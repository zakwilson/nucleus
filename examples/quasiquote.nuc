; Quasiquote / unquote / unquote-splice demo.
; Under the hood these build a list Node with the node runtime's list builders.

(import-use "stdio.h")
(import-use iterator)
(import-use node)   ; a runtime quasiquote calls intern-symbol and node-push

(defn first (n:ptr):ptr (return (node-first n)))
(defn rest  (n:ptr):ptr (return (node-rest n)))

(defstruct ListIter cur:ptr)
(extend ListIter (Iterator ptr))
(defn next (self:&ListIter):?ptr
  (let (c:ptr (self 'cur))
    (when (= (node-len c) 0) (return none))
    (set! (self 'cur) (rest c))
    (return (as-ref (first c)))))

(defn print-list (n:ptr):void
  (let (lit:&ListIter (alloca ListIter))
    (set! (lit 'cur) n)
    (let (first-item:i32 1)
      (printf "(")
      (doseq-iter (elem lit)
        (let (node:&Node (as &Node elem))
          (when (= first-item 0) (printf " "))
          (cond (= (node 'kind) 0) (printf "%ld" (node 'i))
                (= (node 'kind) 2) (printf "%s" (node 's))
                true                 (printf "?"))
          (set! first-item 0)))
      (printf ")\n"))))

(defn main ():int
  (let (x:ptr 'hello
        xs:ptr '(a b c))
    (print-list `(1 2 3))
    (print-list `(pre ~x post))
    (print-list `(before ~@xs after)))
  (return 0))

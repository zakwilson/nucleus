; Quasiquote / unquote / unquote-splice demo.
; Under the hood these use builtin @__cons and @__append runtime helpers.

; Stage 15 B4 (name-resolution.md §11.1/§11.7): the local `(defstruct Node …)`
; that used to sit here shadowed the prelude's, differing only in declaring
; `car`/`cdr` as `ptr` instead of `(raw Node)`. The prelude's already won on
; import order; R4 makes the duplicate an error rather than a coin flip.
(import-use "stdio.h")
(import-use iterator)
(import-use node)   ; a runtime quasiquote calls intern-symbol/make-cell

(defn first (n:ptr):ptr (return ((as ptr:Node n) car)))
(defn rest  (n:ptr):ptr (return ((as ptr:Node n) cdr)))

(defstruct ListIter cur:ptr)
(extend ListIter (Iterator ptr))
(defn next ((self (ref ListIter))) (Maybe ptr)
  (let (c:ptr (self cur))
    (when (= c null) (return none))
    (.set! self cur (rest c))
    (return (some (first c)))))

(defn print-list (n:ptr):void
  (let ((lit (ref ListIter)) (alloca ListIter))
    (.set! lit cur n)
    (let (first-item:i32 1)
      (printf "(")
      (doseq-iter (elem lit)
        (let (node:ptr:Node (as ptr:Node elem))
          (when (= first-item 0) (printf " "))
          (cond (= (node kind) 0) (printf "%ld" (node i))
                (= (node kind) 2) (printf "%s" (node s))
                true                 (printf "?"))
          (set! first-item 0)))
      (printf ")\n"))))

(defn main ():int
  (let (x:ptr 'hello
        xs:ptr '(a b c))
    (print-list `(1 2 3))
    (print-list `(pre ~x post))
    (print-list `(before ~@xs after)))
  (return 0))

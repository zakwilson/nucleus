; Exercises the `with` form: same shape as `let`, autofrees libc-alloc'd
; bindings at scope exit (fall-through and early-return).

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use "string.h")

(defn fall-through ():void
  (with (p:&i32 (malloc 16))
    (set! @p 7)
    (printf "fall-through: %d\n" @p)))

(defn early-return (flag:i32):i32
  (with (p:&i32 (malloc 16))
    (set! @p 42)
    (cond (= flag 1) (return @p))
    (return (+ @p 1))))

(defn nested ():void
  (with (a:&i32 (malloc 16))
    (set! @a 10)
    (with (b:&i32 (calloc 4 4))
      (set! @b 20)
      (printf "nested: %d %d\n" @a @b))))

(defn strdup-bind ():void
  (with (s:ptr (strdup "world"))
    (printf "hello %s\n" s)))

(defn realloc-bind ():void
  (with (p:ptr (malloc 8))
    (set! p (realloc p 32))
    (printf "realloc ok\n")))

(defn mixed ():void
  (with (n:i32 99
         p:&i32 (malloc 16))
    (set! @p n)
    (printf "mixed: %d\n" @p)))

(defn main ():int
  (fall-through)
  (printf "early(1) = %d\n" (early-return 1))
  (printf "early(0) = %d\n" (early-return 0))
  (nested)
  (strdup-bind)
  (realloc-bind)
  (mixed)
  (return 0))

; AVR global initializers — the zero-cost half, on the target the rule exists for.
;
; Stage 15 W8 G-3 (design/global-init.md §4.6, §4.8). Every `defvar` here has a
; CONSTANT initializer, so the runtime-initializer queue stays empty, no
; `@__nucleus_init` and no `llvm.global_ctors` are emitted, and the linked
; firmware is byte-for-byte what it would have been before G-3 existed. That is
; the whole point: "microcontroller binary size" is the stated reason zero cost
; is a hard requirement rather than a nicety, so it is checked here rather than
; only on the host.
;
; The complement is `tests/fixtures/avr-runtime-init.nuc`, which asks for a
; *run-time* initializer and is refused with a located error naming the
; offending `defvar` — because LLVM's `.init_array` lands in AVR RAM while
; avr-libc walks `__ctors_start..__ctors_end`, which the linker leaves empty
; (§2.6 measured this): the constructor would be emitted, linked, occupy RAM and
; never run, with no diagnostic. Spending RAM on a constructor that never
; executes is exactly the failure the zero-cost rule protects against.
;
; `(exclude-prelude)` for the usual freestanding reason (see examples/avr-blink.nuc).

(exclude-prelude)

(import-use "lib/avr.nuc")
(import-use "lib/avr/attiny1634.nuc")

(defconst BLINKS 3)

; A folded constant expression (G-1) and a constant aggregate (G-2), both in
; flash-safe `:const` storage, plus an ordinary zero-initialized counter.
(defvar :const g-limit:ui16 (_* BLINKS 1000))
(defvar :const g-pattern:(array ui8 4) (array ui8 1 2 4 8))
(defvar g-step:ui8 0)

(defn delay (n:ui16):void
  (let (:volatile i:ui16 0)
    (while (< i n)
      (inc! i))))

(defn main ():i32
  (reg8-set-bit! DDRB 0)
  (while true
    ; The index is widened to i64 deliberately: `aref` emits its GEP index as a
    ; hardcoded `i64` on every target (it does not go through `ptr-int-ir`), so
    ; a narrower index produces IR the LLVM parser rejects on AVR. Pre-existing
    ; and unrelated to global initialization -- see the G-3 as-built record.
    (reg8-write PORTB (aref g-pattern (unsafe/cast i64 g-step)))
    (set! g-step (bit-and (_+ g-step 1) 3))
    (delay g-limit))
  (return 0))

; A form is a collection (design/stage21-cleanup/ast-as-collection.md).
;
; A list `Node` is a header over an array of elements, so it conforms to `Coll`
; and `Seq` like a `Vector` does: `count`, `(xs i)`, `conj`, `append`, `insert`,
; `contains?`, `doseq` and `into`. `(xs 'kind)` still reads a field — a selector
; that names one wins over the index method.

(import-use "stdio.h")
(import-use node)
(import-use coll)
(import-use iterator)
(import-use vector)

(defn show (label:CStr xs:&Node):void
  (printf "%s" label)
  (doseq (e xs NodeIter)
    (printf " %ld" (e 'i)))
  (printf "\n"))

(defn main ():i32
  (let (xs:&Node (unsafe/cast &Node `(10 20 30))
        i0:usize 0
        i1:usize 1)
    ; Read: a count, an index, and a field beside it.
    (printf "count=%d kind=%d\n" (unsafe/cast i32 (count xs)) (xs 'kind))
    (printf "second=%ld\n" ((xs i1) 'i))
    (printf "contains-second=%d\n" (as i32 (contains? xs (xs i1))))

    ; Mutate in place: the list has an identity of its own, so an empty one can
    ; be appended to — which is what cons cells could not do.
    (conj xs (node-int 40))
    (append xs (node-int 50))
    (insert xs i0 (node-int 5))
    (show "after conj/append/insert:" xs)

    ; `into`, both ways, through a Vector of nodes.
    (with (v:&(Vector &Node) (alloca (Vector &Node)))
      (vector-init v)
      (into v xs NodeIter)
      (printf "vector-count=%d\n" (unsafe/cast i32 (count v)))
      (let (ys:&Node (node-list-new 0))
        (into ys v (VecIter &Node))
        (show "round-tripped:" ys))))
  (return 0))

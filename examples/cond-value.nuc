(import-use "stdio.h")

(defn main ():int
  (let (a:i64 7
        b:i64 4)
    (let (max:i64 (cond (> a b) a true b))
      (printf "max = %ld\n" max))
    (let (min:i64 (cond (< a b) a true b))
      (printf "min = %ld\n" min))
    (let (label:ptr (cond (= (% a 2) 0) "even" true "odd"))
      (printf "a is %s\n" label))
    (let (sign:i64 (cond (> a 0) 1
                         (< a 0) -1
                         true 0))
      (printf "sign = %ld\n" sign)))
  (return 0))

; MC-3 (design/stage14/macro-conditional-casts.md): macros whose bodies branch
; on argument shape no longer need casts. Macro params are already (ptr Node),
; quasiquote/gensym results are (ptr Node) (MC-2), and a value-position cond/if
; join absorbs an elem-less bare pointer (null, bare quote) into the typed side
; (MC-1). So a castless shape-dispatching macro compiles and runs.

(import-use "stdio.h")

; 1. Castless variadic operator — mirrors the now-castless + / * in lib/nucleus/macros.nuc.
;    The single-arg base case returns a bare `ast-at`, a (ptr Node), joined with
;    the quasiquote branches (also (ptr Node)) — no cast.
(defmacro sum (:rest args)
  (cond (= (ast-len args) 0)
          `0
        (= (ast-len args) 1)
          (ast-at args 0)
        true
          `(_+ ~(ast-at args 0) (sum ~@(ast-rest args)))))

; 2. Castless (if … (ast-rest n) null) slot init: bind `tail` to the argument
;    form's tail when it is a list, else null. (ptr Node) ⊔ null absorbs to
;    (ptr Node) (MC-1), so the local needs no cast. Dispatch on an empty tail.
(defmacro tail-tag (form)
  (let ((tail ?&Node) (if (= (form 'kind) NODE-LIST) (ast-rest form) null))
    (if (= tail null)
      `(printf "no-tail\n")
      `(printf "has-tail\n"))))

; 3. Shape-dispatching macro (tprint-style), castless: dispatch on the literal
;    KIND of the argument. `(x 'kind)` needs no (cast ptr:Node …); the quasiquote
;    branches all join as (ptr Node).
(defmacro describe (x)
  (cond (= (x 'kind) NODE-INT)   `(printf "int %d\n" ~x)
        (= (x 'kind) NODE-STR)   `(printf "str %s\n" ~x)
        (= (x 'kind) NODE-FLOAT) `(printf "float %f\n" ~x)
        true                    `(printf "other\n")))

(defn main ():int
  (printf "%d\n" (sum))              ; 0   — empty
  (printf "%d\n" (sum 7))            ; 7   — single-arg base case (no cast)
  (printf "%d\n" (sum 1 2 3 4))      ; 10  — right-folded _+
  (tail-tag x)                       ; no-tail  — symbol form, kind != NODE-LIST
  (tail-tag (a))                     ; no-tail  — a one-element list
  (tail-tag (a b))                   ; has-tail — a list with a tail
  (describe 42)                      ; int 42
  (describe "hi")                    ; str hi
  (describe 2.5)                     ; float 2.500000
  (describe (1 2))                   ; other    — default branch
  (return 0))

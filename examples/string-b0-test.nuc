; Stage 17 B0 — the string-stack gap closure.
; design/stage17-native-strings/library-gaps.md items 5, 6, 8, 9, 10, 13.
;
; Covers: vector-extend-raw / vector-extend (bulk append), the `strview` value
; constructor, string-as-cstr, the single-byte/backward/codepoint searches, the
; unchecked append, and the !void re-signatures of push-str / truncate.

(import-use "stdio.h")
(import-use vector)
(import-use strview)
(import-use string)
(import-use char)

(defn show-maybe (label:CStr (m (Maybe usize))):void
  (match m
    ((some i) (printf "%s=%llu\n" label (as ui64 i)))
    (none     (printf "%s=none\n" label))))

(defn main ():i32

  ; ---- 6. Vector bulk append -------------------------------------------------
  (with (v:(ref (Vector i32)) (vector-new))
    (let (src:ptr:i32 (as ptr:i32 (alloca i32 3)))
      (set! (aref src 0) 10)
      (set! (aref src 1) 20)
      (set! (aref src 2) 30)
      (vector-extend-raw v src 3))
    (printf "vec-count=%llu\n" (as ui64 (count v)))          ; 3
    (printf "vec=%d,%d,%d\n" (v 0) (v 1) (v 2))              ; 10,20,30
    (with (w:(ref (Vector i32)) (vector-new))
      (conj w 40)
      (vector-extend w v)
      (printf "w-count=%llu w0=%d w3=%d\n"
              (as ui64 (count w)) (w 0) (w 3))))             ; 4 40 30

  ; ---- 8. The strview value constructor --------------------------------------
  (let (hay:StrView (strview (as ptr:ui8 (as ptr "banana")) 6))
    (printf "hay-len=%llu\n" (as ui64 (hay 'len)))           ; 6

    ; ---- 10. byte / backward / codepoint search ------------------------------
    (show-maybe "find-a"  (strview-find-byte  (addr-of hay) (as ui8 97)))   ; 1
    (show-maybe "rfind-a" (strview-rfind-byte (addr-of hay) (as ui8 97)))   ; 5
    (show-maybe "find-z"  (strview-find-byte  (addr-of hay) (as ui8 122)))  ; none
    (let (ana:StrView (strview (as ptr:ui8 (as ptr "ana")) 3))
      (show-maybe "find-ana"  (strview-find  (addr-of hay) (addr-of ana)))  ; 1
      (show-maybe "rfind-ana" (strview-rfind (addr-of hay) (addr-of ana)))) ; 3
    ; `\n` is the LETTER n — Nucleus spells line feed `\newline`.
    (show-maybe "find-char-n"  (strview-find-char  (addr-of hay) \n))       ; 2
    (show-maybe "rfind-char-n" (strview-rfind-char (addr-of hay) \n)))      ; 4

  ; multi-byte codepoint: "hé" is 68 C3 A9, so é starts at byte 1
  (let (acc:StrView (strview (as ptr:ui8 (as ptr "hé")) 3))
    (show-maybe "find-char-e-acute" (strview-find-char (addr-of acc) \u{e9})))

  ; ---- 5, 9, 13. push / truncate / CStr bridge -------------------------------
  (with (s:(ref String) (string-new))
    (let (a:StrView (strview (as ptr:ui8 (as ptr "hello")) 5)
          b:StrView (strview (as ptr:ui8 (as ptr ", world")) 7))
      (string-push-str-unchecked s (addr-of a))
      (match (string-push-str s (addr-of b))
        ((ok)    (printf "push=ok\n"))
        ((err e) (printf "push=err\n"))))
    (printf "as-cstr=%s len=%llu\n" (string-as-cstr s) (as ui64 (byte-len s)))
    (match (string-truncate s 5)
      ((ok)    (printf "trunc=ok as-cstr=%s\n" (string-as-cstr s)))
      ((err e) (printf "trunc=err\n")))
    (match (string-truncate s 99)
      ((ok)    (printf "trunc-oob=ok\n"))
      ((err e) (printf "trunc-oob=err\n"))))

  0)

; nucleus.create's `make` and `new` over the collections. `make` builds a value,
; which materializes into a (ref ...) binding (TC-3) and composes with
; `with`/Drop; `new` also allocates the struct itself through the allocator and
; returns an escapable ref.
(import-use "stdio.h")
(import-use nucleus.vector)
(import-use nucleus.hashmap)
(import-use nucleus.hashset)
(import-use nucleus.allocator)
(import-use nucleus.arena)
(import-use nucleus.create)

(defn main ():i32
  ; 1. By-value `make` + with/Drop — the primary local idiom. Methods take
  ;    (ref ...) so no `&`.
  (with (v:&(Vector i32) (make (Vector i32)))
    (conj v 10)
    (conj v 20)
    (conj v 30)
    (printf "vector count=%d first=%d\n" (unsafe/cast i32 (count v)) (v 0)))

  ; 2. An explicit allocator: anything `handle` takes, here a stored handle.
  (let (ah:Alloc (handle heap))
    (with (v2:&(Vector i32) (make (Vector i32) ah))
      (conj v2 7)
      (printf "alloc-vector count=%d\n" (unsafe/cast i32 (count v2)))))

  ; 3. HashMap.
  (let (m:&(HashMap CStr i32) (make (HashMap CStr i32)))
    (assoc m "alpha" 1)
    (assoc m "beta" 2)
    (printf "hashmap count=%d\n" (unsafe/cast i32 (count m))))

  ; 4. HashSet.
  (with (s:&(HashSet i32) (make (HashSet i32)))
    (insert s 100)
    (insert s 200)
    (printf "hashset count=%d has100=%d\n" (unsafe/cast i32 (count s)) (contains? s 100)))

  ; 5. `new` through the process arena — an escapable ref the arena owns.
  (let (h:&(Vector i32) (new (Vector i32) g-arena))
    (conj h 42)
    (printf "heap-vector count=%d\n" (unsafe/cast i32 (count h))))

  (printf "done\n")
  0)

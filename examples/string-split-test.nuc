; Stage 11 M6 (S5) — strview-split / strview-lines / strview-trim tests.
;
; Tests:
;   1. Split "a,b,c" on "," → "a", "b", "c"
;   2. Split "hello" on "x" (not found) → "hello"
;   3. Split "" on "," → one empty segment ""
;   4. Split "a--b--c" on "--" → "a", "b", "c"
;   5. strview-lines "line1\nline2\nline3" → "line1", "line2", "line3"
;   6. strview-lines "line1\r\nline2\r\n" → "line1", "line2", ""
;   7. strview-trim "  hello  " → len=5
;   8. strview-trim-start "  hello" → len=5
;   9. strview-trim-end "hello  " → len=5

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use "string.h")
(import-use strview)
(import-use string-split)

; Print a StrView as a C string (assumes the view is a slice of a NUL-terminated
; buffer, OR we copy it to a temp buffer).
(defn print-sv ((sv (ref StrView))):void
  (with (n:usize (sv len)
         buf:ptr:ui8 (as ptr:ui8 (malloc (as i64 (+ n 1)))))
    (memcpy (as ptr buf) (as ptr (sv data)) (as i64 n))
    (aset! buf (as i64 n) 0)
    (printf "%s" (as CStr (as ptr buf)))))

(defn main ():i32

  ; ---- 1. Split "a,b,c" on "," -----------------------------------------------
  (with (sv:ptr:StrView (strview-from-cstr "a,b,c")
        sep:ptr:StrView (strview-from-cstr ",")
        it:SplitIter (strview-split sv sep))
    (doseq-split (seg (addr-of it))
                 (print-sv seg)
                 (printf "\n")))

  ; ---- 2. Split "hello" on "x" (not found) ------------------------------------
  (with (sv:ptr:StrView (strview-from-cstr "hello")
        sep:ptr:StrView (strview-from-cstr "x")
        it:SplitIter (strview-split sv sep))
    (doseq-split (seg (addr-of it))
                 (print-sv seg)
                 (printf "\n")))

  ; ---- 3. Split "" on "," → one empty segment ---------------------------------
  (with (sv:ptr:StrView (strview-from-cstr "")
         sep:ptr:StrView (strview-from-cstr ",")
         it:SplitIter (strview-split sv sep)
         count:i32 0)
    (doseq-split (seg (addr-of it))
                 (set! count (+ count 1))
                 (printf "empty-seg-len=%llu\n" (as ui64 (seg len)))
                 (printf "empty-count=%d\n" count)))

  ; ---- 4. Split "a--b--c" on "--" --------------------------------------------
  (with (sv:ptr:StrView (strview-from-cstr "a--b--c")
         sep:ptr:StrView (strview-from-cstr "--")
         it:SplitIter (strview-split sv sep))
    (doseq-split (seg (addr-of it))
                 (print-sv seg)
                 (printf "\n")))

  ; ---- 5. strview-lines "line1\nline2\nline3" ---------------------------------
  (with (sv:ptr:StrView (strview-from-cstr "line1\nline2\nline3")
         it:LineIter (strview-lines sv))
    (doseq-split (seg (addr-of it))
                 (print-sv seg)
                 (printf "\n")))

  ; ---- 6. strview-lines with CRLF and trailing newline -----------------------
  (with (sv:ptr:StrView (strview-from-cstr "line1\r\nline2\r\n")
        it:LineIter (strview-lines sv)
        count:i32 0)
    (doseq-split (seg (addr-of it))
                 (set! count (+ count 1))
                 (printf "crlf%d=" count)
                 (print-sv seg)
                 (printf "\n")))

  ; ---- 7. strview-trim "  hello  " → len=5 -----------------------------------
  (with (sv:ptr:StrView (strview-from-cstr "  hello  ")
        trimmed:StrView (strview-trim sv))
    (printf "trim-len=%llu\n" (as ui64 ((addr-of trimmed) len))))

  ; ---- 8. strview-trim-start "  hello" → len=5 --------------------------------
  (with (sv:ptr:StrView (strview-from-cstr "  hello")
        trimmed:StrView (strview-trim-start sv))
    (printf "trim-start-len=%llu\n" (as ui64 ((addr-of trimmed) len))))

  ; ---- 9. strview-trim-end "hello  " → len=5 ----------------------------------
  (with (sv:ptr:StrView (strview-from-cstr "hello  ")
        trimmed:StrView (strview-trim-end sv))
    (printf "trim-end-len=%llu\n" (as ui64 ((addr-of trimmed) len))))

  (return 0))

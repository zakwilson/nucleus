; :rest parameters for defn. The compiler folds trailing args at the call
; site into a Node list and passes a pointer to it.

(import-use "stdio.h")
(import-use "lib/nucleus/list.nuc")
(import-use nucleus.iterator)
(import-use nucleus.combinators)
(import-use nucleus.node)   ; a :rest call folds its tail into a Node list

; Sum any number of i64 args. The compiler inttoptr's each into a list slot.
(defn sum-args (:rest args:i64):i64
  (let (it:ListIter (list-iter args))
    (return (reduce (vfn (acc:i64 x:ptr):i64 (+ acc (unsafe/cast i64 x))) 0 &it))))

; Mix of fixed positional + :rest.
(defn print-each (prefix:ptr :rest args:ptr):void
  (let (it:ListIter (list-iter args))
    (for-each (vfn (elem:ptr):i32 (printf "%s%s\n" prefix elem) (return 0)) &it)))

(defn main ():i32
  (printf "%ld\n" (sum-args 1 2 3 4))
  (printf "%ld\n" (sum-args))
  (printf "%ld\n" (sum-args 10))
  (print-each "> " "a" "b" "c")
  (print-each "= ")
  (return 0))

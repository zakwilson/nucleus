; Stage 9 — callable values (callable-values.md).
;
; A non-function value `s` in head position, `(s arg)`:
;   - a quoted selector naming one of its fields reads that field;
;   - else, if the value's type has an `invoke` method, that `invoke` runs, with
;     the argument(s) taken as values (indexing, function objects). `(v idx)`
;     indexes even when `idx` is a local symbol holding an index;
;   - else a struct reads the field the selector names (GEP+load).
; `(field s sel)` is the field read alone, whatever `invoke` the type defines.
; Function-object protocols: (UnaryFn Arg Ret) and (FoldFn Acc Elem) in
; lib/nucleus/iterator.nuc provide parametric, element-generic alternatives to the
; former fixed-type Call/BinaryCall protocols.

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use nucleus.iterator)
(import-use nucleus.node)   ; Temp's `invoke` takes a symbol it compares at run time

(defstruct Point x:i32 y:i32)

; ---- invoke: an i32 vector, indexable by call. Its fields still read by
;      quoted name: `(v 'len)` names a field, so it is not an index. ----
(defstruct Vec data:&i32 len:i32)
(defn invoke (self:&Vec i:i32):i32
  (return (aref (self 'data) i)))

; ---- UnaryFn: a function object that adds a fixed delta to its i32 argument ----
(defstruct Adder delta:i32)
(extend Adder (UnaryFn i32 i32))
(defn apply (self:&Adder (x i32)) i32
  (return (+ x (self 'delta))))

; ---- FoldFn: a function object that multiplies accumulator by element ----
(defstruct Multiplier dummy:i32)
(extend Multiplier (FoldFn i32 i32))
(defn fold (self:&Multiplier (acc i32) (x i32)) i32
  (return (* acc x)))

; ---- An `invoke` taking a symbol: `(t 'c)` names the field, so it reads it;
;      `(t 'f)` names none, so `invoke` computes it. ----
(defstruct Temp c:i32)
(defn invoke (self:&Temp sel:&Node):i32
  (if (= sel 'f) (return (+ (* (self 'c) 2) 30))
                 (return (self 'c))))

(defn main ():i32
  ; Member access by call — the Struct default. (p 'x) == (field p 'x).
  (let (p:&Point (unsafe/cast &Point (malloc (as i64 (sizeof Point)))))
    (set! (p 'x) 3)
    (set! (p 'y) 4)
    (printf "point: x=%d y=%d\n" (p 'x) (p 'y)))

  ; (v i) indexes (literal OR a local index symbol); (v 'len) reads the field.
  (let (v:&Vec (unsafe/cast &Vec (malloc (as i64 (sizeof Vec))))
        arr:&i32 (unsafe/cast &i32 (malloc 12)))
    (set! (aref arr 0) 10)
    (set! (aref arr 1) 20)
    (set! (aref arr 2) 30)
    (set! (v 'data) arr)
    (set! (v 'len) 3)
    ; idx is a local symbol holding an index — (v idx) routes to invoke (indexes),
    ; it is NOT a field named "idx". This is the behaviour Step C fixes.
    (let (idx:i32 1)
      (printf "seq: v0=%d vidx=%d v2=%d len=%d\n" (v 0) (v idx) (v 2) (v 'len))))

  ; UnaryFn: a function object invoked with an i32 argument via apply.
  (let (add5:&Adder (alloca Adder))
    (set! (add5 'delta) 5)
    (printf "call: 37+5=%d\n" (apply add5 37)))

  ; FoldFn: reduce [2,3,4] by multiplication starting from 1 via fold.
  (let (mul:&Multiplier (alloca Multiplier))
    (set! (mul 'dummy) 0)
    (printf "fold: 1*2*3*4=%d\n" (fold mul (fold mul (fold mul 1 2) 3) 4)))

  ; 'c is the field; 'f is computed by invoke.
  (let (t:&Temp (unsafe/cast &Temp (malloc (as i64 (sizeof Temp)))))
    (set! (t 'c) 20)
    (printf "temp: c=%d f=%d\n" (t 'c) (t 'f)))
  (return 0))

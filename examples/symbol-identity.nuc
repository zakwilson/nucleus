; Symbol identity: two symbols with the same spelling are the same Node*.

(import-use "stdio.h")
(import-use node)   ; 'foo lowers to a call to intern-symbol

(defn show (label:ptr eq:bool):void
  (if eq (printf "%s: yes\n" label) (printf "%s: no\n" label)))

(defn main ():int
  (show "'foo = 'foo"           (= 'foo 'foo))
  (let (a:ptr 'bar
        b:ptr 'bar)
    (show "let-bound 'bar pair " (= a b)))
  (show "'foo = 'bar"           (= 'foo 'bar))
  (let (xs:ptr '(foo bar)
        head:ptr (node-first xs))
    (show "(first '(foo bar)) = 'foo" (= head 'foo)))
  0)

(import-use "stdio.h")

(defn sum-i64:i64 (a:i64 b:i64)
  (return (+ a b)))

(defn main:int ()
  (let (big:i64 1000000000
        bump:i64 42)
    (let (total:i64 (sum-i64 big bump))
      (printf "total = %lld\n" total)
      (printf "narrow = %d\n" (cast i32 total))))
  ; 200 is outside i8's range [-128,127]; narrowing it must be explicit (an
  ; implicit out-of-range literal is a compile-time error since Stage 14 LW-4),
  ; so the two's-complement wrap to -56 is opted into with an explicit cast.
  (let (byte:i8 (cast i8 200))
    (printf "byte = %d\n" (cast i32 byte)))
  (return 0))

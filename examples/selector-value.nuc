; Member access, both readings — the matrix.
;
; design/stage16-ergonomics/dot-forms.md
;
; A field name is QUOTED; a bare symbol in selector position is an ordinary
; variable reference, like a symbol anywhere else. Stage 15's W7 rule tried to
; get the value reading back by demoting a bare symbol only when the callee
; provably had no such field, which left the collision case unreachable and
; needed a `count:CStr` annotation hatch to force it. Stage 16 dropped the
; special case instead: quoting says "field", not quoting says "variable", and
; neither reading can be foreclosed by what the callee happens to contain.

(import-use "stdio.h")
(import-use allocator)
(import-use coll)
(import-use iterator)
(import-use hash)
(import-use hashmap)

(defstruct Point x:i32 y:i32)

(defn main ():i32
  ; --- plain struct: a bare symbol still names a field, even when a local
  ;     of the same name is in scope (the field wins) ---
  (let (p:ptr:Point (alloca Point)
        x:i32 99)
    (set! (p 'x) 3)
    (set! (p 'y) 4)
    (printf "field=%d local=%d quoted=%d\n" (p 'x) x (get p 'x)))  ; 3 99 3

  (with ((m (ref (HashMap CStr i32))) {"foo" 42 "bar" 7}
         k:CStr "foo"
         miss:CStr "nope")
    ; --- the fix: a local key in head position ---
    (match (m k)
      ((some v) (printf "head=%d\n" v))                           ; 42
      (none     (printf "head=absent\n")))
    ; --- and through the explicit `get` form ---
    (match (get m k)
      ((some v) (printf "get=%d\n" v))                            ; 42
      (none     (printf "get=absent\n")))
    ; --- and through `invoke`, which now falls back to `get` ---
    (match (invoke m k)
      ((some v) (printf "invoke=%d\n" v))                         ; 42
      (none     (printf "invoke=absent\n")))
    ; --- a string literal key still works (it always did) ---
    (match (m "bar")
      ((some v) (printf "literal=%d\n" v))                        ; 7
      (none     (printf "literal=absent\n")))
    ; --- a local key that is genuinely absent ---
    (match (m miss)
      ((some v) (printf "missing=%d\n" v))
      (none     (printf "missing=absent\n"))))                    ; absent

  ; --- the collision: a local named after a real HashMap field. Quoting
  ;     decides it, so both readings are spellable with no escape hatch. ---
  (with ((c (ref (HashMap CStr i32))) {"count" 5}
         count:CStr "count")
    (printf "count-field=%llu\n" (as ui64 (c 'count)))             ; 1 — the field
    (match (c count)
      ((some v) (printf "count-key=%d\n" v))                      ; 5 — the value
      (none     (printf "count-key=absent\n"))))

  (printf "done\n")
  (return 0))

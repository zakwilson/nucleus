; Running another program: lib/process.nuc.
;
; A Command is an argv, not a command line — there is no shell between this
; program and the one it starts, so an argument containing spaces or quotes is
; one argument and nobody has to escape it.

(import-use process)
(import-use io)
(import-use string)
(import-use strview)

; One-shot: run it, capture both streams, wait.
(defn show (label:StrView c:&Command):void
  (match (run c)
    ((ok o)
     (print label " exit=" (exit-code (ref o 'status))
            " out=" (string-as-view (ref o 'out)))
     (drop &o))
    ((err e) (print label " could not run\n"))))

(defn main ():i32
  (let (hello:Command (command "echo"))
    (command-arg &hello "hello from a child")
    (show "echo:" &hello)
    (drop &hello))

  ; An argument the shell would have mangled: quotes, a space, and a $.
  (let (sh-cmd:Command (command "sh"))
    (command-arg &sh-cmd "-c")
    (command-arg &sh-cmd "printf '%s\n' \"$1\"")
    (command-arg &sh-cmd "sh")
    (command-arg &sh-cmd "a \"quoted\" $ARG")
    (show "argv:" &sh-cmd)
    (drop &sh-cmd))

  ; Failure is a value, not a message on stderr.
  (let (bad:Command (command "sh"))
    (command-arg &bad "-c")
    (command-arg &bad "echo problem >&2; exit 2")
    (match (run &bad)
      ((ok o)
       (print "failing: exit=" (exit-code (ref o 'status))
              " ok=" (if (success? (ref o 'status)) "yes" "no")
              " stderr=" (string-as-view (ref o 'err)))
       (drop &o))
      ((err e) (print "failing: could not run\n")))
    (drop &bad))

  ; The pieces underneath, for when one-shot is not enough: start two children,
  ; then take them in the order they finish rather than the order they started.
  (let (slow:Command (command "sh"))
    (command-arg &slow "-c")
    (command-arg &slow "sleep 0.3; exit 4")
    (let (quick:Command (command "sh"))
      (command-arg &quick "-c")
      (command-arg &quick "exit 5")
      (let (a:Process (unwrap (spawn &slow))
            b:Process (unwrap (spawn &quick)))
        (let (i:i32 0)
          (while (< i 2)
            (match (wait-any)
              ((ok ce) (print "finished: exit=" (exit-code (ref ce 'status)) "\n"))
              ((err e) (print "finished: wait failed\n")))
            (set! i (+ i 1))))
        (process-detach &a)
        (process-detach &b))
      (drop &quick))
    (drop &slow))
  (return 0))

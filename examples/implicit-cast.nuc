(import-use "stdio.h")
(import-use "stdlib.h")

; Built-in implicit cast: i32 literal → ui64 (size_t) for malloc.
; No (cast i64 ...) wrapper required.
(defn try-malloc ():i32
  (with (p:ptr (malloc 16))
    (when (= p null) (return 0))
    (return 1)))

; Built-in implicit cast: f32 → f64 (fpext) at call site.
(defn show-f64 (x:f64):void
  (printf "f64=%.2f\n" x))

; Built-in: i32 → i64 widening at call site.
(defn show-i64 (x:i64):void
  (printf "i64=%lld\n" x))

; defcast: user-asserted conversion from i64 to ptr.
; The conversion function provides the actual reinterpretation.
(defn id_to_ptr (x:i64):ptr
  (return (unsafe/cast ptr x)))

(defcast i64 ptr id_to_ptr)

(defn show-ptr (p:ptr):void
  (printf "ptr=%lld\n" (unsafe/cast i64 p)))

(defn main ():int
  (printf "malloc-ok=%d\n" (try-malloc))
  ; i32 literal widens to i64 implicitly.
  (show-i64 42)
  ; f32 widens to f64 implicitly.
  (show-f64 (unsafe/cast f32 2.5))
  ; defcast fires: i64 → ptr via id_to_ptr. The `(as i64 ...)` is required —
  ; a bare literal is i32, a rule is looked up on the exact pair, and implicit
  ; conversions do not compose, so widening does not run first to reach it
  ; (W9 item 42; `(show-ptr 0)` reports that, and names this rule in a note).
  ; This line read `(show-ptr 0)` until W9 item 33 made an unconvertible
  ; argument an error rather than a silent pass-through, which is what showed
  ; that the cast had never fired.
  (show-ptr (as i64 0))
  ; The same rule at a non-argument slot. Until W9 item 47 the registry was only
  ; consulted for call arguments and `as`, so this binding was a type error on
  ; the rule's own exact pair.
  (let (p:ptr (as i64 7))
    (show-ptr p))
  (return 0))

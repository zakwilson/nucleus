; A program that declares and runs its own tests (lib/test.nuc).
;
; `deftest` registers each test before `main` runs, so `main` is one call to
; `test-main`. Run it with no arguments to run everything, `--list` to see the
; names, `--run <name>` to run one.
;
; Two tests do not pass on purpose, so the output shows what a skip record and
; a failure record look like.

(import-use error)
(import-use strview)
(import-use string)
(import-use vector)
(import-use io)
(import-use test)

(defn greeting ():StrView (return "hello, world"))

(defn ledger ():StrView (return "alpha\nbeta\ngamma\n"))

; A scrap of LLVM IR, the shape the compiler's own tests assert against.
(defn module-ir ():StrView (return "target triple = \"x86_64-pc-linux-gnu\"

define i32 @add(i32 %a, i32 %b) {
entry:
  %sum = add i32 %a, %b
  ret i32 %sum
}

define void @noop() {
entry:
  ret void
}
"))

(deftest substrings
  (try (check-contains (greeting) "lo, wo"))
  (try (check-not-contains (greeting) "goodbye")))

(deftest whole-lines
  (try (check-line (ledger) "beta"))
  (try (check-line (ledger) "gamma")))

(deftest equality
  (try (check-eq (greeting) "hello, world"))
  (let (g:StrView (greeting))
    (try (check-eq-int (as i64 (strview-byte-len (addr-of g))) 12 "greeting length"))))

(deftest wildcards
  ; A glob matches a whole line; `*` stands for any run of bytes.
  (try (check-match (module-ir) "define i32 @add(*)*"))
  (try (check-not-match (module-ir) "*fdiv*")))

(deftest emptiness
  (try (check-non-empty (greeting)))
  (try (check-empty "")))

(deftest ir-is-scoped
  ; The point of the scoped matcher: `ret void` IS in the module, but it is not
  ; in @add, and a module-wide grep cannot tell the difference.
  (try (check-in-define (module-ir) "add" "  %sum = add i32*"))
  (try (check-not-in-define (module-ir) "add" "  ret void"))
  (try (check-in-define (module-ir) "noop" "  ret void")))

; What `nucleusc --diagnostics=sexp` writes, with a line of tool output in the
; middle that a caller would get from the compiler's raw stderr.
(defn compiler-stderr ():StrView (return "(diagnostic (severity error) (file \"a.nuc\") (line 12) (message \"get: no field 'z' on struct 'Pt'\") (notes))
clang: error: something a tool said
(diagnostic (severity warning) (file \"b.nuc\") (line 3) (message \"second ns directive\") (notes \"the first one wins\"))
"))

(deftest diagnostics
  (let (ds:(Vector Diagnostic) (try (read-diagnostics (compiler-stderr))))
    ; The line that is not a diagnostic is skipped, not fatal.
    (try (check-eq-int (as i64 (count (addr-of ds))) 2 "diagnostic count"))
    ; Severity, file, line and message are matched against ONE record. Two
    ; independent greps over the blob above would also accept "an error at
    ; a.nuc:12" paired with "second ns directive" -- which is the hole.
    (try (check-error-at (addr-of ds) "a.nuc" 12 "no field 'z'"))
    (try (check-warning-at (addr-of ds) "b.nuc" 3 "second ns"))
    (try (check-note-at (addr-of ds) "b.nuc" 3 "the first one wins"))))

; A test whose subject is not here to be tested says so, with its reason, and
; the run still exits 0 for it. `--no-skip` turns it into a failure, for a run
; that will not accept one.
(deftest this-one-skips-on-purpose
  (skip! "no oracle for " (greeting) " on this host"))

(deftest this-one-fails-on-purpose
  (try (check-contains (greeting) "au revoir")))

(defn main (argc:i32 argv:ptr):int
  (return (as int (test-main argc argv))))

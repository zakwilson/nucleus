; Stage 11 M2 — Iterator protocol, doseq, lazy map/filter/reduce.
;
; Tests:
;   1. IntRangeIter with doseq (prints 1 2 3 4 5).
;   2. I64ArrayIter -> MapIter -> FilterIter -> reduce chain.
;
; chain: [1,2,3,4,5] -> square -> [1,4,9,16,25]
;                    -> keep-even -> [4,16]
;                    -> sum -> 20

(import-use "stdio.h")
(import-use "string.h")
(import-use nucleus.iterator)

; ---------------------------------------------------------------------------
; FoldFn conformer: sums two i64 values.
; ---------------------------------------------------------------------------
(defstruct SumI64 dummy:i32)
(extend SumI64 (FoldFn i64 i64))
(defn fold (self:&SumI64 (acc i64) (x i64)) i64
  (return (+ acc x)))

; ---------------------------------------------------------------------------
; UnaryFn conformer: squares an i64.
; ---------------------------------------------------------------------------
(defstruct SquareI64 dummy:i32)
(extend SquareI64 (UnaryFn i64 i64))
(defn apply (self:&SquareI64 (x i64)) i64
  (return (* x x)))

; ---------------------------------------------------------------------------
; UnaryFn conformer: predicate — returns 1 when x is even, else 0.
; Conforms to (UnaryFn i64 i32) as required by FilterIter.
; ---------------------------------------------------------------------------
(defstruct IsEvenI64 dummy:i32)
(extend IsEvenI64 (UnaryFn i64 i32))
(defn apply (self:&IsEvenI64 (x i64)) i32
  (return (as i32 (= (% x 2) 0))))

; ---------------------------------------------------------------------------
; Helper: run the chain test and return the sum.
; Separated into its own function to keep main readable.
; ---------------------------------------------------------------------------
(defn run-chain (arr:&i64):i64
  (let (sq:&SquareI64  (alloca SquareI64)
        ev:&IsEvenI64  (alloca IsEvenI64)
        sm:&SumI64     (alloca SumI64)
        src:&I64ArrayIter (alloca I64ArrayIter)
        mi:&(MapIter I64ArrayIter SquareI64)
             (alloca (MapIter I64ArrayIter SquareI64))
        fi:&(FilterIter (MapIter I64ArrayIter SquareI64) IsEvenI64)
             (alloca (FilterIter (MapIter I64ArrayIter SquareI64) IsEvenI64)))
    (set! (src 'data) arr)
    (set! (src 'pos) 0)
    (set! (src 'len) 5)
    (memcpy (as ptr (ref mi 'source)) (as ptr src) (as i64 (sizeof I64ArrayIter)))
    (memcpy (as ptr (ref mi 'f))      (as ptr sq)  (as i64 (sizeof SquareI64)))
    (memcpy (as ptr (ref fi 'source)) (as ptr mi)
            (as i64 (sizeof (MapIter I64ArrayIter SquareI64))))
    (memcpy (as ptr (ref fi 'pred)) (as ptr ev) (as i64 (sizeof IsEvenI64)))
    (return (reduce sm 0 fi))))

(defn main ():i32
  ; ---- 1. doseq-iter over a bare IntRangeIter ref (a pure Iterator, not a
  ;         Coll, so it uses the iterator-ref form) ----------------------------
  (let (r:&IntRangeIter (alloca IntRangeIter))
    (set! (r 'start) 1)
    (set! (r 'end) 6)
    (doseq-iter (x r)
      (printf "%d\n" x)))

  ; ---- 2. map/filter/reduce chain over i64 elements ----------------------
  (let (arr:&i64 (alloca i64 5))
    (set! (aref arr 0) 1)
    (set! (aref arr 1) 2)
    (set! (aref arr 2) 3)
    (set! (aref arr 3) 4)
    (set! (aref arr 4) 5)
    (printf "sum=%lld\n" (run-chain arr)))

  (return 0))

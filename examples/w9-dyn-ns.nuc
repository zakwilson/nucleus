; Stage 15 W9 defect 21 — `(dyn ns/Proto)` across a namespace, end to end.
;
; Before the fix this program could not compile at all: `conformance-add` keyed
; the conformance under the BARE `Describe` (Stage 12 N4 stripped the qualifier
; off both the type and the protocol) while `protocol-lookup` matched the raw
; qualified spelling, so `(extend Fox dp/Describe)` recorded a fact that
; `(dyn dp/Describe)` could never find — it reported
;   (dyn dp/Describe): 'dp/Describe' is not a declared protocol
; for a protocol that was both declared and conformed to. A protocol is now a
; namespaced entity: registered under `dp/Describe`, referenced bare from inside
; `(ns dp)` and qualified from outside, and TYPE identity is untouched.
;
; What each line pins:
;   * `dp/Describe`  — a qualified protocol reference resolves cross-namespace,
;     and the import prefix (`dpx`) is deliberately DIFFERENT from the namespace
;     (`dp`), so this proves the reference resolves by NAMESPACE. (An import
;     prefix aliases `g-globals` entries; it does not name protocols.)
;   * `Fox` from lib/nsdescribe.nuc — its `(extend Fox Describe)` is written BARE
;     inside `(ns dp)`, so the bare and qualified spellings must be one identity.
;   * `Cat` conforming to BOTH `dp/Describe` and `dp2/Describe` — two protocols
;     that share the bare name `Describe` and do not collide; each box dispatches
;     its own protocol's method.
;
; Boxing happens here rather than in the libraries because a file with an
; explicit `(ns …)` cannot currently reach `default-allocator` — see the note in
; lib/nsdescribe.nuc.

(import-use "stdio.h")
(import-use allocator)
(import-prefixed nsdescribe dpx)
(import-prefixed nsdescribe2 dpx2)

(defstruct Cat n:i32)

(defn describe ((self (ref Cat))):i32 (return (+ 100 (self n))))
(defn tag-of ((self (ref Cat))):i32 (return (+ 200 (self n))))

; Same bare protocol name, two namespaces, one conforming type.
(extend Cat dp/Describe)
(extend Cat dp2/Describe)

(defn main ():i32
  (let (a:(dyn dp/Describe)  (Cat 5)
        b:(dyn dp2/Describe) (Cat 7)
        c:(dyn dp/Describe)  (Fox 9))
    (printf "%d\n" (describe a))
    (printf "%d\n" (tag-of b))
    ; `describe` is overloaded here (Cat and, from the library, Fox), so the
    ; call dispatches through the box's vtable — the Fox impl lives in namespace
    ; `dp` and is reached without naming it.
    (printf "%d\n" (describe c)))
  (return 0))

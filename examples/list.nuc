; Demonstrates list manipulation primitives over the unified Node type.
;
; Stage 15 B4 (name-resolution.md §11.1/§11.7): this file used to carry its own
; `(defstruct Node kind:i32 line:i32 i:i64 s:ptr car:ptr cdr:ptr)`, shadowing the
; prelude's — which declares `car`/`cdr` as `(raw Node)` rather than `ptr`. The
; two are ABI-identical (six slots; a `(raw Node)` is a pointer) and the prelude
; already won on import order, so the duplicate only ever decided declared
; nullability. R4 makes two definitions of one name an error, so it is gone; the
; prelude's `Node` is the one type.

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use iterator)
(import-use node)   ; '(a b c) below builds cells at run time

(defn cons (car:ptr cdr:ptr):ptr
  (let (c:ptr:Node (as ptr:Node (malloc (sizeof Node))))
    (.set! c kind 3)
    (.set! c line 0)
    (.set! c i 0)
    (.set! c s null)
    (.set! c car car)
    (.set! c cdr cdr)
    (return (as ptr c))))

(defn first (n:ptr):ptr
  (cond (= n null) (return null))
  (return ((as ptr:Node n) car)))

(defn rest (n:ptr):ptr
  (cond (= n null) (return null))
  (return ((as ptr:Node n) cdr)))

(defn append (a:ptr b:ptr):ptr
  (cond (= a null) (return b))
  (return (cons (first a) (append (rest a) b))))

(defstruct ListIter cur:ptr)
(extend ListIter (Iterator ptr))
(defn next ((self (ref ListIter))) (Maybe ptr)
  (let (c:ptr (self cur))
    (when (= c null) (return none))
    (.set! self cur (rest c))
    (return (some (first c)))))

(defn print-list (n:ptr):void
  (let ((lit (ref ListIter)) (alloca ListIter))
    (.set! lit cur n)
    (let (first-item:i32 1)
      (printf "(")
      (doseq-iter (elem lit)
        (let (node:ptr:Node (as ptr:Node elem))
          (when (= first-item 0) (printf " "))
          (cond (= (node kind) 0) (printf "%ld" (node i))
                (= (node kind) 2) (printf "%s" (node s))
                true                 (printf "?"))
          (set! first-item 0)))
      (printf ")\n"))))

(defn main ():int
  (let (xs:ptr '(a b c)
        ys:ptr '(1 2))
    (print-list xs)
    (print-list ys)
    (print-list (cons (first ys) xs))
    (print-list (append xs ys)))
  (return 0))

; Demonstrates list manipulation primitives over the unified Node type.
;
; A list Node is a header over an array of element pointers, so `cons` builds a
; fresh list rather than a cell (design/stage21-cleanup/ast-as-collection.md §5).

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use iterator)
(import-use node)   ; '(a b c) below builds lists at run time

(defn cons (car:ptr cdr:ptr):ptr
  (return (as ptr (node-cons car cdr 0))))

(defn first (n:ptr):ptr
  (return (node-first n)))

(defn rest (n:ptr):ptr
  (return (node-rest n)))

(defn append (a:ptr b:ptr):ptr
  (let (out:&Node (node-list-new 0))
    (node-extend out a)
    (node-extend out b)
    (return (node-list-done out))))

(defstruct ListIter cur:ptr)
(extend ListIter (Iterator ptr))
(defn next (self:&ListIter):?ptr
  (let (c:ptr (self 'cur))
    (when (= (node-len c) 0) (return none))
    (set! (self 'cur) (rest c))
    (return (some (first c)))))

(defn print-list (n:ptr):void
  (let (lit:&ListIter (alloca ListIter))
    (set! (lit 'cur) n)
    (let (first-item:i32 1)
      (printf "(")
      (doseq-iter (elem lit)
        (let (node:&Node (as &Node elem))
          (when (= first-item 0) (printf " "))
          (cond (= (node 'kind) 0) (printf "%ld" (node 'i))
                (= (node 'kind) 2) (printf "%s" (as ptr (symbol-as-cstr (node 's))))
                true                 (printf "?"))
          (set! first-item 0)))
      (printf ")\n"))))

(defn main ():int
  (let (xs:ptr '(a b c)
        ys:ptr '(1 2))
    (print-list xs)
    (print-list ys)
    (print-list (cons (first ys) xs))
    (print-list (append xs ys)))
  (return 0))

; R1-iter: ListIter — drive a cons-cell Node* list as an Iterator.
;
; Builds a cons list of INT nodes (10 20 30 40) and:
;   1. doseq-iter over a ListIter, printing each element's .i field.
;   2. reduce over a fresh ListIter, summing the .i fields (= 100).
;
; The element is a Node* yielded as ptr (niche-encoded Maybe ptr is matchable);
; a consumer recovers it with (cast ptr:Node e).

(import-use "stdio.h")
(import-use "stdlib.h")
; Explicit path: a bare (import-use nucleus.list) would resolve to examples/list.nuc
; (importer-dir is searched first), which has its own `main`. The path form
; reaches the library unambiguously.
(import-use "lib/nucleus/list.nuc")
(import-use nucleus.iterator)

; FoldFn: add the .i field of each list node (a Node*, arriving as a ptr) to acc.
(defstruct SumNodeI dummy:i32)
(extend SumNodeI (FoldFn i64 ptr))
(defn fold (self:&SumNodeI (acc i64) (x ptr)) i64
  (let (n:&Node (unsafe/cast &Node x))
    (return (+ acc (n 'i)))))

; int-node — a fresh INT node carrying value v.
; calloc, not malloc: `s` is a Symbol, which has no null value to assign — a
; node with no name is simply a zeroed one.
(defn int-node (v:i64):ptr
  (let (c:&Node (unsafe/cast &Node (calloc 1 (sizeof Node))))
    (set! (c 'kind) 0)
    (set! (c 'line) 0)
    (set! (c 'i) v)
    (return (as ptr c))))

(defn main ():i32
  (let (lst:ptr (cons (int-node 10)
                      (cons (int-node 20)
                            (cons (int-node 30)
                                  (cons (int-node 40) null)))))
    ; 1. doseq-iter: print each element's .i field.
    (let (it:ListIter (list-iter lst))
      (doseq-iter (x &it)
        (printf "elem=%lld\n" ((as &Node x) 'i))))
    ; 2. reduce: sum the .i fields.
    (let (sm:&SumNodeI (alloca SumNodeI)
          it:&ListIter (alloca ListIter))
      (set! (it 'cur) lst)
      (printf "sum=%lld\n" (reduce sm 0 it))))
  (return 0))

; R1-iter: SplitIter / LineIter conform to Iterator (replacing the done-flag-only
; API). Drives them through doseq-iter and reduce, and cross-checks identical
; behavior against the done-flag loop.
;
; Each segment is yielded as a StrView BY VALUE in a (Maybe StrView), so a
; consumer taking (ref StrView) needs (addr-of seg). Stage 17 A3.

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use "string.h")
(import-use iterator)
(import-use strview)
(import-use string-split)

; print-sv — print a StrView's bytes (copied to a NUL-terminated temp).
(defn print-sv ((sv (ref StrView))):void
  (with (n:usize (sv 'len)
         buf:ptr:ui8 (as ptr:ui8 (malloc (as i64 (+ n 1)))))
    (memcpy (as ptr buf) (as ptr (sv 'data)) (as i64 n))
    (set! (aref buf (as i64 n)) 0)
    (printf "%s" (as CStr (as ptr buf)))))

; FoldFn: sum segment byte-lengths. Segments arrive as StrView values (A3).
(defstruct SegLenSum dummy:i32)
(extend SegLenSum (FoldFn i64 StrView))
(defn fold ((self (ref SegLenSum)) (acc i64) (x StrView)) i64
  (return (+ acc (as i64 ((addr-of x) 'len)))))

; FoldFn: count segments (ignores the element).
(defstruct CountSeg dummy:i32)
(extend CountSeg (FoldFn i64 StrView))
(defn fold ((self (ref CountSeg)) (acc i64) (x StrView)) i64
  (return (+ acc 1)))

(defn main ():i32
  ; ---- 1. doseq-iter over SplitIter: "a,b,c" on "," -------------------------
  (let (sv__v:StrView (strview-from-cstr "a,b,c")
        sv:ptr:StrView (addr-of sv__v)
         sep__v:StrView (strview-from-cstr ",")
         sep:ptr:StrView (addr-of sep__v)
         it:SplitIter (strview-split sv sep))
    (doseq-iter (seg (addr-of it))
      (print-sv (addr-of seg))
      (printf "\n")))

  ; ---- 2. reduce over SplitIter: count segments + total length --------------
  ;        "a--b--c" on "--" → 3 segments, total length 3.
  (let (sv__v:StrView (strview-from-cstr "a--b--c")
        sv:ptr:StrView (addr-of sv__v)
         sep__v:StrView (strview-from-cstr "--")
         sep:ptr:StrView (addr-of sep__v)
         (cs (ref CountSeg)) (alloca CountSeg)
         (ls (ref SegLenSum)) (alloca SegLenSum)
         it1:SplitIter (strview-split sv sep)
         it2:SplitIter (strview-split sv sep))
    (printf "split-count=%lld\n" (reduce cs 0 (addr-of it1)))
    (printf "split-len-total=%lld\n" (reduce ls 0 (addr-of it2))))

  ; ---- 3. doseq-iter over LineIter: 3 lines ---------------------------------
  (let (sv__v:StrView (strview-from-cstr "line1\nline2\nline3")
        sv:ptr:StrView (addr-of sv__v)
         it:LineIter (strview-lines sv))
    (doseq-iter (ln (addr-of it))
                 (print-sv (addr-of ln))
                 (printf "\n")))

  ; ---- 4. parity: Iterator-driven == done-flag-driven, same segments --------
  (let (sv__v:StrView (strview-from-cstr "x,y,z,w")
        sv:ptr:StrView (addr-of sv__v)
         sep__v:StrView (strview-from-cstr ",")
         sep:ptr:StrView (addr-of sep__v)
         iter-acc:i32 0
         it:SplitIter (strview-split sv sep))
    (doseq-iter (seg (addr-of it))
      (when (> (seg 'len) 0)
            (set! iter-acc (+ iter-acc (as i32 (aref (seg 'data) 0))))))
    (with (flag-acc:i32 0
           it2:SplitIter (strview-split sv sep))
      (doseq-iter (s (addr-of it2))
        (when (> (s 'len) 0)
              (set! flag-acc (+ flag-acc (as i32 (aref (s 'data) 0))))))
      (printf "parity iter==flag: %d (%d)\n"
              (as i32 (if (= iter-acc flag-acc) 1 0)) iter-acc)))

  (return 0))

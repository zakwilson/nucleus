; R1 combinators — the SAME combinators (map / filter / find / any? / every?)
; driven over three different collection shapes, proving they are generic over any
; (Iterator E):
;   1. a Vector  (VecIter i32        — element type i32)
;   2. a cons-list of Node* cells (ListIter — element yielded as ptr, recovered
;      with (cast ptr:Node …))
;   3. a String's characters (CharIter — element type Char)
;
; The FNV-hash-as-reduce-over-the-byte-iterator equivalence is proven separately
; in examples/cstr-fold-test.nuc (the R1-iter byte-fold test).

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use vector)
(import-use iterator)
(import-use string)
(import-use combinators)
; explicit path: a bare (import-use list) resolves to examples/list.nuc.
(import-use "lib/list.nuc")

; calloc, not malloc: `s` is a Symbol, which has no null value to assign — a
; node with no name is simply a zeroed one.
(defn int-node (val:i64):ptr
  (let (c:&Node (as &Node (calloc 1 (sizeof Node))))
    (set! (c 'kind) 0) (set! (c 'line) 0) (set! (c 'i) val)
    (set! (c 'car) null) (set! (c 'cdr) null)
    (return (as ptr c))))

(defn main ():i32
  ; ===== 1. Vector (i32) =====
  (with (v:&(Vector i32) (alloca (Vector i32)))
    (vector-init v) (conj v 10) (conj v 20) (conj v 30) (conj v 40)
    (let ((it (VecIter i32)) (iter v))
      (let ((m (Vector i32)) (map (vfn (x:i32):i32 (return (/ x 10))) &it))
        (printf "vec map0=%d\n" (&m 0)) (drop &m)))
    (let ((it (VecIter i32)) (iter v))
      (let ((f (Vector i32)) (filter (vfn (x:i32):bool (return (> x 25))) &it))
        (printf "vec filter-count=%d\n" (count &f)) (drop &f)))
    (let ((it (VecIter i32)) (iter v))
      (match (find (vfn (x:i32):bool (return (> x 25))) &it)
        ((some fv) (printf "vec find=%d\n" fv)) (none (printf "vec find=none\n"))))
    (let ((it (VecIter i32)) (iter v))
      (printf "vec any=%d\n" (any? (vfn (x:i32):bool (return (> x 35))) &it)))
    (let ((it (VecIter i32)) (iter v))
      (printf "vec every=%d\n" (every? (vfn (x:i32):bool (return (> x 5))) &it))))

  ; ===== 2. cons-list of Node* (ListIter yields ptr) =====
  (let (lst:ptr (cons (int-node 10)
                      (cons (int-node 20)
                            (cons (int-node 30)
                                  (cons (int-node 40) null)))))
    ; map: Node* -> its .i field, into a (Vector i64)
    (let (it:&ListIter (alloca ListIter))
      (set! (it 'cur) lst)
      (let ((m (Vector i64))
            (map (vfn (e:ptr):i64 (return ((as &Node e) 'i))) it))
        (printf "lst map count=%d m0=%lld\n"
          (count &m) (as i64 (&m 0)))
        (drop &m)))
    ; filter: keep nodes with .i > 25 (the Node* survives as ptr)
    (let (it:&ListIter (alloca ListIter))
      (set! (it 'cur) lst)
      (let ((f (Vector ptr))
            (filter (vfn (e:ptr):bool (return (> ((as &Node e) 'i) 25))) it))
        (printf "lst filter-count=%d\n" (count &f))
        (drop &f)))
    ; find: first node with .i > 25
    (let (it:&ListIter (alloca ListIter))
      (set! (it 'cur) lst)
      (match (find (vfn (e:ptr):bool (return (> ((as &Node e) 'i) 25))) it)
        ((some e) (printf "lst find=%lld\n" ((as &Node e) 'i)))
        (none (printf "lst find=none\n"))))
    ; any / every over .i
    (let (it:&ListIter (alloca ListIter))
      (set! (it 'cur) lst)
      (printf "lst any=%d\n"
        (any? (vfn (e:ptr):bool (return (> ((as &Node e) 'i) 35))) it)))
    (let (it:&ListIter (alloca ListIter))
      (set! (it 'cur) lst)
      (printf "lst every=%d\n"
        (every? (vfn (e:ptr):bool (return (> ((as &Node e) 'i) 5))) it))))

  ; ===== 3. String characters (CharIter yields Char) =====
  (let (s:String (string-from-cstr-unchecked "hello"))
    (let (cit:CharIter (chars &s))
      (let ((m (Vector i32)) (map (vfn (c:Char):i32 (return (as i32 c))) &cit))
        (printf "str map0=%d count=%d\n"
          (&m 0) (count &m))
        (drop &m)))
    (let (cit:CharIter (chars &s))
      (let ((f (Vector Char)) (filter (vfn (c:Char):bool (return (!= c \l))) &cit))
        (printf "str filter-count=%d\n" (count &f))
        (drop &f)))
    (let (cit:CharIter (chars &s))
      (match (find (vfn (c:Char):bool (return (= c \e))) &cit)
        ((some c) (printf "str find=%d\n" c))
        (none (printf "str find=none\n"))))
    (let (cit:CharIter (chars &s))
      (printf "str any=%d\n" (any? (vfn (c:Char):bool (return (= c \l))) &cit)))
    (let (cit:CharIter (chars &s))
      (printf "str every=%d\n" (every? (vfn (c:Char):bool (return (!= c \z))) &cit)))
    (drop &s))
  (return 0))

; Stage 17 B1 — lib/nucleus/fmt.nuc: Writer, ToStr, and the `str` family.
;
; The replacement for a printf format string: arity and types are settled at
; macro expansion, so there is no format string to get wrong.
;
; design/stage17-native-strings/overview.md §2.5, §2.6.

(import-use "stdio.h")
(import-use nucleus.allocator)
(import-use nucleus.arena)
(import-use nucleus.strview)
(import-use nucleus.strview-str)
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use nucleus.create)

(extern stdout:ptr)

(defn show (s:&String):void
  (printf "%s\n" (string-as-cstr s)))

(defn main ():i32

  ; ---- ToStr, one conformance per line ---------------------------------------
  (let (s:String (make String))
    (to-str -9223372036854775808 s)         ; i64's minimum: negated unsigned
    (to-str \, s)
    (to-str 0 s)
    (to-str \, s)
    (to-str (as usize 18446744073709551615) s)
    (to-str \, s)
    (to-str true s)
    (to-str \, s)
    (to-str 1.5 s)
    (to-str \, s)
    (to-str (strview-from-cstr "view") s)
    (to-str \, s)
    (to-str c"cstr" s)
    (show s))

  ; ---- str-into: append into an existing String -------------------------------
  (let (n:i64 3 m:i64 7
        s:String (make String))
    (str-into s "expected " n " args, got " m)
    (show s))

  ; ---- str: build a fresh one -------------------------------------------------
  (let (t:String (str "x=" 42 " y=" 1.5 " ok=" true))
    (show t))

  ; Degenerate arities still expand.
  (let (e:String (str))
    (printf "empty=%d\n" (as i32 (str-empty? e))))
  (let (one:String (str "solo"))
    (show one))

  ; ---- str-alloc: same, over a caller-chosen allocator ------------------------
  (let (a:String (str-alloc g-arena "arena " 99))
    (show a))

  ; ---- Writer: a String and a FILE* take the same bytes -----------------------
  (let (w:String (make String))
    (write-str w (strview-from-cstr "to a String"))
    (show w))

  (let (out:CFile (cfile stdout))
    (write-str out (strview-from-cstr "to a CFile\n")))

  0)

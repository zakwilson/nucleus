; Stage 11 M6 (S5) — FromStr / parse tests.
;
; Tests:
;   1. (parse i32 "42") → 42
;   2. (parse i32 "-7") → -7
;   3. (parse i32 "abc") → error
;   4. (parse i32 "2147483647") → 2147483647 (i32 max)
;   5. (parse i32 "2147483648") → error (overflow)
;   6. (parse i64 "1000000000000") → 1000000000000
;   7. (parse i64 "-9223372036854775808") → i64 min
;   8. (parse f64 "3.14") → close to 3.14
;   9. (parse f64 "notanumber") → error
;  10. (parse i32 " 42") → error (leading whitespace rejected)
;  11. (parse i32 "42 ") → error (trailing whitespace)
;  12. (parse i32 "") → error (empty)

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use strview)
(import-use parse)

(defn main ():i32

  ; ---- 1. i32 success: "42" ---------------------------------------------------
  (let (sv:StrView (strview-from-cstr "42")
         r:!i32 (parse i32 sv))
    (match r
      ((ok v) (printf "i32-42=%d\n" v))
      ((err e) (printf "i32-42=err\n"))))

  ; ---- 2. i32 success: "-7" ---------------------------------------------------
  (let (sv:StrView (strview-from-cstr "-7")
         r:!i32 (parse i32 sv))
    (match r
      ((ok v) (printf "i32-neg7=%d\n" v))
      ((err e) (printf "i32-neg7=err\n"))))

  ; ---- 3. i32 error: "abc" ----------------------------------------------------
  (let (sv:StrView (strview-from-cstr "abc")
         r:!i32 (parse i32 sv))
    (match r
      ((ok v) (printf "i32-abc=ok\n"))
      ((err e) (printf "i32-abc=err\n"))))

  ; ---- 4. i32 max: "2147483647" -----------------------------------------------
  (let (sv:StrView (strview-from-cstr "2147483647")
         r:!i32 (parse i32 sv))
    (match r
      ((ok v) (printf "i32-max=%d\n" v))
      ((err e) (printf "i32-max=err\n"))))

  ; ---- 5. i32 overflow: "2147483648" ------------------------------------------
  (let (sv:StrView (strview-from-cstr "2147483648")
         r:!i32 (parse i32 sv))
    (match r
      ((ok v) (printf "i32-overflow=ok\n"))
      ((err e) (printf "i32-overflow=err\n"))))

  ; ---- 6. i64 success: "1000000000000" ----------------------------------------
  (let (sv:StrView (strview-from-cstr "1000000000000")
         r:!i64 (parse i64 sv))
    (match r
      ((ok v) (printf "i64-big=%lld\n" v))
      ((err e) (printf "i64-big=err\n"))))

  ; ---- 7. i64 min: "-9223372036854775808" -------------------------------------
  (let (sv:StrView (strview-from-cstr "-9223372036854775808")
         r:!i64 (parse i64 sv))
    (match r
      ((ok v) (printf "i64-min=%lld\n" v))
      ((err e) (printf "i64-min=err\n"))))

  ; ---- 8. f64 success: "3.14" -------------------------------------------------
  (let (sv:StrView (strview-from-cstr "3.14")
         r:!f64 (parse f64 sv))
    (match r
      ((ok v) (printf "f64-pi=%.2f\n" v))
      ((err e) (printf "f64-pi=err\n"))))

  ; ---- 9. f64 error: "notanumber" ---------------------------------------------
  (let (sv:StrView (strview-from-cstr "notanumber")
         r:!f64 (parse f64 sv))
    (match r
      ((ok v) (printf "f64-nan=ok\n"))
      ((err e) (printf "f64-nan=err\n"))))

  ; ---- 10. i32 error: " 42" (leading whitespace) ------------------------------
  (let (sv:StrView (strview-from-cstr " 42")
         r:!i32 (parse i32 sv))
    (match r
      ((ok v) (printf "i32-ws=ok\n"))
      ((err e) (printf "i32-ws=err\n"))))

  ; ---- 11. i32 error: "42 " (trailing whitespace) -----------------------------
  (let (sv:StrView (strview-from-cstr "42 ")
         r:!i32 (parse i32 sv))
    (match r
      ((ok v) (printf "i32-trail=ok\n"))
      ((err e) (printf "i32-trail=err\n"))))

  ; ---- 12. i32 error: "" (empty) ----------------------------------------------
  (let (sv:StrView (strview-from-cstr "")
         r:!i32 (parse i32 sv))
    (match r
      ((ok v) (printf "i32-empty=ok\n"))
      ((err e) (printf "i32-empty=err\n"))))

  ; ---- 13. i64 overflow: "99999999999999999999" ------------------------------
  ; Before the digit-walking rewrite this printed `ok 9223372036854775807`:
  ; `strtoll` clamps and reports the overflow only through `errno`, which the
  ; consumed-bytes check cannot see.
  (let (sv:StrView (strview-from-cstr "99999999999999999999")
         r:!i64 (parse i64 sv))
    (match r
      ((ok v) (printf "i64-overflow=ok %lld\n" v))
      ((err e) (printf "i64-overflow=err\n"))))

  ; ---- 14. i64 just past max: "9223372036854775808" ---------------------------
  (let (sv:StrView (strview-from-cstr "9223372036854775808")
         r:!i64 (parse i64 sv))
    (match r
      ((ok v) (printf "i64-past-max=ok %lld\n" v))
      ((err e) (printf "i64-past-max=err\n"))))

  ; ---- 15. ui64 max, and one past it ------------------------------------------
  (let (sv:StrView (strview-from-cstr "18446744073709551615")
         r:!ui64 (parse ui64 sv))
    (match r
      ((ok v) (printf "u64-max=%llu\n" v))
      ((err e) (printf "u64-max=err\n"))))
  (let (sv:StrView (strview-from-cstr "18446744073709551616")
         r:!ui64 (parse ui64 sv))
    (match r
      ((ok v) (printf "u64-overflow=ok\n"))
      ((err e) (printf "u64-overflow=err\n"))))
  (let (sv:StrView (strview-from-cstr "-1")
         r:!ui64 (parse ui64 sv))
    (match r
      ((ok v) (printf "u64-neg=ok\n"))
      ((err e) (printf "u64-neg=err\n"))))

  (return 0))

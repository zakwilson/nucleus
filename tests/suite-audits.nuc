; What holds across the whole tree, rather than about one program
;
; Design: design/stage18-tooling/overview.md §T6.6 and §T7.
;
; Two kinds of unit, and they are here together because they share the shape:
; the subject is a corpus or the source tree itself, not a fixture.
;
;   - The corpus walks — every `tests/fixtures/*.nuc` compiles without a line-0
;     location; every readable file in four directories reads the same through
;     `lib/read.nuc` as through `src/reader.nuc`. Both discover their inputs
;     from the directory, so a new file is covered with no edit here.
;
;   - The spawns — the struct-ABI and struct-layout oracles, the two generated-
;     artifact audits and the CStr residue audit. §T7 rules these stay outside
;     the framework, and that outside means *not rewritten, not unrun*: their
;     assertion is an external tool's output, so the unit runs the script and
;     requires exit 0. Reimplementing them here would buy a different spelling
;     of the same `spawn` and a second thing to keep in step.
;
; `s18-diagnostics-sexp` is neither, but it belongs beside them: it is the one
; unit that asserts about the diagnostic *stream* rather than about a
; diagnostic, so it is the only caller of `nucleusc-raw`.

; ---------------------------------------------------------------------------
; The external-toolchain oracles
; ---------------------------------------------------------------------------

; Phase C (design/stage8/platform.md): Nucleus<->C aggregate passing and
; returning must match the platform C ABI. A mismatch is silently catastrophic
; at the C boundary, which is why it gates rather than living in `make abi-test`.
(deftest abi-interop
  (try (require-cc))
  (try (check-script-ok "./tests/run-abi-test.sh" ""))
  (return (ok)))

; Phase E: the same for sizeof and field offsets over the question-14 corpus.
; tests/layout/structs.h is the shared source of truth and `cc` is the oracle.
(deftest layout
  (try (require-cc))
  (try (check-script-ok "./tests/run-layout-test.sh" ""))
  (return (ok)))

; ---------------------------------------------------------------------------
; The source-tree audits
; ---------------------------------------------------------------------------

; Stage 15 W4e: docs/stdlib.md's availability tables are generated by probing
; the compiler, not hand-curated. Deliberately not byte-exact — availability is
; host and libc dependent — so the script fails only when a name the COMMITTED
; doc claims as available no longer probes as available here.
(deftest stdlib-table-generated
  (try (check-script-ok "python3" "scripts/gen-stdlib-table.py --check"))
  (return (ok)))

; lib/*.nuch and lib/*.h are generated and committed, and nothing in the build
; reads the committed copies — so a change to src/nuch.nuc or src/cheader.nuc
; leaves them describing a library that no longer exists, with no failure
; anywhere. Byte-exact, unlike the table above: header emission is a pure
; function of the source.
(deftest headers-generated
  (try (check-script-ok "./scripts/check-headers.sh" ""))
  (return (ok)))

; Stage 17 C8: what is left of CStr and libc's str* family in src/ is the FFI
; boundary itself, enumerated in scripts/cstr-allowlist.txt. Fails in both
; directions — a new C-string site cannot appear silently, and a conversion that
; removes one cannot leave the list describing a compiler that no longer exists.
(deftest cstr-residue
  (try (check-script-ok "python3" "scripts/check-cstr.py"))
  (return (ok)))

; Stage 20 M5: `repl-snapshot`/`repl-restore` drive off two tables now, but a
; field added to `defstruct ReplState` with no row in either still compiles —
; and still leaks that global from one prompt into the next, which no REPL
; golden would notice unless it happened to name the global. Exact and in both
; directions, so the tables stay diffable against the struct field for field.
(deftest repl-roster
  (try (check-script-ok "python3" "scripts/check-repl-roster.py"))
  (return (ok)))

; ---------------------------------------------------------------------------
; Stage 15 W4a: no diagnostic reports line 0
; ---------------------------------------------------------------------------

; Every fixture is a potential error producer, so compile them all. This is the
; check that stops the class from regrowing: a diagnostic raised from a context
; that has lost the node — an interned symbol, a registration or inference phase
; — trips here rather than reaching a user.
;
; The shell version grepped stderr for the bytes `:0:`, which any message
; containing them also satisfies; `check-no-line-zero` reads the `line` field.
(deftest w4a-no-line-zero
  (let (d:DirEntries (try (read-dir "tests/fixtures"))
        n:usize (dir-count (addr-of d))
        i:usize 0
        seen:i64 0)
    (while (< i n)
      (let (nm:StrView (dir-name (addr-of d) i))
        (when (strview-has-suffix nm ".nuc")
          (let (p:String (str "tests/fixtures/" nm)
                c:Compiled (try (compile-path (string-as-view (addr-of p)))))
            (try (check-no-line-zero (addr-of c 'diags)))
            (set! seen (+ seen 1))
            (drop (addr-of c))
            (drop (addr-of p)))))
      (set! i (+ i 1)))
    (drop (addr-of d))
    ; A sweep that swept nothing passes every assertion it never made.
    (try (check (> seen 0) "tests/fixtures to hold at least one .nuc")))
  (return (ok)))

; ---------------------------------------------------------------------------
; Stage 18 TF-3: lib/read.nuc agrees with src/reader.nuc
; ---------------------------------------------------------------------------

(defn dump-ast (path:StrView):!Ran
  (let (c:Command (command (compiler-path)))
    (command-arg (addr-of c) "--dump-ast")
    (command-arg (addr-of c) path)
    (let (r:Ran (try (ran (addr-of c))))
      (drop (addr-of c))
      (return (ok r)))))

(defn read-dump (path:StrView):!Ran
  (let (c:Command (command "./build/readdump"))
    (command-arg (addr-of c) path)
    (let (r:Ran (try (ran (addr-of c))))
      (drop (addr-of c))
      (return (ok r)))))

; Both readers print the same canonical text, so a tree difference is a diff.
; Collection literals (`[…]`, `{…}`, `#{…}`) are lib/read.nuc's one documented
; exclusion — their desugaring infers an element type, which is compiler work —
; and a rejection for any OTHER reason is a failure, so the exclusion cannot
; quietly grow. Files the compiler itself cannot parse are the reader-error
; fixtures and say nothing about the two readers agreeing.
(defn reader-parity-over (dir:StrView):!void
  (let (d:DirEntries (try (read-dir dir))
        n:usize (dir-count (addr-of d))
        i:usize 0
        agreed:i64 0)
    (while (< i n)
      (let (nm:StrView (dir-name (addr-of d) i))
        (when (strview-has-suffix nm ".nuc")
          (let (p:String (str dir "/" nm)
                pv:StrView (string-as-view (addr-of p))
                a:Ran (try (dump-ast pv)))
            (when (a 'ok?)
              (let (b:Ran (try (read-dump pv)))
                (if (b 'ok?)
                    (do (try (check-golden-in pv (string-as-view (addr-of b 'out))
                                              (string-as-view (addr-of a 'out))))
                        (set! agreed (+ agreed 1)))
                    (when (not (contains? (string-as-view (addr-of b 'err))
                                          "collection literals"))
                      (fail! pv ": lib/read.nuc refused it, and not for collection"
                             " literals\n     "
                             (test-show (string-as-view (addr-of b 'err))))))
                (drop (addr-of b))))
            (drop (addr-of a))
            (drop (addr-of p)))))
      (set! i (+ i 1)))
    (drop (addr-of d))
    (let (what:String (str dir " to hold a file both readers accept"))
      (try (check (> agreed 0) (string-as-view (addr-of what))))
      (drop (addr-of what))))
  (return (ok)))

(deftest reader-parity-tests-fixtures
  (try (reader-parity-over "tests/fixtures"))
  (return (ok)))

(deftest reader-parity-examples
  (try (reader-parity-over "examples"))
  (return (ok)))

(deftest reader-parity-lib
  (try (reader-parity-over "lib"))
  (return (ok)))

(deftest reader-parity-src
  (try (reader-parity-over "src"))
  (return (ok)))

; ---------------------------------------------------------------------------
; Stage 18 TF-5: --diagnostics=sexp
; ---------------------------------------------------------------------------

; The structured back-end must carry exactly what the text one prints, and carry
; it as FIELDS — one form per diagnostic, notes as a `notes` operand rather than
; as trailing lines. Two independent greps over one stderr blob cannot tell a
; location on a note from a location on the error; a field comparison can.
;
; The text back-end's byte-identity is not asserted here beyond claim 5: the IR
; snapshot's `.ll.err` artifacts compare every fixture's diagnostic text byte
; for byte.
(deftest s18-diagnostics-sexp
  ; 1. An error: one form, on one line, with an empty `notes`. 5. `text` is the
  ;    default, and naming it explicitly is a no-op — asserted against the same
  ;    file so "the location the text mode printed" is a comparison rather than
  ;    a remark, and pinned, because two empty streams are also equal.
  (let (p:String (try (test-write-file "e1.nuc" "(defstruct Pt x:i32 y:i32)
(defn f ((p (ref Pt))):i32 (return (p 'z)))
(defn main ():i32 (return 0))
"))
        pv:StrView (string-as-view (addr-of p))
        sexp:String (str "(diagnostic (severity error) (file \"" pv "\") (line 2)"
                         " (message \"get: no field 'z' on struct 'Pt'\") (notes))\n")
        text:String (str pv ":2: error: get: no field 'z' on struct 'Pt'\n")
        s:Ran (try (nucleusc-raw "--diagnostics=sexp" pv))
        a:Ran (try (nucleusc-raw "" pv))
        b:Ran (try (nucleusc-raw "--diagnostics=text" pv)))
    (try (check-golden (string-as-view (addr-of s 'err)) (string-as-view (addr-of sexp))))
    (try (check-golden (string-as-view (addr-of a 'err)) (string-as-view (addr-of text))))
    (try (check-golden (string-as-view (addr-of b 'err)) (string-as-view (addr-of text))))
    (drop (addr-of b)) (drop (addr-of a)) (drop (addr-of s))
    (drop (addr-of text)) (drop (addr-of sexp)) (drop (addr-of p)))

  ; 2. A note is a FIELD. The text mode prints it as a `  note: ` line, which is
  ;    where it lives inside the message today — the split is the whole point,
  ;    and the note is checked against the record it belongs to rather than
  ;    found somewhere in the blob.
  (let (c:Compiled (try (compile-path "tests/fixtures/g5-noinit-ref.nuc")))
    (try (check-note-at (addr-of c 'diags) "tests/fixtures/g5-noinit-ref.nuc" 12
                        "give it an initializer, or declare it nullable"))
    (try (check-eq-int (count-matching-lines (string-as-view (addr-of c 'raw)) "?*")
                       1 "a diagnostic on exactly one line"))
    (drop (addr-of c)))

  ; 3. Warnings are diagnostics too — a mode that structured only errors would
  ;    hand a reader a stream it cannot parse.
  (let (p:String (try (test-write-file "w1.nuc" "(ns alpha)
(ns beta)
(defn main ():i32 (return 0))
"))
        pv:StrView (string-as-view (addr-of p))
        c:Compiled (try (compile-path pv)))
    (try (check-diagnostic (addr-of c 'diags) "warning" pv 2
                           "second ns directive"))
    (drop (addr-of c))
    (drop (addr-of p)))

  ; 4. A field carrying a `"` survives the round trip. The path is the reachable
  ;    one — a filename may hold any byte — and it exercises the same escaper
  ;    every field uses. `readdump` reprints the canonical form, so the check is
  ;    that lib/read.nuc read back the bytes the compiler wrote.
  (let (p:String (try (test-write-file "a\"b.nuc" "(defn main ():i32 (return (nope 1)))\n"))
        pv:StrView (string-as-view (addr-of p))
        r:Ran (try (nucleusc-raw "--diagnostics=sexp" pv))
        ev:StrView (string-as-view (addr-of r 'err)))
    (try (check-contains ev "a\\\"b.nuc"))
    (let (q:String (try (test-write-file "q1.sexp" ev))
          back:Ran (try (read-dump (string-as-view (addr-of q)))))
      (when (not (back 'ok?))
        (fail! "lib/read.nuc could not read the sexp diagnostic\n     "
               (test-show (string-as-view (addr-of back 'err)))))
      (try (check-golden (string-as-view (addr-of back 'out)) ev))
      (drop (addr-of back))
      (drop (addr-of q)))
    (drop (addr-of r))
    (drop (addr-of p)))
  (return (ok)))

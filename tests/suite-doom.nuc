; Fixes for the nuc-doom port's ISSUES.md rulings of 2026-11-02
; (design/doom-port-fixes/overview.md). Diagnostics are rows in
; tests/manifest/diagnostics.edn; the units here run programs.

(import-use nucleus.string)
(import-use nucleus.strview)
(import-use nucleus.test)
(import-use nucleus.fmt)
(import-use nucleus.file)

; ISSUE-043: an `(ok)` with no want takes the function's result type.
(deftest doom-ok-statement
  (let (out:String (try (build-run-source "(import-use nucleus.error)
(import-use \"stdio.h\")
(defn f (x:i32):!void (ok) (when (> x 0) (ok)) (ok))
(defn g (x:i32):!i32 (ok 5) (ok x))
(defn main ():i32
  (f 1)
  (match (g 3) ((ok v) (printf \"%d\\n\" v)) ((err e) 0))
  0)
"))
        ov:StrView (string-as-view &out))
    (try (check-eq (strview-trim-end &ov) "3"))
    (drop &out)))

; ISSUE-006: a header's `extern` variables are imported; a Nucleus definition
; of the same name still wins, and an explicit extern is the same symbol.
(deftest doom-c-header-variables
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use \"unistd.h\")
(import-use \"time.h\")
(extern stdout:ptr)
(defn timezone ():i32 7)
(defn main ():i32
  (fprintf stderr \"e\\n\")
  (fprintf stdout \"optind=%d tz=%d\\n\" optind (timezone))
  0)
"))
        ov:StrView (string-as-view &out))
    (try (check-eq (strview-trim-end &ov) "e\noptind=1 tz=7"))
    (drop &out)))

; ISSUE-011: an array extent with `?:`, a comparison or an enumerator folds,
; so the struct lays out as C lays it out instead of turning opaque.
(deftest doom-c-extent-conditional
  (let (dir:String (try (test-scratch-sub "ext"))
        dv:StrView (string-as-view &dir))
    (let (h:String (try (write-into dv "ext.h" "enum { EXT_N = 3 };
typedef union { int type; unsigned char padding[sizeof(void *) <= 8 ? 56 : sizeof(void *) == 16 ? 64 : 3 * sizeof(void *)]; } Ev;
struct Row { int cells[EXT_N]; char flags[(1 && 2) + (4 > 3) + !0]; };
"))
          m:String (try (write-into dv "main.nuc" "(import-use \"ext.h\")
(import-use \"stdio.h\")
(defn main ():i32
  (let (e:&Ev (alloca Ev))
    (set! (e 'type) 5)
    (printf \"%d %d %d\\n\" (unsafe/cast i32 (sizeof Ev)) (unsafe/cast i32 (sizeof Row)) (e 'type)))
  0)
"))
          cf:String (str "--cflag=-I" dv)
          out:String (try (build-run-file dv (string-as-view &cf) (string-as-view &m)))
          ov:StrView (string-as-view &out))
      (try (check-eq (strview-trim-end &ov) "56 16 5"))
      (drop &out) (drop &cf) (drop &m) (drop &h))
    (drop &dir)))

; ISSUE-015: an absolute entry beside a relative `-I` reached a cycle member
; under both spellings and loaded it twice.
(deftest doom-import-one-spelling
  (let (dir:String (try (test-scratch-sub "sp"))
        dv:StrView (string-as-view &dir))
    (let (sub:String (str dv "/dsp"))
      (try (make-dir (string-as-view &sub)))
      (drop &sub))
    (let (a:String (try (write-into dv "dsp/a.nuc" "(ns dsp.a)
(import-use dsp.b)
(defn a-one ():i32 (b-one))
"))
          b:String (try (write-into dv "dsp/b.nuc" "(ns dsp.b)
(import-use dsp.a)
(defn b-one ():i32 1)
"))
          m:String (try (write-into dv "main.nuc" "(import-use \"stdio.h\")
(import-use dsp.a)
(defn main ():i32 (printf \"%d\\n\" (a-one)) 0)
"))
          abs:String (try (real-path (string-as-view &m)))
          out:String (try (build-run-file dv "" (string-as-view &abs)))
          ov:StrView (string-as-view &out))
      (try (check-eq (strview-trim-end &ov) "1"))
      (drop &out) (drop &abs) (drop &m) (drop &b) (drop &a))
    (drop &dir)))

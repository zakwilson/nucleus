; Stage 22 ED-4.3: a String key would leak (HashMap never drops keys), so it is
; not an EDN key type and the map has no codec.
(import-use nucleus.string)
(import-use nucleus.hashmap)
(import-use nucleus.edn)
(defn main ():i32
  (let (m:&(HashMap String i32) (alloca (HashMap String i32))
        n:?&Node null)
    (edn-read m n)
    (return 0)))

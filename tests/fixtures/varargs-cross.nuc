; Linked with no libc by tests/run-varargs-cross-test.sh.
(declare c_list (n:i32 ap:VaList):i64)

(defn n_list (n:i32 ap:VaList):i64
  (let (t:i64 0 i:i32 0)
    (while (< i n)
      (set! t (+ t (as i64 (unsafe/va-arg ap i32))))
      (set! t (+ t (unsafe/cast i64 (unsafe/va-arg ap f64))))
      (inc! i))
    (return t)))

(defn n_sum (n:i32 :varargs ap):i64
  (return (n_list n ap)))

(defn n_copy (n:i32 :varargs ap):i64
  (let (a:i64 0)
    (with (aq (va-copy ap))
      (set! a (n_list n aq)))
    (return (+ a (c_list n ap)))))

; Stage 19 P3: the job-pool primitives. Children are spawned in one order and
; must be reaped in COMPLETION order — which is what `wait-any` is for and what
; no per-child call can express.
(import-use process)
(import-use io)
(import-use strview)

(defn spawn-sh (script:StrView):!Process
  (let (c:Command (command "sh"))
    (command-arg &c "-c")
    (command-arg &c script)
    (let (r:!Process (spawn &c))
      (drop &c)
      (return r))))

(defn main ():i32
  (let (a:Process (unwrap (spawn-sh "sleep 0.6; exit 1"))
        b:Process (unwrap (spawn-sh "sleep 0.2; exit 2"))
        c:Process (unwrap (spawn-sh "sleep 0.4; exit 3")))
    ; b is still running: try-wait must say so rather than block.
    (if (unwrap (process-try-wait &b))
      (print "try-wait: unexpectedly done\n")
      (print "try-wait: still running\n"))
    (let (i:i32 0)
      (while (< i 3)
        (match (wait-any)
          ((ok ce) (print "reaped " (exit-code (ref ce 'status)) "\n"))
          ((err e) (print "wait-any failed\n")))
        (set! i (+ i 1))))
    ; All three are gone; the handles must not try to reap them again.
    (process-detach &a)
    (process-detach &b)
    (process-detach &c))
  ; kill: a child that would otherwise outlive the test.
  (let (p:Process (unwrap (spawn-sh "sleep 30")))
    (match (process-kill &p 9)
      (ok
       (match (process-wait &p)
         ((ok st)
          (match st
            ((exited code) (print "killed: exited " code "\n"))
            ((signaled sig) (print "killed: signal " sig "\n"))))
         ((err e) (print "killed: wait failed\n"))))
      ((err e) (print "kill failed\n"))))
  (return 0))

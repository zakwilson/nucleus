; Stage 24 BD-1 — a borrowing box over a with-owned value carries the with taint.
(import-use nucleus.io)
(import-use nucleus.allocator)
(defprotocol Show (show (self:&Self):i32))
(defstruct Pt x:i32)
(defn show (self:&Pt):i32 (return (self (quote x))))
(extend Pt Show)
(import-use nucleus.coll)
(defstruct Res y:i32)
(defn show (self:&Res):i32 (return (self (quote y))))
(defn drop (self:&Res):void (return))
(extend Res Show)
(extend Res Drop)
(defn leak ():(dyn &Show)
  (with (r (Res 1))
    (return r)))

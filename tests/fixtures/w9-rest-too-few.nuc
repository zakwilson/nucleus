; Stage 15 W9 defect 12: a `&rest` callee folds its trailing arguments into one
; Node list, so its fixed prefix is `num-params - 1` and anything at or above
; that is legal. Here: one below the fixed prefix.
(defn r (a:i32 b:i32 &rest xs:i64):i64 (return 0))

(defn main ():i32
  (r 1)
  (return 0))

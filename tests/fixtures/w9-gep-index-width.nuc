; Stage 15 W9 item 15: a GEP index is sized by the TARGET POINTER, not hardcoded
; to i64. Every indexing form is here, with an index type on each side of the
; AVR pointer width (i16) and one exactly on it, because the old code was wrong
; in two different ways: an index at or above the pointer width was left alone
; while the annotation still said `i64` (a register/annotation mismatch the LLVM
; parser rejects outright), and a narrower one was widened to a real i64 —
; 64-bit arithmetic on an 8-bit MCU, well-formed but absurd.
;
; `(exclude-prelude)` so the unit is freestanding and compiles for --target=avr;
; the host path is asserted from the same file (see run_w9_gep_index_width).

(exclude-prelude)

; Exactly the target pointer width on AVR (i16) — the everyday spelling, and the
; one the old code broke: no widening happened, so `i64 %t` named an i16.
(defn at-usize (p:ptr:ui8 i:usize):ui8
  (return (aref p i)))

; Wider than an AVR pointer — must narrow (trunc), a branch unreachable on LP64.
(defn at-i32 (p:ptr:ui8 i:i32):ui8
  (return (aref p i)))

; Narrower than an AVR pointer — must widen to i16 there, i64 on a host.
(defn at-i8 (p:ptr:ui8 i:i8):ui8
  (return (aref p i)))

(defn store-usize (p:ptr:ui8 i:usize v:ui8):void
  (aset! p i v))

(defn store-i32 (p:ptr:ui8 i:i32 v:ui8):void
  (aset! p i v))

; `unsafe/ptr+` shares the same rule via gep-index-ir; it had its own copy.
(defn bump-i32 (p:ptr:ui8 i:i32):ptr:ui8
  (return (unsafe/ptr+ p i)))

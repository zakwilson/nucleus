; Stage 17 C6: string literals meeting at a cond/if/match phi in a `StrView`
; slot. They used to collapse to CStr unconditionally, so the phi carried bare
; data pointers and the aggregate return then read a length off the end of a
; pointer-sized slot — silent garbage, not a verifier error.
(import-use strview)
(import-use string)
(import-use fmt)
(import-use io)

; The shape that broke: `ptr-int-ir` in the compiler itself.
(defn width-ir (bytes:i32):StrView
  (if (= bytes 2) "i16"
    (if (= bytes 4) "i32" "i64")))

; A literal arm meeting a computed one — the sibling must not force the collapse.
(defn name-of (n:i32 (out (ref String))):StrView
  (if (= n 0) "none"
    (do (str-into out "n=" n)
        (string-as-view out))))

; A match arm, through the Maybe niche.
(defn describe ((m (Maybe (ref i32)))):StrView
  (match m
    (none "absent")
    ((some _p) "present")))

; …and the collapse itself, which a C-string slot still depends on.
(defn tag (n:i32):CStr
  (if (= n 0) "zero" "other"))

(defn main ():int
  (println (width-ir 2))
  (println (width-ir 4))
  (println (width-ir 8))
  (let (v:StrView (width-ir 2))
    (println (strview-byte-len v)))
  (let ((b String) (string-new))
    (println (name-of 0 b))
    (println (name-of 7 b)))
  (let (n:i32 3)
    (println (describe (some &n)))
    (println (describe null)))
  (println (strview-from-cstr (tag 0)))
  (println (strview-from-cstr (tag 1)))
  (return 0))

; A `declare` with `:varargs` takes extra arguments; a plain one no longer does
; (w9-declare-extra-args.nuc). Fewer is still an error (w9-declare-too-few.nuc).
(exclude-prelude)

(declare printf (fmt:CStr :varargs):i32)

(defn main ():i32
  (printf "none\n")
  (printf "one %d\n" 1)
  (printf "six %d %d %d %d %d\n" 1 2 3 4 5)
  (return 0))

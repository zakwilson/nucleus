; Frame taint is a property of an address. Every store below loads through the
; pointer into a by-value slot, so nothing here escapes:
;   * a defvar of by-value struct/Vector type from a literal (the copy owns the
;     Vector's heap buffer);
;   * a by-value struct returned from an alloca'd or literal-backed pointer;
;   * a match/cond join whose arms are borrowed, not frame-local, pointers;
;   * a frame address assigned to a global inside an ordinary function — an
;     intra-frame borrow with a paired reset (the with-handler shape), which
;     only the initializer-function sink refuses;
;   * a void function whose last form is a tainted set! (nothing leaves it).
(import-use "stdio.h")
(import-use nucleus.vector)
(defstruct Pt x:i32 y:i32)
(defvar options:(Vector i32) [500 1000 1500 2000 2500])
(defvar gp:Pt (Pt 3 4))
(defvar gb:?&Pt null)
(defn make-pt ():Pt
  (let (p:&Pt (alloca Pt))
    (set! (p 'x) 7)
    (set! (p 'y) 8)
    (return p)))
(defn make-pt2 ():Pt (Pt 5 6))
(defn make-vec ():(Vector i32) [1 2 3])
(defn pick (c:i32 a:&Pt b:&Pt):&Pt (if (!= c 0) a b))
(defn borrow-then-reset ():void
  (let (p:Pt (Pt 9 9))
    (set! gb &p)
    (set! gb null)))
(defn main ():i32
  (let (q:Pt (make-pt) r:Pt (make-pt2) v:(Vector i32) (make-vec) w:(Vector i32) [4 5 6])
    (borrow-then-reset)
    (printf "%d %d %d %d %d %d %d %d\n" (&options 2) (count &options) (gp 'x) (q 'y) (r 'x)
            (&v 0) (&w 2) ((pick 0 &gp &q) 'x))
    (return 0)))

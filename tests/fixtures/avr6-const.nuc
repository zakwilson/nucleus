; Stage 14 AVR-6 (design/stage14/avr-targets.md §5): an aggregate `defconst` emits
; an LLVM `constant`, so a mapped-flash AVR part keeps the table in flash.
(defconst table (array i32 42 7))
(defvar mutable-count:i32 0)

(defn main ():i32
  (set! mutable-count (aref table 0))
  (return mutable-count))

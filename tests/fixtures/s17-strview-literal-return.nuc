; Stage 17 C6: a bare string literal returned from a `StrView` function. The
; return goes through the struct-return path, which did not run the coercion
; that materializes the chameleon literal into {ptr,len} — so LLVM rejected the
; `store %StrView <bare ptr>` with no source location at all.
(import-use strview)
(import-use io)

(defn advice ():StrView
  (return "break the cycle"))

(defn pick (n:i32):StrView
  (when (= n 0) (return "zero"))
  (return (advice)))

(defn main ():int
  (println (pick 0))
  (println (pick 1))
  (let (v:StrView (pick 1))
    (println (strview-byte-len v)))
  (return 0))

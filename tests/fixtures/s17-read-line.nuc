; Stage 17 B2 — `read-line` over buffered fd 0. Fed by `s17-read-line` in
; tests/suite-runtime.nuc; not an example, because an example inherits the harness's
; stdin and would block on a terminal.
;
; Covers: an ordinary line, an empty line, a final line with no terminator, and
; `none` at end of input.

(import-use nucleus.strview)
(import-use nucleus.strview-str)
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use nucleus.io)

(defn main ():i32
  (let (n:i64 0
        go:bool true)
    (while go
      (match (read-line)
        ((some ln) (set! n (+ n 1))
                   (println n ": [" (string-as-view ln) "] len=" (byte-len ln)))
        ((none) (set! go false)))))
  (println "eof")
  0)

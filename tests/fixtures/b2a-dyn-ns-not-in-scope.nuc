; Stage 15 B2a — the `(dyn P)` half of tests/fixtures/b2a-ns-not-in-scope.nuc.
;
; B2a put the scope gate at box CONSTRUCTION because `dyn-type` runs during
; `prescan-defn-signatures`, where the import environment is empty.
;
; Stage 15 B6 MOVED it to the annotation site — same rejection, same line,
; reached differently: the question is recorded where the spelling is and asked
; by `drain-dyn-annots` once the whole graph is in (name-resolution.md §9.5).
; Box construction now does a KEY lookup and asks no scope question, because a
; box carries its protocol's CANONICAL name and that is not nameable through a
; prefix. The tenth defect this header used to record as open — a
; `(dyn nope/Absent)` ANNOTATION fabricating a box type — closed with it;
; b6-dyn-annot-unknown.nuc is its pin.
;
; The `extend` is spelled through the prefix this file binds, so the ONLY thing
; wrong here is the `(dyn …)` spelling — otherwise the conformance failure would
; mask the scope failure.
(import-use "stdio.h")
(import-use allocator)
(import-prefixed nsdescribe dpx)

(defstruct Cat n:i32)
(defn describe ((self (ref Cat))):i32 (return (+ 100 (self n))))
(extend Cat dpx/Describe)

(defn main ():i32
  (let (a:(dyn dp/Describe) (Cat 5))
    (printf "%d\n" (describe a)))
  (return 0))

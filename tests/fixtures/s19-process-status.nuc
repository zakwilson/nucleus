; Stage 19 P1: spawn/wait and the typed exit status. WIFEXITED and friends are
; function-like macros the header importer does not admit, so the wait-status
; layout is decoded in lib/nucleus/process.nuc — this is what checks the decoding.
(import-use nucleus.process)
(import-use nucleus.io)
(import-use nucleus.strview)

(defn run-sh (script:StrView):i32
  (let (c:Command (command "sh"))
    (command-arg &c "-c")
    (command-arg &c script)
    (match (spawn &c)
      ((ok p)
       (match (process-wait &p)
         ((ok st) (drop &c) (return (exit-code &st)))
         ((err e) (drop &c) (return -2))))
      ((err e) (drop &c) (return -1)))))

(defn main ():i32
  (print "zero " (run-sh "exit 0") "\n")
  (print "three " (run-sh "exit 3") "\n")
  (print "killed " (run-sh "kill -9 $$") "\n")
  ; A program that is not on PATH: the child's failed exec, not a spawn error.
  (let (c:Command (command "s19-definitely-no-such-program"))
    (match (spawn &c)
      ((ok p)
       (match (process-wait &p)
         ((ok st) (print "noexec " (exit-code &st) "\n"))
         ((err e) (print "noexec wait-failed\n"))))
      ((err e) (print "noexec spawn-failed\n")))
    (drop &c))
  ; The arm a signalled child takes, seen directly rather than through exit-code.
  (let (c2:Command (command "sh"))
    (command-arg &c2 "-c")
    (command-arg &c2 "kill -15 $$")
    (match (spawn &c2)
      ((ok p)
       (match (process-wait &p)
         ((ok st)
          (match st
            ((exited code) (print "unexpected exit " code "\n"))
            ((signaled sig) (print "signal " sig "\n"))))
         ((err e) (print "wait-failed\n"))))
      ((err e) (print "spawn-failed\n")))
    (drop &c2))
  (return 0))

; Stage 21 R-4 (design/stage21-cleanup/one-reader.md §3, §6.6): the reader has
; no 4095-byte cap. A 6003-byte literal as a global, a macro body (which
; --emit-nuch exports) and a local, in one file; three lengths on stdout.
(import-use nucleus.node)
(defvar big:CStr c"")
(defmacro bigm () '"")
(defn main ():i32
  (let (s:StrView ""
        m:StrView (bigm))
    (printf "%d %d %d
" (unsafe/cast i32 (s 'len)) (unsafe/cast i32 (strlen big)) (unsafe/cast i32 (m 'len)))
    (printf "%.10s...%s
" (s 'data) (unsafe/ptr+ (s 'data) 5990))
    (return 0)))

; Stage 18 TF-6 category (c) — the declarations a header mode must refuse.
;
; Design: design/stage18-tooling/overview.md §T6.6; W9 items 38 and 45 in
; design/stage15-stress-test/progress.md.
;
; A header mode runs the compile first, so each unit asks one file two
; questions: `--emit-llvm` refuses it at a located error, and each header mode
; produces the IDENTICAL diagnostic list, no output, and exit 1 (not merely
; nonzero: a segfault also produces no output).

; ---------------------------------------------------------------------------
; The three modes on one file
; ---------------------------------------------------------------------------

; The rendered diagnostic lists are compared rather than a message quoted per
; mode: the fix routes all three through one chokepoint, and comparing them is
; what pins that. Three quoted copies would drift and never notice.
(import-use nucleus.test)
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use nucleus.strview)
(defn check-header-mode-agrees (dir:StrView path:StrView (want (ref Compiled))
                                flag:StrView):!void
  (let (c:Compiled (try (emit-checked dir flag path)))
    (when (!= (c 'exit) 1)
      (fail! flag " exited " (as i64 (c 'exit)) ", not 1\n     "
             (test-show (string-as-view (ref c 'raw-text)))))
    ; A header mode that refuses must print no header: a consumer that reads
    ; stdout regardless would otherwise commit a file describing nothing.
    (try (check-empty (compiled-ir &c)))
    (let (a:String (diag-list-text (ref want 'diags))
          b:String (diag-list-text (ref c 'diags)))
      (when (!= (string-as-view &a) (string-as-view &b))
        (fail! flag " and --emit-llvm disagree.\n     --emit-llvm:"
               (string-as-view &a) "\n     " flag ":"
               (string-as-view &b)))
      (drop &b)
      (drop &a))
    (drop &c))
  (return (ok)))

(defn check-refused-alike (dir:StrView path:StrView line:i32 msg:StrView):!void
  (let (c:Compiled (try (emit-checked dir "--emit-llvm" path)))
    (when (!= (c 'exit) 1)
      (fail! "--emit-llvm exited " (as i64 (c 'exit)) ", not 1\n     "
             (test-show (string-as-view (ref c 'raw-text)))))
    (try (check-error-at (ref c 'diags) path line msg))
    (try (check-header-mode-agrees dir path &c "--emit-cheader"))
    (try (check-header-mode-agrees dir path &c "--emit-nuch"))
    (drop &c))
  (return (ok)))

; A one-form probe. Both tables below are a head and a shape, so the fixture is
; a line of source and the location is always line 1.
(defn check-probe-refused (src:StrView msg:StrView):!void
  (let (dir:StrView (try (test-scratch))
        p:String (try (test-write-file "probe.nuc" src)))
    (try (check-refused-alike dir (string-as-view &p) 1 msg))
    (drop &p))
  (return (ok)))

; ---------------------------------------------------------------------------
; W9 item 38: the shapes the prescan accepted and the header emitter dropped
; ---------------------------------------------------------------------------

; The three fixtures that segfaulted: a missing return operand, an empty-list
; parameter, and an empty-list member of an inline union.
(deftest w9-cheader-missing-ret
  (try (check-refused-alike "" "tests/fixtures/s1-missing-ret.nuc" 4
         "defn 'foo': expected return type after the parameter list"))
  (return (ok)))

(deftest w9-cheader-empty-param
  (try (check-refused-alike "" "tests/fixtures/w5f-empty-param.nuc" 7
         "expected a name:type declaration, found the empty list '()'"))
  (return (ok)))

(deftest w9-cheader-empty-union-member
  (try (check-refused-alike "" "tests/fixtures/w5f-empty-union-member.nuc" 11
         "expected a name:type declaration, found the empty list '()'"))
  (return (ok)))

; The residue: an import that names nothing. Not a crash but a wrong ANSWER,
; which is the worse half — the header described a unit it could not see, and
; `--emit-nuch`'s copy would have been committed and linked against.
(deftest w9-header-unresolvable-import
  (try (check-probe-refused "(import-use w38nosuchlib)
(defn w38-f (x:i32):i32 (return x))
"
         "import: cannot find 'w38nosuchlib'"))
  (return (ok)))

; The three fixtures were only the shapes the CORPUS happened to contain.
; Probing every head the two header emitters dispatch on found ten crashing
; shapes, not three — a truncated form of each definer, and an inline aggregate
; reached through a pointer, an array or a `defvar` rather than a struct field.
; Each is the same defect, so each pins the same three-way agreement.

(deftest w9-header-truncated-defn
  (try (check-probe-refused "(defn)" "defn: bad form"))
  (return (ok)))

(deftest w9-header-truncated-defstruct
  (try (check-probe-refused "(defstruct)" "defstruct: missing name"))
  (return (ok)))

(deftest w9-header-truncated-defunion
  (try (check-probe-refused "(defunion U)"
         "defunion: expects a name and at least one arm"))
  (return (ok)))

(deftest w9-header-truncated-defvar
  (try (check-probe-refused "(defvar)" "defvar: expects name and optional init"))
  (return (ok)))

(deftest w9-header-truncated-defconst
  (try (check-probe-refused "(defconst K)" "defconst: expects name and value"))
  (return (ok)))

(deftest w9-header-truncated-defenum
  (try (check-probe-refused "(defenum)" "defenum: missing name"))
  (return (ok)))

(deftest w9-header-truncated-defmacro
  (try (check-probe-refused "(defmacro)"
         "defmacro: expects name, params, and body"))
  (return (ok)))

(deftest w9-header-truncated-defcast
  (try (check-probe-refused "(defcast)"
         "defcast: expects (defcast From To conv-fn)"))
  (return (ok)))

(deftest w9-header-truncated-extend
  (try (check-probe-refused "(extend)"
         "extend: expected (extend Subject Protocol)"))
  (return (ok)))

(deftest w9-header-union-under-ptr
  (try (check-probe-refused "(defstruct A (f &(union a:i32 ())))"
         "expected a name:type declaration, found the empty list '()'"))
  (return (ok)))

(deftest w9-header-union-under-array
  (try (check-probe-refused "(defstruct A (f (array (union a:i32 ()) 4)))"
         "expected a name:type declaration, found the empty list '()'"))
  (return (ok)))

(deftest w9-header-union-in-defvar
  (try (check-probe-refused "(defvar v:(union a:i32 ()) 0)"
         "expected a name:type declaration, found the empty list '()'"))
  (return (ok)))

; A CONTROL, not a case this change fixed: the return position already refused
; correctly, and this pins that the walk did not stop covering it.
(deftest w9-header-union-in-ret
  (try (check-probe-refused "(defn f (x:i32):(union a:i32 ()) (return 0))"
         "expected a name:type declaration, found the empty list '()'"))
  (return (ok)))

; ---------------------------------------------------------------------------
; The negative control, and the point of the whole ruling
; ---------------------------------------------------------------------------

; A valid unit — including a bounded-generic template, whose body `--emit-llvm`
; checks only when a call site stamps it, so refusing one here would make the
; header modes STRICTER than the compiler.
(defn w38-ok-src ():StrView
  (return "(defprotocol W38Z (w38z-zero (self:Self):i32))
(defn w38z-zero (x:i32):i32 (return x))
(extend i32 W38Z)
(defn w38-tw (x:T :where (W38Z T)):i32 (return (+ (w38z-zero x) 1)))
(defstruct W38Box (v (union as-int:i64 as-ptr:ptr)))
(defn w38-plain (b:&W38Box):i64 (return 7))
(defn main ():i32 (return (w38-tw 41)))
"))

(deftest w9-header-validation-control-compiles
  (try (check-source-accepts (w38-ok-src)))
  (return (ok)))

; Both headers, whole. The template is the one declaration the two disagree
; about, and they are each right: a `.nuch` consumer can stamp `w38-tw` from the
; body it carries, and C has nothing to stamp it into. Reading the C spelling of
; the inline union is also the only way to see that the walk descended into it
; rather than skipping the field it could not name.
(deftest w9-header-validation-passes-valid-unit
  (let (dir:StrView (try (test-scratch))
        p:String (try (test-write-file "w38ok.nuc" (w38-ok-src)))
        pv:StrView (string-as-view &p)
        h:String (try (emit-for-file dir "--emit-cheader" pv))
        n:String (try (emit-for-file dir "--emit-nuch" pv))
        hv:StrView (string-as-view &h)
        nv:StrView (string-as-view &n))
    (try (check-line hv "int32_t w38z_zero(int32_t x) asm(\"w38z-zero\");"))
    (try (check-line hv "/* w38-tw: generic template; not exported */"))
    (try (check-line hv "typedef struct W38Box {"))
    (try (check-line hv "    union { int64_t as_int; void* as_ptr; } v;"))
    (try (check-line hv "} W38Box;"))
    (try (check-line hv "int64_t w38_plain(struct W38Box* b) asm(\"w38-plain\");"))
    (try (check-not-contains hv " main("))
    (try (check-line nv "(defprotocol W38Z (w38z-zero (self:Self) :i32))"))
    (try (check-line nv "(declare w38z-zero ((x i32)) :i32)"))
    (try (check-line nv "(extend i32 W38Z)"))
    (try (check-line nv
           "(defn w38-tw ((x T) :where (W38Z T)) :i32 (return (+ (w38z-zero x) 1)))"))
    (try (check-line nv "(defstruct W38Box (v (union as-int:i64 as-ptr:ptr)))"))
    (try (check-line nv "(declare w38-plain ((b (ref W38Box))) :i64)"))
    (try (check-line nv "(declare main () :i32)"))
    (drop &n)
    (drop &h)
    (drop &p))
  (return (ok)))

; A body error is refused too: the header describes only a program that compiles.
(deftest w9-header-validation-body-error-refused
  (try (check-probe-refused "(defn w38-body (x:i64):i32 (return (as i32 x)))"
         "as: lossy conversion from i64 to i32 -- use unsafe/cast"))
  (return (ok)))

; ---------------------------------------------------------------------------
; W9 item 45: `()` in a position that requires a name
; ---------------------------------------------------------------------------
;
; `()` reads as a NULL node (W5f: read-list returns null for a zero-element
; list), and nearly every top-level definer read `(node-at form N)` and
; dereferenced it. The item was filed for four heads measured by hand; probing
; every top-level head found the same crash in twenty-odd shapes across all three
; modes.
;
; The fix is not twenty new messages. Every one of these positions ALREADY owned
; the right diagnostic for a wrong-kind name — the kind test that would have
; fired it crashed first. `node-kind` (lib/nucleus/node.nuc) answers NODE-NIL for a null
; node, so each site's own message is what these units pin.

; The four heads item 45 was filed for: each died SIGSEGV under plain
; `--emit-llvm`, which is what separated it from item 38.
(deftest w45-empty-name-defstruct
  (try (check-probe-refused "(defstruct ())" "defstruct: missing name"))
  (return (ok)))

(deftest w45-empty-name-defunion
  (try (check-probe-refused "(defunion () (A i32))" "defunion: missing name"))
  (return (ok)))

(deftest w45-empty-name-defenum
  (try (check-probe-refused "(defenum ())" "defenum: missing name"))
  (return (ok)))

(deftest w45-empty-name-defprotocol
  (try (check-probe-refused "(defprotocol ())" "defprotocol: missing name"))
  (return (ok)))

; The rest of the class, found by probing rather than by report. A bare
; `(defn)`/`(defvar)` is caught by an arity guard, so the name position is only
; reached once the form is long enough — which is why these carry a body.
(deftest w45-empty-name-defn
  (try (check-probe-refused "(defn () (x:i32):i32 (return x))"
         "defn: missing name"))
  (return (ok)))

(deftest w45-empty-name-defvar
  (try (check-probe-refused "(defvar () 0)"
         "expected a name:type declaration, found the empty list '()'"))
  (return (ok)))

(deftest w45-empty-name-defconst
  (try (check-probe-refused "(defconst () 7)" "defconst: name must be symbol"))
  (return (ok)))

(deftest w45-empty-name-defmacro
  (try (check-probe-refused "(defmacro () (x) x)" "defmacro: missing name"))
  (return (ok)))

(deftest w45-empty-name-defcast
  (try (check-probe-refused "(defcast () i32 f)" "unable to parse type expression"))
  (return (ok)))

(deftest w45-empty-name-extern
  (try (check-probe-refused "(extern ())"
         "expected a name:type declaration, found the empty list '()'"))
  (return (ok)))

(deftest w45-empty-name-declare
  (try (check-probe-refused "(declare ())" "declare: missing name"))
  (return (ok)))

(deftest w45-empty-name-export
  (try (check-probe-refused "(export ())"
         "export: each argument must be a symbol"))
  (return (ok)))

(deftest w45-empty-name-ns
  (try (check-probe-refused "(ns ())" "ns: namespace must be a symbol"))
  (return (ok)))

(deftest w45-empty-name-set-ir-prefix
  (try (check-probe-refused "(set-ir-prefix ())"
         "set-ir-prefix: argument must be a string literal"))
  (return (ok)))

(deftest w45-empty-name-import
  (try (check-probe-refused "(import ())"
         "import: name must be a symbol or string path"))
  (return (ok)))

(deftest w45-empty-name-import-use
  (try (check-probe-refused "(import-use ())"
         "import: name must be a symbol or string path"))
  (return (ok)))

; Not the name: an operand, a member, a signature, a template head. Same NULL,
; same cause, and each already had the message it should give.
(deftest w45-empty-defcast-target
  (try (check-probe-refused "(defcast i32 () f)"
         "unable to parse type expression"))
  (return (ok)))

(deftest w45-empty-extend-subject
  (try (check-probe-refused "(extend () Eq)"
         "extend: subject must be a symbol or struct template"))
  (return (ok)))

(deftest w45-empty-extend-protocol
  (try (check-probe-refused "(extend i32 ())"
         "extend: protocol must be a symbol or (Protocol args...)"))
  (return (ok)))

(deftest w45-empty-defenum-member
  (try (check-probe-refused "(defenum E A () B)" "defenum: value must be symbol"))
  (return (ok)))

(deftest w45-empty-defprotocol-sig
  (try (check-probe-refused "(defprotocol P ())"
         "defprotocol: method signature must be a list, e.g. (name (params):ret)"))
  (return (ok)))

(deftest w45-empty-defstruct-template
  (try (check-probe-refused "(defstruct (()) (f i32))"
         "defstruct: template name must be a symbol"))
  (return (ok)))

(deftest w45-empty-defprotocol-template
  (try (check-probe-refused "(defprotocol (()) (m (s:ptr):i32))"
         "defprotocol: protocol name must be a symbol"))
  (return (ok)))

; CONTROLS. A struct field and a union arm route through `extract-name-and-type`
; / the arm walk, both of which W5f and the unions work had already made
; null-safe. They pin that this change did not move them.
(deftest w45-empty-defstruct-field
  (try (check-probe-refused "(defstruct S (f i32) ())"
         "expected a name:type declaration, found the empty list '()'"))
  (return (ok)))

(deftest w45-empty-defunion-arm
  (try (check-probe-refused "(defunion U (A i32) ())"
         "defunion: arm cannot be the empty list '()' -- write `name` or `(name field:type ...)`"))
  (return (ok)))

(deftest w45-empty-name-deferror
  (try (check-probe-refused "(deferror () \"boom\")"
         "deferror: name must be a symbol"))
  (return (ok)))

; `def-rmacro` used to sit on that boundary too, registered by the emitter. Since
; Stage 21 R-2 the reader registers it as it reads, so a malformed one is a
; syntax error, refused alike in every mode (one-reader.md §3).
(deftest w45-empty-name-def-rmacro
  (try (check-probe-refused "(def-rmacro ())"
         "def-rmacro: expects (def-rmacro \"prefix\" symbol)"))
  (return (ok)))

; NEGATIVE CONTROL: the same heads, spelled correctly, still compile and still
; reach both headers. `node-kind` returning NODE-NIL only for a null node makes
; that true by construction, but a guard added at twenty sites is exactly the
; kind of change that could quietly refuse a valid program. The `ns` is what
; makes the C spelling worth reading: every exported name carries the namespace
; and an `asm` label naming the unmangled symbol.
(defn w45-ok-src ():StrView
  (return "(ns w45ns)
(defenum W45E W45A W45B)
(defstruct W45Pt (x i32) (y i32))
(defunion W45U (w45-some v:i32) w45-none)
(defprotocol W45Z (w45z-zero (self:Self):i32))
(defn w45z-zero (x:i32):i32 (return x))
(extend i32 W45Z)
(defconst W45K 7)
(defvar w45-g:i32 0)
(defn w45-add (a:i32 b:i32):i32 (return (+ a b)))
(defn main ():i32 (return (w45-add W45K (w45z-zero 0))))
"))

(deftest w45-valid-unit-unaffected
  (try (check-source-accepts (w45-ok-src)))
  (let (dir:StrView (try (test-scratch))
        p:String (try (test-write-file "w45ok.nuc" (w45-ok-src)))
        pv:StrView (string-as-view &p)
        h:String (try (emit-for-file dir "--emit-cheader" pv))
        n:String (try (emit-for-file dir "--emit-nuch" pv))
        hv:StrView (string-as-view &h)
        nv:StrView (string-as-view &n))
    (try (check-line hv "    W45E_W45A = 0,"))
    (try (check-line hv "} w45ns__W45Pt;"))
    (try (check-line hv "    w45ns__W45U_w45_some = 0,"))
    (try (check-line hv "#define W45K 7"))
    (try (check-line hv "extern int32_t w45ns__w45_g asm(\"w45ns__w45-g\");"))
    (try (check-line hv
           "int32_t w45ns__w45_add(int32_t a, int32_t b) asm(\"w45ns__w45-add\");"))
    (try (check-line nv "(ns w45ns)"))
    (try (check-line nv "(defenum W45E W45A W45B)"))
    (try (check-line nv "(defunion W45U (w45-some v:i32) w45-none)"))
    (try (check-line nv "(extern (w45-g i32))"))
    (try (check-line nv "(declare w45-add ((a i32) (b i32)) :i32)"))
    (drop &n)
    (drop &h)
    (drop &p))
  (return (ok)))

; ---------------------------------------------------------------------------
; Stage 20 L5 — what a macro body may NOT call
; (design/stage20-macros/macro-call-linking.md §5.8, §7 L5)
; ---------------------------------------------------------------------------
;
; A macro/CT body is compiled and RUN mid-unit, so a callee `emit-defn` has not
; reached yet has no `declare` and the JIT module is malformed. Every unit below
; used to surface LLVM's own parse error — `<compile-time>:189:18: error: use of
; undefined value '@helper'` — against generated text the author never wrote and
; at a line number from a file that does not exist.
(defn check-ct-refused (src:StrView line:i32 msg:StrView note:StrView):!void
  (let (dir:StrView (try (test-scratch))
        p:String (try (test-write-file "probe.nuc" src))
        pv:StrView (string-as-view &p)
        c:Compiled (try (emit-checked dir "--emit-llvm" pv)))
    (when (!= (c 'exit) 1)
      (fail! "--emit-llvm exited " (as i64 (c 'exit)) ", not 1\n     "
             (test-show (string-as-view (ref c 'raw-text)))))
    (try (check-error-at (ref c 'diags) pv line msg))
    (try (check-note-at (ref c 'diags) pv line note))
    ; The whole point of the located message is that it replaced LLVM's, so the
    ; raw output is asserted clean of it rather than merely "an error happened".
    (let (raw-text:StrView (string-as-view (ref c 'raw-text)))
      (when (contains? raw-text "use of undefined value")
        (fail! "LLVM's own diagnostic still leaks:\n     " (test-show raw-text)))
      (when (contains? raw-text "IR parse error")
        (fail! "LLVM's own diagnostic still leaks:\n     " (test-show raw-text))))
    (try (check-header-mode-agrees dir pv &c "--emit-cheader"))
    (try (check-header-mode-agrees dir pv &c "--emit-nuch"))
    (drop &c)
    (drop &p))
  (return (ok)))

; §1.2, mode 2 verbatim.
(deftest s20-macro-forward-reference
  (try (check-ct-refused "(defmacro probe () (if (= (helper) 7) `7 `99))
(defn helper ():i32 (return 7))
(defn main ():i32 (return (probe)))
" 1 "macro 'probe' calls 'helper', which is defined later in this unit"
    "a macro body may only call functions defined above it — move 'helper' above the macro"))
  (return (ok)))

; The same rule for a `(compile-time …)` block — one mechanism, two consumers
; (§1.5's closing sentence), so the diagnostic names the block rather than a
; macro.
(deftest s20-ct-block-forward-reference
  (try (check-ct-refused "(compile-time (later 21))
(defn later (x:i32):i32 (return (_* x 2)))
(defn main ():i32 (return 0))
" 1 "compile-time block calls 'later', which is defined later in this unit"
    "a compile-time body may only call functions defined above it — move 'later' above the block"))
  (return (ok)))

; §5.9, L8. A mirror splices `g-def-buf` spans into a host-triple module, and
; those spans were ABI-lowered for `--target=`. Before L8 this compiled clean and
; the macro's answer came from wrong-ABI text run on the host.
;
; The target triple is pinned; the host's is read back from the compiler rather
; than spelled, so the unit says what it means on any machine.
(deftest s20-macro-cross-target
  (let (p:String (try (test-write-file "probe.nuc"
                        "(defn xt-helper (x:i32):i32 (return (_* x 2)))
(defmacro xt (k) (if (= (xt-helper 3) 6) `(_* ~k 2) `0))
(defn main ():i32 (return (xt 21)))
"))
        pv:StrView (string-as-view &p)
        c:Compiled (try (compile-path-for "riscv64-unknown-linux-gnu" pv)))
    (when (c 'ok?)
      (fail! "the cross-target compile succeeded\n     "
             (test-show (string-as-view (ref c 'raw-text)))))
    (let (lowered:String (str "macro 'xt' needs the program's own 'xt-helper' at compile"
                              " time, and the program is lowered for"
                              " 'riscv64-unknown-linux-gnu'"))
      (try (check-error-at (ref c 'diags) pv 3 (string-as-view &lowered)))
      (drop &lowered))
    (let (h:String (try (host-triple))
          want:String (str "while a macro body runs on the host, '"
                           (string-as-view &h) "'"))
      (try (check-error-at (ref c 'diags) pv 3 (string-as-view &want)))
      (drop &want)
      (drop &h))
    (try (check-note-at (ref c 'diags) pv 3
           "a compile-time body may call only the compiler's own library"))
    ; The refusal replaced nothing here — it replaced a silent wrong answer — so
    ; what the raw stream must be clean of is LLVM, as for every unit above.
    (let (raw-text:StrView (string-as-view (ref c 'raw-text)))
      (when (contains? raw-text "use of undefined value")
        (fail! "LLVM's own diagnostic leaked:\n     " (test-show raw-text))))
    (drop &c)
    (drop &p))
  (return (ok)))

; The other half of §5.9: only a FLUSH is refused. A macro body whose every name
; resolves to the host (§3.1 conditions 1 ∧ 2) records no root, so the whole AVR
; and RISC-V surface — which uses macros heavily — cross-compiles as before.
(deftest s20-macro-cross-target-host-resolved
  (let (p:String (try (test-write-file "probe-host.nuc"
                        "(import-use nucleus.node)
(defmacro pick (xs) (node-at xs (as usize 1)))
(defn main ():i32 (return (pick (_+ 7 0))))
"))
        pv:StrView (string-as-view &p)
        c:Compiled (try (compile-path-for "riscv64-unknown-linux-gnu" pv)))
    ; Not `check-silent`: a cross target with no sysroot warns about C header
    ; widths, which is suite-target's subject and not this one's.
    (try (check-no-errors (ref c 'diags)))
    (when (not (c 'ok?))
      (fail! "a host-resolved macro body must still cross-compile\n     "
             (test-show (string-as-view (ref c 'raw-text)))))
    (try (check-line (compiled-ir &c)
                     "target triple = \"riscv64-unknown-linux-gnu\""))
    (drop &c)
    (drop &p))
  (return (ok)))

; L6 retired this refusal: a mirrored global is legal, and the unit that used to
; be refused here is `s20-macro-helper-reads-program-global` in `suite-s16.nuc`,
; where it exits 7. What is left of the reason is a backstop for a global with
; no `defvar` of its own in the unit, which nothing can copy.
; ---------------------------------------------------------------------------
; Stage 20 C2 — what a computed macro argument may be
; (design/stage20-macros/computed-macro-arguments.md §4.2, §4.4)
; ---------------------------------------------------------------------------

; §4.4's first question. A quasiquote whose operand is not `Node`-typed is an
; undiagnosed hole — `~5` reaches LLVM as `integer constant must have integer
; type`, naming generated code (quasiquote-levels.md §10.3) — and C2 must not
; inherit it. The subject is the ARGUMENT, not the macro: the fault is in the
; caller's text.
(deftest s20-computed-arg-not-a-node
  (try (check-ct-refused "(defmacro two (a b) `(_+ ~a ~b))
(defn main ():i32 (return (two 1 ~5)))
" 2 "the computed argument '~5' must evaluate to &Node, not i32"
    "a computed macro argument is substituted as source, so it must evaluate to a node"))
  (try (check-ct-refused "(defn s20-cs ():CStr (return \"hi\"))
(defmacro two (a b) `(_+ ~a ~b))
(defn main ():i32 (return (two 1 ~(s20-cs))))
" 3 "the computed argument '~(s20-cs)' must evaluate to &Node, not CStr"
    "a computed macro argument is substituted as source, so it must evaluate to a node"))
  (return (ok)))

; L5's diagnostic, reached through the new caller. The message and the note both
; name the argument and its call rather than a macro, which is the only part of
; that path C1 had to add.
(deftest s20-computed-arg-forward-reference
  (try (check-ct-refused "(import-use nucleus.node)
(defmacro one (x) x)
(defn main ():i32 (return (one ~(s20-later))))
(defn s20-later ():(ptr Node) (return `7))
" 3 "the computed argument '~(s20-later)' calls 's20-later', which is defined later in this unit"
    "a computed macro argument may only call functions defined above it — move 's20-later' above the call"))
  (return (ok)))

; §4.2, the scope boundary and the whole point of width (a): `~e` is an
; evaluation ONLY at the top level of a macro argument. The arm in `emit-node`
; still owns every other position, including one nesting level in — which is the
; case a recursive substitution would have silently swallowed.
(deftest s20-computed-arg-only-in-macro-argument
  (try (check-source-rejects "(defn main ():i32 (return ~(_+ 1 2)))
" "unquote outside quasiquote"))
  (try (check-source-rejects "(defn s20-f (x:i32):i32 (return x))
(defn main ():i32 (return (s20-f ~(_+ 1 2))))
" "unquote outside quasiquote"))
  (try (check-source-rejects "(import-use nucleus.node)
(defn s20-v ():(ptr Node) (return `1))
(defmacro one (x) x)
(defn main ():i32 (return (one (_+ 1 ~(s20-v)))))
" "unquote outside quasiquote"))
  (try (check-source-rejects "~(s20-nothing)
(defn main ():i32 (return 0))
" "unknown top-level form: unquote"))
  ; C3 put `~@` on the same boundary, so the same four positions still refuse it.
  (try (check-source-rejects "(defn main ():i32 (return ~@(_+ 1 2)))
" "unquote-splice outside quasiquote"))
  (try (check-source-rejects "(defn s20-g (x:i32):i32 (return x))
(defn main ():i32 (return (s20-g ~@(_+ 1 2))))
" "unquote-splice outside quasiquote"))
  (try (check-source-rejects "(import-use nucleus.node)
(defn s20-w ():(ptr Node) (return `1))
(defmacro one (x) x)
(defn main ():i32 (return (one (_+ 1 ~@(s20-w)))))
" "unquote-splice outside quasiquote"))
  (try (check-source-rejects "~@(s20-nothing)
(defn main ():i32 (return 0))
" "unknown top-level form: unquote-splice"))
  (return (ok)))

; §4.1: the substitution runs BEFORE the arity checks, so "expects N args, got M"
; counts what the macro receives. `~e` is exactly ONE argument, `~@e` is however
; many the list has — including none, which is the count a fixed-arity macro then
; has to report rather than seeing one null argument.
(deftest s20-computed-arg-arity-counts-substitution
  (try (check-source-rejects "(import-use nucleus.node)
(defn s20-one ():(ptr Node) (return `1))
(defmacro two (a b) `(_+ ~a ~b))
(defn main ():i32 (return (two ~(s20-one))))
" "macro 'two': expects 2 args, got 1"))
  (try (check-source-rejects "(import-use nucleus.node)
(defn s20-pair ():(ptr Node) (return `(1 2)))
(defmacro three (a b c) `(_+ ~a (_+ ~b ~c)))
(defn main ():i32 (return (three ~@(s20-pair))))
" "macro 'three': expects 3 args, got 2"))
  (try (check-source-rejects "(import-use nucleus.node)
(defn s20-trio ():(ptr Node) (return `(1 2 3)))
(defmacro two2 (a b) `(_+ ~a ~b))
(defn main ():i32 (return (two2 ~@(s20-trio))))
" "macro 'two2': expects 2 args, got 3"))
  (try (check-source-rejects "(import-use nucleus.node)
(defn s20-empty ():(ptr Node) (return null))
(defmacro one2 (x) x)
(defn main ():i32 (return (one2 ~@(s20-empty))))
" "macro 'one2': expects 1 args, got 0"))
  (return (ok)))

; C3's own diagnostic. The type check `~` already had says the value is a node;
; this says it is a node of the right SHAPE, because `~@` substitutes N arguments
; and only a list has N elements.
(deftest s20-computed-arg-splice-not-a-list
  (try (check-ct-refused "(import-use nucleus.node)
(defn s20-atom ():(ptr Node) (return `7))
(defmacro two (a b) `(_+ ~a ~b))
(defn main ():i32 (return (two 1 ~@(s20-atom))))
" 4 "the computed argument '~@(s20-atom)' must evaluate to a list of nodes"
    "`~@` splices its result in as N arguments, so it must evaluate to a list"))
  ; Through a `:rest` macro, whose splice walks a second path.
  (try (check-ct-refused "(import-use nucleus.node)
(defn s20-sym ():(ptr Node) (return `abc))
(defmacro s20-sum2 (:rest args) `(macfoldr _+ 0 ~@args))
(defn main ():i32 (return (s20-sum2 ~@(s20-sym))))
" 4 "the computed argument '~@(s20-sym)' must evaluate to a list of nodes"
    "`~@` splices its result in as N arguments, so it must evaluate to a list"))
  ; Not a node at all: C2's type check owns this one, and it names `~@`.
  (try (check-ct-refused "(defmacro two (a b) `(_+ ~a ~b))
(defn main ():i32 (return (two 1 ~@5)))
" 2 "the computed argument '~@5' must evaluate to &Node, not i32"
    "a computed macro argument is substituted as source, so it must evaluate to a node"))
  (return (ok)))

; L8's refusal through the new caller: a computed argument whose body calls a
; program `defn` needs a mirror, and a mirror is host-triple text spliced from
; spans lowered for `--target=`. The message names the argument.
(deftest s20-computed-arg-cross-target
  (let (p:String (try (test-write-file "probe-carg.nuc"
                        "(import-use nucleus.node)
(defn s20-xrows ():(ptr Node) (return `((a 1))))
(macmap ((n v) `(defn ~n ():i32 (return ~v))) ~(s20-xrows))
(defn main ():i32 (return (a)))
"))
        pv:StrView (string-as-view &p)
        c:Compiled (try (compile-path-for "riscv64-unknown-linux-gnu" pv)))
    (when (c 'ok?)
      (fail! "the cross-target compile succeeded\n     "
             (test-show (string-as-view (ref c 'raw-text)))))
    (let (lowered:String (str "the computed argument '~(s20-xrows)' needs the program's own"
                              " 's20-xrows' at compile time, and the program is lowered for"
                              " 'riscv64-unknown-linux-gnu'"))
      (try (check-error-at (ref c 'diags) pv 3 (string-as-view &lowered)))
      (drop &lowered))
    (drop &c)
    (drop &p))
  (return (ok)))

; ---------------------------------------------------------------------------
; Stage 20 U2 — what `~` may substitute, and what a macro body may return
; (design/stage20-macros/unquote-operand-typing.md; closes quasiquote-levels.md
; §10.3)
; ---------------------------------------------------------------------------
;
; One omission, three manifestations, and `check-ct-refused`'s clean-of-LLVM
; assertion is the point of each: nested, the author used to get `'%t5' defined
; with type 'i32' but expected 'ptr'` about generated text; bare and no-unquote,
; the value was dropped by `compile-macro-body`'s TY-PTR filter and the macro
; silently `returned null`, with no line, no `~` and no type.

(deftest s20-unquote-operand-not-a-node
  ; nested — §10.3's recorded face, the one LLVM used to object to
  (try (check-ct-refused "(defmacro m ()
  (let (n:i32 5)
    `(_+ 0 ~n)))
(defn main ():i32 (return (m)))
" 3 "the unquote operand '~n' must evaluate to &Node, not i32"
    "`~` substitutes its value as source, so it must evaluate to a node"))
  ; bare — the same branch, and the `returned null` face
  (try (check-ct-refused "(defmacro m ()
  (let (n:i32 5)
    `~n))
(defn main ():i32 (return (m)))
" 3 "the unquote operand '~n' must evaluate to &Node, not i32"
    "`~` substitutes its value as source, so it must evaluate to a node"))
  ; splice — the third manifestation, against `@__append` rather than `@__cons`
  (try (check-ct-refused "(defmacro m ()
  (let (n:i32 5)
    `(_+ 0 ~@n)))
(defn main ():i32 (return (m)))
" 3 "the unquote operand '~@n' must evaluate to &Node, not i32"
    "`~@` splices its value in as source, so it must evaluate to a node"))
  (return (ok)))

; The face with no unquote in it at all, which the check above cannot see: the
; subject is the macro, because the fault is the body's own value. The second
; case is what makes the line the BODY form's — `ff` is the whole `defmacro`,
; so blaming it would have said line 1 here too.
(deftest s20-macro-body-not-a-node
  (try (check-ct-refused "(defmacro m () 5)
(defn main ():i32 (return (m)))
" 1 "macro 'm' must evaluate to &Node, not i32"
    "a macro body's value is substituted as source, so it must evaluate to a node"))
  (try (check-ct-refused "(defmacro m ()
  `1
  5)
(defn main ():i32 (return (m)))
" 3 "macro 'm' must evaluate to &Node, not i32"
    "a macro body's value is substituted as source, so it must evaluate to a node"))
  (return (ok)))

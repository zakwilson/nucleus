; Nucleus-defined struct-by-value functions called from C (tests/abi/driver.c).
; Validates the defn side of the ABI — struct parameter reconstruction and
; sret / register-coerced returns — against what the system cc expects.
; No main: compiled with `-c` and linked into the C driver.

(defstruct Pair a:int b:int)
(defstruct Big  x:i64 y:i64 z:i64)

(defn nt_pair_make (a:int b:int):Pair
  (let (q:&Pair (alloca Pair)) (set! (q 'a) a) (set! (q 'b) b) @q))
(defn nt_pair_sum (p:Pair):int
  (let (q:&Pair (alloca Pair)) (set! (deref q) p) (+ (get q 'a) (get q 'b))))
(defn nt_big_make (x:i64 y:i64 z:i64):Big
  (let (q:&Big (alloca Big)) (set! (q 'x) x) (set! (q 'y) y) (set! (q 'z) z) @q))
(defn nt_big_sum (b:Big):i64
  (let (q:&Big (alloca Big)) (set! (deref q) b) (+ (+ (get q 'x) (get q 'y)) (get q 'z))))

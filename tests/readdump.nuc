; Stage 18 TF-3 — readdump: `lib/read.nuc`'s answer, in `nucleusc --dump-ast`'s
; format, so the two readers can be diffed over the whole fixture corpus.
;
; Exits 0 on a clean read, 1 on a reader error (which for a collection literal
; is the expected answer -- see lib/read.nuc's header), 2 on a usage or I/O
; failure.

(import-use error)
(import-use strview)
(import-use string)
(import-use io)
(import-use file)
(import-use read)

(defn dump-file (path:StrView):!i32
  (let (f:File (try (file-open-read (addr-of path)))
        text:String (try (file-read-to-string (addr-of f))))
    (try (file-close (addr-of f)))
    (let (r:Reader (reader (string-as-view (addr-of text)))
          code:i32 0)
      (while (not (reader-eof? (addr-of r)))
        (match (read-one (addr-of r))
          ((ok n)
            (let (s:String (node-str n))
              (print (string-as-view (addr-of s)) "\n")
              (drop (addr-of s))))
          ((err e)
            (eprint path ":" (reader-error-line (addr-of r)) ": " (err-message e) "\n")
            (set! code 1)
            (set! r (reader "")))))
      (drop (addr-of text))
      (return (ok code)))))

(defn main (argc:i32 argv:ptr):int
  (when (< argc 2)
    (eprint "usage: readdump <file.nuc>\n")
    (return 2))
  (let (path:StrView (strview-from-cstr (as CStr (aref (as ptr:ptr argv) 1))))
    (match (dump-file path)
      ((ok code) (return (as int code)))
      ((err e)
        (eprint "readdump: " (err-message e) "\n")
        (return 2)))))

; Nucleus side of the struct-layout verification harness (Phase E,
; design/stage8/platform.md question 13(a)/14). Imports the shared corpus
; header and prints sizeof + per-field byte offsets for every struct, one
; line each, computed entirely from Nucleus's own layout walk (sizeof) and
; field-address arithmetic (offsetof). tests/layout/layout.c prints the same
; lines using the platform C compiler; run-layout-test.sh diffs them, so any
; disagreement between Nucleus's layout and the C ABI fails the build.

(import-use "tests/layout/structs.h")
(import-use "stdio.h")
(import-use "stdlib.h")
(import-use error)

; Stage 10 U4/A2 niche unions over a typed (ref Pt) payload (design/stage10/
; unions.md §6 rules 2/3). `?ptr:Pt` == (Maybe (ref Pt)) and `!ptr:Pt` ==
; (Result (ref Pt) Err) both lower to a bare pointer (no struct, no discriminant),
; so sizeof == sizeof(void*) and (some p)/(ok p) carry p unchanged — the C-ABI
; promise that `!ptr:Pt` is a `Pt*`. Niche types are used only in function
; bodies here (sizeof / a `?ptr:Pt` value), since a C-header-imported Pt is not
; registered until the emit phase (signatures referencing it would prescan-fail).

; Stage 15 W8 G-2: fixed-size array fields (`(array T N)`). These shapes are
; declared HERE rather than imported, because the C-header parser skips array
; declarators by design; structs.h carries byte-identical C copies behind
; NUCLEUS_LAYOUT_C_ORACLE, which only layout.c (the oracle) defines.
(defstruct A_plain (xs (array i32 4)))
(defstruct A_head  tag:i8 (xs (array i32 4)) tail:i8)
(defstruct A_byte  (b (array i8 3)) tail:i8)
(defstruct A_wide  tag:i8 (v (array f64 2)) tail:i8)
(defstruct A_nest  (pts (array Inner 3)) z:i64)
(defstruct A_ofarr (rows (array A_plain 2)) tail:i8)

; offsetof(field) = address-of-field - base, both as integers.
(defn off (base:ptr fld:ptr):i64 (return (- (unsafe/cast i64 fld) (unsafe/cast i64 base))))

(defn main ():int
  (let (s:ptr:P_i8  (alloca P_i8))  (printf "P_i8 sizeof=%lld a=%lld\n"  (as i64 (sizeof P_i8))  (off s (.& s a))))
  (let (s:ptr:P_i16 (alloca P_i16)) (printf "P_i16 sizeof=%lld a=%lld\n" (as i64 (sizeof P_i16)) (off s (.& s a))))
  (let (s:ptr:P_i32 (alloca P_i32)) (printf "P_i32 sizeof=%lld a=%lld\n" (as i64 (sizeof P_i32)) (off s (.& s a))))
  (let (s:ptr:P_i64 (alloca P_i64)) (printf "P_i64 sizeof=%lld a=%lld\n" (as i64 (sizeof P_i64)) (off s (.& s a))))
  (let (s:ptr:P_f32 (alloca P_f32)) (printf "P_f32 sizeof=%lld a=%lld\n" (as i64 (sizeof P_f32)) (off s (.& s a))))
  (let (s:ptr:P_f64 (alloca P_f64)) (printf "P_f64 sizeof=%lld a=%lld\n" (as i64 (sizeof P_f64)) (off s (.& s a))))
  (let (s:ptr:P_ptr (alloca P_ptr)) (printf "P_ptr sizeof=%lld a=%lld\n" (as i64 (sizeof P_ptr)) (off s (.& s a))))

  (let (s:ptr:M_8_64  (alloca M_8_64))  (printf "M_8_64 sizeof=%lld a=%lld b=%lld\n"  (as i64 (sizeof M_8_64))  (off s (.& s a)) (off s (.& s b))))
  (let (s:ptr:M_32_8  (alloca M_32_8))  (printf "M_32_8 sizeof=%lld a=%lld b=%lld\n"  (as i64 (sizeof M_32_8))  (off s (.& s a)) (off s (.& s b))))
  (let (s:ptr:M_8_32  (alloca M_8_32))  (printf "M_8_32 sizeof=%lld a=%lld b=%lld\n"  (as i64 (sizeof M_8_32))  (off s (.& s a)) (off s (.& s b))))
  (let (s:ptr:M_16_64 (alloca M_16_64)) (printf "M_16_64 sizeof=%lld a=%lld b=%lld\n" (as i64 (sizeof M_16_64)) (off s (.& s a)) (off s (.& s b))))
  (let (s:ptr:M_8_16_8 (alloca M_8_16_8)) (printf "M_8_16_8 sizeof=%lld a=%lld b=%lld c=%lld\n" (as i64 (sizeof M_8_16_8)) (off s (.& s a)) (off s (.& s b)) (off s (.& s c))))
  (let (s:ptr:M_64_8  (alloca M_64_8))  (printf "M_64_8 sizeof=%lld a=%lld b=%lld\n"  (as i64 (sizeof M_64_8))  (off s (.& s a)) (off s (.& s b))))

  (let (s:ptr:Inner (alloca Inner)) (printf "Inner sizeof=%lld x=%lld y=%lld\n"   (as i64 (sizeof Inner)) (off s (.& s x))  (off s (.& s y))))
  (let (s:ptr:Outer (alloca Outer)) (printf "Outer sizeof=%lld pt=%lld tag=%lld\n" (as i64 (sizeof Outer)) (off s (.& s pt)) (off s (.& s tag))))
  (let (s:ptr:Anon  (alloca Anon))  (printf "Anon sizeof=%lld in=%lld tag=%lld\n"  (as i64 (sizeof Anon))  (off s (.& s in)) (off s (.& s tag))))

  (let (s:ptr:TimeSpec (alloca TimeSpec)) (printf "TimeSpec sizeof=%lld tv_sec=%lld tv_nsec=%lld\n" (as i64 (sizeof TimeSpec)) (off s (.& s tv_sec)) (off s (.& s tv_nsec))))
  (let (s:ptr:Rec (alloca Rec)) (printf "Rec sizeof=%lld tag=%lld value=%lld next=%lld d=%lld\n" (as i64 (sizeof Rec)) (off s (.& s tag)) (off s (.& s value)) (off s (.& s next)) (off s (.& s d))))

  (printf "U_scalar sizeof=%lld\n" (as i64 (sizeof U_scalar)))
  (printf "U_mixed sizeof=%lld\n"  (as i64 (sizeof U_mixed)))
  (printf "U_pad sizeof=%lld\n"    (as i64 (sizeof U_pad)))
  (let (s:ptr:UWrap (alloca UWrap)) (printf "UWrap sizeof=%lld tag=%lld u=%lld\n" (as i64 (sizeof UWrap)) (off s (.& s tag)) (off s (.& s u))))
  (let (s:ptr:UAnon (alloca UAnon)) (printf "UAnon sizeof=%lld kind=%lld data=%lld tail=%lld\n" (as i64 (sizeof UAnon)) (off s (.& s kind)) (off s (.& s data)) (off s (.& s tail))))

  ; Niche unions: pointer-sized, and (some p) round-trips p unchanged.
  (printf "NICHE_MAYBE sizeof=%lld\n"  (as i64 (sizeof ?ptr:Pt)))
  (printf "NICHE_ERRPTR sizeof=%lld\n" (as i64 (sizeof !ptr:Pt)))
  (let (pt:ptr:Pt (alloca Pt))
    (let (m:?ptr:Pt (some (as ref:Pt pt))
          back:ref:Pt (unwrap m))
      (printf "NICHE_okptr_roundtrip=%d\n" (if (= (unsafe/cast i64 back) (unsafe/cast i64 pt)) 1 0))))
  ; Stage 15 W8 G-2: fixed-size array fields. The shapes are declared in
  ; Nucleus below (the C-header parser skips array declarators, so structs.h's
  ; copies are oracle-only, behind NUCLEUS_LAYOUT_C_ORACLE) and measured the
  ; same way every struct above is: `sizeof` plus field-address arithmetic.
  ; What this pins is that an array field's SIZE (N * sizeof(T)) and ALIGNMENT
  ; (the element's, not the aggregate's) agree with the platform C ABI — get
  ; either wrong and the offset of the field AFTER the array moves.
  (let (s:ptr:A_plain (alloca A_plain)) (printf "A_plain sizeof=%lld xs=%lld\n" (as i64 (sizeof A_plain)) (off s (.& s xs))))
  (let (s:ptr:A_head (alloca A_head)) (printf "A_head sizeof=%lld tag=%lld xs=%lld tail=%lld\n" (as i64 (sizeof A_head)) (off s (.& s tag)) (off s (.& s xs)) (off s (.& s tail))))
  (let (s:ptr:A_byte (alloca A_byte)) (printf "A_byte sizeof=%lld b=%lld tail=%lld\n" (as i64 (sizeof A_byte)) (off s (.& s b)) (off s (.& s tail))))
  (let (s:ptr:A_wide (alloca A_wide)) (printf "A_wide sizeof=%lld tag=%lld v=%lld tail=%lld\n" (as i64 (sizeof A_wide)) (off s (.& s tag)) (off s (.& s v)) (off s (.& s tail))))
  (let (s:ptr:A_nest (alloca A_nest)) (printf "A_nest sizeof=%lld pts=%lld z=%lld\n" (as i64 (sizeof A_nest)) (off s (.& s pts)) (off s (.& s z))))
  (let (s:ptr:A_ofarr (alloca A_ofarr)) (printf "A_ofarr sizeof=%lld rows=%lld tail=%lld\n" (as i64 (sizeof A_ofarr)) (off s (.& s rows)) (off s (.& s tail))))

  (return 0))

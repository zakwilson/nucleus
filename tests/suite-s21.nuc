; Stage 21 — one reader (design/stage21-cleanup/one-reader.md §6.6).
;
; The compiler reads through `lib/read.nuc` since R-2, so what a program's
; `read-all` sees and what `--dump-ast` prints are the same reader's answer,
; and the units here ask both. The reader's failures are values (`ReadError`,
; §2.1) rather than a printed line and an exit, which is what makes the second
; half of the file testable at all: a program can hold the code, the line and
; the message and say what it got.

; ---------------------------------------------------------------------------
; A string literal has no 4095-byte cap
; ---------------------------------------------------------------------------

; 600 x "abcdefghij" + "END": the literal the fixture carries three times.
(defn s21-big-literal ():String
  (let (s:String (string-new)
        i:i32 0)
    (while (< i 600)
      (str-into &s "abcdefghij")
      (set! i (+ i 1)))
    (str-into &s "END")
    (return s)))

; The R-1 probe, pinned: as a global, a macro body and a local it compiles and
; prints its length, and the two modes that reprint the tree carry it whole.
(deftest s21-long-string-literal
  (let (path:StrView "tests/fixtures/s21-long-string-literal.nuc"
        lit:String (s21-big-literal)
        lv:StrView (string-as-view &lit)
        out:String (try (build-run-file "" "" path)))
    (try (check-eq-int (as i64 (lv 'len)) 6003 "literal length"))
    (try (check-golden (string-as-view &out)
                       "6003 6003 6003\nabcdefghij...abcdefghijEND\n"))
    (drop &out)
    (let (nuch:String (try (emit-for-file "" "--emit-nuch" path)))
      (try (check-contains (string-as-view &nuch) "(defmacro bigm () (quote \""))
      (try (check-contains (string-as-view &nuch) lv))
      (drop &nuch))
    (let (ast:String (try (emit-for-file "" "--dump-ast" path)))
      (try (check-contains (string-as-view &ast) "(defvar big:CStr c\""))
      (try (check-contains (string-as-view &ast) lv))
      (drop &ast))
    (drop &lit))
  (return (ok)))

; ---------------------------------------------------------------------------
; `def-rmacro` registers at read time: forward-only, file-scoped
; ---------------------------------------------------------------------------

; A one-form-per-line program the fixture's `def-rmacro` must refuse, with the
; form on line 3 so the line is a claim rather than the default.
(defn s21-rmacro-refused (form:StrView msg:StrView):!void
  (let (src:String (str "(import-use node)\n(defn w (x:i32):i32 (return x))\n" form
                        "\n(defn main ():i32 (return 0))\n")
        p:String (try (test-write-file "t.nuc" (string-as-view &src))))
    (try (check-refused-alike "" (string-as-view &p) 3 msg))
    (drop &p)
    (drop &src))
  (return (ok)))

(deftest s21-def-rmacro
  ; 1. Through `--dump-ast`: `$s21-x` on line 7 is the symbol, on line 10 it is
  ;    `(s21-w s21-x)`, and the directive itself is printed as data.
  (let (ast:String (try (emit-for-file "" "--dump-ast" "tests/fixtures/s21-def-rmacro.nuc"))
        av:StrView (string-as-view &ast))
    (try (check-line av "(defn s21-before () :raw:Node (return (quote $s21-x)))"))
    (try (check-line av "(def-rmacro \"$\" s21-w)"))
    (try (check-line av "(defn s21-after () :i32 (return (s21-w s21-x)))"))
    (drop &ast))

  ; 2. Through a program's `read-all`: the same forward-only rule in one
  ;    buffer, a fresh table for the next buffer, and the three collection
  ;    literals with no gensym element -- the compiler mints that itself. A
  ;    literal element fuses like a list element since PK-2.
  (let (out:String (try (build-run-source "(import-use error)
(import-use strview)
(import-use string)
(import-use io)
(import-use node)
(import-use read)
(defn show (text:StrView):void
  (match (read-all text)
    ((ok forms)
      (let (s:String (node-str forms))
        (print (string-as-view &s) \"\\n\")
        (drop &s)))
    ((err e) (print \"error line \" (e 'line) \": \" (e 'msg) \"\\n\"))))
(defn main ():i32
  (show \"$x (def-rmacro \\\"$\\\" w) $x\")
  (show \"$x\")
  (show \"[1 2]\")
  (show \"{:a 1}\")
  (show \"#{1}\")
  (show \"[a:(T) b]\")
  (return 0))
"))
        ov:StrView (string-as-view &out))
    (try (check-golden ov "($x (def-rmacro \"$\" w) (w x))
($x)
((vector-lit 1 2))
((hashmap-lit :a 1))
((hashset-lit 1))
((vector-lit (a (T)) b))
"))
    (try (check-not-contains ov "__gs"))
    (drop &out))

  ; 3. File-scoped, both ways: an importer defines its own `$` and the imported
  ;    file its own, and each reads its forms through its own table. Were the
  ;    table shared, whichever file was read second would be refused with
  ;    "already a reader macro".
  (let (p:String (try (test-write-file "s21-importer.nuc" "(import-use \"stdio.h\")
(import-use \"tests/fixtures/s21-def-rmacro.nuc\")
(defn s21-v (n:i32):i32 (return (+ n 1)))
(def-rmacro \"$\" s21-v)
(defn main ():i32
  (printf \"%s %d %d\\n\" (symbol-as-cstr ((s21-before) 's)) (s21-after) $s21-x)
  (return 0))
"))
        out:String (try (build-run-file "" "" (string-as-view &p))))
    (try (check-golden (string-as-view &out) "$s21-x 40 5\n"))
    (drop &out)
    (drop &p))

  ; 4. And an importer that defines nothing sees a bare `$s21-x` as the symbol
  ;    it is: the diagnostic is the importer's, at the importer's line.
  (let (p:String (try (test-write-file "s21-plain.nuc" "(import-use \"tests/fixtures/s21-def-rmacro.nuc\")
(defn s21-uses ():i32 (return $s21-x))
"))
        pv:StrView (string-as-view &p)
        c:Compiled (try (compile-path pv)))
    (try (check-error-at (ref c 'diags) pv 2 "undefined: $s21-x"))
    (drop &c)
    (drop &p))

  ; 5. The two refusals R-1 added, alike in every emit mode. `(def-rmacro ())`
  ;    is `w45-empty-name-def-rmacro` in tests/suite-refusals.nuc.
  (try (s21-rmacro-refused "(def-rmacro \"~\" w)"
                           "def-rmacro: '~' is already a reader macro"))
  (try (s21-rmacro-refused "(def-rmacro \"my\" w)"
                           "def-rmacro: prefix must not begin with a byte that can start an atom"))
  (return (ok)))

; ---------------------------------------------------------------------------
; A custom `E` through `(Result T E)`, and across `try` into `!T` callers
; ---------------------------------------------------------------------------

; The two §1.7 probes as one program (the fixture says what it pins). The
; whole output is compared: a field that came back empty or swapped is a
; different line, not a missing substring.
(deftest s21-typed-error-propagation
  (let (out:String (try (build-run-file "" "" "tests/fixtures/s21-typed-error-propagation.nuc")))
    (try (check-golden (string-as-view &out) "direct
err s21-bad line=4 msg=[unknown escape \\q] note=[]
err s21-worse line=7 msg=[too big] note=[a note]
ok 10
same-e
err s21-worse line=7 msg=[too big] note=[a note]
ok 11
into-i32
err s21-bad
ok 10
into-void
err s21-worse
ok void
"))
    (drop &out))
  (return (ok)))

; ---------------------------------------------------------------------------
; A read failure is a value
; ---------------------------------------------------------------------------

; No diagnostic names `file`. The complement of `check-error-at`: a nested
; import's error must be blamed on the imported file and on nothing else.
(defn s21-check-no-diag-in ((ds (ref (Vector Diagnostic))) file:StrView):!void
  (let (n:usize (count ds)
        i:usize 0)
    (while (< i n)
      (let (d:Diagnostic (invoke ds i))
        (when (= (d 'file) file)
          (let (l:String (diag-list-text ds))
            (fail! "no diagnostic may be attributed to " file "\n     got:"
                   (string-as-view &l)))))
      (set! i (+ i 1))))
  (return (ok)))

(deftest s21-read-error-value
  ; 1. The program: code, line, message and note off the value; the `!void`
  ;    wrapper's `try` yields the bare code through the `defcast`; a top-level
  ;    `)` carries the note and one inside an unclosed `[…]` does not.
  (let (out:String (try (build-run-file "" "" "tests/fixtures/s21-read-error-value.nuc")))
    (try (check-golden (string-as-view &out) "bad-escape: read-bad-escape line=1 msg=[unknown escape \\q] note=none
bad-escape-line3: read-bad-escape line=3 msg=[unknown escape \\q] note=none
stray-close-top: read-unexpected-close line=2 msg=[unexpected )] note=some
  note: the form opened at line 1 is already closed -- look for an extra ')' between lines 1 and 2
close-inside-vector: read-unexpected-close line=1 msg=[unexpected )] note=none
clean: ok 2 form(s)
read-through: err read-bad-escape
read-through: ok 2 form(s)
read-through: ok
"))
    (drop &out))

  ; 2. The compiler: a syntax error in an IMPORTED file is reported at that
  ;    file's path and line, and blamed on nothing in the importer.
  (let (dir:StrView (try (test-scratch))
        bad:String (try (test-write-file "s21-synerr.nuc" "(defn s21-synerr-ok ():i32 (return 1))
(defn s21-synerr-bad ():i32
  (return (s21-synerr-ok \"x\\q\")))
"))
        badv:StrView (string-as-view &bad)
        imp:String (try (test-write-file "s21-nested.nuc" "(import s21-synerr)
(defn main ():i32 (return (s21-synerr-ok)))
"))
        impv:StrView (string-as-view &imp)
        c:Compiled (try (compile-path-in dir impv)))
    (when (!= (c 'exit) 1)
      (fail! "expected exit 1 for a syntax error in an imported file, got "
             (as i64 (c 'exit)) "\n     " (test-show (string-as-view (ref c 'raw)))))
    (try (check-error-at (ref c 'diags) badv 3 "unknown escape \\q"))
    (try (s21-check-no-diag-in (ref c 'diags) impv))
    (try (check-eq-int (as i64 (count (ref c 'diags))) 1 "diagnostics"))
    (drop &c)

    ; 3. The REPL recovers from the same import, as from any failed import
    ;    (stage16 repl-libraries.md §3.4): the next diagnostic is `<repl>`'s,
    ;    a retry reports the same error, and an unrelated import still works.
    (let (text:String (str "(import-use \"" badv "\")\n(zzz 1)\n(import-use \"" badv
                           "\")\n(import-use \"tests/fixtures/r1-import-works.nuc\")\n(r1-works)\n")
          want:String (str badv ":3: error: unknown escape \\q\n  error: error (recovered)\n")
          pat:String (str "*" badv ":3: error: unknown escape \\q")
          t:String (try (repl-session (string-as-view &text)))
          tv:StrView (string-as-view &t))
      (try (check-eq-int (count-matching-lines tv (string-as-view &pat))
                         2 "reports of the import's syntax error"))
      (try (check-contains tv (string-as-view &want)))
      (try (check-contains tv "<repl>:1: error: unknown: zzz — not defined anywhere in this compilation unit\n  error: error (recovered)\n"))
      (try (check-contains tv "  imported tests/fixtures/r1-import-works.nuc\nnuc>   42\n"))
      (drop &t)
      (drop &pat)
      (drop &want)
      (drop &text))
    (drop &imp)
    (drop &bad))
  (return (ok)))

; ---------------------------------------------------------------------------
; PK-1: `&` reads as `ref` in both worlds
; ---------------------------------------------------------------------------

; One node for the type and the value (pointer-kind-spellings.md §3). The
; fixture is a witness, not a re-spelling: the pre-PK-1 compiler refuses its
; line 27 with `unknown: ref`, since `(ref x)` had no value-world meaning.
(deftest s21-pk1-ref-head
  ; 1. Every standalone `&T` position §3 names, both value arities, and a
  ;    callable value applied to `&x` (which reads as `(cb (ref n))` and must
  ;    not trip the `q:(ref T)` annotation diagnostic).
  (let (out:String (try (build-run-file "" "" "tests/fixtures/s21-pk1-ref-head.nuc")))
    (try (check-golden (string-as-view &out) "3 4 8 12\n3 4 4\n42 3 3\n9 3\n"))
    (drop &out))

  ; 2. The header of a lib-shaped file: `&k` in a macro body and `&Self` /
  ;    `&Pt` in exported signatures all print as `ref`, and `addr-of` nowhere.
  (let (p:String (try (test-write-file "s21-pk1-lib.nuc" "(import-use vector)
(defstruct Pt x:i32 y:i32)
(defmacro addr-x (k) `(bump &k))
(defn bump (p:&i32):void (set! (deref p) (+ (deref p) 1)))
(defprotocol Area (area ((self &Self)):i32))
(defn first-x ((v (ref (Vector &Pt))) q:&Pt):i32 (return (q 'x)))
"))
        nuch:String (try (emit-for-file "" "--emit-nuch" (string-as-view &p)))
        nv:StrView (string-as-view &nuch))
    (try (check-line nv "(defmacro addr-x (k) (quasiquote (bump (ref k))))"))
    (try (check-line nv "(defprotocol Area (area ((self (ref Self))) :i32))"))
    (try (check-line nv "(declare first-x ((v (ref (Vector (ref Pt)))) (q (ref Pt))) :i32)"))
    (try (check-not-contains nv "addr-of"))
    (drop &nuch)
    (drop &p))

  ; 3. A `macrolet` may not shadow the head `&x` now reads as: the macro table
  ;    is consulted before the special-form chain, so the guard is the only
  ;    thing between a binding named `ref` and every `&x` in the body.
  (let (p:String (try (test-write-file "s21-pk1-macrolet.nuc" "(defn main ():i32
  (macrolet ((ref (x) x))
    (return (ref 1))))
"))
        pv:StrView (string-as-view &p)
        c:Compiled (try (compile-path pv)))
    (try (check-error-at (ref c 'diags) pv 2
                         "macrolet: 'ref' is a pointer kind and may not be shadowed"))
    (drop &c)
    (drop &p))
  (return (ok)))

; ---------------------------------------------------------------------------
; PK-2: the fuse gates on an open segment, and fires on every atom
; ---------------------------------------------------------------------------

; Every row of pointer-kind-spellings.md §4's table, the three consequences of
; the move from list reading into form reading, and the spellings a closed
; final segment must leave alone -- through `read-all`, then the compiler's
; own `--dump-ast` for the rows a program's source can carry.
(deftest s21-pk2-fuse-open-segment
  ; 1. The fixture reads each spelling and prints what it read.
  (let (out:String (try (build-run-file "" "" "tests/fixtures/s21-pk2-fuse-open-segment.nuc")))
    (try (check-golden (string-as-view &out) "?(V) => ((? (V)))
x:?(V) => ((x (? (V))))
x:!(V) => ((x (! (V))))
?!(V) => ((?! (V)))
(f (a):?(V)) => ((f (a) (? (V))))
x:&?(V) => ((x (ref (? (V)))))
x:?&(V) => ((x (?ref (V))))
x:(V) => ((x (V)))
x:ref:(V) => ((x (ref (V))))
(f (a):(V)) => ((f (a) (V)))
f:(fn i32)(i32 i32) => ((f ((fn i32) (i32 i32))))
f:(fn i32) => ((f (fn i32)))
&?(V) => ((ref (? (V))))
&ptr:(V) => ((ref (ptr (V))))
'x:(T) => ((quote (x (T))))
~x:(T) => ((unquote (x (T))))
[x:(T)] => ((vector-lit (x (T))))
foo:(bar) => ((foo (bar)))
foo?(x) => (foo? (x))
push!(x) => (push! (x))
!=(x) => (!= (x))
x:foo?(x) => (x:foo? (x))
&rest(x) => (&rest (x))
x:? (V) => (x:? (V))
"))
    (drop &out))

  ; 2. The compiler reads the same way: a sigil-paren parameter, a `):?(…)`
  ;    return, a reader-macro operand, a literal element and a top-level atom
  ;    (one form, where the pre-PK-2 reader gave a bare symbol then a list).
  (let (p:String (try (test-write-file "s21-pk2-ast.nuc" "(defn f1 (x:?(Vector i32)) :i32 (return 0))
(defn f2 (a:i32):?(Vector i32) (return 0))
(defn f3 () :i32 (return (as &?(Vector i32) x)))
(defmacro m1 () `(let (~x:(T) 1) 2))
(defn f4 () :i32 (return [x:(T)]))
foo:(bar)
(defn f5 () :i32 (return (foo?(x) push!(x))))
"))
        ast:String (try (emit-for-file "" "--dump-ast" (string-as-view &p)))
        av:StrView (string-as-view &ast))
    (try (check-line av "(defn f1 ((x (? (Vector i32)))) :i32 (return 0))"))
    (try (check-line av "(defn f2 (a:i32) (? (Vector i32)) (return 0))"))
    (try (check-line av "(defn f3 () :i32 (return (as (ref (? (Vector i32))) x)))"))
    (try (check-line av "(defmacro m1 () (quasiquote (let ((unquote (x (T))) 1) 2)))"))
    (try (check-line av "(defn f4 () :i32 (return (vector-lit (x (T)))))"))
    (try (check-line av "(foo (bar))"))
    (try (check-line av "(defn f5 () :i32 (return (foo? (x) push! (x))))"))
    (drop &ast)
    (drop &p))
  (return (ok)))

; ---------------------------------------------------------------------------
; PK-3: a bare-sigil head is the canonical list form of a sigil-paren type
; ---------------------------------------------------------------------------

; The rows of pointer-kind-spellings.md §1.1 that failed in 21 of 23 positions:
; the fixture is a witness (the pre-PK-3 compiler refuses its line 19 with an
; empty `unknown type:`), and the header half is the round-trip property §5
; states -- `(? (Vector i32))` prints structurally, re-reads to itself, and a
; separately compiled consumer links through it.
(deftest s21-pk3-sigil-paren-types
  ; 1. Every position, compiled and run.
  (let (out:String (try (build-run-file "" "" "tests/fixtures/s21-pk3-sigil-paren-types.nuc")))
    (try (check-golden (string-as-view &out)
                       "3 -1 3\n3\n5 -3\n6 -4\n1 3\n2\n4\n1 2\n5\nnone\n6\n7\n3\n2\n"))
    (drop &out))

  ; 2. `--emit-nuch` prints the list forms, and a consumer imports the header
  ;    back (the header in `h/` only, so `resolve-import` cannot find the source
  ;    first) and calls through every sigil-paren signature.
  (let (ldir:String (try (test-scratch-sub "l"))
        hdir:String (try (test-scratch-sub "h"))
        lib:String (try (test-write-file "l/s21pk3l.nuc" "(ns s21pk3)
(import-use vector)
(defstruct Pt x:i32 y:i32)
(defstruct Holder (mv (? (Vector i32))) rv:!(Vector i32) q:?&Pt)
(deftype MV ?(Vector i32))
(defprotocol Wrap (wrap ((self &Self) n:i32):?(Vector i32)))
(defn mv-len (m:?(Vector i32)):i32
  (match m ((some v) (return (unsafe/cast i32 (count &v)))) (none (return -1))))
(defn mv-give (n:i32):?!(Vector i32)
  (when (< n 0) (return none))
  (let (v:(Vector i32) (vector-new))
    (dotimes (i n) (conj &v i))
    (let (r:!(Vector i32) (ok v))
      (return (some r)))))
(defn qr-len (q:?!(Vector i32)):i32
  (match q
    ((some r) (match r ((ok v) (return (unsafe/cast i32 (count &v)))) ((err e) (return -9))))
    (none (return -1))))
(defn q-x ((q (?ref Pt))):i32 (if-some (p q) (return (p 'x)) (return -3)))
"))
        lv:StrView (string-as-view &lib)
        nuch:String (try (emit-for-file "" "--emit-nuch" lv))
        nv:StrView (string-as-view &nuch)
        hp:String (try (write-into (string-as-view &hdir) "s21pk3l.nuch" nv))
        use:String (try (test-write-file "s21pk3u.nuc" "(import-use \"stdio.h\")
(import-use vector)
(import s21pk3l k)
(defn main ():i32
  (let (pt:k/Pt (k/Pt 5 6)
        q:?!(Vector i32) (k/mv-give 4)
        m:?(Vector i32) none
        v:(Vector i32) (vector-new)
        r:!(Vector i32) (ok v)
        qp:?&k/Pt (as-ref &pt)
        h:k/Holder (k/Holder m r qp))
    (printf \"%d %d %d %d\\n\" (k/qr-len q) (k/mv-len m) (k/q-x (h 'q)) (k/mv-len (h 'mv)))
    (return 0)))
"))
        uobj:String (str (string-as-view &hdir) "/s21pk3u.o")
        lobj:String (str (string-as-view &ldir) "/s21pk3l.o"))
    (try (check-line nv "(defstruct Holder (mv (? (Vector i32))) (rv (! (Vector i32))) (q (?ref Pt)))"))
    (try (check-line nv "(deftype MV (? (Vector i32)))"))
    (try (check-line nv "(defprotocol Wrap (wrap ((self (ref Self)) n:i32) (? (Vector i32))))"))
    (try (check-line nv "(declare mv-len ((m (? (Vector i32)))) :i32)"))
    (try (check-line nv "(declare mv-give ((n i32)) (?! (Vector i32)))"))
    (try (check-line nv "(declare q-x ((q (?ref Pt))) :i32)"))
    (try (compile-object-in (string-as-view &hdir)
                            (string-as-view &use)
                            (string-as-view &uobj)))
    (try (compile-object-in "" lv (string-as-view &lobj)))
    (let (parts:String (str (string-as-view &uobj) " "
                            (string-as-view &lobj))
          got:String (try (cc-link-run "" (string-as-view &parts))))
      (try (check-golden (string-as-view &got) "4 -1 5 -1\n"))
      (drop &got)
      (drop &parts))
    (drop &lobj)
    (drop &uobj)
    (drop &use)
    (drop &hp)
    (drop &nuch)
    (drop &lib)
    (drop &hdir)
    (drop &ldir))
  (return (ok)))

; One form per probe, on line 3 so the line is a claim rather than the default.
(defn s21-type-refused (form:StrView line:i32 msg:StrView):!void
  (let (src:String (str "(import-use vector)\n\n" form "\n(defn main ():i32 (return 0))\n")
        p:String (try (test-write-file "t.nuc" (string-as-view &src)))
        pv:StrView (string-as-view &p)
        c:Compiled (try (compile-path pv)))
    (when (c 'ok?) (fail! "expected a refusal of " (test-show form)))
    (try (check-error-at (ref c 'diags) pv line msg))
    (drop &c)
    (drop &p)
    (drop &src))
  (return (ok)))

; §5's near-miss: a sigil with a space after it is a bare `?` atom and a
; dangling paren form, named as such at the form's line -- including at
; `alloca`, whose type operand is an interned symbol with no line of its own.
; The list form takes exactly one operand.
(deftest s21-pk3-diagnostics
  (let (near:StrView "a type sigil must be attached to its type -- write ?T or ?(T ...) with no space")
    (try (s21-type-refused "(defn f (x:? (Vector i32)):i32 (return 0))" 3 near))
    (try (s21-type-refused "(defstruct S (f ? (Vector i32)))" 3 near))
    (try (s21-type-refused "(defvar g:? (Vector i32))" 3 near))
    (try (s21-type-refused "(defn f ():i32 (let (s:&i32 (alloca ? (Vector i32))) (return 0)))" 3 near))
    (try (s21-type-refused "(defn f ():i32 (return (unsafe/cast i32 (sizeof ?))))" 3 near))
    (try (s21-type-refused "(defn f ():i32 (return (as ? 1)))" 3 near))
    (try (s21-type-refused "(defn f ():i32 (return (as ! 1)))" 3
                           "a type sigil must be attached to its type -- write !T or !(T ...) with no space"))
    (try (s21-type-refused "(defn f ():i32 (return (as ?! 1)))" 3
                           "a type sigil must be attached to its type -- write ?!T or ?!(T ...) with no space")))
  (try (s21-type-refused "(defn f ((x (? i32 i64))):i32 (return 0))" 3 "'?' takes one type -- (? T)"))
  (try (s21-type-refused "(defn f ((x (?))):i32 (return 0))" 3 "'?' takes one type -- (? T)"))
  (try (s21-type-refused "(defn f ((x (!))):i32 (return 0))" 3 "'!' takes one type -- (! T)"))
  (try (s21-type-refused "(defn f ((x (?! i32 i64))):i32 (return 0))" 3 "'?!' takes one type -- (?! T)"))
  (return (ok)))

; ---------------------------------------------------------------------------
; PK-4a: a sigil over a concrete type is concrete to the generic-pattern walkers
; ---------------------------------------------------------------------------

; H5 (pointer-kind-spellings.md §1.4): the fixture's `(Vector ?Pt)` was a fake
; type variable, so the pre-PK-4a compiler stamped `f_qpt.pVector.i32` from a
; `(Vector i32)` argument and the program printed 1. A sigil over a type
; variable is refused until PK-4b, rather than collected under a spelling the
; unifier never binds.
(deftest s21-pk4a-h5
  (let (path:StrView "tests/fixtures/s21-pk4a-h5.nuc"
        c:Compiled (try (compile-path path)))
    (when (c 'ok?) (fail! "expected (Vector i32) to be refused where (Vector ?Pt) was declared"))
    (try (check-error-at (ref c 'diags) path 15
                         "f-qpt: argument 1 has type ptr:Vector.i32, which does not match parameter type ptr:Vector.Maybe.Pt"))
    (drop &c))
  (let (out:String (try (build-run-file "" "" "tests/fixtures/s21-pk4a-sigil-concrete.nuc")))
    (try (check-golden (string-as-view &out) "0 0 0\n1 0 1\n"))
    (drop &out))
  (try (s21-type-refused "(defn f-qt ((v (ref (Vector ?T)))):i32 (return 1))" 3
                         "Vector: '?T' -- a type sigil over a type variable is not supported in a generic pattern yet; write the concrete type"))
  (try (s21-type-refused "(defn f-bt ((v (ref (Vector !T)))):i32 (return 1))" 3
                         "Vector: '!T' -- a type sigil over a type variable is not supported in a generic pattern yet; write the concrete type"))
  (return (ok)))

; The IR of a `define`, header line dropped, so two functions can be compared
; body for body.
(defn s21-define-body (ir:StrView name:StrView):!StrView
  (match (ir-define ir name)
    (none (fail! "no `define` for " (sexp-quote name)))
    ((some block)
      (match (strview-find-byte &block (as ui8 10))
        ((some i) (return (ok (strview-drop-bytes block (+ i 1)))))
        (none (fail! "a one-line `define` for " (sexp-quote name)))))))

; The second face of H5: `value-annot-type` gates the value-position annotation
; on the same predicate, so `q:?&Pt` used to be refused as an unknown type while
; `(as ?&Pt q)` worked. Now the two are one function body.
(deftest s21-value-annotation
  (let (src:StrView "(import-use \"stdio.h\")
(defstruct Pt x:i32 y:i32)
(defn via-annot (q:&Pt):?&Pt (return q:?&Pt))
(defn via-as (q:&Pt):?&Pt (return (as ?&Pt q)))
(defn main ():i32
  (let (pt:Pt (Pt 5 6))
    (if-some (p (via-annot &pt)) (printf \"%d\\n\" (p 'x)) (printf \"none\\n\"))
    (if-some (p (via-as &pt)) (printf \"%d\\n\" (p 'y)) (printf \"none\\n\"))
    (return 0)))
"
        ir:String (try (source-ir src))
        iv:StrView (string-as-view &ir)
        a:StrView (try (s21-define-body iv "via-annot"))
        b:StrView (try (s21-define-body iv "via-as")))
    (try (check-eq a b))
    (drop &ir))
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(defstruct Pt x:i32 y:i32)
(defn via-annot (q:&Pt):?&Pt (return q:?&Pt))
(defn via-as (q:&Pt):?&Pt (return (as ?&Pt q)))
(defn main ():i32
  (let (pt:Pt (Pt 5 6))
    (if-some (p (via-annot &pt)) (printf \"%d\\n\" (p 'x)) (printf \"none\\n\"))
    (if-some (p (via-as &pt)) (printf \"%d\\n\" (p 'y)) (printf \"none\\n\"))
    (return 0)))
")))
    (try (check-golden (string-as-view &out) "5\n6\n"))
    (drop &out))
  (return (ok)))

; ---------------------------------------------------------------------------
; PK-5b: `addr-of` is retired, and stays reserved
; ---------------------------------------------------------------------------

; The head is in `g-special-form-set` so no definition can shadow it, and every
; path that used to have an `addr-of` arm now hands the name to
; `retired-form-message`: `emit-list`'s dispatch tail, `gcheck`'s call walk, the
; `defvar` constant renderer, and `parse-type-from-node`'s fall-through for the
; type slot (`(addr-of T)` was a legal spelling of `(ref T)` until PK-5b). A
; parameter type is the one slot the header modes resolve too, so that probe
; runs under all three.
(deftest s21-addr-of-retired
  (let (msg:StrView "'addr-of' was retired: write &x, or (ref x) / (ref p 'field)")
    (try (s21-type-refused "(defn f ():i32 (let (x:i32 1 p:&i32 (addr-of x)) (return 0)))" 3 msg))
    (try (s21-type-refused "(defstruct Pt x:i32) (defn f (p:&Pt):&i32 (return (addr-of p 'x)))" 3 msg))
    (try (s21-type-refused "(defvar gx:i32 3) (defvar gp:&i32 (addr-of gx))" 3 msg))
    (try (s21-type-refused "(defn f ():i32 (let (x:i32 1 p:(addr-of i32) &x) (return 0)))" 3 msg))
    (try (s21-type-refused "(defprotocol Sh (sh (self:&Self):i32)) (defn g (x:T :where (Sh T)):i32 (return (deref (addr-of x))))" 3 msg))
    (try (s21-type-refused "(defn f (x:i32):i32 (return (addr-of)))" 3 msg))
    (try (check-probe-refused "(defn f ((x (addr-of i32))):i32 (return 0))" msg))
    (try (s21-type-refused "(defn addr-of (x:i32):i32 (return x))" 3 "'addr-of' already names a special form")))
  (return (ok)))

; Stage 18 TF-6 category (c) — one name, one definition, across compilation units.
;
; Design: design/stage18-tooling/overview.md §T6.6.
;
; These units are about what a *unit boundary* does to a name: the R4
; redefinition rule, and the `.nuch` and namespace machinery around it.

; ---------------------------------------------------------------------------
; R4: a redefinition is a located error (b4)
; ---------------------------------------------------------------------------

; Line 2 in every fixture is the second definition. The shell grepped stderr for
; `redefinition of 'X'` and again for `<file>:2: error:`; one `check-error-at`
; requires both of the same diagnostic, and `check-no-line-zero` is the sweep
; that used to be a `:0:` substring search.
(defn check-redefines (src:StrView nm:StrView):!void
  (let (p:String (try (test-write-file "t.nuc" src))
        pv:StrView (string-as-view &p)
        c:Compiled (try (compile-path pv))
        want:String (str "redefinition of '" nm "'"))
    (try (check-no-line-zero (ref c 'diags)))
    (try (check-error-at (ref c 'diags) pv 2 (string-as-view &want)))
    (drop &want)
    (drop &c)
    (drop &p)
    (return (ok))))

(deftest b4r-struct
  (try (check-redefines "(defstruct RdS a:i32)
(defstruct RdS b:i32 c:i32)
(defn main ():i32 (return 0))
" "RdS")))

(deftest b4r-union
  (try (check-redefines "(defunion RdU (ra x:i32) (rb y:i32))
(defunion RdU (rc x:i32))
(defn main ():i32 (return 0))
" "RdU")))

(deftest b4r-proto
  (try (check-redefines "(defprotocol RdP (rm (self:Self):i32))
(defprotocol RdP (rn (self:Self):i32))
(defn main ():i32 (return 0))
" "RdP")))

(deftest b4r-macro
  (try (check-redefines "(defmacro rd-m (x) x)
(defmacro rd-m (x) 99)
(defn main ():i32 (return (rd-m 0)))
" "rd-m")))

(deftest b4r-enum
  (try (check-redefines "(defenum RdE rd-a rd-b)
(defenum RdE rd-c rd-d)
(defn main ():i32 (return 0))
" "RdE")))

; A member, not the enumeration: two enums may coexist, but one member name
; still means one thing.
(deftest b4r-enum-member
  (try (check-redefines "(defenum RdE1 rd-x rd-y)
(defenum RdE2 rd-y rd-z)
(defn main ():i32 (return rd-y))
" "rd-y")))

(deftest b4r-tmpl
  (try (check-redefines "(defstruct (RdBox T) v:T)
(defstruct (RdBox T) w:T)
(defn main ():i32 (return 0))
" "RdBox")))

(deftest b4r-utmpl
  (try (check-redefines "(defunion (RdRes T) (rok v:T) (rno))
(defunion (RdRes T) (ryes v:T))
(defn main ():i32 (return 0))
" "RdRes")))

(deftest b4r-var
  (try (check-redefines "(defvar rd-v:i32 1)
(defvar rd-v:i32 2)
(defn main ():i32 (return rd-v))
" "rd-v")))

(deftest b4r-const
  (try (check-redefines "(defconst RD-K 1)
(defconst RD-K 2)
(defn main ():i32 (return RD-K))
" "RD-K")))

; The shape R4 was actually written for (§11.1): the two definitions are in two
; different FILES and neither file can see the other. `lib/prelude.nuc` and
; `lib/list.nuc` both defining `Node` with different field nullability was this,
; and the winner was decided by import order. The diagnostic must name the other
; file, which is the whole reason the definition records carry `src-file`.
(deftest b4-redefinition-cross-file
  (let (dir:StrView (try (test-scratch))
        a:String (try (test-write-file "b4r-fa.nuc" "(defstruct RdX n:i32)\n"))
        b:String (try (test-write-file "b4r-fb.nuc" "(defstruct RdX n:i32 m:i32)\n"))
        m:String (try (test-write-file "b4r-fm.nuc" "(import b4r-fa)
(import b4r-fb)
(defn main ():i32 (return 0))
"))
        c:Compiled (try (compile-path-in dir (string-as-view &m)))
        raw-text:StrView (string-as-view (ref c 'raw-text)))
    (try (check-error-anywhere (ref c 'diags) "redefinition of 'RdX'"))
    (try (check-contains raw-text (string-as-view &a)))
    (drop &c)
    (drop &m)
    (drop &b)
    (drop &a)))

; Equal values are NOT an exemption. The first external program to meet R4 — the
; Doom port, 2026-08-15 — collided on seven same-valued `defconst`s in five file
; pairs, two of them commented as deliberate copies, so this is the shape a
; future relaxation would be tempted by. Pinned because the rule is about a name
; having one meaning, not about detecting disagreement: letting equal values
; through means the compiler decides which collisions matter.
(deftest b4-redefinition-same-value
  (let (dir:StrView (try (test-scratch))
        a:String (try (test-write-file "b4r-eqa.nuc" "(defconst RD-EQ 7)\n"))
        b:String (try (test-write-file "b4r-eqb.nuc" "(defconst RD-EQ 7)\n"))
        m:String (try (test-write-file "b4r-eqm.nuc" "(import b4r-eqa)
(import b4r-eqb)
(defn main ():i32 (return RD-EQ))
"))
        c:Compiled (try (compile-path-in dir (string-as-view &m)))
        raw-text:StrView (string-as-view (ref c 'raw-text)))
    (try (check-error-anywhere (ref c 'diags) "redefinition of 'RD-EQ'"))
    (try (check-contains raw-text (string-as-view &a)))
    (drop &c)
    (drop &m)
    (drop &b)
    (drop &a)))

; …and the fix the diagnostic recommends has to work: one owner, reached by
; `import`. This is the migration the port took, and it is the half of the
; ruling that makes it liveable rather than merely strict.
(deftest b4-redefinition-same-value-fix
  (let (dir:StrView (try (test-scratch))
        a:String (try (test-write-file "b4r-owna.nuc" "(defconst RD-OWN 7)\n"))
        b:String (try (test-write-file "b4r-ownb.nuc" "(import b4r-owna)
(defn rd-own-b ():i32 (return RD-OWN))
"))
        m:String (try (test-write-file "b4r-ownm.nuc" "(import b4r-owna)
(import b4r-ownb)
(defn main ():i32 (return (+ RD-OWN (rd-own-b))))
")))
    (try (check-file-exit dir (string-as-view &m) 14))
    (drop &m)
    (drop &b)
    (drop &a)))

; The rule is per compilation unit, so re-importing one file through two paths —
; the diamond every non-trivial program has — must stay legal. This is what
; `same-definition-site` protects: the registrars really are re-entered.
(deftest b4-redefinition-diamond-ok
  (let (dir:StrView (try (test-scratch))
        base:String (try (test-write-file "b4r-diamond.nuc" "(defstruct RdD n:i32)
(defunion RdDU (da x:i32) (db))
(defprotocol RdDP (dm (self:Self):i32))
(defmacro rd-dm (x) x)
(defenum RdDE rd-da rd-db)
(defconst RD-DK 3)
(defstruct (RdDBox T) v:T)
"))
        l:String (try (test-write-file "b4r-dl.nuc" "(import b4r-diamond)
(defn rd-l ():i32 (return RD-DK))
"))
        r:String (try (test-write-file "b4r-dr.nuc" "(import b4r-diamond)
(defn rd-r ():i32 (return rd-da))
"))
        m:String (try (test-write-file "b4r-dm.nuc" "(import b4r-dl)
(import b4r-dr)
(import b4r-diamond)
(defn main ():i32 (return (+ (rd-l) (rd-r))))
")))
    (try (check-file-exit dir (string-as-view &m) 3))
    (drop &m)
    (drop &r)
    (drop &l)
    (drop &base)))

; ---------------------------------------------------------------------------
; Two namespaces, one name (W9 §9.6)
; ---------------------------------------------------------------------------

(defn w35-write-libs ():!StrView
  (let (dir:StrView (try (test-scratch))
        a:String (try (test-write-file "w35qa.nuc" "(ns w35qa)
(defn w35-desc (x:i32):i32 (return (+ x 1)))
"))
        b:String (try (test-write-file "w35qb.nuc" "(ns w35qb)
(defn w35-desc (x:i32):i32 (return (+ x 2)))
")))
    (drop &b)
    (drop &a)
    (return (ok dir))))

; Both prefixed, both calls qualified: two definitions, two symbols, and each
; qualified spelling reaches its own.
(deftest w9-two-ns-one-name
  (let (dir:StrView (try (w35-write-libs))
        m:String (try (test-write-file "w35both.nuc" "(import-prefixed w35qa a)
(import-prefixed w35qb b)
(defn main ():i32 (return (+ (a/w35-desc 10) (b/w35-desc 20))))
")))
    (try (check-file-exit dir (string-as-view &m) 33))
    (drop &m)))

(deftest w9-two-ns-distinct-symbols
  (let (dir:StrView (try (w35-write-libs))
        m:String (try (test-write-file "w35both.nuc" "(import-prefixed w35qa a)
(import-prefixed w35qb b)
(defn main ():i32 (return (+ (a/w35-desc 10) (b/w35-desc 20))))
"))
        c:Compiled (try (compile-path-in dir (string-as-view &m)))
        iv:StrView (string-as-view (ref c 'ir)))
    (try (check-match iv "define *@w35qa__w35-desc(*"))
    (try (check-match iv "define *@w35qb__w35-desc(*"))
    (drop &c)
    (drop &m)))

; Flatten exactly one: the bare call is not ambiguous at all, because only one
; candidate is in this file's unqualified space.
(deftest w9-two-ns-bare-picks-flattened
  (let (dir:StrView (try (w35-write-libs))
        m:String (try (test-write-file "w35one.nuc" "(import-use w35qa)
(import-prefixed w35qb b)
(defn main ():i32 (return (w35-desc 10)))
")))
    (try (check-file-exit dir (string-as-view &m) 11))
    (drop &m)))

; Flatten BOTH: now the bare call really does name two functions, and that is
; the use R4 was refusing the definitions to prevent. Located, and both
; candidates named with a spelling that resolves.
(deftest w9-two-ns-ambiguous-use
  (let (dir:StrView (try (w35-write-libs))
        m:String (try (test-write-file "w35amb.nuc" "(import-use w35qa)
(import-use w35qb)
(defn main ():i32 (return (w35-desc 10)))
"))
        mv:StrView (string-as-view &m)
        c:Compiled (try (compile-path-in dir mv))
        raw-text:StrView (string-as-view (ref c 'raw-text)))
    (try (check-error-at (ref c 'diags) mv 3 "ambiguous call to 'w35-desc'"))
    (try (check-contains raw-text "'w35qa/w35-desc'"))
    (try (check-contains raw-text "'w35qb/w35-desc'"))
    (drop &c)
    (drop &m)))

; Neither flattened: the name is not in the unqualified space, and the message
; says where it IS and what to write instead of guessing.
(deftest w9-two-ns-unqualified-unreachable
  (let (dir:StrView (try (w35-write-libs))
        m:String (try (test-write-file "w35none.nuc" "(import-prefixed w35qa a)
(import-prefixed w35qb b)
(defn main ():i32 (return (w35-desc 10)))
"))
        c:Compiled (try (compile-path-in dir (string-as-view &m)))
        raw-text:StrView (string-as-view (ref c 'raw-text)))
    (try (check-contains raw-text "defined in namespaces 'w35qa' and 'w35qb'"))
    (try (check-contains raw-text "write 'a/w35-desc' or 'b/w35-desc' here"))
    (drop &c)
    (drop &m)))

; R4's rule survives where its reason does: ONE namespace still may not define
; one signature twice, because that pair really would emit a symbol twice. The
; test is the emitted PREFIX, not the namespace name, so two files sharing a
; namespace are still a duplicate.
(deftest w9-one-ns-still-refuses-duplicate
  (let (dir:StrView (try (test-scratch))
        a:String (try (test-write-file "w35dupa.nuc" "(ns w35dup)
(defn w35-dup (x:i32):i32 (return x))
"))
        b:String (try (test-write-file "w35dupb.nuc" "(ns w35dup)
(defn w35-dup (x:i32):i32 (return (+ x 1)))
"))
        m:String (try (test-write-file "w35dupm.nuc" "(import-use w35dupa)
(import-use w35dupb)
(defn main ():i32 (return 0))
")))
    (try (check-file-rejects dir (string-as-view &m)
                             "duplicate definition of 'w35-dup'"))
    (drop &m)
    (drop &b)
    (drop &a)))

; ---------------------------------------------------------------------------
; `defcast` reach, and the note that names a rule that almost applies (W9)
; ---------------------------------------------------------------------------

; Every typed slot, all on the rule's exact pair, linked and RUN — the baseline
; compiles none of these past the first one.
(deftest w9-defcast-every-slot
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(defn i2p (x:i64):ptr (return (unsafe/cast ptr x)))
(defcast i64 ptr i2p)
(defstruct Bx p:ptr)
(defn show (p:ptr):i64 (return (unsafe/cast i64 p)))
(defn mk ():ptr (return (as i64 3)))
(defn mk2 ():ptr (as i64 4))
(defn main ():int
  (let (a:i64 (show (as i64 1))
        l:ptr (as i64 2)
        b:&Bx (alloca Bx)
        arr:ptr (alloca ptr 2))
    (set! (b 'p) (as i64 5))
    (set! (aref (unsafe/cast &ptr arr) 0) (as i64 6))
    (printf \"%lld %lld %lld %lld %lld %lld\\n\"
      a (show l) (show (mk)) (show (mk2)) (show (b 'p))
      (show (aref (unsafe/cast &ptr arr) 0))))
  (return 0))
")))
    (try (check-eq (string-as-view &out) "1 2 3 4 5 6\n"))
    (drop &out)))

(defn defcast-nocompose-src ():StrView
  (return "(defn i2p (x:i64):ptr (return (unsafe/cast ptr x)))
(defcast i64 ptr i2p)
(defn take (p:ptr):void (return))
(defn main ():int (take 0) (return 0))
"))

; The ruling: built-in widening does NOT chain into a user rule. A bare literal
; is i32; the i64 rule stays out of reach, in argument position…
(deftest w9-defcast-no-composition
  (try (check-source-rejects (defcast-nocompose-src) "argument 1 has type i32")))

; …and the refusal names the rule that ALMOST applies, with the spelling that
; reaches it. Without this the ruling is indistinguishable from the rule never
; having been registered. The shell grepped for `note: `; the record makes the
; note a field, so this cannot pass on an error that merely says the words.
(deftest w9-defcast-note-names-rule
  (let (c:Compiled (try (compile-source (defcast-nocompose-src))))
    (try (check-note-anywhere (ref c 'diags) "a defcast rule converts i64 to ptr"))
    (try (check-note-anywhere (ref c 'diags) "(as i64"))
    (drop &c)))

; The `as` position is the one where the bare diagnostic was actively wrong:
; "use unsafe/cast" throws away the safety the defcast was written to buy.
(deftest w9-defcast-note-on-as
  (let (c:Compiled (try (compile-source "(defn i2p (x:i64):ptr (return (unsafe/cast ptr x)))
(defcast i64 ptr i2p)
(defn main ():int (let (q:ptr (as ptr 0)) (return 0)))
")))
    (try (check-note-anywhere (ref c 'diags) "a defcast rule converts i64 to ptr"))
    (drop &c)))

; No rule to that target => no note. Pins the note against firing on every
; unrelated type mismatch in a file that happens to contain a defcast.
(deftest w9-defcast-note-only-on-near-miss
  (let (c:Compiled (try (compile-source "(defn i2p (x:i64):ptr (return (unsafe/cast ptr x)))
(defcast i64 ptr i2p)
(defn take (x:f64):void (return))
(defn main ():int (take (unsafe/cast ptr 0)) (return 0))
"))
        ds:(Vector Diagnostic) (c 'diags))
    (when (= (count &ds) 0) (fail! "expected a type error"))
    (try (check-not-contains (string-as-view (ref c 'raw-text)) "a defcast rule"))
    (drop &c)))

; Built-in coercion still wins: a rule may not be registered for a pair the
; compiler already converts, so "which fires first" can never be observed.
(deftest w9-defcast-builtin-wins
  (try (check-source-rejects "(defn widen (x:i32):i64 (return (as i64 x)))
(defcast i32 i64 widen)
(defn main ():int (return 0))
" "handled by built-in coercion")))

; ---------------------------------------------------------------------------
; Layout and union registration resolve on REACHABILITY (W9 item 40)
; ---------------------------------------------------------------------------
;
; Before this, a field access below the import reported "no field 'x' on struct
; 'S'" for a struct that has that field, a literal reported "too many
; initializers", and a by-value parameter compiled to `define … @f(i0 %v.arg)` —
; a SILENT miscompile, which is why every case here links and RUNS rather than
; just compiling.

(defn w9lay-lib ():StrView
  (return "(defconst W9LAY-N 3)
(defstruct W9LayBox (a i32) (b i32))
(defstruct W9LayArr (xs (array i32 W9LAY-N)) n:i32)
(defunion W9LayOpt (W9LaySome x:i32) W9LayNone)
(defmacro w9lay-mac (x) `(+ ~x 100))
"))

; Every use ABOVE the import: a literal, a field read, a by-value parameter (the
; silent one), an array-field struct whose extent is a same-file `defconst`, and
; a union built with `make` and taken apart with `match`.
(defn w9lay-body ():StrView
  (return "(import-use \"stdio.h\")
(defn w9lay-byval ((v W9LayBox)):i32 (return (+ (_get &v 'a) (_get &v 'b))))
(defn main ():i32
  (let (bx (W9LayBox 3 4)
        ar:&W9LayArr (alloca W9LayArr)
        u (make W9LayOpt W9LaySome 5))
    (set! (aref (ar 'xs) 2) 6)
    (set! (ar 'n) 7)
    (printf \"%d %d %d %d %d\\n\"
      (_get bx 'a) (w9lay-byval bx) (aref (ar 'xs) 2) (_get ar 'n)
      (match u ((W9LaySome x) x) (W9LayNone 0))))
  (return 0))
"))

; The library directory, and `below.nuc` — the import last.
(defn w9lay-setup ():!String
  (let (ldir:String (try (test-scratch-sub "l"))
        lib:String (try (test-write-file "l/w9lay.nuc" (w9lay-lib)))
        body:String (str (w9lay-body) "(import-use w9lay)\n")
        below:String (try (test-write-file "below.nuc" (string-as-view &body))))
    (drop &below)
    (drop &body)
    (drop &lib)
    (return (ok ldir))))

(deftest w9-layout-below-use-runs
  (let (ldir:String (try (w9lay-setup))
        dir:StrView (try (test-scratch))
        below:String (str dir "/below.nuc")
        out:String (try (build-run-file (string-as-view &ldir) ""
                                        (string-as-view &below))))
    (try (check-eq (string-as-view &out) "3 7 6 7 5\n"))
    (drop &out)
    (drop &below)
    (drop &ldir)))

; The by-value parameter, read off the IR rather than the exit status: `i0` is
; what an unlaid-out struct classified to, and it is the shape LLVM rejects with
; no source location at all.
(deftest w9-layout-byval-classified
  (let (ldir:String (try (w9lay-setup))
        dir:StrView (try (test-scratch))
        below:String (str dir "/below.nuc")
        c:Compiled (try (compile-path-in (string-as-view &ldir)
                                         (string-as-view &below))))
    (try (check-match (string-as-view (ref c 'ir))
                      "define i32 @w9lay-byval(i64 *"))
    (drop &c)
    (drop &below)
    (drop &ldir)))

; The same shape inside ONE file: `(defn f (v:S))` textually above
; `(defstruct S …)`. Recorded as latent-and-unfixed since W1d — the layout
; prescan closes it with the cross-file case, since neither is about imports.
(deftest w9-layout-same-file-forward
  (try (check-source-exit "(defn w9lay-fwd ((v W9LayFwd)):i32 (return (+ (_get &v 'p) (_get &v 'q))))
(defstruct W9LayFwd (p i32) (q i32))
(defn main ():i32 (return (w9lay-fwd (W9LayFwd 2 3))))
" 5)))

; A `.nuch` header is a file in the graph like any other: its `defstruct` reaches
; the very same `emit-defstruct`, so its layout hoists too. The library's source
; is deliberately out of the include path — an import prefers the `.nuc` when
; both are there.
(deftest w9-layout-nuch-below-use
  (let (ldir:String (try (test-scratch-sub "l"))
        hdir:String (try (test-scratch-sub "h"))
        lib:String (try (test-write-file "l/w9lay.nuc" (w9lay-lib)))
        nuch:String (try (emit-for-file "" "--emit-nuch" (string-as-view &lib)))
        hp:String (try (test-write-file "h/w9lay.nuch" (string-as-view &nuch)))
        use:String (try (test-write-file "hbelow.nuc" "(import-use \"stdio.h\")
(defn main ():i32
  (let (bx (W9LayBox 8 9))
    (printf \"%d\\n\" (+ (_get bx 'a) (_get bx 'b))))
  (return 0))
(import-use w9lay)
"))
        c:Compiled (try (compile-path-in (string-as-view &hdir)
                                         (string-as-view &use))))
    (try (check-empty (string-as-view (ref c 'raw-text))))
    (drop &c)
    (drop &use)
    (drop &hp)
    (drop &nuch)
    (drop &lib)
    (drop &hdir)
    (drop &ldir)))

; Registration moved; EMISSION did not. Each type is DEFINED exactly once — a
; prescan that wrote a `%Name = type` line of its own would double it, which the
; LLVM parser rejects — and the two import orders carry the same set of
; top-level definitions, so nothing was gained or lost by moving the import.
(deftest w9-layout-emission-unmoved
  (let (ldir:String (try (w9lay-setup))
        ldv:StrView (string-as-view &ldir)
        dir:StrView (try (test-scratch))
        below:String (str dir "/below.nuc")
        abody:String (str "(import-use w9lay)\n" (w9lay-body))
        above:String (try (test-write-file "above.nuc" (string-as-view &abody)))
        bc:Compiled (try (compile-path-in ldv (string-as-view &below)))
        ac:Compiled (try (compile-path-in ldv (string-as-view &above)))
        biv:StrView (string-as-view (ref bc 'ir)))
    (try (check-eq-int (count-lines-with-prefix biv "%W9LayBox = type ") 1 "%W9LayBox"))
    (try (check-eq-int (count-lines-with-prefix biv "%W9LayArr = type ") 1 "%W9LayArr"))
    (try (check-eq-int (count-lines-with-prefix biv "%W9LayOpt = type ") 1 "%W9LayOpt"))
    (try (check-same-decl-set (string-as-view (ref ac 'ir)) biv))
    (drop &ac)
    (drop &bc)
    (drop &above)
    (drop &abody)
    (drop &below)
    (drop &ldir)))

; The residue, pinned so it is a decision rather than an oversight: a `defmacro`
; is a COMPILED function, not a registration — `emit-defmacro` runs codegen and
; materializes a JIT module — so it stays where the emitter is and still needs
; the import above the use.
(deftest w9-layout-macro-still-needs-import-above
  (let (ldir:String (try (test-scratch-sub "l"))
        lib:String (try (test-write-file "l/w9lay.nuc" (w9lay-lib)))
        m:String (try (test-write-file "mac.nuc" "(defn main ():i32 (return (w9lay-mac 1)))
(import-use w9lay)
")))
    (try (check-file-rejects (string-as-view &ldir)
                             (string-as-view &m)
                             "unknown: w9lay-mac"))
    (drop &m)
    (drop &lib)
    (drop &ldir)))

; ---------------------------------------------------------------------------
; The private definers are namespace-private (B5 / B3′)
; ---------------------------------------------------------------------------

(defn b5-write-lib ():!StrView
  (let (dir:StrView (try (test-scratch))
        lib:String (try (test-write-file "b5-plib.nuc" "(ns b5p)
(defstruct- B5HiddenS n:i32)
(defunion- B5HiddenU (UA n:i32) UB)
(defmacro- b5-hidden-mac (x) x)
(defprotocol- B5HiddenP (b5-hm ((self (ref Self))) i32))
(defstruct B5PublicS n:i32)
(defn b5-lib-ok ():i32 (return 7))
")))
    (drop &lib)
    (return (ok dir))))

; These spell the private names THROUGH THE PREFIX. Before B3′ a type name was
; bare-keyed and globally visible, so a bare `B5HiddenS` reached the library and
; privacy was the only thing that could refuse it. R1 makes the bare spelling
; fail for a *scope* reason, which would leave these asserting something they no
; longer test. Qualified, they still measure privacy: the prefix resolves, the
; entry is found, and `binding-visible` hides it.
(defn check-b5-private (name:StrView src:StrView needle:StrView):!void
  (let (dir:StrView (try (b5-write-lib))
        p:String (try (test-write-file name src)))
    (try (check-file-rejects dir (string-as-view &p) needle))
    (drop &p)
    (return (ok))))

(deftest b5-private-struct
  (try (check-b5-private "b5-cs.nuc" "(import-prefixed b5-plib bp)
(defn b5-take ((h (ref bp/B5HiddenS))):i32 (return (h 'n)))
(defn main ():i32 (return 0))
" "unknown type: bp/B5HiddenS")))

(deftest b5-private-union
  (try (check-b5-private "b5-cu.nuc" "(import-prefixed b5-plib bp)
(defn b5-take ((u (ptr bp/B5HiddenU))):i32 (return 0))
(defn main ():i32 (return 0))
" "unknown type: bp/B5HiddenU")))

(deftest b5-private-macro
  (try (check-b5-private "b5-cm.nuc" "(import-prefixed b5-plib bp)
(defn main ():i32
  (return (b5-hidden-mac 1)))
" "unknown: b5-hidden-mac")))

(deftest b5-private-protocol
  (try (check-b5-private "b5-cp.nuc" "(import-prefixed b5-plib bp)
(defstruct B5Cs n:i32)
(extend B5Cs bp/B5HiddenP
  (defn b5-hm ((self (ref B5Cs))):i32 (return 1)))
(defn main ():i32 (return 0))
" "extend: unknown protocol 'bp/B5HiddenP'")))

; Positive control. Without it the four rejections above would also pass if the
; filter simply hid everything: a file INSIDE the namespace still sees the
; private struct, union and macro, and a consumer still reaches the library's
; PUBLIC names through the prefix.
; 1 (private struct field) + 2 (private union sizeof) + 4 (private macro)
; + 7 (public fn) + 1 (public struct field 6 - 5) = 15.
(deftest b5-private-visible-inside
  (let (dir:StrView (try (b5-write-lib))
        pin:String (try (test-write-file "b5-pin.nuc" "(ns b5p)
(import-use b5-plib)

(defn b5-inside-sum ():i32
  (let (s:(ref B5HiddenS) (B5HiddenS 1)
        usz:i32 (if (> (sizeof B5HiddenU) 0) 2 0)
        m:i32 (b5-hidden-mac 4))
    (return (+ (+ (s 'n) usz) m))))
"))
        m:String (try (test-write-file "b5-pmain.nuc" "(import-prefixed b5-pin bin)
(import-prefixed b5-plib bp)

(defn main ():i32
  (let (p:(ref bp/B5PublicS) (bp/B5PublicS 6))
    (return (+ (bin/b5-inside-sum) (+ (bp/b5-lib-ok) (- (p 'n) 5))))))
")))
    (try (check-file-exit dir (string-as-view &m) 15))
    (drop &m)
    (drop &pin)))

; The protocol's positive control is the DIAGNOSTIC, not a run: from inside the
; namespace the name resolves, so `extend` gets as far as the conformance check
; instead of "unknown protocol". (That conformance then fails, but for an
; unrelated pre-existing reason — an `extend` written inside an explicit `(ns …)`
; does not conform even for a PUBLIC protocol. What this pins is which of the two
; diagnostics fires.)
(deftest b5-private-protocol-visible-inside
  (let (dir:StrView (try (b5-write-lib))
        pin:String (try (test-write-file "b5-ppin.nuc" "(ns b5p)
(import-use b5-plib)

(defstruct B5InS n:i32)
(extend B5InS B5HiddenP
  (defn b5-hm ((self (ref B5InS))):i32 (return 1)))
"))
        m:String (try (test-write-file "b5-ppm.nuc" "(import-prefixed b5-ppin pi)
(defn main ():i32 (return 0))
"))
        c:Compiled (try (compile-path-in dir (string-as-view &m)))
        raw-text:StrView (string-as-view (ref c 'raw-text)))
    (try (check-not-contains raw-text "extend: unknown protocol"))
    (try (check-error-anywhere (ref c 'diags)
                               "does not conform to protocol 'b5p/B5HiddenP'"))
    (drop &c)
    (drop &m)
    (drop &pin)))

; ---------------------------------------------------------------------------
; A `(fn …)` slot takes what `let` takes, and checks the SIGNATURE (W9 / S16 FP-1)
; ---------------------------------------------------------------------------

(deftest w9-fnslot-arg
  (try (check-file-exit "" "tests/fixtures/w9-fnslot-arg.nuc" 0)))

(defn fnslot-hdr ():StrView
  (return "(defstruct RS a:i32)
(defn fscb (x:i32):i32 (return (* 2 x)))
(defn take-fn (f:(fn i32)(i32)):i32 (return (funcall f 21)))
"))

(defn fnslot-locals ():StrView
  (return "  (let (c:CStr \"hi\" p:ptr (unsafe/cast ptr c) r:ptr (unsafe/cast ptr c) rf:&RS (RS 1) g:(fn i32)(i32) fscb)
"))

; `null` and a real fn value are the two a fn slot takes; the argument position
; must answer exactly as the `let` slot does, which is the whole claim.
(defn check-fnslot-row (spelling:StrView want:bool):!void
  (let (a:String (str (fnslot-hdr) "(defn main ():i32\n" (fnslot-locals)
                      "    (return (take-fn " spelling "))))\n")
        l:String (str (fnslot-hdr) "(defn main ():i32\n" (fnslot-locals)
                      "    (let (f:(fn i32)(i32) " spelling ") (return 0))))\n")
        ga:bool (try (source-compiles? (string-as-view &a)))
        gl:bool (try (source-compiles? (string-as-view &l))))
    (when (!= ga want)
      (fail! spelling " in argument position: compiled=" (if ga "yes" "no")
             ", wanted " (if want "yes" "no")))
    (when (!= gl want)
      (fail! spelling " in a let slot: compiled=" (if gl "yes" "no")
             ", wanted " (if want "yes" "no")))
    (drop &l)
    (drop &a)
    (return (ok))))

(deftest w9-fnslot-arg-matches-let
  (try (check-fnslot-row "null" true))
  (try (check-fnslot-row "c" false))
  (try (check-fnslot-row "p" false))
  (try (check-fnslot-row "r" false))
  (try (check-fnslot-row "rf" false))
  (try (check-fnslot-row "7" false))
  (try (check-fnslot-row "\"s\"" false))
  (try (check-fnslot-row "g" true)))

; Stage 16 FP-3: the diagnostic names the fn type as the user WROTE it. It used
; to print `type-spelling`'s `__fnty_<id>` — the conformance-registry key, which
; has to stay round-trippable and names nothing in the source.
(deftest w9-fnslot-arg-diagnostic
  (let (src:String (str (fnslot-hdr) "(defn main ():i32
  (let (c:CStr \"hi\") (return (take-fn c))))
"))
    (try (check-source-rejects (string-as-view &src)
           "take-fn: argument 1 has type CStr, which does not match parameter type (i32):i32"))
    (drop &src)))

; FP-1: a fn-pointer slot checks the SIGNATURE, not just the kind. A matching
; signature must still pass at every typed slot.
(deftest s16-fp1-fnsig-match-accepted
  (let (src:String (str (fnslot-hdr) "(defn one-arg (a:i32):i32 (return a))
(defn wrong-ret (a:i32):i64 (return 1))
(defn main ():i32
  (let (ok:(fn i32)(i32) fscb) (return (funcall ok 1))))
"))
    (try (check-source-accepts (string-as-view &src)))
    (drop &src)))

; …and each shape of mismatch is refused with both signatures named. Arity and
; return type are the two that silently produced wrong values before FP-1.
(deftest s16-fp1-fnsig-mismatch-refused
  (let (arity:String (str (fnslot-hdr) "(defn wrong-arity (a:i32 b:i32):i32 (return a))
(defn main ():i32 (return (take-fn wrong-arity)))
")
        ret:String (str (fnslot-hdr) "(defn wrong-ret (a:i32):i64 (return 1))
(defn main ():i32 (return (take-fn wrong-ret)))
")
        lets:String (str (fnslot-hdr) "(defn wrong-arity (a:i32 b:i32):i32 (return a))
(defn main ():i32
  (let (f:(fn i32)(i32) wrong-arity) (return 0)))
"))
    (try (check-source-rejects (string-as-view &arity)
           "has type (i32, i32):i32, which does not match parameter type (i32):i32"))
    (try (check-source-rejects (string-as-view &ret)
           "has type (i32):i64, which does not match parameter type (i32):i32"))
    ; The `let` slot reaches the same rule through `coerce-int-val`.
    (try (check-source-rejects (string-as-view &lets)
           "let: init type mismatch for 'f': value is (i32, i32):i32, slot is (i32):i32"))
    (drop &lets)
    (drop &ret)
    (drop &arity))
  ; The two deliberate relaxations: pointer KIND is not part of a signature, and
  ; a bare elem-less `ptr` is the fn-pointer analogue of `void *`. Without these
  ; the ubiquitous `qsort` comparator shape would stop compiling.
  (try (check-source-accepts "(declare qs ((cmp (fn i32) (ptr ptr))) :void)
(defn c1 (a:&i32 b:(ref i32)):i32 (return 0))
(defn main ():i32 (qs c1) (return 0))
"))
  ; …but a bare ptr is NOT a wildcard for a function pointer: that would
  ; reinstate the data-pointer-into-callable conversion `unsafe/cast` owns.
  (let (wild:bool (try (source-compiles? "(declare qs2 ((cmp (fn i32) ((fn i32)(i32)))) :void)
(defn c2 (f:ptr):i32 (return 0))
(defn main ():i32 (qs2 c2) (return 0))
")))
    (when wild (fail! "a bare ptr was accepted as a function-pointer wildcard")))
  ; …and two different pointee types stay a refusal.
  (let (elem:bool (try (source-compiles? "(defstruct N a:i32)
(declare qs3 ((cmp (fn i32) (&N))) :void)
(defn c3 (p:&i32):i32 (return 0))
(defn main ():i32 (qs3 c3) (return 0))
")))
    (when elem (fail! "two different pointee types were accepted"))))

; The other half of the widened guard: two types that lower to the same IR
; string but differ in SIGN reach the literal range check, so an out-of-range
; literal argument is refused instead of wrapping silently — again exactly what
; `let` does with it.
(deftest w9-fnslot-arg-samewidth-sign-checked
  (try (check-source-rejects "(defn take-ui32 (x:ui32):ui32 (return x))
(defn main ():i32 (return (as i32 (take-ui32 -1))))
" "integer literal -1 does not fit ui32")))


; ---------------------------------------------------------------------------
; What a `.nuch` carries across the boundary (W9 items 24, 29, 36, 46)
;
; Every unit here compiles the library and its consumer SEPARATELY and links the
; two, because that is the only thing that tests what the header promised: the
; symbol has to be resolved by the linker rather than by the compiler having
; seen the library's source. The library's `.nuc` stays out of the include path
; throughout — beside its header an import takes the source, and nothing would
; be exercising a header at all.
; ---------------------------------------------------------------------------

; A library on disk: source under `l/`, generated header under `h/`. The two
; paths and the include directory are all the caller needs, and `NuchLib` owns
; them so a test's `let` stays about the test.
(defstruct NuchLib idir:String nuch:String src:String obj:String)

(extend NuchLib Drop)
(defn drop ((self &NuchLib)):void
  (drop (ref self 'idir))
  (drop (ref self 'nuch))
  (drop (ref self 'src))
  (drop (ref self 'obj)))

(defn nuch-idir ((l (ref NuchLib))):StrView (return (string-as-view (ref l 'idir))))
(defn nuch-header ((l (ref NuchLib))):StrView (return (string-as-view (ref l 'nuch))))
(defn nuch-src ((l (ref NuchLib))):StrView (return (string-as-view (ref l 'src))))
(defn nuch-obj ((l (ref NuchLib))):StrView (return (string-as-view (ref l 'obj))))

; Write the library, emit its header, and compile its object — every unit below
; needs all three, and an object no test links is cheaper than three call sites.
(defn nuch-lib (name:StrView src:StrView):!NuchLib
  (let (ldir:String (try (test-scratch-sub "l"))
        hdir:String (try (test-scratch-sub "h"))
        dir:StrView (try (test-scratch))
        nm:String (str name ".nuc")
        hn:String (str name ".nuch")
        lib:String (try (write-into (string-as-view &ldir)
                                    (string-as-view &nm) src))
        h:String (try (emit-into "" "--emit-nuch" (string-as-view &lib)
                                 (string-as-view &hdir)
                                 (string-as-view &hn)))
        obj:String (str dir "/" name ".o")
        r:&NuchLib (alloca NuchLib))
    (try (compile-object (string-as-view &lib)
                         (string-as-view &obj)))
    (set! (r 'idir) hdir)
    (set! (r 'nuch) h)
    (set! (r 'src) lib)
    (set! (r 'obj) obj)
    (drop &hn)
    (drop &nm)
    (drop &ldir)
    (return (ok (deref r)))))

; Compile `src` against `l`'s header into `<scratch>/<name>.o`, link it with the
; library's object, and run. The one shape every unit below is made of.
(defn nuch-link-run ((l (ref NuchLib)) name:StrView src:StrView):!String
  (let (dir:StrView (try (test-scratch))
        nm:String (str name ".nuc")
        p:String (try (test-write-file (string-as-view &nm) src))
        obj:String (str dir "/" name ".o"))
    (try (compile-object-in (nuch-idir l) (string-as-view &p)
                            (string-as-view &obj)))
    (let (parts:String (str (string-as-view &obj) " " (nuch-obj l))
          out:String (try (link-run (string-as-view &parts))))
      (drop &parts)
      (drop &obj)
      (drop &p)
      (drop &nm)
      (return (ok out)))))

; ---------------------------------------------------------------------------
; Item 46: a `defunion` inside a namespace
;
; The registry takes the canonical KEY and `union-ctor-form` takes the SOURCE
; spelling — the split `emit-defunion` documents and `emit-defunion-import` did
; not honour, so a header carrying `(ns …)` filed its backing struct under the
; key and its UnionDef under the bare name, where no reference looks.
; ---------------------------------------------------------------------------

(defn w9nu-lib-src ():StrView
  (return "(ns w9nu)
(defunion Opt (Some x:i32) None)
(defn opt-or (o:Opt d:i32):i32
  (return (match o ((Some x) x) (None d))))
"))

; `make`, `match` and a by-value union parameter. Used with the import above it
; and below it: below-use is item 40's `.nuch` residue, which could not be
; closed until this key agreed.
(defn w9nu-body ():StrView
  (return "(import-use \"stdio.h\")
(defn go ():i32
  (let (a (make w9nu/Opt Some 41)
        b (make w9nu/Opt None))
    (return (+ (w9nu/opt-or a 0) (w9nu/opt-or b 1)))))
(defn main ():i32 (printf \"%d\\n\" (go)) (return 0))
"))

(deftest w9-nuch-ns-union-links-and-runs
  (let (l:NuchLib (try (nuch-lib "w9nu" (w9nu-lib-src)))
        above:String (str "(import-use w9nu)\n" (w9nu-body))
        below:String (str (w9nu-body) "(import-use w9nu)\n")
        ao:String (try (nuch-link-run &l "above"
                                      (string-as-view &above)))
        bo:String (try (nuch-link-run &l "below"
                                      (string-as-view &below))))
    (try (check-eq (string-as-view &ao) "42\n"))
    (try (check-eq (string-as-view &bo) "42\n"))
    (drop &bo)
    (drop &ao)
    (drop &below)
    (drop &above)
    (drop &l)))

; The same source compiled against the library's `.nuc` rather than its header
; must produce the same answer — the header is the only thing under test.
(deftest w9-nuch-ns-union-agrees-with-source
  (let (l:NuchLib (try (nuch-lib "w9nu" (w9nu-lib-src)))
        src:String (str "(import-use w9nu)\n" (w9nu-body))
        p:String (try (test-write-file "above.nuc" (string-as-view &src)))
        ldir:String (try (test-scratch-sub "l"))
        out:String (try (build-run-file (string-as-view &ldir) ""
                                        (string-as-view &p))))
    (try (check-eq (string-as-view &out) "42\n"))
    (drop &out)
    (drop &ldir)
    (drop &p)
    (drop &src)
    (drop &l)))

; The arm constructors are the mangling half: `union-ctor-form` is handed the
; bare spelling on purpose, and the `declare` it produces must still come out
; under the namespaced symbol the library's object exports. Exactly one declare
; each — the prescan registers without emitting, so this stays 1.
(deftest w9-nuch-ns-union-ctor-symbols
  (let (l:NuchLib (try (nuch-lib "w9nu" (w9nu-lib-src)))
        below:String (str (w9nu-body) "(import-use w9nu)\n")
        p:String (try (test-write-file "below.nuc" (string-as-view &below)))
        c:Compiled (try (compile-path-in (nuch-idir &l)
                                         (string-as-view &p)))
        ir:StrView (string-as-view (ref c 'ir)))
    (when (not (c 'ok?))
      (fail! (test-show (string-as-view (ref c 'raw-text)))))
    (try (check-eq-int (count-exact-lines ir "declare i64 @w9nu__Opt-Some(i32)") 1
                       "declares of the Some constructor"))
    (try (check-eq-int (count-exact-lines ir "declare i64 @w9nu__Opt-None()") 1
                       "declares of the None constructor"))
    (drop &c)
    (drop &p)
    (drop &below)
    (drop &l)))

; A diamond: two headers each importing w9nu, both imported here. The union is
; registered once and its arm declares emitted once — the guard that used to key
; on "a UnionDef exists" now keys on `ctors-emitted`, and getting that wrong
; drops the declares (link failure) or repeats them (invalid IR).
(deftest w9-nuch-ns-union-diamond
  (let (l:NuchLib (try (nuch-lib "w9nu" (w9nu-lib-src)))
        hv:StrView (nuch-idir &l)
        ldir:String (try (test-scratch-sub "l"))
        lv:StrView (string-as-view &ldir)
        dir:StrView (try (test-scratch))
        asrc:String (str "(ns w9nua)
(import-use w9nu)
(defn tag-a ():i32 (return (w9nu/opt-or (make w9nu/Opt Some 1) 0)))
")
        bsrc:String (str "(ns w9nub)
(import-use w9nu)
(defn tag-b ():i32 (return (w9nu/opt-or (make w9nu/Opt Some 1) 0)))
")
        ap:String (try (write-into lv "w9nua.nuc" (string-as-view &asrc)))
        bp:String (try (write-into lv "w9nub.nuc" (string-as-view &bsrc)))
        ah:String (try (emit-into hv "--emit-nuch" (string-as-view &ap)
                                  hv "w9nua.nuch"))
        bh:String (try (emit-into hv "--emit-nuch" (string-as-view &bp)
                                  hv "w9nub.nuch"))
        aobj:String (str dir "/w9nua.o")
        bobj:String (str dir "/w9nub.o")
        dp:String (try (test-write-file "diamond.nuc" "(import-use \"stdio.h\")
(import-use w9nua)
(import-use w9nub)
(defn main ():i32
  (printf \"%d\\n\" (+ (w9nua/tag-a) (w9nub/tag-b)))
  (return 0))
"))
        dobj:String (str dir "/diamond.o"))
    (try (compile-object-in hv (string-as-view &ap)
                            (string-as-view &aobj)))
    (try (compile-object-in hv (string-as-view &bp)
                            (string-as-view &bobj)))
    (try (compile-object-in hv (string-as-view &dp)
                            (string-as-view &dobj)))
    (let (all:String (str (string-as-view &dobj) " "
                          (string-as-view &aobj) " "
                          (string-as-view &bobj) " "
                          (nuch-obj &l))
          out:String (try (link-run (string-as-view &all))))
      (try (check-eq (string-as-view &out) "2\n"))
      (drop &out)
      (drop &all))
    (drop &dobj)
    (drop &dp)
    (drop &bobj)
    (drop &aobj)
    (drop &bh)
    (drop &ah)
    (drop &bp)
    (drop &ap)
    (drop &bsrc)
    (drop &asrc)
    (drop &ldir)
    (drop &l)))

; A header with no `(ns …)` keys bare on both sides, which is why the defect was
; invisible for so long. Pinned so the fix stays a re-keying, not a rename.
(deftest w9-nuch-union-bare-unchanged
  (let (l:NuchLib (try (nuch-lib "w9nub0"
                         "(defunion W9NuBare (W9NuOne x:i32) W9NuZero)
(defn w9nu-bare-or (o:W9NuBare d:i32):i32
  (return (match o ((W9NuOne x) x) (W9NuZero d))))
"))
        out:String (try (nuch-link-run &l "bare" "(import-use \"stdio.h\")
(import-use w9nub0)
(defn main ():i32
  (printf \"%d\\n\" (w9nu-bare-or (make W9NuBare W9NuOne 9) 0))
  (return 0))
")))
    (try (check-eq (string-as-view &out) "9\n"))
    (drop &out)
    (drop &l)))

; ---------------------------------------------------------------------------
; Item 29: a header resolves on REACHABILITY, not on import position
;
; Registration is hoisted into the whole-graph prescan
; (`prescan-nuch-signatures`) and emission left where `emit-nuch-import-forms`
; always wrote it, so the same program's IR does not move — which is what the
; third and fourth units below are for.
; ---------------------------------------------------------------------------

(defn w9no-lib-src ():StrView
  (return "(defconst W9NO-BASE 40)
(defenum W9NoKind w9no-red w9no-green w9no-blue)
(defvar w9no-counter:i32 7)
(defn w9no-add ((a i32) (b i32)):i32 (return (+ a b)))
(defn w9no-two ((a i32)):i32 (return (* a 2)))
(defn w9no-two ((a i64)):i64 (return (* a 2)))
"))

; One use of every kind a header carries: a `declare`, an `extern`, a
; `defconst`, a `defenum` member and one arm of an overload set.
(defn w9no-body ():StrView
  (return "(import-use \"stdio.h\")
(defn main ():i32
  (printf \"%d %d %d %d %d\\n\" (w9no-add 1 2) W9NO-BASE (as i32 w9no-blue) w9no-counter (w9no-two 21))
  (return 0))
"))

(defn w9no-below ():String
  (return (str (w9no-body) "(import-use w9no)\n")))

; The whole defect: on the committed boot compiler this is `not defined
; anywhere in this compilation unit` for five names that are in the unit.
(deftest w9-nuch-import-below-use
  (let (l:NuchLib (try (nuch-lib "w9no" (w9no-lib-src)))
        below:String (w9no-below)
        p:String (try (test-write-file "below.nuc" (string-as-view &below)))
        c:Compiled (try (compile-path-in (nuch-idir &l)
                                         (string-as-view &p))))
    (when (not (c 'ok?))
      (fail! "the import below every use did not compile\n     "
             (test-show (string-as-view (ref c 'raw-text)))))
    (drop &c)
    (drop &p)
    (drop &below)
    (drop &l)))

; …and LINKS and RUNS against the library's object, which is the only proof that
; the `declare` / `external global` lines were still emitted, exactly once, under
; the symbols the library actually exports.
(deftest w9-nuch-import-order-links-and-runs
  (let (l:NuchLib (try (nuch-lib "w9no" (w9no-lib-src)))
        above:String (str "(import-use w9no)\n" (w9no-body))
        below:String (w9no-below)
        ao:String (try (nuch-link-run &l "above"
                                      (string-as-view &above)))
        bo:String (try (nuch-link-run &l "below"
                                      (string-as-view &below))))
    (try (check-eq (string-as-view &ao) "3 40 2 7 42\n"))
    (try (check-eq (string-as-view &bo) "3 40 2 7 42\n"))
    (drop &bo)
    (drop &ao)
    (drop &below)
    (drop &above)
    (drop &l)))

; Emission did not move: one `declare` per function, one `external global` per
; variable. The prescan registers without emitting precisely so these stay 1 —
; a second copy of either is invalid IR.
(deftest w9-nuch-declares-emitted-once
  (let (l:NuchLib (try (nuch-lib "w9no" (w9no-lib-src)))
        below:String (w9no-below)
        p:String (try (test-write-file "below.nuc" (string-as-view &below)))
        c:Compiled (try (compile-path-in (nuch-idir &l)
                                         (string-as-view &p)))
        ir:StrView (string-as-view (ref c 'ir)))
    (try (check-eq-int (count-exact-lines ir "declare i32 @w9no-add(i32, i32)") 1
                       "declares of w9no-add"))
    (try (check-eq-int (count-exact-lines ir "@w9no-counter = external global i32") 1
                       "external globals for w9no-counter"))
    (try (check-eq-int (count-exact-lines ir "declare i32 @w9no_two.i32(i32)") 1
                       "declares of the i32 overload"))
    (try (check-eq-int (count-exact-lines ir "declare i64 @w9no_two.i64(i64)") 1
                       "declares of the i64 overload"))
    (drop &c)
    (drop &p)
    (drop &below)
    (drop &l)))

; Two headers declaring ONE global. The prescan registers it for whichever
; header it reaches first and skips it for the second, so the emit-only pass
; must ask PER NAME whether registration happened rather than assume it did for
; the whole header. Assuming writes `@w9no-shared` twice, which LLVM rejects.
(deftest w9-nuch-shared-global-declared-once
  (let (hdir:String (try (test-scratch-sub "h"))
        hv:StrView (string-as-view &hdir)
        a:String (try (write-into hv "w9noa.nuch"
                        "(extern (w9no-shared i32))\n(declare w9no-a ((x i32)) :i32)\n"))
        b:String (try (write-into hv "w9nob.nuch"
                        "(extern (w9no-shared i32))\n(declare w9no-b ((x i32)) :i32)\n"))
        p:String (try (test-write-file "two.nuc" "(import-use \"stdio.h\")
(defn main ():i32
  (printf \"%d %d %d\\n\" (w9no-a 1) (w9no-b 2) w9no-shared)
  (return 0))
(import-use w9noa)
(import-use w9nob)
"))
        c:Compiled (try (compile-path-in hv (string-as-view &p)))
        ir:StrView (string-as-view (ref c 'ir)))
    (when (not (c 'ok?))
      (fail! (test-show (string-as-view (ref c 'raw-text)))))
    (try (check-eq-int (count-exact-lines ir "@w9no-shared = external global i32") 1
                       "external globals for the shared name"))
    (try (check-eq-int (count-exact-lines ir "declare i32 @w9no-a(i32)") 1
                       "declares of w9no-a"))
    (try (check-eq-int (count-exact-lines ir "declare i32 @w9no-b(i32)") 1
                       "declares of w9no-b"))
    (drop &c)
    (drop &p)
    (drop &b)
    (drop &a)
    (drop &hdir)))

; The case this records rather than endorses: when the unit defines the name a
; header declares, the entry used to be dropped whole — one `define`, no
; `declare`, nothing left that reaches the library's function. The signatures
; here are IDENTICAL, which is why the discriminator cannot be a signature
; comparison: what makes these two different functions is that one is a
; header's and one is this unit's.
(deftest w9-nuch-local-definition-reported
  (let (l:NuchLib (try (nuch-lib "w9no" (w9no-lib-src)))
        p:String (try (test-write-file "shadow.nuc" "(import-use w9no)
(defn w9no-add ((a i32) (b i32)):i32 (return (- a b)))
(defn main ():i32 (printf \"%d\\n\" (w9no-add 5 2)) (return 0))
")))
    (try (check-file-rejects (nuch-idir &l) (string-as-view &p)
                             "already defines 'w9no-add'"))
    (drop &p)
    (drop &l)))

; ---------------------------------------------------------------------------
; Item 24: a header's `declare` registers as a callable, not just a global
;
; Every producer of a callable name registers it in the generic registry —
; `emit-defn` does so even for a solitary function, and that is why a protocol
; method, a drop thunk and a `(dyn P)` vtable can be resolved at all. A `.nuch`
; `declare` was the one exception: it bound the name in `g-globals` and nowhere
; else, so a function arriving through a header was invisible to every asker
; that poses the question by name AND SIGNATURE. Calls were unaffected
; throughout, which is what hid it.
;
; The libraries here `(exclude-prelude)` so their objects and each consumer's
; link together, which is also why their bodies avoid arithmetic.
; ---------------------------------------------------------------------------

(defn w24-lib-src ():StrView
  (return "(exclude-prelude)
(ns w24)
(defprotocol Describe (describe ((self (ref Self))) i32))
(defstruct Fox n:i32)
(defn describe ((self (ref Fox))):i32 (return (_get self 'n)))
(extend Fox Describe)
"))

(defn w24-use-src ((l (ref NuchLib))):String
  (return (str "(import-use \"stdio.h\")
(import-use allocator)
(import \"" (nuch-header l) "\" wx)
(defn main ():i32
  (let (b:(dyn wx/Describe) (wx/Fox 309))
    (printf \"d=%d\\n\" (wx/describe b)))
  (return 0))
")))

; The item's own failure, end to end: box a type whose implementation arrives
; through a header, dispatch through the box, link, run.
(deftest w9-nuch-declare-dyn-box
  (let (l:NuchLib (try (nuch-lib "w24lib" (w24-lib-src)))
        src:String (w24-use-src &l)
        out:String (try (nuch-link-run &l "w24use"
                                       (string-as-view &src))))
    (try (check-eq (string-as-view &out) "d=309\n"))
    (drop &out)
    (drop &src)
    (drop &l)))

; …through the symbol the LIBRARY defines, not merely some symbol that resolves.
; Slot 0 of the vtable is what the box calls through.
(deftest w9-nuch-declare-vtable-symbol
  (let (l:NuchLib (try (nuch-lib "w24lib" (w24-lib-src)))
        src:String (w24-use-src &l)
        p:String (try (test-write-file "w24use.nuc" (string-as-view &src)))
        c:Compiled (try (compile-path (string-as-view &p))))
    (when (not (c 'ok?))
      (fail! (test-show (string-as-view (ref c 'raw-text)))))
    (try (check-contains (string-as-view (ref c 'ir))
                         "internal constant { ptr, ptr } { ptr @w24__describe,"))
    (drop &c)
    (drop &p)
    (drop &src)
    (drop &l)))

; The other asker, `method-satisfies-sig`: a consumer's own protocol satisfied
; by a method it imported.
(deftest w9-nuch-declare-extend-conforms
  (let (l:NuchLib (try (nuch-lib "w24lib" (w24-lib-src)))
        src:String (str "(import \"" (nuch-header &l) "\" wx)
(defprotocol Show (describe ((self (ref Self))) i32))
(extend wx/Fox Show)
(defn main ():i32 (return 0))
")
        p:String (try (test-write-file "w24ext.nuc" (string-as-view &src)))
        c:Compiled (try (compile-path (string-as-view &p))))
    (when (not (c 'ok?))
      (fail! "an imported method did not satisfy the consumer's protocol\n     "
             (test-show (string-as-view (ref c 'raw-text)))))
    (drop &c)
    (drop &p)
    (drop &src)
    (drop &l)))

; Two headers from different namespaces declaring the same signature are two
; distinct symbols, not a collision. They meet in one Generic only because the
; registry is bare-keyed (R2), and a duplicate-DEFINITION error there would be
; about definitions neither file makes. This worked before item 24 — the two
; declares never met — and must keep working.
(deftest w9-nuch-declare-two-namespaces
  (let (a:NuchLib (try (nuch-lib "w24na" "(exclude-prelude)
(ns w24na)
(defn helper (x:i32):i32 (return x))
"))
        b:NuchLib (try (nuch-lib "w24nb" "(exclude-prelude)
(ns w24nb)
(defn helper (x:i32):i32 (return x))
"))
        dir:StrView (try (test-scratch))
        src:String (str "(import-use \"stdio.h\")
(import \"" (nuch-header &a) "\")
(import \"" (nuch-header &b) "\")
(defn main ():i32
  (printf \"h=%d\\n\" (+ (w24na/helper 1) (w24nb/helper 20)))
  (return 0))
")
        p:String (try (test-write-file "w24two.nuc" (string-as-view &src)))
        obj:String (str dir "/w24two.o"))
    (try (compile-object (string-as-view &p)
                         (string-as-view &obj)))
    (let (all:String (str (string-as-view &obj) " "
                          (nuch-obj &a) " " (nuch-obj &b))
          out:String (try (link-run (string-as-view &all))))
      (try (check-eq (string-as-view &out) "h=21\n"))
      (drop &out)
      (drop &all))
    (drop &obj)
    (drop &p)
    (drop &src)
    (drop &b)
    (drop &a)))

; ---------------------------------------------------------------------------
; Item 36: a header entry the importing unit also DEFINES
;
; `nuch-declare-import` skipped a header entry whose name was already bound, for
; idempotence — a diamond import, or a C header and a `.nuch` both naming one
; libc function. What it could not distinguish was a re-DECLARATION of the same
; function from a different function that shares the name, so an entry the unit
; also defines was dropped whole: no global binding, no `declare`, no generic
; method. Measured pre-fix, the QUALIFIED call `(lib2/helper 3)` emitted
; `call i64 @helper` — the unit's own function, at a type the library's never
; had, with no diagnostic.
;
; The discriminator is "does this unit DEFINE the name", not "do the signatures
; differ": only a `defn` has a body, so a declaration answers no.
; ---------------------------------------------------------------------------

(defn w36-lib-src ():StrView
  (return "(exclude-prelude)
(defn helper (x:i32):i32 (return 10))
(defn only-there (x:i32):i32 (return 4))
"))

(defn w36-shadow-src ((l (ref NuchLib)) sig:StrView body:StrView):String
  (return (str "(import-use \"stdio.h\")
(import \"" (nuch-header l) "\" lib2)
(defn helper " sig " (return " body "))
(defn main ():i32 (printf \"%d\\n\" (lib2/helper 3)) (return 0))
")))

; The item's own measured case: the local definition has a DIFFERENT type. The
; signature comparison is a NOTE, which is why the shell's two independent greps
; over one stderr blob could not tell it apart from the error.
(deftest w9-nuch-shadowed-declare-reported
  (let (l:NuchLib (try (nuch-lib "w36lib" (w36-lib-src)))
        src:String (w36-shadow-src &l "(x:i64):i64" "(* 1000 x)")
        p:String (try (test-write-file "w36diff.nuc" (string-as-view &src)))
        c:Compiled (try (compile-path (string-as-view &p))))
    (when (c 'ok?) (fail! "the shadowed declare was accepted"))
    (try (check-error-anywhere (ref c 'diags) "already defines 'helper'"))
    (try (check-note-anywhere (ref c 'diags)
           "the header declares helper(i32):i32, the unit has helper(i64):i64"))
    (drop &c)
    (drop &p)
    (drop &src)
    (drop &l)))

; The half a signature comparison would miss: same signature, still two
; different functions, still nothing that reaches the header's.
(deftest w9-nuch-shadowed-same-signature-reported
  (let (l:NuchLib (try (nuch-lib "w36lib" (w36-lib-src)))
        src:String (w36-shadow-src &l "(x:i32):i32" "1000")
        p:String (try (test-write-file "w36same.nuc" (string-as-view &src))))
    (try (check-file-rejects "" (string-as-view &p)
                             "already defines 'helper'"))
    (drop &p)
    (drop &src)
    (drop &l)))

; The message is located on the HEADER entry and names the definition it
; collides with — a bare "duplicate" would leave the author with two files and
; no line. Location and message are one record here; the shell's regex spanned
; the `file:line: error:` prefix and the text as if they were one string.
(deftest w9-nuch-shadowed-both-sites-named
  (let (l:NuchLib (try (nuch-lib "w36lib" (w36-lib-src)))
        src:String (w36-shadow-src &l "(x:i64):i64" "(* 1000 x)")
        p:String (try (test-write-file "w36diff.nuc" (string-as-view &src)))
        c:Compiled (try (compile-path (string-as-view &p)))
        at:String (str (string-as-view &p) ":3"))
    (try (check-error-at (ref c 'diags) (nuch-header &l) 2
                         "declare 'helper': this compilation unit already defines 'helper'"))
    (try (check-error-at (ref c 'diags) (nuch-header &l) 2
                         (string-as-view &at)))
    (drop &at)
    (drop &c)
    (drop &p)
    (drop &src)
    (drop &l)))

; Accepting half A: the idempotent re-declaration the skip exists for stays
; silent. `strlen` is declared by BOTH string.h and lib/string.nuch.
(deftest w9-nuch-redeclare-still-silent
  (let (c:Compiled (try (compile-source "(import-use \"string.h\")
(import-use string)
(defn main ():i32 (return (unsafe/cast i32 (strlen \"abc\"))))
")))
    (when (not (c 'ok?))
      (fail! "an idempotent re-declaration was reported\n     "
             (test-show (string-as-view (ref c 'raw-text)))))
    (drop &c)))

; Accepting half B: a name the unit does NOT define is untouched — the library's
; other export still declares, links and runs.
(deftest w9-nuch-unshadowed-declare-runs
  (let (l:NuchLib (try (nuch-lib "w36lib" (w36-lib-src)))
        src:String (str "(import-use \"stdio.h\")
(import \"" (nuch-header &l) "\" lib2)
(defn helper2 (x:i64):i64 (return 1000))
(defn main ():i32 (printf \"o=%d\\n\" (lib2/only-there 3)) (return 0))
")
        out:String (try (nuch-link-run &l "w36ok"
                                       (string-as-view &src))))
    (try (check-eq (string-as-view &out) "o=4\n"))
    (drop &out)
    (drop &src)
    (drop &l)))

; The escape route the diagnostic RECOMMENDS has to work, or the note is bad
; advice: under an `(ns …)` the header's exports key as `w36n/helper` and link as
; `@w36n__helper`, so the two functions coexist and both are callable.
(deftest w9-nuch-namespaced-library-coexists
  (let (l:NuchLib (try (nuch-lib "w36nlib" "(exclude-prelude)
(ns w36n)
(defn helper (x:i32):i32 (return 30))
"))
        src:String (str "(import-use \"stdio.h\")
(import \"" (nuch-header &l) "\" nx)
(defn helper (x:i64):i64 (return 3000))
(defn main ():i32
  (printf \"n=%d %d\\n\" (nx/helper 3) (helper (as i64 3)))
  (return 0))
")
        out:String (try (nuch-link-run &l "w36nuse"
                                       (string-as-view &src))))
    (try (check-eq (string-as-view &out) "n=30 3000\n"))
    (drop &out)
    (drop &src)
    (drop &l)))

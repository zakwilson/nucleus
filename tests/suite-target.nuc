; Stage 18 TF-6 category (c) — what the target decides, not the compiler.
;
; Design: design/stage18-tooling/overview.md §T6.6; Stage 16 C4 in
; design/stage16-ergonomics/cheader-parser-vs-libclang.md §6; Stage 17 in
; design/stage17-native-strings/platform-constants.md; Stage 14 RV-6 in
; design/stage14/riscv-fp-abi.md.
;
; Three questions with the same answer. What `size_t` is in a declaration, what
; `O_CREAT` equals, and how a struct of two floats is passed are all the
; TARGET's to answer — and each was once answered by something written into the
; compiler instead: the host's headers under every `--target=`, a hardcoded
; constant table in `lib/nucleus/file.nuc`, and the SysV classifier for every machine.
;
; So the oracle is never a number quoted here. The C4 lane reads the widths back
; out of the emitted module, the constants lane compares against a C program
; clang builds from the same headers, and the RV-6 lane pins shapes derived from
; `clang --target=riscv64-unknown-linux-gnu` on structurally identical C —
; there being no riscv64 hardware in the container, which makes it a
; cross-emission gate.

; `nucleusc --target=<t> [extra] --emit-llvm <path>`, diagnostics kept: two of
; these units are about what the compiler SAID as much as what it emitted.
(import-use nucleus.string)
(import-use nucleus.process)
(import-use nucleus.fmt)
(import-use nucleus.test)
(import-use nucleus.string-split)
(import-use nucleus.strview)
(defn target-emit (target:StrView extra:StrView path:StrView):!Compiled
  (let (c:Command (command (compiler-path))
        flag:String (str "--target=" target))
    (command-arg &c (string-as-view &flag))
    (when (not (= extra "")) (command-arg &c extra))
    (command-arg &c "--diagnostics=edn")
    (command-arg &c "--emit-llvm")
    (command-arg &c path)
    (let (r:Compiled (try (compiled-run &c)))
      (drop &flag)
      (drop &c)
      (return (ok r)))))

; Whether clang can reach `string.h` for `target`. Without the target's own
; headers there is nothing to read and the fallback below is the correct
; outcome, not a failure — so this decides which of the two lanes runs.
(defn target-headers? (target:StrView):bool
  (let (flag:String (str "--target=" target)
        c:Command (command "clang"))
    (command-arg &c "-E")
    (command-arg &c (string-as-view &flag))
    (command-arg &c "-x")
    (command-arg &c "c")
    (command-arg &c "-include")
    (command-arg &c "string.h")
    (command-arg &c "/dev/null")
    (command-capture &c true)
    (match (run &c)
      ((ok o)
        (let (ok?:bool (success? (ref o 'status)))
          (drop &o)
          (drop &c)
          (drop &flag)
          (return ok?)))
      ((err e)
        (drop &c)
        (drop &flag)
        (return false)))))

; ---------------------------------------------------------------------------
; C4: `clang -E` reads the EMISSION target's headers
; ---------------------------------------------------------------------------

; Before C4 it read the host's under every `--target=`, so an AVR build of
; `(import-use "string.h")` declared glibc's `strlen` returning `i64` — on a
; machine whose `size_t` is 16 bits and whose libc does not have half those
; symbols.
(defn c4-src ():StrView
  (return "(exclude-prelude)
(import-use \"string.h\")
(defn main ():i32 (return 0))
"))

; The CONTRAST, and the one case conventions.md leaves host-relative on purpose:
; no `--target=` adds no flags at all, so this is the byte-for-byte pre-C4 path
; and the width is whatever this host's `size_t` is.
(deftest c4-host-headers-unchanged
  (let (c:Compiled (try (compile-source (c4-src)))
        ir:StrView (compiled-ir &c))
    (try (check-silent &c "a host build"))
    (try (check-match ir "declare i?? @strlen(ptr)"))
    (drop &c))
  (return (ok)))

; avr-libc's `size_t` is 16 bits, so every `size_t` in the declarations is
; `i16` where the host's is 64 — that difference IS the measurement. glibc's
; `__memcmpeq` is the independent witness: it exists in no avr-libc header, so
; its presence would mean the host's text was read after all.
(deftest c4-avr-target-headers
  (when (not (target-headers? "avr"))
    (skip! "no avr-libc headers for clang to read"))
  (let (p:String (try (test-write-file "c4.nuc" (c4-src)))
        c:Compiled (try (target-emit "avr" "--mcpu=atmega328p"
                                     (string-as-view &p)))
        ir:StrView (compiled-ir &c))
    (try (check-silent &c "an AVR build with the target's headers"))
    (try (check-line ir "declare i16 @strlen(ptr)"))
    (try (check-line ir "declare ptr @memcpy(ptr, ptr, i16)"))
    (try (check-not-contains ir "@__memcmpeq"))
    (drop &c)
    (drop &p))
  (return (ok)))

; A target whose headers are NOT installed must keep working: refusing would
; retire cross-compiling for every triple without a local sysroot, which is how
; every target lane in this suite runs. The warning is the contract — it carries
; no location because it is about the compile rather than a line of it, and its
; note is the way out.
(deftest c4-missing-sysroot-falls-back
  (when (target-headers? "i386-pc-linux-gnu")
    (skip! "i386 headers ARE installed here"))
  (let (p:String (try (test-write-file "c4.nuc" (c4-src)))
        c:Compiled (try (target-emit "i386-pc-linux-gnu" ""
                                     (string-as-view &p)))
        ir:StrView (compiled-ir &c))
    (try (check-warning-at (ref c 'diags) "" -1
           "C header 'string.h' could not be preprocessed for target 'i386-pc-linux-gnu'; using the HOST's headers, whose type widths may differ"))
    (try (check-note-at (ref c 'diags) "" -1
           "pass --sysroot=<path> naming a sysroot that carries the target's own headers"))
    (try (check-no-errors (ref c 'diags)))
    (try (check-line ir "target triple = \"i386-pc-linux-gnu\""))
    (drop &c)
    (drop &p))
  (return (ok)))

; A header that exists on NO search path is fatal and located. It used to be
; swallowed whole, leaving every name it declares unresolvable with nothing
; pointing at the import.
(deftest c4-missing-header-is-fatal
  (let (p:String (try (test-write-file "miss.nuc" "(import-use \"no-such-header-c4.h\")
(defn main ():i32 (return 0))
"))
        pv:StrView (string-as-view &p)
        c:Compiled (try (compile-path pv)))
    (when (c 'ok?) (fail! "the compile must fail"))
    (try (check-error-at (ref c 'diags) pv 1
           "c-include: failed to preprocess 'no-such-header-c4.h'"))
    (drop &c)
    (drop &p))
  (return (ok)))

; ---------------------------------------------------------------------------
; Stage 21 item 3: `--cflag=<arg>` reaches the `clang -E` that reads a header
; (design/stage21-cleanup/c-header-include-paths.md §5)
; ---------------------------------------------------------------------------

; `nucleusc [a] [b] --diagnostics=edn --emit-llvm <path>`; an empty slot adds
; nothing. Two slots because the verbatim unit passes `-I` AND `-D`.
(defn cflag-emit (a:StrView b:StrView path:StrView):!Compiled
  (let (c:Command (command (compiler-path)))
    (when (not (= a "")) (command-arg &c a))
    (when (not (= b "")) (command-arg &c b))
    (command-arg &c "--diagnostics=edn")
    (command-arg &c "--emit-llvm")
    (command-arg &c path)
    (let (r:Compiled (try (compiled-run &c)))
      (drop &c)
      (return (ok r)))))

; `--cflag=-I<dir>` for a scratch subdirectory `name`, created on first ask.
(defn cflag-include (name:StrView):!String
  (let (dir:String (try (test-scratch-sub name))
        flag:String (str "--cflag=-I" (string-as-view &dir)))
    (drop &dir)
    (return (ok flag))))

; A stand-in for GTK's layout: `inc/gtk/gtk.h` includes `<glib/glib.h>`, so an
; absolute path to gtk.h is no substitute for the search path — the NESTED
; include is what needs `-I`.
(defn cflag-stand-in ():!void
  (let (inc:String (try (test-scratch-sub "inc"))
        gtk:String (try (test-scratch-sub "inc/gtk"))
        glib:String (try (test-scratch-sub "inc/glib"))
        h1:String (try (test-write-file "inc/glib/glib.h"
                        "typedef void* gpointer;\nvoid g_object_unref(gpointer object);\n"))
        h2:String (try (test-write-file "inc/gtk/gtk.h"
                        "#include <glib/glib.h>\ntypedef struct _GtkWidget GtkWidget;\nGtkWidget* gtk_label_new(const char* text);\n")))
    (drop &h1) (drop &h2) (drop &glib) (drop &gtk) (drop &inc)
    (return (ok))))

; The flag is the whole difference: the same source declares the stand-in's
; two functions with it and is the C4 fatal error without it.
(deftest s21-cflag-include-dir
  (let (flag:String (try (cflag-include "inc"))
        p:String (try (test-write-file "cf.nuc" "(import-use \"gtk/gtk.h\")
(defn main ():i32
  (let (w:ptr (gtk_label_new \"hi\"))
    (g_object_unref w)
    (return 0)))
"))
        pv:StrView (string-as-view &p))
    (try (cflag-stand-in))
    (let (with:Compiled (try (cflag-emit (string-as-view &flag) "" pv))
          without:Compiled (try (cflag-emit "" "" pv)))
      (try (check-no-errors (ref with 'diags)))
      (try (check-line (compiled-ir &with) "declare ptr @gtk_label_new(ptr)"))
      (try (check-line (compiled-ir &with) "declare void @g_object_unref(ptr)"))
      (when (without 'ok?) (fail! "the flag-free compile must fail"))
      (try (check-error-at (ref without 'diags) pv 1
             "c-include: failed to preprocess 'gtk/gtk.h'"))
      (drop &with)
      (drop &without))
    (drop &p) (drop &flag))
  (return (ok)))

; The failure `note:` is what a user copies to reproduce, so it must show the
; flags that were passed, where they were passed. It is the compiler's own
; text, not a structured diagnostic, hence `raw`.
(deftest s21-cflag-in-note
  (let (inc:String (try (test-scratch-sub "inc"))
        flag:String (try (cflag-include "inc"))
        want:String (str "  note: clang -E -I" (string-as-view &inc)
                         " -x c -include no-such-header-s21.h /dev/null")
        p:String (try (test-write-file "note.nuc" "(import-use \"no-such-header-s21.h\")
(defn main ():i32 (return 0))
"))
        pv:StrView (string-as-view &p)
        c:Compiled (try (cflag-emit (string-as-view &flag) "" pv)))
    (when (c 'ok?) (fail! "the compile must fail"))
    (try (check-line (string-as-view (ref c 'raw-text)) (string-as-view &want)))
    (try (check-error-at (ref c 'diags) pv 1
           "c-include: failed to preprocess 'no-such-header-s21.h'"))
    (drop &c) (drop &p) (drop &want) (drop &flag) (drop &inc))
  (return (ok)))

; Verbatim, not `-I`-only: a `-D` gates both a declaration and a Stage 17
; constant, so the `-dM` run carries the flags too. The define itself is
; baseline-subtracted, never admitted as a constant — a command-line macro is
; not a header's.
(deftest s21-cflag-verbatim
  (let (inc:String (try (test-scratch-sub "cfd"))
        flag:String (try (cflag-include "cfd"))
        h:String (try (test-write-file "cfd/cf.h"
                       "#ifdef NUC_CF_ON\nint nuc_cf_gated(int x);\n#define NUC_CF_CONST 42\n#endif\n"))
        p:String (try (test-write-file "cfd.nuc" "(import-use \"cf.h\")
(defn main ():i32 (return (+ NUC_CF_CONST (nuc_cf_gated 1))))
"))
        pv:StrView (string-as-view &p)
        q:String (try (test-write-file "cfd2.nuc" "(import-use \"cf.h\")
(defn main ():i32 (return NUC_CF_ON))
"))
        qv:StrView (string-as-view &q)
        on:Compiled (try (cflag-emit (string-as-view &flag) "--cflag=-DNUC_CF_ON=1" pv))
        off:Compiled (try (cflag-emit (string-as-view &flag) "" pv))
        self:Compiled (try (cflag-emit (string-as-view &flag) "--cflag=-DNUC_CF_ON=1" qv)))
    (try (check-no-errors (ref on 'diags)))
    (try (check-line (compiled-ir &on) "declare i32 @nuc_cf_gated(i32)"))
    (try (check-contains (compiled-ir &on) "add nsw i32 42, "))
    (when (off 'ok?) (fail! "without -D the gated names must not exist"))
    (try (check-error-at (ref off 'diags) pv 2 "undefined: NUC_CF_CONST"))
    (when (self 'ok?) (fail! "the -D itself must not be admitted as a constant"))
    (try (check-error-at (ref self 'diags) qv 2 "undefined: NUC_CF_ON"))
    (drop &on) (drop &off) (drop &self)
    (drop &q) (drop &p) (drop &h) (drop &flag) (drop &inc))
  (return (ok)))

; `-I` is the Nucleus import path and never reaches clang. The bait is real:
; `lib/` holds a generated `lib/nucleus/string.h`, and a clang `-I` precedes the system
; directories, so a forwarded `-I lib` would have the prelude read the C header
; of `lib/nucleus/string.nuc` in place of libc's. The scratch `string.h` here declares
; only a marker; if it were ever read, `strlen` would be unknown.
(deftest s21-dash-i-not-forwarded
  (let (dir:String (try (test-scratch-sub "shadow"))
        h:String (try (test-write-file "shadow/string.h" "void nuc_shadow_marker(void);\n"))
        p:String (try (test-write-file "sl.nuc"
                       "(defn main ():i32 (return (unsafe/cast i32 (strlen \"abc\"))))\n"))
        c:Compiled (try (compile-path-in (string-as-view &dir) (string-as-view &p))))
    (try (check-no-errors (ref c 'diags)))
    (try (check-line (compiled-ir &c) "declare i64 @strlen(ptr)"))
    (try (check-not-contains (compiled-ir &c) "nuc_shadow_marker"))
    (drop &c) (drop &p) (drop &h) (drop &dir))
  (return (ok)))

; An empty value is refused like `-o`'s and `-I`'s, not handed to clang as an
; empty argv entry.
(deftest s21-cflag-empty-refused
  (let (p:String (try (test-write-file "empty.nuc" "(defn main ():i32 (return 0))\n"))
        c:Compiled (try (cflag-emit "--cflag=" "" (string-as-view &p))))
    (when (!= (c 'exit) 2) (fail! "expected exit 2, got " (as i64 (c 'exit))))
    (try (check-contains (string-as-view (ref c 'raw-text)) "--cflag= requires an argument"))
    (drop &c) (drop &p))
  (return (ok)))

; ---------------------------------------------------------------------------
; Stage 21 item 4: the REPL's build line — `(cflag …)`, `(import-path …)`,
; `(library-path …)`, `(load-library …)`, `(pkg-config …)` and `-l`/`-L`
; under `-i` (design/stage21-cleanup/repl-build-line.md §8.1)
; ---------------------------------------------------------------------------

; A failed header import is cached as a failure; `imported` on the retry after
; `(cflag …)` is the claim that a flag change empties the cache (§1.2).
(deftest s21-repl-cflag
  (let (inc:String (try (test-scratch-sub "inc"))
        iv:StrView (string-as-view &inc)
        text:String (str "(import-use \"gtk/gtk.h\")\n(cflag \"-I" iv "\")\n"
                         "(import-use \"gtk/gtk.h\")\n(import-use \"no-such-s21.h\")\n(cflag)\n")
        flagged:String (str "nuc>   cflag: -I" iv "\nnuc>   imported gtk/gtk.h\n")
        note2:String (str " -I" iv " -x c -include no-such-s21.h")
        listed:String (str "nuc>   -I" iv "\nnuc>"))
    (try (cflag-stand-in))
    (let (t:String (try (repl-session (string-as-view &text)))
          tv:StrView (string-as-view &t))
      (try (check-contains tv "  note: clang -E -x c -include gtk/gtk.h /dev/null\n"))
      (try (check-contains tv "error: c-include: failed to preprocess 'gtk/gtk.h'"))
      (try (check-contains tv (string-as-view &flagged)))
      (try (check-contains tv (string-as-view &note2)))
      (try (check-contains tv (string-as-view &listed)))
      (drop &t))
    (drop &listed) (drop &note2) (drop &flagged) (drop &text) (drop &inc))
  (return (ok)))

; A prompt-time `-D` re-arms the macro baseline: the constant it gates is
; admitted and the define itself is still subtracted, as for a command-line `-D`.
(deftest s21-repl-cflag-define
  (let (cfd:String (try (test-scratch-sub "cfd"))
        cv:StrView (string-as-view &cfd)
        h:String (try (test-write-file "cfd/cf.h"
                       "#ifdef NUC_CF_ON\nint nuc_cf_gated(int x);\n#define NUC_CF_CONST 42\n#endif\n"))
        text:String (str "(cflag \"-I" cv "\" \"-DNUC_CF_ON=1\")\n(import-use \"cf.h\")\n"
                         "NUC_CF_CONST\nNUC_CF_ON\n")
        t:String (try (repl-session (string-as-view &text)))
        tv:StrView (string-as-view &t))
    (try (check-contains tv "nuc>   imported cf.h\nnuc>   42\n"))
    (try (check-contains tv "undefined: NUC_CF_ON"))
    (drop &t) (drop &text) (drop &h) (drop &cfd))
  (return (ok)))

; The import path is read at resolution time, so the import that failed before
; `(import-path …)` succeeds after it; a missing directory is refused, adds nothing.
(deftest s21-repl-import-path
  (let (ip:String (try (test-scratch-sub "ip"))
        iv:StrView (string-as-view &ip)
        z:String (try (test-write-file "ip/zz.nuc" "(defn zz-answer ():i32 (return 7))\n"))
        text:String (str "(import-use zz)\n(import-path \"" iv "\")\n(import-use zz)\n(zz-answer)\n"
                         "(import-path \"" iv "/nope\")\n(import-path)\n")
        added:String (str "nuc>   import path: " iv "\nnuc>   imported zz\nnuc>   7\n")
        listed:String (str "no such directory '" iv "/nope'\nnuc>   " iv "\nnuc>")
        t:String (try (repl-session (string-as-view &text)))
        tv:StrView (string-as-view &t))
    (try (check-contains tv "cannot find 'zz'"))
    (try (check-contains tv (string-as-view &added)))
    (try (check-contains tv (string-as-view &listed)))
    (drop &t) (drop &listed) (drop &added) (drop &text) (drop &z) (drop &ip))
  (return (ok)))

; The one-function shared library the load units open: `libnucprobe.so` in the
; test's scratch directory, its header under `pinc/`. Answers the directory.
(defn probe-library ():!String
  (try (require-cc))
  (let (dir:StrView (try (test-scratch))
        src:String (try (test-write-file "nucprobe.c"
                         "int nuc_probe_answer(void) { return 41; }\n"))
        pinc:String (try (test-scratch-sub "pinc"))
        h:String (try (test-write-file "pinc/nucprobe.h" "int nuc_probe_answer(void);\n"))
        so:String (str dir "/libnucprobe.so")
        cc:Command (command "cc"))
    (command-arg &cc "-shared")
    (command-arg &cc "-fPIC")
    (command-arg &cc "-o")
    (command-arg &cc (string-as-view &so))
    (command-arg &cc (string-as-view &src))
    (command-capture &cc true)
    (command-stderr-to-stdout &cc true)
    (match (run &cc)
      ((ok o)
        (let (built:bool (success? (ref o 'status)))
          (when (not built)
            (fail! "cc refused the probe library\n     "
                   (test-show (string-as-view (ref o 'out)))))
          (drop &o)))
      ((err e) (return (err e))))
    (drop &cc) (drop &so) (drop &h) (drop &pinc) (drop &src)
    (let (d:String (str dir))
      (return (ok d)))))

; A library the compiler was not linked against is invisible to the JIT until
; `(load-library …)` opens it; a load is reported once under the spelling opened.
(deftest s21-repl-load-library
  (let (dir:String (try (probe-library))
        dv:StrView (string-as-view &dir)
        text:String (str "(cflag \"-I" dv "/pinc\")\n(import-use \"nucprobe.h\")\n(nuc_probe_answer)\n"
                         "(load-library \"" dv "/libnucprobe.so\")\n(nuc_probe_answer)\n"
                         "(load-library \"" dv "/libnucprobe.so\")\n(library-path \"" dv "\")\n"
                         "(load-library \"nucprobe\")\n(load-library \"no-such-lib-s21\")\n(+ 1 2)\n")
        loaded:String (str "nuc>   loaded " dv "/libnucprobe.so\nnuc>   41\n")
        again:String (str "nuc>   " dv "/libnucprobe.so already loaded\nnuc>   library path: " dv
                          "\nnuc>   " dv "/libnucprobe.so already loaded\n")
        missing:String (str "  error: load-library: cannot load 'no-such-lib-s21' (tried " dv
                            "/libno-such-lib-s21.so, libno-such-lib-s21.so)\nnuc>   3\n")
        t:String (try (repl-session (string-as-view &text)))
        tv:StrView (string-as-view &t))
    (try (check-contains tv "nuc>   imported nucprobe.h\nnuc> JIT session error: Symbols not found: [ nuc_probe_answer ]\n"))
    (try (check-contains tv (string-as-view &loaded)))
    (try (check-contains tv (string-as-view &again)))
    (try (check-contains tv (string-as-view &missing)))
    (drop &t) (drop &missing) (drop &again) (drop &loaded) (drop &text) (drop &dir))
  (return (ok)))

; `-L`/`-l` under `-i` load at startup instead of being silently dropped, and a
; wrong `-l` is a dead session rather than one that fails at the first call.
(deftest s21-repl-argv-libs
  (let (dir:String (try (probe-library))
        dv:StrView (string-as-view &dir)
        ldir:String (str "-L" dv)
        cflag:String (str "--cflag=-I" dv "/pinc")
        text:StrView "(import-use \"nucprobe.h\")\n(nuc_probe_answer)\n"
        want:String (str "  loaded " dv "/libnucprobe.so\nnuc>   imported nucprobe.h\nnuc>   41\n")
        good:String (try (repl-session-with (string-as-view &ldir) "-lnucprobe"
                                            (string-as-view &cflag) "" "" text))
        bad:String (try (repl-session-with "-lno-such-lib-s21" "" "" "" "" text)))
    (try (check-contains (string-as-view &good) (string-as-view &want)))
    (try (check-contains (string-as-view &bad)
           "error: -lno-such-lib-s21: cannot load 'no-such-lib-s21'"))
    (try (check-not-contains (string-as-view &bad) "nuc>"))
    (drop &bad) (drop &good) (drop &want) (drop &cflag) (drop &ldir) (drop &dir))
  (return (ok)))

; `(pkg-config …)` routes one tool's two outputs onto the four forms: an escaped
; space is one flag, `-pthread` is skipped by name, an unknown package applies nothing.
(deftest s21-repl-pkg-config
  (when (not (have-program? "pkg-config")) (skip! "pkg-config is not installed"))
  (let (dir:String (try (probe-library))
        dv:StrView (string-as-view &dir)
        pc:String (try (test-scratch-sub "pc"))
        sp:String (try (test-scratch-sub "with space"))
        pcf:String (str "Name: nucprobe\nDescription: the load units' probe\nVersion: 1\n"
                        "Cflags: -I" dv "/pinc -I" dv "/with\\ space -DNUC_PC=1\n"
                        "Libs: -L" dv " -lnucprobe -pthread\n")
        f:String (try (test-write-file "pc/nucprobe.pc" (string-as-view &pcf)))
        text:StrView "(pkg-config \"nucprobe\")\n(import-use \"nucprobe.h\")\n(nuc_probe_answer)\nNUC_PC\n(pkg-config \"no-such-pkg-s21\")\n(cflag)\n"
        report:String (str "nuc>   cflag: -I" dv "/pinc\n  cflag: -I" dv "/with space\n"
                           "  cflag: -DNUC_PC=1\n  library path: " dv "\n  loaded " dv
                           "/libnucprobe.so\n  skipped: -pthread\nnuc>   imported nucprobe.h\nnuc>   41\n")
        listed:String (str "nuc>   -I" dv "/pinc\n  -I" dv "/with space\n  -DNUC_PC=1\nnuc>")
        t:String (try (repl-session-with "" "" "" "PKG_CONFIG_PATH" (string-as-view &pc) text))
        tv:StrView (string-as-view &t))
    (try (check-contains tv (string-as-view &report)))
    (try (check-contains tv "undefined: NUC_PC"))
    (try (check-contains tv
           "  error: pkg-config: Package no-such-pkg-s21 was not found in the pkg-config search path"))
    (try (check-contains tv (string-as-view &listed)))
    (drop &t) (drop &listed) (drop &report) (drop &f) (drop &pcf)
    (drop &sp) (drop &pc) (drop &dir))
  (return (ok)))

; ---------------------------------------------------------------------------
; Stage 17: object-like `#define`s as untyped integer constants
; ---------------------------------------------------------------------------

(defn macro-header ():StrView (return "tests/layout/macros.h"))

; A program over `tests/layout/macros.h`, which is the admission table.
(defn macro-src (expr:StrView):String
  (return (str "(import-use \"" (macro-header) "\")
(import-use nucleus.io)
(defn main ():i32 (print " expr " \"\\n\") (return 0))
")))

; `MP_PUB` folds THROUGH the private `_MP_BASE` (010 | 0x20), so the admitted
; set is not merely "the ones with simple bodies".
(deftest s17-cmacro-admitted
  (let (src:String (macro-src "MP_PUB \" \" MP_SHIFT \" \" MP_XOR \" \" MP_AND \" \" MP_NEG \" \" MP_MAX")
        out:String (try (build-run-source (string-as-view &src))))
    (try (check-eq (string-as-view &out)
                   "40 16 255 60 -3 9223372036854775807\n"))
    (drop &out)
    (drop &src))
  (return (ok)))

; A name that was never registered, said so at the line that used it. The shell
; asked only whether the compile failed, which any other error also satisfies.
(defn check-macro-unknown (name:StrView):!void
  (let (src:String (macro-src name)
        p:String (try (test-write-file "t.nuc" (string-as-view &src)))
        pv:StrView (string-as-view &p)
        c:Compiled (try (compile-path pv))
        want:String (str "undefined: " name))
    (try (check-error-at (ref c 'diags) pv 3 (string-as-view &want)))
    (drop &want)
    (drop &c)
    (drop &p)
    (drop &src))
  (return (ok)))

; The first `#define NAME …` clang predefines whose name begins with a letter,
; or "". Which one that is is the platform's business, so it is read rather than
; named here — a leading-underscore predefine would be refused by the
; underscore rule and so could not test this one.
(defn first-clang-predefine ():!String
  (let (c:Command (command "clang")
        out:String (string-new))
    (command-arg &c "-E")
    (command-arg &c "-dM")
    (command-arg &c "-x")
    (command-arg &c "c")
    (command-arg &c "/dev/null")
    (command-capture &c true)
    (match (run &c)
      ((ok o)
        (let (ov:StrView (string-as-view (ref o 'out))
              it:LineIter (strview-lines &ov))
          (while (not (lines-iter-done &it))
            (let (l:StrView (lines-iter-next &it))
              (when (strview-has-prefix l "#define ")
                (let (nm:StrView (view-upto-byte (strview-drop-bytes l 8) 32))
                  (when (and (!= nm "") (not (strview-has-prefix nm "_"))
                             (not (contains? nm "(")) (= (byte-len &out) 0))
                    (str-into &out nm))))))
          (drop &o)))
      ((err e)
        (drop &c)
        (return (err e))))
    (drop &c)
    (return (ok out))))

; Everything that is not an integer constant expression stays out, and so does
; the reserved name. `MP_OVER` is the decimal-overflow guard; a clang predefine
; is not the header's macro at all.
(deftest s17-cmacro-refused
  (try (check-macro-unknown "_MP_BASE"))
  (try (check-macro-unknown "MP_FN"))
  (try (check-macro-unknown "MP_STR"))
  (try (check-macro-unknown "MP_FLOAT"))
  (try (check-macro-unknown "MP_LOGIC"))
  (try (check-macro-unknown "MP_OVER"))
  (let (pre:String (try (first-clang-predefine)))
    (when (> (byte-len &pre) 0)
      (try (check-macro-unknown (string-as-view &pre))))
    (drop &pre))
  (return (ok)))

; `unsafe/import-private` is the documented way past the leading-underscore
; rule, and the same `_MP_BASE` the table above refuses comes through.
(deftest s17-cmacro-private
  (let (out:String (try (build-run-source "(unsafe/import-private \"tests/layout/macros.h\" m)
(import-use nucleus.io)
(defn main ():i32 (print _MP_BASE \"\\n\") (return 0))
")))
    (try (check-eq (string-as-view &out) "8\n"))
    (drop &out))
  (return (ok)))

; The portability property, and the reason the hardcoded table went: the values
; are whatever THIS platform's headers say, so the reference is the C compiler
; reading the same headers — never a number written here.
(defn posix-c-src ():StrView
  (return "#include <fcntl.h>
#include <stdio.h>
#include <time.h>
int main(void) {
  printf(\"%d %d %d %d %d %d %ld\\n\", O_RDONLY, O_WRONLY, O_CREAT, O_TRUNC,
         O_APPEND, SEEK_SET, (long)CLOCKS_PER_SEC);
  return 0;
}
"))

(deftest s17-cmacro-posix
  (let (p:String (try (test-write-file "ref.c" (posix-c-src)))
        want:String (try (cc-link-run "" (string-as-view &p)))
        got:String (try (build-run-source "(import-use \"fcntl.h\")
(import-use \"stdio.h\")
(import-use \"time.h\")
(import-use nucleus.io)
(defn main ():i32 (print O_RDONLY \" \" O_WRONLY \" \" O_CREAT \" \" O_TRUNC \" \" O_APPEND \" \" SEEK_SET \" \" CLOCKS_PER_SEC \"\\n\") (return 0))
")))
    (try (check-eq (string-as-view &got) (string-as-view &want)))
    (drop &got)
    (drop &want)
    (drop &p))
  (return (ok)))

; ---------------------------------------------------------------------------
; RV-6: the riscv64 lp64d hard-float struct ABI
; ---------------------------------------------------------------------------

(defn rv6-fixture ():StrView (return "tests/fixtures/rv6-fp-abi.nuc"))

; BOTH lanes name their triple. Letting the SysV lane ride the default target
; made the gate assert "the host is x86_64", so it fired on riscv64 hardware
; reporting correct riscv lowering as a leak; a cross-emission gate is
; host-independent by construction.
;
; `check-no-errors` rather than `check-silent`: whichever of these triples has
; no sysroot here emits C4's fallback warning, and which one that is is a
; property of the container, not of the ABI. An ERROR would be neither.
(defn rv6-ir (target:StrView):!String
  (let (c:Compiled (try (target-emit target "" (rv6-fixture)))
        iv:StrView (compiled-ir &c))
    (try (check-no-errors (ref c 'diags)))
    (let (out:String (try (string-from-view &iv)))
      (drop &c)
      (return (ok out)))))

(defn rv6-riscv-ir ():!String
  (return (rv6-ir "riscv64-unknown-linux-gnu")))

(defn rv6-x86-ir ():!String
  (return (rv6-ir "x86_64-pc-linux-gnu")))

; §1: one FP real, two FP reals, an array and a nested struct that flatten, and
; rule 3 in both member orders — with the member order preserved in reg0/reg1.
(deftest rv6-flatten-rules
  (let (s:String (try (rv6-riscv-ir))
        ir:StrView (string-as-view &s))
    (try (check-line ir "define float @f_f1(float %v.arg) section \".text.f_f1\" {"))
    (try (check-line ir "define { double, double } @f_dd(double %v.arg.0, double %v.arg.1) section \".text.f_dd\" {"))
    (try (check-line ir "define { float, float } @f_farr2(float %v.arg.0, float %v.arg.1) section \".text.f_farr2\" {"))
    (try (check-line ir "define { float, float } @f_nest(float %v.arg.0, float %v.arg.1) section \".text.f_nest\" {"))
    (try (check-line ir "define { i32, float } @f_mixed(i32 %v.arg.0, float %v.arg.1) section \".text.f_mixed\" {"))
    (try (check-line ir "define { float, i32 } @f_mixedrev(float %v.arg.0, i32 %v.arg.1) section \".text.f_mixedrev\" {"))
    (try (check-line ir "define { i64, double } @f_longmix(i64 %v.arg.0, double %v.arg.1) section \".text.f_longmix\" {"))
    (try (check-line ir "define i64 @f_pair(i64 %v.arg) section \".text.f_pair\" {"))
    (drop &s))
  (return (ok)))

; §4: the same aggregate flattens while its registers are free and takes the
; integer convention once they are not — separately for FPRs, GPRs, and the GPR
; the hidden `sret` pointer spends before the first argument. Whole lines, so
; the budget that ran out is visible rather than implied.
(deftest rv6-register-counting
  (let (s:String (try (rv6-riscv-ir))
        ir:StrView (string-as-view &s))
    (try (check-line ir "define i32 @fpr7_mixed(double %a.arg, double %b.arg, double %c.arg, double %d.arg, double %e.arg, double %f.arg, double %g.arg, i32 %m.arg.0, float %m.arg.1) section \".text.fpr7_mixed\" {"))
    (try (check-line ir "define i32 @fpr8_mixed(double %a.arg, double %b.arg, double %c.arg, double %d.arg, double %e.arg, double %f.arg, double %g.arg, double %h.arg, i64 %m.arg) section \".text.fpr8_mixed\" {"))
    (try (check-line ir "define i32 @fpr6_dd(double %a.arg, double %b.arg, double %c.arg, double %d.arg, double %e.arg, double %f.arg, double %m.arg.0, double %m.arg.1) section \".text.fpr6_dd\" {"))
    (try (check-line ir "define i32 @fpr7_dd(double %a.arg, double %b.arg, double %c.arg, double %d.arg, double %e.arg, double %f.arg, double %g.arg, i64 %m.arg.0, i64 %m.arg.1) section \".text.fpr7_dd\" {"))
    (try (check-line ir "define i32 @gpr7_mixed(i64 %a.arg, i64 %b.arg, i64 %c.arg, i64 %d.arg, i64 %e.arg, i64 %f.arg, i64 %g.arg, i32 %m.arg.0, float %m.arg.1) section \".text.gpr7_mixed\" {"))
    (try (check-line ir "define i32 @gpr8_mixed(i64 %a.arg, i64 %b.arg, i64 %c.arg, i64 %d.arg, i64 %e.arg, i64 %f.arg, i64 %g.arg, i64 %h.arg, i64 %m.arg) section \".text.gpr8_mixed\" {"))
    (try (check-line ir "define i32 @gpr8_f1(i64 %a.arg, i64 %b.arg, i64 %c.arg, i64 %d.arg, i64 %e.arg, i64 %f.arg, i64 %g.arg, i64 %h.arg, float %m.arg) section \".text.gpr8_f1\" {"))
    (try (check-line ir "define i32 @gpr8_dd(i64 %a.arg, i64 %b.arg, i64 %c.arg, i64 %d.arg, i64 %e.arg, i64 %f.arg, i64 %g.arg, i64 %h.arg, double %m.arg.0, double %m.arg.1) section \".text.gpr8_dd\" {"))
    (try (check-line ir "define void @sret6_mixed(ptr sret(%Big) align 8 %.sret, i64 %a.arg, i64 %b.arg, i64 %c.arg, i64 %d.arg, i64 %e.arg, i64 %f.arg, i32 %m.arg.0, float %m.arg.1) section \".text.sret6_mixed\" {"))
    (try (check-line ir "define void @sret7_mixed(ptr sret(%Big) align 8 %.sret, i64 %a.arg, i64 %b.arg, i64 %c.arg, i64 %d.arg, i64 %e.arg, i64 %f.arg, i64 %g.arg, i64 %m.arg) section \".text.sret7_mixed\" {"))
    (drop &s))
  (return (ok)))

; §1: a variadic argument is never flattened and never takes an FPR. The shell
; asked that no `float`/`double` appear in the call; pinning the operand types
; says the same thing and also says how many there are, with only the SSA
; serials left to the emitter.
(deftest rv6-variadic-integer-convention
  (let (s:String (try (rv6-riscv-ir))
        ir:StrView (string-as-view &s))
    (try (check-match ir
           "  %t* = call i32 (ptr, ...) @printf(ptr %t*, i32 %t*, i64 %t*, i64 %t*, i64 %t*)"))
    (drop &s))
  (return (ok)))

; The anti-leak control: x86_64 SysV packs `{float[2]}` into one SSE eightbyte
; and `{i32,f32}` into one INTEGER eightbyte, and every register-counting shape
; differs too — the riscv rules must reach none of it. The shell checked five of
; these lines; a leak in any of the others would have passed.
(deftest rv6-x86-unchanged
  (let (s:String (try (rv6-x86-ir))
        ir:StrView (string-as-view &s))
    (try (check-line ir "define <2 x float> @f_farr2(<2 x float> %v.arg) section \".text.f_farr2\" {"))
    (try (check-line ir "define <2 x float> @f_nest(<2 x float> %v.arg) section \".text.f_nest\" {"))
    (try (check-line ir "define i64 @f_mixed(i64 %v.arg) section \".text.f_mixed\" {"))
    (try (check-line ir "define i64 @f_mixedrev(i64 %v.arg) section \".text.f_mixedrev\" {"))
    (try (check-line ir "define i32 @fpr7_mixed(double %a.arg, double %b.arg, double %c.arg, double %d.arg, double %e.arg, double %f.arg, double %g.arg, i64 %m.arg) section \".text.fpr7_mixed\" {"))
    (try (check-line ir "define i32 @fpr7_dd(double %a.arg, double %b.arg, double %c.arg, double %d.arg, double %e.arg, double %f.arg, double %g.arg, double %m.arg.0, double %m.arg.1) section \".text.fpr7_dd\" {"))
    (try (check-line ir "define i32 @gpr7_mixed(i64 %a.arg, i64 %b.arg, i64 %c.arg, i64 %d.arg, i64 %e.arg, i64 %f.arg, i64 %g.arg, i64 %m.arg) section \".text.gpr7_mixed\" {"))
    (try (check-line ir "define void @sret6_mixed(ptr sret(%Big) align 8 %.sret, i64 %a.arg, i64 %b.arg, i64 %c.arg, i64 %d.arg, i64 %e.arg, i64 %f.arg, i64 %m.arg) section \".text.sret6_mixed\" {"))
    (drop &s))
  (return (ok)))

; ---------------------------------------------------------------------------
; Stage 14 AVR-1..AVR-7 and RV-1, Stage 15 W9 item 15 — a machine that is not
; the host
; ---------------------------------------------------------------------------
;
; The lanes above ask what the target decides about C. This one asks the prior
; question: whether `--target=` reached anything at all. A compiler can echo a
; triple into the module header and go on emitting for the machine it is running
; on, and every one of these defects was exactly that — a 64-bit GEP index on an
; 8-bit MCU, a Node cell sized 40 for a 16-bit pointer, an SysV eightbyte
; classification on a part with no registers to hold one, soft-float libcalls
; against a hard-float ABI. None of them is an error; all of them are silent.
;
; So no unit here is satisfied by the header. Each reads the emitted
; INSTRUCTIONS, or drives the target's own toolchain, and the AVR ones come in
; pairs against the host: the same source, one target keyed off the descriptor.

; `clang --target=<t>` over an empty translation unit. The datalayout is LLVM's
; own answer for the triple, from the same LLVM the compiler is linked against,
; so a unit can ask whether the compiler agreed with it rather than whether the
; compiler still says what it said last time.
(defn clang-datalayout (target:StrView):!String
  (let (dir:StrView (try (test-scratch))
        src:String (try (write-into dir "empty.c" ""))
        flag:String (str "--target=" target)
        c:Command (command "clang"))
    (command-arg &c (string-as-view &flag))
    (command-arg &c "-S")
    (command-arg &c "-emit-llvm")
    (command-arg &c "-o")
    (command-arg &c "-")
    (command-arg &c (string-as-view &src))
    (command-capture &c true)
    (match (run &c)
      ((ok o)
        (when (not (success? (ref o 'status)))
          (fail! "clang cannot describe target " target "\n     "
                 (test-show (string-as-view (ref o 'err)))))
        (let (ov:StrView (string-as-view (ref o 'out))
              l:StrView (try (line-with ov "target datalayout = "))
              out:String (try (string-from-view &l)))
          (drop &o)
          (drop &c)
          (drop &flag)
          (drop &src)
          (return (ok out))))
      ((err e)
        (drop &c)
        (drop &flag)
        (drop &src)
        (return (err e))))))

; What one `--target=` is worth. The fixture is W9 item 15's, freestanding, so
; the absence of the target's own C headers is not part of the question and
; silence is a real assertion; and because every indexing form is in it, the
; pointer width has somewhere to show up besides the module header. `idx` is a
; property of the machine's NAME, not of this compiler, which is why it is
; written here rather than read back.
(defn tgt-triple-one (target:StrView idx:StrView):!void
  (let (c:Compiled (try (compile-path-for target "tests/fixtures/w9-gep-index-width.nuc"))
        iv:StrView (compiled-ir &c)
        what:String (str "cross-emitting for " target)
        triple:String (str "target triple = \"" target "\"")
        dl:String (try (clang-datalayout target))
        gep:String (str "  %t* = getelementptr inbounds i8, ptr %t*, " idx " %t*")
        gwhat:String (str "pointer-sized GEP indices for " target))
    (try (check-silent &c (string-as-view &what)))
    (try (check-line iv (string-as-view &triple)))
    (try (check-line iv (string-as-view &dl)))
    ; All six, not one: a partial conversion leaves the rest at host width, and
    ; only the index that is at or above the target pointer width fails to parse.
    (try (check-eq-int (count-matching-lines iv (string-as-view &gep)) 6
                       (string-as-view &gwhat)))
    (drop &gwhat)
    (drop &gep)
    (drop &dl)
    (drop &triple)
    (drop &what)
    (drop &c))
  (return (ok)))

(deftest target-x86_64-pc-linux-gnu
  (return (tgt-triple-one "x86_64-pc-linux-gnu" "i64")))

(deftest target-x86_64-apple-darwin
  (return (tgt-triple-one "x86_64-apple-darwin" "i64")))

(deftest target-aarch64-apple-darwin
  (return (tgt-triple-one "aarch64-apple-darwin" "i64")))

(deftest target-aarch64-unknown-linux-gnu
  (return (tgt-triple-one "aarch64-unknown-linux-gnu" "i64")))

(deftest target-arm-unknown-linux-gnueabihf
  (return (tgt-triple-one "arm-unknown-linux-gnueabihf" "i32")))

(deftest target-x86_64-pc-windows-msvc
  (return (tgt-triple-one "x86_64-pc-windows-msvc" "i64")))

(deftest target-x86_64-pc-windows-gnu
  (return (tgt-triple-one "x86_64-pc-windows-gnu" "i64")))

(deftest target-i386-pc-linux-gnu
  (return (tgt-triple-one "i386-pc-linux-gnu" "i32")))

(deftest target-avr
  (return (tgt-triple-one "avr" "i16")))

; ---------------------------------------------------------------------------
; The `long` data model, per target
; ---------------------------------------------------------------------------

; C `long` is 64-bit on LP64, 32-bit on ILP32 and on Windows LLP64, while `long
; long` is 64-bit everywhere — so the two together separate all three models,
; and neither alone does. The probe is written into the test's own scratch
; directory; the shell wrote it into `tests/abi/` beside the header, which is
; the source tree.
(defn long-abi-one (target:StrView want-l:StrView want-ll:StrView):!void
  (let (dir:StrView (try (test-scratch))
        probe:String (try (write-into dir "long-probe.nuc"
"(exclude-prelude)
(import-use \"tests/abi/long.h\")
(defn use ():i64 (return (lfn 1)))
"))
        c:Compiled (try (compile-path-for target (string-as-view &probe)))
        iv:StrView (compiled-ir &c)
        l:String (str "declare " want-l " @lfn(" want-l ")")
        ll:String (str "declare " want-ll " @llfn(" want-ll ")")
        ul:String (str "declare " want-l " @ulfn(" want-l ")"))
    (try (check-no-errors (ref c 'diags)))
    (try (check-line iv (string-as-view &l)))
    (try (check-line iv (string-as-view &ll)))
    ; `unsigned long` is the same width as `long`; the shell declared it in the
    ; header and then never looked at it.
    (try (check-line iv (string-as-view &ul)))
    (drop &ul)
    (drop &ll)
    (drop &l)
    (drop &c)
    (drop &probe))
  (return (ok)))

(deftest long-abi-x86_64-pc-linux-gnu
  (return (long-abi-one "x86_64-pc-linux-gnu" "i64" "i64")))

(deftest long-abi-aarch64-apple-darwin
  (return (long-abi-one "aarch64-apple-darwin" "i64" "i64")))

(deftest long-abi-i386-pc-linux-gnu
  (return (long-abi-one "i386-pc-linux-gnu" "i32" "i64")))

(deftest long-abi-x86_64-pc-windows-msvc
  (return (long-abi-one "x86_64-pc-windows-msvc" "i32" "i64")))

; ---------------------------------------------------------------------------
; AVR: the toolchain, and what it is handed
; ---------------------------------------------------------------------------

; The two reference devices: `attiny1634` names an exact part, `avrxmega3` names
; the AVR-Dx family core that the deviceless AVR32DD20 is compiled for. Both
; must lower, because the family path is the one that needs `--mmcu` at link.
(defn avr-mcpu (cpu:StrView):String
  (return (str "--mcpu=" cpu)))

(defn avr-ir (cpu:StrView path:StrView):!String
  (let (flag:String (avr-mcpu cpu)
        c:Compiled (try (target-emit "avr" (string-as-view &flag) path))
        iv:StrView (compiled-ir &c))
    (try (check-no-errors (ref c 'diags)))
    (let (out:String (try (string-from-view &iv)))
      (drop &c)
      (drop &flag)
      (return (ok out)))))

; `llc` over emitted IR, as an object. The compiler never reads back what it
; writes, so this is the only thing that says the module is not merely
; well-formed text but something the AVR backend accepts.
(defn llc-object (stem:StrView mtriple:StrView mcpu:StrView ir:StrView):!void
  (let (dir:StrView (try (test-scratch))
        name:String (str stem ".ll")
        src:String (try (write-into dir (string-as-view &name) ir))
        obj:String (str dir "/" stem ".o")
        tflag:String (str "-mtriple=" mtriple)
        cflag:String (str "-mcpu=" mcpu)
        c:Command (command "llc"))
    (command-arg &c (string-as-view &tflag))
    (when (not (= mcpu "")) (command-arg &c (string-as-view &cflag)))
    (command-arg &c "-filetype=obj")
    (command-arg &c (string-as-view &src))
    (command-arg &c "-o")
    (command-arg &c (string-as-view &obj))
    (command-capture &c true)
    (match (run &c)
      ((ok o)
        (when (not (success? (ref o 'status)))
          (fail! "llc rejected the emitted " mtriple " IR\n     "
                 (test-show (string-as-view (ref o 'err)))))
        (drop &o))
      ((err e)
        (drop &c)
        (return (err e))))
    (let (got:String (try (read-file (string-as-view &obj))))
      (try (check-non-empty (string-as-view &got)))
      (drop &got))
    (drop &c)
    (drop &cflag)
    (drop &tflag)
    (drop &obj)
    (drop &src)
    (drop &name))
  (return (ok)))

; AVR-1: the datalayout is the one clang derives for `avr`, and llc lowers what
; the compiler emitted. `--mcpu` reaches the TargetMachine or llc's own device
; check refuses the object.
(deftest avr-emit-attiny1634
  (let (s:String (try (avr-ir "attiny1634" "examples/arith.nuc"))
        ir:StrView (string-as-view &s)
        dl:String (try (clang-datalayout "avr")))
    (try (check-line ir "target triple = \"avr\""))
    (try (check-line ir (string-as-view &dl)))
    (drop &dl)
    (drop &s))
  (return (ok)))

(deftest avr-emit-avrxmega3
  (let (s:String (try (avr-ir "avrxmega3" "examples/arith.nuc"))
        ir:StrView (string-as-view &s)
        dl:String (try (clang-datalayout "avr")))
    (try (check-line ir "target triple = \"avr\""))
    (try (check-line ir (string-as-view &dl)))
    (drop &dl)
    (drop &s))
  (return (ok)))

(deftest avr-llc-attiny1634
  (when (not (have-program? "llc")) (skip! "llc is not installed"))
  (let (s:String (try (avr-ir "attiny1634" "examples/arith.nuc")))
    (try (llc-object "avr-emit-attiny1634" "avr" "attiny1634" (string-as-view &s)))
    (drop &s))
  (return (ok)))

(deftest avr-llc-avrxmega3
  (when (not (have-program? "llc")) (skip! "llc is not installed"))
  (let (s:String (try (avr-ir "avrxmega3" "examples/arith.nuc")))
    (try (llc-object "avr-emit-avrxmega3" "avr" "avrxmega3" (string-as-view &s)))
    (drop &s))
  (return (ok)))

; AVR-2: 16-bit correctness where llc cannot see it. A wrong-but-well-formed
; pointer width lowers perfectly, so each of these is a silent miscompile rather
; than a build failure. Since Stage 21 the quasiquote list runtime is an ordinary
; library compiled FOR the target (it was a helper the emitter spliced in at a
; fixed host width), so its own element index and allocation are the subject.
(defn avr2-16bit-one (cpu:StrView):!void
  (let (s:String (try (avr-ir cpu "tests/fixtures/avr2-16bit.nuc"))
        ir:StrView (string-as-view &s))
    (try (check-match ir "*ptrtoint ptr %t* to i16"))
    (try (check-not-match ir "*ptrtoint ptr %t* to i64"))
    ; size_t is 16-bit there, so the allocator under the node runtime takes i16.
    (try (check-line ir "declare ptr @malloc(i16)"))
    ; `(aref (b 'elems) (b 'len))` — a pointer-sized index into the element array.
    (try (check-match ir "*getelementptr inbounds ptr, ptr %t*, i16 %t*"))
    (try (check-not-match ir "*getelementptr inbounds ptr, ptr %t*, i64 %t*"))
    (drop &s))
  (return (ok)))

(deftest avr2-16bit-attiny1634
  (return (avr2-16bit-one "attiny1634")))

(deftest avr2-16bit-avrxmega3
  (return (avr2-16bit-one "avrxmega3")))

(deftest avr2-llc-attiny1634
  (when (not (have-program? "llc")) (skip! "llc is not installed"))
  (let (s:String (try (avr-ir "attiny1634" "tests/fixtures/avr2-16bit.nuc")))
    (try (llc-object "avr2-attiny1634" "avr" "attiny1634" (string-as-view &s)))
    (drop &s))
  (return (ok)))

(deftest avr2-llc-avrxmega3
  (when (not (have-program? "llc")) (skip! "llc is not installed"))
  (let (s:String (try (avr-ir "avrxmega3" "tests/fixtures/avr2-16bit.nuc")))
    (try (llc-object "avr2-avrxmega3" "avr" "avrxmega3" (string-as-view &s)))
    (drop &s))
  (return (ok)))

; ---------------------------------------------------------------------------
; W9 item 15: the GEP index follows the target pointer
; ---------------------------------------------------------------------------
;
; The nine triple units above assert the width; these three assert the two ways
; the old code was wrong, which the width alone does not distinguish. An index
; at or above the pointer width was passed through unwidened while the
; annotation still read `i64`, naming an i16 register — LLVM refuses that
; outright. A NARROWER one was widened to a real i64, which parses and lowers
; and emits 64-bit arithmetic on an 8-bit MCU; only its absence can be seen.

(deftest w9-gep-index-width-avr-parses
  (let (s:String (try (avr-ir "attiny1634" "tests/fixtures/w9-gep-index-width.nuc"))
        sv:StrView (string-as-view &s))
    (try (check-ir-parses sv))
    ; The control, and the defect itself: widening only the ANNOTATION is what
    ; the old code did, so llvm-as accepting the module above means something
    ; only because the same llvm-as refuses this one.
    (let (bad:String (try (replace-all sv ", i16 %" ", i64 %")))
      (try (check-ir-rejects (string-as-view &bad) "but expected 'i16'"))
      (drop &bad))
    (drop &s))
  (return (ok)))

(deftest w9-gep-index-width-avr-no-i64
  (let (s:String (try (avr-ir "attiny1634" "tests/fixtures/w9-gep-index-width.nuc"))
        ir:StrView (string-as-view &s))
    ; Instruction lines only. The AVR datalayout names i64 as a legal scalar
    ; width, which says nothing about whether an instruction uses one.
    (try (check-not-match ir "  *i64*"))
    (drop &s))
  (return (ok)))

(deftest w9-gep-index-width-host
  (let (c:Compiled (try (compile-path "tests/fixtures/w9-gep-index-width.nuc"))
        iv:StrView (compiled-ir &c))
    (try (check-eq-int
           (count-matching-lines iv "  %t* = getelementptr inbounds i8, ptr %t*, i64 %t*")
           6 "host GEP indices at the host pointer width"))
    (drop &c))
  (return (ok)))

; ---------------------------------------------------------------------------
; AVR-3/AVR-5: a real link, driven by the target's own toolchain
; ---------------------------------------------------------------------------

(defn have-avr-toolchain? ():bool
  (return (and (have-program? "avr-gcc")
               (and (have-program? "avr-objdump") (have-program? "avr-size")))))

; Skip unless avr-gcc can link a C `main` for `device`: the binaries alone say
; nothing about avr-libc or the device's startup files, which are packaged apart.
(defn avr-require-device (device:StrView):!void
  (when (not (have-avr-toolchain?)) (skip! "the avr-gcc toolchain is not installed"))
  (let (dir:StrView (try (test-scratch))
        src:String (try (test-write-file "avr-probe.c" "int main(void) { return 0; }\n"))
        elf:String (str dir "/avr-probe.elf")
        mflag:String (str "-mmcu=" device)
        c:Command (command "avr-gcc"))
    (command-arg &c (string-as-view &mflag))
    (command-arg &c (string-as-view &src))
    (command-arg &c "-o")
    (command-arg &c (string-as-view &elf))
    (let (r:Ran (try (ran &c)))
      (when (not (r 'ok?))
        (skip! "avr-gcc cannot link a C program for " device
               " (avr-libc or its device support is missing)\n     "
               (test-show (string-as-view (ref r 'err)))))
      (drop &r))
    (drop &c)
    (drop &mflag)
    (drop &elf)
    (drop &src))
  (return (ok)))

; `nucleusc --target=avr --mcpu=<cpu> [--mmcu=<device>] <path> -o <elf>`. No
; `-c` and no `--emit-llvm`: the compiler emits the object and shells out to
; `avr-gcc`, which is the part under test.
(defn avr-link (stem:StrView cpu:StrView mmcu:StrView path:StrView):!String
  (let (dir:StrView (try (test-scratch))
        elf:String (str dir "/" stem ".elf")
        cflag:String (avr-mcpu cpu)
        mflag:String (str "--mmcu=" mmcu)
        what:String (str "linking " path " for " cpu)
        c:Command (command (compiler-path)))
    (command-arg &c "--target=avr")
    (command-arg &c (string-as-view &cflag))
    (when (not (= mmcu "")) (command-arg &c (string-as-view &mflag)))
    (command-arg &c "--diagnostics=edn")
    (command-arg &c path)
    (command-arg &c "-o")
    (command-arg &c (string-as-view &elf))
    (let (r:Compiled (try (compiled-run &c)))
      (try (check-silent &r (string-as-view &what)))
      ; A link-step failure is plain text on stderr, not an EDN diagnostic.
      (when (not (r 'ok?))
        (fail! (string-as-view &what) " failed (exit " (r 'exit) ")\n     "
               (test-show (string-as-view (ref r 'raw-text)))))
      (drop &r))
    (drop &c)
    (drop &what)
    (drop &mflag)
    (drop &cflag)
    (return (ok elf))))

(defn avr-tool (tool:StrView flag:StrView path:StrView):!String
  (let (c:Command (command tool))
    (command-arg &c flag)
    (command-arg &c path)
    (command-capture &c true)
    (match (run &c)
      ((ok o)
        (when (not (success? (ref o 'status)))
          (fail! tool " " flag " failed\n     "
                 (test-show (string-as-view (ref o 'err)))))
        (let (ov:StrView (string-as-view (ref o 'out))
              out:String (try (string-from-view &ov)))
          (drop &o)
          (drop &c)
          (return (ok out))))
      ((err e)
        (drop &c)
        (return (err e))))))

; The n'th whitespace-separated field of `l`. `avr-size`'s Berkeley columns are
; padded to a width, so they are not separated by a fixed string.
(defn ws-field (l:StrView n:i64):!StrView
  (let (rest:StrView (strview-trim-start &l)
        i:i64 0)
    (while (not (strview-empty (ref rest)))
      (let (end:usize (strview-byte-len (ref rest))
            k:usize 0)
        (while (and (< k end)
                    (not (strview-is-ascii-ws (try (strview-byte-at (ref rest) k)))))
          (set! k (+ k 1)))
        (when (= i n) (return (ok (strview-take-bytes rest k))))
        (let (tail:StrView (strview-drop-bytes rest k))
          (set! rest (strview-trim-start &tail)))
        (set! i (+ i 1)))))
  (fail! "no field " n " in " (quoted l)))

; The `text` and `data` columns of `avr-size`. A freestanding program is tens of
; bytes; a pulled-in host runtime is kilobytes and brings initialized data with
; it, so `data` is the load-bearing half and `text` is the sanity bound.
(defn avr-footprint (elf:StrView out-text:&ui64 out-data:&ui64):!void
  (let (s:String (try (avr-tool "avr-size" "-B" elf))
        sv:StrView (string-as-view &s)
        it:LineIter (strview-lines &sv)
        row:StrView "")
    (while (not (lines-iter-done &it))
      (let (l:StrView (lines-iter-next &it))
        (when (and (= row "") (contains? l "/")) (set! row l))))
    (when (= row "") (fail! "avr-size printed no row for " elf "\n     " (test-show sv)))
    (set! (aref out-text 0) (try (strview-parse-magnitude (try (ws-field row 0)) 10 1000000)))
    (set! (aref out-data 0) (try (strview-parse-magnitude (try (ws-field row 1)) 10 1000000)))
    (drop &s))
  (return (ok)))

; AVR-3. `architecture: avr:<n>` is the device family binutils recorded in the
; ELF, and it differs between the two devices — which is what says `--mmcu`, not
; `--mcpu`, supplied the device name on the link line. The shell asked `file`
; whether the ELF was "Atmel AVR 8-bit", which is the same answer for both.
(defn avr3-link-one (stem:StrView cpu:StrView mmcu:StrView arch:StrView):!void
  (try (avr-require-device (if (= mmcu "") cpu mmcu)))
  (let (elf:String (try (avr-link stem cpu mmcu "tests/fixtures/avr3-link.nuc"))
        ev:StrView (string-as-view &elf)
        f:String (try (avr-tool "avr-objdump" "-f" ev))
        fv:StrView (string-as-view &f)
        want:String (str "architecture: " arch ",*")
        dwhat:String (str stem " initialized data bytes")
        twhat:String (str stem " text under 4096 bytes")
        text:ui64 0
        data:ui64 0)
    (try (check-match fv "*file format elf32-avr"))
    (try (check-match fv (string-as-view &want)))
    (try (avr-footprint ev &text &data))
    ; Exactly zero: the prelude-free floor this fixture exists to pin. The shell
    ; allowed anything under 256, which a small pulled-in runtime satisfies.
    (try (check-eq-int (as i64 data) 0 (string-as-view &dwhat)))
    (try (check (< text 4096) (string-as-view &twhat)))
    (drop &twhat)
    (drop &dwhat)
    (drop &want)
    (drop &f)
    (drop &elf))
  (return (ok)))

(deftest avr3-link-attiny1634
  (return (avr3-link-one "avr3-attiny1634" "attiny1634" "" "avr:35")))

(deftest avr3-link-avr32dd20
  (return (avr3-link-one "avr3-avr32dd20" "avrxmega3" "avr32dd20" "avr:103")))

; The disassembly of one function: from its `<name>:` label to the next blank
; line. avr-libc's vector table is full of `reti`, so a whole-file search proves
; nothing about the handler.
(defn disasm-body (dis:StrView name:StrView):!String
  (let (label:String (str "<" name ">:")
        lv:StrView (string-as-view &label)
        it:LineIter (strview-lines &dis)
        out:String (string-new)
        seen:bool false
        done:bool false)
    (while (not (lines-iter-done &it))
      (let (l:StrView (lines-iter-next &it))
        (when (not done)
          (if seen
            (if (= (strview-trim &l) "")
              (set! done true)
              (str-into &out l "\n"))
            (when (contains? l lv) (set! seen true))))))
    (drop &label)
    (when (not seen) (fail! "no disassembly for " name "\n     " (test-show dis)))
    (return (ok out))))

; Any line of `body` whose mnemonic is `m`. objdump pads address and opcode
; columns with tabs, so the mnemonic is what the line ends with.
(defn body-has-mnemonic? (body:StrView m:StrView):bool
  (let (it:LineIter (strview-lines &body))
    (while (not (lines-iter-done &it))
      (let (l:StrView (lines-iter-next &it))
        (when (strview-has-suffix (strview-trim &l) m) (return true))))
    (return false)))

; AVR-5: `(fn-attr <name> "signal")` on a defn named for an avr-libc vector
; symbol. The two halves are separate claims — the strong symbol overrode
; avr-libc's weak `__bad_interrupt`, and the attribute reached the backend,
; which is the only thing that turns the epilogue from `ret` into `reti`.
(deftest avr5-isr
  (try (avr-require-device "atmega328p"))
  (let (elf:String (try (avr-link "avr5-isr" "atmega328p" "" "examples/avr-isr.nuc"))
        ev:StrView (string-as-view &elf)
        f:String (try (avr-tool "avr-objdump" "-f" ev))
        d:String (try (avr-tool "avr-objdump" "-d" ev))
        dv:StrView (string-as-view &d))
    (try (check-match (string-as-view &f) "architecture: avr:5,*"))
    (try (check-match dv "*jmp*<__vector_13>"))
    (let (body:String (try (disasm-body dv "__vector_13")))
      (try (check (body-has-mnemonic? (string-as-view &body) "reti")
                  "__vector_13 to end in reti"))
      (drop &body))
    (drop &d)
    (drop &f)
    (drop &elf))
  (return (ok)))

; ---------------------------------------------------------------------------
; AVR-6: the Harvard hazards
; ---------------------------------------------------------------------------

; A function materialized as a first-class DATA pointer is `ptr addrspace(1)` on
; AVR where a plain `ptr` is required — an LLVM verifier error, so v1 refuses at
; compile time. Keyed on the descriptor's prog-as, which is why the SAME source
; must compile on the host: a diagnostic that fired everywhere would pass a test
; that only looked at AVR.
(deftest avr6-fnvalue-diagnostic
  (let (flag:String (avr-mcpu "attiny1634")
        a:Compiled (try (target-emit "avr" (string-as-view &flag)
                                     "tests/fixtures/avr6-fnvalue.nuc")))
    ; Located, so a regression that reports the hazard against the wrong form is
    ; a failure rather than a pass: the shell matched the message anywhere.
    (try (check-error-at (ref a 'diags) "tests/fixtures/avr6-fnvalue.nuc" 15
           "cannot use function 'add' as a value on this target"))
    (drop &a)
    (drop &flag))
  (let (h:Compiled (try (compile-path "tests/fixtures/avr6-fnvalue.nuc")))
    (try (check-silent &h "the same source on the host"))
    (drop &h))
  (return (ok)))

; An aggregate `defconst` emits an LLVM `constant`, so on a mapped-flash part
; the table costs no RAM; a plain defvar is unchanged.
(deftest avr6-const-global
  (let (c:Compiled (try (compile-path "tests/fixtures/avr6-const.nuc"))
        iv:StrView (compiled-ir &c))
    (try (check-line iv "@table = constant [2 x i32] [i32 42, i32 7], section \".rodata.table\", align 4"))
    (try (check-line iv "@mutable-count = global i32 0, section \".bss.mutable-count\", align 4"))
    (drop &c))
  (return (ok)))

; ---------------------------------------------------------------------------
; AVR-7: numerics and the aggregate ABI
; ---------------------------------------------------------------------------

; The other half of every target-keyed rejection: the SAME file on the host.
(defn host-accepts (path:StrView):!void
  (let (c:Compiled (try (compile-path path))
        what:String (str path " on the host"))
    (try (check-silent &c (string-as-view &what)))
    (drop &what)
    (drop &c))
  (return (ok)))

(defn avr-rejects (cpu:StrView path:StrView line:i32 needle:StrView):!void
  (let (flag:String (avr-mcpu cpu)
        c:Compiled (try (target-emit "avr" (string-as-view &flag) path)))
    (try (check-error-at (ref c 'diags) path line needle))
    (drop &c)
    (drop &flag))
  (return (ok)))

; f64 has no hardware on an 8-bit part, and the rejection has to happen at BOTH
; finalization points — an explicit annotation reaches `parse-type-name`, a bare
; float literal never does and reaches `emit-float` instead. Each half is keyed
; against the host accepting the same file.
;
; The `double` spelling is a THIRD case, not a restatement of the first: the two
; names are separate branches of the same test in `union-registry.nuc`. The
; shell's step 2 claimed to cover it and re-ran step 1's command on step 1's
; fixture, so it had never been compiled for AVR at all.
(deftest avr7-f64-rejected
  (let (msg:StrView "f64 is not supported on AVR")
    (try (avr-rejects "attiny1634" "tests/fixtures/avr7-f64-annot.nuc" 5 msg))
    (try (host-accepts "tests/fixtures/avr7-f64-annot.nuc"))
    (let (dir:StrView (try (test-scratch))
          dbl:String (try (write-into dir "avr7-double.nuc" "(exclude-prelude)
(defn takes-double (x:double):double (return x))
"))
          dv:StrView (string-as-view &dbl))
      (try (avr-rejects "attiny1634" dv 2 msg))
      (drop &dbl))
    (try (avr-rejects "attiny1634" "tests/fixtures/avr7-f64-literal.nuc" 6 msg))
    (try (host-accepts "tests/fixtures/avr7-f64-literal.nuc")))
  (return (ok)))

(deftest avr7-f32-allowed
  (let (s:String (try (avr-ir "attiny1634" "tests/fixtures/avr7-f32.nuc"))
        ir:StrView (string-as-view &s))
    (try (check-line ir "define float @idf(float %a.arg) section \".text.idf\" {"))
    (drop &s))
  (return (ok)))

(deftest avr7-i64-allowed
  (let (s:String (try (avr-ir "attiny1634" "tests/fixtures/avr7-i64.nuc"))
        ir:StrView (string-as-view &s))
    ; Costly but correct: libgcc's __muldi3 supplies it at link.
    (try (check-match ir "*mul nsw i64 %t*, %t*"))
    (drop &s))
  (return (ok)))

; AVR classifies EVERY aggregate as ABI-MEMORY with aarch64-style plain-pointer
; passing, bypassing the SysV eightbyte model that assumes 8-byte register
; chunks. Target-keyed against the host, where the same 4-byte struct is
; register-coerced — without that half the claim is satisfied by a compiler that
; passes every struct by pointer everywhere.
(deftest avr7-struct-abi
  (let (s:String (try (avr-ir "atmega328p" "tests/fixtures/avr7-struct.nuc"))
        ir:StrView (string-as-view &s))
    (try (check-line ir "define i16 @sum(ptr %p.arg) section \".text.sum\" {"))
    (try (check-match ir "define void @mk(ptr sret(%Point) align 1 %.sret, i16 %a.arg, i16 %b.arg)*"))
    (try (check-not-match ir "*byval*"))
    (drop &s))
  (let (c:Compiled (try (compile-path "tests/fixtures/avr7-struct.nuc"))
        iv:StrView (compiled-ir &c))
    (try (check-line iv "define i16 @sum(i32 %p.arg) section \".text.sum\" {"))
    (try (check-line iv "define i32 @mk(i16 %a.arg, i16 %b.arg) section \".text.mk\" {"))
    (drop &c))
  (return (ok)))

; The emitted ABI is one thing; avr-gcc accepting it is another. This is the
; only unit that puts the struct convention through the real assembler and
; linker.
(deftest avr7-struct-link
  (try (avr-require-device "atmega328p"))
  (let (elf:String (try (avr-link "avr7-struct" "atmega328p" "" "tests/fixtures/avr7-struct.nuc"))
        ev:StrView (string-as-view &elf)
        f:String (try (avr-tool "avr-objdump" "-f" ev))
        text:ui64 0
        data:ui64 0)
    (try (check-match (string-as-view &f) "architecture: avr:5,*"))
    (try (avr-footprint ev &text &data))
    (try (check (> text 0) "avr7-struct to carry code"))
    (drop &f)
    (drop &elf))
  (return (ok)))

; ---------------------------------------------------------------------------
; RV-1: the features cliff
; ---------------------------------------------------------------------------

(defn rv1-ir ():!String
  (let (c:Compiled (try (compile-path-for "riscv64-unknown-linux-gnu"
                                          "tests/fixtures/riscv-features.nuc"))
        iv:StrView (compiled-ir &c))
    (try (check-no-errors (ref c 'diags)))
    (let (out:String (try (string-from-view &iv)))
      (drop &c)
      (return (ok out)))))

(deftest riscv-emit
  (let (s:String (try (rv1-ir))
        ir:StrView (string-as-view &s)
        dl:String (try (clang-datalayout "riscv64-unknown-linux-gnu")))
    (try (check-line ir "target triple = \"riscv64-unknown-linux-gnu\""))
    (try (check-line ir (string-as-view &dl)))
    ; The module flag is what makes the hard-float ABI a property of the module
    ; rather than of whoever runs llc next.
    (try (check-line ir "!0 = !{i32 1, !\"target-abi\", !\"lp64d\"}"))
    (drop &dl)
    (drop &s))
  (return (ok)))

; With +m,+a,+f,+d,+c an i64 multiply is a hardware `mul` and an f64 add a
; `fadd.d`; with bare RV64I both become `__muldi3`/`__adddf3` soft-float
; libcalls — a SILENT ABI mismatch with riscv64 glibc, not an error.
;
; So the load-bearing half is the compiler's OWN object: the shell handed llc
; the feature list on the command line, which asks whether llc can lower the IR,
; not whether the features ever reached the compiler's TargetMachine. The bare
; llc run stays as the control that shows the two answers differ at all.
(deftest riscv-llc-features
  (when (not (have-program? "llc")) (skip! "llc is not installed"))
  (when (not (have-program? "llvm-objdump")) (skip! "llvm-objdump is not installed"))
  (let (dir:StrView (try (test-scratch))
        obj:String (str dir "/riscv-features.o")
        ov:StrView (string-as-view &obj)
        c:Command (command (compiler-path)))
    (command-arg &c "--target=riscv64-unknown-linux-gnu")
    (command-arg &c "--diagnostics=edn")
    (command-arg &c "-c")
    (command-arg &c "tests/fixtures/riscv-features.nuc")
    (command-arg &c "-o")
    (command-arg &c ov)
    (let (r:Compiled (try (compiled-run &c)))
      (try (check-no-errors (ref r 'diags)))
      (drop &r))
    (drop &c)
    (let (d:String (try (avr-tool "llvm-objdump" "-d" ov))
          dv:StrView (string-as-view &d))
      (try (check-match dv "*mul*a0, a0, a1"))
      (try (check-match dv "*fadd.d*"))
      (try (check-not-match dv "*__muldi3*"))
      (try (check-not-match dv "*__adddf3*"))
      (drop &d))
    (drop &obj))
  ; The control: the same IR at bare RV64I falls off the cliff, so the
  ; assertions above are discriminating rather than true of any lowering.
  (let (s:String (try (rv1-ir))
        dir:StrView (try (test-scratch))
        src:String (try (write-into dir "rv64i.ll" (string-as-view &s)))
        asm:String (str dir "/rv64i.s")
        c:Command (command "llc"))
    (command-arg &c "-mtriple=riscv64")
    (command-arg &c "-filetype=asm")
    (command-arg &c (string-as-view &src))
    (command-arg &c "-o")
    (command-arg &c (string-as-view &asm))
    (command-capture &c true)
    (match (run &c)
      ((ok o) (drop &o))
      ((err e) (drop &c) (return (err e))))
    (drop &c)
    (let (a:String (try (read-file (string-as-view &asm)))
          av:StrView (string-as-view &a))
      (try (check-match av "*__muldi3*"))
      (try (check-match av "*__adddf3*"))
      (drop &a))
    (drop &asm)
    (drop &src)
    (drop &s))
  (return (ok)))

; Stage 18 TF-6 category (c) — the Stage 16 type-system units, ported.
;
; Design: design/stage18-tooling/overview.md §T6.6.
;
; These were the largest bodies in `tests/run-tests.sh`. Each varies one line of
; a small program across a dozen spellings, so the fixture is embedded (§T8.3
; ruling 3) rather than filed, and a string literal may span lines — which is
; what makes an embedded program readable at all.

; ---------------------------------------------------------------------------
; bool as a type of its own (Stage 16 §BT)
; ---------------------------------------------------------------------------

; No implicit coercion in either direction — the {0,1} rule's replacement.
(deftest s16-bool-no-implicit-coercion
  (try (check-source-rejects
         "(defvar g:bool 1)
(defn main ():i32 (return 0))
"
         "defvar: integer literal incompatible with type bool"))
  (try (check-source-rejects
         "(defn main ():i32 (let (b:bool 1) (return 0)))
"
         "let: init type mismatch for 'b'"))
  (try (check-source-rejects
         "(defn main ():i32 (let (n:i32 true) (return 0)))
"
         "let: init type mismatch for 'n'"))
  (try (check-source-rejects
         "(defn main ():i32 (let (b:bool (as bool 1)) (return 0)))
"
         "as: lossy conversion from i32 to bool -- use unsafe/cast")))

; Arithmetic refuses a bool operand, and a comparison refuses a MIXED pair. All
; six comparisons on two bools stay legal (w9-bool-unsigned covers them).
(deftest s16-bool-not-an-integer-operand
  (try (check-source-rejects
         "(defn main ():i32 (let (b:bool (+ true true)) (return 0)))
"
         "_+ does not apply to bool"))
  (try (check-source-rejects
         "(defn main ():i32 (let (b:bool (bit-and true true)) (return 0)))
"
         "bit-and does not apply to bool"))
  (try (check-source-rejects
         "(defn main ():i32 (let (b:bool (= true 1)) (return 0)))
"
         "=: mixed bool and non-bool operands")))

; `i1` is retired as a spelling, in every type position, and names bool.
(deftest s16-bool-i1-spelling-retired
  (try (check-source-rejects
         "(defn main ():i32 (let (b:i1 true) (return 0)))
"
         "i1 is no longer a type — use bool"))
  (try (check-source-rejects
         "(defn f (a:i1):i32 (return 0))
(defn main ():i32 (return 0))
"
         "i1 is no longer a type — use bool"))
  (try (check-source-rejects
         "(defn f ():i1 (return true))
(defn main ():i32 (return 0))
"
         "i1 is no longer a type — use bool")))

; The accepting half. `(as i32 b)` is the sanctioned widening (zext, since bool
; is unsigned), and a bool global must hold the value that was WRITTEN — the
; assertion a run cannot make, since `global i1 false` for a written `true`
; still exits 0 through every check a run could apply.
(deftest s16-bool-widens-to-int
  (let (src:StrView "(import-use \"stdio.h\")
(defvar s16b-t:bool true)
(defvar s16b-f:bool false)
(defn main ():i32
  (printf \"%d %d\\n\" (as i32 s16b-t) (as i32 s16b-f))
  (return 0))
")
    (let (out:String (try (build-run-source src))
          ov:StrView (string-as-view (addr-of out)))
      (try (check-eq (strview-trim-end (addr-of ov)) "1 0"))
      (drop (addr-of out)))
    (let (ir:String (try (source-ir src)))
      (try (check-contains (string-as-view (addr-of ir)) "@s16b-t = global i1 true"))
      (try (check-contains (string-as-view (addr-of ir)) "@s16b-f = global i1 false"))
      (try (check-contains (string-as-view (addr-of ir)) "zext i1"))
      (drop (addr-of ir)))))

; `as` names `unsafe/cast` in every bool rejection, so the hatch has to be
; TOTAL: all five instruction-selection gates must admit a bool operand, or the
; diagnostic advertises a conversion that cannot be written.
(deftest s16-bool-unsafe-cast-is-total
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(defn main ():i32
  (let (b:bool (unsafe/cast bool 1)
        z:bool (unsafe/cast bool 0)
        n:i32  (unsafe/cast i32 true)
        f:f64  (unsafe/cast f64 true)
        w:i64  (unsafe/cast i64 false))
    (printf \"%d %d %d %.1f %ld\\n\" (as i32 b) (as i32 z) n f w))
  (return 0))
")))
    (let (ov:StrView (string-as-view (addr-of out)))
      (try (check-eq (strview-trim-end (addr-of ov)) "1 0 1 1.0 0")))
    (drop (addr-of out))))

; The two permanent, user-visible spellings of the type: the mangle token in an
; overload's link name, and the C rendering in a generated header. Both read
; `i1` before Stage 16; a header consumer sees whichever ships.
(deftest s16-bool-mangle-and-c-spelling
  (let (src:StrView "(defn f (a:bool):i32 (return (as i32 a)))
(defn f (a:i32):i32 (return a))
(defn g (b:bool):bool (return (not b)))
")
    (let (ir:String (try (source-ir src)))
      (try (check-contains (string-as-view (addr-of ir))
                           "define i32 @f.bool(i1 %a.arg)"))
      (drop (addr-of ir)))
    (let (h:String (try (source-cheader src)))
      (try (check-line (string-as-view (addr-of h))
                       "int32_t f_bool(bool a) asm(\"f.bool\");"))
      (try (check-line (string-as-view (addr-of h)) "bool g(bool b);"))
      (try (check-line (string-as-view (addr-of h)) "#include <stdbool.h>"))
      (drop (addr-of h)))))

; ---------------------------------------------------------------------------
; Macros: atoms, `macrolet`, and what `macrolet` refuses (Stage 16 §MA)
; ---------------------------------------------------------------------------

; A macro template that is a bare atom -- a literal, an unquoted symbol, or a
; quoted one -- expands to that atom rather than to a call. The answer is the
; exit status, since each of the four contributes a number.
(deftest s16-atom-macro
  (try (check-source-exit "(defmacro one () `1)
(defmacro sym-of () `x)
(defmacro quoted () 'y)
(defn main ():i32
  (let (x:i32 40 y:i32 2)
    (macrolet ((two () `2))
      (return (_+ (one) (_+ (two) (_+ (sym-of) (quoted))))))))
" 45)))

(deftest s16-defmacro-nonsym-param
  (try (check-source-rejects
         "(defmacro m (5) `1)\n(defn main ():i32 0)\n"
         "defmacro: param must be a symbol")))

(deftest s16-macrolet-refused-noargs
  (try (check-source-rejects "(defn main ():i32 (macrolet) 0)
"
         "macrolet: expects a binding list and at least one body form")))
(deftest s16-macrolet-refused-nobody
  (try (check-source-rejects "(defn main ():i32 (macrolet ((m () `1))) 0)
"
         "macrolet: expects a binding list and at least one body form")))
(deftest s16-macrolet-refused-badbind
  (try (check-source-rejects "(defn main ():i32 (macrolet (m) 0))
"
         "macrolet: binding must be (name (params) body...)")))
(deftest s16-macrolet-refused-badname
  (try (check-source-rejects "(defn main ():i32 (macrolet ((5 () `1)) 0))
"
         "macrolet: macro name must be a symbol")))
(deftest s16-macrolet-refused-badparams
  (try (check-source-rejects "(defn main ():i32 (macrolet ((m 5 `1)) 0))
"
         "macrolet: params must be a list")))
(deftest s16-macrolet-refused-badparam
  (try (check-source-rejects "(defn main ():i32 (macrolet ((m (5) `1)) 0))
"
         "macrolet: param must be a symbol")))
(deftest s16-macrolet-refused-special
  (try (check-source-rejects "(defn main ():i32 (macrolet ((let (x) `1)) 0))
"
         "macrolet: 'let' is a special form and may not be shadowed")))
(deftest s16-macrolet-refused-restpos
  (try (check-source-rejects "(defn main ():i32 (macrolet ((m (:rest a b) `1)) 0))
"
         "macrolet: :rest must be second-to-last param")))
(deftest s16-macrolet-refused-colon
  (try (check-source-rejects "(defn main ():i32 (macrolet ((m:i32 () `1)) 0))
"
         "macrolet: a binding name takes no type annotation; write (m (params) ...)")))
(deftest s16-macrolet-refused-toplevel
  (try (check-source-rejects "(macrolet ((m () `1)) (m))
"
         "unknown top-level form: macrolet")))

; ---------------------------------------------------------------------------
; `:repr` on an UNINSTANTIATED template (Stage 16 §TR)
; ---------------------------------------------------------------------------

; The mode is checked where it is written, not where it is stamped: a template
; nobody instantiates still has to be diagnosed.
(deftest s16-template-repr
  (try (check-source-rejects "(defunion (Box T) (some v:T) none :repr bogus)
(defn main ():i32 (return 0))
"
         "defunion: :repr mode must be `tagged` or `niche`"))
  (try (check-source-rejects "(defunion (Box T) (some v:T) none :repr)
(defn main ():i32 (return 0))
"
         "defunion: :repr needs a mode (tagged or niche)"))
  (try (check-source-rejects "(defunion (Box T) (some v:T) none &repr tagged)
(defn main ():i32 (return 0))
"
         "'&repr' is no longer a marker -- write ':repr'"))
  ; And a VALID uninstantiated template still compiles -- the check must
  ; diagnose, not stamp.
  (try (check-source-accepts "(defunion (Box T) (some v:T) none :repr tagged)
(defn main ():i32 (return 0))
")))

; ---------------------------------------------------------------------------
; `ref` / `raw` / `ptr` are reserved (Stage 16 §PK)
; ---------------------------------------------------------------------------

(deftest s16-pointer-kind-names-reserved
  (try (check-source-rejects "(defvar ref:i32 5)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defn ref ():i32 (return 5))
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defstruct ref x:i32)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defconst ref 5)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defvar raw:i32 5)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defn raw ():i32 (return 5))
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defstruct raw x:i32)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defconst raw 5)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defvar ptr:i32 5)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defn ptr ():i32 (return 5))
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defstruct ptr x:i32)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defconst ptr 5)
"
         "a symbol may name only one kind of thing"))
  ; The noun is per-name, not per-row: `ref`/`raw` are not types.
  (try (check-source-rejects "(defvar ref:i32 5)\n"
         "'ref' already names a pointer kind"))
  ; Unchanged: the kinds are still type syntax...
  (try (check-source-accepts "(defstruct Pt x:i32)
(defn f (a:ref:Pt b:raw:Pt c:ptr:Pt):i32 (return (a 'x)))
(defn g (v:(ref Pt) w:(raw Pt)):i32 (return (v 'x)))
"))
  ; ...and `ref` is still not a resolvable type NAME, so a bare one in a
  ; template argument is reported rather than collected as a tyvar.
  (try (check-source-rejects "(import-use node)
(import-use vector)
(defn h (v:(Vector ref)):i32 (return 0))
"
         "'ref' is a pointer kind, not a type argument")))

; ---------------------------------------------------------------------------
; Nil punning at condition position (Stage 16 §BT, bool-truthiness.md)
; ---------------------------------------------------------------------------

; All six sites, for each of the four nullable types. Each probe returns a
; bitmask so one number pins every site at once -- 1 cond, 2 not, 4 _and,
; 8 _or, 16 while.
;
; The IR half is not redundant: a wrong value that only reaches a truthiness
; test is invisible to every gate (conventions.md), so the two eliminations are
; also pinned at the instruction level -- a pointer test is `icmp ne ptr`, a
; value-Maybe test reads the tag word.
(deftest s16-truthiness-six-sites
  (let (src:StrView "(import-use \"stdio.h\")
(import-use arena)

(defstruct Pt x:i32)

(defn probe-raw (p:(raw Pt) q:(raw Pt)):i32
  (let (n:i32 0)
    (when p (set! n (+ n 1)))
    (when (not p) (set! n (+ n 2)))
    (when (and p q) (set! n (+ n 4)))
    (when (or p q) (set! n (+ n 8)))
    (let (c:(raw Pt) p)
      (while c (set! n (+ n 16)) (set! c null)))
    (return n)))

(defn probe-cstr (p:CStr q:CStr):i32
  (let (n:i32 0)
    (when p (set! n (+ n 1)))
    (when (not p) (set! n (+ n 2)))
    (when (and p q) (set! n (+ n 4)))
    (when (or p q) (set! n (+ n 8)))
    (let (c:CStr p)
      (while c (set! n (+ n 16)) (set! c null)))
    (return n)))

(defn probe-maybe-ptr (p:?ptr:Pt q:?ptr:Pt):i32
  (let (n:i32 0)
    (when p (set! n (+ n 1)))
    (when (not p) (set! n (+ n 2)))
    (when (and p q) (set! n (+ n 4)))
    (when (or p q) (set! n (+ n 8)))
    (let (c:?ptr:Pt p)
      (while c (set! n (+ n 16)) (set! c null)))
    (return n)))

(defn probe-maybe-val (p:(Maybe i64) q:(Maybe i64)):i32
  (let (n:i32 0)
    (when p (set! n (+ n 1)))
    (when (not p) (set! n (+ n 2)))
    (when (and p q) (set! n (+ n 4)))
    (when (or p q) (set! n (+ n 8)))
    (let (c:(Maybe i64) p)
      (while c (set! n (+ n 16)) (set! c (make (Maybe i64) none))))
    (return n)))

(defn main ():i32
  (let (a:(ref Pt) (new Pt)
        b:(ref Pt) (new Pt)
        s:CStr c\"x\"
        t:CStr c\"y\"
        nc:CStr (as CStr null)
        sm:(Maybe i64) (make (Maybe i64) some 5)
        nm:(Maybe i64) (make (Maybe i64) none))
    (printf \"raw %d %d %d %d\\n\"
      (probe-raw (as (raw Pt) a) (as (raw Pt) b))
      (probe-raw (as (raw Pt) a) null)
      (probe-raw null (as (raw Pt) b))
      (probe-raw null null))
    (printf \"cstr %d %d %d %d\\n\"
      (probe-cstr s t) (probe-cstr s nc) (probe-cstr nc t) (probe-cstr nc nc))
    (printf \"mptr %d %d %d %d\\n\"
      (probe-maybe-ptr (as-ref a) (as-ref b))
      (probe-maybe-ptr (as-ref a) null)
      (probe-maybe-ptr null (as-ref b))
      (probe-maybe-ptr null null))
    (printf \"mval %d %d %d %d\\n\"
      (probe-maybe-val sm sm) (probe-maybe-val sm nm)
      (probe-maybe-val nm sm) (probe-maybe-val nm nm)))
  (return 0))
")
    (let (out:String (try (build-run-source src)))
      (try (check-golden (string-as-view (addr-of out))
                         "raw 29 25 10 2
cstr 29 25 10 2
mptr 29 25 10 2
mval 29 25 10 2
"))
      (drop (addr-of out)))
    (let (ir:String (try (source-ir src))
          iv:StrView (string-as-view (addr-of ir)))
      (try (check-contains iv "icmp ne ptr"))
      (try (check-match iv "*extractvalue %Maybe.i64 %*, 0*"))
      (drop (addr-of ir)))))

; The narrowing half. `test-true-nonnull` matches node SHAPES, so the bare
; symbol needed its own arm -- without it the condition compiles and the BODY
; fails, i.e. the sugar would break exactly the case that motivates it.
(deftest s16-truthiness-narrows-bare-symbol
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use arena)

(defstruct Pt x:i32)

(defn f-when (m:?ptr:Pt):i32
  (when m (return (m 'x)))
  (return -1))

(defn f-and (m:?ptr:Pt):i32
  (when (and m (> (m 'x) 0)) (return (m 'x)))
  (return -1))

(defn f-guard (m:?ptr:Pt):i32
  (when (not m) (return -1))
  (return (m 'x)))

(defn f-while (m:?ptr:Pt):i32
  (let (n:i32 -1)
    (while m
      (set! n (m 'x))
      (return n))
    (return n)))

(defn main ():i32
  (let (a:(ref Pt) (new Pt))
    (set! (a 'x) 7)
    (printf \"%d %d %d %d %d %d %d %d\\n\"
      (f-when (as-ref a))  (f-when null)
      (f-and (as-ref a))   (f-and null)
      (f-guard (as-ref a)) (f-guard null)
      (f-while (as-ref a)) (f-while null)))
  (return 0))
")))
    (try (check-eq (string-as-view (addr-of out)) "7 -1 7 -1 7 -1 7 -1\n"))
    (drop (addr-of out))))

; The refusals that must STAY refusals. `(when n:i32 …)` is what keeps both
; zero-is-false and all-numbers-true revisable.
(deftest s16-truthiness-numbers-stay-refused
  (try (check-source-rejects
         "(defn main ():i32 (let (n:i32 3) (when n (return 1))) (return 0))\n"
         "cond: condition must be bool, not i32"))
  (try (check-source-rejects
         "(defn main ():i32 (let (n:i32 3) (while n (dec! n))) (return 0))\n"
         "while: condition must be bool, not i32"))
  (try (check-source-rejects
         "(defn main ():i32 (let (n:i32 3) (when (not n) (return 1))) (return 0))\n"
         "not: condition must be bool, not i32"))
  (try (check-source-rejects
         "(defn main ():i32 (let (n:i32 3) (when (and n (> n 0)) (return 1))) (return 0))\n"
         "and: condition must be bool, not i32"))
  (try (check-source-rejects
         "(defn main ():i32 (let (n:i32 3) (when (or n (> n 0)) (return 1))) (return 0))\n"
         "or: condition must be bool, not i32"))
  (try (check-source-rejects
         "(defn main ():i32 (let (f:f64 1.0) (when f (return 1))) (return 0))\n"
         "cond: condition must be bool, not f64")))

; The two types nil punning deliberately does not reach: a Result is neither
; true nor false, and a non-null pointer's test is a constant. Both name their
; own way out.
(deftest s16-truthiness-nonnull-and-result-refused
  (try (check-source-rejects "(defstruct Pt x:i32)
(defn f (p:(ref Pt)):i32 (when p (return 1)) (return 0))
(defn main ():i32 (return 0))
"
         "ptr:Pt is non-null, so this test is always true"))
  (try (check-source-rejects "(defn f (p:ptr):i32 (when p (return 1)) (return 0))
(defn main ():i32 (return 0))
"
         "ptr is non-null, so this test is always true"))
  (try (check-source-rejects "(defstruct Pt x:i32)
(deferror Boom \"boom\")
(defn g ():!ptr:Pt (return (err Boom)))
(defn f ():i32 (let (r:!ptr:Pt (g)) (when r (return 1))) (return 0))
(defn main ():i32 (return 0))
"
         "a Result (!T) is neither true nor false")))

; It is an ELIMINATION RULE, NOT A COERCION: `coerce-int-val` is untouched, so
; `bool` did not become a universal sink. If any of these ever compiles,
; truthiness has leaked into the coercion set and overload resolution is next.
(deftest s16-truthiness-is-not-a-coercion
  (try (check-source-rejects "(defstruct Pt x:i32)
(defn f (b:bool):i32 (return 0))
(defn g (p:(raw Pt)):i32 (return (f p)))
(defn main ():i32 (return 0))
"
         "f: argument 1 has type ptr:Pt, which does not match parameter type bool"))
  (try (check-source-rejects "(defstruct Pt x:i32)
(defn g (p:(raw Pt)):i32 (let (b:bool p) (return 0)))
(defn main ():i32 (return 0))
"
         "let: init type mismatch for 'b'"))
  (try (check-source-rejects "(defstruct Pt x:i32)
(defstruct S flag:bool)
(defn g (p:(raw Pt)):i32 (let (s:(ref S) (alloca S)) (set! (s 'flag) p)) (return 0))
(defn main ():i32 (return 0))
"
         "set!: type mismatch for field 'flag': value is ptr:Pt, field is bool")))

; ---------------------------------------------------------------------------
; Variables as collection-literal elements (Stage 16, collection-literal-variables.md)
; ---------------------------------------------------------------------------

(defn litvar-pre ():StrView
  (return "(import-use \"stdio.h\")
(import-use vector)
(import-use hashset)
(import-use hashmap)
"))

(defn check-litvar-rejects (body:StrView needle:StrView):!void
  (let (src:String (str (litvar-pre) body "\n")
        v:StrView (string-as-view (addr-of src)))
    (try (check-source-rejects v needle))
    (drop (addr-of src))
    (return (ok))))

; Enum members, a defconst, a local, and a call, in all three literal kinds.
; Every one of these was a hard error before this item.
(deftest s16-litvar-accepted
  (let (src:String (str (litvar-pre) "(defenum BK BK-GLOBAL BK-PROTOCOL BK-GENERIC BK-MACRO)
(defconst LIMIT 40)
(defn twice (x:i32):i32 (return (* 2 x)))
(defn main ():i32
  (let (kind:i32 BK-MACRO other:i32 7)
    (with ((s (ref (HashSet i32))) #{BK-GLOBAL BK-PROTOCOL other (twice 9)})
      (printf \"set=%d %d %d %d\\n\" (unsafe/cast i32 (count s))
        (unsafe/cast i32 (contains? s BK-GLOBAL)) (unsafe/cast i32 (contains? s 18))
        (unsafe/cast i32 (contains? s kind))))
    (with ((v (ref (Vector i32))) [LIMIT other])
      (printf \"vec=%d %d\\n\" (invoke v 0) (invoke v 1)))
    (with ((m (ref (HashMap i32 i32))) {BK-GLOBAL other BK-MACRO LIMIT})
      (printf \"map=%d\\n\" (unsafe/cast i32 (count m)))))
  (return 0))
")
        out:String (try (build-run-source (string-as-view (addr-of src)))))
    (try (check-golden (string-as-view (addr-of out)) "set=4 1 1 0
vec=40 7
map=2
"))
    (drop (addr-of out))
    (drop (addr-of src))))

(defn litvar-target-src ():String
  (return (str (litvar-pre) "(defn main ():i32
  (with ((v (ref (Vector i64))) [1 2 3])
    (printf \"want=%lld %d\\n\" (invoke v 0) (unsafe/cast i32 (count v))))
  (return 0))
")))

; Target-first, and the soundness regression it closes: before this item
; `(ref (Vector i64))` bound to a literal-built (Vector i32) with no error, and
; `(invoke v 0)` read two i32 elements back as one i64 -- 8589934593.
(deftest s16-litvar-target-wins
  (let (src:String (litvar-target-src)
        out:String (try (build-run-source (string-as-view (addr-of src)))))
    (try (check-eq (string-as-view (addr-of out)) "want=1 3\n"))
    (drop (addr-of out))
    (drop (addr-of src))))

; …and it must stamp only the wanted instance, not build i32 and reinterpret.
(deftest s16-litvar-target-stamps-once
  (let (src:String (litvar-target-src)
        ir:String (try (source-ir (string-as-view (addr-of src)))))
    (try (check-not-contains (string-as-view (addr-of ir)) "Vector.i32"))
    (drop (addr-of ir))
    (drop (addr-of src))))

; A numeric literal ADAPTS to a value element, exactly as `(conj v 1)` on a
; (Vector i64) already does; a value is never narrowed to suit a literal.
(deftest s16-litvar-literal-adapts
  (let (src:String (str (litvar-pre) "(defn main ():i32
  (let (n:i64 5000000000)
    (with ((v (ref (Vector i64))) [n 1 2])
      (printf \"adapt=%lld %lld\\n\" (invoke v 0) (invoke v 1))))
  (return 0))
")
        out:String (try (build-run-source (string-as-view (addr-of src)))))
    (try (check-eq (string-as-view (addr-of out)) "adapt=5000000000 1\n"))
    (drop (addr-of out))
    (drop (addr-of src))))

; Elements evaluate left to right, which only became observable once an element
; could be a call.
(deftest s16-litvar-eval-order
  (let (src:String (str (litvar-pre) "(defvar seq:i32 0)
(defn tick (tag:i32):i32 (printf \"%d\" tag) (set! seq (+ seq 1)) (return tag))
(defn main ():i32
  (with ((v (ref (Vector i32))) [(tick 1) (tick 2) (tick 3)])
    (printf \"|%d\\n\" (unsafe/cast i32 (count v))))
  (return 0))
")
        out:String (try (build-run-source (string-as-view (addr-of src)))))
    (try (check-eq (string-as-view (addr-of out)) "123|3\n"))
    (drop (addr-of out))
    (drop (addr-of src))))

; An empty literal is legal exactly when a target supplies the element type.
(deftest s16-litvar-empty-with-target
  (let (src:String (str (litvar-pre) "(defn main ():i32
  (with ((v (ref (Vector i32))) [])
    (printf \"empty=%d\\n\" (unsafe/cast i32 (count v))))
  (return 0))
")
        out:String (try (build-run-source (string-as-view (addr-of src)))))
    (try (check-eq (string-as-view (addr-of out)) "empty=0\n"))
    (drop (addr-of out))
    (drop (addr-of src))))

; The refusals. Each names the literal and, where two types clash, both of them.
(deftest s16-litvar-refused-mixed-values
  (try (check-litvar-rejects
         "(defn main ():i32 (let (a:i32 1 b:i64 2) (let (v [a b]) (return 0))))"
         "vector literal: mixed element types -- 'i32' and 'i64'")))
(deftest s16-litvar-refused-int-float
  (try (check-litvar-rejects
         "(defn main ():i32 (let (v [1 2.5]) (return 0)))"
         "vector literal: mixed element types")))
(deftest s16-litvar-refused-int-string
  (try (check-litvar-rejects
         "(defn main ():i32 (let (v [\"a\" 1]) (return 0)))"
         "vector literal: mixed element types")))
(deftest s16-litvar-refused-empty-no-target
  (try (check-litvar-rejects
         "(defn main ():i32 (let (v []) (return 0)))"
         "empty vector literal: use (vector-new)")))
(deftest s16-litvar-refused-narrow-value
  (try (check-litvar-rejects
         "(defn main ():i32 (let (n:i64 5) (with ((v (ref (Vector i32))) [n 1]) (return 0))))"
         "no matching method for overloaded 'conj'")))
(deftest s16-litvar-refused-unspellable
  (try (check-litvar-rejects
         "(defstruct P x:i32) (defn main ():i32 (let (p:(ref P) (alloca P)) (let (v [p p]) (return 0))))"
         "cannot infer an element type from a value of type 'ptr:P'")))
(deftest s16-litvar-refused-shadow-head
  (try (check-litvar-rejects
         "(defn vector-lit (x:i32):i32 (return x)) (defn main ():i32 (return 0))"
         "already names a special form")))

; ---------------------------------------------------------------------------
; C's default argument promotions at a variadic call (varargs-promotion.md)
; ---------------------------------------------------------------------------

(defn vararg-run-src ():StrView
  (return "(import-use \"stdio.h\")
(defn main ():i32
  (let (a:i8 65 b:i16 -300 c:ui8 200 d:f32 2.5 e:bool true f:Char \\A)
    (printf \"%d %d %u %f %d %d\\n\" a b c d e f))
  (return 0))
"))

; The run: every promoted type, against the answers C gives for the identical
; program. i16 printed 1321270996 and f32 printed 0.000000.
(deftest s16-vararg-promotion-run
  (let (out:String (try (build-run-source (vararg-run-src))))
    (try (check-eq (string-as-view (addr-of out)) "65 -300 200 2.500000 1 65\n"))
    (drop (addr-of out))))

; The instruction. `bool`/`i8`/`ui8` print correctly under BOTH behaviours, so
; the run above cannot distinguish them -- only the IR can.
(deftest s16-vararg-promotion-ir
  (let (ir:String (try (source-ir (vararg-run-src)))
        iv:StrView (string-as-view (addr-of ir))
        l:StrView (try (line-with iv "call i32 (ptr, ...) @printf")))
    (try (check-match l "*i32 %*, i32 %*, i32 %*, double %*, i32 %*, i32 %*"))
    (try (check-not-contains l "i1 %"))
    (try (check-not-contains l "i8 %"))
    (try (check-not-contains l "i16 %"))
    (try (check-not-contains l "float %"))
    (drop (addr-of ir))))

; Only the `...` tail promotes. A variadic callee's FIXED narrow parameter keeps
; its declared type -- the promotion is a property of the position, not of the
; type, so a rule applied one argument too early would widen it.
(deftest s16-vararg-promotion-fixed-param-untouched
  (let (h:String (try (test-write-file "fix.h" "int narrowfix(signed char tag, ...);\n"))
        src:String (str "(import-use \"" (string-as-view (addr-of h)) "\")
(defn go (a:i8 b:i8 c:f32):i32 (return (narrowfix a b c)))
")
        ir:String (try (source-ir (string-as-view (addr-of src)))))
    (try (check-match (string-as-view (addr-of ir))
                      "*@narrowfix(i8 %*, i32 %*, double %*"))
    (drop (addr-of ir))
    (drop (addr-of src))
    (drop (addr-of h))))

; Nothing already `int`-wide or wider is touched -- a spurious promotion would
; be as wrong as a missing one, and costs an instruction per call.
(deftest s16-vararg-promotion-no-spurious-widening
  (let (ir:String (try (source-ir "(import-use \"stdio.h\")
(defn main ():i32
  (let (a:i32 1 b:i64 2 c:f64 3.5 d:ui32 4)
    (printf \"%d %ld %f %u\\n\" a b c d))
  (return 0))
"))
        iv:StrView (string-as-view (addr-of ir))
        l:StrView (try (line-with iv "call i32 (ptr, ...) @printf")))
    (try (check-match l "*i32 %*, i64 %*, double %*, i32 %*"))
    (drop (addr-of ir))))

; ---------------------------------------------------------------------------
; Colon chains that overshoot a template's arity (container-type-sugar.md §1.2)
; ---------------------------------------------------------------------------

; The refusal must be LOCATED, which is the whole point of the item: the
; surplus symbols used to be collected as tyvars, so a concrete defn was
; reclassified as an uninstantiable template, `emit-defn` skipped its define,
; and nothing at all was reported.
(defn check-chain-refused (body:StrView needle:StrView):!void
  (let (src:String (str "(import-use vector)
(import-use hashmap)
(import-use node)
" body "\n(defn main ():i32 (return 0))\n")
        p:String (try (test-write-file "t.nuc" (string-as-view (addr-of src))))
        pv:StrView (string-as-view (addr-of p))
        c:Compiled (try (compile-path pv)))
    (try (check-error-at (addr-of c 'diags) pv 4 needle))
    (drop (addr-of c))
    (drop (addr-of p))
    (drop (addr-of src))
    (return (ok))))

; The three silent rows of §1.2, each naming the template. Bare `ref` is the
; trigger: `ptr` and `raw` are tyname-resolvable, so they overshoot into the
; arity check below instead.
(deftest s16-chain-nested-ref-refused
  (try (check-chain-refused "(defn f (x:ref:Vector:ref:Node):i32 (return 21))"
                            "Vector: 'ref' is a pointer kind"))
  (try (check-chain-refused "(defn f (x:ref:HashMap:CStr:ref:Vector:i32):i32 (return 21))"
                            "HashMap: 'ref' is a pointer kind"))
  (try (check-chain-refused "(defn f (x:ref:HashMap:ref:Vector:i32:i32):i32 (return 21))"
                            "HashMap: 'ref' is a pointer kind")))

; The general net behind that one case: any over-long argument list in a type
; pattern is an arity error.
(deftest s16-chain-arity-refused
  (try (check-chain-refused "(defn f (x:ref:Vector:ptr:i8):i32 (return 21))"
         "Vector: wrong number of type arguments for defstruct template (2 given)"))
  (try (check-chain-refused "(defn f (x:ref:(Vector i32 CStr)):i32 (return 21))"
         "Vector: wrong number of type arguments for defstruct template (2 given)")))

; The guards must not cost the spellings docs/types.md advertises, and a genuine
; tyvar must still be a tyvar. Asserted as a `define` per function, because a
; missing define IS the §1.2 bug.
(deftest s16-chain-working-spellings
  (let (src:StrView "(import-use \"stdio.h\")
(import-use vector)
(import-use hashmap)
(import-use node)
(import-use coll)
(defn ca (x:ref:HashMap:CStr:i32):i32 (return 1))
(defn cb (x:ref:Vector:i32):i32 (return 2))
(defn cc (x:ref:(Vector (ref Node))):i32 (return 3))
(defn cd (x:ref:(HashMap CStr i32)):i32 (return 4))
(defn ce (x:ref:Vector:ptr):i32 (return 5))
(defn tyv (v:(ref (Vector T))):i64 (return (as i64 (count v))))
(defn main ():i32
  (with (v:(ref (Vector i32)) (alloca (Vector i32)))
    (vector-init v)
    (conj v 9)
    (printf \"%d %ld\\n\" (cb v) (tyv v)))
  (return 0))
")
    (let (ir:String (try (source-ir src))
          iv:StrView (string-as-view (addr-of ir)))
      (try (check-match iv "define i32 @ca(*"))
      (try (check-match iv "define i32 @cb(*"))
      (try (check-match iv "define i32 @cc(*"))
      (try (check-match iv "define i32 @cd(*"))
      (try (check-match iv "define i32 @ce(*"))
      (drop (addr-of ir)))
    (let (out:String (try (build-run-source src)))
      (try (check-eq (string-as-view (addr-of out)) "2 1\n"))
      (drop (addr-of out)))))

; The fuse and the list form are two spellings of one type, not two types:
; asserted as IR equality rather than as a claim (the §3.11 convention). Both
; compile from the same path, so even the module header lines must agree.
(deftest s16-chain-fuse-transparent-ir
  (let (a:String (try (source-ir "(import-use hashmap)
(import-use coll)
(defn t (m:ref:(HashMap CStr i32)):i64 (return (as i64 (count m))))
"))
        b:String (try (source-ir "(import-use hashmap)
(import-use coll)
(defn t (m:(ref (HashMap CStr i32))):i64 (return (as i64 (count m))))
")))
    (try (check-golden (string-as-view (addr-of a)) (string-as-view (addr-of b))))
    (drop (addr-of a))
    (drop (addr-of b))))

; ---------------------------------------------------------------------------
; Type aliases (container-type-sugar.md §3)
; ---------------------------------------------------------------------------

; An alias works in every declaration position, and composes with the colon
; sugar (§3.9 -- a single-token type name needs no fuse at all).
(deftest s16-deftype-every-position
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use hashset)
(import-use coll)
(deftype NameSet (ref (HashSet CStr)))
(deftype Count i64)
(defstruct Reg names:NameSet)
(defvar gv:Count 7)
(defn size (s:NameSet):Count (return (as Count (count s))))
(defn main ():i32
  (with (s:NameSet (alloca (HashSet CStr)))
    (hashset-init s)
    (conj s (as CStr \"a\"))
    (conj s (as CStr \"b\"))
    (let (t:NameSet s)
      (printf \"%ld %ld\\n\" (size t) gv)))
  (return 0))
")))
    (try (check-eq (string-as-view (addr-of out)) "2 7\n"))
    (drop (addr-of out))))

; Transparency (§3.2) is the load-bearing claim: an alias is a second SPELLING,
; not a second type, so the IR must be identical to the spelled-out program.
; This is also what keeps the bootstrap byte-identical until a source file
; adopts one.
(deftest s16-deftype-transparent-ir
  (let (a:String (try (source-ir "(import-use hashmap)
(import-use coll)
(deftype SymTab (ref (HashMap CStr i32)))
(defn tally (m:SymTab):i64 (return (as i64 (count m))))
"))
        b:String (try (source-ir "(import-use hashmap)
(import-use coll)
(defn tally (m:(ref (HashMap CStr i32))):i64 (return (as i64 (count m))))
")))
    (try (check-golden (string-as-view (addr-of a)) (string-as-view (addr-of b))))
    (drop (addr-of a))
    (drop (addr-of b))))

; Composition (§3.3): the ?/! sigils, pointer-kind chains, template arguments,
; alias-of-alias, and a forward reference all route through the two resolution
; sites without their own code.
(deftest s16-deftype-composes
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use vector)
(defstruct Pt x:i32 y:i32)
(deftype P Pt)
(deftype PRef (ref P))
(deftype Later i32)
(defn viaq (v:?PRef):i32 (if-some (p v) (return (p 'x)) (return -1)))
(defn chain (v:ref:P):i32 (return (v 'y)))
(defn intmpl (v:(ref (Vector Later))):i32 (return 0))
(defn fwd (n:Later):i32 (return n))
(defn main ():i32
  (with (p:PRef (alloca Pt))
    (set! (p 'x) 3) (set! (p 'y) 4)
    (printf \"%d %d %d\\n\" (viaq p) (chain p) (fwd 5)))
  (return 0))
")))
    (try (check-eq (string-as-view (addr-of out)) "3 4 5\n"))
    (drop (addr-of out))))

; A colliding alias would be DEAD, not merely ambiguous -- `parse-type-name`
; probes aliases last -- so every collision is refused rather than silently
; ignored (§3.4). Both orders, since the check runs on the prescan pass and
; again on the emit pass.
(deftest s16-deftype-collisions-refused
  (try (check-source-rejects "(defstruct Pt x:i32)
(deftype Pt i32)
" "already names a type"))
  (try (check-source-rejects "(import-use vector)
(deftype Vector i32)
" "already names a struct template"))
  (try (check-source-rejects "(defenum E A B)
(deftype E i32)
" "already names an enumeration"))
  (try (check-source-rejects "(deftype i32 i64)\n" "already names a built-in type"))
  (try (check-source-rejects "(deftype Q i32)
(defstruct Q a:i32)
" "already names a type"))
  (try (check-source-rejects "(defn Q ():i32 (return 0))
(deftype Q i32)
" "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(deftype Q i32)
(deftype Q i64)
" "redefinition of 'Q'")))

; Malformed forms, and the §3.6 cycle guard (a recursive body would not
; otherwise terminate).
(deftest s16-deftype-malformed-refused
  (try (check-source-rejects "(deftype Q)\n" "deftype: expects a name and one type"))
  (try (check-source-rejects "(deftype Q i32 i64)\n" "deftype: expects a name and one type"))
  (try (check-source-rejects "(deftype Q:i32 i64)\n" "deftype: takes no type annotation"))
  (try (check-source-rejects "(deftype () i32)\n" "deftype: alias name must be a symbol"))
  (try (check-source-rejects "(deftype (Tbl) i32)\n" "deftype: parameter list required"))
  (try (check-source-rejects "(deftype (Tbl 3) i32)\n"
                             "deftype: each type parameter must be a symbol"))
  (try (check-source-rejects "(deftype A B)
(deftype B A)
(defn f (x:A):i32 (return 0))
" "expands into a cycle")))

; `.nuch` round-trip. The header must CARRY the alias -- an exported defn may
; name it in its signature, and the importer resolves that spelling in its own
; unit. (This is the one part of the design that needed code: the export and
; import dispatches are both explicit form lists.)
(deftest s16-deftype-nuch-roundtrip
  (let (dir:StrView (try (test-scratch))
        lib:String (try (test-write-file "alib.nuc" "(deftype Count i64)
(defn twice (n:Count):Count (return (* n 2)))
"))
        nuch:String (try (emit-for-file "" "--emit-nuch" (string-as-view (addr-of lib))))
        hp:String (try (test-write-file "alib.nuch" (string-as-view (addr-of nuch))))
        use:String (try (test-write-file "use.nuc" "(import-use \"stdio.h\")
(import-use alib)
(defn main ():i32 (printf \"%ld\\n\" (twice 21)) (return 0))
"))
        out:String (try (build-run-file dir "" (string-as-view (addr-of use)))))
    (try (check-contains (string-as-view (addr-of nuch)) "(deftype Count i64)"))
    (try (check-eq (string-as-view (addr-of out)) "42\n"))
    (drop (addr-of out))
    (drop (addr-of use))
    (drop (addr-of hp))
    (drop (addr-of nuch))
    (drop (addr-of lib))))

; Privacy here is NAMESPACE-level, as it is for the other four private type
; definers, so the check needs a namespaced library and a consumer outside it --
; spelling the name through the prefix, so a refusal measures privacy and not
; just scope. Plus the positive control that `deftype` still exports.
(deftest s16-deftype-private-namespaced
  (let (dir:StrView (try (test-scratch))
        lib:String (try (test-write-file "tplib.nuc" "(ns t16p)
(deftype- T16Hidden i64)
(deftype T16Public i64)
(defn- t16-inside (n:T16Hidden):T16Hidden (return (* n 3)))
(defn t16-pub (n:T16Public):T16Public (return (t16-inside n)))
"))
        nuch:String (try (emit-for-file dir "--emit-nuch" (string-as-view (addr-of lib))))
        hp:String (try (test-write-file "tplib.nuch" (string-as-view (addr-of nuch))))
        outp:String (try (test-write-file "tp-out.nuc" "(import-prefixed tplib tp)
(defn t16-take (n:tp/T16Hidden):i64 (return n))
(defn main ():i32 (return 0))
"))
        pubp:String (try (test-write-file "tp-pub.nuc" "(import-prefixed tplib tp)
(defn t16-take (n:tp/T16Public):i64 (return n))
(defn main ():i32 (return 0))
"))
        bad:Compiled (try (compile-path-in dir (string-as-view (addr-of outp))))
        good:Compiled (try (compile-path-in dir (string-as-view (addr-of pubp)))))
    (try (check-contains (string-as-view (addr-of bad 'raw)) "T16Hidden"))
    (try (check-empty (string-as-view (addr-of good 'raw))))
    (try (check-not-contains (string-as-view (addr-of nuch)) "T16Hidden"))
    (try (check-contains (string-as-view (addr-of nuch)) "T16Public"))
    (drop (addr-of good))
    (drop (addr-of bad))
    (drop (addr-of pubp))
    (drop (addr-of outp))
    (drop (addr-of hp))
    (drop (addr-of nuch))
    (drop (addr-of lib))))

; The C header must show the alias's BODY. It has no C spelling of its own, and
; `type-node-to-c` resolved names by spelling -- so the alias name leaked out as
; `struct Count`, naming nothing the header defines. Asserted against the
; spelled-out program, which is the only definition of "right" here.
(deftest s16-deftype-cheader-expands
  (let (a:String (try (source-cheader "(defstruct Pt x:i32 y:i32)
(deftype Count i64)
(deftype PtRef (ref Pt))
(defn twice (n:Count):Count (return (* n 2)))
(defn getx (p:PtRef):i32 (return (p 'x)))
"))
        b:String (try (source-cheader "(defstruct Pt x:i32 y:i32)
(defn twice (n:i64):i64 (return (* n 2)))
(defn getx (p:(ref Pt)):i32 (return (p 'x)))
")))
    (try (check-golden (string-as-view (addr-of a)) (string-as-view (addr-of b))))
    (drop (addr-of a))
    (drop (addr-of b))))

; The REPL has its own top-level form chain; without an arm there `deftype` was
; `unknown: deftype` and every later use of the name failed too.
(deftest s16-deftype-repl
  (let (out:String (try (repl-session "(deftype C i64)
(defn d (n:C):C (return (* n 2)))
(d 21)
")))
    (try (check-contains (string-as-view (addr-of out)) "42"))
    (drop (addr-of out))))

; ---------------------------------------------------------------------------
; Parametric type aliases (container-type-sugar.md §3.7)
; ---------------------------------------------------------------------------

; Every declaration position, plus a colon-spelled body (`(Ref T) ref:T`), which
; substitutes segment-wise rather than by node.
(deftest s16-deftype-parametric-every-position
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use vector)
(import-use hashmap)
(import-use coll)
(deftype (Vec T) (ref (Vector T)))
(deftype (Table V) (ref (HashMap CStr V)))
(deftype (Ref T) ref:T)
(defstruct Pt x:i32 y:i32)
(defstruct Reg items:(Vec i32) names:(Table i32))
(defn total (v:(Vec i32)):i64 (return (as i64 (count v))))
(defn look (m:(Table i32)):i64 (return (as i64 (count m))))
(defn getx (p:(Ref Pt)):i32 (return (p 'x)))
(defn main ():i32
  (with (v:(Vec i32) (alloca (Vector i32))
         m:(Table i32) (alloca (HashMap CStr i32))
         p:(Ref Pt) (alloca Pt))
    (vector-init v) (hashmap-init m)
    (conj v 4) (conj v 5)
    (assoc m \"a\" 1)
    (set! (p 'x) 9)
    (printf \"%ld %ld %d\\n\" (total v) (look m) (getx p)))
  (return 0))
")))
    (try (check-eq (string-as-view (addr-of out)) "2 1 9\n"))
    (drop (addr-of out))))

; §3.7's stated hard case: a generic template whose RECEIVER is an alias
; application, instantiated at two element types. This is the one that needed
; `collect-pattern-tyvars` and `unify-tpat` taught about aliases.
(deftest s16-deftype-parametric-receiver
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use vector)
(import-use coll)
(deftype (Vec T) (ref (Vector T)))
(defn second (v:(Vec T)):T (return (invoke v (as usize 1))))
(defn main ():i32
  (with (a:(Vec i32) (alloca (Vector i32))
         b:(Vec CStr) (alloca (Vector CStr)))
    (vector-init a) (vector-init b)
    (conj a 10) (conj a 20)
    (conj b \"x\") (conj b \"y\")
    (printf \"%d %s\\n\" (second a) (second b)))
  (return 0))
")))
    (try (check-eq (string-as-view (addr-of out)) "20 y\n"))
    (drop (addr-of out))))

; Transparency, including the generic `t3`, whose stamped instance must mangle
; from the expansion and not from the alias name.
(deftest s16-deftype-parametric-transparent-ir
  (let (a:String (try (source-ir "(import-use vector)
(import-use hashmap)
(import-use coll)
(deftype (Vec T) (ref (Vector T)))
(deftype (Table V) (ref (HashMap CStr V)))
(defn t1 (v:(Vec i32)):i64 (return (as i64 (count v))))
(defn t2 (m:(Table i32)):i64 (return (as i64 (count m))))
(defn t3 (v:(Vec T)):i64 (return (as i64 (count v))))
(defn use ():i64 (return (t3 (unsafe/cast (ref (Vector CStr)) null))))
"))
        b:String (try (source-ir "(import-use vector)
(import-use hashmap)
(import-use coll)
(defn t1 (v:(ref (Vector i32))):i64 (return (as i64 (count v))))
(defn t2 (m:(ref (HashMap CStr i32))):i64 (return (as i64 (count m))))
(defn t3 (v:(ref (Vector T))):i64 (return (as i64 (count v))))
(defn use ():i64 (return (t3 (unsafe/cast (ref (Vector CStr)) null))))
")))
    (try (check-golden (string-as-view (addr-of a)) (string-as-view (addr-of b))))
    (drop (addr-of a))
    (drop (addr-of b))))

; Arity in both directions, a bare application, and the colon-body limit. A
; cycle must be caught on the PATTERN path too: the depth guard in
; `parse-type-from-node` does not cover `collect-pattern-tyvars`, which reaches
; a defn parameter first and looped forever until it got its own.
(deftest s16-deftype-parametric-refusals
  (try (check-source-rejects "(import-use vector)
(deftype (Vec T) (ref (Vector T)))
(defn f (v:(Vec i32 CStr)):i32 (return 0))
" "Vec: wrong number of type arguments for type alias (2 given)"))
  (try (check-source-rejects "(import-use hashmap)
(deftype (Table K V) (ref (HashMap K V)))
(defn f (m:(Table CStr)):i32 (return 0))
" "Table: wrong number of type arguments for type alias (1 given)"))
  (try (check-source-rejects "(import-use vector)
(deftype (Vec T) (ref (Vector T)))
(defn f (v:Vec):i32 (return 0))
" "type alias 'Vec' takes 1 type arguments"))
  (try (check-source-rejects "(import-use node)
(deftype (Ref T) ref:T)
(defn f (v:(Ref (ref Node))):i32 (return 0))
" "must be a single token"))
  (try (check-source-rejects "(deftype (A T) (A T))
(defn f (v:(A i32)):i32 (return 0))
" "expands into a cycle"))
  (try (check-source-rejects "(deftype (A T) (B T))
(deftype (B T) (A T))
(defn f (v:(A i32)):i32 (return 0))
" "expands into a cycle")))

; A parametric alias crosses a `.nuch` and a real object-file link: the header
; must carry the `deftype` itself, since the `declare` beside it spells its
; parameters in terms of the alias.
(deftest s16-deftype-parametric-nuch-roundtrip
  (let (lib:String (try (test-write-file "plib.nuc" "(import-use vector)
(import-use coll)
(deftype (Vec T) (ref (Vector T)))
(defn plen (v:(Vec i32)):i64 (return (as i64 (count v))))
"))
        libv:StrView (string-as-view (addr-of lib))
        nuch:String (try (emit-for-file "" "--emit-nuch" libv))
        hp:String (try (test-write-file "plib.nuch" (string-as-view (addr-of nuch))))
        dir:StrView (try (test-scratch))
        obj:String (str dir "/plib.o")
        usesrc:String (str "(import-use \"stdio.h\")
(import-use vector)
(import-use coll)
(import-use \"" (string-as-view (addr-of hp)) "\")
(defn main ():i32
  (with (v:(ref (Vector i32)) (alloca (Vector i32)))
    (vector-init v) (conj v 1) (conj v 2) (conj v 3)
    (printf \"%ld\\n\" (plen v)))
  (return 0))
")
        use:String (try (test-write-file "use.nuc" (string-as-view (addr-of usesrc)))))
    (try (check-contains (string-as-view (addr-of nuch))
                         "(deftype (Vec T) (ref (Vector T)))"))
    (try (compile-object libv (string-as-view (addr-of obj))))
    (let (linkarg:String (str "--link-arg=" (string-as-view (addr-of obj)))
          out:String (try (build-run-file "" (string-as-view (addr-of linkarg))
                                          (string-as-view (addr-of use)))))
      (try (check-eq (string-as-view (addr-of out)) "3\n"))
      (drop (addr-of out))
      (drop (addr-of linkarg)))
    (drop (addr-of use))
    (drop (addr-of obj))
    (drop (addr-of hp))
    (drop (addr-of nuch))
    (drop (addr-of lib))))

; The C header has no spelling for an alias, parametric or not, so it must show
; the expansion.
(deftest s16-deftype-parametric-cheader-expands
  (let (a:String (try (source-cheader "(import-use vector)
(import-use coll)
(deftype (Vec T) (ref (Vector T)))
(defn plen (v:(Vec i32)):i64 (return (as i64 (count v))))
"))
        b:String (try (source-cheader "(import-use vector)
(import-use coll)
(defn plen (v:(ref (Vector i32))):i64 (return (as i64 (count v))))
")))
    (try (check-golden (string-as-view (addr-of a)) (string-as-view (addr-of b))))
    (drop (addr-of a))
    (drop (addr-of b))))

(deftest s16-deftype-parametric-repl
  (let (out:String (try (repl-session "(deftype (Pair T) (ptr T))
(defn takes (p:(Pair i32)):i32 (return (aref p 0)))
(let (a:ptr:i32 (array i32 41 42)) (takes a))
")))
    (try (check-contains (string-as-view (addr-of out)) "41"))
    (drop (addr-of out))))

; ---------------------------------------------------------------------------
; Types stamped inside a `compile-time` body (Stage 16 D9, repl-libraries.md §3.3)
; ---------------------------------------------------------------------------

(defn d9-ct-stamp-src ():StrView
  (return "(import-use \"stdio.h\")
(compile-time
  (defn d9-ct-maybe (n:i32):?i32 (some n))
  (match (d9-ct-maybe 7)
    ((some v) (printf \"d9 ct some %d\\n\" v))
    (none (printf \"d9 ct none\\n\"))))
(defn main ():i32 (return 0))
"))

; A `?i32` whose `%Maybe.i32` is stamped INSIDE the compile-time body. Pre-D9:
; `IR parse error: Cannot allocate unsized type %Maybe.i32`. A batch failure,
; not a REPL one -- the design note framed it as REPL-only.
(deftest s16-d9-ct-body-stamp
  (let (c:Compiled (try (compile-source (d9-ct-stamp-src)))
        raw:StrView (string-as-view (addr-of c 'raw)))
    (try (check-contains raw "d9 ct some 7"))
    (try (check-not-contains raw "IR parse error"))
    (drop (addr-of c))))

; The drain that fixes the above writes into the PROGRAM's type buffer, and the
; final drain runs over the same queue -- so the line must arrive exactly once.
; A count, not a presence test: a double emit is what a re-drain gets wrong.
(deftest s16-d9-ct-type-once
  (let (ir:String (try (source-ir (d9-ct-stamp-src))))
    (try (check-eq-int (count-lines-with-prefix (string-as-view (addr-of ir))
                                                "%Maybe.i32 = type")
                       1 "%Maybe.i32 definitions"))
    (drop (addr-of ir))))

; `emit-defstruct` queues every StructDef it writes, so the shared drain sees
; types whose line is already in the buffer. `sdef-in-module` is what keeps that
; inert; assert it over a program with several structs.
(deftest s16-d9-no-duplicate-type-lines
  (let (c:Compiled (try (compile-path "examples/struct.nuc"))
        ir:StrView (string-as-view (addr-of c 'ir))
        dup:StrView (duplicate-type-name ir))
    (try (check-non-empty ir))
    (when (not (= dup "")) (fail! "type defined twice: " dup))
    (drop (addr-of c))))

; The ruling: a `defstruct` inside a `compile-time` body defines a PROGRAM type,
; so its line goes to the module's own type buffer rather than the CT module's.
; Pre-D9 this exited 0 from `--emit-llvm` with three `%D9P` references and no
; `%D9P = type` line, and died only at `-o`. Three assertions, because each
; catches a different way to get it wrong: the count is 1 (0 = the old bug,
; 2 = written to both buffers), the binary links, and it computes.
(deftest s16-d9-ct-defstruct-is-program-type
  (let (src:StrView "(import-use \"stdio.h\")
(compile-time (defstruct D9P x:i32 y:i32))
(defn d9-sum (a:i32 b:i32):i32
  (let (q:ptr:D9P (as ptr:D9P (alloca D9P)))
    (set! (q 'x) a) (set! (q 'y) b) (return (+ (q 'x) (q 'y)))))
(defn main ():i32 (printf \"%d\\n\" (d9-sum 3 4)) (return 0))
")
    (let (c:Compiled (try (compile-source src)))
      (try (check-not-contains (string-as-view (addr-of c 'raw)) "IR parse error"))
      (try (check-eq-int (count-lines-with-prefix (string-as-view (addr-of c 'ir))
                                                  "%D9P = type")
                         1 "%D9P definitions"))
      (drop (addr-of c)))
    (let (out:String (try (build-run-source src)))
      (try (check-eq (string-as-view (addr-of out)) "7\n"))
      (drop (addr-of out)))))

; D9 residue: the same type named in a SIGNATURE. This failed EARLIER -- before
; any emission -- because `prescan-struct-names` was a flat walk over the
; top-level form list and never descended into a `compile-time` body. The
; by-value `defn` is placed BEFORE the block deliberately: it needs the LAYOUT,
; not just the name, and an unlaid-out struct is sized 0 rather than diagnosed
; (`define i32 @f(i0 %p.arg)`) -- so the assertion is on the lowered parameter
; type as well as on the value.
(deftest s16-d9-ct-type-in-signature
  (let (src:StrView "(import-use \"stdio.h\")
(defn d9-byval (p:D9V):i32 (return (+ (p 'x) (p 'y))))
(compile-time (defstruct D9V x:i32 y:i32))
(defn d9-byref (p:(ref D9V)):i32 (return (* (p 'x) (p 'y))))
(defn main ():i32
  (let (q:D9V (D9V 3 4))
    (printf \"%d %d\\n\" (d9-byval q) (d9-byref (as ref:D9V (addr-of q)))))
  (return 0))
")
    (let (ir:String (try (source-ir src)))
      (try (check-match (string-as-view (addr-of ir)) "define i32 @d9-byval(i64 *"))
      (drop (addr-of ir)))
    (let (out:String (try (build-run-source src)))
      (try (check-eq (string-as-view (addr-of out)) "7 12\n"))
      (drop (addr-of out)))))

; The same, one level in: `emit-compile-time` runs its own defn-signature
; prescan BEFORE its body-form loop, so a `defn` in the block naming a
; `defstruct` in the same block hit the identical ordering.
(deftest s16-d9-ct-type-in-ct-signature
  (let (c:Compiled (try (compile-source "(import-use \"stdio.h\")
(compile-time
  (defstruct D9Q x:i32 y:i32)
  (defn d9-ct-sum (p:(ref D9Q)):i32 (return (+ (p 'x) (p 'y))))
  (let (q:ptr:D9Q (as ptr:D9Q (alloca D9Q)))
    (set! (q 'x) 5) (set! (q 'y) 6)
    (printf \"d9 ct inner %d\\n\" (d9-ct-sum (as ref:D9Q q)))))
(defn main ():i32 (return 0))
"))
        raw:StrView (string-as-view (addr-of c 'raw)))
    (try (check-contains raw "d9 ct inner 11"))
    (try (check-not-contains raw "IR parse error"))
    (drop (addr-of c))))

; The descent mirrors `emit-compile-time`'s SKIPS, not just its walk. That loop
; has an arm for `defstruct` and for nothing else this prescan registers, so a
; name it would never define must stay UNKNOWN -- registering one resolves the
; signature, writes no `%Name = type` line, and exits 0 on invalid IR, which is
; strictly worse than the diagnostic.
(deftest s16-d9-ct-descent-mirrors-skips
  (try (check-source-rejects "(compile-time (defstruct- D9K x:i32))
(defn d9-skip (p:(ref D9K)):i32 (return 0))
(defn main ():i32 (return 0))
" "unknown type: D9K"))
  (try (check-source-rejects "(compile-time (defunion D9K (a x:i32) (b)))
(defn d9-skip (p:(ref D9K)):i32 (return 0))
(defn main ():i32 (return 0))
" "unknown type: D9K"))
  (try (check-source-rejects "(compile-time (deftype D9K i32))
(defn d9-skip (p:(ref D9K)):i32 (return 0))
(defn main ():i32 (return 0))
" "unknown type: D9K"))
  (try (check-source-rejects "(compile-time (compile-time (defstruct D9K x:i32)))
(defn d9-skip (p:(ref D9K)):i32 (return 0))
(defn main ():i32 (return 0))
" "unknown type: D9K")))

; ---------------------------------------------------------------------------
; `&T` as a spelling of `(ref T)` (Stage 16 §RS)
; ---------------------------------------------------------------------------

; Sugar, not a second type: both spellings emit byte-identical IR.
(deftest s16-ref-sigil-ir-identical
  (let (a:String (try (source-ir "(import-use node)
(import-use vector)
(defstruct Pt x:i32 y:i32)
(defn s1 (p:&Pt):i32 (return (+ (p 'x) (p 'y))))
(defn id1 (p:&Pt):&Pt (return p))
(defn dd (pp:&&Pt):i32 (return (s1 (deref pp))))
(defn tot (v:&(Vector &Pt)):i32
  (let (s:i32 0) (dotimes (i (count v)) (set! s (+ s (s1 (v i))))) (return s)))
"))
        b:String (try (source-ir "(import-use node)
(import-use vector)
(defstruct Pt x:i32 y:i32)
(defn s1 (p:ref:Pt):i32 (return (+ (p 'x) (p 'y))))
(defn id1 (p:ref:Pt):ref:Pt (return p))
(defn dd (pp:ref:ref:Pt):i32 (return (s1 (deref pp))))
(defn tot (v:ref:(Vector ref:Pt)):i32
  (let (s:i32 0) (dotimes (i (count v)) (set! s (+ s (s1 (v i))))) (return s)))
")))
    (try (check-golden (string-as-view (addr-of a)) (string-as-view (addr-of b))))
    (drop (addr-of a))
    (drop (addr-of b))))

; The sigil is only a *leading* `&`, so a mid-token `&` (as in `a&b`, and in the
; compiler) keeps its name, and the two spellings compose in one file.
(deftest s16-ref-sigil-field-address-unclaimed
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(defstruct Pt x:i32 y:i32)
(defn bump (p:&Pt):i32
  (let (xp:&i32 (addr-of p 'x))
    (set! (deref xp) (+ (deref xp) 1))
    (return (p 'x))))
(defn main ():i32
  (let (a:Pt (Pt 1 2) ap:&Pt (addr-of a))
    (printf \"%d\\n\" (bump ap))
    (return 0)))
")))
    (try (check-eq (string-as-view (addr-of out)) "2\n"))
    (drop (addr-of out))))

; `&T` IS `(ref T)`, so it carries `ref`'s non-null obligation, and the
; whitespace near-miss is the same reader error `name: (T)` gets.
(deftest s16-ref-sigil-rules-preserved
  (try (check-source-rejects "(defstruct Pt x:i32)
(defvar p:&Pt null)
" "defvar: raw pointer where non-null (ref ...) is required"))
  (try (check-source-rejects "(defstruct Pt x:i32)
(defn f (p:&Pt):i32 (return 0))
(defn g (q:raw:Pt):i32 (return (f q)))
" "argument: raw pointer where non-null (ref ...) is required"))
  (try (check-source-rejects "(defstruct Pt x:i32)
(defn f (p:& Pt):i32 (return 0))
" "binding name ends in ':'")))

; A `.nuch` is a serialization format and the sigil is a *reader* rule -- so a
; header must carry the canonical `(ref T)` / `:ref:T` spelling and no `&` at
; all, or an importer re-reads a form the exporter never meant.
(deftest s16-ref-sigil-nuch-roundtrip
  (let (libdir:String (try (test-scratch-sub "lib"))
        dirv:StrView (string-as-view (addr-of libdir))
        src:String (try (test-write-file "siglib.nuc" "(defstruct Pt x:i32 y:i32)
(defn pt-sum (p:&Pt):i32 (return (+ (p 'x) (p 'y))))
(defn pt-id (p:&Pt):&Pt (return p))
"))
        nuch:String (try (emit-for-file "" "--emit-nuch" (string-as-view (addr-of src))))
        hp:String (try (test-write-file "lib/siglib.nuch" (string-as-view (addr-of nuch))))
        use:String (try (test-write-file "siguse.nuc" "(import-use \"stdio.h\")
(import-use siglib)
(defn main ():i32
  (let (a:Pt (Pt 4 5) ap:&Pt (addr-of a))
    (printf \"%d\\n\" (pt-sum (pt-id ap)))
    (return 0)))
"))
        nv:StrView (string-as-view (addr-of nuch)))
    (try (check-contains nv "((p (ref Pt)))"))
    (try (check-contains nv ":ref:Pt"))
    (try (check-not-contains nv "&"))
    (let (out:String (try (build-run-file dirv "" (string-as-view (addr-of use)))))
      (try (check-eq (string-as-view (addr-of out)) "9\n"))
      (drop (addr-of out)))
    (drop (addr-of use))
    (drop (addr-of hp))
    (drop (addr-of nuch))
    (drop (addr-of src))
    (drop (addr-of libdir))))

; A `&` that starts a token is the address-of reader macro, and it is sugar in
; the same strict sense: identical IR to the `(addr-of x)` it stands for.
(deftest s16-ref-sigil-addr-of-ir-identical
  (let (a:String (try (source-ir "(defstruct Pt x:i32 y:i32)
(defn s1 (p:&Pt):i32 (return (+ (p 'x) (p 'y))))
(defn go ():i32 (let (a:Pt (Pt 1 2)) (return (s1 &a))))
"))
        b:String (try (source-ir "(defstruct Pt x:i32 y:i32)
(defn s1 (p:&Pt):i32 (return (+ (p 'x) (p 'y))))
(defn go ():i32 (let (a:Pt (Pt 1 2)) (return (s1 (addr-of a)))))
")))
    (try (check-golden (string-as-view (addr-of a)) (string-as-view (addr-of b))))
    (drop (addr-of a))
    (drop (addr-of b))))

; The two meanings are split by token position, not by context, so they have to
; compose: `(as &Pt &p)` is a type and an operator in one form, and a standalone
; `&T` in a type slot -- which the reader wrote as `(addr-of T)` before position
; was known -- must still read as `(ref T)`.
(deftest s16-ref-sigil-both-meanings
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(defstruct Pt x:i32 y:i32)
(defstruct Holder (link &Pt) (tag i32))
(defn hx (h:&Holder):i32 (return ((h 'link) 'x)))
(defn main ():i32
  (let (a:Pt (Pt 3 4) ap:&Pt &a)
    (printf \"%d %d %d\\n\" ((as &Pt &a) 'x) (unsafe/cast i32 (sizeof &Pt)) ((deref &ap) 'y))
    (return 0)))
")))
    (try (check-eq (string-as-view (addr-of out)) "3 8 4\n"))
    (drop (addr-of out))))

; ---------------------------------------------------------------------------
; `:noreturn` / `:returns-twice` (Stage 16 §DA)
; ---------------------------------------------------------------------------

; One test, as in the shell -- but the shell accumulated `bad=1` and reported at
; the end, which is the hand-rolled accumulator `!void` exists to replace: here
; the first failure ends the test and names itself.
(deftest s16-decl-attrs
  ; 1. The `define`. Both attributes, in either order, and both on one function.
  (let (src:StrView "(import-use \"stdio.h\")
(import-use \"stdlib.h\")
(defn sj (b:ptr):i32 :returns-twice (return 0))
(defn boom (m:CStr):void :noreturn (printf \"%s\\n\" m) (exit 3))
(defn both (m:CStr):void :noreturn :returns-twice (printf \"%s\\n\" m) (exit 3))
(defn plain (x:i32):i32 (return x))
(defn main ():i32 (printf \"%d\\n\" (sj null)) (return 0))
")
    (let (ir:String (try (source-ir src))
          iv:StrView (string-as-view (addr-of ir)))
      ; Anchored at the start of the line, since a `define` also carries its
      ; `section`.
      (try (check-match iv "define i32 @sj(ptr %b.arg) returns_twice *"))
      (try (check-match iv "define void @boom(ptr %m.arg) noreturn *"))
      (try (check-match iv "define void @both(ptr %m.arg) noreturn returns_twice *"))
      ; A function with no attribute must gain none.
      (try (check-not-contains iv "define i32 @plain(i32 %x.arg) noreturn"))
      (try (check-not-contains iv "define i32 @plain(i32 %x.arg) returns_twice"))
      (drop (addr-of ir)))
    (let (out:String (try (build-run-source src)))
      (try (check-eq (string-as-view (addr-of out)) "0\n"))
      (drop (addr-of out))))
  ; 2. A top-level `(declare … :noreturn)` still drives `terminate-after-noreturn`
  ;    (the one Nucleus-side consumer), and `:returns-twice` rides the declare.
  (let (ir:String (try (source-ir "(declare my_abort ():void :noreturn)
(declare my_sj (b:ptr):i32 :returns-twice)
(defn main ():i32 (my_abort) (return 0))
"))
        iv:StrView (string-as-view (addr-of ir)))
    (try (check-line iv "declare void @my_abort() noreturn"))
    (try (check-line iv "declare i32 @my_sj(ptr) returns_twice"))
    (try (check-line iv "  unreachable"))
    (drop (addr-of ir)))
  ; 3. `.nuch` round-trip, solitary AND overloaded -- the exporter and the two
  ;    importers are three separate dispatch sites, and a missing one is silent.
  ;    `resolve-import` tries `.nuc` everywhere before any `.nuch`, so the source
  ;    sits outside every search directory or the header is never read.
  (let (libdir:String (try (test-scratch-sub "lib"))
        srcdir:String (try (test-scratch-sub "src"))
        lib:String (try (test-write-file "src/atlib.nuc" "(import-use \"stdio.h\")
(import-use \"stdlib.h\")
(defn sj (b:ptr):i32 :returns-twice (return 0))
(defn sj (b:ptr n:i32):i32 :returns-twice (return n))
(defn nope (m:CStr):void :noreturn (printf \"%s\\n\" m) (exit 3))
"))
        nuch:String (try (emit-for-file "" "--emit-nuch" (string-as-view (addr-of lib))))
        hp:String (try (test-write-file "lib/atlib.nuch" (string-as-view (addr-of nuch))))
        use:String (try (test-write-file "u.nuc" "(import-use \"stdio.h\")
(import-use atlib)
(defn main ():i32 (printf \"%d\\n\" (sj null)) (nope \"bye\") (return 0))
"))
        nv:StrView (string-as-view (addr-of nuch)))
    (try (check-contains nv "(declare nope ((m CStr)) :void :noreturn)"))
    (try (check-contains nv ":i32 :returns-twice)"))
    (let (c:Compiled (try (compile-path-in (string-as-view (addr-of libdir))
                                           (string-as-view (addr-of use))))
          iv:StrView (string-as-view (addr-of c 'ir)))
      (try (check-line iv "declare i32 @sj.ptr(ptr) returns_twice"))
      (try (check-line iv "declare i32 @sj.ptr.i32(ptr, i32) returns_twice"))
      (try (check-line iv "declare void @nope(ptr) noreturn"))
      (drop (addr-of c)))
    (drop (addr-of use))
    (drop (addr-of hp))
    (drop (addr-of nuch))
    (drop (addr-of lib))
    (drop (addr-of srcdir))
    (drop (addr-of libdir)))
  ; 4. The retired bare spellings each name their replacement. Without this they
  ;    fall through as ordinary symbols -- a body expression, or (in a declare) a
  ;    phantom trailing operand -- and fail somewhere unrelated.
  (try (check-source-rejects "(defn f (m:CStr):void noreturn (while (= 0 0) 0))\n"
         "'noreturn' is no longer a declaration attribute -- write ':noreturn'"))
  (try (check-source-rejects "(declare foo ():void noreturn)
(defn main ():i32 (return 0))
" "'noreturn' is no longer a declaration attribute -- write ':noreturn'"))
  (try (check-source-rejects "(declare foo ():i32 returns_twice)
(defn main ():i32 (return 0))
" "'returns_twice' is no longer a declaration attribute -- write ':returns-twice'"))
  ; 5. A LONE trailing form is the body, never an attribute -- otherwise a
  ;    keyword-returning one-expression body would be silently eaten.
  (let (src:StrView "(import-use \"stdio.h\")
(import-use keyword)
(defn kw ():Keyword :noreturn)
(defn main ():i32 (printf \"%d\\n\" (if (= (kw) :noreturn) 1 0)) (return 0))
")
    (let (ir:String (try (source-ir src)))
      (try (check-not-match (string-as-view (addr-of ir)) "*@kw(*) noreturn*"))
      (drop (addr-of ir)))
    (let (out:String (try (build-run-source src)))
      (try (check-eq (string-as-view (addr-of out)) "1\n"))
      (drop (addr-of out)))))

; ---------------------------------------------------------------------------
; `import-ct` — a library the program uses only at compile time (Stage 16)
; ---------------------------------------------------------------------------

; The definitions really are gone: one `define`, for `main`.
(deftest s16-import-ct-emits-no-definitions
  (let (ir:String (try (source-ir "(import-ct node)
(defn main ():i32 (return 0))
")))
    (try (check-eq-int (count-lines-with-prefix (string-as-view (addr-of ir)) "define ")
                       1 "definitions in the module"))
    (drop (addr-of ir))))

; The promise is kept at the two kinds of use: the compiler-synthesized one (a
; quote lowers to @intern-symbol) and the ordinary one (a direct call).
(deftest s16-import-ct-quote-refused
  (try (check-source-rejects "(import-ct node)
(defn main ():i32 (let (s:(ref Node) (quote a)) (return 0)))
" "quote needs the node runtime")))

(deftest s16-import-ct-call-refused
  (try (check-source-rejects "(import-ct node)
(defn main ():i32 (return (node-len null)))
" "imported compile-time-only")))

; …and it is a REFUSAL, not a link error: the message names a location in the
; user's file, which is the whole reason the check exists. The shell grepped for
; the message and again for `:2:`; one `check-error-at` requires both of the
; same diagnostic.
(deftest s16-import-ct-refusal-is-located
  (let (p:String (try (test-write-file "t.nuc" "(import-ct node)
(defn main ():i32 (return (node-len null)))
"))
        pv:StrView (string-as-view (addr-of p))
        c:Compiled (try (compile-path pv)))
    (try (check-error-at (addr-of c 'diags) pv 2 "imported compile-time-only"))
    (drop (addr-of c))
    (drop (addr-of p))))

; Order independence. `lib/error.nuc` does `(import-ct node)`, so a program that
; uses error handling AND quotes must get the runtime either way round. Getting
; this wrong is silent in one order and a refusal in the other.
(deftest s16-import-ct-real-import-wins-ct-first
  (let (ir:String (try (source-ir "(import-use error)
(import-use node)
(defn main ():i32 (let (s:(ref Node) (quote a)) (return 0)))
")))
    (try (check-match (string-as-view (addr-of ir)) "define *@intern-symbol(*"))
    (drop (addr-of ir))))

(deftest s16-import-ct-real-import-wins-real-first
  (let (ir:String (try (source-ir "(import-use node)
(import-use error)
(defn main ():i32 (let (s:(ref Node) (quote a)) (return 0)))
")))
    (try (check-match (string-as-view (addr-of ir)) "define *@intern-symbol(*"))
    (drop (addr-of ir))))

; The unit-level rule reaches THROUGH a ct-imported library: `ctlib` is
; compile-time-only, but the `vector` it pulls in is one the program itself
; imports, so vector must stay real — and, because a template stamp belongs to
; no file, `(Vector i32)` must still be instantiated into the program. Measured
; before the fix: every vector definition came out ct-only and the program was
; refused at its own `[1 2 3]`.
(deftest s16-import-ct-nested-real-import-survives
  (let (libdir:String (try (test-scratch-sub "l"))
        lib:String (try (test-write-file "l/ctlib.nuc" "(import-use vector)
(defn ctlib-count ((v (ref (Vector i32)))):usize (return (count v)))
"))
        use:String (try (test-write-file "nested.nuc" "(import-use \"stdio.h\")
(import-ct ctlib)
(import-use vector)
(defn main ():i32
  (with ((v (ref (Vector i32))) [1 2 3])
    (printf \"%d\\n\" (unsafe/cast i32 (count v))))
  (return 0))
"))
        out:String (try (build-run-file (string-as-view (addr-of libdir)) ""
                                        (string-as-view (addr-of use)))))
    (try (check-eq (string-as-view (addr-of out)) "3\n"))
    (drop (addr-of out))
    (drop (addr-of use))
    (drop (addr-of lib))
    (drop (addr-of libdir))))

; What `import-ct` is FOR: the compile-time surface is really registered, so a
; macro body may call the library's functions. `with-handler` (lib/error) is the
; in-tree case — it calls `node-at` under `(import-ct node)` — and it must still
; expand in a program carrying no node runtime at all.
(deftest s16-import-ct-macro-runs-with-no-runtime
  (let (src:StrView "(import-use \"stdio.h\")
(import-use error)
(deferror EGone \"gone\")
(defn probe ((e Err) (ctx ptr)):(Maybe i32) (return (some 7)))
(defn risky (x:i32):!i32 (if (< x 0) (return (err EGone)) (return (ok x))))
(defn main ():i32
  (with-handler (EGone i32 probe null)
    (match (risky -1) ((ok v) (printf \"%d\\n\" v)) ((err e) (printf \"unrepaired\\n\"))))
  (return 0))
")
    (let (out:String (try (build-run-source src)))
      (try (check-eq (string-as-view (addr-of out)) "7\n"))
      (drop (addr-of out)))
    (let (ir:String (try (source-ir src))
          iv:StrView (string-as-view (addr-of ir)))
      (try (check-not-match iv "define *@alloc-node(*"))
      (try (check-not-match iv "define *@make-cell(*"))
      (try (check-not-match iv "define *@intern-symbol(*"))
      (try (check-not-match iv "define *@arena-alloc(*"))
      (drop (addr-of ir)))))

; Arity, so a typo is a diagnostic rather than a silent no-op.
(deftest s16-import-ct-arity
  (try (check-source-rejects "(import-ct)
(defn main ():i32 (return 0))
" "import-ct: expected (import-ct name)")))

; ---------------------------------------------------------------------------
; `:rest` / `:optional` / `:where` / `:repr` (keyword-markers.md)
; ---------------------------------------------------------------------------

; All four markers, plus the two shapes that could have collided with one:
; `:where(Ord T)` with no separating space (the reader's colon-paren fuse keys
; on a TRAILING colon, so a keyword must not trigger it), and an `:optional`
; default that is itself a keyword VALUE one level down. `Ord3`/`less3` rather
; than `Ord`/`less`: lib/numeric.nuc defines those and `import-use keyword`
; reaches it, so the obvious names are a redefinition.
(deftest s16-keyword-markers-accepted
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use node)
(import-use keyword)
(defprotocol Ord3 (less3 (a:Self b:Self):bool))
(defn less3 (a:i32 b:i32):bool (return (< a b)))
(extend i32 Ord3)
(defstruct Point x:i32 y:i32)
(defunion Shape (circle p:(ref Point)) none :repr tagged)
(defn sum (:rest args:i64):i64
  (let (total:i64 0)
    (while (!= args null)
      (set! total (+ total (unsafe/cast i64 ((unsafe/cast ptr:Node args) 'car))))
      (set! args ((unsafe/cast ptr:Node args) 'cdr)))
    total))
(defn maxv (a:T b:T :where (Ord3 T)):T (return (if (less3 a b) b a)))
(defn minv (a:T b:T :where(Ord3 T)):T (return (if (less3 b a) b a)))
(defn kw-default (n:i32 :optional (k:Keyword :fallback)):i32 (return n))
(defn greet (n:i32 :optional (m:i32 7)):i32 (return (+ n m)))
(defmacro twice (x :rest r) `(+ ~x ~x))
(defn main ():i32
  (printf \"%ld %d %d %d %d %d\\n\"
    (sum 1 2 3 4) (maxv 3 9) (minv 3 9) (greet 1) (greet 1 2) (twice 5))
  (return (kw-default 0)))
")))
    (try (check-eq (string-as-view (addr-of out)) "10 9 3 8 3 10\n"))
    (drop (addr-of out))))

; Every retired `&x` spelling names its replacement, from the definer that owns
; it. Without this each one falls through as an ordinary symbol and surfaces as
; `missing :type on param '&rest'` or `unknown type: T`.
(deftest s16-keyword-markers-legacy-rejected
  (try (check-source-rejects "(defn f (a:i32 &rest xs:i64):i64 (return 0))\n"
         "'&rest' is no longer a marker -- write ':rest'"))
  (try (check-source-rejects "(defn f (n:i32 &optional (m:i32 7)):i32 (return n))\n"
         "'&optional' is no longer a marker -- write ':optional'"))
  (try (check-source-rejects "(defprotocol Ord (less (a:Self b:Self):bool))
(defn maxv (a:T b:T &where (Ord T)):T (return a))
" "'&where' is no longer a marker -- write ':where'"))
  (try (check-source-rejects "(defprotocol Show (shout (a:Self):i32))
(defstruct (Box T) v:T)
(extend (Box T) Show &where (Show T))
" "'&where' is no longer a marker -- write ':where'"))
  (try (check-source-rejects "(defstruct Point x:i32)
(defunion Shape (circle p:(ref Point)) none &repr tagged)
" "'&repr' is no longer a marker -- write ':repr'"))
  (try (check-source-rejects "(defmacro twice (x &rest r) `(+ ~x ~x))\n"
         "'&rest' is no longer a marker -- write ':rest'"))
  (try (check-source-rejects "(declare printf (fmt:CStr &rest args:i32) :i32)\n"
         "'&rest' is no longer a marker -- write ':rest'")))

; The keyword spelling did not weaken any rule the symbol spelling enforced.
(deftest s16-keyword-markers-rules-preserved
  (try (check-source-rejects "(defn f (:rest xs:i64 a:i32):i64 (return 0))\n"
         "defn: :rest must be second-to-last param"))
  (try (check-source-rejects "(defn f (a:i32 :optional (m:i32 1) :rest xs:i64):i64 (return 0))\n"
         "defn: :optional cannot be combined with :rest"))
  (try (check-source-rejects "(declare printf (fmt:CStr :rest args:i32) :i32)\n"
         "declare: ':rest' is not supported in a declaration"))
  (try (check-source-rejects "(defprotocol Ord (less (a:Self b:Self):bool))
(defn maxv (a:T b:T :rest xs:i64 :where (Ord T)):T (return a))
" "defn: :rest combined with a generic method is not supported yet"))
  (try (check-source-rejects "(defmacro m (x :rest r y) `~x)\n"
         "defmacro: :rest must be second-to-last param")))

; `.nuch` is a serialization format: print-node must round-trip a marker keyword
; with its colon, or a header exports a form its importer cannot re-read.
; Asserted on the emitted text AND on a real import of it.
(deftest s16-keyword-markers-nuch-roundtrip
  (let (libdir:String (try (test-scratch-sub "lib"))
        lib:String (try (test-write-file "lib/mklib.nuc"
                          "(defprotocol Ord2 (less2 (a:Self b:Self):bool))
(defn less2 (a:i32 b:i32):bool (return (< a b)))
(extend i32 Ord2)
(defn mk-max (a:T b:T :where (Ord2 T)):T (return (if (less2 a b) b a)))
(defmacro mk-first (x :rest r) `~x)
"))
        nuch:String (try (emit-for-file "" "--emit-nuch" (string-as-view (addr-of lib))))
        hp:String (try (test-write-file "lib/mklib.nuch" (string-as-view (addr-of nuch))))
        use:String (try (test-write-file "use.nuc" "(import-use \"stdio.h\")
(import-use mklib)
(defn main ():i32 (printf \"%d\\n\" (mk-max 4 11)) (return 0))
"))
        nv:StrView (string-as-view (addr-of nuch)))
    (try (check-contains nv ":where (Ord2 T)"))
    (try (check-contains nv "(x :rest r)"))
    (try (check-not-contains nv "&"))
    (let (out:String (try (build-run-file (string-as-view (addr-of libdir)) ""
                                          (string-as-view (addr-of use)))))
      (try (check-eq (string-as-view (addr-of out)) "11\n"))
      (drop (addr-of out)))
    (drop (addr-of use))
    (drop (addr-of hp))
    (drop (addr-of nuch))
    (drop (addr-of lib))
    (drop (addr-of libdir))))

; ---------------------------------------------------------------------------
; `macrolet` (macrolet.md)
; ---------------------------------------------------------------------------

; Each program's exit code is a bitmask of FAILED checks, so a regression names
; itself instead of reporting one anonymous wrong number.
(deftest s16-macrolet
  (try (check-source-exit "(defmacro dbl (x) `(_* 2 ~x))

; A binding shadows a global macro for the body and only for the body.
(defn ml-shadow ():i32
  (let (r:i32 0)
    (set! r (dbl 5))
    (macrolet ((dbl (x) `(_* 3 ~x)))
      (set! r (_+ r (dbl 5))))
    (_+ r (dbl 5))))

; Bindings are sequential (like Nucleus `let`, unlike Common Lisp's parallel
; macrolet): `two` sees `one`.
(defn ml-seq ():i32
  (macrolet ((one () `1)
             (two () `(_+ (one) (one))))
    (two)))

; An inner binding shadows an outer one of the same name; the outer is restored
; after the inner body. This is the pop.
(defn ml-nest ():i32
  (macrolet ((m () `10))
    (_+ (macrolet ((m () `100)) (m))
        (m))))

(defn ml-rest ():i32
  (macrolet ((sum3 (a :rest more) `(_+ ~a (_+ ~@more))))
    (sum3 1 2 3)))

; The enclosing function's entry/body streams must survive the nested macro
; compilation -- a macrolet inside a loop body is the cheapest proof.
(defn ml-loop ():i32
  (let (acc:i32 0 i:i32 0)
    (while (< i 4)
      (macrolet ((bump () `(set! acc (_+ acc i))))
        (bump))
      (inc! i))
    acc))

(defn main ():i32
  (let (bad:i32 0)
    (when (!= (ml-shadow) 35) (set! bad (_+ bad 1)))
    (when (!= (ml-seq)     2) (set! bad (_+ bad 2)))
    (when (!= (ml-nest)  110) (set! bad (_+ bad 4)))
    (when (!= (ml-rest)    6) (set! bad (_+ bad 8)))
    (when (!= (ml-loop)    6) (set! bad (_+ bad 16)))
    (return bad)))
" 0)))

; A macrolet in ARGUMENT position sits mid-argument-walk, so the ambient
; argument-register budget (g-abi-gpr-left/…) has to survive the nested emission
; -- by-value structs of both ABI classes make that observable. Plus: a macrolet
; in a `cond` arm, and one inside a generic template body (compiled once per
; monomorphization, hence the monotonic jit-name counter).
(deftest s16-macrolet-abi
  (try (check-source-exit "(import-use numeric)
(defstruct Big a:i64 b:i64 c:i64)
(defstruct Pair x:i64 y:i64)

(defn take6 (p:Pair q:Pair b:Big n:i32 m:i32):i64
  (let (pp:ptr:Pair (addr-of p) qq:ptr:Pair (addr-of q) bb:ptr:Big (addr-of b))
    (_+ (_+ (pp 'x) (qq 'y)) (_+ (bb 'c) (as i64 (_+ n m))))))

(defn ml-argpos ():i64
  (let (p:Pair (Pair 1 2) q:Pair (Pair 3 4) b:Big (Big 5 6 7))
    (take6 p q b 10 (macrolet ((twenty () `20)) (twenty)))))

(defn ml-cond (n:i32):i32
  (cond (= n 0) (macrolet ((z () `100)) (z))
        (= n 1) (macrolet ((o (k) `(_* ~k 3))) (o 7))
        true    (macrolet ((d () `(_- 0 1))) (d))))

(defn ml-maxish (a:T b:T :where (Ord T)):T
  (macrolet ((pick (x y) `(if (< ~x ~y) ~y ~x)))
    (pick a b)))

(defn main ():i32
  (let (bad:i32 0)
    (when (!= (ml-argpos) (as i64 42)) (set! bad (_+ bad 1)))
    (when (!= (ml-cond 0) 100) (set! bad (_+ bad 2)))
    (when (!= (ml-cond 1)  21) (set! bad (_+ bad 4)))
    (when (!= (ml-cond 2)  -1) (set! bad (_+ bad 8)))
    (when (!= (ml-maxish 21 9) 21) (set! bad (_+ bad 16)))
    (when (!= (ml-maxish (as i64 50) (as i64 77)) (as i64 77)) (set! bad (_+ bad 32)))
    (return bad)))
" 0)))

; A macrolet inside a `defmacro` BODY: one macro JIT module compiled while
; another is compiling. The hoist-to-a-pre-pass alternative could not do this;
; `push-function-state` can. `(a car)` on the INT node `5` is null, so `pick`
; expands to its second argument.
(deftest s16-macrolet-in-defmacro
  (try (check-source-exit "(defmacro pick (a b)
  (macrolet ((first-of (x) `(~x 'car)))
    (if (= (first-of a) null) b a)))
(defn main ():i32 (return (pick 5 6)))
" 6)))

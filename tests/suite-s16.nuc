; Stage 18 TF-6 category (c) — the Stage 16 type-system units, ported.
;
; Design: design/stage18-tooling/overview.md §T6.6.
;
; These were the largest bodies in `tests/run-tests.sh`. Each varies one line of
; a small program across a dozen spellings, so the fixture is embedded (§T8.3
; ruling 3) rather than filed, and a string literal may span lines — which is
; what makes an embedded program readable at all.

; ---------------------------------------------------------------------------
; bool as a type of its own (Stage 16 §BT)
; ---------------------------------------------------------------------------

; No implicit coercion in either direction — the {0,1} rule's replacement.
(deftest s16-bool-no-implicit-coercion
  (try (check-source-rejects
         "(defvar g:bool 1)
(defn main ():i32 (return 0))
"
         "defvar: integer literal incompatible with type bool"))
  (try (check-source-rejects
         "(defn main ():i32 (let (b:bool 1) (return 0)))
"
         "let: init type mismatch for 'b'"))
  (try (check-source-rejects
         "(defn main ():i32 (let (n:i32 true) (return 0)))
"
         "let: init type mismatch for 'n'"))
  (try (check-source-rejects
         "(defn main ():i32 (let (b:bool (as bool 1)) (return 0)))
"
         "as: lossy conversion from i32 to bool -- use unsafe/cast")))

; Arithmetic refuses a bool operand, and a comparison refuses a MIXED pair. All
; six comparisons on two bools stay legal (w9-bool-unsigned covers them).
(deftest s16-bool-not-an-integer-operand
  (try (check-source-rejects
         "(defn main ():i32 (let (b:bool (+ true true)) (return 0)))
"
         "_+ does not apply to bool"))
  (try (check-source-rejects
         "(defn main ():i32 (let (b:bool (bit-and true true)) (return 0)))
"
         "bit-and does not apply to bool"))
  (try (check-source-rejects
         "(defn main ():i32 (let (b:bool (= true 1)) (return 0)))
"
         "=: mixed bool and non-bool operands")))

; `i1` is retired as a spelling, in every type position, and names bool.
(deftest s16-bool-i1-spelling-retired
  (try (check-source-rejects
         "(defn main ():i32 (let (b:i1 true) (return 0)))
"
         "i1 is no longer a type — use bool"))
  (try (check-source-rejects
         "(defn f (a:i1):i32 (return 0))
(defn main ():i32 (return 0))
"
         "i1 is no longer a type — use bool"))
  (try (check-source-rejects
         "(defn f ():i1 (return true))
(defn main ():i32 (return 0))
"
         "i1 is no longer a type — use bool")))

; The accepting half. `(as i32 b)` is the sanctioned widening (zext, since bool
; is unsigned), and a bool global must hold the value that was WRITTEN — the
; assertion a run cannot make, since `global i1 false` for a written `true`
; still exits 0 through every check a run could apply.
(deftest s16-bool-widens-to-int
  (let (src:StrView "(import-use \"stdio.h\")
(defvar s16b-t:bool true)
(defvar s16b-f:bool false)
(defn main ():i32
  (printf \"%d %d\\n\" (as i32 s16b-t) (as i32 s16b-f))
  (return 0))
")
    (let (out:String (try (build-run-source src))
          ov:StrView (string-as-view &out))
      (try (check-eq (strview-trim-end &ov) "1 0"))
      (drop &out))
    (let (ir:String (try (source-ir src)))
      (try (check-contains (string-as-view &ir) "@s16b-t = global i1 true"))
      (try (check-contains (string-as-view &ir) "@s16b-f = global i1 false"))
      (try (check-contains (string-as-view &ir) "zext i1"))
      (drop &ir))))

; `as` names `unsafe/cast` in every bool rejection, so the hatch has to be
; TOTAL: all five instruction-selection gates must admit a bool operand, or the
; diagnostic advertises a conversion that cannot be written.
(deftest s16-bool-unsafe-cast-is-total
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(defn main ():i32
  (let (b:bool (unsafe/cast bool 1)
        z:bool (unsafe/cast bool 0)
        n:i32  (unsafe/cast i32 true)
        f:f64  (unsafe/cast f64 true)
        w:i64  (unsafe/cast i64 false))
    (printf \"%d %d %d %.1f %ld\\n\" (as i32 b) (as i32 z) n f w))
  (return 0))
")))
    (let (ov:StrView (string-as-view &out))
      (try (check-eq (strview-trim-end &ov) "1 0 1 1.0 0")))
    (drop &out)))

; The two permanent, user-visible spellings of the type: the mangle token in an
; overload's link name, and the C rendering in a generated header. Both read
; `i1` before Stage 16; a header consumer sees whichever ships.
(deftest s16-bool-mangle-and-c-spelling
  (let (src:StrView "(defn f (a:bool):i32 (return (as i32 a)))
(defn f (a:i32):i32 (return a))
(defn g (b:bool):bool (return (not b)))
")
    (let (ir:String (try (source-ir src)))
      (try (check-contains (string-as-view &ir)
                           "define i32 @f.bool(i1 %a.arg)"))
      (drop &ir))
    (let (h:String (try (source-cheader src)))
      (try (check-line (string-as-view &h)
                       "int32_t f_bool(bool a) asm(\"f.bool\");"))
      (try (check-line (string-as-view &h) "bool g(bool b);"))
      (try (check-line (string-as-view &h) "#include <stdbool.h>"))
      (drop &h))))

; ---------------------------------------------------------------------------
; Macros: atoms, `macrolet`, and what `macrolet` refuses (Stage 16 §MA)
; ---------------------------------------------------------------------------

; A macro template that is a bare atom -- a literal, an unquoted symbol, or a
; quoted one -- expands to that atom rather than to a call. The answer is the
; exit status, since each of the four contributes a number.
(deftest s16-atom-macro
  (try (check-source-exit "(defmacro one () `1)
(defmacro sym-of () `x)
(defmacro quoted () 'y)
(defn main ():i32
  (let (x:i32 40 y:i32 2)
    (macrolet ((two () `2))
      (return (_+ (one) (_+ (two) (_+ (sym-of) (quoted))))))))
" 45)))

(deftest s16-defmacro-nonsym-param
  (try (check-source-rejects
         "(defmacro m (5) `1)\n(defn main ():i32 0)\n"
         "defmacro: param must be a symbol")))

(deftest s16-macrolet-refused-noargs
  (try (check-source-rejects "(defn main ():i32 (macrolet) 0)
"
         "macrolet: expects a binding list and at least one body form")))
(deftest s16-macrolet-refused-nobody
  (try (check-source-rejects "(defn main ():i32 (macrolet ((m () `1))) 0)
"
         "macrolet: expects a binding list and at least one body form")))
(deftest s16-macrolet-refused-badbind
  (try (check-source-rejects "(defn main ():i32 (macrolet (m) 0))
"
         "macrolet: binding must be (name (params) body...)")))
(deftest s16-macrolet-refused-badname
  (try (check-source-rejects "(defn main ():i32 (macrolet ((5 () `1)) 0))
"
         "macrolet: macro name must be a symbol")))
(deftest s16-macrolet-refused-badparams
  (try (check-source-rejects "(defn main ():i32 (macrolet ((m 5 `1)) 0))
"
         "macrolet: params must be a list")))
(deftest s16-macrolet-refused-badparam
  (try (check-source-rejects "(defn main ():i32 (macrolet ((m (5) `1)) 0))
"
         "macrolet: param must be a symbol")))
(deftest s16-macrolet-refused-special
  (try (check-source-rejects "(defn main ():i32 (macrolet ((let (x) `1)) 0))
"
         "macrolet: 'let' is a special form and may not be shadowed")))
(deftest s16-macrolet-refused-restpos
  (try (check-source-rejects "(defn main ():i32 (macrolet ((m (:rest a b) `1)) 0))
"
         "macrolet: :rest must be second-to-last param")))
(deftest s16-macrolet-refused-colon
  (try (check-source-rejects "(defn main ():i32 (macrolet ((m:i32 () `1)) 0))
"
         "macrolet: a binding name takes no type annotation; write (m (params) ...)")))
; Stage 20 M2 lifted the top-level refusal this test was written against, so
; what it now pins is the rule that outlived it: a top-level `macrolet` body is
; a list of TOP-LEVEL forms, so a binding that expands to a value is as wrong
; there as any other non-definition would be.
(deftest s20-macrolet-toplevel-body-is-toplevel
  (try (check-source-rejects "(macrolet ((m () `1)) (m))
"
         "top-level macro 'm' did not expand to a form")))

; ---------------------------------------------------------------------------
; `:repr` on an UNINSTANTIATED template (Stage 16 §TR)
; ---------------------------------------------------------------------------

; The mode is checked where it is written, not where it is stamped: a template
; nobody instantiates still has to be diagnosed.
(deftest s16-template-repr
  (try (check-source-rejects "(defunion (Box T) (some v:T) none :repr bogus)
(defn main ():i32 (return 0))
"
         "defunion: :repr mode must be `tagged` or `niche`"))
  (try (check-source-rejects "(defunion (Box T) (some v:T) none :repr)
(defn main ():i32 (return 0))
"
         "defunion: :repr needs a mode (tagged or niche)"))
  (try (check-source-rejects "(defunion (Box T) (some v:T) none &repr tagged)
(defn main ():i32 (return 0))
"
         "'&repr' is no longer a marker -- write ':repr'"))
  ; And a VALID uninstantiated template still compiles -- the check must
  ; diagnose, not stamp.
  (try (check-source-accepts "(defunion (Box T) (some v:T) none :repr tagged)
(defn main ():i32 (return 0))
")))

; ---------------------------------------------------------------------------
; `ref` / `raw` / `ptr` are reserved (Stage 16 §PK)
; ---------------------------------------------------------------------------

(deftest s16-pointer-kind-names-reserved
  (try (check-source-rejects "(defvar ref:i32 5)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defn ref ():i32 (return 5))
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defstruct ref x:i32)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defconst ref 5)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defvar raw:i32 5)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defn raw ():i32 (return 5))
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defstruct raw x:i32)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defconst raw 5)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defvar ptr:i32 5)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defn ptr ():i32 (return 5))
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defstruct ptr x:i32)
"
         "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(defconst ptr 5)
"
         "a symbol may name only one kind of thing"))
  ; The noun is per-name, not per-row: `ref`/`raw` are not types.
  (try (check-source-rejects "(defvar ref:i32 5)\n"
         "'ref' already names a pointer kind"))
  ; Unchanged: the kinds are still type syntax...
  (try (check-source-accepts "(defstruct Pt x:i32)
(defn f (a:ref:Pt b:raw:Pt c:ptr:Pt):i32 (return (a 'x)))
(defn g (v:(ref Pt) w:(raw Pt)):i32 (return (v 'x)))
"))
  ; ...and `ref` is still not a resolvable type NAME, so a bare one in a
  ; template argument is reported rather than collected as a tyvar.
  (try (check-source-rejects "(import-use node)
(import-use vector)
(defn h (v:(Vector ref)):i32 (return 0))
"
         "'ref' is a pointer kind, not a type argument")))

; ---------------------------------------------------------------------------
; Nil punning at condition position (Stage 16 §BT, bool-truthiness.md)
; ---------------------------------------------------------------------------

; All six sites, for each of the four nullable types. Each probe returns a
; bitmask so one number pins every site at once -- 1 cond, 2 not, 4 _and,
; 8 _or, 16 while.
;
; The IR half is not redundant: a wrong value that only reaches a truthiness
; test is invisible to every gate (conventions.md), so the two eliminations are
; also pinned at the instruction level -- a pointer test is `icmp ne ptr`, a
; value-Maybe test reads the tag word.
(deftest s16-truthiness-six-sites
  (let (src:StrView "(import-use \"stdio.h\")
(import-use arena)

(defstruct Pt x:i32)

(defn probe-raw (p:(raw Pt) q:(raw Pt)):i32
  (let (n:i32 0)
    (when p (set! n (+ n 1)))
    (when (not p) (set! n (+ n 2)))
    (when (and p q) (set! n (+ n 4)))
    (when (or p q) (set! n (+ n 8)))
    (let (c:(raw Pt) p)
      (while c (set! n (+ n 16)) (set! c null)))
    (return n)))

(defn probe-cstr (p:CStr q:CStr):i32
  (let (n:i32 0)
    (when p (set! n (+ n 1)))
    (when (not p) (set! n (+ n 2)))
    (when (and p q) (set! n (+ n 4)))
    (when (or p q) (set! n (+ n 8)))
    (let (c:CStr p)
      (while c (set! n (+ n 16)) (set! c null)))
    (return n)))

(defn probe-maybe-ptr (p:?ptr:Pt q:?ptr:Pt):i32
  (let (n:i32 0)
    (when p (set! n (+ n 1)))
    (when (not p) (set! n (+ n 2)))
    (when (and p q) (set! n (+ n 4)))
    (when (or p q) (set! n (+ n 8)))
    (let (c:?ptr:Pt p)
      (while c (set! n (+ n 16)) (set! c null)))
    (return n)))

(defn probe-maybe-val (p:(Maybe i64) q:(Maybe i64)):i32
  (let (n:i32 0)
    (when p (set! n (+ n 1)))
    (when (not p) (set! n (+ n 2)))
    (when (and p q) (set! n (+ n 4)))
    (when (or p q) (set! n (+ n 8)))
    (let (c:(Maybe i64) p)
      (while c (set! n (+ n 16)) (set! c (make (Maybe i64) none))))
    (return n)))

(defn main ():i32
  (let (a:(ref Pt) (new Pt)
        b:(ref Pt) (new Pt)
        s:CStr c\"x\"
        t:CStr c\"y\"
        nc:CStr (as CStr null)
        sm:(Maybe i64) (make (Maybe i64) some 5)
        nm:(Maybe i64) (make (Maybe i64) none))
    (printf \"raw %d %d %d %d\\n\"
      (probe-raw (as (raw Pt) a) (as (raw Pt) b))
      (probe-raw (as (raw Pt) a) null)
      (probe-raw null (as (raw Pt) b))
      (probe-raw null null))
    (printf \"cstr %d %d %d %d\\n\"
      (probe-cstr s t) (probe-cstr s nc) (probe-cstr nc t) (probe-cstr nc nc))
    (printf \"mptr %d %d %d %d\\n\"
      (probe-maybe-ptr (as-ref a) (as-ref b))
      (probe-maybe-ptr (as-ref a) null)
      (probe-maybe-ptr null (as-ref b))
      (probe-maybe-ptr null null))
    (printf \"mval %d %d %d %d\\n\"
      (probe-maybe-val sm sm) (probe-maybe-val sm nm)
      (probe-maybe-val nm sm) (probe-maybe-val nm nm)))
  (return 0))
")
    (let (out:String (try (build-run-source src)))
      (try (check-golden (string-as-view &out)
                         "raw 29 25 10 2
cstr 29 25 10 2
mptr 29 25 10 2
mval 29 25 10 2
"))
      (drop &out))
    (let (ir:String (try (source-ir src))
          iv:StrView (string-as-view &ir))
      (try (check-contains iv "icmp ne ptr"))
      (try (check-match iv "*extractvalue %Maybe.i64 %*, 0*"))
      (drop &ir))))

; The narrowing half. `test-true-nonnull` matches node SHAPES, so the bare
; symbol needed its own arm -- without it the condition compiles and the BODY
; fails, i.e. the sugar would break exactly the case that motivates it.
(deftest s16-truthiness-narrows-bare-symbol
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use arena)

(defstruct Pt x:i32)

(defn f-when (m:?ptr:Pt):i32
  (when m (return (m 'x)))
  (return -1))

(defn f-and (m:?ptr:Pt):i32
  (when (and m (> (m 'x) 0)) (return (m 'x)))
  (return -1))

(defn f-guard (m:?ptr:Pt):i32
  (when (not m) (return -1))
  (return (m 'x)))

(defn f-while (m:?ptr:Pt):i32
  (let (n:i32 -1)
    (while m
      (set! n (m 'x))
      (return n))
    (return n)))

(defn main ():i32
  (let (a:(ref Pt) (new Pt))
    (set! (a 'x) 7)
    (printf \"%d %d %d %d %d %d %d %d\\n\"
      (f-when (as-ref a))  (f-when null)
      (f-and (as-ref a))   (f-and null)
      (f-guard (as-ref a)) (f-guard null)
      (f-while (as-ref a)) (f-while null)))
  (return 0))
")))
    (try (check-eq (string-as-view &out) "7 -1 7 -1 7 -1 7 -1\n"))
    (drop &out)))

; The refusals that must STAY refusals. `(when n:i32 …)` is what keeps both
; zero-is-false and all-numbers-true revisable.
(deftest s16-truthiness-numbers-stay-refused
  (try (check-source-rejects
         "(defn main ():i32 (let (n:i32 3) (when n (return 1))) (return 0))\n"
         "cond: condition must be bool, not i32"))
  (try (check-source-rejects
         "(defn main ():i32 (let (n:i32 3) (while n (dec! n))) (return 0))\n"
         "while: condition must be bool, not i32"))
  (try (check-source-rejects
         "(defn main ():i32 (let (n:i32 3) (when (not n) (return 1))) (return 0))\n"
         "not: condition must be bool, not i32"))
  (try (check-source-rejects
         "(defn main ():i32 (let (n:i32 3) (when (and n (> n 0)) (return 1))) (return 0))\n"
         "and: condition must be bool, not i32"))
  (try (check-source-rejects
         "(defn main ():i32 (let (n:i32 3) (when (or n (> n 0)) (return 1))) (return 0))\n"
         "or: condition must be bool, not i32"))
  (try (check-source-rejects
         "(defn main ():i32 (let (f:f64 1.0) (when f (return 1))) (return 0))\n"
         "cond: condition must be bool, not f64")))

; The two types nil punning deliberately does not reach: a Result is neither
; true nor false, and a non-null pointer's test is a constant. Both name their
; own way out.
(deftest s16-truthiness-nonnull-and-result-refused
  (try (check-source-rejects "(defstruct Pt x:i32)
(defn f (p:(ref Pt)):i32 (when p (return 1)) (return 0))
(defn main ():i32 (return 0))
"
         "&Pt is non-null, so this test is always true"))
  (try (check-source-rejects "(defn f (p:ptr):i32 (when p (return 1)) (return 0))
(defn main ():i32 (return 0))
"
         "ptr is non-null, so this test is always true"))
  (try (check-source-rejects "(defstruct Pt x:i32)
(deferror Boom \"boom\")
(defn g ():!ptr:Pt (return (err Boom)))
(defn f ():i32 (let (r:!ptr:Pt (g)) (when r (return 1))) (return 0))
(defn main ():i32 (return 0))
"
         "a Result (!T) is neither true nor false")))

; It is an ELIMINATION RULE, NOT A COERCION: `coerce-int-val` is untouched, so
; `bool` did not become a universal sink. If any of these ever compiles,
; truthiness has leaked into the coercion set and overload resolution is next.
(deftest s16-truthiness-is-not-a-coercion
  (try (check-source-rejects "(defstruct Pt x:i32)
(defn f (b:bool):i32 (return 0))
(defn g (p:(raw Pt)):i32 (return (f p)))
(defn main ():i32 (return 0))
"
         "f: argument 1 has type (raw Pt), which does not match parameter type bool"))
  (try (check-source-rejects "(defstruct Pt x:i32)
(defn g (p:(raw Pt)):i32 (let (b:bool p) (return 0)))
(defn main ():i32 (return 0))
"
         "let: init type mismatch for 'b'"))
  (try (check-source-rejects "(defstruct Pt x:i32)
(defstruct S flag:bool)
(defn g (p:(raw Pt)):i32 (let (s:(ref S) (alloca S)) (set! (s 'flag) p)) (return 0))
(defn main ():i32 (return 0))
"
         "set!: type mismatch for field 'flag': value is (raw Pt), field is bool")))

; ---------------------------------------------------------------------------
; Variables as collection-literal elements (Stage 16, collection-literal-variables.md)
; ---------------------------------------------------------------------------

(defn litvar-pre ():StrView
  (return "(import-use \"stdio.h\")
(import-use vector)
(import-use hashset)
(import-use hashmap)
"))

(defn check-litvar-rejects (body:StrView needle:StrView):!void
  (let (src:String (str (litvar-pre) body "\n")
        v:StrView (string-as-view &src))
    (try (check-source-rejects v needle))
    (drop &src)
    (return (ok))))

; Enum members, a defconst, a local, and a call, in all three literal kinds.
; Every one of these was a hard error before this item.
(deftest s16-litvar-accepted
  (let (src:String (str (litvar-pre) "(defenum BK BK-GLOBAL BK-PROTOCOL BK-GENERIC BK-MACRO)
(defconst LIMIT 40)
(defn twice (x:i32):i32 (return (* 2 x)))
(defn main ():i32
  (let (kind:i32 BK-MACRO other:i32 7)
    (with ((s (ref (HashSet i32))) #{BK-GLOBAL BK-PROTOCOL other (twice 9)})
      (printf \"set=%d %d %d %d\\n\" (unsafe/cast i32 (count s))
        (unsafe/cast i32 (contains? s BK-GLOBAL)) (unsafe/cast i32 (contains? s 18))
        (unsafe/cast i32 (contains? s kind))))
    (with ((v (ref (Vector i32))) [LIMIT other])
      (printf \"vec=%d %d\\n\" (invoke v 0) (invoke v 1)))
    (with ((m (ref (HashMap i32 i32))) {BK-GLOBAL other BK-MACRO LIMIT})
      (printf \"map=%d\\n\" (unsafe/cast i32 (count m)))))
  (return 0))
")
        out:String (try (build-run-source (string-as-view &src))))
    (try (check-golden (string-as-view &out) "set=4 1 1 0
vec=40 7
map=2
"))
    (drop &out)
    (drop &src)))

(defn litvar-target-src ():String
  (return (str (litvar-pre) "(defn main ():i32
  (with ((v (ref (Vector i64))) [1 2 3])
    (printf \"want=%lld %d\\n\" (invoke v 0) (unsafe/cast i32 (count v))))
  (return 0))
")))

; Target-first, and the soundness regression it closes: before this item
; `(ref (Vector i64))` bound to a literal-built (Vector i32) with no error, and
; `(invoke v 0)` read two i32 elements back as one i64 -- 8589934593.
(deftest s16-litvar-target-wins
  (let (src:String (litvar-target-src)
        out:String (try (build-run-source (string-as-view &src))))
    (try (check-eq (string-as-view &out) "want=1 3\n"))
    (drop &out)
    (drop &src)))

; …and it must stamp only the wanted instance, not build i32 and reinterpret.
(deftest s16-litvar-target-stamps-once
  (let (src:String (litvar-target-src)
        ir:String (try (source-ir (string-as-view &src))))
    (try (check-not-contains (string-as-view &ir) "Vector.i32"))
    (drop &ir)
    (drop &src)))

; A numeric literal ADAPTS to a value element, exactly as `(conj v 1)` on a
; (Vector i64) already does; a value is never narrowed to suit a literal.
(deftest s16-litvar-literal-adapts
  (let (src:String (str (litvar-pre) "(defn main ():i32
  (let (n:i64 5000000000)
    (with ((v (ref (Vector i64))) [n 1 2])
      (printf \"adapt=%lld %lld\\n\" (invoke v 0) (invoke v 1))))
  (return 0))
")
        out:String (try (build-run-source (string-as-view &src))))
    (try (check-eq (string-as-view &out) "adapt=5000000000 1\n"))
    (drop &out)
    (drop &src)))

; Elements evaluate left to right, which only became observable once an element
; could be a call.
(deftest s16-litvar-eval-order
  (let (src:String (str (litvar-pre) "(defvar seq:i32 0)
(defn tick (tag:i32):i32 (printf \"%d\" tag) (set! seq (+ seq 1)) (return tag))
(defn main ():i32
  (with ((v (ref (Vector i32))) [(tick 1) (tick 2) (tick 3)])
    (printf \"|%d\\n\" (unsafe/cast i32 (count v))))
  (return 0))
")
        out:String (try (build-run-source (string-as-view &src))))
    (try (check-eq (string-as-view &out) "123|3\n"))
    (drop &out)
    (drop &src)))

; An empty literal is legal exactly when a target supplies the element type.
(deftest s16-litvar-empty-with-target
  (let (src:String (str (litvar-pre) "(defn main ():i32
  (with ((v (ref (Vector i32))) [])
    (printf \"empty=%d\\n\" (unsafe/cast i32 (count v))))
  (return 0))
")
        out:String (try (build-run-source (string-as-view &src))))
    (try (check-eq (string-as-view &out) "empty=0\n"))
    (drop &out)
    (drop &src)))

; The refusals. Each names the literal and, where two types clash, both of them.
(deftest s16-litvar-refused-mixed-values
  (try (check-litvar-rejects
         "(defn main ():i32 (let (a:i32 1 b:i64 2) (let (v [a b]) (return 0))))"
         "vector literal: mixed element types -- 'i32' and 'i64'")))
(deftest s16-litvar-refused-int-float
  (try (check-litvar-rejects
         "(defn main ():i32 (let (v [1 2.5]) (return 0)))"
         "vector literal: mixed element types")))
(deftest s16-litvar-refused-int-string
  (try (check-litvar-rejects
         "(defn main ():i32 (let (v [\"a\" 1]) (return 0)))"
         "vector literal: mixed element types")))
(deftest s16-litvar-refused-empty-no-target
  (try (check-litvar-rejects
         "(defn main ():i32 (let (v []) (return 0)))"
         "empty vector literal: use (vector-new)")))
(deftest s16-litvar-refused-narrow-value
  (try (check-litvar-rejects
         "(defn main ():i32 (let (n:i64 5) (with ((v (ref (Vector i32))) [n 1]) (return 0))))"
         "no matching method for overloaded 'conj'")))
(deftest s16-litvar-refused-unspellable
  (try (check-litvar-rejects
         "(defstruct P x:i32) (defn main ():i32 (let (p:(ref P) (alloca P)) (let (v [p p]) (return 0))))"
         "cannot infer an element type from a value of type '&P'")))
(deftest s16-litvar-refused-shadow-head
  (try (check-litvar-rejects
         "(defn vector-lit (x:i32):i32 (return x)) (defn main ():i32 (return 0))"
         "already names a special form")))

; ---------------------------------------------------------------------------
; C's default argument promotions at a variadic call (varargs-promotion.md)
; ---------------------------------------------------------------------------

(defn vararg-run-src ():StrView
  (return "(import-use \"stdio.h\")
(defn main ():i32
  (let (a:i8 65 b:i16 -300 c:ui8 200 d:f32 2.5 e:bool true f:Char \\A)
    (printf \"%d %d %u %f %d %d\\n\" a b c d e f))
  (return 0))
"))

; The run: every promoted type, against the answers C gives for the identical
; program. i16 printed 1321270996 and f32 printed 0.000000.
(deftest s16-vararg-promotion-run
  (let (out:String (try (build-run-source (vararg-run-src))))
    (try (check-eq (string-as-view &out) "65 -300 200 2.500000 1 65\n"))
    (drop &out)))

; The instruction. `bool`/`i8`/`ui8` print correctly under BOTH behaviours, so
; the run above cannot distinguish them -- only the IR can.
(deftest s16-vararg-promotion-ir
  (let (ir:String (try (source-ir (vararg-run-src)))
        iv:StrView (string-as-view &ir)
        l:StrView (try (line-with iv "call i32 (ptr, ...) @printf")))
    (try (check-match l "*i32 %*, i32 %*, i32 %*, double %*, i32 %*, i32 %*"))
    (try (check-not-contains l "i1 %"))
    (try (check-not-contains l "i8 %"))
    (try (check-not-contains l "i16 %"))
    (try (check-not-contains l "float %"))
    (drop &ir)))

; Only the `...` tail promotes. A variadic callee's FIXED narrow parameter keeps
; its declared type -- the promotion is a property of the position, not of the
; type, so a rule applied one argument too early would widen it.
(deftest s16-vararg-promotion-fixed-param-untouched
  (let (h:String (try (test-write-file "fix.h" "int narrowfix(signed char tag, ...);\n"))
        src:String (str "(import-use \"" (string-as-view &h) "\")
(defn go (a:i8 b:i8 c:f32):i32 (return (narrowfix a b c)))
")
        ir:String (try (source-ir (string-as-view &src))))
    (try (check-match (string-as-view &ir)
                      "*@narrowfix(i8 %*, i32 %*, double %*"))
    (drop &ir)
    (drop &src)
    (drop &h)))

; Nothing already `int`-wide or wider is touched -- a spurious promotion would
; be as wrong as a missing one, and costs an instruction per call.
(deftest s16-vararg-promotion-no-spurious-widening
  (let (ir:String (try (source-ir "(import-use \"stdio.h\")
(defn main ():i32
  (let (a:i32 1 b:i64 2 c:f64 3.5 d:ui32 4)
    (printf \"%d %ld %f %u\\n\" a b c d))
  (return 0))
"))
        iv:StrView (string-as-view &ir)
        l:StrView (try (line-with iv "call i32 (ptr, ...) @printf")))
    (try (check-match l "*i32 %*, i64 %*, double %*, i32 %*"))
    (drop &ir)))

; ---------------------------------------------------------------------------
; Colon chains that overshoot a template's arity (container-type-sugar.md §1.2)
; ---------------------------------------------------------------------------

; The refusal must be LOCATED, which is the whole point of the item: the
; surplus symbols used to be collected as tyvars, so a concrete defn was
; reclassified as an uninstantiable template, `emit-defn` skipped its define,
; and nothing at all was reported.
(defn check-chain-refused (body:StrView needle:StrView):!void
  (let (src:String (str "(import-use vector)
(import-use hashmap)
(import-use node)
" body "\n(defn main ():i32 (return 0))\n")
        p:String (try (test-write-file "t.nuc" (string-as-view &src)))
        pv:StrView (string-as-view &p)
        c:Compiled (try (compile-path pv)))
    (try (check-error-at (ref c 'diags) pv 4 needle))
    (drop &c)
    (drop &p)
    (drop &src)
    (return (ok))))

; The three silent rows of §1.2, each naming the template. Bare `ref` is the
; trigger: `ptr` and `raw` are tyname-resolvable, so they overshoot into the
; arity check below instead.
(deftest s16-chain-nested-ref-refused
  (try (check-chain-refused "(defn f (x:ref:Vector:ref:Node):i32 (return 21))"
                            "Vector: 'ref' is a pointer kind"))
  (try (check-chain-refused "(defn f (x:ref:HashMap:CStr:ref:Vector:i32):i32 (return 21))"
                            "HashMap: 'ref' is a pointer kind"))
  (try (check-chain-refused "(defn f (x:ref:HashMap:ref:Vector:i32:i32):i32 (return 21))"
                            "HashMap: 'ref' is a pointer kind")))

; The general net behind that one case: any over-long argument list in a type
; pattern is an arity error.
(deftest s16-chain-arity-refused
  (try (check-chain-refused "(defn f (x:ref:Vector:ptr:i8):i32 (return 21))"
         "Vector: wrong number of type arguments for defstruct template (2 given)"))
  (try (check-chain-refused "(defn f (x:ref:(Vector i32 CStr)):i32 (return 21))"
         "Vector: wrong number of type arguments for defstruct template (2 given)")))

; The guards must not cost the spellings docs/types.md advertises, and a genuine
; tyvar must still be a tyvar. Asserted as a `define` per function, because a
; missing define IS the §1.2 bug.
(deftest s16-chain-working-spellings
  (let (src:StrView "(import-use \"stdio.h\")
(import-use vector)
(import-use hashmap)
(import-use node)
(import-use coll)
(defn ca (x:ref:HashMap:CStr:i32):i32 (return 1))
(defn cb (x:ref:Vector:i32):i32 (return 2))
(defn cc (x:ref:(Vector (ref Node))):i32 (return 3))
(defn cd (x:ref:(HashMap CStr i32)):i32 (return 4))
(defn ce (x:ref:Vector:ptr):i32 (return 5))
(defn tyv (v:(ref (Vector T))):i64 (return (as i64 (count v))))
(defn main ():i32
  (with (v:(ref (Vector i32)) (alloca (Vector i32)))
    (vector-init v)
    (conj v 9)
    (printf \"%d %ld\\n\" (cb v) (tyv v)))
  (return 0))
")
    (let (ir:String (try (source-ir src))
          iv:StrView (string-as-view &ir))
      (try (check-match iv "define i32 @ca(*"))
      (try (check-match iv "define i32 @cb(*"))
      (try (check-match iv "define i32 @cc(*"))
      (try (check-match iv "define i32 @cd(*"))
      (try (check-match iv "define i32 @ce(*"))
      (drop &ir))
    (let (out:String (try (build-run-source src)))
      (try (check-eq (string-as-view &out) "2 1\n"))
      (drop &out))))

; The fuse and the list form are two spellings of one type, not two types:
; asserted as IR equality rather than as a claim (the §3.11 convention). Both
; compile from the same path, so even the module header lines must agree.
(deftest s16-chain-fuse-transparent-ir
  (let (a:String (try (source-ir "(import-use hashmap)
(import-use coll)
(defn t (m:ref:(HashMap CStr i32)):i64 (return (as i64 (count m))))
"))
        b:String (try (source-ir "(import-use hashmap)
(import-use coll)
(defn t (m:(ref (HashMap CStr i32))):i64 (return (as i64 (count m))))
")))
    (try (check-golden (string-as-view &a) (string-as-view &b)))
    (drop &a)
    (drop &b)))

; ---------------------------------------------------------------------------
; Type aliases (container-type-sugar.md §3)
; ---------------------------------------------------------------------------

; An alias works in every declaration position, and composes with the colon
; sugar (§3.9 -- a single-token type name needs no fuse at all).
(deftest s16-deftype-every-position
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use hashset)
(import-use coll)
(deftype NameSet (ref (HashSet CStr)))
(deftype Count i64)
(defstruct Reg names:NameSet)
(defvar gv:Count 7)
(defn size (s:NameSet):Count (return (as Count (count s))))
(defn main ():i32
  (with (s:NameSet (alloca (HashSet CStr)))
    (hashset-init s)
    (conj s (as CStr \"a\"))
    (conj s (as CStr \"b\"))
    (let (t:NameSet s)
      (printf \"%ld %ld\\n\" (size t) gv)))
  (return 0))
")))
    (try (check-eq (string-as-view &out) "2 7\n"))
    (drop &out)))

; Transparency (§3.2) is the load-bearing claim: an alias is a second SPELLING,
; not a second type, so the IR must be identical to the spelled-out program.
; This is also what keeps the bootstrap byte-identical until a source file
; adopts one.
(deftest s16-deftype-transparent-ir
  (let (a:String (try (source-ir "(import-use hashmap)
(import-use coll)
(deftype SymTab (ref (HashMap CStr i32)))
(defn tally (m:SymTab):i64 (return (as i64 (count m))))
"))
        b:String (try (source-ir "(import-use hashmap)
(import-use coll)
(defn tally (m:(ref (HashMap CStr i32))):i64 (return (as i64 (count m))))
")))
    (try (check-golden (string-as-view &a) (string-as-view &b)))
    (drop &a)
    (drop &b)))

; Composition (§3.3): the ?/! sigils, pointer-kind chains, template arguments,
; alias-of-alias, and a forward reference all route through the two resolution
; sites without their own code.
(deftest s16-deftype-composes
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use vector)
(defstruct Pt x:i32 y:i32)
(deftype P Pt)
(deftype PRef (ref P))
(deftype Later i32)
(defn viaq (v:?PRef):i32 (if-some (p v) (return (p 'x)) (return -1)))
(defn chain (v:ref:P):i32 (return (v 'y)))
(defn intmpl (v:(ref (Vector Later))):i32 (return 0))
(defn fwd (n:Later):i32 (return n))
(defn main ():i32
  (with (p:PRef (alloca Pt))
    (set! (p 'x) 3) (set! (p 'y) 4)
    (printf \"%d %d %d\\n\" (viaq p) (chain p) (fwd 5)))
  (return 0))
")))
    (try (check-eq (string-as-view &out) "3 4 5\n"))
    (drop &out)))

; A colliding alias would be DEAD, not merely ambiguous -- `parse-type-name`
; probes aliases last -- so every collision is refused rather than silently
; ignored (§3.4). Both orders, since the check runs on the prescan pass and
; again on the emit pass.
(deftest s16-deftype-collisions-refused
  (try (check-source-rejects "(defstruct Pt x:i32)
(deftype Pt i32)
" "already names a type"))
  (try (check-source-rejects "(import-use vector)
(deftype Vector i32)
" "already names a struct template"))
  (try (check-source-rejects "(defenum E A B)
(deftype E i32)
" "already names an enumeration"))
  (try (check-source-rejects "(deftype i32 i64)\n" "already names a built-in type"))
  (try (check-source-rejects "(deftype Q i32)
(defstruct Q a:i32)
" "already names a type"))
  (try (check-source-rejects "(defn Q ():i32 (return 0))
(deftype Q i32)
" "a symbol may name only one kind of thing"))
  (try (check-source-rejects "(deftype Q i32)
(deftype Q i64)
" "redefinition of 'Q'")))

; Malformed forms, and the §3.6 cycle guard (a recursive body would not
; otherwise terminate).
(deftest s16-deftype-malformed-refused
  (try (check-source-rejects "(deftype Q)\n" "deftype: expects a name and one type"))
  (try (check-source-rejects "(deftype Q i32 i64)\n" "deftype: expects a name and one type"))
  (try (check-source-rejects "(deftype Q:i32 i64)\n" "deftype: takes no type annotation"))
  (try (check-source-rejects "(deftype () i32)\n" "deftype: alias name must be a symbol"))
  (try (check-source-rejects "(deftype (Tbl) i32)\n" "deftype: parameter list required"))
  (try (check-source-rejects "(deftype (Tbl 3) i32)\n"
                             "deftype: each type parameter must be a symbol"))
  (try (check-source-rejects "(deftype A B)
(deftype B A)
(defn f (x:A):i32 (return 0))
" "expands into a cycle")))

; `.nuch` round-trip. The header must CARRY the alias -- an exported defn may
; name it in its signature, and the importer resolves that spelling in its own
; unit. (This is the one part of the design that needed code: the export and
; import dispatches are both explicit form lists.)
(deftest s16-deftype-nuch-roundtrip
  (let (dir:StrView (try (test-scratch))
        lib:String (try (test-write-file "alib.nuc" "(deftype Count i64)
(defn twice (n:Count):Count (return (* n 2)))
"))
        nuch:String (try (emit-for-file "" "--emit-nuch" (string-as-view &lib)))
        hp:String (try (test-write-file "alib.nuch" (string-as-view &nuch)))
        use:String (try (test-write-file "use.nuc" "(import-use \"stdio.h\")
(import-use alib)
(defn main ():i32 (printf \"%ld\\n\" (twice 21)) (return 0))
"))
        out:String (try (build-run-file dir "" (string-as-view &use))))
    (try (check-contains (string-as-view &nuch) "(deftype Count i64)"))
    (try (check-eq (string-as-view &out) "42\n"))
    (drop &out)
    (drop &use)
    (drop &hp)
    (drop &nuch)
    (drop &lib)))

; Privacy here is NAMESPACE-level, as it is for the other four private type
; definers, so the check needs a namespaced library and a consumer outside it --
; spelling the name through the prefix, so a refusal measures privacy and not
; just scope. Plus the positive control that `deftype` still exports.
(deftest s16-deftype-private-namespaced
  (let (dir:StrView (try (test-scratch))
        lib:String (try (test-write-file "tplib.nuc" "(ns t16p)
(deftype- T16Hidden i64)
(deftype T16Public i64)
(defn- t16-inside (n:T16Hidden):T16Hidden (return (* n 3)))
(defn t16-pub (n:T16Public):T16Public (return (t16-inside n)))
"))
        nuch:String (try (emit-for-file dir "--emit-nuch" (string-as-view &lib)))
        hp:String (try (test-write-file "tplib.nuch" (string-as-view &nuch)))
        outp:String (try (test-write-file "tp-out.nuc" "(import-prefixed tplib tp)
(defn t16-take (n:tp/T16Hidden):i64 (return n))
(defn main ():i32 (return 0))
"))
        pubp:String (try (test-write-file "tp-pub.nuc" "(import-prefixed tplib tp)
(defn t16-take (n:tp/T16Public):i64 (return n))
(defn main ():i32 (return 0))
"))
        bad:Compiled (try (compile-path-in dir (string-as-view &outp)))
        good:Compiled (try (compile-path-in dir (string-as-view &pubp))))
    (try (check-contains (string-as-view (ref bad 'raw)) "T16Hidden"))
    (try (check-empty (string-as-view (ref good 'raw))))
    (try (check-not-contains (string-as-view &nuch) "T16Hidden"))
    (try (check-contains (string-as-view &nuch) "T16Public"))
    (drop &good)
    (drop &bad)
    (drop &pubp)
    (drop &outp)
    (drop &hp)
    (drop &nuch)
    (drop &lib)))

; The C header must show the alias's BODY. It has no C spelling of its own, and
; `type-node-to-c` resolved names by spelling -- so the alias name leaked out as
; `struct Count`, naming nothing the header defines. Asserted against the
; spelled-out program, which is the only definition of "right" here.
(deftest s16-deftype-cheader-expands
  (let (a:String (try (source-cheader "(defstruct Pt x:i32 y:i32)
(deftype Count i64)
(deftype PtRef (ref Pt))
(defn twice (n:Count):Count (return (* n 2)))
(defn getx (p:PtRef):i32 (return (p 'x)))
"))
        b:String (try (source-cheader "(defstruct Pt x:i32 y:i32)
(defn twice (n:i64):i64 (return (* n 2)))
(defn getx (p:(ref Pt)):i32 (return (p 'x)))
")))
    (try (check-golden (string-as-view &a) (string-as-view &b)))
    (drop &a)
    (drop &b)))

; The REPL has its own top-level form chain; without an arm there `deftype` was
; `unknown: deftype` and every later use of the name failed too.
(deftest s16-deftype-repl
  (let (out:String (try (repl-session "(deftype C i64)
(defn d (n:C):C (return (* n 2)))
(d 21)
")))
    (try (check-contains (string-as-view &out) "42"))
    (drop &out)))

; ---------------------------------------------------------------------------
; Parametric type aliases (container-type-sugar.md §3.7)
; ---------------------------------------------------------------------------

; Every declaration position, plus a colon-spelled body (`(Ref T) ref:T`), which
; substitutes segment-wise rather than by node.
(deftest s16-deftype-parametric-every-position
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use vector)
(import-use hashmap)
(import-use coll)
(deftype (Vec T) (ref (Vector T)))
(deftype (Table V) (ref (HashMap CStr V)))
(deftype (Ref T) ref:T)
(defstruct Pt x:i32 y:i32)
(defstruct Reg items:(Vec i32) names:(Table i32))
(defn total (v:(Vec i32)):i64 (return (as i64 (count v))))
(defn look (m:(Table i32)):i64 (return (as i64 (count m))))
(defn getx (p:(Ref Pt)):i32 (return (p 'x)))
(defn main ():i32
  (with (v:(Vec i32) (alloca (Vector i32))
         m:(Table i32) (alloca (HashMap CStr i32))
         p:(Ref Pt) (alloca Pt))
    (vector-init v) (hashmap-init m)
    (conj v 4) (conj v 5)
    (assoc m \"a\" 1)
    (set! (p 'x) 9)
    (printf \"%ld %ld %d\\n\" (total v) (look m) (getx p)))
  (return 0))
")))
    (try (check-eq (string-as-view &out) "2 1 9\n"))
    (drop &out)))

; §3.7's stated hard case: a generic template whose RECEIVER is an alias
; application, instantiated at two element types. This is the one that needed
; `collect-pattern-tyvars` and `unify-tpat` taught about aliases.
(deftest s16-deftype-parametric-receiver
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use vector)
(import-use coll)
(deftype (Vec T) (ref (Vector T)))
(defn second (v:(Vec T)):T (return (invoke v (as usize 1))))
(defn main ():i32
  (with (a:(Vec i32) (alloca (Vector i32))
         b:(Vec CStr) (alloca (Vector CStr)))
    (vector-init a) (vector-init b)
    (conj a 10) (conj a 20)
    (conj b \"x\") (conj b \"y\")
    (printf \"%d %s\\n\" (second a) (second b)))
  (return 0))
")))
    (try (check-eq (string-as-view &out) "20 y\n"))
    (drop &out)))

; Transparency, including the generic `t3`, whose stamped instance must mangle
; from the expansion and not from the alias name.
(deftest s16-deftype-parametric-transparent-ir
  (let (a:String (try (source-ir "(import-use vector)
(import-use hashmap)
(import-use coll)
(deftype (Vec T) (ref (Vector T)))
(deftype (Table V) (ref (HashMap CStr V)))
(defn t1 (v:(Vec i32)):i64 (return (as i64 (count v))))
(defn t2 (m:(Table i32)):i64 (return (as i64 (count m))))
(defn t3 (v:(Vec T)):i64 (return (as i64 (count v))))
(defn use ():i64 (return (t3 (unsafe/cast (ref (Vector CStr)) null))))
"))
        b:String (try (source-ir "(import-use vector)
(import-use hashmap)
(import-use coll)
(defn t1 (v:(ref (Vector i32))):i64 (return (as i64 (count v))))
(defn t2 (m:(ref (HashMap CStr i32))):i64 (return (as i64 (count m))))
(defn t3 (v:(ref (Vector T))):i64 (return (as i64 (count v))))
(defn use ():i64 (return (t3 (unsafe/cast (ref (Vector CStr)) null))))
")))
    (try (check-golden (string-as-view &a) (string-as-view &b)))
    (drop &a)
    (drop &b)))

; Arity in both directions, a bare application, and the colon-body limit. A
; cycle must be caught on the PATTERN path too: the depth guard in
; `parse-type-from-node` does not cover `collect-pattern-tyvars`, which reaches
; a defn parameter first and looped forever until it got its own.
(deftest s16-deftype-parametric-refusals
  (try (check-source-rejects "(import-use vector)
(deftype (Vec T) (ref (Vector T)))
(defn f (v:(Vec i32 CStr)):i32 (return 0))
" "Vec: wrong number of type arguments for type alias (2 given)"))
  (try (check-source-rejects "(import-use hashmap)
(deftype (Table K V) (ref (HashMap K V)))
(defn f (m:(Table CStr)):i32 (return 0))
" "Table: wrong number of type arguments for type alias (1 given)"))
  (try (check-source-rejects "(import-use vector)
(deftype (Vec T) (ref (Vector T)))
(defn f (v:Vec):i32 (return 0))
" "type alias 'Vec' takes 1 type arguments"))
  (try (check-source-rejects "(import-use node)
(deftype (Ref T) ref:T)
(defn f (v:(Ref (ref Node))):i32 (return 0))
" "must be a single token"))
  (try (check-source-rejects "(deftype (A T) (A T))
(defn f (v:(A i32)):i32 (return 0))
" "expands into a cycle"))
  (try (check-source-rejects "(deftype (A T) (B T))
(deftype (B T) (A T))
(defn f (v:(A i32)):i32 (return 0))
" "expands into a cycle")))

; A parametric alias crosses a `.nuch` and a real object-file link: the header
; must carry the `deftype` itself, since the `declare` beside it spells its
; parameters in terms of the alias.
(deftest s16-deftype-parametric-nuch-roundtrip
  (let (lib:String (try (test-write-file "plib.nuc" "(import-use vector)
(import-use coll)
(deftype (Vec T) (ref (Vector T)))
(defn plen (v:(Vec i32)):i64 (return (as i64 (count v))))
"))
        libv:StrView (string-as-view &lib)
        nuch:String (try (emit-for-file "" "--emit-nuch" libv))
        hp:String (try (test-write-file "plib.nuch" (string-as-view &nuch)))
        dir:StrView (try (test-scratch))
        obj:String (str dir "/plib.o")
        usesrc:String (str "(import-use \"stdio.h\")
(import-use vector)
(import-use coll)
(import-use \"" (string-as-view &hp) "\")
(defn main ():i32
  (with (v:(ref (Vector i32)) (alloca (Vector i32)))
    (vector-init v) (conj v 1) (conj v 2) (conj v 3)
    (printf \"%ld\\n\" (plen v)))
  (return 0))
")
        use:String (try (test-write-file "use.nuc" (string-as-view &usesrc))))
    (try (check-contains (string-as-view &nuch)
                         "(deftype (Vec T) (ref (Vector T)))"))
    (try (compile-object libv (string-as-view &obj)))
    (let (linkarg:String (str "--link-arg=" (string-as-view &obj))
          out:String (try (build-run-file "" (string-as-view &linkarg)
                                          (string-as-view &use))))
      (try (check-eq (string-as-view &out) "3\n"))
      (drop &out)
      (drop &linkarg))
    (drop &use)
    (drop &obj)
    (drop &hp)
    (drop &nuch)
    (drop &lib)))

; The C header has no spelling for an alias, parametric or not, so it must show
; the expansion.
(deftest s16-deftype-parametric-cheader-expands
  (let (a:String (try (source-cheader "(import-use vector)
(import-use coll)
(deftype (Vec T) (ref (Vector T)))
(defn plen (v:(Vec i32)):i64 (return (as i64 (count v))))
"))
        b:String (try (source-cheader "(import-use vector)
(import-use coll)
(defn plen (v:(ref (Vector i32))):i64 (return (as i64 (count v))))
")))
    (try (check-golden (string-as-view &a) (string-as-view &b)))
    (drop &a)
    (drop &b)))

(deftest s16-deftype-parametric-repl
  (let (out:String (try (repl-session "(deftype (Pair T) (ptr T))
(defn takes (p:(Pair i32)):i32 (return (aref p 0)))
(let (a:ptr:i32 (array i32 41 42)) (takes a))
")))
    (try (check-contains (string-as-view &out) "41"))
    (drop &out)))

; ---------------------------------------------------------------------------
; Types stamped inside a `compile-time` body (Stage 16 D9, repl-libraries.md §3.3)
; ---------------------------------------------------------------------------

(defn d9-ct-stamp-src ():StrView
  (return "(import-use \"stdio.h\")
(compile-time
  (defn d9-ct-maybe (n:i32):?i32 (some n))
  (match (d9-ct-maybe 7)
    ((some v) (printf \"d9 ct some %d\\n\" v))
    (none (printf \"d9 ct none\\n\"))))
(defn main ():i32 (return 0))
"))

; A `?i32` whose `%Maybe.i32` is stamped INSIDE the compile-time body. Pre-D9:
; `IR parse error: Cannot allocate unsized type %Maybe.i32`. A batch failure,
; not a REPL one -- the design note framed it as REPL-only.
(deftest s16-d9-ct-body-stamp
  (let (c:Compiled (try (compile-source (d9-ct-stamp-src)))
        raw:StrView (string-as-view (ref c 'raw)))
    (try (check-contains raw "d9 ct some 7"))
    (try (check-not-contains raw "IR parse error"))
    (drop &c)))

; The drain that fixes the above writes into the PROGRAM's type buffer, and the
; final drain runs over the same queue -- so the line must arrive exactly once.
; A count, not a presence test: a double emit is what a re-drain gets wrong.
(deftest s16-d9-ct-type-once
  (let (ir:String (try (source-ir (d9-ct-stamp-src))))
    (try (check-eq-int (count-lines-with-prefix (string-as-view &ir)
                                                "%Maybe.i32 = type")
                       1 "%Maybe.i32 definitions"))
    (drop &ir)))

; `emit-defstruct` queues every StructDef it writes, so the shared drain sees
; types whose line is already in the buffer. `sdef-in-module` is what keeps that
; inert; assert it over a program with several structs.
(deftest s16-d9-no-duplicate-type-lines
  (let (c:Compiled (try (compile-path "examples/struct.nuc"))
        ir:StrView (string-as-view (ref c 'ir))
        dup:StrView (duplicate-type-name ir))
    (try (check-non-empty ir))
    (when (not (= dup "")) (fail! "type defined twice: " dup))
    (drop &c)))

; The ruling: a `defstruct` inside a `compile-time` body defines a PROGRAM type,
; so its line goes to the module's own type buffer rather than the CT module's.
; Pre-D9 this exited 0 from `--emit-llvm` with three `%D9P` references and no
; `%D9P = type` line, and died only at `-o`. Three assertions, because each
; catches a different way to get it wrong: the count is 1 (0 = the old bug,
; 2 = written to both buffers), the binary links, and it computes.
(deftest s16-d9-ct-defstruct-is-program-type
  (let (src:StrView "(import-use \"stdio.h\")
(compile-time (defstruct D9P x:i32 y:i32))
(defn d9-sum (a:i32 b:i32):i32
  (let (q:ptr:D9P (as ptr:D9P (alloca D9P)))
    (set! (q 'x) a) (set! (q 'y) b) (return (+ (q 'x) (q 'y)))))
(defn main ():i32 (printf \"%d\\n\" (d9-sum 3 4)) (return 0))
")
    (let (c:Compiled (try (compile-source src)))
      (try (check-not-contains (string-as-view (ref c 'raw)) "IR parse error"))
      (try (check-eq-int (count-lines-with-prefix (string-as-view (ref c 'ir))
                                                  "%D9P = type")
                         1 "%D9P definitions"))
      (drop &c))
    (let (out:String (try (build-run-source src)))
      (try (check-eq (string-as-view &out) "7\n"))
      (drop &out))))

; D9 residue: the same type named in a SIGNATURE. This failed EARLIER -- before
; any emission -- because `prescan-struct-names` was a flat walk over the
; top-level form list and never descended into a `compile-time` body. The
; by-value `defn` is placed BEFORE the block deliberately: it needs the LAYOUT,
; not just the name, and an unlaid-out struct is sized 0 rather than diagnosed
; (`define i32 @f(i0 %p.arg)`) -- so the assertion is on the lowered parameter
; type as well as on the value.
(deftest s16-d9-ct-type-in-signature
  (let (src:StrView "(import-use \"stdio.h\")
(defn d9-byval (p:D9V):i32 (return (+ (p 'x) (p 'y))))
(compile-time (defstruct D9V x:i32 y:i32))
(defn d9-byref (p:(ref D9V)):i32 (return (* (p 'x) (p 'y))))
(defn main ():i32
  (let (q:D9V (D9V 3 4))
    (printf \"%d %d\\n\" (d9-byval q) (d9-byref (as ref:D9V &q))))
  (return 0))
")
    (let (ir:String (try (source-ir src)))
      (try (check-match (string-as-view &ir) "define i32 @d9-byval(i64 *"))
      (drop &ir))
    (let (out:String (try (build-run-source src)))
      (try (check-eq (string-as-view &out) "7 12\n"))
      (drop &out))))

; The same, one level in: `emit-compile-time` runs its own defn-signature
; prescan BEFORE its body-form loop, so a `defn` in the block naming a
; `defstruct` in the same block hit the identical ordering.
(deftest s16-d9-ct-type-in-ct-signature
  (let (c:Compiled (try (compile-source "(import-use \"stdio.h\")
(compile-time
  (defstruct D9Q x:i32 y:i32)
  (defn d9-ct-sum (p:(ref D9Q)):i32 (return (+ (p 'x) (p 'y))))
  (let (q:ptr:D9Q (as ptr:D9Q (alloca D9Q)))
    (set! (q 'x) 5) (set! (q 'y) 6)
    (printf \"d9 ct inner %d\\n\" (d9-ct-sum (as ref:D9Q q)))))
(defn main ():i32 (return 0))
"))
        raw:StrView (string-as-view (ref c 'raw)))
    (try (check-contains raw "d9 ct inner 11"))
    (try (check-not-contains raw "IR parse error"))
    (drop &c)))

; The descent mirrors `emit-compile-time`'s SKIPS, not just its walk. That loop
; has an arm for `defstruct` and for nothing else this prescan registers, so a
; name it would never define must stay UNKNOWN -- registering one resolves the
; signature, writes no `%Name = type` line, and exits 0 on invalid IR, which is
; strictly worse than the diagnostic.
(deftest s16-d9-ct-descent-mirrors-skips
  (try (check-source-rejects "(compile-time (defstruct- D9K x:i32))
(defn d9-skip (p:(ref D9K)):i32 (return 0))
(defn main ():i32 (return 0))
" "unknown type: D9K"))
  (try (check-source-rejects "(compile-time (defunion D9K (a x:i32) (b)))
(defn d9-skip (p:(ref D9K)):i32 (return 0))
(defn main ():i32 (return 0))
" "unknown type: D9K"))
  (try (check-source-rejects "(compile-time (deftype D9K i32))
(defn d9-skip (p:(ref D9K)):i32 (return 0))
(defn main ():i32 (return 0))
" "unknown type: D9K"))
  (try (check-source-rejects "(compile-time (compile-time (defstruct D9K x:i32)))
(defn d9-skip (p:(ref D9K)):i32 (return 0))
(defn main ():i32 (return 0))
" "unknown type: D9K")))

; ---------------------------------------------------------------------------
; `&T` as a spelling of `(ref T)` (Stage 16 §RS)
; ---------------------------------------------------------------------------

; Sugar, not a second type: both spellings emit byte-identical IR.
(deftest s16-ref-sigil-ir-identical
  (let (a:String (try (source-ir "(import-use node)
(import-use vector)
(defstruct Pt x:i32 y:i32)
(defn s1 (p:&Pt):i32 (return (+ (p 'x) (p 'y))))
(defn id1 (p:&Pt):&Pt (return p))
(defn dd (pp:&&Pt):i32 (return (s1 (deref pp))))
(defn tot (v:&(Vector &Pt)):i32
  (let (s:i32 0) (dotimes (i (count v)) (set! s (+ s (s1 (v i))))) (return s)))
"))
        b:String (try (source-ir "(import-use node)
(import-use vector)
(defstruct Pt x:i32 y:i32)
(defn s1 (p:ref:Pt):i32 (return (+ (p 'x) (p 'y))))
(defn id1 (p:ref:Pt):ref:Pt (return p))
(defn dd (pp:ref:ref:Pt):i32 (return (s1 (deref pp))))
(defn tot (v:ref:(Vector ref:Pt)):i32
  (let (s:i32 0) (dotimes (i (count v)) (set! s (+ s (s1 (v i))))) (return s)))
")))
    (try (check-golden (string-as-view &a) (string-as-view &b)))
    (drop &a)
    (drop &b)))

; The sigil is only a *leading* `&`, so a mid-token `&` (as in `a&b`, and in the
; compiler) keeps its name, and the two spellings compose in one file.
(deftest s16-ref-sigil-field-address-unclaimed
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(defstruct Pt x:i32 y:i32)
(defn bump (p:&Pt):i32
  (let (xp:&i32 (ref p 'x))
    (set! (deref xp) (+ (deref xp) 1))
    (return (p 'x))))
(defn main ():i32
  (let (a:Pt (Pt 1 2) ap:&Pt &a)
    (printf \"%d\\n\" (bump ap))
    (return 0)))
")))
    (try (check-eq (string-as-view &out) "2\n"))
    (drop &out)))

; `&T` IS `(ref T)`, so it carries `ref`'s non-null obligation, and the
; whitespace near-miss is the same reader error `name: (T)` gets.
(deftest s16-ref-sigil-rules-preserved
  (try (check-source-rejects "(defstruct Pt x:i32)
(defvar p:&Pt null)
" "defvar: raw pointer where non-null (ref ...) is required"))
  (try (check-source-rejects "(defstruct Pt x:i32)
(defn f (p:&Pt):i32 (return 0))
(defn g (q:raw:Pt):i32 (return (f q)))
" "argument: raw pointer where non-null (ref ...) is required"))
  (try (check-source-rejects "(defstruct Pt x:i32)
(defn f (p:& Pt):i32 (return 0))
" "binding name ends in ':'")))

; A `.nuch` is a serialization format and the sigil is a *reader* rule -- so a
; header must carry the canonical `(ref T)` / `:ref:T` spelling and no `&` at
; all, or an importer re-reads a form the exporter never meant.
(deftest s16-ref-sigil-nuch-roundtrip
  (let (libdir:String (try (test-scratch-sub "lib"))
        dirv:StrView (string-as-view &libdir)
        src:String (try (test-write-file "siglib.nuc" "(defstruct Pt x:i32 y:i32)
(defn pt-sum (p:&Pt):i32 (return (+ (p 'x) (p 'y))))
(defn pt-id (p:&Pt):&Pt (return p))
"))
        nuch:String (try (emit-for-file "" "--emit-nuch" (string-as-view &src)))
        hp:String (try (test-write-file "lib/siglib.nuch" (string-as-view &nuch)))
        use:String (try (test-write-file "siguse.nuc" "(import-use \"stdio.h\")
(import-use siglib)
(defn main ():i32
  (let (a:Pt (Pt 4 5) ap:&Pt &a)
    (printf \"%d\\n\" (pt-sum (pt-id ap)))
    (return 0)))
"))
        nv:StrView (string-as-view &nuch))
    (try (check-contains nv "((p (ref Pt)))"))
    (try (check-contains nv ":ref:Pt"))
    (try (check-not-contains nv "&"))
    (let (out:String (try (build-run-file dirv "" (string-as-view &use))))
      (try (check-eq (string-as-view &out) "9\n"))
      (drop &out))
    (drop &use)
    (drop &hp)
    (drop &nuch)
    (drop &src)
    (drop &libdir)))

; A `&` that starts a token is the address-of reader macro, and it is sugar in
; the same strict sense: identical IR to the `(ref x)` it reads as.
(deftest s16-ref-sigil-ref-ir-identical
  (let (a:String (try (source-ir "(defstruct Pt x:i32 y:i32)
(defn s1 (p:&Pt):i32 (return (+ (p 'x) (p 'y))))
(defn go ():i32 (let (a:Pt (Pt 1 2)) (return (s1 &a))))
"))
        b:String (try (source-ir "(defstruct Pt x:i32 y:i32)
(defn s1 (p:&Pt):i32 (return (+ (p 'x) (p 'y))))
(defn go ():i32 (let (a:Pt (Pt 1 2)) (return (s1 (ref a)))))
")))
    (try (check-golden (string-as-view &a) (string-as-view &b)))
    (drop &a)
    (drop &b)))

; The two meanings are split by token position, not by context, so they have to
; compose: `(as &Pt &p)` is a type and an operator in one form, and a standalone
; `&T` in a type slot is the same `(ref T)` node the value form is (PK-1).
(deftest s16-ref-sigil-both-meanings
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(defstruct Pt x:i32 y:i32)
(defstruct Holder (link &Pt) (tag i32))
(defn hx (h:&Holder):i32 (return ((h 'link) 'x)))
(defn main ():i32
  (let (a:Pt (Pt 3 4) ap:&Pt &a)
    (printf \"%d %d %d\\n\" ((as &Pt &a) 'x) (unsafe/cast i32 (sizeof &Pt)) ((deref &ap) 'y))
    (return 0)))
")))
    (try (check-eq (string-as-view &out) "3 8 4\n"))
    (drop &out)))

; ---------------------------------------------------------------------------
; `:noreturn` / `:returns-twice` (Stage 16 §DA)
; ---------------------------------------------------------------------------

; One test, as in the shell -- but the shell accumulated `bad=1` and reported at
; the end, which is the hand-rolled accumulator `!void` exists to replace: here
; the first failure ends the test and names itself.
(deftest s16-decl-attrs
  ; 1. The `define`. Both attributes, in either order, and both on one function.
  (let (src:StrView "(import-use \"stdio.h\")
(import-use \"stdlib.h\")
(defn sj (b:ptr):i32 :returns-twice (return 0))
(defn boom (m:CStr):void :noreturn (printf \"%s\\n\" m) (exit 3))
(defn both (m:CStr):void :noreturn :returns-twice (printf \"%s\\n\" m) (exit 3))
(defn plain (x:i32):i32 (return x))
(defn main ():i32 (printf \"%d\\n\" (sj null)) (return 0))
")
    (let (ir:String (try (source-ir src))
          iv:StrView (string-as-view &ir))
      ; Anchored at the start of the line, since a `define` also carries its
      ; `section`.
      (try (check-match iv "define i32 @sj(ptr %b.arg) returns_twice *"))
      (try (check-match iv "define void @boom(ptr %m.arg) noreturn *"))
      (try (check-match iv "define void @both(ptr %m.arg) noreturn returns_twice *"))
      ; A function with no attribute must gain none.
      (try (check-not-contains iv "define i32 @plain(i32 %x.arg) noreturn"))
      (try (check-not-contains iv "define i32 @plain(i32 %x.arg) returns_twice"))
      (drop &ir))
    (let (out:String (try (build-run-source src)))
      (try (check-eq (string-as-view &out) "0\n"))
      (drop &out)))
  ; 2. A top-level `(declare … :noreturn)` still drives `terminate-after-noreturn`
  ;    (the one Nucleus-side consumer), and `:returns-twice` rides the declare.
  (let (ir:String (try (source-ir "(declare my_abort ():void :noreturn)
(declare my_sj (b:ptr):i32 :returns-twice)
(defn main ():i32 (my_abort) (return 0))
"))
        iv:StrView (string-as-view &ir))
    (try (check-line iv "declare void @my_abort() noreturn"))
    (try (check-line iv "declare i32 @my_sj(ptr) returns_twice"))
    (try (check-line iv "  unreachable"))
    (drop &ir))
  ; 3. `.nuch` round-trip, solitary AND overloaded -- the exporter and the two
  ;    importers are three separate dispatch sites, and a missing one is silent.
  ;    `resolve-import` tries `.nuc` everywhere before any `.nuch`, so the source
  ;    sits outside every search directory or the header is never read.
  (let (libdir:String (try (test-scratch-sub "lib"))
        srcdir:String (try (test-scratch-sub "src"))
        lib:String (try (test-write-file "src/atlib.nuc" "(import-use \"stdio.h\")
(import-use \"stdlib.h\")
(defn sj (b:ptr):i32 :returns-twice (return 0))
(defn sj (b:ptr n:i32):i32 :returns-twice (return n))
(defn nope (m:CStr):void :noreturn (printf \"%s\\n\" m) (exit 3))
"))
        nuch:String (try (emit-for-file "" "--emit-nuch" (string-as-view &lib)))
        hp:String (try (test-write-file "lib/atlib.nuch" (string-as-view &nuch)))
        use:String (try (test-write-file "u.nuc" "(import-use \"stdio.h\")
(import-use atlib)
(defn main ():i32 (printf \"%d\\n\" (sj null)) (nope \"bye\") (return 0))
"))
        nv:StrView (string-as-view &nuch))
    (try (check-contains nv "(declare nope ((m CStr)) :void :noreturn)"))
    (try (check-contains nv ":i32 :returns-twice)"))
    (let (c:Compiled (try (compile-path-in (string-as-view &libdir)
                                           (string-as-view &use)))
          iv:StrView (string-as-view (ref c 'ir)))
      (try (check-line iv "declare i32 @sj.ptr(ptr) returns_twice"))
      (try (check-line iv "declare i32 @sj.ptr.i32(ptr, i32) returns_twice"))
      (try (check-line iv "declare void @nope(ptr) noreturn"))
      (drop &c))
    (drop &use)
    (drop &hp)
    (drop &nuch)
    (drop &lib)
    (drop &srcdir)
    (drop &libdir))
  ; 4. The retired bare spellings each name their replacement. Without this they
  ;    fall through as ordinary symbols -- a body expression, or (in a declare) a
  ;    phantom trailing operand -- and fail somewhere unrelated.
  (try (check-source-rejects "(defn f (m:CStr):void noreturn (while (= 0 0) 0))\n"
         "'noreturn' is no longer a declaration attribute -- write ':noreturn'"))
  (try (check-source-rejects "(declare foo ():void noreturn)
(defn main ():i32 (return 0))
" "'noreturn' is no longer a declaration attribute -- write ':noreturn'"))
  (try (check-source-rejects "(declare foo ():i32 returns_twice)
(defn main ():i32 (return 0))
" "'returns_twice' is no longer a declaration attribute -- write ':returns-twice'"))
  ; 5. A LONE trailing form is the body, never an attribute -- otherwise a
  ;    keyword-returning one-expression body would be silently eaten.
  (let (src:StrView "(import-use \"stdio.h\")
(import-use keyword)
(defn kw ():Keyword :noreturn)
(defn main ():i32 (printf \"%d\\n\" (if (= (kw) :noreturn) 1 0)) (return 0))
")
    (let (ir:String (try (source-ir src)))
      (try (check-not-match (string-as-view &ir) "*@kw(*) noreturn*"))
      (drop &ir))
    (let (out:String (try (build-run-source src)))
      (try (check-eq (string-as-view &out) "1\n"))
      (drop &out))))

; ---------------------------------------------------------------------------
; `import-ct` — a library the program uses only at compile time (Stage 16)
; ---------------------------------------------------------------------------

; The definitions really are gone: one `define`, for `main`.
(deftest s16-import-ct-emits-no-definitions
  (let (ir:String (try (source-ir "(import-ct node)
(defn main ():i32 (return 0))
")))
    (try (check-eq-int (count-lines-with-prefix (string-as-view &ir) "define ")
                       1 "definitions in the module"))
    (drop &ir)))

; The promise is kept at the two kinds of use: the compiler-synthesized one (a
; quote lowers to @intern-symbol) and the ordinary one (a direct call).
(deftest s16-import-ct-quote-refused
  (try (check-source-rejects "(import-ct node)
(defn main ():i32 (let (s:(ref Node) (quote a)) (return 0)))
" "quote needs the node runtime")))

(deftest s16-import-ct-call-refused
  (try (check-source-rejects "(import-ct node)
(defn main ():i32 (return (node-len null)))
" "imported compile-time-only")))

; …and it is a REFUSAL, not a link error: the message names a location in the
; user's file, which is the whole reason the check exists. The shell grepped for
; the message and again for `:2:`; one `check-error-at` requires both of the
; same diagnostic.
(deftest s16-import-ct-refusal-is-located
  (let (p:String (try (test-write-file "t.nuc" "(import-ct node)
(defn main ():i32 (return (node-len null)))
"))
        pv:StrView (string-as-view &p)
        c:Compiled (try (compile-path pv)))
    (try (check-error-at (ref c 'diags) pv 2 "imported compile-time-only"))
    (drop &c)
    (drop &p)))

; Order independence. `lib/error.nuc` does `(import-ct node)`, so a program that
; uses error handling AND quotes must get the runtime either way round. Getting
; this wrong is silent in one order and a refusal in the other.
(deftest s16-import-ct-real-import-wins-ct-first
  (let (ir:String (try (source-ir "(import-use error)
(import-use node)
(defn main ():i32 (let (s:(ref Node) (quote a)) (return 0)))
")))
    (try (check-match (string-as-view &ir) "define *@intern-symbol(*"))
    (drop &ir)))

(deftest s16-import-ct-real-import-wins-real-first
  (let (ir:String (try (source-ir "(import-use node)
(import-use error)
(defn main ():i32 (let (s:(ref Node) (quote a)) (return 0)))
")))
    (try (check-match (string-as-view &ir) "define *@intern-symbol(*"))
    (drop &ir)))

; The unit-level rule reaches THROUGH a ct-imported library: `ctlib` is
; compile-time-only, but the `vector` it pulls in is one the program itself
; imports, so vector must stay real — and, because a template stamp belongs to
; no file, `(Vector i32)` must still be instantiated into the program. Measured
; before the fix: every vector definition came out ct-only and the program was
; refused at its own `[1 2 3]`.
(deftest s16-import-ct-nested-real-import-survives
  (let (libdir:String (try (test-scratch-sub "l"))
        lib:String (try (test-write-file "l/ctlib.nuc" "(import-use vector)
(defn ctlib-count ((v (ref (Vector i32)))):usize (return (count v)))
"))
        use:String (try (test-write-file "nested.nuc" "(import-use \"stdio.h\")
(import-ct ctlib)
(import-use vector)
(defn main ():i32
  (with ((v (ref (Vector i32))) [1 2 3])
    (printf \"%d\\n\" (unsafe/cast i32 (count v))))
  (return 0))
"))
        out:String (try (build-run-file (string-as-view &libdir) ""
                                        (string-as-view &use))))
    (try (check-eq (string-as-view &out) "3\n"))
    (drop &out)
    (drop &use)
    (drop &lib)
    (drop &libdir)))

; What `import-ct` is FOR: the compile-time surface is really registered, so a
; macro body may call the library's functions. `with-handler` (lib/error) is the
; in-tree case — it calls `node-at` under `(import-ct node)` — and it must still
; expand in a program carrying no node runtime at all.
(deftest s16-import-ct-macro-runs-with-no-runtime
  (let (src:StrView "(import-use \"stdio.h\")
(import-use error)
(deferror EGone \"gone\")
(defn probe ((e Err) (ctx ptr)):(Maybe i32) (return (some 7)))
(defn risky (x:i32):!i32 (if (< x 0) (return (err EGone)) (return (ok x))))
(defn main ():i32
  (with-handler (EGone i32 probe null)
    (match (risky -1) ((ok v) (printf \"%d\\n\" v)) ((err e) (printf \"unrepaired\\n\"))))
  (return 0))
")
    (let (out:String (try (build-run-source src)))
      (try (check-eq (string-as-view &out) "7\n"))
      (drop &out))
    (let (ir:String (try (source-ir src))
          iv:StrView (string-as-view &ir))
      (try (check-not-match iv "define *@alloc-node(*"))
      (try (check-not-match iv "define *@node-list-new(*"))
      (try (check-not-match iv "define *@intern-symbol(*"))
      (try (check-not-match iv "define *@arena-alloc(*"))
      (drop &ir))))

; Arity, so a typo is a diagnostic rather than a silent no-op.
(deftest s16-import-ct-arity
  (try (check-source-rejects "(import-ct)
(defn main ():i32 (return 0))
" "import-ct: expected (import-ct name)")))

; ---------------------------------------------------------------------------
; `:rest` / `:optional` / `:where` / `:repr` (keyword-markers.md)
; ---------------------------------------------------------------------------

; All four markers, plus the two shapes that could have collided with one:
; `:where(Ord T)` with no separating space (the reader's colon-paren fuse keys
; on a TRAILING colon, so a keyword must not trigger it), and an `:optional`
; default that is itself a keyword VALUE one level down. `Ord3`/`less3` rather
; than `Ord`/`less`: lib/numeric.nuc defines those and `import-use keyword`
; reaches it, so the obvious names are a redefinition.
(deftest s16-keyword-markers-accepted
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use node)
(import-use keyword)
(defprotocol Ord3 (less3 (a:Self b:Self):bool))
(defn less3 (a:i32 b:i32):bool (return (< a b)))
(extend i32 Ord3)
(defstruct Point x:i32 y:i32)
(defunion Shape (circle p:(ref Point)) none :repr tagged)
(defn sum (:rest args:i64):i64
  (let (lst:raw:Node (unsafe/cast raw:Node args)
        total:i64 0)
    (dotimes (i (node-len lst))
      (set! total (+ total (unsafe/cast i64 (node-at lst i)))))
    total))
(defn maxv (a:T b:T :where (Ord3 T)):T (return (if (less3 a b) b a)))
(defn minv (a:T b:T :where(Ord3 T)):T (return (if (less3 b a) b a)))
(defn kw-default (n:i32 :optional (k:Keyword :fallback)):i32 (return n))
(defn greet (n:i32 :optional (m:i32 7)):i32 (return (+ n m)))
(defmacro twice (x :rest r) `(+ ~x ~x))
(defn main ():i32
  (printf \"%ld %d %d %d %d %d\\n\"
    (sum 1 2 3 4) (maxv 3 9) (minv 3 9) (greet 1) (greet 1 2) (twice 5))
  (return (kw-default 0)))
")))
    (try (check-eq (string-as-view &out) "10 9 3 8 3 10\n"))
    (drop &out)))

; Every retired `&x` spelling names its replacement, from the definer that owns
; it. Without this each one falls through as an ordinary symbol and surfaces as
; `missing :type on param '&rest'` or `unknown type: T`.
(deftest s16-keyword-markers-legacy-rejected
  (try (check-source-rejects "(defn f (a:i32 &rest xs:i64):i64 (return 0))\n"
         "'&rest' is no longer a marker -- write ':rest'"))
  (try (check-source-rejects "(defn f (n:i32 &optional (m:i32 7)):i32 (return n))\n"
         "'&optional' is no longer a marker -- write ':optional'"))
  (try (check-source-rejects "(defprotocol Ord (less (a:Self b:Self):bool))
(defn maxv (a:T b:T &where (Ord T)):T (return a))
" "'&where' is no longer a marker -- write ':where'"))
  (try (check-source-rejects "(defprotocol Show (shout (a:Self):i32))
(defstruct (Box T) v:T)
(extend (Box T) Show &where (Show T))
" "'&where' is no longer a marker -- write ':where'"))
  (try (check-source-rejects "(defstruct Point x:i32)
(defunion Shape (circle p:(ref Point)) none &repr tagged)
" "'&repr' is no longer a marker -- write ':repr'"))
  (try (check-source-rejects "(defmacro twice (x &rest r) `(+ ~x ~x))\n"
         "'&rest' is no longer a marker -- write ':rest'"))
  (try (check-source-rejects "(declare printf (fmt:CStr &rest args:i32) :i32)\n"
         "'&rest' is no longer a marker -- write ':rest'")))

; The keyword spelling did not weaken any rule the symbol spelling enforced.
(deftest s16-keyword-markers-rules-preserved
  (try (check-source-rejects "(defn f (:rest xs:i64 a:i32):i64 (return 0))\n"
         "defn: :rest must be second-to-last param"))
  (try (check-source-rejects "(defn f (a:i32 :optional (m:i32 1) :rest xs:i64):i64 (return 0))\n"
         "defn: :optional cannot be combined with :rest"))
  (try (check-source-rejects "(declare printf (fmt:CStr :rest args:i32) :i32)\n"
         "declare: ':rest' is not supported in a declaration"))
  (try (check-source-rejects "(defprotocol Ord (less (a:Self b:Self):bool))
(defn maxv (a:T b:T :rest xs:i64 :where (Ord T)):T (return a))
" "defn: :rest combined with a generic method is not supported yet"))
  (try (check-source-rejects "(defmacro m (x :rest r y) `~x)\n"
         "defmacro: :rest must be second-to-last param")))

; `.nuch` is a serialization format: print-node must round-trip a marker keyword
; with its colon, or a header exports a form its importer cannot re-read.
; Asserted on the emitted text AND on a real import of it.
(deftest s16-keyword-markers-nuch-roundtrip
  (let (libdir:String (try (test-scratch-sub "lib"))
        lib:String (try (test-write-file "lib/mklib.nuc"
                          "(defprotocol Ord2 (less2 (a:Self b:Self):bool))
(defn less2 (a:i32 b:i32):bool (return (< a b)))
(extend i32 Ord2)
(defn mk-max (a:T b:T :where (Ord2 T)):T (return (if (less2 a b) b a)))
(defmacro mk-first (x :rest r) `~x)
"))
        nuch:String (try (emit-for-file "" "--emit-nuch" (string-as-view &lib)))
        hp:String (try (test-write-file "lib/mklib.nuch" (string-as-view &nuch)))
        use:String (try (test-write-file "use.nuc" "(import-use \"stdio.h\")
(import-use mklib)
(defn main ():i32 (printf \"%d\\n\" (mk-max 4 11)) (return 0))
"))
        nv:StrView (string-as-view &nuch))
    (try (check-contains nv ":where (Ord2 T)"))
    (try (check-contains nv "(x :rest r)"))
    (try (check-not-contains nv "&"))
    (let (out:String (try (build-run-file (string-as-view &libdir) ""
                                          (string-as-view &use))))
      (try (check-eq (string-as-view &out) "11\n"))
      (drop &out))
    (drop &use)
    (drop &hp)
    (drop &nuch)
    (drop &lib)
    (drop &libdir)))

; ---------------------------------------------------------------------------
; `macrolet` (macrolet.md)
; ---------------------------------------------------------------------------

; Each program's exit code is a bitmask of FAILED checks, so a regression names
; itself instead of reporting one anonymous wrong number.
(deftest s16-macrolet
  (try (check-source-exit "(defmacro dbl (x) `(_* 2 ~x))

; A binding shadows a global macro for the body and only for the body.
(defn ml-shadow ():i32
  (let (r:i32 0)
    (set! r (dbl 5))
    (macrolet ((dbl (x) `(_* 3 ~x)))
      (set! r (_+ r (dbl 5))))
    (_+ r (dbl 5))))

; Bindings are sequential (like Nucleus `let`, unlike Common Lisp's parallel
; macrolet): `two` sees `one`.
(defn ml-seq ():i32
  (macrolet ((one () `1)
             (two () `(_+ (one) (one))))
    (two)))

; An inner binding shadows an outer one of the same name; the outer is restored
; after the inner body. This is the pop.
(defn ml-nest ():i32
  (macrolet ((m () `10))
    (_+ (macrolet ((m () `100)) (m))
        (m))))

(defn ml-rest ():i32
  (macrolet ((sum3 (a :rest more) `(_+ ~a (_+ ~@more))))
    (sum3 1 2 3)))

; The enclosing function's entry/body streams must survive the nested macro
; compilation -- a macrolet inside a loop body is the cheapest proof.
(defn ml-loop ():i32
  (let (acc:i32 0 i:i32 0)
    (while (< i 4)
      (macrolet ((bump () `(set! acc (_+ acc i))))
        (bump))
      (inc! i))
    acc))

(defn main ():i32
  (let (bad:i32 0)
    (when (!= (ml-shadow) 35) (set! bad (_+ bad 1)))
    (when (!= (ml-seq)     2) (set! bad (_+ bad 2)))
    (when (!= (ml-nest)  110) (set! bad (_+ bad 4)))
    (when (!= (ml-rest)    6) (set! bad (_+ bad 8)))
    (when (!= (ml-loop)    6) (set! bad (_+ bad 16)))
    (return bad)))
" 0)))

; A macrolet in ARGUMENT position sits mid-argument-walk, so the ambient
; argument-register budget (g-abi-gpr-left/…) has to survive the nested emission
; -- by-value structs of both ABI classes make that observable. Plus: a macrolet
; in a `cond` arm, and one inside a generic template body (compiled once per
; monomorphization, hence the monotonic jit-name counter).
(deftest s16-macrolet-abi
  (try (check-source-exit "(import-use numeric)
(defstruct Big a:i64 b:i64 c:i64)
(defstruct Pair x:i64 y:i64)

(defn take6 (p:Pair q:Pair b:Big n:i32 m:i32):i64
  (let (pp:ptr:Pair &p qq:ptr:Pair &q bb:ptr:Big &b)
    (_+ (_+ (pp 'x) (qq 'y)) (_+ (bb 'c) (as i64 (_+ n m))))))

(defn ml-argpos ():i64
  (let (p:Pair (Pair 1 2) q:Pair (Pair 3 4) b:Big (Big 5 6 7))
    (take6 p q b 10 (macrolet ((twenty () `20)) (twenty)))))

(defn ml-cond (n:i32):i32
  (cond (= n 0) (macrolet ((z () `100)) (z))
        (= n 1) (macrolet ((o (k) `(_* ~k 3))) (o 7))
        true    (macrolet ((d () `(_- 0 1))) (d))))

(defn ml-maxish (a:T b:T :where (Ord T)):T
  (macrolet ((pick (x y) `(if (< ~x ~y) ~y ~x)))
    (pick a b)))

(defn main ():i32
  (let (bad:i32 0)
    (when (!= (ml-argpos) (as i64 42)) (set! bad (_+ bad 1)))
    (when (!= (ml-cond 0) 100) (set! bad (_+ bad 2)))
    (when (!= (ml-cond 1)  21) (set! bad (_+ bad 4)))
    (when (!= (ml-cond 2)  -1) (set! bad (_+ bad 8)))
    (when (!= (ml-maxish 21 9) 21) (set! bad (_+ bad 16)))
    (when (!= (ml-maxish (as i64 50) (as i64 77)) (as i64 77)) (set! bad (_+ bad 32)))
    (return bad)))
" 0)))

; A macrolet inside a `defmacro` BODY: one macro JIT module compiled while
; another is compiling. The hoist-to-a-pre-pass alternative could not do this;
; `push-function-state` can. `ast-first` of the INT node `5` is null, so `pick`
; expands to its second argument.
(deftest s16-macrolet-in-defmacro
  (try (check-source-exit "(defmacro pick (a b)
  (macrolet ((first-of (x) `(ast-first ~x)))
    (if (= (first-of a) null) b a)))
(defn main ():i32 (return (pick 5 6)))
" 6)))

; ---------------------------------------------------------------------------
; `macmap` (design/stage20-macros/overview.md)
; ---------------------------------------------------------------------------

; Same bitmask convention as the macrolet block above.
(deftest s20-macmap
  (try (check-source-exit "
; One parameter: the row IS the argument, whole.
(defn mm-one ():i32
  (let (acc:i32 0)
    (macmap ((v) `(set! acc (_+ acc ~v))) (1 2 4))
    acc))

; More than one: the row is destructured across the parameters.
(defn mm-two (n:i32):i32
  (macmap ((v r) `(when (= n ~v) (return ~r)))
    ((1 10) (2 20) (3 30)))
  -1)

; A one-parameter row may be any expression, a list included -- the arity rule
; is what makes that unambiguous.
(defn mm-expr ():i32
  (let (acc:i32 0)
    (macmap ((v) `(set! acc (_+ acc ~v))) ((_* 2 3) 1))
    acc))

; :rest in the template parameters, over rows of the same shape.
(defn mm-rest ():i32
  (let (acc:i32 0)
    (macmap ((a :rest more) `(set! acc (_+ acc (_+ ~a (_+ ~@more)))))
      ((1 2 3) (4 5 6)))
    acc))

; An empty table emits nothing and is still a well-formed expression.
(defn mm-empty ():i32
  (let (acc:i32 7)
    (macmap ((v) `(set! acc ~v)) ())
    acc))

; A row expression may itself contain a macmap: the inner binding shadows the
; outer one and the outer is restored on pop.
(defn mm-nested ():i32
  (let (acc:i32 0)
    (macmap ((v) `(set! acc (_+ acc ~v)))
      ((let (inner:i32 0)
         (macmap ((w) `(set! inner (_+ inner ~w))) (1 2))
         inner)
       10))
    acc))

; Statement position inside a loop body, and expression position in a cond arm.
(defn mm-loop ():i32
  (let (acc:i32 0 i:i32 0)
    (while (< i 3)
      (macmap ((v) `(set! acc (_+ acc ~v))) (1 2))
      (inc! i))
    acc))

(defn mm-cond (n:i32):i32
  (cond (= n 0) (let (a:i32 0) (macmap ((v) `(set! a (_+ a ~v))) (5 6)) a)
        true    (let (b:i32 0) (macmap ((v) `(set! b (_+ b ~v))) (1))   b)))

(defn main ():i32
  (let (bad:i32 0)
    (when (!= (mm-one)     7) (set! bad (_+ bad 1)))
    (when (!= (mm-two 2)  20) (set! bad (_+ bad 2)))
    (when (!= (mm-two 9)  -1) (set! bad (_+ bad 4)))
    (when (!= (mm-expr)    7) (set! bad (_+ bad 8)))
    (when (!= (mm-rest)   21) (set! bad (_+ bad 16)))
    (when (!= (mm-empty)   7) (set! bad (_+ bad 32)))
    (when (!= (mm-nested) 13) (set! bad (_+ bad 64)))
    (when (!= (mm-loop)    9) (set! bad (_+ bad 128)))
    (when (!= (mm-cond 0) 11) (set! bad (_+ bad 256)))
    (when (!= (mm-cond 1)  1) (set! bad (_+ bad 512)))
    (return bad)))
" 0)))

; M2: `macrolet` in top-level position, which is what lets `macmap` stand where
; a definition stands. `fifty` proves the inner binding shadows the outer one
; and `mk` after the body proves the outer scope really closed -- the pop is a
; synthetic `(__macrolet-end N)` spliced after the body, so a missing one would
; leave `mk` bound as a macro and the `defn` would collide.
(deftest s20-macmap-toplevel
  (try (check-source-exit "
(macmap ((name val) `(defn ~name ():i32 ~val))
  ((one 1) (two 2) (three 3)))

(macrolet ((mk (n v) `(defn ~n ():i32 ~v)))
  (mk four 4)
  (macrolet ((mk (n v) `(defn ~n ():i32 (_* ~v 10))))
    (mk fifty 5))
  (mk six 6))

(defn mk ():i32 99)

(defn main ():i32
  (let (bad:i32 0)
    (when (!= (one)    1) (set! bad (_+ bad 1)))
    (when (!= (two)    2) (set! bad (_+ bad 2)))
    (when (!= (three)  3) (set! bad (_+ bad 4)))
    (when (!= (four)   4) (set! bad (_+ bad 8)))
    (when (!= (fifty) 50) (set! bad (_+ bad 16)))
    (when (!= (six)    6) (set! bad (_+ bad 32)))
    (when (!= (mk)    99) (set! bad (_+ bad 64)))
    (return bad)))
" 0)))

; The same two shape errors the expression-position form reports, from the
; top-level arm -- which validates independently of `emit-macrolet`.
(deftest s20-macrolet-toplevel-refused-noargs
  (try (check-source-rejects "(macrolet)
(defn main ():i32 0)
"
         "macrolet: expects a binding list and at least one body form")))
(deftest s20-macrolet-toplevel-refused-nobody
  (try (check-source-rejects "(macrolet ((m () `1)))
(defn main ():i32 0)
"
         "macrolet: expects a binding list and at least one body form")))
(deftest s20-macrolet-toplevel-refused-badbind
  (try (check-source-rejects "(macrolet (5) (defn main ():i32 0))
"
         "macrolet: binding must be (name (params) body...)")))

; ---------------------------------------------------------------------------
; `macfoldl` / `macfoldr` (design/stage20-macros/overview.md §3)
; ---------------------------------------------------------------------------

; The folds themselves, then the six operators they now back at arity >= 3 --
; every arity of every one, since the rewrite's whole claim is that the final
; tree is unchanged. `_-`/`_/` left-fold, the rest right-fold.
(deftest s20-macfold
  (try (check-source-exit "
(defn main ():i32
  (let (bad:i32 0)
    ; the folds directly: nesting direction, unit, single argument
    (when (!= (macfoldr _+ 0 1 2 3 4)   10) (set! bad (_+ bad 1)))
    (when (!= (macfoldl _- 0 10 1 2 3)   4) (set! bad (_+ bad 2)))
    (when (!= (macfoldr _+ 0)            0) (set! bad (_+ bad 4)))
    (when (!= (macfoldl _- 99)          99) (set! bad (_+ bad 8)))
    (when (!= (macfoldr _+ 0 7)          7) (set! bad (_+ bad 16)))
    (when (!= (macfoldl _* 1 2 3 4)     24) (set! bad (_+ bad 32)))
    ; an operator spelled by a MACRO, not a primitive: the head is spliced
    (when (!= (macfoldr + 0 1 2 3)       6) (set! bad (_+ bad 64)))
    ; + and * : identity, single, binary, n-ary
    (when (!= (+)                        0) (set! bad (_+ bad 128)))
    (when (!= (+ 5)                      5) (set! bad (_+ bad 256)))
    (when (!= (+ 5 6)                   11) (set! bad (_+ bad 512)))
    (when (!= (+ 1 2 3 4 5)             15) (set! bad (_+ bad 1024)))
    (when (!= (*)                        1) (set! bad (_+ bad 2048)))
    (when (!= (* 2 3 4)                 24) (set! bad (_+ bad 4096)))
    ; - and / : unary negate / reciprocal, then LEFT folds
    (when (!= (-)                        0) (set! bad (_+ bad 8192)))
    (when (!= (- 5)                     -5) (set! bad (_+ bad 16384)))
    (when (!= (- 10 3)                   7) (set! bad (_+ bad 32768)))
    (when (!= (- 10 3 2 1)               4) (set! bad (_+ bad 65536)))
    (when (!= (/ 100 5 2)               10) (set! bad (_+ bad 131072)))
    (when (!= (/ 100 5 2 5)              2) (set! bad (_+ bad 262144)))
    (return bad)))
" 0)))

; and/or keep short-circuit at every arity: `boom` divides by zero, so reaching
; it at all traps. The right-fold is what makes each operand narrow under all
; the ones before it, so the arity-3+ path must still nest to the RIGHT.
(deftest s20-macfold-shortcircuit
  (try (check-source-exit "
(defvar hits:i32 0)
(defn bump (v:i32):bool (set! hits (_+ hits 1)) (if (= v 0) false true))
(defn main ():i32
  (let (bad:i32 0)
    (unless (and)           (set! bad (_+ bad 1)))
    (when (or)              (set! bad (_+ bad 2)))
    (set! hits 0)
    (when (and (bump 0) (bump 1) (bump 1)) (set! bad (_+ bad 4)))
    (when (!= hits 1) (set! bad (_+ bad 8)))
    (set! hits 0)
    (unless (or (bump 1) (bump 1) (bump 1)) (set! bad (_+ bad 16)))
    (when (!= hits 1) (set! bad (_+ bad 32)))
    (set! hits 0)
    (unless (and (bump 1) (bump 1) (bump 1) (bump 1)) (set! bad (_+ bad 64)))
    (when (!= hits 4) (set! bad (_+ bad 128)))
    (return bad)))
" 0)))

; ---------------------------------------------------------------------------
; `macro-error` (design/stage20-macros/overview.md §2.5)
; ---------------------------------------------------------------------------

; A macro that inspects its argument and accepts it emits nothing extra.
(deftest s20-macro-error-accepts
  (try (check-source-exit "(import-use \"stdio.h\")
(defmacro only-ints (x)
  (when (!= (x 'kind) NODE-INT)
    (macro-error x \"only-ints: the argument must be an integer literal\"))
  `~x)
(defn main ():i32 (return (only-ints 7)))
" 7)))

; ... and one that rejects reports the macro's own message.
(deftest s20-macro-error-rejects
  (try (check-source-rejects "(defmacro only-ints (x)
  (when (!= (x 'kind) NODE-INT)
    (macro-error x \"only-ints: the argument must be an integer literal\"))
  `~x)
(defn main ():i32 (return (only-ints \"nope\")))
"
         "only-ints: the argument must be an integer literal")))

; Outside a macro/CT body there is no compiler to call into, so the form is
; refused rather than emitted as a call nothing will resolve.
(deftest s20-macro-error-refused-in-program
  (try (check-source-rejects "(defn main ():i32 (macro-error null \"x\") 0)
"
         "macro-error: only available inside a defmacro, macrolet or compile-time body")))

(deftest s20-macro-error-refused-arity
  (try (check-source-rejects "(defmacro m (x) (macro-error x) `0)
(defn main ():i32 (m 1))
"
         "macro-error: expects a node and a message")))

; A `macrolet` body reaches it too -- the guard is `in-jit-module`, which a
; macrolet's body module satisfies exactly as a defmacro's does.
(deftest s20-macro-error-in-macrolet
  (try (check-source-rejects "(defn main ():i32
  (macrolet ((m (x) (macro-error x \"m: no\") `0))
    (m 1)))
"
         "m: no")))

; `macmap`'s own shape checks, the first user of macro-error in the prelude.
; Without them each of these reported against `__macmap`, the binding the
; lowering introduces and the caller never wrote.
(deftest s20-macmap-refused-short-row
  (try (check-source-rejects "(defn f (n:i32):i32
  (macmap ((a b) `(when (= n ~a) (return ~b))) ((1 10) (2)))
  0)
(defn main ():i32 0)
"
         "macmap: this row's length does not match the template's parameter list")))
(deftest s20-macmap-refused-nonlist-row
  (try (check-source-rejects "(defn f (n:i32):i32
  (macmap ((a b) `(when (= n ~a) (return ~b))) (1 2))
  0)
(defn main ():i32 0)
"
         "macmap: a row must be a list, one element per template parameter")))
(deftest s20-macmap-refused-bad-spec
  (try (check-source-rejects "(defn main ():i32 (macmap (x) (1 2)) 0)
"
         "macmap: the first argument must be ((param ...) template)")))
; `()` reads as a NULL node, so the diagnostic falls back to the row list for a
; line -- reporting at 0 would name no source at all.
(deftest s20-macmap-refused-empty-spec
  (try (check-source-rejects "(defn main ():i32 (macmap () (1 2)) 0)
"
         "macmap: the first argument must be ((param ...) template)")))
(deftest s20-macmap-refused-no-template
  (try (check-source-rejects "(defn main ():i32 (macmap ((a)) (1 2)) 0)
"
         "macmap: the first argument must be ((param ...) template)")))

; `:rest` makes the row check a lower bound, not an equality: rows of differing
; length past the fixed parameters are exactly what it is for.
(deftest s20-macmap-rest-rows-vary
  (try (check-source-exit "
(defn main ():i32
  (let (acc:i32 0)
    (macmap ((a :rest more) `(set! acc (_+ acc (+ ~a ~@more))))
      ((1 2) (3 4 5)))
    (return (_- acc 15))))
" 0)))

; ---------------------------------------------------------------------------
; Quasiquote nesting levels (design/stage20-macros/quasiquote-levels.md)
; ---------------------------------------------------------------------------
;
; Every unit below FAILS on a compiler without the level counter: the inner
; template's unquotes fire at the outer level, so `v`/`p`/`body` are reported
; undefined at the outer macro's definition site.

; A macro that writes a macro. `~name` is level 1 and fires now; `~v` is level 2
; and belongs to `add5`; `~'~k` is the compound that carries the OUTER
; argument in (quasiquote-levels.md §10).
(deftest s20-qq-nested-template
  (try (check-source-exit "(defmacro def-adder (name k)
  `(defmacro ~name (v) `(+ ~v ~'~k)))
(def-adder add5 5)
(defn main ():i32 (return (add5 1)))
" 6)))

; The motivating case: a `macmap` in a macro body is always a nested template.
(deftest s20-qq-macmap-in-macro
  (try (check-source-exit "(defmacro sum-all (:rest parts)
  `(macmap ((p) `(set! acc (_+ acc ~p))) ~parts))
(defn main ():i32
  (let (acc:i32 0)
    (sum-all 1 2 4)
    (return acc)))
" 7)))

; `~~'v` lowers twice and lands on the inner parameter, which is what `~v`
; already says — the equivalence is the checkable statement of the arithmetic.
(deftest s20-qq-double-unquote
  (try (check-source-exit "(defmacro def-id (name)
  `(defmacro ~name (v) `(do ~~'v)))
(def-id idy)
(defn main ():i32 (return (idy (_+ 40 2))))
" 42)))

; `~@body` is data at level 2 and splices the GENERATED macro's rest list;
; `~@'~after` is the splicing counterpart of `~'~`.
(deftest s20-qq-inner-splice
  (try (check-source-exit "(defmacro def-wrapper (name :rest after)
  `(defmacro ~name (:rest body) `(do ~@body ~@'~after)))
(def-wrapper w (set! acc (_+ acc 4)))
(defn main ():i32
  (let (acc:i32 0)
    (w (set! acc (_+ acc 3)))
    (return acc)))
" 7)))

; The common case, which the counter must leave exactly where it was. The
; 2,690-artifact IR snapshot is the real gate for that; this is the unit that
; says so from inside the suite.
(deftest s20-qq-level-one-unchanged
  (try (check-source-exit "(defmacro pair (a :rest more)
  `(_+ ~a (+ ~@more)))
(defn main ():i32 (return (pair 1 2 3)))
" 6)))

; Level 1 keeps its refusal; deeper the same form is data.
(deftest s20-qq-splice-outside-list
  (try (check-source-rejects "(defmacro m (x) `~@x)
(defn main ():i32 0)
"
         "unquote-splice outside list")))

; Was `unknown: unquote`, which named the reader macro's expansion rather than
; the mistake.
(deftest s20-qq-unquote-outside-quasiquote
  (try (check-source-rejects "(defn main ():i32 (let (x:i32 1) (return ~x)))
"
         "unquote outside quasiquote")))

; ---------------------------------------------------------------------------
; What a macro body may call (design/stage20-macros/macro-call-linking.md)
; ---------------------------------------------------------------------------
;
; Stage 20 L4 turned the compile-time mirror on: a name in a macro body means
; what it means in the PROGRAM, except for the compile-time runtime, which is a
; `lib/` file the running compiler also exports (§3.1). Every unit below was one
; of §1's three failure modes before L4, so each is a regression test for a
; behaviour that USED to be a link error, a wrong answer or a core dump.

; §1.1, mode 1. `Symbols not found: [ my-ident ]` before L4 — the program's
; `define` was text in g-def-buf that nothing compiled until after expansion.
(deftest s20-macro-calls-own-defn
  (try (check-source-exit "(import-use node)
(defn my-ident (n:(raw Node)):(raw Node) (return n))
(defmacro ident (x) (my-ident x))
(defn main ():i32 (return (ident 7)))
" 7)))

; §1.5, and the deferral's headline claim retired: a macro body could not
; recurse, because the only recursion available to it was a helper. The REPL
; answered 4 for this file while the batch compiler said `Symbols not found`.
(deftest s20-macro-calls-recursive-helper
  (try (check-source-exit "(import-use node)
(defn depth (n:(raw Node)):i32
  (if (= (node-len n) 0) (return 0)
      (return (_+ 1 (depth (node-rest n))))))
(defn mk-int (v:i64):(raw Node)
  (let (n:&Node (alloc-node))
    (set! (n 'kind) NODE-INT)
    (set! (n 'i) v)
    (return (as raw:Node n))))
(defmacro dep (:rest xs) (mk-int (as i64 (depth xs))))
(defn main ():i32 (return (dep 1 2 3 4)))
" 4)))

; §3.2's one-arena invariant, which design C (a copy of the closure per macro)
; would have broken silently: two macros share one helper, the helper allocates
; through the HOST's `alloc-node` because the mirror only declares it, and both
; expansions survive to runtime.
(deftest s20-macro-helper-shares-arena
  (try (check-source-exit "(import-use node)
(defn mk (v:i64):(raw Node)
  (let (n:&Node (alloc-node))
    (set! (n 'kind) NODE-INT)
    (set! (n 'i) v)
    (return (as raw:Node n))))
(defmacro a () (mk 3))
(defmacro b () (mk 4))
(defn main ():i32 (return (_+ (a) (b))))
" 7)))

; §5.6: a `defn-`'s `define internal` cannot link from a mirror, which is its
; own object, so the COPY is rewritten to `weak_odr`. The program's own bytes
; must not move — that is the second assertion.
(deftest s20-macro-calls-private-defn
  (let (src:StrView "(defn- ctm-priv (n:i32):i32 (return (_+ n 1)))
(defmacro probe () (if (= (ctm-priv 6) 7) `7 `99))
(defn main ():i32 (return (probe)))
")
    (try (check-source-exit src 7))
    ; W5e keys a private name on its FILE, and every embedded fixture is `t.nuc`,
    ; so the mangled spelling is stable. N4's mangling is also why §5.6's
    ; `weak_odr` collision worry cannot arise (L3).
    (let (ir:String (try (source-ir src)))
      (try (check-line (string-as-view &ir)
             "define internal i32 @t_p1__ctm-priv(i32 %n.arg) section \".text.t_p1__ctm-priv\" {"))
      (drop &ir)))
  (return (ok)))

; The mode-3 shape in all three of its claims. Three compiles, because the
; answer and the diagnostic come from different invocations.
(defn check-ct-shadow-of (verb:StrView src:StrView name:StrView note:StrView
                          line:i32):!void
  (try (check-source-exit src 7))
  (let (p:String (try (test-write-file "t.nuc" src))
        pv:StrView (string-as-view &p)
        needle:String (str verb " '" name
                           "', which is also a symbol exported by the compiler")
        c:Compiled (try (compile-path pv)))
    (try (check-warning-at (ref c 'diags) pv line
                           (string-as-view &needle)))
    (try (check-note-at (ref c 'diags) pv line note))
    (drop &c)
    (drop &needle)
    ; `nucleusc-raw`, because the claim is that stderr says NOTHING — which a
    ; sexp-diagnostics run would also satisfy by emitting no records, but this
    ; way the assertion covers any spelling of the message.
    (let (r:Ran (try (nucleusc-raw "--no-warn-ct-shadow" pv)))
      (try (check-empty (string-as-view (ref r 'err))))
      (drop &r))
    (drop &p))
  (return (ok)))

(defn check-ct-shadow (src:StrView name:StrView line:i32):!void
  (return (check-ct-shadow-of "calls" src name "the compiler's ran instead" line)))

; §1.3, mode 3, and the reason this item is a soundness fix rather than a
; feature. THIS TEST PASSED AT EXIT 99 BEFORE L4: `-rdynamic` exports 1,658
; lowercase-hyphenated compiler symbols, the program's `in-jit-module` collided
; with one, and the COMPILER's ran mid-compilation and chose the expansion.
(deftest s20-macro-shadows-compiler-symbol
  (try (check-ct-shadow "(defn in-jit-module ():i32 (return 7))
(defmacro probe () (if (= (in-jit-module) 7) `7 `99))
(defn main ():i32 (return (probe)))
" "in-jit-module" 2)))

; The same collision with a MISMATCHED signature, which is the memory-unsafe
; half: the compiler's `desugar-form` takes a `Node*`, this one takes an `i32`,
; and calling it from a macro body dereferenced 21. `nucleusc` dumped core —
; no cast, no `unsafe/`, no C, just an unlucky function name.
(deftest s20-macro-shadows-compiler-signature
  (try (check-ct-shadow "(defn desugar-form (n:i32):i32 (return (_* n 2)))
(defmacro probe () (if (= (desugar-form 21) 42) `7 `99))
(defn main ():i32 (return (probe)))
" "desugar-form" 2)))

; The same collision on a program GLOBAL, which L6 made reachable and L8 names
; (§7 L8). Equally discriminating: the compiler's own `g-block-term` is 0 or 1
; mid-compilation, never 7, so only the program's copy can have chosen `7`.
(deftest s20-macro-shadows-compiler-global
  (try (check-ct-shadow-of "reads" "(defvar g-block-term:i32 7)
(defmacro probe () (if (= g-block-term 7) `7 `99))
(defn main ():i32 (return (probe)))
" "g-block-term" "a different object" 2)))

; The shape that distinguishes a correct root set from a lost one: a `macrolet`
; compiled INSIDE a macro body opens a second body mid-way through the first,
; and the calls the inner template splices belong to the OUTER macro. With the
; roots reset the way `g-macro-decls` is — reset, never restored — this file
; fails with `Symbols not found: [ mk, base ]` (measured).
(deftest s20-macro-roots-survive-nested-macrolet
  (try (check-source-exit "(import-use node)
(defn mk (v:i64):(raw Node)
  (let (n:&Node (alloc-node))
    (set! (n 'kind) NODE-INT)
    (set! (n 'i) v)
    (return (as raw:Node n))))
(defn base ():i64 (return 5))
(defmacro outer ()
  (macrolet ((inner (k) `(mk (_+ (base) ~k))))
    (inner 2)))
(defn main ():i32 (return (outer)))
" 7)))

; §3.1 condition 2, which is what keeps a `lib/` module the compiler does not
; link from becoming an unresolvable `declare`: `lib/mathlib.nuc` is under the
; root, so condition 1 holds, but `build/nucleusc` exports no `square`. Mode 1
; before L4.
(deftest s20-macro-calls-unlinked-lib
  (try (check-source-exit "(import-use \"lib/mathlib.nuc\")
(defmacro probe () (if (= (square 3) 9) `7 `99))
(defn main ():i32 (return (probe)))
" 7)))

; L7's probe, reached for free: a `(compile-time …)` block flushes at its own
; lookup site, so it calls a program `defn` exactly as a macro body does.
; `Symbols not found: [ twice ]` before L4.
(deftest s20-ct-block-calls-own-defn
  (let (p:String (try (test-write-file "t.nuc" "(import-use \"stdio.h\")
(defn twice (n:i32):i32 (return (_* n 2)))
(compile-time (printf \"%d\\n\" (twice 21)))
(defn main ():i32 (return 0))
")))
    ; `nucleusc-raw`: a CT block's stdout is redirected to stderr so it cannot
    ; corrupt the IR, and 42 is not a diagnostic.
    (let (r:Ran (try (nucleusc-raw "" (string-as-view &p))))
      (try (check (r 'ok?) "a clean compile"))
      (try (check-eq (string-as-view (ref r 'err)) "42\n"))
      (drop &r))
    (drop &p))
  (return (ok)))

; L7, the shape L4's one-call probe did not reach: a CT block whose helper
; recurses. The mirror has to carry `fib`'s own `@fib` call sites, which is the
; closure walk finding a span it has already chosen.
(deftest s20-ct-block-calls-recursive-helper
  (let (p:String (try (test-write-file "t.nuc" "(import-use \"stdio.h\")
(defn fib (n:i32):i32
  (if (< n 2) (return n) (return (_+ (fib (_- n 1)) (fib (_- n 2))))))
(compile-time (printf \"%d\\n\" (fib 10)))
(defn main ():i32 (return 0))
")))
    (let (r:Ran (try (nucleusc-raw "" (string-as-view &p))))
      (try (check (r 'ok?) "a clean compile"))
      (try (check-eq (string-as-view (ref r 'err)) "55\n"))
      (drop &r))
    (drop &p))
  (return (ok)))

; L5's false-positive gate. Each of the four units below reaches
; `macro-jit-ensure-decl` with NO `ProgDefn` for a legitimate reason, and L5's
; forward-reference diagnostic has to be narrower than that early return: a
; mis-drawn check turns every one of them into a compile error.

; An extern reached through a C header: already in `g-decl-stream`, which the
; macro module copies verbatim.
(deftest s20-macro-calls-c-header-fn
  (try (check-source-exit "(import-use \"stdio.h\")
(defmacro probe () (printf \"\") `7)
(defn main ():i32 (return (probe)))
" 7)))

; A top-level `declare`, the other producer of a `g-decl-stream` entry.
(deftest s20-macro-calls-declared-fn
  (try (check-source-exit "(declare abs (i32):i32)
(defmacro probe () (if (= (abs -7) 7) `7 `99))
(defn main ():i32 (return (probe)))
" 7)))

; A call through a function-POINTER local: its `ir-name` is `%f.addr.0`, an IR
; text that is not a link name at all.
(deftest s20-macro-calls-through-fn-ptr
  (try (check-source-exit "(declare abs (i32):i32)
(defmacro probe ()
  (let (f:(fn i32)(i32) abs)
    (if (= (f -7) 7) `7 `99)))
(defn main ():i32 (return (probe)))
" 7)))

; A `defn` the CT block DEFINES: `program-defn-record` declines inside a JIT
; module, so it has no `ProgDefn` and never will — and it needs no `declare`,
; because its `define` is in this very module. §5.8's stated test (no
; `ProgDefn`, not in `g-decl-stream`, a global `TY-FN` `Sym`) admits it, so
; this is the unit that says the fourth condition is load-bearing. The second
; `defn` is defined BELOW its caller inside the block, which the CT prescan is
; what covers.
(deftest s20-ct-block-defines-own-defn
  (let (p:String (try (test-write-file "t.nuc" "(import-use \"stdio.h\")
(compile-time
  (defn ct-outer (x:i32):i32 (return (ct-inner x)))
  (defn ct-inner (x:i32):i32 (return (_* x 2)))
  (printf \"%d\\n\" (ct-outer 21)))
(defn main ():i32 (return 0))
")))
    (let (r:Ran (try (nucleusc-raw "" (string-as-view &p))))
      (try (check (r 'ok?) "a clean compile"))
      (try (check-eq (string-as-view (ref r 'err)) "42\n"))
      (drop &r))
    (drop &p))
  (return (ok)))

; A macro body may also NAME a program defn rather than call it. That reaches
; `emit-symbol-ref-bound`'s materialization chokepoint, not `emit-call`, and
; before L5 it was the one remaining path that leaked LLVM's own `use of
; undefined value '@twice'` for a callee defined ABOVE the macro.
(deftest s20-macro-names-defn-as-value
  (try (check-source-exit "(defn twice (x:i32):i32 (return (_* x 2)))
(defmacro probe ()
  (let (f:(fn i32)(i32) twice)
    (if (= (f 21) 42) `7 `99)))
(defn main ():i32 (return (probe)))
" 7)))

; --- L6: program globals in the closure (§5.7) ------------------------------

; L5 refused this one, worded as a current limitation. The helper's span names
; `@g-s20k`, so the mirror has to carry the global as well as the function.
(deftest s20-macro-helper-reads-program-global
  (try (check-source-exit "(defvar g-s20k:i32 7)
(defn s20-readk ():i32 (return g-s20k))
(defmacro probe () (if (= (s20-readk) 7) `7 `99))
(defn main ():i32 (return (probe)))
" 7)))

; The sibling with no helper at all. A call records its root at
; `macro-jit-ensure-decl`; a global reference has no such site — a read, a
; `set!`, a `ref` and a member GEP each spell `@g` by their own route — so
; the root comes from the body's own IR text. Before L6 this leaked LLVM's
; `use of undefined value '@g-s20k'`.
(deftest s20-macro-reads-program-global-directly
  (try (check-source-exit "(defvar g-s20k:i32 7)
(defmacro probe () (if (= g-s20k 7) `7 `99))
(defn main ():i32 (return (probe)))
" 7)))

; The half of §5.7 that fails SILENTLY. The mirror needs the global's queued
; initializer to have run, and the program needs the identical job still in its
; own `@__nucleus_init` — so the value is asserted twice, at compile time
; (`probe` expands to 1) and at run time (`g-s20r` reads 42). A mirror that
; drained `g-init-drained` would still compile, still link, expand to 1, and
; exit 1 instead of 43.
(deftest s20-macro-global-runtime-init
  (let (src:StrView "(defn s20-seed ():i32 (return 21))
(defvar g-s20r:i32 (_* (s20-seed) 2))
(defn s20-readr ():i32 (return g-s20r))
(defmacro probe () (if (= (s20-readr) 42) `1 `0))
(defn main ():i32 (return (_+ (probe) g-s20r)))
")
    (try (check-source-exit src 43))
    (let (ir:String (try (source-ir src)))
      (try (check-line (string-as-view &ir)
             "define internal void @__nucleus_init() {"))
      (try (check-line (string-as-view &ir)
             "  store i32 %t1, ptr @g-s20r, align 4"))
      (drop &ir)))
  (return (ok)))

; A chain: the mirrored global's initializer reads another global whose own
; initializer is still queued. The copied-global set and the initializer IR grow
; each other, so the walk has to reach a fixpoint rather than run once.
(deftest s20-macro-global-init-chain
  (try (check-source-exit "(defn s20-base ():i32 (return 10))
(defvar g-s20a:i32 (_* (s20-base) 2))
(defvar g-s20b:i32 (_+ g-s20a 5))
(defn s20-readb ():i32 (return g-s20b))
(defmacro probe () (if (= (s20-readb) 25) `1 `0))
(defn main ():i32 (return (_+ (probe) g-s20b)))
" 26)))

; A flush INSIDE a flush. The mirror emits the queued initializer with
; `emit-node`, so a macro in that initializer expands — and expanding it flushes
; a mirror of its own, against the same globals. With the per-flush vectors
; merely reset instead of restored, the outer walk resumes on the inner's state
; and this file fails `Symbols not found: [ s20-readn ]` (measured).
(deftest s20-macro-global-init-expands-macro
  (try (check-source-exit "(defn s20-t2 (x:i32):i32 (return (_* x 2)))
(defmacro dbl (k) (if (= (s20-t2 3) 6) `(_* ~k 2) `0))
(defn s20-seed ():i32 (return 10))
(defvar g-n:i32 (dbl (s20-seed)))
(defn s20-readn ():i32 (return g-n))
(defmacro probe () (if (= (s20-readn) 20) `1 `0))
(defn main ():i32 (return (_+ (probe) g-n)))
" 21)))

; §11 Q3, settled by probe and pinned here: two flushes that need one global
; must see one copy. Each macro has its own helper, so the second flush is a
; real second module that DECLARES the global the first one defined. Under
; `internal` — the other plausible answer — the measured failure is
; `JIT session error: Symbols not found: [ q3_p1__g-s20p ]`. Exit 1 would mean
; two copies; the `defvar-` is what makes the linkage question bite at all.
(deftest s20-macro-global-two-flushes-one-copy
  (try (check-source-exit "(defvar- g-s20p:i32 0)
(defn- s20-bump1 ():i32 (do (set! g-s20p (_+ g-s20p 1)) (return g-s20p)))
(defn- s20-bump2 ():i32 (do (set! g-s20p (_+ g-s20p 1)) (return g-s20p)))
(defmacro a () (if (= (s20-bump1) 1) `1 `0))
(defmacro b () (if (= (s20-bump2) 2) `1 `0))
(defn main ():i32 (return (_+ (a) (b))))
" 2)))

; §3.2's one-arena invariant, on the GLOBAL rather than the allocator: a
; `lib/` global the running compiler exports stays a `declare`, so the mirrored
; helper reads the HOST's arena counter. A copy of `g-arena-used` would be a
; fresh zero, and the expansion would be 99.
(deftest s20-macro-lib-global-is-the-hosts
  (try (check-source-exit "(import-use arena)
(defn s20-arena-used ():i64 (return g-arena-used))
(defmacro probe () (if (> (s20-arena-used) 0) `7 `99))
(defn main ():i32 (return (probe)))
" 7)))

; A pointer global backed by an anonymous constant table (G-2 shape 4) is TWO
; definitions inside one span, and the second names the first. The walk must
; skip what the span defines, or `@g-s20pa.data` is classified as a reference
; nothing in the unit declares. Private, so the linkage rewrite has to find the
; global's own line past the backing global's.
(deftest s20-macro-global-array-backing
  (try (check-source-exit "(defvar- g-s20pa:&i32 (array i32 3 4 5))
(defn- s20-r1 ():i32 (return (aref g-s20pa 2)))
(defn- s20-r2 ():i32 (return (aref g-s20pa 0)))
(defmacro a () (if (= (s20-r1) 5) `4 `0))
(defmacro b () (if (= (s20-r2) 3) `3 `0))
(defn main ():i32 (return (_+ (a) (b))))
" 7)))

; L7 parity for L6: a `(compile-time …)` block reaches a program global by the
; same route a macro body does.
(deftest s20-ct-block-reads-program-global
  (let (p:String (try (test-write-file "t.nuc" "(import-use \"stdio.h\")
(defn s20-ctseed ():i32 (return 21))
(defvar g-s20ct:i32 (_* (s20-ctseed) 2))
(compile-time (printf \"%d\\n\" g-s20ct))
(defn main ():i32 (return 0))
")))
    (let (r:Ran (try (nucleusc-raw "" (string-as-view &p))))
      (try (check (r 'ok?) "a clean compile"))
      (try (check-eq (string-as-view (ref r 'err)) "42\n"))
      (drop &r))
    (drop &p))
  (return (ok)))

; --- C1/C2: a computed macro argument -----------------------------------------
; (design/stage20-macros/computed-macro-arguments.md §2.1 width (a))
;
; `~e` in macro-argument position evaluates `e` at compile time and substitutes
; the node it returns. It is the macro-body path with a different caller, so
; everything L4-L8 built is inherited — these units pin what that buys.

; The ask, verbatim from §1: rows a program `defn` computes, spliced into
; `macmap` as if they had been written out. Before C2 this was
; `unquote outside quasiquote`.
(deftest s20-computed-arg-macmap
  (try (check-source-exit "(import-use node)
(defn s20-rows ():(raw Node) (return `((a 1) (b 2) (c 3))))
(macmap ((name arity) `(defn ~name ():i32 (return ~arity))) ~(s20-rows))
(defn main ():i32 (return (_+ (a) (_+ (b) (c)))))
" 6)))

; The closure, which is L4's machinery doing the work: the evaluated form calls
; a program `defn` that calls another, so BOTH spans have to reach the mirror.
(deftest s20-computed-arg-calls-helper
  (try (check-source-exit "(import-use node)
(defn s20-leaf ():(raw Node) (return `(_* 4 3)))
(defn s20-rows2 ():(raw Node) (return `((p ~(s20-leaf)) (q 5))))
(macmap ((name v) `(defn ~name ():i32 (return ~v))) ~(s20-rows2))
(defn main ():i32 (return (_+ (p) (q))))
" 17)))

; §4.4 asks whether `macrolet` is on this path rather than asserting it. It is —
; both definers compile through `compile-macro-body`, and the substitution is in
; `expand-macro-call`, which both call. Mid-function, so this is also the unit
; that says `ct-eval-node` brackets `push-function-state` the way `macrolet-bind`
; does: without it the enclosing `main`'s entry/body streams are reset under it.
(deftest s20-computed-arg-macrolet
  (try (check-source-exit "(import-use node)
(defn s20-val ():(raw Node) (return `(_* 6 7)))
(defn main ():i32
  (macrolet ((one (x) x))
    (return (one ~(s20-val)))))
" 42)))

; A body that names nothing but the compile-time runtime records no root, so it
; needs no mirror — which is what keeps `~e` usable under `--target=` (the other
; half is `s20-computed-arg-cross-target` in suite-refusals.nuc).
(deftest s20-computed-arg-host-resolved
  (try (check-source-exit "(import-use node)
(defmacro one (x) x)
(defn main ():i32 (return (one ~`(_* 6 7))))
" 42)))

; --- C3: `~@e`, the splice ----------------------------------------------------
; (design/stage20-macros/computed-macro-arguments.md §4.3)
;
; `~e` is one argument; `~@e` is N. That is what serves the `:rest` family, which
; §2.1 says the feature exists for: without it the stage covers `macmap` and none
; of its friends. Substitution happens before the arity checks either way, so a
; splice is indistinguishable from having written the elements out.

; §4.3 verbatim, and the same list through `+` — which lowers to `macfoldr` only
; above two arguments, so the two units together cover both of that macro's arms.
(deftest s20-computed-arg-splice
  (try (check-source-exit "(import-use node)
(defn s20-nums ():(raw Node) (return `(1 2 3 4)))
(defn main ():i32 (return (macfoldr _+ 0 ~@(s20-nums))))
" 10))
  (try (check-source-exit "(import-use node)
(defn s20-nums2 ():(raw Node) (return `(1 2 3 4)))
(defn main ():i32 (return (+ ~@(s20-nums2))))
" 10))
  (return (ok)))

; A user `:rest` macro gets it with no change of its own, which is the claim in
; §2.1's third bullet. The splice lands in the macro's OWN `:rest`, so what it
; sees is four arguments and not one list.
(deftest s20-computed-arg-splice-rest-macro
  (try (check-source-exit "(import-use node)
(defn s20-nums3 ():(raw Node) (return `(1 2 3 4)))
(defmacro s20-count (:rest args)
  (let ((acc (raw Node)) `0
        (a (raw Node)) args)
    (while (> (ast-len a) 0) (set! acc `(_+ 1 ~acc)) (set! a (ast-rest a)))
    acc))
(defn main ():i32 (return (s20-count ~@(s20-nums3))))
" 4)))

; The empty splice contributes zero arguments — not one null argument, which is
; the failure mode a copy-the-cell implementation would have. `macfoldr` with no
; args is its unit, so 7 says the argument list really is empty.
(deftest s20-computed-arg-splice-empty
  (try (check-source-exit "(import-use node)
(defn s20-nothing ():(raw Node) (return null))
(defn main ():i32 (return (macfoldr _+ 7 ~@(s20-nothing))))
" 7))
  (try (check-source-exit "(import-use node)
(defn s20-nothing2 ():(raw Node) (return null))
(defmacro s20-sum (:rest args) `(macfoldr _+ 100 ~@args))
(defn main ():i32 (return (s20-sum ~@(s20-nothing2))))
" 100))
  (return (ok)))

; Both spellings in one call, against a FIXED-arity macro: `~@` has to widen the
; list to exactly the two arguments the middle needs while `~` stays one, or the
; arity check rejects the call. 1+2+3+4+5.
(deftest s20-computed-arg-splice-mixed
  (try (check-source-exit "(import-use node)
(defn s20-mid ():(raw Node) (return `(2 3)))
(defn s20-one ():(raw Node) (return `4))
(defmacro s20-five (a b c d e) `(_+ ~a (_+ ~b (_+ ~c (_+ ~d ~e)))))
(defn main ():i32 (return (s20-five 1 ~@(s20-mid) ~(s20-one) 5)))
" 15)))

; `macrolet` is on this path for `~@` too, mid-function — the same confirmation
; §4.4 asked for and C2 made for `~`.
(deftest s20-computed-arg-splice-macrolet
  (try (check-source-exit "(import-use node)
(defn s20-pair ():(raw Node) (return `(6 7)))
(defn main ():i32
  (macrolet ((s20-mul (a b) `(_* ~a ~b)))
    (return (s20-mul ~@(s20-pair)))))
" 42)))

; U3 (unquote-operand-typing.md §2): the one-liner U2's diagnostic names. `~n`
; with `n:i32` is an error, so interpolating a computed number needs a node
; constructor — and the producer for a spliced list is the shape that wanted
; one, which C3's units had to write out of quasiquoted literals instead.
(deftest s20-node-int
  (try (check-source-exit "(import-use node)
(defmacro s20-double ()
  (let (n:i32 21)
    `(_* ~(node-int n) 2)))
(defn main ():i32 (return (s20-double)))
" 42))
  (try (check-source-exit "(import-use node)
(defn s20-range ():(raw Node)
  (let ((acc (raw Node)) null
        i:i64 4)
    (while (> i 0)
      (set! acc (as raw:Node (node-cons (as raw:Node (node-int i)) acc 0)))
      (set! i (- i 1)))
    (return acc)))
(defn main ():i32 (return (macfoldr _+ 0 ~@(s20-range))))
" 10))
  (return (ok)))

; ---------------------------------------------------------------------------
; What a place is (dot-forms.md §5 steps 4-6)
; ---------------------------------------------------------------------------
;
; `.` and `.&` are gone and `set!` takes a PLACE. `.` was `_get` verbatim, so
; its sites became `get` (or `_get`, where a user override must be bypassed);
; `.&` became an ARITY OVERLOAD on `ref` — 1-arg is a binding's address,
; 2-arg is a field's, and the two cannot collide because a binding address takes
; a bare symbol. `.set!`, `ptr-set!` and `aset!` became places under one `set!`.
; Every retired spelling stays RESERVED, so the answer is the replacement rather
; than "undefined function" and no user definition can shadow it into silence.

; One refusal, pinned to the line that wrote it. The shell grepped stderr for
; the message alone, which a note at some other location also satisfies.
(defn check-place-refused (src:StrView line:i32 needle:StrView):!void
  (let (p:String (try (test-write-file "t.nuc" src))
        pv:StrView (string-as-view &p)
        c:Compiled (try (compile-path pv)))
    (try (check-error-at (ref c 'diags) pv line needle))
    (drop &c)
    (drop &p))
  (return (ok)))

; The 2-arg `ref` covers every shape `.&` did: a plain field, a nested one,
; an array field (which DECAYS to `ptr:elem` — a pointer-to-array is useless), a
; union member, and a by-value struct receiver.
(deftest s16-ref-2arg
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(defstruct Inner a:i32)
(defstruct Outer p:Inner cells:(array i32 3) n:i32)
(defstruct Holder u:(union as-int:i64 as-f:f64))
(defn by-val (o:Outer):i32 (return (deref (ref &o 'n))))
(defn main ():i32
  (let (o:ptr:Outer (alloca Outer)
        h:ptr:Holder (alloca Holder))
    (set! (deref (ref o 'n)) 5)
    (set! (deref (ref (ref o 'p) 'a)) 6)
    (set! (aref (ref o 'cells) 1) 7)
    (set! (deref (ref (ref h 'u) 'as-int)) 8)
    (let (c:ptr:i32 (ref o 'cells)
          n:i32 5 q:ptr:i32 &n)
      (printf \"%d %d %d %lld %d %d %d\\n\"
              (deref (ref o 'n)) (deref (ref (ref o 'p) 'a))
              (aref c 1) (deref (ref (ref h 'u) 'as-int))
              (by-val (deref o)) (deref q) (aref (ref o 'cells) 1))))
  (return 0))
")))
    (try (check-eq (string-as-view &out) "5 6 7 8 5 5 7\n"))
    (drop &out)))

; `node-type` must split on the same arity the emitter does. Without the mirror
; the 2-arg form types as the BINDING's address (`ptr:ptr:Pt`), which only shows
; up where the type is load-bearing — an argument position and an annotated
; binding, not in the value itself.
(deftest s16-ref-2arg-node-type
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(defstruct Pt x:i32 y:i32)
(defn takes (q:ptr:i32):i32 (return (deref q)))
(defn main ():i32
  (let (p:ptr:Pt (alloca Pt))
    (set! (p 'x) 3)
    (let (q:ptr:i32 (ref p 'x))
      (printf \"%d %d\\n\" (takes (ref p 'x)) (deref q))))
  (return 0))
")))
    (try (check-eq (string-as-view &out) "3 3\n"))
    (drop &out)))

; Both retired spellings answer with the replacement, both stay reserved, and
; `ref`'s own diagnostics name the form the user wrote rather than `.&`.
(deftest s16-dot-forms-retired
  (try (check-place-refused "(defstruct Pt x:i32)
(defn f (p:&Pt):i32 (return (. p 'x)))
" 2 "'.' was retired in Stage 16: use 'get' -- (get p 'field), or head position (p 'field)"))
  (try (check-place-refused "(defstruct Pt x:i32)
(defn f (p:&Pt):ptr:i32 (return (.& p 'x)))
" 2 "'.&' was retired in Stage 16: use the 2-argument 'ref' -- (ref p 'field)"))
  (try (check-place-refused "(defn . (a:i32):i32 (return a))
" 1 "'.' already names a special form"))
  (try (check-place-refused "(defstruct Pt x:i32)
(defn f (p:&Pt):ptr:i32 (return (ref p 'z)))
" 2 "ref: no field 'z' on struct 'Pt'"))
  (try (check-place-refused "(defstruct Pt x:i32)
(defn f (p:&Pt):ptr:i32 (return (ref p 'x 1)))
" 2 "ref expects 1 or 2 args")))

; One program varying one line: a member place in each of its three spellings,
; a nested member, a deref, a pointer element and an array-field element.
;
; The identical-IR half is what the retirement actually claimed — every place
; delegates to the writer it replaced — and the shell asserted only that the
; program printed the right numbers, which four different code paths could also
; do. `compile-source` writes every fixture to the same `t.nuc`, so two modules
; that should agree agree byte for byte.
(defn place-ir (write:StrView):!String
  (let (src:String (str "(defstruct Pt x:i32 y:i32)
(defn f (p:ptr:Pt):i32 " write " (return (_get p 'y)))
")
        ir:String (try (source-ir (string-as-view &src))))
    (drop &src)
    (return (ok ir))))

(deftest s16-set-places
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(defstruct Inner a:i32)
(defstruct Pt x:i32 y:i32 in:Inner cells:(array i32 3))
(defn main ():i32
  (let (p:ptr:Pt (alloca Pt)
        buf:ptr:i32 (alloca i32 4)
        n:i32 0)
    (set! n 7)
    (set! (p 'x) 1)
    (set! (get p 'y) 2)
    (set! (_get p 'y) 3)
    (set! ((ref p 'in) 'a) 4)
    (set! (deref (ref p 'x)) 5)
    (set! (aref buf 2) 6)
    (set! (aref (ref p 'cells) 1) 9)
    (printf \"%d %d %d %d %d %d\\n\"
            n (p 'x) (p 'y) ((ref p 'in) 'a) (aref buf 2)
            (aref (ref p 'cells) 1)))
  (return 0))
")))
    (try (check-eq (string-as-view &out) "7 5 3 4 6 9\n"))
    (drop &out))
  (let (a:String (try (place-ir "(set! (p 'y) 2)"))
        b:String (try (place-ir "(set! (get p 'y) 2)"))
        c:String (try (place-ir "(set! (_get p 'y) 2)"))
        d:String (try (place-ir "(set! (deref (ref p 'y)) 2)")))
    (try (check-golden (string-as-view &b) (string-as-view &a)))
    (try (check-golden (string-as-view &c) (string-as-view &a)))
    (try (check-golden (string-as-view &d) (string-as-view &a)))
    (drop &d)
    (drop &c)
    (drop &b)
    (drop &a)))

; The three retired writers answer with the replacement and stay reserved; a
; place that is not assignable is refused by name; and the delegated writers'
; own diagnostics say `set!`, the only spelling left. `()` reads as a null node,
; so the place judgement has to precede any dereference of it.
(deftest s16-set-writers-retired
  (try (check-place-refused "(defstruct Pt x:i32)
(defn f (p:&Pt):i32 (.set! p 'x 1) (return 0))
" 2 "'.set!' was retired in Stage 16: set! takes a place -- (set! (p 'field) v)"))
  (try (check-place-refused "(defn f (p:ptr:i32):i32 (ptr-set! p 1) (return 0))
" 1 "'ptr-set!' was retired in Stage 16: set! takes a place -- (set! (deref p) v)"))
  (try (check-place-refused "(defn f (a:ptr:i32):i32 (aset! a 0 1) (return 0))
" 1 "'aset!' was retired in Stage 16: set! takes a place -- (set! (aref a i) v)"))
  (try (check-place-refused "(defn aset! (a:i32):i32 (return a))
" 1 "'aset!' already names a special form"))
  (try (check-place-refused "(defn f ():i32 (set! (+ 1 2) 3) (return 0))
" 1 "set!: not an assignable place -- write a name, (deref p), (aref a i), or a member access (r 'field)"))
  (try (check-place-refused "(defn f ():i32 (set! () 3) (return 0))
" 1 "set!: not an assignable place"))
  (try (check-place-refused "(defstruct Pt x:i32)
(defn f (p:&Pt):i32 (set! (p 'zzz) 1) (return 0))
" 2 "set!: no field 'zzz' on struct 'Pt'")))

; A closure body's member place. The receiver sits in head position, which
; `fn-capture-walk` used to skip — `.set!` walked its receiver explicitly.
(deftest s16-set-place-in-closure
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(defn main ():i32
  (let (total:i32 0)
    (let (f (vfn (d:i32):i32 (set! total (+ total d)) (return total)))
      (printf \"%d\\n\" (+ (invoke f 2) (invoke f 3)))))
  (return 0))
")))
    (try (check-eq (string-as-view &out) "7\n"))
    (drop &out)))

; A member place whose key is COMPUTED dispatches to a user `set` method on
; (recv, key, value), reusing the multimethod machinery rather than a second
; extension protocol — so `Vector` and `HashMap` are writable through the place
; form, in both spellings.
(deftest s16-set-generic-collections
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use vector)
(import-use hashmap)
(defn main ():i32
  (with ((v (ref (Vector i32))) (alloca (Vector i32)))
    (vector-init v) (conj v 10) (conj v 20) (conj v 30)
    (let (i:usize (as usize 1))
      (set! (v i) 99)
      (printf \"%d %d %d\\n\" (v (as usize 0)) (v i) (v (as usize 2)))))
  (with ((m (ref (HashMap CStr i32))) (alloca (HashMap CStr i32)))
    (hashmap-init m)
    (let (k:CStr \"a\")
      (set! (m k) 1)
      (set! (get m k) 7)
      (match (get m k) ((some x) (printf \"%d %lld\\n\" x (count m)))
                       (none (printf \"none\\n\")))))
  (return 0))
")))
    (try (check-eq (string-as-view &out) "10 99 30\n7 1\n"))
    (drop &out)))

; A LITERAL selector is always the field, even on a receiver that HAS a `set`
; method — otherwise a collection could no longer write its own fields, which is
; the write side of the `_get` recursion trap. The method's return type is the
; place's type, which is the `node-type` mirror.
(deftest s16-set-generic-literal-is-the-field
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(defstruct Box n:i32 hits:i32)
(defn set ((self (ref Box)) (k i32) (x i32)):i32
  (set! (self 'hits) (+ (_get self 'hits) 1))
  (set! (self 'n) (+ (_get self 'n) x))
  (return (_get self 'n)))
(defn main ():i32
  (let (b:ptr:Box (alloca Box) k:i32 0)
    (set! (b 'n) 1) (set! (b 'hits) 0)
    (let (r:i32 (set! (b k) 10))
      (printf \"%d %d %d\\n\" r (_get b 'n) (_get b 'hits))))
  (return 0))
")))
    (try (check-eq (string-as-view &out) "11 11 1\n"))
    (drop &out)))

; A computed key on a READABLE collection with no `set` method says so. The
; field path would answer with a missing-quote note about a non-field.
(deftest s16-set-generic-missing-method
  (try (check-place-refused "(defstruct Ro n:i32)
(defn invoke ((self (ref Ro)) i:i32):i32 (return (+ (_get self 'n) i)))
(defn main ():i32
  (let (r:ref:Ro (alloca Ro) k:i32 0)
    (set! (r k) 5))
  (return 0))
" 5 "&Ro has no `set` method -- a computed key writes through the `set` generic")))

; ---------------------------------------------------------------------------
; Keyword and symbol elements in container literals
; ---------------------------------------------------------------------------
;
; Design: design/stage16-ergonomics/container-literal-elements.md §1. The
; success paths are examples/keyword-lit-test.nuc; what needed coverage is the
; refusals, which had none before this item.
;
; Every unit here pins the LINE, which the shell could not: it grepped the whole
; stderr blob, so a diagnostic raised anywhere in the ten-line import preamble
; would have satisfied it.

; The preamble is ten lines, so every mixed-literal body below is line 11.
(defn kwlit-src (body:StrView):String
  (return (str "(import-use \"stdio.h\")
(import-use strview)
(import-use hash)
(import-use keyword)
(import-use allocator)
(import-use coll)
(import-use iterator)
(import-use hashset)
(import-use hashmap)
(import-use vector)
" body "
")))

(defn check-kwlit (body:StrView needle:StrView):!void
  (let (s:String (kwlit-src body))
    (try (check-place-refused (string-as-view &s) 11 needle))
    (drop &s))
  (return (ok)))

; A set of `Keyword` will not take a string. The two conflicting types are named
; in the message, and pinned — the shell's needle stopped at "mixed element
; types", which is the half that cannot tell this apart from any other mixture.
(deftest s16-kwlit-refused-mix-set
  (try (check-kwlit "(defn main ():i32 (with ((s (ref (HashSet Keyword))) #{:a \"b\"}) 0) 0)"
                    "set literal: mixed element types -- 'Keyword' and 'StrView'"))
  (return (ok)))

; The vector form reports no types. Measured, not chosen: see the deferred entry
; on mixed-literal diagnostics naming their types inconsistently.
(deftest s16-kwlit-refused-mix-vec
  (try (check-kwlit "(defn main ():i32 (with ((v (ref (Vector Keyword))) [:a 1]) 0) 0)"
                    "vector literal: mixed element types"))
  (return (ok)))

(deftest s16-kwlit-refused-mix-key
  (try (check-kwlit "(defn main ():i32 (with ((m (ref (HashMap Keyword i32))) {:a 1 \"b\" 2}) 0) 0)"
                    "map literal: mixed key types -- 'Keyword' and 'StrView'"))
  (return (ok)))

(deftest s16-kwlit-refused-mix-val
  (try (check-kwlit "(defn main ():i32 (with ((m (ref (HashMap Keyword Keyword))) {:a :x :b 2}) 0) 0)"
                    "map literal: mixed value types"))
  (return (ok)))

; A quoted symbol lowers to `ptr:Node`, so mixing one with a string is the same
; refusal reported over the two lowered types.
(deftest s16-kwlit-refused-mix-sym
  (try (check-kwlit "(defn main ():i32 (with ((s (ref (HashSet (ref Node)))) #{'a \"b\"}) 0) 0)"
                    "set literal: mixed element types -- '&Node' and 'StrView'"))
  (return (ok)))

; Element kinds still refused at a `(HashSet (ref Node))`. These used to share
; one blanket "must be scalar literals" message; the collection-literal-variables
; item removed that refusal, so each now fails for its own reason — and those
; reasons are what the shape check always meant. A quoted LIST or INT is
; `(raw Node)`, not the `(ref Node)` a quoted symbol lowers to, so nullability
; refuses it; a bare symbol is a variable reference, now admitted as an element,
; so it reports the missing variable instead. Losing the blanket message is the
; feature; losing the refusals would be the bug.
;
; This preamble is eight lines, so each body is line 9.
(defn symlit-src (elems:StrView):String
  (return (str "(import-use \"stdio.h\")
(import-use numeric)
(import-use node)
(import-use hash)
(import-use allocator)
(import-use coll)
(import-use iterator)
(import-use hashset)
(defn main ():i32 (with ((s (ref (HashSet (ref Node)))) " elems ") 0) 0)
")))

(defn check-symlit (elems:StrView needle:StrView):!void
  (let (s:String (symlit-src elems))
    (try (check-place-refused (string-as-view &s) 9 needle))
    (drop &s))
  (return (ok)))

(deftest s16-symlit-refused-qlist
  (try (check-symlit "#{'(a b) '(c d)}"
                     "argument: raw pointer where non-null (ref ...) is required"))
  (return (ok)))

(deftest s16-symlit-refused-qint
  (try (check-symlit "#{'1 '2}"
                     "argument: raw pointer where non-null (ref ...) is required"))
  (return (ok)))

(deftest s16-symlit-refused-bare
  (try (check-symlit "#{a b}" "undefined: a — not defined anywhere in this compilation unit"))
  (return (ok)))

(deftest s16-symlit-refused-call
  (try (check-symlit "#{(f x)}" "unknown: f — not defined anywhere in this compilation unit"))
  (return (ok)))

; Without `(import-use keyword)` the expansion names a type the unit cannot see.
; The note must point at the FILE, or the reader's expansion looks like a
; compiler bug to whoever wrote `#{:a :b}`. The shell grepped for the head and
; the path independently, so a note belonging to some other diagnostic would
; have satisfied it; here both are matched against one record.
(deftest s16-kwlit-missing-import-names-file
  (let (p:String (try (test-write-file "noimp.nuc" "(import-use \"stdio.h\")
(import-use allocator)
(import-use coll)
(import-use iterator)
(import-use hashset)
(defn main ():i32 (with ((s (ref (HashSet Keyword))) #{:a :b}) 0) 0)
"))
        pv:StrView (string-as-view &p)
        c:Compiled (try (compile-path pv)))
    (try (check-error-at (ref c 'diags) pv 6
                         "unknown type: Keyword — not defined anywhere in this compilation unit"))
    (try (check-note-at (ref c 'diags) pv 6
                        "'Keyword' is defined in lib/keyword.nuc, which no import in this unit reaches"))
    (drop &c)
    (drop &p))
  (return (ok)))

; ---------------------------------------------------------------------------
; A quoted symbol is a value, and it is non-null
; ---------------------------------------------------------------------------
;
; `(import-use node)` throughout because a quote is a RUNTIME call since the
; prelude split — without it the list case would fail for the wrong reason and
; the nullability assertion would pass vacuously.

; A quoted symbol fits a `(ref Node)` slot with no cast.
(deftest s16-quoted-symbol-is-ref
  (try (check-source-accepts "(import-use node)
(defn main ():i32 (let (l:(ref Node) (quote a)) (return 0)))
"))
  (return (ok)))

; …and it really is the intern call, not a laundered raw pointer.
(deftest s16-quoted-symbol-lowers-to-intern
  (let (c:Compiled (try (compile-source "(import-use node)
(defn main ():i32 (let (l:(ref Node) (quote a)) (return 0)))
")))
    (try (check-match (compiled-ir &c) "*call ptr @intern-symbol*"))
    (drop &c))
  (return (ok)))

; A quoted LIST stays nullable. If this ever passes, the conditional has been
; flattened and `'()` is being typed non-null.
(deftest s16-quoted-list-stays-raw
  (try (check-place-refused "(import-use node)
(defn main ():i32 (let (l:(ref Node) (quote (a b))) (return 0)))
" 2 "raw pointer where non-null (ref ...) is required"))
  (return (ok)))

; Non-null narrows into a nullable slot, so pre-Stage-16 spellings still build.
(deftest s16-quoted-symbol-still-fits-raw
  (try (check-source-accepts "(import-use node)
(defn main ():i32 (let (l:(raw Node) (quote a)) (return 0)))
"))
  (return (ok)))

; ---------------------------------------------------------------------------
; A selector is quoted; a bare symbol is a variable
; ---------------------------------------------------------------------------

; A quoted selector is the field at every form, and a computed one needs no
; annotation to be read as a value: `_get`, `get`, the callable-value form and a
; computed selector all reach the same two fields.
(deftest s16-selector-quoted-is-the-field
  (let (p:String (try (test-write-file "sel.nuc" "(import-use \"stdio.h\")
(import-use node)
(defstruct Pt x:i32 y:i32)
(defn main ():i32
  (let (p:ptr:Pt (alloca Pt))
    (set! (p 'x) 1)
    (set! (deref (ref p 'y)) 2)
    (let (sel:ptr (quote y))
      (printf \"%d %d %d %d\\n\" (_get p 'x) (get p 'y) (p 'x) (p sel))))
  (return 0))
"))
        out:String (try (build-run-file "" "" (string-as-view &p))))
    (try (check-eq (string-as-view &out) "1 2 1 2\n"))
    (drop &out)
    (drop &p))
  (return (ok)))

; A bare symbol is the variable. Unbound, it is refused — and because the
; overwhelmingly likely cause is a missed quote on a real field, the message
; names the receiver and the spelling rather than saying "undefined".
;
; The three fixed-position forms need a literal, and a bare symbol is not one:
; "must be symbol" would describe a bare symbol as failing a test it appears to
; pass. Each names ITS OWN form, which the shell's needle could not see — it was
; the same string for all three, so all three reporting `.set!` would have
; passed.
(deftest s16-selector-bare-is-a-variable
  (try (check-place-refused "(defstruct Pt x:i32 y:i32)
(defn f (p:&Pt):i32 (return (p x)))
" 2 "get: 'x' is undefined here, and a bare symbol in selector position is an ordinary variable -- write (p 'x)"))
  (try (check-place-refused "(defstruct Pt x:i32)
(defn f (p:&Pt):i32 (set! (p x) 1) (return 0))
" 2 ".set!: field name must be a quoted selector -- write 'x"))
  (try (check-place-refused "(defstruct Pt x:i32)
(defn f (p:&Pt):i32 (let (q:ptr:i32 (ref p x)) 0) (return 0))
" 2 "ref: field name must be a quoted selector -- write 'x"))
  (try (check-place-refused "(defstruct Pt x:i32)
(defn f (p:&Pt):i32 (let (v:i32 (_get p x)) 0) (return 0))
" 2 "_get: field name must be a quoted selector -- write 'x"))
  ; A selector that is neither spelling is still refused, and this one carries no
  ; "write 'x" tail because there is no symbol to suggest.
  (try (check-place-refused "(defstruct Pt x:i32)
(defn f (p:&Pt):i32 (set! (p 3) 9) (return 0))
" 2 ".set!: field name must be a quoted selector"))
  (return (ok)))

; ---------------------------------------------------------------------------
; What a program pays for a runtime it never reaches
; ---------------------------------------------------------------------------
;
; Design: design/stage16-ergonomics/compile-time-imports.md §4b. `lib/prelude.nuc`
; had `(import-use node)`, so EVERY program carried alloc-node / the list
; builders / intern-symbol / the intern table and the arena behind them — sixteen
; definitions and 4569 bytes of .text for a program reaching none of it, and an
; unlinkable one for freestanding AVR. The prelude now holds only forms that
; emit no IR and the runtime is a library like any other.
;
; The two halves fail in opposite directions, which is why these are asserted
; here rather than left to `make bootstrap`: too little and a quoting program
; has no `@intern-symbol` to call, a LINK error with no location; too much and
; the saving is silently gone with every test still green.

(defn plain-src ():StrView
  (return "(import-use \"stdio.h\")
(defn main ():i32 (printf \"hi\\n\") (return 0))
"))

; A macro, and an expansion that is ordinary arithmetic needing no runtime.
(defn macro-src ():StrView
  (return "(import-use \"stdio.h\")
(defmacro twice (x) `(_+ ~x ~x))
(defn main ():i32 (let (a:i32 21) (printf \"%d\\n\" (twice a))) (return 0))
"))

; The measured case, as a SET rather than the shell's absence of five names: a
; program that never asked for the runtime defines its own `main` and nothing
; else. Absence alone is satisfied by a module that emits nothing at all.
(deftest s16-prelude-emits-no-node-runtime
  (let (ir:String (try (source-ir (plain-src)))
        names:String (define-names (string-as-view &ir)))
    (try (check-line-set (string-as-view &names) "main
" "a program that quotes nothing"))
    (drop &names)
    (drop &ir))
  (return (ok)))

; The premise the design note had to correct: defining a macro costs nothing,
; because a macro body is JIT'd against the COMPILER's copies. The shell
; compared define COUNTS, which two different sets of the same size satisfy.
(deftest s16-defmacro-costs-no-runtime
  (let (pi:String (try (source-ir (plain-src)))
        mi:String (try (source-ir (macro-src)))
        pn:String (define-names (string-as-view &pi))
        mn:String (define-names (string-as-view &mi)))
    (try (check-line-set (string-as-view &mn)
                         (string-as-view &pn)
                         "defining a macro adds no definition"))
    (drop &mn)
    (drop &pn)
    (drop &mi)
    (drop &pi))
  (return (ok)))

; …and it still RUNS, which is the half a definition set cannot see.
(deftest s16-defmacro-still-expands-without-node
  (let (out:String (try (build-run-source (macro-src))))
    (try (check-eq (string-as-view &out) "42\n"))
    (drop &out))
  (return (ok)))

; A quote is a runtime call, so it is refused by NAME rather than left to fail
; at link time with no location — which is the whole point, so the line is
; pinned; the shell grepped the stderr blob.
(deftest s16-quote-demands-node-import
  (try (check-place-refused "(defn main ():i32 (let (s:(ref Node) (quote a)) (return 0)))
" 1 "quote needs the node runtime — add (import-use node)"))
  (return (ok)))

; The same program with the import compiles — a diagnostic naming a fix that
; does not work is worse than none — and reaches the call the refusal was about.
(deftest s16-quote-import-is-the-fix
  (let (c:Compiled (try (compile-source "(import-use node)
(defn main ():i32 (let (s:(ref Node) (quote a)) (return 0)))
")))
    (try (check-no-errors (ref c 'diags)))
    (try (check-match (compiled-ir &c) "*call ptr @intern-symbol(*"))
    (drop &c))
  (return (ok)))

; The SECOND emission site, and the one easy to miss: a `:rest` call folds its
; tail into Node cells at the CALL, nowhere near emit-quote-tree. A check on
; quote alone leaves this a link error.
(deftest s16-rest-call-demands-node-import
  (try (check-place-refused "(defn takes (:rest xs:i64):i32 (return 0))
(defn main ():i32 (return (takes 1 2)))
" 2 "a :rest call needs the node runtime — add (import-use node)"))
  (return (ok)))

; What the split must not take away: `Node` is a type, the prelude still
; registers it, and reading a field off one emits no call at all — the second
; half is what the shell's comment claimed and its exit-status check could not
; see.
(deftest s16-node-type-survives-without-runtime
  (let (c:Compiled (try (compile-source "(defn f ((n (raw Node))):i32 (return (n 'kind)))
(defn main ():i32 (return 0))
"))
        iv:StrView (compiled-ir &c))
    (try (check-no-errors (ref c 'diags)))
    (try (check-match iv "define i32 @f(*"))
    (try (check-not-match iv "*call *"))
    (drop &c))
  (return (ok)))

; ---------------------------------------------------------------------------
; What a typed slot and a receiver accept
; ---------------------------------------------------------------------------
;
; Design: design/stage16-ergonomics/template-ref-equality.md (SE-1/SE-2) and
; c-boundary-defects.md §2.5 (SV-1). A typed slot checks the TYPE and not only
; the pointer kind; a struct VALUE is a member-access receiver.
;
; Every refusal here is pinned at its line. The shell grepped the whole stderr
; blob and, worse, reused one `got` variable across the greps in a verdict, so
; the FAIL branch reported the LAST diagnostic whichever claim had failed.

; §6.1 at all three positions. Each message names both types, so a regression
; that refuses for the wrong reason cannot pass — and the `takes:` prefix, which
; the shell's needle dropped, is what says which call is blamed.
(deftest s16-se1-template-ref-refused
  (try (check-place-refused "(import-use \"stdio.h\")
(import-use vector)
(defn takes ((v (ref (Vector i64)))):i64 (return (invoke v 0)))
(defn main ():i32
  (with ((a (ref (Vector i32))) [1 2 3])
    (printf \"%lld\\n\" (takes a)))
  (return 0))
" 6 "takes: argument 1 has type &(Vector i32), which does not match parameter type &(Vector i64)"))
  (try (check-place-refused "(import-use \"stdio.h\")
(import-use vector)
(defn main ():i32
  (with ((a (ref (Vector i32))) [1 2 3])
    (let (b:(ref (Vector i64)) a) (return 0))))
" 5 "let: init type mismatch for 'b': value is &(Vector i32), slot is &(Vector i64)"))
  (try (check-place-refused "(import-use \"stdio.h\")
(import-use vector)
(defn main ():i32
  (with ((a (ref (Vector i32))) [1 2 3]
         (b (ref (Vector i64))) [4 5 6])
    (set! b a) (return 0)))
" 6 "set!: type mismatch for 'b': value is &(Vector i32), slot is &(Vector i64)"))
  (return (ok)))

; The runtime shape §6.1 measured: a correctly-typed literal reads element 0 as
; ONE i64. The defect printed 8589934593 — 0x2_00000001, two i32s read at the
; wrong stride — so the value is the assertion.
(deftest s16-se1-template-ref-runtime
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use vector)
(defn takes ((v (ref (Vector i64)))):i64 (return (invoke v 0)))
(defn main ():i32
  (with ((a (ref (Vector i64))) [1 2 3])
    (printf \"%lld\\n\" (takes a)))
  (return 0))
")))
    (try (check-eq (string-as-view &out) "1\n"))
    (drop &out))
  (return (ok)))

; The rule is about pointees, not templates: two plain structs are the same
; defect and the same refusal. The two relaxations FP-1 installed survive —
; pointer KIND is not part of the question (pkind-flow-check owns that) and an
; elem-less bare `ptr` is `void *` — and `defvar` is the SECOND value-into-a-
; typed-slot path, which had the identity hole independently.
(deftest s16-se1-pointee-rule-general
  (try (check-place-refused "(defstruct SA x:i32)
(defstruct SB y:i64 z:i64)
(defn takes (b:(ref SB)):i64 (return (b 'y)))
(defn main ():i32
  (let (a:(ref SA) (SA 7)) (return (as i32 (takes a)))))
" 5 "takes: argument 1 has type &SA, which does not match parameter type &SB"))
  (try (check-source-accepts "(defstruct SA x:i32)
(defn takes (b:(ref SA)):i32 (return (b 'x)))
(defn wild (p:ptr):i32 (return 0))
(defn main ():i32
  (let (a:ptr:SA (SA 7) q:ptr (unsafe/cast ptr (SA 1)))
    (let (r:(ref SA) (unsafe/cast (ref SA) q) w:ptr a)
      (return (+ (takes a) (+ (wild a) (takes r)))))))
"))
  (try (check-place-refused "(defstruct SA x:i32)
(defstruct SB y:i64)
(defvar ga:SA)
(defvar gp:(ref SB) &ga)
(defn main ():i32 (return 0))
" 4 "defvar: ref: 'ga' has type &SA, which does not match &SB"))
  (try (check-source-accepts "(defstruct SA x:i32)
(defvar ga:SA)
(defvar gq:ptr &ga)
(defvar gr:(ref SA) &ga)
(defn main ():i32 (return 0))
"))
  (return (ok)))

; SE-2: a constructor whose type variable appears only in its RETURN type is
; stamped once per instance, under a symbol saying which. Asserted on the
; `define` and by COUNT: the shell grepped the mangled name as a substring,
; which the CALL site carries too — so a module that named both instances and
; defined neither, the unmonomorphized-template failure `tyname-resolvable`
; exists to catch, satisfied it.
(deftest s16-se2-want-stamped-instances
  (let (c:Compiled (try (compile-source "(import-use \"stdio.h\")
(import-use vector)
(defn main ():i32
  (let (a:(ref (Vector i32)) (vector-new-in (default-allocator))
        b:(ref (Vector i64)) (vector-new-in (default-allocator)))
    (conj a 5) (conj b 7000000000)
    (let (i:usize 0)
      (printf \"%d %lld\\n\" (invoke a i) (invoke b i))))
  (return 0))
"))
        iv:StrView (compiled-ir &c))
    (try (check-eq-int
           (count-matching-lines iv "define*@vector_new_in.pAllocHandle.$r.pVector.i32(*")
           1 "one stamp for the i32 instance"))
    (try (check-eq-int
           (count-matching-lines iv "define*@vector_new_in.pAllocHandle.$r.pVector.i64(*")
           1 "one stamp for the i64 instance"))
    (drop &c))
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use vector)
(defn main ():i32
  (let (a:(ref (Vector i32)) (vector-new-in (default-allocator))
        b:(ref (Vector i64)) (vector-new-in (default-allocator)))
    (conj a 5) (conj b 7000000000)
    (let (i:usize 0)
      (printf \"%d %lld\\n\" (invoke a i) (invoke b i))))
  (return 0))
")))
    (try (check-eq (string-as-view &out) "5 7000000000\n"))
    (drop &out))
  (return (ok)))

; SV-1: a struct VALUE is a receiver. All three read spellings against a
; by-value parameter, straight off a call result with no binding at all, and
; `.set!` on a by-value local mutating the local copy as in C.
(deftest s16-sv1-struct-value-receiver
  (let (out:String (try (build-run-source "(declare printf (fmt:CStr):i32)
(defstruct Pt x:i64 y:i64)
(defn mk (n:i64):Pt (return (Pt n (* n 2))))
(defn sum (p:Pt):i64 (return (+ (get p 'x) (+ (p 'y) (_get p 'x)))))
(defn direct ():i64 (return (get (mk 5) 'y)))
(defn main ():i32
  (let (v:Pt (mk 3))
    (printf \"%lld %lld %lld %lld\\n\" (sum v) (direct) (get v 'x) (v 'y))
    (set! (v 'x) 40)
    (printf \"%lld %d\\n\" (get v 'x) (if (= (ref v 'y) null) 0 1))
    (return 0)))
")))
    (try (check-eq (string-as-view &out) "12 10 3 6
40 1
"))
    (drop &out))
  (return (ok)))

; The other half: `.set!` and `ref` need the receiver's STORAGE, so a
; temporary stays an error rather than a store into something about to be
; discarded — which is also what keeps a pointer into that copy from being
; returned. Each message is pinned WHOLE: the shell's needles stopped before
; `-- bind it to a name first`, the half that says what to do.
(deftest s16-sv1-lvalue-and-refusals
  (try (check-place-refused "(defstruct Pt x:i64 y:i64)
(defn mk (n:i64):Pt (return (Pt n n)))
(defn main ():i32 (set! ((mk 1) 'x) 5) (return 0))
" 3 ".set!: the receiver is a temporary struct value, so it has no address -- bind it to a name first"))
  (try (check-place-refused "(defstruct Pt x:i64 y:i64)
(defn mk (n:i64):Pt (return (Pt n n)))
(defn leak ():ptr:i64 (return (ref (mk 1) 'x)))
(defn main ():i32 (return 0))
" 3 "ref: the receiver is a temporary struct value, so it has no address -- bind it to a name first"))
  ; A non-struct receiver is still refused, and the message names BOTH legal
  ; receivers now that a value is one of them.
  (try (check-place-refused "(defstruct Pt x:i64 y:i64)
(defn main ():i32 (let (k:i64 5) (return (as i32 (_get k 'x)))))
" 2 "_get: operand must be a struct or union, or a pointer to one"))
  ; A missing field on a VALUE receiver reports the FIELD, not the receiver —
  ; only possible if the type pass unwrapped it in lockstep.
  (try (check-place-refused "(defstruct Pt x:i64 y:i64)
(defn f (p:Pt):i64 (return (_get p 'zzz)))
(defn main ():i32 (return 0))
" 2 "_get: no field 'zzz' on struct 'Pt'"))
  (return (ok)))

; ---------------------------------------------------------------------------
; What the compiler records when it reads a signature
; ---------------------------------------------------------------------------

; `tyname-resolvable` (src/generics.nuc) decides whether a symbol in a stamped
; method's type pattern names a CONCRETE type or a free type variable. Read as a
; tyvar, a concrete argument makes the stamp look like an unmonomorphized
; template, so `emit-defn` skips its define while the call site still names its
; ir-name — an undefined symbol only LLVM's parser catches, which is why the
; assertion is `llvm-as` rather than the shell's hand-rolled `comm` over the
; call and define lines.
(defn check-tyname-stamps (t:StrView):!void
  (let (s:String (str "(import-use vector)
(defn main ():i32
  (with ((v (ref (Vector " t "))) (alloca (Vector " t ")))
    (vector-init v))
  (return 0))
")
        c:Compiled (try (compile-source (string-as-view &s))))
    (try (check-no-errors (ref c 'diags)))
    (try (check-ir-parses (compiled-ir &c)))
    (drop &c)
    (drop &s))
  (return (ok)))

; The whole builtin set, because it had drifted from `parse-type-name` three
; times (__fnty_N, ptr:X, and `Char`). `raw` is included: the shell listed it,
; said it was the point of listing it, then `continue`d past it before writing
; a file — so the one name singled out was the one never exercised, and it
; stamps and parses like the rest.
(deftest builtin-tyname-resolvable
  (try (check-tyname-stamps "Char"))
  (try (check-tyname-stamps "usize"))
  (try (check-tyname-stamps "ssize"))
  (try (check-tyname-stamps "i32"))
  (try (check-tyname-stamps "ui8"))
  (try (check-tyname-stamps "f64"))
  (try (check-tyname-stamps "bool"))
  (try (check-tyname-stamps "ptr"))
  (try (check-tyname-stamps "CStr"))
  (try (check-tyname-stamps "Err"))
  (try (check-tyname-stamps "raw"))
  (return (ok)))

; keyword-markers.md §7, follow-up 1: the two signature-registration sites
; inferred `has-rest` from `(< (defn-params-count …) (node-len …))`, which is
; equally true of an `:optional` list — so every `:optional` defn registered
; has-rest = 1. `finalize-generics` binds that Type for a SOLITARY name, so a
; call above the definition took the `:rest` path; the widening dispatch tiers
; gate on `(= (m has-rest) 0)`, so an overloaded one never resolved.
;
; The shell reported four distinct FAIL names under a single PASS name, so the
; names a red run printed did not exist in a green one.
(deftest s16-optional-has-rest
  ; Solitary, called from ABOVE its definition, optional omitted — the prescan
  ; Type verbatim. Before the fix this reported `a :rest call needs the node
  ; runtime` for a defn with no `:rest` in it.
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(defn caller ():i64 (return (early 1)))
(defn early (a:i32 :optional (b:i64 5)):i64 (return b))
(defn main ():i32 (printf \"%ld\\n\" (caller)) (return 0))
")))
    (try (check-eq (string-as-view &out) "5\n"))
    (drop &out))
  ; Overloaded, so the call resolves through the generic registry rather than
  ; the scope binding; the literal 3 needs widening to i64, which lands it in
  ; the adapt tier — the one gated on has-rest.
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(defn pick (a:CStr :optional (b:i64 7)):i64 (return b))
(defn pick (a:i32):i64 (return (as i64 a)))
(defn main ():i32 (printf \"%ld %ld\\n\" (pick \"x\" 3) (pick 5)) (return 0))
")))
    (try (check-eq (string-as-view &out) "3 5\n"))
    (drop &out))
  ; The second site: the same overload set arriving as `.nuch` `defmethod`
  ; entries. A SOLITARY `:optional` defn exports a `(declare …)` its own
  ; importer refuses, so the overloaded shape is the only round-trip there is.
  ; `resolve-import` tries `.nuc` in every search directory before any `.nuch`,
  ; so the source sits outside them.
  (let (src:String (try (test-scratch-sub "optsrc"))
        hdr:String (try (test-scratch-sub "optlib"))
        use:String (try (test-scratch-sub "optuse"))
        hv:StrView (string-as-view &hdr)
        lib:String (try (write-into (string-as-view &src) "optlib.nuc"
                          "(defn pick (a:CStr :optional (b:i64 7)):i64 (return b))
(defn pick (a:i32):i64 (return (as i64 a)))
"))
        u:String (try (write-into (string-as-view &use) "u.nuc"
                        "(import-use \"stdio.h\")
(import-use optlib)
(defn main ():i32 (printf \"%ld\\n\" (pick \"x\" 3)) (return 0))
")))
    (let (h:String (try (emit-into "" "--emit-nuch" (string-as-view &lib)
                                   hv "optlib.nuch")))
      (drop &h))
    (let (c:Compiled (try (compile-path-in hv (string-as-view &u)))
          iv:StrView (compiled-ir &c))
      ; Both members: the round trip is of the overload SET, and the shell asked
      ; only about the `:optional` one.
      (try (check-line iv "declare i64 @pick.cstr.i64(ptr, i64)"))
      (try (check-line iv "declare i64 @pick.i32(i32)"))
      (drop &c))
    (drop &u)
    (drop &lib)
    (drop &use)
    (drop &hdr)
    (drop &src))
  ; The rule the fix must not lose: a real `:rest` defn still registers has-rest
  ; at the prescan, so a forward call folds its tail into a node list.
  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
(import-use node)
(defn caller ():i64 (return (sum 1 2 3 4)))
(defn sum (:rest args:i64):i64
  (let (lst:raw:Node (unsafe/cast raw:Node args)
        total:i64 0)
    (dotimes (i (node-len lst))
      (set! total (+ total (unsafe/cast i64 (node-at lst i)))))
    total))
(defn main ():i32 (printf \"%ld\\n\" (caller)) (return 0))
")))
    (try (check-eq (string-as-view &out) "10\n"))
    (drop &out))
  (return (ok)))

; Stage 14 defn-signature.md S1: the `?`/`!` sugar returns (`:!ptr:T`, `:!i32`,
; `:?ptr:T`) and a trailing `noreturn` parse in the new return position, and the
; define carries the LLVM attribute. Whole `define` lines, not the substrings
; the shell matched — a signature test that cannot see the parameter list is
; not checking the signature.
(deftest s1-sugar-rets-and-noreturn
  (let (c:Compiled (try (compile-path "tests/fixtures/s1-sugar-rets.nuc"))
        iv:StrView (compiled-ir &c))
    (try (check-no-errors (ref c 'diags)))
    (try (check-line iv "define ptr @lookup(ptr %p.arg, i32 %i.arg) section \".text.lookup\" {"))
    (try (check-line iv "define i64 @checked(i32 %x.arg) section \".text.checked\" {"))
    (try (check-line iv "define ptr @maybe-pt(i1 %give.arg, ptr %p.arg) section \".text.maybe-pt\" {"))
    (try (check-line iv "define void @spin(ptr %m.arg) noreturn section \".text.spin\" {"))
    (drop &c))
  (return (ok)))

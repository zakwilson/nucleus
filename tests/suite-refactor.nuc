; Stage 26 — Nucleus refactors Nucleus (design/stage26-refactoring/overview.md).
;
; RF-1: the reader's syntax mode; RF-2: colon chains as data; RF-3a: edits, the
; sugared printer, path globs and the directory walk; RF-3b: `defrewrite`;
; RF-4: `nucleusc --run`; RF-6: operand slots; RR-1: `nucleusc --resolve`'s
; definition records. Every unit but the expansion errors, RF-4's and RR-1's runs in process: a syntax read is a library call, and its
; answer is a value to compare against `read-all`'s. The whole-corpus claims are
; scripts/stage26/syn-corpus.nuc's, and the rules' are the sweep replays'.

(import-use "unistd.h")
(import-use "dirent.h")
(import-use nucleus.string)
(import-use nucleus.strview)
(import-use nucleus.vector)
(import-use nucleus.fmt)
(import-use nucleus.test)
(import-use nucleus.node)
(import-use nucleus.intern)
(import-use nucleus.read)
(import-use nucleus.syntax)
(import-use nucleus.slots)
(import-use nucleus.refactor)
(import-use nucleus.file)
(import-use nucleus.create)
(import-use nucleus.process)
(import-use nucleus.edn)
(import-use nucleus.string-split)
(import-use nucleus.allocator)
(import-use nucleus.hashmap)

(defn rf-read (src:StrView):!&SynFile
  (match (read-syntax-all src)
    ((ok f) (return (ok f)))
    ((err e) (fail! "read-syntax-all refused " (quoted src) ": line " (e 'line) ": " (e 'msg)))))

(defn rf-form (f:&SynFile i:usize):&Syn
  (return ((ref f 'forms) i)))

(defn rf-kid (s:&Syn i:usize):&Syn
  (return ((ref s 'kids) i)))

; Kind, text, line and column of one Syn.
(defn rf-check-syn (f:&SynFile s:&Syn kind:i32 text:StrView line:i32 col:i32):!void
  (try (check-eq (syn-text f s) text))
  (try (check-eq-int (as i64 (s 'kind)) (as i64 kind) "kind"))
  (try (check-eq-int (as i64 (s 'line)) (as i64 line) "line"))
  (try (check-eq-int (as i64 (s 'col)) (as i64 col) "col"))
  (return (ok)))

; `check-eq` copies its message out before the text is dropped.
(defn rf-check-node (n:?&Node want:StrView):!void
  (let (t:String (node-str n)
        r:!void (check-eq (string-as-view &t) want))
    (drop &t)
    (return r)))

; ---------------------------------------------------------------------------
; Every SynKind, and the spans and columns around comments and `#_`
; ---------------------------------------------------------------------------

(deftest rf1-syn-kinds
  (let (f:&SynFile (try (rf-read "a \"s\" c\"c\" \\x (l m) [v] {k 1} #{s} 'q #tag w x:(T)")))
    (try (check-eq-int (as i64 (count (ref f 'forms))) 11 "top-level Syns"))
    (try (rf-check-syn f (rf-form f 0) SYN-ATOM "a" 1 1))
    (try (rf-check-syn f (rf-form f 1) SYN-STR "\"s\"" 1 3))
    (try (rf-check-syn f (rf-form f 2) SYN-STR "c\"c\"" 1 7))
    (try (rf-check-syn f (rf-form f 3) SYN-CHAR "\\x" 1 12))
    (try (rf-check-syn f (rf-form f 4) SYN-LIST "(l m)" 1 15))
    (try (rf-check-syn f (rf-form f 5) SYN-VEC "[v]" 1 21))
    (try (rf-check-syn f (rf-form f 6) SYN-MAP "{k 1}" 1 25))
    (try (rf-check-syn f (rf-form f 7) SYN-SET "#{s}" 1 31))
    (try (rf-check-syn f (rf-form f 8) SYN-PREFIX "'q" 1 36))
    (try (rf-check-syn f (rf-form f 9) SYN-TAGGED "#tag w" 1 39))
    (try (rf-check-syn f (rf-form f 10) SYN-FUSE "x:(T)" 1 46))
    ; The tagged literal's tag is its first kid, so kid i is elem i+1 as for
    ; the other literals.
    (let (t:&Syn (rf-form f 9))
      (try (rf-check-syn f (rf-kid t 0) SYN-ATOM "tag" 1 40))
      (try (check-eq-int (as i64 (syn-elem-index t (rf-kid t 1))) 2 "the value's elem"))
      (try (check-eq-int (as i64 ((rf-kid t 0) 'open)) 0 "a tag's open")))
    (try (check-eq-int (as i64 ((rf-form f 7) 'open)) 2 "#{'s delimiter length"))
    (try (rf-check-node ((rf-form f 5) 'node) "(vector-lit v)"))
    (try (check (= (syn-kid-for-elem (rf-form f 5) 0) null) "no Syn for vector-lit")))
  (return (ok)))

(deftest rf1-syn-spans
  (let (src:StrView "; head
(defn f (x)   ; trailing
  #_ (old x)
  [x
   y])
#_ #_ a b
"
        f:&SynFile (try (rf-read src))
        d:&Syn (rf-form f 0)
        v:&Syn (rf-kid d 3))
    (try (check-eq-int (as i64 (count (ref f 'forms))) 1 "top-level Syns: the discards are not forms"))
    (try (rf-check-syn f d SYN-LIST "(defn f (x)   ; trailing\n  #_ (old x)\n  [x\n   y])" 2 1))
    (try (check-eq-int (as i64 (count (ref d 'kids))) 4 "kids of the defn"))
    (try (rf-check-syn f v SYN-VEC "[x\n   y]" 4 3))
    (try (rf-check-syn f (rf-kid v 1) SYN-ATOM "y" 5 4))
    (try (check (= (v 'parent) d) "the vector's parent"))
    (let (cs:&(Vector SynSpan) (ref f 'comments)
          ds:&(Vector SynSpan) (ref f 'discards))
      (try (check-eq-int (as i64 (count cs)) 2 "comments"))
      (try (check-eq (syn-slice f ((cs 0) 'start) ((cs 0) 'end)) "; head"))
      (try (check-eq (syn-slice f ((cs 1) 'start) ((cs 1) 'end)) "; trailing"))
      ; `#_ #_ a b` is one discard holding another, in order of their starts.
      (try (check-eq-int (as i64 (count ds)) 3 "discards"))
      (try (check-eq (syn-slice f ((ds 0) 'start) ((ds 0) 'end)) "#_ (old x)"))
      (try (check-eq (syn-slice f ((ds 1) 'start) ((ds 1) 'end)) "#_ #_ a b"))
      (try (check-eq (syn-slice f ((ds 2) 'start) ((ds 2) 'end)) "#_ a")))
    (try (check (syn-has-comment? f d) "a comment inside the defn"))
    (try (check (not (syn-has-comment? f v)) "no comment inside the vector"))
    (try (check (syn-has-discard? f d) "a discard inside the defn"))
    (try (check (not (syn-has-discard? f v)) "no discard inside the vector")))
  (return (ok)))

; ---------------------------------------------------------------------------
; The fuse correspondences, and a def-rmacro prefix
; ---------------------------------------------------------------------------

(deftest rf1-syn-fuse
  (let (f:&SynFile (try (rf-read "x:(T) x:ptr:(T) f:(fn i32)(i32) :(ref T) :(fn i32)(i32)"))
        a:&Syn (rf-form f 0)
        b:&Syn (rf-form f 1)
        c:&Syn (rf-form f 2)
        d:&Syn (rf-form f 3)
        e:&Syn (rf-form f 4))
    ; x:(T) -> (x (T)): the atom has no elem, the list is elem 1.
    (try (rf-check-syn f (rf-kid a 0) SYN-ATOM "x:" 1 1))
    (try (rf-check-syn f (rf-kid a 1) SYN-LIST "(T)" 1 3))
    (try (check-eq-int (as i64 (syn-elem-index a (rf-kid a 0))) -1 "the atom's elem"))
    (try (check-eq-int (as i64 (syn-elem-index a (rf-kid a 1))) 1 "the list's elem"))
    (try (check (= (syn-kid-for-elem a 0) null) "no Syn for the name"))
    (try (check (= (syn-kid-for-elem a 1) (rf-kid a 1)) "elem 1 is the list"))
    (try (rf-check-node ((rf-kid a 0) 'node) "x:"))
    ; x:ptr:(T) -> (x (ptr (T))): elem 1 is a synthesized wrapper with no span;
    ; the list is found by identity under it.
    (try (rf-check-node (b 'node) "(x (ptr (T)))"))
    (try (check (= (syn-kid-for-elem b 1) null) "no Syn for the (ptr …) wrapper"))
    (try (check-eq-int (as i64 (syn-elem-index b (rf-kid b 1))) -1 "the list sits under a wrapper"))
    (try (check (= (syn-kid-for-node b (node-at (node-at (b 'node) 1) 1)) (rf-kid b 1))
                "syn-kid-for-node finds the list"))
    ; f:(fn i32)(i32): three kids, the atom and both groups.
    (try (check-eq-int (as i64 (count (ref c 'kids))) 3 "fn-params fuse kids"))
    (try (rf-check-syn f (rf-kid c 1) SYN-LIST "(fn i32)" 1 19))
    (try (rf-check-syn f (rf-kid c 2) SYN-LIST "(i32)" 1 27))
    (try (rf-check-node (c 'node) "(f ((fn i32) (i32)))"))
    ; :(ref T) -> (ref T) itself: the fuse's elems are its list kid's.
    (try (check (= (d 'node) ((rf-kid d 1) 'node)) "a lone ':' returns the list"))
    (try (check (= (syn-kid-for-elem d 1) (rf-kid (rf-kid d 1) 1)) "elem 1 is T"))
    (try (check-eq-int (as i64 (syn-elem-index d (rf-kid d 1))) -1 "the list is the node, not an elem"))
    ; :(fn i32)(i32) -> ((fn i32) (i32)): both groups are elems.
    (try (check-eq-int (as i64 (syn-elem-index e (rf-kid e 1))) 0 "the fn group"))
    (try (check-eq-int (as i64 (syn-elem-index e (rf-kid e 2))) 1 "the param group")))
  (return (ok)))

(deftest rf1-syn-prefix
  (let (f:&SynFile (try (rf-read "(def-rmacro \"$\" interp) $y 'z &w ~@v ' spaced")))
    (let (p:&Syn (rf-form f 1))
      (try (rf-check-syn f p SYN-PREFIX "$y" 1 25))
      (try (check-eq (syn-prefix f p) "$"))
      (try (rf-check-node (p 'node) "(interp y)"))
      (try (check-eq-int (as i64 (syn-elem-index p (rf-kid p 0))) 1 "the operand's elem")))
    (try (check-eq (syn-prefix f (rf-form f 2)) "'"))
    (try (check-eq (syn-prefix f (rf-form f 3)) "&"))
    (try (rf-check-node ((rf-form f 3) 'node) "(ref w)"))
    (try (check-eq (syn-prefix f (rf-form f 4)) "~@"))
    ; The operand may sit apart from its prefix; the spelling is still one byte.
    (let (s:&Syn (rf-form f 5))
      (try (check-eq (syn-prefix f s) "'"))
      (try (rf-check-syn f (rf-kid s 0) SYN-ATOM "spaced" 1 40)))
    (try (check-eq (syn-prefix f (rf-form f 0)) "")))
  (return (ok)))

; ---------------------------------------------------------------------------
; Error parity, and read-all unchanged
; ---------------------------------------------------------------------------

(defn rf-check-same-error (src:StrView):!void
  (match (read-all src)
    ((ok t) (fail! "read-all accepted " (quoted src)))
    ((err ea)
      (match (read-syntax-all src)
        ((ok f) (fail! "read-syntax-all accepted " (quoted src)))
        ((err es)
          (when (or (!= (ea 'line) (es 'line)) (!= (ea 'msg) (es 'msg)) (!= (ea 'note) (es 'note))
                    (!= (strview-from-cstr (err-name (ea 'code)))
                        (strview-from-cstr (err-name (es 'code)))))
            (fail! (quoted src) ": read-all says line " (ea 'line) " " (ea 'msg)
                   ", read-syntax-all says line " (es 'line) " " (es 'msg)))))))
  (return (ok)))

(deftest rf1-syn-error-parity
  (try (rf-check-same-error "(a\n  (b"))
  (try (rf-check-same-error "(a)\n)"))
  (try (rf-check-same-error "[1\n )"))
  (try (rf-check-same-error "\"abc"))
  (try (rf-check-same-error "(f \"\\q\")"))
  (try (rf-check-same-error "\\u{110000}"))
  (try (rf-check-same-error "x::(T)"))
  (try (rf-check-same-error "{1}"))
  (try (rf-check-same-error "(a #_)"))
  (try (rf-check-same-error "#_ #_ a"))
  (try (rf-check-same-error "# x"))
  (try (rf-check-same-error "(def-rmacro \"m\" w)"))
  (try (rf-check-same-error "99999999999999999999"))
  ; One form at a time: the reader's own error, at the same place.
  (let (r:Reader (reader-syntax "(ok) ; c\n(bad"))
    (match (read-syntax-one &r)
      ((ok s) (try (check-eq-int (as i64 (s 'line)) 1 "first form's line")))
      ((err e) (fail! "the first form refused: " (e 'msg))))
    (match (read-syntax-one &r)
      ((ok s) (fail! "the unterminated form read"))
      ((err e) (try (check-eq-int (as i64 (e 'line)) 2 "the error's line"))))
    (if-some (f (reader-syn-file &r))
      (try (check-eq-int (as i64 (count (ref f 'comments))) 1 "comments seen one form at a time"))
      (fail! "a syntax reader with no file")))
  (let (o:Reader (reader "x"))
    (try (check (= (reader-syn-file &o) null) "an ordinary reader has no file")))
  (return (ok)))

(deftest rf1-read-all-unchanged
  (let (src:StrView "; c\n(defn f (x:&T) #_ gone [x 'y] {:k c\"z\"} #{\\a})\nx:(ref T) &w ; tail\n"
        want:StrView "((defn f (x:ref:T) (vector-lit x (quote y)) (hashmap-lit :k c\"z\") (hashset-lit \\u{61})) (x (ref T)) (ref w))")
    (match (read-all src)
      ((ok t) (try (rf-check-node t want)))
      ((err e) (fail! "read-all refused it: " (e 'msg))))
    (let (f:&SynFile (try (rf-read src))
          t:&Node (f 'tree))
      (try (rf-check-node t want))
      ; The Syns point into the very tree the read returned.
      (dotimes (i (node-len t))
        (when (!= ((rf-form f (as usize i)) 'node) (node-at t i))
          (fail! "form " i "'s Syn does not point at the tree's elem")))))
  (return (ok)))

; ---------------------------------------------------------------------------
; RF-2: colon chains as data
; ---------------------------------------------------------------------------

(defn rf-chain (text:StrView n:i64 keyword:bool open:bool):!&Chain
  (let (c:&Chain (chain-segments text))
    (try (check-eq-int (as i64 (count (ref c 'segs))) n "segments"))
    (try (check (= (c 'keyword) keyword) "keyword"))
    (try (check (= (chain-open? c) open) "open"))
    (return (ok c))))

; Segment `i`'s sigil run and body, its span in the atom, and whether a `:` follows.
(defn rf-check-seg (c:&Chain i:usize sigils:StrView body:StrView start:i64 end:i64 colon:bool):!void
  (let (seg:ChainSeg (chain-seg c i))
    (try (check-eq (chain-sigils c i) sigils))
    (try (check-eq (chain-body c i) body))
    (try (check-eq-int (as i64 (seg 'start)) start "segment start"))
    (try (check-eq-int (as i64 (seg 'end)) end "segment end"))
    (try (check (= (seg 'colon) colon) "segment colon"))
    (return (ok))))

(deftest rf2-chain-sigils
  (let (c:&Chain (try (rf-chain "?&Node" 1 false false))
        d:&Chain (try (rf-chain "x:ptr:T" 3 false false))
        e:&Chain (try (rf-chain "?ptr:!T" 2 false false)))
    (try (rf-check-seg c 0 "?&" "Node" 0 6 false))
    (try (rf-check-seg d 0 "" "x" 0 1 true))
    (try (rf-check-seg d 1 "" "ptr" 2 5 true))
    (try (rf-check-seg d 2 "" "T" 6 7 false))
    (try (rf-check-seg e 0 "?" "ptr" 0 4 true))
    (try (rf-check-seg e 1 "!" "T" 5 7 false))
    (try (check-eq-int (as i64 ((chain-seg e 1) 'body)) 6 "the body starts after the sigils")))
  ; A sigil byte past a segment's start is part of its body.
  (try (rf-check-seg (try (rf-chain "foo?" 1 false false)) 0 "" "foo?" 0 4 false))
  (try (rf-check-seg (try (rf-chain "a&b" 1 false false)) 0 "" "a&b" 0 3 false))
  (try (rf-check-seg (try (rf-chain "!=" 1 false false)) 0 "!" "=" 0 2 false))
  (return (ok)))

(deftest rf2-chain-keyword
  ; A keyword's leading `:` separates nothing, so no segment is a name.
  (try (rf-check-seg (try (rf-chain ":k" 1 true false)) 0 "" "k" 1 2 false))
  (let (c:&Chain (try (rf-chain ":k:ptr:T" 3 true false)))
    (try (rf-check-seg c 0 "" "k" 1 2 true))
    (try (rf-check-seg c 2 "" "T" 7 8 false)))
  (let (c:&Chain (try (rf-chain ":k:" 2 true true)))
    (try (rf-check-seg c 1 "" "" 3 3 false)))
  (let (c:&Chain (try (rf-chain "::" 2 true true)))
    (try (rf-check-seg c 0 "" "" 1 1 true))
    (try (rf-check-seg c 1 "" "" 2 2 false)))
  (return (ok)))

(deftest rf2-chain-lone-colon
  ; Two empty segments; a `:` alone is a symbol, not a keyword.
  (let (c:&Chain (try (rf-chain ":" 2 false true)))
    (try (rf-check-seg c 0 "" "" 0 0 true))
    (try (rf-check-seg c 1 "" "" 1 1 false)))
  (let (c:&Chain (try (rf-chain "" 1 false true)))
    (try (rf-check-seg c 0 "" "" 0 0 false)))
  (return (ok)))

(deftest rf2-chain-trailing
  ; A trailing `:` leaves an empty last segment; a trailing sigil run is a
  ; segment with sigils and no body. Both are open.
  (let (c:&Chain (try (rf-chain "x:ptr:" 3 false true)))
    (try (rf-check-seg c 1 "" "ptr" 2 5 true))
    (try (rf-check-seg c 2 "" "" 6 6 false)))
  (try (rf-check-seg (try (rf-chain "x:?" 2 false true)) 1 "?" "" 2 3 false))
  (try (rf-check-seg (try (rf-chain "x:&" 2 false true)) 1 "&" "" 2 3 false))
  (try (rf-check-seg (try (rf-chain "x:?&" 2 false true)) 1 "?&" "" 2 4 false))
  (try (rf-check-seg (try (rf-chain "?!" 1 false true)) 0 "?!" "" 0 2 false))
  (return (ok)))

; `text` glued to `(T)` reads as one fused form exactly when its chain is open.
(defn rf-check-open (text:StrView):!void
  (let (src:String (str text "(T)")
        open:bool (chain-open? (chain-segments text))
        forms:i64 0)
    (match (read-all (string-as-view &src))
      ((ok t) (set! forms (as i64 (node-len t))))
      ((err e) (do)))
    (drop &src)
    (when (!= open (= forms 1))
      (fail! (quoted text) ": chain-open? says " (if open "open" "closed")
             " but the read made " forms " forms"))
    (return (ok))))

; The reader's sigil expansion, re-derived from the segments: a sigil `&` is `ref:`.
(defn rf-check-expansion (text:StrView):!void
  (let (c:&Chain (chain-segments text)
        want:String (make String)
        i:usize 0)
    (while (< i (count (ref c 'segs)))
      (let (sg:StrView (chain-sigils c i)
            j:usize 0)
        (while (< j (sg 'len))
          (if (= (aref (sg 'data) (as i64 j)) 38)
            (str-into &want "ref:")
            (str-into &want (strview-take-bytes (strview-drop-bytes sg j) 1)))
          (set! j (+ j 1))))
      (str-into &want (chain-body c i))
      (when ((chain-seg c i) 'colon) (str-into &want ":"))
      (set! i (+ i 1)))
    (match (read-all text)
      ((ok t) (let (r:!void (rf-check-node (node-at t 0) (string-as-view &want)))
                (drop &want)
                (return r)))
      ((err e) (do (drop &want)
                   (fail! (quoted text) " refused: " (e 'msg)))))
    (return (ok))))

(deftest rf2-chain-agrees-with-reader
  (try (rf-check-open "x:"))
  (try (rf-check-open "x:ptr:"))
  (try (rf-check-open "x:?"))
  (try (rf-check-open "x:&"))
  (try (rf-check-open "?&"))
  (try (rf-check-open "?"))
  (try (rf-check-open ":k:"))
  (try (rf-check-open ":"))
  (try (rf-check-open "x"))
  (try (rf-check-open "foo?"))
  (try (rf-check-open "!="))
  (try (rf-check-open "a&b"))
  (try (rf-check-open "x:ptr:T"))
  (try (rf-check-expansion "?&Node"))
  (try (rf-check-expansion "x:&T"))
  (try (rf-check-expansion "x:?&?&T"))
  (try (rf-check-expansion "a&b:&c"))
  (try (rf-check-expansion "x:ptr:T"))
  (return (ok)))

(deftest rf2-chain-spans
  ; A fuse's atom kid keeps its trailing colon; a segment's span plus the
  ; atom's start is a file span, which is what a `ptr:` -> `&` edit replaces.
  (let (src:StrView "(defn f (p:ptr:(T) q:?&Node))"
        f:&SynFile (try (rf-read src))
        params:&Syn (rf-kid (rf-form f 0) 2)
        fuse:&Syn (rf-kid params 0)
        atom:&Syn (rf-kid fuse 0)
        c:&Chain (chain-segments (syn-text f atom))
        seg:ChainSeg (chain-seg c 1)
        at:usize (+ (atom 'start) (seg 'body)))
    (try (check-eq-int (as i64 (fuse 'kind)) (as i64 SYN-FUSE) "the fuse"))
    (try (check-eq (syn-text f atom) "p:ptr:"))
    (try (check (chain-open? c) "a fuse's atom is open"))
    (try (check-eq (syn-slice f at (+ (atom 'start) (seg 'end))) "ptr"))
    (let (out:String (str (syn-slice f 0 at) "&" (syn-slice f (+ (atom 'start) (+ (seg 'end) 1)) (src 'len)))
          r:!void (check-eq (string-as-view &out) "(defn f (p:&(T) q:?&Node))"))
      (drop &out)
      (try r))
    ; An atom's span is its raw text; its node is the expanded symbol.
    (let (q:&Syn (rf-kid params 1)
          d:&Chain (chain-segments (syn-text f q)))
      (try (check-eq-int (as i64 (q 'kind)) (as i64 SYN-ATOM) "q's kind"))
      (try (rf-check-seg d 1 "?&" "Node" 2 8 false))
      (try (rf-check-node (q 'node) "q:?ref:Node"))))
  (return (ok)))

; ---------------------------------------------------------------------------
; RF-3a: edits
; ---------------------------------------------------------------------------

(defn rf3-check-applied (r:EditsResult want:StrView):!void
  (match r
    ((ok out) (let (o:String out
                    c:!void (check-eq (string-as-view &o) want))
                (drop &o)
                (return c)))
    ((err x) (fail! "edits refused: " (x 'msg)))))

; Refused with `code`, naming exactly the spans [a0,a1) and [b0,b1).
(defn rf3-check-refused (r:EditsResult code:StrView a0:i64 a1:i64 b0:i64 b1:i64):!void
  (match r
    ((ok out) (let (o:String out)
                (drop &o)
                (fail! "edits applied; want a refusal naming [" a0 "," a1 ") and [" b0 "," b1 ")")))
    ((err x)
      (try (check-eq (strview-from-cstr (err-name (x 'code))) code))
      (try (check-eq-int (as i64 ((x 'first) 'start)) a0 "first start"))
      (try (check-eq-int (as i64 ((x 'first) 'end)) a1 "first end"))
      (try (check-eq-int (as i64 ((x 'second) 'start)) b0 "second start"))
      (try (check-eq-int (as i64 ((x 'second) 'end)) b1 "second end"))))
  (return (ok)))

(deftest rf3-edit-positions
  (let (src:StrView "(alpha beta gamma)")
    ; Start, middle and end, added out of order; untouched bytes stay.
    (with (e:Edits (edits-new))
      (edit-span &e 12 17 "G")
      (edit-span &e 0 1 "[")
      (edit-span &e 7 11 "b")
      (edit-span &e 17 18 "]")
      (try (check-eq-int (as i64 (edits-count &e)) 4 "edits"))
      (try (rf3-check-applied (edits-apply src &e) "[alpha b G]")))
    ; Insertions at the very start and end, and a deletion.
    (with (e:Edits (edits-new))
      (edit-span &e 18 18 " ; tail")
      (edit-span &e 0 0 "#_ ")
      (edit-span &e 6 11 "")
      (try (rf3-check-applied (edits-apply src &e) "#_ (alpha gamma) ; tail")))
    (with (none:Edits (edits-new))
      (try (rf3-check-applied (edits-apply src &none) src))
      (try (rf3-check-applied (edits-apply "" &none) ""))))
  (return (ok)))

(deftest rf3-edit-adjacent
  (let (src:StrView "abcdef")
    ; [1,3) and [3,5) touch without sharing a byte.
    (with (e:Edits (edits-new))
      (edit-span &e 3 5 "Y")
      (edit-span &e 1 3 "X")
      (try (rf3-check-applied (edits-apply src &e) "aXYf")))
    ; An insertion where one replacement ends and another starts goes between
    ; them; one at a replacement's start goes before it.
    (with (e:Edits (edits-new))
      (edit-span &e 3 5 "Y")
      (edit-span &e 3 3 "+")
      (edit-span &e 1 3 "X")
      (edit-span &e 1 1 "<")
      (try (rf3-check-applied (edits-apply src &e) "a<X+Yf"))))
  (return (ok)))

(deftest rf3-edit-overlap
  (let (src:StrView "(a\n  (b c))")
    ; Sharing bytes: both are named, earlier start first, with line:col.
    (with (e:Edits (edits-new))
      (edit-span &e 6 9 "x")
      (edit-span &e 5 10 "y")
      (try (rf3-check-refused (edits-apply src &e) "edit-overlap" 5 10 6 9))
      (match (edits-apply src &e)
        ((ok out) (let (o:String out) (drop &o) (fail! "applied")))
        ((err x) (try (check-eq (x 'msg) "edit at 2:3 [5,10) overlaps the edit at 2:4 [6,9)")))))
    ; An insertion inside a replacement, and two insertions at one byte.
    (with (e:Edits (edits-new))
      (edit-span &e 1 4 "x")
      (edit-span &e 2 2 "y")
      (try (rf3-check-refused (edits-apply src &e) "edit-overlap" 1 4 2 2)))
    (with (e:Edits (edits-new))
      (edit-span &e 2 2 "x")
      (edit-span &e 2 2 "y")
      (try (rf3-check-refused (edits-apply src &e) "edit-overlap" 2 2 2 2)))
    ; Past the end, and backwards.
    (with (e:Edits (edits-new))
      (edit-span &e 10 12 "x")
      (try (rf3-check-refused (edits-apply src &e) "edit-out-of-range" 10 12 0 11)))
    (with (e:Edits (edits-new))
      (edit-span &e 4 3 "x")
      (try (rf3-check-refused (edits-apply src &e) "edit-out-of-range" 4 3 0 11)))
    ; The refusal converts to `Err`, so `try` passes it up a `!T` function.
    (with (e:Edits (edits-new))
      (edit-span &e 1 4 "x")
      (edit-span &e 3 5 "y")
      (match (rf3-apply-or-err src &e)
        ((ok n) (fail! "applied"))
        ((err code) (try (check-eq (strview-from-cstr (err-name code)) "edit-overlap"))))))
  (return (ok)))

(defn rf3-apply-or-err (src:StrView e:&Edits):!i64
  (let (out:String (try (edits-apply src e))
        n:i64 (as i64 (byte-len &out)))
    (drop &out)
    (return (ok n))))

; A rule rewrites bottom-up: a form's new text splices its holes' already-edited
; text, then its own edit replaces those inside it.
(deftest rf3-edit-syn-compose
  (let (src:StrView "; keep\n(f (g x) ; note\n   'y)\n"
        f:&SynFile (try (rf-read src))
        call:&Syn (rf-form f 0)
        inner:&Syn (rf-kid call 1))
    (with (e:Edits (edits-new))
      (edit-replace &e (rf-kid inner 0) "h")
      (try (rf3-check-applied (edits-apply-range src &e (inner 'start) (inner 'end)) "(h x)"))
      (try (rf3-check-applied (edits-apply src &e) "; keep\n(f (h x) ; note\n   'y)\n"))
      ; The form's range keeps its comment and layout, with the inner edit applied.
      (match (edits-apply-range src &e (call 'start) (call 'end))
        ((ok whole)
          (let (w:String whole)
            (try (check-eq (string-as-view &w) "(f (h x) ; note\n   'y)"))
            (try (check-eq-int (as i64 (edits-drop-within &e (call 'start) (call 'end))) 1 "dropped"))
            (let (wrapped:String (str "(wrap " (string-as-view &w) ")"))
              (edit-replace &e call (string-as-view &wrapped))
              (drop &wrapped))
            (drop &w)))
        ((err x) (fail! "range refused: " (x 'msg))))
      (try (rf3-check-applied (edits-apply src &e) "; keep\n(wrap (f (h x) ; note\n   'y))\n"))
      ; A range that cuts an edit in two is refused, naming the edit and the range.
      (try (rf3-check-refused (edits-apply-range src &e (+ (call 'start) 1) (src 'len))
                              "edit-out-of-range" (as i64 (call 'start)) (as i64 (call 'end))
                              (as i64 (+ (call 'start) 1)) (as i64 (src 'len))))))
  (return (ok)))

; ---------------------------------------------------------------------------
; RF-3a: the sugared printer
; ---------------------------------------------------------------------------

; `text` read, printed sugared, is `want`, which reads back as the same tree;
; `node-write` still prints `long`.
(defn rf3-check-sugared (text:StrView want:StrView long:StrView):!void
  (match (read-all text)
    ((ok t)
      (let (n:?&Node (node-at t 0)
            s:String (node-str-sugared n)
            c:!void (check-eq (string-as-view &s) want))
        (drop &s)
        (try c)
        (try (rf-check-node n long))
        (match (read-all want)
          ((ok b) (try (check (node-eq (node-at b 0) n) "the sugared text reads back as the tree")))
          ((err e) (fail! (quoted want) " does not read: " (e 'msg))))))
    ((err e) (fail! (quoted text) " does not read: " (e 'msg))))
  (return (ok)))

(deftest rf3-sugared-prefixes
  (try (rf3-check-sugared "(quote x)" "'x" "(quote x)"))
  (try (rf3-check-sugared "(quasiquote (f (unquote x) (unquote-splice ys)))" "`(f ~x ~@ys)"
                          "(quasiquote (f (unquote x) (unquote-splice ys)))"))
  (try (rf3-check-sugared "(deref p)" "@p" "(deref p)"))
  (try (rf3-check-sugared "(ref x)" "&x" "(ref x)"))
  (try (rf3-check-sugared "(ref (Vector T))" "&(Vector T)" "(ref (Vector T))"))
  (try (rf3-check-sugared "''x" "''x" "(quote (quote x))"))
  ; Fallbacks: `&rest` is the retired marker, `~@x` the splice, and a wrong
  ; arity has no prefix spelling.
  (try (rf3-check-sugared "(ref rest)" "(ref rest)" "(ref rest)"))
  (try (rf3-check-sugared "(ref where)" "(ref where)" "(ref where)"))
  (try (rf3-check-sugared "(unquote (deref x))" "(unquote @x)" "(unquote (deref x))"))
  (try (rf3-check-sugared "(ref s 'f)" "(ref s 'f)" "(ref s (quote f))"))
  (try (rf3-check-sugared "(quote)" "(quote)" "(quote)"))
  ; A caller's table adds its own prefixes.
  (let (tbl:&(Vector RMacro) (read-macro-table-new)
        out:String (make String))
    (rd-macro-add tbl "$" (symbol-intern "interp"))
    (match (read-all "(interp (ref y))")
      ((ok t) (node-write-sugared-with &out (node-at t 0) tbl))
      ((err e) (do)))
    (let (c:!void (check-eq (string-as-view &out) "$&y"))
      (drop &out)
      (try c)))
  (return (ok)))

(deftest rf3-sugared-literals
  (try (rf3-check-sugared "(vector-lit a (hashset-lit 1))" "[a #{1}]" "(vector-lit a (hashset-lit 1))"))
  (try (rf3-check-sugared "{:k [1 2]}" "{:k [1 2]}" "(hashmap-lit :k (vector-lit 1 2))"))
  (try (rf3-check-sugared "(vector-lit)" "[]" "(vector-lit)"))
  (try (rf3-check-sugared "#inst \"z\"" "#inst \"z\"" "(tagged-lit inst \"z\")"))
  (try (rf3-check-sugared "(hashmap-lit a)" "(hashmap-lit a)" "(hashmap-lit a)"))
  (try (rf3-check-sugared "(tagged-lit 1 x)" "(tagged-lit 1 x)" "(tagged-lit 1 x)"))
  (return (ok)))

(deftest rf3-sugared-atoms
  (try (rf3-check-sugared "x:ref:T" "x:&T" "x:ref:T"))
  (try (rf3-check-sugared "?ref:Node" "?&Node" "?ref:Node"))
  (try (rf3-check-sugared "x:ref:ref:T" "x:&&T" "x:ref:ref:T"))
  (try (rf3-check-sugared ":k:ref:T" ":k:&T" ":k:ref:T"))
  ; `&T` starting a token is the reader macro, and `&rest` the marker.
  (try (rf3-check-sugared "ref:T" "ref:T" "ref:T"))
  (try (rf3-check-sugared "ref:rest" "ref:rest" "ref:rest"))
  (try (rf3-check-sugared "x:ptr:T" "x:ptr:T" "x:ptr:T"))
  (try (rf3-check-sugared "\\a" "\\a" "\\u{61}"))
  (try (rf3-check-sugared "\\(" "\\(" "\\u{28}"))
  (try (rf3-check-sugared "\\space" "\\space" "\\u{20}"))
  (try (rf3-check-sugared "\\newline" "\\newline" "\\u{a}"))
  (try (rf3-check-sugared "\\u{e9}" "\\u{e9}" "\\u{e9}"))
  (try (rf3-check-sugared "(f c\"z\" 0x1F 1.5)" "(f c\"z\" 31 1.5)" "(f c\"z\" 31 1.5)"))
  (return (ok)))

; ---------------------------------------------------------------------------
; RF-3a: globs and the walk
; ---------------------------------------------------------------------------

(defn rf3-glob (pat:StrView path:StrView want:bool):!void
  (when (!= (path-glob-match &pat &path) want)
    (fail! (quoted pat) (if want " should match " " should not match ") (quoted path)))
  (return (ok)))

(deftest rf3-glob-match
  ; The text glob: `*` crosses `/`.
  (try (check (glob-match &"a*c" &"a/b/c") "text * crosses /"))
  (try (check (glob-match &"a?c" &"abc") "text ?"))
  (try (check (not (glob-match &"a?c" &"ac")) "text ? is one byte"))
  ; The path glob: `*` and `?` stay in a component.
  (try (rf3-glob "lib/*.nuc" "lib/a.nuc" true))
  (try (rf3-glob "lib/*.nuc" "lib/x/a.nuc" false))
  (try (rf3-glob "lib/?.nuc" "lib/a.nuc" true))
  (try (rf3-glob "lib/?.nuc" "lib//.nuc" false))
  ; `**` is zero or more components when another follows, one or more at the end.
  (try (rf3-glob "lib/**/*.nuc" "lib/a.nuc" true))
  (try (rf3-glob "lib/**/*.nuc" "lib/x/y/a.nuc" true))
  (try (rf3-glob "lib/**/*.nuc" "lib/x/y/a.nuch" false))
  (try (rf3-glob "**/*.nuc" "a.nuc" true))
  (try (rf3-glob "lib/**" "lib/x/a" true))
  (try (rf3-glob "lib/**" "lib" false))
  (try (rf3-glob "lib/**/x/**/*.nuc" "lib/x/a.nuc" true))
  (try (rf3-glob "lib/**/x/**/*.nuc" "lib/p/q/x/r/a.nuc" true))
  (try (rf3-glob "lib/a**b" "lib/a/b" false))
  ; A leading `.` needs a literal `.`, in any component.
  (try (rf3-glob "*" ".hidden" false))
  (try (rf3-glob ".*" ".hidden" true))
  (try (rf3-glob "lib/**/*.nuc" "lib/.git/a.nuc" false))
  (try (rf3-glob "lib/.git/*.nuc" "lib/.git/a.nuc" true))
  (try (rf3-glob "src/nucleusc.nuc" "src/nucleusc.nuc" true))
  (return (ok)))

; The DirEntries' names, after `strip` bytes, space-separated.
(defn rf3-names (d:&DirEntries strip:usize):String
  (let (out:String (make String)
        i:usize 0)
    (while (< i (dir-count d))
      (when (> i 0) (str-into &out " "))
      (str-into &out (strview-drop-bytes (dir-name d i) strip))
      (set! i (+ i 1)))
    (return out)))

(defn rf3-check-names (r:!DirEntries strip:usize want:StrView):!void
  (let (d:DirEntries (try r)
        got:String (rf3-names &d strip)
        c:!void (check-eq (string-as-view &got) want))
    (drop &got)
    (drop &d)
    (return c)))

(deftest rf3-walk
  (let (root:String (try (test-scratch-sub "tree"))
        rv:StrView (string-as-view &root)
        n:usize (+ (rv 'len) 1)
        pat:String (make String))
    (dotimes (i 6)
      (let (p:String (str rv "/" (case i 0 "a" 1 "b" 2 "b/c" 3 ".hid" 4 "a-dir" "e")))
        (try (make-dir (string-as-view &p)))
        (drop &p)))
    (dotimes (i 8)
      (let (p:String (str rv "/" (case i 0 "a.nuc" 1 "a/x.nuc" 2 "a-b.nuc" 3 "b/c/deep.nuc"
                                        4 ".hid/h.nuc" 5 ".z.nuc" 6 "a-dir/y.nuch" "top.txt"))
            pv:StrView (string-as-view &p)
            fh:File (try (file-create &pv)))
        (try (file-close &fh))
        (drop &p)))
    ; Bytewise order of whole paths: `a-b.nuc` and `a.nuc` before `a/x.nuc`,
    ; hidden names included, the empty directory `e` contributing nothing.
    (try (rf3-check-names (walk-dir rv) n
                          ".hid/h.nuc .z.nuc a-b.nuc a-dir/y.nuch a.nuc a/x.nuc b/c/deep.nuc top.txt"))
    (str-into &pat rv "/**/*.nuc")
    (try (rf3-check-names (glob-files (string-as-view &pat)) n "a-b.nuc a.nuc a/x.nuc b/c/deep.nuc"))
    (string-clear &pat)
    (str-into &pat rv "/*.nuc*")
    (try (rf3-check-names (glob-files (string-as-view &pat)) n "a-b.nuc a.nuc"))
    (string-clear &pat)
    (str-into &pat rv "/.*/*.nuc")
    (try (rf3-check-names (glob-files (string-as-view &pat)) n ".hid/h.nuc"))
    (string-clear &pat)
    (str-into &pat rv "/a/x.nuc")
    (try (rf3-check-names (glob-files (string-as-view &pat)) n "a/x.nuc"))
    (string-clear &pat)
    (str-into &pat rv "/missing/**/*.nuc")
    (try (rf3-check-names (glob-files (string-as-view &pat)) n ""))
    (string-clear &pat)
    (str-into &pat rv "/a")
    (try (rf3-check-names (glob-files (string-as-view &pat)) n ""))
    ; read-dir now says which entries are directories.
    (let (d:DirEntries (try (read-dir rv))
          kinds:String (make String)
          i:usize 0)
      (while (< i (dir-count &d))
        (str-into &kinds (if (dir-is-dir? &d i) "d" "f"))
        (set! i (+ i 1)))
      (let (c:!void (check-eq (string-as-view &kinds) "dfdfdfddf"))
        (drop &kinds)
        (drop &d)
        (try c)))
    (drop &pat)
    (drop &root))
  (return (ok)))

(defn rf3-kind-of (dir:StrView nm:StrView):i64
  (return (as i64 (dir-resolve-kind dir nm (unsafe/cast ui8 DT_UNKNOWN)))))

; Symlinks are listed and never entered, so a cycle ends; that holds where
; `d_type` is unknown too.
(deftest rf3-walk-links
  (let (root:String (try (test-scratch-sub "links"))
        rv:StrView (string-as-view &root)
        d:String (str rv "/d")
        f:String (str rv "/d/x.nuc")
        loop:String (str rv "/loop")
        ld:String (str rv "/ld"))
    (try (make-dir (string-as-view &d)))
    (let (fv:StrView (string-as-view &f)
          fh:File (try (file-create &fv)))
      (try (file-close &fh)))
    (symlink "." (string-as-cstr &loop))
    (symlink "d" (string-as-cstr &ld))
    (try (rf3-check-names (walk-dir rv) (+ (rv 'len) 1) "d/x.nuc ld loop"))
    (try (check-eq-int (rf3-kind-of rv "loop") (as i64 DT_LNK) "loop"))
    (try (check-eq-int (rf3-kind-of rv "ld") (as i64 DT_LNK) "ld"))
    (try (check-eq-int (rf3-kind-of rv "d") (as i64 DT_DIR) "d"))
    (try (check-eq-int (rf3-kind-of rv "d/x.nuc") (as i64 DT_REG) "x.nuc"))
    (drop &ld)
    (drop &loop)
    (drop &f)
    (drop &d)
    (drop &root))
  (return (ok)))

; ---------------------------------------------------------------------------
; RF-3b: defrewrite
; ---------------------------------------------------------------------------

; `src` rewritten by `rules` is `want`, and its reports, one `line:col kind
; reason` line each, are `reports`. One comparison: a failure keeps only the
; last message.
(defn rf3b-check (rules:&Rules src:StrView want:StrView reports:StrView):!void
  (match (rewrite-source rules src)
    ((err e) (fail! "rewrite-source refused " (quoted src) ": " (e 'msg)))
    ((ok r)
      (let (rr:Rewrite r
            got:String (str (string-as-view (ref rr 'text)) "\n--\n")
            exp:String (str want "\n--\n" reports)
            ps:&(Vector RwReport) (rr 'reports)
            i:usize 0)
        (while (< i (count ps))
          (let (p:RwReport (ps i))
            (str-into &got (p 'line) ":" (p 'col) (if (p 'flagged) " flag " " refuse ") (p 'reason) "\n"))
          (set! i (+ i 1)))
        (let (c:!void (check-eq (string-as-view &got) (string-as-view &exp)))
          (drop &got)
          (drop &exp)
          (drop &rr)
          (return c))))))

(defrewrite rf3b-holes
  (rule (f ~a ~@rest) `(g ~@rest ~a) :multiline)
  (rule (h ~@xs) `[~@xs])
  (rule (pair (p ~x) ~y) `{~y ~x}))

(deftest rf3b-match-holes
  (try (rf3b-check (rf3b-holes) "(f 1 2 3) (f 1) (h) (h a  b) (pair (p 1) 2) (pair (q 1) 2)"
                   "(g 2 3 1) (g 1) [] [a  b] {2 1} (pair (q 1) 2)" ""))
  ; A `~@` keeps what lies between its forms; a comment in a gap the template
  ; drops refuses the rewrite.
  (try (rf3b-check (rf3b-holes) "(f a b ; keep\n   c)\n(f (x) ; gone\n  y)"
                   "(g b ; keep\n   c a)\n(f (x) ; gone\n  y)"
                   "3:1 refuse the rewrite would drop a comment\n"))
  ; A pattern matches the tree as read: `[x]` is `(vector-lit x)`.
  (try (rf3b-check (rf3b-holes) "(f [1 2] 'q)" "(g 'q [1 2])" ""))
  (return (ok)))

; A hole inside a form another rule rewrote first is spliced with its own
; rewrites, and nested matches compose inside out.
(defrewrite rf3b-nest
  (rule (g ~y) `(G ~y))
  (rule (f (g ~x)) `(F ~x))
  (rule (wrap ~x) `(W ~x)))

(deftest rf3b-compose
  (try (rf3b-check (rf3b-nest) "(f (g (g 1)))" "(F (G 1))" ""))
  (try (rf3b-check (rf3b-nest) "(wrap (wrap (g 2)))  ; c\n(f (h 3))" "(W (W (G 2)))  ; c\n(f (h 3))" ""))
  ; A hole's current text decides whether it spans lines.
  (try (rf3b-check (rf3b-nest) "(f (g (wrap\n 1)))" "(F (W 1))" ""))
  (return (ok)))

; Guards see holes as Syns and the form as `self`; spelling is a guard.
(defrewrite rf3b-spell
  (rule (quote ~x) `(never ~x) :when (spelled? self "&"))
  (rule (ref ~x) `(ref ~x) :when (not (spelled? self "&")))
  (rule (quote ~x) `(Q ~x) :when (prefix-form? self))
  (rule (same ~a ~b) `(one ~a) :when (same-text? a b))
  (rule (note ~@xs) :refuse "a comment inside" :when (has-comment? self)))

(deftest rf3b-guards
  ; `(ref rest)` prints long: `&rest` would read back as the retired marker.
  (try (rf3b-check (rf3b-spell) "(ref a) &b (ref rest) (ref (f x)) 'z (quote w)"
                   "&a &b (ref rest) &(f x) (Q z) (quote w)" ""))
  (try (rf3b-check (rf3b-spell) "(same x x) (same x y) (same (a 1) (a  1))"
                   "(one x) (same x y) (same (a 1) (a  1))" ""))
  (try (rf3b-check (rf3b-spell) "(note a)\n(note ; c\n b)" "(note a)\n(note ; c\n b)"
                   "2:1 refuse a comment inside\n"))
  (return (ok)))

(defrewrite rf3b-context
  (rule (probe) `quoted :when (in-quote? self))
  (rule (probe) `templated :when (in-quasiquote? self))
  (rule (probe) `unquoted :when (in-unquote? self))
  (rule (probe) `(code) :when (operand-of? self 'set! 2)))

(deftest rf3b-quote-context
  (try (rf3b-check (rf3b-context)
                   "(probe) '(a (probe)) `(b (probe) ~(c (probe)) ``(d ~(probe))) (quote (probe)) (set! x (probe))"
                   "(probe) '(a quoted) `(b templated ~(c unquoted) ``(d ~templated)) (quote quoted) (set! x (code))"
                   ""))
  (return (ok)))

; A refusal leaves the form as written, its rewritten insides included; a flag
; rewrites and reports.
(defrewrite rf3b-refuse
  (rule (inner) `(INNER))
  (rule (keep ~x) :refuse "kept as written")
  (rule (place ~x) :refuse "a place" :when (operand-of? self 'set! 1))
  (rule (place ~x) `(P ~x))
  (rule (wide ~x) `(narrow ~x) :flag "check this one"))

(deftest rf3b-refusal
  (try (rf3b-check (rf3b-refuse)
                   "(keep (inner))\n(set! (place (inner)) (place (inner)))\n(wide (inner))"
                   "(keep (inner))\n(set! (place (inner)) (P (INNER)))\n(narrow (INNER))"
                   "1:1 refuse kept as written\n2:7 refuse a place\n3:1 flag check this one\n"))
  (return (ok)))

; A fuse's name has no span of its own, so a hole on it is refused.
(defrewrite rf3b-span
  (rule (~n (T)) `(~n U)))

(deftest rf3b-no-span
  (try (rf3b-check (rf3b-span) "x:(T) (y (T))" "x:(T) (y U)"
                   "1:1 refuse ~n has no source span of its own\n"))
  (return (ok)))

(defrewrite rf3b-lines
  (rule (w ~x) `(wrapped ~x)))
(defrewrite rf3b-lines-keep
  (rule (w ~x) `(wrapped ~x) :multiline))
(defrewrite rf3b-lines-shift
  (rule (w ~x) `(wrapped ~x) :reindent)
  (rule (longname ~x) `(s ~x) :reindent))

(deftest rf3b-multiline
  (let (src:StrView "(w (f a\n     b))\n(w \"s\n  t\")")
    (try (rf3b-check (rf3b-lines) src src
                     "1:1 refuse a hole spans lines; the rule needs :multiline or :reindent
3:1 refuse a hole spans lines; the rule needs :multiline or :reindent\n"))
    (try (rf3b-check (rf3b-lines-keep) src "(wrapped (f a\n     b))\n(wrapped \"s\n  t\")" ""))
    ; Continuation lines move with the first line, except inside a string.
    (try (rf3b-check (rf3b-lines-shift) src "(wrapped (f a\n           b))\n(wrapped \"s\n  t\")" ""))
    (try (rf3b-check (rf3b-lines-shift) "(longname (f a\n            b\n\n  c))" "(s (f a\n     b\n\nc))" "")))
  (return (ok)))

; An :emit expression writes the text itself: here the operands swap, each
; keeping the gap before its slot, a line break re-indented as the form's body.
(defn rf3b-swap (out:&RwMatch s:&Syn a:&Syn b:&Syn):void
  (rw-put out "(swapped")
  (rw-put-gap out (((ref s 'kids) 0) 'end) (a 'start) (+ (rw-form-col out) 2))
  (rw-put-syn out b)
  (rw-put-gap out (a 'end) (b 'start) (+ (rw-form-col out) 2))
  (rw-put-syn out a)
  (rw-put out ")"))

(defrewrite rf3b-emit
  (rule (swap ~a ~b) :emit (rf3b-swap out self a b)))

(deftest rf3b-emit-gaps
  (try (rf3b-check (rf3b-emit) "  (swap x\n        (y 1))\n(swap p ; c\n q)"
                   "  (swapped (y 1)\n    x)\n(swapped q ; c\n p)" ""))
  (return (ok)))

; The expansion refuses a template it cannot print, at the rule.
(defn rf3b-refused-rule (rule:StrView msg:StrView):!void
  (let (src:String (str "(import-use nucleus.node)\n(import-use nucleus.syntax)\n(import-use nucleus.refactor)\n"
                        "(defrewrite bad\n  " rule ")\n(defn main ():i32 (return 0))\n")
        p:String (try (test-write-file "t.nuc" (string-as-view &src)))
        pv:StrView (string-as-view &p)
        c:Compiled (try (compile-path pv)))
    (when (c 'ok?)
      (fail! "expected a refusal of " rule))
    (try (check-error-at (ref c 'diags) pv 5 msg))
    (drop &c)
    (drop &p)
    (drop &src))
  (return (ok)))

(deftest rf3b-expand-errors
  (try (rf3b-refused-rule "(rule (f ~x) `(g ~y))" "defrewrite: the template's ~y is not a hole of the pattern"))
  (try (rf3b-refused-rule "(rule (f ~x) `(g ~(h x)))" "defrewrite: a template may unquote only a hole of the pattern"))
  (try (rf3b-refused-rule "(rule (f ~@xs) `(g ~xs))" "defrewrite: ~@xs is a splice hole"))
  (try (rf3b-refused-rule "(rule (f ~@xs ~y) `(g))" "defrewrite: ~@xs must be the last element of its list"))
  (try (rf3b-refused-rule "(rule (f ~x ~x) `(g))" "defrewrite: ~x is bound twice in the pattern"))
  (try (rf3b-refused-rule "(rule (f ~self) `(g))" "defrewrite: ~self cannot be a hole"))
  (try (rf3b-refused-rule "(rule (f ~x) (g ~x))" "defrewrite: a rule's third part is a quasiquote template"))
  (try (rf3b-refused-rule "(rule (f ~x) :refuse \"r\" :flag \"x\")" "defrewrite: a rule option is"))
  (return (ok)))

; RF-4: `nucleusc ARGS…`, both streams and the status kept apart. An empty
; word adds nothing.
(defn rf4-nucleusc (a:StrView b:StrView c:StrView d:StrView):!Output
  (let (cmd:Command (command (compiler-path)))
    (when (not (= a "")) (command-arg &cmd a))
    (when (not (= b "")) (command-arg &cmd b))
    (when (not (= c "")) (command-arg &cmd c))
    (when (not (= d "")) (command-arg &cmd d))
    (command-capture &cmd true)
    (let (o:Output (try (run &cmd)))
      (drop &cmd)
      (return (ok o)))))

; `--run` compiles the whole unit, so a macro may define a top-level `defn` (the
; REPL's per-form path cannot); it runs the constructors, hands `main` the words
; after `--` with the source path as argv[0], and exits with `main`'s value.
(deftest rf4-run-argv-status
  (let (p:String (try (test-write-file "run.nuc" "(import-use nucleus.io)
(defvar g-base:i32 (+ 40 (unsafe/cast i32 (strlen \"ab\"))))
(defmacro rf4-def (n) `(defn ~n (k:i32):i32 (return (+ g-base k))))
(rf4-def rf4-status)
(defn main (argc:i32 argv:ptr):i32
  (dotimes (k argc)
    (print k \"=[\" (as CStr (aref (unsafe/cast &ptr argv) k)) \"]\\n\"))
  (return (rf4-status argc)))
"))
        cmd:Command (command (compiler-path)))
    (command-arg &cmd "--run")
    (command-arg &cmd (string-as-view &p))
    (command-arg &cmd "--")
    (command-arg &cmd "a b")
    (command-arg &cmd "")
    (command-arg &cmd "--apply")
    (command-capture &cmd true)
    (let (o:Output (try (run &cmd))
          want:String (str "0=[" (string-as-view &p) "]\n1=[a b]\n2=[]\n3=[--apply]\n"))
      (try (check-eq (string-as-view (ref o 'out)) (string-as-view &want)))
      (try (check-eq (string-as-view (ref o 'err)) ""))
      (try (check-eq-int (as i64 (exit-code (ref o 'status))) 46 "exit status"))
      (drop &want)
      (drop &o))
    (drop &cmd)
    (drop &p))
  (return (ok)))

; A nullary `main`'s value is the status too, and the flags `--run` cannot mean.
(deftest rf4-run-refusals
  (let (p:String (try (test-write-file "run0.nuc" "(defn main ():i32 (return 7))\n"))
        pv:StrView (string-as-view &p)
        o:Output (try (rf4-nucleusc "--run" pv "" "")))
    (try (check-eq-int (as i64 (exit-code (ref o 'status))) 7 "nullary main"))
    (drop &o)
    (set! o (try (rf4-nucleusc pv "--" "x" "")))
    (try (check-eq-int (as i64 (exit-code (ref o 'status))) 2 "-- without --run"))
    (try (check-contains (string-as-view (ref o 'err)) "there is no --run"))
    (drop &o)
    (set! o (try (rf4-nucleusc "--run" pv "-o" "x.bin")))
    (try (check-eq-int (as i64 (exit-code (ref o 'status))) 2 "--run with -o"))
    (try (check-contains (string-as-view (ref o 'err)) "--run cannot be combined with -o"))
    (drop &o)
    (drop &p))
  (let (p:String (try (test-write-file "run1.nuc" "(defn helper ():i32 (return 1))\n"))
        o:Output (try (rf4-nucleusc "--run" (string-as-view &p) "" "")))
    (try (check-eq-int (as i64 (exit-code (ref o 'status))) 1 "no main"))
    (try (check-contains (string-as-view (ref o 'err)) "defines no 'main' function"))
    (drop &o)
    (drop &p))
  (return (ok)))

; ---------------------------------------------------------------------------
; RF-5: programs inside string literals
; ---------------------------------------------------------------------------

; Each element of `v`, decimal, space-separated.
(defn rf5-ints (v:&(Vector usize)):String
  (let (out:String (str ""))
    (dotimes (i (as i64 (count v)))
      (str-into &out (if (= i 0) "" " ") (v (as usize i))))
    (return out)))

(defn rf5-bytes (t:StrView):String
  (let (out:String (str ""))
    (dotimes (i (as i64 (t 'len)))
      (str-into &out (if (= i 0) "" " ") (as usize (aref (t 'data) i))))
    (return out)))

(defn rf5-source (f:&SynFile s:&Syn):!&StrSource
  (if-some (ss (syn-string-source f s))
    (return (ok ss))
    (fail! "no string source for " (quoted (syn-text f s)))))

(defn rf5-check-text (got:String want:StrView):!void
  (let (g:String got
        r:!void (check-eq (string-as-view &g) want))
    (drop &g)
    (return r)))

; Every escape the reader decodes, against byte values written as numbers, so
; the check does not lean on the decoder it tests.
(deftest rf5-string-source
  (let (f:&SynFile (try (rf-read "\"a\\nb\\x41\\x7g\\u00e9\\0\\\\\\\"\\t\\r\" c\"q\\n\" x"))
        ss:&StrSource (try (rf5-source f (rf-form f 0)))
        cs:&StrSource (try (rf5-source f (rf-form f 1)))
        out:String (str ""))
    (try (rf5-check-text (rf5-bytes (ss 'text)) "97 10 98 65 7 103 195 169 0 92 34 9 13"))
    (try (rf5-check-text (rf5-ints (ref ss 'map)) "1 2 4 5 9 12 13 13 19 21 23 25 27 29"))
    (try (rf5-check-text (rf5-bytes (cs 'text)) "113 10"))
    (try (rf5-check-text (rf5-ints (ref cs 'map)) "33 34 36"))
    ; Only the second byte of the `\u00e9` has no source offset of its own.
    (dotimes (i 14)
      (try (check (= (str-source-split? ss (as usize i)) (= i 7)) "split")))
    (try (check (= (syn-string-source f (rf-form f 2)) null) "an atom has no string source"))
    ; Escaped back, only `\`, `"` and NUL are spelled; the rest is kept, and it
    ; reads back as the same value.
    (str-source-escape &out (ss 'text))
    (try (rf5-check-text (rf5-bytes (string-as-view &out)) "97 10 98 65 7 103 195 169 92 48 92 92 92 34 9 13"))
    (let (lit:String (str "\"" (string-as-view &out) "\"")
          g:&SynFile (try (rf-read (string-as-view &lit)))
          back:&StrSource (try (rf5-source g (rf-form g 0))))
      (try (check-eq (back 'text) (ss 'text)))
      (drop &lit))
    (drop &out))
  (return (ok)))

; `src` rewritten with --in-strings is `want`, with `reports` as rf3b-check
; prints them, and the strings read as programs, as fragments, and skipped.
(defn rf5-check (rules:&Rules src:StrView want:StrView reports:StrView counts:StrView):!void
  (match (rewrite-source-in-strings rules src)
    ((err e) (fail! "rewrite-source-in-strings refused " (quoted src) ": " (e 'msg)))
    ((ok r)
      (let (rr:Rewrite r
            got:String (str (string-as-view (ref rr 'text)) "\n--\n")
            exp:String (str want "\n--\n" reports "--\n" counts)
            ps:&(Vector RwReport) (rr 'reports)
            i:usize 0)
        (while (< i (count ps))
          (let (p:RwReport (ps i))
            (str-into &got (p 'line) ":" (p 'col) (if (p 'flagged) " flag " " refuse ") (p 'reason) "\n"))
          (set! i (+ i 1)))
        (str-into &got "--\n" (rr 'strings) " " (rr 'fragments) " " (rr 'skipped))
        (let (c:!void (check-eq (string-as-view &got) (string-as-view &exp)))
          (drop &got)
          (drop &exp)
          (drop &rr)
          (return c))))))

(defrewrite rf5-q
  (rule (q ~x) `(quoted "s\"t" ~x))
  (rule (bad ~x) :refuse "refused here"))

; An edit inside a string is mapped back and escaped, through two levels.
(deftest rf5-in-strings-escape
  (try (rf5-check (rf5-q) "(q 0) \"(q \\\"in\\\")\" \"(f \\\"(q 1)\\\")\""
                  "(quoted \"s\\\"t\" 0) \"(quoted \\\"s\\\\\\\"t\\\" \\\"in\\\")\" \"(f \\\"(quoted \\\\\\\"s\\\\\\\\\\\\\\\"t\\\\\\\" 1)\\\")\""
                  "" "4 0 0"))
  ; Without --in-strings a string is data.
  (try (rf3b-check (rf5-q) "(q 0) \"(q 1)\"" "(quoted \"s\\\"t\" 0) \"(q 1)\"" ""))
  (return (ok)))

; A refusal inside a string is reported where the file writes it: past escapes,
; across a line break the string holds, and at an escape that spells its `(`.
(deftest rf5-in-strings-reports
  (let (src:StrView "(x \"line1\\n  (bad 2)\" (bad 3))\n\"a\n (bad 4)\" \"\\x28bad 5)\"")
    (try (rf5-check (rf5-q) src src
                    "1:14 refuse refused here\n1:23 refuse refused here\n3:2 refuse refused here\n3:12 refuse refused here\n"
                    "3 0 0")))
  (return (ok)))

; A string that does not read is counted and left, even where a rule would
; match; a piece of a program is read as a fragment, inside a string when the
; string before it in its form left one open.
(deftest rf5-in-strings-skipped
  (try (rf5-check (rf5-q)
                  "\"#! (q 1)\" \"(q 2) (open\" (str \"(g \\\"\" x \"\\\") (q 3)\") \"plain words\""
                  "\"#! (q 1)\" \"(quoted \\\"s\\\\\\\"t\\\" 2) (open\" (str \"(g \\\"\" x \"\\\") (quoted \\\"s\\\\\\\"t\\\" 3)\") \"plain words\""
                  "" "1 3 1"))
  (return (ok)))

(defn rf5-fragment (src:StrView inside:bool):!&SynFile
  (match (read-syntax-fragment src inside)
    ((ok f) (return (ok f)))
    ((err e) (fail! "read-syntax-fragment refused " (quoted src) ": " (e 'msg)))))

; `(c (d`, which the text ends inside: no nodes, and the kids read so far.
(defn rf5-fragment-open (f:&SynFile c:&Syn):!void
  (try (rf-check-syn f c SYN-LIST "(c (d" 1 9))
  (try (check (= (c 'node) null) "an open form has no node"))
  (try (check-eq-int (as i64 (count (ref c 'kids))) 2 "kids of (c (d"))
  (try (rf-check-syn f (rf-kid c 0) SYN-ATOM "c" 1 10))
  (try (rf-check-syn f (rf-kid (rf-kid c 1) 0) SYN-ATOM "d" 1 13))
  (return (ok)))

; A closer with no opener is skipped, a form the text ends inside keeps what it
; read under a null node, and a piece may start inside a string.
(deftest rf5-fragment-read
  (let (f:&SynFile (try (rf5-fragment ") (a b) (c (d" false)))
    (try (check-eq-int (as i64 (count (ref f 'forms))) 2 "forms"))
    (try (rf5-fragment-open f (rf-form f 1)))
    (try (rf-check-syn f (rf-form f 0) SYN-LIST "(a b)" 1 3))
    (try (rf-check-node ((rf-form f 0) 'node) "(a b)"))
    (try (check-eq-int (as i64 (node-len (f 'tree))) 1 "tree elems"))
    (try (check (and (f 'fragment) (not (f 'ends-in-string))) "a fragment, not in a string")))
  (let (f:&SynFile (try (rf5-fragment "(e \"str" false)))
    (try (check (f 'ends-in-string) "ends in a string")))
  (let (f:&SynFile (try (rf5-fragment "x\\\" y\" (z)" true)))
    (try (check-eq-int (as i64 (count (ref f 'forms))) 1 "forms after the string"))
    (try (rf-check-syn f (rf-form f 0) SYN-LIST "(z)" 1 8))
    (try (check (f 'fragment) "a fragment")))
  (let (f:&SynFile (try (rf5-fragment "(a)" false)))
    (try (check (not (f 'fragment)) "a whole program")))
  (match (read-syntax-fragment "#! (a)" false)
    ((ok f) (fail! "read-syntax-fragment read '#!'"))
    ((err e) (try (check-eq (e 'msg) "'#' must be followed by '{', '_' or a tag that starts with a letter"))))
  (return (ok)))

; ---------------------------------------------------------------------------
; RF-6: what each operand of a built-in form is (`slot-kind`)
; ---------------------------------------------------------------------------

; `s` as `text=slot` for a leaf and `slot(kids)` for a form.
(defn rf6-tree (f:&SynFile s:&Syn out:&String):void
  (let (ks:&(Vector &Syn) (ref s 'kids)
        k:StrView (slot-name (slot-kind s)))
    (if (= (count ks) 0)
      (str-into out (syn-text f s) "=" k)
      (do (str-into out k "(")
          (dotimes (i (as i64 (count ks)))
            (when (> i 0) (str-into out " "))
            (rf6-tree f (ks (as usize i)) out))
          (str-into out ")")))))

(defn rf6-trees (f:&SynFile):String
  (let (got:String (str "")
        i:usize 0)
    (while (< i (count (ref f 'forms)))
      (when (> i 0) (str-into &got "\n"))
      (rf6-tree f (rf-form f i) &got)
      (set! i (+ i 1)))
    (return got)))

(defn rf6-check (src:StrView want:StrView):!void
  (let (got:String (rf6-trees (try (rf-read src)))
        c:!void (check-eq (string-as-view &got) want))
    (drop &got)
    (return c)))

; Each definer's operands: names, binders, fields, parameters, types.
(deftest rf6-slot-definers
  (try (rf6-check "(defn f (x:i32 (p &T)) i32 x)\n(declare g (x:i32 i64 (y u8)) :void :noreturn)\n(defvar :volatile v:i32 0)\n(extern :const (E Pt))\n(defconst K:i32 2)\n(defstruct S a:i32 (b T) (:volatile c:u8))\n(defunion (U T) (some v:T :repr x) none)\n(defprotocol P (m (self) i32))\n(deftype A (Vector i32))\n(defenum E X Y)\n(deferror bad \"m\")\n(defmacro mac (a :rest b) a)\n(defcast A B conv)\n(extend S P)"
                  "top(defn=head f=binder params(x:i32=binder binder(p=name type(T=type))) i32=return x=value)\ntop(declare=head g=binder decl-params(x:i32=binder i64=type binder(y=name u8=type)) :void=return :noreturn=attr)\ntop(defvar=head :volatile=attr v:i32=binder 0=value)\ntop(extern=head :const=attr binder(E=name Pt=type))\ntop(defconst=head K:i32=binder 2=value)\ntop(defstruct=head S=name a:i32=field field(b=name T=type) field(:volatile=attr c:u8=field))\ntop(defunion=head name(U=name T=name) arm(some=name v:T=field :repr=attr x=value) none=arm)\ntop(defprotocol=head P=name sig(m=name params(self=binder) i32=return))\ntop(deftype=head A=name type(Vector=type i32=type))\ntop(defenum=head E=name X=name Y=name)\ntop(deferror=head bad=name \"m\"=value)\ntop(defmacro=head mac=name params(a=binder :rest=attr b=binder) a=value)\ntop(defcast=head A=type B=type conv=value)\ntop(extend=head S=type P=type)"))
  (return (ok)))

; Code: bindings, places, clauses and patterns, quoted data and templates;
; a `do` at the top level holds top-level forms, and a call's operands are unknown.
(deftest rf6-slot-code
  (try (rf6-check "(let (:volatile x:i32 0 (y T) (f)) (set! (y 'a) x) (inc! x))\n(if-some (p (g)) (as &T p) (sizeof T))\n(fn (a b:i32):i32 (alloca T 4))\n(cfn &h (c) void (c))\n(match v ((some x) x) (none 0))\n(do (defn h () void) (do (x)))\n(compile-time (defvar w 1))\n(f 'g `(a ~(as T b) ~@c) (quote d) [e (ref f)])\n(when (ok) (as T y))"
                  "top(let=head bindings(:volatile=attr x:i32=binder 0=value binder(y=name T=type) value(f=head)) value(set!=head place(y=head unknown(a=quoted)) x=value) value(inc!=head x=place))\ntop(if-some=head bindings(p=binder value(g=head)) value(as=head type(T=type) p=value) value(sizeof=head T=type))\ntop(fn=head params(a=binder b:i32=binder) :i32=return value(alloca=head T=type 4=value))\ntop(cfn=head value(h=value) params(c=binder) void=return value(c=head))\ntop(match=head v=value clause(pattern(some=pattern x=pattern) x=value) clause(none=pattern 0=value))\ntop(do=head top(defn=head h=binder ()=params void=return) top(do=head top(x=head)))\ntop(compile-time=head top(defvar=head w=binder 1=value))\ntop(f=head unknown(g=quoted) unknown(template(a=head unknown(value(as=head T=type b=value)) unknown(c=value))) unknown(quote=head d=quoted) unknown(e=value value(ref=head f=value)))\ntop(when=head unknown(ok=head) unknown(as=head T=type y=value))"))
  (return (ok)))

; Inside a type: a function type's parameters are a list of types, an anonymous
; struct's members are fields, and a fuse's lists sit under its chain.
(deftest rf6-slot-types
  (try (rf6-check "(defn f (cb:(fn i32)(ptr i32) (g (fn i32) (ptr i64)) (h (BoxedFn (A B) R)) (s (struct a:i32 (b (ptr T))))) ((fn void) (i32)) 0)\n(defn g (x:ptr:(Vector T) y:(T) :where (Ord T) :optional (z 3)):(Maybe T) 0)\n(defvar v:?(T) 1)\n(as ptr:(Vector T) q)"
                  "top(defn=head f=binder params(binder(cb:=binder type(fn=head i32=type) types(ptr=type i32=type)) binder(g=name type(fn=head i32=type) types(ptr=type i64=type)) binder(h=name type(BoxedFn=head types(A=type B=type) R=type)) binder(s=name type(struct=head a:i32=field field(b=name type(ptr=type T=type))))) return(type(fn=head void=type) types(i32=type)) 0=value)\ntop(defn=head g=binder params(binder(x:ptr:=binder type(Vector=type T=type)) binder(y:=binder type(T=type)) :where=attr type(Ord=type T=type) :optional=attr optional(z=binder 3=value)) return(:=return return(Maybe=type T=type)) 0=value)\ntop(defvar=head binder(v:?=binder type(T=type)) 1=value)\ntop(as=head type(ptr:=type type(Vector=type T=type)) q=value)"))
  (return (ok)))

; A form the fragment ends inside has no node, so its operands are unknown;
; a complete form inside it still knows its own.
(deftest rf6-slot-fragment
  (let (f:&SynFile (try (rf5-fragment "(defn f (x:ref:T (as (ptr T) y)" false))
        got:String (rf6-trees f)
        c:!void (check-eq (string-as-view &got)
                          "top(defn=unknown f=unknown unknown(x:ref:T=unknown unknown(as=head type(ptr=type T=type) y=value)))"))
    (drop &got)
    (try c))
  (return (ok)))

; A rule that needs a slot asks `slot-kind`, and refuses where it is unknown.
(defrewrite rf6-ptr
  (rule (ptr ~x) `&~x :when (= (slot-kind self) SLOT-TYPE))
  (rule (ptr ~x) :refuse "no slot" :when (= (slot-kind self) SLOT-UNKNOWN)))

(deftest rf6-slot-guard
  (try (rf3b-check (rf6-ptr) "(defn f (p:(ptr T)) (ptr U) (as (ptr V) (g (ptr W))))"
                   "(defn f (p:&T) (ptr U) (as &V (g (ptr W))))" "1:44 refuse no slot\n"))
  (return (ok)))

; The forms the compiler's desugar splits are the table's `desugar` rows.
(deftest rf6-desugar-rows
  (match (read-all "(defn f) (defn- f) (declare f) (defvar v) (defvar- v) (extern e) (defstruct S) (defstruct- S) (let ()) (with ()) (do) (compile-time) (defmacro m) (defconst K) (fn ()) (f x) ()")
    ((err e) (fail! "read-all refused: " (e 'msg)))
    ((ok t)
      (let (got:String (str ""))
        (dotimes (i (node-len t))
          (str-into &got (if (slots-desugared? (node-at t (as i32 i))) "1" "0")))
        (let (c:!void (check-eq (string-as-view &got) "11111111111100000"))
          (drop &got)
          (try c)))))
  (return (ok)))

; ---------------------------------------------------------------------------
; RR-1: `nucleusc --resolve`, definitions (design/stage26-refactoring/overview.md §4.9)
; ---------------------------------------------------------------------------

; The report on stdout, after a clean compile.
(defn rr1-resolve (path:StrView):!String
  (let (o:Output (try (rf4-nucleusc "--resolve" path "" "")))
    (try (check-eq (string-as-view (ref o 'err)) ""))
    (try (check-eq-int (as i64 (exit-code (ref o 'status))) 0 "--resolve status"))
    (let (out:String (str (string-as-view (ref o 'out))))
      (drop &o)
      (return (ok out)))))

; A string, keyword, symbol, boolean or nil slot's spelling; "<absent>" for a missing key.
(defn rr1-get (m:?&Node k:StrView):StrView
  (let (v:?&Node (edn-get m k))
    (when (= v null) (return "<absent>"))
    (when (= (edn-kind v) EDN-INT) (return "<int>"))
    (return (symbol-as-view ((unsafe/cast &Node v) 's)))))

(defn rr1-int (m:?&Node k:StrView):i64
  (let (v:?&Node (edn-get m k))
    (when (!= (edn-kind v) EDN-INT) (return -1))
    (return ((unsafe/cast &Node v) 'i))))

; Every line is one EDN map; the :def records.
(defn rr1-defs (out:StrView):!&(Vector &Node)
  (let (it:LineIter (strview-lines &out)
        v:&(Vector &Node) (new (Vector &Node) heap))
    (while (not (lines-iter-done &it))
      (let (line:StrView (lines-iter-next &it))
        (when (> (line 'len) 0)
          (match (edn-parse line)
            ((err e) (fail! "not one EDN value: " (quoted line)))
            ((ok m) (do (when (!= (edn-kind m) EDN-MAP) (fail! "not a map: " (quoted line)))
                        (when (= (rr1-get m "record") "def") (conj v (unsafe/cast &Node m)))))))))
    (return (ok v))))

(defn rr1-count (recs:&(Vector &Node) file:StrView name:StrView form:StrView):usize
  (let (n:usize 0)
    (dotimes (i (count recs))
      (let (m:&Node (recs i))
        (when (and (= (rr1-get m "file") file) (= (rr1-get m "name") name) (= (rr1-get m "form") form))
          (set! n (+ n 1)))))
    (return n)))

(defn rr1-def (recs:&(Vector &Node) file:StrView name:StrView form:StrView):!&Node
  (let (n:usize (rr1-count recs file name form))
    (when (!= n 1) (fail! n " records for " form " " name " in " file)))
  (dotimes (i (count recs))
    (let (m:&Node (recs i))
      (when (and (= (rr1-get m "file") file) (= (rr1-get m "name") name) (= (rr1-get m "form") form))
        (return (ok m)))))
  (fail! "unreachable"))

; The span is the name's own bytes in `src`, and :line/:col are where they start.
(defn rr1-check-span (src:StrView m:&Node):!void
  (let (start:i64 (rr1-int m "start")
        end:i64 (rr1-int m "end")
        line:i64 1
        col:i64 1)
    (try (check (and (>= start 0) (> end start) (<= end (as i64 (src 'len)))) "a span inside the file"))
    (try (check-eq (strview-take-bytes (strview-drop-bytes src (as usize start)) (as usize (- end start)))
                   (rr1-get m "name")))
    (dotimes (i start)
      (if (= (aref (src 'data) i) 10)
        (do (set! line (+ line 1)) (set! col 1))
        (set! col (+ col 1))))
    (try (check-eq-int (rr1-int m "line") line "line"))
    (try (check-eq-int (rr1-int m "col") col "col"))
    (return (ok))))

(defn rr1-check-def (recs:&(Vector &Node) src:StrView file:StrView name:StrView form:StrView
                     key:StrView kind:StrView private:StrView):!&Node
  (let (m:&Node (try (rr1-def recs file name form)))
    (try (check-eq (rr1-get m "key") key))
    (try (check-eq (rr1-get m "kind") kind))
    (try (check-eq (rr1-get m "private") private))
    (try (check-eq (rr1-get m "origin") "source"))
    (try (check-eq (rr1-get m "trace") "exact"))
    (try (rr1-check-span src m))
    (return (ok m))))

(defn rr2-last-line (text:StrView):StrView
  (let (it:LineIter (strview-lines &text)
        last:StrView "")
    (while (not (lines-iter-done &it))
      (let (line:StrView (lines-iter-next &it))
        (when (> (line 'len) 0) (set! last line))))
    (return last)))

; Every slot, in order, as one line: the format is a contract within its version.
(deftest rr1-resolve-format
  (let (src:StrView "(defn sq (x:i32):i32 (return (* x x)))\n(defn main ():i32 (return (sq 3)))\n"
        p:String (try (test-write-file "rr1a.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        ov:StrView (string-as-view &out)
        head:String (str "{:record :report :version 4 :unit " (quoted pv) "}\n")
        file:String (str "{:record :file :file " (quoted pv) " :header false}")
        sq:String (str "{:record :def :file " (quoted pv) " :start 6 :end 8 :line 1 :col 7 :name \"sq\" :ns \"user\" :key \"sq\" :kind :function :form \"defn\" :link \"sq\" :host false :private false :origin :source :trace :exact :macro nil :call-start nil :call-end nil :call-line nil :call-col nil}"))
    (try (check (strview-has-prefix ov (string-as-view &head)) "the :report record comes first"))
    (try (check-line ov (string-as-view &file)))
    (try (check-line ov (string-as-view &sq)))
    (let (x:String (str "{:record :ref :file " (quoted pv) " :start 10 :end 11 :line 1 :col 11 :name \"x\" :role :binder :kind :local :target {:file " (quoted pv) " :start 10 :end 11} :why nil :macro nil :call-start nil :call-end nil :call-line nil :call-col nil :via :desugar}"))
      (try (check-line ov (string-as-view &x)))
      (drop &x))
    (try (check (strview-has-prefix (rr2-last-line ov) "{:record :coverage ") "the :coverage record comes last"))
    (try (check-match ov "{:record :coverage :attributed * :ambiguous * :no-span * :why {:macro * :instance * :generated * :absent * :prescan * :mismatch 0} :unframed * :unframed-only * :roles {:local {:attributed * :ambiguous * :macro * :instance * :generated * :absent * :prescan * :mismatch *} :binder {*} :global {*} :head {*} :type {*} :field {*} :arm {*} :macro {*}} :via {:desugar * :rewrite * :instance * :closure * :expansion * :template *}}"))
    (let (recs:&(Vector &Node) (try (rr1-defs ov)))
      (try (rr1-check-def recs src pv "main" "defn" "main" "function" "false"))
      ; The prelude's files are in the unit, so their definitions are in the report.
      (try (check (> (rr1-count recs "lib/nucleus/core.nuc" "nucleus.core" "ns") 0) "the prelude's ns")))
    (drop &sq) (drop &file) (drop &head) (drop &out) (drop &p))
  (return (ok)))

; One record per definer form, the name's segment 0 under attributes, types and
; a template head; overloads share a key; a compile-time body's definers count.
(deftest rr1-resolve-kinds
  (let (src:StrView "(defconst K 3)
(defvar :volatile trap:i32 0)
(defvar- hidden-v:i32 1)
(extern ext-sym:i32)
(defstruct (Box T) v:T)
(defstruct Pt x:i32 y:i32)
(defunion Sh (circle r:i32) dot)
(defenum Color RED GREEN)
(deferror oops \"oops\")
(deftype Count i32)
(defprotocol Area (area (self:&Self):i32))
(defmacro twice (x) `(do ~x ~x))
(declare rr1-ext (x:i32) :i32)
(defn mag (p:&Pt):i32 (return (p 'x)))
(defn mag (b:&(Box i32)):i32 (return (b 'v)))
(defn sized (n:i32):(Box i32) (return ((Box i32) n)))
(compile-time (defn ct-helper ():void (return)))
(defn main ():i32 (return 0))
"
        p:String (try (test-write-file "rr1k.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        recs:&(Vector &Node) (try (rr1-defs (string-as-view &out))))
    (try (rr1-check-def recs src pv "K" "defconst" "K" "const" "false"))
    (try (rr1-check-def recs src pv "trap" "defvar" "trap" "var" "false"))
    (let (m:&Node (try (rr1-def recs pv "hidden-v" "defvar-")))
      (try (check-eq (rr1-get m "private") "true"))
      (try (check-match (rr1-get m "key") "#p*/hidden-v")))
    (try (rr1-check-def recs src pv "ext-sym" "extern" "ext-sym" "var" "false"))
    (try (rr1-check-def recs src pv "Box" "defstruct" "Box" "struct" "false"))
    (try (rr1-check-def recs src pv "Pt" "defstruct" "Pt" "struct" "false"))
    (try (rr1-check-def recs src pv "Sh" "defunion" "Sh" "union" "false"))
    (try (rr1-check-def recs src pv "Color" "defenum" "Color" "enum" "false"))
    (try (rr1-check-def recs src pv "oops" "deferror" "oops" "error" "false"))
    (try (rr1-check-def recs src pv "Count" "deftype" "Count" "type-alias" "false"))
    (try (rr1-check-def recs src pv "Area" "defprotocol" "Area" "protocol" "false"))
    (try (rr1-check-def recs src pv "twice" "defmacro" "twice" "macro" "false"))
    (try (rr1-check-def recs src pv "rr1-ext" "declare" "rr1-ext" "function" "false"))
    (try (rr1-check-def recs src pv "sized" "defn" "sized" "function" "false"))
    (try (rr1-check-def recs src pv "ct-helper" "defn" "ct-helper" "function" "false"))
    (try (check-eq-int (as i64 (rr1-count recs pv "mag" "defn")) 2 "one record per overload"))
    (dotimes (i (count recs))
      (let (m:&Node (recs i))
        (when (and (= (rr1-get m "file") pv) (= (rr1-get m "name") "mag"))
          (try (check-eq (rr1-get m "key") "mag"))
          (try (rr1-check-span src m)))))
    (drop &out) (drop &p))
  (return (ok)))

; Keys across namespaces and privacy, each import's records at its own path,
; and a header's.
(deftest rr1-resolve-namespaces
  (let (lib:StrView "(ns rr1geo)
(defstruct Pt x:i32 y:i32)
(defn norm (p:&Pt):i32 (return (+ (p 'x) (p 'y))))
(defn- helper ():i32 (return 1))
(defstruct- Hid z:i32)
(defmacro twice (x) `(do ~x ~x))
"
        hdr:StrView "(declare rr1-hdecl (i32) :i32)\n"
        lp:String (try (test-write-file "rr1geo.nuc" lib))
        hp:String (try (test-write-file "rr1h.nuch" hdr))
        lpv:StrView (string-as-view &lp)
        hpv:StrView (string-as-view &hp)
        root:String (str "(import-use rr1geo)\n(import-use " (quoted hpv) ")\n(defn- helper ():i32 (return 2))\n(defstruct- Mine a:i32)\n(defn main ():i32 (return (helper)))\n")
        rp:String (try (test-write-file "rr1ns.nuc" (string-as-view &root)))
        rpv:StrView (string-as-view &rp)
        rv:StrView (string-as-view &root)
        out:String (try (rr1-resolve rpv))
        ov:StrView (string-as-view &out)
        recs:&(Vector &Node) (try (rr1-defs ov))
        lf:String (str "{:record :file :file " (quoted lpv) " :header false}")
        hf:String (str "{:record :file :file " (quoted hpv) " :header true}"))
    (try (check-line ov (string-as-view &lf)))
    (try (check-line ov (string-as-view &hf)))
    (let (m:&Node (try (rr1-check-def recs lib lpv "rr1geo" "ns" "rr1geo" "namespace" "false")))
      (try (check-eq (rr1-get m "ns") "rr1geo")))
    (let (m:&Node (try (rr1-check-def recs lib lpv "Pt" "defstruct" "rr1geo/Pt" "struct" "false")))
      (try (check-eq (rr1-get m "ns") "rr1geo")))
    (try (rr1-check-def recs lib lpv "norm" "defn" "rr1geo/norm" "function" "false"))
    ; Private in a namespace is the namespace's key; in `user`, the file's own.
    (try (rr1-check-def recs lib lpv "helper" "defn-" "rr1geo/helper" "function" "true"))
    (try (rr1-check-def recs lib lpv "Hid" "defstruct-" "rr1geo/Hid" "struct" "true"))
    (try (rr1-check-def recs lib lpv "twice" "defmacro" "rr1geo/twice" "macro" "false"))
    (try (rr1-check-def recs hdr hpv "rr1-hdecl" "declare" "rr1-hdecl" "function" "false"))
    (let (m:&Node (try (rr1-def recs rpv "helper" "defn-")))
      (try (check-eq (rr1-get m "ns") "user"))
      (try (check-match (rr1-get m "key") "#p*/helper"))
      (try (rr1-check-span rv m)))
    (try (rr1-check-def recs rv rpv "Mine" "defstruct-" "Mine" "struct" "true"))
    (try (rr1-check-def recs rv rpv "main" "defn" "main" "function" "false"))
    (drop &hf) (drop &lf) (drop &out) (drop &rp) (drop &root) (drop &hp) (drop &lp))
  (return (ok)))

(defn rr1-check-macro (recs:&(Vector &Node) src:StrView file:StrView name:StrView form:StrView
                       macro:StrView trace:StrView call:StrView):!void
  (let (m:&Node (try (rr1-def recs file name form))
        cs:i64 (rr1-int m "call-start")
        ce:i64 (rr1-int m "call-end"))
    (try (check-eq (rr1-get m "origin") "macro"))
    (try (check-eq (rr1-get m "macro") macro))
    (try (check-eq (rr1-get m "trace") trace))
    (try (check-eq (strview-take-bytes (strview-drop-bytes src (as usize cs)) (as usize (- ce cs))) call))
    (if (= trace "arg")
      (try (rr1-check-span src m))
      (try (check-eq-int (rr1-int m "start") -1 "no span")))
    (return (ok))))

; A definer a top-level macro produced: traced to the one operand atom that
; spells its name, else no span; a list the macro returns is the caller's own.
(deftest rr1-resolve-macros
  (let (src:StrView "(defmacro mk (n) `(defn ~n ():i32 (return 1)))
(mk made)
(defmacro mk-fixed () `(defn fixed-name ():i32 (return 2)))
(mk-fixed)
(defmacro mk-two (a b) `(defn ~a ():i32 (return 3)))
(mk-two dup dup)
(defmacro mk-do (a b) `(do (defn ~a ():i32 (return 4)) (defconst ~b 5)))
(mk-do first-fn second-k)
(defmacro keep (form) form)
(keep (defn kept ():i32 (return 6)))
(defmacro outer (n) `(mk ~n))
(outer deep)
(defn main ():i32 (return 0))
"
        p:String (try (test-write-file "rr1m.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        recs:&(Vector &Node) (try (rr1-defs (string-as-view &out))))
    (try (rr1-check-macro recs src pv "made" "defn" "mk" "arg" "(mk made)"))
    (try (rr1-check-macro recs src pv "fixed-name" "defn" "mk-fixed" "absent" "(mk-fixed)"))
    (try (rr1-check-macro recs src pv "dup" "defn" "mk-two" "ambiguous" "(mk-two dup dup)"))
    (try (rr1-check-macro recs src pv "first-fn" "defn" "mk-do" "arg" "(mk-do first-fn second-k)"))
    (try (rr1-check-macro recs src pv "second-k" "defconst" "mk-do" "arg" "(mk-do first-fn second-k)"))
    (try (rr1-check-def recs src pv "kept" "defn" "kept" "function" "false"))
    (try (rr1-check-macro recs src pv "deep" "defn" "outer" "arg" "(outer deep)"))
    (drop &out) (drop &p))
  (return (ok)))

; The report goes to stdout alone, and a failed compile writes none.
(deftest rr1-resolve-refusals
  (let (p:String (try (test-write-file "rr1r.nuc" "(defn main ():i32 (return 0))\n"))
        pv:StrView (string-as-view &p)
        o:Output (try (rf4-nucleusc "--resolve" "--emit-llvm" pv "")))
    (try (check-eq-int (as i64 (exit-code (ref o 'status))) 2 "--resolve with --emit-llvm"))
    (try (check-contains (string-as-view (ref o 'err)) "--resolve writes its report to stdout and cannot be combined with --emit-llvm"))
    (drop &o)
    (set! o (try (rf4-nucleusc "--resolve" "-o" "x.bin" pv)))
    (try (check-eq-int (as i64 (exit-code (ref o 'status))) 2 "--resolve with -o"))
    (try (check-contains (string-as-view (ref o 'err)) "cannot be combined with -o"))
    (drop &o)
    (drop &p))
  (let (p:String (try (test-write-file "rr1e.nuc" "(defn f ():i32 (return 0))\n(defn main ():i32 (return (no-such-fn)))\n"))
        o:Output (try (rf4-nucleusc "--resolve" (string-as-view &p) "" "")))
    (try (check-eq-int (as i64 (exit-code (ref o 'status))) 1 "a failed compile"))
    (try (check-eq (string-as-view (ref o 'out)) ""))
    (try (check-contains (string-as-view (ref o 'err)) "no-such-fn"))
    (drop &o)
    (drop &p))
  (return (ok)))

; A prelude file compiled as the root is read for emission twice (the root
; hoist); each definition still has one record.
(deftest rr1-resolve-root-hoist
  (let (src:String (try (read-file "lib/nucleus/macros.nuc"))
        sv:StrView (string-as-view &src)
        out:String (try (rr1-resolve "lib/nucleus/macros.nuc"))
        recs:&(Vector &Node) (try (rr1-defs (string-as-view &out))))
    (try (rr1-check-def recs sv "lib/nucleus/macros.nuc" "nucleus.macros" "ns" "nucleus.macros" "namespace" "false"))
    (try (rr1-check-def recs sv "lib/nucleus/macros.nuc" "macfoldr" "defmacro" "nucleus.macros/macfoldr" "macro" "false"))
    (drop &out) (drop &src))
  (return (ok)))

; ---------------------------------------------------------------------------
; RR-2: `--resolve`, references (design/stage26-refactoring/overview.md §4.9)
; ---------------------------------------------------------------------------

; The records of one kind.
(defn rr2-recs (out:StrView what:StrView):!&(Vector &Node)
  (let (it:LineIter (strview-lines &out)
        v:&(Vector &Node) (new (Vector &Node) heap))
    (while (not (lines-iter-done &it))
      (let (line:StrView (lines-iter-next &it))
        (when (> (line 'len) 0)
          (match (edn-parse line)
            ((err e) (fail! "not one EDN value: " (quoted line)))
            ((ok m) (when (= (rr1-get m "record") what) (conj v (unsafe/cast &Node m))))))))
    (return (ok v))))

; `k` bytes into occurrence `nth` (from 0) of `needle`.
(defn rr2-at (src:StrView needle:StrView nth:i32 k:i64):!i64
  (let (from:usize 0
        i:i32 0)
    (while (<= i nth)
      (let (rest:StrView (strview-drop-bytes src from))
        (match (strview-find &rest &needle)
          ((some j) (do (when (= i nth) (return (ok (+ (as i64 (+ from j)) k))))
                        (set! from (+ from (+ j 1)))
                        (set! i (+ i 1))))
          (none (fail! "no occurrence " nth " of " (quoted needle)))))))
  (fail! "unreachable"))

(defn rr2-count (refs:&(Vector &Node) file:StrView role:StrView start:i64):usize
  (let (n:usize 0)
    (dotimes (i (count refs))
      (let (m:&Node (refs i))
        (when (and (= (rr1-get m "file") file) (= (rr1-get m "role") role) (= (rr1-int m "start") start))
          (set! n (+ n 1)))))
    (return n)))

; The one :ref of `role` at `start`: its name's own bytes, of `kind`, with no :why;
; `target` is the key, or "" for a local's span, checked by the caller.
(defn rr2-ref (refs:&(Vector &Node) src:StrView file:StrView role:StrView start:i64 name:StrView
               kind:StrView target:StrView):!&Node
  (let (n:usize (rr2-count refs file role start))
    (when (!= n 1) (fail! n " :ref " role " records at " start " for " (quoted name))))
  (dotimes (i (count refs))
    (let (m:&Node (refs i))
      (when (and (= (rr1-get m "file") file) (= (rr1-get m "role") role) (= (rr1-int m "start") start))
        (try (check-eq (rr1-get m "name") name))
        (try (check-eq (rr1-get m "kind") kind))
        (try (check-eq (rr1-get m "why") "nil"))
        (when (!= (target 'len) 0) (try (check-eq (rr1-get m "target") target)))
        (try (rr1-check-span src m))
        (return (ok m)))))
  (fail! "unreachable"))

; A local or binder at `start` whose target is the binder at `binder`.
(defn rr2-local (refs:&(Vector &Node) src:StrView file:StrView role:StrView start:i64 name:StrView
                 binder:i64):!void
  (let (m:&Node (try (rr2-ref refs src file role start name "local" ""))
        t:?&Node (edn-get m "target"))
    (try (check-eq (rr1-get t "file") file))
    (try (check-eq-int (rr1-int t "start") binder "the binder's start"))
    (try (check-eq-int (rr1-int t "end") (+ binder (as i64 (name 'len))) "the binder's end"))
    (return (ok))))

(defn rr2-none-why (refs:&(Vector &Node) file:StrView why:StrView):usize
  (let (n:usize 0)
    (dotimes (i (count refs))
      (when (and (= (rr1-get (refs i) "file") file) (= (rr1-get (refs i) "why") why)) (set! n (+ n 1))))
    (return n)))

; Every role, each placed on its own name.
(deftest rr2-resolve-roles
  (let (src:StrView "(defstruct Pt x:i32 y:i32)
(defunion Sh (circle r:i32) dot)
(defvar counter:i32 0)
(defn add (a:i32 b:i32):i32 (return (_+ a b)))
(defn pos (k:i32):!i32 (return (ok k)))
(defn area (s:Sh):i32
  (match s
    ((circle r) (return r))
    (dot (return 0))))
(defn main ():i32
  (let (p:Pt (Pt 1 2)
        q:&Pt &p)
    (when (> counter 0) (return 1))
    (return (add (q 'x) (area (Sh circle 3))))))
"
        p:String (try (test-write-file "rr2a.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        refs:&(Vector &Node) (try (rr2-recs (string-as-view &out) "ref"))
        ba:i64 (try (rr2-at src "(a:i32" 0 1))
        br:i64 (try (rr2-at src "(circle r)" 0 8))
        bq:i64 (try (rr2-at src "q:&Pt" 0 0)))
    (try (rr2-local refs src pv "binder" ba "a" ba))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(_+ a b)" 0 4)) "a" ba))
    (try (rr2-local refs src pv "binder" br "r" br))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(return r)" 0 8)) "r" br))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(q 'x)" 0 1)) "q" bq))
    (try (rr2-ref refs src pv "global" (try (rr2-at src "counter 0" 0 0)) "counter" "var" "counter"))
    (try (rr2-ref refs src pv "head" (try (rr2-at src "(add (q" 0 1)) "add" "function" "add"))
    (try (rr2-ref refs src pv "head" (try (rr2-at src "(_+ a b)" 0 1)) "_+" "operator" "_+"))
    (try (rr2-ref refs src pv "head" (try (rr2-at src "(Pt 1 2)" 0 1)) "Pt" "struct" "Pt"))
    (try (rr2-ref refs src pv "head" (try (rr2-at src "(Sh circle 3)" 0 1)) "Sh" "union" "Sh"))
    (try (rr2-ref refs src pv "type" (try (rr2-at src "p:Pt" 0 2)) "Pt" "struct" "Pt"))
    (try (rr2-ref refs src pv "type" (try (rr2-at src "q:&Pt" 0 3)) "Pt" "struct" "Pt"))
    (try (rr2-ref refs src pv "type" (try (rr2-at src "s:Sh" 0 2)) "Sh" "union" "Sh"))
    (try (rr2-ref refs src pv "field" (try (rr2-at src "(q 'x)" 0 4)) "x" "field" "Pt"))
    (try (rr2-ref refs src pv "arm" (try (rr2-at src "((circle r)" 0 2)) "circle" "arm" "Sh"))
    (try (rr2-ref refs src pv "arm" (try (rr2-at src "(dot (return" 0 1)) "dot" "arm" "Sh"))
    (try (rr2-ref refs src pv "arm" (try (rr2-at src "(Sh circle 3)" 0 4)) "circle" "arm" "Sh"))
    (try (rr2-ref refs src pv "macro" (try (rr2-at src "(when" 0 1)) "when" "macro" "nucleus.macros/when"))
    ; `(ok k)` is emitted as the compiler's rewrite of it, placed back on the source.
    (try (rr2-ref refs src pv "arm" (try (rr2-at src "(ok k)" 0 1)) "ok" "arm" "nucleus.core/Result.i32.Err"))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(ok k)" 0 4)) "k" (try (rr2-at src "(k:i32)" 0 1))))
    (try (check-eq-int (as i64 (rr2-none-why refs pv "ambiguous")) 0 "no ambiguous record"))
    (try (check-eq-int (as i64 (rr2-none-why refs pv "mismatch")) 0 "no mismatch record"))
    (drop &out) (drop &p))
  (return (ok)))

; A name twice in one list is two records, each on its own atom; an inner
; binder shadows from its body on, not in its own value.
(deftest rr2-resolve-duplicates
  (let (src:StrView "(defn f2 (a:i32 b:i32):i32 (return b))
(defn g (x:i32):i32
  (let (x:i32 (f2 x x))
    (return x)))
(defn main ():i32 (return (g 1)))
"
        p:String (try (test-write-file "rr2d.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        refs:&(Vector &Node) (try (rr2-recs (string-as-view &out) "ref"))
        outer:i64 (try (rr2-at src "(x:i32)" 0 1))
        inner:i64 (try (rr2-at src "(x:i32 (f2" 0 1)))
    (try (rr2-local refs src pv "binder" outer "x" outer))
    (try (rr2-local refs src pv "binder" inner "x" inner))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(f2 x x)" 0 4)) "x" outer))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(f2 x x)" 0 6)) "x" outer))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(return x)" 0 8)) "x" inner))
    (try (rr2-ref refs src pv "head" (try (rr2-at src "(f2 x x)" 0 1)) "f2" "function" "f2"))
    (try (check-eq-int (as i64 (rr2-none-why refs pv "ambiguous")) 0 "no ambiguous record"))
    (drop &out) (drop &p))
  (return (ok)))

; A chain's names: the binder is segment 0, a type is its segment's body.
(deftest rr2-resolve-chains
  (let (src:StrView "(defstruct Pt x:i32)
(defn h (p:?&Pt n:i32):i32
  (if-some (q p) (return (q 'x)) (return n)))
(defn main ():i32 (let (k:&Pt (Pt 1)) (return (h k 2))))
"
        p:String (try (test-write-file "rr2c.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        refs:&(Vector &Node) (try (rr2-recs (string-as-view &out) "ref"))
        bp:i64 (try (rr2-at src "p:?&Pt" 0 0))
        bn:i64 (try (rr2-at src "n:i32" 0 0)))
    (try (rr2-local refs src pv "binder" bp "p" bp))
    (try (rr2-local refs src pv "binder" bn "n" bn))
    (try (rr2-ref refs src pv "type" (try (rr2-at src "p:?&Pt" 0 4)) "Pt" "struct" "Pt"))
    (try (rr2-ref refs src pv "type" (try (rr2-at src "k:&Pt" 0 3)) "Pt" "struct" "Pt"))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(q p)" 0 3)) "p" bp))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(return n)" 0 8)) "n" bn))
    (drop &out) (drop &p))
  (return (ok)))

; What a macro's expansion resolves has no span yet: `:why :macro` and the call.
(deftest rr2-resolve-macro-output
  (let (src:StrView "(defn f2 (a:i32 b:i32):i32 (return b))
(defmacro twice-of (e) `(f2 ~e ~e))
(defn main ():i32 (let (v:i32 1) (return (twice-of v))))
"
        p:String (try (test-write-file "rr2m.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        refs:&(Vector &Node) (try (rr2-recs (string-as-view &out) "ref"))
        call:i64 (try (rr2-at src "(twice-of v)" 0 0))
        heads:i32 0)
    (try (rr2-ref refs src pv "macro" (+ call 1) "twice-of" "macro" "twice-of"))
    (dotimes (i (count refs))
      (let (m:&Node (refs i))
        (when (and (= (rr1-get m "role") "head") (= (rr1-get m "target") "f2") (= (rr1-get m "why") "macro"))
          (set! heads (+ heads 1))
          (try (check-eq-int (rr1-int m "start") -1 "no span"))
          (try (check-eq (rr1-get m "macro") "twice-of"))
          (try (check-eq-int (rr1-int m "call-start") call "the call's start"))
          (try (check-eq-int (rr1-int m "call-end") (+ call 12) "the call's end")))))
    (try (check-eq-int (as i64 heads) 1 "one head record for the minted f2"))
    (drop &out) (drop &p))
  (return (ok)))

; A macro that returns an atom: `'k` is the interned `k` its operand spells too,
; so konst's is ambiguous; same's is the operand it was handed (RR-3).
(deftest rr2-resolve-macro-atom
  (let (src:StrView "(defmacro konst (e) 'k)
(defmacro same (e) e)
(defn main ():i32
  (let (k:i32 5)
    (return (_+ (konst k) (same k)))))
"
        p:String (try (test-write-file "rr2k.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        refs:&(Vector &Node) (try (rr2-recs (string-as-view &out) "ref"))
        n:i32 0)
    (try (check-eq-int (as i64 (rr2-count refs pv "local" (try (rr2-at src "(konst k)" 0 7)))) 0 "konst's operand"))
    (let (m:&Node (try (rr2-ref refs src pv "local" (try (rr2-at src "(same k)" 0 6)) "k" "local" "")))
      (try (check-eq (rr1-get m "via") "expansion"))
      (try (check-eq (rr1-get m "macro") "same")))
    (dotimes (i (count refs))
      (let (m:&Node (refs i))
        (when (and (= (rr1-get m "file") pv) (= (rr1-get m "role") "local") (= (rr1-get m "name") "k")
                   (= (rr1-int m "start") -1))
          (set! n (+ n 1))
          (try (check-eq (rr1-get m "why") "ambiguous"))
          (try (check-eq (rr1-get m "macro") "konst")))))
    (try (check-eq-int (as i64 n) 1 "konst's record"))
    (drop &out) (drop &p))
  (return (ok)))

; Inference resolves `(pick y y)` before emission; only emission reports it, so
; each `y` is one record on its own atom and nothing is ambiguous.
(deftest rr2-resolve-suppression
  (let (src:StrView "(import-use nucleus.vector)
(import-use nucleus.create)
(import-use nucleus.allocator)
(defn pick (a:T b:T :where (Any T)):T (return a))
(defconst K (* 2 3))
(defstruct Pt x:i32)
(defn size (p:Pt):i32 (return 1))
(defn size (n:i32):i32 (return n))
(defn main ():i32
  (let (y:i32 K
        v (pick y y)
        vs:&(Vector i32) (new (Vector i32) heap))
    (conj vs v)
    (return (size v))))
"
        p:String (try (test-write-file "rr2s.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        refs:&(Vector &Node) (try (rr2-recs (string-as-view &out) "ref"))
        by:i64 (try (rr2-at src "y:i32" 0 0))
        n:i32 0
        alloc:i32 0)
    (try (rr2-local refs src pv "local" (try (rr2-at src "(pick y y)" 0 6)) "y" by))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(pick y y)" 0 8)) "y" by))
    (try (rr2-ref refs src pv "head" (try (rr2-at src "(pick y y)" 0 1)) "pick" "function" "pick"))
    (try (rr2-ref refs src pv "global" (try (rr2-at src "y:i32 K" 0 6)) "K" "const" "K"))
    (dotimes (i (count refs))
      (let (m:&Node (refs i))
        (when (and (= (rr1-get m "file") pv) (or (= (rr1-get m "name") "y") (= (rr1-get m "name") "pick")))
          (set! n (+ n 1)))
        (when (and (= (rr1-get m "file") pv) (= (rr1-get m "name") "Alloc")) (set! alloc (+ alloc 1)))))
    ; The binder, two locals and the head.
    (try (check-eq-int (as i64 n) 4 "records naming y or pick"))
    (try (check-eq-int (as i64 (rr2-none-why refs pv "ambiguous")) 0 "no ambiguous record"))
    ; Matching `(size v)` re-reads both signatures, and `new`'s `init` call its
    ; `a:Alloc`; none of them is a reference here.
    (try (check-eq-int (as i64 (rr2-none-why refs pv "absent")) 0 "no absent record"))
    (try (check-eq-int (as i64 alloc) 0 "records naming Alloc"))
    (try (rr2-ref refs src pv "head" (try (rr2-at src "(size v)" 0 1)) "size" "function" "size"))
    (drop &out) (drop &p))
  (return (ok)))

; The root hoist reads a prelude file twice for emission (node.nuc has code, not
; only macros); each line is written once, a no-span one (edn.nuc's) too.
(defn rr2-distinct-refs (text:StrView):!i32
  (let (it:LineIter (strview-lines &text)
        seen:&(HashMap Symbol i32) (new (HashMap Symbol i32) heap)
        refs:i32 0)
    (while (not (lines-iter-done &it))
      (let (line:StrView (lines-iter-next &it))
        (when (strview-has-prefix line "{:record :ref ")
          (set! refs (+ refs 1))
          (match (get seen (symbol-intern line))
            ((some k) (fail! "written twice: " line))
            (none (assoc seen (symbol-intern line) 1))))))
    (return (ok refs))))

(deftest rr2-resolve-root-hoist
  (let (out:String (try (rr1-resolve "lib/nucleus/node.nuc"))
        refs:i32 (try (rr2-distinct-refs (string-as-view &out))))
    (try (check (> refs 0) "the prelude's references"))
    (drop &out))
  (let (out:String (try (rr1-resolve "lib/nucleus/edn.nuc"))
        refs:i32 (try (rr2-distinct-refs (string-as-view &out))))
    (try (check (> refs 0) "edn.nuc's references"))
    (drop &out))
  (return (ok)))

; ---------------------------------------------------------------------------
; RR-3: tracing through the copies the compiler makes (overview.md §4.9, §8 RR-3)
; ---------------------------------------------------------------------------

; The one :ref of `role` at `start`, whose :via is `via` ("nil" for none).
(defn rr3-via (refs:&(Vector &Node) file:StrView role:StrView start:i64 via:StrView):!void
  (dotimes (i (count refs))
    (let (m:&Node (refs i))
      (when (and (= (rr1-get m "file") file) (= (rr1-get m "role") role) (= (rr1-int m "start") start))
        (try (check-eq (rr1-get m "via") via))
        (return (ok)))))
  (fail! "no :ref " role " at " start))

; A desugared definition is a positional copy: each binder and use lands on its own
; atom; a rewritten `ok` and the `set!`/`aref` rewrite to `aset!` keep their operands.
(deftest rr3-resolve-desugar
  (let (src:StrView "(defn mid (a:i32 b:i32 c:i32):i32 (return (_+ a (_+ b c))))
(defn pos (k:i32):!i32 (return (ok k)))
(defn main ():i32
  (let (arr:(ptr i32) (alloca i32 4)
        i:i32 1
        v:i32 7)
    (set! (aref arr i) v)
    (pos 1)
    (return (mid (aref arr i) v (mk 3)))))
(defstruct One x:i32)
(defn mk (a:i32):i32 (let (o:One (One a)) (return (o 'x))))
(defn wrap (a:i32):One (return (One a)))
"
        p:String (try (test-write-file "rr3d.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        refs:&(Vector &Node) (try (rr2-recs (string-as-view &out) "ref"))
        ba:i64 (try (rr2-at src "a:i32" 0 0))
        bb:i64 (try (rr2-at src "b:i32" 0 0))
        bc:i64 (try (rr2-at src "c:i32" 0 0))
        barr:i64 (try (rr2-at src "arr:" 0 0))
        bi:i64 (try (rr2-at src "i:i32 1" 0 0))
        bv:i64 (try (rr2-at src "v:i32 7" 0 0))
        set:i64 (try (rr2-at src "(set! (aref arr i) v)" 0 0)))
    (try (rr2-local refs src pv "binder" ba "a" ba))
    (try (rr2-local refs src pv "binder" bb "b" bb))
    (try (rr2-local refs src pv "binder" bc "c" bc))
    (try (rr3-via refs pv "binder" bb "desugar"))
    ; The return type is an elem of the `defn` list `desugar` copied, placed through it.
    (try (rr3-via refs pv "type" (try (rr2-at src "):One" 0 2)) "desugar"))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(_+ a (" 0 4)) "a" ba))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(_+ b c)" 0 4)) "b" bb))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(_+ b c)" 0 6)) "c" bc))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(ok k)" 0 4)) "k" (try (rr2-at src "(k:i32)" 0 1))))
    (try (rr3-via refs pv "local" (try (rr2-at src "(ok k)" 0 4)) "rewrite"))
    ; `(set! (aref arr i) v)` is emitted as `(aset! arr i v)`, a copy of its atoms.
    (try (rr2-local refs src pv "local" (+ set 12) "arr" barr))
    (try (rr2-local refs src pv "local" (+ set 16) "i" bi))
    (try (rr2-local refs src pv "local" (+ set 19) "v" bv))
    (try (rr3-via refs pv "local" (+ set 12) "rewrite"))
    (try (check-eq-int (as i64 (rr2-none-why refs pv "ambiguous")) 0 "no ambiguous record"))
    (drop &out) (drop &p))
  (return (ok)))

; A generic's instances are copies of its text: what they agree on is one record on
; the template's atom; what they disagree on is :ambiguous there, never one of them.
(deftest rr3-resolve-instances
  (let (src:StrView "(defstruct Pt x:i32)
(defn size (p:Pt):i32 (return 1))
(defn size (n:i32):i32 (return n))
(defn helper (n:i32):i32 (return n))
(defn measure (v:T :where (Any T)):i32
  (let (s:i32 (size v))
    (return (helper s))))
(defn one (w:T :where (Any T)):i32 (return (size w)))
(defn main ():i32
  (let (p:Pt (Pt 1))
    (return (_+ (_+ (measure p) (measure 2)) (one 3)))))
"
        p:String (try (test-write-file "rr3i.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        refs:&(Vector &Node) (try (rr2-recs (string-as-view &out) "ref"))
        bv:i64 (try (rr2-at src "v:T" 0 0))
        bs:i64 (try (rr2-at src "s:i32 (size" 0 0))
        sz:i64 (try (rr2-at src "(size v)" 0 1)))
    (try (rr2-local refs src pv "binder" bv "v" bv))
    (try (rr3-via refs pv "binder" bv "instance"))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(size v)" 0 6)) "v" bv))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(helper s)" 0 8)) "s" bs))
    (try (rr2-ref refs src pv "head" (try (rr2-at src "(helper s)" 0 1)) "helper" "function" "helper"))
    (try (rr3-via refs pv "head" (try (rr2-at src "(helper s)" 0 1)) "instance"))
    ; Pt's instance calls one `size`, i32's the other.
    (try (check-eq-int (as i64 (rr2-count refs pv "head" sz)) 1 "one record at measure's size"))
    (dotimes (i (count refs))
      (let (m:&Node (refs i))
        (when (and (= (rr1-get m "file") pv) (= (rr1-get m "role") "head") (= (rr1-int m "start") sz))
          (try (check-eq (rr1-get m "why") "ambiguous"))
          (try (check-eq (rr1-get m "target") "nil"))
          (try (check-eq (rr1-get m "via") "instance"))
          (try (rr1-check-span src m)))))
    ; One instance: one meaning.
    (try (rr2-ref refs src pv "head" (try (rr2-at src "(size w)" 0 1)) "size" "function" "size"))
    ; A substituted type variable is in no instance's text.
    (try (check-eq-int (as i64 (rr2-count refs pv "type" (+ bv 2))) 0 "no record on T"))
    (try (check-eq-int (as i64 (rr2-none-why refs pv "ambiguous")) 1 "one ambiguous record"))
    (drop &out) (drop &p))
  (return (ok)))

; A template's literal that shares an operand's spelling is the macro's own name:
; tracing it to the operand would rename the wrong thing, so it is :ambiguous.
(deftest rr3-resolve-template-literal
  (let (src:StrView "(defmacro with-tmp (e) `(let (tmp:i32 1) (_+ tmp ~e)))
(defmacro mkc (tag) `(defn fixed-c ():i32 (return 7)))
(mkc fixed-c)
(defmacro pass (e) e)
(defn main ():i32
  (let (tmp:i32 2)
    (return (_+ (_+ (with-tmp tmp) (fixed-c)) (pass tmp)))))
"
        p:String (try (test-write-file "rr3t.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        ov:StrView (string-as-view &out)
        refs:&(Vector &Node) (try (rr2-recs ov "ref"))
        recs:&(Vector &Node) (try (rr1-defs ov))
        bt:i64 (try (rr2-at src "tmp:i32 2" 0 0))
        op:i64 (try (rr2-at src "(with-tmp tmp)" 0 10))
        amb:i32 0)
    (try (check-eq-int (as i64 (rr2-count refs pv "binder" op)) 0 "no binder on the operand"))
    (try (check-eq-int (as i64 (rr2-count refs pv "local" op)) 0 "no local on the operand"))
    (dotimes (i (count refs))
      (let (m:&Node (refs i))
        (when (and (= (rr1-get m "file") pv) (= (rr1-get m "name") "tmp") (= (rr1-get m "macro") "with-tmp"))
          (try (check-eq (rr1-get m "why") "ambiguous"))
          (try (check-eq-int (rr1-int m "start") -1 "no span"))
          (set! amb (+ amb 1)))))
    (try (check-eq-int (as i64 amb) 2 "the macro's binder and its use"))
    ; RR-1 traced fixed-c's definition to the operand that happens to spell it.
    (try (rr1-check-macro recs src pv "fixed-c" "defn" "mkc" "ambiguous" "(mkc fixed-c)"))
    ; A macro that mints nothing hands its operand through.
    (try (rr2-local refs src pv "local" (try (rr2-at src "(pass tmp)" 0 6)) "tmp" bt))
    (drop &out) (drop &p))
  (return (ok)))

; An operand list the expansion emits in place has records of its own, so its atoms
; are no candidates: the binder the macro builds from `k` traces to the operand `k`.
(deftest rr3-resolve-passed-operand
  (let (src:StrView "(defmacro bind-as (n init body) `(let (~n ~init) ~body))
(defn main ():i32
  (return (bind-as k 3 (_+ k k))))
"
        p:String (try (test-write-file "rr3p.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        refs:&(Vector &Node) (try (rr2-recs (string-as-view &out) "ref"))
        bk:i64 (try (rr2-at src "(bind-as k" 0 9)))
    (try (rr2-local refs src pv "binder" bk "k" bk))
    (try (rr3-via refs pv "binder" bk "expansion"))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(_+ k k)" 0 4)) "k" bk))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(_+ k k)" 0 6)) "k" bk))
    (try (check-eq-int (as i64 (rr2-none-why refs pv "ambiguous")) 0 "no ambiguous record"))
    (drop &out) (drop &p))
  (return (ok)))

; A closure's body is a rewrite: a captured name is the outer binder's :local, and
; the lambda's own names land on its text.
(deftest rr3-resolve-closure
  (let (src:StrView "(defn main ():i32
  (let (n:i32 5
        f (vfn (x:i32):i32 (_+ x n)))
    (return (f 1))))
"
        p:String (try (test-write-file "rr3c.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        refs:&(Vector &Node) (try (rr2-recs (string-as-view &out) "ref"))
        bn:i64 (try (rr2-at src "n:i32" 0 0))
        bx:i64 (try (rr2-at src "x:i32" 0 0))
        use:i64 (try (rr2-at src "(_+ x n)" 0 6)))
    (try (rr2-local refs src pv "local" use "n" bn))
    (try (rr3-via refs pv "local" use "closure"))
    (try (rr2-local refs src pv "binder" bx "x" bx))
    (try (rr3-via refs pv "binder" bx "closure"))
    (try (rr2-local refs src pv "local" (try (rr2-at src "(_+ x n)" 0 4)) "x" bx))
    (try (rr2-ref refs src pv "head" (try (rr2-at src "(_+ x n)" 0 1)) "_+" "operator" "_+"))
    (try (check-eq-int (as i64 (rr2-none-why refs pv "ambiguous")) 0 "no ambiguous record"))
    (drop &out) (drop &p))
  (return (ok)))

; The names a defunion's constructors mint are the union's, not the text's.
(deftest rr3-resolve-minted
  (let (src:StrView "(defunion Sh (circle r:i32) dot)
(deferror oops \"oops\")
(defn bad (n:i32):!i32 (when (> n 0) (return (err! oops))) (return (ok n)))
(defn main ():i32 (bad 1) (return 0))
"
        p:String (try (test-write-file "rr3u.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        refs:&(Vector &Node) (try (rr2-recs (string-as-view &out) "ref"))
        decl-end:i64 (try (rr2-at src "dot)" 0 4))
        gen:i32 0)
    (dotimes (i (count refs))
      (let (m:&Node (refs i))
        (when (= (rr1-get m "file") pv)
          (when (and (>= (rr1-int m "start") 0) (< (rr1-int m "start") decl-end))
            (fail! "a record inside the defunion: " (rr1-get m "name")))
          (when (= (rr1-get m "why") "generated") (set! gen (+ gen 1))))))
    (try (check (> gen 0) "the constructors' names are :generated"))
    (try (check-eq-int (as i64 (rr2-none-why refs pv "absent")) 0 "no absent record"))
    (try (rr2-ref refs src pv "global" (try (rr2-at src "(err! oops)" 0 6)) "oops" "const" "oops"))
    (drop &out) (drop &p))
  (return (ok)))

; A template's name the quasiquote resolves at definition is a reference where it
; is written, once, however often the macro expands.
(deftest rr3-resolve-template-site
  (let (src:StrView "(defn helper (n:i32):i32 (return n))
(defmacro call-helper (e) `(helper ~e))
(defn main ():i32 (return (_+ (call-helper 1) (call-helper 2))))
"
        p:String (try (test-write-file "rr3q.nuc" src))
        pv:StrView (string-as-view &p)
        out:String (try (rr1-resolve pv))
        refs:&(Vector &Node) (try (rr2-recs (string-as-view &out) "ref"))
        at:i64 (try (rr2-at src "`(helper" 0 2)))
    (try (rr2-ref refs src pv "head" at "helper" "function" "helper"))
    (try (rr3-via refs pv "head" at "template"))
    (drop &out) (drop &p))
  (return (ok)))

; ---------------------------------------------------------------------------
; RR-4: rename-local over a --resolve report (§4.10)
; ---------------------------------------------------------------------------

; `src` written to `file` and resolved; the local at `needle`'s `nth` occurrence
; plus `k` renamed to `new` in process.
(defn rr4-rename (file:StrView src:StrView needle:StrView nth:i32 k:i64 new:StrView):!RenameResult
  (let (p:String (try (test-write-file file src))
        pv:StrView (edit-arena-str &p)
        out:String (try (rr1-resolve pv))
        at:i64 (try (rr2-at src needle nth k)))
    (match (report-parse (string-as-view &out))
      ((err e) (do (drop &out) (fail! "report-parse refused the report: " e)))
      ((ok rep)
        (let (ctx:&RnCtx (rename-ctx-new rep false)
              r:RenameResult (rename-local ctx pv src (as usize at) new))
          (drop &out)
          (return (ok r)))))))

(defn rr4-ok (r:RenameResult want:StrView):!void
  (match r
    ((err x) (fail! "refused at " (x 'at) ": " (x 'reason)))
    ((ok t) (let (tx:String t
                  res:!void (check-eq (string-as-view &tx) want))
              (drop &tx)
              (return res)))))

(defn rr4-refused (r:RenameResult why:StrView):!void
  (match r
    ((err x) (return (check-contains (x 'reason) why)))
    ((ok t) (let (tx:String t)
              (drop &tx)
              (fail! "renamed, but expected a refusal: " why)))))

; Named from a reference, the binder and every reference change, nothing else.
(deftest rr4-rename-basic
  (let (src:StrView "(defn main ():i32
  (let (n:i32 2
        m:i32 (_+ n 1))
    (return (_+ m n))))
")
    (try (rr4-ok (try (rr4-rename "rr4a.nuc" src "(_+ m n)" 0 6 "total"))
                 "(defn main ():i32
  (let (total:i32 2
        m:i32 (_+ total 1))
    (return (_+ m total))))
"))
    (try (rr4-refused (try (rr4-rename "rr4a.nuc" src "main" 0 0 "go")) "is a definition"))
    (try (rr4-refused (try (rr4-rename "rr4a.nuc" src "n:i32" 0 0 "a:b")) "plain symbol"))
    (try (rr4-refused (try (rr4-rename "rr4a.nuc" src "n:i32" 0 0 "let")) "built-in form")))
  (return (ok)))

; A chain-sugared binder keeps its type; a sigil-led reference keeps its sigil.
(deftest rr4-rename-chain-sugar
  (let (src:StrView "(defn f (x:i32 p:(ptr i32)):i32
  (set! @p x)
  (return (_+ x 1)))
(defn main ():i32 (let (v:i32 0) (return (f 2 &v))))
")
    (try (rr4-ok (try (rr4-rename "rr4b.nuc" src "x:i32" 0 0 "y"))
                 "(defn f (y:i32 p:(ptr i32)):i32
  (set! @p y)
  (return (_+ y 1)))
(defn main ():i32 (let (v:i32 0) (return (f 2 &v))))
"))
    (try (rr4-ok (try (rr4-rename "rr4b.nuc" src "&v" 0 1 "w"))
                 "(defn f (x:i32 p:(ptr i32)):i32
  (set! @p x)
  (return (_+ x 1)))
(defn main ():i32 (let (w:i32 0) (return (f 2 &w))))
")))
  (return (ok)))

; Inward: a binder of the new name inside the scope. Outward: the renamed binder
; would sit inside a binder of the new name, used there or not.
(deftest rr4-rename-shadowing
  (let (src:StrView "(defn main ():i32
  (let (a:i32 1)
    (let (b:i32 2)
      (_+ a b))
    (let (c:i32 3) c)
    (return a)))
")
    (try (rr4-refused (try (rr4-rename "rr4c.nuc" src "a:i32" 0 0 "b")) "already occurs in the binder's scope"))
    (try (rr4-refused (try (rr4-rename "rr4c.nuc" src "c:i32" 0 0 "a")) "the renamed binder would shadow it"))
    (try (rr4-ok (try (rr4-rename "rr4c.nuc" src "c:i32" 0 0 "b"))
                 "(defn main ():i32
  (let (a:i32 1)
    (let (b:i32 2)
      (_+ a b))
    (let (b:i32 3) b)
    (return a)))
")))
  (return (ok)))

; A global the scope uses, or one it does not: the compiler writes calls too.
(deftest rr4-rename-global-capture
  (let (src:StrView "(defvar g:i32 5)
(defn h ():i32 (return 1))
(defn main ():i32
  (let (x:i32 (_+ g 1))
    (return x)))
")
    (try (rr4-refused (try (rr4-rename "rr4d.nuc" src "x:i32" 0 0 "g")) "'g' names a definition of the unit"))
    (try (rr4-refused (try (rr4-rename "rr4d.nuc" src "x:i32" 0 0 "h")) "names a definition of the unit")))
  (return (ok)))

; An operand a macro moves is edited. The new name refuses where an expansion
; in scope binds it, or where a macro's definition spells it at all.
(deftest rr4-rename-macro-call
  (let (src:StrView "(defmacro twice (e) `(_+ ~e ~e))
(defmacro with-acc (e) `(let (acc:i32 1) (_+ acc ~e)))
(defmacro noted (e) `(do \"tag\" ~e))
(defn main ():i32
  (let (k:i32 2)
    (return (_+ (twice k) (noted (with-acc k))))))
")
    (try (rr4-ok (try (rr4-rename "rr4e.nuc" src "k:i32" 0 0 "j"))
                 "(defmacro twice (e) `(_+ ~e ~e))
(defmacro with-acc (e) `(let (acc:i32 1) (_+ acc ~e)))
(defmacro noted (e) `(do \"tag\" ~e))
(defn main ():i32
  (let (j:i32 2)
    (return (_+ (twice j) (noted (with-acc j))))))
"))
    (try (rr4-refused (try (rr4-rename "rr4e.nuc" src "k:i32" 0 0 "acc"))
                      "code the compiler or a macro wrote here uses 'acc'"))
    (try (rr4-refused (try (rr4-rename "rr4e.nuc" src "k:i32" 0 0 "tag"))
                      "definition spells 'tag', which its expansion here could capture")))
  (return (ok)))

; Two operands of one call spell the name, so the trace cannot say which one the
; expansion read: :ambiguous, refused.
(deftest rr4-rename-ambiguous
  (let (src:StrView "(defn sq (x:i32):i32 (return (* x x)))
(defn main ():i32 (return (sq 3)))
")
    (try (rr4-refused (try (rr4-rename "rr4f.nuc" src "x:i32" 0 0 "y")) "ambiguous")))
  (return (ok)))

; Two instances disagree about the member `'fst` names, so its one spanned record
; is :ambiguous; a local spelled like it refuses although the member is no local.
(deftest rr4-rename-ambiguous-spanned
  (let (src:StrView "(defstruct (Pair A B) fst:A snd:B)
(defn pair-first (p:&(Pair A B)):A
  (let (fst:A (p 'fst))
    (return fst)))
(defn main ():i32
  (let (a:(Pair i32 i32) ((Pair i32 i32) 1 2)
        b:(Pair i64 i64) ((Pair i64 i64) 3 4))
    (pair-first &a)
    (pair-first &b)
    (return 0)))
")
    (try (rr4-refused (try (rr4-rename "rr4m.nuc" src "fst:A (p" 0 0 "first"))
                      "means different things in different copies of the code")))
  (return (ok)))

; Text the compiler never resolved: an operand a macro drops, a discard, and (with
; the flag) a program in a string.
(deftest rr4-rename-unrecorded
  (let (src:StrView "(defmacro ignore (e) `0)
(defn main ():i32
  (let (x:i32 1)
    (ignore x)
    (return x)))
"
        disc:StrView "(defn main ():i32
  (let (x:i32 1)
    #_(_+ x 2)
    (return x)))
")
    (try (rr4-refused (try (rr4-rename "rr4g.nuc" src "x:i32" 0 0 "y")) "this 'x' has no record"))
    (try (rr4-refused (try (rr4-rename "rr4h.nuc" disc "x:i32" 0 0 "y")) "a #_ form in the binder's scope")))
  (return (ok)))

; Only version 4 is read, and a report must be whole.
(deftest rr4-report-version
  (let (head:StrView "{:record :report :version 4 :unit \"u.nuc\"}\n"
        cov:StrView "{:record :coverage :attributed 0}\n")
    (match (report-parse "{:record :report :version 3 :unit \"u.nuc\"}\n{:record :coverage}\n")
      ((ok r) (fail! "a version 3 report was read"))
      ((err e) (try (check-contains e "the report is version 3; this library reads version 4"))))
    (match (report-parse "{:record :report :version 5 :unit \"u.nuc\"}\n{:record :coverage}\n")
      ((ok r) (fail! "a version 5 report was read"))
      ((err e) (try (check-contains e "version 5"))))
    (let (cut:String (str head "{:record :file :file \"u.nuc\"}\n")
          odd:String (str head "{:record :span :file \"u.nuc\"}\n" cov)
          whole:String (str head cov))
      (match (report-parse (string-as-view &cut))
        ((ok r) (fail! "a report with no :coverage was read"))
        ((err e) (try (check-contains e "does not end with its :coverage record"))))
      (match (report-parse (string-as-view &odd))
        ((ok r) (fail! "a report with an unknown record was read"))
        ((err e) (try (check-contains e "unknown record :span"))))
      (match (report-parse (string-as-view &whole))
        ((ok r) (try (check-eq (r 'unit) "u.nuc")))
        ((err e) (fail! "a whole version 4 report was refused: " e)))
      (drop &cut) (drop &odd) (drop &whole)))
  (return (ok)))

; Renamed, resolved again and renamed back: the original bytes.
(deftest rr4-rename-and-back
  (let (src:StrView "(defn f (x:i32 y:i32):i32
  (let (s:i32 (_+ x y))
    (dotimes (i 3) (set! s (_+ s i)))
    (return s)))
(defn main ():i32 (return (f 1 2)))
"
        once:String (str ""))
    (match (try (rr4-rename "rr4i.nuc" src "s:i32" 0 0 "acc"))
      ((err x) (fail! "refused at " (x 'at) ": " (x 'reason)))
      ((ok t) (do (drop &once) (set! once t))))
    (try (check-contains (string-as-view &once) "(acc:i32 (_+ x y))"))
    (let (mid:StrView (string-as-view &once))
      (try (rr4-ok (try (rr4-rename "rr4i.nuc" mid "acc:i32" 0 0 "s")) src)))
    (drop &once))
  (return (ok)))

; A macro that quotes its operand makes the spelling program data, so the trace
; refuses it (§4.9 rule 3) and the rename refuses in turn.
(deftest rr4-rename-quoted-operand
  (let (src:StrView "(import-use nucleus.node)
(defmacro keep-name (v) `(do '~v ~v))
(defn main ():i32
  (let (k:i32 2)
    (return (keep-name k))))
")
    (try (rr4-refused (try (rr4-rename "rr4j.nuc" src "k:i32" 0 0 "j")) "an occurrence of 'k' has no span")))
  (return (ok)))

; A closure's environment reads its captures in code the compiler writes, with no
; span and no binder named: neither the capture nor a new name spelled like it moves.
(deftest rr4-rename-generated
  (let (src:StrView "(defn f ():i32
  (let (n:i32 5
        g (vfn (x:i32):i32 (_+ x n)))
    (return (g 1))))
(defn main ():i32
  (let (m:i32 (f))
    (return m)))
")
    (try (rr4-refused (try (rr4-rename "rr4k.nuc" src "n:i32" 0 0 "q")) "has no span (:why generated)"))
    (try (rr4-refused (try (rr4-rename "rr4k.nuc" src "m:i32" 0 0 "n"))
                      "code the compiler wrote uses 'n' where the report cannot place it")))
  (return (ok)))

; A report of other text is refused before anything is planned.
(deftest rr4-rename-stale-report
  (let (src:StrView "(defn main ():i32
  (let (n:i32 2)
    (return n)))
"
        moved:StrView ";
(defn main ():i32
  (let (n:i32 2)
    (return n)))
"
        p:String (try (test-write-file "rr4l.nuc" src))
        pv:StrView (edit-arena-str &p)
        out:String (try (rr1-resolve pv)))
    (match (report-parse (string-as-view &out))
      ((err e) (do (drop &out) (fail! "report-parse refused the report: " e)))
      ((ok rep)
        (let (ctx:&RnCtx (rename-ctx-new rep false))
          (try (rr4-refused (rename-local ctx pv moved (as usize (try (rr2-at moved "n:i32" 0 0))) "k")
                            "the report does not match the file")))))
    (drop &out))
  (return (ok)))

; `str`'s expansion binds and reads its own `p`, which no source binder names: a
; local `p` around the call cannot be told apart from it, so it does not move.
(deftest rr4-rename-unbound-read
  (let (src:StrView "(import-use nucleus.string)
(import-use nucleus.fmt)
(defn main ():i32
  (let (p:String (str \"a\" \"b\"))
    (drop &p)
    (return 0)))
")
    (try (rr4-refused (try (rr4-rename "rr4n.nuc" src "p:String" 0 0 "q"))
                      "reads a local 'p' whose binder it does not name")))
  (return (ok)))

; ---------------------------------------------------------------------------
; RR-5: rename-global over one report per root (§4.11)
; ---------------------------------------------------------------------------

(defstruct Rr5Run (roots &(Vector &RgRoot)) (plan &RgPlan))

; Each of `roots` resolved and read as a rename-global root.
(defn rr5-roots (roots:&(Vector StrView)):!&(Vector &RgRoot)
  (let (rs:&(Vector &RgRoot) (new (Vector &RgRoot) heap))
    (dotimes (i (count roots))
      (let (out:String (try (rr1-resolve (roots i))))
        (match (report-parse (edit-arena-str &out))
          ((err e) (fail! "report-parse refused the report: " e))
          ((ok rep) (conj rs (rename-global-root (roots i) rep false))))))
    (return (ok rs))))

(defn rr5-opts ():&RgOpts
  (let (o:&RgOpts (unsafe/cast &RgOpts (heap-allocate-zeroed (as usize (sizeof RgOpts)) (as usize 8))))
    (set-fields! o
                 'compiler     (compiler-path)
                 'compiler-src "src"
                 'ir-check     true)
    (init (ref o 'edit))
    (return o)))

; The definition at `needle`'s `nth` occurrence plus `k` in `file` (text `src`), renamed to `new`.
(defn rr5-plan (rs:&(Vector &RgRoot) file:StrView src:StrView needle:StrView nth:i32 k:i64 new:StrView):!Rr5Run
  (let (at:i64 (try (rr2-at src needle nth k)))
    (return (ok (Rr5Run rs (rename-global-plan rs file (as usize at) new (rr5-opts)))))))

(defn rr5-refused (r:Rr5Run why:StrView):!void
  (let (p:&RgPlan (r 'plan))
    (when (rg-plan-ok? p) (fail! "renamed, but expected a refusal: " why))
    (return (check-contains ((p 'refusal) 'reason) why))))

; Each file's text after the rename, in `files` order; a file the plan leaves alone keeps its text.
(defn rr5-apply (r:Rr5Run files:&(Vector StrView) srcs:&(Vector StrView)):!&(Vector StrView)
  (let (p:&RgPlan (r 'plan))
    (when (not (rg-plan-ok? p))
      (fail! "refused in " (p 'refused) " at " ((p 'refusal) 'at) ": " ((p 'refusal) 'reason)))
    (let (outs:&(Vector RgOut) (rename-global-apply (r 'roots) p)
          res:&(Vector StrView) (new (Vector StrView) heap))
      (when (not (rg-plan-ok? p)) (fail! "apply refused: " ((p 'refusal) 'reason)))
      (dotimes (i (count files))
        (let (t:StrView (srcs i))
          (dotimes (j (count outs))
            (when (= ((outs j) 'path) (files i)) (set! t ((outs j) 'text))))
          (conj res t)))
      (return (ok res)))))

(defn rr5-write (name:StrView src:StrView):!StrView
  (let (p:String (try (test-write-file name src)))
    (return (ok (edit-arena-str &p)))))

(defn rr5-no-roots ():&(Vector &RgRoot)
  (return (new (Vector &RgRoot) heap)))

(defn rr5-one (s:StrView):&(Vector StrView)
  (let (v:&(Vector StrView) (new (Vector StrView) heap))
    (conj v s)
    (return v)))

(defn rr5-two (a:StrView b:StrView):&(Vector StrView)
  (let (v:&(Vector StrView) (rr5-one a))
    (conj v b)
    (return v)))

(defn rr5-replace (t:StrView old:StrView new:StrView):String
  (let (out:String (str "")
        rest:StrView t)
    (while true
      (match (strview-find &rest &old)
        ((some j) (do (str-into &out (strview-take-bytes rest j) new)
                      (set! rest (strview-drop-bytes rest (+ j (old 'len))))))
        (none (do (str-into &out rest) (return out)))))
    (return out)))

(defn rr5-lib ():StrView
  (return "(ns rr5p)
(defn foo (n:i32):i32 (return (_+ n 1)))
(defn twice-foo (n:i32):i32 (return (foo (foo n))))
"))

(defn rr5-main ():StrView
  (return "(import-prefixed rr5p p)
(defn main ():i32 (return (p/foo 1)))
"))

; Two files, two namespaces: the definition, a bare reference in its namespace and a
; qualified one across it, which keeps its qualifier.
(deftest rr5-rename-two-files
  (let (lp:StrView (try (rr5-write "rr5p.nuc" (rr5-lib)))
        mp:StrView (try (rr5-write "rr5a.nuc" (rr5-main)))
        rs:&(Vector &RgRoot) (try (rr5-roots (rr5-one mp)))
        r:Rr5Run (try (rr5-plan rs lp (rr5-lib) "foo (n" 0 0 "bump"))
        got:&(Vector StrView) (try (rr5-apply r (rr5-two lp mp) (rr5-two (rr5-lib) (rr5-main)))))
    (try (check-eq (got 0) "(ns rr5p)
(defn bump (n:i32):i32 (return (_+ n 1)))
(defn twice-foo (n:i32):i32 (return (bump (bump n))))
"))
    (try (check-eq (got 1) "(import-prefixed rr5p p)
(defn main ():i32 (return (p/bump 1)))
")))
  (return (ok)))

; Named from a qualified reference, every member of an overload set moves together.
(deftest rr5-rename-overloads
  (let (src:StrView "(defn area (x:i32):i32 (return (_* x x)))
(defn area (x:f64):f64 (return x))
(defn main ():i32 (area 2.0) (return (area 3)))
"
        p:StrView (try (rr5-write "rr5o.nuc" src))
        rs:&(Vector &RgRoot) (try (rr5-roots (rr5-one p)))
        r:Rr5Run (try (rr5-plan rs p src "(area 3)" 0 1 "size"))
        got:&(Vector StrView) (try (rr5-apply r (rr5-one p) (rr5-one src))))
    (try (check-eq (got 0) "(defn size (x:i32):i32 (return (_* x x)))
(defn size (x:f64):f64 (return x))
(defn main ():i32 (size 2.0) (return (size 3)))
")))
  (return (ok)))

; A type in every spelling: a field, a constructor, a chain-sugared binder, a
; return keyword and a template's argument.
(deftest rr5-rename-type
  (let (src:StrView "(import-use nucleus.vector)
(defstruct Foo a:i32)
(defstruct Box (f Foo))
(defn mk ():Foo (return (Foo 1)))
(defn get-a (x:Foo):i32 (return (x 'a)))
(defn none-of (v:&(Vector Foo)):i32 (return 0))
(defn main ():i32 (let (f:Foo (mk)) (return (get-a f))))
"
        p:StrView (try (rr5-write "rr5t.nuc" src))
        rs:&(Vector &RgRoot) (try (rr5-roots (rr5-one p)))
        r:Rr5Run (try (rr5-plan rs p src "Foo a:" 0 0 "Bar"))
        got:&(Vector StrView) (try (rr5-apply r (rr5-one p) (rr5-one src))))
    (try (check-eq (got 0) "(import-use nucleus.vector)
(defstruct Bar a:i32)
(defstruct Box (f Bar))
(defn mk ():Bar (return (Bar 1)))
(defn get-a (x:Bar):i32 (return (x 'a)))
(defn none-of (v:&(Vector Bar)):i32 (return 0))
(defn main ():i32 (let (f:Bar (mk)) (return (get-a f))))
")))
  (return (ok)))

; A macro and its calls; its link name is a JIT symbol, checked like any other.
(deftest rr5-rename-macro
  (let (src:StrView "(defmacro twice (e) `(_+ ~e ~e))
(defn main ():i32 (return (twice 2)))
"
        p:StrView (try (rr5-write "rr5m.nuc" src))
        rs:&(Vector &RgRoot) (try (rr5-roots (rr5-one p)))
        r:Rr5Run (try (rr5-plan rs p src "twice (e)" 0 0 "double"))
        got:&(Vector StrView) (try (rr5-apply r (rr5-one p) (rr5-one src))))
    (try (check-eq (got 0) "(defmacro double (e) `(_+ ~e ~e))
(defn main ():i32 (return (double 2)))
")))
  (return (ok)))

; A new name another definition holds, or one a local in a renamed site's scope binds.
(deftest rr5-rename-collision
  (let (src:StrView "(defn foo (n:i32):i32 (return n))
(defn other ():i32 (return 2))
(defn g (bump:i32):i32 (return (foo bump)))
(defn main ():i32 (return (g (other))))
"
        p:StrView (try (rr5-write "rr5c.nuc" src))
        rs:&(Vector &RgRoot) (try (rr5-roots (rr5-one p))))
    (try (rr5-refused (try (rr5-plan rs p src "foo (n" 0 0 "other")) "'other' names a definition of root"))
    (try (rr5-refused (try (rr5-plan rs p src "foo (n" 0 0 "bump")) "'bump' already occurs here")))
  (return (ok)))

; An occurrence the compiler never resolved: an operand a macro drops.
(deftest rr5-rename-unrecorded
  (let (src:StrView "(defmacro ignore (e) `0)
(defn foo ():i32 (return 1))
(defn main ():i32 (ignore (foo)) (return (foo)))
"
        p:StrView (try (rr5-write "rr5u.nuc" src))
        rs:&(Vector &RgRoot) (try (rr5-roots (rr5-one p))))
    (try (rr5-refused (try (rr5-plan rs p src "foo ()" 0 0 "bar")) "this 'foo' has no record")))
  (return (ok)))

; Two roots that read the definition's file under different keys: a report from
; another build of the library, doctored here.
(deftest rr5-roots-disagree
  (let (lp:StrView (try (rr5-write "rr5p.nuc" (rr5-lib)))
        mp:StrView (try (rr5-write "rr5a.nuc" (rr5-main)))
        rs:&(Vector &RgRoot) (try (rr5-roots (rr5-one mp)))
        out:String (try (rr1-resolve mp))
        bad:String (rr5-replace (string-as-view &out) "\"rr5p/foo\"" "\"rr5p/fob\""))
    (match (report-parse (edit-arena-str &bad))
      ((err e) (fail! "report-parse refused the doctored report: " e))
      ((ok rep) (conj rs (rename-global-root "doctored" rep false))))
    (try (rr5-refused (try (rr5-plan rs lp (rr5-lib) "foo (n" 0 0 "bump"))
                      "the roots disagree on the definition's key"))
    (drop &out) (drop &bad))
  (return (ok)))

; A report of another version is refused before it is read.
(deftest rr5-report-version
  (let (p:StrView (try (rr5-write "rr5v.edn" "{:record :report :version 3 :unit \"u.nuc\"}\n{:record :coverage}\n")))
    (match (rg-read-report p)
      ((ok r) (fail! "a version 3 report was read"))
      ((err e) (try (check-contains e "the report is version 3; this library reads version 4")))))
  (return (ok)))

; Renamed, written, resolved again and renamed back: the original bytes in every file.
(deftest rr5-rename-and-back
  (let (lp:StrView (try (rr5-write "rr5p.nuc" (rr5-lib)))
        mp:StrView (try (rr5-write "rr5a.nuc" (rr5-main)))
        files:&(Vector StrView) (rr5-two lp mp)
        rs:&(Vector &RgRoot) (try (rr5-roots (rr5-one mp)))
        r:Rr5Run (try (rr5-plan rs lp (rr5-lib) "foo (n" 0 0 "bump"))
        mid:&(Vector StrView) (try (rr5-apply r files (rr5-two (rr5-lib) (rr5-main)))))
    (try (rr5-write "rr5p.nuc" (mid 0)))
    (try (rr5-write "rr5a.nuc" (mid 1)))
    (let (rs2:&(Vector &RgRoot) (try (rr5-roots (rr5-one mp)))
          r2:Rr5Run (try (rr5-plan rs2 lp (mid 0) "bump (n" 0 0 "foo"))
          back:&(Vector StrView) (try (rr5-apply r2 files mid)))
      (try (check-eq (back 0) (rr5-lib)))
      (try (check-eq (back 1) (rr5-main)))))
  (return (ok)))

; A C function only a header declares is in the IR and nowhere else; `@bar-baz` does not name `bar`.
(deftest rr5-ir-check
  (let (src:StrView "(import-use \"stdio.h\")
(defn bar-baz ():i32 (return 2))
(defn foo ():i32 (return 1))
(defn main ():i32 (return (_+ (foo) (bar-baz))))
"
        p:StrView (try (rr5-write "rr5i.nuc" src))
        rs:&(Vector &RgRoot) (try (rr5-roots (rr5-one p))))
    (try (rr5-refused (try (rr5-plan rs p src "foo ()" 0 0 "memccpy")) "IR names a symbol 'memccpy'"))
    (let (r:Rr5Run (try (rr5-plan rs p src "foo ()" 0 0 "bar"))
          got:&(Vector StrView) (try (rr5-apply r (rr5-one p) (rr5-one src))))
      (try (check-contains (got 0) "(_+ (bar) (bar-baz))"))))
  (return (ok)))

; A `:host` global refuses, a `:host` function renames: the report doctored, as a library's would read.
(deftest rr5-host
  (let (src:StrView "(defvar counter:i64 0)
(defn bump ():i64 (set! counter (_+ counter 1)) (return counter))
(defn main ():i32 (bump) (return 0))
"
        p:StrView (try (rr5-write "rr5h.nuc" src))
        out:String (try (rr1-resolve p))
        a:String (rr5-replace (string-as-view &out) ":link \"counter\" :host false" ":link \"counter\" :host true")
        b:String (rr5-replace (string-as-view &a) ":link \"bump\" :host false" ":link \"bump\" :host true")
        rs:&(Vector &RgRoot) (rr5-no-roots))
    (match (report-parse (edit-arena-str &b))
      ((err e) (fail! "report-parse refused the doctored report: " e))
      ((ok rep) (conj rs (rename-global-root p rep false))))
    (try (rr5-refused (try (rr5-plan rs p src "counter:" 0 0 "tally")) "macro bodies share the compiler's own 'counter'"))
    (let (r:Rr5Run (try (rr5-plan rs p src "bump ()" 0 0 "tick-up"))
          got:&(Vector StrView) (try (rr5-apply r (rr5-one p) (rr5-one src))))
      (try (check-contains (got 0) "(defn main ():i32 (tick-up) (return 0))")))
    (drop &out) (drop &a) (drop &b))
  (return (ok)))

; A stale header is found by its C identifier, bare or namespaced, its asm label or a comment.
(deftest rr5-header-scan
  (when (not (rg-header-spells? "lib/m.h" "int32_t square(int32_t x);\n" "square")) (fail! "a bare C name"))
  (when (rg-header-spells? "lib/m.h" "int32_t squared(int32_t x);\n" "square") (fail! "a longer C name"))
  (when (not (rg-header-spells? "lib/g.h" "int32_t geom__area(int32_t w);\n" "area")) (fail! "a namespaced C name"))
  (when (not (rg-header-spells? "lib/q.h" "bool nuc_full_QMARK(void) NUC_ASM(\"nuc_full_QMARK\");\n" "full?"))
    (fail! "a nuc_ name"))
  (when (not (rg-header-spells? "lib/b.h" "/* box-set: generic template; not exported */\n" "box-set"))
    (fail! "a comment"))
  (when (not (rg-header-spells? "lib/g.nuch" "(declare area ((w i32)) :i32)\n" "area")) (fail! "a .nuch"))
  (when (rg-header-spells? "lib/g.nuch" "(declare geom__area)\n" "area") (fail! "a .nuch's C spelling"))
  (return (ok)))

; A union and the constructors its arms mint, `Shape-circle` with it; the arm stays.
(deftest rr5-rename-union
  (let (src:StrView "(defunion Shape (circle r:i32) dot)
(defn area (s:Shape):i32 (match s ((circle r) (return r)) (dot (return 0))))
(defn main ():i32 (return (_+ (area (Shape-circle 2)) (area (Shape dot)))))
"
        p:StrView (try (rr5-write "rr5n.nuc" src))
        rs:&(Vector &RgRoot) (try (rr5-roots (rr5-one p)))
        r:Rr5Run (try (rr5-plan rs p src "Shape (circle" 0 0 "Form"))
        got:&(Vector StrView) (try (rr5-apply r (rr5-one p) (rr5-one src))))
    (try (check-eq (got 0) "(defunion Form (circle r:i32) dot)
(defn area (s:Form):i32 (match s ((circle r) (return r)) (dot (return 0))))
(defn main ():i32 (return (_+ (area (Form-circle 2)) (area (Form dot)))))
")))
  (return (ok)))

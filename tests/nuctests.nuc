; Stage 18 TF-6 — the compiler's native test suite.
;
; Design: design/stage18-tooling/overview.md §T6.6.
;
; One binary: `--list` names every test, `--run <name>` runs exactly one and
; prints its s-expression record, and `--shard i/n` is how `make test` spreads
; the suite across cores. A shard is a process and each test owns a scratch
; directory keyed by its name, so the split needs no locking.
;
; Category (a) is a TABLE (`tests/manifest/diagnostics.edn`), not 168 hand
; written units: every row says the same thing about a different fixture, and
; the thing it says is now a comparison against one `Diagnostic` record rather
; than two greps over one stderr blob.

(import-use error)
(import-use strview)
(import-use string)
(import-use string-split)
(import-use fmt)
(import-use vector)
(import-use io)
(import-use file)
(import-use process)
(import-use node)
(import-use parse)
(import-use read)
(import-use keyword)
(import-use edn)
(import-use test)
(import-use suite-s16)
(import-use suite-modules)
(import-use suite-float)
(import-use suite-layout)
(import-use suite-cheader)
(import-use suite-cimport)
(import-use suite-declarators)
(import-use suite-exports)
(import-use suite-linking)
(import-use suite-refusals)
(import-use suite-ir-names)
(import-use suite-target)
(import-use suite-imports)
(import-use suite-globals)
(import-use suite-conversions)
(import-use suite-fnptr)
(import-use suite-cdecl)
(import-use suite-namespaces)
(import-use suite-runtime)
(import-use suite-audits)
(import-use suite-s21)
(import-use suite-s22)



(defn manifest-path ():StrView (return "tests/manifest/diagnostics.edn"))
(defn compiler-path ():StrView (return "./build/nucleusc"))

; ---------------------------------------------------------------------------
; Reading a row
; ---------------------------------------------------------------------------

; Rows are EDN maps (design/stage22-edn/test-records.md §2). Each accessor
; answers for a row `manifest-rows` has already checked.
(defn row-str (row:?&Node key:StrView):StrView
  (match (edn-str (edn-get row key))
    ((ok v) (return v))
    ((err e) (return ""))))

(defn row-name (row:?&Node):StrView (return (row-str row "name")))
(defn row-file (row:?&Node):StrView (return (row-str row "file")))

; The pinned line, or -1 when the row does not pin one.
(defn row-line (row:?&Node):i32
  (match (edn-int (edn-get row "line"))
    ((ok v) (return (unsafe/cast i32 v)))
    ((err e) (return -1))))

(defn row-expects (row:?&Node):StrView
  (match (edn-keyword (edn-get row "expect"))
    ((ok k) (return (keyword-name k)))
    ((err e) (return ""))))

; Absent, or a vector of strings.
(defn row-strings? (v:?&Node):bool
  (when (= v null) (return true))
  (when (!= (edn-kind v) EDN-VECTOR) (return false))
  (dotimes (i (edn-count v))
    (when (!= (edn-kind (edn-nth v (as usize i))) EDN-STR) (return false)))
  (return true))

(defn row-key-known? (k:?&Node):bool
  (when (or (= k null) (!= (edn-kind k) EDN-KEYWORD)) (return false))
  (let (nm:StrView (symbol-as-view (k 's)))
    (return (or (= nm "name") (= nm "expect") (= nm "file") (= nm "line")
                (= nm "messages") (= nm "notes")))))

(defn row-check (row:?&Node):!void
  (when (or (= row null) (!= (edn-kind row) EDN-MAP))
    (fail! "manifest: a row is a map, not " (edn-kind-name (edn-kind row))))
  (let (ln:i32 (row 'line)
        line:?&Node (edn-get row "line")
        msgs:?&Node (edn-get row "messages")
        notes:?&Node (edn-get row "notes")
        expects:StrView (row-expects row))
    (dotimes (i (edn-count row))
      (let (k:?&Node (edn-key row (as usize i)))
        (when (not (row-key-known? k))
          (let (t:String (string-new))
            (edn-write &t k)
            (fail! "manifest line " ln ": unknown key " (string-as-view &t))))))
    (when (or (!= (edn-kind (edn-get row "name")) EDN-STR)
              (!= (edn-kind (edn-get row "file")) EDN-STR))
      (fail! "manifest line " ln ": :name and :file are strings"))
    (when (and (!= line null) (!= (edn-kind line) EDN-INT))
      (fail! "manifest line " ln ": :line is an integer"))
    (when (not (and (row-strings? msgs) (row-strings? notes)))
      (fail! "manifest line " ln ": :messages and :notes are vectors of strings"))
    (cond (= expects "accept")
            (when (or (!= line null) (!= msgs null) (!= notes null))
              (fail! "manifest line " ln ": an :accept row has only :name and :file"))
          (= expects "reject")
            (when (= (+ (edn-count msgs) (edn-count notes)) 0)
              (fail! "manifest line " ln ": a :reject row names a message or a note"))
          true
            (fail! "manifest line " ln ": :expect is :reject or :accept")))
  (return (ok)))

; Every row of a manifest's text, each checked, so a malformed row fails the
; registration of the whole table rather than its own test.
(defn manifest-rows (text:StrView):!?&Node
  (match (edn-parse-all text)
    ((err e) (fail! "manifest line " (e 'line) ": " (e 'msg)))
    ((ok forms)
      (dotimes (i (node-len forms))
        (try (row-check (node-at forms i))))
      (return (ok forms)))))

; ---------------------------------------------------------------------------
; Running the compiler
; ---------------------------------------------------------------------------

; What one `nucleusc --emit-llvm` produced. One record because most units ask
; about more than one part of it, and asking twice means compiling twice.
;
; A `Diagnostic`'s views point at interned symbols, so `diags` stays valid after
; `raw` is dropped.
;
; `exit` as well as `ok?`: a segfault also produces no output and no diagnostic,
; so only the status separates "refused" from "crashed".
(defstruct Compiled
  ok?:bool
  exit:i32
  ir:String
  raw-text:String
  diags:(Vector Diagnostic))

(extend Compiled Drop)
(defn drop ((self &Compiled)):void
  (drop (ref self 'ir))
  (drop (ref self 'raw-text))
  (drop (ref self 'diags)))

; One prepared `nucleusc` command, run. Every builder below differs from the
; others only in which arguments it adds, and a unit that asserts the compiler
; said NOTHING needs the diagnostic list rather than a stderr grep.
(defn compiled-run ((c (ref Command))):!Compiled
  (command-capture c true)
  (match (run c)
    ((ok o)
      (let (ov:StrView (string-as-view (ref o 'out))
            ev:StrView (string-as-view (ref o 'err))
            r:&Compiled (alloca Compiled))
        (set! (r 'ok?) (success? (ref o 'status)))
        (set! (r 'exit) (exit-code (ref o 'status)))
        (set! (r 'ir) (try (string-from-view &ov)))
        (set! (r 'raw-text) (try (string-from-view &ev)))
        (set! (r 'diags) (try (read-diagnostics ev)))
        (drop &o)
        (return (ok (deref r)))))
    ((err e) (return (err e)))))

; What one command that is not `nucleusc --diagnostics=edn` did. `Compiled`
; reads its stderr as structured diagnostics, which only the compiler in that
; mode emits; a unit spawning an audit script or the compiler's own text
; back-end needs the two streams themselves.
(defstruct Ran ok?:bool out:String err:String)

(extend Ran Drop)
(defn drop ((self &Ran)):void
  (drop (ref self 'out))
  (drop (ref self 'err)))

; Unchecked, where the rest of this file validates: a child's streams are bytes,
; and a fixture may deliberately print what is not UTF-8.
(defn ran-stream (v:StrView):String
  (let (s:String (string-new))
    (string-push-str-unchecked &s &v)
    (return s)))

(defn ran ((c (ref Command))):!Ran
  (command-capture c true)
  (match (run c)
    ((ok o)
      (let (ov:StrView (string-as-view (ref o 'out))
            ev:StrView (string-as-view (ref o 'err))
            r:&Ran (alloca Ran))
        (set! (r 'ok?) (success? (ref o 'status)))
        (set! (r 'out) (ran-stream ov))
        (set! (r 'err) (ran-stream ev))
        (drop &o)
        (return (ok (deref r)))))
    ((err e) (return (err e)))))

; `nucleusc [flag] --emit-llvm <path>`, with nothing else added. The units that
; assert about the diagnostic FORMAT cannot use the builders above: every one of
; them passes `--diagnostics=edn`, which is the thing under test.
(defn nucleusc-raw (flag:StrView path:StrView):!Ran
  (let (c:Command (command (compiler-path)))
    (when (not (= flag "")) (command-arg &c flag))
    (command-arg &c "--emit-llvm")
    (command-arg &c path)
    (let (r:Ran (try (ran &c)))
      (drop &c)
      (return (ok r)))))

; An empty `dir` adds no `-I`, which is the only optionality the multi-file
; units need: they export a `.nuch` and then import it from a second unit.
(defn compile-path-in (dir:StrView path:StrView):!Compiled
  (let (c:Command (command (compiler-path)))
    (when (not (= dir ""))
      (command-arg &c "-I")
      (command-arg &c dir))
    (command-arg &c "--diagnostics=edn")
    (command-arg &c "--emit-llvm")
    (command-arg &c path)
    (let (r:Compiled (try (compiled-run &c)))
      (drop &c)
      (return (ok r)))))

(defn compile-path (path:StrView):!Compiled
  (return (compile-path-in "" path)))

; The same for an emit mode other than `--emit-llvm`. Unlike `emit-for-file`
; this survives a refusal, so a unit can ask whether an emission was CLEAN.
(defn emit-checked (dir:StrView flag:StrView path:StrView):!Compiled
  (let (c:Command (command (compiler-path)))
    (when (not (= dir ""))
      (command-arg &c "-I")
      (command-arg &c dir))
    (command-arg &c "--diagnostics=edn")
    (command-arg &c flag)
    (command-arg &c path)
    (let (r:Compiled (try (compiled-run &c)))
      (drop &c)
      (return (ok r)))))

; `nucleusc [-I dir] -c <path> -o <out>`. `-c` is the only flag that says
; "relocatable object", so it is the only one under which the compiler can warn
; about what ANOTHER object will do; `compile-object-in` discards that.
(defn object-checked (dir:StrView path:StrView out:StrView):!Compiled
  (let (c:Command (command (compiler-path)))
    (when (not (= dir ""))
      (command-arg &c "-I")
      (command-arg &c dir))
    (command-arg &c "--diagnostics=edn")
    (command-arg &c "-c")
    (command-arg &c path)
    (command-arg &c "-o")
    (command-arg &c out)
    (let (r:Compiled (try (compiled-run &c)))
      (drop &c)
      (return (ok r)))))

; `nucleusc [-I dir] <path> -o <bin>` — a whole program, link included.
(defn build-checked (dir:StrView path:StrView bin:StrView):!Compiled
  (let (c:Command (command (compiler-path)))
    (when (not (= dir ""))
      (command-arg &c "-I")
      (command-arg &c dir))
    (command-arg &c "--diagnostics=edn")
    (command-arg &c path)
    (command-arg &c "-o")
    (command-arg &c bin)
    (let (r:Compiled (try (compiled-run &c)))
      (drop &c)
      (return (ok r)))))

; The same, plus one driver flag. A link-time claim needs the binary's PATH to
; hand to `nm`, and `build-run-file` — the only other helper taking an extra
; flag — returns the program's output instead.
(defn build-checked-with (dir:StrView extra:StrView path:StrView
                          bin:StrView):!Compiled
  (let (c:Command (command (compiler-path)))
    (when (not (= dir ""))
      (command-arg &c "-I")
      (command-arg &c dir))
    (command-arg &c "--diagnostics=edn")
    (when (not (= extra "")) (command-arg &c extra))
    (command-arg &c path)
    (command-arg &c "-o")
    (command-arg &c bin)
    (let (r:Compiled (try (compiled-run &c)))
      (drop &c)
      (return (ok r)))))

; No diagnostics at all. `check-no-errors` is not this claim: a warning is what
; three of the separate-compilation units are asserting the absence of.
(defn check-silent ((c (ref Compiled)) what:StrView):!void
  (when (> (count (ref c 'diags)) 0)
    (let (l:String (diag-list-text (ref c 'diags)))
      (fail! what " must say nothing, got:" (string-as-view &l))))
  (return (ok)))

(defn compiled-ir ((c (ref Compiled))):StrView
  (return (string-as-view (ref c 'ir))))

; Where `compile-source` and friends put a fixture, so a unit can pin the file
; field of a diagnostic about source it wrote itself.
(defn scratch-file (name:StrView):!String
  (let (dir:StrView (try (test-scratch)))
    (return (ok (str dir "/" name)))))

; The same, for a cross target. Separate from `compile-path-in` because the two
; optional arguments are never both wanted: a `-I` search path is about this
; project's sources and `--target` is about the machine they are emitted for.
(defn compile-path-for (target:StrView path:StrView):!Compiled
  (let (c:Command (command (compiler-path))
        flag:String (str "--target=" target))
    (command-arg &c (string-as-view &flag))
    (command-arg &c "--diagnostics=edn")
    (command-arg &c "--emit-llvm")
    (command-arg &c path)
    (let (r:Compiled (try (compiled-run &c)))
      (drop &flag)
      (drop &c)
      (return (ok r)))))

; The host triple as the compiler itself spells it — the module header of a
; native `--emit-llvm`. A unit asserting a cross-target diagnostic needs it
; without pinning the machine the suite happens to run on.
(defn host-triple ():!String
  (let (ir:String (try (source-ir "(defn main ():i32 (return 0))\n"))
        v:StrView (string-as-view &ir)
        key:StrView "target triple = \"")
    (match (strview-find &v &key)
      ((some i)
        (let (after:StrView (strview-drop-bytes v (+ i (strview-byte-len key))))
          (match (strview-find-byte &after (as ui8 34))
            ((some j)
              (let (tv:StrView (strview-take-bytes after j)
                    out:String (try (string-from-view &tv)))
                (drop &ir)
                (return (ok out))))
            (none (drop &ir)
                  (fail! "no closing quote on the module's target triple")))))
      (none (drop &ir)
            (fail! "no `target triple` line in a native --emit-llvm")))))

; `nucleusc [-I dir] <flag> <path>` — stdout, which for `--emit-nuch` and
; `--emit-cheader` is the artifact itself.
(defn emit-for-file (dir:StrView flag:StrView path:StrView):!String
  (let (c:Command (command (compiler-path)))
    (when (not (= dir ""))
      (command-arg &c "-I")
      (command-arg &c dir))
    (command-arg &c flag)
    (command-arg &c path)
    (command-capture &c true)
    (match (run &c)
      ((ok o)
        (when (not (success? (ref o 'status)))
          (fail! "expected " flag " to succeed\n     "
                 (test-show (string-as-view (ref o 'err)))))
        (let (ov:StrView (string-as-view (ref o 'out))
              out:String (try (string-from-view &ov)))
          (drop &o)
          (drop &c)
          (return (ok out))))
      ((err e)
        (drop &c)
        (return (err e))))))

; The same, for source written out of the test itself. Ruling 3 (§T8.3) admits
; both embedded and file fixtures; a unit that varies one line of a program is
; unreadable as a hundred files.
(defn compile-source (src:StrView):!Compiled
  (let (p:String (try (test-write-file "t.nuc" src))
        r:Compiled (try (compile-path (string-as-view &p))))
    (drop &p)
    (return (ok r))))

; Compiling `path` must FAIL, and some error must carry `needle`.
(defn check-file-rejects (dir:StrView path:StrView needle:StrView):!void
  (let (r:Compiled (try (compile-path-in dir path)))
    (when (r 'ok?)
      (fail! "expected a rejection containing " (quoted needle)
             ", but it compiled"))
    (try (check-error-anywhere (ref r 'diags) needle))
    (drop &r)
    (return (ok))))

; `nucleusc <flag> <path>` must FAIL, with `needle` in some error. The
; `--emit-cheader` refusals are the ones a `--emit-llvm` run cannot reach at
; all: they fire while rendering the header, which that run never does.
(defn check-emit-rejects (flag:StrView path:StrView needle:StrView):!void
  (let (c:Command (command (compiler-path)))
    (command-arg &c "--diagnostics=edn")
    (command-arg &c flag)
    (command-arg &c path)
    (command-capture &c true)
    (match (run &c)
      ((ok o)
        (when (success? (ref o 'status))
          (fail! "expected " flag " to refuse " path))
        (let (ev:StrView (string-as-view (ref o 'err))
              ds:(Vector Diagnostic) (try (read-diagnostics ev)))
          (try (check-error-anywhere &ds needle))
          (drop &ds)
          (drop &o)))
      ((err e)
        (drop &c)
        (return (err e))))
    (drop &c)
    (return (ok))))

(defn check-source-rejects (src:StrView needle:StrView):!void
  (let (p:String (try (test-write-file "t.nuc" src)))
    (try (check-file-rejects "" (string-as-view &p) needle))
    (drop &p)
    (return (ok))))

; Whether `src` compiles at all. A table of accept/reject spellings asks only
; this, and neither `check-source-rejects` nor `check-source-accepts` can carry
; the two halves of one row.
(defn source-compiles? (src:StrView):!bool
  (let (c:Compiled (try (compile-source src))
        ok?:bool (c 'ok?))
    (drop &c)
    (return (ok ok?))))

; Compiling `src` must SUCCEED, with no diagnostic at all.
(defn check-source-accepts (src:StrView):!void
  (let (r:Compiled (try (compile-source src)))
    (when (not (r 'ok?))
      (fail! "expected a clean compile\n     "
             (test-show (string-as-view (ref r 'raw-text)))))
    (try (check-empty (string-as-view (ref r 'raw-text))))
    (drop &r)
    (return (ok))))

; The IR of a source that must compile.
(defn source-ir (src:StrView):!String
  (let (r:Compiled (try (compile-source src)))
    (when (not (r 'ok?))
      (fail! "expected a clean compile\n     "
             (test-show (string-as-view (ref r 'raw-text)))))
    (let (iv:StrView (string-as-view (ref r 'ir))
          out:String (try (string-from-view &iv)))
      (drop &r)
      (return (ok out)))))

; Run a built binary. `command-search false` because the path is one this test
; just wrote, not a program name to find.
(defn run-stdout (bin:StrView):!String
  (let (rc:Command (command bin))
    (command-search &rc false)
    (command-capture &rc true)
    (command-stderr-to-stdout &rc true)
    (match (run &rc)
      ((ok o)
        (let (ov:StrView (string-as-view (ref o 'out))
              out:String (try (string-from-view &ov)))
          (drop &o)
          (drop &rc)
          (return (ok out))))
      ((err e) (return (err e))))))

; The same run, when the program's answer is its exit status. Separate because
; a program deliberately kept to a handful of symbols cannot print: `print`
; would pull the whole io closure into an object whose symbol table is the
; assertion.
(defn run-exit (bin:StrView):!i32
  (let (rc:Command (command bin))
    (command-search &rc false)
    (command-capture &rc true)
    (command-stderr-to-stdout &rc true)
    (match (run &rc)
      ((ok o)
        (let (st:ExitStatus (o 'status)
              got:i32 (exit-code &st))
          (drop &o)
          (drop &rc)
          (return (ok got))))
      ((err e) (return (err e))))))

; Build `path` and run it; the assertion is its EXIT STATUS. The shape of
; `w1_run`, which several bespoke units use for a program whose answer is a
; number rather than output.
(defn check-file-exit (idir:StrView path:StrView want:i32):!void
  (let (dir:StrView (try (test-scratch))
        bin:String (str dir "/t.bin")
        bv:StrView (string-as-view &bin)
        cc:Command (command (compiler-path)))
    (when (not (= idir ""))
      (command-arg &cc "-I")
      (command-arg &cc idir))
    (command-arg &cc path)
    (command-arg &cc "-o")
    (command-arg &cc bv)
    (command-capture &cc true)
    (command-stderr-to-stdout &cc true)
    (match (run &cc)
      ((ok o)
        (let (built:bool (success? (ref o 'status)))
          (when (not built)
            (fail! "compile/link error\n     "
                   (test-show (string-as-view (ref o 'out)))))
          (drop &o)))
      ((err e) (return (err e))))
    (drop &cc)
    (let (got:i32 (try (run-exit bv)))
      (when (!= got want)
        (fail! "expected exit " (as i64 want) ", got " (as i64 got))))
    (drop &bin)
    (return (ok))))

(defn check-source-exit (src:StrView want:i32):!void
  (let (p:String (try (test-write-file "t.nuc" src)))
    (try (check-file-exit "" (string-as-view &p) want))
    (drop &p)
    (return (ok))))

; The generated C header for `src`, which must compile.
(defn source-cheader (src:StrView):!String
  (let (p:String (try (test-write-file "t.nuc" src))
        c:Command (command (compiler-path)))
    (command-arg &c "--emit-cheader")
    (command-arg &c (string-as-view &p))
    (command-capture &c true)
    (match (run &c)
      ((ok o)
        (let (built:bool (success? (ref o 'status)))
          (when (not built)
            (fail! "expected a header, got an error\n     "
                   (test-show (string-as-view (ref o 'err)))))
          (let (ov:StrView (string-as-view (ref o 'out))
                out:String (try (string-from-view &ov)))
            (drop &o)
            (drop &c)
            (drop &p)
            (return (ok out)))))
      ((err e)
        (drop &c)
        (return (err e))))))

; `nucleusc [-I dir] -c <path> -o <out>`: a translation unit for a real link.
(defn compile-object-in (dir:StrView path:StrView out:StrView):!void
  (let (c:Command (command (compiler-path)))
    (when (not (= dir ""))
      (command-arg &c "-I")
      (command-arg &c dir))
    (command-arg &c "-c")
    (command-arg &c path)
    (command-arg &c "-o")
    (command-arg &c out)
    (command-capture &c true)
    (command-stderr-to-stdout &c true)
    (match (run &c)
      ((ok o)
        (when (not (success? (ref o 'status)))
          (fail! "expected an object file\n     "
                 (test-show (string-as-view (ref o 'out)))))
        (drop &o))
      ((err e)
        (drop &c)
        (return (err e))))
    (drop &c)
    (return (ok))))

(defn compile-object (path:StrView out:StrView):!void
  (return (compile-object-in "" path out)))

; Build the space-separated `parts` — `.c`, `.o` or `.ll`, clang takes any — and
; run the result; stdout is the answer. Separate compilation is the only thing
; that tests what a `.nuch` or a generated `.h` actually promised: the symbol has
; to be resolved by the LINKER, not by the compiler having seen the source.
;
; `-Wall -Werror` because "it parses" is not the claim a generated header has to
; meet; a real consumer builds clean or the header is broken.
(defn driver-link (drv:StrView idir:StrView parts:StrView):!String
  (let (dir:StrView (try (test-scratch))
        bin:String (str dir "/linked.bin")
        sp:StrView " "
        c:Command (command drv)
        it:SplitIter (strview-split &parts &sp))
    (command-arg &c "-Wall")
    (command-arg &c "-Werror")
    (when (not (= idir ""))
      (command-arg &c "-I")
      (command-arg &c idir))
    (while (not (split-iter-done &it))
      (command-arg &c (split-iter-next &it)))
    (command-arg &c "-o")
    (command-arg &c (string-as-view &bin))
    (command-capture &c true)
    (command-stderr-to-stdout &c true)
    (match (run &c)
      ((ok o)
        (when (not (success? (ref o 'status)))
          (fail! "link error\n     " (test-show (string-as-view (ref o 'out)))))
        (drop &o))
      ((err e) (return (err e))))
    (drop &c)
    (return (ok bin))))

(defn driver-link-run (drv:StrView idir:StrView parts:StrView):!String
  (let (bin:String (try (driver-link drv idir parts))
        out:String (try (run-stdout (string-as-view &bin))))
    (drop &bin)
    (return (ok out))))

(defn cc-link-run (idir:StrView parts:StrView):!String
  (return (driver-link-run "clang" idir parts)))

; The same link, for a program whose answer is its exit status.
(defn cc-link-exit (parts:StrView):!i32
  (let (bin:String (try (driver-link "clang" "" parts))
        got:i32 (try (run-exit (string-as-view &bin))))
    (drop &bin)
    (return (ok got))))

; The same consumer through the platform C++ driver. A generated header is
; routinely read from C++ behind `extern "C"`, where a name C tolerates can
; still be a keyword.
(defn cxx-link-run (idir:StrView parts:StrView):!String
  (return (driver-link-run "c++" idir parts)))

(defn link-run (parts:StrView):!String
  (return (cc-link-run "" parts)))

; `--emit-llvm` never reads back what it writes, so exiting 0 says nothing about
; whether the module is valid. `llvm-as` is the reader.
(defn check-ir-parses (ir:StrView):!void
  (let (p:String (try (test-write-file "parse-probe.ll" ir))
        c:Command (command "llvm-as"))
    (command-arg &c (string-as-view &p))
    (command-arg &c "-o")
    (command-arg &c "/dev/null")
    (command-capture &c true)
    (match (run &c)
      ((ok o)
        (when (not (success? (ref o 'status)))
          (fail! "emitted IR does not parse\n     "
                 (test-show (string-as-view (ref o 'err)))))
        (drop &o))
      ((err e)
        (drop &c)
        (return (err e))))
    (drop &c)
    (drop &p)
    (return (ok))))

; The complement. That llvm-as accepted a module says nothing until the same
; llvm-as is shown refusing the defect the unit is about, named in `needle`.
(defn check-ir-rejects (ir:StrView needle:StrView):!void
  (let (p:String (try (test-write-file "reject-probe.ll" ir))
        c:Command (command "llvm-as"))
    (command-arg &c (string-as-view &p))
    (command-arg &c "-o")
    (command-arg &c "/dev/null")
    (command-capture &c true)
    (match (run &c)
      ((ok o)
        (when (success? (ref o 'status))
          (fail! "expected llvm-as to reject this IR\n     " (test-show ir)))
        (try (check-contains (string-as-view (ref o 'err)) needle))
        (drop &o))
      ((err e)
        (drop &c)
        (return (err e))))
    (drop &c)
    (drop &p)
    (return (ok))))

; `hay` with every `needle` replaced by `repl`. A unit that emits a module and
; then wants its NEGATIVE has no other way to build one that is wrong in exactly
; one respect.
(defn replace-all (hay:StrView needle:StrView repl:StrView):!String
  (let (out:String (string-new)
        rest:StrView hay
        more:bool true)
    (while more
      (match (strview-find (ref rest) &needle)
        ((some at)
          (str-into &out (strview-take-bytes rest at) repl)
          (set! rest (strview-drop-bytes rest (+ at (strview-byte-len &needle)))))
        (none
          (str-into &out rest)
          (set! more false))))
    (return (ok out))))

; `first` is emitted before `second`. The root hoist and the ordinary cycle skip
; produce the same four definitions, so WHEN the root's own forms are written is
; the only artifact that tells the two paths apart.
(defn check-order (hay:StrView first:StrView second:StrView what:StrView):!void
  (let (a:usize 0
        b:usize 0)
    (match (strview-find &hay &first)
      ((some at) (set! a at))
      (none (fail! what ": not emitted at all: " (test-show first))))
    (match (strview-find &hay &second)
      ((some at) (set! b at))
      (none (fail! what ": not emitted at all: " (test-show second))))
    (when (> a b)
      (fail! what ": " (test-show first) " must be emitted before " (test-show second))))
  (return (ok)))

; No diagnostic, message or note, says `needle`. The guard a scope diagnostic
; needs: "unknown" plus the right note still passes if the compiler ALSO fell
; back to claiming the name is absent from the unit, which for a name that is
; defined and reachable is false.
(defn check-no-diag-containing ((ds (ref (Vector Diagnostic))) needle:StrView):!void
  (let (n:usize (count ds)
        i:usize 0)
    (while (< i n)
      (let (d:Diagnostic (invoke ds i))
        (when (contains? (d 'message) needle)
          (let (l:String (diag-list-text ds))
            (fail! "no diagnostic may contain " (quoted needle) "\n     got:"
                   (string-as-view &l))))
        (let (m:usize (count (d 'notes))
              j:usize 0)
          (while (< j m)
            (when (contains? (invoke (d 'notes) j) needle)
              (let (l:String (diag-list-text ds))
                (fail! "no note may contain " (quoted needle) "\n     got:"
                       (string-as-view &l))))
            (set! j (+ j 1)))))
      (set! i (+ i 1))))
  (return (ok)))

; `opt -O2` over a module, as text. The only way to ask whether a function
; attribute changes what the optimizer actually does.
(defn opt-o2 (stem:StrView ir:StrView):!String
  (let (dir:StrView (try (test-scratch))
        nm:String (str stem ".ll")
        p:String (try (test-write-file (string-as-view &nm) ir))
        out:String (str dir "/" stem ".opt.ll")
        c:Command (command "opt"))
    (command-arg &c "-O2")
    (command-arg &c "-S")
    (command-arg &c (string-as-view &p))
    (command-arg &c "-o")
    (command-arg &c (string-as-view &out))
    (command-capture &c true)
    (match (run &c)
      ((ok o)
        (when (not (success? (ref o 'status)))
          (fail! "opt -O2 rejected the emitted module\n     "
                 (test-show (string-as-view (ref o 'err)))))
        (drop &o))
      ((err e)
        (drop &c)
        (return (err e))))
    (let (text:String (try (read-file (string-as-view &out))))
      (drop &c)
      (drop &out)
      (drop &p)
      (drop &nm)
      (return (ok text)))))

; The global symbols `path` DEFINES, one per line. The independent witness a
; generated header needs: reading it cannot tell a correct `asm` label from one
; naming a symbol no object defines, and that is the whole risk of a label.
(defn nm-defined (path:StrView):!String
  (let (c:Command (command "nm"))
    (command-arg &c "-g")
    (command-arg &c "--defined-only")
    (command-arg &c path)
    (command-capture &c true)
    (match (run &c)
      ((ok o)
        (when (not (success? (ref o 'status)))
          (fail! "nm failed\n     " (test-show (string-as-view (ref o 'err)))))
        (let (ov:StrView (string-as-view (ref o 'out))
              nl:StrView "\n"
              out:String (string-new)
              it:SplitIter (strview-split &ov &nl))
          (while (not (split-iter-done &it))
            (let (l:StrView (split-iter-next &it))
              (match (strview-rfind-byte &l 32)
                ((some at)
                  (str-into &out (strview-drop-bytes l (+ at 1)) "\n"))
                (none 0))))
          (drop &o)
          (drop &c)
          (return (ok out))))
      ((err e)
        (drop &c)
        (return (err e))))))

; Every symbol in `path`, as `<type> <name>` lines. `nm-defined` cannot answer a
; separate-compilation question: it drops both the linkage letter, which is what
; says an imported definition is a COPY, and the undefined symbols, which are
; what says a call crossed the object boundary at all.
(defn nm-typed (path:StrView):!String
  (let (c:Command (command "nm"))
    (command-arg &c path)
    (command-capture &c true)
    (match (run &c)
      ((ok o)
        (when (not (success? (ref o 'status)))
          (fail! "nm failed\n     " (test-show (string-as-view (ref o 'err)))))
        (let (ov:StrView (string-as-view (ref o 'out))
              nl:StrView "\n"
              out:String (string-new)
              it:SplitIter (strview-split &ov &nl))
          (while (not (split-iter-done &it))
            (let (l:StrView (split-iter-next &it))
              (match (strview-rfind-byte &l 32)
                ((some at)
                  ; `<value> <type> <name>`, and an undefined symbol pads the
                  ; value field with spaces — so the letter is the byte before
                  ; the last space, whichever form the line took.
                  (when (> at 0)
                    (str-into &out
                              (strview-take-bytes (strview-drop-bytes l (- at 1)) 1)
                              " " (strview-drop-bytes l (+ at 1)) "\n")))
                (none 0))))
          (drop &o)
          (drop &c)
          (return (ok out))))
      ((err e)
        (drop &c)
        (return (err e))))))

; Every non-empty line of `want` must be a line of `got`, and the two must have
; the same number of them. Symbol names are unique within one object, so that is
; set equality — and order is not: `nm` sorts by value, and every symbol in a
; relocatable object has value 0.
(defn check-line-set (got:StrView want:StrView what:StrView):!void
  (let (ng:i64 0
        nw:i64 0
        gi:LineIter (strview-lines &got)
        wi:LineIter (strview-lines &want))
    (while (not (lines-iter-done &gi))
      (when (!= (lines-iter-next &gi) "") (set! ng (+ ng 1))))
    (while (not (lines-iter-done &wi))
      (let (l:StrView (lines-iter-next &wi))
        (when (!= l "")
          (set! nw (+ nw 1))
          (when (not (has-line? got l))
            (fail! what ": missing " (quoted l) "\n     got:\n" got)))))
    (when (!= ng nw)
      (fail! what ": expected " nw " line(s), got " ng "\n     got:\n" got)))
  (return (ok)))

; `test-write-file` only reaches the scratch directory itself, and a `.nuch`
; unit needs its header in a subdirectory of it — `resolve-import` tries `.nuc`
; in every search directory before any `.nuch`, so the source must sit outside.
(defn write-into (dir:StrView name:StrView content:StrView):!String
  (let (p:String (str dir "/" name)
        pv:StrView (string-as-view &p)
        f:File (try (file-create &pv)))
    (try (write-str &f content))
    (try (file-close &f))
    (return (ok p))))

; `nucleusc [-I idir] <flag> <src>`, written to `dir/name`. The artifact has to
; be a FILE for the next compile to import or the linker to read.
(defn emit-into (idir:StrView flag:StrView src:StrView dir:StrView
                 name:StrView):!String
  (let (t:String (try (emit-for-file idir flag src))
        p:String (try (write-into dir name (string-as-view &t))))
    (drop &t)
    (return (ok p))))

; What clang made of a C file. `ok?` is false for a source clang refused —
; which is how a unit asks whether THIS clang's target has a type, since a
; version number does not say when each width arrived.
(defstruct CcIr ok?:bool ir:String err:String)

(extend CcIr Drop)
(defn drop ((self &CcIr)):void
  (drop (ref self 'ir))
  (drop (ref self 'err)))

; clang's own IR for a C file — the oracle half of a unit that compares the two
; compilers. clang itself is not optional: `src/nucleusc.nuc` uses it as the
; default linker driver and the Makefile links with it, so a missing clang is a
; broken toolchain rather than a skip.
(defn cc-emit-llvm (path:StrView):!CcIr
  (let (c:Command (command "clang"))
    (command-arg &c "-S")
    (command-arg &c "-emit-llvm")
    (command-arg &c "-O0")
    (command-arg &c "-w")
    (command-arg &c "-o")
    (command-arg &c "-")
    (command-arg &c path)
    (command-capture &c true)
    (match (run &c)
      ((ok o)
        (let (ov:StrView (string-as-view (ref o 'out))
              ev:StrView (string-as-view (ref o 'err))
              r:&CcIr (alloca CcIr))
          (set! (r 'ok?) (success? (ref o 'status)))
          (set! (r 'ir) (try (string-from-view &ov)))
          (set! (r 'err) (try (string-from-view &ev)))
          (drop &o)
          (drop &c)
          (return (ok (deref r)))))
      ((err e)
        (drop &c)
        (return (err e))))))

; Whether clang accepted a C file, and what it said. For a `-fsyntax-only`
; oracle `ok?` is the whole verdict: the assertions are `_Static_assert`s in the
; file itself, so there is nothing left to compare.
(defstruct CcCheck ok?:bool err:String)

(extend CcCheck Drop)
(defn drop ((self &CcCheck)):void
  (drop (ref self 'err)))

(defn cc-check-run ((c (ref Command))):!CcCheck
  (command-capture c true)
  (match (run c)
    ((ok o)
      (let (ev:StrView (string-as-view (ref o 'err))
            r:&CcCheck (alloca CcCheck))
        (set! (r 'ok?) (success? (ref o 'status)))
        (set! (r 'err) (try (string-from-view &ev)))
        (drop &o)
        (return (ok (deref r)))))
    ((err e) (return (err e)))))

; A complete compile-time `sizeof`/`offsetof` oracle for a machine this one
; cannot execute: `_Static_assert`s rule, so there is no sysroot, no link and
; no run.
(defn cc-syntax-only-for (target:StrView path:StrView):!CcCheck
  (let (flag:String (str "--target=" target)
        c:Command (command "clang"))
    (command-arg &c (string-as-view &flag))
    (command-arg &c "-ffreestanding")
    (command-arg &c "-fsyntax-only")
    (command-arg &c path)
    (let (r:CcCheck (try (cc-check-run &c)))
      (drop &flag)
      (drop &c)
      (return (ok r)))))

; Does this C file parse against the headers in `idir`? The question a unit asks
; when the expected answer is NO — a link would report the same defect much
; later and with a worse message.
(defn cc-syntax-only-in (idir:StrView path:StrView):!CcCheck
  (let (c:Command (command "clang"))
    (command-arg &c "-fsyntax-only")
    (when (not (= idir ""))
      (command-arg &c "-I")
      (command-arg &c idir))
    (command-arg &c path)
    (let (r:CcCheck (try (cc-check-run &c)))
      (drop &c)
      (return (ok r)))))

; A C consumer of a generated header, compiled as strictly as a real one would
; be — which is the half of "the header is valid C" that reading it cannot say.
(defn cc-compile-strict (path:StrView):!CcCheck
  (let (c:Command (command "clang"))
    (command-arg &c "-std=gnu11")
    (command-arg &c "-Wall")
    (command-arg &c "-Wextra")
    (command-arg &c "-Werror")
    (command-arg &c "-c")
    (command-arg &c path)
    (command-arg &c "-o")
    (command-arg &c "/dev/null")
    (let (r:CcCheck (try (cc-check-run &c)))
      (drop &c)
      (return (ok r)))))

; Whether `name` is on PATH, asked by running it. clang is a hard dependency of
; this project and never skips; `cc` and `c++` are not, and it is `cc` an ABI
; oracle wants — the claim is agreement with the compiler the platform's own
; headers were written for.
(defn have-program? (name:StrView):bool
  (let (c:Command (command name))
    (command-arg &c "--version")
    (command-capture &c true)
    (match (run &c)
      ((ok o)
        (let (ok?:bool (success? (ref o 'status)))
          (drop &o)
          (drop &c)
          (return ok?)))
      ((err e)
        (drop &c)
        (return false)))))

(defn have-cc? ():bool
  (return (have-program? "cc")))

(defn have-cxx? ():bool
  (return (have-program? "c++")))

(defn require-cc ():!void
  (when (not (have-cc?)) (skip! "no cc to build the oracle against"))
  (return (ok)))

; Run a source-tree audit or an external-toolchain script and require exit 0.
; These stay shell and Python by design — the framework invokes them rather than
; replacing them (design/stage18-tooling/overview.md §T7) — so the script's own
; report is the diagnosis, and a failure reprints it rather than restating it.
; `args` is split on spaces; none of these takes an argument containing one.
(defn check-script-ok (prog:StrView args:StrView):!void
  (let (sp:StrView " "
        c:Command (command prog)
        it:SplitIter (strview-split &args &sp))
    (while (not (split-iter-done &it))
      (let (a:StrView (split-iter-next &it))
        (when (!= a "") (command-arg &c a))))
    (command-env &c "NUCLEUSC" (compiler-path))
    (command-stderr-to-stdout &c true)
    (let (r:Ran (try (ran &c)))
      (when (not (r 'ok?))
        (fail! prog " " args " reported a failure\n     "
               (test-show (string-as-view (ref r 'out)))))
      (drop &r)
      (drop &c)))
  (return (ok)))

; Build a C program with `cc` and run it; stdout is the answer. The oracle half
; of a layout unit, whose claim is that the two compilers put the same bytes in
; the same places. An empty `idir` adds no `-I`.
(defn cc-run-file (idir:StrView path:StrView):!String
  (let (sdir:StrView (try (test-scratch))
        bin:String (str sdir "/c.bin")
        cc:Command (command "cc"))
    (command-arg &cc "-w")
    (when (not (= idir ""))
      (command-arg &cc "-I")
      (command-arg &cc idir))
    (command-arg &cc path)
    (command-arg &cc "-o")
    (command-arg &cc (string-as-view &bin))
    (command-capture &cc true)
    (command-stderr-to-stdout &cc true)
    (match (run &cc)
      ((ok o)
        (let (built:bool (success? (ref o 'status)))
          (when (not built)
            (fail! "cc refused the oracle program\n     "
                   (test-show (string-as-view (ref o 'out)))))
          (drop &o)))
      ((err e) (return (err e))))
    (drop &cc)
    (let (out:String (try (run-stdout (string-as-view &bin))))
      (drop &bin)
      (return (ok out)))))

; Compile `path` to a binary and run it, stdout and stderr on one stream. An
; empty `dir` adds no `-I`, and an empty `extra` no extra argument.
(defn build-run-file (dir:StrView extra:StrView path:StrView):!String
  (let (sdir:StrView (try (test-scratch))
        bin:String (str sdir "/t.bin")
        cc:Command (command (compiler-path)))
    (when (not (= dir ""))
      (command-arg &cc "-I")
      (command-arg &cc dir))
    (when (not (= extra "")) (command-arg &cc extra))
    (command-arg &cc path)
    (command-arg &cc "-o")
    (command-arg &cc (string-as-view &bin))
    (command-capture &cc true)
    (command-stderr-to-stdout &cc true)
    (match (run &cc)
      ((ok o)
        (let (built:bool (success? (ref o 'status)))
          (when (not built)
            (fail! "compile error\n     "
                   (test-show (string-as-view (ref o 'out)))))
          (drop &o)))
      ((err e) (return (err e))))
    (drop &cc)
    (let (out:String (try (run-stdout (string-as-view &bin))))
      (drop &bin)
      (return (ok out)))))

(defn build-run-source (src:StrView):!String
  (let (p:String (try (test-write-file "t.nuc" src))
        out:String (try (build-run-file "" "" (string-as-view &p))))
    (drop &p)
    (return (ok out))))

; A REPL session: `text` is the child's stdin and the transcript is the answer.
; Up to three extra argv words after `-i` (an empty slot adds nothing, as in
; `cflag-emit`) and one environment binding (an empty key sets nothing).
(defn repl-session-with (a:StrView b:StrView c:StrView
                         env-k:StrView env-v:StrView text:StrView):!String
  (let (p:String (try (test-write-file "repl.in" text))
        cmd:Command (command (compiler-path)))
    (command-arg &cmd "-i")
    (when (not (= a "")) (command-arg &cmd a))
    (when (not (= b "")) (command-arg &cmd b))
    (when (not (= c "")) (command-arg &cmd c))
    (when (not (= env-k "")) (command-env &cmd env-k env-v))
    (command-stdin-path &cmd (string-as-view &p))
    (command-capture &cmd true)
    (command-stderr-to-stdout &cmd true)
    (match (run &cmd)
      ((ok o)
        (let (ov:StrView (string-as-view (ref o 'out))
              out:String (try (string-from-view &ov)))
          (drop &o)
          (drop &cmd)
          (drop &p)
          (return (ok out))))
      ((err e)
        (drop &cmd)
        (return (err e))))))

(defn repl-session (text:StrView):!String
  (return (repl-session-with "" "" "" "" "" text)))

; Build `path`, feed the program `input` on stdin, and answer its output. An
; example cannot ask this: the golden-output loop hands a child the harness's
; own stdin, which on a terminal would block.
(defn build-run-stdin (path:StrView input:StrView):!String
  (let (sdir:StrView (try (test-scratch))
        bin:String (str sdir "/stdin.bin")
        binv:StrView (string-as-view &bin)
        c:Compiled (try (build-checked "" path binv)))
    (try (check-silent &c path))
    (drop &c)
    (let (ip:String (try (test-write-file "stdin.txt" input))
          rc:Command (command binv))
      (command-search &rc false)
      (command-stdin-path &rc (string-as-view &ip))
      (command-capture &rc true)
      (command-stderr-to-stdout &rc true)
      (match (run &rc)
        ((ok o)
          (let (ov:StrView (string-as-view (ref o 'out))
                out:String (try (string-from-view &ov)))
            (drop &o)
            (drop &rc)
            (drop &ip)
            (drop &bin)
            (return (ok out))))
        ((err e)
          (drop &rc)
          (return (err e)))))))

; The first line of `hay` containing `needle`. A claim about ONE instruction
; cannot be made by searching the module: `i8 %` is in every module.
(defn line-with (hay:StrView needle:StrView):!StrView
  (let (it:LineIter (strview-lines &hay))
    (while (not (lines-iter-done &it))
      (let (l:StrView (lines-iter-next &it))
        (when (contains? l needle) (return (ok l))))))
  (fail! "no line containing " (quoted needle) "\n     in: " (test-show hay)))

; The prefix of `sv` before the first `b`, or all of it.
(defn view-upto-byte (sv:StrView b:ui8):StrView
  (match (strview-find-byte &sv b)
    ((some i) (return (strview-take-bytes sv i)))
    (none (return sv))))

; How many lines of `hay` begin with `prefix`. A presence test cannot catch a
; DOUBLE emit, which is the way a re-drain goes wrong.
(defn count-lines-with-prefix (hay:StrView prefix:StrView):i64
  (let (n:i64 0
        it:LineIter (strview-lines &hay))
    (while (not (lines-iter-done &it))
      (when (strview-has-prefix (lines-iter-next &it) prefix)
        (set! n (+ n 1))))
    (return n)))

; The opcodes whose two operands may be written either way. Everything else --
; `icmp` above all -- carries meaning in its operand order and is left alone.
(defn commutative-opcode? (rest:StrView):bool
  (when (strview-has-prefix rest "add ") (return true))
  (when (strview-has-prefix rest "mul ") (return true))
  (when (strview-has-prefix rest "and ") (return true))
  (when (strview-has-prefix rest "or ") (return true))
  (when (strview-has-prefix rest "xor ") (return true))
  (when (strview-has-prefix rest "fadd ") (return true))
  (when (strview-has-prefix rest "fmul ") (return true))
  (return false))

; Writes `l` with its two operands in a canonical order and answers true, or
; answers false having written nothing. Only a `  %t = <commutative> a, b` line
; with exactly one comma qualifies.
(defn write-canonical-binop (l:StrView (out &String)):bool
  (when (not (strview-has-prefix l "  %")) (return false))
  (let (eq:StrView " = "
        comma:StrView ", "
        opc:bool false
        at:usize 0
        ci:usize 0
        si:usize 0
        found:bool false)
    (match (strview-find &l &eq)
      ((some x) (set! at x) (set! found true))
      (none (set! found false)))
    (when (not found) (return false))
    (set! opc (commutative-opcode? (strview-drop-bytes l (+ at 3))))
    (when (not opc) (return false))
    (set! found false)
    (match (strview-find &l &comma)
      ((some x) (set! ci x) (set! found true))
      (none (set! found false)))
    (when (not found) (return false))
    (let (tail:StrView (strview-drop-bytes l (+ ci 2))
          head:StrView (strview-take-bytes l ci)
          second:bool false)
      ; A second comma means the operand list is not a simple pair.
      (match (strview-find-byte &tail 44)
        ((some x) (set! second true))
        (none (set! second false)))
      (when second (return false))
      (set! found false)
      (match (strview-rfind-byte &head 32)
        ((some x) (set! si x) (set! found true))
        (none (set! found false)))
      (when (not found) (return false))
      (let (a:StrView (strview-drop-bytes head (+ si 1))
            pre:StrView (strview-take-bytes head (+ si 1)))
        (if (> (strview-cmp-raw &a &tail) 0)
            (str-into out pre tail ", " a "\n")
            (str-into out pre a ", " tail "\n")))
      (return true))))

; `ir` with the module header dropped and every commutative binop's operands in
; a canonical order. "Identical IR" cannot mean byte-identical text: the emitter
; preserves SOURCE operand order, so `mul i32 2, %t2` against `mul i32 %t2, 2`
; is an unavoidable and meaningless difference, and the header names the file.
(defn normalize-commutative (ir:StrView):String
  (let (out:String (string-new)
        it:LineIter (strview-lines &ir))
    (while (not (lines-iter-done &it))
      (let (l:StrView (lines-iter-next &it))
        (when (not (strview-has-prefix l "; ModuleID"))
          (when (not (strview-has-prefix l "source_filename"))
            (when (not (write-canonical-binop l &out))
              (str-into &out l "\n"))))))
    (return out)))

; `clang <flags> -o <bin> <path>`, then run it. `cc-run-file` is the wrong tool
; for a float kernel: the comparison is bit-exact, so the reference has to be
; built with the fixture's own `-ffp-contract=off`.
(defn clang-run-file (flags:StrView path:StrView):!String
  (let (sdir:StrView (try (test-scratch))
        bin:String (str sdir "/cref.bin")
        sp:StrView " "
        c:Command (command "clang")
        it:SplitIter (strview-split &flags &sp))
    (while (not (split-iter-done &it))
      (let (f:StrView (split-iter-next &it))
        (when (!= f "") (command-arg &c f))))
    (command-arg &c "-o")
    (command-arg &c (string-as-view &bin))
    (command-arg &c path)
    (command-capture &c true)
    (command-stderr-to-stdout &c true)
    (match (run &c)
      ((ok o)
        (when (not (success? (ref o 'status)))
          (fail! "the C reference does not build\n     "
                 (test-show (string-as-view (ref o 'out)))))
        (drop &o))
      ((err e)
        (drop &c)
        (return (err e))))
    (drop &c)
    (let (out:String (try (run-stdout (string-as-view &bin))))
      (drop &bin)
      (return (ok out)))))

; How many lines of `hay` match `pat`. `check-match` answers "at least one",
; which cannot tell six pointer-sized indices from one and five left behind.
(defn count-matching-lines (hay:StrView pat:StrView):i64
  (let (n:i64 0
        it:LineIter (strview-lines &hay))
    (while (not (lines-iter-done &it))
      (let (l:StrView (lines-iter-next &it))
        (when (glob-match &pat &l) (set! n (+ n 1)))))
    (return n)))

; The `%Name` of an IR type-definition line, or "".
(defn type-line-name (l:StrView):StrView
  (let (m:StrView " = type")
    (when (not (strview-has-prefix l "%")) (return ""))
    (match (strview-find &l &m)
      ((some at) (return (strview-take-bytes l at)))
      (none (return "")))))

; A top-level definition line: `%Name = type …`, `define …` or `declare …`.
(defn decl-line? (l:StrView):bool
  (when (strview-has-prefix l "define ") (return true))
  (when (strview-has-prefix l "declare ") (return true))
  (let (m:StrView " = type ")
    (return (and (strview-has-prefix l "%") (contains? l m)))))

(defn count-exact-lines (hay:StrView want:StrView):i64
  (let (n:i64 0
        it:LineIter (strview-lines &hay))
    (while (not (lines-iter-done &it))
      (when (= (lines-iter-next &it) want) (set! n (+ n 1))))
    (return n)))

(defn check-decls-subsumed (a:StrView b:StrView):!void
  (let (it:LineIter (strview-lines &a))
    (while (not (lines-iter-done &it))
      (let (l:StrView (lines-iter-next &it))
        (when (decl-line? l)
          (when (!= (count-exact-lines a l) (count-exact-lines b l))
            (fail! "the two modules' definition sets differ at "
                   (quoted l)))))))
  (return (ok)))

; Two modules must carry the same top-level definitions, as a SET: position
; within the type section is order-dependent and inert, and the string pool
; renumbers, so the artifacts themselves cannot be compared.
(defn check-same-decl-set (a:StrView b:StrView):!void
  (try (check-decls-subsumed a b))
  (try (check-decls-subsumed b a))
  (return (ok)))

; A type defined twice, or "". LLVM refuses a duplicate `%X = type` outright, so
; this is about the emitter's own bookkeeping rather than about the module.
(defn duplicate-type-name (ir:StrView):StrView
  (let (outer:LineIter (strview-lines &ir))
    (while (not (lines-iter-done &outer))
      (let (nm:StrView (type-line-name (lines-iter-next &outer)))
        (when (not (= nm ""))
          (let (n:i64 0
                inner:LineIter (strview-lines &ir))
            (while (not (lines-iter-done &inner))
              (when (= (type-line-name (lines-iter-next &inner)) nm)
                (set! n (+ n 1))))
            (when (> n 1) (return nm))))))
    (return "")))

; The `@name` a `define` line names, or "". No lib module emits a quoted global,
; so the name is everything between the first `@` and the `(` after it.
(defn define-line-name (l:StrView):StrView
  (when (not (strview-has-prefix l "define ")) (return ""))
  (match (strview-find-byte &l 64)
    ((some at)
      (let (rest:StrView (strview-drop-bytes l (+ at 1)))
        (match (strview-find-byte (ref rest) 40)
          ((some p) (return (strview-take-bytes rest p)))
          ((none) (return "")))))
    ((none) (return ""))))

; Every function the module defines, one name per line, for `check-line-set`. A
; COUNT of `define` lines is a weaker claim than it looks: two different sets of
; the same size compare equal.
(defn define-names (ir:StrView):String
  (let (out:String (string-new)
        it:LineIter (strview-lines &ir))
    (while (not (lines-iter-done &it))
      (let (nm:StrView (define-line-name (lines-iter-next &it)))
        (when (not (= nm "")) (str-into &out nm "\n"))))
    (return out)))

; A function defined twice, or "". Unlike a duplicate type LLVM accepts this and
; the module still parses; the second definition simply wins, which is how a
; re-drain silently doubles a library's contents.
(defn duplicate-define-name (ir:StrView):StrView
  (let (names:(Vector StrView) (vector-new)
        it:LineIter (strview-lines &ir))
    (while (not (lines-iter-done &it))
      (let (nm:StrView (define-line-name (lines-iter-next &it)))
        (when (not (= nm "")) (conj &names nm))))
    (let (n:usize (count &names)
          i:usize 0)
      (while (< i n)
        (let (a:StrView (invoke &names i)
              j:usize (+ i 1))
          (while (< j n)
            (when (= (invoke &names j) a)
              (drop &names)
              (return a))
            (set! j (+ j 1))))
        (set! i (+ i 1))))
    (drop &names)
    (return "")))

; ---------------------------------------------------------------------------
; A library, its generated header, and its object
; ---------------------------------------------------------------------------

; The object to link against and the header's text to read. Both artifacts sit
; in the test's own scratch directory, which is also where a C consumer gets
; written — a quoted `#include` resolves against the including file's own
; directory, so the header is reachable by BASE NAME and needs no path here.
(defstruct CLib obj:String text:String)

(extend CLib Drop)
(defn drop ((self &CLib)):void
  (drop (ref self 'obj))
  (drop (ref self 'text)))

(defn c-lib-obj ((l (ref CLib))):StrView
  (return (string-as-view (ref l 'obj))))

(defn c-lib-text ((l (ref CLib))):StrView
  (return (string-as-view (ref l 'text))))

; Write `stem.nuc`, emit its header beside it, compile its object. The scratch
; directory is always on the include path, so a library that imports a sibling
; needs no second spelling.
(defn c-lib (stem:StrView src:StrView):!CLib
  (let (dir:StrView (try (test-scratch))
        nuc:String (str stem ".nuc")
        hdr:String (str stem ".h")
        obj:String (str dir "/" stem ".o")
        p:String (try (test-write-file (string-as-view &nuc) src))
        hp:String (try (emit-into dir "--emit-cheader" (string-as-view &p)
                                  dir (string-as-view &hdr)))
        text:String (try (read-file (string-as-view &hp)))
        l:&CLib (alloca CLib))
    (try (compile-object-in dir (string-as-view &p)
                            (string-as-view &obj)))
    (set! (l 'obj) obj)
    (set! (l 'text) text)
    (drop &hp)
    (drop &p)
    (drop &nuc)
    (drop &hdr)
    (return (ok (deref l)))))

; Emit a header without compiling anything: what a unit wants when the claim is
; that a declaration was REFUSED, so there may be no symbol to link.
(defn c-header (stem:StrView src:StrView):!String
  (let (dir:StrView (try (test-scratch))
        nuc:String (str stem ".nuc")
        hdr:String (str stem ".h")
        p:String (try (test-write-file (string-as-view &nuc) src))
        hp:String (try (emit-into dir "--emit-cheader" (string-as-view &p)
                                  dir (string-as-view &hdr)))
        text:String (try (read-file (string-as-view &hp))))
    (drop &nuc)
    (drop &hdr)
    (drop &p)
    (drop &hp)
    (return (ok text))))

; Build `main-src` against the headers in the scratch directory, link it with
; `parts`, run it. The shape every end-to-end unit here is made of.
(defn c-consumer-run (main-src:StrView parts:StrView):!String
  (let (dir:StrView (try (test-scratch))
        p:String (try (test-write-file "main.c" main-src))
        all:String (str (string-as-view &p) " " parts)
        out:String (try (cc-link-run dir (string-as-view &all))))
    (drop &all)
    (drop &p)
    (return (ok out))))

(defn c-lib-run ((l (ref CLib)) main-src:StrView):!String
  (return (c-consumer-run main-src (c-lib-obj l))))

; What clang makes of a consumer it is only asked to parse — the form a unit
; needs when the expected answer is "it does not compile".
(defn c-consumer-syntax (idir:StrView main-src:StrView):!CcCheck
  (let (p:String (try (test-write-file "probe.c" main-src))
        r:CcCheck (try (cc-syntax-only-in idir (string-as-view &p))))
    (drop &p)
    (return (ok r))))

; ---------------------------------------------------------------------------
; Category (a): the rejection/acceptance table
; ---------------------------------------------------------------------------

; Each `(message …)` must appear in the message of a diagnostic at the pinned
; location, and each `(note …)` in a note of a diagnostic there. That pairing is
; the whole upgrade: eight rows of this table asserted a location that was only
; ever on a NOTE, which two independent greps over one blob cannot tell apart.
(defn run-reject-row (row:&Node):!void
  (let (fixture:StrView (row-file row)
        line:i32 (row-line row)
        msgs:?&Node (edn-get row "messages")
        notes:?&Node (edn-get row "notes")
        c:Compiled (try (compile-path fixture))
        ds:(Vector Diagnostic) (c 'diags))
    (when (= (count &ds) 0)
      (fail! "compiling " fixture " produced no diagnostic"))
    ; With no pinned line the old shell unit only swept for a `:0:` substring.
    ; The record makes that a field.
    (when (< line 0) (try (check-no-line-zero &ds)))
    (dotimes (i (edn-count msgs))
      (let (v:StrView (try (edn-str (edn-nth msgs (as usize i)))))
        (if (< line 0)
          (try (check-error-anywhere &ds v))
          (try (check-error-at &ds fixture line v)))))
    (dotimes (i (edn-count notes))
      (let (v:StrView (try (edn-str (edn-nth notes (as usize i)))))
        (if (< line 0)
          (try (check-note-anywhere &ds v))
          (try (check-note-at &ds fixture line v)))))
    (return (ok))))

(defn run-accept-row (row:&Node):!void
  (let (fixture:StrView (row-file row)
        c:Compiled (try (compile-path fixture))
        ds:(Vector Diagnostic) (c 'diags))
    (when (> (count &ds) 0)
      (try (check-no-errors &ds)))
    ; A diagnostic-free compile is the claim, so anything on stderr is a failure
    ; -- including something the diagnostics reader skipped.
    (try (check-empty (string-as-view (ref c 'raw-text))))
    (return (ok))))

(defn run-manifest-row (data:ptr):!void
  (let (row:&Node (unsafe/cast &Node data))
    (when (= (row-expects row) "accept") (return (run-accept-row row)))
    (return (run-reject-row row))))

; ---------------------------------------------------------------------------
; Category (b): golden output
; ---------------------------------------------------------------------------

; The base name a golden-output test was registered with. Carried as the
; interned symbol NODE for the same reason a manifest row is carried as one:
; `data` is a bare pointer, and an interned node outlives registration.
(defn data-name (data:ptr):StrView
  (return (symbol-as-view ((unsafe/cast &Node data) 's))))

(defn name-node (nm:StrView):&Node
  (return (intern-node (symbol-intern nm))))

; Compile, then run, comparing the program's own output against its golden file.
; Both captures merge stderr into stdout on ONE pipe: the golden file recorded
; `2>&1`, and two separately drained streams cannot reproduce an interleaving.
(defn run-example-test (data:ptr):!void
  ; The suite owns its output directory: `make test` clears it, and a test run
  ; on its own has no shell script to have made it.
  (try (make-dir "build/out"))
  (let (base:StrView (data-name data)
        src:String (str "examples/" base ".nuc")
        bin:String (str "build/out/" base)
        exp:String (str "tests/expected/" base ".out")
        cc:Command (command (compiler-path)))
    (command-arg &cc (string-as-view &src))
    (command-arg &cc "-o")
    (command-arg &cc (string-as-view &bin))
    (command-capture &cc true)
    (command-stderr-to-stdout &cc true)
    (match (run &cc)
      ((ok o)
        (let (ok?:bool (success? (ref o 'status)))
          (when (not ok?)
            (fail! "compile error\n     " (test-show (string-as-view (ref o 'out)))))
          (drop &o)))
      ((err e) (return (err e))))
    (drop &cc)
    (let (rc:Command (command (string-as-view &bin)))
      ; An exact path, not a PATH lookup -- and the exit status is deliberately
      ; not asserted: an example that exits nonzero says so in its golden file.
      (command-search &rc false)
      (command-capture &rc true)
      (command-stderr-to-stdout &rc true)
      (match (run &rc)
        ((ok o)
          (let (want:String (try (read-file (string-as-view &exp))))
            (try (check-golden (string-as-view (ref o 'out))
                               (string-as-view &want)))
            (drop &want)
            (drop &o)))
        ((err e) (return (err e))))
      (drop &rc))
    (drop &src)
    (drop &bin)
    (drop &exp)
    (return (ok))))

; A REPL session: the `.in` file is the child's stdin, and the transcript is
; compared whole.
(defn run-repl-test (data:ptr):!void
  (let (base:StrView (data-name data)
        src:String (str "tests/repl/" base ".in")
        exp:String (str "tests/expected/repl-" base ".out")
        c:Command (command (compiler-path)))
    (command-arg &c "-i")
    (command-stdin-path &c (string-as-view &src))
    (command-capture &c true)
    (command-stderr-to-stdout &c true)
    (match (run &c)
      ((ok o)
        (let (want:String (try (read-file (string-as-view &exp))))
          (try (check-golden (string-as-view (ref o 'out))
                             (string-as-view &want)))
          (drop &want)
          (drop &o)))
      ((err e) (return (err e))))
    (drop &c)
    (drop &src)
    (drop &exp)
    (return (ok))))

; ---------------------------------------------------------------------------
; Registration
; ---------------------------------------------------------------------------

; Present and readable. Asked by reading it, because there is no `stat` in
; `lib/file.nuc` and the file is small and about to be read anyway.
(defn have-file? (path:StrView):bool
  (match (read-file path)
    ((ok t) (let (s:String t) (drop &s) (return true)))
    ((err e) (return false))))

; Discovered from the directory, not listed in a manifest: a new example is a
; new test with no edit anywhere, which is the property the shell glob had and
; the reason category (b) is not a table like category (a).
(defn register-golden (dir:StrView ext:StrView exp-prefix:StrView
                       name-prefix:StrView (f (fn !void) (ptr))):!void
  (let (d:DirEntries (try (read-dir dir))
        n:usize (dir-count &d)
        i:usize 0)
    (while (< i n)
      (let (nm:StrView (dir-name &d i))
        (when (strview-has-suffix nm ext)
          (let (base:StrView (strview-take-bytes
                               nm (- (strview-byte-len &nm)
                                     (strview-byte-len &ext)))
                exp:String (str exp-prefix base ".out")
                tname:String (str name-prefix base))
            (when (have-file? (string-as-view &exp))
              (test-add (string-as-view &tname) dir 0 f
                        (as ptr (name-node base))))
            (drop &exp)
            (drop &tname))))
      (set! i (+ i 1)))
    (drop &d)
    (return (ok))))

(defn register-manifest ():!void
  (let (text:String (try (read-file (manifest-path)))
        forms:?&Node (try (manifest-rows (string-as-view &text))))
    (dotimes (i (node-len forms))
      (when-some (row (node-at forms i))
        (test-add (row-name row) (manifest-path) (row 'line) run-manifest-row row)))
    (return (ok))))

(defn register-all ():!void
  (try (register-manifest))
  (try (register-golden "examples" ".nuc" "tests/expected/" "" run-example-test))
  (try (register-golden "tests/repl" ".in" "tests/expected/repl-" "repl-" run-repl-test))
  (return (ok)))

(defn main (argc:i32 argv:ptr):int
  (match (register-all)
    (ok 0)
    ((err e)
      (if (> (test-failure-len) 0)
        (eprint "nuctests: registration failed: " (test-failure-text) "\n")
        (eprint "nuctests: registration failed: " (err-message e) "\n"))
      (return 2)))
  (return (as int (test-main argc argv))))

; Stage 18 TF-6 — the compiler's native test suite.
;
; Design: design/stage18-tooling/overview.md §T6.6.
;
; One binary, driven by `build/nuctest` the same way the shell suite is:
; `--list` names every test, `--run <name>` runs exactly one and prints its
; s-expression record. Each test is its own process, so isolation and order
; independence are properties of the architecture rather than promises.
;
; Category (a) is a TABLE (`tests/manifest/diagnostics.sexp`), not 168 hand
; written units: every row says the same thing about a different fixture, and
; the thing it says is now a comparison against one `Diagnostic` record rather
; than two greps over one stderr blob.

(import-use error)
(import-use strview)
(import-use string)
(import-use string-split)
(import-use fmt)
(import-use vector)
(import-use io)
(import-use file)
(import-use process)
(import-use node)
(import-use parse)
(import-use read)
(import-use test)
(import-use suite-s16)
(import-use suite-modules)
(import-use suite-float)
(import-use suite-layout)
(import-use suite-cheader)
(import-use suite-cimport)
(import-use suite-declarators)
(import-use suite-exports)
(import-use suite-linking)
(import-use suite-refusals)
(import-use suite-ir-names)
(import-use suite-target)
(import-use suite-imports)
(import-use suite-globals)
(import-use suite-conversions)



(defn manifest-path ():StrView (return "tests/manifest/diagnostics.sexp"))
(defn compiler-path ():StrView (return "./build/nucleusc"))

; ---------------------------------------------------------------------------
; Reading a row
; ---------------------------------------------------------------------------

; The operands of the `(key …)` entry named `name`, or null. Rows are the same
; shape a diagnostic is, so they are read the same way.
(defn row-entry (row:raw:Node name:StrView):raw:Node
  (let (cur:raw:Node (row 'cdr))
    (while (!= cur null)
      (let (e:raw:Node (cur 'car))
        (when (and (!= e null) (= (e 'kind) NODE-CELL))
          (let (h:raw:Node (e 'car))
            (when (and (!= h null) (= (h 'kind) NODE-SYM)
                       (= (symbol-as-view (h 's)) name))
              (return (e 'cdr))))))
      (set! cur (cur 'cdr)))
    (return null)))

; A kind check, not a null check: `Node.s` is null on an INT or a FLOAT, and
; `symbol-as-view` of null is a segfault, not an empty view.
(defn row-text (n:raw:Node):StrView
  (when (= n null) (return ""))
  (let (k:i32 (n 'kind))
    (when (and (!= k NODE-SYM) (!= k NODE-STR) (!= k NODE-KEYWORD)) (return "")))
  (return (symbol-as-view (n 's))))

; A row's Nth positional operand, counting the head as 0.
(defn row-at (row:raw:Node i:i32):raw:Node
  (let (cur:raw:Node row
        k:i32 0)
    (while (!= cur null)
      (when (= k i) (return (cur 'car)))
      (set! k (+ k 1))
      (set! cur (cur 'cdr)))
    (return null)))

(defn row-head (row:raw:Node):StrView
  (return (row-text (row-at row 0))))

(defn row-name (row:raw:Node):StrView
  (return (row-text (row-at row 1))))

(defn row-file (row:raw:Node):StrView
  (return (row-text ((row-entry row "file") 'car))))

; The pinned line, or -1 when the row does not pin one.
(defn row-line (row:raw:Node):i32
  (let (e:raw:Node (row-entry row "line"))
    (when (= e null) (return -1))
    (return (unsafe/cast i32 ((e 'car) 'i)))))

; ---------------------------------------------------------------------------
; Running the compiler
; ---------------------------------------------------------------------------

; What one `nucleusc --emit-llvm` produced. One record because most units ask
; about more than one part of it, and asking twice means compiling twice.
;
; A `Diagnostic`'s views point at interned symbols, so `diags` stays valid after
; `raw` is dropped.
;
; `exit` as well as `ok?`: a segfault also produces no output and no diagnostic,
; so only the status separates "refused" from "crashed".
(defstruct Compiled
  ok?:bool
  exit:i32
  ir:String
  raw:String
  diags:(Vector Diagnostic))

(extend Compiled Drop)
(defn drop ((self (ptr Compiled))):void
  (drop (addr-of self 'ir))
  (drop (addr-of self 'raw))
  (drop (addr-of self 'diags)))

; One prepared `nucleusc` command, run. Every builder below differs from the
; others only in which arguments it adds, and a unit that asserts the compiler
; said NOTHING needs the diagnostic list rather than a stderr grep.
(defn compiled-run ((c (ref Command))):!Compiled
  (command-capture c true)
  (match (run c)
    ((ok o)
      (let (ov:StrView (string-as-view (addr-of o 'out))
            ev:StrView (string-as-view (addr-of o 'err))
            r:&Compiled (alloca Compiled))
        (set! (r 'ok?) (success? (addr-of o 'status)))
        (set! (r 'exit) (exit-code (addr-of o 'status)))
        (set! (r 'ir) (try (string-from-view (addr-of ov))))
        (set! (r 'raw) (try (string-from-view (addr-of ev))))
        (set! (r 'diags) (try (read-diagnostics ev)))
        (drop (addr-of o))
        (return (ok (deref r)))))
    ((err e) (return (err e)))))

; An empty `dir` adds no `-I`, which is the only optionality the multi-file
; units need: they export a `.nuch` and then import it from a second unit.
(defn compile-path-in (dir:StrView path:StrView):!Compiled
  (let (c:Command (command (compiler-path)))
    (when (not (= dir ""))
      (command-arg (addr-of c) "-I")
      (command-arg (addr-of c) dir))
    (command-arg (addr-of c) "--diagnostics=sexp")
    (command-arg (addr-of c) "--emit-llvm")
    (command-arg (addr-of c) path)
    (let (r:Compiled (try (compiled-run (addr-of c))))
      (drop (addr-of c))
      (return (ok r)))))

(defn compile-path (path:StrView):!Compiled
  (return (compile-path-in "" path)))

; The same for an emit mode other than `--emit-llvm`. Unlike `emit-for-file`
; this survives a refusal, so a unit can ask whether an emission was CLEAN.
(defn emit-checked (dir:StrView flag:StrView path:StrView):!Compiled
  (let (c:Command (command (compiler-path)))
    (when (not (= dir ""))
      (command-arg (addr-of c) "-I")
      (command-arg (addr-of c) dir))
    (command-arg (addr-of c) "--diagnostics=sexp")
    (command-arg (addr-of c) flag)
    (command-arg (addr-of c) path)
    (let (r:Compiled (try (compiled-run (addr-of c))))
      (drop (addr-of c))
      (return (ok r)))))

; `nucleusc [-I dir] -c <path> -o <out>`. `-c` is the only flag that says
; "relocatable object", so it is the only one under which the compiler can warn
; about what ANOTHER object will do; `compile-object-in` discards that.
(defn object-checked (dir:StrView path:StrView out:StrView):!Compiled
  (let (c:Command (command (compiler-path)))
    (when (not (= dir ""))
      (command-arg (addr-of c) "-I")
      (command-arg (addr-of c) dir))
    (command-arg (addr-of c) "--diagnostics=sexp")
    (command-arg (addr-of c) "-c")
    (command-arg (addr-of c) path)
    (command-arg (addr-of c) "-o")
    (command-arg (addr-of c) out)
    (let (r:Compiled (try (compiled-run (addr-of c))))
      (drop (addr-of c))
      (return (ok r)))))

; `nucleusc [-I dir] <path> -o <bin>` — a whole program, link included.
(defn build-checked (dir:StrView path:StrView bin:StrView):!Compiled
  (let (c:Command (command (compiler-path)))
    (when (not (= dir ""))
      (command-arg (addr-of c) "-I")
      (command-arg (addr-of c) dir))
    (command-arg (addr-of c) "--diagnostics=sexp")
    (command-arg (addr-of c) path)
    (command-arg (addr-of c) "-o")
    (command-arg (addr-of c) bin)
    (let (r:Compiled (try (compiled-run (addr-of c))))
      (drop (addr-of c))
      (return (ok r)))))

; No diagnostics at all. `check-no-errors` is not this claim: a warning is what
; three of the separate-compilation units are asserting the absence of.
(defn check-silent ((c (ref Compiled)) what:StrView):!void
  (when (> (count (addr-of c 'diags)) 0)
    (let (l:String (diag-list-text (addr-of c 'diags)))
      (fail! what " must say nothing, got:" (string-as-view (addr-of l)))))
  (return (ok)))

(defn compiled-ir ((c (ref Compiled))):StrView
  (return (string-as-view (addr-of c 'ir))))

; Where `compile-source` and friends put a fixture, so a unit can pin the file
; field of a diagnostic about source it wrote itself.
(defn scratch-file (name:StrView):!String
  (let (dir:StrView (try (test-scratch)))
    (return (ok (str dir "/" name)))))

; The same, for a cross target. Separate from `compile-path-in` because the two
; optional arguments are never both wanted: a `-I` search path is about this
; project's sources and `--target` is about the machine they are emitted for.
(defn compile-path-for (target:StrView path:StrView):!Compiled
  (let (c:Command (command (compiler-path))
        flag:String (str "--target=" target))
    (command-arg (addr-of c) (string-as-view (addr-of flag)))
    (command-arg (addr-of c) "--diagnostics=sexp")
    (command-arg (addr-of c) "--emit-llvm")
    (command-arg (addr-of c) path)
    (let (r:Compiled (try (compiled-run (addr-of c))))
      (drop (addr-of flag))
      (drop (addr-of c))
      (return (ok r)))))

; `nucleusc [-I dir] <flag> <path>` — stdout, which for `--emit-nuch` and
; `--emit-cheader` is the artifact itself.
(defn emit-for-file (dir:StrView flag:StrView path:StrView):!String
  (let (c:Command (command (compiler-path)))
    (when (not (= dir ""))
      (command-arg (addr-of c) "-I")
      (command-arg (addr-of c) dir))
    (command-arg (addr-of c) flag)
    (command-arg (addr-of c) path)
    (command-capture (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (when (not (success? (addr-of o 'status)))
          (fail! "expected " flag " to succeed\n     "
                 (test-show (string-as-view (addr-of o 'err)))))
        (let (ov:StrView (string-as-view (addr-of o 'out))
              out:String (try (string-from-view (addr-of ov))))
          (drop (addr-of o))
          (drop (addr-of c))
          (return (ok out))))
      ((err e)
        (drop (addr-of c))
        (return (err e))))))

; The same, for source written out of the test itself. Ruling 3 (§T8.3) admits
; both embedded and file fixtures; a unit that varies one line of a program is
; unreadable as a hundred files.
(defn compile-source (src:StrView):!Compiled
  (let (p:String (try (test-write-file "t.nuc" src))
        r:Compiled (try (compile-path (string-as-view (addr-of p)))))
    (drop (addr-of p))
    (return (ok r))))

; Compiling `path` must FAIL, and some error must carry `needle`.
(defn check-file-rejects (dir:StrView path:StrView needle:StrView):!void
  (let (r:Compiled (try (compile-path-in dir path)))
    (when (r 'ok?)
      (fail! "expected a rejection containing " (sexp-quote needle)
             ", but it compiled"))
    (try (check-error-anywhere (addr-of r 'diags) needle))
    (drop (addr-of r))
    (return (ok))))

; `nucleusc <flag> <path>` must FAIL, with `needle` in some error. The
; `--emit-cheader` refusals are the ones a `--emit-llvm` run cannot reach at
; all: they fire while rendering the header, which that run never does.
(defn check-emit-rejects (flag:StrView path:StrView needle:StrView):!void
  (let (c:Command (command (compiler-path)))
    (command-arg (addr-of c) "--diagnostics=sexp")
    (command-arg (addr-of c) flag)
    (command-arg (addr-of c) path)
    (command-capture (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (when (success? (addr-of o 'status))
          (fail! "expected " flag " to refuse " path))
        (let (ev:StrView (string-as-view (addr-of o 'err))
              ds:(Vector Diagnostic) (try (read-diagnostics ev)))
          (try (check-error-anywhere (addr-of ds) needle))
          (drop (addr-of ds))
          (drop (addr-of o))))
      ((err e)
        (drop (addr-of c))
        (return (err e))))
    (drop (addr-of c))
    (return (ok))))

(defn check-source-rejects (src:StrView needle:StrView):!void
  (let (p:String (try (test-write-file "t.nuc" src)))
    (try (check-file-rejects "" (string-as-view (addr-of p)) needle))
    (drop (addr-of p))
    (return (ok))))

; Whether `src` compiles at all. A table of accept/reject spellings asks only
; this, and neither `check-source-rejects` nor `check-source-accepts` can carry
; the two halves of one row.
(defn source-compiles? (src:StrView):!bool
  (let (c:Compiled (try (compile-source src))
        ok?:bool (c 'ok?))
    (drop (addr-of c))
    (return (ok ok?))))

; Compiling `src` must SUCCEED, with no diagnostic at all.
(defn check-source-accepts (src:StrView):!void
  (let (r:Compiled (try (compile-source src)))
    (when (not (r 'ok?))
      (fail! "expected a clean compile\n     "
             (test-show (string-as-view (addr-of r 'raw)))))
    (try (check-empty (string-as-view (addr-of r 'raw))))
    (drop (addr-of r))
    (return (ok))))

; The IR of a source that must compile.
(defn source-ir (src:StrView):!String
  (let (r:Compiled (try (compile-source src)))
    (when (not (r 'ok?))
      (fail! "expected a clean compile\n     "
             (test-show (string-as-view (addr-of r 'raw)))))
    (let (iv:StrView (string-as-view (addr-of r 'ir))
          out:String (try (string-from-view (addr-of iv))))
      (drop (addr-of r))
      (return (ok out)))))

; Run a built binary. `command-search false` because the path is one this test
; just wrote, not a program name to find.
(defn run-stdout (bin:StrView):!String
  (let (rc:Command (command bin))
    (command-search (addr-of rc) false)
    (command-capture (addr-of rc) true)
    (command-stderr-to-stdout (addr-of rc) true)
    (match (run (addr-of rc))
      ((ok o)
        (let (ov:StrView (string-as-view (addr-of o 'out))
              out:String (try (string-from-view (addr-of ov))))
          (drop (addr-of o))
          (drop (addr-of rc))
          (return (ok out))))
      ((err e) (return (err e))))))

; The same run, when the program's answer is its exit status. Separate because
; a program deliberately kept to a handful of symbols cannot print: `print`
; would pull the whole io closure into an object whose symbol table is the
; assertion.
(defn run-exit (bin:StrView):!i32
  (let (rc:Command (command bin))
    (command-search (addr-of rc) false)
    (command-capture (addr-of rc) true)
    (command-stderr-to-stdout (addr-of rc) true)
    (match (run (addr-of rc))
      ((ok o)
        (let (st:ExitStatus (o 'status)
              got:i32 (exit-code (addr-of st)))
          (drop (addr-of o))
          (drop (addr-of rc))
          (return (ok got))))
      ((err e) (return (err e))))))

; Build `path` and run it; the assertion is its EXIT STATUS. The shape of
; `w1_run`, which several bespoke units use for a program whose answer is a
; number rather than output.
(defn check-file-exit (idir:StrView path:StrView want:i32):!void
  (let (dir:StrView (try (test-scratch))
        bin:String (str dir "/t.bin")
        bv:StrView (string-as-view (addr-of bin))
        cc:Command (command (compiler-path)))
    (when (not (= idir ""))
      (command-arg (addr-of cc) "-I")
      (command-arg (addr-of cc) idir))
    (command-arg (addr-of cc) path)
    (command-arg (addr-of cc) "-o")
    (command-arg (addr-of cc) bv)
    (command-capture (addr-of cc) true)
    (command-stderr-to-stdout (addr-of cc) true)
    (match (run (addr-of cc))
      ((ok o)
        (let (built:bool (success? (addr-of o 'status)))
          (when (not built)
            (fail! "compile/link error\n     "
                   (test-show (string-as-view (addr-of o 'out)))))
          (drop (addr-of o))))
      ((err e) (return (err e))))
    (drop (addr-of cc))
    (let (got:i32 (try (run-exit bv)))
      (when (!= got want)
        (fail! "expected exit " (as i64 want) ", got " (as i64 got))))
    (drop (addr-of bin))
    (return (ok))))

(defn check-source-exit (src:StrView want:i32):!void
  (let (p:String (try (test-write-file "t.nuc" src)))
    (try (check-file-exit "" (string-as-view (addr-of p)) want))
    (drop (addr-of p))
    (return (ok))))

; The generated C header for `src`, which must compile.
(defn source-cheader (src:StrView):!String
  (let (p:String (try (test-write-file "t.nuc" src))
        c:Command (command (compiler-path)))
    (command-arg (addr-of c) "--emit-cheader")
    (command-arg (addr-of c) (string-as-view (addr-of p)))
    (command-capture (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (let (built:bool (success? (addr-of o 'status)))
          (when (not built)
            (fail! "expected a header, got an error\n     "
                   (test-show (string-as-view (addr-of o 'err)))))
          (let (ov:StrView (string-as-view (addr-of o 'out))
                out:String (try (string-from-view (addr-of ov))))
            (drop (addr-of o))
            (drop (addr-of c))
            (drop (addr-of p))
            (return (ok out)))))
      ((err e)
        (drop (addr-of c))
        (return (err e))))))

; `nucleusc [-I dir] -c <path> -o <out>`: a translation unit for a real link.
(defn compile-object-in (dir:StrView path:StrView out:StrView):!void
  (let (c:Command (command (compiler-path)))
    (when (not (= dir ""))
      (command-arg (addr-of c) "-I")
      (command-arg (addr-of c) dir))
    (command-arg (addr-of c) "-c")
    (command-arg (addr-of c) path)
    (command-arg (addr-of c) "-o")
    (command-arg (addr-of c) out)
    (command-capture (addr-of c) true)
    (command-stderr-to-stdout (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (when (not (success? (addr-of o 'status)))
          (fail! "expected an object file\n     "
                 (test-show (string-as-view (addr-of o 'out)))))
        (drop (addr-of o)))
      ((err e)
        (drop (addr-of c))
        (return (err e))))
    (drop (addr-of c))
    (return (ok))))

(defn compile-object (path:StrView out:StrView):!void
  (return (compile-object-in "" path out)))

; Build the space-separated `parts` — `.c`, `.o` or `.ll`, clang takes any — and
; run the result; stdout is the answer. Separate compilation is the only thing
; that tests what a `.nuch` or a generated `.h` actually promised: the symbol has
; to be resolved by the LINKER, not by the compiler having seen the source.
;
; `-Wall -Werror` because "it parses" is not the claim a generated header has to
; meet; a real consumer builds clean or the header is broken.
(defn driver-link (drv:StrView idir:StrView parts:StrView):!String
  (let (dir:StrView (try (test-scratch))
        bin:String (str dir "/linked.bin")
        sp:StrView " "
        c:Command (command drv)
        it:SplitIter (strview-split (addr-of parts) (addr-of sp)))
    (command-arg (addr-of c) "-Wall")
    (command-arg (addr-of c) "-Werror")
    (when (not (= idir ""))
      (command-arg (addr-of c) "-I")
      (command-arg (addr-of c) idir))
    (while (not (split-iter-done (addr-of it)))
      (command-arg (addr-of c) (split-iter-next (addr-of it))))
    (command-arg (addr-of c) "-o")
    (command-arg (addr-of c) (string-as-view (addr-of bin)))
    (command-capture (addr-of c) true)
    (command-stderr-to-stdout (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (when (not (success? (addr-of o 'status)))
          (fail! "link error\n     " (test-show (string-as-view (addr-of o 'out)))))
        (drop (addr-of o)))
      ((err e) (return (err e))))
    (drop (addr-of c))
    (return (ok bin))))

(defn driver-link-run (drv:StrView idir:StrView parts:StrView):!String
  (let (bin:String (try (driver-link drv idir parts))
        out:String (try (run-stdout (string-as-view (addr-of bin)))))
    (drop (addr-of bin))
    (return (ok out))))

(defn cc-link-run (idir:StrView parts:StrView):!String
  (return (driver-link-run "clang" idir parts)))

; The same link, for a program whose answer is its exit status.
(defn cc-link-exit (parts:StrView):!i32
  (let (bin:String (try (driver-link "clang" "" parts))
        got:i32 (try (run-exit (string-as-view (addr-of bin)))))
    (drop (addr-of bin))
    (return (ok got))))

; The same consumer through the platform C++ driver. A generated header is
; routinely read from C++ behind `extern "C"`, where a name C tolerates can
; still be a keyword.
(defn cxx-link-run (idir:StrView parts:StrView):!String
  (return (driver-link-run "c++" idir parts)))

(defn link-run (parts:StrView):!String
  (return (cc-link-run "" parts)))

; `--emit-llvm` never reads back what it writes, so exiting 0 says nothing about
; whether the module is valid. `llvm-as` is the reader.
(defn check-ir-parses (ir:StrView):!void
  (let (p:String (try (test-write-file "parse-probe.ll" ir))
        c:Command (command "llvm-as"))
    (command-arg (addr-of c) (string-as-view (addr-of p)))
    (command-arg (addr-of c) "-o")
    (command-arg (addr-of c) "/dev/null")
    (command-capture (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (when (not (success? (addr-of o 'status)))
          (fail! "emitted IR does not parse\n     "
                 (test-show (string-as-view (addr-of o 'err)))))
        (drop (addr-of o)))
      ((err e)
        (drop (addr-of c))
        (return (err e))))
    (drop (addr-of c))
    (drop (addr-of p))
    (return (ok))))

; `opt -O2` over a module, as text. The only way to ask whether a function
; attribute changes what the optimizer actually does.
(defn opt-o2 (stem:StrView ir:StrView):!String
  (let (dir:StrView (try (test-scratch))
        nm:String (str stem ".ll")
        p:String (try (test-write-file (string-as-view (addr-of nm)) ir))
        out:String (str dir "/" stem ".opt.ll")
        c:Command (command "opt"))
    (command-arg (addr-of c) "-O2")
    (command-arg (addr-of c) "-S")
    (command-arg (addr-of c) (string-as-view (addr-of p)))
    (command-arg (addr-of c) "-o")
    (command-arg (addr-of c) (string-as-view (addr-of out)))
    (command-capture (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (when (not (success? (addr-of o 'status)))
          (fail! "opt -O2 rejected the emitted module\n     "
                 (test-show (string-as-view (addr-of o 'err)))))
        (drop (addr-of o)))
      ((err e)
        (drop (addr-of c))
        (return (err e))))
    (let (text:String (try (read-file (string-as-view (addr-of out)))))
      (drop (addr-of c))
      (drop (addr-of out))
      (drop (addr-of p))
      (drop (addr-of nm))
      (return (ok text)))))

; The global symbols `path` DEFINES, one per line. The independent witness a
; generated header needs: reading it cannot tell a correct `asm` label from one
; naming a symbol no object defines, and that is the whole risk of a label.
(defn nm-defined (path:StrView):!String
  (let (c:Command (command "nm"))
    (command-arg (addr-of c) "-g")
    (command-arg (addr-of c) "--defined-only")
    (command-arg (addr-of c) path)
    (command-capture (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (when (not (success? (addr-of o 'status)))
          (fail! "nm failed\n     " (test-show (string-as-view (addr-of o 'err)))))
        (let (ov:StrView (string-as-view (addr-of o 'out))
              nl:StrView "\n"
              out:String (string-new)
              it:SplitIter (strview-split (addr-of ov) (addr-of nl)))
          (while (not (split-iter-done (addr-of it)))
            (let (l:StrView (split-iter-next (addr-of it)))
              (match (strview-rfind-byte (addr-of l) 32)
                ((some at)
                  (str-into (addr-of out) (strview-drop-bytes l (+ at 1)) "\n"))
                (none 0))))
          (drop (addr-of o))
          (drop (addr-of c))
          (return (ok out))))
      ((err e)
        (drop (addr-of c))
        (return (err e))))))

; Every symbol in `path`, as `<type> <name>` lines. `nm-defined` cannot answer a
; separate-compilation question: it drops both the linkage letter, which is what
; says an imported definition is a COPY, and the undefined symbols, which are
; what says a call crossed the object boundary at all.
(defn nm-typed (path:StrView):!String
  (let (c:Command (command "nm"))
    (command-arg (addr-of c) path)
    (command-capture (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (when (not (success? (addr-of o 'status)))
          (fail! "nm failed\n     " (test-show (string-as-view (addr-of o 'err)))))
        (let (ov:StrView (string-as-view (addr-of o 'out))
              nl:StrView "\n"
              out:String (string-new)
              it:SplitIter (strview-split (addr-of ov) (addr-of nl)))
          (while (not (split-iter-done (addr-of it)))
            (let (l:StrView (split-iter-next (addr-of it)))
              (match (strview-rfind-byte (addr-of l) 32)
                ((some at)
                  ; `<value> <type> <name>`, and an undefined symbol pads the
                  ; value field with spaces — so the letter is the byte before
                  ; the last space, whichever form the line took.
                  (when (> at 0)
                    (str-into (addr-of out)
                              (strview-take-bytes (strview-drop-bytes l (- at 1)) 1)
                              " " (strview-drop-bytes l (+ at 1)) "\n")))
                (none 0))))
          (drop (addr-of o))
          (drop (addr-of c))
          (return (ok out))))
      ((err e)
        (drop (addr-of c))
        (return (err e))))))

; Every non-empty line of `want` must be a line of `got`, and the two must have
; the same number of them. Symbol names are unique within one object, so that is
; set equality — and order is not: `nm` sorts by value, and every symbol in a
; relocatable object has value 0.
(defn check-line-set (got:StrView want:StrView what:StrView):!void
  (let (ng:i64 0
        nw:i64 0
        gi:LineIter (strview-lines (addr-of got))
        wi:LineIter (strview-lines (addr-of want)))
    (while (not (lines-iter-done (addr-of gi)))
      (when (!= (lines-iter-next (addr-of gi)) "") (set! ng (+ ng 1))))
    (while (not (lines-iter-done (addr-of wi)))
      (let (l:StrView (lines-iter-next (addr-of wi)))
        (when (!= l "")
          (set! nw (+ nw 1))
          (when (not (has-line? got l))
            (fail! what ": missing " (sexp-quote l) "\n     got:\n" got)))))
    (when (!= ng nw)
      (fail! what ": expected " nw " line(s), got " ng "\n     got:\n" got)))
  (return (ok)))

; `test-write-file` only reaches the scratch directory itself, and a `.nuch`
; unit needs its header in a subdirectory of it — `resolve-import` tries `.nuc`
; in every search directory before any `.nuch`, so the source must sit outside.
(defn write-into (dir:StrView name:StrView content:StrView):!String
  (let (p:String (str dir "/" name)
        pv:StrView (string-as-view (addr-of p))
        f:File (try (file-create (addr-of pv))))
    (try (write-str (addr-of f) content))
    (try (file-close (addr-of f)))
    (return (ok p))))

; `nucleusc [-I idir] <flag> <src>`, written to `dir/name`. The artifact has to
; be a FILE for the next compile to import or the linker to read.
(defn emit-into (idir:StrView flag:StrView src:StrView dir:StrView
                 name:StrView):!String
  (let (t:String (try (emit-for-file idir flag src))
        p:String (try (write-into dir name (string-as-view (addr-of t)))))
    (drop (addr-of t))
    (return (ok p))))

; What clang made of a C file. `ok?` is false for a source clang refused —
; which is how a unit asks whether THIS clang's target has a type, since a
; version number does not say when each width arrived.
(defstruct CcIr ok?:bool ir:String err:String)

(extend CcIr Drop)
(defn drop ((self (ptr CcIr))):void
  (drop (addr-of self 'ir))
  (drop (addr-of self 'err)))

; clang's own IR for a C file — the oracle half of a unit that compares the two
; compilers. clang itself is not optional: `src/nucleusc.nuc` uses it as the
; default linker driver and the Makefile links with it, so a missing clang is a
; broken toolchain rather than a skip.
(defn cc-emit-llvm (path:StrView):!CcIr
  (let (c:Command (command "clang"))
    (command-arg (addr-of c) "-S")
    (command-arg (addr-of c) "-emit-llvm")
    (command-arg (addr-of c) "-O0")
    (command-arg (addr-of c) "-w")
    (command-arg (addr-of c) "-o")
    (command-arg (addr-of c) "-")
    (command-arg (addr-of c) path)
    (command-capture (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (let (ov:StrView (string-as-view (addr-of o 'out))
              ev:StrView (string-as-view (addr-of o 'err))
              r:&CcIr (alloca CcIr))
          (set! (r 'ok?) (success? (addr-of o 'status)))
          (set! (r 'ir) (try (string-from-view (addr-of ov))))
          (set! (r 'err) (try (string-from-view (addr-of ev))))
          (drop (addr-of o))
          (drop (addr-of c))
          (return (ok (deref r)))))
      ((err e)
        (drop (addr-of c))
        (return (err e))))))

; Whether clang accepted a C file, and what it said. For a `-fsyntax-only`
; oracle `ok?` is the whole verdict: the assertions are `_Static_assert`s in the
; file itself, so there is nothing left to compare.
(defstruct CcCheck ok?:bool err:String)

(extend CcCheck Drop)
(defn drop ((self (ptr CcCheck))):void
  (drop (addr-of self 'err)))

(defn cc-check-run ((c (ref Command))):!CcCheck
  (command-capture c true)
  (match (run c)
    ((ok o)
      (let (ev:StrView (string-as-view (addr-of o 'err))
            r:&CcCheck (alloca CcCheck))
        (set! (r 'ok?) (success? (addr-of o 'status)))
        (set! (r 'err) (try (string-from-view (addr-of ev))))
        (drop (addr-of o))
        (return (ok (deref r)))))
    ((err e) (return (err e)))))

; A complete compile-time `sizeof`/`offsetof` oracle for a machine this one
; cannot execute: `_Static_assert`s rule, so there is no sysroot, no link and
; no run.
(defn cc-syntax-only-for (target:StrView path:StrView):!CcCheck
  (let (flag:String (str "--target=" target)
        c:Command (command "clang"))
    (command-arg (addr-of c) (string-as-view (addr-of flag)))
    (command-arg (addr-of c) "-ffreestanding")
    (command-arg (addr-of c) "-fsyntax-only")
    (command-arg (addr-of c) path)
    (let (r:CcCheck (try (cc-check-run (addr-of c))))
      (drop (addr-of flag))
      (drop (addr-of c))
      (return (ok r)))))

; Does this C file parse against the headers in `idir`? The question a unit asks
; when the expected answer is NO — a link would report the same defect much
; later and with a worse message.
(defn cc-syntax-only-in (idir:StrView path:StrView):!CcCheck
  (let (c:Command (command "clang"))
    (command-arg (addr-of c) "-fsyntax-only")
    (when (not (= idir ""))
      (command-arg (addr-of c) "-I")
      (command-arg (addr-of c) idir))
    (command-arg (addr-of c) path)
    (let (r:CcCheck (try (cc-check-run (addr-of c))))
      (drop (addr-of c))
      (return (ok r)))))

; A C consumer of a generated header, compiled as strictly as a real one would
; be — which is the half of "the header is valid C" that reading it cannot say.
(defn cc-compile-strict (path:StrView):!CcCheck
  (let (c:Command (command "clang"))
    (command-arg (addr-of c) "-std=gnu11")
    (command-arg (addr-of c) "-Wall")
    (command-arg (addr-of c) "-Wextra")
    (command-arg (addr-of c) "-Werror")
    (command-arg (addr-of c) "-c")
    (command-arg (addr-of c) path)
    (command-arg (addr-of c) "-o")
    (command-arg (addr-of c) "/dev/null")
    (let (r:CcCheck (try (cc-check-run (addr-of c))))
      (drop (addr-of c))
      (return (ok r)))))

; Whether `name` is on PATH, asked by running it. clang is a hard dependency of
; this project and never skips; `cc` and `c++` are not, and it is `cc` an ABI
; oracle wants — the claim is agreement with the compiler the platform's own
; headers were written for.
(defn have-program? (name:StrView):bool
  (let (c:Command (command name))
    (command-arg (addr-of c) "--version")
    (command-capture (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (let (ok?:bool (success? (addr-of o 'status)))
          (drop (addr-of o))
          (drop (addr-of c))
          (return ok?)))
      ((err e)
        (drop (addr-of c))
        (return false)))))

(defn have-cc? ():bool
  (return (have-program? "cc")))

(defn have-cxx? ():bool
  (return (have-program? "c++")))

(defn require-cc ():!void
  (when (not (have-cc?)) (skip! "no cc to build the oracle against"))
  (return (ok)))

; Build a C program with `cc` and run it; stdout is the answer. The oracle half
; of a layout unit, whose claim is that the two compilers put the same bytes in
; the same places. An empty `idir` adds no `-I`.
(defn cc-run-file (idir:StrView path:StrView):!String
  (let (sdir:StrView (try (test-scratch))
        bin:String (str sdir "/c.bin")
        cc:Command (command "cc"))
    (command-arg (addr-of cc) "-w")
    (when (not (= idir ""))
      (command-arg (addr-of cc) "-I")
      (command-arg (addr-of cc) idir))
    (command-arg (addr-of cc) path)
    (command-arg (addr-of cc) "-o")
    (command-arg (addr-of cc) (string-as-view (addr-of bin)))
    (command-capture (addr-of cc) true)
    (command-stderr-to-stdout (addr-of cc) true)
    (match (run (addr-of cc))
      ((ok o)
        (let (built:bool (success? (addr-of o 'status)))
          (when (not built)
            (fail! "cc refused the oracle program\n     "
                   (test-show (string-as-view (addr-of o 'out)))))
          (drop (addr-of o))))
      ((err e) (return (err e))))
    (drop (addr-of cc))
    (let (out:String (try (run-stdout (string-as-view (addr-of bin)))))
      (drop (addr-of bin))
      (return (ok out)))))

; Compile `path` to a binary and run it, stdout and stderr on one stream. An
; empty `dir` adds no `-I`, and an empty `extra` no extra argument.
(defn build-run-file (dir:StrView extra:StrView path:StrView):!String
  (let (sdir:StrView (try (test-scratch))
        bin:String (str sdir "/t.bin")
        cc:Command (command (compiler-path)))
    (when (not (= dir ""))
      (command-arg (addr-of cc) "-I")
      (command-arg (addr-of cc) dir))
    (when (not (= extra "")) (command-arg (addr-of cc) extra))
    (command-arg (addr-of cc) path)
    (command-arg (addr-of cc) "-o")
    (command-arg (addr-of cc) (string-as-view (addr-of bin)))
    (command-capture (addr-of cc) true)
    (command-stderr-to-stdout (addr-of cc) true)
    (match (run (addr-of cc))
      ((ok o)
        (let (built:bool (success? (addr-of o 'status)))
          (when (not built)
            (fail! "compile error\n     "
                   (test-show (string-as-view (addr-of o 'out)))))
          (drop (addr-of o))))
      ((err e) (return (err e))))
    (drop (addr-of cc))
    (let (out:String (try (run-stdout (string-as-view (addr-of bin)))))
      (drop (addr-of bin))
      (return (ok out)))))

(defn build-run-source (src:StrView):!String
  (let (p:String (try (test-write-file "t.nuc" src))
        out:String (try (build-run-file "" "" (string-as-view (addr-of p)))))
    (drop (addr-of p))
    (return (ok out))))

; A REPL session: `text` is the child's stdin and the transcript is the answer.
(defn repl-session (text:StrView):!String
  (let (p:String (try (test-write-file "repl.in" text))
        c:Command (command (compiler-path)))
    (command-arg (addr-of c) "-i")
    (command-stdin-path (addr-of c) (string-as-view (addr-of p)))
    (command-capture (addr-of c) true)
    (command-stderr-to-stdout (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (let (ov:StrView (string-as-view (addr-of o 'out))
              out:String (try (string-from-view (addr-of ov))))
          (drop (addr-of o))
          (drop (addr-of c))
          (drop (addr-of p))
          (return (ok out))))
      ((err e)
        (drop (addr-of c))
        (return (err e))))))

; The first line of `hay` containing `needle`. A claim about ONE instruction
; cannot be made by searching the module: `i8 %` is in every module.
(defn line-with (hay:StrView needle:StrView):!StrView
  (let (it:LineIter (strview-lines (addr-of hay)))
    (while (not (lines-iter-done (addr-of it)))
      (let (l:StrView (lines-iter-next (addr-of it)))
        (when (contains? l needle) (return (ok l))))))
  (fail! "no line containing " (sexp-quote needle) "\n     in: " (test-show hay)))

; The prefix of `sv` before the first `b`, or all of it.
(defn view-upto-byte (sv:StrView b:ui8):StrView
  (match (strview-find-byte (addr-of sv) b)
    ((some i) (return (strview-take-bytes sv i)))
    (none (return sv))))

; How many lines of `hay` begin with `prefix`. A presence test cannot catch a
; DOUBLE emit, which is the way a re-drain goes wrong.
(defn count-lines-with-prefix (hay:StrView prefix:StrView):i64
  (let (n:i64 0
        it:LineIter (strview-lines (addr-of hay)))
    (while (not (lines-iter-done (addr-of it)))
      (when (strview-has-prefix (lines-iter-next (addr-of it)) prefix)
        (set! n (+ n 1))))
    (return n)))

; The `%Name` of an IR type-definition line, or "".
(defn type-line-name (l:StrView):StrView
  (let (m:StrView " = type")
    (when (not (strview-has-prefix l "%")) (return ""))
    (match (strview-find (addr-of l) (addr-of m))
      ((some at) (return (strview-take-bytes l at)))
      (none (return "")))))

; A top-level definition line: `%Name = type …`, `define …` or `declare …`.
(defn decl-line? (l:StrView):bool
  (when (strview-has-prefix l "define ") (return true))
  (when (strview-has-prefix l "declare ") (return true))
  (let (m:StrView " = type ")
    (return (and (strview-has-prefix l "%") (contains? l m)))))

(defn count-exact-lines (hay:StrView want:StrView):i64
  (let (n:i64 0
        it:LineIter (strview-lines (addr-of hay)))
    (while (not (lines-iter-done (addr-of it)))
      (when (= (lines-iter-next (addr-of it)) want) (set! n (+ n 1))))
    (return n)))

(defn check-decls-subsumed (a:StrView b:StrView):!void
  (let (it:LineIter (strview-lines (addr-of a)))
    (while (not (lines-iter-done (addr-of it)))
      (let (l:StrView (lines-iter-next (addr-of it)))
        (when (decl-line? l)
          (when (!= (count-exact-lines a l) (count-exact-lines b l))
            (fail! "the two modules' definition sets differ at "
                   (sexp-quote l)))))))
  (return (ok)))

; Two modules must carry the same top-level definitions, as a SET: position
; within the type section is order-dependent and inert, and the string pool
; renumbers, so the artifacts themselves cannot be compared.
(defn check-same-decl-set (a:StrView b:StrView):!void
  (try (check-decls-subsumed a b))
  (try (check-decls-subsumed b a))
  (return (ok)))

; A type defined twice, or "". LLVM refuses a duplicate `%X = type` outright, so
; this is about the emitter's own bookkeeping rather than about the module.
(defn duplicate-type-name (ir:StrView):StrView
  (let (outer:LineIter (strview-lines (addr-of ir)))
    (while (not (lines-iter-done (addr-of outer)))
      (let (nm:StrView (type-line-name (lines-iter-next (addr-of outer))))
        (when (not (= nm ""))
          (let (n:i64 0
                inner:LineIter (strview-lines (addr-of ir)))
            (while (not (lines-iter-done (addr-of inner)))
              (when (= (type-line-name (lines-iter-next (addr-of inner))) nm)
                (set! n (+ n 1))))
            (when (> n 1) (return nm))))))
    (return "")))

; The `@name` a `define` line names, or "". No lib module emits a quoted global,
; so the name is everything between the first `@` and the `(` after it.
(defn define-line-name (l:StrView):StrView
  (when (not (strview-has-prefix l "define ")) (return ""))
  (match (strview-find-byte (addr-of l) 64)
    ((some at)
      (let (rest:StrView (strview-drop-bytes l (+ at 1)))
        (match (strview-find-byte (addr-of rest) 40)
          ((some p) (return (strview-take-bytes rest p)))
          ((none) (return "")))))
    ((none) (return ""))))

; A function defined twice, or "". Unlike a duplicate type LLVM accepts this and
; the module still parses; the second definition simply wins, which is how a
; re-drain silently doubles a library's contents.
(defn duplicate-define-name (ir:StrView):StrView
  (let (names:(Vector StrView) (vector-new)
        it:LineIter (strview-lines (addr-of ir)))
    (while (not (lines-iter-done (addr-of it)))
      (let (nm:StrView (define-line-name (lines-iter-next (addr-of it))))
        (when (not (= nm "")) (conj (addr-of names) nm))))
    (let (n:usize (count (addr-of names))
          i:usize 0)
      (while (< i n)
        (let (a:StrView (invoke (addr-of names) i)
              j:usize (+ i 1))
          (while (< j n)
            (when (= (invoke (addr-of names) j) a)
              (drop (addr-of names))
              (return a))
            (set! j (+ j 1))))
        (set! i (+ i 1))))
    (drop (addr-of names))
    (return "")))

; ---------------------------------------------------------------------------
; A library, its generated header, and its object
; ---------------------------------------------------------------------------

; The object to link against and the header's text to read. Both artifacts sit
; in the test's own scratch directory, which is also where a C consumer gets
; written — a quoted `#include` resolves against the including file's own
; directory, so the header is reachable by BASE NAME and needs no path here.
(defstruct CLib obj:String text:String)

(extend CLib Drop)
(defn drop ((self (ptr CLib))):void
  (drop (addr-of self 'obj))
  (drop (addr-of self 'text)))

(defn c-lib-obj ((l (ref CLib))):StrView
  (return (string-as-view (addr-of l 'obj))))

(defn c-lib-text ((l (ref CLib))):StrView
  (return (string-as-view (addr-of l 'text))))

; Write `stem.nuc`, emit its header beside it, compile its object. The scratch
; directory is always on the include path, so a library that imports a sibling
; needs no second spelling.
(defn c-lib (stem:StrView src:StrView):!CLib
  (let (dir:StrView (try (test-scratch))
        nuc:String (str stem ".nuc")
        hdr:String (str stem ".h")
        obj:String (str dir "/" stem ".o")
        p:String (try (test-write-file (string-as-view (addr-of nuc)) src))
        hp:String (try (emit-into dir "--emit-cheader" (string-as-view (addr-of p))
                                  dir (string-as-view (addr-of hdr))))
        text:String (try (read-file (string-as-view (addr-of hp))))
        l:&CLib (alloca CLib))
    (try (compile-object-in dir (string-as-view (addr-of p))
                            (string-as-view (addr-of obj))))
    (set! (l 'obj) obj)
    (set! (l 'text) text)
    (drop (addr-of hp))
    (drop (addr-of p))
    (drop (addr-of nuc))
    (drop (addr-of hdr))
    (return (ok (deref l)))))

; Emit a header without compiling anything: what a unit wants when the claim is
; that a declaration was REFUSED, so there may be no symbol to link.
(defn c-header (stem:StrView src:StrView):!String
  (let (dir:StrView (try (test-scratch))
        nuc:String (str stem ".nuc")
        hdr:String (str stem ".h")
        p:String (try (test-write-file (string-as-view (addr-of nuc)) src))
        hp:String (try (emit-into dir "--emit-cheader" (string-as-view (addr-of p))
                                  dir (string-as-view (addr-of hdr))))
        text:String (try (read-file (string-as-view (addr-of hp)))))
    (drop (addr-of nuc))
    (drop (addr-of hdr))
    (drop (addr-of p))
    (drop (addr-of hp))
    (return (ok text))))

; Build `main-src` against the headers in the scratch directory, link it with
; `parts`, run it. The shape every end-to-end unit here is made of.
(defn c-consumer-run (main-src:StrView parts:StrView):!String
  (let (dir:StrView (try (test-scratch))
        p:String (try (test-write-file "main.c" main-src))
        all:String (str (string-as-view (addr-of p)) " " parts)
        out:String (try (cc-link-run dir (string-as-view (addr-of all)))))
    (drop (addr-of all))
    (drop (addr-of p))
    (return (ok out))))

(defn c-lib-run ((l (ref CLib)) main-src:StrView):!String
  (return (c-consumer-run main-src (c-lib-obj l))))

; What clang makes of a consumer it is only asked to parse — the form a unit
; needs when the expected answer is "it does not compile".
(defn c-consumer-syntax (idir:StrView main-src:StrView):!CcCheck
  (let (p:String (try (test-write-file "probe.c" main-src))
        r:CcCheck (try (cc-syntax-only-in idir (string-as-view (addr-of p)))))
    (drop (addr-of p))
    (return (ok r))))

; ---------------------------------------------------------------------------
; Category (a): the rejection/acceptance table
; ---------------------------------------------------------------------------

; Each `(message …)` must appear in the message of a diagnostic at the pinned
; location, and each `(note …)` in a note of a diagnostic there. That pairing is
; the whole upgrade: eight rows of this table asserted a location that was only
; ever on a NOTE, which two independent greps over one blob cannot tell apart.
(defn run-reject-row (row:raw:Node):!void
  (let (fixture:StrView (row-file row)
        line:i32 (row-line row)
        c:Compiled (try (compile-path fixture))
        ds:(Vector Diagnostic) (c 'diags))
    (when (= (count (addr-of ds)) 0)
      (fail! "compiling " fixture " produced no diagnostic"))
    ; With no pinned line the old shell unit only swept for a `:0:` substring.
    ; The record makes that a field.
    (when (< line 0) (try (check-no-line-zero (addr-of ds))))
    (let (cur:raw:Node (row 'cdr))
      (while (!= cur null)
        (let (e:raw:Node (cur 'car))
          (when (and (!= e null) (= (e 'kind) NODE-CELL))
            (let (k:StrView (row-text (e 'car))
                  v:StrView (row-text ((e 'cdr) 'car)))
              (when (= k "message")
                (if (< line 0)
                  (try (check-error-anywhere (addr-of ds) v))
                  (try (check-error-at (addr-of ds) fixture line v))))
              (when (= k "note")
                (if (< line 0)
                  (try (check-note-anywhere (addr-of ds) v))
                  (try (check-note-at (addr-of ds) fixture line v)))))))
        (set! cur (cur 'cdr))))
    (return (ok))))

(defn run-accept-row (row:raw:Node):!void
  (let (fixture:StrView (row-file row)
        c:Compiled (try (compile-path fixture))
        ds:(Vector Diagnostic) (c 'diags))
    (when (> (count (addr-of ds)) 0)
      (try (check-no-errors (addr-of ds))))
    ; A diagnostic-free compile is the claim, so anything on stderr is a failure
    ; -- including something the sexp reader skipped.
    (try (check-empty (string-as-view (addr-of c 'raw))))
    (return (ok))))

(defn run-manifest-row (data:ptr):!void
  (let (row:raw:Node (unsafe/cast raw:Node data))
    (when (= (row-head row) "accept") (return (run-accept-row row)))
    (return (run-reject-row row))))

; ---------------------------------------------------------------------------
; Category (b): golden output
; ---------------------------------------------------------------------------

; The base name a golden-output test was registered with. Carried as the
; interned symbol NODE for the same reason a manifest row is carried as one:
; `data` is a bare pointer, and an interned node outlives registration.
(defn data-name (data:ptr):StrView
  (return (symbol-as-view ((unsafe/cast raw:Node data) 's))))

(defn name-node (nm:StrView):raw:Node
  (return (as raw:Node (intern-node (symbol-intern nm)))))

; Compile, then run, comparing the program's own output against its golden file.
; Both captures merge stderr into stdout on ONE pipe: the golden file recorded
; `2>&1`, and two separately drained streams cannot reproduce an interleaving.
(defn run-example-test (data:ptr):!void
  ; The suite owns its output directory: `make test` clears it, and a test run
  ; on its own has no shell script to have made it.
  (try (make-dir "build/out"))
  (let (base:StrView (data-name data)
        src:String (str "examples/" base ".nuc")
        bin:String (str "build/out/" base)
        exp:String (str "tests/expected/" base ".out")
        cc:Command (command (compiler-path)))
    (command-arg (addr-of cc) (string-as-view (addr-of src)))
    (command-arg (addr-of cc) "-o")
    (command-arg (addr-of cc) (string-as-view (addr-of bin)))
    (command-capture (addr-of cc) true)
    (command-stderr-to-stdout (addr-of cc) true)
    (match (run (addr-of cc))
      ((ok o)
        (let (ok?:bool (success? (addr-of o 'status)))
          (when (not ok?)
            (fail! "compile error\n     " (test-show (string-as-view (addr-of o 'out)))))
          (drop (addr-of o))))
      ((err e) (return (err e))))
    (drop (addr-of cc))
    (let (rc:Command (command (string-as-view (addr-of bin))))
      ; An exact path, not a PATH lookup -- and the exit status is deliberately
      ; not asserted: an example that exits nonzero says so in its golden file.
      (command-search (addr-of rc) false)
      (command-capture (addr-of rc) true)
      (command-stderr-to-stdout (addr-of rc) true)
      (match (run (addr-of rc))
        ((ok o)
          (let (want:String (try (read-file (string-as-view (addr-of exp)))))
            (try (check-golden (string-as-view (addr-of o 'out))
                               (string-as-view (addr-of want))))
            (drop (addr-of want))
            (drop (addr-of o))))
        ((err e) (return (err e))))
      (drop (addr-of rc)))
    (drop (addr-of src))
    (drop (addr-of bin))
    (drop (addr-of exp))
    (return (ok))))

; A REPL session: the `.in` file is the child's stdin, and the transcript is
; compared whole.
(defn run-repl-test (data:ptr):!void
  (let (base:StrView (data-name data)
        src:String (str "tests/repl/" base ".in")
        exp:String (str "tests/expected/repl-" base ".out")
        c:Command (command (compiler-path)))
    (command-arg (addr-of c) "-i")
    (command-stdin-path (addr-of c) (string-as-view (addr-of src)))
    (command-capture (addr-of c) true)
    (command-stderr-to-stdout (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (let (want:String (try (read-file (string-as-view (addr-of exp)))))
          (try (check-golden (string-as-view (addr-of o 'out))
                             (string-as-view (addr-of want))))
          (drop (addr-of want))
          (drop (addr-of o))))
      ((err e) (return (err e))))
    (drop (addr-of c))
    (drop (addr-of src))
    (drop (addr-of exp))
    (return (ok))))

; ---------------------------------------------------------------------------
; Registration
; ---------------------------------------------------------------------------

; Present and readable. Asked by reading it, because there is no `stat` in
; `lib/file.nuc` and the file is small and about to be read anyway.
(defn have-file? (path:StrView):bool
  (match (read-file path)
    ((ok t) (let (s:String t) (drop (addr-of s)) (return true)))
    ((err e) (return false))))

; Discovered from the directory, not listed in a manifest: a new example is a
; new test with no edit anywhere, which is the property the shell glob had and
; the reason category (b) is not a table like category (a).
(defn register-golden (dir:StrView ext:StrView exp-prefix:StrView
                       name-prefix:StrView (f (fn !void) (ptr))):!void
  (let (d:DirEntries (try (read-dir dir))
        n:usize (dir-count (addr-of d))
        i:usize 0)
    (while (< i n)
      (let (nm:StrView (dir-name (addr-of d) i))
        (when (strview-has-suffix nm ext)
          (let (base:StrView (strview-take-bytes
                               nm (- (strview-byte-len (addr-of nm))
                                     (strview-byte-len (addr-of ext))))
                exp:String (str exp-prefix base ".out")
                tname:String (str name-prefix base))
            (when (have-file? (string-as-view (addr-of exp)))
              (test-add (string-as-view (addr-of tname)) dir 0 f
                        (as raw (name-node base))))
            (drop (addr-of exp))
            (drop (addr-of tname)))))
      (set! i (+ i 1)))
    (drop (addr-of d))
    (return (ok))))

(defn register-manifest ():!void
  (let (text:String (try (read-file (manifest-path)))
        forms:raw:Node (try (read-all (string-as-view (addr-of text))))
        cur:raw:Node forms)
    (while (!= cur null)
      (let (row:raw:Node (cur 'car))
        (when (and (!= row null) (= (row 'kind) NODE-CELL))
          (test-add (row-name row) (manifest-path) 0 run-manifest-row row)))
      (set! cur (cur 'cdr)))
    (return (ok))))

(defn register-all ():!void
  (try (register-manifest))
  (try (register-golden "examples" ".nuc" "tests/expected/" "" run-example-test))
  (try (register-golden "tests/repl" ".in" "tests/expected/repl-" "repl-" run-repl-test))
  (return (ok)))

(defn main (argc:i32 argv:ptr):int
  (match (register-all)
    (ok 0)
    ((err e)
      (eprint "nuctests: registration failed: " (err-message e) "\n")
      (return 2)))
  (return (as int (test-main argc argv))))

; Stage 18 TF-6 — the compiler's native test suite.
;
; Design: design/stage18-tooling/overview.md §T6.6.
;
; One binary, driven by `build/nuctest` the same way the shell suite is:
; `--list` names every test, `--run <name>` runs exactly one and prints its
; s-expression record. Each test is its own process, so isolation and order
; independence are properties of the architecture rather than promises.
;
; Category (a) is a TABLE (`tests/manifest/diagnostics.sexp`), not 168 hand
; written units: every row says the same thing about a different fixture, and
; the thing it says is now a comparison against one `Diagnostic` record rather
; than two greps over one stderr blob.

(import-use error)
(import-use strview)
(import-use string)
(import-use string-split)
(import-use fmt)
(import-use vector)
(import-use io)
(import-use file)
(import-use process)
(import-use node)
(import-use read)
(import-use test)
(import-use suite-s16)



(defn manifest-path ():StrView (return "tests/manifest/diagnostics.sexp"))
(defn compiler-path ():StrView (return "./build/nucleusc"))

; ---------------------------------------------------------------------------
; Reading a row
; ---------------------------------------------------------------------------

; The operands of the `(key …)` entry named `name`, or null. Rows are the same
; shape a diagnostic is, so they are read the same way.
(defn row-entry (row:raw:Node name:StrView):raw:Node
  (let (cur:raw:Node (row 'cdr))
    (while (!= cur null)
      (let (e:raw:Node (cur 'car))
        (when (and (!= e null) (= (e 'kind) NODE-CELL))
          (let (h:raw:Node (e 'car))
            (when (and (!= h null) (= (h 'kind) NODE-SYM)
                       (= (symbol-as-view (h 's)) name))
              (return (e 'cdr))))))
      (set! cur (cur 'cdr)))
    (return null)))

; A kind check, not a null check: `Node.s` is null on an INT or a FLOAT, and
; `symbol-as-view` of null is a segfault, not an empty view.
(defn row-text (n:raw:Node):StrView
  (when (= n null) (return ""))
  (let (k:i32 (n 'kind))
    (when (and (!= k NODE-SYM) (!= k NODE-STR) (!= k NODE-KEYWORD)) (return "")))
  (return (symbol-as-view (n 's))))

; A row's Nth positional operand, counting the head as 0.
(defn row-at (row:raw:Node i:i32):raw:Node
  (let (cur:raw:Node row
        k:i32 0)
    (while (!= cur null)
      (when (= k i) (return (cur 'car)))
      (set! k (+ k 1))
      (set! cur (cur 'cdr)))
    (return null)))

(defn row-head (row:raw:Node):StrView
  (return (row-text (row-at row 0))))

(defn row-name (row:raw:Node):StrView
  (return (row-text (row-at row 1))))

(defn row-file (row:raw:Node):StrView
  (return (row-text ((row-entry row "file") 'car))))

; The pinned line, or -1 when the row does not pin one.
(defn row-line (row:raw:Node):i32
  (let (e:raw:Node (row-entry row "line"))
    (when (= e null) (return -1))
    (return (unsafe/cast i32 ((e 'car) 'i)))))

; ---------------------------------------------------------------------------
; Running the compiler
; ---------------------------------------------------------------------------

; What one `nucleusc --emit-llvm` produced. One record because most units ask
; about more than one part of it, and asking twice means compiling twice.
;
; A `Diagnostic`'s views point at interned symbols, so `diags` stays valid after
; `raw` is dropped.
(defstruct Compiled
  ok?:bool
  ir:String
  raw:String
  diags:(Vector Diagnostic))

(extend Compiled Drop)
(defn drop ((self (ptr Compiled))):void
  (drop (addr-of self 'ir))
  (drop (addr-of self 'raw))
  (drop (addr-of self 'diags)))

(defn compile-path (path:StrView):!Compiled
  (let (c:Command (command (compiler-path)))
    (command-arg (addr-of c) "--diagnostics=sexp")
    (command-arg (addr-of c) "--emit-llvm")
    (command-arg (addr-of c) path)
    (command-capture (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (let (ov:StrView (string-as-view (addr-of o 'out))
              ev:StrView (string-as-view (addr-of o 'err))
              r:&Compiled (alloca Compiled))
          (set! (r 'ok?) (success? (addr-of o 'status)))
          (set! (r 'ir) (try (string-from-view (addr-of ov))))
          (set! (r 'raw) (try (string-from-view (addr-of ev))))
          (set! (r 'diags) (try (read-diagnostics ev)))
          (drop (addr-of o))
          (drop (addr-of c))
          (return (ok (deref r)))))
      ((err e)
        (drop (addr-of c))
        (return (err e))))))

; The same, for source written out of the test itself. Ruling 3 (§T8.3) admits
; both embedded and file fixtures; a unit that varies one line of a program is
; unreadable as a hundred files.
(defn compile-source (src:StrView):!Compiled
  (let (p:String (try (test-write-file "t.nuc" src))
        r:Compiled (try (compile-path (string-as-view (addr-of p)))))
    (drop (addr-of p))
    (return (ok r))))

; Compiling `src` must FAIL, and some error must carry `needle`.
(defn check-source-rejects (src:StrView needle:StrView):!void
  (let (r:Compiled (try (compile-source src)))
    (when (r 'ok?)
      (fail! "expected a rejection containing " (sexp-quote needle)
             ", but it compiled"))
    (try (check-error-anywhere (addr-of r 'diags) needle))
    (drop (addr-of r))
    (return (ok))))

; Compiling `src` must SUCCEED, with no diagnostic at all.
(defn check-source-accepts (src:StrView):!void
  (let (r:Compiled (try (compile-source src)))
    (when (not (r 'ok?))
      (fail! "expected a clean compile\n     "
             (test-show (string-as-view (addr-of r 'raw)))))
    (try (check-empty (string-as-view (addr-of r 'raw))))
    (drop (addr-of r))
    (return (ok))))

; The IR of a source that must compile.
(defn source-ir (src:StrView):!String
  (let (r:Compiled (try (compile-source src)))
    (when (not (r 'ok?))
      (fail! "expected a clean compile\n     "
             (test-show (string-as-view (addr-of r 'raw)))))
    (let (iv:StrView (string-as-view (addr-of r 'ir))
          out:String (try (string-from-view (addr-of iv))))
      (drop (addr-of r))
      (return (ok out)))))

; Compile `src` and run it; the assertion is its EXIT STATUS. The shape of
; `w1_run`, which several bespoke units use for a program whose answer is a
; number rather than output.
(defn check-source-exit (src:StrView want:i32):!void
  (let (p:String (try (test-write-file "t.nuc" src))
        dir:StrView (try (test-scratch))
        bin:String (str dir "/t.bin")
        cc:Command (command (compiler-path)))
    (command-arg (addr-of cc) (string-as-view (addr-of p)))
    (command-arg (addr-of cc) "-o")
    (command-arg (addr-of cc) (string-as-view (addr-of bin)))
    (command-capture (addr-of cc) true)
    (command-stderr-to-stdout (addr-of cc) true)
    (match (run (addr-of cc))
      ((ok o)
        (let (built:bool (success? (addr-of o 'status)))
          (when (not built)
            (fail! "compile/link error\n     "
                   (test-show (string-as-view (addr-of o 'out)))))
          (drop (addr-of o))))
      ((err e) (return (err e))))
    (drop (addr-of cc))
    (let (rc:Command (command (string-as-view (addr-of bin))))
      (command-search (addr-of rc) false)
      (command-capture (addr-of rc) true)
      (command-stderr-to-stdout (addr-of rc) true)
      (match (run (addr-of rc))
        ((ok o)
          (let (st:ExitStatus (o 'status)
                got:i32 (exit-code (addr-of st)))
            (when (!= got want)
              (fail! "expected exit " (as i64 want) ", got " (as i64 got)))
            (drop (addr-of o))))
        ((err e) (return (err e))))
      (drop (addr-of rc)))
    (drop (addr-of p))
    (drop (addr-of bin))
    (return (ok))))

; The generated C header for `src`, which must compile.
(defn source-cheader (src:StrView):!String
  (let (p:String (try (test-write-file "t.nuc" src))
        c:Command (command (compiler-path)))
    (command-arg (addr-of c) "--emit-cheader")
    (command-arg (addr-of c) (string-as-view (addr-of p)))
    (command-capture (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (let (built:bool (success? (addr-of o 'status)))
          (when (not built)
            (fail! "expected a header, got an error\n     "
                   (test-show (string-as-view (addr-of o 'err)))))
          (let (ov:StrView (string-as-view (addr-of o 'out))
                out:String (try (string-from-view (addr-of ov))))
            (drop (addr-of o))
            (drop (addr-of c))
            (drop (addr-of p))
            (return (ok out)))))
      ((err e)
        (drop (addr-of c))
        (return (err e))))))

; Compile `src` to a binary and run it, stdout and stderr on one stream.
(defn build-run-source (src:StrView):!String
  (let (p:String (try (test-write-file "t.nuc" src))
        dir:StrView (try (test-scratch))
        bin:String (str dir "/t.bin")
        cc:Command (command (compiler-path)))
    (command-arg (addr-of cc) (string-as-view (addr-of p)))
    (command-arg (addr-of cc) "-o")
    (command-arg (addr-of cc) (string-as-view (addr-of bin)))
    (command-capture (addr-of cc) true)
    (command-stderr-to-stdout (addr-of cc) true)
    (match (run (addr-of cc))
      ((ok o)
        (let (built:bool (success? (addr-of o 'status)))
          (when (not built)
            (fail! "compile error\n     "
                   (test-show (string-as-view (addr-of o 'out)))))
          (drop (addr-of o))))
      ((err e) (return (err e))))
    (drop (addr-of cc))
    (let (rc:Command (command (string-as-view (addr-of bin))))
      (command-search (addr-of rc) false)
      (command-capture (addr-of rc) true)
      (command-stderr-to-stdout (addr-of rc) true)
      (match (run (addr-of rc))
        ((ok o)
          (let (ov:StrView (string-as-view (addr-of o 'out))
                out:String (try (string-from-view (addr-of ov))))
            (drop (addr-of o))
            (drop (addr-of rc))
            (drop (addr-of p))
            (drop (addr-of bin))
            (return (ok out))))
        ((err e) (return (err e)))))))

; ---------------------------------------------------------------------------
; Category (a): the rejection/acceptance table
; ---------------------------------------------------------------------------

; Each `(message …)` must appear in the message of a diagnostic at the pinned
; location, and each `(note …)` in a note of a diagnostic there. That pairing is
; the whole upgrade: eight rows of this table asserted a location that was only
; ever on a NOTE, which two independent greps over one blob cannot tell apart.
(defn run-reject-row (row:raw:Node):!void
  (let (fixture:StrView (row-file row)
        line:i32 (row-line row)
        c:Compiled (try (compile-path fixture))
        ds:(Vector Diagnostic) (c 'diags))
    (when (= (count (addr-of ds)) 0)
      (fail! "compiling " fixture " produced no diagnostic"))
    ; With no pinned line the old shell unit only swept for a `:0:` substring.
    ; The record makes that a field.
    (when (< line 0) (try (check-no-line-zero (addr-of ds))))
    (let (cur:raw:Node (row 'cdr))
      (while (!= cur null)
        (let (e:raw:Node (cur 'car))
          (when (and (!= e null) (= (e 'kind) NODE-CELL))
            (let (k:StrView (row-text (e 'car))
                  v:StrView (row-text ((e 'cdr) 'car)))
              (when (= k "message")
                (if (< line 0)
                  (try (check-error-anywhere (addr-of ds) v))
                  (try (check-error-at (addr-of ds) fixture line v))))
              (when (= k "note")
                (if (< line 0)
                  (try (check-note-anywhere (addr-of ds) v))
                  (try (check-note-at (addr-of ds) fixture line v)))))))
        (set! cur (cur 'cdr))))
    (return (ok))))

(defn run-accept-row (row:raw:Node):!void
  (let (fixture:StrView (row-file row)
        c:Compiled (try (compile-path fixture))
        ds:(Vector Diagnostic) (c 'diags))
    (when (> (count (addr-of ds)) 0)
      (try (check-no-errors (addr-of ds))))
    ; A diagnostic-free compile is the claim, so anything on stderr is a failure
    ; -- including something the sexp reader skipped.
    (try (check-empty (string-as-view (addr-of c 'raw))))
    (return (ok))))

(defn run-manifest-row (data:ptr):!void
  (let (row:raw:Node (unsafe/cast raw:Node data))
    (when (= (row-head row) "accept") (return (run-accept-row row)))
    (return (run-reject-row row))))

; ---------------------------------------------------------------------------
; Category (b): golden output
; ---------------------------------------------------------------------------

; The base name a golden-output test was registered with. Carried as the
; interned symbol NODE for the same reason a manifest row is carried as one:
; `data` is a bare pointer, and an interned node outlives registration.
(defn data-name (data:ptr):StrView
  (return (symbol-as-view ((unsafe/cast raw:Node data) 's))))

(defn name-node (nm:StrView):raw:Node
  (return (as raw:Node (intern-node (symbol-intern nm)))))

; Compile, then run, comparing the program's own output against its golden file.
; Both captures merge stderr into stdout on ONE pipe: the golden file recorded
; `2>&1`, and two separately drained streams cannot reproduce an interleaving.
(defn run-example-test (data:ptr):!void
  ; The suite owns its output directory: `make test` clears it, and a test run
  ; on its own has no shell script to have made it.
  (try (make-dir "build/out"))
  (let (base:StrView (data-name data)
        src:String (str "examples/" base ".nuc")
        bin:String (str "build/out/" base)
        exp:String (str "tests/expected/" base ".out")
        cc:Command (command (compiler-path)))
    (command-arg (addr-of cc) (string-as-view (addr-of src)))
    (command-arg (addr-of cc) "-o")
    (command-arg (addr-of cc) (string-as-view (addr-of bin)))
    (command-capture (addr-of cc) true)
    (command-stderr-to-stdout (addr-of cc) true)
    (match (run (addr-of cc))
      ((ok o)
        (let (ok?:bool (success? (addr-of o 'status)))
          (when (not ok?)
            (fail! "compile error\n     " (test-show (string-as-view (addr-of o 'out)))))
          (drop (addr-of o))))
      ((err e) (return (err e))))
    (drop (addr-of cc))
    (let (rc:Command (command (string-as-view (addr-of bin))))
      ; An exact path, not a PATH lookup -- and the exit status is deliberately
      ; not asserted: an example that exits nonzero says so in its golden file.
      (command-search (addr-of rc) false)
      (command-capture (addr-of rc) true)
      (command-stderr-to-stdout (addr-of rc) true)
      (match (run (addr-of rc))
        ((ok o)
          (let (want:String (try (read-file (string-as-view (addr-of exp)))))
            (try (check-golden (string-as-view (addr-of o 'out))
                               (string-as-view (addr-of want))))
            (drop (addr-of want))
            (drop (addr-of o))))
        ((err e) (return (err e))))
      (drop (addr-of rc)))
    (drop (addr-of src))
    (drop (addr-of bin))
    (drop (addr-of exp))
    (return (ok))))

; A REPL session: the `.in` file is the child's stdin, and the transcript is
; compared whole.
(defn run-repl-test (data:ptr):!void
  (let (base:StrView (data-name data)
        src:String (str "tests/repl/" base ".in")
        exp:String (str "tests/expected/repl-" base ".out")
        c:Command (command (compiler-path)))
    (command-arg (addr-of c) "-i")
    (command-stdin-path (addr-of c) (string-as-view (addr-of src)))
    (command-capture (addr-of c) true)
    (command-stderr-to-stdout (addr-of c) true)
    (match (run (addr-of c))
      ((ok o)
        (let (want:String (try (read-file (string-as-view (addr-of exp)))))
          (try (check-golden (string-as-view (addr-of o 'out))
                             (string-as-view (addr-of want))))
          (drop (addr-of want))
          (drop (addr-of o))))
      ((err e) (return (err e))))
    (drop (addr-of c))
    (drop (addr-of src))
    (drop (addr-of exp))
    (return (ok))))

; ---------------------------------------------------------------------------
; Registration
; ---------------------------------------------------------------------------

; Present and readable. Asked by reading it, because there is no `stat` in
; `lib/file.nuc` and the file is small and about to be read anyway.
(defn have-file? (path:StrView):bool
  (match (read-file path)
    ((ok t) (let (s:String t) (drop (addr-of s)) (return true)))
    ((err e) (return false))))

; Discovered from the directory, not listed in a manifest: a new example is a
; new test with no edit anywhere, which is the property the shell glob had and
; the reason category (b) is not a table like category (a).
(defn register-golden (dir:StrView ext:StrView exp-prefix:StrView
                       name-prefix:StrView (f (fn !void) (ptr))):!void
  (let (d:DirEntries (try (read-dir dir))
        n:usize (dir-count (addr-of d))
        i:usize 0)
    (while (< i n)
      (let (nm:StrView (dir-name (addr-of d) i))
        (when (strview-has-suffix nm ext)
          (let (base:StrView (strview-take-bytes
                               nm (- (strview-byte-len (addr-of nm))
                                     (strview-byte-len (addr-of ext))))
                exp:String (str exp-prefix base ".out")
                tname:String (str name-prefix base))
            (when (have-file? (string-as-view (addr-of exp)))
              (test-add (string-as-view (addr-of tname)) dir 0 f
                        (as raw (name-node base))))
            (drop (addr-of exp))
            (drop (addr-of tname)))))
      (set! i (+ i 1)))
    (drop (addr-of d))
    (return (ok))))

(defn register-manifest ():!void
  (let (text:String (try (read-file (manifest-path)))
        forms:raw:Node (try (read-all (string-as-view (addr-of text))))
        cur:raw:Node forms)
    (while (!= cur null)
      (let (row:raw:Node (cur 'car))
        (when (and (!= row null) (= (row 'kind) NODE-CELL))
          (test-add (row-name row) (manifest-path) 0 run-manifest-row row)))
      (set! cur (cur 'cdr)))
    (return (ok))))

(defn register-all ():!void
  (try (register-manifest))
  (try (register-golden "examples" ".nuc" "tests/expected/" "" run-example-test))
  (try (register-golden "tests/repl" ".in" "tests/expected/repl-" "repl-" run-repl-test))
  (return (ok)))

(defn main (argc:i32 argv:ptr):int
  (match (register-all)
    (ok 0)
    ((err e)
      (eprint "nuctests: registration failed: " (err-message e) "\n")
      (return 2)))
  (return (as int (test-main argc argv))))

; Stage 18 TF-6 category (c) — what the compiler makes of a real C header:
; opaque members, array extents, decay, function attributes and typedef names.
;
; Design: design/stage18-tooling/overview.md §T6.6, and the L1-L5 items in
; design/stage15-libc/overview.md.
;
; The family shares one claim, which is why it ports as one batch: importing a C
; header must either produce the layout C produces or fail SAFELY. The pre-L1
; behaviour was a silently wrong layout that compiled, linked and ran, so every
; unit here pins either the exact emitted type — never a size alone, since a
; size-only oracle passes a struct whose every offset after the first is wrong —
; or a located refusal.
;
; The IR sweep over the tree's own modules is structurally blind here: the whole
; tree imports six C headers, between them exposing 14 of the 65 comparable
; struct types the §1.5 survey measured, so a change that broke signal.h,
; pthread.h or netinet/in.h outright would sweep clean. Every unit below
; therefore imports headers, or fixtures, the tree does not.

; ---------------------------------------------------------------------------
; Probing an imported header
; ---------------------------------------------------------------------------

; `(sizeof NAME)` over an imported header. The member position is what L1 added,
; and `sizeof` on an opaque type is fatal, so a table gets one row per compile.
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use nucleus.test)
(import-use nucleus.string-split)
(import-use nucleus.strview)
(defn sizeof-probe (header:StrView name:StrView):String
  (return (str "(import-use \"stdio.h\")\n(import-use \"" header "\")\n"
               "(defn main ():i32 (printf \"%ld\\n\" (sizeof " name ")) (return 0))\n")))

; A row of the opaque table: refused, with an error naming the header and the
; line the struct is declared on, and no LLVM layout for it anywhere. The
; located half is the point — the defect this replaced was silent.
(defn check-opaque-at (header:StrView name:StrView line:StrView):!void
  (let (src:String (sizeof-probe header name)
        sv:StrView (string-as-view &src)
        c:Compiled (try (compile-source sv))
        want:String (str "'" name "' is an opaque type declared at ./" header
                         ":" line "; only pointers to it are valid")
        tl:String (str "%" name " = type"))
    (when (c 'ok?) (fail! name " was accepted, but it is opaque"))
    (try (check-error-anywhere (ref c 'diags) (string-as-view &want)))
    (try (check-not-contains (compiled-ir &c) (string-as-view &tl)))
    (drop &tl)
    (drop &want)
    (drop &c)
    (drop &src)
    (return (ok))))

; ---------------------------------------------------------------------------
; L1: a member whose type cannot be represented makes the struct opaque
;
; Not `ptr`. The point is that failure is SAFE — a located error and no
; `%X = type` line — because the pre-L1 behaviour was a silently wrong layout.
; ---------------------------------------------------------------------------

(defn l1-header ():StrView (return "tests/fixtures/l1-members.h"))

; Each of the five raise sites in `c-parse-type`, driven through a struct MEMBER,
; must name this fixture and the enclosing struct's own line.
(deftest l1-member-opaque
  (try (check-opaque-at (l1-header) "l1_m_wide_int" "27"))
  (try (check-opaque-at (l1-header) "l1_m_unrep_typedef" "33"))
  (try (check-opaque-at (l1-header) "l1_m_opaque_tag" "37"))
  (try (check-opaque-at (l1-header) "l1_m_unknown_tag" "40"))
  (try (check-opaque-at (l1-header) "l1_m_bad_body" "46"))
  (return (ok)))

; Every one of the five used ONLY behind a pointer.
(defn l1-safe-src ():StrView
  (return "(import-use \"stdio.h\")
(import-use \"tests/fixtures/l1-members.h\")
(defn t1 (p:&l1_m_wide_int):i32 (return 0))
(defn t2 (p:&l1_m_unrep_typedef):i32 (return 0))
(defn t3 (p:&l1_m_opaque_tag):i32 (return 0))
(defn t4 (p:&l1_m_unknown_tag):i32 (return 0))
(defn t5 (p:&l1_m_bad_body):i32 (return 0))
(defn main ():i32 (return 0))
"))

; Silent, no layout for any of the five, and an opaque type behind a pointer
; stays usable — the "fails safe, not unusable" half, and the reason `ptr:FILE`
; still works.
(deftest l1-member-fails-safe
  (let (c:Compiled (try (compile-source (l1-safe-src)))
        ir:StrView (compiled-ir &c))
    (try (check-no-errors (ref c 'diags)))
    (try (check-not-contains ir "%l1_m_wide_int = type"))
    (try (check-not-contains ir "%l1_m_unrep_typedef = type"))
    (try (check-not-contains ir "%l1_m_opaque_tag = type"))
    (try (check-not-contains ir "%l1_m_unknown_tag = type"))
    (try (check-not-contains ir "%l1_m_bad_body = type"))
    (try (check-contains ir "define i32 @t1(ptr "))
    (try (check-contains ir "define i32 @t2(ptr "))
    (try (check-contains ir "define i32 @t3(ptr "))
    (try (check-contains ir "define i32 @t4(ptr "))
    (try (check-contains ir "define i32 @t5(ptr "))
    (try (check-ir-parses ir))
    (drop &c)
    (return (ok))))

; The positive controls, so a future "fix" cannot pass the two above by making
; every C struct opaque. `l1_ok_hidden_array` was the row measured as the
; SILENT-wrong case: L2 gave `c-typedef-record` a real `(array T N)` to store, so
; it is representable now and must carry the extent.
(deftest l1-member-controls
  (let (c:Compiled (try (compile-source (l1-safe-src)))
        ir:StrView (compiled-ir &c))
    (try (check-line ir "%l1_ok_plain = type { i32, i32 }"))
    (try (check-line ir "%l1_ok_hidden_array = type { [4 x i32], i32 }"))
    (drop &c)
    (return (ok))))

; ---------------------------------------------------------------------------
; L2: the array-extent matrix
;
; `tests/fixtures/l2-arrays.h` states the expected layout for every row. The
; exact `%X = type` line and `(sizeof X)` are asserted against it, and the sizes
; cross-checked against cc compiled from the SAME header — asserting the emitted
; layout rather than the exit code is the whole point of the gate.
; ---------------------------------------------------------------------------

(defn l2-matrix-src ():StrView
  (return "(import-use \"stdio.h\")
(import-use \"tests/fixtures/l2-arrays.h\")
(defn main ():i32
  (printf \"l2_lit %lld\\n\" (as i64 (sizeof l2_lit)))
  (printf \"l2_multi %lld\\n\" (as i64 (sizeof l2_multi)))
  (printf \"l2_macro %lld\\n\" (as i64 (sizeof l2_macro)))
  (printf \"l2_sizeof %lld\\n\" (as i64 (sizeof l2_sizeof)))
  (printf \"l2_shift %lld\\n\" (as i64 (sizeof l2_shift)))
  (printf \"l2_chararr %lld\\n\" (as i64 (sizeof l2_chararr)))
  (return 0))
"))

; The exact type line for every foldable row. `int`/`short`/`char` throughout,
; so these hold on any target with a 4-byte int.
(deftest l2-layout-types
  (let (c:Compiled (try (compile-source (l2-matrix-src)))
        ir:StrView (compiled-ir &c))
    (try (check-no-errors (ref c 'diags)))
    (try (check-line ir "%l2_lit = type { [4 x i32], i32 }"))
    (try (check-line ir "%l2_multi = type { [2 x [3 x i32]], i32 }"))
    (try (check-line ir "%l2_macro = type { [6 x i8], i32 }"))
    (try (check-line ir "%l2_sizeof = type { [24 x i8], i32 }"))
    (try (check-line ir "%l2_shift = type { [8 x i8], i16 }"))
    (try (check-line ir "%l2_chararr = type { i16, [14 x i8] }"))
    (try (check-ir-parses ir))
    (drop &c)
    (return (ok))))

; `sizeof` against the values the fixture states, and against cc built from the
; same header — so the numbers are checked and not merely restated.
(deftest l2-layout-sizeof
  (try (require-cc))
  (let (got:String (try (build-run-source (l2-matrix-src))))
    (try (check-golden (string-as-view &got)
"l2_lit 20
l2_multi 28
l2_macro 12
l2_sizeof 28
l2_shift 10
l2_chararr 16
"))
    (drop &got))
  (try (check-agrees-with-cc "l2m" "." (l2-matrix-src)
"#include <stdio.h>
#include \"tests/fixtures/l2-arrays.h\"
int main(void){
  printf(\"l2_lit %zu\\n\", sizeof(struct l2_lit));
  printf(\"l2_multi %zu\\n\", sizeof(struct l2_multi));
  printf(\"l2_macro %zu\\n\", sizeof(struct l2_macro));
  printf(\"l2_sizeof %zu\\n\", sizeof(struct l2_sizeof));
  printf(\"l2_shift %zu\\n\", sizeof(struct l2_shift));
  printf(\"l2_chararr %zu\\n\", sizeof(struct l2_chararr));
  return 0;
}
"))
  (return (ok)))

; An extent the evaluator cannot fold abandons the struct and leaves the name
; opaque, rather than guessing a count. Two shapes: a name (an enum constant —
; the evaluator resolves no names) and a zero extent. `[]` used to be a third;
; Stage 16 C1a made it a flexible array member, checked positively below.
(deftest l2-layout-unfoldable
  (try (check-opaque-at "tests/fixtures/l2-arrays.h" "l2_unfoldable_enum" "56"))
  (try (check-opaque-at "tests/fixtures/l2-arrays.h" "l2_unfoldable_zero" "62"))
  (return (ok)))

; Stage 16 C1a: `int f[];` is C99's flexible array member — a trailing member
; contributing no bytes. It must lay out, size like cc's, and print `[0 x …]`
; rather than reuse the prescan's provisional 0.
(deftest l2-layout-flex-array
  (try (require-cc))
  (let (src:StrView "(import-use \"stdio.h\")
(import-use \"tests/fixtures/l2-arrays.h\")
(defn main ():i32 (printf \"%ld\\n\" (sizeof l2_unfoldable_flex)) (return 0))
"
        c:Compiled (try (compile-source src)))
    (try (check-line (compiled-ir &c)
                     "%l2_unfoldable_flex = type { i32, [0 x i32] }"))
    (drop &c)
    (try (check-agrees-with-cc "l2fx" "." src
"#include <stdio.h>
#include \"tests/fixtures/l2-arrays.h\"
int main(void){ printf(\"%zu\\n\", sizeof(struct l2_unfoldable_flex)); return 0; }
")))
  (return (ok)))

; ---------------------------------------------------------------------------
; L2: the libc survey
;
; The roster of real libc types the §1.5 table names, against a C program built
; in the same run — never against a hardcoded number, which is glibc-version-
; and target-dependent and becomes a false failure on the first musl or 32-bit
; run. Field OFFSETS and ALIGNMENT, not just `sizeof`: L1 measured
; `SDL_HapticConstant` at 40 bytes under both compilers while every offset after
; the first was wrong, and a size-only oracle calls that agreement.
; ---------------------------------------------------------------------------

(defn libc-c-src ():StrView
  (return "#include <stddef.h>
#include <stdio.h>
#include <setjmp.h>
#include <time.h>
#include <sys/stat.h>
#include <dirent.h>
#include <termios.h>
#include <sys/select.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <signal.h>
#include <pthread.h>
/* Referenced so a libc that does not spell these fails the ORACLE build and the
   unit SKIPs, rather than the Nucleus side failing alone against a libc whose
   types simply have other names. */
static const size_t glibc_spellings[] = { sizeof(struct __jmp_buf_tag), sizeof(__sigset_t) };
int main(void){
  (void)glibc_spellings;
  printf(\"__jmp_buf_tag size=%zu align=%zu __jmpbuf=%zu __mask_was_saved=%zu __saved_mask=%zu\\n\",
    sizeof(struct __jmp_buf_tag), _Alignof(struct __jmp_buf_tag),
    offsetof(struct __jmp_buf_tag, __jmpbuf), offsetof(struct __jmp_buf_tag, __mask_was_saved),
    offsetof(struct __jmp_buf_tag, __saved_mask));
  printf(\"timespec size=%zu align=%zu tv_sec=%zu tv_nsec=%zu\\n\",
    sizeof(struct timespec), _Alignof(struct timespec),
    offsetof(struct timespec, tv_sec), offsetof(struct timespec, tv_nsec));
  printf(\"itimerspec size=%zu align=%zu it_interval=%zu it_value=%zu\\n\",
    sizeof(struct itimerspec), _Alignof(struct itimerspec),
    offsetof(struct itimerspec, it_interval), offsetof(struct itimerspec, it_value));
  printf(\"stat size=%zu align=%zu st_dev=%zu st_ino=%zu st_mode=%zu st_uid=%zu st_size=%zu st_mtim=%zu\\n\",
    sizeof(struct stat), _Alignof(struct stat),
    offsetof(struct stat, st_dev), offsetof(struct stat, st_ino), offsetof(struct stat, st_mode),
    offsetof(struct stat, st_uid), offsetof(struct stat, st_size), offsetof(struct stat, st_mtim));
  printf(\"dirent size=%zu align=%zu d_ino=%zu d_off=%zu d_reclen=%zu d_type=%zu d_name=%zu\\n\",
    sizeof(struct dirent), _Alignof(struct dirent),
    offsetof(struct dirent, d_ino), offsetof(struct dirent, d_off), offsetof(struct dirent, d_reclen),
    offsetof(struct dirent, d_type), offsetof(struct dirent, d_name));
  printf(\"termios size=%zu align=%zu c_iflag=%zu c_oflag=%zu c_cflag=%zu c_lflag=%zu c_line=%zu c_cc=%zu c_ispeed=%zu c_ospeed=%zu\\n\",
    sizeof(struct termios), _Alignof(struct termios),
    offsetof(struct termios, c_iflag), offsetof(struct termios, c_oflag), offsetof(struct termios, c_cflag),
    offsetof(struct termios, c_lflag), offsetof(struct termios, c_line), offsetof(struct termios, c_cc),
    offsetof(struct termios, c_ispeed), offsetof(struct termios, c_ospeed));
  printf(\"fd_set size=%zu align=%zu\\n\", sizeof(fd_set), _Alignof(fd_set));
  printf(\"sockaddr size=%zu align=%zu sa_family=%zu sa_data=%zu\\n\",
    sizeof(struct sockaddr), _Alignof(struct sockaddr),
    offsetof(struct sockaddr, sa_family), offsetof(struct sockaddr, sa_data));
  printf(\"in6_addr size=%zu align=%zu __in6_u=%zu\\n\",
    sizeof(struct in6_addr), _Alignof(struct in6_addr), offsetof(struct in6_addr, __in6_u));
  printf(\"sigset_t size=%zu align=%zu\\n\", sizeof(sigset_t), _Alignof(sigset_t));
  printf(\"pthread_mutex_t size=%zu align=%zu\\n\", sizeof(pthread_mutex_t), _Alignof(pthread_mutex_t));
  /* Stage 16 FP-4: both were opaque until the importer built a real type for
     their inline function-pointer members. */
  printf(\"sigaction size=%zu align=%zu sa_mask=%zu sa_flags=%zu sa_restorer=%zu\\n\",
    sizeof(struct sigaction), _Alignof(struct sigaction),
    offsetof(struct sigaction, sa_mask), offsetof(struct sigaction, sa_flags),
    offsetof(struct sigaction, sa_restorer));
  printf(\"sigevent_t size=%zu align=%zu sigev_signo=%zu sigev_notify=%zu\\n\",
    sizeof(sigevent_t), _Alignof(sigevent_t),
    offsetof(sigevent_t, sigev_signo), offsetof(sigevent_t, sigev_notify));
  return 0;
}
"))

; Alignment is read off a probe struct: Nucleus has no `alignof`, and
; `offsetof(struct {i8; T;}, v)` IS the alignment.
;
; `sigset_t` is `typedef __sigset_t sigset_t;`, a typedef of a typedef, and its
; probe names `__sigset_t`: the L5 typedef table is consulted in value positions
; but a `defstruct` FIELD type is resolved by the prescan, where every C struct
; is still opaque, so `v:sigset_t` there is refused. The size below is still
; `(sizeof sigset_t)` — the subject under test.
;
; Two literals because the reader caps one at 4095 bytes and the whole program
; is 4490; the seam is the declarations/`main` boundary.
(defn libc-nuc-decls ():StrView
  (return "(import-use \"stdio.h\")
(import-use \"setjmp.h\")
(import-use \"time.h\")
(import-use \"sys/stat.h\")
(import-use \"dirent.h\")
(import-use \"termios.h\")
(import-use \"sys/select.h\")
(import-use \"sys/socket.h\")
(import-use \"netinet/in.h\")
(import-use \"signal.h\")
(import-use \"pthread.h\")

(defstruct AP1 pad:i8 v:__jmp_buf_tag)
(defstruct AP2 pad:i8 v:timespec)
(defstruct AP3 pad:i8 v:itimerspec)
(defstruct AP4 pad:i8 v:stat)
(defstruct AP5 pad:i8 v:dirent)
(defstruct AP6 pad:i8 v:termios)
(defstruct AP7 pad:i8 v:fd_set)
(defstruct AP8 pad:i8 v:sockaddr)
(defstruct AP9 pad:i8 v:in6_addr)
(defstruct AP10 pad:i8 v:__sigset_t)
(defstruct AP11 pad:i8 v:pthread_mutex_t)
(defstruct AP12 pad:i8 v:sigaction)
(defstruct AP13 pad:i8 v:sigevent_t)

(defn off (base:ptr fld:ptr):i64 (return (- (unsafe/cast i64 fld) (unsafe/cast i64 base))))
"))

(defn libc-nuc-main ():StrView
  (return "
(defn main ():i32
  (let (s:&__jmp_buf_tag (alloca __jmp_buf_tag) a:&AP1 (alloca AP1))
    (printf \"__jmp_buf_tag size=%lld align=%lld __jmpbuf=%lld __mask_was_saved=%lld __saved_mask=%lld\\n\"
      (as i64 (sizeof __jmp_buf_tag)) (off a (ref a 'v))
      (off s (ref s '__jmpbuf)) (off s (ref s '__mask_was_saved)) (off s (ref s '__saved_mask))))
  (let (s:&timespec (alloca timespec) a:&AP2 (alloca AP2))
    (printf \"timespec size=%lld align=%lld tv_sec=%lld tv_nsec=%lld\\n\"
      (as i64 (sizeof timespec)) (off a (ref a 'v)) (off s (ref s 'tv_sec)) (off s (ref s 'tv_nsec))))
  (let (s:&itimerspec (alloca itimerspec) a:&AP3 (alloca AP3))
    (printf \"itimerspec size=%lld align=%lld it_interval=%lld it_value=%lld\\n\"
      (as i64 (sizeof itimerspec)) (off a (ref a 'v)) (off s (ref s 'it_interval)) (off s (ref s 'it_value))))
  (let (s:&stat (alloca stat) a:&AP4 (alloca AP4))
    (printf \"stat size=%lld align=%lld st_dev=%lld st_ino=%lld st_mode=%lld st_uid=%lld st_size=%lld st_mtim=%lld\\n\"
      (as i64 (sizeof stat)) (off a (ref a 'v)) (off s (ref s 'st_dev)) (off s (ref s 'st_ino))
      (off s (ref s 'st_mode)) (off s (ref s 'st_uid)) (off s (ref s 'st_size)) (off s (ref s 'st_mtim))))
  (let (s:&dirent (alloca dirent) a:&AP5 (alloca AP5))
    (printf \"dirent size=%lld align=%lld d_ino=%lld d_off=%lld d_reclen=%lld d_type=%lld d_name=%lld\\n\"
      (as i64 (sizeof dirent)) (off a (ref a 'v)) (off s (ref s 'd_ino)) (off s (ref s 'd_off))
      (off s (ref s 'd_reclen)) (off s (ref s 'd_type)) (off s (ref s 'd_name))))
  (let (s:&termios (alloca termios) a:&AP6 (alloca AP6))
    (printf \"termios size=%lld align=%lld c_iflag=%lld c_oflag=%lld c_cflag=%lld c_lflag=%lld c_line=%lld c_cc=%lld c_ispeed=%lld c_ospeed=%lld\\n\"
      (as i64 (sizeof termios)) (off a (ref a 'v)) (off s (ref s 'c_iflag)) (off s (ref s 'c_oflag))
      (off s (ref s 'c_cflag)) (off s (ref s 'c_lflag)) (off s (ref s 'c_line)) (off s (ref s 'c_cc))
      (off s (ref s 'c_ispeed)) (off s (ref s 'c_ospeed))))
  (let (a:&AP7 (alloca AP7))
    (printf \"fd_set size=%lld align=%lld\\n\" (as i64 (sizeof fd_set)) (off a (ref a 'v))))
  (let (s:&sockaddr (alloca sockaddr) a:&AP8 (alloca AP8))
    (printf \"sockaddr size=%lld align=%lld sa_family=%lld sa_data=%lld\\n\"
      (as i64 (sizeof sockaddr)) (off a (ref a 'v)) (off s (ref s 'sa_family)) (off s (ref s 'sa_data))))
  (let (s:&in6_addr (alloca in6_addr) a:&AP9 (alloca AP9))
    (printf \"in6_addr size=%lld align=%lld __in6_u=%lld\\n\"
      (as i64 (sizeof in6_addr)) (off a (ref a 'v)) (off s (ref s '__in6_u))))
  (let (a:&AP10 (alloca AP10))
    (printf \"sigset_t size=%lld align=%lld\\n\" (as i64 (sizeof sigset_t)) (off a (ref a 'v))))
  (let (a:&AP11 (alloca AP11))
    (printf \"pthread_mutex_t size=%lld align=%lld\\n\" (as i64 (sizeof pthread_mutex_t)) (off a (ref a 'v))))
  (let (s:&sigaction (alloca sigaction) a:&AP12 (alloca AP12))
    (printf \"sigaction size=%lld align=%lld sa_mask=%lld sa_flags=%lld sa_restorer=%lld\\n\"
      (as i64 (sizeof sigaction)) (off a (ref a 'v)) (off s (ref s 'sa_mask))
      (off s (ref s 'sa_flags)) (off s (ref s 'sa_restorer))))
  (let (s:&sigevent_t (alloca sigevent_t) a:&AP13 (alloca AP13))
    (printf \"sigevent_t size=%lld align=%lld sigev_signo=%lld sigev_notify=%lld\\n\"
      (as i64 (sizeof sigevent_t)) (off a (ref a 'v)) (off s (ref s 'sigev_signo))
      (off s (ref s 'sigev_notify))))
  (return 0))
"))

(deftest l2-libc-layouts
  (try (require-cc))
  (let (nuc:String (str (libc-nuc-decls) (libc-nuc-main)))
    (try (check-agrees-with-cc "l2libc" "" (string-as-view &nuc)
                               (libc-c-src)))
    (drop &nuc))
  (return (ok)))

; `FILE` was the last of §1.5's rows still opaque after L1/L2, and it was opaque
; for one reason — `int _flags2:24`. BF-4 gave that a real layout, so the claim
; flips from "still fails safe" to "agrees with cc", which is the only claim
; worth making about the type stdio hands every program.
(deftest l2-libc-file-layout
  (try (require-cc))
  (try (check-agrees-with-cc "l2file" ""
"(import-use \"stdio.h\")
(defn main ():i32
  (let (f:&FILE (alloca FILE))
    (printf \"%ld %ld %ld\\n\" (sizeof FILE)
      (- (unsafe/cast i64 (ref f '_flags)) (unsafe/cast i64 f))
      (- (unsafe/cast i64 (ref f '_lock)) (unsafe/cast i64 f))))
  (return 0))
"
"#include <stdio.h>
#include <stddef.h>
int main(void){printf(\"%zu %zu %zu\\n\",sizeof(FILE),offsetof(FILE,_flags),offsetof(FILE,_lock));return 0;}
"))
  (return (ok)))

; ---------------------------------------------------------------------------
; L3: an array typedef decays to a pointer in parameter position, as in C
;
; `jmp_buf` is `typedef struct __jmp_buf_tag jmp_buf[1];`, so before L3 `setjmp`
; and `siglongjmp` had the wrong CALLING CONVENTION — passed `byval(%jmp_buf)`
; where C passes one word — independently of the wrong size.
; ---------------------------------------------------------------------------

(defn setjmp-import ():StrView
  (return "(import-use \"setjmp.h\")\n(defn main ():i32 (return 0))\n"))

; The declare lines, textually. `setjmp` and `__sigsetjmp` carry L4's
; `returns_twice`; `longjmp`/`siglongjmp` carry `noreturn` from the hardcoded
; list in src/cheader.nuc. `_longjmp` is on neither, which is the tell that the
; attribute comes from a roster and not from the spelling.
(deftest l3-setjmp-decay
  (let (c:Compiled (try (compile-source (setjmp-import)))
        ir:StrView (compiled-ir &c))
    (try (check-no-errors (ref c 'diags)))
    (try (check-line ir "declare i32 @setjmp(ptr) returns_twice"))
    (try (check-line ir "declare i32 @__sigsetjmp(ptr, i32) returns_twice"))
    (try (check-line ir "declare i32 @_setjmp(ptr) returns_twice"))
    (try (check-line ir "declare void @longjmp(ptr, i32) noreturn"))
    (try (check-line ir "declare void @_longjmp(ptr, i32)"))
    (try (check-line ir "declare void @siglongjmp(ptr, i32) noreturn"))
    ; A 200-byte `byval(%jmp_buf)` is a CORRECT layout passed by the wrong
    ; convention, which no layout gate would catch.
    (try (check-not-contains ir "byval"))
    (try (check-ir-parses ir))
    (drop &c)
    (return (ok))))

; The negative: the pre-existing SYNTACTIC decay path, which consumes `[N]`
; after a parameter NAME, must be undisturbed. `utimensat`'s
; `const struct timespec times[2]` is the case that forced it.
(deftest l3-syntactic-decay
  (let (c:Compiled (try (compile-source
                          "(import-use \"sys/stat.h\")\n(defn main ():i32 (return 0))\n"))
        ir:StrView (compiled-ir &c))
    (try (check-line ir "declare i32 @utimensat(i32, ptr, ptr, i32)"))
    (try (check-line ir "declare i32 @futimens(i32, ptr)"))
    (drop &c)
    (return (ok))))

; ---------------------------------------------------------------------------
; L4: `returns_twice`
;
; Without it a `setjmp` call is indistinguishable from any other call to the
; optimizer, which may tail-call it and destroy the very frame the jump has to
; return into. Before L4 the compiler emitted no function attribute anywhere
; except `noreturn`.
; ---------------------------------------------------------------------------

; `vfork` is the only in-tree witness outside a fixture, and it lives in an
; example's OUTPUT rather than in setjmp.h — so it also pins that the attribute
; follows a roster of names and not the `setjmp` spelling.
(deftest l4-returns-twice-declares
  (let (c:Compiled (try (compile-source (setjmp-import)))
        ir:StrView (compiled-ir &c))
    (try (check-line ir "declare i32 @setjmp(ptr) returns_twice"))
    (try (check-line ir "declare i32 @__sigsetjmp(ptr, i32) returns_twice"))
    (try (check-line ir "declare i32 @_setjmp(ptr) returns_twice"))
    (drop &c))
  (let (p:Compiled (try (compile-path "examples/cheader-posix.nuc")))
    (try (check-line (compiled-ir &p)
                     "declare i32 @vfork() returns_twice"))
    (drop &p))
  (return (ok)))

; The attribute is only worth having if it changes what the optimizer does.
; `_setjmp` specifically: `@setjmp` resolves to `__sigsetjmp` and is a different
; call site. The negative control — the same module with the attribute stripped
; — is what makes this an assertion rather than a coincidence.
(deftest l4-no-tail-call
  (when (not (have-program? "opt")) (skip! "no llvm opt on PATH"))
  (let (c:Compiled (try (compile-path "examples/setjmp-guard.nuc"))
        ir:StrView (compiled-ir &c)
        o:String (try (opt-o2 "sjg" ir))
        ov:StrView (string-as-view &o)
        call:StrView (try (line-with ov "call i32 @_setjmp(")))
    (when (strview-contains call "tail call")
      (fail! "opt -O2 tail-called _setjmp: " (test-show call)))
    (drop &o)
    ; Strip the attribute and the same pipeline tail-calls it. Without this the
    ; assertion above would hold on an -O2 that never tail-calls anything.
    (let (bare:String (drop-suffix-on-lines ir " returns_twice")
          n:String (try (opt-o2 "sjgn" (string-as-view &bare)))
          nv:StrView (string-as-view &n))
      (try (check-contains nv "tail call i32 @_setjmp("))
      (drop &n)
      (drop &bare))
    (drop &c)
    (return (ok))))

; `text` with `suffix` cut from every line that ends in it — how the negative
; control strips one function attribute out of a module without touching
; anything else about it.
(defn drop-suffix-on-lines (text:StrView suffix:StrView):String
  (let (out:String (string-new)
        nl:StrView "\n"
        it:SplitIter (strview-split &text &nl))
    (while (not (split-iter-done &it))
      (let (l:StrView (split-iter-next &it))
        (if (strview-has-suffix l suffix)
          (str-into &out
                    (strview-take-bytes l (- (strview-byte-len &l)
                                             (strview-byte-len &suffix)))
                    "\n")
          (str-into &out l "\n"))))
    (return out)))

; ---------------------------------------------------------------------------
; L5: a C typedef is a Nucleus type NAME
;
; Resolved by a probe in `parse-type-name` placed after `type-alias-lookup-ref`
; (so a `deftype` can never be masked by an import) and returning the stored
; `Type*` directly — TRANSPARENT, exactly like `deftype`.
; ---------------------------------------------------------------------------

; The load-bearing half is that the signature prescan runs BEFORE any import, so
; this needs `cheader-scan-typedef` and not just the import-time table. The
; emitted signature is `i64 (i64)`: transparency, asserted as IR rather than as
; "it compiled".
(deftest l5-typedef-signature
  (let (c:Compiled (try (compile-source
"(import-use \"sys/types.h\")
(defn f (x:off_t):off_t (return (+ x 1)))
")))
    (try (check-no-errors (ref c 'diags)))
    (try (check-match (compiled-ir &c) "define i64 @f(i64 *"))
    (drop &c)
    (return (ok))))

; Transparency's sharpest evidence: `off_t` and `i64` are `type-eq`, mangle
; identically, and are therefore ONE overload — the pair collides as a duplicate
; definition rather than resolving as two.
(deftest l5-typedef-transparent
  (let (c:Compiled (try (compile-source
"(import-use \"sys/types.h\")
(defn f (x:off_t):off_t (return x))
(defn f (x:i64):i64 (return x))
"))
        p:String (try (scratch-file "t.nuc")))
    (when (c 'ok?) (fail! "off_t and i64 did not collide as one overload"))
    (try (check-error-at (ref c 'diags) (string-as-view &p) 3
                         "duplicate definition of 'f'"))
    (drop &p)
    (drop &c)
    (return (ok))))

; `type-name-collision` gains a C-typedef arm: a `deftype` over an imported
; typedef name would be dead on arrival, so it is refused NAMING the header.
(deftest l5-deftype-collision
  (let (c:Compiled (try (compile-source
"(import-use \"sys/types.h\")
(deftype off_t i64)
(defn f (x:off_t):off_t (return x))
"))
        p:String (try (scratch-file "t.nuc")))
    (when (c 'ok?) (fail! "a deftype over an imported typedef was accepted"))
    (try (check-error-at (ref c 'diags) (string-as-view &p) 2
                         "deftype: 'off_t' already names a C typedef imported from"))
    (try (check-error-anywhere (ref c 'diags)
           "sys/types.h — an alias of an existing type name would never resolve"))
    (drop &p)
    (drop &c)
    (return (ok))))

; A recorded-NULL entry gets its own message, distinct from "not defined
; anywhere in this compilation unit" — the C table is the one registry that
; tells "declared, and we have no type for it" from "absent". `__int128` is the
; durable subject: deliberately unscheduled, and deliberately kept out of C1's
; implicit-int rule so it reaches this path rather than being narrowed.
(deftest l5-unrepresentable-message
  (let (dir:StrView (try (test-scratch))
        h:String (try (test-write-file "l5.h" "typedef __int128 l5_wi_t;\n"))
        src:String (str "(import-use \"" (string-as-view &h) "\")\n"
                        "(defn f ():i32 (let (x:l5_wi_t 0) (return 0)))\n")
        c:Compiled (try (compile-source (string-as-view &src)))
        ; `./`: an import path is reported as the compiler resolved it, and it
        ; resolves a project-relative path against the working directory.
        want:String (str "'l5_wi_t' names a C type this compiler cannot represent (./"
                         (string-as-view &h) ":1)"))
    (when (c 'ok?) (fail! "an unrepresentable C typedef was accepted"))
    (try (check-error-anywhere (ref c 'diags) (string-as-view &want)))
    (drop &want)
    (drop &c)
    (drop &src)
    (drop &h)
    (return (ok))))

; `jmp_buf` after L3 is a `TY-ARRAY`, so the probe has to answer the
; `g-array-ok` question: legal as `defvar` STORAGE, refused as a parameter with
; the same message the Nucleus `(array T N)` spelling gives. The size is
; compared against cc, never against a hardcoded 200.
(deftest l5-array-typedef-storage
  (try (require-cc))
  (let (c:Compiled (try (compile-source
"(import-use \"setjmp.h\")
(defn g (x:jmp_buf):i32 (return 0))
")))
    (when (c 'ok?) (fail! "jmp_buf was accepted as a parameter"))
    (try (check-error-anywhere (ref c 'diags)
                               "(array T N) is a storage type"))
    (drop &c))
  (try (check-agrees-with-cc "l5jb" ""
"(import-use \"stdio.h\")
(import-use \"setjmp.h\")
(defvar env:jmp_buf)
(defn main ():i32 (printf \"%lld\\n\" (as i64 (sizeof jmp_buf))) (return 0))
"
"#include <stdio.h>
#include <setjmp.h>
int main(void){printf(\"%zu\\n\", sizeof(jmp_buf));return 0;}
"))
  (return (ok)))

; The same `g-array-ok` question on the Nucleus side of the fence.
; `parse-type-from-node` read-and-CLEARED the permission before delegating a
; bare name to `parse-type-name`, which is why a `deftype` array alias was
; refused at `defvar` before L5. A strict widening, so it needs its own pin
; together with the position where it must still refuse.
(deftest l5-deftype-array-storage
  (let (got:String (try (build-run-source
"(import-use \"stdio.h\")
(deftype Buf (array i32 4))
(defstruct Holder b:Buf n:i32)
(defvar gbuf:Buf)
(defn main ():i32 (printf \"%lld %lld\\n\" (as i64 (sizeof Buf)) (as i64 (sizeof Holder))) (return 0))
")))
    (try (check-eq (string-as-view &got) "16 20\n"))
    (drop &got))
  (let (c:Compiled (try (compile-source
"(deftype Buf (array i32 4))
(defn f (x:Buf):i32 (return 0))
")))
    (when (c 'ok?) (fail! "an array alias was accepted as a parameter"))
    (try (check-error-anywhere (ref c 'diags)
                               "(array T N) is a storage type"))
    (drop &c))
  (return (ok)))

; REPL rollback. Once a C typedef is a user-visible type name, a half-loaded
; header leaving one behind is a real defect: the entry can hold a `Type` over a
; StructDef `repl-restore` has just truncated out of `g-structs`, and the next
; module emits `[1 x %RLTag]` with no `%RLTag` definition. The half-load is
; staged as ONE form — a `.nuc` import whose own C import succeeds and whose
; next form dies — because the REPL snapshots per form.
(deftest l5-repl-rollback
  (let (sub:String (try (test-scratch-sub "lib"))
        dir:StrView (string-as-view &sub)
        hdr:String (try (write-into dir "hdr.h"
"typedef long rl_scalar_t;
struct RLTag { long a; long b; };
typedef struct RLTag rl_arr_t[1];
"))
        half-src:String (str "(import-use \"" (string-as-view &hdr) "\")\n"
                             "(defn rl-broken ():i32 (return (rl-no-such-function 1)))\n")
        half:String (try (write-into dir "half.nuc"
                                     (string-as-view &half-src)))
        session:String (str "(import-use \"" (string-as-view &half) "\")\n"
                            "(defvar rv:rl_scalar_t)\n(defvar ra:rl_arr_t)\n"
                            "(defn rl-alive ():i32 (return 7))\n(rl-alive)\n")
        out:String (try (repl-session (string-as-view &session)))
        ov:StrView (string-as-view &out))
    ; Both names gone, the session alive, and nothing reaching LLVM: an entry
    ; that outlived the rollback shows up as an IR parse error about an unsized
    ; type, not as a diagnostic.
    (try (check-contains ov "unknown type: rl_scalar_t"))
    (try (check-contains ov "unknown type: rl_arr_t"))
    (try (check-not-contains ov "IR parse error"))
    (try (check-not-contains ov "must be sized"))
    (try (check-line ov "nuc>   7"))
    (drop &out)
    ; Positive control: the SAME header, imported successfully, resolves both
    ; names — otherwise this passes on a REPL that never learned them at all.
    (let (ctl:String (str "(import-use \"" (string-as-view &hdr) "\")\n"
                          "(defvar rv2:rl_scalar_t)\n(defvar ra2:rl_arr_t)\n"
                          "(defn rl-alive2 ():i32 (return 9))\n(rl-alive2)\n")
          co:String (try (repl-session (string-as-view &ctl)))
          cv:StrView (string-as-view &co))
      (try (check-not-contains cv "unknown type:"))
      (try (check-line cv "nuc>   9"))
      (drop &co)
      (drop &ctl))
    (drop &session)
    (drop &half)
    (drop &half-src)
    (drop &hdr)
    (drop &sub)
    (return (ok))))

; `type-name-to-c` used to render any unmapped name `struct %s`, so
; `--emit-cheader` emitted `struct off_t f(struct off_t x);`. A C typedef name
; renders verbatim — and, since Stage 16, with an `#include` of the header the
; import named, which is what makes the result compile.
(deftest l5-cheader-typedef
  (let (h:String (try (source-cheader
"(import-use \"sys/types.h\")
(defn f (x:off_t):off_t (return (+ x 1)))
"))
        hv:StrView (string-as-view &h))
    (try (check-line hv "#include <sys/types.h>"))
    (try (check-line hv "off_t f(off_t x);"))
    (drop &h)
    (return (ok))))

; ---------------------------------------------------------------------------
; A bare `unsigned`, and a declaration the parser declines
; ---------------------------------------------------------------------------
;
; Design: design/stage16-ergonomics/cheader-parser-vs-libclang.md §3. C1: a bare
; `unsigned`/`signed` used to make the DECLARATOR name the base type, so
; `unsigned a;` abandoned its struct and `unsigned f(void);` was dropped — zero
; occurrences in glibc, which is why the census missed it, and pervasive in
; third-party headers (libclang's own `clang-c/Index.h` among them). C2: a
; declaration the parser declines is recorded with a reason, so the use site
; says more than "not defined anywhere".

; The oracle half. `cc` is not a hard dependency, so its absence is a SKIP —
; the shell printed `PASS  s16-c1-bare-unsigned (SKIP: no cc …)` for both the
; missing compiler and an oracle that failed to build, which is a green verdict
; for a claim nothing checked.
(deftest s16-c1-bare-unsigned
  (try (require-cc))
  (try (check-agrees-with-cc "s16u" "tests/fixtures"
    "(import-use \"tests/fixtures/s16-unsigned.h\")
(declare printf (fmt:CStr):i32)
(defn main ():i32
  (printf \"%ld %ld %ld %ld %ld %ld %ld %ld\\n\"
    (as i64 (sizeof S16U01)) (as i64 (sizeof S16U02)) (as i64 (sizeof S16U03))
    (as i64 (sizeof S16U04)) (as i64 (sizeof S16U05)) (as i64 (sizeof S16U06))
    (as i64 (sizeof S16U07)) (as i64 (sizeof S16U08)))
  (return 0))
"
    "#include <stdio.h>
#include \"s16-unsigned.h\"
int main(void){
  printf(\"%zu %zu %zu %zu %zu %zu %zu %zu\\n\",
    sizeof(struct S16U01), sizeof(struct S16U02), sizeof(struct S16U03),
    sizeof(struct S16U04), sizeof(struct S16U05), sizeof(struct S16U06),
    sizeof(struct S16U07), sizeof(struct S16U08));
  return 0;
}
"))
  (return (ok)))

; Signedness, not just size: an out-of-range literal is refused for the unsigned
; field and accepted for the signed one. Both bare-specifier FUNCTIONS have to
; register too — the shell said "the two functions" and asked about one.
(deftest s16-c1-signedness-and-functions
  (try (check-place-refused "(import-use \"tests/fixtures/s16-unsigned.h\")
(defn main ():i32
  (let (p:&S16U01 (alloca S16U01)) (set! (p 'a) -1) (return 0)))
" 3 "integer literal -1 does not fit ui32"))
  (try (check-source-accepts "(import-use \"tests/fixtures/s16-unsigned.h\")
(defn main ():i32
  (let (p:&S16U02 (alloca S16U02)) (set! (p 'a) -1) (return 0)))
"))
  (let (c:Compiled (try (compile-source "(import-use \"tests/fixtures/s16-unsigned.h\")
(defn main ():i32 (s16u_f) (s16u_g 1 2) (return 0))
"))
        iv:StrView (compiled-ir &c))
    (try (check-line iv "declare i32 @s16u_f()"))
    (try (check-line iv "declare i32 @s16u_g(i32, i32)"))
    (drop &c))
  (return (ok)))

; C2: the use site names the header, the LINE and a reason. Pinned as one
; record at the call's own line — the shell ran a regex over the whole stderr
; blob with `[0-9]+` where the header line belongs, so a reason recorded
; against the wrong declaration read the same.
(deftest s16-c2-skip-reason-recorded
  (try (check-place-refused "(import-use \"tests/fixtures/s16-unsigned.h\")
(defn main ():i32 (return (s16u_odd 1)))
" 2 "unknown: 's16u_odd' — its C header declaration was skipped (./tests/fixtures/s16-unsigned.h:21: a declaration shape the C header parser does not recognize)"))
  (return (ok)))

; Stage 21 item 3 (design/stage21-cleanup/c-header-include-paths.md §10): the
; `MAX-STRUCTS` guard is not a size. `gtk/gtk.h` registers thousands of C
; structs, opaque forward declarations and typedef aliases, and the 1024 that
; sufficed for SDL's umbrella header was `nucleusc: too many structs` for it.
; This header registers 4,000 (2,000 each of the two shapes), which is above
; the old cap and below the guard, and the LAST of each must be usable.
(deftest s21-thousands-of-c-structs
  (let (h:String (string-new)
        i:i64 0)
    (while (< i 2000)
      (str-into &h "typedef struct _Big" i " Big" i "; struct _Big" i
                   " { int a; void* p; }; Big" i "* big" i "_new(int a);\n"
                   "typedef struct _Op" i " Op" i "; void op" i "_free(Op" i "* o);\n")
      (set! i (+ i 1)))
    (let (p:String (try (test-write-file "many.h" (string-as-view &h)))
          src:String (str "(import-use \"" (string-as-view &p) "\")
(defn main ():i32
  (let (b:ptr (big1999_new 1))
    (op1999_free null)
    (return 0)))
")
          c:Compiled (try (compile-source (string-as-view &src))))
      (try (check-no-errors (ref c 'diags)))
      (try (check-line (compiled-ir &c) "declare ptr @big1999_new(i32)"))
      (try (check-line (compiled-ir &c) "declare void @op1999_free(ptr)"))
      (drop &c)
      (drop &src)
      (drop &p))
    (drop &h))
  (return (ok)))

; ---------------------------------------------------------------------------
; Typed C pointers: a C `T *` keeps its pointee, so a call is checked
; (design/stage23-namespaces/typed-c-pointers.md)
; ---------------------------------------------------------------------------

(defn tp-src (body:StrView):String
  (return (str "(import-use nucleus.node)\n(import-use \"tests/fixtures/tp-pointers.h\")\n"
               "(defn main ():i32 " body " (return 0))\n")))

(defn tp-accepts (body:StrView):!void
  (let (src:String (tp-src body)
        c:Compiled (try (compile-source (string-as-view &src))))
    (try (check-no-errors (ref c 'diags)))
    (drop &c)
    (drop &src)
    (return (ok))))

(defn tp-refuses (body:StrView needle:StrView):!void
  (let (src:String (tp-src body)
        c:Compiled (try (compile-source (string-as-view &src))))
    (when (c 'ok?) (fail! "accepted: " body))
    (try (check-error-anywhere (ref c 'diags) needle))
    (drop &c)
    (drop &src)
    (return (ok))))

; The charge.nuc crash: a quoted symbol reached GTK as a widget.
(deftest tp1-wrong-pointee-refused
  (try (tp-refuses "(tp_take_base (quote x))"
                   "tp_take_base: argument 1 has type &Node, which does not match parameter type (ptr TpBase)"))
  (try (tp-refuses "(tp_take_hidden (quote x))"
                   "argument 1 has type &Node, which does not match parameter type (ptr TpHidden)"))
  (try (tp-refuses "(let (n:i32 0) (tp_take_charp &n))" "does not match parameter type (ptr i8)"))
  (return (ok)))

; The tag and the typedef name are one type; `void *` is still the wildcard.
(deftest tp1-matching-pointee-accepted
  (try (tp-accepts "(let (b:?&TpBase null) (tp_take_base b) (tp_take_tagged b) (tp_take_voidp b))"))
  (try (tp-accepts "(tp_take_charp \"x\") (let (s:CStr \"y\") (tp_take_charp s))"))
  (try (tp-accepts "(let (n:?&tp_node null) (when-some (m n) (tp_take_node (m 'next))))"))
  (return (ok)))

(deftest tp2-size-t-is-usize
  (try (tp-accepts "(let (n:usize 0) (tp_take_sizep &n))"))
  (return (ok)))

; C's `char` and `unsigned char` meet each other's sign; other ints do not.
(deftest tp3-char-sign
  (try (tp-accepts "(let (a:ui8 0 b:i8 0) (tp_take_charp &a) (tp_take_ucharp &b))"))
  (try (tp-refuses "(let (n:ui32 0) (tp_take_intp &n))"
                   "argument 1 has type &ui32, which does not match parameter type (ptr i32)"))
  (return (ok)))

; A pointer to a C struct converts to a pointer to its first member's struct.
(deftest tp4-first-member-upcast
  (try (tp-accepts "(tp_take_base (tp_make_leaf)) (tp_take_mid (tp_make_leaf)) (tp_take_tagged (tp_make_leaf))"))
  (try (tp-accepts "(let (b:?&TpBase (tp_make_leaf)) (tp_take_base b))"))
  (try (tp-refuses "(let (b:?&TpBase null) (tp_take_mid b))"
                   "which does not match parameter type (ptr TpMid) — where C would cast, write (unsafe/cast (ptr TpMid) x)"))
  (return (ok)))

; `typedef TpHidden TpHidden2;` renames an opaque struct.
(deftest tp5-opaque-typedef-chain
  (try (tp-accepts "(tp_take_hidden (tp_make_hidden2))"))
  (try (tp-refuses "(tp_take_base (tp_make_hidden2))" "which does not match parameter type (ptr TpBase)"))
  (return (ok)))

; Pointer kind is ignored at every level; an upcast is not, below the top.
(deftest tp6-pointer-to-pointer
  (try (tp-accepts "(let (e:?&TpBase null) (tp_take_basepp &e))"))
  (try (tp-accepts "(let (v:(ptr CStr) null) (tp_take_strv v))"))
  (try (tp-accepts "(let (v:?&TpBase null) (tp_take_voidpp &v))"))
  (try (tp-refuses "(let (e:?&TpMid null) (tp_take_basepp &e))"
                   "argument 1 has type &?&TpMid, which does not match parameter type (ptr (ptr TpBase))"))
  (return (ok)))

; The signature prescan skipped a `static inline` body to the NEXT `;`, which
; swallowed the declaration after it: 145 GTK names were unknown in a signature.
(deftest prescan-type-after-inline-body
  (let (c:Compiled (try (compile-source "(import-use \"tests/fixtures/prescan-after-inline.h\")
(defvar g:?&PaiThing null)
(defn f (t:?&PaiOther):void (return))
(defn main ():i32 (pai_take g) (return 0))
")))
    (try (check-no-errors (ref c 'diags)))
    (drop &c)
    (return (ok))))

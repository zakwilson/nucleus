; .nuch header for lib/keyword.nuc
(defstruct Keyword (sym Symbol))
(declare keyword-intern ((cs CStr)) :Keyword)
(declare keyword-name ((self Keyword)) :StrView)
(declare keyword-symbol ((self Keyword)) :Symbol)
(extend Keyword Eq)
(defmethod "@eq.Keyword.Keyword" = ((a Keyword) (b Keyword)) :bool)
(defmethod "@ne.Keyword.Keyword" != ((a Keyword) (b Keyword)) :bool)
(extend Keyword Hash)
(declare hash ((self (ref Keyword))) :usize)
(extend Keyword ToStr)
(declare to-str ((self Keyword) (out (ref String))) :!void)

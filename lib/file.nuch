; .nuch header for lib/file.nuc
(defconst MODE-644 420)
(defconst FILE-CHUNK 65536)
(defstruct File (fd i32))
(declare file ((fd i32)) :File)
(extend File Drop)
(defmethod "@drop.pFile" drop ((self (ptr File))) :void)
(declare file-close ((self (ref File))) :!void)
(declare file-open-flags ((path (ref StrView)) (flags i32) (mode i32)) :!File)
(declare file-open-read ((path (ref StrView))) :!File)
(declare file-create ((path (ref StrView))) :!File)
(declare file-open-append ((path (ref StrView))) :!File)
(declare file-write-bytes ((self (ref File)) (p (ptr ui8)) (n usize)) :!void)
(extend File Writer)
(defmethod "@write_str.pFile.StrView" write-str ((self (ref File)) (s StrView)) :!void)
(declare file-read-to-string ((self (ref File))) :!String)
(defconst BUF-WRITER-CAP 65536)
(defstruct BufWriter (out File) (buf String))
(declare buf-writer ((f File)) :BufWriter)
(declare flush ((self (ref BufWriter))) :!void)
(extend BufWriter Writer)
(defmethod "@write_str.pBufWriter.StrView" write-str ((self (ref BufWriter)) (s StrView)) :!void)
(declare buf-writer-close ((self (ref BufWriter))) :!void)
(extend BufWriter Drop)
(defmethod "@drop.pBufWriter" drop ((self (ptr BufWriter))) :void)

; Stage 11 collections — the Hash protocol and built-in conformances for the
; scalar types and CStr. Required by HashSet/HashMap (a key or set member must
; be both Hash and Eq).
;
; Design: design/stage11/collections.md §"Hash (its own lib)".
;
; ---------------------------------------------------------------------------
; THE PROTOCOL
;
;   (defprotocol Hash
;     (hash:usize ((self (ref Self)))))
;
; A type conforms by providing `hash` over a (ref Self) receiver returning a
; usize. The receiver is by reference so a large key (a struct) need not be
; copied; the scalar conformances simply load through it.
;
; TOKENIZER NOTE (carried from M1/M2 + parametric structs): a parameter whose
; type is a parenthesised form uses the LIST binding form `(self (ref Self))`,
; never `self:(ref Self)`. A plain-symbol return type in colon position DOES
; tokenise, so `hash:usize` is fine.
;
; ---------------------------------------------------------------------------
; THE HASH FUNCTION: FNV-1a (64-bit), the same algorithm the compiler itself
; uses to hash interned strings / struct shapes (src/nucleusc.nuc fnv-byte /
; fnv-str). FNV-1a folds the input one byte at a time:
;
;   h := FNV_OFFSET_BASIS                 ; 0xcbf29ce484222325
;   for each byte b:  h := (h XOR b) * FNV_PRIME      ; prime = 0x100000001b3
;
; We fold every byte of an integer scalar (so equal values hash equal), and the
; bytes of a CStr up to its terminator. The fold runs in i64 (the natural width
; for the constants and the multiply) and the result is cast to usize at the
; end — usize is the protocol's return type and the table indexes with it.
;
; FNV_OFFSET_BASIS 0xcbf29ce484222325 as a *signed* i64 is the negative literal
; below (the high bit is set); writing the unsigned hex directly would overflow
; the signed-literal range, so we use the two's-complement decimal form exactly
; as the compiler's hash-struct-shape seed does (-3750763034362895579).
; ---------------------------------------------------------------------------

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use "string.h")

; `stderr` is a libc global, not a function — C header parsing imports functions
; only, so it must be declared explicitly (the same line lib/vector.nuc carries).
(extern stderr:ptr)

; Fold one byte `b` (0..255, passed as i64) into the running hash `h`.
; The * is the FNV prime 0x100000001b3 = 1099511628211.
(defn fnv1a-byte (h:i64 b:i64):i64
  (set! h (bit-xor h b))
  (set! h (* h 1099511628211))
  (return h))

; Fold the `n` low bytes of integer value `v` (little-endian byte order) into
; `h`. Byte order is internal to this hash (never observed), so little-endian is
; an arbitrary, consistent choice — equal values always fold identically.
(defn fnv1a-int (h:i64 v:i64 n:i32):i64
  (let (i:i32 0)
    (while (< i n)
      (let (b:i64 (bit-and (bit-shr v (as i64 (* i 8))) 255))
        (set! h (fnv1a-byte h b)))
      (set! i (+ i 1)))
    (return h)))

; ---------------------------------------------------------------------------
; The Hash protocol.
; ---------------------------------------------------------------------------
(defprotocol Hash
  (hash ((self (ref Self))):usize))

; ---------------------------------------------------------------------------
; Built-in conformances. Each loads the value through the (ref Self) receiver,
; folds its bytes through FNV-1a, and returns the result as usize.
;
; i32 — fold the 4 bytes of the value.
; i64 — fold the 8 bytes.
; usize — fold the target-pointer-sized value as 8 bytes (the high bytes are
;         zero on a 32-bit target, which is harmless: a zero byte still folds).
; f64/f32 — fold the bit pattern, with -0.0 normalised to +0.0.
; CStr — fold each character byte up to (not including) the NUL terminator.
; ---------------------------------------------------------------------------

(extend i32 Hash)
(defn hash ((self (ref i32))):usize
  (let (h:i64 -3750763034362895579)
    (return (as usize (fnv1a-int h (as i64 (deref self)) 4)))))

(extend i64 Hash)
(defn hash ((self (ref i64))):usize
  (let (h:i64 -3750763034362895579)
    (return (as usize (fnv1a-int h (deref self) 8)))))

(extend usize Hash)
(defn hash ((self (ref usize))):usize
  (let (h:i64 -3750763034362895579)
    (return (as usize (fnv1a-int h (as i64 (deref self)) 8)))))

; f64 / f32 — fold the BIT PATTERN, read back through the receiver. `(as i64 x)`
; would convert the value and round the fraction away, so equal-but-unequal
; floats would collide wholesale.
;
; IEEE-754 forces one correction: `0.0` and `-0.0` are `=` but differ in bits, so
; zero folds as the +0.0 pattern or a `-0.0` key would never be found. NaN needs
; none — it is `=` to nothing, itself included, so a NaN key is unfindable
; whatever it hashes to.
(extend f64 Hash)
(defn hash ((self (ref f64))):usize
  (let (h:i64 -3750763034362895579
        bits:i64 (if (= (deref self) 0.0) 0 (deref (unsafe/cast ptr:i64 self))))
    (return (as usize (fnv1a-int h bits 8)))))

(extend f32 Hash)
(defn hash ((self (ref f32))):usize
  (let (h:i64 -3750763034362895579
        bits:i64 (if (= (deref self) 0.0) 0 (as i64 (deref (unsafe/cast ptr:i32 self)))))
    (return (as usize (fnv1a-int h bits 4)))))

; `(ref Node)` — a symbol. `intern-symbol` keeps one canonical Node per spelling,
; so pointer identity IS symbol identity and `=` already compares correctly; only
; `hash` was missing. Folded rather than returned raw: arena nodes sit a fixed
; stride apart and the table masks on low bits, so raw pointers would cluster.
;
; No `(extend (ref Node) Hash)` — `extend` takes a struct template, not a pointer
; type. The bare overload resolves on its own; the conformance record only feeds
; `&where` bounds, which nothing here needs.
(defn hash ((self (ref (ref Node)))):usize
  (let (h:i64 -3750763034362895579)
    (return (as usize (fnv1a-int h (unsafe/cast i64 (as ptr (deref self))) 8)))))

(defn hash-null-cstr ():void
  (fprintf stderr "hash: null CStr\n")
  (exit 1))

(extend CStr Hash)
; The receiver is a non-null `(ref CStr)`, but the CStr VALUE it points at can be
; null — `CStr` carries no non-null contract (Stage 15 W9 item 7: it used to be
; exempt from the flow check, so this line converted a possibly-null CStr into a
; non-null `ptr:i8` silently and a null key segfaulted inside the loop below).
; There is no error channel on `hash`, so this follows `vector-bounds`: report
; the caller's bug and stop, rather than fault on the first `aref`.
(defn hash ((self (ref CStr))):usize
  (when (= (as raw:i8 (deref self)) null) (hash-null-cstr))
  (let (h:i64 -3750763034362895579
        s:ptr:i8 (unsafe/cast ptr:i8 (deref self))
        i:i64 0)
    (let (c:i32 (bit-and (as i32 (aref s 0)) 255))
      (while (!= c 0)
        (set! h (fnv1a-byte h (as i64 c)))
        (set! i (+ i 1))
        (set! c (bit-and (as i32 (aref s i)) 255))))
    (return (as usize h))))

; .nuch header for lib/iterator.nuc
(defprotocol (Iterator E) (next ((self (ref Self))) (Maybe E)))
(defstruct IntRangeIter (start i32) (end i32))
(extend IntRangeIter (Iterator i32))
(defmethod "@next.pIntRangeIter" next ((self (ref IntRangeIter))) (Maybe i32))
(defstruct I64ArrayIter (data (ptr i64)) (pos usize) (len usize))
(extend I64ArrayIter (Iterator i64))
(defmethod "@next.pI64ArrayIter" next ((self (ref I64ArrayIter))) (Maybe i64))
(defprotocol (UnaryFn Arg Ret) (apply ((self (ref Self)) (x Arg)) Ret))
(defprotocol (FoldFn Acc Elem) (fold ((self (ref Self)) (acc Acc) (x Elem)) Acc))
(defstruct (MapIter I F) (source I) (f F))
(defn next ((self (ref (MapIter I F))) :where ((Iterator S) I) ((UnaryFn S E) F)) (Maybe E) (let ((res (Maybe S)) (next (.& self source))) (match res ((some v) (return (some (apply (.& self f) v)))) (none (return none)))))
(extend (MapIter I F) (Iterator E) :where ((Iterator S) I) ((UnaryFn S E) F))
(defstruct (FilterIter I F) (source I) (pred F))
(defn next ((self (ref (FilterIter I F))) :where ((Iterator S) I) ((UnaryFn S i32) F)) (Maybe S) (let (done:i32 0) (while (= done 0) (let ((item (Maybe S)) (next (.& self source))) (match item ((some v) (when (!= (apply (.& self pred) v) 0) (return (some v)))) (none (return none))))) (return none)))
(extend (FilterIter I F) (Iterator S) :where ((Iterator S) I) ((UnaryFn S i32) F))
(defn reduce ((g (ref G)) (init Acc) (it (ref I)) :where ((Iterator S) I) ((FoldFn Acc S) G)) :Acc (let (acc:Acc init) (let (done:i32 0) (while (= done 0) (let ((item (Maybe S)) (next it)) (match item ((some v) (set! acc (fold g acc v))) (none (set! done 1)))))) (return acc)))

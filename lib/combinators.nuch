; .nuch header for lib/combinators.nuc
(defprotocol (BinaryFn A R) (apply2 ((self (ref Self)) (x A) (y A)) R))
(defn map ((g (ref G)) (it (ref I)) :where ((Iterator S) I) ((UnaryFn S E) G)) (Vector E) (let ((out (ref (Vector E))) (alloca (Vector E))) (vector-init out) (let (done:i32 0) (while (= done 0) (match (next it) ((some v) (conj out (apply g v))) (none (set! done 1))))) (return (deref out))))
(defn filter ((pred (ref P)) (it (ref I)) :where ((Iterator S) I) ((UnaryFn S bool) P)) (Vector S) (let ((out (ref (Vector S))) (alloca (Vector S))) (vector-init out) (let (done:i32 0) (while (= done 0) (match (next it) ((some v) (when (apply pred v) (conj out v))) (none (set! done 1))))) (return (deref out))))
(defn remove-if ((pred (ref P)) (it (ref I)) :where ((Iterator S) I) ((UnaryFn S bool) P)) (Vector S) (let ((out (ref (Vector S))) (alloca (Vector S))) (vector-init out) (let (done:i32 0) (while (= done 0) (match (next it) ((some v) (when (not (apply pred v)) (conj out v))) (none (set! done 1))))) (return (deref out))))
(defn for-each ((f (ref F)) (it (ref I)) :where ((Iterator S) I) ((UnaryFn S R) F)) :void (let (done:i32 0) (while (= done 0) (match (next it) ((some v) (apply f v)) (none (set! done 1))))))
(defn flat-map ((g (ref G)) (it (ref I)) :where ((Iterator S) I) ((UnaryFn S R) G) ((Coll E It) R) ((Iterator E) It)) (Vector E) (let ((out (ref (Vector E))) (alloca (Vector E))) (vector-init out) (let (done:i32 0) (while (= done 0) (match (next it) ((some v) (let ((inner R) (apply g v)) (let ((iit It) (iter (addr-of inner))) (let (idone:i32 0) (while (= idone 0) (match (next (addr-of iit)) ((some e) (conj out e)) (none (set! idone 1)))))) (drop (addr-of inner)))) (none (set! done 1))))) (return (deref out))))
(defn find ((pred (ref P)) (it (ref I)) :where ((Iterator S) I) ((UnaryFn S bool) P)) (Maybe S) (let (done:i32 0) (while (= done 0) (match (next it) ((some v) (when (apply pred v) (return (some v)))) (none (set! done 1))))) (return none))
(defn find-index ((pred (ref P)) (it (ref I)) :where ((Iterator S) I) ((UnaryFn S bool) P)) :i32 (let (idx:i32 0 done:i32 0) (while (= done 0) (match (next it) ((some v) (when (apply pred v) (return idx)) (set! idx (+ idx 1))) (none (set! done 1))))) (return -1))
(defn any? ((pred (ref P)) (it (ref I)) :where ((Iterator S) I) ((UnaryFn S bool) P)) :bool (let (done:i32 0) (while (= done 0) (match (next it) ((some v) (when (apply pred v) (return true))) (none (set! done 1))))) (return false))
(defn exists? ((pred (ref P)) (it (ref I)) :where ((Iterator S) I) ((UnaryFn S bool) P)) :bool (return (any? pred it)))
(defn every? ((pred (ref P)) (it (ref I)) :where ((Iterator S) I) ((UnaryFn S bool) P)) :bool (let (done:i32 0) (while (= done 0) (match (next it) ((some v) (when (not (apply pred v)) (return false))) (none (set! done 1))))) (return true))
(defn all? ((pred (ref P)) (it (ref I)) :where ((Iterator S) I) ((UnaryFn S bool) P)) :bool (return (every? pred it)))
(defn count-if ((pred (ref P)) (it (ref I)) :where ((Iterator S) I) ((UnaryFn S bool) P)) :i32 (let (n:i32 0 done:i32 0) (while (= done 0) (match (next it) ((some v) (when (apply pred v) (set! n (+ n 1)))) (none (set! done 1)))) (return n)))
(defn foldr ((g (ref G)) (init Acc) (it (ref I)) :where ((Iterator S) I) ((FoldFn Acc S) G)) :Acc (let ((buf (ref (Vector S))) (alloca (Vector S))) (vector-init buf) (let (done:i32 0) (while (= done 0) (match (next it) ((some v) (conj buf v)) (none (set! done 1))))) (let (acc:Acc init n:usize (count buf) i:i64 (- (as i64 n) 1)) (while (>= i 0) (set! acc (fold g acc (buf (as usize i)))) (set! i (- i 1))) (drop buf) (return acc))))
(defn sum ((it (ref I)) :where ((Iterator S) I)) :S (let (acc:S (as S 0) done:i32 0) (while (= done 0) (match (next it) ((some v) (set! acc (+ acc v))) (none (set! done 1)))) (return acc)))
(defn product ((it (ref I)) :where ((Iterator S) I)) :S (let (acc:S (as S 1) done:i32 0) (while (= done 0) (match (next it) ((some v) (set! acc (* acc v))) (none (set! done 1)))) (return acc)))
(defn min ((it (ref I)) :where ((Iterator S) I)) :S (let (acc:S (as S 0) seen:i32 0 done:i32 0) (while (= done 0) (match (next it) ((some v) (if (= seen 0) (do (set! acc v) (set! seen 1)) (when (< v acc) (set! acc v)))) (none (set! done 1)))) (return acc)))
(defn max ((it (ref I)) :where ((Iterator S) I)) :S (let (acc:S (as S 0) seen:i32 0 done:i32 0) (while (= done 0) (match (next it) ((some v) (if (= seen 0) (do (set! acc v) (set! seen 1)) (when (< acc v) (set! acc v)))) (none (set! done 1)))) (return acc)))
(defn sort ((cmp (ref C)) (v (ref (Vector T))) :where ((BinaryFn T i32) C)) :void (let (n:usize (count v) buf:ptr:T (as ptr:T (as ptr (_get v (quote data))))) (let (i:usize 1) (while (< i n) (let (key:T (aref buf (as i64 i)) j:i64 (- (as i64 i) 1)) (while (and (>= j 0) (!= (apply2 cmp key (aref buf j)) 0)) (set! (aref buf (+ j 1)) (aref buf j)) (set! j (- j 1))) (set! (aref buf (+ j 1)) key)) (set! i (+ i 1))))))
(defn sort-by ((keyf (ref F)) (v (ref (Vector T))) :where ((UnaryFn T K) F)) :void (let (n:usize (count v) buf:ptr:T (as ptr:T (as ptr (_get v (quote data))))) (let (i:usize 1) (while (< i n) (let (key:T (aref buf (as i64 i)) kk:K (apply keyf (aref buf (as i64 i))) j:i64 (- (as i64 i) 1)) (while (and (>= j 0) (< kk (apply keyf (aref buf j)))) (set! (aref buf (+ j 1)) (aref buf j)) (set! j (- j 1))) (set! (aref buf (+ j 1)) key)) (set! i (+ i 1))))))
(defn emit-joined ((emitf (ref EF)) (sep StrView) (it (ref I)) :where ((Iterator S) I) ((UnaryFn S R) EF)) :void (let (first:i32 1 done:i32 0) (while (= done 0) (match (next it) ((some v) (when (= first 0) (printf "%.*s" (unsafe/cast i32 (sep (quote len))) (as ptr (sep (quote data))))) (set! first 0) (apply emitf v)) (none (set! done 1))))))
(defn join ((renderf (ref RF)) (sep StrView) (it (ref I)) :where ((Iterator S) I) ((UnaryFn S StrView) RF)) :String (let (out:String (string-new) first:i32 1 done:i32 0) (while (= done 0) (match (next it) ((some v) (when (= first 0) (string-push-str-unchecked (addr-of out) (addr-of sep))) (set! first 0) (let (r:StrView (apply renderf v)) (string-push-str-unchecked (addr-of out) (addr-of r)))) (none (set! done 1)))) (return out)))
(defn keep-last ((f (ref F)) (init R) (it (ref I)) :where ((Iterator S) I) ((UnaryFn S R) F)) :R (let (acc:R init done:i32 0) (while (= done 0) (match (next it) ((some v) (set! acc (apply f v))) (none (set! done 1)))) (return acc)))
(defmacro do-last (:rest body) (quasiquote (do (unquote-splice body))))
(defn compose ((g (ref G)) (f (ref F)) :where ((UnaryFn B C) G) ((UnaryFn A B) F)) (BoxedFn (A) C) (return (vfn (x:A) C (apply g (apply f x)))))
(defn comp ((g (ref G)) (f (ref F)) :where ((UnaryFn B C) G) ((UnaryFn A B) F)) (BoxedFn (A) C) (return (compose g f)))
(defn complement ((pred (ref P)) :where ((UnaryFn A bool) P)) (BoxedFn (A) i32) (return (vfn (x:A) i32 (if (apply pred x) 0 1))))
(defn conjoin ((p (ref P)) (q (ref Q)) :where ((UnaryFn A bool) P) ((UnaryFn A bool) Q)) (BoxedFn (A) i32) (return (vfn (x:A) i32 (if (and (apply p x) (apply q x)) 1 0))))
(defn disjoin ((p (ref P)) (q (ref Q)) :where ((UnaryFn A bool) P) ((UnaryFn A bool) Q)) (BoxedFn (A) i32) (return (vfn (x:A) i32 (if (or (apply p x) (apply q x)) 1 0))))
(defn constantly ((v V) :where (Ord V)) (BoxedFn (V) V) (return (vfn (ignored:V) V v)))
(defn partial ((f (ref F)) (a A) :where ((FoldFn A X) F)) (BoxedFn (X) A) (return (vfn (x:X) A (fold f a x))))

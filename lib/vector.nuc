; Stage 11 collections — Vector T: a dynamically-sized, heap-backed, mutable
; sequence (C++ STL `vector` in spirit). O(1) indexed `invoke`/append (amortized
; via capacity doubling), O(n) `insert`. Owns its element buffer through a stored
; allocator handle and frees it via `Drop` at `with`-scope exit.
;
; Design: design/stage11/collections.md §"Vector" + §"Memory model".
;
; ---------------------------------------------------------------------------
; USAGE (the working construction pattern):
;
;   (with (v:(ref (Vector i32)) (vector-new))   ; T inferred from declared type
;     (conj v 10) (conj v 20)
;     (printf "%d\n" (v 0))        ; index access -> 10
;     ...)                      ; (drop v) fires here, freeing the buffer
;
; `vector-new` is a target-typed value constructor: T is bound from the
; binding's declared type via the want channel (design/stage14/target-typed-
; constructors.md), and the by-value result materializes into the declared
; `(ref (Vector T))`. The `*-init` family below stays for caller-managed
; storage (`(with ((v (ref (Vector T))) (alloca (Vector T))) (vector-init v) …)`);
; `vector-new-in` allocates the struct itself through a handle and returns an
; escapable ref. An owning collection may not escape by return without `move`.
; ---------------------------------------------------------------------------

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use "string.h")

; `stderr` is a libc global, not a function — C header parsing imports functions
; only, so it must be declared explicitly (as the compiler itself does).
(extern stderr:ptr)

(import-use allocator)
(import-use coll)
(import-use iterator)

; ---------------------------------------------------------------------------
; Panic helpers. These are NON-generic so they are emitted once and resolve
; their `stderr`/`exit`/`fprintf` references against this file's includes. A
; generic method body is monomorphized at the *call site* in the consuming unit,
; which would otherwise have to declare `stderr`/`exit` itself; routing the panic
; through these helpers keeps the consumer's only requirement to `(import vector)`.
; ---------------------------------------------------------------------------
(defn vector-oom ():void
  (fprintf stderr "vector: out of memory\n")
  (exit 1))

(defn vector-bounds (what:CStr i:usize n:usize):void
  (fprintf stderr "vector: %s index %llu out of bounds (len %llu)\n"
    what (as ui64 i) (as ui64 n))
  (exit 1))

; Vector T: dynamically-sized heap array.
;   data  : raw byte pointer to the element buffer (null while cap = 0).
;   len   : number of live elements.
;   cap   : total allocated element slots.
;   alloc : the allocator handle the buffer is owned through (by value).
(defstruct (Vector T)
  (data (raw ui8))   ; list-form: (raw ui8) is a parenthesised type
  len:usize
  cap:usize
  alloc:AllocHandle)

; ---------------------------------------------------------------------------
; Constructors. Each takes a caller-owned (ref (Vector T)) to initialise in
; place; T is inferred from the receiver. Returns void; the receiver is ready
; to use afterwards.
; ---------------------------------------------------------------------------

; Initialise an empty Vector with the default (libc) allocator.
(defn vector-init ((v (ref (Vector T)))):void
  (.set! v data null)
  (.set! v len 0)
  (.set! v cap 0)
  (libc-allocator (.& v alloc)))

; Initialise an empty Vector with an explicit allocator handle (copied in).
(defn vector-init-alloc ((v (ref (Vector T))) (a (ref AllocHandle))):void
  (.set! v data null)
  (.set! v len 0)
  (.set! v cap 0)
  (.set! v alloc (deref a)))

; ---------------------------------------------------------------------------
; Value/heap constructors (target-typed — design/stage14/target-typed-
; constructors.md). T is bound from the binding's declared type via the want
; channel, so a zero-arg `(vector-new)` resolves at a typed position. The by-
; value family materializes into a `(ref (Vector T))` binding (TC-3); the `-in`
; family allocates the struct itself through the handle and returns an
; escapable ref. The `*-init` family above stays for caller-managed storage.
; ---------------------------------------------------------------------------
; by value — stack/binding use (materializes into a declared (ref (Vector T)))
(defn vector-new () (Vector T)
  (let (r (alloca (Vector T)))
    (vector-init r)
    (return (deref r))))
(defn vector-new-alloc ((a (ref AllocHandle))) (Vector T)
  (let (r (alloca (Vector T)))
    (vector-init-alloc r a)
    (return (deref r))))
(defn vector-new-capacity (n:usize) (Vector T)
  (let (r (alloca (Vector T)))
    (vector-init-capacity r n)
    (return (deref r))))
; heap placement — struct allocated through the handle; returns an escapable ref.
(defn vector-new-in ((a (ref AllocHandle))) (ref (Vector T))
  (let (v (unsafe/cast (ref (Vector T))
             (alloc-handle-alloc a (sizeof (Vector T)) 8)))
    (vector-init-alloc v a)
    (return v)))


; ---------------------------------------------------------------------------
; Internal: grow the buffer. Doubles capacity (or seeds 4 when empty),
; reallocating through the stored allocator. Aborts on OOM.
; ---------------------------------------------------------------------------
(defn vector-grow ((v (ref (Vector T)))):void
  (let (new-cap:usize (if (= (_get v cap) 0)
                        4
                        (* (_get v cap) 2))
        elem-size:usize (as usize (sizeof T)))
    (let (old-bytes:usize (* (_get v cap) elem-size)
          new-bytes:usize (* new-cap elem-size)
          ah:ref:AllocHandle (.& v alloc))
      (let ((new-data (raw ui8))
            (alloc-handle-realloc ah (_get v data) old-bytes new-bytes 8))
        (when (= (as ptr new-data) null) (vector-oom))
        (.set! v data new-data)
        (.set! v cap new-cap)))))

; ---------------------------------------------------------------------------
; Coll T conformance: count, conj, empty?.
; ---------------------------------------------------------------------------

; count -> number of live elements.
(defn count ((self (ref (Vector T)))):usize
  (return (_get self len)))

; conj: append an element at the back, growing if needed.
(defn conj ((self (ref (Vector T))) elem:T):void
  (when (>= (_get self len) (_get self cap)) (vector-grow self))
  (aset! (as ptr:T (as ptr (_get self data))) (as i64 (_get self len)) elem)
  (.set! self len (+ (_get self len) 1)))

; empty? -> 1 when len = 0, else 0.
(defn empty? ((self (ref (Vector T)))):i32
  (return (if (= (_get self len) 0) 1 0)))

; ---------------------------------------------------------------------------
; Seq T conformance: invoke (index), append, contains?, insert.
; ---------------------------------------------------------------------------

; invoke: index access `(v i)` -> element. Panics on out-of-bounds.
(defn invoke ((self (ref (Vector T))) i:usize):T
  (when (>= i (_get self len)) (vector-bounds "get" i (_get self len)))
  (return (aref (as ptr:T (as ptr (_get self data))) (as i64 i))))

; append: add at the back (same as conj for a vector).
(defn append ((self (ref (Vector T))) elem:T):void
  (conj self elem))

; contains?: linear scan with =, 1 if found else 0. (Scalar element types.)
(defn contains? ((self (ref (Vector T))) elem:T):i1
  (let (i:usize 0)
    (while (< i (_get self len))
      (when (= (aref (as ptr:T (as ptr (_get self data))) (as i64 i)) elem)
        (return 1))
      (set! i (+ i 1)))
    (return 0)))

; insert: place elem at index i, shifting [i,len) right by one. Grows if full.
; i may equal len (append). i > len is out of bounds.
(defn insert ((self (ref (Vector T))) i:usize elem:T):void
  (when (> i (_get self len)) (vector-bounds "insert" i (_get self len)))
  (when (>= (_get self len) (_get self cap)) (vector-grow self))
  (let (buf:ptr:T (as ptr:T (as ptr (_get self data)))
        j:usize (_get self len))
    (while (> j i)
      (aset! buf (as i64 j) (aref buf (as i64 (- j 1))))
      (set! j (- j 1)))
    (aset! buf (as i64 i) elem))
  (.set! self len (+ (_get self len) 1)))

; remove-at: delete the element at index i, shifting (i,len) left by one.
; i must be < len (i = len-1 removes the last element). Panics out-of-bounds.
(defn remove-at ((self (ref (Vector T))) i:usize):void
  (when (>= i (_get self len)) (vector-bounds "remove-at" i (_get self len)))
  (let (buf:ptr:T (as ptr:T (as ptr (_get self data)))
        j:usize i)
    (while (< (+ j 1) (_get self len))
      (aset! buf (as i64 j) (aref buf (as i64 (+ j 1))))
      (set! j (+ j 1))))
  (.set! self len (- (_get self len) 1)))

; ---------------------------------------------------------------------------
; Capacity operations (STL-like opt-in surface; design §Vector recommends
; Minimal + reserve/capacity/with-capacity).
; ---------------------------------------------------------------------------

; capacity -> current allocated slot count.
(defn capacity ((self (ref (Vector T)))):usize
  (return (_get self cap)))

; reserve: ensure at least n total slots (grows by doubling until cap >= n).
(defn reserve ((self (ref (Vector T))) n:usize):void
  (while (< (_get self cap) n) (vector-grow self)))

; vector-init-capacity: initialise empty (default allocator) with >= n slots
; reserved. The with-capacity constructor for known-size builds.
(defn vector-init-capacity ((v (ref (Vector T))) n:usize):void
  (vector-init v)
  (reserve v n))

; ---------------------------------------------------------------------------
; Drop conformance: free the buffer through the stored allocator. Null-safe and
; idempotent (data is nulled so a double drop / post-move is a no-op).
; ---------------------------------------------------------------------------
(extend (Vector T) (Seq T))
(extend (Vector T) Drop)

(defn drop ((self (ptr (Vector T)))):void
  (when (!= (as ptr (_get self data)) null)
    (alloc-handle-free (.& self alloc)
                       (_get self data)
                       (* (_get self cap) (as usize (sizeof T)))
                       8))
  (.set! self data null)
  (.set! self len 0)
  (.set! self cap 0))

; ---------------------------------------------------------------------------
; VecIter T — a forward cursor over a Vector's elements. Iterator T conformance
; provides `next`; `iter-init` configures a caller-allocated VecIter to scan a
; Vector from the start.
;
;   (let ((it (ref (VecIter i32))) (alloca (VecIter i32)))
;     (iter-init it v)
;     (doseq (x it) ...))          ; doseq advances `it` via (next it)
;
; The iterator BORROWS the buffer (raw element pointer); it does not own it and
; must not outlive the Vector.
;
; NOTE: `iter-init` is the internal fill-in-place helper. The protocol surface
; is the value-returning `iter` (Coll conformance, defined below): it alloca's a
; VecIter, calls `iter-init`, and returns `(deref it)` by value through the SysV
; sret path. Consumers `(addr-of …)` the returned value to get the (ref (VecIter
; T)) that `next` wants (the doseq/into convention — C2.1).
; ---------------------------------------------------------------------------
(defstruct (VecIter T)
  data:ptr     ; element-typed buffer pointer (as to ptr:T on read)
  pos:usize
  len:usize)

(extend (VecIter T) (Iterator T))

(defn next ((self (ref (VecIter T)))) (Maybe T)
  (when (>= (self pos) (self len)) (return none))
  (let (v:T (aref (as ptr:T (self data)) (as i64 (self pos))))
    (.set! self pos (+ (self pos) 1))
    (return (some v))))

; iter-init: configure `it` to scan `v` from the start (borrowing its buffer).
; Internal helper: the value-returning `iter` (Coll conformance) wraps it.
(defn iter-init ((it (ref (VecIter T))) (v (ref (Vector T)))):void
  (.set! it data (as ptr (_get v data)))
  (.set! it pos 0)
  (.set! it len (_get v len)))

; ---------------------------------------------------------------------------
; Coll T (VecIter T) conformance. `iter` returns a fresh VecIter BY VALUE
; (alloca + iter-init + (deref …) — the spike pattern). Consumers `addr-of`
; the result to drive `next`. (extend is placed here because (VecIter T) must
; be declared before it can name the associated iterator type.)
; ---------------------------------------------------------------------------
(extend (Vector T) (Coll T (VecIter T)))

(defn iter ((self (ref (Vector T)))) (VecIter T)
  (let ((it (ref (VecIter T))) (alloca (VecIter T)))
    (iter-init it self)
    (return (deref it))))

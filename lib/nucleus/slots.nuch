; .nuch header for lib/nucleus/slots.nuc
(ns nucleus.slots)
(import-use nucleus.strview)
(import-use nucleus.intern)
(import-use nucleus.node)
(defenum SlotKind SLOT-UNKNOWN SLOT-TOP SLOT-HEAD SLOT-VALUE SLOT-PLACE SLOT-INLINE SLOT-NAME SLOT-BINDER SLOT-FIELD SLOT-ATTR SLOT-BINDINGS SLOT-PARAMS SLOT-DECL-PARAMS SLOT-OPTIONAL SLOT-RETURN SLOT-TYPE SLOT-TYPES SLOT-SIG SLOT-ARM SLOT-CLAUSE SLOT-PATTERN SLOT-QUOTED SLOT-TEMPLATE)
(defstruct FormSlots (a i32) (b i32) (c i32) (rest i32) (attrs bool) (desugar bool))
(declare form-slots-of ((h StrView)) :FormSlots)
(declare slot-head ((n (?ref Node))) :StrView)
(declare form-slots ((n (?ref Node))) :FormSlots)
(declare slot-of-elem ((own i32) (n (?ref Node)) (i i32)) :i32)
(declare slots-desugared? ((n (?ref Node))) :bool)
(declare slot-name ((k i32)) :StrView)

(extend String EdnCodec)
(defprotocol EdnKey)
(extend Keyword EdnKey)
(extend StrView EdnKey)
(extend i32 EdnKey)
(extend i64 EdnKey)
(declare edn-failed? ((r (ref ReadResult))) :bool)
(defn edn-read ((dst (ref T)) (n (?ref Node)) :where (EdnCodec T)) :ReadResult (return (edn-decode dst n)))
(defn edn-write ((out (ref String)) (v (ref T)) :where (EdnCodec T)) :!void (return (edn-encode out v)))
(extend (Vector T) EdnCodec :where (EdnCodec T))
(defn edn-decode ((dst (ref (Vector T))) (n (?ref Node)) :where (EdnCodec T)) :ReadResult (when (!= (edn-kind n) EDN-VECTOR) (return (edn-expected "a vector" n))) (init dst) (let (xp:ref:T (alloca T) len:usize (edn-count n) i:usize 0) (while (< i len) (let (r:ReadResult (edn-decode xp (edn-nth n i))) (when (edn-failed? (ref r)) (edn-release dst) (return r))) (conj dst (deref xp)) (set! i (+ i 1)))) (return (ok n)))
(defn edn-encode ((out (ref String)) (v (ref (Vector T))) :where (EdnCodec T)) :!void (write-str out "[") (let (len:usize (count v) i:usize 0) (while (< i len) (when (> i 0) (write-str out " ")) (let (e:T (v i)) (try (edn-encode out (ref e)))) (set! i (+ i 1)))) (write-str out "]") (return (ok)))
(defn edn-release ((v (ref (Vector T))) :where (EdnCodec T)) :void (let (i:usize (count v)) (while (> i 0) (set! i (- i 1)) (let (e:T (v i)) (edn-release (ref e))))) (drop v))
(extend (HashSet T) EdnCodec :where (EdnCodec T) (EdnKey T))
(defn edn-decode ((dst (ref (HashSet T))) (n (?ref Node)) :where (EdnCodec T) (EdnKey T)) :ReadResult (when (!= (edn-kind n) EDN-SET) (return (edn-expected "a set" n))) (init dst) (let (xp:ref:T (alloca T) len:usize (edn-count n) i:usize 0) (while (< i len) (let (r:ReadResult (edn-decode xp (edn-nth n i))) (when (edn-failed? (ref r)) (drop dst) (return r))) (conj dst (deref xp)) (set! i (+ i 1)))) (return (ok n)))
(defn edn-encode ((out (ref String)) (v (ref (HashSet T))) :where (EdnCodec T) (EdnKey T)) :!void (write-str out "#{") (let (first:bool true) (doseq (x v (HashSetIter T)) (when (not first) (write-str out " ")) (set! first false) (let (e:T x) (try (edn-encode out (ref e)))))) (write-str out "}") (return (ok)))
(defn edn-release ((v (ref (HashSet T))) :where (EdnCodec T) (EdnKey T)) :void (drop v))
(extend (HashMap K V) EdnCodec :where (EdnCodec K) (EdnKey K) (EdnCodec V))
(defn edn-decode ((dst (ref (HashMap K V))) (n (?ref Node)) :where (EdnCodec K) (EdnKey K) (EdnCodec V)) :ReadResult (when (!= (edn-kind n) EDN-MAP) (return (edn-expected "a map" n))) (init dst) (let (kp:ref:K (alloca K) vp:ref:V (alloca V) len:usize (edn-count n) i:usize 0) (while (< i len) (let (r:ReadResult (edn-decode kp (edn-key n i))) (when (edn-failed? (ref r)) (edn-release dst) (return r))) (let (r:ReadResult (edn-decode vp (edn-val n i))) (when (edn-failed? (ref r)) (edn-release dst) (return r))) (match (get dst (deref kp)) ((some old) (edn-release vp) (edn-release dst) (let (s:String (edn-text (edn-key n i))) (let (m:String (str "duplicate map key " (string-as-view (ref s)))) (drop (ref s)) (return (edn-err edn-dup-key (node-line (edn-key n i) (node-line n 0)) (ref m)))))) (none (assoc dst (deref kp) (deref vp)))) (set! i (+ i 1)))) (return (ok n)))
(defn edn-encode ((out (ref String)) (v (ref (HashMap K V))) :where (EdnCodec K) (EdnKey K) (EdnCodec V)) :!void (write-str out "{") (let (first:bool true) (doseq (en v (HashMapEntryIter K V)) (when (not first) (write-str out " ")) (set! first false) (let (k:K (en (quote key)) x:V (en (quote val))) (try (edn-encode out (ref k))) (write-str out " ") (try (edn-encode out (ref x)))))) (write-str out "}") (return (ok)))
(defn edn-release ((v (ref (HashMap K V))) :where (EdnCodec K) (EdnKey K) (EdnCodec V)) :void (doseq (en v (HashMapEntryIter K V)) (let (x:V (en (quote val))) (edn-release (ref x)))) (drop v))
(declare edn-put ((out (ref String)) (s StrView)) :void)
(declare edn-struct-map ((n (?ref Node)) (tag StrView)) :ReadResult)
(declare edn-field-listed? ((fields StrView) (name StrView)) :bool)
(declare edn-struct-keys ((m (?ref Node)) (tag StrView) (fields StrView)) :ReadResult)
(declare edn-at-key ((r ReadResult) (key StrView)) :ReadResult)
(defmacro edn-str-node (sym) (quasiquote (let (sn:ref:Node (alloc-node)) (set! (sn (quote kind)) NODE-STR) (set! (sn (quote s)) (unquote sym)) sn)))
(defmacro edn-derive-struct (t tag enc dec rel) (let (fields:ref:Node (struct-fields t) out:ref:Node (node-list-new (t (quote line))) encb:ref:Node (node-list-new (t (quote line))) decb:ref:Node (node-list-new (t (quote line))) undo:ref:Node (node-list-new (t (quote line))) names:String (String) tags:ref:Node (edn-str-node (tag (quote s)))) (init (ref names)) (node-push out (quote do)) (dotimes (i (ast-len fields)) (let (f:ptr:Node (ast-at fields i) fname:ptr:Node (ast-at f 0) ftype:ptr:Node (ast-at f 1) fe:ptr:Node (quasiquote edn-encode) fd:ptr:Node (quasiquote edn-decode) fr:ptr:Node (quasiquote edn-release) key:ref:Node (edn-str-node (fname (quote s))) place:ptr:Node (quasiquote (ref dst (quote (unquote fname))))) (let (hd:ptr:Node ftype) (when (= (ftype (quote kind)) NODE-LIST) (set! hd (ast-at ftype 0))) (let (hv:StrView (if (and (!= hd null) (= (hd (quote kind)) NODE-SYM)) (symbol-as-view (hd (quote s))) "")) (when (or (= hv "ptr") (= hv "CStr") (= hv "ref") (= hv "?ref") (strview-has-prefix hv "ref:") (strview-has-prefix hv "?ref:") (strview-has-prefix hv "ptr:") (strview-has-prefix hv "&") (strview-has-prefix hv "?&")) (let (m:String (str "derive-edn: field '" (symbol-as-view (fname (quote s))) "' is a pointer, which EDN cannot spell")) (macro-error t (string-as-view (ref m))))) (when (and (= (ftype (quote kind)) NODE-LIST) (= hv "struct")) (set! fe (gensym)) (set! fd (gensym)) (set! fr (gensym)) (node-push out (quasiquote (edn-derive-struct (unquote ftype) nucleus/struct (unquote fe) (unquote fd) (unquote fr))))))) (when (> i 0) (str-into (ref names) " ")) (str-into (ref names) (symbol-as-view (fname (quote s)))) (let (kt:String (str (if (= i 0) ":" " :") (symbol-as-view (fname (quote s))) " ")) (node-push encb (quasiquote (edn-put out (unquote (edn-str-node (symbol-intern (string-as-view (ref kt))))))))) (node-push encb (quasiquote (try ((unquote fe) out (unquote place))))) (let (prior:ref:Node undo) (node-push decb (quasiquote (let (r:ReadResult (edn-at-key ((unquote fd) (unquote place) (edn-get m (unquote key))) (unquote key))) (when (edn-failed? (ref r)) (unquote-splice prior) (return r))))) (set! undo (node-list-new (t (quote line)))) (node-push undo (quasiquote ((unquote fr) (unquote place)))) (doseq (u prior NodeIter) (node-push undo u))))) (let (fstr-node:ref:Node (edn-str-node (symbol-intern (string-as-view (ref names))))) (node-push out (quasiquote (defn (unquote enc) (out:ref:String (dst (ref (unquote t)))) :!void (edn-put out "#") (edn-put out (unquote tags)) (edn-put out " {") (unquote-splice encb) (edn-put out "}") (return (ok))))) (node-push out (quasiquote (defn (unquote dec) ((dst (ref (unquote t))) n:?ref:Node) :ReadResult (let (m:?ref:Node (try (edn-struct-map n (unquote tags)))) (try (edn-struct-keys m (unquote tags) (unquote fstr-node))) (unquote-splice decb) (return (ok n)))))) (node-push out (quasiquote (defn (unquote rel) ((dst (ref (unquote t)))) :void (unquote-splice undo) (return))))) out))
(defmacro derive-edn (:rest types) (let (out:ref:Node (node-list-new (types (quote line)))) (node-push out (quote do)) (doseq (t types NodeIter) (node-push out (quasiquote (edn-derive-struct (unquote t) (unquote (type-name t)) (unquote (quote edn-encode)) (unquote (quote edn-decode)) (unquote (quote edn-release))))) (node-push out (quasiquote (extend (unquote t) EdnCodec)))) out))

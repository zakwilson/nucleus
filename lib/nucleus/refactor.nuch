; .nuch header for lib/nucleus/refactor.nuc
(ns nucleus.refactor)
(import-use nucleus.error)
(import-use nucleus.strview)
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use nucleus.io)
(import-use nucleus.file)
(import-use nucleus.vector)
(import-use nucleus.coll)
(import-use nucleus.allocator)
(import-use nucleus.arena)
(import-use nucleus.intern)
(import-use nucleus.node)
(import-use nucleus.read)
(import-use nucleus.syntax)
(import-use nucleus.slots)
(deferror edit-overlap "two edits overlap")
(deferror edit-out-of-range "an edit lies outside the text it applies to")
(defstruct Edit (start usize) (end usize) (at usize) (len usize))
(defstruct Edits (buf String) (list (Vector Edit)) (sorted bool) (checked usize))
(defstruct EditError (code Err) (msg StrView) (first SynSpan) (second SynSpan))
(declare edit-error-code ((e EditError)) :Err)
(defcast EditError Err edit-error-code)
(defunion EditsResult (ok v:String) (err e:EditError))
(declare edits-new () :Edits)
(extend Edits Drop)
(defmethod "@nuc_drop.pnuc_Edits" drop ((self (ref Edits))) :void)
(declare edits-count ((e (ref Edits))) :usize)
(declare edit-before? ((a Edit) (b Edit)) :bool)
(declare edit-span ((e (ref Edits)) (start usize) (end usize) (text StrView)) :void)
(declare edit-replace ((e (ref Edits)) (s (ref Syn)) (text StrView)) :void)
(declare edit-text ((e (ref Edits)) (ed Edit)) :StrView)
(declare edits-merge-sort ((a (ref (Vector Edit))) (tmp (ref (Vector Edit))) (lo usize) (hi usize)) :void)
(declare edits-sort ((e (ref Edits))) :void)
(declare edits-drop-within ((e (ref Edits)) (start usize) (end usize)) :usize)
(declare edit-slice ((src StrView) (start usize) (end usize)) :StrView)
(declare edit-arena-str ((s (ref String))) :StrView)
(declare edit-describe ((out (ref String)) (src StrView) (sp SynSpan)) :void)
(declare edit-error ((code Err) (src StrView) (what StrView) (a SynSpan) (rel StrView) (b SynSpan)) :EditError)
(declare edit-span-of ((ed Edit)) :SynSpan)
(declare edits-check ((src StrView) (e (ref Edits)) (out (ref EditError))) :bool)
(declare edits-first-from ((l (ref (Vector Edit))) (start usize)) :usize)
(declare edits-apply-range ((src StrView) (e (ref Edits)) (start usize) (end usize)) :EditsResult)
(declare edits-first-at ((l (ref (Vector Edit))) (start usize)) :usize)
(declare edits-apply-outermost ((src StrView) (e (ref Edits)) (start usize) (end usize)) :EditsResult)
(declare edits-apply ((src StrView) (e (ref Edits))) :EditsResult)
(defenum RuleKind RULE-TEMPLATE RULE-REFUSE RULE-EMIT)
(defenum HoleLines LINES-REFUSE LINES-KEEP LINES-SHIFT)
(defstruct RwHole (syn (?ref Syn)) (list (?ref Syn)) (from i32) (splice bool))
(defstruct RwMatch (form (?ref Syn)) (names (?ref Node)) (holes (Vector RwHole)) (lines i32) (text String) (kept (Vector SynSpan)) (col0 i32) (refusal StrView))
(defstruct Rule (kind i32) (pat (?ref Node)) (tmpl (?ref Node)) (reason StrView) (flag StrView) (lines i32) (names (?ref Node)) (guard ((fn bool) ((ref RwMatch)))) (emit ((fn void) ((ref RwMatch)))) (hits usize) (refused usize))
(defstruct Rules (name StrView) (rules (Vector Rule)))
(declare rw-rules-new ((name StrView)) :ref:Rules)
(declare rw-add ((rs (ref Rules)) (kind i32) (pat (?ref Node)) (tmpl (?ref Node)) (reason StrView) (flag StrView) (lines i32) (names (?ref Node)) (guard ((fn bool) ((ref RwMatch)))) (emit ((fn void) ((ref RwMatch))))) :void)
(declare rw-wrapped ((p (?ref Node)) (head StrView)) :?ref:Node)
(declare rw-name-index ((names (?ref Node)) (x (?ref Node))) :i32)
(declare rw-bind ((m (ref RwMatch)) (name (?ref Node)) (h RwHole)) :void)
(declare rw-kid ((s (?ref Syn)) (i i32)) :?ref:Syn)
(declare rw-match ((m (ref RwMatch)) (p (?ref Node)) (n (?ref Node)) (s (?ref Syn))) :bool)
(declare rw-unspanned ((m (ref RwMatch))) :?ref:Node)
(declare rw-hole ((m (ref RwMatch)) (i i32)) :ref:Syn)
(declare rw-splice ((m (ref RwMatch)) (i i32)) (ref (Vector (ref Syn))))
(declare rw-self ((m (ref RwMatch))) :ref:Syn)
(defstruct RwReport (start usize) (line i32) (col i32) (rule i32) (flagged bool) (reason StrView))
(defstruct Rewriter (src StrView) (file (?ref SynFile)) (edits (?ref Edits)) (table (ref (Vector RMacro))) (rules (ref Rules)) (reports (ref (Vector RwReport))) (rewrites usize) (in-strings bool) (depth i32) (strings usize) (fragments usize) (skipped usize) (carry bool))
(extern (g-rw (?ref Rewriter)))
(declare rw-cur () :ref:Rewriter)
(declare rw-column ((text StrView) (at usize) (base i32)) :i32)
(declare rw-col ((out (ref RwMatch))) :i32)
(declare rw-form-col ((out (ref RwMatch))) :i32)
(declare rw-put ((out (ref RwMatch)) (text StrView)) :void)
(declare rw-refuse-text ((out (ref RwMatch)) (why StrView)) :void)
(declare rw-put-gap ((out (ref RwMatch)) (from usize) (to usize) (indent i32)) :void)
(declare rw-in-string? ((s (ref Syn)) (at usize)) :bool)
(declare rw-put-shifted ((out (ref RwMatch)) (text StrView) (delta i32)) :void)
(declare rw-in-file-string? ((f (ref SynFile)) (at usize)) :bool)
(declare rw-multiline? ((v StrView)) :bool)
(declare rw-put-range ((out (ref RwMatch)) (start usize) (end usize)) :void)
(declare rw-put-syn ((out (ref RwMatch)) (s (ref Syn))) :void)
(declare rw-splice-empty? ((h RwHole)) :bool)
(declare rw-put-splice ((out (ref RwMatch)) (h RwHole)) :void)
(declare rw-hole-of ((out (ref RwMatch)) (name (?ref Node))) :RwHole)
(declare rw-has-hole? ((t (?ref Node)) (level i32)) :bool)
(declare rw-elem-level ((t (?ref Node)) (i i32) (level i32)) :i32)
(declare rw-put-node ((out (ref RwMatch)) (t (?ref Node)) (level i32)) :void)
(declare rw-prefix-reads-back? ((out (ref RwMatch)) (mark usize) (inner usize) (t (?ref Node))) :bool)
(declare src-text ((s (ref Syn))) :StrView)
(declare same-text? ((a (ref Syn)) (b (ref Syn))) :bool)
(declare src-slice ((start usize) (end usize)) :StrView)
(declare in-string? ((s (ref Syn))) :bool)
(declare prefix-form? ((s (ref Syn))) :bool)
(declare spelled? ((s (ref Syn)) (prefix StrView)) :bool)
(declare has-comment? ((s (ref Syn))) :bool)
(declare has-discard? ((s (ref Syn))) :bool)
(declare operand-of? ((s (ref Syn)) (head (ref Node)) (i i32)) :bool)
(declare slot-kind ((s (ref Syn))) :i32)
(declare rw-slot-path ((own i32) (n (?ref Node)) (target (?ref Node))) :i32)
(declare rw-wrapper ((p (ref Syn)) (k (ref Syn))) :StrView)
(declare rw-qq-level ((s (ref Syn))) :i32)
(declare rw-under? ((s (ref Syn)) (head StrView)) :bool)
(declare in-quote? ((s (ref Syn))) :bool)
(declare in-quasiquote? ((s (ref Syn))) :bool)
(declare in-unquote? ((s (ref Syn))) :bool)
(declare rw-report ((rw (ref Rewriter)) (s (ref Syn)) (rule usize) (flagged bool) (why StrView)) :void)
(declare edits-outermost ((e (ref Edits))) (ref (Vector Edit)))
(declare rw-map-edits ((e (ref Edits)) (ie (ref Edits)) (ss (ref StrSource))) :bool)
(declare rw-map-report ((rw (ref Rewriter)) (s (ref Syn)) (ss (ref StrSource)) (p RwReport)) :RwReport)
(declare rw-string ((rw (ref Rewriter)) (s (ref Syn))) :void)
(declare rw-string-source ((rw (ref Rewriter)) (s (ref Syn)) (ss (ref StrSource)) (carry bool)) :void)
(declare edits-check-outermost ((src StrView) (e (ref Edits))) :bool)
(declare rw-refuse ((rw (ref Rewriter)) (s (ref Syn)) (j usize) (why StrView)) :void)
(declare rw-match-reset ((m (ref RwMatch)) (s (ref Syn)) (r (ref Rule)) (src StrView)) :void)
(declare rw-drops? ((m (ref RwMatch)) (s (ref Syn)) (spans (ref (Vector SynSpan)))) :bool)
(declare rw-try ((rw (ref Rewriter)) (m (ref RwMatch)) (s (ref Syn)) (j usize)) :bool)
(declare rw-visit-kids ((rw (ref Rewriter)) (m (ref RwMatch)) (ks (ref (Vector (ref Syn))))) :void)
(declare rw-visit ((rw (ref Rewriter)) (m (ref RwMatch)) (s (ref Syn))) :void)
(declare rw-sort-reports ((v (ref (Vector RwReport)))) :void)
(defstruct Rewrite (text String) (reports (ref (Vector RwReport))) (rewrites usize) (strings usize) (fragments usize) (skipped usize))
(extend Rewrite Drop)
(defmethod "@nuc_drop.pnuc_Rewrite" drop ((self (ref Rewrite))) :void)
(defunion RewriteResult (ok v:Rewrite) (err e:ReadError))
(declare rw-init ((rw (ref Rewriter)) (src StrView) (f (ref SynFile)) (e (ref Edits)) (rules (ref Rules)) (reports (ref (Vector RwReport))) (in-strings bool) (depth i32)) :void)
(declare rw-run-pass ((rw (ref Rewriter))) :void)
(declare rewrite-source ((rules (ref Rules)) (src StrView)) :RewriteResult)
(declare rewrite-source-in-strings ((rules (ref Rules)) (src StrView)) :RewriteResult)
(declare rw-rewrite ((rules (ref Rules)) (src StrView) (in-strings bool)) :RewriteResult)
(defstruct RwRun (apply bool) (in-strings bool) (files usize) (changed usize) (rewrites usize) (reported usize) (failed usize) (unread usize) (strings usize) (fragments usize) (skipped usize))
(declare rw-read-file ((path StrView)) :!String)
(declare rw-write-file ((path StrView) (text StrView)) :!void)
(declare rw-run-file ((rules (ref Rules)) (run (ref RwRun)) (path StrView)) :void)
(declare rw-run-arg ((rules (ref Rules)) (run (ref RwRun)) (a StrView)) :void)
(declare rw-arg ((argv ptr) (i i32)) :StrView)
(declare refactor-main ((argc i32) (argv ptr) (rules (ref Rules))) :i32)
(defstruct RwForm (bad (?ref Node)) (msg StrView) (kind i32) (pat (?ref Node)) (tmpl (?ref Node)) (reason (?ref Node)) (flag (?ref Node)) (lines i32) (names (ref Node)) (splices (ref Node)) (guard (?ref Node)) (emit (?ref Node)))
(declare rw-form-fail ((f (ref RwForm)) (at (?ref Node)) (msg String)) :void)
(declare rw-sym-is? ((n (?ref Node)) (kind i32) (name StrView)) :bool)
(declare rw-sym-text ((n (?ref Node))) :StrView)
(declare rw-str-node ((s Symbol)) :ref:Node)
(declare rw-form-splice? ((f (ref RwForm)) (h (?ref Node))) :bool)
(declare rw-pat-holes ((f (ref RwForm)) (at (ref Node)) (p (?ref Node)) (last bool)) :void)
(declare rw-tmpl-check ((f (ref RwForm)) (at (ref Node)) (t (?ref Node)) (level i32) (in-list bool)) :void)
(declare rw-parse-rule ((r (ref Node))) :ref:RwForm)
(defmacro defrewrite (name :rest rules) (when (!= (name (quote kind)) NODE-SYM) (macro-error name "defrewrite: the first argument is the rule set's name")) (let (rs:ptr (gensym) m:ptr (gensym) adds:ref:Node (node-list-new (name (quote line)))) (doseq (r rules NodeIter) (let (f:ref:RwForm (rw-parse-rule r)) (when (!= (f (quote bad)) null) (macro-error (f (quote bad)) (f (quote msg)))) (let (binds:ref:Node (node-list-new (r (quote line))) names:ref:Node (f (quote names))) (dotimes (i (ast-len names)) (let (h:ptr:Node (ast-at names i)) (node-extend binds (if (rw-form-splice? f h) (quasiquote (((unquote h) (ref (Vector (ref Syn)))) (rw-splice (unquote m) (unquote (node-int i))))) (quasiquote (((unquote h) (ref Syn)) (rw-hole (unquote m) (unquote (node-int i))))))))) (node-extend binds (quasiquote (((unquote (quote self)) (ref Syn)) (rw-self (unquote m)) ((unquote (quote out)) (ref RwMatch)) (unquote m)))) (node-push adds (quasiquote (rw-add (unquote rs) (unquote (node-int (f (quote kind)))) (quote (unquote (f (quote pat)))) (quote (unquote (f (quote tmpl)))) (unquote (f (quote reason))) (unquote (f (quote flag))) (unquote (node-int (f (quote lines)))) (quote (unquote names)) (fn (((unquote m) (ref RwMatch))) :bool (let (unquote binds) (return (unquote (f (quote guard)))))) (fn (((unquote m) (ref RwMatch))) :void (let (unquote binds) (unquote (f (quote emit)))) (return)))))))) (quasiquote (defn (unquote name) () :ref:Rules (let (((unquote rs) (ref Rules)) (rw-rules-new (unquote (rw-str-node (name (quote s)))))) (unquote-splice adds) (return (unquote rs)))))))

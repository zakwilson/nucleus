(defmacro defrewrite (name :rest rules) (when (!= (name (quote kind)) NODE-SYM) (macro-error name "defrewrite: the first argument is the rule set's name")) (let (rs:ptr (gensym) m:ptr (gensym) adds:ref:Node (node-list-new (name (quote line)))) (doseq (r rules NodeIter) (let (f:ref:RwForm (rw-parse-rule r)) (when (!= (f (quote bad)) null) (macro-error (f (quote bad)) (f (quote msg)))) (let (binds:ref:Node (node-list-new (r (quote line))) names:ref:Node (f (quote names))) (dotimes (i (ast-len names)) (let (h:ptr:Node (ast-at names i)) (node-extend binds (if (rw-form-splice? f h) (quasiquote (((unquote h) (ref (Vector (ref Syn)))) (rw-splice (unquote m) (unquote (node-int i))))) (quasiquote (((unquote h) (ref Syn)) (rw-hole (unquote m) (unquote (node-int i))))))))) (node-extend binds (quasiquote (((unquote (quote self)) (ref Syn)) (rw-self (unquote m)) ((unquote (quote out)) (ref RwMatch)) (unquote m)))) (node-push adds (quasiquote (rw-add (unquote rs) (unquote (node-int (f (quote kind)))) (quote (unquote (f (quote pat)))) (quote (unquote (f (quote tmpl)))) (unquote (f (quote reason))) (unquote (f (quote flag))) (unquote (node-int (f (quote lines)))) (quote (unquote names)) (fn (((unquote m) (ref RwMatch))) :bool (let (unquote binds) (return (unquote (f (quote guard)))))) (fn (((unquote m) (ref RwMatch))) :void (let (unquote binds) (unquote (f (quote emit)))) (return)))))))) (quasiquote (defn (unquote name) () :ref:Rules (let (((unquote rs) (ref Rules)) (rw-rules-new (unquote (rw-str-node (name (quote s)))))) (unquote-splice adds) (return (unquote rs)))))))

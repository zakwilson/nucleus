(defstruct RDef (file StrView) (start i64) (end i64) (name StrView) (ns StrView) (key StrView) (kind StrView) (form StrView) (link StrView) (macro StrView) (private bool) (host bool))
(defstruct Report (unit StrView) (files (Vector StrView)) (defs (Vector RDef)) (refs (Vector RRef)) (spans (HashMap Symbol i64)) (targets (HashMap Symbol (ref (Vector usize)))) (calls (HashMap Symbol (ref (Vector usize)))) (loose (HashMap Symbol (ref (Vector usize)))) (by-file (HashMap Symbol (ref (Vector usize)))) (defs-by-file (HashMap Symbol (ref (Vector usize)))) (calls-by-file (HashMap Symbol (ref (Vector usize)))) (def-names (HashMap Symbol usize)) (macros (HashMap Symbol usize)))

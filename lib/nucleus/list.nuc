; List manipulation primitives over the AST `Node` type.
;
; A list Node is a header over an array of element pointers (see lib/node.nuc);
; `cons` prepends, `first`/`rest` read. Retained for the examples that still
; spell a list this way — `Node` conforms to `Coll`/`Seq` directly now, so this
; layer is scheduled for retirement
; (design/stage21-cleanup/ast-as-collection.md §8.5).

(import-use node)
(import-use iterator)

(defn cons (car:ptr cdr:ptr):ptr
  (return (as ptr (node-cons car cdr 0))))

(defn first (n:ptr):ptr
  (return (node-first n)))

(defn rest (n:ptr):ptr
  (return (node-rest n)))

(defn append (a:ptr b:ptr):ptr
  (let (out:&Node (node-list-new 0))
    (node-extend out a)
    (node-extend out b)
    (return (node-list-done out))))

; ---------------------------------------------------------------------------
; ListIter — drive a Node list as an Iterator, yielding each element.
;
; The element is a Node* (a `ptr`). Since niche-encoded `(Maybe ptr)` is now
; matchable, the iterator yields `ptr` directly. Recover each element in a
; consumer with (cast ptr:Node elem).
;
; LIFETIME: the iterator holds a view of the list and does NOT own it; the list
; must outlive the iterator.
; ---------------------------------------------------------------------------
(defstruct ListIter
  cur:ptr)

(extend ListIter (Iterator ptr))

(defn next (self:&ListIter):?ptr
  (let (c:ptr (self 'cur))
    (when (= (node-len c) 0) (return none))
    (set! (self 'cur) (rest c))
    (return (as-ref (first c)))))

; list-iter — a ListIter positioned at the head of `lst` (null = empty list).
; Returned BY VALUE (alloca + set + deref), the value-return convention the
; other iterators use; drive with &it + next, or via doseq-iter.
(defn list-iter (lst:ptr):ListIter
  (let (it:&ListIter (alloca ListIter))
    (set! (it 'cur) lst)
    (return @it)))

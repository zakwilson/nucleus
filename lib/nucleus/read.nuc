; read.nuc: text to `Node`.
;
; Design: design/stage18-tooling/overview.md §T6.3 (the library reader),
; design/stage21-cleanup/one-reader.md (growing it into THE reader).
;
; Every Nucleus program is already handed `Node` and `NodeKind` by the prelude
; and no way to build one from text. This is that way — for a config file, a
; serialized value, a test-result protocol, or anything else that wants
; s-expressions as data.
;
; It agrees with the compiler's own reader (`src/reader.nuc`) on the whole
; written language, which the parity gate checks over the corpus, and words
; every refusal exactly as the compiler does. The reader-macro table is the
; `Reader`'s: seeded with the six built-ins, extended by a top-level
; `(def-rmacro "p" sym)` as it is read, so the prefix works for the rest of
; that `Reader`'s input.
;
; See docs/reading.md.

(ns nucleus.read)

(import-use nucleus.error)
(import-use nucleus.strview)
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use nucleus.vector)
(import-use nucleus.allocator)
(import-use nucleus.arena)
(import-use nucleus.intern)
(import-use nucleus.node)
(import-use nucleus.syntax)
(import-use nucleus.const)

(deferror read-eof "unexpected end of input")
(deferror read-unterminated-list "unterminated list")
(deferror read-unexpected-close "unexpected close bracket")
(deferror read-unterminated-string "unterminated string literal")
(deferror read-bad-escape "unknown escape in string literal")
(deferror read-bad-char "invalid char literal")
(deferror read-int-range "integer literal out of range")
(deferror read-empty-segment "empty segment in colon-chain")
(deferror read-map-odd "map literal: odd number of elements")
(deferror read-bad-rmacro "bad def-rmacro form")
(deferror read-bad-tag "bad tagged literal")
(deferror read-bad-discard "#_ with no form to discard")

; What brackets a literal cell was read from, stamped on its unused `i`: the
; text `(vector-lit 1)` and `[1]` are otherwise the same tree, and EDN needs to
; tell them apart (design/stage22-edn/overview.md §2).
(defenum LitMark LIT-NONE LIT-VECTOR LIT-MAP LIT-SET LIT-TAGGED)

; ---------------------------------------------------------------------------
; The error value: the code a program `match`es on, plus the line and the text
; the compiler prints. `Err` is the code tier and this is the payload tier;
; the `defcast` is the bridge, so a `!T` caller can `try` a read unchanged.
; ---------------------------------------------------------------------------

(defstruct ReadError code:Err line:i32 msg:StrView note:StrView)

(defn read-error-code (e:ReadError):Err (return (e 'code)))
(defcast ReadError Err read-error-code)

; Not `(Result ptr:Node ReadError)`: a template stamp re-spells `ptr:Node` as
; `ptr:Node`, so that instance could not carry `()`, the null node. Same arms,
; so `try`/`unwrap`/`match` treat it as a Result.
(defunion ReadResult (ok v:?&Node) (err e:ReadError))

; A call, not a struct literal: a two-element list in a positional initializer
; slot reads as a `(field value)` pair.
(defn rd-error (code:Err line:i32 msg:StrView note:StrView):ReadError
  (return (ReadError code line msg note)))

; A message's variable part, copied into the arena beside the nodes it
; describes, so nothing the reader returns is owned.
(defn rd-arena-str (s:&String):StrView
  (let (v:StrView (string-as-view s)
        n:usize (v 'len)
        p:ptr (arena-bytes (v 'data) (as i64 n)))
    (drop s)
    (return (strview (unsafe/cast &ui8 p) n))))

; ---------------------------------------------------------------------------
; Reader macros: `prefix` at a token boundary reads the next form as
; `(wrap form)`. Longest prefix wins, so the table's order carries no meaning.
; ---------------------------------------------------------------------------

(defstruct RMacro prefix:StrView wrap:Symbol)

; A table lives as long as the nodes read through it, so it is built in the
; arena like everything else the reader hands out, and never dropped.
(defn rd-macro-table ():&(Vector RMacro)
  (let (tbl:&(Vector RMacro) (unsafe/cast &(Vector RMacro)
                                (arena-alloc (sizeof (Vector RMacro)))))
    (init tbl (handle g-arena))
    (return tbl)))

; The prefix is interned so a table outlives whatever buffer it was spelled in.
(defn rd-macro-add (tbl:&(Vector RMacro) prefix:StrView wrap:Symbol):void
  (let (rm:&RMacro (alloca RMacro))
    (set! (rm 'prefix) (symbol-as-view (symbol-intern prefix)))
    (set! (rm 'wrap) wrap)
    (conj tbl @rm)))

; The index of the row whose prefix is exactly `prefix`, or -1.
(defn rd-macro-find (tbl:&(Vector RMacro) prefix:StrView):i32
  (let (n:usize (count tbl)
        i:usize 0)
    (while (< i n)
      (let (rm:RMacro (invoke tbl i))
        (when (= (rm 'prefix) prefix) (return (unsafe/cast i32 i))))
      (set! i (+ i 1)))
    (return -1)))

; A fresh table holding the six built-ins, for a caller that wants to own one
; (a REPL session's, shared across its inputs through `reader-with-macros`).
(defn read-macro-table-new ():&(Vector RMacro)
  (let (tbl:&(Vector RMacro) (rd-macro-table))
    (rd-macro-add tbl "~@" (symbol-intern "unquote-splice"))
    (rd-macro-add tbl "~" (symbol-intern "unquote"))
    (rd-macro-add tbl "'" (symbol-intern "quote"))
    (rd-macro-add tbl "`" (symbol-intern "quasiquote"))
    (rd-macro-add tbl "@" (symbol-intern "deref"))
    ; `&x` is `(ref x)` only at a token boundary; the mid-atom `&` is the `ref:`
    ; sigil. One head for both worlds: a type slot reads `(ref T)` as the
    ; non-null pointer, a value slot as address-of (pointer-kind-spellings.md §3).
    (rd-macro-add tbl "&" (symbol-intern "ref"))
    (return tbl)))

; ---------------------------------------------------------------------------
; Reader state
; ---------------------------------------------------------------------------

(defstruct Reader
  src:StrView
  pos:usize
  line:i32
  ; Bracket balance, per buffer (design/stage15-stress-test/diagnostics.md
  ; §W4c). Not clamped at zero: a negative depth is "this closer has no opener".
  paren-depth:i32
  form-open-line:i32
  col0-open-line:i32
  col0-open-depth:i32
  macros:&(Vector RMacro)
  ; EDN data, not Nucleus source: no reader macros, `&` sigil, colon-paren
  ; fuse, `def-rmacro` or `c"…"`; `N`/`M` number suffixes.
  edn:bool
  ; Syntax mode (docs/reading.md): null for an ordinary read.
  syn:?&SynBuilder)

; A reader over `src` whose reader-macro table is `table`, which the caller
; owns and may share with the readers it builds next.
(defn reader-with-macros (src:StrView table:&(Vector RMacro)):Reader
  (let (r:&Reader (alloca Reader))
    (set-fields! r
                 'src             src
                 'pos             0
                 'line            1
                 'paren-depth     0
                 'form-open-line  0
                 'col0-open-line  0
                 'col0-open-depth 0
                 'macros          table
                 'edn             false
                 'syn             null)
    (return @r)))

(defn reader (src:StrView):Reader
  (return (reader-with-macros src (read-macro-table-new))))

; A reader for EDN text (design/stage22-edn/overview.md).
(defn reader-edn (src:StrView):Reader
  (let (tbl:&(Vector RMacro) (rd-macro-table)
        r:Reader (reader-with-macros src tbl))
    (set! (r 'edn) true)
    (return r)))

; 0 at end of input, exactly as the compiler's NUL sentinel behaves -- so an
; embedded NUL byte ends the text in both readers rather than in neither.
(defn rd-at (self:&Reader i:usize):i32
  (let (sv:StrView (self 'src))
    (when (>= i (sv 'len)) (return 0))
    (return (bit-and (as i32 (aref (sv 'data) (as i64 i))) 255))))

(defn rd-peek (self:&Reader):i32
  (return (rd-at self (self 'pos))))

(defn rd-peek1 (self:&Reader):i32
  (return (rd-at self (+ (self 'pos) 1))))

(defn rd-next (self:&Reader):i32
  (let (c:i32 (rd-peek self))
    (when (= c 0) (return 0))
    (set! (self 'pos) (+ (self 'pos) 1))
    (when (= c 10) (set! (self 'line) (+ (self 'line) 1)))
    (return c)))

; Called BEFORE the bracket is consumed, so the byte at pos-1 is the lookbehind.
; Only a `(` is a column-0 candidate: a top-level form is a parenthesised list.
(defn rd-open-bracket (self:&Reader line:i32 is-paren:bool):void
  (let (pos:usize (self 'pos)
        depth:i32 (self 'paren-depth))
    (when (= depth 0) (set! (self 'form-open-line) line))
    (when (and is-paren (> depth 0) (= (self 'col0-open-line) 0)
               (or (= pos 0) (= (rd-at self (- pos 1)) 10)))
      (set! (self 'col0-open-line) line)
      (set! (self 'col0-open-depth) depth))
    (set! (self 'paren-depth) (+ depth 1))))

(defn rd-close-bracket (self:&Reader):void
  (set! (self 'paren-depth) (- (self 'paren-depth) 1)))

; The note names the first column-0 form opened while this one was still open;
; with no such candidate it says only how many forms EOF left open.
(defn rd-unterminated (self:&Reader open-line:i32 msg:StrView closer:StrView):ReadError
  (let (note:&String (alloca String)
        c0:i32 (self 'col0-open-line))
    (init note)
    (if (and (!= c0 0) (!= c0 open-line))
      (str-into note "line " c0 " starts a new form in column 0 while "
                (self 'col0-open-depth) " form(s) are still open -- a '" closer
                "' is probably missing before line " c0)
      (str-into note "end of file reached with " (self 'paren-depth)
                " form(s) still open"))
    (return (rd-error read-unterminated-list open-line msg (rd-arena-str note)))))

; The C locale's `isspace` set. The reader skips commas too; callers test that.
(defn rd-space? (c:i32):bool
  (when (= c 32) (return true))
  (when (and (>= c 9) (<= c 13)) (return true))
  (return false))

(defn rd-digit? (c:i32):bool
  (return (and (>= c 48) (<= c 57))))

(defn rd-hex-val (c:i32):i32
  (return (cond (and (>= c 48) (<= c 57)) (- c 48)
                (and (>= c 97) (<= c 102)) (+ (- c 97) 10)
                (and (>= c 65) (<= c 70)) (+ (- c 65) 10)
                true -1)))

(defn rd-syn-comment (self:&Reader sb:&SynBuilder):void
  (let (at:usize (self 'pos))
    (while (and (!= (rd-peek self) 0) (!= (rd-peek self) 10))
      (rd-next self))
    (syn-comment sb at (self 'pos))))

(defn rd-skip-ws (self:&Reader):void
  (while true
    (let (c:i32 (rd-peek self))
      (when (= c 0) (return))
      (cond (or (rd-space? c) (= c 44))
              (rd-next self)
            ; Syntax mode scans its own copy so this loop stays hook-free (overview.md §8).
            (= c 59)                       ; ';' to end of line
              (let (sb:?&SynBuilder (self 'syn))
                (if (= sb null)
                  (while (and (!= (rd-peek self) 0) (!= (rd-peek self) 10))
                    (rd-next self))
                  (rd-syn-comment self sb)))
            true
              (return)))))

; Not NUL, whitespace, `,` or one of `( ) " ; [ ] { }`.
(defn rd-sym-char? (c:i32):bool
  (return (not (or (contains? #{0 34 40 41 44 59 91 93 123 125} c)
                   (rd-space? c)))))

; The slice from `start` to the current position.
(defn rd-slice (self:&Reader start:usize):StrView
  (let (sv:StrView (self 'src))
    (return (strview (unsafe/ptr+ (sv 'data) (as i64 start)) (- (self 'pos) start)))))

; ---------------------------------------------------------------------------
; Atom classification -- these mirror src/reader.nuc exactly, because an atom
; that classifies differently in the two readers is a silently different tree.
; ---------------------------------------------------------------------------

(defn rd-tv-at (tv:&StrView i:usize):i32
  (when (>= i (tv 'len)) (return 0))
  (return (bit-and (as i32 (aref (tv 'data) (as i64 i))) 255)))

(defn rd-int-atom? (tv:&StrView):bool
  (let (n:usize (tv 'len)
        i:usize 0)
    (when (= n 0) (return false))
    (let (c0:i32 (rd-tv-at tv 0))
      (when (or (= c0 45) (= c0 43)) (set! i 1)))
    (when (= i n) (return false))
    (while (< i n)
      (when (not (rd-digit? (rd-tv-at tv i))) (return false))
      (set! i (+ i 1)))
    (return true)))

; 0 = not hex, 1 = hex integer, 2 = hex float. C makes the binary exponent
; mandatory on a hex float, which is what separates the two.
(defn rd-hex-kind (tv:&StrView):i32
  (let (n:usize (tv 'len)
        i:usize 0)
    (when (< n 3) (return 0))
    (let (c0:i32 (rd-tv-at tv 0))
      (when (or (= c0 43) (= c0 45)) (set! i 1)))
    (when (> (+ i 3) n) (return 0))
    (when (!= (rd-tv-at tv i) 48) (return 0))
    (let (c1:i32 (rd-tv-at tv (+ i 1)))
      (when (and (!= c1 120) (!= c1 88)) (return 0)))
    (set! i (+ i 2))
    (let (digits:bool false
          seen-dot:bool false)
      (while (and (< i n) (>= (rd-hex-val (rd-tv-at tv i)) 0))
        (set! digits true)
        (set! i (+ i 1)))
      (when (and (< i n) (= (rd-tv-at tv i) 46))
        (set! seen-dot true)
        (set! i (+ i 1))
        (while (and (< i n) (>= (rd-hex-val (rd-tv-at tv i)) 0))
          (set! digits true)
          (set! i (+ i 1))))
      (when (not digits) (return 0))
      (when (= i n)
        (when seen-dot (return 0))
        (return 1))
      (let (cp:i32 (rd-tv-at tv i))
        (when (and (!= cp 112) (!= cp 80)) (return 0)))
      (set! i (+ i 1))
      (let (cs:i32 (rd-tv-at tv i))
        (when (and (< i n) (or (= cs 43) (= cs 45))) (set! i (+ i 1))))
      (let (edig:bool false)
        (while (and (< i n) (rd-digit? (rd-tv-at tv i)))
          (set! edig true)
          (set! i (+ i 1)))
        (when (not edig) (return 0))
        (when (!= i n) (return 0))
        (return 2)))))

(defn rd-float-atom? (tv:&StrView):bool
  (let (n:usize (tv 'len)
        i:usize 0)
    (when (= n 0) (return false))
    (when (= n 6)
      (let (v:StrView @tv)
        (when (or (= v "+inf.0") (or (= v "-inf.0") (= v "+nan.0"))) (return true))))
    (let (c0:i32 (rd-tv-at tv 0))
      (when (or (= c0 43) (= c0 45)) (set! i 1)))
    (let (digits-before:bool false
          digits-after:bool false
          digits-exp:bool false
          saw-dot:bool false
          saw-e:bool false)
      (while (and (< i n) (rd-digit? (rd-tv-at tv i)))
        (set! digits-before true)
        (set! i (+ i 1)))
      (when (and (< i n) (= (rd-tv-at tv i) 46))
        (set! saw-dot true)
        (set! i (+ i 1))
        (while (and (< i n) (rd-digit? (rd-tv-at tv i)))
          (set! digits-after true)
          (set! i (+ i 1))))
      (let (ce:i32 (rd-tv-at tv i))
        (when (and (< i n) (or (= ce 101) (= ce 69)))
          (set! saw-e true)
          (set! i (+ i 1))
          (let (cs:i32 (rd-tv-at tv i))
            (when (and (< i n) (or (= cs 43) (= cs 45))) (set! i (+ i 1))))
          (while (and (< i n) (rd-digit? (rd-tv-at tv i)))
            (set! digits-exp true)
            (set! i (+ i 1)))))
      (return (not (or (!= i n)
                       (and (not saw-dot) (not saw-e))
                       (and (not digits-before) (not digits-after))
                       (and saw-e (not digits-exp))))))))

; The two-step the compiler's `lex-int-value` performs: a non-negative literal
; that overflows signed i64 may still be a ui64/usize value, and its bits go
; into the signed field where two's-complement wrap reproduces it.
(defn rd-int-value (tv:StrView radix:i32):!i64
  (let (start:usize 0
        neg:i32 (strview-parse-sign tv &start)
        digits:StrView (strview-drop-bytes tv start)
        smax:ui64 (if (!= neg 0) 9223372036854775808 9223372036854775807))
    (when (and (= radix 16)
               (or (strview-has-prefix digits "0x") (strview-has-prefix digits "0X")))
      (set! digits (strview-drop-bytes digits 2)))
    (match (strview-parse-magnitude digits radix smax)
      ((ok m) (if (!= neg 0)
                (return (ok (- 0 (unsafe/cast i64 m))))
                (return (ok (unsafe/cast i64 m)))))
      ((err e) 0))
    (when (!= neg 0) (return (err! read-int-range)))
    (match (strview-parse-magnitude digits radix 18446744073709551615)
      ((ok m2) (return (ok (unsafe/cast i64 m2))))
      ((err e2) (do)))
    (return (err! read-int-range))))

; ---------------------------------------------------------------------------
; Colon chains. `chain-seg-at` is the one splitter: the sigil expansion, the
; fuse, the compiler's desugar and refactoring tools all segment through it
; (design/stage26-refactoring/overview.md §4.2).
; ---------------------------------------------------------------------------

; A segment's byte offsets in its chain's text: the sigil run [start, body),
; the body [body, end), and `colon` when a `:` follows at `end`.
(defstruct ChainSeg start:usize body:usize end:usize colon:bool)

; A segment starts with its run of `?`, `!` and `&`; anywhere else they are body bytes.
(defn chain-sigil? (c:i32):bool
  (return (or (= c 63) (= c 33) (= c 38))))

; The segment starting at `at`: 0, or one past a segment's `colon`.
(defn chain-seg-at (text:StrView at:usize):ChainSeg
  (let (tp:&StrView &text
        n:usize (text 'len)
        i:usize at)
    (while (and (< i n) (chain-sigil? (rd-tv-at tp i)))
      (set! i (+ i 1)))
    (let (body:usize i)
      (while (and (< i n) (!= (rd-tv-at tp i) 58))
        (set! i (+ i 1)))
      (return (ChainSeg at body i (< i n))))))

(defn chain-seg-next (text:StrView seg:ChainSeg):ChainSeg
  (return (chain-seg-at text (+ (seg 'end) 1))))

; The segment's text, its sigils included and its `:` not.
(defn chain-seg-text (text:StrView seg:ChainSeg):StrView
  (return (strview-take-bytes (strview-drop-bytes text (seg 'start)) (- (seg 'end) (seg 'start)))))

(defstruct Chain text:StrView keyword:bool segs:(Vector ChainSeg))

; A raw atom's segments, arena-allocated. A keyword's leading `:` separates
; nothing, so its segments start at byte 1 and none of them is a name.
(defn chain-segments (text:StrView):&Chain
  (let (c:&Chain (unsafe/cast &Chain (arena-alloc (sizeof Chain)))
        kw:bool (and (> (text 'len) 1) (= (rd-tv-at &text 0) 58))
        from:usize 0)
    (when kw (set! from 1))
    (set! (c 'text) text)
    (set! (c 'keyword) kw)
    (init (ref c 'segs) (handle g-arena))
    (let (seg:ChainSeg (chain-seg-at text from)
          more:bool true)
      (while more
        (conj (ref c 'segs) seg)
        (set! more (seg 'colon))
        (when more (set! seg (chain-seg-next text seg))))
      (return c))))

(defn chain-seg (c:&Chain i:usize):ChainSeg
  (return ((ref c 'segs) i)))

(defn chain-sigils (c:&Chain i:usize):StrView
  (let (seg:ChainSeg (chain-seg c i))
    (return (strview-take-bytes (strview-drop-bytes (c 'text) (seg 'start))
                                (- (seg 'body) (seg 'start))))))

(defn chain-body (c:&Chain i:usize):StrView
  (let (seg:ChainSeg (chain-seg c i))
    (return (strview-take-bytes (strview-drop-bytes (c 'text) (seg 'body))
                                (- (seg 'end) (seg 'body))))))

; The last segment has no body (`x:`, `x:?`, `?&`), so the reader fuses the
; atom with a `(` that follows it.
(defn chain-open? (c:&Chain):bool
  (let (seg:ChainSeg (chain-seg c (- (count (ref c 'segs)) 1)))
    (return (= (seg 'body) (seg 'end)))))

; ---------------------------------------------------------------------------
; A string literal as source: its value, and where each byte of it is written
; (design/stage26-refactoring/overview.md §4.6).
; ---------------------------------------------------------------------------

; `map` has an entry per byte of `text`, the source offset its spelling starts
; at (an escape's `\`), plus one for the end: the closing quote's offset.
(defstruct StrSource text:StrView map:(Vector usize))

; `s`'s value decoded as the reader decodes it, arena-allocated; null unless
; `s` is a string literal.
(defn syn-string-source (f:&SynFile s:&Syn):?&StrSource
  (when (!= (s 'kind) SYN-STR) (return null))
  (let (src:StrView (f 'src)
        end:usize (- (s 'end) 1)
        r:Reader (reader (strview-take-bytes src end))
        buf:&String (alloca String)
        ss:&StrSource (unsafe/cast &StrSource (arena-alloc (sizeof StrSource))))
    (init buf)
    (init (ref ss 'map) (handle g-arena))
    ; Past the opening quote, and the `c` of a `c"…"`.
    (set! (r 'pos) (if (= (rd-tv-at &src (s 'start)) 99) (+ (s 'start) 2) (+ (s 'start) 1)))
    (while (< (r 'pos) end)
      (let (at:usize (r 'pos)
            c:i32 (rd-next &r))
        (when (= c 0)
          (drop buf)
          (return null))
        (if (= c 92)
          (match (rd-string-escape &r buf)
            ((err e) (do (drop buf)
                         (return null)))
            ((ok x) (do)))
          (rd-push-byte buf c))
        (while (< (count (ref ss 'map)) (byte-len buf))
          (conj (ref ss 'map) at))))
    (conj (ref ss 'map) end)
    (set! (ss 'text) (rd-arena-str buf))
    (return ss)))

; The source offset of value byte `i`; `i` may be the value's length.
(defn str-source-at (ss:&StrSource i:usize):usize
  (return ((ref ss 'map) i)))

; Whether value offset `i` falls inside one escape's bytes (a `\uXXXX` that
; decodes to several), where no source offset corresponds to it.
(defn str-source-split? (ss:&StrSource i:usize):bool
  (return (and (> i 0) (< i ((ss 'text) 'len)) (= (str-source-at ss i) (str-source-at ss (- i 1))))))

; `text` spelled for the inside of a string literal: the bytes a literal
; decodes or ends at are escaped; the rest, line breaks included, are kept.
(defn str-source-escape (out:&String text:StrView):void
  (dotimes (i (as i64 (text 'len)))
    (let (c:i32 (rd-tv-at &text (as usize i)))
      (cond (= c 34) (write-str out "\\\"")
            (= c 92) (write-str out "\\\\")
            (= c 0) (write-str out "\\0")
            true (rd-push-byte out c)))))

; ---------------------------------------------------------------------------
; `&T` is sugar for `ref:T`, expanded before the parser so every reader of a
; type spelling sees the colon chain (design/stage16-ergonomics/ref-sigil.md).
; ---------------------------------------------------------------------------

; A retired `&x` marker stays unexpanded so the compiler's own check can name
; its keyword replacement instead of failing as `unknown type: rest`.
(defn rd-legacy-marker? (sv:StrView):bool
  (when (not (strview-has-prefix sv "&")) (return false))
  (let (tail:StrView (strview-drop-bytes sv 1))
    (return (or (= tail "rest") (= tail "where") (= tail "optional") (= tail "repr")))))

; Whether any segment's sigil run holds a `&`.
(defn rd-has-ref-sigil? (tv:StrView):bool
  (let (tp:&StrView &tv
        seg:ChainSeg (chain-seg-at tv 0)
        more:bool true)
    (while more
      (let (i:usize (seg 'start))
        (while (< i (seg 'body))
          (when (= (rd-tv-at tp i) 38) (return true))
          (set! i (+ i 1))))
      (set! more (seg 'colon))
      (when more (set! seg (chain-seg-next tv seg))))
    (return false)))

(defn rd-expand-sigil (tv:StrView):Symbol
  (when (not (rd-has-ref-sigil? tv)) (return (symbol-intern tv)))
  (when (rd-legacy-marker? tv) (return (symbol-intern tv)))
  (let (out:&String (alloca String)
        tp:&StrView &tv
        seg:ChainSeg (chain-seg-at tv 0)
        more:bool true
        ref-colon:StrView "ref:"
        colon:StrView ":")
    (init out)
    (while more
      (let (i:usize (seg 'start))
        (while (< i (seg 'body))
          (if (= (rd-tv-at tp i) 38)
            (string-push-str-unchecked out &ref-colon)
            (let (one:StrView (strview (unsafe/ptr+ (tp 'data) (as i64 i)) 1))
              (string-push-str-unchecked out &one)))
          (set! i (+ i 1))))
      (let (body:StrView (strview (unsafe/ptr+ (tp 'data) (as i64 (seg 'body)))
                                  (- (seg 'end) (seg 'body))))
        (string-push-str-unchecked out &body))
      (set! more (seg 'colon))
      (when more
        (string-push-str-unchecked out &colon)
        (set! seg (chain-seg-next tv seg))))
    (let (s:Symbol (symbol-intern (string-as-view out)))
      (drop out)
      (return s))))

; The `&` reader macro must not swallow a retired marker.
(defn rd-at-legacy-marker (self:&Reader):bool
  (let (end:usize (self 'pos))
    (while (rd-sym-char? (rd-at self end))
      (set! end (+ end 1)))
    (when (<= (- end (self 'pos)) 1) (return false))
    (let (sv:StrView (self 'src)
          tok:StrView (strview (unsafe/ptr+ (sv 'data) (as i64 (self 'pos)))
                               (- end (self 'pos))))
      (return (rd-legacy-marker? tok)))))

; ---------------------------------------------------------------------------
; Node construction
; ---------------------------------------------------------------------------

(defn rd-node (kind:i32 line:i32):&Node
  (let (n:&Node (alloc-node))
    (set! (n 'kind) kind)
    (set! (n 'line) line)
    (return n)))

; ---------------------------------------------------------------------------
; Literals
; ---------------------------------------------------------------------------

; The four hex digits after `\u`, consumed, or -1 (consuming nothing) when
; there are fewer.
(defn rd-hex4 (self:&Reader):i32
  (let (cp:i32 0
        i:usize 0)
    (while (< i 4)
      (when (< (rd-hex-val (rd-at self (+ (self 'pos) i))) 0) (return -1))
      (set! i (+ i 1)))
    (dotimes (k 4)
      (set! cp (+ (* cp 16) (rd-hex-val (rd-next self)))))
    (return cp)))

(defn rd-surrogate? (cp:i32):bool
  (return (and (>= cp 55296) (<= cp 57343))))

; The escape after a string literal's `\`, its value appended to `buf`. The one
; decoder: `syn-string-source` maps a literal's bytes through it too.
(defn rd-string-escape (self:&Reader buf:&String):ReadResult
  (let (e:i32 (rd-next self)
        c:i32 (case e 110 10 116 9 114 13 48 0 92 92 34 34 -1))
    (cond (>= c 0) (do)
          ; `\xHH`: one or two hex digits, deliberately not C's greedy run.
          (= e 120)
            (let (h1:i32 (rd-hex-val (rd-peek self)))
              (when (< h1 0)
                (return (err (rd-error read-bad-escape (self 'line)
                                       "\\x escape needs at least one hex digit" ""))))
              (rd-next self)
              (set! c h1)
              (let (h2:i32 (rd-hex-val (rd-peek self)))
                (when (>= h2 0)
                  (rd-next self)
                  (set! c (+ (* c 16) h2)))))
          ; `\uXXXX`, EDN's (and Java's) spelling: exactly four digits.
          (= e 117)
            (let (cp:i32 (rd-hex4 self))
              (when (< cp 0)
                (return (err (rd-error read-bad-escape (self 'line)
                                       "\\u escape needs exactly four hex digits" ""))))
              (when (rd-surrogate? cp)
                (return (err (rd-error read-bad-escape (self 'line)
                                       "\\u escape names a surrogate, which is not a character" ""))))
              (string-push-char buf (as Char (as ui32 cp)))
              (return (ok null)))
          true
            (let (m:String (str "unknown escape \\" (as Char (as ui32 e))))
              (return (err (rd-error read-bad-escape (self 'line) (rd-arena-str &m) "")))))
    (rd-push-byte buf c)
    (return (ok null))))

(defn rd-push-byte (buf:&String c:i32):void
  (let (one:&ui8 (as &ui8 (alloca ui8 1)))
    (set! (aref one 0) (unsafe/cast ui8 c))
    (string-push-bytes-raw buf one 1)))

; No length ceiling: the buffer grows.
(defn rd-string (self:&Reader open-line:i32 is-cstr:bool):ReadResult
  (let (buf:&String (alloca String)
        one:&ui8 (as &ui8 (alloca ui8 1)))
    (init buf)
    (while true
      (let (c:i32 (rd-next self))
        (cond
          (= c 0)
            (do (drop buf)
                (return (err (rd-error read-unterminated-string open-line
                                       "unterminated string literal" ""))))
          (= c 34)
            (let (n:&Node (rd-node NODE-STR open-line))
              (set! (n 's) (symbol-intern (string-as-view buf)))
              (set! (n 'i) (if is-cstr 1 0))
              (drop buf)
              (return (ok n)))
          (= c 92)
            (match (rd-string-escape self buf)
              ((err e) (do (drop buf)
                           (return (err e))))
              ((ok x) (set! c -1))))
        (when (>= c 0)
          (set! (aref one 0) (unsafe/cast ui8 c))
          (string-push-bytes-raw buf one 1))))
    (return (err (rd-error read-unterminated-string open-line
                           "unterminated string literal" "")))))

(defn rd-char-node (cp:i32 line:i32):&Node
  (let (n:&Node (rd-node NODE-CHAR line))
    (set! (n 'i) (as i64 cp))
    (return n)))

(defn rd-char (self:&Reader open-line:i32):ReadResult
  (rd-next self)                                    ; the leading backslash
  (let (c0:i32 (rd-peek self))
    (when (= c0 0)
      (return (err (rd-error read-bad-char open-line "unterminated char literal" ""))))
    ; `\u{XXXX}` only when the `u` is immediately followed by `{`; a bare `\u`
    ; is the ordinary literal for the letter.
    (when (and (= c0 117) (= (rd-peek1 self) 123))
      (rd-next self) (rd-next self)
      (let (cp:i32 0
            ndigits:i32 0
            done:bool false)
        (while (not done)
          (let (h:i32 (rd-peek self))
            (cond (= h 125) (do (rd-next self) (set! done true))
                  (= h 0)   (return (err (rd-error read-bad-char open-line
                                                   "unterminated \\u{...} char literal" "")))
                  true
                    (let (hv:i32 (rd-hex-val h))
                      (when (< hv 0)
                        (return (err (rd-error read-bad-char open-line
                                               "invalid hex digit in \\u{...} char literal" ""))))
                      (rd-next self)
                      (set! cp (+ (* cp 16) hv))
                      (set! ndigits (+ ndigits 1))
                      (when (> ndigits 6)
                        (return (err (rd-error read-bad-char open-line
                                               "codepoint out of range in \\u{...} (max 0x10FFFF)" ""))))))))
        (cond (= ndigits 0)
                (return (err (rd-error read-bad-char open-line "empty \\u{...} char literal" "")))
              (> cp 1114111)
                (return (err (rd-error read-bad-char open-line
                                       "invalid-codepoint: value exceeds 0x10FFFF" "")))
              (rd-surrogate? cp)
                (return (err (rd-error read-bad-char open-line
                                       "invalid-codepoint: surrogate 0xD800..0xDFFF is not a scalar value" ""))))
        (return (ok (as &Node (rd-char-node cp open-line))))))
    ; A non-symbol character after the backslash is a literal of that byte.
    (when (not (rd-sym-char? c0))
      (rd-next self)
      (return (ok (as &Node (rd-char-node c0 open-line)))))
    (let (start:usize (self 'pos))
      (while (rd-sym-char? (rd-peek self))
        (rd-next self))
      (let (tv:StrView (rd-slice self start))
        (when (= (tv 'len) 1)
          (return (ok (as &Node (rd-char-node (rd-tv-at &tv 0) open-line)))))
        (let (named:i32 (case tv "newline" 10 "return" 13 "tab" 9 "space" 32 "nul" 0
                                 "escape" 27 "backspace" 8 "delete" 127 -1))
          (when (>= named 0) (return (ok (as &Node (rd-char-node named open-line))))))
        (when (and (= (tv 'len) 5) (= (rd-tv-at &tv 0) 117))
          (let (cp:i32 0
                hex:bool true)
            (dotimes (k 4)
              (let (hv:i32 (rd-hex-val (rd-tv-at &tv (as usize (+ k 1)))))
                (if (< hv 0) (set! hex false) (set! cp (+ (* cp 16) hv)))))
            (when hex
              (when (rd-surrogate? cp)
                (return (err (rd-error read-bad-char open-line
                                       "invalid-codepoint: surrogate 0xD800..0xDFFF is not a scalar value" ""))))
              (return (ok (as &Node (rd-char-node cp open-line)))))))
        (let (m:String (str "unknown named char literal '\\" tv "'"))
          (return (err (rd-error read-bad-char open-line (rd-arena-str &m) ""))))))))

(defn rd-int-node (tv:StrView radix:i32 line:i32):ReadResult
  (let (v:i64 0)
    (match (rd-int-value tv radix)
      ((ok m) (set! v m))
      ((err e) (return (err (rd-error read-int-range line "integer literal out of range" "")))))
    (let (n:&Node (rd-node NODE-INT line))
      (set! (n 'i) v)
      (return (ok n)))))

(defn rd-float-node (tv:StrView line:i32):&Node
  (let (n:&Node (rd-node NODE-FLOAT line))
    (set! (n 's) (symbol-intern tv))
    (return n)))

; EDN integers are signed 64-bit: the ui64 widening Nucleus literals get would
; read a too-big positive as a negative.
(defn rd-edn-int (tv:StrView line:i32):ReadResult
  (let (n:?&Node (try (rd-int-node tv 10 line)))
    (when (and (!= n null) (< (n 'i) 0) (!= (rd-tv-at &tv 0) 45))
      (return (err (rd-error read-int-range line "integer literal out of range" ""))))
    (return (ok n))))

; An EDN atom: no `&` sigil, no hex, `+inf.0` and friends are symbols, and `N`
; marks an integer, `M` a decimal kept as its text (suffix included).
(defn rd-edn-atom (tv:StrView line:i32):ReadResult
  (let (tp:&StrView &tv
        n:usize (tv 'len)
        last:i32 (rd-tv-at tp (- n 1)))
    (when (and (> n 1) (or (= last 78) (= last 77)))
      (let (body:StrView (strview-take-bytes tv (- n 1))
            bp:&StrView &body)
        (when (and (= last 78) (rd-int-atom? bp))
          (return (rd-edn-int body line)))
        (when (and (= last 77) (or (rd-int-atom? bp) (rd-float-atom? bp)))
          (return (ok (rd-float-node tv line))))))
    (cond (rd-int-atom? tp)
            (return (rd-edn-int tv line))
          (and (rd-float-atom? tp) (!= n 6))
            (return (ok (rd-float-node tv line)))
          (and (> n 1) (= (rd-tv-at tp 0) 58))
            (let (k:&Node (rd-node NODE-KEYWORD line))
              (set! (k 's) (symbol-intern (strview-drop-bytes tv 1)))
              (return (ok k))))
    (return (ok (as &Node (intern-node (symbol-intern tv)))))))

(defn rd-atom (self:&Reader):ReadResult
  (let (line:i32 (self 'line)
        start:usize (self 'pos))
    (while (rd-sym-char? (rd-peek self))
      (rd-next self))
    (let (tv:StrView (rd-slice self start)
          tp:&StrView &tv)
      (let (hk:i32 (rd-hex-kind tp))
        (cond (self 'edn) (return (rd-edn-atom tv line))
              (rd-int-atom? tp) (return (rd-int-node tv 10 line))
              (= hk 2) (return (ok (rd-float-node tv line)))
              (= hk 1) (return (rd-int-node tv 16 line))
              (rd-float-atom? tp) (return (ok (rd-float-node tv line)))
              ; A leading ':' with a non-empty remainder is a keyword; a lone ':'
              ; is a plain symbol, which is what makes the `):(` return-type sugar lex.
              (and (> (tv 'len) 1) (= (rd-tv-at tp 0) 58))
                (let (n:&Node (rd-node NODE-KEYWORD line))
                  (set! (n 's) (rd-expand-sigil (strview-drop-bytes tv 1)))
                  (return (ok n)))))
      ; Symbols are interned singletons shared across the whole program, so
      ; they carry no per-occurrence line -- see node-line in lib/nucleus/node.nuc.
      (return (ok (as &Node (intern-node (rd-expand-sigil tv))))))))

; ---------------------------------------------------------------------------
; Forms
; ---------------------------------------------------------------------------

; The table row whose prefix is at the current position, longest prefix
; winning, or -1. An empty prefix never matches: it cannot beat `best-len` 0.
(defn rd-macro-match (self:&Reader):i32
  (let (tbl:&(Vector RMacro) (self 'macros)
        n:usize (count tbl)
        pos:usize (self 'pos)
        best:i32 -1
        best-len:usize 0
        i:usize 0)
    (while (< i n)
      (let (rm:RMacro (invoke tbl i)
            p:StrView (rm 'prefix)
            plen:usize (p 'len)
            j:usize 0
            hit:bool true)
        (while (and hit (< j plen))
          (when (!= (rd-at self (+ pos j)) (rd-tv-at &p j)) (set! hit false))
          (set! j (+ j 1)))
        (when (and hit (> plen best-len))
          (set! best (unsafe/cast i32 i))
          (set! best-len plen)))
      (set! i (+ i 1)))
    (return best)))

; Only a byte no atom begins with may start a prefix: `"my"` read `myvar` as
; `(w var)` and `"<"` broke `<=`. These seven -- $ ' @ ^ ` | ~ -- are the ones
; the grammar leaves free.
(defn rd-atom-start? (c:i32):bool
  (return (not (or (= c 36) (= c 39) (= c 64) (= c 94) (= c 96) (= c 124) (= c 126)))))

; Add `prefix` to this reader's table, with the two checks a `(def-rmacro …)`
; form gets. `ok` carries no node.
(defn reader-register-macro (self:&Reader prefix:StrView wrap:Symbol line:i32):ReadResult
  (let (tbl:&(Vector RMacro) (self 'macros)
        none:?&Node null)
    (when (>= (rd-macro-find tbl prefix) 0)
      (let (m:String (str "def-rmacro: '" prefix "' is already a reader macro"))
        (return (err (rd-error read-bad-rmacro line (rd-arena-str &m) "")))))
    (when (rd-atom-start? (rd-tv-at &prefix 0))
      (return (err (rd-error read-bad-rmacro line
                             "def-rmacro: prefix must not begin with a byte that can start an atom" ""))))
    (rd-macro-add tbl prefix wrap)
    (return (ok none))))

(defn rd-def-rmacro-form? (form:?&Node):bool
  (when (= form null) (return false))
  (when (!= (form 'kind) NODE-LIST) (return false))
  (let (h:?&Node (node-first form))
    (when (= h null) (return false))
    (when (!= (h 'kind) NODE-SYM) (return false))
    (return (= (h 's) "def-rmacro"))))

; A top-level `(def-rmacro "p" sym)`, registered as it is read so the forms
; after it see the prefix. The first three messages are the compiler's.
(defn rd-def-rmacro (self:&Reader form:ptr:Node):ReadResult
  (let (line:i32 (form 'line))
    (when (!= (node-len form) 3)
      (return (err (rd-error read-bad-rmacro line
                             "def-rmacro: expects (def-rmacro \"prefix\" symbol)" ""))))
    (let (pn:ptr:Node (node-at form 1)
          sn:ptr:Node (node-at form 2))
      (when (!= (node-kind pn) NODE-STR)
        (return (err (rd-error read-bad-rmacro line "def-rmacro: prefix must be a string" ""))))
      (when (!= (node-kind sn) NODE-SYM)
        (return (err (rd-error read-bad-rmacro line "def-rmacro: wrap symbol must be a symbol" ""))))
      (try (reader-register-macro self (symbol-as-view (pn 's)) (sn 's) line))
      (return (ok form)))))

; True iff `form` is a `(fn …)`-headed list -- the return-type half of a
; function-pointer type.
(defn rd-fn-type-form? (form:?&Node):bool
  (when (= form null) (return false))
  (when (!= (form 'kind) NODE-LIST) (return false))
  (let (h:?&Node (node-first form))
    (when (= h null) (return false))
    (when (!= (h 'kind) NODE-SYM) (return false))
    (return (= (h 's) "fn"))))

; A function-pointer type is TWO adjacent parenthesised groups, which the
; single-group fuse below cannot express: `f:(fn i32)(i32)` must read as
; `(f ((fn i32) (i32)))`, not as a zero-parameter fn type with a dangling
; sibling. Adjacency is required -- a space-separated second group is genuinely
; ambiguous with the next binding in the enclosing list.
(defn rd-fuse-fn-params (self:&Reader paren-form:?&Node line:i32):ReadResult
  (when (not (rd-fn-type-form? paren-form)) (return (ok paren-form)))
  (when (!= (rd-peek self) 40) (return (ok paren-form)))
  (let (plist:?&Node (try (rd-form self)))
    (return (ok (as &Node (node-list2 paren-form
                               plist line))))))

; The final chain segment is still open (`x:`, `?`, `x:?`, `?!` -- not `foo?`,
; `!=`): the fuse gate of pointer-kind-spellings.md §4. `chain-open?` without
; the arena, since every symbol the reader reads asks.
(defn rd-open-segment? (sv:StrView):bool
  (let (seg:ChainSeg (chain-seg-at sv 0))
    (while (seg 'colon)
      (set! seg (chain-seg-next sv seg)))
    (return (= (seg 'body) (seg 'end)))))

; Colon-paren binding sugar (design/stage11/cleanup.md §1). The colon is an
; ordinary symbol char, so `name:(ref (Vector T))` lexes as the atom `name:`
; followed by a separate list; fuse them back together.
(defn rd-fuse-colon-paren (self:&Reader child:?&Node line:i32):ReadResult
  (when (= child null) (return (ok child)))
  (when (and (!= (child 'kind) NODE-SYM) (!= (child 'kind) NODE-KEYWORD))
    (return (ok child)))
  (let (sv:StrView (symbol-as-view (child 's))
        len:usize (symbol-len (child 's)))
    (when (not (rd-open-segment? sv)) (return (ok child)))
    (when (!= (rd-peek self) 40) (return (ok child)))
    (let (first:?&Node (try (rd-form self))
          paren-form:?&Node (try (rd-fuse-fn-params self first line))
          body:StrView sv)
      ; A bare ':' fuses to the paren form directly, so `(fn (x:i32):(ref T) …)`
      ; reads as `(fn (x:i32) (ref T) …)`.
      (when (and (= (child 'kind) NODE-SYM) (= sv ":"))
        (return (ok paren-form)))
      ; A trailing sigil run is a segment of its own (`x:?` → `x`, `?`), so
      ; only a trailing ':' is stripped before the split.
      (when (strview-has-suffix sv ":")
        (set! body (strview-take-bytes sv (- len 1))))
      ; The first segment is the binding name for a symbol (a keyword, whose
      ; colon the lexer already stripped, has none); the rest wrap the paren
      ; form right-to-left as unary constructors.
      (let (segs:&(Vector Symbol) (alloca (Vector Symbol))
            seg:ChainSeg (chain-seg-at body 0)
            more:bool true)
        (init segs)
        (while more
          (when (= (seg 'start) (seg 'end))
            (drop segs)
            (let (m:String (str "empty segment in colon-chain '" sv
                                "' -- write name:k1:(Type) with no '::'"))
              (return (err (rd-error read-empty-segment line (rd-arena-str &m) "")))))
          (conj segs (symbol-intern (chain-seg-text body seg)))
          (set! more (seg 'colon))
          (when more (set! seg (chain-seg-next body seg))))
        (let (n:usize (count segs)
              start:usize 0
              name:Symbol (symbol-none)
              have-name:bool false)
          (when (= (child 'kind) NODE-SYM)
            (set! name (invoke segs 0))
            (set! have-name true)
            (set! start 1))
          (let (result:?&Node paren-form
                i:usize n)
            (while (> i start)
              (set! i (- i 1))
              (set! result (as &Node
                             (node-list2 (as &Node (intern-node (invoke segs i)))
                               result line))))
            (when have-name
              (set! result (as &Node
                             (node-list2 (as &Node (intern-node name))
                               result line))))
            (drop segs)
            (return (ok result))))))))

; Whitespace, comments and `#_`-discarded forms. A discard can fail, which is
; why this is not `rd-skip-ws`.
(defn rd-skip-discard (self:&Reader):ReadResult
  (let (none:?&Node null)
    (while true
      (rd-skip-ws self)
      (when (or (!= (rd-peek self) 35) (!= (rd-peek1 self) 95))
        (return (ok none)))
      (let (line:i32 (self 'line)
            at:usize (self 'pos))
        (rd-next self) (rd-next self)
        (rd-skip-ws self)
        (let (c:i32 (rd-peek self))
          (when (or (= c 0) (= c 41) (= c 93) (= c 125))
            (return (err (rd-error read-bad-discard line "#_ must be followed by a form to discard" "")))))
        (try (rd-discard-form self at))))
    (return (ok none))))

; The form a `#_` at `at` drops. In syntax mode its span is recorded and its
; frames are kept out of the tree.
(defn rd-discard-form (self:&Reader at:usize):ReadResult
  (let (sb:?&SynBuilder (self 'syn))
    (when (= sb null) (return (rd-form self)))
    (let (saved:?&Syn (syn-discard-begin sb at)
          r:ReadResult (rd-form self))
      (syn-discard-end sb saved (self 'pos))
      (return r))))

(defn rd-list (self:&Reader open-line:i32):ReadResult
  (let (b:&Node (node-list-new open-line))
    (while true
      (try (rd-skip-discard self))
      (let (c:i32 (rd-peek self))
        (when (= c 0)
          (return (err (rd-unterminated self open-line "unterminated list" ")"))))
        (when (= c 41)
          (rd-close-bracket self)
          (rd-next self)
          (return (ok (node-list-done b))))
        (let (child:?&Node (try (rd-form self)))
          (node-push b child))))
    (return (ok (node-list-done b)))))

; The elements of a `[…]`/`{…}`/`#{…}` literal up to `closer`.
(defn rd-lit-elems (self:&Reader what:StrView closer:i32 open-line:i32):ReadResult
  (let (b:&Node (node-list-new open-line))
    (while true
      (try (rd-skip-discard self))
      (let (c:i32 (rd-peek self))
        (when (= c 0)
          (let (m:String (str "unterminated " what " literal"))
            (return (err (rd-unterminated self open-line (rd-arena-str &m)
                                          (if (= closer 93) "]" "}"))))))
        (when (= c closer)
          (rd-close-bracket self)
          (rd-next self)
          (return (ok (node-list-done b))))
        (let (child:?&Node (try (rd-form self)))
          (node-push b child))))
    (return (ok (node-list-done b)))))

; `(vector-lit e…)` / `(hashmap-lit k v…)` / `(hashset-lit e…)` -- no gensym
; element; the compiler mints its own after reading.
(defn rd-lit-cell (name:StrView elems:?&Node line:i32 mark:i32):&Node
  (let (cell:&Node (node-cons (as &Node (intern-node (symbol-intern name))) elems line))
    (set! (cell 'i) mark)
    (return cell)))

; `#tag form` -> `(tagged-lit tag form)`, the `#` already consumed.
(defn rd-tagged (self:&Reader line:i32):ReadResult
  (let (start:usize (self 'pos))
    (while (rd-sym-char? (rd-peek self))
      (rd-next self))
    (let (tv:StrView (rd-slice self start))
      (try (rd-skip-discard self))
      (let (c:i32 (rd-peek self))
        (when (or (= c 0) (= c 41) (= c 93) (= c 125))
          (let (m:String (str "tagged literal '#" tv "' has no value"))
            (return (err (rd-error read-bad-tag line (rd-arena-str &m) ""))))))
      (let (value:?&Node (try (rd-form self))
            tag:&Node (as &Node (intern-node (symbol-intern tv)))
            elems:&Node (node-list2 tag value line))
        (return (ok (rd-lit-cell "tagged-lit" elems line LIT-TAGGED)))))))

(defn rd-letter? (c:i32):bool
  (return (or (and (>= c 97) (<= c 122)) (and (>= c 65) (<= c 90)))))

; The fuse lives here, not in `rd-list`, so it fires wherever an atom is read:
; a reader-macro operand, a literal element, a top-level form.
(defn rd-atom-form (self:&Reader line:i32):ReadResult
  (let (atom:?&Node (try (rd-atom self)))
    (when (self 'edn) (return (ok atom)))
    (return (rd-fuse-colon-paren self atom line))))

(defn rd-form (self:&Reader):ReadResult
  (try (rd-skip-discard self))
  ; Syntax mode re-enters here to read the frame it opened, which keeps this
  ; body inline for the ordinary read (stage26-refactoring/overview.md §8).
  (let (sb:?&SynBuilder (self 'syn))
    (when (!= sb null)
      (if (sb 'framed)
        (set! (sb 'framed) false)
        (return (rd-syn-form self sb)))))
  (let (line:i32 (self 'line)
        c:i32 (rd-peek self))
    (cond
      (= c 0)
        (return (err (rd-error read-eof line "unexpected end of input" "")))
      (= c 40)
        (do (rd-open-bracket self line true)
            (rd-next self)
            (return (rd-list self line)))
      ; Only a `)` at NEGATIVE depth has no opener anywhere (one inside an unclosed
      ; `[…]` closes a real bracket), so only then is the note's search bounded.
      (= c 41)
        (do (rd-close-bracket self)
            (rd-next self)
            (let (note:StrView ""
                  fo:i32 (self 'form-open-line))
              (when (and (< (self 'paren-depth) 0) (!= fo 0))
                (let (m:String (str "the form opened at line " fo
                                    " is already closed -- look for an extra ')' between lines "
                                    fo " and " line))
                  (set! note (rd-arena-str &m))))
              (return (err (rd-error read-unexpected-close line "unexpected )" note)))))
      (= c 91)
        (do (rd-open-bracket self line false)
            (rd-next self)
            (let (elems:?&Node (try (rd-lit-elems self "vector" 93 line)))
              (return (ok (rd-lit-cell "vector-lit" elems line LIT-VECTOR)))))
      (= c 93)
        (do (rd-close-bracket self)
            (rd-next self)
            (return (err (rd-error read-unexpected-close line "unexpected ]" ""))))
      (and (= c 35) (= (rd-peek1 self) 123))
        (do (rd-open-bracket self line false)
            (rd-next self) (rd-next self)
            (let (elems:?&Node (try (rd-lit-elems self "set" 125 line)))
              (return (ok (rd-lit-cell "hashset-lit" elems line LIT-SET)))))
      ; `#_` was taken by rd-skip-discard, so any other `#` here opens a tag.
      (= c 35)
        (do (when (not (rd-letter? (rd-peek1 self)))
              (return (err (rd-error read-bad-tag line
                                     "'#' must be followed by '{', '_' or a tag that starts with a letter" ""))))
            (rd-next self)
            (return (rd-tagged self line)))
      (= c 123)
        (do (rd-open-bracket self line false)
            (rd-next self)
            (let (elems:?&Node (try (rd-lit-elems self "map" 125 line)))
              (when (!= (bit-and (node-len elems) 1) 0)
                (return (err (rd-error read-map-odd line "map literal: odd number of elements" ""))))
              (return (ok (rd-lit-cell "hashmap-lit" elems line LIT-MAP)))))
      (= c 125)
        (do (rd-close-bracket self)
            (rd-next self)
            (return (err (rd-error read-unexpected-close line "unexpected }" ""))))
      ; A retired `&x` marker must reach the compiler's own check rather than be
      ; consumed by the `&` reader macro.
      (and (= c 38) (rd-at-legacy-marker self))
        (return (rd-atom-form self line)))
    (let (mi:i32 (rd-macro-match self))
      (when (>= mi 0)
        (let (rm:RMacro (invoke (self 'macros) (as usize mi))
              p:StrView (rm 'prefix)
              k:usize (p 'len)
              j:usize 0)
          (while (< j k)
            (rd-next self)
            (set! j (+ j 1)))
          (let (inner:?&Node (try (rd-form self))
                sym:&Node (as &Node (intern-node (rm 'wrap))))
            (return (ok (as &Node
                          (node-list2 sym
                            inner line))))))))
    ; `c"…"` -- a `c` glued to an opening quote -- is an explicit CStr literal.
    (cond (and (= c 99) (= (rd-peek1 self) 34) (not (self 'edn)))
            (do (rd-next self)
                (rd-next self)
                (return (rd-string self line true)))
          (= c 34)
            (do (rd-next self)
                (return (rd-string self line false)))
          (= c 92)
            (return (rd-char self line)))
    (return (rd-atom-form self line))))

; ---------------------------------------------------------------------------
; Syntax mode: the same read, building a `Syn` per form beside its node
; (lib/nucleus/syntax.nuc, design/stage26-refactoring/overview.md §4.1).
; ---------------------------------------------------------------------------

; The kind `rd-form` is about to read, by its tests in its order. A fuse is
; told from an atom once its kids are read.
(defn rd-syn-kind (self:&Reader):i32
  (let (c:i32 (rd-peek self)
        c1:i32 (rd-peek1 self))
    (return (cond (= c 40) SYN-LIST
                  (= c 91) SYN-VEC
                  (and (= c 35) (= c1 123)) SYN-SET
                  (= c 35) SYN-TAGGED
                  (= c 123) SYN-MAP
                  (and (= c 38) (rd-at-legacy-marker self)) SYN-ATOM
                  (>= (rd-macro-match self) 0) SYN-PREFIX
                  (or (= c 34) (and (= c 99) (= c1 34) (not (self 'edn)))) SYN-STR
                  (= c 92) SYN-CHAR
                  true SYN-ATOM))))

(defn rd-syn-open (self:&Reader kind:i32):i32
  (when (= kind SYN-PREFIX)
    (let (rm:RMacro (invoke (self 'macros) (as usize (rd-macro-match self)))
          p:StrView (rm 'prefix))
      (return (unsafe/cast i32 (p 'len)))))
  (return (case kind SYN-LIST 1 SYN-VEC 1 SYN-MAP 1 SYN-SET 2 SYN-TAGGED 1 0)))

; A fuse's atom and a tagged literal's tag are read without a frame. The fused
; tree has no elem for the atom, so its node is the atom read on its own.
(defn rd-syn-head-kid (self:&Reader s:&Syn n:?&Node):void
  (let (ks:&(Vector &Syn) (ref s 'kids)
        start:usize (s 'start))
    (cond (and (= (s 'kind) SYN-ATOM) (> (count ks) 0))
            (let (k0:&Syn (ks 0)
                  end:usize (k0 'start)
                  text:StrView (strview-take-bytes (strview-drop-bytes (self 'src) start)
                                                   (- end start))
                  sub:Reader (reader-with-macros text (self 'macros))
                  atom:?&Node null)
              (set! (s 'kind) SYN-FUSE)
              (set! (sub 'line) (s 'line))
              (match (rd-atom &sub)
                ((ok a) (set! atom a))
                ((err e) (do)))
              (syn-add-head-kid s start end atom))
          (= (s 'kind) SYN-TAGGED)
            (let (end:usize (+ start 1))
              (while (rd-sym-char? (rd-at self end))
                (set! end (+ end 1)))
              (syn-add-head-kid s (+ start 1) end (node-at n 1))))))

(defn rd-syn-form (self:&Reader sb:&SynBuilder):ReadResult
  (let (kind:i32 (rd-syn-kind self)
        s:&Syn (syn-open sb kind (rd-syn-open self kind) (self 'pos) (self 'line)))
    (set! (sb 'framed) true)
    (let (r:ReadResult (rd-form self))
      (match r
        ((ok n) (do (rd-syn-head-kid self s n)
                    (syn-close sb s (self 'pos) n)))
        ((err e) (if (and (sb 'recover) (= (rd-peek self) 0) (!= (e 'code) read-unexpected-close))
                   (syn-close sb s (self 'pos) null)
                   (syn-abandon sb s))))
      (return r))))

; ---------------------------------------------------------------------------
; Public entry points
; ---------------------------------------------------------------------------

; A trailing `#_ x` is not a form, so it counts as end of input. A discard that
; fails leaves the reader where it was, for `read-one` to report.
(defn reader-eof? (self:&Reader):bool
  (let (pos:usize (self 'pos)
        line:i32 (self 'line)
        depth:i32 (self 'paren-depth)
        fo:i32 (self 'form-open-line)
        c0:i32 (self 'col0-open-line)
        c0d:i32 (self 'col0-open-depth))
    (match (rd-skip-discard self)
      ((ok v) (return (= (rd-peek self) 0)))
      ((err e)
       (set-fields! self
                    'pos pos
                    'line line
                    'paren-depth depth
                    'form-open-line fo
                    'col0-open-line c0
                    'col0-open-depth c0d)
        (return false)))))

; The next form. Check `reader-eof?` first. A top-level `def-rmacro` takes
; effect here, before the form is returned.
(defn read-one (self:&Reader):ReadResult
  (let (form:?&Node (try (rd-form self)))
    (when (and (not (self 'edn)) (rd-def-rmacro-form? form))
      (try (rd-def-rmacro self form)))
    (return (ok form))))

; Every form in `src`, as a list, read through the caller's table -- so a
; `def-rmacro` in one buffer is seen by the caller's next read over the same
; table (a REPL session). Each spine cell carries the line the form started on.
(defn read-all-with-macros (src:StrView table:&(Vector RMacro)):ReadResult
  (let (r:Reader (reader-with-macros src table)
        b:&Node (node-list-new 0))
    (while (not (reader-eof? &r))
      (try (rd-read-into &r b)))
    (return (ok (node-list-done b)))))

; The next form, pushed on `spine` carrying the line it started on.
(defn rd-read-into (r:&Reader spine:&Node):ReadResult
  (let (start-line:i32 (r 'line)
        form:?&Node (try (read-one r))
        line:i32 start-line)
    (when (!= form null)
      (let (fl:i32 (form 'line))
        (when (!= fl 0) (set! line fl))))
    (node-push-line spine form line)
    (return (ok form))))

; The same over a fresh table: a `def-rmacro` in `src` is scoped to `src`.
(defn read-all (src:StrView):ReadResult
  (return (read-all-with-macros src (read-macro-table-new))))

; Same arms as `ReadResult`, for the same reason (docs/reading.md).
(defunion SynFileResult (ok v:&SynFile) (err e:ReadError))
(defunion SynResult (ok v:&Syn) (err e:ReadError))

(defn rd-syn-builder (r:&Reader):&SynBuilder
  (let (sb:?&SynBuilder (r 'syn))
    (when (!= sb null) (return sb))
    (let (fresh:&SynBuilder (syn-builder-new (r 'src)))
      (set! (r 'syn) fresh)
      (return fresh))))

; A reader in syntax mode over `src`, with a fresh built-in macro table.
(defn reader-syntax (src:StrView):Reader
  (let (r:Reader (reader src))
    (rd-syn-builder &r)
    (return r)))

; The file a syntax-mode reader is building; null for an ordinary reader.
(defn reader-syn-file (r:&Reader):?&SynFile
  (let (sb:?&SynBuilder (r 'syn))
    (when (= sb null) (return null))
    (return (sb 'file))))

; The next form's `Syn`, its node also pushed on the file's `tree`. A reader not
; yet in syntax mode is switched into it here.
(defn read-syntax-one (r:&Reader):SynResult
  (let (f:&SynFile ((rd-syn-builder r) 'file))
    (try (rd-read-into r (f 'tree)))
    (let (fs:&(Vector &Syn) (ref f 'forms))
      (return (ok (fs (- (count fs) 1)))))))

; `read-all` in syntax mode: the same tree, as `(f 'tree)`, plus a `Syn` per form.
(defn read-syntax-all (src:StrView):SynFileResult
  (let (r:Reader (reader-syntax src))
    (while (not (reader-eof? &r))
      (try (read-syntax-one &r)))
    (return (ok ((rd-syn-builder &r) 'file)))))

; `read-syntax-all` over a piece of a program, as a test builds one from string
; literals: a closer with no opener is skipped, and a form the text ends inside
; keeps the kids it read, with a null `node` and no elem in `tree`. A piece that
; `starts-in-string` is read from past the quote that ends that string. Any
; other error is returned. `fragment` says whether any of this happened.
(defn read-syntax-fragment (src:StrView starts-in-string:bool):SynFileResult
  (let (r:Reader (reader-syntax src)
        sb:&SynBuilder (rd-syn-builder &r)
        f:&SynFile (sb 'file)
        c:i32 (if starts-in-string 92 0))
    (set! (sb 'recover) true)
    (set! (f 'fragment) starts-in-string)
    (while (and starts-in-string (!= c 0) (!= c 34))
      (set! c (rd-next &r))
      (when (= c 92)
        (rd-next &r)))
    (while (not (reader-eof? &r))
      (match (read-syntax-one &r)
        ((ok s) (do))
        ((err e)
          (do (when (and (!= (e 'code) read-unexpected-close) (!= (rd-peek &r) 0))
                (return (err e)))
              (set! (f 'fragment) true)
              (set! (f 'ends-in-string) (= (e 'code) read-unterminated-string))))))
    (return (ok f))))

; Every form in EDN text `src`, as a list.
(defn read-all-edn (src:StrView):ReadResult
  (let (r:Reader (reader-edn src)
        b:&Node (node-list-new 0))
    (while (not (reader-eof? &r))
      (node-push b (try (read-one &r))))
    (return (ok (node-list-done b)))))

; ---------------------------------------------------------------------------
; Writing and comparing
; ---------------------------------------------------------------------------

(defn rd-write-escaped (out:&String sv:StrView):void
  (let (n:usize (sv 'len)
        i:usize 0
        one:&ui8 (as &ui8 (alloca ui8 1)))
    (while (< i n)
      (let (c:i32 (bit-and (as i32 (aref (sv 'data) (as i64 i))) 255))
        (cond (= c 10) (write-str out "\\n")
              (= c 9)  (write-str out "\\t")
              (= c 13) (write-str out "\\r")
              (= c 92) (write-str out "\\\\")
              (= c 34) (write-str out "\\\"")
              (= c 0)  (write-str out "\\0")
              true (do (set! (aref one 0) (unsafe/cast ui8 c))
                       (string-push-bytes-raw out one 1))))
      (set! i (+ i 1)))))

; `\u{…}` is hex, and lib/nucleus/fmt.nuc writes decimal only.
(defn rd-write-hex (out:&String v:ui64):void
  (let (buf:&ui8 (as &ui8 (alloca ui8 16))
        n:i32 0
        x:ui64 v)
    (when (= x 0)
      (write-str out "0")
      (return))
    (while (> x 0)
      (let (d:i32 (unsafe/cast i32 (% x 16)))
        (set! (aref buf n) (unsafe/cast ui8 (if (< d 10) (+ 48 d) (+ 87 d))))
        (set! n (+ n 1)))
      (set! x (/ x 16)))
    (while (> n 0)
      (set! n (- n 1))
      (string-push-bytes-raw out (as &ui8 (unsafe/ptr+ buf n)) 1))))

; A string as an s-expression literal -- quotes included, escapes applied. The
; counterpart of what the reader accepts, exported so anything WRITING an
; s-expression (lib/nucleus/test.nuc's result records) escapes the way this reads.
(defn sexp-write-string (out:&String sv:StrView):void
  (write-str out "\"")
  (rd-write-escaped out sv)
  (write-str out "\""))

; The canonical text of a node: re-readable, and identical to what the compiler
; prints for the same tree.
(defn node-write (out:&String n:?&Node):void
  (when (= n null)
    (write-str out "()")
    (return))
  (let (k:i32 (n 'kind))
    (cond (= k NODE-INT)
            (str-into out (n 'i))
          (or (= k NODE-FLOAT) (= k NODE-SYM))
            (write-str out (symbol-as-view (n 's)))
          (= k NODE-KEYWORD)
            (do (write-str out ":")
                (write-str out (symbol-as-view (n 's))))
          (= k NODE-CHAR)
            (do (write-str out "\\u{")
                (rd-write-hex out (as ui64 (n 'i)))
                (write-str out "}"))
          (= k NODE-STR)
            (do (when (!= (n 'i) 0) (write-str out "c"))
                (write-str out "\"")
                (rd-write-escaped out (symbol-as-view (n 's)))
                (write-str out "\""))
          (= k NODE-LIST)
            (do (write-str out "(")
                (let (cur:ptr:Node n
                      first:bool true)
                  (while (and (> (node-len cur) 0) (= (cur 'kind) NODE-LIST))
                    (when (not first) (write-str out " "))
                    (set! first false)
                    (node-write out (node-first cur))
                    (set! cur (node-rest cur))))
                (write-str out ")"))
          true (do))))

(defn node-str (n:?&Node):String
  (let (s:&String (alloca String))
    (init s)
    (node-write s n)
    (return @s)))

; ---------------------------------------------------------------------------
; Writing in the preferred spelling (design/stage26-refactoring/overview.md
; §4.4.1). Each sugared spelling is kept only if it reads back as the same
; tree, so the exceptions (`&rest`, `~@x` for `(unquote @x)`) need no list.
; ---------------------------------------------------------------------------

; Whether `text` reads as exactly one form, `node-eq` to `n`.
(defn rd-reads-back? (text:StrView n:?&Node table:&(Vector RMacro)):bool
  (let (r:Reader (reader-with-macros text table))
    (match (rd-form &r)
      ((ok m) (return (and (reader-eof? &r) (node-eq m n))))
      ((err e) (return false)))))

; The prefix of the first row that wraps a form in `head`, or "".
(defn rd-macro-prefix-for (table:&(Vector RMacro) head:Symbol):StrView
  (let (n:usize (count table)
        i:usize 0)
    (while (< i n)
      (let (rm:RMacro (invoke table i))
        (when (= (rm 'wrap) head) (return (rm 'prefix))))
      (set! i (+ i 1)))
    (return "")))

(defn rd-view-from (out:&String mark:usize):StrView
  (return (strview-drop-bytes (string-as-view out) mark)))

; Whether a segment of the chain is a `ref` with a `:` after it, which `&` spells.
(defn rd-has-ref-segment? (tv:StrView):bool
  (let (seg:ChainSeg (chain-seg-at tv 0)
        more:bool true)
    (while more
      (when (and (seg 'colon) (= (strview-take-bytes (strview-drop-bytes tv (seg 'body))
                                                      (- (seg 'end) (seg 'body)))
                                 "ref"))
        (return true))
      (set! more (seg 'colon))
      (when more (set! seg (chain-seg-next tv seg))))
    (return false)))

; `x:ref:T` as `x:&T`: the reader's sigil expansion, inverted.
(defn rd-write-ref-sigils (out:&String tv:StrView):void
  (let (seg:ChainSeg (chain-seg-at tv 0)
        more:bool true)
    (while more
      (let (sig:StrView (strview-take-bytes (strview-drop-bytes tv (seg 'start))
                                            (- (seg 'body) (seg 'start)))
            body:StrView (strview-take-bytes (strview-drop-bytes tv (seg 'body))
                                             (- (seg 'end) (seg 'body))))
        (write-str out sig)
        (if (and (seg 'colon) (= body "ref"))
          (write-str out "&")
          (do (write-str out body)
              (when (seg 'colon) (write-str out ":")))))
      (set! more (seg 'colon))
      (when more (set! seg (chain-seg-next tv seg))))))

(defn rd-write-atom-sugared (out:&String n:&Node table:&(Vector RMacro)):void
  (let (k:i32 (n 'kind)
        mark:usize (byte-len out))
    (cond (and (or (= k NODE-SYM) (= k NODE-KEYWORD))
               (rd-has-ref-segment? (symbol-as-view (n 's))))
            (do (when (= k NODE-KEYWORD) (write-str out ":"))
                (rd-write-ref-sigils out (symbol-as-view (n 's))))
          (= k NODE-CHAR)
            (let (cp:i64 (n 'i)
                  named:StrView (case cp 10 "newline" 13 "return" 9 "tab" 32 "space" 0 "nul"
                                      27 "escape" 8 "backspace" 127 "delete" ""))
              (cond (> (named 'len) 0) (str-into out "\\" named)
                    (and (> cp 32) (< cp 127)) (str-into out "\\" (as Char (unsafe/cast ui32 cp)))
                    true (do))))
    (when (or (= (byte-len out) mark) (not (rd-reads-back? (rd-view-from out mark) n table)))
      (string-truncate-unchecked out mark)
      (node-write out n))))

; A prefix form, a literal cell or a tagged literal: `open`, the elems from
; `from` on, `close`. The elems' text is reused if the long form is needed.
(defn rd-write-sugared-cell (out:&String n:&Node table:&(Vector RMacro)
                             open:StrView from:i32 close:StrView):void
  (let (mark:usize (byte-len out)
        len:i32 (node-len n))
    (write-str out open)
    (let (inner:usize (byte-len out))
      (dotimes (i (- len from))
        (when (> i 0) (write-str out " "))
        (node-write-sugared-with out (node-at n (+ i from)) table))
      (write-str out close)
      (when (rd-reads-back? (rd-view-from out mark) n table) (return))
      (let (body:&String (alloca String)
            v:StrView (strview-take-bytes (rd-view-from out inner)
                                          (- (- (byte-len out) inner) (close 'len))))
        (init body)
        (string-push-str-unchecked body &v)
        (string-truncate-unchecked out mark)
        (write-str out "(")
        (node-write out (node-first n))
        (when (> (byte-len body) 0)
          (write-str out " ")
          (write-str out (string-as-view body)))
        (write-str out ")")
        (drop body)))))

; `node-write` in the house spelling: reader-macro prefixes (`&x`, `'x`, `~@x`
; …) through `table`, `[…]` `{…}` `#{…}` `#tag v`, `&` sigils in atoms (`x:&T`)
; and named or printable chars (`\space`, `\a`). Any spelling that would not
; read back as the same tree falls back to `node-write`'s long form.
(defn node-write-sugared-with (out:&String n:?&Node table:&(Vector RMacro)):void
  (when (= n null)
    (write-str out "()")
    (return))
  (when (!= (n 'kind) NODE-LIST)
    (rd-write-atom-sugared out n table)
    (return))
  (let (len:i32 (node-len n)
        h:?&Node (node-first n))
    (when (and (!= h null) (= (h 'kind) NODE-SYM))
      (let (hs:Symbol (h 's)
            p:StrView (rd-macro-prefix-for table hs))
        (let (open:StrView (cond (and (> (p 'len) 0) (= len 2)) p
                                 (= hs "vector-lit") "["
                                 (= hs "hashmap-lit") "{"
                                 (= hs "hashset-lit") "#{"
                                 (and (= hs "tagged-lit") (= len 3)) "#"
                                 true "")
              close:StrView (cond (= hs "vector-lit") "]"
                                  (or (= hs "hashmap-lit") (= hs "hashset-lit")) "}"
                                  true ""))
          (when (> (open 'len) 0)
            (rd-write-sugared-cell out n table open 1 close)
            (return)))))
    (write-str out "(")
    (dotimes (i len)
      (when (> i 0) (write-str out " "))
      (node-write-sugared-with out (node-at n i) table))
    (write-str out ")")))

; The same through the six built-in reader macros.
(defn node-write-sugared (out:&String n:?&Node):void
  (node-write-sugared-with out n (read-macro-table-new)))

(defn node-str-sugared (n:?&Node):String
  (let (s:&String (alloca String))
    (init s)
    (node-write-sugared s n)
    (return @s)))

; Structural equality: same shape, same kinds, same values. Symbols compare by
; interned identity, which is what makes two reads of one spelling equal.
(defn node-eq (a:?&Node b:?&Node):bool
  (cond (and (= a null) (= b null)) (return true)
        (or (= a null) (= b null)) (return false)
        (!= (a 'kind) (b 'kind)) (return false))
  (let (k:i32 (a 'kind))
    (return (cond (or (= k NODE-INT) (= k NODE-CHAR)) (= (a 'i) (b 'i))
                  (= k NODE-STR) (and (= (a 'i) (b 'i)) (= (a 's) (b 's)))
                  (or (= k NODE-SYM) (= k NODE-FLOAT) (= k NODE-KEYWORD)) (= (a 's) (b 's))
                  (= k NODE-LIST) (and (node-eq (node-first a) (node-first b))
                                       (node-eq (node-rest a) (node-rest b)))
                  true false))))

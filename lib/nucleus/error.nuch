; .nuch header for lib/error.nuc
(deferror unhandled-error "unhandled error")
(defstruct Handler (what Err) (rty ptr) (hfn ptr) (ctx ptr) (prev ptr))
(extern (g-handler-top ptr))
(declare err-find-handler ((eid Err) (token ptr)) :ptr)
(defmacro with-handler (spec :rest body) (let (h:ptr (gensym)) (quasiquote (let (((unquote h) (ref Handler)) (alloca Handler)) (set! ((unquote h) (quote what)) (unquote (node-at spec 0))) (set! ((unquote h) (quote rty)) (type-token (unquote (node-at spec 1)))) (set! ((unquote h) (quote hfn)) (unsafe/cast ptr (unquote (node-at spec 2)))) (set! ((unquote h) (quote ctx)) (unquote (node-at spec 3))) (set! ((unquote h) (quote prev)) g-handler-top) (set! g-handler-top (as ptr (unquote h))) (defer (set! g-handler-top ((unquote h) (quote prev)))) (unquote-splice body)))))

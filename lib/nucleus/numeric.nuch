; .nuch header for lib/nucleus/numeric.nuc
(ns nucleus.numeric)
(defprotocol Eq (= (a:Self b:Self) :bool) (!= (a:Self b:Self) :bool))
(defprotocol Ord (< (a:Self b:Self) :bool) (<= (a:Self b:Self) :bool) (> (a:Self b:Self) :bool) (>= (a:Self b:Self) :bool))
(extend Ord Eq)
(defprotocol Num (_+ (a:Self b:Self) :Self) (_- (a:Self b:Self) :Self) (_* (a:Self b:Self) :Self) (_/ (a:Self b:Self) :Self))
(extend i32 Ord)
(extend i32 Num)
(extend i64 Ord)
(extend i64 Num)
(extend f64 Ord)
(extend f64 Num)
(extend f32 Ord)
(extend f32 Num)
(extend CStr Eq)

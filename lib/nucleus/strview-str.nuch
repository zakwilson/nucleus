; .nuch header for lib/nucleus/strview-str.nuc
(ns nucleus.strview-str)
(import-use nucleus.strview)
(import-use nucleus.string-protocols)
(extend StrView (ByteStr ByteIter))
(defmethod "@nuc_byte_len.pnuc_StrView" byte-len ((self (ref StrView))) :usize)
(defmethod "@nuc_byte_at.pnuc_StrView.usize" byte-at ((self (ref StrView)) (i usize)) :!ui8)
(defmethod "@nuc_bytes.pnuc_StrView" bytes ((self (ref StrView))) :ByteIter)
(defmethod "@nuc_as_view.pnuc_StrView" as-view ((self (ref StrView))) :StrView)
(defmethod "@nuc_sub_bytes.pnuc_StrView.usize.usize" sub-bytes ((self (ref StrView)) (start usize) (end usize)) :!StrView)
(defmethod "@nuc_byte_find.pnuc_StrView.pnuc_StrView" byte-find ((self (ref StrView)) (needle (ref StrView))) :?usize)
(extend StrView (Str CharIter))
(defmethod "@nuc_char_count.pnuc_StrView" char-count ((self (ref StrView))) :usize)
(defmethod "@nuc_str_empty_QMARK.pnuc_StrView" str-empty? ((self (ref StrView))) :bool)
(defmethod "@nuc_char_at.pnuc_StrView.usize" char-at ((self (ref StrView)) (i usize)) :!Char)
(defmethod "@nuc_chars.pnuc_StrView" chars ((self (ref StrView))) :CharIter)
(defmethod "@nuc_starts_with_QMARK.pnuc_StrView.pnuc_StrView" starts-with? ((self (ref StrView)) (prefix (ref StrView))) :bool)
(defmethod "@nuc_ends_with_QMARK.pnuc_StrView.pnuc_StrView" ends-with? ((self (ref StrView)) (suffix (ref StrView))) :bool)
(defmethod "@nuc_contains_str_QMARK.pnuc_StrView.pnuc_StrView" contains-str? ((self (ref StrView)) (needle (ref StrView))) :bool)

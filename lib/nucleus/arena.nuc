; The process-lifetime arena: one `Arena` (lib/nucleus/allocator.nuc) that
; nothing ever drops, plus the zeroed, never-null `arena-alloc` the compiler and
; the node runtime allocate through.

(ns nucleus.arena)

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use "string.h")

(import-use nucleus.allocator)

; An empty arena over the heap, as a constant; the first allocation makes a block.
(defvar g-arena:Arena (Arena null null 0 0 &heap))

(defn arena-alloc (n:i64):ptr
  (let ((p ?&ui8) (arena-allocate &g-arena (unsafe/cast usize n) 8))
    (when (= (as ptr p) null)
      (do (perror "arena-alloc") (exit 1)))
    (return (as ptr p))))

; `n` bytes copied into the arena, so a borrowed buffer's contents can outlive
; it. Was `arena-strndup`, which also wrote a NUL its one caller never read.
(defn arena-bytes (src:ptr n:i64):ptr
  (let (p:ptr (arena-alloc n))
    (memcpy p src n)
    (return p)))

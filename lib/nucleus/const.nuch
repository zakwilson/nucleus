(defn const-cmp ((a (Entry K V)) (b (Entry K V))) :i32 (return (const-cmp (a (quote key)) (b (quote key)))))
(extend (Entry K V) ConstOrd)
(defn const-seal ((data (ref T)) (n usize) :where (ConstOrd T)) :usize (when (< n 2) (return n)) (let (i:usize 1) (while (< i n) (let (x:T (aref data (as i64 i)) j:usize i) (while (and (> j 0) (> (const-cmp (aref data (as i64 (- j 1))) x) 0)) (set! (aref data (as i64 j)) (aref data (as i64 (- j 1)))) (set! j (- j 1))) (set! (aref data (as i64 j)) x)) (set! i (+ i 1)))) (let (out:usize 0 i:usize 0) (while (< i n) (let (x:T (aref data (as i64 i))) (if (and (> out 0) (= (const-cmp (aref data (as i64 (- out 1))) x) 0)) (set! (aref data (as i64 (- out 1))) x) (do (set! (aref data (as i64 out)) x) (set! out (+ out 1))))) (set! i (+ i 1))) (return out)))
(defn const-find ((data (ref T)) (len usize) (x T) :where (ConstOrd T)) :usize (when (< len 8) (let (i:usize 0) (while (< i len) (when (= (const-cmp (aref data (as i64 i)) x) 0) (return i)) (set! i (+ i 1)))) (return len)) (let (lo:usize 0 hi:usize len) (while (< lo hi) (let (mid:usize (+ lo (/ (- hi lo) 2)) c:i32 (const-cmp (aref data (as i64 mid)) x)) (cond (= c 0) (return mid) (< c 0) (set! lo (+ mid 1)) true (set! hi mid))))) (return len))
(defn count ((self (ConstVec T))) :usize (return (self (quote len))))
(defn empty? ((self (ConstVec T))) :bool (return (= (self (quote len)) 0)))
(declare const-bounds ((i usize) (n usize)) :void)
(defn invoke ((self (ConstVec T)) (i usize)) :T (when (>= i (self (quote len))) (const-bounds i (self (quote len)))) (return (aref (unsafe/cast (ref T) (self (quote data))) (as i64 i))))
(defn contains? ((self (ConstVec T)) (e T)) :bool (let (p:ref:T (unsafe/cast (ref T) (self (quote data))) i:usize 0) (while (< i (self (quote len))) (when (= (aref p (as i64 i)) e) (return true)) (set! i (+ i 1)))) (return false))
(defstruct (ConstIter T) (data ptr) (pos usize) (len usize))
(extend (ConstIter T) (Iterator T))
(defn next ((self (ref (ConstIter T)))) :?T (when (>= (self (quote pos)) (self (quote len))) (return none)) (let (v:T (aref (unsafe/cast (ref T) (self (quote data))) (as i64 (self (quote pos))))) (set! (self (quote pos)) (+ (self (quote pos)) 1)) (return (some v))))

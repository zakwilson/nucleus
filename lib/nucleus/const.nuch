(defn iter ((self (ConstMap K V))) (ConstIter (Entry K V)) (let ((it (ref (ConstIter (Entry K V)))) (alloca (ConstIter (Entry K V)))) (set-fields! it (quote data) (self (quote data)) (quote pos) 0 (quote len) (self (quote len))) (return (deref it))))

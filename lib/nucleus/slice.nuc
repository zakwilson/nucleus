; (Slice T): a fixed-length view of elements another owner keeps in place — a
; pointer and a length, bounds-checked, handing elements out by reference, as
; C's &a[i] is. Unlike a Vector it never grows, so its elements never move.

(ns nucleus.slice)

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use nucleus.coll)
(import-use nucleus.iterator)
(import-use nucleus.vector)

(extern stderr:ptr)

(defstruct (Slice T) data:(ptr T) len:usize)

(defn slice-bounds (i:i64 n:usize):void
  (fprintf stderr "slice: index %lld out of bounds (len %llu)\n" i (as ui64 n))
  (exit 1))

; The `n` elements starting at `p`.
(defn slice-of (p:(ptr T) n:usize):(Slice T)
  (return ((Slice T) p n)))

; The live elements of `v`, valid until its next growth moves them.
(defn as-slice (v:&(Vector T)):(Slice T)
  (return ((Slice T) (unsafe/cast (ptr T) (as ptr (field v 'data))) (field v 'len))))

(defn count (self:&(Slice T)):usize
  (return (field self 'len)))

(defn empty? (self:&(Slice T)):bool
  (return (= (field self 'len) 0)))

; Yields the elements by value, as VecIter does; `(s i)` is the way to a reference.
(defstruct (SliceIter T) data:(ptr T) pos:usize len:usize)
(extend (SliceIter T) (Iterator T))

(defn next (self:&(SliceIter T)):?T
  (when (>= (field self 'pos) (field self 'len)) (return none))
  (let (v:T (aref (field self 'data) (as i64 (field self 'pos))))
    (set! (self 'pos) (+ (field self 'pos) 1))
    (return (some v))))

(extend (Slice T) (Coll T (SliceIter T)))

(defn iter (self:&(Slice T)) (SliceIter T)
  (let (it:&(SliceIter T) (alloca (SliceIter T)))
    (set-fields! it
                 'data (field self 'data)
                 'pos  0
                 'len  (field self 'len))
    (return @it)))

(defn invoke (self:&(Slice T) i:usize):&T
  (when (>= i (field self 'len)) (slice-bounds (unsafe/cast i64 i) (field self 'len)))
  (return (unsafe/cast &T (unsafe/ptr+ (field self 'data) (unsafe/cast i64 i)))))

(defn invoke (self:&(Slice T) i:i64):&T
  (when (or (< i 0) (>= (unsafe/cast usize i) (field self 'len)))
    (slice-bounds i (field self 'len)))
  (return (unsafe/cast &T (unsafe/ptr+ (field self 'data) i))))

(defn invoke (self:&(Slice T) i:i32):&T
  (return (invoke self (as i64 i))))

(defn set (self:&(Slice T) i:usize v:T):void
  (set! (deref (invoke self i)) v))

(defn set (self:&(Slice T) i:i64 v:T):void
  (set! (deref (invoke self i)) v))

(defn set (self:&(Slice T) i:i32 v:T):void
  (set! (deref (invoke self (as i64 i))) v))

; The index of an element of this slice, for code that subtracts the base as C does.
(defn index-of (self:&(Slice T) p:&T):usize
  (return (unsafe/cast usize (/ (- (unsafe/cast i64 p) (unsafe/cast i64 (field self 'data)))
                                (as i64 (sizeof T))))))

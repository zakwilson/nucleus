; Stage 17 B3 — files: an owning descriptor, and the buffered Writer emission
; needs.
;
; Design: design/stage17-native-strings/overview.md §2.1 (the sink column).
;
; `BufWriter` is the load-bearing half. IR emission is millions of small writes
; and `fprintf`'s one real advantage over a bare descriptor is its `FILE` buffer;
; this is that buffer, made explicit and flushable, so B2 can keep the standard
; streams unbuffered without costing the conversion its throughput.

(ns nucleus.file)

(import-use "fcntl.h")
(import-use "unistd.h")
(import-use "dirent.h")
(import-use "sys/stat.h")

(import-use nucleus.error)
(import-use nucleus.string-errors)
(import-use nucleus.char)
(import-use nucleus.strview)
(import-use nucleus.allocator)
(import-use nucleus.vector)
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use nucleus.coll)

; `O_*` come from the target's own <fcntl.h>, so the values are the emission
; target's (design/stage17-native-strings/platform-constants.md). `0644` is a
; literal in every libc, not a macro.
(defconst MODE-644 420)    ; 0644
(defconst MODE-755 493)    ; 0755

(defconst FILE-CHUNK 65536)

; ---------------------------------------------------------------------------
; File — an owning descriptor, closed by Drop.
; ---------------------------------------------------------------------------
(defstruct File fd:i32)

(defn file (fd:i32):File
  (let (f:&File (alloca File))
    (set! (f 'fd) fd)
    (return @f)))

(extend File Drop)
(defn drop (self:&File):void
  (when (>= (self 'fd) 0)
    (close (self 'fd))
    ; -1 so a `with` scope that already closed explicitly does not close a
    ; descriptor some later `open` has since handed to someone else.
    (set! (self 'fd) -1)))

; Close now and observe the result. `close` can fail late (a deferred write
; error on NFS), which the `Drop` path has no way to report.
(defn file-close (self:&File):!void
  (let (fd:i32 (self 'fd))
    (set! (self 'fd) -1)
    (when (< fd 0) (return (ok)))
    (when (!= (close fd) 0) (return (err! io-write-failed))))
  (return (ok)))

; open(2) wants a NUL-terminated path and a StrView is not one, so the path is
; copied. Unchecked: a path is bytes, not necessarily UTF-8.
(defn file-open-flags (path:&StrView flags:i32 mode:i32):!File
  (let (buf:&String (alloca String))
    (init buf)
    (string-push-str-unchecked buf path)
    (let (fd:i32 (open (string-as-cstr buf) flags mode))
      (drop buf)
      (when (< fd 0) (return (err! io-open-failed)))
      (return (ok (file fd))))))

(defn file-open-read (path:&StrView):!File
  (return (file-open-flags path O_RDONLY 0)))

(defn file-create (path:&StrView):!File
  (return (file-open-flags path (bit-or O_WRONLY (bit-or O_CREAT O_TRUNC))
                           MODE-644)))

(defn file-open-append (path:&StrView):!File
  (return (file-open-flags path (bit-or O_WRONLY (bit-or O_CREAT O_APPEND))
                           MODE-644)))

; ---------------------------------------------------------------------------
; Reading and writing
; ---------------------------------------------------------------------------
(defn file-write-bytes (self:&File p:&ui8 n:usize):!void
  (let (off:usize 0)
    (while (< off n)
      (let (w:i64 (as i64 (write (self 'fd)
                            (as ptr (unsafe/ptr+ p (as i64 off)))
                            (as i64 (- n off)))))
        (when (<= w 0) (return (err! io-write-failed)))
        (set! off (+ off (as usize w))))))
  (return (ok)))

(extend File Writer)

(defn write-str (self:&File s:StrView):!void
  (when (= (s 'len) 0) (return (ok)))
  (return (file-write-bytes self (s 'data) (s 'len))))

; The whole file, from the current offset. Bytes, not text: no UTF-8 validation,
; because the compiler reads source files whose encoding is the *program's*
; problem to diagnose, not the reader's to refuse.
(defn file-read-to-string (self:&File):!String
  (let (out:&String (alloca String)
        buf:&ui8 (as &ui8 (alloca ui8 FILE-CHUNK))
        go:bool true)
    (init out)
    (while go
      (let (n:i64 (as i64 (read (self 'fd) (as ptr buf) FILE-CHUNK)))
        (when (< n 0)
          (drop out)
          (return (err! io-read-failed)))
        (when (= n 0) (set! go false))
        (when go (string-push-bytes-raw out buf (as usize n)))))
    (return (ok @out))))

; ---------------------------------------------------------------------------
; BufWriter — a File plus a staging buffer.
; ---------------------------------------------------------------------------
(defconst BUF-WRITER-CAP 65536)

(defstruct BufWriter
  out:File
  buf:String)

(defn buf-writer (f:File):BufWriter
  (let (b:&BufWriter (alloca BufWriter))
    (set! (b 'out) f)
    (init (ref b 'buf))
    (string-reserve (ref b 'buf) BUF-WRITER-CAP)
    (return @b)))

(defn flush (self:&BufWriter):!void
  (let (v:StrView (string-as-view (ref self 'buf)))
    (when (> (v 'len) 0)
      (try (file-write-bytes (ref self 'out) (v 'data) (v 'len)))
      (string-clear (ref self 'buf))))
  (return (ok)))

(extend BufWriter Writer)

; Anything at least a bufferful goes straight to the descriptor: staging it
; would be a memcpy that buys no syscall.
(defn write-str (self:&BufWriter s:StrView):!void
  (when (= (s 'len) 0) (return (ok)))
  (when (>= (s 'len) BUF-WRITER-CAP)
    (try (flush self))
    (return (file-write-bytes (ref self 'out) (s 'data) (s 'len))))
  (when (> (+ (byte-len (ref self 'buf)) (s 'len)) BUF-WRITER-CAP)
    (try (flush self)))
  (string-push-str-unchecked (ref self 'buf) &s)
  (return (ok)))

; Flush, then close. A `Drop`-only path cannot report a failed final write, so
; call this when the bytes reaching disk is something the program must know.
(defn buf-writer-close (self:&BufWriter):!void
  (try (flush self))
  (return (file-close (ref self 'out))))

(extend BufWriter Drop)
(defn drop (self:&BufWriter):void
  ; The flush result is unobservable here — that is what `buf-writer-close` is
  ; for. Dropping without it still writes the bytes on the ordinary path.
  (flush self)
  (drop (ref self 'out))
  (drop (ref self 'buf)))

; ---------------------------------------------------------------------------
; Directories
;
; Design: design/stage18-tooling/overview.md §T3 lists directory enumeration
; among the filesystem surface `lib/nucleus/file.nuc` was missing; TF-6 category (b) is
; the consumer that needed it.
; ---------------------------------------------------------------------------

(deferror dir-layout-unknown "struct dirent is not the assumed layout")

; `d_name`'s byte offset in `struct dirent` on 64-bit glibc and musl:
; ino_t(8) + off_t(8) + unsigned short(2) + unsigned char(1). The C-header
; reader registers `struct dirent` opaque -- its `char d_name[256]` is a shape
; the declaration parser declines -- so the offset cannot be asked for. It is
; validated rather than trusted: see `read-dir`.
(defconst DIRENT-D-NAME-OFFSET 19)
; `d_type`, the byte before `d_name` in the same layouts; `.` and `..` validate it too.
(defconst DIRENT-D-TYPE-OFFSET 18)

; One buffer of NUL-terminated names plus their offsets, the shape `Command`
; uses and for the same reason: `Vector`'s drop frees its array without dropping
; elements, so a (Vector String) would leak every name.
(defstruct DirEntries
  buf:String
  offs:(Vector usize)
  ; Each entry's `d_type`, with `DT_UNKNOWN` already resolved.
  kinds:(Vector ui8))

(defn dir-entries-new ():DirEntries
  (let (e:&DirEntries (alloca DirEntries))
    (init (ref e 'buf))
    (init (ref e 'offs))
    (init (ref e 'kinds))
    (return @e)))

(defn dir-count (self:&DirEntries):usize
  (return (count (ref self 'offs))))

; A symlink is not a directory here, whatever it points at.
(defn dir-is-dir? (self:&DirEntries i:usize):bool
  (return (= (as i32 (invoke (ref self 'kinds) i)) DT_DIR)))

; Valid while the DirEntries is alive and unmodified.
(defn dir-name (self:&DirEntries i:usize):StrView
  (let (v:StrView (string-as-view (ref self 'buf)))
    (return (strview-from-cstr
              (as CStr (unsafe/ptr+ (unsafe/cast &i8 (as ptr (v 'data)))
                                    (as i64 (invoke (ref self 'offs) i))))))))

(extend DirEntries Drop)
(defn drop (self:&DirEntries):void
  (drop (ref self 'buf))
  (drop (ref self 'offs))
  (drop (ref self 'kinds)))

; The terminator is a real byte of the buffer: every name but the last has more
; bytes after it, so `string-as-cstr`'s past-the-end NUL would not do.
(defn dir-push (self:&DirEntries nm:StrView kind:ui8):void
  (let (off:usize (byte-len (ref self 'buf))
        z:&ui8 (as &ui8 (alloca ui8 1)))
    (string-push-str-unchecked (ref self 'buf) &nm)
    (set! (aref z 0) 0)
    (string-push-bytes-raw (ref self 'buf) z 1)
    (conj (ref self 'offs) off)
    (conj (ref self 'kinds) kind)))

; Insertion sort over the OFFSETS, which is why the names never move: an
; offset is a usize and the buffer is untouched.
(defn dir-sort (self:&DirEntries):void
  (let (n:usize (dir-count self)
        i:usize 1)
    (while (< i n)
      (let (key:usize (invoke (ref self 'offs) i)
            kind:ui8 (invoke (ref self 'kinds) i)
            kv:StrView (dir-name self i)
            j:i64 (- (as i64 i) 1)
            placed:i32 0)
        (while (and (>= j 0) (= placed 0))
          (let (jv:StrView (dir-name self (as usize j)))
            (if (<= (strview-cmp-raw &jv &kv) 0)
              (set! placed 1)
              (do
                (set (ref self 'offs) (as usize (+ j 1))
                     (invoke (ref self 'offs) (as usize j)))
                (set (ref self 'kinds) (as usize (+ j 1))
                     (invoke (ref self 'kinds) (as usize j)))
                (set! j (- j 1))))))
        (set (ref self 'offs) (as usize (+ j 1)) key)
        (set (ref self 'kinds) (as usize (+ j 1)) kind))
      (set! i (+ i 1)))))

; Where `d_type` is unknown, `readlink` finds a symlink first, because `opendir`
; would follow it and a walk would enter a link cycle.
(defn dir-resolve-kind (dir:StrView nm:StrView kind:ui8):ui8
  (when (!= (as i32 kind) DT_UNKNOWN) (return kind))
  (let (p:String (str dir "/" nm)
        one:&i8 (alloca i8)
        k:i32 (cond (>= (readlink (string-as-cstr &p) one 1) 0) DT_LNK
                    (dir-exists? (string-as-view &p)) DT_DIR
                    true DT_REG))
    (drop &p)
    (return (unsafe/cast ui8 k))))

; Every entry in `path` except `.` and `..`, sorted by name.
;
; Sorted because `readdir` order is filesystem-dependent: a caller enumerating a
; corpus would otherwise get a different test order on every machine.
;
; The offset above is validated here, not trusted. Every POSIX directory
; contains `.` and `..`, so if neither is found the offset is wrong on this
; platform and this fails -- rather than returning names read out of the middle
; of `d_ino`.
(defn read-dir (path:StrView):!DirEntries
  (let (cpath:String (try (string-from-view &path))
        d:ptr (opendir (string-as-cstr &cpath)))
    (drop &cpath)
    (when (= d null) (return (err! io-open-failed)))
    (let (e:&DirEntries (alloca DirEntries)
          seen:i32 0
          ent:ptr (readdir d))
      (init (ref e 'buf))
      (init (ref e 'offs))
      (init (ref e 'kinds))
      (while (!= ent null)
        (let (nm:StrView (strview-from-cstr
                           (as CStr (unsafe/ptr+ (unsafe/cast &i8 ent) DIRENT-D-NAME-OFFSET)))
              kind:ui8 (aref (unsafe/cast &ui8 ent) DIRENT-D-TYPE-OFFSET)
              dir-ok:bool (or (= (as i32 kind) DT_DIR) (= (as i32 kind) DT_UNKNOWN)))
          (cond (= nm ".") (when dir-ok (set! seen (bit-or seen 1)))
                (= nm "..") (when dir-ok (set! seen (bit-or seen 2)))
                true (dir-push e nm (dir-resolve-kind path nm kind))))
        (set! ent (readdir d)))
      (closedir d)
      (when (!= seen 3)
        (drop e)
        (return (err! dir-layout-unknown)))
      (dir-sort e)
      (return (ok @e)))))

; True when `path` names a directory this process may open.
(defn dir-exists? (path:StrView):bool
  (match (string-from-view &path)
    ((ok p)
      (let (s:String p
            d:ptr (opendir (string-as-cstr &s)))
        (drop &s)
        (when (= d null) (return false))
        (closedir d)
        (return true)))
    ((err e) (return false))))

; Create `path`, one level. Idempotent -- an existing directory is success,
; which is what every caller means by "make sure this is there". Re-checked with
; `opendir` rather than `errno`: `EEXIST` is a C macro the header import does
; not carry, and the question a caller actually has is whether the directory is
; there now.
(defn make-dir (path:StrView):!void
  (let (p:String (try (string-from-view &path))
        rc:i32 (mkdir (string-as-cstr &p) MODE-755))
    (drop &p)
    (when (= rc 0) (return (ok))))
  (when (dir-exists? path) (return (ok)))
  (return (err! io-open-failed)))

; ---------------------------------------------------------------------------
; File metadata, rename, remove, and paths (design/stage27-build/plan.md BT-1)
; ---------------------------------------------------------------------------

(import-use "stdlib.h")

(defconst FILE-KIND-OTHER 0)
(defconst FILE-KIND-REG 1)
(defconst FILE-KIND-DIR 2)

; Nanoseconds, not seconds: two writes in one second must still compare as changed.
(defstruct FileStat mtime-ns:i64 size:i64 kind:i32)

(defn c-path (path:&StrView):String
  (let (p:&String (alloca String))
    (init p)
    (string-push-str-unchecked p path)
    (return @p)))

; `stat`, so a symlink reports its target.
(defn file-stat (path:StrView):!FileStat
  (let (p:String (c-path &path)
        sb:&stat (as &stat (alloca stat 1))
        rc:i32 (stat (string-as-cstr &p) sb))
    (drop &p)
    (when (!= rc 0) (return (err! io-stat-failed)))
    (let (fmt:i32 (bit-and (as i32 (sb 'st_mode)) S_IFMT)
          t:timespec (sb 'st_mtim))
      (return (ok (FileStat (+ (* (as i64 (t 'tv_sec)) 1000000000) (as i64 (t 'tv_nsec)))
                            (as i64 (sb 'st_size))
                            (cond (= fmt S_IFREG) FILE-KIND-REG
                                  (= fmt S_IFDIR) FILE-KIND-DIR
                                  true FILE-KIND-OTHER)))))))

(defn file-exists? (path:StrView):bool
  (match (file-stat path)
    ((ok s) (return true))
    ((err e) (return false))))

; Atomic within one filesystem, which is what replace-by-rename relies on.
(defn rename-file (from:StrView to:StrView):!void
  (let (a:String (c-path &from)
        b:String (c-path &to)
        rc:i32 (rename (string-as-cstr &a) (string-as-cstr &b)))
    (drop &a)
    (drop &b)
    (when (!= rc 0) (return (err! io-rename-failed)))
    (return (ok))))

; A file, or an empty directory.
(defn remove-file (path:StrView):!void
  (let (p:String (c-path &path)
        rc:i32 (unlink (string-as-cstr &p)))
    (when (!= rc 0) (set! rc (rmdir (string-as-cstr &p))))
    (drop &p)
    (when (!= rc 0) (return (err! io-remove-failed)))
    (return (ok))))

; Absolute, with every symlink, `.` and `..` resolved; the path must exist.
(defn real-path (path:StrView):!String
  (let (p:String (c-path &path)
        r:?&i8 (realpath (string-as-cstr &p) null))
    (drop &p)
    (match r
      (none (return (err! io-path-failed)))
      ((some q)
        (let (v:StrView (strview-from-cstr (as CStr q))
              out:String (c-path &v))
          (free (as ptr q))
          (return (ok out)))))))

; The running executable, through `/proc/self/exe` (Linux; plan.md D-LINUX).
(defn exe-path ():!String
  (return (real-path "/proc/self/exe")))

; ---------------------------------------------------------------------------
; Tracked reads (plan.md BT-2 P3). A macro body runs in the compiler's process,
; so a read through here lands in the buffer the compiler's `--depfile` lists.
; A direct `open`/`fopen` is not tracked.
; ---------------------------------------------------------------------------

; Lazily allocated: a library global with a run-time initializer would run in
; every program that links this file.
(defvar g-tracked-reads:?&String null)

(defn track-read (path:StrView):void
  (when (= g-tracked-reads null)
    (let (s:&String (unsafe/cast &String (malloc (sizeof String))))
      (init s)
      (set! g-tracked-reads s)))
  (let (b:&String (unsafe/cast &String g-tracked-reads)
        z:&ui8 (as &ui8 (alloca ui8 1)))
    (set! (aref z 0) 0)
    (string-push-str-unchecked b &path)
    (string-push-bytes-raw b z 1)))

; Every tracked path, each followed by a NUL byte.
(defn tracked-reads ():StrView
  (when (= g-tracked-reads null) (return ""))
  (return (string-as-view (unsafe/cast &String g-tracked-reads))))

; The whole file, as bytes, with the path tracked first so a failed read still
; makes the output depend on the file appearing.
(defn read-file-tracked (path:StrView):!String
  (track-read path)
  (let (f:File (try (file-open-read &path))
        r:!String (file-read-to-string &f))
    (drop &f)
    (return r)))

; An environment variable, or none when it is unset or empty.
(defn env-var (name:StrView):?StrView
  (let (n:String (c-path &name)
        v:?&i8 (getenv (string-as-cstr &n)))
    (drop &n)
    (match v
      (none (return (none)))
      ((some q)
        (let (sv:StrView (strview-from-cstr (as CStr q)))
          (when (= (sv 'len) 0) (return (none)))
          (return (some sv)))))))

; The XDG base directory spec ignores a relative value, so only an absolute one wins.
(defn xdg-home-dir (fallback:StrView):!String
  (match (env-var "HOME")
    ((some h) (return (ok (str h "/" fallback))))
    (none (return (err! io-path-failed)))))

(defn xdg-dir (var:StrView fallback:StrView):!String
  (match (env-var var)
    ((some v)
      (if (= (aref (v 'data) 0) 47)
        (return (ok (c-path &v)))
        (return (xdg-home-dir fallback))))
    (none (return (xdg-home-dir fallback)))))

(defn xdg-config-home ():!String (return (xdg-dir "XDG_CONFIG_HOME" ".config")))
(defn xdg-cache-home ():!String (return (xdg-dir "XDG_CACHE_HOME" ".cache")))

; ---------------------------------------------------------------------------
; Globs and the recursive walk (design/stage26-refactoring/overview.md §8 RF-3a)
; ---------------------------------------------------------------------------

; Unchecked: every caller has just bounds-checked `i`.
(defn glob-byte-at (v:&StrView i:usize):ui8
  (return (aref (v 'data) i)))

; A text glob: `*` matches any run of bytes, `/` included, and `?` any single
; byte. Backtracking rather than recursive: one remembered `*` is enough, since a
; second supersedes the first.
(defn glob-match (pat:&StrView s:&StrView):bool
  (let (pn:usize (strview-byte-len pat)
        sn:usize (strview-byte-len s)
        pi:usize 0
        si:usize 0
        star:i64 -1
        mark:usize 0)
    (while (< si sn)
      (let (starred:bool false
            matched:bool false)
        (when (< pi pn)
          (let (pc:ui8 (glob-byte-at pat pi))
            (set! starred (= pc 42))
            (set! matched (or (= pc 63) (= pc (glob-byte-at s si))))))
        (cond starred
                (do (set! star (as i64 pi))
                    (set! mark si)
                    (set! pi (+ pi 1)))
              matched
                (do (set! pi (+ pi 1))
                    (set! si (+ si 1)))
              (>= star 0)
                (do (set! pi (+ (as usize star) 1))
                    (set! mark (+ mark 1))
                    (set! si mark))
              true
                (return false))))
    (while (and (< pi pn) (= (glob-byte-at pat pi) 42))
      (set! pi (+ pi 1)))
    (return (= pi pn))))

; The end of the `/`-separated component that starts at byte `at`.
(defn path-comp-end (s:&StrView at:usize):usize
  (let (i:usize at
        n:usize (s 'len))
    (while (and (< i n) (!= (glob-byte-at s i) 47))
      (set! i (+ i 1)))
    (return i)))

(defn path-comp (s:&StrView at:usize end:usize):StrView
  (return (strview-take-bytes (strview-drop-bytes @s at) (- end at))))

; A component's leading `.` is matched only by a literal `.`.
(defn path-comp-match (pc:&StrView sc:&StrView):bool
  (when (and (> (sc 'len) 0) (= (glob-byte-at sc 0) 46)
             (or (= (pc 'len) 0) (!= (glob-byte-at pc 0) 46)))
    (return false))
  (return (glob-match pc sc)))

; The components of `pat` from byte `pi` against those of `path` from byte
; `si`. A position past the end means no components are left.
(defn path-glob-from (pat:&StrView pi:usize path:&StrView si:usize):bool
  (when (> pi (pat 'len)) (return (> si (path 'len))))
  (let (pe:usize (path-comp-end pat pi)
        pc:StrView (path-comp pat pi pe))
    (when (= pc "**")
      ; Only a `**` with a component after it matches zero: a trailing one names what is below.
      (when (and (< pe (pat 'len)) (path-glob-from pat (+ pe 1) path si)) (return true))
      (let (s:usize si)
        (while (<= s (path 'len))
          (when (and (< s (path 'len)) (= (glob-byte-at path s) 46)) (return false))
          (set! s (+ (path-comp-end path s) 1))
          (when (path-glob-from pat (+ pe 1) path s) (return true))))
      (return false))
    (when (> si (path 'len)) (return false))
    (let (se:usize (path-comp-end path si)
          sc:StrView (path-comp path si se))
      (return (and (path-comp-match &pc &sc)
                   (path-glob-from pat (+ pe 1) path (+ se 1)))))))

; A path glob, as bash's with `globstar`: `*` and `?` match within one
; `/`-separated component, a component that is exactly `**` matches any number
; of whole components, and only a literal `.` matches a component's leading `.`.
(defn path-glob-match (pat:&StrView path:&StrView):bool
  (return (path-glob-from pat 0 path 0)))

; Within one directory a subdirectory sorts as its name plus `/`, which makes
; the preorder walk the bytewise order of the whole paths.
(defn walk-key-tail (nm:&StrView k:usize dir:bool):i32
  (cond (< k (nm 'len)) (return (as i32 (glob-byte-at nm k)))
        dir (return 47)
        true (return -1)))

(defn walk-less? (d:&DirEntries a:usize b:usize):bool
  (let (x:StrView (dir-name d a)
        y:StrView (dir-name d b)
        k:usize 0)
    (while (and (< k (x 'len)) (< k (y 'len)))
      (let (cx:ui8 (glob-byte-at &x k)
            cy:ui8 (glob-byte-at &y k))
        (when (!= cx cy) (return (< cx cy))))
      (set! k (+ k 1)))
    (return (< (walk-key-tail &x k (dir-is-dir? d a)) (walk-key-tail &y k (dir-is-dir? d b))))))

(defn walk-order (d:&DirEntries):(Vector usize)
  (let (v:&(Vector usize) (alloca (Vector usize))
        n:usize (dir-count d)
        i:usize 0)
    (init v)
    (while (< i n)
      (let (j:usize i)
        (while (and (> j 0) (walk-less? d i (invoke v (- j 1))))
          (set! j (- j 1)))
        (insert v j i))
      (set! i (+ i 1)))
    (return @v)))

; `dir`'s entries in walk order, each subdirectory's in its place. A path is
; `prefix` plus the name; `filter` keeps only paths matching `pat`, and without
; `hidden` no `.`-name is listed or entered.
(defn walk-into (out:&DirEntries dir:StrView prefix:StrView filter:bool pat:StrView
                 hidden:bool):!void
  (with (d:DirEntries (try (read-dir dir))
         order:(Vector usize) (walk-order &d))
    (let (i:usize 0)
      (while (< i (count &order))
        (let (k:usize (invoke &order i)
              nm:StrView (dir-name &d k))
          (when (or hidden (not (strview-has-prefix nm ".")))
            (with (path:String (str prefix nm))
              (let (pv:StrView (string-as-view &path))
                (if (dir-is-dir? &d k)
                  (with (sub:String (str prefix nm "/"))
                    (try (walk-into out pv (string-as-view &sub) filter pat hidden)))
                  (when (or (not filter) (path-glob-match &pat &pv))
                    (dir-push out pv (invoke (ref d 'kinds) k))))))))
        (set! i (+ i 1)))))
  (return (ok)))

; Every non-directory under `root`, as `root/…` paths in bytewise order (what
; `LC_ALL=C sort` gives). A symlink is listed and never entered.
(defn walk-dir (root:StrView):!DirEntries
  (with (out:DirEntries (dir-entries-new)
         prefix:String (str root (if (strview-has-suffix root "/") "" "/")))
    (try (walk-into &out root (string-as-view &prefix) false "" true))
    (return (ok (move out)))))

; Whether a component of `pat` from byte `at` on starts with `.`.
(defn glob-names-hidden? (pat:&StrView at:usize):bool
  (let (i:usize at)
    (while (<= i (pat 'len))
      (when (and (< i (pat 'len)) (= (glob-byte-at pat i) 46)) (return true))
      (set! i (+ (path-comp-end pat i) 1)))
    (return false)))

; Where `pat`'s first component holding a `*` or `?` starts, or past the end.
(defn glob-literal-end (pat:&StrView):usize
  (let (i:usize 0)
    (while (<= i (pat 'len))
      (let (e:usize (path-comp-end pat i)
            j:usize i)
        (while (< j e)
          (let (c:ui8 (glob-byte-at pat j))
            (when (or (= c 42) (= c 63)) (return i)))
          (set! j (+ j 1)))
        (set! i (+ e 1))))
    (return i)))

(defn path-readable? (path:StrView):bool
  (match (file-open-read &path)
    ((ok f) (let (fh:File f)
              (drop &fh)
              (return true)))
    ((err e) (return false))))

; The non-directories matching the path glob `pat`, in bytewise order. The walk
; starts below `pat`'s literal leading components (`lib` for `lib/**/*.nuc`); a
; missing start matches nothing, and a pattern with no wildcard names one path.
(defn glob-files (pat:StrView):!DirEntries
  (with (out:DirEntries (dir-entries-new))
    (let (lit:usize (glob-literal-end &pat))
      (cond (> lit (pat 'len))
              (when (and (not (dir-exists? pat)) (path-readable? pat))
                (dir-push &out pat (unsafe/cast ui8 DT_REG)))
            (= lit 0)
              (try (walk-into &out "." "" true pat (glob-names-hidden? &pat 0)))
            true
              (let (prefix:StrView (strview-take-bytes pat lit)
                    dir:StrView (if (= lit 1) "/" (strview-take-bytes pat (- lit 1))))
                (when (dir-exists? dir)
                  (try (walk-into &out dir prefix true pat (glob-names-hidden? &pat lit)))))))
    (return (ok (move out)))))

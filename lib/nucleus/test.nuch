; .nuch header for lib/nucleus/test.nuc
(ns nucleus.test)
(import-use nucleus.error)
(import-use nucleus.strview)
(import-use nucleus.string)
(import-use nucleus.string-split)
(import-use nucleus.fmt)
(import-use nucleus.vector)
(import-use nucleus.io)
(import-use nucleus.file)
(import-use nucleus.allocator)
(import-use nucleus.read)
(import-use nucleus.keyword)
(import-use nucleus.edn)
(import-use nucleus.intern)
(deferror test-failed "assertion failed")
(deferror test-skipped "test skipped")
(deferror test-unknown "no such test")
(deferror test-bad-args "bad arguments")
(defenum TestStatus TEST-PASS TEST-FAIL TEST-SKIP)
(extern (g-test-no-skip bool))
(defstruct TestCase (name Symbol) (file StrView) (line i32) (run ((fn !void) (ptr))) (data ptr))
(extern (g-test-alloc AllocHandle))
(extern (g-tests (ref (Vector TestCase))))
(extern (g-fail-buf String))
(extern (g-fail-ready i32))
(declare test-add ((name StrView) (file StrView) (line i32) (f (fn !void) (ptr)) (data ptr)) :void)
(declare test-register ((name (ref Node)) (file StrView) (line i32) (f (fn !void) (ptr))) :i32)
(defmacro deftest (name :rest body) (let (g:ptr (gensym) a:ptr (gensym)) (quasiquote (defvar ((unquote g) i32) (test-register (quote (unquote name)) (source-file) (source-line) (fn (((unquote a) ptr)) :!void (unquote-splice body) (return (ok))))))))
(declare test-fail-begin () :ref:String)
(declare test-failure-text () :StrView)
(declare test-failure-len () :usize)
(defmacro fail! (:rest parts) (let (b:ptr (gensym)) (quasiquote (let (((unquote b) (ref String)) (test-fail-begin)) (str-into (unquote b) (unquote-splice parts)) (return (err! test-failed))))))
(defmacro skip! (:rest parts) (let (b:ptr (gensym)) (quasiquote (let (((unquote b) (ref String)) (test-fail-begin)) (str-into (unquote b) (unquote-splice parts)) (return (err! test-skipped))))))
(defconst SHOW-LIMIT 400)
(declare test-show ((s StrView)) :StrView)
(declare test-byte-at ((v (ref StrView)) (i usize)) :ui8)
(declare glob-match ((pat (ref StrView)) (s (ref StrView))) :bool)
(defmethod "@contains_QMARK.StrView.StrView" contains? ((hay StrView) (needle StrView)) :bool)
(declare has-line? ((hay StrView) (want StrView)) :bool)
(declare has-matching-line? ((hay StrView) (pat StrView)) :bool)
(declare check-contains ((hay StrView) (needle StrView)) :!void)
(declare check-not-contains ((hay StrView) (needle StrView)) :!void)
(declare check-line ((hay StrView) (want StrView)) :!void)
(declare check-eq ((got StrView) (want StrView)) :!void)
(declare check-match ((hay StrView) (pat StrView)) :!void)
(declare check-not-match ((hay StrView) (pat StrView)) :!void)
(declare read-file ((path StrView)) :!String)
(declare check-golden ((got StrView) (want StrView)) :!void)
(declare check-files-eq ((a StrView) (b StrView)) :!void)
(declare check-empty ((s StrView)) :!void)
(declare check-non-empty ((s StrView)) :!void)
(declare check ((cond bool) (what StrView)) :!void)
(declare check-eq-int ((got i64) (want i64) (what StrView)) :!void)
(declare ir-define ((module StrView) (name StrView)) :?StrView)
(declare check-in-define ((module StrView) (fname StrView) (pat StrView)) :!void)
(declare check-not-in-define ((module StrView) (fname StrView) (pat StrView)) :!void)
(defstruct Diagnostic (severity Keyword) (file StrView) (line i32) (message StrView) (notes (ref (Vector StrView))))
(declare diag-of-node ((m (?ref Node))) :!Diagnostic)
(declare read-diagnostics ((text StrView)) (! (Vector Diagnostic)))
(declare diag-list-text ((ds (ref (Vector Diagnostic)))) :String)
(declare diag-matches ((d (ref Diagnostic)) (severity StrView) (file StrView) (line i32) (needle StrView)) :bool)
(declare check-diagnostic ((ds (ref (Vector Diagnostic))) (severity StrView) (file StrView) (line i32) (needle StrView)) :!void)
(declare check-error-at ((ds (ref (Vector Diagnostic))) (file StrView) (line i32) (needle StrView)) :!void)
(declare check-warning-at ((ds (ref (Vector Diagnostic))) (file StrView) (line i32) (needle StrView)) :!void)
(declare check-error-anywhere ((ds (ref (Vector Diagnostic))) (needle StrView)) :!void)
(declare check-note-at ((ds (ref (Vector Diagnostic))) (file StrView) (line i32) (needle StrView)) :!void)
(declare check-note-anywhere ((ds (ref (Vector Diagnostic))) (needle StrView)) :!void)
(declare check-no-line-zero ((ds (ref (Vector Diagnostic)))) :!void)
(declare check-no-errors ((ds (ref (Vector Diagnostic)))) :!void)
(defstruct Quoted (v StrView))
(declare quoted ((v StrView)) :Quoted)
(extend Quoted ToStr)
(defmethod "@to_str.Quoted.pString" to-str ((self Quoted) (out (ref String))) :!void)
(declare test-report ((tc (ref TestCase)) (status i32)) :void)
(extern (g-test-scratch StrView))
(declare test-scratch-set ((name StrView)) :void)
(declare test-scratch () :!StrView)
(declare test-scratch-sub ((name StrView)) :!String)
(declare test-write-file ((name StrView) (content StrView)) :!String)
(declare test-run-one ((tc (ref TestCase))) :i32)
(declare test-find ((name StrView)) :?usize)
(declare test-run-all ((shard usize) (nshards usize)) :i32)
(declare test-duplicate-name () :Symbol)
(declare test-list () :void)
(declare test-parse-shard ((a StrView) (out-shard (ref usize)) (out-n (ref usize))) :!void)
(declare test-main ((argc i32) (argv ptr)) :i32)

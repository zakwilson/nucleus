; .nuch header for lib/nucleus/file.nuc
(ns nucleus.file)
(import-use nucleus.error)
(import-use nucleus.string-errors)
(import-use nucleus.char)
(import-use nucleus.strview)
(import-use nucleus.allocator)
(import-use nucleus.vector)
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use nucleus.coll)
(defconst MODE-644 420)
(defconst MODE-755 493)
(defconst FILE-CHUNK 65536)
(defstruct File (fd i32))
(declare file ((fd i32)) :File)
(extend File Drop)
(defmethod "@nuc_drop.pnuc_File" drop ((self (ref File))) :void)
(declare file-close ((self (ref File))) :!void)
(declare file-open-flags ((path (ref StrView)) (flags i32) (mode i32)) :!File)
(declare file-open-read ((path (ref StrView))) :!File)
(declare file-create ((path (ref StrView))) :!File)
(declare file-open-append ((path (ref StrView))) :!File)
(declare file-write-bytes ((self (ref File)) (p (ref ui8)) (n usize)) :!void)
(extend File Writer)
(defmethod "@nuc_write_str.pnuc_File.nuc_StrView" write-str ((self (ref File)) (s StrView)) :!void)
(declare file-read-to-string ((self (ref File))) :!String)
(defconst BUF-WRITER-CAP 65536)
(defstruct BufWriter (out File) (buf String))
(declare buf-writer ((f File)) :BufWriter)
(declare flush ((self (ref BufWriter))) :!void)
(extend BufWriter Writer)
(defmethod "@nuc_write_str.pnuc_BufWriter.nuc_StrView" write-str ((self (ref BufWriter)) (s StrView)) :!void)
(declare buf-writer-close ((self (ref BufWriter))) :!void)
(extend BufWriter Drop)
(defmethod "@nuc_drop.pnuc_BufWriter" drop ((self (ref BufWriter))) :void)
(deferror dir-layout-unknown "struct dirent is not the assumed layout")
(defconst DIRENT-D-NAME-OFFSET 19)
(defstruct DirEntries (buf String) (offs (Vector usize)))
(declare dir-count ((self (ref DirEntries))) :usize)
(declare dir-name ((self (ref DirEntries)) (i usize)) :StrView)
(extend DirEntries Drop)
(defmethod "@nuc_drop.pnuc_DirEntries" drop ((self (ref DirEntries))) :void)
(declare dir-push-name ((self (ref DirEntries)) (nm StrView)) :usize)
(declare dir-sort ((self (ref DirEntries))) :void)
(declare read-dir ((path StrView)) :!DirEntries)
(declare dir-exists? ((path StrView)) :bool)
(declare make-dir ((path StrView)) :!void)

; Stage 11 M6 (S5) — strview-split / strview-lines: lazy string splitting.
;
; SplitIter and LineIter are forward-only cursors over a StrView that yield
; borrowed sub-views (pointing into the original buffer) without allocation.
;
; Design: design/stage11/string.md §"S5 split/lines/trim + FromStr/parse".
;
; ---------------------------------------------------------------------------
; TOKENIZER NOTES (carried from strview.nuc):
;   - `?` and `!` must NOT appear in plain defn names (LLVM IR rejects them).
;   - Parameters whose type is a parenthesised form use list binding:
;     `(self (ref SplitIter))`, never `self:(ref SplitIter)`.
;   - Return type StrView (struct by value) goes through sret ABI.
; ---------------------------------------------------------------------------

(ns nucleus.string-split)

(import-use "stdlib.h")
(import-use "string.h")

(import-use nucleus.strview)
(import-use nucleus.iterator)

; ---------------------------------------------------------------------------
; SplitIter — lazy byte-level split of a StrView on a delimiter StrView.
;
; Fields:
;   buf      — pointer into the source buffer at the start of the unsearched
;              region (advances by sep-len after each yield).
;   rem      — bytes remaining from `buf` to the end of the source.
;   sep-data — pointer to the separator bytes.
;   sep-len  — byte length of the separator.
;   done     — false while segments remain, true after the final segment was yielded.
;
; Iteration convention:
;   1. Check done: if true, stop.
;   2. Call split-iter-next → get the next StrView segment.
;   3. Repeat.
;
; After split-iter-next yields the LAST segment (no more separators), it sets
; done=true so the NEXT call to the check step stops iteration. This means the
; last segment IS yielded (even if empty), and exactly one empty segment is
; yielded for empty input.
; ---------------------------------------------------------------------------
(defstruct SplitIter
  buf:&ui8
  rem:usize
  sep-data:&ui8
  sep-len:usize
  done:bool)

; split-iter-done — true if the iterator is exhausted (no more segments).
(defn split-iter-done (it:&SplitIter):bool
  (return (it 'done)))

; split-iter-next — advance to and return the next segment.
;
; Find the first occurrence of the separator starting at buf[0..rem).
; If found at offset k: yield buf[0..k], advance buf by k+sep-len, rem by k+sep-len.
; If not found: yield buf[0..rem] (the tail), set done=true.
;
; Precondition: done is false.
(defn split-iter-next (it:&SplitIter):StrView
  (let (slen:usize (it 'sep-len)
        rem:usize  (it 'rem)
        buf:&ui8 (it 'buf))
    ; Search for separator in buf[0..rem).
    (when (> slen 0)
      ; Build a temporary StrView over the remaining buffer for strview-find.
      (let (haystack:&StrView (alloca StrView))
        (set! (haystack 'data) buf)
        (set! (haystack 'len) rem)
        (let (needle:&StrView (alloca StrView))
          (set! (needle 'data) (it 'sep-data))
          (set! (needle 'len) slen)
          (let (found:?usize (strview-find haystack needle))
            (match found
              ((some k)
               ; Found at offset k: yield buf[0..k].
               (let (seg:&StrView (alloca StrView))
                 (set! (seg 'data) buf)
                 (set! (seg 'len) k)
                 ; Advance past this segment and the separator.
                 (set! (it 'buf) (unsafe/ptr+ buf (as i64 (+ k slen))))
                 (set! (it 'rem) (- rem (+ k slen)))
                 (return @seg)))
              (none
               ; Not found: yield the entire tail, mark done.
               (let (seg:&StrView (alloca StrView))
                 (set! (seg 'data) buf)
                 (set! (seg 'len) rem)
                 (set! (it 'done) true)
                 (return @seg))))))))
    ; Sep-len == 0 edge case: yield one-byte segments (or mark done immediately
    ; on empty). For simplicity and to match common expectations when sep is
    ; empty, treat the entire remaining buffer as a single segment and mark done.
    (let (seg:&StrView (alloca StrView))
      (set! (seg 'data) buf)
      (set! (seg 'len) rem)
      (set! (it 'done) true)
      (return @seg))))

; strview-split — construct a SplitIter over sv splitting on sep.
; Both sv and sep are borrowed; the caller must keep them alive for the
; iterator's lifetime (the iterator holds raw pointers into their buffers).
(defn strview-split (sv:&StrView sep:&StrView):SplitIter
  (let (it:&SplitIter (alloca SplitIter))
    (set! (it 'buf) (sv 'data))
    (set! (it 'rem) (sv 'len))
    (set! (it 'sep-data) (sep 'data))
    (set! (it 'sep-len) (sep 'len))
    ; done=false unless source is empty AND sep is non-empty: in that case the
    ; first call will yield an empty segment and then set done=true, so start
    ; with false always (one empty segment for empty input matches Python/Rust).
    (set! (it 'done) false)
    (return @it)))

; Yields each segment as a StrView BY VALUE. Was (Iterator ptr) with a `cur`
; scratch slot until Stage 17 A3: design/stage17-native-strings/overview.md.
(extend SplitIter (Iterator StrView))

(defn next (self:&SplitIter):?StrView
  (when (self 'done) (return none))
  (return (some (split-iter-next self))))

; ---------------------------------------------------------------------------
; LineIter — split a StrView on '\n', stripping trailing '\r' from each line.
;
; Same done-flag convention as SplitIter.
; ---------------------------------------------------------------------------
(defstruct LineIter
  buf:&ui8
  rem:usize
  done:bool)

; lines-iter-done — true if the iterator is exhausted.
(defn lines-iter-done (it:&LineIter):bool
  (return (it 'done)))

; lines-iter-next — return the next line (without its trailing newline).
;
; Scans for '\n' (0x0A). If found at byte k: yields buf[0..k] with any
; trailing '\r' (0x0D) stripped, advances past the '\n'. If not found:
; yields the entire remaining buffer (no trailing newline), sets done=true.
;
; Precondition: done is false.
(defn lines-iter-next (it:&LineIter):StrView
  (let (buf:&ui8 (it 'buf)
        rem:usize   (it 'rem)
        i:usize     0
        found:i32   0
        nl-pos:usize 0)
    ; Scan for '\n'.
    (while (and (< i rem) (= found 0))
      (when (= (as ui32 (aref buf (as i64 i))) 10)
        (set! nl-pos i)
        (set! found 1))
      (set! i (+ i 1)))
    (if (= found 1)
      (do
        ; Found '\n' at nl-pos. Line is buf[0..nl-pos], strip trailing '\r'.
        (let (line-end:usize nl-pos)
          (when (and (> line-end 0)
                     (= (as ui32 (aref buf (as i64 (- line-end 1)))) 13))
            (set! line-end (- line-end 1)))
          (let (seg:&StrView (alloca StrView))
            (set! (seg 'data) buf)
            (set! (seg 'len) line-end)
            ; Advance past the '\n'.
            (set! (it 'buf) (unsafe/ptr+ buf (as i64 (+ nl-pos 1))))
            (set! (it 'rem) (- rem (+ nl-pos 1)))
            (return @seg))))
      (do
        ; No '\n' found: yield the remaining bytes as the last line.
        (let (seg:&StrView (alloca StrView))
          (set! (seg 'data) buf)
          (set! (seg 'len) rem)
          (set! (it 'done) true)
          (return @seg))))))

; strview-lines — construct a LineIter over sv.
; Borrowed: caller must keep sv alive for the iterator's lifetime.
(defn strview-lines (sv:&StrView):LineIter
  (let (it:&LineIter (alloca LineIter))
    (set! (it 'buf) (sv 'data))
    (set! (it 'rem) (sv 'len))
    (set! (it 'done) false)
    (return @it)))

; ---------------------------------------------------------------------------
; LineIter as an Iterator. Identical to the SplitIter conformance above; yields
; each line (trailing newline stripped) as a StrView by value.
; ---------------------------------------------------------------------------
(extend LineIter (Iterator StrView))

(defn next (self:&LineIter):?StrView
  (when (self 'done) (return none))
  (return (some (lines-iter-next self))))


; .nuch header for lib/nucleus/node.nuc
(ns nucleus.node)
(import-use nucleus.arena)
(import-use nucleus.intern)
(import-use nucleus.coll)
(import-use nucleus.iterator)
(declare alloc-node () :ref:Node)
(declare node-int ((v i64)) :ref:Node)
(declare node-at ((n (ptr Node)) (i i32)) :?ref:Node)
(declare node-len ((n (?ref Node))) :i32)
(declare node-line ((n (?ref Node)) (encl i32)) :i32)
(declare node-is-list ((n (?ref Node))) :bool)
(declare node-empty? ((n (?ref Node))) :bool)
(defconst NODE-NIL -1)
(declare node-kind ((n (ptr Node))) :i32)
(declare node-first ((n (ptr Node))) :?ref:Node)
(declare node-elems-alloc ((n i32)) :?ref:?ref:Node)
(declare node-list-new ((line i32)) :ref:Node)
(declare node-rest ((n (ptr Node))) :ptr:Node)
(declare node-reserve ((b (ref Node))) :void)
(declare node-push ((b (ref Node)) (x (?ref Node))) :void)
(declare node-push-line ((b (ref Node)) (x (?ref Node)) (line i32)) :void)
(declare node-extend ((b (ref Node)) (lst (?ref Node))) :void)
(declare node-list-done ((b (ref Node))) :ref:Node)
(declare node-cons ((x (?ref Node)) (lst (?ref Node)) (line i32)) :ref:Node)
(declare node-set-at ((lst (ref Node)) (i i32) (x (?ref Node))) :void)
(declare node-splice-at ((lst (ref Node)) (i i32) (items (?ref Node)) (extra (?ref Node))) :void)
(declare node-list1 ((a (?ref Node)) (line i32)) :ref:Node)
(declare node-list2 ((a (?ref Node)) (b (?ref Node)) (line i32)) :ref:Node)
(declare node-list3 ((a (?ref Node)) (b (?ref Node)) (c (?ref Node)) (line i32)) :ref:Node)
(declare node-list4 ((a (?ref Node)) (b (?ref Node)) (c (?ref Node)) (d (?ref Node)) (line i32)) :ref:Node)
(declare node-list5 ((a (?ref Node)) (b (?ref Node)) (c (?ref Node)) (d (?ref Node)) (e (?ref Node)) (line i32)) :ref:Node)
(declare node-head-sym ((n (ptr Node))) :Symbol)
(defstruct InternEntry (spelling Symbol) (node (ref Node)))
(extern (g-intern-table ptr))
(extern (g-intern-cap i32))
(extern (g-intern-len i32))
(declare sym-node-place ((table ptr) (cap i32) (sp Symbol) (nd (ref Node)) (h i64)) :void)
(declare sym-node-grow () :void)
(declare intern-node ((sym Symbol)) :ref:Node)
(declare intern-symbol ((s CStr)) :ref:Node)
(defstruct NodeIter (lst (ref Node)) (pos i32))
(extend NodeIter (Iterator (ref Node)))
(defmethod "@next.pNodeIter" next ((self (ref NodeIter))) :?ref:Node)
(extend Node (Coll (ref Node) NodeIter))
(declare count ((self (ref Node))) :usize)
(declare conj ((self (ref Node)) (elem (ref Node))) :void)
(declare empty? ((self (ref Node))) :bool)
(declare iter ((self (ref Node))) :NodeIter)
(extend Node (Seq (ref Node)))
(declare invoke ((self (ref Node)) (i usize)) :ref:Node)
(declare append ((self (ref Node)) (elem (ref Node))) :void)
(declare contains? ((self (ref Node)) (elem (ref Node))) :bool)
(declare insert ((self (ref Node)) (i usize) (elem (ref Node))) :void)

; .nuch header for lib/nucleus/hash.nuc
(ns nucleus.hash)
(import-use nucleus.fnv)
(defprotocol Hash (hash (self:ref:Self) :usize))
(extend i32 Hash)
(defmethod "@nuc_hash.pi32" hash ((self (ref i32))) :usize)
(extend i64 Hash)
(defmethod "@nuc_hash.pi64" hash ((self (ref i64))) :usize)
(extend usize Hash)
(defmethod "@nuc_hash.pusize" hash ((self (ref usize))) :usize)
(extend f64 Hash)
(defmethod "@nuc_hash.pf64" hash ((self (ref f64))) :usize)
(extend f32 Hash)
(defmethod "@nuc_hash.pf32" hash ((self (ref f32))) :usize)
(defmethod "@nuc_hash.ppnuc_Node" hash ((self (ref ref Node))) :usize)
(extend StrView Hash)
(defmethod "@nuc_hash.pnuc_StrView" hash ((self (ref StrView))) :usize)
(declare hash-null-cstr () :void)
(extend CStr Hash)
(defmethod "@nuc_hash.pcstr" hash ((self (ref CStr))) :usize)

; .nuch header for lib/nucleus/fmt.nuc
(ns nucleus.fmt)
(import-use nucleus.error)
(import-use nucleus.string-errors)
(import-use nucleus.numeric)
(import-use nucleus.char)
(import-use nucleus.strview)
(import-use nucleus.vector)
(import-use nucleus.string)
(import-use nucleus.allocator)
(defprotocol Writer (write-str (self:ref:Self s:StrView) :!void))
(extend String Writer)
(defmethod "@write_str.pString.StrView" write-str ((self (ref String)) (s StrView)) :!void)
(defstruct CFile (f ptr))
(declare cfile ((f ptr)) :CFile)
(extend CFile Writer)
(defmethod "@write_str.pCFile.StrView" write-str ((self (ref CFile)) (s StrView)) :!void)
(defprotocol ToStr (to-str ((self Self) out:ref:String) :!void))
(declare string-push-u64 ((out (ref String)) (v ui64)) :void)
(declare string-push-i64 ((out (ref String)) (v i64)) :void)
(extend i64 ToStr)
(defmethod "@to_str.i64.pString" to-str ((self i64) (out (ref String))) :!void)
(extend i32 ToStr)
(defmethod "@to_str.i32.pString" to-str ((self i32) (out (ref String))) :!void)
(extend usize ToStr)
(defmethod "@to_str.usize.pString" to-str ((self usize) (out (ref String))) :!void)
(extend ui64 ToStr)
(defmethod "@to_str.u64.pString" to-str ((self ui64) (out (ref String))) :!void)
(extend StrView ToStr)
(defmethod "@to_str.StrView.pString" to-str ((self StrView) (out (ref String))) :!void)
(extend CStr ToStr)
(defmethod "@to_str.cstr.pString" to-str ((self CStr) (out (ref String))) :!void)
(extend Char ToStr)
(defmethod "@to_str.Char.pString" to-str ((self Char) (out (ref String))) :!void)
(extend bool ToStr)
(defmethod "@to_str.bool.pString" to-str ((self bool) (out (ref String))) :!void)
(declare string-push-f64 ((out (ref String)) (v f64) (prec CStr)) :void)
(extend f64 ToStr)
(defmethod "@to_str.f64.pString" to-str ((self f64) (out (ref String))) :!void)
(extend f32 ToStr)
(defmethod "@to_str.f32.pString" to-str ((self f32) (out (ref String))) :!void)
(defmacro str-into (out :rest parts) (quasiquote (macmap ((p) (quasiquote (to-str (unquote p) (unquote (quote (unquote out)))))) (unquote parts))))
(defmacro str (:rest parts) (let (s:ptr (gensym)) (quasiquote (let (((unquote s) String) (string-new)) (str-into (unquote s) (unquote-splice parts)) (unquote s)))))
(defmacro str-alloc (a :rest parts) (let (s:ptr (gensym)) (quasiquote (let (((unquote s) String) (string-new-alloc (unquote a))) (str-into (unquote s) (unquote-splice parts)) (unquote s)))))

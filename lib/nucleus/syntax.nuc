; syntax.nuc: the source-shaped tree a syntax-mode read builds beside its nodes.
;
; Design: design/stage26-refactoring/overview.md §4.1. The reader side (the
; `Reader` field, the hooks and `read-syntax-all`) is in lib/nucleus/read.nuc;
; this file holds the types, the builder primitives the reader calls, and the
; queries. See docs/reading.md §Syntax mode.

(ns nucleus.syntax)

(import-use nucleus.strview)
(import-use nucleus.vector)
(import-use nucleus.allocator)
(import-use nucleus.arena)
(import-use nucleus.node)

(defenum SynKind SYN-ATOM SYN-STR SYN-CHAR SYN-LIST SYN-VEC SYN-MAP SYN-SET
                 SYN-PREFIX SYN-TAGGED SYN-FUSE)

(defstruct Syn
  kind:i32
  start:usize
  end:usize
  line:i32
  col:i32
  ; The opening delimiter's or the prefix spelling's length: `(` 1, `#{` 2, the
  ; `#` of a tagged literal 1, `'` 1, `~@` 2; 0 for a leaf or a fuse.
  open:i32
  node:?&Node
  parent:?&Syn
  kids:(Vector &Syn))

(defstruct SynSpan start:usize end:usize)

(defstruct SynFile
  src:StrView
  tree:&Node
  forms:(Vector &Syn)
  comments:(Vector SynSpan)
  discards:(Vector SynSpan)
  ; Read by `read-syntax-fragment`, which had to recover (see `recover` below),
  ; and whose text ends inside a string literal.
  fragment:bool
  ends-in-string:bool)

; A discarded form's frames hang off `sink`, so they reach neither the tree
; nor `forms`. `framed` tells the reader's next form it is the open frame's.
; Under `recover`, a frame the text ends inside closes with a null node.
(defstruct SynBuilder
  file:&SynFile
  cur:?&Syn
  sink:&Syn
  framed:bool
  recover:bool)

; ---------------------------------------------------------------------------
; Building (called by the reader in syntax mode)
; ---------------------------------------------------------------------------

; The byte column of `at`, 1-based.
(defn syn-col (src:StrView at:usize):i32
  (let (i:usize at)
    (while (and (> i 0) (!= (aref (src 'data) (as i64 (- i 1))) 10))
      (set! i (- i 1)))
    (return (unsafe/cast i32 (+ (- at i) 1)))))

(defn syn-new (kind:i32 start:usize line:i32 col:i32):&Syn
  (let (s:&Syn (unsafe/cast &Syn (arena-alloc (sizeof Syn))))
    (set! (s 'kind) kind)
    (set! (s 'start) start)
    (set! (s 'line) line)
    (set! (s 'col) col)
    (init (ref s 'kids) (handle g-arena))
    (return s)))

(defn syn-builder-new (src:StrView):&SynBuilder
  (let (f:&SynFile (unsafe/cast &SynFile (arena-alloc (sizeof SynFile))))
    (set! (f 'src) src)
    (set! (f 'tree) (node-list-new 0))
    (init (ref f 'forms) (handle g-arena))
    (init (ref f 'comments) (handle g-arena))
    (init (ref f 'discards) (handle g-arena))
    (set! (f 'fragment) false)
    (set! (f 'ends-in-string) false)
    (let (b:&SynBuilder (unsafe/cast &SynBuilder (arena-alloc (sizeof SynBuilder))))
      (set! (b 'file) f)
      (set! (b 'cur) null)
      (set! (b 'sink) (syn-new SYN-LIST 0 0 0))
      (set! (b 'framed) false)
      (set! (b 'recover) false)
      (return b))))

; Open a frame at `start`; it is the parent of every frame opened before it closes.
(defn syn-open (b:&SynBuilder kind:i32 open:i32 start:usize line:i32):&Syn
  (let (f:&SynFile (b 'file)
        s:&Syn (syn-new kind start line (syn-col (f 'src) start)))
    (set! (s 'open) open)
    (set! (s 'parent) (b 'cur))
    (set! (b 'cur) s)
    (return s)))

(defn syn-close (b:&SynBuilder s:&Syn end:usize n:?&Node):void
  (set! (s 'end) end)
  (set! (s 'node) n)
  (set! (b 'cur) (s 'parent))
  (let (p:?&Syn (s 'parent)
        f:&SynFile (b 'file))
    (cond (= p null) (conj (ref f 'forms) s)
          (!= p (b 'sink)) (conj (ref p 'kids) s))))

; A read that failed: the frame is dropped, and its parent is current again.
(defn syn-abandon (b:&SynBuilder s:&Syn):void
  (set! (b 'cur) (s 'parent)))

; A leaf kid the reader consumed without a frame of its own (a fuse's atom, a
; tagged literal's tag), placed first among `s`'s kids.
(defn syn-add-head-kid (s:&Syn start:usize end:usize n:?&Node):void
  (let (k:&Syn (syn-new SYN-ATOM start (s 'line) (+ (s 'col) (unsafe/cast i32 (- start (s 'start))))))
    (set! (k 'end) end)
    (set! (k 'node) n)
    (set! (k 'parent) s)
    (insert (ref s 'kids) 0 k)))

(defn syn-comment (b:&SynBuilder start:usize end:usize):void
  (let (f:&SynFile (b 'file))
    (conj (ref f 'comments) (SynSpan start end))))

; Returns the frame to restore at `syn-discard-end`. The span's end stays 0
; (no discard ends there) until then, which is how the end finds its span.
(defn syn-discard-begin (b:&SynBuilder start:usize):?&Syn
  (let (f:&SynFile (b 'file)
        saved:?&Syn (b 'cur))
    (conj (ref f 'discards) (SynSpan start 0))
    (set! (b 'cur) (b 'sink))
    (return saved)))

(defn syn-discard-end (b:&SynBuilder saved:?&Syn end:usize):void
  (let (f:&SynFile (b 'file)
        ds:&(Vector SynSpan) (ref f 'discards)
        i:usize (count ds))
    (set! (b 'cur) saved)
    (while (> i 0)
      (set! i (- i 1))
      (let (sp:SynSpan (ds i))
        (when (= (sp 'end) 0)
          (set ds i (SynSpan (sp 'start) end))
          (return))))))

; ---------------------------------------------------------------------------
; Queries
; ---------------------------------------------------------------------------

(defn syn-slice (f:&SynFile start:usize end:usize):StrView
  (return (strview-take-bytes (strview-drop-bytes (f 'src) start) (- end start))))

; The raw source of `s`.
(defn syn-text (f:&SynFile s:&Syn):StrView
  (return (syn-slice f (s 'start) (s 'end))))

; A `SYN-PREFIX`'s prefix as written (`'`, `&`, a `def-rmacro` prefix); "" for
; any other kind.
(defn syn-prefix (f:&SynFile s:&Syn):StrView
  (when (!= (s 'kind) SYN-PREFIX) (return ""))
  (return (syn-slice f (s 'start) (+ (s 'start) (as usize (s 'open))))))

; True when a span in `spans` (sorted by start) starts inside `s`.
(defn syn-spans-inside? (spans:&(Vector SynSpan) s:&Syn):bool
  (let (lo:usize 0
        hi:usize (count spans))
    (while (< lo hi)
      (let (mid:usize (/ (+ lo hi) 2)
            sp:SynSpan (spans mid))
        (if (< (sp 'start) (s 'start))
          (set! lo (+ mid 1))
          (set! hi mid))))
    (when (= lo (count spans)) (return false))
    (let (sp:SynSpan (spans lo))
      (return (< (sp 'start) (s 'end))))))

; Whether a `;` comment lies inside `s`, the refusal a rewrite that would lose
; one needs.
(defn syn-has-comment? (f:&SynFile s:&Syn):bool
  (return (syn-spans-inside? (ref f 'comments) s)))

(defn syn-has-discard? (f:&SynFile s:&Syn):bool
  (return (syn-spans-inside? (ref f 'discards) s)))

; How many leading elems of a kind's node have no kid: the head symbol of a
; literal cell or a reader-macro wrap.
(defn syn-elem-offset (kind:i32):i32
  (return (case kind SYN-LIST 0 SYN-VEC 1 SYN-MAP 1 SYN-SET 1 SYN-TAGGED 1 SYN-PREFIX 1 -1)))

; The kid of a fuse whose node is `n`. A fuse's list kids are fresh nodes, so
; identity finds them even under the wrappers its chain synthesized.
(defn syn-kid-for-node (s:&Syn n:?&Node):?&Syn
  (let (ks:&(Vector &Syn) (ref s 'kids)
        i:usize 1)
    (when (or (!= (s 'kind) SYN-FUSE) (= n null)) (return null))
    (while (< i (count ks))
      (let (k:&Syn (ks i))
        (when (= (k 'node) n) (return k)))
      (set! i (+ i 1)))
    (return null)))

; The Syn whose span is elem `i` of `(s 'node)`, or null when that elem has no
; span of its own (a literal's or prefix's head, a fuse's name or wrapper).
(defn syn-kid-for-elem (s:&Syn i:i32):?&Syn
  (let (ks:&(Vector &Syn) (ref s 'kids)
        off:i32 (syn-elem-offset (s 'kind)))
    (when (= (s 'kind) SYN-FUSE)
      ; A lone `:` fuses to its list unwrapped, so the fuse's elems are its kid's.
      (let (k:&Syn (ks 1))
        (when (= (k 'node) (s 'node)) (return (syn-kid-for-elem k i))))
      (return (syn-kid-for-node s (node-at (s 'node) i))))
    (when (or (< off 0) (< i off) (>= (- i off) (unsafe/cast i32 (count ks))))
      (return null))
    (return (ks (unsafe/cast usize (- i off))))))

; The elem of `(s 'node)` that kid `k` spans, or -1: a fuse's atom, a fuse kid
; under a chain wrapper, or the list a lone `:` returned unwrapped.
(defn syn-elem-index (s:&Syn k:&Syn):i32
  (let (ks:&(Vector &Syn) (ref s 'kids)
        n:?&Node (s 'node)
        off:i32 (syn-elem-offset (s 'kind))
        i:usize 0)
    (when (= (s 'kind) SYN-FUSE)
      (dotimes (j (node-len n))
        (when (and (= (node-at n j) (k 'node)) (!= k (ks 0))) (return j)))
      (return -1))
    (when (< off 0) (return -1))
    (while (< i (count ks))
      (when (= (ks i) k) (return (+ (unsafe/cast i32 i) off)))
      (set! i (+ i 1)))
    (return -1)))

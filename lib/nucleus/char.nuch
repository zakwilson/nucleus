; .nuch header for lib/nucleus/char.nuc
(ns nucleus.char)
(import-use nucleus.error)
(import-use nucleus.string-errors)
(defstruct DecodeResult (ch Char) (nbytes usize) (ok i32))
(declare char-utf8-len ((c Char)) :usize)
(declare char-encode-utf8 ((c Char) (buf (ref ui8))) :usize)
(declare decode-err () :DecodeResult)
(declare char-decode-utf8 ((p (ref ui8)) (len usize)) :DecodeResult)
(declare char-to-u32 ((c Char)) :ui32)
(declare char-from-u32 ((n ui32)) :!Char)
(declare char-is-ascii ((c Char)) :bool)
(declare char-is-digit ((c Char)) :bool)
(declare char-is-alpha ((c Char)) :bool)
(declare char-is-alnum ((c Char)) :bool)
(declare char-is-whitespace ((c Char)) :bool)
(declare char-ascii-upper ((c Char)) :Char)
(declare char-ascii-lower ((c Char)) :Char)

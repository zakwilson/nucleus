; nucleus.create — `new` and `make`: an object in one call
; (design/stage24-allocation/overview.md §6).
;
;   (new T a args…)   ; → &T, the object's own bytes from allocator a
;   (make T a args…)  ; → T by value; storage it owns comes from a
;   (make T)          ; (make T heap)
;   (delete p a)      ; drops *p if its type is Drop, then gives its bytes back to a
;   (derive-drop T)   ; a field-wise Drop for struct T
;
; A type that conforms to `Init` (or to `InitFrom`/`TryInitFrom`, which extend
; it) is initialized with `(init p (handle a) args…)`; any other type is built
; like a struct literal, or zero-filled when there are no args. The templates
; spell `nucleus.allocator/init` so a caller's own `init` cannot shadow it.

(ns nucleus.create)

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use "string.h")
(import-use nucleus.allocator)
(import-use nucleus.coll)

(extern stderr:ptr)

; The templates dispatch beside the handle they build, so -O2 folds the vtable
; load even where this helper is not inlined (overview.md §9 AL-5).
(defn create-bytes (p:?&ui8):&ui8
  (when (= (as ptr p) null)
    (fprintf stderr "new: out of memory\n")
    (exit 1))
  (return (unsafe/cast &ui8 (as ptr p))))

(defn create-zero (p:ptr size:usize):void
  (memset p 0 size))

(defmacro new (t :rest args)
  (when (= (ast-len args) 0)
    (macro-error t "new: name the allocator, as in (new T heap)"))
  `(create-form 1 ~t ~@args))

(defmacro make (t :rest args)
  (if (= (ast-len args) 0)
    `(create-form 0 ~t heap)
    `(create-form 0 ~t ~@args)))

; MODE is 1 for `new`, 0 for `make`.
(defmacro create-form (mode t a :rest vals)
  (let (n:i32 (ast-len vals)
        is-new:i32 (if (= (mode 'i) 1) 1 0)
        h (gensym)
        p (gensym)
        v (ast-at vals 0))
    (let (slot (if (= is-new 1)
                 `((~p (ref ~t)) (unsafe/cast (ref ~t)
                                   (create-bytes (allocate-zeroed (ref ~h) (as usize (sizeof ~t))
                                                                (as usize (alignof ~t))))))
                 `((~p (ref ~t)) (alloca ~t)))
          result (if (= is-new 1) p `(deref ~p)))
      (when (and (> n 1) (conforms? t Init))
        (macro-error (ast-at vals 1)
          "new/make: an Init type takes one value after the allocator"))
      (cond
        (not (conforms? t Init))
          (cond (= n 0)
                  (if (= is-new 1)
                    `(let ((~h Alloc) (handle ~a) ~@slot) ~p)
                    `(let ((~h Alloc) (handle ~a) ~@slot)
                       (create-zero ~p (as usize (sizeof ~t)))
                       (deref ~p)))
                (= is-new 1)
                  `(let ((~h Alloc) (handle ~a) ~@slot) (set! (deref ~p) (~t ~@vals)) ~p)
                true
                  `(let ((~h Alloc) (handle ~a)) (~t ~@vals)))
        (= n 0)
          `(let ((~h Alloc) (handle ~a) ~@slot) (nucleus.allocator/init ~p ~h) ~result)
        (= is-new 1)
          `(let ((~h Alloc) (handle ~a) ~@slot)
             (__init-then (nucleus.allocator/init ~p ~h ~v) ~p
               (deallocate (ref ~h) (unsafe/cast ?&ui8 ~p) (as usize (sizeof ~t))
                           (as usize (alignof ~t)))))
        true
          `(let ((~h Alloc) (handle ~a) ~@slot)
             (__init-then (nucleus.allocator/init ~p ~h ~v) (deref ~p)))))))

(defmacro __drop-if (t p)
  (if (conforms? t Drop) `(drop ~p) `0))

(defn delete-in (h:Alloc p:&T :where (Any T)):void
  (__drop-if T p)
  (deallocate &h (unsafe/cast ?&ui8 p) (as usize (sizeof T)) (as usize (alignof T))))

; `new`'s other half. `a` is the allocator the object came from.
(defmacro delete (p a)
  `(delete-in (handle ~a) ~p))

; A `drop` that drops each field whose type is Drop, in declaration order. A shallow
; copy shares its buffers, so `:except (f …)` names the fields this struct doesn't own.
(defmacro derive-drop (t :rest opts)
  (let (fields (struct-fields t)
        nopts:i32 (ast-len opts)
        except (ast-at opts 1)
        self (gensym)
        (body ?&Node) null)
    (when (or (= nopts 1) (> nopts 2)
              (and (= nopts 2) (!= (as ptr (((ast-at opts 0) 's) 'p)) (as ptr (('except 's) 'p)))))
      (macro-error t "derive-drop: expected (derive-drop T) or (derive-drop T :except (field ...))"))
    (dotimes (e (ast-len except))
      (let (name (ast-at except e)
            known:bool false)
        (dotimes (i (ast-len fields))
          (when (= (ast-at (ast-at fields i) 0) name) (set! known true)))
        (when (not known) (macro-error name "derive-drop: :except names no field of this struct"))))
    (dotimes (i (ast-len fields))
      (let (f (ast-at fields i)
            name (ast-at f 0)
            ftype (ast-at f 1)
            skip:bool false)
        (dotimes (e (ast-len except))
          (when (= (ast-at except e) name) (set! skip true)))
        (when (and (not skip) (conforms? ftype Drop))
          (set! body `(~@body (drop (ref ~self '~name)))))))
    `(do
       (defn ~'drop ((~self (ref ~t))) :void ~@body)
       (extend ~t Drop))))

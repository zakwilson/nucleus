; .nuch header for lib/nucleus/parse.nuc
(ns nucleus.parse)
(import-use nucleus.strview)
(import-use nucleus.string-errors)
(deferror parse-float-error "invalid float")
(defprotocol (FromStr R) (from-str ((self Self) sv:ref:StrView) :R))
(defmacro parse (ty sv) (quasiquote (from-str (unsafe/cast (unquote ty) 0) (unquote sv))))
(declare parse-nul-copy ((sv (ref StrView))) :ref:ui8)
(extend i32 (FromStr !i32))
(defmethod "@nuc_from_str.i32.pnuc_StrView" from-str ((self i32) (sv (ref StrView))) :!i32)
(extend i64 (FromStr !i64))
(defmethod "@nuc_from_str.i64.pnuc_StrView" from-str ((self i64) (sv (ref StrView))) :!i64)
(extend ui64 (FromStr !ui64))
(defmethod "@nuc_from_str.u64.pnuc_StrView" from-str ((self ui64) (sv (ref StrView))) :!ui64)
(extend f64 (FromStr !f64))
(defmethod "@nuc_from_str.f64.pnuc_StrView" from-str ((self f64) (sv (ref StrView))) :!f64)

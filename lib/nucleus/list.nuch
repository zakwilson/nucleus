; .nuch header for lib/nucleus/list.nuc
(ns nucleus.list)
(import-use nucleus.node)
(import-use nucleus.iterator)
(declare cons ((car ptr) (cdr ptr)) :ptr)
(declare first ((n ptr)) :ptr)
(declare rest ((n ptr)) :ptr)
(defmethod "@append.ptr.ptr" append ((a ptr) (b ptr)) :ptr)
(defstruct ListIter (cur ptr))
(extend ListIter (Iterator ptr))
(defmethod "@next.pListIter" next ((self (ref ListIter))) :?ptr)
(declare list-iter ((lst ptr)) :ListIter)

; .nuch header for lib/nucleus/string-split.nuc
(ns nucleus.string-split)
(import-use nucleus.strview)
(import-use nucleus.iterator)
(defstruct SplitIter (buf (ref ui8)) (rem usize) (sep-data (ref ui8)) (sep-len usize) (done bool))
(declare split-iter-done ((it (ref SplitIter))) :bool)
(declare split-iter-next ((it (ref SplitIter))) :StrView)
(declare strview-split ((sv (ref StrView)) (sep (ref StrView))) :SplitIter)
(extend SplitIter (Iterator StrView))
(defmethod "@nuc_next.pnuc_SplitIter" next ((self (ref SplitIter))) :?StrView)
(defstruct LineIter (buf (ref ui8)) (rem usize) (done bool))
(declare lines-iter-done ((it (ref LineIter))) :bool)
(declare lines-iter-next ((it (ref LineIter))) :StrView)
(declare strview-lines ((sv (ref StrView))) :LineIter)
(extend LineIter (Iterator StrView))
(defmethod "@nuc_next.pnuc_LineIter" next ((self (ref LineIter))) :?StrView)

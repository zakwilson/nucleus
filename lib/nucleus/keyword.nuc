; Keyword: an interned, immutable, self-evaluating name.
;
; Design: design/stage11/cleanup.md §2; rebased onto `Symbol` in Stage 17 B4
; (design/stage17-native-strings/overview.md §2.4, library-gaps.md #4).
;
; ---------------------------------------------------------------------------
; WHAT A KEYWORD IS
;
; `:foo` is a keyword literal. The reader recognises a leading-colon atom and
; emits a NODE-KEYWORD; the compiler lowers that to a runtime call to
; `keyword-intern("foo")`, which returns the one canonical `Keyword` value for
; that name. Two `:foo` therefore share a `Symbol`, so equality is a pointer
; compare and hashing is a cached load — the whole point being ergonomic, cheap
; `HashMap` keys.
;
; A Keyword is now exactly one interned `Symbol` and nothing else: one word
; instead of three, and the intern table is `lib/nucleus/intern.nuc`'s open-addressed
; one. Before Stage 17 this file carried its own 256-entry fixed array with a
; linear scan and a `strcmp` per probe, which capped a program's distinct
; keyword set and aborted past it. Both are gone.
; ---------------------------------------------------------------------------

(ns nucleus.keyword)

(import-use nucleus.numeric)   ; the Eq protocol (= / !=)
(import-use nucleus.hash)
(import-use nucleus.strview)
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use nucleus.intern)
(import-use nucleus.intern-str)

(defstruct Keyword sym:Symbol)

; The canonical Keyword for the name in `sv`.
(defn keyword-intern (sv:StrView):Keyword
  (let (k:&Keyword (alloca Keyword))
    (set! (k 'sym) (symbol-intern sv))
    (return @k)))

; The keyword's name. Borrowed and process-lived, like every interned view.
(defn keyword-name (self:Keyword):StrView
  (return (symbol-as-view (self 'sym))))

(defn keyword-symbol (self:Keyword):Symbol
  (return (self 'sym)))

; ---------------------------------------------------------------------------
; Conformances. Eq is identity and Hash is the hash cached at intern time, both
; inherited from `Symbol` — so equal keywords still share a hash by construction.
; ---------------------------------------------------------------------------

(extend Keyword Eq)
(defn = (a:Keyword b:Keyword):bool (return (= (a 'sym) (b 'sym))))
(defn != (a:Keyword b:Keyword):bool (return (!= (a 'sym) (b 'sym))))

(extend Keyword Hash)
(defn hash (self:&Keyword):usize
  (return (hash (ref self 'sym))))

(extend Keyword ToStr)
(defn to-str (self:Keyword out:&String):!void
  (return (to-str (self 'sym) out)))

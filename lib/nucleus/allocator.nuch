; .nuch header for lib/nucleus/allocator.nuc
(ns nucleus.allocator)
(import-use nucleus.arena)
(defprotocol Allocator (alloc (self:ref:Self size:usize align:usize) ?ref:ui8) (realloc (self:ref:Self (p ?ref:ui8) old:usize new:usize align:usize) ?ref:ui8) (free (self:ref:Self (p ?ref:ui8) size:usize align:usize) :void))
(defenum AllocKind ALLOC-LIBC ALLOC-ARENA)
(defstruct AllocHandle (kind i32) (data ptr))
(declare alloc-handle-alloc ((h (ref AllocHandle)) (size usize) (align usize)) :?ref:ui8)
(declare alloc-handle-realloc ((h (ref AllocHandle)) (p ?ref:ui8) (old usize) (new usize) (align usize)) :?ref:ui8)
(declare alloc-handle-free ((h (ref AllocHandle)) (p ?ref:ui8) (size usize) (align usize)) :void)
(extern (g-default-alloc AllocHandle))
(declare default-allocator () :ref:AllocHandle)
(declare libc-allocator ((h (ref AllocHandle))) :ref:AllocHandle)
(declare arena-allocator ((h (ref AllocHandle))) :ref:AllocHandle)

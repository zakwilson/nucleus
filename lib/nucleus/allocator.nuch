; .nuch header for lib/nucleus/allocator.nuc
(ns nucleus.allocator)
(import-use nucleus.coll)
(defenum AllocKind ALLOC-HEAP ALLOC-ARENA ALLOC-FIXED ALLOC-CUSTOM ALLOC-TRACKING)
(defstruct Alloc (kind i32) (data ptr))
(defstruct CustomAlloc (instance ptr) (allocate-fn ((fn ?ref:ui8) (ptr usize usize))) (reallocate-fn ((fn ?ref:ui8) (ptr ?ref:ui8 usize usize usize))) (deallocate-fn ((fn void) (ptr ?ref:ui8 usize usize))))
(defprotocol Allocator (allocate (self:ref:Self size:usize align:usize) ?ref:ui8) (reallocate (self:ref:Self (p ?ref:ui8) old:usize new:usize align:usize) ?ref:ui8) (deallocate (self:ref:Self (p ?ref:ui8) size:usize align:usize) :void) (handle (self:ref:Self) :Alloc))
(declare align-pad ((addr usize) (align usize)) :usize)
(declare align-ok? ((align usize)) :bool)
(declare alloc-addr ((p ptr)) :usize)
(defstruct Heap)
(extern (heap Heap))
(declare heap-malloc-align () :usize)
(declare heap-raw-slot ((p ptr)) :ref:ptr)
(declare heap-allocate ((size usize) (align usize)) :?ref:ui8)
(declare heap-deallocate ((p ?ref:ui8) (size usize) (align usize)) :void)
(declare heap-reallocate ((p ?ref:ui8) (old usize) (new usize) (align usize)) :?ref:ui8)
(extend Heap Allocator)
(extend Heap Drop)
(defmethod "@nuc_allocate.pnuc_Heap.usize.usize" allocate ((self (ref Heap)) (size usize) (align usize)) :?ref:ui8)
(defmethod "@nuc_reallocate.pnuc_Heap.pu8.usize.usize.usize" reallocate ((self (ref Heap)) (p ?ref:ui8) (old usize) (new usize) (align usize)) :?ref:ui8)
(defmethod "@nuc_deallocate.pnuc_Heap.pu8.usize.usize" deallocate ((self (ref Heap)) (p ?ref:ui8) (size usize) (align usize)) :void)
(defmethod "@nuc_handle.pnuc_Heap" handle ((self (ref Heap))) :Alloc)
(defmethod "@nuc_drop.pnuc_Heap" drop ((self (ref Heap))) :void)
(defstruct ArenaBlock (next (?ref ArenaBlock)) (size usize))
(defstruct Arena (first (?ref ArenaBlock)) (cur (?ref ArenaBlock)) (off usize) (block-size usize) (parent Alloc))
(declare arena-block-align () :usize)
(declare arena-default-block () :usize)
(declare arena-block-cap () :usize)
(declare arena-in ((parent Alloc) (block-size usize)) :Arena)
(declare arena-base ((b (ref ArenaBlock))) :ref:ui8)
(declare arena-fit ((b (ref ArenaBlock)) (from usize) (size usize) (align usize)) :usize)
(declare arena-take ((a (ref Arena)) (b (ref ArenaBlock)) (start usize) (size usize)) :?ref:ui8)
(declare arena-next-size ((a (ref Arena)) (tail (?ref ArenaBlock)) (need usize)) :usize)
(declare arena-allocate ((a (ref Arena)) (size usize) (align usize)) :?ref:ui8)
(declare arena-top? ((a (ref Arena)) (p ?ref:ui8) (size usize)) :bool)
(declare arena-deallocate ((a (ref Arena)) (p ?ref:ui8) (size usize)) :void)
(declare arena-reallocate ((a (ref Arena)) (p ?ref:ui8) (old usize) (new usize) (align usize)) :?ref:ui8)
(declare arena-reset ((a (ref Arena))) :void)
(extend Arena Allocator)
(extend Arena Drop)
(defmethod "@nuc_allocate.pnuc_Arena.usize.usize" allocate ((self (ref Arena)) (size usize) (align usize)) :?ref:ui8)
(defmethod "@nuc_reallocate.pnuc_Arena.pu8.usize.usize.usize" reallocate ((self (ref Arena)) (p ?ref:ui8) (old usize) (new usize) (align usize)) :?ref:ui8)
(defmethod "@nuc_deallocate.pnuc_Arena.pu8.usize.usize" deallocate ((self (ref Arena)) (p ?ref:ui8) (size usize) (align usize)) :void)
(defmethod "@nuc_handle.pnuc_Arena" handle ((self (ref Arena))) :Alloc)
(defmethod "@nuc_drop.pnuc_Arena" drop ((self (ref Arena))) :void)
(defstruct FixedBuffer (buf ptr) (len usize) (off usize) (live usize))
(declare fixed-buffer ((p ptr) (len usize)) :FixedBuffer)
(defmacro frame-buffer (n) (quasiquote (fixed-buffer (alloca (array ui8 (unquote n))) (unquote n))))
(declare fixed-allocate ((fb (ref FixedBuffer)) (size usize) (align usize)) :?ref:ui8)
(declare fixed-top? ((fb (ref FixedBuffer)) (p ?ref:ui8) (size usize)) :bool)
(declare fixed-deallocate ((fb (ref FixedBuffer)) (p ?ref:ui8) (size usize)) :void)
(declare fixed-reallocate ((fb (ref FixedBuffer)) (p ?ref:ui8) (old usize) (new usize) (align usize)) :?ref:ui8)
(extend FixedBuffer Allocator)
(extend FixedBuffer Drop)
(defmethod "@nuc_allocate.pnuc_FixedBuffer.usize.usize" allocate ((self (ref FixedBuffer)) (size usize) (align usize)) :?ref:ui8)
(defmethod "@nuc_reallocate.pnuc_FixedBuffer.pu8.usize.usize.usize" reallocate ((self (ref FixedBuffer)) (p ?ref:ui8) (old usize) (new usize) (align usize)) :?ref:ui8)
(defmethod "@nuc_deallocate.pnuc_FixedBuffer.pu8.usize.usize" deallocate ((self (ref FixedBuffer)) (p ?ref:ui8) (size usize) (align usize)) :void)
(defmethod "@nuc_handle.pnuc_FixedBuffer" handle ((self (ref FixedBuffer))) :Alloc)
(defmethod "@nuc_drop.pnuc_FixedBuffer" drop ((self (ref FixedBuffer))) :void)
(defstruct Tracking (parent Alloc) (live usize) (bytes usize))
(declare tracking-owes? ((tr (ref Tracking)) (size usize)) :bool)
(declare tracking-allocate ((tr (ref Tracking)) (size usize) (align usize)) :?ref:ui8)
(declare tracking-reallocate ((tr (ref Tracking)) (p ?ref:ui8) (old usize) (new usize) (align usize)) :?ref:ui8)
(declare tracking-deallocate ((tr (ref Tracking)) (p ?ref:ui8) (size usize) (align usize)) :void)
(extend Tracking Allocator)
(extend Tracking Drop)
(defmethod "@nuc_allocate.pnuc_Tracking.usize.usize" allocate ((self (ref Tracking)) (size usize) (align usize)) :?ref:ui8)
(defmethod "@nuc_reallocate.pnuc_Tracking.pu8.usize.usize.usize" reallocate ((self (ref Tracking)) (p ?ref:ui8) (old usize) (new usize) (align usize)) :?ref:ui8)
(defmethod "@nuc_deallocate.pnuc_Tracking.pu8.usize.usize" deallocate ((self (ref Tracking)) (p ?ref:ui8) (size usize) (align usize)) :void)
(defmethod "@nuc_handle.pnuc_Tracking" handle ((self (ref Tracking))) :Alloc)
(defmethod "@nuc_drop.pnuc_Tracking" drop ((self (ref Tracking))) :void)
(declare alloc-allocate ((a (ref Alloc)) (size usize) (align usize)) :?ref:ui8)
(declare alloc-reallocate ((a (ref Alloc)) (p ?ref:ui8) (old usize) (new usize) (align usize)) :?ref:ui8)
(declare alloc-deallocate ((a (ref Alloc)) (p ?ref:ui8) (size usize) (align usize)) :void)
(declare custom-alloc ((c (ref CustomAlloc))) :Alloc)
(extend Alloc Allocator)
(defmethod "@nuc_allocate.pnuc_Alloc.usize.usize" allocate ((self (ref Alloc)) (size usize) (align usize)) :?ref:ui8)
(defmethod "@nuc_reallocate.pnuc_Alloc.pu8.usize.usize.usize" reallocate ((self (ref Alloc)) (p ?ref:ui8) (old usize) (new usize) (align usize)) :?ref:ui8)
(defmethod "@nuc_deallocate.pnuc_Alloc.pu8.usize.usize" deallocate ((self (ref Alloc)) (p ?ref:ui8) (size usize) (align usize)) :void)
(defmethod "@nuc_handle.pnuc_Alloc" handle ((self (ref Alloc))) :Alloc)
(defprotocol Init (init (self:ref:Self a:Alloc) :void))
(defprotocol (InitFrom V) (init (self:ref:Self a:Alloc v:V) :void))
(defprotocol (TryInitFrom V) (init (self:ref:Self a:Alloc v:V) :!void))
(extend InitFrom Init)
(extend TryInitFrom Init)
(defn init ((self (ref T)) :where (Init T)) :void (init self (handle (ref heap))))
(extend Tracking Init)
(defmethod "@nuc_init.pnuc_Tracking.nuc_Alloc" init ((self (ref Tracking)) (a Alloc)) :void)

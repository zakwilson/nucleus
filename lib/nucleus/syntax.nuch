; .nuch header for lib/nucleus/syntax.nuc
(ns nucleus.syntax)
(import-use nucleus.strview)
(import-use nucleus.vector)
(import-use nucleus.allocator)
(import-use nucleus.arena)
(import-use nucleus.node)
(defenum SynKind SYN-ATOM SYN-STR SYN-CHAR SYN-LIST SYN-VEC SYN-MAP SYN-SET SYN-PREFIX SYN-TAGGED SYN-FUSE)
(defstruct Syn (kind i32) (start usize) (end usize) (line i32) (col i32) (open i32) (node (?ref Node)) (parent (?ref Syn)) (kids (Vector (ref Syn))))
(defstruct SynSpan (start usize) (end usize))
(defstruct SynFile (src StrView) (tree (ref Node)) (forms (Vector (ref Syn))) (comments (Vector SynSpan)) (discards (Vector SynSpan)) (fragment bool) (ends-in-string bool))
(defstruct SynBuilder (file (ref SynFile)) (cur (?ref Syn)) (sink (ref Syn)) (framed bool) (recover bool))
(declare syn-col ((src StrView) (at usize)) :i32)
(declare syn-new ((kind i32) (start usize) (line i32) (col i32)) :ref:Syn)
(declare syn-builder-new ((src StrView)) :ref:SynBuilder)
(declare syn-open ((b (ref SynBuilder)) (kind i32) (open i32) (start usize) (line i32)) :ref:Syn)
(declare syn-close ((b (ref SynBuilder)) (s (ref Syn)) (end usize) (n (?ref Node))) :void)
(declare syn-abandon ((b (ref SynBuilder)) (s (ref Syn))) :void)
(declare syn-add-head-kid ((s (ref Syn)) (start usize) (end usize) (n (?ref Node))) :void)
(declare syn-comment ((b (ref SynBuilder)) (start usize) (end usize)) :void)
(declare syn-discard-begin ((b (ref SynBuilder)) (start usize)) :?ref:Syn)
(declare syn-discard-end ((b (ref SynBuilder)) (saved (?ref Syn)) (end usize)) :void)
(declare syn-slice ((f (ref SynFile)) (start usize) (end usize)) :StrView)
(declare syn-text ((f (ref SynFile)) (s (ref Syn))) :StrView)
(declare syn-prefix ((f (ref SynFile)) (s (ref Syn))) :StrView)
(declare syn-spans-inside? ((spans (ref (Vector SynSpan))) (s (ref Syn))) :bool)
(declare syn-has-comment? ((f (ref SynFile)) (s (ref Syn))) :bool)
(declare syn-has-discard? ((f (ref SynFile)) (s (ref Syn))) :bool)
(declare syn-elem-offset ((kind i32)) :i32)
(declare syn-kid-for-node ((s (ref Syn)) (n (?ref Node))) :?ref:Syn)
(declare syn-kid-for-elem ((s (ref Syn)) (i i32)) :?ref:Syn)
(declare syn-elem-index ((s (ref Syn)) (k (ref Syn))) :i32)

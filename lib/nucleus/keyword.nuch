; .nuch header for lib/nucleus/keyword.nuc
(ns nucleus.keyword)
(import-use nucleus.numeric)
(import-use nucleus.hash)
(import-use nucleus.strview)
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use nucleus.intern)
(import-use nucleus.intern-str)
(defstruct Keyword (sym Symbol))
(declare keyword-intern ((sv StrView)) :Keyword)
(declare keyword-name ((self Keyword)) :StrView)
(declare keyword-symbol ((self Keyword)) :Symbol)
(extend Keyword Eq)
(defmethod "@nuc_eq.nuc_Keyword.nuc_Keyword" = ((a Keyword) (b Keyword)) :bool)
(defmethod "@nuc_ne.nuc_Keyword.nuc_Keyword" != ((a Keyword) (b Keyword)) :bool)
(extend Keyword Hash)
(defmethod "@nuc_hash.pnuc_Keyword" hash ((self (ref Keyword))) :usize)
(extend Keyword ToStr)
(defmethod "@nuc_to_str.nuc_Keyword.pnuc_String" to-str ((self Keyword) (out (ref String))) :!void)

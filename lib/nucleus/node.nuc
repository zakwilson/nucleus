; Node utilities — allocation and list operations on the AST Node type.
;
; The Node struct and NODE-* constants are defined in lib/nucleus/core.nuc, which
; is auto-imported into every program. arena-alloc comes from lib/nucleus/arena.nuc.

(ns nucleus.node)

(import-use nucleus.arena)

; arena-alloc aborts on exhaustion, so node allocation never yields null.
(defn alloc-node ():&Node
  (return (unsafe/cast &Node (arena-alloc (sizeof Node)))))

; An integer leaf, which is what `~` wants when what a macro computed is a
; number. No line: a synthesized node has no source position, and `node-line`'s
; fallback to the enclosing form is what reads it.
(defn node-int (v:i64):&Node
  (let (n:&Node (alloc-node))
    (set! (n 'kind) NODE-INT)
    (set! (n 'i) v)
    (return n)))

(defn node-at (n:ptr:Node i:i32):?&Node
  (when (or (< i 0) (>= i (node-len n))) (return none))
  (return (as-ref (aref (n 'elems) i))))

(defn node-len (n:?&Node):i32
  (when (= n null) (return 0))
  (when (!= (n 'kind) NODE-LIST) (return 0))
  (return (n 'len)))

; Source line to blame for a diagnostic about `n`, given the line of the
; enclosing form.
;
; A bare symbol node is an *interned singleton* shared by every occurrence of
; that spelling in the whole program (see intern-symbol above and read-form's
; TOK-SYMBOL branch), so it cannot carry a per-occurrence line — `(sym line)` is
; always 0. Every other node kind (lists, ints, strings, chars, floats,
; keywords) is freshly allocated per occurrence and does carry its reader line.
;
; So a diagnostic whose subject is (or may be) a symbol must borrow the line of
; the enclosing form, which its emitter has in hand. Writing a line *into* a
; symbol node is never correct: it would be observed by every other occurrence
; of the same spelling anywhere in the program.
(defn node-line (n:?&Node encl:i32):i32
  (when (= n null) (return encl))
  (let (ln:i32 (n 'line))
    (when (= ln 0) (return encl))
    (return ln)))

(defn node-is-list (n:?&Node):bool
  (when (= n null) (return true))
  (when (= (n 'kind) NODE-LIST) (return true))
  (return false))

; Absent (null) or the empty list `()` — the two ways a form can have nothing
; where an operand belongs. A definer that refuses `()` asks this, not `= null`.
(defn node-empty? (n:?&Node):bool
  (when (= n null) (return true))
  (return (and (= (n 'kind) NODE-LIST) (= (n 'len) 0))))

; The kind of a node that is not there. Deliberately outside NodeKind's 0..n
; range, so a `(= (node-kind x) NODE-SYM)` test answers false rather than
; matching a real kind by accident.
(defconst NODE-NIL -1)

; `(n kind)` for a node that may be absent — null, or the empty list `()`, which
; carries no name, no head and no operand. That is W9 item 45: the diagnostic
; each site wants ("name must be a symbol") already existed there, and the kind
; test that would have fired it crashed on the null first. Use this wherever the
; node came from `node-at`, whose return type is `?ref:Node` and says so; a site
; that means to walk a list whether or not it is empty reads `(n 'kind)`.
(defn node-kind (n:ptr:Node):i32
  (when (node-empty? n) (return NODE-NIL))
  (return (n 'kind)))

; ============================================================
; The list API (design/stage21-cleanup/ast-as-collection.md §8)
; ============================================================
;
; Every consumer of a list reads it through these and builds one through
; `node-list-new`/`node-push`/`node-list-done` (or the fixed-arity
; `node-listN`), never through the cell fields: the representation behind
; them is what §8's second step replaces. Null is "absent" — an out-of-range
; `node-at`, a missing form — and every reader below treats it as empty.

; The first element, or null when `n` is null, empty, or not a list.
(defn node-first (n:ptr:Node):?&Node
  (when (= (node-len n) 0) (return null))
  (return (aref (n 'elems) 0)))

; A fresh array of `n` element slots.
(defn node-elems-alloc (n:i32):?&?&Node
  (return (unsafe/cast (ptr (ptr Node)) (arena-alloc (* (as i64 n) (sizeof &Node))))))

; A list under construction — the same thing as a finished list, so
; `node-list-done` is the identity and a builder may be handed out as it is.
(defn node-list-new (line:i32):&Node
  (let (b:&Node (alloc-node))
    (set! (b 'kind) NODE-LIST)
    (set! (b 'line) line)
    (return b)))

; The elements after the first, or null when there are none. A `cap` of 0 over a
; non-null `elems` is a BORROWED view: it shares the parent's array and copies on
; its first push, which is what keeps `node-rest` O(1).
(defn node-rest (n:ptr:Node):ptr:Node
  (when (<= (node-len n) 1) (return null))
  (let (v:&Node (node-list-new (n 'line)))
    (set! (v 'elems) (unsafe/ptr+ (n 'elems) 1))
    (set! (v 'len) (- (n 'len) 1))
    (return v)))

; Room for one more element, owned. Growth is amortized doubling from 4.
(defn node-reserve (b:&Node):void
  (when (< (b 'len) (b 'cap)) (return))
  (let (want:i32 (if (< (b 'cap) 4) (+ (b 'len) 4) (* (b 'cap) 2))
        fresh:(ptr ?&Node) null)
    (set! fresh (node-elems-alloc want))
    (dotimes (i (b 'len))
      (set! (aref fresh i) (aref (b 'elems) i)))
    (set! (b 'elems) fresh)
    (set! (b 'cap) want)))

(defn node-push (b:&Node x:?&Node):void
  (node-reserve b)
  (set! (aref (b 'elems) (b 'len)) x)
  (set! (b 'len) (+ (b 'len) 1)))

; The list's line is its FIRST element's: the top-level dispatcher blames the
; unit's opening form for a form that carries no line of its own (a symbol).
(defn node-push-line (b:&Node x:?&Node line:i32):void
  (when (= (b 'len) 0) (set! (b 'line) line))
  (node-push b x))

; Append every element of `lst` (null = nothing; a non-list is one element).
(defn node-extend (b:&Node lst:?&Node):void
  (when (= lst null) (return))
  (when (!= (lst 'kind) NODE-LIST)
    (node-push b lst)
    (return))
  (dotimes (i (lst 'len))
    (node-push b (aref (lst 'elems) i))))

(defn node-list-done (b:&Node):&Node
  (return b))

(defn node-cons (x:?&Node lst:?&Node line:i32):&Node
  (let (b:&Node (node-list-new line))
    (node-push b x)
    (node-extend b lst)
    (return b)))

; Replace element `i` of `lst` in place.
(defn node-set-at (lst:&Node i:i32 x:?&Node):void
  (when (or (< i 0) (>= i (lst 'len))) (return))
  (set! (aref (lst 'elems) i) x))

; Replace element `i` with the elements of `items`, followed by `extra` when it
; is non-null — the top-level dispatcher's splice, which must be a MUTATION so
; that a list the caller already holds keeps its identity.
(defn node-splice-at (lst:&Node i:i32 items:?&Node extra:?&Node):void
  (when (or (< i 0) (>= i (lst 'len))) (return))
  (let (b:&Node (node-list-new (lst 'line)))
    (dotimes (k i)
      (node-push b (aref (lst 'elems) k)))
    (node-extend b items)
    (when (!= extra null) (node-push b extra))
    (let (k:i32 (+ i 1))
      (while (< k (lst 'len))
        (node-push b (aref (lst 'elems) k))
        (inc! k)))
    (set! (lst 'elems) (b 'elems))
    (set! (lst 'len) (b 'len))
    (set! (lst 'cap) (b 'cap))))

(defn node-list1 (a:?&Node line:i32):&Node
  (let (b:&Node (node-list-new line))
    (node-push b a)
    (return b)))
(defn node-list2 (a:?&Node b:?&Node line:i32):&Node
  (let (n:&Node (node-list1 a line))
    (node-push n b)
    (return n)))
(defn node-list3 (a:?&Node b:?&Node c:?&Node line:i32):&Node
  (let (n:&Node (node-list2 a b line))
    (node-push n c)
    (return n)))
(defn node-list4 (a:?&Node b:?&Node c:?&Node d:?&Node line:i32):&Node
  (let (n:&Node (node-list3 a b c line))
    (node-push n d)
    (return n)))
(defn node-list5 (a:?&Node b:?&Node c:?&Node d:?&Node e:?&Node line:i32):&Node
  (let (n:&Node (node-list4 a b c d line))
    (node-push n e)
    (return n)))

; `intern` is imported HERE, not at the top: it reaches `lib/nucleus/error.nuc`
; transitively, whose `with-handler` macro body calls `node-at` — and a macro
; body sees only what precedes it (context/conventions.md). Importing it above
; would compile that macro before `node-at` is a registered program defn, and
; the JIT module would reference an undeclared `@node-at`.
(import-use nucleus.intern)

; A form's head symbol, or none for an empty list or a leaf.
(defn node-head-sym (n:ptr:Node):Symbol
  (if-some (h (node-first n)) (return (h 's)) (return (symbol-none))))

; ============================================================
; Symbol intern table
; ============================================================
;
; Two reads of the same spelling return the same Node*: identical symbols
; are =-equal as pointers. The reader interns at lex time; quoted symbols
; (`'foo`) emit a runtime call to `intern-symbol` so that a quoted symbol
; and a reader-produced symbol of the same spelling are bit-identical.
;
; gensym deliberately bypasses interning — gensym-produced symbols are
; unique by construction and never collide with anything else.
;
; Stage 17 C7-2: the BYTES are `lib/nucleus/intern.nuc`'s, not a second table's. This
; file keeps only the Symbol -> canonical-Node map, which is what the `Node*`
; identity above actually needs; the probe is a pointer compare on the interned
; bytes rather than a `strcmp`, and the hash is the one the interner cached.
; Two tables over the same names would defeat both identities at once.

; The key is the `Symbol` itself, not its bytes pointer: one word either way,
; but the interner's identity, `=`, cached hash and `symbol-none?` all come with
; it, where the bare pointer had to be cast back into a Symbol to be hashed.
(defstruct InternEntry
  spelling:Symbol
  node:&Node)  ; valid whenever spelling is not symbol-none (occupied entry)

(defvar g-intern-table:ptr)
(defvar g-intern-cap:i32 0)
(defvar g-intern-len:i32 0)

(defn sym-node-place (table:ptr cap:i32 sp:Symbol nd:&Node h:i64):void
  (let (mask:i64 (as i64 (- cap 1))
        j:i64 (bit-and h mask))
    (while (!= 0 1)
      (let (e:&InternEntry (as &InternEntry
                                    (unsafe/ptr+ (unsafe/cast &InternEntry table) (unsafe/cast i32 j))))
        (when (symbol-none? (e 'spelling))
          (set! (e 'spelling) sp)
          (set! (e 'node) nd)
          (return)))
      (set! j (bit-and (+ j 1) mask)))))

(defn sym-node-grow ():void
  (let (old-cap:i32 g-intern-cap
        old-table:ptr g-intern-table
        new-cap:i32 (* g-intern-cap 2)
        new-table:ptr (arena-alloc (* (as i64 new-cap)
                                      (sizeof InternEntry))))
    (set! g-intern-cap new-cap)
    (set! g-intern-table new-table)
    (let (i:i32 0)
      (while (< i old-cap)
        (let (e:&InternEntry (as &InternEntry
                                      (unsafe/ptr+ (unsafe/cast &InternEntry old-table) i)))
          (when (not (symbol-none? (e 'spelling)))
            (sym-node-place new-table new-cap (e 'spelling) (e 'node)
                            (unsafe/cast i64 (symbol-cached-hash (e 'spelling))))))
        (inc! i)))))

(defn intern-node (sym:Symbol):&Node
  (when (= g-intern-cap 0)
    (set! g-intern-cap 1024)
    (set! g-intern-table (arena-alloc (* (as i64 g-intern-cap)
                                         (sizeof InternEntry)))))
  (when (>= (* g-intern-len 2) g-intern-cap)
    (sym-node-grow))
  (let (mask:i64 (as i64 (- g-intern-cap 1))
        j:i64 (bit-and (unsafe/cast i64 (symbol-cached-hash sym)) mask))
    (while (!= 0 1)
      (let (e:&InternEntry (as &InternEntry
                                    (unsafe/ptr+ (unsafe/cast &InternEntry g-intern-table) (unsafe/cast i32 j))))
        (when (symbol-none? (e 'spelling))
          (let (nd:&Node (alloc-node))
            (set! (nd 'kind) NODE-SYM)
            (set! (nd 'line) 0)
            (set! (nd 's) sym)
            (set! (e 'spelling) sym)
            (set! (e 'node) nd)
            (inc! g-intern-len)
            (return nd)))
        (when (= (e 'spelling) sym)
          (return (e 'node))))
      (set! j (bit-and (+ j 1) mask)))))

; The ONLY caller is the `'foo` lowering, which emits `call ptr @intern-symbol`
; with a C string constant — this is that lowering's ABI, not a source-level API.
; Nucleus source interns through `(intern-node (symbol-intern …))`.
(defn intern-symbol (s:CStr):&Node
  (return (intern-node (symbol-from-cstr s))))

; ============================================================
; A list Node as a collection
; ============================================================
;
; The point of the header layout: a list answers `count`, `(n i)`, `conj`,
; `doseq` and the combinators like any other collection
; (design/stage21-cleanup/ast-as-collection.md §1).
;
; Imported here rather than at the top for the same reason `intern` is: a macro
; body sees only what precedes it, and `lib/nucleus/coll.nuc` reaches macros of its own.
(import-use nucleus.coll)
(import-use nucleus.iterator)

; LIFETIME: a view, not an owner — the list must outlive the iterator.
(defstruct NodeIter
  lst:&Node
  pos:i32)

; The element type is `&Node`, not `(ptr Node)`: `some` takes a non-null ref, and
; a null element is not one. Only the `:rest` lowering stores a null (an
; `inttoptr` of a small integer), and it builds through `node-push`, not `conj`.
(extend NodeIter (Iterator &Node))

(defn next (self:&NodeIter):?&Node
  (when (>= (self 'pos) (node-len (self 'lst))) (return none))
  (let (e:?&Node (aref ((self 'lst) 'elems) (self 'pos)))
    (set! (self 'pos) (+ (self 'pos) 1))
    (return (as-ref e))))

(extend Node (Coll &Node NodeIter))

(defn count (self:&Node):usize
  (return (unsafe/cast usize (node-len self))))

(defn conj (self:&Node elem:&Node):void
  (node-push self elem))

(defn empty? (self:&Node):bool
  (return (= (node-len self) 0)))

(defn iter (self:&Node):NodeIter
  (let (it:&NodeIter (alloca NodeIter))
    (set! (it 'lst) self)
    (set! (it 'pos) 0)
    (return @it)))

; `invoke`, not `get`: an integer index `(n i)` routes to `invoke`, which keeps
; index access and field access distinct (lib/nucleus/coll.nuc §Seq). `(n 'kind)` still
; reads the field — the router prefers a selector that names one.
(extend Node (Seq &Node))

(defn invoke (self:&Node i:usize):&Node
  (return (unsafe/cast &Node (node-at self (unsafe/cast i32 i)))))

(defn append (self:&Node elem:&Node):void
  (node-push self elem))

(defn contains? (self:&Node elem:&Node):bool
  (dotimes (i (node-len self))
    (when (= (aref (self 'elems) i) elem) (return true)))
  (return false))

(defn insert (self:&Node i:usize elem:&Node):void
  (let (at:i32 (unsafe/cast i32 i))
    (when (or (< at 0) (> at (self 'len))) (return))
    (node-reserve self)
    (let (k:i32 (self 'len))
      (while (> k at)
        (set! (aref (self 'elems) k) (aref (self 'elems) (- k 1)))
        (set! k (- k 1))))
    (set! (aref (self 'elems) at) elem)
    (set! (self 'len) (+ (self 'len) 1))))

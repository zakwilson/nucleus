; .nuch header for lib/nucleus/intern-str.nuc
(ns nucleus.intern-str)
(import-use nucleus.error)
(import-use nucleus.numeric)
(import-use nucleus.char)
(import-use nucleus.strview)
(import-use nucleus.strview-str)
(import-use nucleus.vector)
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use nucleus.intern)
(import-use nucleus.hash)
(import-use nucleus.string-protocols)
(extend Symbol Eq)
(extend Symbol Hash)
(defmethod "@nuc_hash.pnuc_Symbol" hash ((self (ref Symbol))) :usize)
(extend Symbol ToStr)
(defmethod "@nuc_to_str.nuc_Symbol.pnuc_String" to-str ((self Symbol) (out (ref String))) :!void)
(extend Symbol (ByteStr ByteIter))
(defmethod "@nuc_byte_len.pnuc_Symbol" byte-len ((self (ref Symbol))) :usize)
(defmethod "@nuc_byte_at.pnuc_Symbol.usize" byte-at ((self (ref Symbol)) (i usize)) :!ui8)
(defmethod "@nuc_bytes.pnuc_Symbol" bytes ((self (ref Symbol))) :ByteIter)
(defmethod "@nuc_as_view.pnuc_Symbol" as-view ((self (ref Symbol))) :StrView)
(defmethod "@nuc_sub_bytes.pnuc_Symbol.usize.usize" sub-bytes ((self (ref Symbol)) (start usize) (end usize)) :!StrView)
(defmethod "@nuc_byte_find.pnuc_Symbol.pnuc_StrView" byte-find ((self (ref Symbol)) (needle (ref StrView))) :?usize)
(extend Symbol (Str CharIter))
(defmethod "@nuc_char_count.pnuc_Symbol" char-count ((self (ref Symbol))) :usize)
(defmethod "@nuc_str_empty_QMARK.pnuc_Symbol" str-empty? ((self (ref Symbol))) :bool)
(defmethod "@nuc_char_at.pnuc_Symbol.usize" char-at ((self (ref Symbol)) (i usize)) :!Char)
(defmethod "@nuc_chars.pnuc_Symbol" chars ((self (ref Symbol))) :CharIter)
(defmethod "@nuc_starts_with_QMARK.pnuc_Symbol.pnuc_StrView" starts-with? ((self (ref Symbol)) (prefix (ref StrView))) :bool)
(defmethod "@nuc_ends_with_QMARK.pnuc_Symbol.pnuc_StrView" ends-with? ((self (ref Symbol)) (suffix (ref StrView))) :bool)
(defmethod "@nuc_contains_str_QMARK.pnuc_Symbol.pnuc_StrView" contains-str? ((self (ref Symbol)) (needle (ref StrView))) :bool)

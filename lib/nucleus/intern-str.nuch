; .nuch header for lib/nucleus/intern-str.nuc
(ns nucleus.intern-str)
(import-use nucleus.error)
(import-use nucleus.numeric)
(import-use nucleus.char)
(import-use nucleus.strview)
(import-use nucleus.strview-str)
(import-use nucleus.vector)
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use nucleus.intern)
(import-use nucleus.hash)
(import-use nucleus.string-protocols)
(extend Symbol Eq)
(extend Symbol Hash)
(defmethod "@hash.pSymbol" hash ((self (ref Symbol))) :usize)
(extend Symbol ToStr)
(defmethod "@to_str.Symbol.pString" to-str ((self Symbol) (out (ref String))) :!void)
(extend Symbol (ByteStr ByteIter))
(defmethod "@byte_len.pSymbol" byte-len ((self (ref Symbol))) :usize)
(defmethod "@byte_at.pSymbol.usize" byte-at ((self (ref Symbol)) (i usize)) :!ui8)
(defmethod "@bytes.pSymbol" bytes ((self (ref Symbol))) :ByteIter)
(defmethod "@as_view.pSymbol" as-view ((self (ref Symbol))) :StrView)
(defmethod "@sub_bytes.pSymbol.usize.usize" sub-bytes ((self (ref Symbol)) (start usize) (end usize)) :!StrView)
(defmethod "@byte_find.pSymbol.pStrView" byte-find ((self (ref Symbol)) (needle (ref StrView))) :?usize)
(extend Symbol (Str CharIter))
(defmethod "@char_count.pSymbol" char-count ((self (ref Symbol))) :usize)
(defmethod "@str_empty_QMARK.pSymbol" str-empty? ((self (ref Symbol))) :bool)
(defmethod "@char_at.pSymbol.usize" char-at ((self (ref Symbol)) (i usize)) :!Char)
(defmethod "@chars.pSymbol" chars ((self (ref Symbol))) :CharIter)
(defmethod "@starts_with_QMARK.pSymbol.pStrView" starts-with? ((self (ref Symbol)) (prefix (ref StrView))) :bool)
(defmethod "@ends_with_QMARK.pSymbol.pStrView" ends-with? ((self (ref Symbol)) (suffix (ref StrView))) :bool)
(defmethod "@contains_str_QMARK.pSymbol.pStrView" contains-str? ((self (ref Symbol)) (needle (ref StrView))) :bool)

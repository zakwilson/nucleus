; .nuch header for lib/nucleus/string.nuc
(ns nucleus.string)
(import-use nucleus.allocator)
(import-use nucleus.coll)
(import-use nucleus.iterator)
(import-use nucleus.vector)
(import-use nucleus.strview)
(import-use nucleus.strview-str)
(import-use nucleus.char)
(import-use nucleus.string-errors)
(import-use nucleus.string-protocols)
(import-use nucleus.hash)
(import-use nucleus.numeric)
(defstruct String (bytes (Vector ui8)))
(declare string-as-view ((self (ref String))) :StrView)
(declare string-new () :String)
(declare string-new-alloc ((a (ref AllocHandle))) :String)
(declare string-with-capacity ((n usize)) :String)
(declare string-push-bytes-raw ((self (ref String)) (p (ref ui8)) (n usize)) :void)
(declare string-push-char ((self (ref String)) (c Char)) :void)
(declare string-push-str-unchecked ((self (ref String)) (s (ref StrView))) :void)
(declare string-push-str ((self (ref String)) (s (ref StrView))) :!void)
(declare string-pop-char ((self (ref String))) :?Char)
(declare string-clear ((self (ref String))) :void)
(declare string-truncate ((self (ref String)) (byte-len usize)) :!void)
(declare string-truncate-unchecked ((self (ref String)) (byte-len usize)) :void)
(declare string-reserve ((self (ref String)) (extra usize)) :void)
(declare string-as-cstr ((self (ref String))) :CStr)
(declare string-shrink-to-fit ((self (ref String))) :void)
(declare string-from-view ((sv (ref StrView))) :!String)
(declare string-from-cstr-unchecked ((cs CStr)) :String)
(declare string-from-cstr ((cs CStr)) :!String)
(extend String Drop)
(defmethod "@drop.pString" drop ((self (ref String))) :void)
(extend String (ByteStr ByteIter))
(defmethod "@byte_len.pString" byte-len ((self (ref String))) :usize)
(defmethod "@byte_at.pString.usize" byte-at ((self (ref String)) (i usize)) :!ui8)
(defmethod "@bytes.pString" bytes ((self (ref String))) :ByteIter)
(defmethod "@as_view.pString" as-view ((self (ref String))) :StrView)
(defmethod "@sub_bytes.pString.usize.usize" sub-bytes ((self (ref String)) (start usize) (end usize)) :!StrView)
(defmethod "@byte_find.pString.pStrView" byte-find ((self (ref String)) (needle (ref StrView))) :?usize)
(extend String (Str CharIter))
(defmethod "@char_count.pString" char-count ((self (ref String))) :usize)
(defmethod "@str_empty_QMARK.pString" str-empty? ((self (ref String))) :bool)
(defmethod "@char_at.pString.usize" char-at ((self (ref String)) (i usize)) :!Char)
(defmethod "@chars.pString" chars ((self (ref String))) :CharIter)
(defmethod "@starts_with_QMARK.pString.pStrView" starts-with? ((self (ref String)) (prefix (ref StrView))) :bool)
(defmethod "@ends_with_QMARK.pString.pStrView" ends-with? ((self (ref String)) (suffix (ref StrView))) :bool)
(defmethod "@contains_str_QMARK.pString.pStrView" contains-str? ((self (ref String)) (needle (ref StrView))) :bool)
(extend String Eq)
(defmethod "@eq.String.String" = ((a String) (b String)) :bool)
(defmethod "@ne.String.String" != ((a String) (b String)) :bool)
(extend String Ord)
(defmethod "@lt.String.String" < ((a String) (b String)) :bool)
(defmethod "@le.String.String" <= ((a String) (b String)) :bool)
(defmethod "@gt.String.String" > ((a String) (b String)) :bool)
(defmethod "@ge.String.String" >= ((a String) (b String)) :bool)
(extend String Hash)
(defmethod "@hash.pString" hash ((self (ref String))) :usize)

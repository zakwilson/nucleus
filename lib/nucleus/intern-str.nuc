; Stage 17 B4 — `Symbol`'s text conformances.
;
; Split from `lib/nucleus/intern.nuc` at C7-1 exactly as `lib/nucleus/strview-str.nuc` is split
; from `lib/nucleus/strview.nuc`, and for the same reason: `ToStr` needs `fmt` and
; `String`, and `ByteStr`/`Str` need `strview-str`, while the interner itself
; must stay importable by `lib/nucleus/node.nuc` without dragging the whole string stack
; into every program that uses a macro.
;
; Every method here is the `StrView` method on `symbol-as-view`, which is two
; words and no allocation.

(ns nucleus.intern-str)

(import-use nucleus.error)
(import-use nucleus.numeric)
(import-use nucleus.char)
(import-use nucleus.strview)
(import-use nucleus.strview-str)
(import-use nucleus.vector)
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use nucleus.intern)
(import-use nucleus.hash)
(import-use nucleus.string-protocols)

; The conformance RECORDS for the two protocols lib/nucleus/intern.nuc cannot import.
; `=`/`!=` are already defined there; `hash` is a load of the value cached at
; intern time, never a byte walk.
(extend Symbol Eq)

(extend Symbol Hash)
(defn hash (self:&Symbol):usize
  (return (symbol-cached-hash @self)))

(extend Symbol ToStr)
(defn to-str (self:Symbol out:&String):!void
  (let (v:StrView (symbol-as-view self))
    (string-push-str-unchecked out &v))
  (return (ok)))

; ByteStr/Str come free through the view: every method is the StrView method on
; `as-view`, which is two words and no allocation.
(extend Symbol (ByteStr ByteIter))

(defn byte-len (self:&Symbol):usize (return (symbol-len @self)))

(defn byte-at (self:&Symbol i:usize):!ui8
  (let (v:StrView (symbol-as-view @self))
    (return (byte-at v i))))

(defn bytes (self:&Symbol):ByteIter
  (let (v:StrView (symbol-as-view @self))
    (return (bytes v))))

(defn as-view (self:&Symbol):StrView
  (return (symbol-as-view @self)))

(defn sub-bytes (self:&Symbol start:usize end:usize):!StrView
  (let (v:StrView (symbol-as-view @self))
    (return (sub-bytes v start end))))

(defn byte-find (self:&Symbol needle:&StrView):?usize
  (let (v:StrView (symbol-as-view @self))
    (return (byte-find v needle))))

(extend Symbol (Str CharIter))

(defn char-count (self:&Symbol):usize
  (let (v:StrView (symbol-as-view @self))
    (return (char-count v))))

(defn str-empty? (self:&Symbol):bool
  (return (= (symbol-len @self) 0)))

(defn char-at (self:&Symbol i:usize):!Char
  (let (v:StrView (symbol-as-view @self))
    (return (char-at v i))))

(defn chars (self:&Symbol):CharIter
  (let (v:StrView (symbol-as-view @self))
    (return (chars v))))

(defn starts-with? (self:&Symbol prefix:&StrView):bool
  (let (v:StrView (symbol-as-view @self))
    (return (starts-with? v prefix))))

(defn ends-with? (self:&Symbol suffix:&StrView):bool
  (let (v:StrView (symbol-as-view @self))
    (return (ends-with? v suffix))))

(defn contains-str? (self:&Symbol needle:&StrView):bool
  (let (v:StrView (symbol-as-view @self))
    (return (contains-str? v needle))))

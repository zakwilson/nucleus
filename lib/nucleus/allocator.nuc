; Allocators: the `Allocator` protocol, the stored handle `Alloc`, and the
; built-in allocators `Heap`, `Arena`, `FixedBuffer` and `Tracking`.
; Design: design/stage24-allocation/overview.md §4, §8, and AL-1 and AL-6 in §9.

(ns nucleus.allocator)

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use "string.h")

(import-use nucleus.coll)   ; Drop

(extern stderr:ptr)

; ---------------------------------------------------------------------------
; The handle a collection stores. A zero-filled `Alloc` is the heap handle, so
; a global holding one needs no initializer.
; ---------------------------------------------------------------------------
(defenum AllocKind ALLOC-HEAP ALLOC-ARENA ALLOC-FIXED ALLOC-CUSTOM ALLOC-TRACKING)

(defstruct Alloc
  kind:i32
  data:ptr)

; The table an `ALLOC-CUSTOM` handle's `data` points at. It must outlive every
; handle made from it.
(defstruct CustomAlloc
  instance:ptr
  allocate-fn:(fn ?&ui8)(ptr usize usize)
  reallocate-fn:(fn ?&ui8)(ptr ?&ui8 usize usize usize)
  deallocate-fn:(fn void)(ptr ?&ui8 usize usize))

(defprotocol Allocator
  (allocate   (self:&Self size:usize align:usize) ?&ui8)
  (reallocate (self:&Self (p ?&ui8) old:usize new:usize align:usize) ?&ui8)
  (deallocate (self:&Self (p ?&ui8) size:usize align:usize):void)
  (handle     (self:&Self):Alloc))

; ---------------------------------------------------------------------------
; Alignment arithmetic. `align` must be a power of two; 0 reads as 1.
; ---------------------------------------------------------------------------
(defn align-pad (addr:usize align:usize):usize
  (when (<= align 1) (return 0))
  (return (bit-and (- 0 addr) (- align 1))))

(defn align-ok? (align:usize):bool
  (return (= (bit-and align (- align 1)) 0)))

(defn alloc-addr (p:ptr):usize
  (return (unsafe/cast usize p)))

; ---------------------------------------------------------------------------
; Heap: libc. Stateless, so one instance serves the process.
; ---------------------------------------------------------------------------
(defstruct Heap)

(defvar heap:Heap)

; What C promises of malloc (alignof max_align_t is two words on every target
; Nucleus has); a larger request is over-allocated by hand.
(defn heap-malloc-align ():usize
  (return (* 2 (sizeof usize))))

; An over-aligned block keeps malloc's own pointer in the word before it.
(defn heap-raw-slot (p:ptr):&ptr
  (return (unsafe/cast &ptr (unsafe/ptr+ (unsafe/cast &ui8 p)
                                         (- 0 (as i64 (sizeof ptr)))))))

(defn heap-allocate (size:usize align:usize) ?&ui8
  (when (not (align-ok? align)) (return null))
  (when (<= align (heap-malloc-align))
    (return (as ?&ui8 (malloc size))))
  (let (w:usize (sizeof ptr)
        raw:ptr (malloc (+ size align w)))
    (when (= raw null) (return null))
    (let (p:ptr (unsafe/ptr+ (unsafe/cast &ui8 raw)
                             (+ w (align-pad (+ (alloc-addr raw) w) align))))
      (set! (aref (heap-raw-slot p) 0) raw)
      (return (as ?&ui8 p)))))

(defn heap-deallocate ((p ?&ui8) size:usize align:usize):void
  (when (= (as ptr p) null) (return))
  (if (<= align (heap-malloc-align))
    (free (as ptr p))
    (free (aref (heap-raw-slot (as ptr p)) 0))))

(defn heap-reallocate ((p ?&ui8) old:usize new:usize align:usize) ?&ui8
  (when (<= align (heap-malloc-align))
    (return (as ?&ui8 (realloc (as ptr p) new))))
  (when (= (as ptr p) null) (return (heap-allocate new align)))
  (let ((q ?&ui8) (heap-allocate new align))
    (when (= (as ptr q) null) (return null))
    (memcpy (as ptr q) (as ptr p) (if (< old new) old new))
    (heap-deallocate p old align)
    (return q)))

(extend Heap Allocator)
(extend Heap Drop)

(defn allocate (self:&Heap size:usize align:usize) ?&ui8
  (return (heap-allocate size align)))

(defn reallocate (self:&Heap (p ?&ui8) old:usize new:usize align:usize) ?&ui8
  (return (heap-reallocate p old new align)))

(defn deallocate (self:&Heap (p ?&ui8) size:usize align:usize):void
  (heap-deallocate p size align))

(defn handle (self:&Heap):Alloc
  (return (Alloc ALLOC-HEAP null)))

(defn drop (self:&Heap):void
  (return))

; ---------------------------------------------------------------------------
; Arena: a chain of blocks from a parent allocator, bump-allocated and released
; together. Memory it hands out is zero-filled. A zero-filled `Arena` is an
; empty arena over the heap with the default growth policy.
; ---------------------------------------------------------------------------
(defstruct ArenaBlock
  next:?&ArenaBlock
  size:usize)

(defstruct Arena
  first:?&ArenaBlock
  cur:?&ArenaBlock
  off:usize
  block-size:usize
  parent:Alloc)

(defn arena-block-align ():usize
  (return (sizeof usize)))

; The default policy starts small and doubles to a cap, so a short-lived arena
; stays small and a long-lived one makes few blocks; both are sized in words to
; fit a 16-bit `usize`.
(defn arena-default-block ():usize
  (return (* 8192 (sizeof usize))))

(defn arena-block-cap ():usize
  (when (<= (sizeof usize) 2) (return (arena-default-block)))
  (return (* (arena-default-block) 256)))

; An empty arena whose blocks come from `parent`; `block-size` 0 is the default
; policy, anything else is every block's minimum size.
(defn arena-in (parent:Alloc block-size:usize):Arena
  (return (Arena null null 0 block-size parent)))

(defn arena-base (b:&ArenaBlock):&ui8
  (return (unsafe/cast &ui8 b)))

; Where a `size`/`align` request would start in `b` past `from`, or 0 if it
; does not fit. Offset 0 is the block header, so it never names a fit.
(defn arena-fit (b:&ArenaBlock from:usize size:usize align:usize):usize
  (let (start:usize (+ from (align-pad (+ (alloc-addr b) from) align)))
    (when (or (> start (b 'size)) (> size (- (b 'size) start))) (return 0))
    (return start)))

(defn arena-take (a:&Arena b:&ArenaBlock start:usize size:usize):?&ui8
  (set! (a 'cur) b)
  (set! (a 'off) (+ start size))
  (let (p:&ui8 (unsafe/ptr+ (arena-base b) start))
    (memset p 0 size)
    (return p)))

(defn arena-next-size (a:&Arena tail:?&ArenaBlock need:usize):usize
  (let (bs:usize (a 'block-size))
    (when (= bs 0)
      (set! bs (arena-default-block))
      (when (!= tail null)
        (let (grown:usize (* (tail 'size) 2))
          (when (> grown (arena-block-cap)) (set! grown (arena-block-cap)))
          (when (> grown bs) (set! bs grown)))))
    (return (if (> need bs) need bs))))

(defn arena-allocate (a:&Arena size:usize align:usize) ?&ui8
  (when (not (align-ok? align)) (return null))
  (let (hdr:usize (sizeof ArenaBlock)
        (tail ?&ArenaBlock) (a 'cur)
        (b ?&ArenaBlock) (a 'first))
    (when (!= tail null)
      (let (start:usize (arena-fit tail (a 'off) size align))
        (when (!= start 0) (return (arena-take a tail start size))))
      (set! b (tail 'next)))
    ; Blocks past `cur` are only there after `arena-reset`; reuse the first that fits.
    (while (!= b null)
      (let (start:usize (arena-fit b hdr size align))
        (when (!= start 0) (return (arena-take a b start size))))
      (set! tail b)
      (set! b (b 'next)))
    (let (bs:usize (arena-next-size a tail (+ hdr size align))
          (nb ?&ui8) (allocate (ref a 'parent) bs (arena-block-align)))
      (when (= (as ptr nb) null) (return null))
      (let (blk:&ArenaBlock (unsafe/cast &ArenaBlock nb))
        (set! (blk 'next) null)
        (set! (blk 'size) bs)
        (if (= tail null)
          (set! (a 'first) blk)
          (set! (tail 'next) blk))
        (return (arena-take a blk (arena-fit blk hdr size align) size))))))

; True when `p..p+size` ends at the bump pointer, i.e. it is the latest allocation.
(defn arena-top? (a:&Arena (p ?&ui8) size:usize):bool
  (let ((cur ?&ArenaBlock) (a 'cur))
    (when (or (= cur null) (= (as ptr p) null)) (return false))
    (return (= (+ (alloc-addr (as ptr p)) size) (+ (alloc-addr cur) (a 'off))))))

(defn arena-deallocate (a:&Arena (p ?&ui8) size:usize):void
  (when (arena-top? a p size)
    (set! (a 'off) (- (alloc-addr (as ptr p)) (alloc-addr (a 'cur))))))

(defn arena-reallocate (a:&Arena (p ?&ui8) old:usize new:usize align:usize) ?&ui8
  (when (= (as ptr p) null) (return (arena-allocate a new align)))
  (when (arena-top? a p old)
    (let (cur:&ArenaBlock (unsafe/cast &ArenaBlock (a 'cur))
          start:usize (- (alloc-addr (as ptr p)) (alloc-addr cur)))
      (when (<= new (- (cur 'size) start))
        (when (> new old)
          (memset (unsafe/ptr+ (unsafe/cast &ui8 p) old) 0 (- new old)))
        (set! (a 'off) (+ start new))
        (return p))))
  (when (<= new old) (return p))
  (let ((q ?&ui8) (arena-allocate a new align))
    (when (= (as ptr q) null) (return null))
    (memcpy (as ptr q) (as ptr p) old)
    (return q)))

; Rewind to the first block and keep every block for reuse.
(defn arena-reset (a:&Arena):void
  (set! (a 'cur) (a 'first))
  (set! (a 'off) (sizeof ArenaBlock)))

(extend Arena Allocator)
(extend Arena Drop)

(defn allocate (self:&Arena size:usize align:usize) ?&ui8
  (return (arena-allocate self size align)))

(defn reallocate (self:&Arena (p ?&ui8) old:usize new:usize align:usize) ?&ui8
  (return (arena-reallocate self p old new align)))

(defn deallocate (self:&Arena (p ?&ui8) size:usize align:usize):void
  (arena-deallocate self p size))

(defn handle (self:&Arena):Alloc
  (return (Alloc ALLOC-ARENA self)))

; Frees every block; the arena is then empty and reusable.
(defn drop (self:&Arena):void
  (let ((b ?&ArenaBlock) (self 'first))
    (while (!= b null)
      (let ((next ?&ArenaBlock) (b 'next))
        (deallocate (ref self 'parent) (unsafe/cast ?&ui8 b) (b 'size) (arena-block-align))
        (set! b next))))
  (set! (self 'first) null)
  (set! (self 'cur) null)
  (set! (self 'off) 0))

; ---------------------------------------------------------------------------
; FixedBuffer: bump allocation over a borrowed buffer. `live` counts
; outstanding allocations so `drop` can report a leak (§8.4 option C).
; ---------------------------------------------------------------------------
(defstruct FixedBuffer
  buf:ptr
  len:usize
  off:usize
  live:usize)

(defn fixed-buffer (p:ptr len:usize):FixedBuffer
  (return (FixedBuffer p len 0 0)))

; A buffer in the expanding scope's frame; a function could not alloca in its
; caller's. `n` must be a constant.
(defmacro frame-buffer (n)
  `(fixed-buffer (alloca (array ui8 ~n)) ~n))

(defn fixed-allocate (fb:&FixedBuffer size:usize align:usize) ?&ui8
  (when (not (align-ok? align)) (return null))
  (let (start:usize (+ (fb 'off) (align-pad (+ (alloc-addr (fb 'buf)) (fb 'off)) align)))
    (when (or (> start (fb 'len)) (> size (- (fb 'len) start))) (return null))
    (set! (fb 'off) (+ start size))
    (set! (fb 'live) (+ (fb 'live) 1))
    (return (unsafe/ptr+ (unsafe/cast &ui8 (fb 'buf)) start))))

(defn fixed-top? (fb:&FixedBuffer (p ?&ui8) size:usize):bool
  (when (= (as ptr p) null) (return false))
  (return (= (+ (alloc-addr (as ptr p)) size) (+ (alloc-addr (fb 'buf)) (fb 'off)))))

(defn fixed-deallocate (fb:&FixedBuffer (p ?&ui8) size:usize):void
  (when (= (as ptr p) null) (return))
  (when (> (fb 'live) 0) (set! (fb 'live) (- (fb 'live) 1)))
  (when (fixed-top? fb p size)
    (set! (fb 'off) (- (alloc-addr (as ptr p)) (alloc-addr (fb 'buf))))))

(defn fixed-reallocate (fb:&FixedBuffer (p ?&ui8) old:usize new:usize align:usize) ?&ui8
  (when (= (as ptr p) null) (return (fixed-allocate fb new align)))
  (when (fixed-top? fb p old)
    (let (start:usize (- (alloc-addr (as ptr p)) (alloc-addr (fb 'buf))))
      (when (<= new (- (fb 'len) start))
        (set! (fb 'off) (+ start new))
        (return p))))
  (when (<= new old) (return p))
  (let ((q ?&ui8) (fixed-allocate fb new align))
    (when (= (as ptr q) null) (return null))
    (memcpy (as ptr q) (as ptr p) old)
    (fixed-deallocate fb p old)
    (return q)))

(extend FixedBuffer Allocator)
(extend FixedBuffer Drop)

(defn allocate (self:&FixedBuffer size:usize align:usize) ?&ui8
  (return (fixed-allocate self size align)))

(defn reallocate (self:&FixedBuffer (p ?&ui8) old:usize new:usize align:usize) ?&ui8
  (return (fixed-reallocate self p old new align)))

(defn deallocate (self:&FixedBuffer (p ?&ui8) size:usize align:usize):void
  (fixed-deallocate self p size))

(defn handle (self:&FixedBuffer):Alloc
  (return (Alloc ALLOC-FIXED self)))

; The buffer belongs to whoever supplied it, so drop only checks the count.
; There is no checked build to confine it to (overview.md §9 AL-1).
(defn drop (self:&FixedBuffer):void
  (when (!= (self 'live) 0)
    (fprintf stderr "FixedBuffer: dropped with %llu live allocation(s)\n"
             (as ui64 (self 'live)))))

; ---------------------------------------------------------------------------
; Tracking: forwards to a parent allocator and counts what is outstanding, so
; `drop` can report a leak (§8.4 option C). A zero-filled `Tracking` is over the heap.
; ---------------------------------------------------------------------------
(defstruct Tracking
  parent:Alloc
  live:usize
  bytes:usize)

; Over-freeing is caught without per-allocation records: it would take more
; than is outstanding. The block is not forwarded, since the parent may not own it.
(defn tracking-owes? (tr:&Tracking size:usize):bool
  (when (and (> (tr 'live) 0) (<= size (tr 'bytes))) (return true))
  (fprintf stderr "Tracking: deallocate of %llu byte(s) with %llu live allocation(s) of %llu byte(s)\n"
           (as ui64 size) (as ui64 (tr 'live)) (as ui64 (tr 'bytes)))
  (return false))

(defn tracking-allocate (tr:&Tracking size:usize align:usize) ?&ui8
  (let ((p ?&ui8) (allocate (ref tr 'parent) size align))
    (when (!= (as ptr p) null)
      (set! (tr 'live) (+ (tr 'live) 1))
      (set! (tr 'bytes) (+ (tr 'bytes) size)))
    (return p)))

(defn tracking-reallocate (tr:&Tracking (p ?&ui8) old:usize new:usize align:usize) ?&ui8
  (when (= (as ptr p) null) (return (tracking-allocate tr new align)))
  (when (not (tracking-owes? tr old)) (return null))
  (let ((q ?&ui8) (reallocate (ref tr 'parent) p old new align))
    (when (!= (as ptr q) null)
      (set! (tr 'bytes) (+ (- (tr 'bytes) old) new)))
    (return q)))

(defn tracking-deallocate (tr:&Tracking (p ?&ui8) size:usize align:usize):void
  (when (= (as ptr p) null) (return))
  (when (not (tracking-owes? tr size)) (return))
  (set! (tr 'live) (- (tr 'live) 1))
  (set! (tr 'bytes) (- (tr 'bytes) size))
  (deallocate (ref tr 'parent) p size align))

(extend Tracking Allocator)
(extend Tracking Drop)

(defn allocate (self:&Tracking size:usize align:usize) ?&ui8
  (return (tracking-allocate self size align)))

(defn reallocate (self:&Tracking (p ?&ui8) old:usize new:usize align:usize) ?&ui8
  (return (tracking-reallocate self p old new align)))

(defn deallocate (self:&Tracking (p ?&ui8) size:usize align:usize):void
  (tracking-deallocate self p size align))

(defn handle (self:&Tracking):Alloc
  (return (Alloc ALLOC-TRACKING self)))

; The parent is borrowed, so drop only checks the counts.
(defn drop (self:&Tracking):void
  (when (!= (self 'live) 0)
    (fprintf stderr "Tracking: dropped with %llu live allocation(s) of %llu byte(s)\n"
             (as ui64 (self 'live)) (as ui64 (self 'bytes)))))

; ---------------------------------------------------------------------------
; Alloc dispatch. The plain functions are what compiler-synthesized code calls
; (closure environments, boxes), since a generic has no single symbol.
; ---------------------------------------------------------------------------
(defn alloc-allocate (a:&Alloc size:usize align:usize) ?&ui8
  (let (d:ptr (a 'data))
    (return (case (a 'kind)
              ALLOC-ARENA (arena-allocate (unsafe/cast &Arena d) size align)
              ALLOC-FIXED (fixed-allocate (unsafe/cast &FixedBuffer d) size align)
              ALLOC-TRACKING (tracking-allocate (unsafe/cast &Tracking d) size align)
              ALLOC-CUSTOM (let (c:&CustomAlloc (unsafe/cast &CustomAlloc d))
                             ((c 'allocate-fn) (c 'instance) size align))
              (heap-allocate size align)))))

(defn alloc-reallocate (a:&Alloc (p ?&ui8) old:usize new:usize align:usize) ?&ui8
  (let (d:ptr (a 'data))
    (return (case (a 'kind)
              ALLOC-ARENA (arena-reallocate (unsafe/cast &Arena d) p old new align)
              ALLOC-FIXED (fixed-reallocate (unsafe/cast &FixedBuffer d) p old new align)
              ALLOC-TRACKING (tracking-reallocate (unsafe/cast &Tracking d) p old new align)
              ALLOC-CUSTOM (let (c:&CustomAlloc (unsafe/cast &CustomAlloc d))
                             ((c 'reallocate-fn) (c 'instance) p old new align))
              (heap-reallocate p old new align)))))

(defn alloc-deallocate (a:&Alloc (p ?&ui8) size:usize align:usize):void
  (let (d:ptr (a 'data))
    (case (a 'kind)
      ALLOC-ARENA (arena-deallocate (unsafe/cast &Arena d) p size)
      ALLOC-FIXED (fixed-deallocate (unsafe/cast &FixedBuffer d) p size)
      ALLOC-TRACKING (tracking-deallocate (unsafe/cast &Tracking d) p size align)
      ALLOC-CUSTOM (let (c:&CustomAlloc (unsafe/cast &CustomAlloc d))
                     ((c 'deallocate-fn) (c 'instance) p size align))
      (heap-deallocate p size align))))

; A handle over a hand-built table, for an allocator the kinds above do not cover.
(defn custom-alloc (c:&CustomAlloc):Alloc
  (return (Alloc ALLOC-CUSTOM c)))

; A handle is not the allocator, so it has no `Drop`.
(extend Alloc Allocator)

(defn allocate (self:&Alloc size:usize align:usize) ?&ui8
  (return (alloc-allocate self size align)))

(defn reallocate (self:&Alloc (p ?&ui8) old:usize new:usize align:usize) ?&ui8
  (return (alloc-reallocate self p old new align)))

(defn deallocate (self:&Alloc (p ?&ui8) size:usize align:usize):void
  (alloc-deallocate self p size align))

(defn handle (self:&Alloc):Alloc
  (return @self))

; ---------------------------------------------------------------------------
; Initialization (overview.md §5): one method name, `init`, across the three
; protocols. `a` is the allocator the object stores and frees through. The
; one-call forms `new` and `make` are in nucleus.create.
; ---------------------------------------------------------------------------
(defprotocol Init
  (init (self:&Self a:Alloc):void))

(defprotocol (InitFrom V)
  (init (self:&Self a:Alloc v:V):void))

(defprotocol (TryInitFrom V)
  (init (self:&Self a:Alloc v:V):!void))

; So `new`/`make` can tell an initialized type from a plain struct by asking
; for `Init` alone; a `conforms?` cannot ask for InitFrom of any V.
(extend InitFrom Init)
(extend TryInitFrom Init)

(defn init (self:&T :where (Init T)):void
  (init self (handle &heap)))

; So `(make Tracking a)` is a tracker over `a`, as for any object that stores one.
(extend Tracking Init)

(defn init (self:&Tracking a:Alloc):void
  (set! (self 'parent) a)
  (set! (self 'live) 0)
  (set! (self 'bytes) 0))

; .nuch header for lib/macros.nuc
(defmacro + (:rest args) (cond (= args null) (quasiquote 0) (= (args cdr) null) (args car) true (quasiquote (_+ (unquote (args car)) (+ (unquote-splice (args cdr)))))))
(defmacro * (:rest args) (cond (= args null) (quasiquote 1) (= (args cdr) null) (args car) true (quasiquote (_* (unquote (args car)) (* (unquote-splice (args cdr)))))))
(defmacro - (:rest args) (cond (= args null) (quasiquote 0) (= (args cdr) null) (quasiquote (_- 0 (unquote (args car)))) (= ((args cdr) cdr) null) (quasiquote (_- (unquote (args car)) (unquote ((args cdr) car)))) true (quasiquote (- (_- (unquote (args car)) (unquote ((args cdr) car))) (unquote-splice ((args cdr) cdr))))))
(defmacro / (:rest args) (cond (= args null) (quasiquote 1) (= (args cdr) null) (quasiquote (_/ 1 (unquote (args car)))) (= ((args cdr) cdr) null) (quasiquote (_/ (unquote (args car)) (unquote ((args cdr) car)))) true (quasiquote (/ (_/ (unquote (args car)) (unquote ((args cdr) car))) (unquote-splice ((args cdr) cdr))))))
(defmacro and (:rest args) (cond (= args null) (quasiquote true) (= (args cdr) null) (args car) true (quasiquote (_and (unquote (args car)) (and (unquote-splice (args cdr)))))))
(defmacro or (:rest args) (cond (= args null) (quasiquote false) (= (args cdr) null) (args car) true (quasiquote (_or (unquote (args car)) (or (unquote-splice (args cdr)))))))
(defmacro bit-not (x) (quasiquote (bit-xor (unquote x) -1)))
(defmacro if (test then else) (quasiquote (cond (unquote test) (unquote then) true (unquote else))))
(defmacro case (form :rest clauses) (let ((acc (raw Node)) null (cur (raw Node)) clauses) (while (!= cur null) (let ((rest (raw Node)) (cur cdr)) (if (= rest null) (do (set! acc (quasiquote ((unquote-splice acc) true (unquote (cur car))))) (set! cur null)) (do (set! acc (quasiquote ((unquote-splice acc) (= (unquote form) (unquote (cur car))) (unquote (rest car))))) (set! cur (rest cdr)))))) (quasiquote (cond (unquote-splice acc)))))
(defmacro when (condition :rest body) (quasiquote (cond (unquote condition) (do (unquote-splice body)))))
(defmacro unless (condition :rest body) (quasiquote (cond (not (unquote condition)) (do (unquote-splice body)))))
(defmacro zero? (x) (quasiquote (= (unquote x) 0)))
(defmacro null? (x) (quasiquote (= (unquote x) null)))
(defmacro for (init test step body) (quasiquote (let (unquote init) (while (unquote test) (unquote body) (unquote step)))))
(defmacro dotimes (spec :rest body) (let ((var-node (raw Node)) (spec car) (n-node (raw Node)) ((spec cdr) car)) (quasiquote (let ((unquote var-node) (* (unquote n-node) 0)) (while (< (unquote var-node) (unquote n-node)) (do (unquote-splice body)) (inc! (unquote var-node)))))))
(defmacro doseq (binding :rest body) (let (done-sym:ptr (gensym) it-sym:ptr (gensym) var-sym:ptr (binding car) coll-expr:ptr ((binding cdr) car) it-type:ptr (((binding cdr) cdr) car)) (quasiquote (let (((unquote it-sym) (unquote it-type)) (iter (unquote coll-expr))) (let (((unquote done-sym) i32) 0) (while (= (unquote done-sym) 0) (match (next (addr-of (unquote it-sym))) ((some (unquote var-sym)) (do (unquote-splice body))) (none (set! (unquote done-sym) 1)))))))))
(defmacro doseq-iter (binding :rest body) (let (done-sym:ptr (gensym) var-sym:ptr (binding car) iter-ref:ptr ((binding cdr) car)) (quasiquote (let (((unquote done-sym) i32) 0) (while (= (unquote done-sym) 0) (match (next (unquote iter-ref)) ((some (unquote var-sym)) (do (unquote-splice body))) (none (set! (unquote done-sym) 1))))))))
(defmacro into (coll-sym src-coll it-type) (let (done-sym:ptr (gensym) it-sym:ptr (gensym) x-sym:ptr (gensym)) (quasiquote (let (((unquote it-sym) (unquote it-type)) (iter (unquote src-coll))) (let (((unquote done-sym) i32) 0) (while (= (unquote done-sym) 0) (match (next (addr-of (unquote it-sym))) ((some (unquote x-sym)) (conj (unquote coll-sym) (unquote x-sym))) (none (set! (unquote done-sym) 1)))))))))
(defmacro into-iter (coll-sym iter-ref) (let (done-sym:ptr (gensym) x-sym:ptr (gensym)) (quasiquote (let (((unquote done-sym) i32) 0) (while (= (unquote done-sym) 0) (match (next (unquote iter-ref)) ((some (unquote x-sym)) (conj (unquote coll-sym) (unquote x-sym))) (none (set! (unquote done-sym) 1))))))))
(defmacro -> (x :rest forms) (let ((result (raw Node)) x (current (raw Node)) forms) (while (!= current null) (let ((form (raw Node)) (current car)) (if (= (form kind) NODE-CELL) (do (let (has-placeholder:i32 0 (scan (raw Node)) form) (while (!= scan null) (let ((child (raw Node)) (scan car)) (when (= (child kind) NODE-SYM) (when (= (strcmp (child s) "_") 0) (set! has-placeholder 1)))) (set! scan (scan cdr))) (if (!= has-placeholder 0) (let ((rev (raw Node)) null (src (raw Node)) form) (while (!= src null) (let ((elem (raw Node)) (src car) replacement:ptr elem) (when (= (elem kind) NODE-SYM) (when (= (strcmp (elem s) "_") 0) (set! replacement result))) (set! rev (quasiquote ((unquote replacement) (unquote-splice rev))))) (set! src (src cdr))) (let (final:ptr null) (while (!= rev null) (set! final (quasiquote ((unquote (rev car)) (unquote-splice final)))) (set! rev (rev cdr))) (set! result final))) (let (head:ptr (form car) tail:ptr (form cdr)) (set! result (quasiquote ((unquote head) (unquote result) (unquote-splice tail)))))))) (set! result (quasiquote ((unquote form) (unquote result)))))) (set! current (current cdr))) result))

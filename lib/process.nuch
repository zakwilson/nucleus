; .nuch header for lib/process.nuc
(deferror process-spawn-failed "cannot start process")
(deferror process-wait-failed "cannot wait for process")
(deferror process-pipe-failed "cannot create pipe")
(deferror process-read-failed "cannot read from process")
(deferror process-signal-failed "cannot signal process")
(deferror process-redirect-failed "cannot redirect process output")
(defconst EXEC-FAILED-STATUS 127)
(defconst PROC-CHUNK 65536)
(defconst PROC-MODE-644 420)
(defunion ExitStatus (exited code:i32) (signaled sig:i32))
(declare wait-status-decode ((raw i32)) :ExitStatus)
(declare success? ((self (ref ExitStatus))) :bool)
(declare exit-code ((self (ref ExitStatus))) :i32)
(defstruct Command (buf String) (offs (Vector usize)) (envs (Vector usize)) (cwd-off i64) (search bool) (capture bool) (out-path-off i64) (merge-err bool))
(declare command-push-cstr ((self (ref Command)) (s StrView)) :usize)
(declare command ((prog StrView)) :Command)
(declare command-arg ((self (ref Command)) (a StrView)) :void)
(declare command-cwd ((self (ref Command)) (dir StrView)) :void)
(declare command-search ((self (ref Command)) (on bool)) :void)
(declare command-env ((self (ref Command)) (k StrView) (v StrView)) :void)
(declare command-capture ((self (ref Command)) (on bool)) :void)
(declare command-stdout-path ((self (ref Command)) (path StrView)) :void)
(declare command-stderr-to-stdout ((self (ref Command)) (on bool)) :void)
(extend Command Drop)
(defmethod "@drop.pCommand" drop ((self (ptr Command))) :void)
(declare command-argv ((self (ref Command)) (out (ref (Vector ptr)))) :void)
(declare env-key ((e (ptr ui8))) :StrView)
(declare command-envp ((self (ref Command)) (out (ref (Vector ptr)))) :void)
(defstruct Process (pid i32) (out-fd i32) (err-fd i32) (status ExitStatus))
(declare process-pid ((self (ref Process))) :i32)
(declare spawn ((self (ref Command))) :!Process)
(declare process-drain-one ((p (ref pollfd)) (into (ref String)) (buf (ptr ui8))) :!void)
(declare process-capture ((self (ref Process)) (out (ref String)) (errs (ref String))) :!void)
(declare process-wait ((self (ref Process))) :!ExitStatus)
(declare process-try-wait ((self (ref Process))) :!bool)
(declare process-status ((self (ref Process))) :ExitStatus)
(declare process-kill ((self (ref Process)) (sig i32)) :!void)
(defstruct ChildExit (pid i32) (status ExitStatus))
(declare wait-any () :!ChildExit)
(declare process-detach ((self (ref Process))) :void)
(extend Process Drop)
(defmethod "@drop.pProcess" drop ((self (ptr Process))) :void)
(defstruct Output (status ExitStatus) (out String) (err String))
(extend Output Drop)
(defmethod "@drop.pOutput" drop ((self (ptr Output))) :void)
(declare run ((self (ref Command))) :!Output)

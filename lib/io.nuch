; .nuch header for lib/io.nuc
(defstruct FdOut (fd i32))
(declare fd-out ((fd i32)) :FdOut)
(declare std-out () :FdOut)
(declare std-err () :FdOut)
(declare fd-write-all ((fd i32) (p (ptr ui8)) (n usize)) :!void)
(extend FdOut Writer)
(declare write-str ((self (ref FdOut)) (s StrView)) :!void)
(extern (g-io-buf String))
(extern (g-io-buf-ready i32))
(declare io-buf-begin () :ref:String)
(declare io-buf-end ((fd i32)) :!void)
(defmacro print (:rest parts) (let (b:ptr (gensym)) (quasiquote (let (((unquote b) (ref String)) (io-buf-begin)) (str-into (unquote b) (unquote-splice parts)) (io-buf-end 1)))))
(defmacro println (:rest parts) (let (b:ptr (gensym)) (quasiquote (let (((unquote b) (ref String)) (io-buf-begin)) (str-into (unquote b) (unquote-splice parts) ) (io-buf-end 1)))))
(defmacro eprint (:rest parts) (let (b:ptr (gensym)) (quasiquote (let (((unquote b) (ref String)) (io-buf-begin)) (str-into (unquote b) (unquote-splice parts)) (io-buf-end 2)))))
(defmacro eprintln (:rest parts) (let (b:ptr (gensym)) (quasiquote (let (((unquote b) (ref String)) (io-buf-begin)) (str-into (unquote b) (unquote-splice parts) ) (io-buf-end 2)))))
(defconst IO-IN-CAP 8192)
(extern (g-in-buf ptr))
(extern (g-in-len usize))
(extern (g-in-pos usize))
(extern (g-in-eof i32))
(declare io-in-fill () :i32)
(declare read-line () (Maybe String))

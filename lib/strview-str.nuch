; .nuch header for lib/strview-str.nuc
(extend StrView (ByteStr ByteIter))
(declare byte-len ((self (ref StrView))) :usize)
(declare byte-at ((self (ref StrView)) (i usize)) :!ui8)
(declare bytes ((self (ref StrView))) :ByteIter)
(declare as-view ((self (ref StrView))) :StrView)
(declare sub-bytes ((self (ref StrView)) (start usize) (end usize)) :!ptr:StrView)
(declare byte-find ((self (ref StrView)) (needle (ref StrView))) (Maybe usize))
(extend StrView (Str CharIter))
(declare char-count ((self (ref StrView))) :usize)
(declare str-empty? ((self (ref StrView))) :i32)
(declare char-at ((self (ref StrView)) (i usize)) :!Char)
(declare chars ((self (ref StrView))) :CharIter)
(declare starts-with? ((self (ref StrView)) (prefix (ref StrView))) :i32)
(declare ends-with? ((self (ref StrView)) (suffix (ref StrView))) :i32)
(declare contains-str? ((self (ref StrView)) (needle (ref StrView))) :i32)

; .nuch header for lib/intern.nuc
(defstruct Symbol (p (ptr ui8)))
(defconst SYM-LEN-OFF -8)
(defconst SYM-HASH-OFF -16)
(defconst SYM-HEADER 16)
(declare symbol-len ((self Symbol)) :usize)
(declare symbol-cached-hash ((self Symbol)) :usize)
(declare symbol-as-view ((self Symbol)) :StrView)
(declare symbol-as-cstr ((self Symbol)) :CStr)
(defconst INTERN-INIT-CAP 1024)
(extern (g-sym-table ptr))
(extern (g-sym-cap usize))
(extern (g-sym-count usize))
(declare intern-oom () :void)
(declare intern-alloc-bytes ((sv (ref StrView)) (h usize)) (ptr ui8))
(declare intern-place ((tbl ptr) (cap usize) (p (ptr ui8)) (h usize)) :void)
(declare intern-grow ((newcap usize)) :void)
(declare symbol-intern ((sv (ref StrView))) :Symbol)
(declare symbol-from-cstr ((cs CStr)) :Symbol)
(declare symbol-count () :usize)
(extend Symbol Eq)
(defmethod "@eq.Symbol.Symbol" = ((a Symbol) (b Symbol)) :bool)
(defmethod "@ne.Symbol.Symbol" != ((a Symbol) (b Symbol)) :bool)
(extend Symbol Hash)
(declare hash ((self (ref Symbol))) :usize)
(extend Symbol ToStr)
(declare to-str ((self Symbol) (out (ref String))) :!void)
(extend Symbol (ByteStr ByteIter))
(declare byte-len ((self (ref Symbol))) :usize)
(declare byte-at ((self (ref Symbol)) (i usize)) :!ui8)
(declare bytes ((self (ref Symbol))) :ByteIter)
(declare as-view ((self (ref Symbol))) :StrView)
(declare sub-bytes ((self (ref Symbol)) (start usize) (end usize)) :!StrView)
(declare byte-find ((self (ref Symbol)) (needle (ref StrView))) (Maybe usize))
(extend Symbol (Str CharIter))
(declare char-count ((self (ref Symbol))) :usize)
(declare str-empty? ((self (ref Symbol))) :bool)
(declare char-at ((self (ref Symbol)) (i usize)) :!Char)
(declare chars ((self (ref Symbol))) :CharIter)
(declare starts-with? ((self (ref Symbol)) (prefix (ref StrView))) :bool)
(declare ends-with? ((self (ref Symbol)) (suffix (ref StrView))) :bool)
(declare contains-str? ((self (ref Symbol)) (needle (ref StrView))) :bool)

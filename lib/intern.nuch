; .nuch header for lib/intern.nuc
(defconst SYM-LEN-OFF -8)
(defconst SYM-HASH-OFF -16)
(defconst SYM-HEADER 16)
(declare symbol-len ((self Symbol)) :usize)
(declare symbol-cached-hash ((self Symbol)) :usize)
(declare symbol-as-view ((self Symbol)) :StrView)
(declare symbol-as-cstr ((self Symbol)) :CStr)
(defconst INTERN-INIT-CAP 1024)
(extern (g-sym-table ptr))
(extern (g-sym-cap usize))
(extern (g-sym-count usize))
(declare intern-oom () :void)
(declare intern-alloc-bytes ((sv (ref StrView)) (h usize)) (ptr ui8))
(declare intern-place ((tbl ptr) (cap usize) (p (ptr ui8)) (h usize)) :void)
(declare intern-grow ((newcap usize)) :void)
(declare symbol-intern ((sv (ref StrView))) :Symbol)
(declare symbol-from-cstr ((cs CStr)) :Symbol)
(declare symbol-count () :usize)
(extend Symbol Eq)
(defmethod "@eq.Symbol.Symbol" = ((a Symbol) (b Symbol)) :bool)
(defmethod "@ne.Symbol.Symbol" != ((a Symbol) (b Symbol)) :bool)
(extend Symbol Hash)
(declare hash ((self (ref Symbol))) :usize)

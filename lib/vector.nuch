(defn vector-new-capacity ((n usize)) (Vector T) (let (r (alloca (Vector T))) (vector-init-capacity r n) (return (deref r))))
(defn vector-new-in ((a (ref AllocHandle))) (ref (Vector T)) (let (v (unsafe/cast (ref (Vector T)) (alloc-handle-alloc a (sizeof (Vector T)) 8))) (vector-init-alloc v a) (return v)))
(defn vector-grow ((v (ref (Vector T)))) :void (let (new-cap:usize (if (= (_get v cap) 0) 4 (* (_get v cap) 2)) elem-size:usize (as usize (sizeof T))) (let (old-bytes:usize (* (_get v cap) elem-size) new-bytes:usize (* new-cap elem-size) ah:ref:AllocHandle (.& v alloc)) (let ((new-data (raw ui8)) (alloc-handle-realloc ah (_get v data) old-bytes new-bytes 8)) (when (= (as ptr new-data) null) (vector-oom)) (.set! v data new-data) (.set! v cap new-cap)))))
(defn count ((self (ref (Vector T)))) :usize (return (_get self len)))
(defn conj ((self (ref (Vector T))) (elem T)) :void (when (>= (_get self len) (_get self cap)) (vector-grow self)) (aset! (as ptr:T (as ptr (_get self data))) (as i64 (_get self len)) elem) (.set! self len (+ (_get self len) 1)))
(defn empty? ((self (ref (Vector T)))) :i32 (return (if (= (_get self len) 0) 1 0)))
(defn invoke ((self (ref (Vector T))) (i usize)) :T (when (>= i (_get self len)) (vector-bounds "get" i (_get self len))) (return (aref (as ptr:T (as ptr (_get self data))) (as i64 i))))
(defn append ((self (ref (Vector T))) (elem T)) :void (conj self elem))
(defn contains? ((self (ref (Vector T))) (elem T)) :i32 (let (i:usize 0) (while (< i (_get self len)) (when (= (aref (as ptr:T (as ptr (_get self data))) (as i64 i)) elem) (return 1)) (set! i (+ i 1))) (return 0)))
(defn insert ((self (ref (Vector T))) (i usize) (elem T)) :void (when (> i (_get self len)) (vector-bounds "insert" i (_get self len))) (when (>= (_get self len) (_get self cap)) (vector-grow self)) (let (buf:ptr:T (as ptr:T (as ptr (_get self data))) j:usize (_get self len)) (while (> j i) (aset! buf (as i64 j) (aref buf (as i64 (- j 1)))) (set! j (- j 1))) (aset! buf (as i64 i) elem)) (.set! self len (+ (_get self len) 1)))
(defn remove-at ((self (ref (Vector T))) (i usize)) :void (when (>= i (_get self len)) (vector-bounds "remove-at" i (_get self len))) (let (buf:ptr:T (as ptr:T (as ptr (_get self data))) j:usize i) (while (< (+ j 1) (_get self len)) (aset! buf (as i64 j) (aref buf (as i64 (+ j 1)))) (set! j (+ j 1)))) (.set! self len (- (_get self len) 1)))
(defn capacity ((self (ref (Vector T)))) :usize (return (_get self cap)))

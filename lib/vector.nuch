; .nuch header for lib/vector.nuc
(declare vector-oom () :void)
(declare vector-bounds ((what CStr) (i usize) (n usize)) :void)
(defstruct (Vector T) (data (raw ui8)) (len usize) (cap usize) (alloc AllocHandle))
(defn vector-init ((v (ref (Vector T)))) :void (.set! v data null) (.set! v len 0) (.set! v cap 0) (libc-allocator (.& v alloc)))
(defn vector-init-alloc ((v (ref (Vector T))) (a (ref AllocHandle))) :void (.set! v data null) (.set! v len 0) (.set! v cap 0) (.set! v alloc (deref a)))

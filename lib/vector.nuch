(defn vector-init-capacity ((v (ref (Vector T))) (n usize)) :void (vector-init v) (reserve v n))
(extend (Vector T) (Seq T))
(extend (Vector T) Drop)
(defn drop ((self (ptr (Vector T)))) :void (when (!= (as ptr (_get self data)) null) (alloc-handle-free (.& self alloc) (_get self data) (* (_get self cap) (as usize (sizeof T))) 8)) (.set! self data null) (.set! self len 0) (.set! self cap 0))
(defstruct (VecIter T) (data ptr) (pos usize) (len usize))
(extend (VecIter T) (Iterator T))
(defn next ((self (ref (VecIter T)))) (Maybe T) (when (>= (self pos) (self len)) (return none)) (let (v:T (aref (as ptr:T (self data)) (as i64 (self pos)))) (.set! self pos (+ (self pos) 1)) (return (some v))))
(defn iter-init ((it (ref (VecIter T))) (v (ref (Vector T)))) :void (.set! it data (as ptr (_get v data))) (.set! it pos 0) (.set! it len (_get v len)))

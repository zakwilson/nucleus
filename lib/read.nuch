; .nuch header for lib/read.nuc
(deferror read-eof "unexpected end of input")
(deferror read-unterminated-list "unterminated list")
(deferror read-unexpected-close "unexpected close bracket")
(deferror read-unterminated-string "unterminated string literal")
(deferror read-bad-escape "unknown escape in string literal")
(deferror read-bad-char "invalid char literal")
(deferror read-int-range "integer literal out of range")
(deferror read-empty-segment "empty segment in colon-chain")
(deferror read-map-odd "map literal: odd number of elements")
(deferror read-bad-rmacro "bad def-rmacro form")
(defstruct ReadError (code Err) (line i32) (msg StrView) (note StrView))
(declare read-error-code ((e ReadError)) :Err)
(defcast ReadError Err read-error-code)
(defunion ReadResult (ok v:raw:Node) (err e:ReadError))
(declare rd-error ((code Err) (line i32) (msg StrView) (note StrView)) :ReadError)
(declare rd-arena-str ((s (ref String))) :StrView)
(defstruct RMacro (prefix StrView) (wrap Symbol))
(extern (g-read-alloc AllocHandle))
(declare rd-macro-add ((tbl (ref (Vector RMacro))) (prefix StrView) (wrap Symbol)) :void)
(declare rd-macro-find ((tbl (ref (Vector RMacro))) (prefix StrView)) :i32)
(declare read-macro-table-new () (ref (Vector RMacro)))
(defstruct Reader (src StrView) (pos usize) (line i32) (paren-depth i32) (form-open-line i32) (col0-open-line i32) (col0-open-depth i32) (macros (ref (Vector RMacro))))
(declare reader-with-macros ((src StrView) (table (ref (Vector RMacro)))) :Reader)
(declare reader ((src StrView)) :Reader)
(declare rd-at ((self (ref Reader)) (i usize)) :i32)
(declare rd-peek ((self (ref Reader))) :i32)
(declare rd-peek1 ((self (ref Reader))) :i32)
(declare rd-next ((self (ref Reader))) :i32)
(declare rd-open-bracket ((self (ref Reader)) (line i32) (is-paren bool)) :void)
(declare rd-close-bracket ((self (ref Reader))) :void)
(declare rd-unterminated ((self (ref Reader)) (open-line i32) (msg StrView) (closer StrView)) :ReadError)
(declare rd-space? ((c i32)) :bool)
(declare rd-digit? ((c i32)) :bool)
(declare rd-hex-val ((c i32)) :i32)
(declare rd-skip-ws ((self (ref Reader))) :void)
(declare rd-sym-char? ((c i32)) :bool)
(declare rd-slice ((self (ref Reader)) (start usize)) :StrView)
(declare rd-tv-at ((tv (ref StrView)) (i usize)) :i32)
(declare rd-int-atom? ((tv (ref StrView))) :bool)
(declare rd-hex-kind ((tv (ref StrView))) :i32)
(declare rd-float-atom? ((tv (ref StrView))) :bool)
(declare rd-int-value ((tv StrView) (radix i32)) :!i64)
(declare rd-seg-next ((c i32) (seg i32)) :i32)
(declare rd-legacy-marker? ((sv StrView)) :bool)
(declare rd-expand-sigil ((tv StrView)) :Symbol)
(declare rd-at-legacy-marker ((self (ref Reader))) :bool)
(declare rd-node ((kind i32) (line i32)) :ref:Node)
(declare rd-string ((self (ref Reader)) (open-line i32) (is-cstr bool)) :ReadResult)
(declare rd-char-node ((cp i32) (line i32)) :ref:Node)
(declare rd-char ((self (ref Reader)) (open-line i32)) :ReadResult)
(declare rd-int-node ((tv StrView) (radix i32) (line i32)) :ReadResult)
(declare rd-atom ((self (ref Reader))) :ReadResult)
(declare rd-macro-match ((self (ref Reader))) :i32)
(declare rd-atom-start? ((c i32)) :bool)
(declare reader-register-macro ((self (ref Reader)) (prefix StrView) (wrap Symbol) (line i32)) :ReadResult)
(declare rd-def-rmacro-form? ((form (raw Node))) :bool)
(declare rd-def-rmacro ((self (ref Reader)) (form (raw Node))) :ReadResult)
(declare rd-fn-type-form? ((form (raw Node))) :bool)
(declare rd-fuse-fn-params ((self (ref Reader)) (paren-form (raw Node)) (line i32)) :ReadResult)
(declare rd-open-segment? ((sv StrView)) :bool)
(declare rd-fuse-colon-paren ((self (ref Reader)) (child (raw Node)) (line i32)) :ReadResult)
(declare rd-list ((self (ref Reader)) (open-line i32)) :ReadResult)
(declare rd-lit-elems ((self (ref Reader)) (what StrView) (closer i32) (open-line i32)) :ReadResult)
(declare rd-lit-cell ((name StrView) (elems (raw Node)) (line i32)) :raw:Node)
(declare rd-atom-form ((self (ref Reader)) (line i32)) :ReadResult)
(declare rd-form ((self (ref Reader))) :ReadResult)
(declare reader-eof? ((self (ref Reader))) :bool)
(declare read-one ((self (ref Reader))) :ReadResult)
(declare read-all-with-macros ((src StrView) (table (ref (Vector RMacro)))) :ReadResult)
(declare read-all ((src StrView)) :ReadResult)
(declare rd-write-escaped ((out (ref String)) (sv StrView)) :void)
(declare rd-write-hex ((out (ref String)) (v ui64)) :void)
(declare sexp-write-string ((out (ref String)) (sv StrView)) :void)
(declare node-write ((out (ref String)) (n (raw Node))) :void)
(declare node-str ((n (raw Node))) :String)
(declare node-eq ((a (raw Node)) (b (raw Node))) :bool)

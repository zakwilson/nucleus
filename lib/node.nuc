; Node utilities — allocation and list operations on the AST Node type.
;
; The Node struct and NODE-* constants are defined in lib/prelude.nuc, which
; is auto-imported into every program. arena-alloc comes from lib/arena.nuc.

(import-use arena)

; arena-alloc aborts on exhaustion, so node allocation never yields null.
(defn alloc-node ():ref:Node
  (return (as ref:Node (arena-alloc (sizeof Node)))))

(defn make-cell (car:raw:Node cdr:raw:Node line:i32):ref:Node
  (let (c:ref:Node (alloc-node))
    (set! (c 'kind) NODE-CELL)
    (set! (c 'line) line)
    (set! (c 'car) car)
    (set! (c 'cdr) cdr)
    (return c)))

(defn node-at (n:raw:Node i:i32):?ptr:Node
  (match (as-ref n)
    ((some nn)
     (while (and (= (nn 'kind) NODE-CELL) (> i 0))
       (match (as-ref (nn 'cdr))
         ((some nnn)
          (set! n nnn)
          (set! nn nnn))
         (none (return none)))
       (set! i (- i 1)))
     (when (= (nn 'kind) NODE-CELL)
       (return (as-ref (nn 'car)))))
    (none (return none))))

(defn node-len (n:raw:Node):i32
  (let (k:i32 0
        nn:raw:Node n)
    (while (and (!= n null) (= (nn 'kind) NODE-CELL))
      (set! k (+ k 1))
      (set! n (nn 'cdr))
      (set! nn n))
    (return k)))

; Source line to blame for a diagnostic about `n`, given the line of the
; enclosing form.
;
; A bare symbol node is an *interned singleton* shared by every occurrence of
; that spelling in the whole program (see intern-symbol above and read-form's
; TOK-SYMBOL branch), so it cannot carry a per-occurrence line — `(sym line)` is
; always 0. Every other node kind (cells, ints, strings, chars, floats,
; keywords) is freshly allocated per occurrence and does carry its reader line.
;
; So a diagnostic whose subject is (or may be) a symbol must borrow the line of
; the enclosing form, which its emitter has in hand. Writing a line *into* a
; symbol node is never correct: it would be observed by every other occurrence
; of the same spelling anywhere in the program.
(defn node-line (n:raw:Node encl:i32):i32
  (when (= n null) (return encl))
  (let (ln:i32 (n 'line))
    (when (= ln 0) (return encl))
    (return ln)))

(defn node-is-list (n:raw:Node):bool
  (when (= n null) (return true))
  (when (= (n 'kind) NODE-CELL) (return true))
  (return false))

; The kind of a NULL node. Deliberately outside NodeKind's 0..n range, so a
; `(= (node-kind x) NODE-SYM)` test answers false rather than matching a real
; kind by accident.
(defconst NODE-NIL -1)

; `(n kind)`, null-safe. `()` reads as a NULL node — `read-list` returns null for
; a zero-element list (W5f) — so every `(x kind)` on a node a program may spell
; `()` is a null dereference. That was W9 item 45: the diagnostic each site wants
; ("name must be a symbol") already existed at the site, and the kind test that
; would have fired it crashed first. Use this wherever the node came from
; `node-at`, whose return type is `?ptr:Node` and says so.
(defn node-kind (n:raw:Node):i32
  (when (= n null) (return NODE-NIL))
  (return (n 'kind)))

; `intern` is imported HERE, not at the top: it reaches `lib/error.nuc`
; transitively, whose `with-handler` macro body calls `node-at` — and a macro
; body sees only what precedes it (context/conventions.md). Importing it above
; would compile that macro before `node-at` is a registered program defn, and
; the JIT module would reference an undeclared `@node-at`.
(import-use intern)

; ============================================================
; Symbol intern table
; ============================================================
;
; Two reads of the same spelling return the same Node*: identical symbols
; are =-equal as pointers. The reader interns at lex time; quoted symbols
; (`'foo`) emit a runtime call to `intern-symbol` so that a quoted symbol
; and a reader-produced symbol of the same spelling are bit-identical.
;
; gensym deliberately bypasses interning — gensym-produced symbols are
; unique by construction and never collide with anything else.
;
; Stage 17 C7-2: the BYTES are `lib/intern.nuc`'s, not a second table's. This
; file keeps only the Symbol -> canonical-Node map, which is what the `Node*`
; identity above actually needs; the probe is a pointer compare on the interned
; bytes rather than a `strcmp`, and the hash is the one the interner cached.
; Two tables over the same names would defeat both identities at once.

; The key is the `Symbol` itself, not its bytes pointer: one word either way,
; but the interner's identity, `=`, cached hash and `symbol-none?` all come with
; it, where the bare pointer had to be cast back into a Symbol to be hashed.
(defstruct InternEntry
  spelling:Symbol
  node:ref:Node)  ; valid whenever spelling is not symbol-none (occupied entry)

(defvar g-intern-table:ptr)
(defvar g-intern-cap:i32 0)
(defvar g-intern-len:i32 0)

(defn sym-node-place (table:ptr cap:i32 sp:Symbol nd:ref:Node h:i64):void
  (let (mask:i64 (as i64 (- cap 1))
        j:i64 (bit-and h mask))
    (while (!= 0 1)
      (let (e:ptr:InternEntry (as ptr:InternEntry
                                    (unsafe/ptr+ (as ptr:InternEntry table) (unsafe/cast i32 j))))
        (when (symbol-none? (e 'spelling))
          (set! (e 'spelling) sp)
          (set! (e 'node) nd)
          (return)))
      (set! j (bit-and (+ j 1) mask)))))

(defn sym-node-grow ():void
  (let (old-cap:i32 g-intern-cap
        old-table:ptr g-intern-table
        new-cap:i32 (* g-intern-cap 2)
        new-table:ptr (arena-alloc (* (as i64 new-cap)
                                      (sizeof InternEntry))))
    (set! g-intern-cap new-cap)
    (set! g-intern-table new-table)
    (let (i:i32 0)
      (while (< i old-cap)
        (let (e:ptr:InternEntry (as ptr:InternEntry
                                      (unsafe/ptr+ (as ptr:InternEntry old-table) i)))
          (when (not (symbol-none? (e 'spelling)))
            (sym-node-place new-table new-cap (e 'spelling) (e 'node)
                            (unsafe/cast i64 (symbol-cached-hash (e 'spelling))))))
        (inc! i)))))

(defn intern-node (sym:Symbol):ref:Node
  (when (= g-intern-cap 0)
    (set! g-intern-cap 1024)
    (set! g-intern-table (arena-alloc (* (as i64 g-intern-cap)
                                         (sizeof InternEntry)))))
  (when (>= (* g-intern-len 2) g-intern-cap)
    (sym-node-grow))
  (let (mask:i64 (as i64 (- g-intern-cap 1))
        j:i64 (bit-and (unsafe/cast i64 (symbol-cached-hash sym)) mask))
    (while (!= 0 1)
      (let (e:ptr:InternEntry (as ptr:InternEntry
                                    (unsafe/ptr+ (as ptr:InternEntry g-intern-table) (unsafe/cast i32 j))))
        (when (symbol-none? (e 'spelling))
          (let (nd:ref:Node (alloc-node))
            (set! (nd 'kind) NODE-SYM)
            (set! (nd 'line) 0)
            (set! (nd 's) sym)
            (set! (e 'spelling) sym)
            (set! (e 'node) nd)
            (inc! g-intern-len)
            (return nd)))
        (when (= (e 'spelling) sym)
          (return (e 'node))))
      (set! j (bit-and (+ j 1) mask)))))

; The ONLY caller is the `'foo` lowering, which emits `call ptr @intern-symbol`
; with a C string constant — this is that lowering's ABI, not a source-level API.
; Nucleus source interns through `(intern-node (symbol-intern …))`.
(defn intern-symbol (s:CStr):ref:Node
  (return (intern-node (symbol-from-cstr s))))

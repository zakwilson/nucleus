; .nuch header for lib/char.nuc
(defstruct DecodeResult (ch Char) (nbytes usize) (ok i32))
(declare char-utf8-len ((c Char)) :usize)
(declare char-encode-utf8 ((c Char) (buf (ptr ui8))) :usize)
(declare decode-err () :DecodeResult)
(declare char-decode-utf8 ((p (ptr ui8)) (len usize)) :DecodeResult)
(declare char-to-u32 ((c Char)) :ui32)
(declare char-from-u32 ((n ui32)) :!Char)
(declare char-is-ascii ((c Char)) :i32)
(declare char-is-digit ((c Char)) :i32)
(declare char-is-alpha ((c Char)) :i32)
(declare char-is-alnum ((c Char)) :i32)
(declare char-is-whitespace ((c Char)) :i32)
(declare char-ascii-upper ((c Char)) :Char)
(declare char-ascii-lower ((c Char)) :Char)

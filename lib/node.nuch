(defstruct InternEntry (spelling ptr) (node (ref Node)))
(extern (g-intern-table ptr))
(extern (g-intern-cap i32))
(extern (g-intern-len i32))
(declare intern-hash ((s ptr)) :i64)
(declare intern-raw-insert ((table ptr) (cap i32) (sp ptr) (nd (ref Node))) :void)
(declare intern-grow () :void)
(declare intern-symbol ((s ptr)) :ref:Node)
(declare node-at ((n ptr) (i i32)) :?ptr:Node)
(declare node-len ((n ptr)) :i32)
(declare node-line ((n ptr) (encl i32)) :i32)
(declare node-is-list ((n ptr)) :i32)
(defconst NODE-NIL -1)
(declare node-kind ((n ptr)) :i32)

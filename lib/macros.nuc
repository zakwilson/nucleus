; Standard macro library for Nucleus.
;
; These macros require defmacro and quasiquote support (stage-2 compiler).
; They are pulled in automatically by the prelude; a file may also bring them
; in explicitly with (import-use macros).

; (macfoldr op unit a b c) => (op a (op b c))   [right-nested]
; (macfoldl op unit a b c) => (op (op a b) c)   [left-nested]
;   no args  => unit;  one arg => that arg, untouched.
;
; The generalisation of the six variadic operators below, and the way to make a
; new one variadic without copying their shape. `op` is spliced into head
; position, so it may be any callable spelling — a primitive, a function, or
; another macro.
;
; `cond` only, no `if`/`when`: these are the first macros in the file, so nothing
; defined below them is callable from these bodies yet, and `cond` is a special
; form. Same reason the `case` macro further down says so.
(defmacro macfoldr (op unit :rest args)
  (let (n:i32 (ast-len args))
    (cond (= n 0)
            unit
          true
            (let ((acc (raw Node)) (ast-at args (_- n 1))
                  i:i32 (_- n 1))
              (while (!= i 0)
                (set! i (_- i 1))
                (set! acc `(~op ~(ast-at args i) ~acc)))
              acc))))

(defmacro macfoldl (op unit :rest args)
  (let (n:i32 (ast-len args))
    (cond (= n 0)
            unit
          true
            (let ((acc (raw Node)) (ast-at args 0)
                  i:i32 1)
              (while (< i n)
                (set! acc `(~op ~acc ~(ast-at args i)))
                (set! i (_+ i 1)))
              acc))))

; variadic math
;   (+)            => 0
;   (+ x)          => x
;   (+ x y)        => (_+ x y)
;   (+ x y z ...)  => (_+ x (_+ y z ...))  [right-fold; associative]
;
; The 0/1/2-ary arms are spelled out rather than left to `macfoldr` so that the
; overwhelmingly common binary call costs one expansion and not two: 94% of the
; 3,103 operator call sites in this tree are binary
; (design/stage20-macros/overview.md §3.1).
(defmacro + (:rest args)
  (cond (= (ast-len args) 0)  `0
        (= (ast-len args) 1)  (ast-at args 0)
        (= (ast-len args) 2)  `(_+ ~(ast-at args 0) ~(ast-at args 1))
        true                  `(macfoldr _+ 0 ~@args)))

(defmacro * (:rest args)
  (cond (= (ast-len args) 0)  `1
        (= (ast-len args) 1)  (ast-at args 0)
        (= (ast-len args) 2)  `(_* ~(ast-at args 0) ~(ast-at args 1))
        true                  `(macfoldr _* 1 ~@args)))

; Subtraction: unary negates; n-ary left-folds (matches Common Lisp).
(defmacro - (:rest args)
  (cond (= (ast-len args) 0)  `0
        (= (ast-len args) 1)  `(_- 0 ~(ast-at args 0))
        (= (ast-len args) 2)  `(_- ~(ast-at args 0) ~(ast-at args 1))
        true                  `(macfoldl _- 0 ~@args)))

; Division: unary is reciprocal (integer: 1/x); n-ary left-folds.
(defmacro / (:rest args)
  (cond (= (ast-len args) 0)  `1
        (= (ast-len args) 1)  `(_/ 1 ~(ast-at args 0))
        (= (ast-len args) 2)  `(_/ ~(ast-at args 0) ~(ast-at args 1))
        true                  `(macfoldl _/ 1 ~@args)))

; variadic logic
;   (and)         => true
;   (and x)       => x
;   (and x y z..) => (_and x (_and y z..))  [right-fold; short-circuits]
(defmacro and (:rest args)
  (cond (= (ast-len args) 0)  `true
        (= (ast-len args) 1)  (ast-at args 0)
        (= (ast-len args) 2)  `(_and ~(ast-at args 0) ~(ast-at args 1))
        true                  `(macfoldr _and true ~@args)))

(defmacro or (:rest args)
  (cond (= (ast-len args) 0)  `false
        (= (ast-len args) 1)  (ast-at args 0)
        (= (ast-len args) 2)  `(_or ~(ast-at args 0) ~(ast-at args 1))
        true                  `(macfoldr _or false ~@args)))

(defmacro bit-not (x)
  `(bit-xor ~x -1))

; (if test then else) — binary conditional over cond.
(defmacro if (test then else)
  `(cond ~test ~then true ~else))

; (case form v1 r1 v2 r2 ... default) — multi-way equality dispatch.
; Compares `form` (with =) against each value vi in turn and yields the result
; ri of the first match. A final unpaired argument is the required default, used
; when nothing matches. Expands to a cond:
;   (case x a ra b rb d) => (cond (= x a) ra (= x b) rb true d)
; A value may instead be (:or v ...), matching any one of the listed values:
;   (case x (:or a b) r d) => (cond (or (= x a) (= x b)) r true d)
; The keyword head is what marks the list, so an ordinary parenthesised value
; stays a call — see design/stage16-ergonomics/case-alternatives.md. An empty
; (:or) is false, matching the file's other variadics.
; Because = is overloadable, case works over any type with an equality (ints,
; enum constants, symbols, C strings). `form` is re-evaluated per comparison, so
; it should be a pure, side-effect-free expression.
(defmacro case (form :rest clauses)
  (let ((acc (raw Node)) null
        i:i32 0
        n:i32 (ast-len clauses))
    (while (< i n)
      (if (= i (- n 1))
        ; Lone trailing element: the default arm.
        (do
          (set! acc `(~@acc true ~(ast-at clauses i)))
          (set! i n))
        ; A value/result pair.
        (do
          (let ((val (raw Node)) (ast-at clauses i)
                alt-list:i32 0)
            ; `when` is defined below this macro, so it is not yet callable
            ; from this body; `cond` is a special form and always is.
            (let ((head (raw Node)) (ast-first val))
              (cond (and (!= head null)
                         (= (head 'kind) NODE-KEYWORD)
                         ; Reaching through `Symbol.p` because the prelude
                         ; cannot import `lib/intern.nuc`, where `=` on two
                         ; `Symbol`s lives. One byte table, so this is the
                         ; identity compare that overload would do.
                         (= (as ptr ((head 's) 'p)) (as ptr (('or 's) 'p))))
                      (set! alt-list 1)))
            (let ((test (raw Node)) null)
              (if (!= alt-list 0)
                (let ((tests (raw Node)) null
                      k:i32 1
                      m:i32 (ast-len val))
                  (while (< k m)
                    (set! tests `(~@tests (= ~form ~(ast-at val k))))
                    (set! k (+ k 1)))
                  (set! test `(or ~@tests)))
                (set! test `(= ~form ~val)))
              (set! acc `(~@acc ~test ~(ast-at clauses (+ i 1))))))
          (set! i (+ i 2)))))
    `(cond ~@acc)))

; (when condition body) — one-armed conditional; body only if condition is true.
; For multiple body forms, wrap them in (do ...).
(defmacro when (condition :rest body)
  `(cond ~condition (do ~@body)))

; (unless condition body) — one-armed conditional; body only if condition is false.
; For multiple body forms, wrap them in (do ...).
(defmacro unless (condition :rest body)
  `(cond (not ~condition) (do ~@body)))

; (zero? x) — true if x equals 0.
(defmacro zero? (x)
  `(= ~x 0))

; (null? x) — true if x equals null.
(defmacro null? (x)
  `(= ~x null))

; (for (var:type init) test step body) — counted loop.
; Expands to (let (var:type init) (while test body step)).
; var:type appears as the let binding name (type annotation required).
; The step expression is placed after body so break-via-return is natural.
; Example: (for (i:i32 0) (< i:i32 n) (inc! i:i32) (foo i:i32))
(defmacro for (init test step body)
  `(let ~init
     (while ~test
       ~body
       ~step)))

; (dotimes (var:type n) body) — loop from 0 to n-1.
; var:type is the loop variable with type annotation; n is the upper bound.
; Expands to a for loop initialised to 0, incrementing by 1 each iteration.
; Example: (dotimes (i:i32 n) (process (node-at items i:i32)))
; `ast-at` is a compiler special form, so this macro works even in programs that
; have not imported the node runtime.
(defmacro dotimes (spec :rest body)
  (let ((var-node (raw Node)) (ast-at spec 0)
        (n-node (raw Node)) (ast-at spec 1))
    `(let (~var-node (* ~n-node 0)) ; adopt the count's type for the index
       (while (< ~var-node ~n-node)
         (do ~@body)
         (inc! ~var-node)))))

; (doseq (var coll-expr IterType) body...) — iterate any Coll, binding var to
; each element.
;
; coll-expr is a COLLECTION (a (ref (Vector T)) / (ref (HashSet T)) / (ref
; (HashMap K V)) / …); IterType is its associated iterator type — the It in
; (Coll E It) — e.g. (VecIter i32), (HashSetIter i32), (HashMapEntryIter K V).
; `doseq` calls the protocol `iter` to get a fresh iterator BY VALUE, binds it
; to a typed local, then drives it via (next &it) — the value-return +
; `&` convention (C2.1, design/stage11/cleanup2.md). It dispatches
; generically over any (Coll E It).
;
; Why IterType must be named: the language has no type inference for `let`
; bindings (every binding needs an explicit type) and `&` only takes the
; address of a named local (not an rvalue), so the value-returned iterator must
; live in a typed binding we can address. The binding's THIRD element supplies
; that type; the macro emits `(let (it:IterType (iter coll)) …)`.
;
; Expands to a while loop with a done-flag so it composes safely in any context.
; No `return` or `break` inside the expansion — works in any expression context.
;
; For a bare iterator REFERENCE (a pure Iterator that is not a Coll — e.g.
; IntRangeIter / MapIter / FilterIter / HashMapKeyIter), use `doseq-iter`.
;
; Example:
;   (with ((v (ref (Vector i32))) (alloca (Vector i32)))
;     (vector-init v) (conj v 1) (conj v 2)
;     (doseq (x v (VecIter i32)) (printf "%d\n" x)))
(defmacro doseq (binding :rest body)
  ; binding is (var coll-expr IterType). (iter coll-expr) yields an IterType
  ; value bound to a fresh typed local `it`; drive (next &it) per step.
  ; The (sym type) list-binding form lets the done-flag gensym skip a colon type.
  (let (done-sym:ptr  (gensym)
        it-sym:ptr    (gensym)
        var-sym:ptr   (ast-at binding 0)
        coll-expr:ptr (ast-at binding 1)
        it-type:ptr   (ast-at binding 2))
    `(let ((~it-sym ~it-type) (iter ~coll-expr))
       (let ((~done-sym i32) 0)
         (while (= ~done-sym 0)
           (match (next &~it-sym)
             ((some ~var-sym) (do ~@body))
             (none (set! ~done-sym 1))))))))

; (doseq-iter (var iter-ref) body...) — iterate a bare iterator REFERENCE.
;
; iter-ref is a (ref Iterator) symbol (the iterator already materialised by the
; caller). Advances it each loop step via (next iter-ref), binding the element
; to var. This is the pre-Coll form, kept for pure iterators (IntRangeIter,
; MapIter, FilterIter, the single-projection map iterators) that have no `iter`.
;
; Example:
;   (let ((r (ref IntRangeIter)) (alloca IntRangeIter))
;     (set! (r 'start) 0) (set! (r 'end) 5)
;     (doseq-iter (x r) (printf "%d\n" x)))
(defmacro doseq-iter (binding :rest body)
  (let (done-sym:ptr  (gensym)
        var-sym:ptr   (ast-at binding 0)
        iter-ref:ptr  (ast-at binding 1))
    `(let ((~done-sym i32) 0)
       (while (= ~done-sym 0)
         (match (next ~iter-ref)
           ((some ~var-sym) (do ~@body))
           (none (set! ~done-sym 1)))))))

; (into dest-coll src-coll IterType) — materialize one Coll into another.
;
; dest-coll is a (ref Collection) already declared and initialised; src-coll is
; any (Coll E It) and IterType is its associated iterator type (the It). `into`
; calls the protocol `iter` on src-coll and folds every element into dest-coll
; via (conj dest-coll elem). Dispatches generically over any source Coll (C2.1).
; Requires dest-coll to implement `conj` over E. IterType is named for the same
; reason as in `doseq` (no let-binding inference; `&` needs a named local).
;
; Example:
;   (into dest src (VecIter i32))   ; copy every element of src into dest
(defmacro into (coll-sym src-coll it-type)
  (let (done-sym:ptr (gensym)
        it-sym:ptr   (gensym)
        x-sym:ptr    (gensym))
    `(let ((~it-sym ~it-type) (iter ~src-coll))
       (let ((~done-sym i32) 0)
         (while (= ~done-sym 0)
           (match (next &~it-sym)
             ((some ~x-sym) (conj ~coll-sym ~x-sym))
             (none (set! ~done-sym 1))))))))

; (into-iter dest-coll iter-ref) — materialize a bare iterator ref into a Coll.
;
; dest-coll is a (ref Collection) already declared and initialised; iter-ref is
; a (ref Iterator) symbol. Each element is appended via (conj dest-coll elem).
; The pre-Coll form, kept for pure iterators that have no `iter`.
(defmacro into-iter (coll-sym iter-ref)
  (let (done-sym:ptr (gensym)
        x-sym:ptr    (gensym))
    `(let ((~done-sym i32) 0)
       (while (= ~done-sym 0)
         (match (next ~iter-ref)
           ((some ~x-sym) (conj ~coll-sym ~x-sym))
           (none (set! ~done-sym 1)))))))

; (-> x form ...) — threading macro with _ placeholder.
; Threads x through each form. If a form contains _, the threaded value
; replaces _ at that position. If no _ is present, the value is inserted
; as the first argument (thread-first). Bare symbols wrap as (form value).
; _ is only special inside ->; it is an ordinary symbol elsewhere.
;
; Examples:
;   (-> x (f a b) (g c))       expands to (g (f x a b) c)       [no _, thread-first]
;   (-> x (f _ a) (g b _ c))   expands to (g b (f x a) c)       [_ placement]
;   (-> x f g)                 expands to (g (f x))              [bare symbols]
;   (-> x)                     expands to x                      [identity]
(defmacro -> (x :rest forms)
  (let ((result (raw Node)) x
        i:i32 0
        nforms:i32 (ast-len forms))
    (while (< i nforms)
      (let ((form (raw Node)) (ast-at forms i)
            n:i32 (ast-len form))
        (if (= (form 'kind) NODE-LIST)
          (do
            ; Scan the whole form (head + args) for the _ placeholder. Scanning
            ; the head lets a threaded value land in call position, e.g.
            ; (-> s (_ field)) => (s field) — head-position member access.
            (let (has-placeholder:i32 0
                  k:i32 0)
              (while (< k n)
                ; `_` is reader-interned, so identity IS the spelling test —
                ; and the prelude cannot call `symbol-is`, which is a library.
                (when (= (ast-at form k) '_)
                  (set! has-placeholder 1))
                (set! k (+ k 1)))
              (if (!= has-placeholder 0)
                ; Has _: rebuild the form, substituting result for each _.
                (let ((out (raw Node)) null
                      j:i32 0)
                  (while (< j n)
                    (let ((elem (raw Node)) (ast-at form j)
                          replacement:ptr elem)
                      (when (= elem '_)
                        (set! replacement result))
                      (set! out `(~@out ~replacement)))
                    (set! j (+ j 1)))
                  (set! result out))
                ; No _: thread-first (insert after head).
                (let (head:ptr (ast-first form)
                      tail:ptr (ast-rest form))
                  (set! result `(~head ~result ~@tail))))))
          (set! result `(~form ~result))))
      (set! i (+ i 1)))
    result))

; (macmap ((param ...) template) (row ...)) — expand one template once per row
; of a literal table and splice the results in sequence.
;
;   (macmap ((tok) `(when (!= (text-token-is text start e ~tok) 0) (return 1)))
;     ("defn" "defmacro" "defvar" "defconst"))
;
; A one-parameter template takes each row WHOLE, so a row may be any expression;
; a multi-parameter one destructures the row, which must then be a list of that
; many elements.
;
;   (macmap ((res ret) `(when (= test ~res) (return ~ret)))
;     (((+ 2 2) "four!") ("dammit" "curses!") (null 0)))
;
; Lowered to a gensym'd `macrolet` plus one application per row, so nothing here
; walks the template: the existing macro machinery compiles it, and its line
; numbers, its diagnostics and its `gensym` are whatever `macrolet` already
; gives. design/stage20-macros/overview.md §2.1.
;
; `ast-at`/`ast-len` rather than `node-at`/`node-len`: the prelude registers the
; Node TYPE but imports no node runtime, so a signature from lib/node.nuc is not
; in scope here even though the JIT'd body could resolve one.
;
; The binding is the fixed name `__macmap`, not a `gensym`: gensym'd names are
; numbered from one global counter, so a gensym here renumbers every `__gs_N` in
; every function emitted after it and no macrolet-to-macmap migration could be
; byte-identical. A fixed name is safe because the only forms inside the body
; are the applications built below, an inner `macrolet` shadows an outer binding
; of the same name and restores it on pop, and `__` is reserved.
(defmacro macmap (spec rows)
  ; Order matters: `or` short-circuits, and member access on a null (raw Node)
  ; dereferences — it would segfault the COMPILER, at expansion time, before any
  ; diagnostic could be raised. Every chain below is reached only past its guard.
  (when (or (= spec null)
            (!= (spec 'kind) NODE-LIST)
            (< (ast-len spec) 2))
    (macro-error (if (= spec null) rows spec)
      "macmap: the first argument must be ((param ...) template)"))
  (let ((params (raw Node)) (ast-at spec 0)
        (tmpl (raw Node))   (ast-at spec 1)
        ntotal:i32          0
        nfixed:i32          0
        variadic:i32        0
        calls:ptr           null)
    ; Two counts, not one. `ntotal` decides the whole-row rule below; `nfixed`
    ; and `variadic` decide how long a row may be, since `:rest` lets it run
    ; longer. The keyword test reaches through `Symbol.p` for the same reason
    ; `case` does — the prelude cannot import `lib/intern.nuc`, where `=` on two
    ; Symbols lives, and one byte table makes identity the same question.
    (let (pi:i32 0
          np:i32 (ast-len params))
      (while (< pi np)
        (let ((e (raw Node)) (ast-at params pi))
          (when (and (!= e null) (= (e 'kind) NODE-KEYWORD)
                     (= (as ptr ((e 's) 'p)) (as ptr (('rest 's) 'p))))
            (set! variadic 1))
          (when (= variadic 0) (set! nfixed (+ nfixed 1))))
        (set! ntotal (+ ntotal 1))
        (set! pi (+ pi 1))))
    (let (ri:i32 0
          nrows:i32 (ast-len rows))
      (while (< ri nrows)
        (let ((r (raw Node)) (ast-at rows ri))
          (if (= ntotal 1)
            (set! calls `(~@calls (__macmap ~r)))
            (do
              (when (or (= r null) (!= (r 'kind) NODE-LIST))
                (macro-error rows
                  "macmap: a row must be a list, one element per template parameter"))
              (let (n:i32 (ast-len r))
                (when (if (= variadic 0) (!= n ntotal) (< n nfixed))
                  (macro-error r
                    "macmap: this row's length does not match the template's parameter list")))
              (set! calls `(~@calls (__macmap ~@r))))))
        (set! ri (+ ri 1))))
    ; An empty table is `(do)`, not a `macrolet` with an empty body: the lowering
    ; may not surface as a diagnostic about a form the caller never wrote.
    (if (= calls null)
      `(do)
      `(macrolet ((__macmap ~params ~tmpl)) ~@calls))))


; .nuch header for lib/intern-str.nuc
(extend Symbol Eq)
(extend Symbol Hash)
(declare hash ((self (ref Symbol))) :usize)
(extend Symbol ToStr)
(declare to-str ((self Symbol) (out (ref String))) :!void)
(extend Symbol (ByteStr ByteIter))
(declare byte-len ((self (ref Symbol))) :usize)
(declare byte-at ((self (ref Symbol)) (i usize)) :!ui8)
(declare bytes ((self (ref Symbol))) :ByteIter)
(declare as-view ((self (ref Symbol))) :StrView)
(declare sub-bytes ((self (ref Symbol)) (start usize) (end usize)) :!StrView)
(declare byte-find ((self (ref Symbol)) (needle (ref StrView))) :?usize)
(extend Symbol (Str CharIter))
(declare char-count ((self (ref Symbol))) :usize)
(declare str-empty? ((self (ref Symbol))) :bool)
(declare char-at ((self (ref Symbol)) (i usize)) :!Char)
(declare chars ((self (ref Symbol))) :CharIter)
(declare starts-with? ((self (ref Symbol)) (prefix (ref StrView))) :bool)
(declare ends-with? ((self (ref Symbol)) (suffix (ref StrView))) :bool)
(declare contains-str? ((self (ref Symbol)) (needle (ref StrView))) :bool)

; .nuch header for lib/error.nuc
(deferror unhandled-error "unhandled error")
(defmacro try (r) (let (v:ptr (gensym) e:ptr (gensym)) (quasiquote (match (unquote r) ((ok (unquote v)) (unquote v)) ((err (unquote e)) (return (err! (unquote e))))))))
(defstruct Handler (what Err) (rty ptr) (hfn ptr) (ctx ptr) (prev ptr))
(extern (g-handler-top ptr))
(declare err-find-handler ((eid Err) (token ptr)) :ptr)
(defmacro with-handler (spec &rest body) (let (h:ptr (gensym)) (quasiquote (let (((unquote h) (ptr Handler)) (alloca Handler)) (.set! (unquote h) what (unquote (node-at spec 0))) (.set! (unquote h) rty (type-token (unquote (node-at spec 1)))) (.set! (unquote h) hfn (unsafe/cast ptr (unquote (node-at spec 2)))) (.set! (unquote h) ctx (unquote (node-at spec 3))) (.set! (unquote h) prev g-handler-top) (set! g-handler-top (as ptr (unquote h))) (defer (set! g-handler-top ((unquote h) prev))) (unquote-splice body)))))

; Stage 13 functional refactor — R1: the eager *consuming* combinators.
;
; Design: design/stage13/functional-refactor.md §"R1 — Eager combinator library".
;
; Every combinator here mirrors `reduce` (lib/iterator.nuc): it is generic, driven
; over a bare `(Iterator E)` reference, and takes its closure operand typed
; `(name (ref Tyvar))` so the operand may be an inline closure, a CE-1 named
; closure, or a hand-written conformer — conformance is type-keyed, never literal.
;
; A `(Coll E It)` is reached the same way `reduce` reaches one: materialise its
; iterator with `(iter coll)`, bind it to a typed local, and pass `&it`.
;
; ELEMENT-TYPE CONVENTION (carried from R1-iter): the pointer/struct iterators
; (ListIter / SplitIter / LineIter) yield each element as `ptr` (niche-encoded
; Maybe ptr is matchable). The caller recovers the real value with
; `(cast ptr:T e)`. Scalar iterators (VecIter i32 / ByteIter / CharIter /
; IntRangeIter) bind S to their real scalar element type directly.
;
; OWNING RETURNS: `map`/`filter`/`remove-if`/`flat-map`/`join` build and RETURN a
; fresh owning value (a `(Vector E)` or a `String`) by value. The caller owns the
; result and must `(drop &result)` exactly once — the same discipline a
; returned `BoxedFn` follows. A `let`-bound result is NOT auto-dropped (only
; `with` bindings are), so the explicit drop is the contract.

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use "string.h")          ; strlen, for join
(import-use allocator)           ; BoxedFn boxing (the closure-returning combinators)
(import-use iterator)            ; Iterator/UnaryFn/FoldFn protocols + reduce
(import-use numeric)             ; Ord (constantly's value-type bound)
(import-use strview)             ; StrView (string.nuc's !String fns reference it)
(import-use vector)              ; Vector / VecIter / conj / count / iter
(import-use string)              ; String / string-new / string-push-bytes-raw

; ---------------------------------------------------------------------------
; BinaryFn A R — a binary function object `(A, A) -> R`. This is the comparator
; shape `sort` needs; the existing recognised set `{UnaryFn, FoldFn}` does not
; cover a same-typed-args predicate, so `derive-closure-conformance` (src/
; generics.nuc) is extended to recognise this third protocol. The extension is
; inert under self-compilation (the compiler never stamps a BinaryFn), so the
; bootstrap stays a byte-identical fixed point.
; ---------------------------------------------------------------------------
(defprotocol (BinaryFn A R)
  (apply2 (self:&Self (x A) (y A)) R))

; ===========================================================================
; Transformations
; ===========================================================================

; map — apply g to every element, collecting the results into a new (Vector E).
; g : (UnaryFn S E). Returns the new Vector by value (caller drops it).
(defn map (g:&G it:&I
                        :where ((Iterator S) I)
                               ((UnaryFn S E) G)) (Vector E)
  (let (out:&(Vector E) (alloca (Vector E)))
    (vector-init out)
    (let (done:i32 0)
      (while (= done 0)
        (match (next it)
          ((some v) (conj out (apply g v)))
          (none (set! done 1)))))
    (return @out)))

; filter — keep every element for which pred answers true, into a new (Vector S).
; pred : (UnaryFn S bool). Returns the new Vector by value (caller drops it).
(defn filter (pred:&P it:&I
                           :where ((Iterator S) I)
                                  ((UnaryFn S bool) P)) (Vector S)
  (let (out:&(Vector S) (alloca (Vector S)))
    (vector-init out)
    (let (done:i32 0)
      (while (= done 0)
        (match (next it)
          ((some v) (when (apply pred v) (conj out v)))
          (none (set! done 1)))))
    (return @out)))

; remove-if — the complement of filter: keep every element for which pred is
; FALSE. pred : (UnaryFn S bool). Returns a new (Vector S) by value.
(defn remove-if (pred:&P it:&I
                              :where ((Iterator S) I)
                                     ((UnaryFn S bool) P)) (Vector S)
  (let (out:&(Vector S) (alloca (Vector S)))
    (vector-init out)
    (let (done:i32 0)
      (while (= done 0)
        (match (next it)
          ((some v) (when (not (apply pred v)) (conj out v)))
          (none (set! done 1)))))
    (return @out)))

; for-each — apply f to every element for side effects, discarding each result.
; f : (UnaryFn S R) for any R. Returns void.
(defn for-each (f:&F it:&I
                     :where ((Iterator S) I)
                            ((UnaryFn S R) F)):void
  (let (done:i32 0)
    (while (= done 0)
      (match (next it)
        ((some v) (apply f v))
        (none (set! done 1))))))

; flat-map — apply g to each element, where g maps S to ANY owning collection
; R = (Coll E It); concatenate every element of every produced collection into one
; new (Vector E). The inner collection type R, its element E, and its iterator It
; are recovered from g's conformance: R from g's (UnaryFn S R) result, then E/It
; from R's (Coll E It) conformance. Each intermediate collection is owning and is
; dropped after its elements are copied out. Returns the new Vector by value
; (caller drops it). E must be a matchable scalar (it rides It).
(defn flat-map (g:&G it:&I
                             :where ((Iterator S) I)
                                    ((UnaryFn S R) G)
                                    ((Coll E It) R)
                                    ((Iterator E) It)) (Vector E)
  (let (out:&(Vector E) (alloca (Vector E)))
    (vector-init out)
    (let (done:i32 0)
      (while (= done 0)
        (match (next it)
          ((some v)
           (let ((inner R) (apply g v))
             (let ((iit It) (iter &inner))
               (let (idone:i32 0)
                 (while (= idone 0)
                   (match (next &iit)
                     ((some e) (conj out e))
                     (none (set! idone 1))))))
             (drop &inner)))
          (none (set! done 1)))))
    (return @out)))

; ===========================================================================
; Search (early-stopping)
; ===========================================================================

; find — the first element for which pred answers true, or none. Stops early.
; pred : (UnaryFn S bool). Returns (Maybe S) (S must be a matchable scalar).
(defn find (pred:&P it:&I
                        :where ((Iterator S) I)
                               ((UnaryFn S bool) P)) (Maybe S)
  (let (done:i32 0)
    (while (= done 0)
      (match (next it)
        ((some v) (when (apply pred v) (return (some v))))
        (none (set! done 1)))))
  (return none))

; find-index — the index of the first element for which pred answers true, or -1.
; Stops early. pred : (UnaryFn S bool). The -1 sentinel keeps the result i32.
(defn find-index (pred:&P it:&I
                      :where ((Iterator S) I)
                             ((UnaryFn S bool) P)):i32
  (let (idx:i32 0
        done:i32 0)
    (while (= done 0)
      (match (next it)
        ((some v)
         (when (apply pred v) (return idx))
         (set! idx (+ idx 1)))
        (none (set! done 1)))))
  (return -1))

; ===========================================================================
; Quantifiers. These are GENERIC (they carry :where), so their monomorphised
; names route through `sanitize-for-ir` (`?` -> `_`) and never emit a bare
; `@any?`/`@every?` that LLVM would reject — exactly like `reduce`.
; ===========================================================================

; any? — true if pred holds for any element. Stops early on the first such
; element. pred : (UnaryFn S bool).
(defn any? (pred:&P it:&I
                :where ((Iterator S) I)
                       ((UnaryFn S bool) P)):bool
  (let (done:i32 0)
    (while (= done 0)
      (match (next it)
        ((some v) (when (apply pred v) (return true)))
        (none (set! done 1)))))
  (return false))

; exists? — alias of any?.
(defn exists? (pred:&P it:&I
                   :where ((Iterator S) I)
                          ((UnaryFn S bool) P)):bool
  (return (any? pred it)))

; every? — true if pred holds for every element (vacuously true for empty).
; Stops early on the first FALSE element. pred : (UnaryFn S bool).
(defn every? (pred:&P it:&I
                  :where ((Iterator S) I)
                         ((UnaryFn S bool) P)):bool
  (let (done:i32 0)
    (while (= done 0)
      (match (next it)
        ((some v) (when (not (apply pred v)) (return false)))
        (none (set! done 1)))))
  (return true))

; all? — alias of every?.
(defn all? (pred:&P it:&I
                :where ((Iterator S) I)
                       ((UnaryFn S bool) P)):bool
  (return (every? pred it)))

; count-if — how many elements satisfy pred. Visits every element (a count
; cannot stop early). Named `count-if` (not `count`) so it does not overload the
; `(Coll E It)` `count` method. pred : (UnaryFn S bool); the result is a count,
; so it stays i32.
(defn count-if (pred:&P it:&I
                    :where ((Iterator S) I)
                           ((UnaryFn S bool) P)):i32
  (let (n:i32 0
        done:i32 0)
    (while (= done 0)
      (match (next it)
        ((some v) (when (apply pred v) (set! n (+ n 1))))
        (none (set! done 1))))
    (return n)))

; ===========================================================================
; Folds
; ===========================================================================

; foldr — a right fold. `reduce` is the left fold; foldr combines elements in
; reverse order: foldr g init [a b c] = g(g(g(init,c),b),a). Because the source
; iterator is forward-only, the elements are first collected into a scratch
; Vector, then folded from the back. g : (FoldFn Acc S). S must be a matchable
; scalar (it rides a VecIter S).
(defn foldr (g:&G (init Acc) it:&I
                 :where ((Iterator S) I)
                        ((FoldFn Acc S) G)):Acc
  (let (buf:&(Vector S) (alloca (Vector S)))
    (vector-init buf)
    (let (done:i32 0)
      (while (= done 0)
        (match (next it)
          ((some v) (conj buf v))
          (none (set! done 1)))))
    (let (acc:Acc init
          n:usize (count buf)
          i:i64 (- (as i64 n) 1))
      (while (>= i 0)
        (set! acc (fold g acc (buf (as usize i))))
        (set! i (- i 1)))
      (drop buf)
      (return acc))))

; sum — add every element, seeded at 0. S must be a numeric scalar.
(defn sum (it:&I :where ((Iterator S) I)):S
  (let (acc:S (as S 0)
        done:i32 0)
    (while (= done 0)
      (match (next it)
        ((some v) (set! acc (+ acc v)))
        (none (set! done 1))))
    (return acc)))

; product — multiply every element, seeded at 1. S must be a numeric scalar.
(defn product (it:&I :where ((Iterator S) I)):S
  (let (acc:S (as S 1)
        done:i32 0)
    (while (= done 0)
      (match (next it)
        ((some v) (set! acc (* acc v)))
        (none (set! done 1))))
    (return acc)))

; min — the least element (by `<`), or 0 for an empty sequence. S scalar.
(defn min (it:&I :where ((Iterator S) I)):S
  (let (acc:S (as S 0)
        seen:i32 0
        done:i32 0)
    (while (= done 0)
      (match (next it)
        ((some v)
         (if (= seen 0)
           (do (set! acc v) (set! seen 1))
           (when (< v acc) (set! acc v))))
        (none (set! done 1))))
    (return acc)))

; max — the greatest element (by `<`), or 0 for an empty sequence. S scalar.
(defn max (it:&I :where ((Iterator S) I)):S
  (let (acc:S (as S 0)
        seen:i32 0
        done:i32 0)
    (while (= done 0)
      (match (next it)
        ((some v)
         (if (= seen 0)
           (do (set! acc v) (set! seen 1))
           (when (< acc v) (set! acc v))))
        (none (set! done 1))))
    (return acc)))

; ===========================================================================
; Ordering (in-place on a Vector)
; ===========================================================================

; sort — in-place ascending insertion sort using a binary "less" comparator.
; cmp : (BinaryFn T i32) — truthy when its first argument should come BEFORE its
; second. T is the Vector's element type.
(defn sort (cmp:&C v:&(Vector T)
                 :where ((BinaryFn T i32) C)):void
  (let (n:usize (count v)
        buf:&T (as &T (as ptr (_get v 'data))))
    (let (i:usize 1)
      (while (< i n)
        (let (key:T (aref buf (as i64 i))
              j:i64 (- (as i64 i) 1))
          (while (and (>= j 0) (!= (apply2 cmp key (aref buf j)) 0))
            (set! (aref buf (+ j 1)) (aref buf j))
            (set! j (- j 1)))
          (set! (aref buf (+ j 1)) key))
        (set! i (+ i 1))))))

; sort-by — in-place ascending insertion sort keyed by a projection. keyf maps
; each element to a `<`-comparable key. keyf : (UnaryFn T K).
(defn sort-by (keyf:&F v:&(Vector T)
                    :where ((UnaryFn T K) F)):void
  (let (n:usize (count v)
        buf:&T (as &T (as ptr (_get v 'data))))
    (let (i:usize 1)
      (while (< i n)
        (let (key:T (aref buf (as i64 i))
              kk:K  (apply keyf (aref buf (as i64 i)))
              j:i64 (- (as i64 i) 1))
          (while (and (>= j 0) (< kk (apply keyf (aref buf j))))
            (set! (aref buf (+ j 1)) (aref buf j))
            (set! j (- j 1)))
          (set! (aref buf (+ j 1)) key))
        (set! i (+ i 1))))))

; ===========================================================================
; Joinery — "emit each element, separated"
; ===========================================================================

; emit-joined — drive `emitf` once per element (for its side effects, e.g.
; printing), writing `sep` between consecutive elements. emitf : (UnaryFn S R)
; for any R (its result is discarded).
;
; `printf`, not `write-str`: the caller's `emitf` writes wherever it likes, and
; stdio is the only stream a separator can join without importing a Writer that
; would buffer independently of it. `%.*s` because a StrView is not NUL-terminated.
(defn emit-joined (emitf:&EF sep:StrView it:&I
                        :where ((Iterator S) I)
                               ((UnaryFn S R) EF)):void
  (let (first:i32 1
        done:i32 0)
    (while (= done 0)
      (match (next it)
        ((some v)
         (when (= first 0)
           (printf "%.*s" (unsafe/cast i32 (sep 'len)) (as ptr (sep 'data))))
         (set! first 0)
         (apply emitf v))
        (none (set! done 1))))))

; join — build a String by rendering each element with `renderf` and
; concatenating the renderings, separated by `sep`. renderf : (UnaryFn S StrView)
; (its result is borrowed only for the duration of the append). Returns the new
; String by value (caller drops it).
(defn join (renderf:&RF sep:StrView it:&I
                   :where ((Iterator S) I)
                          ((UnaryFn S StrView) RF)):String
  (let (out:String (string-new)
        first:i32 1
        done:i32 0)
    (while (= done 0)
      (match (next it)
        ((some v)
         (when (= first 0) (string-push-str-unchecked &out &sep))
         (set! first 0)
         (let (r:StrView (apply renderf v))
           (string-push-str-unchecked &out &r)))
        (none (set! done 1))))
    (return out)))

; ===========================================================================
; Implicit-progn last value
; ===========================================================================

; keep-last — apply f to every element, returning the LAST result (or `init` for
; an empty sequence). The combinator form of a loop whose value is its final
; per-iteration expression. f : (UnaryFn S R).
(defn keep-last (f:&F (init R) it:&I
                   :where ((Iterator S) I)
                          ((UnaryFn S R) F)):R
  (let (acc:R init
        done:i32 0)
    (while (= done 0)
      (match (next it)
        ((some v) (set! acc (apply f v)))
        (none (set! done 1))))
    (return acc)))

; do-last — evaluate a body for effect, yielding its final expression's value.
; Names the "implicit progn, keep the last value" idiom explicitly. (A Nucleus
; `do` already yields its last value; `do-last` is the named, intention-revealing
; spelling used when a counted/imperative loop is refactored to keep one value.)
(defmacro do-last (:rest body)
  `(do ~@body))

; ===========================================================================
; Closure-returning combinators (the storable-closure payoff — Stage 13 TE-5)
; ===========================================================================
; Higher-order combinators that PRODUCE a closure and return it by value as a
; `(BoxedFn (params…) ret)` — impossible before TE-5 (a defn could not spell a
; closure return type; the anonymous `__vfn_env_N` was unnameable). Each is
; generic over its signature so it stamps on use only, keeping the compiler boot
; byte-identical (the compiler imports no combinator and boxes nothing — verify
; no `%__fatptr`/`@__vt.*`/`@__boxedfn_drop` reached build/nucleusc.ll).
;
; OPERAND MODEL (v1 — the safe fallback per design/stage13/functional-refactor.md
; risk register): the function-typed operands are BARE `fn` pointers (non-
; capturing functions). A bare `fn` flows into a `(ref G)` operand slot, binds G
; to its TY-FN, and the returned box's env captures it as a plain function
; pointer VALUE (8 bytes, copied into the heap env) — NOT a `Drop` value. So the
; env's synthesized vtable drop slot is NULL (verified: the emitted vtable is
; `{ invoke, null }`), which means there is no transitive drop of a captured box
; and thus no nested-box leak or double-free. This is exactly the `make-adder`
; shape in examples/boxedfn.nuc (a real capturing closure boxed on return via the
; existing coercion machinery), only the captured payload is a fn pointer(s)
; rather than an int. Nesting — a `BoxedFn` operand captured by a returned
; `BoxedFn`, needing transitive drop — is deferred until the nested-box drop path
; is proven; v1 restricts operands to bare fn pointers (and, for `constantly`, a
; plain by-value scalar).
;
; Each returned box is an owning `Drop` value: the caller must drop it exactly
; once (`(drop &e)` for a let-bound box, or a `with` binding's scope-
; exit drop), following examples/boxedfn.nuc.
;
; NOTE on vfn return annotations: the closure's return type is spelled as a bare
; symbol (e.g. `(vfn (x:A) C …)`, not `(vfn (x:A):C …)`) when it is a tyvar. A
; `:Tyvar` keyword return annotation is a NODE-KEYWORD, and the generic
; monomorphizer's `subst-tyvars-node` (lib/type-mangle.nuc) only substitutes
; NODE-SYM/NODE-CELL — a keyword tyvar would survive unstamped into the nested
; closure stamping and report "unknown type". A bare-symbol return is a NODE-SYM
; and substitutes correctly. Concrete returns (`i32`) may use either spelling.
;
; NOTE on `constantly`: its value operand `v` is a flat by-value tyvar, so the
; defn's A2 abstract body check (gcheck) runs (it is skipped only when a param
; carries a nested tyvar). gcheck models closure-creating forms (vfn/fn/mfn/cfn)
; by binding their params and checking the body — without that, the vfn's param
; list would be mis-walked as a call. V is bounded by `Ord` (the most general
; recognised protocol i32/i64/CStr conform to) solely so the tyvar is collected;
; constantly performs no Ord operation, so the bound is a collection vehicle, not
; a semantic requirement on the value.
; ===========================================================================

; compose — `(compose g f)` → a box `x → (g (f x))`. g : (UnaryFn B C), f : (UnaryFn
; A B). Both operands are bare fn pointers captured by value (null env-drop slot).
(defn compose (g:&G f:&F
                                  :where ((UnaryFn B C) G)
                                         ((UnaryFn A B) F)) (BoxedFn (A) C)
  (return (vfn (x:A) C (apply g (apply f x)))))

; comp — alias of compose.
(defn comp (g:&G f:&F
                               :where ((UnaryFn B C) G)
                                      ((UnaryFn A B) F)) (BoxedFn (A) C)
  (return (compose g f)))

; complement — `(complement pred)` → a box `x → ¬(pred x)` (i32: 1 when pred is
; false, 0 when true). pred : (UnaryFn A bool), a bare predicate fn pointer.
; The BOX stays i32-valued: `BoxedFn` conforms to no `UnaryFn`, so a bool box
; could never be fed back to a predicate slot, and homogeneous box storage
; (examples/comb-storage.nuc) needs one element type.
(defn complement (pred:&P
                                       :where ((UnaryFn A bool) P)) (BoxedFn (A) i32)
  (return (vfn (x:A) i32 (if (apply pred x) 0 1))))

; conjoin — `(conjoin p q)` → a box `x → (p x) ∧ (q x)` (i32: 1 when both hold).
; p, q : (UnaryFn A bool), bare predicate fn pointers.
(defn conjoin (p:&P q:&Q
                                    :where ((UnaryFn A bool) P)
                                           ((UnaryFn A bool) Q)) (BoxedFn (A) i32)
  (return (vfn (x:A) i32 (if (and (apply p x) (apply q x)) 1 0))))

; disjoin — `(disjoin p q)` → a box `x → (p x) ∨ (q x)` (i32: 1 when either holds).
; p, q : (UnaryFn A bool), bare predicate fn pointers.
(defn disjoin (p:&P q:&Q
                                    :where ((UnaryFn A bool) P)
                                           ((UnaryFn A bool) Q)) (BoxedFn (A) i32)
  (return (vfn (x:A) i32 (if (or (apply p x) (apply q x)) 1 0))))

; constantly — `(constantly v)` → a box `_ → v` that always returns v, ignoring
; its argument. The value v is captured BY VALUE (cloned into the heap env, like
; make-adder's int). The box's input type is V (the value's type): the ignored
; argument must be V-typed. V is Ord-bounded only so the tyvar is collected (see
; the operand-model note above).
(defn constantly ((v V) :where (Ord V)) (BoxedFn (V) V)
  (return (vfn (ignored:V) V v)))

; partial — `(partial f a)` → a box `x → (f a x)` (partial application of the
; first argument). f : (FoldFn A X) — a bare 2-arg fn pointer whose return type
; equals its first argument's type (the FoldFn shape: (Acc, Elem) → Acc). v1
; partial covers this FoldFn-shaped binary function (the common arithmetic case,
; e.g. `(partial + n)`); a general `(A, X) → R` binary protocol is deferred. a is
; captured by value; f is captured as a bare fn pointer (null env-drop slot).
(defn partial (f:&F (a A)
                                  :where ((FoldFn A X) F)) (BoxedFn (X) A)
  (return (vfn (x:X) A (fold f a x))))

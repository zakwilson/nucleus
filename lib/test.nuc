; Stage 18 TF-4 — test.nuc: declare tests, assert, and report.
;
; Design: design/stage18-tooling/overview.md §T6.4.
;
; A test is a `deftest`. It registers itself before `main` runs, so a suite is a
; program whose `main` is one call to `test-main` -- and a suite binary answers
; `--list` and `--run <name>`, the two verbs an outside runner needs to address
; one test or shard a suite.
;
; Assertions return `!void` and a test body is `try`-shaped, so a failing step
; stops the test. That is the whole reason the framework is native: the shell
; suite hand-rolls `ok=1 … || ok=0` accumulators 111 times, and forgetting one
; makes a step unconditionally pass.
;
; Failure text is rendered in ONE place, here, rather than at each assertion's
; call site. See docs/testing.md.

(import-use error)
(import-use strview)
(import-use string)
(import-use string-split)
(import-use fmt)
(import-use vector)
(import-use io)
(import-use file)
(import-use allocator)
(import-use read)

(deferror test-failed "assertion failed")
(deferror test-skipped "test skipped")
(deferror test-unknown "no such test")
(deferror test-bad-args "bad arguments")

; A skip is a THIRD verdict, not a quiet pass: a test that cannot run on this
; host says so, in the record, with its reason. `--no-skip` turns every skip
; into a failure, for a run that cannot accept one.
(defenum TestStatus TEST-PASS TEST-FAIL TEST-SKIP)

(defvar g-test-no-skip:bool)

; ---------------------------------------------------------------------------
; The registry
; ---------------------------------------------------------------------------

(defstruct TestCase
  name:Symbol
  file:StrView
  line:i32
  ; TF-6: `run` takes a `ptr` and `data` supplies it, so a test can come from a
  ; TABLE as well as from a `deftest`. A `deftest` ignores both.
  run:(fn !void)(ptr)
  data:ptr)

; Process-lifetime state, so it is built through the arena: its `drop` is a
; no-op and nothing here is ever torn down.
(defvar g-test-alloc:AllocHandle)
(defvar g-tests:&(Vector TestCase)
  (vector-new-in (arena-allocator &g-test-alloc)))
; Lazily built, like lib/io.nuc's output buffer: a global String with a
; constant initializer would need an allocator this module has no reason to own.
(defvar g-fail-buf:String)
(defvar g-fail-ready:i32 0)

; Register a test by name. The data-driven entry point: a suite that reads its
; cases from a table calls this once per row, before `test-main`.
(defn test-add (name:StrView file:StrView line:i32 (f (fn !void) (ptr)) data:ptr):void
  (let (tc:&TestCase (alloca TestCase))
    (set! (tc 'name) (symbol-intern name))
    (set! (tc 'file) file)
    (set! (tc 'line) line)
    (set! (tc 'run) f)
    (set! (tc 'data) data)
    (conj g-tests @tc)))

; Called by `deftest`'s expansion from a global initializer, which is why it
; returns an `i32` -- it needs a value for the slot it is initialising.
(defn test-register (name:&Node file:StrView line:i32 (f (fn !void) (ptr))):i32
  (test-add (symbol-as-view (name 's)) file line f null)
  (return 0))

; `(deftest name body…)`. The name is a bare symbol; `(source-file)` and
; `(source-line)` resolve at the CALL site, so a failure names the `deftest`
; rather than this macro.
(defmacro deftest (name :rest body)
  (let (g:ptr (gensym)
        a:ptr (gensym))
    `(defvar (~g i32)
       (test-register (quote ~name) (source-file) (source-line)
                      (fn ((~a ptr)):!void ~@body (return (ok)))))))

; ---------------------------------------------------------------------------
; Failure reporting -- one implementation, not one per assertion
; ---------------------------------------------------------------------------

; Clears the failure buffer and hands it back to be written into.
(defn test-fail-begin ():&String
  (when (= g-fail-ready 0)
    (set! g-fail-buf (string-new))
    (set! g-fail-ready 1))
  (string-clear &g-fail-buf)
  (return &g-fail-buf))

(defn test-failure-text ():StrView
  (when (= g-fail-ready 0) (return ""))
  (return (string-as-view &g-fail-buf)))

(defn test-failure-len ():usize
  (when (= g-fail-ready 0) (return 0))
  (return (byte-len &g-fail-buf)))

; `(fail! "expected " x " got " y)` — render, then propagate. A macro because
; the pieces are variadic and heterogeneous, which a function cannot take.
(defmacro fail! (:rest parts)
  (let (b:ptr (gensym))
    ; `str-into` re-evaluates its target once per piece, and `test-fail-begin`
    ; clears -- so binding it first is what keeps all but the last piece.
    `(let ((~b &String) (test-fail-begin))
       (str-into ~b ~@parts)
       (return (err! test-failed)))))

; `(skip! "needs " thing)` — the same shape, and the reason is required for the
; same reason a failure's is: a skip with no reason cannot be audited later.
(defmacro skip! (:rest parts)
  (let (b:ptr (gensym))
    `(let ((~b &String) (test-fail-begin))
       (str-into ~b ~@parts)
       (return (err! test-skipped)))))

; Long haystacks make a failure unreadable; the first 400 bytes are enough to
; recognise what was actually there.
(defconst SHOW-LIMIT 400)

(defn test-show (s:StrView):StrView
  (when (<= (s 'len) SHOW-LIMIT) (return s))
  (return (strview-take-bytes s SHOW-LIMIT)))

; ---------------------------------------------------------------------------
; Glob matching (§T8.4: glob, not regex)
; ---------------------------------------------------------------------------

; Unchecked: every caller has just bounds-checked `i`, and the checked accessor
; yields `!ui8`, which a bool-returning matcher cannot propagate.
(defn test-byte-at (v:&StrView i:usize):ui8
  (return (aref (v 'data) i)))

; `*` matches any run of bytes, `?` any single byte. Backtracking rather than
; recursive: one remembered `*` is enough, since a second supersedes the first.
(defn glob-match (pat:&StrView s:&StrView):bool
  (let (pn:usize (strview-byte-len pat)
        sn:usize (strview-byte-len s)
        pi:usize 0
        si:usize 0
        star:i64 -1
        mark:usize 0)
    (while (< si sn)
      (let (starred:bool false
            matched:bool false)
        (when (< pi pn)
          (let (pc:ui8 (test-byte-at pat pi))
            (set! starred (= pc 42))
            (set! matched (or (= pc 63) (= pc (test-byte-at s si))))))
        (cond starred
                (do (set! star (as i64 pi))
                    (set! mark si)
                    (set! pi (+ pi 1)))
              matched
                (do (set! pi (+ pi 1))
                    (set! si (+ si 1)))
              (>= star 0)
                (do (set! pi (+ (as usize star) 1))
                    (set! mark (+ mark 1))
                    (set! si mark))
              true
                (return false))))
    (while (and (< pi pn) (= (test-byte-at pat pi) 42))
      (set! pi (+ pi 1)))
    (return (= pi pn))))

; ---------------------------------------------------------------------------
; The predicates (§T1.2)
; ---------------------------------------------------------------------------

(defn contains? (hay:StrView needle:StrView):bool
  (match (strview-find &hay &needle)
    ((some at) (return true))
    (none (return false))))

(defn has-line? (hay:StrView want:StrView):bool
  (let (it:LineIter (strview-lines &hay))
    (while (not (lines-iter-done &it))
      (when (= (lines-iter-next &it) want) (return true)))
    (return false)))

(defn has-matching-line? (hay:StrView pat:StrView):bool
  (let (it:LineIter (strview-lines &hay))
    (while (not (lines-iter-done &it))
      (let (line:StrView (lines-iter-next &it))
        (when (glob-match &pat &line) (return true))))
    (return false)))

; 1. contains-substring
(defn check-contains (hay:StrView needle:StrView):!void
  (when (contains? hay needle) (return (ok)))
  (fail! "expected to contain " (sexp-quote needle) "\n     in: " (test-show hay)))

(defn check-not-contains (hay:StrView needle:StrView):!void
  (when (not (contains? hay needle)) (return (ok)))
  (fail! "expected NOT to contain " (sexp-quote needle) "\n     in: " (test-show hay)))

; 2. contains-whole-line
(defn check-line (hay:StrView want:StrView):!void
  (when (has-line? hay want) (return (ok)))
  (fail! "expected a line " (sexp-quote want) "\n     in: " (test-show hay)))

; 3. equals-string
(defn check-eq (got:StrView want:StrView):!void
  (when (= got want) (return (ok)))
  (fail! "expected " (sexp-quote want) "\n     got " (sexp-quote (test-show got))))

; 4. matches-with-wildcards -- some line matches the glob in full
(defn check-match (hay:StrView pat:StrView):!void
  (when (has-matching-line? hay pat) (return (ok)))
  (fail! "expected a line matching " (sexp-quote pat) "\n     in: " (test-show hay)))

(defn check-not-match (hay:StrView pat:StrView):!void
  (when (not (has-matching-line? hay pat)) (return (ok)))
  (fail! "expected NO line matching " (sexp-quote pat) "\n     in: " (test-show hay)))

; 5. files-identical
(defn read-file (path:StrView):!String
  (let (f:File (try (file-open-read &path))
        text:String (try (file-read-to-string &f)))
    (try (file-close &f))
    (return (ok text))))

; Golden-output comparison. Reports the FIRST differing line and its number,
; which is what `diff -u` gave the shell suite: two truncated blobs side by side
; cannot say where they parted, and a golden file is usually long.
(defn check-golden (got:StrView want:StrView):!void
  (when (= got want) (return (ok)))
  (let (gi:LineIter (strview-lines &got)
        wi:LineIter (strview-lines &want)
        n:i64 0)
    (while (or (not (lines-iter-done &gi)) (not (lines-iter-done &wi)))
      (set! n (+ n 1))
      (let (gd:bool (lines-iter-done &gi)
            wd:bool (lines-iter-done &wi))
        (when gd
          (fail! "output ends at line " (- n 1) "; expected line " n ": "
                 (sexp-quote (lines-iter-next &wi))))
        (when wd
          (fail! "expected output ends at line " (- n 1) "; got line " n ": "
                 (sexp-quote (lines-iter-next &gi))))
        (let (g:StrView (lines-iter-next &gi)
              w:StrView (lines-iter-next &wi))
          (when (!= g w)
            (fail! "line " n " differs\n     want " (sexp-quote w)
                   "\n     got  " (sexp-quote g)))))))
  ; Equal line by line but not byte for byte: a trailing newline, which a
  ; line iterator cannot see and a golden file records.
  (fail! "output differs only in trailing bytes (want " (as i64 (strview-byte-len &want))
         " bytes, got " (as i64 (strview-byte-len &got)) ")"))

(defn check-files-eq (a:StrView b:StrView):!void
  (let (ta:String (try (read-file a))
        tb:String (try (read-file b))
        same:bool (= (string-as-view &ta) (string-as-view &tb)))
    (drop &ta)
    (drop &tb)
    (when same (return (ok)))
    (fail! "expected identical files: " a " and " b)))

; 6. output-empty / non-empty
(defn check-empty (s:StrView):!void
  (when (= (s 'len) 0) (return (ok)))
  (fail! "expected empty, got " (sexp-quote (test-show s))))

(defn check-non-empty (s:StrView):!void
  (when (> (s 'len) 0) (return (ok)))
  (fail! "expected non-empty output, got nothing"))

; The general escape hatch, for a condition the six do not name.
(defn check (cond:bool what:StrView):!void
  (when cond (return (ok)))
  (fail! "expected " what))

(defn check-eq-int (got:i64 want:i64 what:StrView):!void
  (when (= got want) (return (ok)))
  (fail! "expected " what " = " want ", got " got))

; ---------------------------------------------------------------------------
; The scoped IR matcher (§T4.3)
;
; 202 of the suite's 209 IR probes assert about a DECISION -- an ABI class, a
; linkage, a field order -- that is only observable in the rendering. A probe
; over the whole module cannot say which function it means, so a match anywhere
; satisfies it. Splitting the module into its `define` blocks makes the scope
; explicit without the compiler growing an IR data structure it has no other
; use for.
; ---------------------------------------------------------------------------

; The `define … @name(…) { … }` block for `name`, brace line included.
(defn ir-define (module:StrView name:StrView):?StrView
  (let (needle:String (str "@" name "(")
        nv:StrView (string-as-view &needle)
        it:LineIter (strview-lines &module)
        start:usize 0
        seen:usize 0
        in-body:bool false)
    (while (not (lines-iter-done &it))
      (let (line:StrView (lines-iter-next &it)
            len:usize (+ (line 'len) 1))
        (if in-body
          (when (and (= (line 'len) 1) (= line "}"))
            (drop &needle)
            (return (some (strview (unsafe/ptr+ (module 'data) (as i64 start))
                                   (- (+ seen len) start)))))
          (when (and (strview-has-prefix line "define") (contains? line nv))
            (set! in-body true)
            (set! start seen)))
        (set! seen (+ seen len))))
    (drop &needle)
    (return none)))

; A glob that must match a line INSIDE one function's body.
(defn check-in-define (module:StrView fname:StrView pat:StrView):!void
  (match (ir-define module fname)
    (none (fail! "no `define` for " (sexp-quote fname) " in the module"))
    ((some body)
      (when (has-matching-line? body pat) (return (ok)))
      (fail! "in @" fname ": expected a line matching " (sexp-quote pat)
             "\n     body: " (test-show body)))))

(defn check-not-in-define (module:StrView fname:StrView pat:StrView):!void
  (match (ir-define module fname)
    (none (fail! "no `define` for " (sexp-quote fname) " in the module"))
    ((some body)
      (when (not (has-matching-line? body pat)) (return (ok)))
      (fail! "in @" fname ": expected NO line matching " (sexp-quote pat)))))

; ---------------------------------------------------------------------------
; Compiler diagnostics (§T4.2)
;
; `nucleusc --diagnostics=sexp` writes one form per diagnostic. Reading them
; back makes an assertion about a diagnostic ONE comparison against ONE record.
; The shell suite greps stderr twice, once for the location and once for the
; message, and never checks that the two came from the same diagnostic -- and
; notes carry locations too, so a note can satisfy the location probe while the
; error says something else somewhere else.
; ---------------------------------------------------------------------------

(defstruct Diagnostic
  severity:Symbol
  file:StrView
  line:i32
  message:StrView
  notes:&(Vector StrView))

; The operands of the `(key …)` entry named `name`, or null.
(defn diag-entry (body:?&Node name:StrView):?&Node
  (let (cur:?&Node body)
    (while (> (node-len cur) 0)
      (let (e:?&Node (node-first cur))
        (when (and (!= e null) (= (e 'kind) NODE-LIST))
          (let (h:?&Node (node-first e))
            (when (and (!= h null) (= (h 'kind) NODE-SYM)
                       (= (symbol-as-view (h 's)) name))
              (return (node-rest e))))))
      (set! cur (node-rest cur)))
    (return null)))

; A kind check, not a null check: `Node.s` is null on an INT or a FLOAT, and
; `symbol-as-view` of null is a segfault, not an empty view.
(defn diag-text (n:?&Node):StrView
  (when (= n null) (return ""))
  (let (k:i32 (n 'kind))
    (when (and (!= k NODE-SYM) (!= k NODE-STR) (!= k NODE-KEYWORD)) (return "")))
  (return (symbol-as-view (n 's))))

(defn diag-of-node (form:?&Node):!Diagnostic
  (when (or (= form null) (!= (form 'kind) NODE-LIST))
    (return (err! test-bad-args)))
  (let (body:?&Node (node-rest form)
        d:&Diagnostic (alloca Diagnostic)
        sev:?&Node (diag-entry body "severity")
        file:?&Node (diag-entry body "file")
        line:?&Node (diag-entry body "line")
        msg:?&Node (diag-entry body "message")
        notes:?&Node (diag-entry body "notes"))
    (when (or (= sev null) (= file null) (= line null) (= msg null))
      (return (err! test-bad-args)))
    (let (sn:?&Node (node-first sev)
          ln:?&Node (node-first line))
      (when (or (= sn null) (= ln null)) (return (err! test-bad-args)))
      (set! (d 'severity) (sn 's))
      (set! (d 'line) (unsafe/cast i32 (ln 'i))))
    (set! (d 'file) (diag-text (node-first file)))
    (set! (d 'message) (diag-text (node-first msg)))
    (set! (d 'notes) (vector-new-in (arena-allocator &g-test-alloc)))
    (let (cur:?&Node notes)
      (while (> (node-len cur) 0)
        (conj (d 'notes) (diag-text (node-first cur)))
        (set! cur (node-rest cur))))
    (return (ok @d))))

; Reads every diagnostic in `text`, which may be the compiler's raw stderr.
; One diagnostic is one LINE -- the writer escapes every newline inside a
; string -- so a line that is not one is skipped rather than failing the parse,
; which is what lets output from a tool `nucleusc` invoked ride along.
(defn read-diagnostics (text:StrView):!(Vector Diagnostic)
  (let (out:(Vector Diagnostic) (vector-new)
        it:LineIter (strview-lines &text))
    (while (not (lines-iter-done &it))
      (let (line:StrView (lines-iter-next &it))
        (when (strview-has-prefix line "(diagnostic ")
          (let (forms:?&Node (try (read-all line)))
            (conj &out (try (diag-of-node (node-first forms))))))))
    (return (ok out))))

; Every diagnostic, one per line, for a failure message.
(defn diag-list-text (ds:&(Vector Diagnostic)):String
  (let (s:String (string-new)
        n:usize (count ds)
        i:usize 0)
    (when (= n 0) (str-into &s "\n     (no diagnostics)"))
    (while (< i n)
      (let (d:Diagnostic (invoke ds i))
        (str-into &s "\n     " (symbol-as-view (d 'severity)) " "
                  (d 'file) ":" (d 'line) ": " (d 'message))
        (let (m:usize (count (d 'notes))
              j:usize 0)
          (while (< j m)
            (str-into &s "\n       note: " (invoke (d 'notes) j))
            (set! j (+ j 1)))))
      (set! i (+ i 1)))
    (return s)))

(defn diag-matches (d:&Diagnostic severity:StrView file:StrView line:i32 needle:StrView):bool
  (return (and (= (symbol-as-view (d 'severity)) severity)
               (= (d 'file) file)
               (= (d 'line) line)
               (contains? (d 'message) needle))))

; The assertion the shell harness could not write: severity, file, line and
; message are matched against ONE record, so a note cannot supply the location
; for a message that came from somewhere else.
(defn check-diagnostic (ds:&(Vector Diagnostic) severity:StrView
                        file:StrView line:i32 needle:StrView):!void
  (let (n:usize (count ds)
        i:usize 0)
    (while (< i n)
      (let (d:Diagnostic (invoke ds i))
        (when (diag-matches &d severity file line needle) (return (ok))))
      (set! i (+ i 1))))
  (let (l:String (diag-list-text ds))
    (fail! "expected " severity " at " file ":" line " containing " (sexp-quote needle)
           "\n     got:" (string-as-view &l))))

(defn check-error-at (ds:&(Vector Diagnostic) file:StrView line:i32 needle:StrView):!void
  (return (check-diagnostic ds "error" file line needle)))

(defn check-warning-at (ds:&(Vector Diagnostic) file:StrView line:i32 needle:StrView):!void
  (return (check-diagnostic ds "warning" file line needle)))

; No location pinned: some error's message contains `needle`. The weaker form,
; for a case whose line nobody has committed to.
(defn check-error-anywhere (ds:&(Vector Diagnostic) needle:StrView):!void
  (let (n:usize (count ds)
        i:usize 0)
    (while (< i n)
      (let (d:Diagnostic (invoke ds i))
        (when (and (= (symbol-as-view (d 'severity)) "error")
                   (contains? (d 'message) needle))
          (return (ok))))
      (set! i (+ i 1))))
  (let (l:String (diag-list-text ds))
    (fail! "expected an error containing " (sexp-quote needle)
           "\n     got:" (string-as-view &l))))

; A note on a diagnostic at that same location -- the pairing the two-grep
; version had no way to express.
(defn check-note-at (ds:&(Vector Diagnostic) file:StrView line:i32 needle:StrView):!void
  (let (n:usize (count ds)
        i:usize 0)
    (while (< i n)
      (let (d:Diagnostic (invoke ds i))
        (when (and (= (d 'file) file) (= (d 'line) line))
          (let (m:usize (count (d 'notes))
                j:usize 0)
            (while (< j m)
              (when (contains? (invoke (d 'notes) j) needle) (return (ok)))
              (set! j (+ j 1))))))
      (set! i (+ i 1))))
  (let (l:String (diag-list-text ds))
    (fail! "expected a note at " file ":" line " containing " (sexp-quote needle)
           "\n     got:" (string-as-view &l))))

; No location pinned: some diagnostic carries a note containing `needle`.
(defn check-note-anywhere (ds:&(Vector Diagnostic) needle:StrView):!void
  (let (n:usize (count ds)
        i:usize 0)
    (while (< i n)
      (let (d:Diagnostic (invoke ds i)
            m:usize (count (d 'notes))
            j:usize 0)
        (while (< j m)
          (when (contains? (invoke (d 'notes) j) needle) (return (ok)))
          (set! j (+ j 1))))
      (set! i (+ i 1))))
  (let (l:String (diag-list-text ds))
    (fail! "expected a note containing " (sexp-quote needle)
           "\n     got:" (string-as-view &l))))

; Stage 15 W4a's accept criterion, as a field check: the shell version greps
; stderr for the literal `:0:`, which any message containing those bytes also
; satisfies.
(defn check-no-line-zero (ds:&(Vector Diagnostic)):!void
  (let (n:usize (count ds)
        i:usize 0)
    (while (< i n)
      (let (d:Diagnostic (invoke ds i))
        (when (= (d 'line) 0)
          (let (l:String (diag-list-text ds))
            (fail! "a diagnostic reports line 0:" (string-as-view &l)))))
      (set! i (+ i 1))))
  (return (ok)))

(defn check-no-errors (ds:&(Vector Diagnostic)):!void
  (let (n:usize (count ds)
        i:usize 0)
    (while (< i n)
      (let (d:Diagnostic (invoke ds i))
        (when (= (symbol-as-view (d 'severity)) "error")
          (let (l:String (diag-list-text ds))
            (fail! "expected no errors, got:" (string-as-view &l)))))
      (set! i (+ i 1))))
  (return (ok)))

; ---------------------------------------------------------------------------
; Reporting -- s-expression result records (§T8.5)
; ---------------------------------------------------------------------------

; A `StrView` wrapper that renders as an s-expression string literal, so a
; message containing a quote or a newline survives being written and read back.
(defstruct SexpStr v:StrView)

(defn sexp-quote (v:StrView):SexpStr
  (let (q:&SexpStr (alloca SexpStr))
    (set! (q 'v) v)
    (return @q)))

(extend SexpStr ToStr)
(defn to-str (self:SexpStr out:&String):!void
  (sexp-write-string out (self 'v))
  (return (ok)))

(defn test-report (tc:&TestCase status:i32):void
  (let (b:&String (io-buf-begin))
    (str-into b "(test (name " (sexp-quote (symbol-as-view (tc 'name)))
              ") (file " (sexp-quote (tc 'file))
              ") (line " (tc 'line) ") (status ")
    (cond
      (= status TEST-PASS) (str-into b "pass)")
      (= status TEST-SKIP) (str-into b "skip) (message "
                                     (sexp-quote (test-failure-text)) ")")
      true                 (str-into b "fail) (message "
                                     (sexp-quote (test-failure-text)) ")"))
    (str-into b ")\n")
    (io-buf-end 1)))

; ---------------------------------------------------------------------------
; Scratch files
;
; A test that needs a fixture on disk gets one directory, named for the test, so
; `--run <name>` reproduces exactly the files the full run made -- and no two
; tests can collide. Under `build/out`, which `make test` clears.
; ---------------------------------------------------------------------------

(defvar g-test-scratch:StrView)

; Interned rather than kept in a String: the view outlives the call, and a test
; name is one of a small fixed set.
(defn test-scratch-set (name:StrView):void
  (let (p:String (str "build/out/nt/" name)
        v:StrView (string-as-view &p))
    (set! g-test-scratch (symbol-as-view (symbol-intern &v)))
    (drop &p)))

; The current test's directory, created on first ask.
(defn test-scratch ():!StrView
  (try (make-dir "build/out"))
  (try (make-dir "build/out/nt"))
  (try (make-dir g-test-scratch))
  (return (ok g-test-scratch)))

; A subdirectory of this test's scratch directory, created on first ask. A unit
; that exports a `.nuch` needs one: `resolve-import` tries `.nuc` in every
; search directory before any `.nuch`, so the source must sit outside them.
(defn test-scratch-sub (name:StrView):!String
  (let (dir:StrView (try (test-scratch))
        p:String (str dir "/" name)
        pv:StrView (string-as-view &p))
    (try (make-dir pv))
    (return (ok p))))

; Write `content` to `name` inside the scratch directory; yields the path.
(defn test-write-file (name:StrView content:StrView):!String
  (let (dir:StrView (try (test-scratch))
        path:String (str dir "/" name)
        pv:StrView (string-as-view &path)
        f:File (try (file-create &pv)))
    (try (write-str &f content))
    (try (file-close &f))
    (return (ok path))))

(defn test-run-one (tc:&TestCase):i32
  (test-scratch-set (symbol-as-view (tc 'name)))
  (test-fail-begin)
  (match (funcall (tc 'run) (tc 'data))
    (ok (do (test-report tc TEST-PASS) (return TEST-PASS)))
    ((err e)
      (when (= e test-skipped)
        (when (not g-test-no-skip)
          (test-report tc TEST-SKIP)
          (return TEST-SKIP))
        ; Copy first: `test-fail-begin` clears the buffer the reason lives in.
        (let (s:String (str "skipped: " (test-failure-text)))
          (str-into (test-fail-begin) (string-as-view &s))
          (drop &s))
        (test-report tc TEST-FAIL)
        (return TEST-FAIL))
      ; An error that is not an assertion failure -- a file that would not open,
      ; say -- still has to say something, or the record reads as an empty
      ; failure.
      (when (= (test-failure-len) 0)
        (str-into (test-fail-begin) "test raised " (err-name e) ": " (err-message e)))
      (test-report tc TEST-FAIL)
      (return TEST-FAIL))))

; ---------------------------------------------------------------------------
; The suite entry point
; ---------------------------------------------------------------------------

(defn test-find (name:StrView):?usize
  (let (n:usize (count g-tests)
        i:usize 0)
    (while (< i n)
      (let (tc:TestCase (invoke g-tests i))
        (when (= (symbol-as-view (tc 'name)) name) (return (some i))))
      (set! i (+ i 1)))
    (return none)))

; Shards STRIDE rather than take contiguous blocks: neighbouring tests share
; fixtures and cost, so a block split hands one shard a whole expensive family.
(defn test-run-all (shard:usize nshards:usize):i32
  (let (n:usize (count g-tests)
        i:usize shard
        failed:i32 0)
    (while (< i n)
      (let (tc:TestCase (invoke g-tests i))
        (when (= (test-run-one &tc) TEST-FAIL) (set! failed (+ failed 1))))
      (set! i (+ i nshards)))
    (return (if (> failed 0) 1 0))))

; A duplicate name makes `--run` address the wrong test and a shard silently
; cover one test twice, so it is checked once rather than left to be noticed.
(defn test-duplicate-name ():Symbol
  (let (n:usize (count g-tests)
        i:usize 0)
    (while (< i n)
      (let (a:TestCase (invoke g-tests i)
            j:usize (+ i 1))
        (while (< j n)
          (let (b:TestCase (invoke g-tests j))
            (when (= (a 'name) (b 'name)) (return (a 'name))))
          (set! j (+ j 1))))
      (set! i (+ i 1))))
  (return (symbol-none)))

(defn test-list ():void
  (let (n:usize (count g-tests)
        i:usize 0)
    (while (< i n)
      (let (tc:TestCase (invoke g-tests i))
        (print (symbol-as-view (tc 'name)) "\n"))
      (set! i (+ i 1)))))

; `--shard i/n` runs every nth test from i, so n processes cover the suite once
; between them; the pair parses as one argument because half is meaningless alone.
(defn test-parse-shard (a:StrView out-shard:&usize out-n:&usize):!void
  (match (strview-find-byte &a 47)
    ((some k)
      (let (lhs:StrView (try (strview-sub-bytes &a 0 k))
            rhs:StrView (try (strview-sub-bytes &a (+ k 1) (a 'len)))
            si:ui64 (try (strview-parse-magnitude lhs 10 65536))
            ni:ui64 (try (strview-parse-magnitude rhs 10 65536)))
        (when (or (= ni 0) (>= si ni)) (return (err! test-bad-args)))
        (set! (aref out-shard 0) (as usize si))
        (set! (aref out-n 0) (as usize ni))
        (return (ok))))
    (none (return (err! test-bad-args)))))

; `main` for a suite. `--list` names its tests, `--run <name>` runs exactly one,
; `--shard <i>/<n>` runs every nth from i (the Makefile fans one process per
; core), no arguments runs them all; every run emits one record per test.
; `--no-skip` is a policy flag rather than a mode, so it composes with any verb.
(defn test-main (argc:i32 argv:ptr):i32
  (let (dup:Symbol (test-duplicate-name))
    (when (not (symbol-none? dup))
      (eprint "duplicate test name: " (symbol-as-view dup) "\n")
      (return 2)))
  (let (i:i32 1
        mode:StrView ""
        want:StrView ""
        shard:usize 0
        nshards:usize 1)
    (while (< i argc)
      (let (a:StrView (strview-from-cstr (as CStr (aref (unsafe/cast &ptr argv) i))))
        (cond
          (= a "--no-skip") (set! g-test-no-skip true)
          (= a "--list")    (set! mode "list")
          (= a "--run")
            (do
              (when (>= (+ i 1) argc)
                (eprint "usage: <suite> --run <name>\n")
                (return 2))
              (set! mode "run")
              (set! i (+ i 1))
              (set! want (strview-from-cstr (as CStr (aref (unsafe/cast &ptr argv) i)))))
          (= a "--shard")
            (do
              (when (>= (+ i 1) argc)
                (eprint "usage: <suite> --shard <i>/<n>\n")
                (return 2))
              (set! i (+ i 1))
              (match (test-parse-shard
                       (strview-from-cstr (as CStr (aref (unsafe/cast &ptr argv) i)))
                       &shard &nshards)
                (ok 0)
                ((err e)
                  (eprint "bad --shard: " (err-message e)
                          "; want <i>/<n> with 0 <= i < n\n")
                  (return 2))))
          true
            (do
              (eprint "usage: <suite> [--list | --run <name> | --shard <i>/<n>] [--no-skip]\n")
              (return 2))))
      (set! i (+ i 1)))
    (when (= mode "list") (test-list) (return 0))
    (when (= mode "run")
      (match (test-find want)
        ((some k)
          ; A sharded `--run` is still one test in one shard, so passing both
          ; yields one record rather than one per shard.
          (when (!= (% k nshards) shard) (return 0))
          (let (tc:TestCase (invoke g-tests k))
            (return (if (= (test-run-one &tc) TEST-FAIL) 1 0))))
        (none
          (eprint "no such test: " want "\n")
          (return 2))))
    (return (test-run-all shard nshards))))

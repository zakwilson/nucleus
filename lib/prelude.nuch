; .nuch header for lib/prelude.nuc
(defstruct Node (kind i32) (line i32) (i i64) (s ptr) (car (raw Node)) (cdr (raw Node)))
(defenum NodeKind NODE-INT NODE-STR NODE-SYM NODE-CELL NODE-FLOAT NODE-KEYWORD NODE-CHAR)
(defstruct StrView (data (ptr ui8)) (len usize))
(defprotocol Clone (clone ((self (ref Self))) Self))
(defunion (Result T E) (ok v:T) (err e:E))
(defunion (Maybe T) (some v:T) none)

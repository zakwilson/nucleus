; Stage 17 B4 — `Symbol`: interned identity, with the header behind the pointer.
;
; Design: design/stage17-native-strings/overview.md §2.4.
;
; The stage's third overturned ruling. Stage 14 exempted the compiler's interned
; substrate — `Node.s`, scope keys, struct-field names — from native strings
; because identity comparison must stay one `icmp eq ptr` and a `{data,len}`
; view cannot be identity-compared. The requirement is real; the conclusion
; ("so keep it a raw `char*`") was the work-around-the-weakness move. The
; weakness is that the native stack had no interned-identity type. This is it.
;
; LAYOUT. The interner allocates
;
;     [hash:usize][len:usize][bytes…][NUL]
;                             ^ Symbol.p
;
; and the Symbol holds the address of the first BYTE, not of the header. That
; one choice buys all four properties at once: `=` is `icmp eq ptr`; `len` and
; `hash` are O(1) loads behind the pointer; `as-view` is `{p, len}` with no
; allocation; and `as-cstr` is free, because the bytes are still NUL-terminated,
; so every remaining FFI seam takes a Symbol with no copy.

(import-use "stdlib.h")
(import-use "string.h")
(import-use "stdio.h")

(extern stderr:ptr)

; `fnv` is the ONLY Nucleus import, and that is the point: `lib/node.nuc`
; delegates its symbol table here (C7-2), and `node` is what every macro-using
; program imports. `hash`, `numeric` and `strview` all reach an `f64`
; annotation, which AVR rejects outright, so importing any of them would make
; every macro-using program un-compilable for an 8-bit target. The `Eq`/`Hash`
; conformance records and the `ToStr`/`ByteStr`/`Str` methods live in
; `lib/intern-str.nuc` — the same split, for the same reason, as `strview` /
; `strview-str`.
;
; `Symbol` itself is declared in `lib/prelude.nuc`, beside `StrView` and for the
; same reason (design/stage17-native-strings/c7-interned-substrate.md §2.2):
; `Node.s` is one, so the reader, the macro JIT module and the bootstrap all
; need the type registered without importing anything.
(import-use fnv)

; The header behind `p`, as a type rather than as byte offsets: `usize` is two
; bytes on AVR and eight on a host, so hand-written `-8`/`-16` would silently
; read the wrong words there.
(defstruct SymHeader
  hash:usize
  len:usize)

; Reinterpreting a byte pointer at the header is the one thing this layout
; cannot express in the type, hence `unsafe/cast`. malloc's alignment is at
; least usize's, and the header is a whole number of words, so `p` is aligned.
(defn symbol-header (self:Symbol):&SymHeader
  (return (unsafe/cast ptr:SymHeader
            (unsafe/ptr+ (self 'p) (- 0 (as i64 (sizeof SymHeader)))))))

(defn symbol-len (self:Symbol):usize
  (let (h:&SymHeader (symbol-header self))
    (return (h 'len))))

(defn symbol-cached-hash (self:Symbol):usize
  (let (h:&SymHeader (symbol-header self))
    (return (h 'hash))))

; Spelled out rather than `(strview …)`: the constructor lives in lib/strview.nuc,
; which this file cannot import.
(defn symbol-as-view (self:Symbol):StrView
  (let (sv:&StrView (alloca StrView))
    (set! (sv 'data) (self 'p))
    (set! (sv 'len) (symbol-len self))
    (return @sv)))

; Free, not a conversion: the interner NUL-terminates, so the bytes already are
; a C string. This is what keeps every surviving FFI seam copy-free.
(defn symbol-as-cstr (self:Symbol):CStr
  (return (as CStr (as ptr (self 'p)))))

; "This node has no name." A `Symbol` is never CONSTRUCTED null — `p` is a
; non-null pointer type — but a zeroed struct (an arena `Node` that is an INT or
; a CELL) reads back as one, and reaching the bytes then segfaults.
(defn symbol-none? (self:Symbol):bool
  (return (= (as ptr (self 'p)) null)))

; …and the value it tests for, so "this has no name" can be WRITTEN and not only
; recognised. `memset` because `p` is a non-null pointer type: there is no null
; to assign, which is the whole reason the zero Symbol has to be minted rather
; than constructed. Its bytes may never be read — `symbol-none?` is the only
; thing it is good for.
(defn symbol-none ():Symbol
  (let (s:&Symbol (alloca Symbol))
    (memset (as ptr s) 0 (as i64 (sizeof Symbol)))
    (return @s)))

; A spelling test against a written literal — the overwhelmingly common
; comparison, and the one thing pointer identity cannot answer, since interning
; the literal to get a pointer would cost a hash to save a `memcmp` of four
; bytes (c7-interned-substrate.md §2.1).
(defn symbol-is (self:Symbol other:StrView):bool
  (let (n:usize (symbol-len self))
    (when (!= n (other 'len)) (return false))
    (when (= n 0) (return true))
    (return (= (memcmp (as ptr (self 'p)) (as ptr (other 'data)) (as i64 n)) 0))))

; `=` on two Symbols is identity; against a view it is `symbol-is`. Both mean
; "same bytes" — interning is what makes those one predicate.
(defn = (a:Symbol b:StrView):bool (return (symbol-is a b)))
(defn != (a:Symbol b:StrView):bool (return (= (symbol-is a b) false)))

(defn symbol-contains-byte (self:Symbol b:i32):bool
  (return (!= (memchr (as ptr (self 'p)) b (as i64 (symbol-len self))) null)))

; The `i`th byte. Unchecked, deliberately: every caller is a one-character test
; on a name whose length it has already established, and index `len` reads the
; interner's own NUL rather than running off the end.
(defn symbol-byte-at (self:Symbol i:usize):i32
  (return (as i32 (aref (self 'p) (as i64 i)))))

; ---------------------------------------------------------------------------
; The table — open-addressed, power-of-two, linear probing.
;
; Not lib/keyword.nuc's 256-entry linear scan with a `strcmp` per probe: the
; compiler interns tens of thousands of distinct names, and that shape is O(n)
; per intern and capped besides. Not a HashMap either — a HashMap's keys want to
; be interned, so building the interner on it is circular.
; ---------------------------------------------------------------------------
(defconst INTERN-INIT-CAP 1024)

(defvar g-sym-table:ptr null)      ; (ptr ui8)[] — the Symbol bytes, or null
(defvar g-sym-cap:usize 0)         ; always a power of two
(defvar g-sym-count:usize 0)

(defn intern-oom ():void
  (fprintf stderr "intern: out of memory\n")
  (exit 1))

; The interned block for `src`/`n`, NUL-terminated, with its header filled in.
(defn intern-alloc-bytes (src:(ptr ui8) n:usize h:usize):(ptr ui8)
  (let (hdrsz:i64 (as i64 (sizeof SymHeader))
        base:?ptr (malloc (+ hdrsz (as i64 (+ n 1)))))
    (when (= base null) (intern-oom))
    (let (p:(ptr ui8) (as ptr:ui8 (unsafe/ptr+ (as ptr:ui8 base) hdrsz))
          hdr:&SymHeader (unsafe/cast ptr:SymHeader base))
      (set! (hdr 'hash) h)
      (set! (hdr 'len) n)
      (when (> n 0) (memcpy (as ptr p) (as ptr src) (as i64 n)))
      (set! (aref p (as i64 n)) 0)
      (return p))))

; Place an already-interned pointer into `tbl`. Only ever called with a key not
; present, so it stops at the first empty slot without comparing.
(defn intern-place (tbl:ptr cap:usize p:(ptr ui8) h:usize):void
  (let (mask:usize (- cap 1)
        i:usize (bit-and h mask))
    (while (!= (aref (as ptr:ptr tbl) (as i64 i)) null)
      (set! i (bit-and (+ i 1) mask)))
    (set! (aref (as ptr:ptr tbl) (as i64 i)) (as ptr p))))

(defn intern-grow (newcap:usize):void
  (let (nt:?ptr (calloc (as i64 newcap) (sizeof ptr)))
    (when (= nt null) (intern-oom))
    (when (!= g-sym-table null)
      (let (i:usize 0)
        (while (< i g-sym-cap)
          (let (e:?ptr (aref (as ptr:ptr g-sym-table) (as i64 i)))
            (when (!= e null)
              (let (ep:(ptr ui8) (as ptr:ui8 e)
                    es:&Symbol (alloca Symbol))
                (set! (es 'p) ep)
                (intern-place nt newcap ep (symbol-cached-hash @es))))
            (set! i (+ i 1)))))
      (free g-sym-table))
    (set! g-sym-table nt)
    (set! g-sym-cap newcap)))

; The canonical Symbol for these bytes. Two calls with equal bytes return the
; same pointer, which is the whole contract.
(defn symbol-intern-bytes (src:(ptr ui8) n:usize):Symbol
  (when (= g-sym-table null) (intern-grow (as usize INTERN-INIT-CAP)))
  ; Grow at 3/4 load: linear probing degrades sharply past that.
  (when (>= (* (+ g-sym-count 1) 4) (* g-sym-cap 3))
    (intern-grow (* g-sym-cap 2)))
  (let (h:usize (fnv1a-bytes src n)
        mask:usize (- g-sym-cap 1)
        i:usize (bit-and h mask)
        s:&Symbol (alloca Symbol))
    (while true
      (let (e:?ptr (aref (as ptr:ptr g-sym-table) (as i64 i)))
        (when (= e null)
          (let (p:(ptr ui8) (intern-alloc-bytes src n h))
            (intern-place g-sym-table g-sym-cap p h)
            (set! g-sym-count (+ g-sym-count 1))
            (set! (s 'p) p)
            (return @s)))
        (set! (s 'p) (as ptr:ui8 e))
        (when (and (= (symbol-len @s) n)
                   (or (= n 0)
                       (= (memcmp (as ptr (s 'p)) (as ptr src) (as i64 n)) 0)))
          (return @s)))
      (set! i (bit-and (+ i 1) mask)))
    (return @s)))

(defn symbol-intern ((sv (ref StrView))):Symbol
  (return (symbol-intern-bytes (sv 'data) (sv 'len))))

; The by-value convenience beside the by-reference primitive, for the same
; reason `strview-has-prefix` sits beside `strview-starts-with` (library-gaps.md
; #34): address-of is lvalue-only, so a literal and a freshly formatted `fstr`
; result cannot reach the `(ref StrView)` form at all.
(defn symbol-intern (sv:StrView):Symbol
  (return (symbol-intern &sv)))

(defn symbol-from-cstr ((cs CStr)):Symbol
  (return (symbol-intern-bytes (as ptr:ui8 (as ptr cs))
                               (as usize (strlen (as ptr cs))))))

; The exact inverse of `symbol-as-cstr`, for a `Symbol` parked in a
; pointer-shaped slot. Unchecked because nothing in the type says the pointer
; came from the interner — hashing it back through `symbol-from-cstr` would only
; re-find the entry it already is.
(defn symbol-from-cstr-unchecked ((cs CStr)):Symbol
  (let (s:&Symbol (alloca Symbol))
    (set! (s 'p) (unsafe/cast (ptr ui8) (as ptr cs)))
    (return @s)))

; How many distinct names are interned. For diagnostics and the B4 benchmark.
(defn symbol-count ():usize (return g-sym-count))

; Eq is pointer identity — the property the whole layout exists to preserve.
; The bare overloads resolve on their own; the `Eq`/`Hash` conformance RECORDS
; need `numeric`/`hash`, so they are registered in lib/intern-str.nuc.
(defn = (a:Symbol b:Symbol):bool (return (= (as ptr (a 'p)) (as ptr (b 'p)))))
(defn != (a:Symbol b:Symbol):bool (return (!= (as ptr (a 'p)) (as ptr (b 'p)))))

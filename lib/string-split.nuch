; .nuch header for lib/string-split.nuc
(defstruct SplitIter (buf (ptr ui8)) (rem usize) (sep-data (ptr ui8)) (sep-len usize) (done bool) (cur StrView))
(declare split-iter-done ((it (ref SplitIter))) :bool)
(declare split-iter-next ((it (ref SplitIter))) :StrView)
(declare strview-split ((sv (ref StrView)) (sep (ref StrView))) :SplitIter)
(extend SplitIter (Iterator ptr))
(defmethod "@next.pSplitIter" next ((self (ref SplitIter))) (Maybe ptr))
(defstruct LineIter (buf (ptr ui8)) (rem usize) (done bool) (cur StrView))
(declare lines-iter-done ((it (ref LineIter))) :bool)
(declare lines-iter-next ((it (ref LineIter))) :StrView)
(declare strview-lines ((sv (ref StrView))) :LineIter)
(extend LineIter (Iterator ptr))
(defmethod "@next.pLineIter" next ((self (ref LineIter))) (Maybe ptr))
(defmacro doseq-split (binding :rest body) (let (var-sym:ptr ((unsafe/cast ptr:Node binding) (quote car)) iter-ref:ptr ((unsafe/cast ptr:Node ((unsafe/cast ptr:Node binding) (quote cdr))) (quote car)) raw-sym:ptr (gensym)) (quasiquote (doseq-iter ((unquote raw-sym) (unquote iter-ref)) (let (((unquote var-sym) (ref StrView)) (as ptr:StrView (unquote raw-sym))) (unquote-splice body))))))

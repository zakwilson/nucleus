; .nuch header for lib/string-split.nuc
(defstruct SplitIter (buf (ptr ui8)) (rem usize) (sep-data (ptr ui8)) (sep-len usize) (done bool))
(declare split-iter-done ((it (ref SplitIter))) :bool)
(declare split-iter-next ((it (ref SplitIter))) :StrView)
(declare strview-split ((sv (ref StrView)) (sep (ref StrView))) :SplitIter)
(extend SplitIter (Iterator StrView))
(defmethod "@next.pSplitIter" next ((self (ref SplitIter))) (Maybe StrView))
(defstruct LineIter (buf (ptr ui8)) (rem usize) (done bool))
(declare lines-iter-done ((it (ref LineIter))) :bool)
(declare lines-iter-next ((it (ref LineIter))) :StrView)
(declare strview-lines ((sv (ref StrView))) :LineIter)
(extend LineIter (Iterator StrView))
(defmethod "@next.pLineIter" next ((self (ref LineIter))) (Maybe StrView))

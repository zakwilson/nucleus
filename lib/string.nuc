; Stage 11 M6 (S4) — String: the owning, mutable UTF-8 string type.
;
; String is a thin wrapper over `(Vector ui8)`. It owns its byte buffer through
; the Vector's allocator handle and releases it via `Drop` at `with`-scope exit.
; All reading is delegated through a zero-copy `string-as-view` → StrView bridge.
;
; Design: design/stage11/string.md §"S4 String owning type".
;
; ---------------------------------------------------------------------------
; TOKENIZER NOTES (carried from strview.nuc / vector.nuc):
;   - A parameter whose type is a parenthesised form uses the LIST binding form:
;     `(self (ref String))`, never `self:(ref String)`.
;   - `?` and `!` must NOT appear in plain defn names (LLVM IR rejects them).
;     They are fine in generic protocol method names (sanitize-for-ir strips them).
;   - The byte element type is `ui8`; `u8` is not a Nucleus type name.
;   - Vector fields: data:(raw ui8), len:usize, cap:usize, alloc:AllocHandle.
;   - Field access uses the raw `_get` intrinsic: `(_get v len)` reads field `len`
;     from `(ref (Vector T))`. The callable form `(v idx)` indexes (invoke), so a
;     literal field name like `(v len)` would mis-route to invoke — use `_get`.
;   - Drop protocol: `(drop:void (self:ptr:Self))` — ptr, NOT ref.
; ---------------------------------------------------------------------------

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use "string.h")

(extern stderr:ptr)

(import-use allocator)
(import-use coll)
(import-use iterator)
(import-use vector)
(import-use strview)
(import-use strview-str)
(import-use char)
(import-use string-errors)
(import-use string-protocols)
(import-use hash)
(import-use numeric)

; ---------------------------------------------------------------------------
; Struct definition. A String IS-A single-field struct wrapping a Vector ui8.
; All byte storage is in the Vector's heap buffer.
; ---------------------------------------------------------------------------
(defstruct String bytes:(Vector ui8))

; ---------------------------------------------------------------------------
; string-as-view — zero-copy view of the current String contents.
;
; Reads the Vector's data pointer (a `raw ui8`) and len, constructs a StrView
; by value. The StrView borrows the String's buffer; it MUST NOT outlive the
; String.
; ---------------------------------------------------------------------------
(defn string-as-view (self:&String):StrView
  (let (v:&(Vector ui8) (ref self 'bytes)
        len:usize (_get v 'len)
        data:&ui8 (as &ui8 (as ptr (_get v 'data))))
    (let (sv:&StrView (alloca StrView))
      (set! (sv 'data) data)
      (set! (sv 'len) len)
      (return @sv))))

; ---------------------------------------------------------------------------
; Constructors.
; ---------------------------------------------------------------------------

; string-new — empty String with the default (libc) allocator.
(defn string-new ():String
  (let (s:&String (alloca String))
    (vector-init (ref s 'bytes))
    (return @s)))

; string-new-alloc — empty String with an explicit allocator handle (copied in).
(defn string-new-alloc (a:&AllocHandle):String
  (let (s:&String (alloca String))
    (vector-init-alloc (ref s 'bytes) a)
    (return @s)))

; string-with-capacity — empty String (libc allocator) pre-reserving n bytes.
(defn string-with-capacity (n:usize):String
  (let (s:&String (alloca String))
    (vector-init-capacity (ref s 'bytes) n)
    (return @s)))

; ---------------------------------------------------------------------------
; Internal helper: append raw bytes (no UTF-8 check — caller ensures validity).
; Was one `conj` per byte — a capacity test, a bounds test and a call each — on
; the path that appends every byte of the compiler's output (library-gaps.md #5).
; ---------------------------------------------------------------------------
(defn string-push-bytes-raw (self:&String p:&ui8 n:usize):void
  (vector-extend-raw (ref self 'bytes) p n))

; ---------------------------------------------------------------------------
; Mutation methods.
; ---------------------------------------------------------------------------

; string-push-char — append a single Char (always valid UTF-8 by construction).
; Reserves capacity, encodes directly into the tail of the Vector buffer, then
; bumps the len field by the number of bytes written.
(defn string-push-char (self:&String c:Char):void
  (let (v:&(Vector ui8) (ref self 'bytes)
        clen:usize (char-utf8-len c))
    ; Ensure capacity for clen more bytes (reserve takes total slots needed).
    (reserve v (+ (_get v 'len) clen))
    ; Write directly into the raw buffer at offset len.
    (let (dst:&ui8 (unsafe/ptr+ (as &ui8 (as ptr (_get v 'data))) (as i64 (_get v 'len))))
      (char-encode-utf8 c dst)
      ; Bump len by clen.
      (set! (v 'len) (+ (_get v 'len) clen)))))

; string-push-str-unchecked — append a StrView's bytes with no UTF-8 check.
; The caller asserts validity, exactly as `string-from-cstr-unchecked` does.
; This is the appending path for bytes the producer already knows are valid.
(defn string-push-str-unchecked (self:&String s:&StrView):void
  (string-push-bytes-raw self (s 'data) (s 'len)))

; string-push-str — append a StrView's bytes, validating UTF-8 first.
;
; The validation stays: `String` is the UTF-8-guaranteed type and `StrView` is a
; byte slice (`string-from-view` validates for the same reason). What went was
; the per-byte `conj` underneath it — see `string-push-bytes-raw`.
(defn string-push-str (self:&String s:&StrView):!void
  (let (p:&ui8 (s 'data)
        n:usize (s 'len)
        pos:usize 0)
    (while (< pos n)
      (let (rem:usize (- n pos)
            dr:DecodeResult (char-decode-utf8 (unsafe/ptr+ p (as i64 pos)) rem))
        (when (= (&dr 'ok) 0)
          (return (err! invalid-utf8)))
        (set! pos (+ pos (&dr 'nbytes)))))
    (string-push-bytes-raw self p n)
    (return (ok))))

; string-pop-char — remove and return the last codepoint, or none if empty.
(defn string-pop-char (self:&String):?Char
  (let (v:&(Vector ui8) (ref self 'bytes)
        len:usize (_get v 'len))
    (when (= len 0) (return none))
    ; Walk backward to find the start of the last codepoint.
    ; A continuation byte has pattern 10xxxxxx: (b & 0xC0) == 0x80.
    ; The last codepoint start is the last non-continuation byte.
    (let (p:&ui8 (as &ui8 (as ptr (_get v 'data)))
          i:usize (- len 1))
      ; Skip continuation bytes backward.
      (while (and (> i 0)
                  (= (bit-and (as ui32 (aref p (as i64 i))) 192) 128))
        (set! i (- i 1)))
      ; Now i points to the start of the last codepoint. Decode it.
      (let (rem:usize (- len i)
            dr:DecodeResult (char-decode-utf8 (unsafe/ptr+ p (as i64 i)) rem))
        ; Truncate the Vector to i bytes.
        (set! (v 'len) i)
        (when (= (&dr 'ok) 1)
          (return (some (&dr 'ch))))
        ; Invalid byte — return replacement char U+FFFD.
        (return (some (as Char 65533)))))))

; string-clear — set len to 0 (keep capacity).
(defn string-clear (self:&String):void
  (set! ((ref self 'bytes) 'len) 0))

; string-truncate — truncate to byte_len bytes.
; Errors: str-index-out-of-bounds if byte_len > current len;
;         invalid-char-boundary if byte_len falls mid-codepoint.
(defn string-truncate (self:&String byte-len:usize):!void
  (let (v:&(Vector ui8) (ref self 'bytes)
        cur-len:usize (_get v 'len))
    (when (> byte-len cur-len)
      (return (err! str-index-out-of-bounds)))
    ; Check byte boundary: byte_len must not fall on a continuation byte.
    ; A continuation byte has pattern 10xxxxxx (bit-and b 0xC0) == 0x80.
    (when (and (> byte-len 0) (< byte-len cur-len))
      (let (b:ui8 (aref (as &ui8 (as ptr (_get v 'data))) (as i64 byte-len)))
        (when (= (bit-and (as ui32 b) 192) 128)
          (return (err! invalid-char-boundary)))))
    (set! (v 'len) byte-len)
    (return (ok))))

; string-truncate-unchecked — O(1) rewind to a length the caller already knows
; is a boundary, typically a mark it took from `byte-len` before appending. The
; checked form validates and returns `!void`, neither of which a scratch buffer
; that rewinds on every use can act on (library-gaps.md #31).
(defn string-truncate-unchecked (self:&String byte-len:usize):void
  (let (v:&(Vector ui8) (ref self 'bytes))
    (when (< byte-len (_get v 'len))
      (set! (v 'len) byte-len))))

; string-reserve — ensure at least `extra` additional bytes of capacity beyond
; the current length.
(defn string-reserve (self:&String extra:usize):void
  (let (v:&(Vector ui8) (ref self 'bytes))
    (reserve v (+ (_get v 'len) extra))))

; string-as-cstr — a NUL-terminated view of the bytes, for an FFI seam.
;
; Writes the NUL PAST `len` and does not count it, so the String is unchanged as
; far as every other operation is concerned and a second call is free. The
; pointer is invalidated by any subsequent append (library-gaps.md #9).
(defn string-as-cstr (self:&String):CStr
  (let (v:&(Vector ui8) (ref self 'bytes)
        len:usize (_get v 'len))
    (reserve v (+ len 1))
    (let (p:&ui8 (as &ui8 (as ptr (_get v 'data))))
      (set! (aref p (as i64 len)) 0)
      (return (as CStr (as ptr p))))))

; string-shrink-to-fit — shrink capacity to match len.
; Reallocates the buffer to exactly len bytes (or frees if len = 0).
(defn string-shrink-to-fit (self:&String):void
  (let (v:&(Vector ui8) (ref self 'bytes)
        cur-len:usize (_get v 'len))
    (when (= cur-len (_get v 'cap)) (return))  ; already at fit
    (when (= cur-len 0)
      ; Free the buffer entirely.
      (alloc-handle-free (ref v 'alloc) (_get v 'data) (* (_get v 'cap) 1) 8)
      (set! (v 'data) null)
      (set! (v 'cap) 0)
      (return))
    ; Reallocate to exactly cur-len bytes.
    (let ((new-data (raw ui8))
          (alloc-handle-realloc (ref v 'alloc) (_get v 'data) (_get v 'cap) cur-len 8))
      (when (= (as ptr new-data) null)
        (fprintf stderr "string: out of memory in shrink-to-fit\n")
        (exit 1))
      (set! (v 'data) new-data)
      (set! (v 'cap) cur-len))))

; ---------------------------------------------------------------------------
; Validating constructors — copy bytes, check UTF-8.
; ---------------------------------------------------------------------------

; string-from-view — copy a StrView's bytes into a new String, validating UTF-8.
; Returns !String: err invalid-utf8 if the bytes are not valid UTF-8.
(defn string-from-view (sv:&StrView):!String
  ; Validate UTF-8 first.
  (let (p:&ui8 (sv 'data)
        n:usize (sv 'len)
        pos:usize 0)
    (while (< pos n)
      (let (rem:usize (- n pos)
            dr:DecodeResult (char-decode-utf8 (unsafe/ptr+ p (as i64 pos)) rem))
        (when (= (&dr 'ok) 0)
          (return (err! invalid-utf8)))
        (set! pos (+ pos (&dr 'nbytes)))))
    ; Valid — copy bytes into a new String.
    (let (s:&String (alloca String))
      (vector-init (ref s 'bytes))
      (string-push-bytes-raw s p n)
      (return (ok @s)))))

; string-from-cstr-unchecked — copy a CStr's bytes into a new String (no validation).
; The caller must ensure the bytes are valid UTF-8.
(defn string-from-cstr-unchecked ((cs CStr)):String
  (let (p:&ui8 (as &ui8 (as ptr cs))
        n:usize (as usize (strlen (as ptr cs))))
    (let (s:&String (alloca String))
      (vector-init (ref s 'bytes))
      (string-push-bytes-raw s p n)
      (return @s))))

; string-from-cstr — copy a CStr's bytes into a new String, validating UTF-8.
; Returns !String: err invalid-utf8 if the bytes are not valid UTF-8.
(defn string-from-cstr ((cs CStr)):!String
  (let (p:&ui8 (as &ui8 (as ptr cs))
        n:usize (as usize (strlen (as ptr cs))))
    ; Validate UTF-8.
    (let (pos:usize 0)
      (while (< pos n)
        (let (rem:usize (- n pos)
              dr:DecodeResult (char-decode-utf8 (unsafe/ptr+ p (as i64 pos)) rem))
          (when (= (&dr 'ok) 0)
            (return (err! invalid-utf8)))
          (set! pos (+ pos (&dr 'nbytes)))))
      ; Valid — copy bytes.
      (let (s:&String (alloca String))
        (vector-init (ref s 'bytes))
        (string-push-bytes-raw s p n)
        (return (ok @s))))))

; ---------------------------------------------------------------------------
; Drop conformance — String owns its Vector, so Drop delegates to Vector drop.
;
; NOTE: Drop protocol signature is `(drop:void (self:ptr:Self))` — ptr, not ref.
; The `with` machinery calls `(drop &binding)` which gives ptr:String.
; ---------------------------------------------------------------------------
(extend String Drop)
(defn drop (self:&String):void
  (drop (ref self 'bytes)))

; ---------------------------------------------------------------------------
; ByteStr conformance — delegate through string-as-view.
; ByteI = ByteIter (defined in strview.nuc).
; ---------------------------------------------------------------------------
(extend String (ByteStr ByteIter))

(defn byte-len (self:&String):usize
  (let (sv:StrView (string-as-view self))
    (strview-byte-len &sv)))

(defn byte-at (self:&String i:usize):!ui8
  (let (sv:StrView (string-as-view self))
    (strview-byte-at &sv i)))

(defn bytes (self:&String):ByteIter
  (let (sv:StrView (string-as-view self))
    (strview-bytes &sv)))

(defn as-view (self:&String):StrView
  (string-as-view self))

(defn sub-bytes (self:&String start:usize end:usize):!StrView
  (let (sv:StrView (string-as-view self))
    (strview-sub-bytes &sv start end)))

(defn byte-find (self:&String needle:&StrView):?usize
  (let (sv:StrView (string-as-view self))
    (strview-find &sv needle)))

; ---------------------------------------------------------------------------
; Str conformance — delegate through string-as-view.
; CharI = CharIter (defined in strview.nuc).
; ---------------------------------------------------------------------------
(extend String (Str CharIter))

(defn char-count (self:&String):usize
  (let (sv:StrView (string-as-view self))
    (strview-char-count &sv)))

(defn str-empty? (self:&String):bool
  (let (sv:StrView (string-as-view self))
    (strview-empty &sv)))

(defn char-at (self:&String i:usize):!Char
  (let (sv:StrView (string-as-view self))
    (strview-char-at &sv i)))

(defn chars (self:&String):CharIter
  (let (sv:StrView (string-as-view self))
    (strview-chars &sv)))

(defn starts-with? (self:&String prefix:&StrView):bool
  (let (sv:StrView (string-as-view self))
    (strview-starts-with &sv prefix)))

(defn ends-with? (self:&String suffix:&StrView):bool
  (let (sv:StrView (string-as-view self))
    (strview-ends-with &sv suffix)))

(defn contains-str? (self:&String needle:&StrView):bool
  (let (sv:StrView (string-as-view self))
    (strview-contains-str &sv needle)))

; ---------------------------------------------------------------------------
; Eq conformance — byte-content equality via StrView comparison.
; Eq methods take Self by VALUE (see strview.nuc and numeric.nuc patterns).
; ---------------------------------------------------------------------------
(extend String Eq)
(defn = (a:String b:String):bool
  (let (sva:StrView (string-as-view &a)
        svb:StrView (string-as-view &b))
    (strview-eq &sva &svb)))
(defn != (a:String b:String):bool
  (let (sva:StrView (string-as-view &a)
        svb:StrView (string-as-view &b))
    (not (strview-eq &sva &svb))))

; ---------------------------------------------------------------------------
; Ord conformance — byte-lexicographic ordering via StrView comparison.
; Ord methods take Self by VALUE (see strview.nuc pattern).
; ---------------------------------------------------------------------------
(extend String Ord)
(defn < (a:String b:String):bool
  (let (sva:StrView (string-as-view &a)
        svb:StrView (string-as-view &b))
    (if (< (strview-cmp-raw &sva &svb) 0) true false)))
(defn <= (a:String b:String):bool
  (let (sva:StrView (string-as-view &a)
        svb:StrView (string-as-view &b))
    (if (<= (strview-cmp-raw &sva &svb) 0) true false)))
(defn > (a:String b:String):bool
  (let (sva:StrView (string-as-view &a)
        svb:StrView (string-as-view &b))
    (if (> (strview-cmp-raw &sva &svb) 0) true false)))
(defn >= (a:String b:String):bool
  (let (sva:StrView (string-as-view &a)
        svb:StrView (string-as-view &b))
    (if (>= (strview-cmp-raw &sva &svb) 0) true false)))

; ---------------------------------------------------------------------------
; Hash conformance — delegate to strview-hash.
; Hash protocol receiver is (ref Self).
; ---------------------------------------------------------------------------
(extend String Hash)
(defn hash (self:&String):usize
  (let (sv:StrView (string-as-view self))
    (strview-hash &sv)))

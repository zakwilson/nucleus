; Stage 11 cleanup §2 / M6 S3 — StrView: the shared, immutable, non-owning
; byte-slice substrate underneath both `Keyword` (this cleanup) and `String`
; (M6).
;
; Design: design/stage11/cleanup.md §2 ("keyword type on a shared StrView
; substrate") and design/stage11/string.md ("thin wrapper over byte vector").
;
; ---------------------------------------------------------------------------
; WHAT THIS IS (and is NOT)
;
; A StrView is a length-prefixed view over UTF-8 bytes: `{ data, len }`. It is
; length-counted (not NUL-terminated), so it generalises to sub-slices and to
; buffers with embedded NULs. It owns nothing: copying a StrView copies the two
; words, never the bytes; dropping a StrView frees nothing.
;
; S3 adds iterators (ByteIter, CharIter), the full read-layer methods, and the
; ByteStr / Str / Ord protocol conformances.  CharIter and ByteIter hold a raw
; pointer that aliases the StrView's buffer; they MUST NOT outlive the StrView.
;
; ---------------------------------------------------------------------------
; TOKENIZER NOTES (carried from M1/M4):
;   - A parameter whose type is a parenthesised form uses the LIST binding form
;     `(sv (ref StrView))`, never `sv:(ref StrView)`.
;   - The byte element type is `ui8` (= C `unsigned char`); `u8` is not a Nucleus
;     type name (the design doc's `u8` reads as `ui8` here).
;   - A plain-symbol return type in colon position DOES tokenise, so
;     `strview-byte-len:usize` is fine. The colon-paren binding sugar is also live
;     (design §1), so `data:(ptr ui8)` tokenises in a defstruct field.
;   - `?` suffix is fine in generic method names (sanitize-for-ir strips it), but
;     must NOT appear in plain `defn` names (LLVM IR rejects them).
; ---------------------------------------------------------------------------

(import-use "stdio.h")
(import-use "stdlib.h")
(import-use "string.h")

(import-use hash)
(import-use numeric)       ; Eq / Ord protocols (= / != / <)
(import-use char)          ; Char type, char-decode-utf8, DecodeResult
(import-use string-errors) ; str-index-out-of-bounds, invalid-char-boundary
(import-use iterator)      ; (Iterator E)
; NOTE: string-protocols.nuc imports strview, so we CANNOT import it here
; (circular).  The ByteStr/Str conformances for StrView live in strview-str.nuc,
; which imports both strview and string-protocols.

; ---------------------------------------------------------------------------
; The view: a borrowed pointer to the first byte plus a byte count. No NUL is
; required or assumed; `len` is authoritative.
;
; Stage 14 NS-1 (design/stage14/native-strings.md): the `(defstruct StrView
; ...)` itself now lives in lib/prelude.nuc (beside Node/Maybe) so the type is
; registered in every compilation unit, including the reader/macros/bootstrap,
; not just files that `(import-use strview)`. This file keeps every method.
; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
; strview-eq — byte equality. Equal length AND identical bytes. The length test
; comes first so memcmp is only reached for same-length views (and so two views
; of different length never read past either buffer).
; ---------------------------------------------------------------------------
(defn strview-eq ((a (ref StrView)) (b (ref StrView))):bool
  (when (!= (a 'len) (b 'len)) (return false))
  (when (= (a 'len) 0) (return true))
  (let (c:i32 (memcmp (as ptr (a 'data)) (as ptr (b 'data)) (as i64 (a 'len))))
    (return (= c 0))))

; ---------------------------------------------------------------------------
; S3: ByteIter — iterates raw bytes of a StrView in order.
;
; LIFETIME: buf aliases the StrView's buffer; the iterator must not outlive
; the StrView that produced it.
; ---------------------------------------------------------------------------
(defstruct ByteIter
  buf:(ptr ui8)
  pos:usize
  len:usize)

(extend ByteIter (Iterator ui8))

(defn next ((self (ref ByteIter))) (Maybe ui8)
  (when (>= (self 'pos) (self 'len))
    (return none))
  (let (b:ui8 (aref (self 'buf) (as i64 (self 'pos))))
    (set! (self 'pos) (+ (self 'pos) 1))
    (return (some b))))

; ---------------------------------------------------------------------------
; strview-hash — fold every byte of the view through FNV-1a (lib/hash.nuc's
; `fnv1a-byte`, seeded with the same offset basis the scalar/CStr conformances
; use). The fold runs in i64 and the result is cast to usize, matching the Hash
; protocol's return type. This is the length-counted analogue of the CStr Hash
; conformance: it folds exactly `len` bytes instead of stopping at a NUL, so a
; StrView over a buffer with embedded NULs still hashes all of its bytes.
; ---------------------------------------------------------------------------
; A direct byte loop, not `reduce` over a `ByteIter`: the fold spelling cost an
; indirect call and a `(Maybe ui8)` per byte, which made hashing ~8x the work of
; the compiler's own `intern-hash` over the same bytes
; (design/stage17-native-strings/library-gaps.md #30). Same FNV-1a, same result.
(defn strview-hash ((sv (ref StrView))):usize
  (let (p:(ptr ui8) (sv 'data)
        n:usize (sv 'len)
        h:i64 -3750763034362895579
        i:usize 0)
    (while (< i n)
      (set! h (fnv1a-byte h (as i64 (aref p (as i64 i)))))
      (set! i (+ i 1)))
    (return (as usize h))))

; ---------------------------------------------------------------------------
; strview — the value constructor. Building a view was an `alloca` plus two
; `set!`s, spelled out at every site (library-gaps.md #8).
; ---------------------------------------------------------------------------
(defn strview ((data (ptr ui8)) len:usize):StrView
  (let ((sv (ref StrView)) (alloca StrView))
    (set! (sv 'data) data)
    (set! (sv 'len) len)
    (return (deref sv))))

; ---------------------------------------------------------------------------
; CStr bridge.
;
; strview-from-cstr — a StrView whose `data` aliases the C string's own bytes
; and whose `len` is strlen(cs). The view BORROWS the C string's bytes (no
; copy), so the caller must keep the C string alive for the view's lifetime.
;
; Returned BY VALUE, and allocates nothing. It returned a heap `(ptr StrView)`
; until Stage 17 A2 because struct-by-value returns were once unavailable; they
; are not, and crossing an FFI seam is the commonest thing a converted compiler
; does — it must not malloc. design/stage17-native-strings/library-gaps.md #7.
; ---------------------------------------------------------------------------
(defn strview-from-cstr ((cs CStr)):StrView
  (return (strview (as ptr:ui8 (as ptr cs)) (as usize (strlen (as ptr cs))))))

; ---------------------------------------------------------------------------
; strview-to-cstr — reinterpret the view's bytes as a C string. Only sound when
; the underlying buffer is NUL-terminated at `data[len]`; that holds for the
; keyword intern arena (names are stored NUL-terminated) and for any view built
; from a C string. The view itself does not guarantee termination, so callers on
; arbitrary sub-slices must not use this.
; ---------------------------------------------------------------------------
(defn strview-to-cstr ((sv (ref StrView))):CStr
  (return (as CStr (as ptr (sv 'data)))))

; ---------------------------------------------------------------------------
; Protocol conformances.
;
; Hash's receiver is (ref Self), so the StrView Hash conformance takes the view
; by reference and delegates to strview-hash.
;
; Eq is by VALUE (the protocol is `(=:bool (a:Self b:Self))`, and collection key
; comparison loads two K values and calls `(= k1 k2)`), so the StrView Eq
; conformance takes two StrView VALUES. It copies each to a local and takes its
; address (the same `(addr-of k)` idiom the collections use to call Hash) so the
; by-reference strview-eq does the actual byte compare without a second copy.
; ---------------------------------------------------------------------------

(extend StrView Hash)
(defn hash ((self (ref StrView))):usize
  (return (strview-hash self)))

(extend StrView Eq)
(defn = (a:StrView b:StrView):bool
  (let (la:StrView a
        lb:StrView b)
    (return (strview-eq (addr-of la) (addr-of lb)))))
(defn != (a:StrView b:StrView):bool
  (let (la:StrView a
        lb:StrView b)
    (return (not (strview-eq (addr-of la) (addr-of lb))))))

; ---------------------------------------------------------------------------
; S3: CharIter — iterates UTF-8 codepoints of a StrView.
;
; On a valid-UTF-8 sequence every `next` call consumes 1-4 bytes and returns
; (some ch).  On an invalid byte sequence: the bad byte is consumed and
; U+FFFD (the Unicode replacement character) is returned, so iteration always
; terminates without an error path.
;
; LIFETIME: buf aliases the StrView's buffer; the iterator must not outlive
; the StrView that produced it.
; ---------------------------------------------------------------------------
(defstruct CharIter
  buf:(ptr ui8)
  pos:usize
  len:usize)

(extend CharIter (Iterator Char))

(defn next ((self (ref CharIter))) (Maybe Char)
  (when (>= (self 'pos) (self 'len))
    (return none))
  (let (rem:usize (- (self 'len) (self 'pos))
        dr:DecodeResult (char-decode-utf8 (unsafe/ptr+ (self 'buf) (as i64 (self 'pos))) rem))
    (when (= ((addr-of dr) 'ok) 1)
      (set! (self 'pos) (+ (self 'pos) ((addr-of dr) 'nbytes)))
      (return (some ((addr-of dr) 'ch))))
    ; Invalid byte: skip one byte, emit U+FFFD replacement character.
    (set! (self 'pos) (+ (self 'pos) 1))
    (return (some (as Char 65533)))))

; ---------------------------------------------------------------------------
; S3: StrView read-layer — standalone defn helpers.
;
; These are NOT yet protocol conformances; the extend blocks come at the end.
; Splitting helpers from conformances keeps each function independently named
; and callable, and makes the conformance wiring trivial.
; ---------------------------------------------------------------------------

; strview-byte-len — O(1) byte length.
(defn strview-byte-len ((sv (ref StrView))):usize
  (return (sv 'len)))

; strview-byte-at — O(1) byte access with bounds check.
; Errors str-index-out-of-bounds when i >= sv.len.
(defn strview-byte-at ((sv (ref StrView)) i:usize):!ui8
  (when (>= i (sv 'len))
    (return (err! str-index-out-of-bounds)))
  (return (ok (aref (sv 'data) (as i64 i)))))

; strview-bytes — return a ByteIter aliasing sv's buffer (by value).
; Drive with (addr-of it) + next (value-return convention from M2/C2.1).
(defn strview-bytes ((sv (ref StrView))):ByteIter
  (let ((it (ref ByteIter)) (alloca ByteIter))
    (set! (it 'buf) (sv 'data))
    (set! (it 'pos) 0)
    (set! (it 'len) (sv 'len))
    (return (deref it))))

; strview-as-view — identity: return the StrView by value (two-word copy).
(defn strview-as-view ((sv (ref StrView))):StrView
  (return (deref sv)))

; ---------------------------------------------------------------------------
; CStr byte/char iterators.
;
; A ByteIter / CharIter over a NUL-terminated C string (the NUL is excluded;
; the length is strlen(cs)). The iterator BORROWS the C string's bytes and must
; not outlive it. These let a CStr be byte- or char-folded with `reduce` exactly
; like a String (which folds via string-as-view + strview-bytes/-chars), e.g.
; expressing the FNV byte hash as a fold over the byte iterator.
; ---------------------------------------------------------------------------

; cstr-bytes — a ByteIter over the bytes of cs (by value, value-return convention).
(defn cstr-bytes (cs:CStr):ByteIter
  (let ((it (ref ByteIter)) (alloca ByteIter))
    (set! (it 'buf) (as ptr:ui8 (as ptr cs)))
    (set! (it 'pos) 0)
    (set! (it 'len) (as usize (strlen (as ptr cs))))
    (return (deref it))))

; cstr-chars — a CharIter over the UTF-8 codepoints of cs (by value).
(defn cstr-chars (cs:CStr):CharIter
  (let ((it (ref CharIter)) (alloca CharIter))
    (set! (it 'buf) (as ptr:ui8 (as ptr cs)))
    (set! (it 'pos) 0)
    (set! (it 'len) (as usize (strlen (as ptr cs))))
    (return (deref it))))

; strview-sub-bytes — O(1) sub-slice [start, end).
;
; Two distinct errors:
;   str-index-out-of-bounds — start > end, or end > sv.len
;   invalid-char-boundary   — start or end falls on a UTF-8 continuation byte
;                             (bit pattern 10xxxxxx: (b & 0xC0) == 0x80)
;
; Returns the sub-slice BY VALUE. Its `data` borrows the parent StrView's
; buffer, so the parent must outlive it; nothing is allocated and nothing needs
; freeing.
;
; It returned a heap `!ptr:StrView` until Stage 17 A2, on the belief that a
; struct payload could not travel through `!T`. It can (verified 2026-08-31);
; the wrapper was a workaround for a limitation that had already been fixed.
; design/stage17-native-strings/library-gaps.md #11.
(defn strview-sub-bytes ((sv (ref StrView)) start:usize end:usize):!StrView
  ; Range check first.
  (when (> start end)
    (return (err! str-index-out-of-bounds)))
  (when (> end (sv 'len))
    (return (err! str-index-out-of-bounds)))
  ; UTF-8 boundary check: a continuation byte has pattern 10xxxxxx.
  ; start must be 0, sv.len, or a non-continuation byte.
  (when (and (> start 0) (< start (sv 'len)))
    (let (sb:ui8 (aref (sv 'data) (as i64 start)))
      (when (= (bit-and (as ui32 sb) 192) 128)
        (return (err! invalid-char-boundary)))))
  (when (and (> end 0) (< end (sv 'len)))
    (let (eb:ui8 (aref (sv 'data) (as i64 end)))
      (when (= (bit-and (as ui32 eb) 192) 128)
        (return (err! invalid-char-boundary)))))
  ; Build the sub-view — borrow the bytes, return the two words by value.
  (let ((result (ref StrView)) (alloca StrView))
    (set! (result 'data) (unsafe/ptr+ (sv 'data) (as i64 start)))
    (set! (result 'len) (- end start))
    (return (ok (deref result)))))

; strview-find — first byte index of needle in sv, or none.
;
; Empty needle: returns (some 0) — same convention as Rust/C memmem for empty
; pattern.  Needle longer than haystack: returns none.
;
; Was `strview-byte-find`, renamed in Stage 17 B0 so it cannot be misread as the
; single-byte search that now sits beside it (library-gaps.md #10).
(defn strview-find ((sv (ref StrView)) (needle (ref StrView))) (Maybe usize)
  (let (nlen:usize (needle 'len)
        slen:usize (sv 'len))
    ; Empty needle found at index 0.
    (when (= nlen 0)
      (return (some 0)))
    ; Needle longer than haystack: not found.
    (when (> nlen slen)
      (return none))
    ; Linear scan: for each candidate start position, compare nlen bytes.
    (let (limit:usize (- slen (- nlen 1))
          i:usize 0
          found:i32 0
          result:usize 0)
      (while (and (< i limit) (= found 0))
        (let (c:i32 (memcmp (as ptr (unsafe/ptr+ (sv 'data) (as i64 i)))
                            (as ptr (needle 'data))
                            (as i64 nlen)))
          (when (= c 0)
            (set! result i)
            (set! found 1)))
        (set! i (+ i 1)))
      (if (= found 1)
        (return (some result))
        (return none)))))

; ---------------------------------------------------------------------------
; Single-byte, backward, and codepoint search. The compiler reaches for `strchr`
; 37 times and `strstr` 14; none of those should have to materialize a one-byte
; needle view to run a `memcmp` loop (library-gaps.md #10).
; ---------------------------------------------------------------------------

; strview-find-byte — first index of byte b, or none.
(defn strview-find-byte ((sv (ref StrView)) b:ui8) (Maybe usize)
  (let (p:ptr:ui8 (sv 'data)
        n:usize (sv 'len)
        i:usize 0)
    (while (< i n)
      (when (= (aref p (as i64 i)) b) (return (some i)))
      (set! i (+ i 1)))
    (return none)))

; strview-rfind-byte — last index of byte b, or none.
(defn strview-rfind-byte ((sv (ref StrView)) b:ui8) (Maybe usize)
  (let (p:ptr:ui8 (sv 'data)
        i:usize (sv 'len))
    (while (> i 0)
      (set! i (- i 1))
      (when (= (aref p (as i64 i)) b) (return (some i))))
    (return none)))

; strview-rfind — last byte index at which needle occurs, or none.
; Empty needle returns (some len), the mirror of strview-find's (some 0).
(defn strview-rfind ((sv (ref StrView)) (needle (ref StrView))) (Maybe usize)
  (let (nlen:usize (needle 'len)
        slen:usize (sv 'len))
    (when (= nlen 0) (return (some slen)))
    (when (> nlen slen) (return none))
    (let (i:usize (+ (- slen nlen) 1))
      (while (> i 0)
        (set! i (- i 1))
        (when (= (memcmp (as ptr (unsafe/ptr+ (sv 'data) (as i64 i)))
                         (as ptr (needle 'data))
                         (as i64 nlen)) 0)
          (return (some i))))
      (return none))))

; strview-find-char / strview-rfind-char — first/last byte index at which c is
; encoded. UTF-8 is self-synchronizing, so a byte-level search for the encoding
; cannot match inside another codepoint and needs no boundary check.
(defn strview-find-char ((sv (ref StrView)) c:Char) (Maybe usize)
  (let (buf:ptr:ui8 (as ptr:ui8 (alloca ui8 4)))
    (let (n:usize (char-encode-utf8 c buf))
      (when (= n 1) (return (strview-find-byte sv (aref buf 0))))
      (let (nv:StrView (strview buf n))
        (return (strview-find sv (addr-of nv)))))))

(defn strview-rfind-char ((sv (ref StrView)) c:Char) (Maybe usize)
  (let (buf:ptr:ui8 (as ptr:ui8 (alloca ui8 4)))
    (let (n:usize (char-encode-utf8 c buf))
      (when (= n 1) (return (strview-rfind-byte sv (aref buf 0))))
      (let (nv:StrView (strview buf n))
        (return (strview-rfind sv (addr-of nv)))))))

; strview-char-count — O(n): count lead bytes (non-continuation bytes).
; A UTF-8 continuation byte has bit pattern 10xxxxxx: (b & 0xC0) == 0x80.
; Every non-continuation byte starts a new codepoint.
(defn strview-char-count ((sv (ref StrView))):usize
  (let (n:usize 0
        len:usize (sv 'len)
        p:ptr:ui8 (sv 'data))
    (dotimes (i:usize len)
      (let (b:ui8 (aref p (as i64 i)))
        (when (!= (bit-and (as ui32 b) 192) 128)
          (set! n (+ n 1)))))
    (return n)))

; strview-char-at — O(n): nth codepoint (0-indexed).
; Errors str-index-out-of-bounds if i is >= the number of codepoints.
(defn strview-char-at ((sv (ref StrView)) i:usize):!Char
  (let (pos:usize 0
        count:usize 0
        len:usize (sv 'len)
        p:ptr:ui8 (sv 'data)
        done:i32 0)
    (while (and (< pos len) (= done 0))
      (let (rem:usize (- len pos)
            dr:DecodeResult (char-decode-utf8 (unsafe/ptr+ p (as i64 pos)) rem))
        (when (= count i)
          (when (= ((addr-of dr) 'ok) 1)
            (return (ok ((addr-of dr) 'ch))))
          ; Invalid byte at target position: return replacement char U+FFFD.
          (return (ok (as Char 65533))))
        (set! pos (+ pos ((addr-of dr) 'nbytes)))
        (set! count (+ count 1))))
    (return (err! str-index-out-of-bounds))))

; strview-chars — return a CharIter aliasing sv's buffer (by value).
; Drive with (addr-of it) + next (value-return convention from M2/C2.1).
(defn strview-chars ((sv (ref StrView))):CharIter
  (let ((it (ref CharIter)) (alloca CharIter))
    (set! (it 'buf) (sv 'data))
    (set! (it 'pos) 0)
    (set! (it 'len) (sv 'len))
    (return (deref it))))

; strview-empty — true if the view has zero bytes.
(defn strview-empty ((sv (ref StrView))):bool
  (= (sv 'len) 0))

; strview-starts-with — true if sv begins with prefix (byte-level).
(defn strview-starts-with ((sv (ref StrView)) (prefix (ref StrView))):bool
  (let (plen:usize (prefix 'len))
    (when (> plen (sv 'len)) (return false))
    (when (= plen 0) (return true))
    (let (c:i32 (memcmp (as ptr (sv 'data)) (as ptr (prefix 'data)) (as i64 plen)))
      (= c 0))))

; strview-ends-with — true if sv ends with suffix (byte-level).
(defn strview-ends-with ((sv (ref StrView)) (suffix (ref StrView))):bool
  (let (slen:usize (suffix 'len)
        svlen:usize (sv 'len))
    (when (> slen svlen) (return false))
    (when (= slen 0) (return true))
    (let (offset:usize (- svlen slen)
          c:i32 (memcmp (as ptr (unsafe/ptr+ (sv 'data) (as i64 offset)))
                        (as ptr (suffix 'data))
                        (as i64 slen)))
      (= c 0))))

; strview-contains-str — true if sv contains needle as a substring.
(defn strview-contains-str ((sv (ref StrView)) (needle (ref StrView))):bool
  (let ((found (Maybe usize)) (strview-find sv needle))
    (match found
      ((some i) true)
      (none false))))

; ---------------------------------------------------------------------------
; Trim — ASCII whitespace only (space 0x20, tab 0x09, LF 0x0A, CR 0x0D).
; All trim functions return a borrowed StrView (no allocation, just adjusted
; data pointer and/or reduced len).
; ---------------------------------------------------------------------------

; is-ascii-ws — internal helper: true if b is an ASCII whitespace byte.
(defn strview-is-ascii-ws (b:ui8):bool
  (or (= b 32) (= b 9) (= b 10) (= b 13)))

; strview-trim-start — remove leading ASCII whitespace.
(defn strview-trim-start ((sv (ref StrView))):StrView
  (let (p:ptr:ui8 (sv 'data)
        len:usize (sv 'len)
        i:usize 0)
    (while (and (< i len) (strview-is-ascii-ws (aref p (as i64 i))))
      (set! i (+ i 1)))
    (let ((result (ref StrView)) (alloca StrView))
      (set! (result 'data) (unsafe/ptr+ p (as i64 i)))
      (set! (result 'len) (- len i))
      (return (deref result)))))

; strview-trim-end — remove trailing ASCII whitespace.
(defn strview-trim-end ((sv (ref StrView))):StrView
  (let (p:ptr:ui8 (sv 'data)
        len:usize (sv 'len))
    (while (and (> len 0)
                (strview-is-ascii-ws (aref p (as i64 (- len 1)))))
      (set! len (- len 1)))
    (let ((result (ref StrView)) (alloca StrView))
      (set! (result 'data) p)
      (set! (result 'len) len)
      (return (deref result)))))

; strview-trim — remove both leading and trailing ASCII whitespace.
(defn strview-trim ((sv (ref StrView))):StrView
  (let (s:StrView (strview-trim-start sv))
    (return (strview-trim-end (addr-of s)))))

; ---------------------------------------------------------------------------
; S3: ByteStr / Str conformances for StrView live in lib/strview-str.nuc.
;
; They cannot live here because string-protocols.nuc imports strview (for
; StrView in method signatures), creating a circular import if strview also
; imported string-protocols. strview-str.nuc breaks the cycle by importing
; both at the leaf level.
;
; ---------------------------------------------------------------------------
; S3: Ord conformance for StrView — byte-lexicographic ordering.
;
; Compare min(a.len, b.len) bytes with memcmp; if equal, the shorter string
; is less-than (prefix < extension). This matches the standard C string
; ordering convention and Rust's PartialOrd for str.
; ---------------------------------------------------------------------------
(extend StrView Ord)

; strview-cmp-raw — internal helper: negative if a<b, 0 if equal, positive if a>b.
; Uses memcmp on min(a.len,b.len) bytes, then compares lengths on tie.
(defn strview-cmp-raw ((a (ref StrView)) (b (ref StrView))):i32
  (let (alen:usize (a 'len)
        blen:usize (b 'len)
        min-len:usize (if (< alen blen) alen blen))
    (when (> min-len 0)
      (let (c:i32 (memcmp (as ptr (a 'data)) (as ptr (b 'data)) (as i64 min-len)))
        (when (!= c 0) (return c))))
    ; Bytes equal up to min-len; shorter < longer.
    (if (< alen blen) (return -1)
      (if (> alen blen) (return 1)
        (return 0)))))

(defn < (a:StrView b:StrView):bool
  (let (la:StrView a lb:StrView b)
    (if (< (strview-cmp-raw (addr-of la) (addr-of lb)) 0) true false)))
(defn <= (a:StrView b:StrView):bool
  (let (la:StrView a lb:StrView b)
    (if (<= (strview-cmp-raw (addr-of la) (addr-of lb)) 0) true false)))
(defn > (a:StrView b:StrView):bool
  (let (la:StrView a lb:StrView b)
    (if (> (strview-cmp-raw (addr-of la) (addr-of lb)) 0) true false)))
(defn >= (a:StrView b:StrView):bool
  (let (la:StrView a lb:StrView b)
    (if (>= (strview-cmp-raw (addr-of la) (addr-of lb)) 0) true false)))

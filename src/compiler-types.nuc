; Nucleus compiler — core constants and struct definitions

; ============================================================
; Constants
; ============================================================

; A runaway-growth guard, not a preallocation size (g-structs is a Vector).
; Every C struct, opaque forward decl and typedef alias takes a slot, and
; `gtk/gtk.h` alone brings in thousands — 1024 was "too many structs" for it.
(defconst MAX-STRUCTS 16384)
(defconst MAX-CAST-RULES 256)
; Stage 10 unions (design/stage10/unions.md)
(defconst MAX-UNIONS 128)
(defconst MAX-UNION-TEMPLATES 64)
; Stage 11 parametric structs (design/stage11/parametric-structs.md §1)
(defconst MAX-STRUCT-TEMPLATES 64)
; Stage 16 type aliases (design/stage16-ergonomics/container-type-sugar.md §3)
(defconst MAX-TYPE-ALIASES 128)
; §3.6: an alias body is expanded recursively, so a cycle would not terminate.
; A depth cap rather than a visited set — expansion is a plain recursive descent
; with nowhere natural to hang set state, and no honest chain is deep.
(defconst MAX-TYPE-ALIAS-DEPTH 32)
(defconst MAX-ENUMS 128)
(defconst MAX-UNION-ARMS 64)
; Stage 10 errors (design/stage10/errors.md §8): global error-id cap. Ids are
; dense from 1 (0 reserved), so the descriptor table has MAX-DEFERRORS+1 slots.
; The cap keeps every id inside the top-page range A2's future ERR_PTR niche
; encoding needs — no renumbering when U4 lands.
(defconst MAX-DEFERRORS 4095)

; Name kinds for the one-symbol-one-meaning shadowing check (see
; guard-name-kind / binding-noun). These are the *nouns a diagnostic
; says*, not the registries — several registries report the same NK (every type
; registry reports NK-TYPE). The registries themselves are the BK-* rows below;
; priority now lives there, not in these ordinals.
(defconst NK-NONE 0)
(defconst NK-SPECIAL 1)
(defconst NK-BUILTIN 2)   ; a primitive/built-in type name (i32, ptr, ...)
(defconst NK-TYPE 3)      ; a struct type
(defconst NK-PROTOCOL 4)
(defconst NK-MACRO 5)
(defconst NK-FUNCTION 6)
(defconst NK-VALUE 7)     ; defvar / defconst / defenum member / extern

; ============================================================
; Stage 15 B5 — the shared binding interface
; (design/stage15-stress-test/name-resolution.md §13.3 "B+")
; ============================================================
;
; One row per name-keyed registry (§1's eleven, plus the two correctly-global
; name SETS §1 lists separately). The row order IS the resolution priority
; order — the single answer to defect #8, consumed by `guard-name-kind`,
; `emit-dispatch` and `node-type-call` alike.
;
; ENCODING: a kind tag plus a `case` dispatch, deliberately NOT fn-pointer
; struct fields. Three open W9 defects sit in the fn-pointer path — `(= h null)`
; does not compile for a `TY-FN` value (`emit-binop-vals` gates on
; `is-ptr-like`, which excludes `TY-FN`), `type-size` has no `TY-FN` case so a
; fn-pointer slot emits `align 1`, and `coerce-int-val` has no `ptr`→`TY-FN`
; case — so a vtable-shaped table would have had to fix all three first, moving
; the IR of every fn-pointer program to buy nothing this interface needs. A tag
; is still exactly one table; the operations are `case`-dispatched beside it.
(defconst BK-MACRO 0)            ; g-macros
(defconst BK-SPECIAL 1)          ; g-special-form-set + the `unsafe/` roster
(defconst BK-PRIMITIVE 2)        ; g-primitive-type-set
(defconst BK-GENERIC 3)          ; g-generics
(defconst BK-GLOBAL 4)           ; g-globals (a Scope)
(defconst BK-PROTOCOL 5)         ; g-protocols
(defconst BK-STRUCT 6)           ; g-structs
(defconst BK-UNION 7)            ; g-uniondefs
(defconst BK-STRUCT-TEMPLATE 8)  ; g-struct-templates
(defconst BK-UNION-TEMPLATE 9)   ; g-union-templates
(defconst BK-ENUM 10)            ; g-enumdefs
(defconst BK-FNTY 11)            ; fn-type aliases (g-fnty)
(defconst BK-CONFORMANCE 12)     ; the (Type, Protocol) conformance relation
(defconst BK-TYPE-ALIAS 13)      ; g-type-aliases
(defconst BINDING-KIND-COUNT 14)

; The first row `emit-dispatch` probes. Rows 0–2 are answered earlier, by
; `emit-list`'s macro loop and its interned-pointer special-form ladder; a
; primitive type name in head position has no expression meaning and falls to
; the unresolved-name tiers, which say more about it (`unsafe-bare-message`,
; the retired-spelling text) than "not callable" would.
(defconst BK-DISPATCH-FIRST 3)

; One row of the table. `nk` is the noun this registry reports to
; `guard-name-kind`; `noun` is the prose. The three flags say, per row, which
; of the shared concerns this registry actually participates in — a row that
; does not is a stated fact here rather than an omission somewhere else, which
; is the whole reason the table exists (§13.2: NK-PROTOCOL and the four private
; definers were both *silent* omissions).
(defstruct BindingKind
  kind:i32
  noun:StrView
  nk:i32
  ; 1 = a binding of this kind participates in the one-symbol-one-kind rule
  ; (`guard-name-kind` probes it). See `build-binding-kinds` for the rows
  ; that are 0 today and what B4 has to do about them.
  collides:i32
  ; 1 = `binding-probe` can answer for this row at all. 0 for the conformance
  ; relation, which is keyed by a PAIR of names and has no single-name probe.
  name-keyed:i32
  ; 1 = `binding-re-register` can bind this row's payload under a second key
  ; (what `export` needs). 0 raises a located diagnostic naming the kind.
  reregisterable:i32)

; The result of `binding-probe`: a registry hit as a (kind, payload) pair. The
; payload is a bare `ptr` because the eleven registries hold eleven different
; record types; `kind` is what makes it a discriminated union, and every
; consumer must `case` on `kind` before casting. This is the one place an
; untyped pointer is the honest representation rather than an escape hatch.
(defstruct BindingHit
  kind:i32
  payload:ptr)

; Stage 15 B3′ (name-resolution.md §11.6): one re-export alias. `export` binds an
; existing binding under a SECOND key in the facade's namespace, and for
; `g-globals` that is a second `scope-define` — the registry stores one entry per
; key. The other registries store one record per *thing* and key it by a field, so
; a second key cannot live in them; this table is where it lives instead. Consulted
; by each type/protocol reference lookup after its own miss, and gated on
; `g-binding-aliases == null` — which it is for every program in the tree except
; the one facade in `lib/`.
(defstruct BindingAlias
  key:Symbol        ; the facade-namespace key, e.g. `gfacade/Pt`
  kind:i32        ; the BK-* row this payload belongs to
  payload:ptr)

; Stage 15 W8 G-4 (design/global-init.md §4.2): `Sym.defvar-state`, the answer
; to "has this global's `defvar` been REACHED yet?" — a question G-0 made
; distinct from "does this name resolve?". Since G-0 every reachable file's
; `defvar` names are registered by `prescan-value-names` before any form is
; emitted, so a name resolving says nothing about whether its initializer has
; run. Emission registers a SECOND Sym for the same key (scope-define appends,
; scope-lookup scans backwards), so the state a lookup reports flips from
; DECLARED to REACHED exactly when `emit-defvar` runs — no separate registry,
; and immune to the Sym array's realloc-and-memcpy growth, which a saved Sym*
; would not be.
;
; 0 (the arena's zero) means "not a `defvar` global at all" — a function, an
; `extern`, a `defconst`/`defenum` member, a local. Those are outside the rule:
; a constant has no storage to initialize, and another translation unit's
; global is not ours to sequence.
(defconst DEFVAR-DECLARED 1)  ; prescan-defvar-name registered it; not yet emitted
(defconst DEFVAR-REACHED 2)   ; emit-defvar has emitted its @g = global line

; Node struct and NODE-* kinds come from lib/prelude.nuc (imported below).

; Type kinds. TY-TYVAR is an abstract type variable used only by the Stage 9
; rung-4 A2 def-time check of generic bodies; it never reaches codegen (generic
; templates emit only after monomorphization, where every type is concrete).
; TY-CSTR is a C-style (null-terminated) string — ABI-identical to a `char*`
; pointer (lowers to `ptr`), distinct only so `=`/`!=` dispatch to a `strcmp`
; content comparison (Eq) instead of pointer identity. Unicode is out of scope.
; TY-UNION is a Stage 10 untagged union (design/stage10/unions.md §2): size =
; max member size, align = max member align, every member at offset 0. It
; reuses StructDef (with is-union=1) for its member table.
; TY-ERR is the Stage 10 error-code scalar (design/stage10/errors.md §8): a
; distinct builtin type represented as i32 so it is C-legible, but distinguished
; from a plain i32 by `type-eq`/mangling so `with-handler`, the E3 handler check,
; and U4's future niche detection can key on it. `deferror` defines TY-ERR
; constants; the `err` arm of an `!T` (`(Result T Err)`) is TY-ERR.
(defenum TypeKind TY-VOID TY-BOOL TY-I8 TY-I16 TY-I32 TY-I64
                  TY-UI8 TY-UI16 TY-UI32 TY-UI64
                  TY-PTR TY-FN TY-STRUCT
                  TY-F32 TY-F64 TY-TYVAR TY-CSTR TY-UNION TY-ERR
                  ; Stage 11: pointer-sized integer scalars. TY-USIZE is unsigned,
                  ; TY-SSIZE is signed. Both lower to i32/i64 per g-target-ptr-bytes.
                  TY-USIZE TY-SSIZE
                  ; Stage 11 M6 (S0): the Unicode scalar `Char` (design/stage11/
                  ; string.md §"Char types"). A distinct 32-bit built-in scalar over
                  ; `ui32` — the same kind of distinct scalar TY-CSTR is — lowering to
                  ; IR `i32` (C `uint32_t`), so `=`/`!=` dispatch on `Char` and a
                  ; `Char`-vs-int overload stay distinct. Appended last to keep the
                  ; existing TypeKind ordinals unchanged.
                  TY-CHAR
                  ; Stage 15 W8 G-2 (design/global-init.md §5): a fixed-size
                  ; array `(array T N)` — `elem` = T, `arr-len` = N. A STORAGE
                  ; type only: legal as a `defvar` type and a `defstruct` field
                  ; type, refused everywhere else (parse-type-from-node's
                  ; g-array-ok gate). In every value position it DECAYS to
                  ; `(ref T)` — the address of element 0 — exactly as C does,
                  ; via the one shared rule `array-decay` (src/type-utils.nuc).
                  ; Appended last, same reasoning as TY-CHAR above.
                  TY-ARRAY
                  ; Stage 16 FL-1 (design/stage16-ergonomics/c-boundary-defects.md
                  ; §6): the remaining C float widths, named for their
                  ; REPRESENTATION rather than for a C spelling — `long double` is
                  ; x86_fp80 on x86-64/i386, fp128 on aarch64/riscv64 and plain
                  ; double elsewhere, so the C name maps per target the way
                  ; `usize`/`ptr-int-type` already do. Appended last, same
                  ; reasoning as TY-ARRAY above.
                  TY-F16 TY-F80 TY-F128)

; Pointer kinds (Stage 10 nullability, design/stage10/nullability.md). A
; compile-time contract carried on TY-PTR types; all three lower to IR `ptr`
; and are ABI-identical. PTR-RAW is the default (today's unchecked pointer);
; PTR-REF is non-null; PTR-MAYBE is nullable-checked (deref forbidden until
; narrowed). The kind is deliberately ignored by type-eq / hash-type /
; type-mangle-token (like is-volatile), so dispatch, monomorphization, and
; emitted IR are unaffected — only the flow checks read it.
(defconst PTR-RAW 0)
(defconst PTR-REF 1)
(defconst PTR-MAYBE 2)
; PTR-ERRPTR (Stage 10 U4/A2, design/stage10/errors.md §2/§8): a niche-encoded
; (Result (ref T) Err) — a bare pointer carrying the ERR_PTR encoding (ok p =
; p directly; err E = inttoptr(-id), id in 1..4095; is-err = icmp uge against
; -4096). Like the other pkinds it is invisible to type-eq / hash-type /
; type-mangle-token, so a niche `!T` mangles and compares exactly like a `T*`.
(defconst PTR-ERRPTR 3)

; Union layout classes (design/stage10/unions.md §6 — the four ordered niche
; rules). The layout engine (union-layout-classify) decides, in order:
;   ENUM         — all arms payload-less: just the i32 tag (≅ defenum).
;   NICHE-MAYBE  — two arms, one payload-less, one a single typed (ref T) field:
;                  a bare pointer, null = the payload-less arm (== N1's ?T).
;   NICHE-ERRPTR — two arms, one a single typed (ref T) field, one a single Err
;                  field: a bare pointer with the ERR_PTR encoding (== A2's !T).
;   TAGGED       — otherwise: the §3 {i32 tag, union payload} struct.
; The niche rules require the (ref T) payload's element to be present and
; non-void; an elem-less (Result ptr Err) (the reader's !ptr) stays TAGGED so
; the bootstrap is byte-identical (the void* exemption, nullability.md §9.1).
(defconst LAYOUT-ENUM 0)
(defconst LAYOUT-NICHE-MAYBE 1)
(defconst LAYOUT-NICHE-ERRPTR 2)
(defconst LAYOUT-TAGGED 3)
; :repr modes parsed off a defunion form (unions.md §6, §9).
(defconst REPR-AUTO 0)    ; default: the layout engine decides
(defconst REPR-TAGGED 1)  ; :repr tagged: force the §3 struct (C-consumer opt-out)
(defconst REPR-NICHE 2)   ; :repr niche: require a niche, error if not nicheable

; Declaration attributes (Stage 14 AT-1, design/stage14/attributes.md). An
; attribute is a leading keyword literal (`:volatile`) qualifying the declaration
; that follows it; it never enters type identity, dispatch, or name mangling
; (§2). parse-decl-attrs (src/union-registry.nuc) is the registry chokepoint; it
; OR's these DECL-ATTR-* bits into an i32 flag word. Only `:volatile` is a real
; flag today (it lowers to the existing is-volatile Type flag via
; type-with-volatile); `:thread-local` is reserved-with-error (§5). Room for
; future valued attributes (`:align 64`) is left in the registry, none implemented.
;
; `:const` (DECL-ATTR-CONST) is written only on an `extern`; an aggregate
; `defconst` sets it internally. Every other site refuses it (reject-decl-attr-const).
(defconst DECL-ATTR-VOLATILE 1)
(defconst DECL-ATTR-CONST 2)

; Stage 16 PK-2: a `defstruct`'s own attributes, which are properties of the
; TYPE rather than of a declared binding, so they get their own bitset and their
; own scanner (struct-attr-scan) instead of joining the DECL-ATTR-* set.
(defconst STRUCT-ATTR-PACKED 1)

; ============================================================
; Struct definitions (ordered by dependency)
; ============================================================

; One field of a defstruct (Stage 14 §14.4, batch 3a). Replaces StructDef's two
; parallel arrays (field-names/field-types, formerly walked in lockstep by
; index) with one indexable record held in a `(Vector (ref Field))`.
; `name` stays a bare `ptr` (NOT CStr): struct-field-index matches a selector
; against it by **pointer identity** (interned-symbol substrate, NS-5 exclusion
; list); a CStr retype would lower that hot comparison to strcmp. `type` is the
; field's declared Type* (never null in practice; `(ptr Type)` to match the
; stage-14 Type-pointer idiom and every consumer's `t:ptr:Type` parameter).
(defstruct Field
  name:Symbol        ; the field name; identity-compared, so a Symbol says so
  (type ?&Type)  ; field Type*
  ; Stage 16 PK-3: member `__attribute__((aligned(N)))` / `(:align N x:T)`, 0 =
  ; none. Raises the offset this field is placed at (and so the struct's own
  ; alignment); it beats `packed`, which is why abi-field-align consults it
  ; first. Almost always a no-op in real headers — the `aligned(__alignof__(T))`
  ; idiom pins an alignment rather than raising one — but when it does raise,
  ; the gap has to appear as an explicit pad element in the type line.
  align-attr:i32
  ; Stage 16 BF-1: C's `int flags:24`. Three values, not two:
  ;   0  — not a bitfield (every field until one is written)
  ;   >0 — a bitfield of that many bits, held inside a shared storage run
  ;   -1 — an unnamed zero-width member, which allocates nothing and forces the
  ;        next bitfield to the next boundary of its declared type
  ; `type` stays the DECLARED type: it is what sets the boundary the allocator
  ; may not cross and what the struct's own alignment is taken from.
  bit-width:i32
  bf-signed:i32)

; Stage 16 FR-1 (design/stage16-ergonomics/c-boundary-defects.md §8.1): a
; RESOLVED field reference. The old contract at the access sites was "one Nucleus
; field = one LLVM member at the same index", which bitfields break in one
; direction (several fields share one storage unit) and C11 anonymous members
; break in the other (one member holds a nested struct whose fields are named
; from outside, reached by a multi-level GEP). Both are the same broken
; invariant, so the access sites take a descriptor rather than an `i32`.
(defstruct FieldRef
  ; The struct that DECLARES the field — not necessarily the one the access was
  ; written on, once a path runs through an anonymous member (§9 AN-2).
  (owner ?&StructDef)
  index:i32           ; source field index within `owner`
  (type ?&Type)   ; the field's declared type
  ; The GEP chain, outermost first: `psd[j]` is the StructDef whose LLVM type is
  ; indexed at level j, `pidx[j]` the member index within it. Length 1 for every
  ; ordinary field, which is what makes a one-level path today's GEP verbatim.
  psd:ptr
  pidx:ptr
  depth:i32
  ; BF-1: where the value sits inside the storage unit the path addresses.
  ; `bit-width` 0 means "not a bitfield", which is every field until BF-1.
  bit-offset:i32
  bit-width:i32
  bf-signed:i32)

(defstruct StructDef
  ; Stage 15 B3′ (name-resolution.md §8.1 step 1): the CANONICAL registry key —
  ; `<ns>/<bare>` for a type defined inside an explicit `(ns …)`, bare in `user`.
  ; `lookup-struct` matches it by interned-pointer identity, so every writer must
  ; hand it a key `qualify-name`/`ns-qualify-in` produced (or a compiler-minted
  ; name, which is `user` by construction). A source *spelling* resolves to a key
  ; through `struct-lookup-ref`; the two are different questions (§9.2).
  name:Symbol
  ; The LLVM-safe spelling of `name` for IR emission: the defining namespace's
  ; ir-prefix composed onto the bare name with `?`→`_QMARK`, `!`→`_BANG`
  ; (ir-name-token) — `dp/Fox` prints `%dp__Fox`. Every other char (hyphens
  ; included) is unchanged, so `ir-name == name` for every `user` type and the
  ; whole self-IR is byte-identical. `ir-name` is what every `%Name` reference and
  ; definition prints, and (B3′) what `type-mangle-token` returns, so a mangled
  ; symbol never carries a `/`. Computed once in register-struct — the single
  ; StructDef allocator (SM-4).
  ir-name:Symbol
  ; The ir-prefix snapshot taken at REGISTRATION, exactly as `Generic.ir-prefix`
  ; is and for the same reason: a stamp or a finalize may run while another
  ; namespace is current, so the prefix must come from the key rather than from
  ; `g-current-ns` at the point of use. The empty Symbol for `user`.
  ir-prefix:Symbol
  ; Null until struct-set-fields: a name-only pre-registered struct has none yet.
  (fields ?&(Vector &Field))
  num-fields:i32    ; == (count fields); cached length for i32 loops (hot: struct-field-index/ABI)
  emitted:i32       ; defined: its line is written or queued (vs. name-only pre-registration)
  ; Stage 16 R4 (design/stage16-ergonomics/repl-libraries.md §3.3): WHICH buffer
  ; holds that line. `emitted` cannot answer "is it in the module being assembled"
  ; once a process assembles more than one module.
  emit-epoch:i32    ; g-module-epoch when the line was written; 0 = never written
  in-type-buf:i32   ; it went to the module's TYPE buffer, the one the REPL carries forward
  in-preamble:i32   ; it is in g-repl-preamble, so it is in every module from here on
  queued:i32        ; on g-pending-unions, so a drain will write it once its fields are in
  ; Stage 15 W9 item 40: the field table has been populated. `emitted` used to
  ; answer this too, because the two happened in one statement; the layout
  ; prescan separates them (it lays a struct out and writes no IR), so "has a
  ; layout" needs its own bit. Set by `struct-set-fields`, the single chokepoint
  ; every field-populating path funnels through, so no builder can miss it.
  ; Unlike `num-fields != 0` it distinguishes a legitimate `(defstruct Empty)`
  ; from a name-only pre-registration.
  laid-out:i32
  src-file:Symbol     ; source file where defined (cheader/anon struct provenance)
  src-line:i32
  ; --- Stage 15 W3a: opaque (forward-declared) C types ---
  ; 1 = the type's NAME is known but its LAYOUT is not: a C header forward
  ; declaration (`struct Foo;` / `typedef struct Foo Foo;`) with no body in any
  ; header we parsed, or a body the C parser could not represent. Such a type is
  ; legal only behind a pointer (`ptr:Foo` / `(ref Foo)` — the C opaque-handle
  ; idiom); every use that needs a size or a layout is rejected with a located
  ; diagnostic (reject-opaque-type, src/type-utils.nuc) instead of emitting a
  ; reference to an LLVM type that was never defined. Cleared by
  ; struct-set-fields — the single chokepoint that gives a StructDef its layout —
  ; so a later full definition upgrades the entry in place.
  opaque:i32
  ; For a C `typedef struct Tag Name;` alias, the StructDef of `Tag`. The alias
  ; is a separate registry entry (lookup-struct is keyed by name) that shares the
  ; tag's shape; this link is what lets a later `struct Tag { … }` body upgrade
  ; every alias registered before it (struct-upgrade-aliases, src/cheader.nuc).
  ; null for every non-alias StructDef.
  (alias-of ?&StructDef)
  ; --- Stage 16 PK-1 (design/stage16-ergonomics/c-boundary-defects.md §7) ---
  ; 1 = `__attribute__((packed))` / `(defstruct :packed …)`: every field sits at
  ; the next byte with no padding and the struct's own alignment is 1. Three
  ; consequences, and the third is the one that is not a flag: the IR type line
  ; prints `<{ … }>`, the ABI walks skip `abi-align-up`, and every load/store
  ; through a field must carry `align 1` or the IR states an alignment the layout
  ; does not provide.
  packed:i32
  ; Stage 16 PK-3: `__attribute__((aligned(N)))` / `(defstruct :align N …)`, 0 =
  ; none. A DIFFERENT mechanism from `packed`, not a second flag on it: it raises
  ; the struct's own alignment (never lowers it) and so grows `sizeof` by tail
  ; padding, while the field offsets are untouched. LLVM does not model it, so
  ; the growth has to be an explicit `[k x i8]` in the type line and every
  ; alloca/global of one has to say `align N`.
  align-attr:i32
  ; --- Stage 10 unions ---
  is-union:i32      ; 1 = untagged union: all fields at offset 0, size = max member
  (udef ?&UnionDef) ; UnionDef* when this struct is a defunion backing struct, else null
  ; --- Stage 11 parametric structs (T2): origin of a stamped template instance ---
  ; For a struct produced by struct-template-stamp-types these record which
  ; template it came from and the concrete type arguments, so the method unifier
  ; can recover (template, args) from a concrete `Vector.i32` and bind a tyvar
  ; pattern `(Vector T)` against it. null/0 for an ordinary hand-written struct.
  (origin-template ?&StructTemplate) ; StructTemplate* this instance was stamped from, or null
  origin-args:ptr     ; ptr array of concrete arg Type* (length origin-nargs), or null
  origin-nargs:i32
  ; --- Stage 15 B5: the shared binding interface's `is-private` / `src-ns` ---
  ; `defstruct-` had no carrier for its own privacy before B5 (§13.2), so
  ; nothing enforced it. Privacy for a type is NAMESPACE-level, per W5e's
  ; deliberate split: a type name is bare-keyed and globally identified
  ; (Stage 12 decision 9), so file-scoping it is a separate, larger question.
  priv:i32
  src-ns:Symbol
  ; Declared by a C header, so its tag does not displace a same-named C constant.
  from-c:i32)

; One arm of a defunion (Stage 14 §14.4). Replaces UnionDef's five parallel
; arm arrays (arm-names/arm-ptypes/arm-fnames/arm-ftypes/arm-nfields, formerly
; walked in lockstep by index) with one indexable record held in a
; `(Vector (ref Arm))`. `ptype` is the arm's payload type: null (payload-less),
; the single field's type (one field), or a memoized anon struct (several).
; `fnames`/`ftypes` are the per-arm ragged field-name/field-type C arrays (a
; later 14.4 sub-step folds these into a `Field{name,type}` element).
(defstruct Arm
  name:Symbol           ; interned arm name
  (ptype (ptr Type))  ; payload Type*, or null for a payload-less arm
  fnames:ptr          ; per-arm ptr array of interned field-name strings, or null
  ftypes:ptr          ; per-arm ptr array of field Type*s, or null
  nfields:i32)        ; field count for this arm

; A tagged sum (defunion, design/stage10/unions.md §3). The backing
; representation is an ordinary struct {tag:i32, payload:(union ...)} held in
; `sdef`; this record carries the arm table `match` and `make` need.
(defstruct UnionDef
  name:Symbol
  (sdef &StructDef)      ; backing StructDef (tag [+ payload])
  (union-sd ?&StructDef)  ; payload union's StructDef (one member per payload arm), or null
  num-arms:i32                ; == (count arms); cached length for i32 loops
  arms:&(Vector &Arm) ; the arm table (was five parallel arm-* arrays)
  ; --- Stage 10 U4 niche layout (design/stage10/unions.md §6) ---
  layout:i32        ; LAYOUT-ENUM / NICHE-MAYBE / NICHE-ERRPTR / TAGGED
  (niche-elem ?&Type) ; for NICHE-MAYBE/ERRPTR: the (ref T) payload's element Type*
  src-line:i32
  priv:i32          ; Stage 15 B5 — see StructDef.priv
  src-ns:Symbol
  src-file:Symbol     ; Stage 15 B4 — see StructDef.src-file (redefinition blame)
  ; Stage 15 W9 item 40: the arm CONSTRUCTORS have been emitted. A UnionDef used
  ; to be created only by `emit-defunion`, so its mere existence meant both "this
  ; type is registered" and "its constructors are compiled"; the layout prescan
  ; separates them, and `emit-defunion` reads this to tell its own prescan entry
  ; (register, keep going) from a REPL re-emission of the same form (no-op).
  ctors-emitted:i32
  ; Stage 21 PK-4b: the stamping origin, as StructDef's, so the pattern
  ; unifier can peel a `?T` / `!T` sigil off a stamped `Maybe.X` / `Result.X.Err`.
  (origin-template ?&UnionTemplate)
  origin-args:ptr
  origin-nargs:i32)

; A parameterized defunion template: `(defunion (Result T E) ...)`. Defines no
; type itself; a fully-applied use `(Result A B)` stamps a concrete instance.
(defstruct UnionTemplate
  name:Symbol
  tyvars:ptr        ; ptr array of tyvar-name Symbols
  ntv:i32
  (form ?&Node) ; retained (defunion (Name T ...) arms...) Node*
  priv:i32          ; Stage 15 B5 — see StructDef.priv
  src-ns:Symbol
  ; Stage 15 B4 (R4): where this name was defined, so a redefinition names the
  ; definition it collides with. Zero/null when the record was minted by
  ; something other than a source definer, which `die-redefinition` handles.
  src-file:Symbol
  src-line:i32
  src-imports:?&ImportVec) ; the arms are this file's text — see NameEnv

; A parameterized defstruct template: `(defstruct (Vector T) ...)`. Defines no
; type itself; a fully-applied use `(Vector i32)` in type position stamps a
; concrete monomorphic StructDef (struct-template-stamp-types). Exact analogue
; of UnionTemplate (design/stage11/parametric-structs.md §1).
(defstruct StructTemplate
  name:Symbol
  tyvars:ptr        ; ptr array of tyvar-name Symbols
  ntv:i32
  (form ?&Node) ; retained (defstruct (Name T ...) field-specs...) Node*
  priv:i32          ; Stage 15 B5 — see StructDef.priv
  src-ns:Symbol
  src-file:Symbol     ; Stage 15 B4 — see UnionTemplate.src-file
  src-line:i32
  src-imports:?&ImportVec) ; see UnionTemplate.src-imports

; Stage 16: `(deftype Name Type)` — a second spelling for one type, not a new
; one (container-type-sugar.md §3.2). `body` is the retained type expression,
; re-parsed on each use, so declaration order inside a file does not matter.
(defstruct TypeAlias
  name:Symbol
  (body ?&Node)
  ; §3.7 phase 2: `(deftype (Table V) …)` — the declared parameter names, whose
  ; occurrences in `body` are replaced by the argument NODES at each use. Node
  ; substitution, not spelling substitution as StructTemplate does, because an
  ; argument may still be a free tyvar in a method receiver pattern.
  tyvars:ptr        ; ptr array of tyvar-name Symbols; null when ntv is 0
  ntv:i32           ; 0 for a plain alias
  priv:i32          ; Stage 15 B5 — see StructDef.priv
  src-ns:Symbol
  src-file:Symbol     ; Stage 15 B4 — see UnionTemplate.src-file
  src-line:i32
  src-imports:?&ImportVec) ; the body is this file's text — see NameEnv

; A defenum's member table, recorded so `match` can check exhaustiveness over
; enum constants (the §4 freebie). Member i's value is i.
(defstruct EnumDef
  name:Symbol
  members:ptr       ; ptr array of member-name Symbols
  num-members:i32
  priv:i32          ; Stage 15 B5 — see StructDef.priv
  src-ns:Symbol
  src-file:Symbol     ; Stage 15 B4 — see UnionTemplate.src-file
  src-line:i32)

(defstruct Type
  kind:i32
  (ret (ptr Type))
  ; Stage 14 §14.4: the TY-FN parameter list as one `(Vector (ref Field))` (was
  ; the two parallel arrays `params` (Type*[]) and `param-names` (name string[])).
  ; Each param is a `(ref Field)` whose `type` is the param's declared Type;
  ; `name` is left null — `param-names` was dead storage (no builder ever
  ; populated it, and the REPL renders positional pN). `num-params` is the cached
  ; count, kept as the shared length so every `(dotimes (i (ft num-params)))` loop
  ; stays intact. Reads go through `field-at` (abi.nuc); builds through
  ; `type-set-params` (abi.nuc). Nullable: a zero-param or non-fn Type leaves it
  ; null, and `field-at` is reached only under num-params>0 loops.
  (params ?&(Vector &Field))
  num-params:i32
  variadic:i32
  has-rest:i32
  (elem (ptr Type))
  (sdef (ptr StructDef))
  ; --- Stage 8 additions ---
  nopt:i32          ; number of trailing :optional params (TY-FN)
  ; A *ragged tail* array of length `nopt` (NOT `num-params`): the default-value
  ; Node* forms for only the trailing `nopt` :optional params, indexed 0..nopt-1
  ; (slot k ↔ param index `required + k`, where required = num-params - nopt).
  ; Because it is not a parallel array to `params`, it stays a raw ptr[] (like
  ; Constraint.args / Arm.fnames) rather than folding into the Field record.
  opt-defaults:ptr  ; array of ptr:Node default forms for the trailing :optional params
  ; Volatile qualifier: when set, loads/stores at this type's storage site are
  ; emitted as `load volatile`/`store volatile`. Primitive singletons are shared,
  ; so volatility is represented by cloning the Type via type-with-volatile.
  is-volatile:i32
  ; Pointer kind (Stage 10): PTR-RAW / PTR-REF / PTR-MAYBE for TY-PTR.
  ; Shared Types are never mutated — clone via type-as-pkind.
  pkind:i32
  ; Stage 15 W8 G-2: element count of a TY-ARRAY (`elem` carries T). Zero for
  ; every other kind. Read by type-to-ir / abi-sizeof / abi-class-eightbyte /
  ; type-eq / hash-type / the constant-aggregate renderer; anything that CLONES
  ; a Type must copy it (type-with-volatile, src/nucleusc.nuc — the one such
  ; site today).
  arr-len:i32)

; Node struct comes from lib/prelude.nuc (imported below).

(defstruct Sym
  ; The scope KEY, fully qualified for a global. A `Symbol`, so `scope-frame-find`'s
  ; per-probe `strcmp` is an `icmp` — the keys were always interned, and until
  ; C7-4 the type did not say so.
  name:Symbol
  (type (ptr Type))
  ; The IR text that refers to this symbol: `@name` for a global, `%x.addr.7`
  ; for a local. A `StrView` and not a `Symbol` because the local population
  ; dominates by orders of magnitude and carries a per-binding counter, so
  ; interning it would buy an identity nothing asks about (C7-4b). The two
  ; callers that DO need identity are global-only and intern at their own
  ; boundary — `program-defn-record` and the macro-JIT declare set. Empty means
  ; "no ir-name", the `Val.val` convention.
  ir-name:StrView
  is-local:i32
  is-const:i32
  const-val:StrView
  ; Stage 15 W2b (design/stage15-stress-test/literal-typing.md): this `is-const`
  ; symbol stands for a bare INTEGER LITERAL, so a reference to it adapts at a
  ; use site exactly as the literal it names would (`(<= ans:ui32 K)` compiles
  ; iff `(<= ans:ui32 512)` does — naming a constant must not change how it
  ; types). Set by `defconst`/`defenum` (and the REPL's hand-registered NODE-*
  ; mirror); deliberately NOT set by `deferror`, whose constants are `Err`-typed
  ; and must never unify with a plain integer. `const-lit-i64` carries the VALUE,
  ; not just the flag, so the emitted Val can be tagged `is-lit`/`lit-i64` and
  ; the LW-4 range check in coerce-int-val rejects an out-of-range narrowing
  ; instead of silently wrapping it.
  const-lit:i32
  const-lit-i64:i64
  ; A non-integer `defconst`'s literal, re-emitted at each use (stage21-cleanup/defconst-values.md).
  (const-node ?&Node)
  ; An annotated `defconst` has its annotation's type and never adapts.
  const-annot:i32
  tracker:ptr
  ; --- Stage 8 / REPL introspection additions ---
  src-file:Symbol     ; source file where defined (null if unknown)
  src-line:i32      ; source line where defined (0 if unknown)
  trace-tracker:ptr ; resource tracker for a REPL-installed trace wrapper (LLVM opaque)
  ; The impl address `@<name>.tgt` held before `trace` repointed it, restored by
  ; `untrace`. A JIT'd code address, so `ptr` — the Stage 14 retype to `StrView`
  ; described a field nothing read (design/stage18-tooling §1.1).
  trace-saved:ptr
  ; The docstring of a `defn` whose body's first form is a string literal, per
  ; docs/toplevel.md. Read by `doc` and `apropos`.
  docstring:Symbol
  ; --- Stage 10 safety (lifecycle + nullability) ---
  (home ?&Scope)  ; defining Scope* (escape analysis compares scope nesting)
  (taint ?&Scope) ; owning with-Scope* (or, Stage 13 L1, frame-region Scope*) this value aliases (null = clean)
  taint-frame:i32   ; Stage 13 L1: 1 = `taint` is a frame-region (`&x` of a plain local), not a with-resource
  owns:i32          ; 1 = this binding armed a `with` cleanup (owning binding)
  moved:i32         ; 1 = consumed by (move ...); any further use is an error
  cslot:StrView     ; cleanup slot IR name when owns=1 (move disarms by storing null)
  (ntype ?&Type) ; flow-narrowed type override (?T read as (ref T)); null = none
  ndepth:i32        ; g-loop-depth at which the current narrow was established
  kstamp:i32        ; bumped on each kill (reassignment); stale undo entries skip
  ngen:i32          ; g-narrow-gen when `ntype` was set: a global's narrow must not outlive its function
  ; Stage 10 Phase F1 (nullability.md §9 finding 1): the callee never returns
  ; (die-at, repl-throw, libc exit/abort). A statement-position call to it
  ; emits `unreachable` and terminates the block, so the (when (= x null)
  ; (die-at …)) guard idiom narrows past the guard via emit-cond's g-block-term
  ; accumulation — no narrowing-engine change needed.
  noreturn:i32
  ; The callee can return a second time (the setjmp family). Unlike `noreturn`
  ; it rides only the emitted `declare` — a Nucleus `defn` cannot claim it.
  returns-twice:i32
  ; Stage 12 N3: symbol is private — not importable from another namespace.
  ; Set by `defn-`, `defvar-`, `defconst-`, `defenum-` (private member values).
  ; For link-emitting forms, also implies internal LLVM linkage.
  sym-private:i32
  ; Read-only storage: an aggregate `defconst` or an `extern :const`. Not
  ; `is-const`, which means substitution with no storage at all.
  readonly-global:i32
  ; Stage 15 W8 G-4: DEFVAR-DECLARED / DEFVAR-REACHED / 0 — see the comment at
  ; those two constants. Written only by `prescan-defvar-name` (1) and
  ; `emit-defvar` (2); read only by `defvar-check-init-order`, which is on a
  ; dying path, so no emitted IR depends on it.
  defvar-state:i32
  ; Stage 15 W9 defect 12: this signature came from a `declare` — a prototype the
  ; user ASSERTS — rather than from a `defn` whose body the compiler has seen.
  ; Nucleus has no `...` spelling, so a C variadic function is declared with its
  ; fixed parameters only and the extra arguments ride the call site
  ; (docs/toplevel.md `declare`; `:rest`/`:optional` are refused in a
  ; declaration). The call-arity rule therefore admits a LONGER argument list
  ; against a declared signature; too FEW arguments is still an error. Set only
  ; in emit-nuch-declare-import. A C-header-imported function is unaffected: it
  ; carries a real `variadic` flag from the header and is checked exactly.
  extern-decl:i32
  ; Stage 16: bound while an `(import-ct …)` was in progress, so the definition
  ; behind it was registered but never emitted. Program code may not reference
  ; one; a macro/CT JIT module may, because it resolves against the compiler
  ; process. Set only in `scope-define`, read only by `reject-ct-only`.
  ; design/stage16-ergonomics/compile-time-imports.md §4a.
  ct-only:i32
  ; A C header's integer constant, which any Nucleus definition of the name
  ; displaces (`cheader-define-int-const`, `cconst-yield`).
  c-const:i32
  ; Appended at the END deliberately: inserting a field mid-struct shifts the
  ; GEP index of every field after it in every function that touches one, which
  ; would bury this change's real bootstrap diff under hundreds of unrelated
  ; index edits. Field order carries no meaning here — `new Sym` zero-fills and
  ; access is by interned name through struct-field-index.
  )

; One armed scope-exit cleanup (Stage 10 lifecycle, design/stage10/lifecycle.md).
; Stage 14 §14.6 (the defunion pilot): this was a defstruct whose doc-comment
; said "exactly one shape is set" and whose three shapes were dispatched by
; null-probing (drop-fn/defer-node) in a `cond` inside emit-scope-cleanups — a
; closed sum masquerading as a struct. It is now a defunion, so the tag makes the
; three shapes exhaustive and the dispatch is a match (union-emit's exhaustiveness
; check). The three arms:
;   libc-free — legacy libc free(slot) at scope exit (free(NULL) is a no-op, so a
;               slot disarmed via (set! name null) / `move` is safe).
;   drop      — Drop-protocol call: load slot, null-guard, statically dispatch to
;               `dropfn` (the resolved drop method's ir-name); `dropret` types the
;               call (void or a returned value). The legacy `drop-ty` field was
;               write-only (set at construction, never read anywhere) — dropped.
;   defer     — an ad-hoc (defer expr): re-emit `node` in `scope` at each exit.
; Field types: `slot`/`dropfn` are IR-name strings consumed by fprintf %s so they
; stay `ptr` (matching the fields they replace and Method.ir-name); `dropret` is a
; nullable Type* ((ptr Type), matching Method.ret-type); `node`/`scope` mirror
; emit-node's ((ptr Node), (ref Scope)) arguments. `Cleanup` is a compiler-runtime
; type only (never appears in emitted user/JIT IR), so the (Maybe <struct>) JIT
; gotcha does not apply — its dispatch is on the emit path exclusively.
(defunion Cleanup
  (libc-free (slot StrView))
  (drop (slot StrView) (dropfn Symbol) (dropret ?&Type))
  (defer (node ?&Node) scope:&Scope))

; A narrowing undo entry (Stage 10 nullability §4). Restores are skipped when
; the binding's kstamp moved past `stamp` — a kill (reassignment) is sticky.
(defstruct NarrowUndo
  name:Symbol
  scope:&Scope
  (old-ntype ?&Type)
  old-ndepth:i32
  old-ngen:i32
  stamp:i32)

(defstruct Scope
  (parent ?&Scope)
  syms:ptr
  len:i32
  cap:i32
  ; Stage 14 §14.5 batch 5: was a hand-rolled ptr[]/ncleanups/ccleanups triple
  ; with a manual cap-doubling grow thunk (scope-push-cleanup); now a Vector.
  ; Non-null: set once by scope-new and never reset.
  cleanup-slots:&(Vector &Cleanup))

(defstruct StrLit
  ; The bytes are copied into the arena because the source buffer they were read
  ; from may be a `String` the caller drops (the REPL's per-entry input).
  bytes:StrView
  len:i32
  id:i32)

(defstruct Val
  (type (ptr Type))
  ; The value's IR text — `%t42`, `@name`, `zeroinitializer`, a constant. Empty
  ; (arena zero-init) for a void Val, which is the only thing the old null meant.
  val:StrView
  ; Stage 10 escape analysis: owning with-Scope* this value aliases (null =
  ; clean). Propagated through identity-preserving ops (cast, ptr+, .&, phi);
  ; dropped by value-copying ops (deref, field load, calls).
  (taint ?&Scope)
  ; Stage 13 L1 (lambda.md §"Lifetime and escape analysis"): 1 when `taint` is a
  ; *frame-region* — the scope of a plain let/with/param storage whose address
  ; was taken (emit-ref's new source) — rather than a `with`-OWNED resource.
  ; Both kinds escape via `return` (the function-frame boundary, enforced now);
  ; but a frame-region pointer stored into other frame memory is an intra-frame
  ; borrow, so the *store* sinks enforce only with-taint (taint-frame == 0).
  ; Nested-region store precision is deferred (see lambda.md §Deferred).
  ; Propagated alongside `taint` by every identity-preserving op.
  taint-frame:i32
  ; Stage 14 LW-4 (int-widening.md §"LW-4"): 1 when this Val is an integer
  ; literal whose exact value is known (set only by emit-int). `lit-i64` then
  ; holds that value. Lets the coercion chokepoint (coerce-int-val) reject an
  ; out-of-range literal — `(take8 300)` — at compile time instead of silently
  ; truncating, without needing the source Node at the coercion site. Cleared
  ; (0) on every non-literal Val (arena zero-init) and never re-set by coercion,
  ; so a value that has already been widened is not re-checked.
  is-lit:i32
  lit-i64:i64
  ; Stage 15 W2d (design/stage15-stress-test/literal-typing.md §3.6): the float
  ; counterpart of is-lit/lit-i64 — 1 when this Val is a *float* literal whose
  ; exact value is known (set only by emit-float), with `lit-f64` holding the
  ; value the reader's lexeme denotes. A bare float literal is typed f64, so
  ; without this the coercion chokepoint (coerce-int-val) could only reach an
  ; f32 target by emitting an `fptrunc` of a double constant; with it the
  ; literal is re-rendered at the target width as a plain LLVM constant, no
  ; instruction — exactly the courtesy an integer literal has had since LW-4.
  ; A DELIBERATELY separate flag rather than a third overload of `is-lit`
  ; (which already means "int literal" and, with a StrView type, "unmaterialized
  ; string literal"): every existing `is-lit` reader would otherwise have to be
  ; audited for float reachability, and two of them (abi-arg-frag, the variadic
  ; StrView collapse) sit on the vararg path where a float genuinely appears.
  ; Cleared (0) on every non-literal Val (arena zero-init) and never re-set by
  ; coercion, so an already-narrowed value is not re-folded.
  is-flit:i32
  lit-f64:f64
  ; Stage 16 FL-3: the literal's own LEXEME, kept beside the f64 value because
  ; a hex float carries more precision than the value does — re-rendering an
  ; f80/f128 slot from `lit-f64` would silently drop it. `symbol-none` for
  ; every other Val (arena zero-init), which is what selects the f64 path below.
  lit-lex:Symbol
  ; Stage 15 W9 item 20: 1 when this Val is the literal `null` (set only by
  ; emit-symbol-ref's `null` arm). Same shape and same reason as is-lit/is-flit
  ; above — the coercion chokepoint needs a fact only the emitter knows, and
  ; cannot see the source Node.
  ;
  ; A third flag rather than a test on the Val: `null` is typed `ty-ptr`, the
  ; singleton a bare `ptr` binding carries, so type alone cannot tell the literal
  ; from a loaded pointer. That distinction is the whole rule here: `null` may land
  ; in a function-pointer slot, an arbitrary data pointer may not — `fn`<->`ptr`
  ; is unsafe/cast's job (docs/types.md) and laundering data into something
  ; callable is strictly worse than laundering it into a char*.
  ; Cleared (0) on every other Val by arena zero-init.
  is-nlit:i32
  ; Stage 17: the binding this value was LOADED from, or null — the Val's
  ; lvalue-ness, which only the emitter knows. Set solely by
  ; emit-symbol-ref-bound's load arm, so a call result, a literal, or any
  ; derived value has it null (arena zero-init) and is not an lvalue.
  ; design/stage17-native-strings/borrow-conventions.md §3.4.
  (lvalue-sym ?&Sym))

; ---- Aggregate ABI lowering (Stage 8 Phase C, x86_64 System V) ----
; How a struct-by-value parameter or return is lowered to the platform C ABI.
; Only TY-STRUCT is ever non-DIRECT, so every scalar/pointer path is unchanged.
;   ABI-DIRECT  — passed/returned as-is (all scalars, pointers).
;   ABI-MEMORY  — >16 bytes: param is `ptr byval(%T)`, return is `sret` (hidden
;                 leading pointer param, function returns void).
;   ABI-COERCE1 — ≤8 bytes: one eightbyte, coerced to reg0 (e.g. i64/double).
;   ABI-COERCE2 — 9..16 bytes: two eightbytes reg0,reg1; return is {reg0,reg1}.
(defenum AbiKind ABI-DIRECT ABI-MEMORY ABI-COERCE1 ABI-COERCE2)

; Stage 16 FL-4 (design/stage16-ergonomics/c-boundary-defects.md §6): the two
; SysV eightbyte classes the wide float types add, numbered ABOVE INTEGER (3)
; because `abi-class-eightbyte` merges by taking the maximum and both must win
; against everything they can meet.
; BF-1 needs the INTEGER class by name: SysV classifies a bit-field as INTEGER
; whatever its declared type, so a storage run merges as one regardless.
(defconst ABI-CLS-INTEGER 3)
(defconst ABI-CLS-X87 4)     ; x86_fp80: poisons the whole aggregate to MEMORY
(defconst ABI-CLS-SSEUP 5)   ; fp128: one xmm across both eightbytes

(defstruct AbiInfo
  kind:i32     ; AbiKind
  reg0:StrView ; IR type string for eightbyte 0 (COERCE1/COERCE2), else empty
  reg1:StrView ; IR type string for eightbyte 1 (COERCE2), else empty
  size:i32     ; struct ABI size in bytes (MEMORY/COERCE)
  align:i32    ; struct ABI alignment in bytes (MEMORY/COERCE)
  ; Byte offset of reg1's data within the struct (COERCE2 only). 8 on the SysV
  ; eightbyte path — reg1 IS the second eightbyte. A riscv64 lp64d flattened
  ; aggregate puts its second member at that member's own offset instead (4 for
  ; `{i32,f32}` / `{float[2]}`), so the five COERCE2 reconstruction sites GEP by
  ; this rather than a literal 8. See design/stage14/riscv-fp-abi.md §3.
  off1:i32
  ; Which riscv64 lp64d hard-float flattening rule produced this lowering:
  ; 0 none (every non-riscv target, and riscv's integer-convention fallback),
  ; 1 a lone FP real (1 FPR), 2 two FP reals (2 FPRs), 3 one FP real + one
  ; integer (1 FPR + 1 GPR). Recorded by the classifier so `abi-rv-consume`
  ; (src/abi.nuc) can debit exactly what was spent instead of re-deriving it
  ; from the reg0/reg1 IR strings — the "mirror a call, not the logic" rule
  ; (context/conventions.md). See design/stage14/riscv-fp-abi.md §4.
  rvfp:i32)

; Accumulator for the riscv64 lp64d flattening walk (Stage 14 RV-6,
; design/stage14/riscv-fp-abi.md §1). The psABI's hard-float rules apply only to
; an aggregate whose *flattened* scalar members number one or two, so the walk
; records at most two and sets `cnt` past 2 the moment a third appears (or a
; union is seen — a union is never flattened). Offsets are absolute within the
; aggregate, which is what AbiInfo.off1 needs.
(defstruct RvFlat
  cnt:i32      ; flattened scalar count; > 2 means ineligible
  fp0:i32      ; member 0 is a floating-point real
  ir0:StrView  ; member 0 IR type string
  pos0:i32     ; member 0 byte offset
  sz0:i32      ; member 0 size
  fp1:i32
  ir1:StrView
  pos1:i32
  sz1:i32)

; A program-defined function's captured signature, so a macro/CT JIT module can
; reproduce its `declare`. ir-name is the emitted @symbol; ret + param Types
; drive the ABI-lowered declare exactly as emit-defn lowered the `define`.
(defstruct ProgDefn
  ; Content-compared by program-defn-lookup — which as a `Symbol` is one `icmp`,
  ; interning having made content and identity the same question.
  ir-name:Symbol
  (ret ?&Type)
  ptypes:ptr   ; ptr array of param Type*
  nparams:i32
  variadic:i32
  ; The `define`'s byte span in `g-def-buf`, so a compile-time mirror module can
  ; copy it verbatim; `ir-start == ir-end == 0` means "no span, not mirrorable"
  ; (design/stage20-macros/macro-call-linking.md §5.1).
  ir-start:usize
  ir-end:usize
  ; Defining file was under `g-ct-lib-root` — §3.1 condition 1.
  from-lib:i32)

; Stage 20 L6: the ProgDefn of a program `defvar`. `ty-ir` is the LLVM type text,
; so a JIT module that only NAMES the global can declare it `external` without
; re-deriving the type; the span is the whole `@g = … align N` emission, backing
; global included (design/stage20-macros/macro-call-linking.md §5.7).
(defstruct ProgGlobal
  ir-name:Symbol
  ty-ir:Symbol
  ir-start:usize
  ir-end:usize
  from-lib:i32
  is-const:i32)

(defstruct BinOp
  ; All three are content-only: `name` is only ever content-compared against
  ; string literals ("=", "!=" in builtin-op-result-type) or formatted into
  ; diagnostics; `instr`/`instr-u` are LLVM instruction mnemonics formatted
  ; straight into the IR stream. None are identity-compared.
  name:Symbol
  instr:StrView
  instr-u:StrView
  is-cmp:i32)

; ---- Polymorphism (Stage 9) ----
; A Generic is a named set of Methods sharing one source name. Operators are
; seeded as intrinsic generics (see init-generics); user defns add methods.
; Dispatch among concrete methods is on the whole argument tuple.
(defenum MethodKind METHOD-INTRINSIC METHOD-USER METHOD-GENERIC)

; Stage 14 §14.4: one parsed `:where` constraint — either a plain `(Protocol Var)`
; or the parametric `((Protocol Arg…) Var)` (assoc-types A1). Replaces the former
; parallel con-protos/con-vars/con-args/con-nargs arrays on Method and
; TmplConformance with a single indexable record held in a
; `(Vector (ref Constraint))`. `proto`/`var` are interned name strings and are
; content-compared everywhere (every comparison already has a CStr operand, so a
; CStr field is byte-identical in lowering and semantically correct). `args` stays
; a raw ptr[] of Node* — the protocol-application Arg patterns — with `nargs` its
; count; null/0 for a plain `(Proto V)` constraint (a ragged sub-array, like
; Arm.fnames/ftypes).
(defstruct Constraint
  proto:Symbol      ; protocol name: canonical once `settled`, else as written
  var:Symbol        ; conforming type-variable name
  args:ptr          ; ptr array of Node* (proto-application Args), or null
  nargs:i32         ; count of Arg nodes (0 for a plain constraint)
  settled:bool
  ; The writing file's name environment, to resolve an unsettled `proto` in.
  ns:Symbol
  path:Symbol
  imports:?&ImportVec)

; The pointer kind is left OUTSIDE this alias because a constraint clause is
; genuinely held both ways — nullable on a struct field (null for no :where),
; `&` once a site has proved it non-null (container-type-sugar.md §3.10).
(deftype ConstraintVec (Vector &Constraint))

(defstruct Method
  param-types:ptr   ; ptr to array of ptr:Type (length num-params); null for intrinsic
  num-params:i32
  (ret-type ?&Type)  ; null for intrinsic
  has-rest:i32
  variadic:i32
  kind:i32          ; one of MethodKind
  ; A METHOD-INTRINSIC or not-yet-mangled method has no ir-name, which is the
  ; zero `Symbol` (`symbol-none?`) rather than a null — `Symbol.p` is non-null by
  ; type, so the absent case is minted, not assigned.
  ir-name:Symbol    ; emitted symbol "@name..." (user methods); none otherwise
  (fn-type (ptr Type))  ; TY-FN for user methods; null otherwise
  (binop (ptr BinOp))   ; intrinsic operators; null otherwise
  (body (ptr Node))     ; retained defn form (generic methods); null otherwise
  ; --- METHOD-GENERIC only (Stage 9 rung 4): a bounded generic defn template ---
  tyvars:ptr        ; array of ptr (distinct type-variable name strings)
  num-tyvars:i32
  ; --- Stage 11 assoc-types (A1) / Stage 14 §14.4: parsed :where constraints ---
  ; Each `(Protocol Var)` or parametric `((Proto Arg…) V)` constraint is one
  ; `(ref Constraint)` record; the whole clause is a `(Vector (ref Constraint))`
  ; (null for a non-generic method or a template with no :where). Unchecked: it
  ; is read only under `(dotimes (i (mm num-constraints)))` loops.
  constraints:ptr:ConstraintVec
  num-constraints:i32
  checked:i32       ; A2 def-time check done (so it runs once per template)
  ; --- Stage 14 LW-1: stamped-instance marker ---
  ; For a METHOD-USER produced by monomorphizing a template (generic-instantiate),
  ; the originating template Method*; null for a hand-written method. Stamped
  ; instances are caches of their template, so tier-2 widening resolution skips
  ; them (the template alone covers every widened call) to avoid a false ambiguity
  ; between a template and its own stamped instance.
  (origin-template ?&Method)
  ; --- Stage 15 W5e: provenance, for the duplicate-signature diagnostic ---
  ; The source file this method was registered from (`g-source-path` at
  ; registration; null for a synthesized method with no source file) and whether
  ; it came from a *private* definer. `finalize-generics` needs both to name the
  ; OTHER definition's file and to phrase the namespace rule correctly — the
  ; `Method.body` Node carries a line but no file.
  src-file:Symbol
  src-ns:Symbol
  ; Stage 15 W9 item 43: `g-file-imports` at registration — the third of the
  ; three globals that define a file's name environment, recorded for the same
  ; reason `DynAnnot` records all three. Only a TEMPLATE needs it (its body is
  ; re-emitted, once per instantiation, from whichever file happens to call it),
  ; but it is written wherever the other two are so the trio cannot drift.
  src-imports:?&ImportVec
  priv:i32
  ; --- Stage 15 W9 item 24: the symbol is a fact from another translation unit ---
  ; Set on a method registered from a `declare`/`defmethod` — its `ir-name` is
  ; the symbol some other object file already defines, so `finalize-generics`
  ; may decide this generic's DISPATCH but may not rename this method. The
  ; principle is `fn-force-generic-mangled`'s ("no already-emitted symbol is
  ; renamed"), stated per method instead of by freezing the whole generic, so a
  ; local overload added afterwards still gets a mangled name of its own.
  ir-fixed:i32)

(defstruct Generic
  name:Symbol
  ; Non-null: set once by generic-new and never reset.
  methods:&(Vector &Method)
  finalized:i32     ; mangling decided + solitary scope binding established
  mangled:i32       ; 0 = solitary, unmangled @name (C-callable); 1 = mangled set
  ; Stage 12 N4: the IR-mangling prefix string for this generic's methods (e.g.
  ; "foo", or "" under `user`). Captured at generic-new time from the *defining*
  ; namespace so finalize/monomorphization — which may run while a later import's
  ; namespace is current — still mangle under the right prefix. The empty prefix
  ; (`user`) composes to the bare name, keeping the bootstrap byte-identical.
  ir-prefix:Symbol)

; A Protocol names a capability: a set of required method signatures whose
; parameter/return types may mention `Self` and, for a parametric protocol
; `(defprotocol (Seq E) ...)`, the extra parameters `E...` bound at the extend
; site. It is purely compile-time and emits no code. `extend Type Protocol`
; substitutes Self→Type (and each extra param→its binding) in each signature and
; verifies a matching concrete method exists (see emit-extend).
(defstruct Protocol
  name:Symbol
  sigs:ptr          ; ptr to array of ptr:Node, each a (name:ret (params...)) form
  num-sigs:i32
  ; --- Stage 11 parametric protocols (T4) ---
  ; Extra type parameters beyond the implicit `Self`: for `(defprotocol (Seq E)
  ; ...)` this is the one-element array {"E"}. Empty (null/0) for a plain
  ; `(defprotocol Name ...)`, which behaves exactly as before (Self-only).
  params:ptr        ; ptr array of extra-param name Symbols (beyond Self), or null
  num-params:i32
  ; --- Stage 15 B5 ---
  ; `defprotocol-`'s privacy carrier. `name` is already namespace-qualified
  ; (protocol-key), so `src-ns` is derivable from it — but the interface asks
  ; every row the same question and a stored answer costs one word.
  priv:i32
  src-ns:Symbol
  src-file:Symbol     ; Stage 15 B4 — see UnionTemplate.src-file
  src-line:i32
  src-imports:?&ImportVec) ; the signatures are this file's text — see NameEnv

; A recorded (Type, Protocol) conformance fact. No code; consulted by the
; resolver (protocol-bound tier, later) and exported in .nuch.
; Stage 11 assoc-types (A0): the parametric protocol's bound arguments are now
; retained so dispatch-time associated-type recovery (A2) can read them back out.
; `args` is a ptr array of canonical type-spelling strings (one per protocol
; extra-param, in head order: `(extend IntRangeIter (Iterator i32))` → {"i32"});
; null/0 for a plain (non-parametric) protocol. Coherence (`conformance-add`)
; keeps one record per (type, proto), so these args are functionally determined
; by the conforming type — that is the associated-type recovery rule.
(defstruct Conformance
  type-name:Symbol
  proto-name:Symbol
  ; Stage 14 §14.4: the retained associated-type arguments as a (Vector Symbol) of
  ; canonical type-spellings (value-compared by conformance-args-eq); null
  ; for a plain (non-parametric) protocol. The count is `(count args)`.
  (args ?&(Vector Symbol)))

; Stage 11 parametric structs (T4): a recorded template-level conformance from
; `(extend (Vector T) (Seq T))`. `template` is the extended struct template;
; `proto` is the (parametric) protocol; `bindings` is a node array — the proto
; application's args, e.g. `T` from `(Seq T)` — positionally bound to the
; protocol's extra params. At stamp time the template tyvars in each binding are
; substituted to the concrete instance args to obtain concrete param spellings.
; Stage 11 assoc-types (A4): a template-level conformance may now carry a trailing
; `:where` clause `(extend (MapIter I F) (Iterator E) :where ((Iterator S) I)
; ((UnaryFn S E) F))`, whose constraints recover the protocol-application args
; (`E`) from the instance's own arg conformances at stamp time (A4.2). The clause
; is parsed identically to a `defn`'s :where (parse-where-constraints) and stored
; here, mirroring the Method `constraints` field (a (Vector (ref Constraint))).
; A `:where`-free extend records `num-constraints = 0`; nothing
; downstream changes for it (the bootstrap stays byte-identical, §9). `num-tyvars`
; is the count of the conformance's tyvars (the template tyvars plus any assoc
; tyvars introduced by the :where clause), needed to size A4.2's recovery bound
; array; for a :where-free extend it equals the template's own tyvar count.
(defstruct TmplConformance
  template:ptr      ; a StructTemplate or a UnionTemplate; compared by identity only
  (proto ?&Protocol)
  bindings:ptr      ; ptr array of Node* (the proto-app args), or null if none
  nbindings:i32
  ; --- Stage 11 assoc-types (A4): trailing :where clause, or empty ---
  tyvars:ptr        ; ptr array of tyvar-name Symbols (template tyvars + assoc), or null
  num-tyvars:i32    ; count of tyvars above (template ntv for a :where-free extend)
  ; Stage 14 §14.4: the parsed :where clause as a (Vector (ref Constraint)),
  ; mirroring Method; null for a :where-free extend (num-constraints = 0).
  constraints:?&ConstraintVec
  num-constraints:i32   ; 0 for a :where-free extend
  ptr-depth:i32)        ; pointers over the template in the subject (`&(Vector T)`)

; A queued generic instantiation: the stamped concrete defn form awaiting body
; emission, plus a human-readable context ("while instantiating @name.toks…
; requested at file:line") attached to any compile error raised while emitting it.
; Stage 15 W9 item 43: the three globals that define a file's name environment,
; carried per job for the same reason `DynAnnot` and `InitJob` carry them — the
; drain runs later, and a `defn` form is a body of arbitrary source names. For a
; monomorphized template that environment is the TEMPLATE's, not the requesting
; call site's: the body is the library's text, and it must resolve the way the
; library's own file did. That is the same argument `g-emitting-copy` and the
; `src-ns` re-ownership already make about the stamp's linkage and its namespace,
; carried one layer further into where its names are looked up.
(defstruct MonoJob
  (form ?&Node)
  context:StrView
  ns:Symbol
  path:Symbol
  imports:?&ImportVec)

; Stage 15 W8 G-3 (design/global-init.md §5): a queued *runtime* global
; initializer — a `defvar` whose initializer G-1/G-2 could not render as a
; constant. `form` is the synthesized `(set! name init)` that @__nucleus_init
; emits; the other three restore the emission context the `defvar` was reached
; in, because the drain happens later, at the end of the outermost unit:
; `ns` for name qualification (qualify-name), `path` for private-name
; resolution (priv-key-use reads g-source-path) and for the file half of any
; diagnostic, `line` for its line half. `name` is the global's source spelling,
; carried only so the no-mechanism diagnostic (§4.6) can name it.
(defstruct InitJob
  (form ?&Node)
  ns:Symbol
  path:Symbol
  line:i32
  name:Symbol
  ; Stage 20 L6: the global's `@name`, so a compile-time mirror can ask whether
  ; the globals it copied have a pending initializer without re-deriving the
  ; namespace mangling (macro-call-linking.md §5.7).
  ir-name:Symbol)

(defstruct MacroDef
  name:Symbol
  jit-name:Symbol
  num-params:i32
  variadic:i32
  ; --- Stage 8 / REPL introspection additions ---
  src-file:Symbol
  src-line:i32
  ; The `defmacro` half of Sym.docstring above, and unwritten for the same reason.
  docstring:Symbol
  ; Parameter names array (parallel to the user-declared param list, minus
  ; :rest/:optional keywords) for tooling. null if not captured.
  param-names:ptr
  priv:i32          ; Stage 15 B5 — see StructDef.priv (`defmacro-`)
  src-ns:Symbol
  ; Stage 20 L4: the ir-names this body calls that do NOT resolve to the host,
  ; so `expand-macro-call` can mirror them before its lookup — the flush is at
  ; expansion, not here (design/stage20-macros/macro-call-linking.md §5.3).
  ct-roots:&(Vector Symbol))

; Stage 20 L4: the same for a `(compile-time …)` block, which has no MacroDef.
; Keyed by the `__compile_time_main_N` symbol, because the flush belongs at
; `jit-call-ct-main-sym`'s lookup (macro-call-linking.md §5.3).
(defstruct CtBlock
  sym:Symbol
  roots:&(Vector Symbol))

; A label declaration within the current function (Stage 8 goto support).
; `total` is the number of (label NAME) occurrences seen in the pre-scan;
; `seen` counts how many have been emitted so the last one wins the live BB.
; `name` is content-compared: lbl-find matches it via explicit strcmp, not
; identity.
(defstruct LabelEntry
  name:Symbol
  total:i32
  seen:i32)

; Stage 16 (design/stage16-ergonomics/macrolet.md §5.2): a snapshot of every
; global `reset-function-state` writes, plus the ambient argument-register
; budget and the want channel — the state a *nested* function emission would
; otherwise clobber. `macrolet` compiles a macro body mid-function, so unlike
; the mono worklist it cannot defer the nested emission to a drain.
;
; Fields track `reset-function-state` (src/scope.nuc) one-for-one; the pair that
; reads this struct lives directly below it so the two drift together.
(defstruct FnState
  tmp:i32
  label:i32
  block-term:i32
  lbl-tbl:&(Vector &LabelEntry)
  cur-fname:StrView
  fn-ret-abi:ptr
  fn-sret-name:StrView
  fn-ret-type:ptr
  loop-depth:i32
  nundo:&(Vector &NarrowUndo)
  narrow-gen:i32
  ; Pointers, not `String` values: this file is imported before `lib/string.nuc`,
  ; so a `%String`-typed field names a type the compile-time module's own type
  ; section does not carry. A pointer field is `ptr` in IR and carries nothing.
  entry-stream:&String
  body-stream:&String
  ; Ambient argument-register budget (conventions.md, "Argument-register state
  ; is AMBIENT"): a macrolet in argument position sits mid-walk.
  abi-gpr-left:i32
  abi-fpr-left:i32
  abi-varargs:i32
  want-type:ptr
  form-line:i32)

; A user-asserted implicit conversion (defcast From To conv-fn). Applied at call
; sites by safe-coerce-val when an argument's type differs from the parameter's.
(defstruct CastRule
  (from &Type)
  (to &Type)
  ; ir-name is content-only: safe-coerce-val formats it straight into the
  ; emitted `call` instruction (never null-checked or identity-compared), so it
  ; is IR text and stays a view.
  ir-name:StrView)

; A resolved compilation target (Stage 8 cross-compilation). datalayout and
; ptr-size come from LLVM for `triple`, so emitted IR matches the target ABI.
; ptr-align is queried from the datalayout (LLVMABIAlignmentOfType on a `ptr`),
; not assumed equal to ptr-size — AVR aligns pointers at 1 byte. `cpu` is the
; --mcpu string passed to LLVMCreateTargetMachine (empty "" for host targets;
; never null, never compared — kept `ptr`). `features` (the LLVMCreateTargetMachine
; features string, e.g. "+m,+a,+f,+d,+c" for riscv64) and `abi` (the LLVM
; "target-abi" module-flag value, e.g. "lp64d" for riscv64) are triple-keyed
; defaults resolved in make-target-for-triple; both are empty "" for every
; existing hosted triple (so their IR is byte-identical), never null, never
; compared — kept `ptr`. See design/stage14/riscv-linux.md §5 (RV-1).
; `prog-as` is the datalayout's program address space (the `P<n>` token; Stage 14
; AVR-6): 1 on AVR (functions live in program memory, addrspace(1)), 0 on every
; other target (no `P` token). It gates the AVR-6 function-value diagnostic in
; emit-symbol-ref — see design/stage14/avr-targets.md §5 (AVR-6).
(defstruct Target
  triple:Symbol
  datalayout:Symbol
  ptr-size:i32
  ptr-align:i32
  cpu:Symbol
  features:Symbol
  abi:Symbol
  prog-as:i32)

; Stage 14 §14.5 batch 2 — vtable memo entry: replaces the parallel
; g-vtable-keys/g-vtable-names arrays (nucleusc.nuc) with one
; `(Vector (ref VtableEntry))`. Both fields are interned strings; the key is
; always looked up by pointer identity (never strcmp'd), so it stays `ptr`,
; not `CStr`.
(defstruct VtableEntry
  key:Symbol    ; "(spelling)/(proto)" or "fnfwd.<sig>" memo key
  name:Symbol)  ; emitted vtable symbol ("@__vt..."/"@__vtfn...")

; Stage 14 §14.5 batch 2 — per-namespace ir-prefix table entry: replaces the
; parallel g-ns-prefix-keys/g-ns-prefix-vals arrays (nucleusc.nuc) with one
; `(Vector (ref NsPrefixEntry))`. Both columns are `Symbol`, so both compare by
; identity (ns-ir-prefix-set/-get).
(defstruct NsPrefixEntry
  ns:Symbol      ; the namespace name
  prefix:Symbol) ; its ir-prefix

; Stage 15 B1 (design/stage15-stress-test/name-resolution.md §5.2 B1, §8.3) — one
; entry in the FILE-scoped import environment: what a single import form bound in
; the file that wrote it. `prefix` is the qualifier an `import-prefixed` (or the
; prefixed `import` / `unsafe/import-private`) bound, and is **null** for a
; flattening `import-use`/`import-only` — the null-prefix entries are exactly the
; "namespaces this file flattened" set §8.3 needs. `path` is the resolved file
; path (or the header spelling for a C include), which is what B2 will map to the
; imported file's namespace.
;
; Stage 15 B2b: `private` is 1 only for `unsafe/import-private`, the one form
; that asks to reach the imported file's *file-private* key space (`#pN/name`,
; the W5e synthetic namespace) as well as its public one. Before B2b that
; distinction lived in `inject-import-aliases`, which filtered the alias slice on
; `sym-private` unless `g-import-include-private` was set; with injection gone
; the filter has to be a property of the binding, because resolution happens long
; after the flag has been restored.
(defstruct ImportBind
  prefix:Symbol ; bound qualifier, or `symbol-none` for a flattening import
  path:Symbol   ; resolved path of the imported file / header spelling
  private:i32)  ; 1 iff this import asked for the file's private names too

; Pointer kind left outside, as for ConstraintVec: `g-file-imports` and the
; saved copies of it are `?&` (null before the first import), the locals that
; index the table are `&`.
(deftype ImportVec (Vector &ImportBind))

; A file's name environment — the three globals `resolve-spelling` reads — held
; so a definition's own text is re-read the way its file read it.
(defstruct NameEnv
  ns:Symbol
  path:Symbol
  imports:?&ImportVec)

; A spelling substituted into another file's text (an alias argument, a protocol's
; `Self`) as the marker `#env-arg-N`, which the parser reads back in `env` (`env-arg-type`).
; A `type` marker carries a type already resolved, so it is read back as that type.
(defstruct EnvArg
  (node (ptr Node))
  env:NameEnv
  line:i32
  ctx:StrView
  (type ?&Type))

; The dry type parse's state, saved by `dry-parse-enter`.
(defstruct DryParse
  tyvars:ptr
  ntv:i32)

; A `:where` whose protocol must exist, asked once every file's are registered.
(defstruct WhereCheck
  (crec &Constraint)
  line:i32
  who:StrView)

; The call whose candidate templates are being bound; `name` is none outside one.
(defstruct BindCall
  name:Symbol
  path:Symbol
  line:i32)

; The namespace one source file declared. Stage 17 C7-4a gave this its own
; record: it was a `Node` cell abusing `s` for the path and `car` — a
; `(ptr Node)` slot — for the namespace, which stopped typechecking the moment
; the namespace became a `Symbol` and was never honest before that.
(defstruct FileNs
  path:Symbol ; source path, interned by `resolve-import` — compared by identity
  ns:Symbol)

(deftype FileNsVec (Vector &FileNs))

; Stage 15 B2a (design/stage15-stress-test/name-resolution.md §5.2 B2, §8.3) —
; the result of `resolve-spelling`, the ONE canonicaliser on the *reference*
; side. It replaces the ad-hoc splitting each registry used to do inline
; (`qualify-name` / `strip-ns-qualifier` / `protocol-key`) with a single record
; that says what the qualifier resolved to and what the registry key therefore
; is.
;
; `status` distinguishes the three outcomes a reference can have, and callers
; MUST branch on it — a null `canonical` is not the whole answer:
;   NR-BARE      unqualified: `canonical` is the current namespace's key and the
;                caller then probes the flattened set (file-flattened-ns-at);
;   NR-QUALIFIED the qualifier resolved through this file's import environment;
;                `canonical` is the one key to probe and there is no fallback;
;   NR-UNBOUND   the qualifier is in scope nowhere in this file. `canonical` is
;                null and the reference resolves to NOTHING — deliberately, even
;                when the raw spelling happens to BE a registry key, which is
;                exactly the `dp/Describe`-reaches-a-prefixed-import defect.
(defconst NR-BARE 0)
(defconst NR-QUALIFIED 1)
(defconst NR-UNBOUND 2)

; `qual` is a StrView because it is a SLICE of `spelling`, never a key: the
; qualifier is compared and printed, never looked up, so interning it would cost
; a hash per resolution to buy nothing. The three `Symbol`s are keys. A zeroed
; `NameRef` (`new` zeroes) reads as "unset" on all of them — `symbol-none?` for
; the keys, an empty view for `qual`.
(defstruct NameRef
  spelling:Symbol   ; the source spelling, as written
  qual:StrView      ; the qualifier text, empty when unqualified
  bare:Symbol       ; the name part (== spelling when unqualified)
  ns:Symbol         ; the namespace the qualifier resolved to, or none
  canonical:Symbol  ; the registry key, or none when NR-UNBOUND
  status:i32)

; Stage 15 W5e (design/stage15-stress-test/ergonomics.md §W5e) — one name a file
; declared with a private definer (`defn-`, `defvar-`, `defconst-`, `defenum-`)
; while the default `user` namespace was current. `bare` is the source spelling;
; `key` is the file-scoped scope/generic key the definer was registered under
; (`"#pN/bare"`, an ordinary namespace-qualified spelling whose namespace is the
; synthetic per-file one — so `qualify-name` is idempotent on it and every
; existing keying rule applies unchanged). Both are interned.
(defstruct PrivName
  bare:Symbol
  key:Symbol)

; The set of file-private names owned by one source file, plus the synthetic
; namespace that keys them. `ns` is `#pN` (N = 1-based creation order); `prefix`
; is its registered IR prefix (`<basename>_pN`), so a private solitary defn emits
; `@<basename>_pN__<name>` and an overloaded one `@<basename>_pN__<name>.tok…` —
; both fall out of the pre-existing `ns-compose`/`mangle-fn-name` path. A `#`
; cannot begin a user namespace name (rejected in `emit-ns`), so `#pN` can never
; collide with one.
(defstruct PrivFile
  path:Symbol   ; interned source path that owns these names
  ns:Symbol     ; the synthetic namespace ("#pN")
  prefix:Symbol ; IR prefix for that namespace
  names:&(Vector &PrivName))

; Stage 14 AVR-5 (design/stage14/avr-targets.md §5 AVR-5) — function-attribute
; entry: maps a `defn`'s source name to one LLVM string function attribute set by
; `(fn-attr <name> "<attr>" …)`. Stored flat in a `(Vector (ref FnAttrEntry))`
; (the §14.5 batch-2 small-table idiom, mirroring NsPrefixEntry) and scanned at
; emit-defn time, collecting every entry whose `name` matches the function being
; emitted — so a function may carry several attributes (one `fn-attr` call with
; several strings, or several `fn-attr` calls on the same name). `name` is looked
; up by identity, which is what a `Symbol` is; `attr` arrives already interned as
; the string literal's own spelling, so it costs nothing to keep one.
; Stage 15 W3b/W3c, retabled at stage17 C8: a C-header declaration the importer
; recognized but could not describe. Was a Node cell whose `car` carried the
; note as a bare pointer, which made the read-back a `strlen` on a view.
(defstruct CheaderSkip
  name:Symbol   ; the skipped function's name
  note:Symbol)  ; "<header>:<line>: <reason>"

(defstruct FnAttrEntry
  name:Symbol ; source function name (fn-attr's target defn)
  attr:Symbol)  ; LLVM string attribute (e.g. "signal", "interrupt")

; Stage 14 §14.5 batch 3 — BoxedFn-instance memo entry: replaces the parallel
; g-boxedfn-keys/g-boxedfn-types arrays (union-registry.nuc) with one
; `(Vector (ref BoxedFnEntry))`. `key` is always looked up by pointer identity
; (never strcmp'd — both sides already interned), so it stays `ptr`, not
; `CStr`; `ty` is a memoised box Type* looked up by `sdef` pointer identity
; (boxedfn-canonical), typed `(ptr Type)` per the field-typing idiom.
(defstruct BoxedFnEntry
  key:Symbol     ; "BoxedFn.<sig>" memo key
  ty:(ptr Type)) ; the memoised box Type* (carries the Fn signature)

; Stage 14 §14.5 batch 3 — `(dyn P)`-instance memo entry: replaces the
; parallel g-dyn-keys/g-dyn-types/g-dyn-protos arrays (union-registry.nuc)
; with one `(Vector (ref DynEntry))`. All fields are identity-compared
; (never strcmp'd — every key/value is already interned): `key`/`proto` stay
; `ptr`, `ty` is `(ptr Type)` matching BoxedFnEntry.
(defstruct DynEntry
  key:Symbol     ; the "dyn.<P>" memo key
  ty:(ptr Type)  ; the memoised box Type*
  proto:Symbol)  ; the protocol name

; Stage 15 B6 (name-resolution.md §9.5) — one deferred `(dyn P)` ANNOTATION-site
; admission job. `dyn-type` mints the box's identity from the spelling but cannot
; ask "may this file name this protocol?" there: it runs during
; `prescan-defn-signatures`, before the imported protocol registry exists. The
; question is therefore recorded with everything needed to ask it later *as that
; file* — the spelling, its location, and the two globals that define the file's
; name environment — and asked by `drain-dyn-annots` once the whole graph is in.
(defstruct DynAnnot
  spelling:Symbol   ; the protocol name the author wrote
  path:Symbol       ; source file of the annotation
  line:i32
  ns:Symbol         ; g-current-ns at the annotation
  imports:?&ImportVec)  ; g-file-imports at the annotation


; Stage 10 tagged-sum / Maybe / error-handling codegen, extracted from
; nucleusc.nuc (Stage 12 N8). Two adjacent and mutually-recursive sections:
;   - Maybe transition forms (nullability.md §3): emit-err-handled / emit-
;     signal / emit-handler-call / the niche Result helpers, plus the
;     errptr/niche layout queries (niche-layout-of, error-lib-in-scope).
;   - tagged-sum construction & elimination (unions.md §3–§5): emit-make /
;     emit-union-construct / emit-niche-* / emit-match family / union-target-
;     rewrite / stamp-maybe-type / enum lookups / emit-not / emit-short-
;     circuit / emit-ptr-add.
;
; Source-imported by src/nucleusc.nuc at the point these sections used to
; live (after union-registry/generics, before the emit-* dispatch that calls
; emit-make/emit-match/union-target-rewrite). The two sections call each other
; (the Maybe emitters call the niche/tagged-sum helpers and vice versa), so
; they are kept together: one import-use registers the whole cluster before
; any body emits. Depends on union-registry.nuc (lookup-struct, parse-type-
; from-node), generics.nuc, and many nucleusc.nuc emit helpers (emit-node,
; emit-cond, …) which resolve through nucleusc.nuc's whole-unit prescan.

; ============================================================
; Stage 10: Maybe transition forms (design/stage10/nullability.md §3)
; ============================================================

; (some r) — wrap a non-null (ref T) as (Maybe (ref T)). Pure relabel, no IR.
(defn emit-some (call:ptr scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 2) (die-at (cc 'line) "some expects 1 arg"))
    (let (v:ref:Val (emit-node (node-at cc 1) scope))
      (when (!= (ptr-pkind (v 'type)) PTR-REF)
        (die-at (cc 'line) "some: value must be non-null (ref ...) — launder a raw pointer with (as-ref ...)"))
      (let (rv:ref:Val (alloc-val (type-as-pkind (v 'type) PTR-MAYBE) (v 'val)))
        (val-copy-taint (as ptr rv) (as ptr v))
        (return rv)))))

; (as-ref p) — launder a raw pointer into (Maybe (ref T)): null stays none.
; Pure relabel, no IR; the value still has to be narrowed before use.
(defn emit-as-ref (call:ptr scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 2) (die-at (cc 'line) "as-ref expects 1 arg"))
    (let (v:ref:Val (emit-node (node-at cc 1) scope))
      (when (-> v (_ 'type) (unsafe/cast ptr:Type _) (_ 'kind) (!= _ TY-PTR))
        (die-at (cc 'line) "as-ref: value must be a pointer"))
      (let (rv:ref:Val (alloc-val (type-as-pkind (v 'type) PTR-MAYBE) (v 'val)))
        (val-copy-taint (as ptr rv) (as ptr v))
        (return rv)))))

; (unwrap r) over a Result `!T` value (errors.md §9): yields the `ok` payload,
; or — on the `err` arm — consults the panic-tier unhandled-error handler chain
; (Stage 10 C3, like die-at), then prints err-name/err-message and aborts (the
; panic tier). Printing needs printf in scope (e.g. (import-use "stdio.h")); the abort
; is @llvm.trap, so no libc abort symbol is needed.
(defn emit-unwrap-result (v:raw:Val ud:raw:UnionDef scope:ref:Scope line:i32):ref:Val
  (let (vv:raw:Val v
        udd:raw:UnionDef ud
        sd:raw:StructDef (udd 'sdef)
        oi:i32 (union-arm-index ud (symbol-intern "ok"))
        ok-ty:ptr ((invoke (udd 'arms) oi:usize) 'ptype)
        poff:i32 (union-payload-off ud))
    (when (= (scope-lookup g-globals (symbol-intern "printf")) null)
      (die-at line "unwrap on a Result needs printf in scope — add (import-use \"stdio.h\")"))
    (set! g-err-table-used 1)
    (when (= g-trap-declared 0)
      (emit g-decl-stream "declare void @llvm.trap()\n")
      (set! g-trap-declared 1))
    (let (base:StrView (new-tmp)
          id:i32 (new-label-id)
          ok-lbl:StrView (fstr "unwrap.ok" id)
          err-lbl:StrView (fstr "unwrap.err" id)
          tgep:StrView (new-tmp)
          tag:StrView (new-tmp)
          isok:StrView (new-tmp))
      (emit g-entry-stream "  " base " = alloca %" (sd 'ir-name) ", align "
            (abi-struct-align sd) "\n")
      (emit g-body-stream "  store %" (sd 'ir-name) " " (vv 'val) ", ptr " base "\n")
      (emit g-body-stream "  " tgep " = getelementptr inbounds %" (sd 'ir-name) ", ptr " base
            ", i32 0, i32 0\n")
      (emit g-body-stream "  " tag " = load i32, ptr " tgep ", align 4\n")
      (emit g-body-stream "  " isok " = icmp eq i32 " tag ", " oi "\n")
      (emit g-body-stream "  br i1 " isok ", label %" ok-lbl ", label %" err-lbl "\n")
      ; error path: load the err id, look up name/message, print, trap.
      (emit g-body-stream err-lbl ":\n")
      (set! g-block-term 0)
      (let (fmt:CStr "nucleus: unwrap on error %s: %s\n"
            fmt-id:i32 (intern-string "nucleus: unwrap on error %s: %s\n")
            epp:StrView (new-tmp) eid:StrView (new-tmp) eid64:StrView (new-tmp)
            ngep:StrView (new-tmp) nm:StrView (new-tmp)
            mgep:StrView (new-tmp) msg:StrView (new-tmp)
            ftmp:StrView (new-tmp))
        (emit g-body-stream "  " epp " = getelementptr inbounds i8, ptr " base ", i64 " poff
              "\n")
        (emit g-body-stream "  " eid " = load i32, ptr " epp ", align 4\n")
        (emit g-body-stream "  " eid64 " = sext i32 " eid " to i64\n")
        (emit g-body-stream "  " ngep " = getelementptr ptr, ptr @nuc_err_names, i64 " eid64
              "\n")
        (emit g-body-stream "  " nm " = load ptr, ptr " ngep ", align 8\n")
        (emit g-body-stream "  " mgep " = getelementptr ptr, ptr @nuc_err_messages, i64 " eid64
              "\n")
        (emit g-body-stream "  " msg " = load ptr, ptr " mgep ", align 8\n")
        ; Stage 10 C3 panic-tier hook (errors.md §4): consult the unhandled-error
        ; handler chain before aborting, mirroring die-at (lib/reader.nuc). The
        ; library-fn refactor (move the abort into lib/error.nuc) is infeasible:
        ; the abort is `@llvm.trap()`, raw IR with no Nucleus spelling — routing
        ; through libc abort() would change the abort mechanism and break byte
        ; identity. So we inject the same chain-walk IR `signal`/emit-handler-call
        ; produce, here, before the existing printf/trap. detail = the message
        ; ptr (`%msg`), repair type i32 — identical to die-at's
        ; `(signal unhandled-error i32 msg)`. Gated on error-lib-in-scope so a
        ; unit without the error library emits no extra code (byte-identical);
        ; with no handler bound the walk loads g-handler-top, finds null, and
        ; falls straight through to the abort below. The (Maybe i32) repair is
        ; discarded — the panic path traps regardless.
        (when (!= (error-lib-in-scope) 0)
          (let (uesym:?ptr:Sym (scope-lookup g-globals (symbol-intern "unhandled-error")))
            (when (and (!= uesym null)
                       (!= ((unsafe/cast ptr:Sym uesym) 'is-const) 0))
              (emit-handler-call (strview-from-cstr ((unsafe/cast ptr:Sym uesym) 'const-val))
                                 (as ptr ty-i32) msg scope line))))
        (emit g-body-stream "  " ftmp " = getelementptr inbounds ["
              (+ (unsafe/cast i32 (strlen fmt)) 1) " x i8], ptr @.str." fmt-id
              ", i64 0, i64 0\n")
        (emit g-body-stream "  call i32 (ptr, ...) @printf(ptr " ftmp ", ptr " nm ", ptr " msg
              ")\n")
        ; Flush before the trap (which raises immediately, bypassing buffers) so
        ; the panic message is not lost. fflush(NULL) flushes all open streams.
        (when (!= (scope-lookup g-globals (symbol-intern "fflush")) null)
          (emit g-body-stream "  call i32 @fflush(ptr null)\n"))
        (emit g-body-stream "  call void @llvm.trap()\n")
        (emit g-body-stream "  unreachable\n"))
      ; ok path becomes the continuation; load and yield the payload.
      (emit g-body-stream ok-lbl ":\n")
      (set! g-block-term 0)
      (let (opp:StrView (new-tmp) res:StrView (new-tmp))
        (emit g-body-stream "  " opp " = getelementptr inbounds i8, ptr " base ", i64 " poff
              "\n")
        (emit-load res (type-to-ir ok-ty) opp ok-ty)
        (return (alloc-val ok-ty res))))))

; (unwrap-or r default) over a Result: the `ok` payload, or `default` (evaluated
; only on the err path; it must satisfy the ok payload type).
(defn emit-unwrap-or-result (v:raw:Val ud:raw:UnionDef default-node:ptr scope:ref:Scope line:i32):ref:Val
  (let (vv:raw:Val v
        udd:raw:UnionDef ud
        sd:raw:StructDef (udd 'sdef)
        oi:i32 (union-arm-index ud (symbol-intern "ok"))
        ok-ty:ptr ((invoke (udd 'arms) oi:usize) 'ptype)
        poff:i32 (union-payload-off ud)
        base:StrView (new-tmp)
        id:i32 (new-label-id)
        ok-lbl:StrView (fstr "unwrapor.ok" id)
        err-lbl:StrView (fstr "unwrapor.err" id)
        join-lbl:StrView (fstr "unwrapor.join" id)
        end-lbl:StrView (fstr "unwrapor.end" id)
        tgep:StrView (new-tmp) tag:StrView (new-tmp) isok:StrView (new-tmp))
    (emit g-entry-stream "  " base " = alloca %" (sd 'ir-name) ", align " (abi-struct-align sd)
          "\n")
    (emit g-body-stream "  store %" (sd 'ir-name) " " (vv 'val) ", ptr " base "\n")
    (emit g-body-stream "  " tgep " = getelementptr inbounds %" (sd 'ir-name) ", ptr " base
          ", i32 0, i32 0\n")
    (emit g-body-stream "  " tag " = load i32, ptr " tgep ", align 4\n")
    (emit g-body-stream "  " isok " = icmp eq i32 " tag ", " oi "\n")
    (emit g-body-stream "  br i1 " isok ", label %" ok-lbl ", label %" err-lbl "\n")
    ; ok path: load the payload.
    (emit g-body-stream ok-lbl ":\n")
    (set! g-block-term 0)
    (let (opp:StrView (new-tmp) okv:StrView (new-tmp))
      (emit g-body-stream "  " opp " = getelementptr inbounds i8, ptr " base ", i64 " poff "\n")
      (emit-load okv (type-to-ir ok-ty) opp ok-ty)
      (emit g-body-stream "  br label %" end-lbl "\n")
      ; err path: evaluate the default.
      (emit g-body-stream err-lbl ":\n")
      (set! g-block-term 0)
      (let (dv:ref:Val (emit-node default-node scope)
            dval:StrView ""
            dterm:i32 g-block-term)
        (when (= dterm 0)
          (let (coerced:ptr (coerce-int-val (as ptr dv) ok-ty line))
            (when (= coerced null)
              (die-at line "unwrap-or: default type mismatch"))
            (set! dval ((as ptr:Val coerced) 'val)))
          (emit g-body-stream "  br label %" join-lbl "\n")
          (emit g-body-stream join-lbl ":\n")
          (emit g-body-stream "  br label %" end-lbl "\n"))
        (emit g-body-stream end-lbl ":\n")
        (set! g-block-term 0)
        (let (tmp:StrView (new-tmp))
          (if (= dterm 0)
            (emit g-body-stream "  " tmp " = phi " (type-to-ir ok-ty) " [ " okv ", %" ok-lbl
                  " ], [ " dval ", %" join-lbl " ]\n")
            (emit g-body-stream "  " tmp " = phi " (type-to-ir ok-ty) " [ " okv ", %" ok-lbl
                  " ]\n"))
          (return (alloc-val ok-ty tmp)))))))

; (unwrap m) — the (ref T) inside, or trap. The one runtime branch nullability
; costs, paid only where it is written.
; (unwrap r) over a niche-ERRPTR `!T` (unions.md §6 rule 3): on the ok arm yield
; the (ref T) pointer; on the err arm print err-name/err-message and abort — the
; panic tier, mirroring emit-unwrap-result but discriminated by is-err and with
; the id recovered from the sentinel pointer (0 - ptrtoint r) rather than a tag.
(defn emit-unwrap-niche-errptr (v:raw:Val elem:raw:Type scope:ref:Scope line:i32):ref:Val
  (let (vv:raw:Val v
        rval:StrView (vv 'val))
    (when (= (scope-lookup g-globals (symbol-intern "printf")) null)
      (die-at line "unwrap on a Result needs printf in scope — add (import-use \"stdio.h\")"))
    (set! g-err-table-used 1)
    (when (= g-trap-declared 0)
      (emit g-decl-stream "declare void @llvm.trap()\n")
      (set! g-trap-declared 1))
    (let (iserr:StrView (emit-errptr-is-err rval)
          id:i32 (new-label-id)
          err-lbl:StrView (fstr "unwrap.err" id)
          ok-lbl:StrView (fstr "unwrap.ok" id))
      (emit g-body-stream "  br i1 " iserr ", label %" err-lbl ", label %" ok-lbl "\n")
      ; error path: recover the id, look up name/message, signal the panic hook,
      ; print, trap. Mirrors emit-unwrap-result's err block exactly.
      (emit g-body-stream err-lbl ":\n")
      (set! g-block-term 0)
      (let (fmt:CStr "nucleus: unwrap on error %s: %s\n"
            fmt-id:i32 (intern-string "nucleus: unwrap on error %s: %s\n")
            pineg:StrView (new-tmp) eid:StrView (new-tmp) idtr:StrView (new-tmp) eid64:StrView (new-tmp)
            ngep:StrView (new-tmp) nm:StrView (new-tmp) mgep:StrView (new-tmp) msg:StrView (new-tmp)
            ftmp:StrView (new-tmp))
        (emit g-body-stream "  " pineg " = ptrtoint ptr " rval " to " (ptr-int-ir) "\n")
        (emit g-body-stream "  " eid " = sub " (ptr-int-ir) " 0, " pineg "\n")
        (if (= (ptr-int-ir) "i32")
          (set! idtr eid)
          (emit g-body-stream "  " idtr " = trunc " (ptr-int-ir) " " eid " to i32\n"))
        (emit g-body-stream "  " eid64 " = sext i32 " idtr " to i64\n")
        (emit g-body-stream "  " ngep " = getelementptr ptr, ptr @nuc_err_names, i64 " eid64
              "\n")
        (emit g-body-stream "  " nm " = load ptr, ptr " ngep ", align 8\n")
        (emit g-body-stream "  " mgep " = getelementptr ptr, ptr @nuc_err_messages, i64 " eid64
              "\n")
        (emit g-body-stream "  " msg " = load ptr, ptr " mgep ", align 8\n")
        (when (!= (error-lib-in-scope) 0)
          (let (uesym:?ptr:Sym (scope-lookup g-globals (symbol-intern "unhandled-error")))
            (when (and (!= uesym null) (!= ((unsafe/cast ptr:Sym uesym) 'is-const) 0))
              (emit-handler-call (strview-from-cstr ((unsafe/cast ptr:Sym uesym) 'const-val))
                                 (as ptr ty-i32) msg scope line))))
        (emit g-body-stream "  " ftmp " = getelementptr inbounds ["
              (+ (unsafe/cast i32 (strlen fmt)) 1) " x i8], ptr @.str." fmt-id
              ", i64 0, i64 0\n")
        (emit g-body-stream "  call i32 (ptr, ...) @printf(ptr " ftmp ", ptr " nm ", ptr " msg
              ")\n")
        (when (!= (scope-lookup g-globals (symbol-intern "fflush")) null)
          (emit g-body-stream "  call i32 @fflush(ptr null)\n"))
        (emit g-body-stream "  call void @llvm.trap()\n")
        (emit g-body-stream "  unreachable\n"))
      ; ok path: r is the (ref T) pointer (non-null, never top-page).
      (emit g-body-stream ok-lbl ":\n")
      (set! g-block-term 0)
      (let (rt:ptr:Type (as ptr:Type (make-type TY-PTR)))
        (set! (rt 'elem) elem)
        (set! (rt 'pkind) PTR-REF)
        (let (rv:ref:Val (alloc-val (as ptr rt) rval))
          (set! (rv 'taint) (vv 'taint))
          (return rv))))))

(defn emit-unwrap (call:ptr scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 2) (die-at (cc 'line) "unwrap expects 1 arg"))
    (let (v:ref:Val (emit-node (node-at cc 1) scope))
      (when (= (niche-layout-of (v 'type)) LAYOUT-NICHE-ERRPTR)
        (return (emit-unwrap-niche-errptr v
                  ((v 'type) 'elem) scope (cc 'line))))
      (let (rud:?ptr:UnionDef (result-union-of (v 'type)))
        (when (!= rud null)
          (return (emit-unwrap-result v rud scope (cc 'line)))))
      (when (!= (ptr-pkind (v 'type)) PTR-MAYBE)
        (die-at (cc 'line) "unwrap: value must be (Maybe (ref ...)) — launder a raw pointer with (as-ref ...)"))
      (when (= g-trap-declared 0)
        (emit g-decl-stream "declare void @llvm.trap()\n")
        (set! g-trap-declared 1))
      (let (isn:StrView (new-tmp)
            id:i32 (new-label-id)
            trap-lbl:StrView (fstr "unwrap.none" id)
            ok-lbl:StrView (fstr "unwrap.some" id))
        (emit g-body-stream "  " isn " = icmp eq ptr " (v 'val) ", null\n")
        (emit g-body-stream "  br i1 " isn ", label %" trap-lbl ", label %" ok-lbl "\n")
        (emit g-body-stream trap-lbl ":\n")
        (emit g-body-stream "  call void @llvm.trap()\n")
        (emit g-body-stream "  unreachable\n")
        (emit g-body-stream ok-lbl ":\n")
        (set! g-block-term 0)
        (let (rv:ref:Val (alloc-val (type-as-pkind (v 'type) PTR-REF) (v 'val)))
          (set! (rv 'taint) (v 'taint))
          (return rv))))))

; (unwrap-or r default) over a niche-ERRPTR `!T`: the ok (ref T) pointer, or
; `default` (evaluated only on the err arm; must satisfy the (ref T) result).
(defn emit-unwrap-or-niche-errptr (v:raw:Val elem:raw:Type default-node:ptr
                                           scope:ref:Scope line:i32):ref:Val
  (let (vv:raw:Val v
        rval:StrView (vv 'val)
        ref-ty:ptr:Type (as ptr:Type (make-type TY-PTR))
        iserr:StrView (emit-errptr-is-err rval)
        id:i32 (new-label-id)
        ok-lbl:StrView (fstr "unwrapor.ok" id)
        err-lbl:StrView (fstr "unwrapor.err" id)
        join-lbl:StrView (fstr "unwrapor.join" id)
        end-lbl:StrView (fstr "unwrapor.end" id))
    (set! (ref-ty 'elem) elem)
    (set! (ref-ty 'pkind) PTR-REF)
    (emit g-body-stream "  br i1 " iserr ", label %" err-lbl ", label %" ok-lbl "\n")
    (emit g-body-stream ok-lbl ":\n")
    (emit g-body-stream "  br label %" end-lbl "\n")
    (emit g-body-stream err-lbl ":\n")
    (set! g-block-term 0)
    (let (dv:ref:Val (emit-node default-node scope)
          dval:StrView ""
          dtaint:ptr null
          dterm:i32 g-block-term)
      (when (= dterm 0)
        (let (coerced:ptr (coerce-int-val (as ptr dv) (as ptr ref-ty) line))
          (when (= coerced null)
            (die-at line "unwrap-or: default type mismatch"))
          (set! dval ((as ptr:Val coerced) 'val))
          (set! dtaint (dv 'taint)))
        (emit g-body-stream "  br label %" join-lbl "\n")
        (emit g-body-stream join-lbl ":\n")
        (emit g-body-stream "  br label %" end-lbl "\n"))
      (emit g-body-stream end-lbl ":\n")
      (set! g-block-term 0)
      (let (tmp:StrView (new-tmp))
        (if (= dterm 0)
          (emit g-body-stream "  " tmp " = phi ptr [ " rval ", %" ok-lbl " ], [ " dval ", %"
                join-lbl " ]\n")
          (emit g-body-stream "  " tmp " = phi ptr [ " rval ", %" ok-lbl " ]\n"))
        (let (rv:ref:Val (alloc-val (as ptr ref-ty) tmp))
          (set! (rv 'taint) (taint-merge (vv 'taint) dtaint))
          (return rv))))))

; (unwrap-or m default) — the narrowed value, or `default` (evaluated only on
; the none path; it must satisfy the non-null (ref ...) result type).
(defn emit-unwrap-or (call:ptr scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 3) (die-at (cc 'line) "unwrap-or expects 2 args"))
    (let (v:ref:Val (emit-node (node-at cc 1) scope))
      (when (= (niche-layout-of (v 'type)) LAYOUT-NICHE-ERRPTR)
        (return (emit-unwrap-or-niche-errptr v
                  ((v 'type) 'elem) (node-at cc 2) scope (cc 'line))))
      (let (rud:?ptr:UnionDef (result-union-of (v 'type)))
        (when (!= rud null)
          (return (emit-unwrap-or-result v rud
                                         (node-at cc 2) scope (cc 'line)))))
      (when (!= (ptr-pkind (v 'type)) PTR-MAYBE)
        (die-at (cc 'line) "unwrap-or: value must be (Maybe (ref ...)) — launder a raw pointer with (as-ref ...)"))
      (let (ref-ty:ptr (type-as-pkind (v 'type) PTR-REF)
            isn:StrView (new-tmp)
            id:i32 (new-label-id)
            some-lbl:StrView (fstr "unwrapor.some" id)
            none-lbl:StrView (fstr "unwrapor.none" id)
            join-lbl:StrView (fstr "unwrapor.join" id)
            end-lbl:StrView (fstr "unwrapor.end" id))
        (emit g-body-stream "  " isn " = icmp eq ptr " (v 'val) ", null\n")
        (emit g-body-stream "  br i1 " isn ", label %" none-lbl ", label %" some-lbl "\n")
        (emit g-body-stream some-lbl ":\n")
        (emit g-body-stream "  br label %" end-lbl "\n")
        (emit g-body-stream none-lbl ":\n")
        (set! g-block-term 0)
        (let (dv:ref:Val (emit-node (node-at cc 2) scope)
              dval:StrView ""
              dtaint:ptr null)
          (let (dterm:i32 g-block-term)
            (when (= dterm 0)
              (let (coerced:ptr (coerce-int-val (as ptr dv) ref-ty (cc 'line)))
                (when (= coerced null)
                  (die-at (cc 'line) "unwrap-or: default type mismatch"))
                (set! dval ((as ptr:Val coerced) 'val))
                (set! dtaint (dv 'taint)))
              (emit g-body-stream "  br label %" join-lbl "\n")
              (emit g-body-stream join-lbl ":\n")
              (emit g-body-stream "  br label %" end-lbl "\n"))
            (emit g-body-stream end-lbl ":\n")
            (set! g-block-term 0)
            (let (tmp:StrView (new-tmp))
              (if (= dterm 0)
                (emit g-body-stream "  " tmp " = phi ptr [ " (v 'val) ", %" some-lbl " ], [ "
                      dval ", %" join-lbl " ]\n")
                (emit g-body-stream "  " tmp " = phi ptr [ " (v 'val) ", %" some-lbl " ]\n"))
              (let (rv:ref:Val (alloc-val ref-ty tmp))
                (set! (rv 'taint) (taint-merge (v 'taint) dtaint))
                (return rv)))))))))

; (if-some (x m) then [else]) / (when-some (x m) body…) — bind x to the Maybe
; value and desugar to cond: the synthesized (!= x null) test is the standard
; narrowing point, so x reads as (ref T) exactly inside the then arm (and stays
; Maybe in the else arm). Reuses cond's phi typing, fall-through, and
; after-the-form narrowing rules wholesale.
(defn emit-if-some (call:ptr scope:ref:Scope is-when:i32):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        tag:ptr "if-some")
    (when (!= is-when 0) (set! tag "when-some"))
    (when (< (node-len cc) 3)
      (die-at (cc 'line) (fstr tag ": expects (name maybe-expr) and a body")))
    (when (and (= is-when 0) (> (node-len cc) 4))
      (die-at (cc 'line) "if-some: expects (name maybe-expr) then [else]"))
    (let (binder:ptr:Node (unsafe/cast ptr:Node (node-at cc 1)))
      (when (or (!= (binder 'kind) NODE-CELL) (!= (node-len (as ptr binder)) 2))
        (die-at (cc 'line) (fstr tag ": binding must be (name maybe-expr)")))
      (let (xnode:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr binder) 0)))
        (when (!= (xnode 'kind) NODE-SYM)
          (die-at (binder 'line) (fstr tag ": name must be a symbol")))
        (let (mv:ref:Val (emit-node (node-at (as ptr binder) 1) scope))
          (when (!= (ptr-pkind (mv 'type)) PTR-MAYBE)
            (die-at (cc 'line) (fstr tag
                                     ": value must be (Maybe (ref ...)) — launder a raw pointer with (as-ref ...)")))
          ; W9 item 39: a binder name becomes an LLVM local identifier, so it takes
          ; the same transform a defn name does. Every `%<binder>.addr.N` producer
          ; in this file applies it; `scope-define` still keys on the source name.
          (let (slot:StrView (fstr "%" (ir-name-token (symbol-as-view (xnode 's))) ".addr." g-tmp))
            (inc! g-tmp)
            (emit g-entry-stream "  " slot " = alloca ptr, align 8\n")
            (emit g-body-stream "  store ptr " (mv 'val) ", ptr " slot ", align 8\n")
            (let (inner:ref:Scope (scope-new scope)
                  sym:ref:Sym (scope-define inner (xnode 's) (mv 'type) slot 1)
                  ln:i32 (cc 'line))
              (set! (sym 'taint) (mv 'taint))
              (let (test:ptr (make-cell '!=
                               (make-cell xnode
                                 (make-cell 'null null ln) ln) ln)
                    tail:ptr null)
                (if (!= is-when 0)
                  (let (body-chain:ptr (-> cc (_ 'cdr) (unsafe/cast ptr:Node _) (_ 'cdr)))
                    (set! tail (make-cell (make-cell 'do body-chain ln) null ln)))
                  (if (= (node-len cc) 4)
                    (set! tail (make-cell (node-at cc 2)
                                 (make-cell 'true
                                   (make-cell (node-at cc 3) null ln) ln) ln))
                    (set! tail (make-cell (node-at cc 2) null ln))))
                (let (synth:ptr (make-cell 'cond
                                  (make-cell test tail ln) ln))
                  (return (emit-cond synth inner)))))))))))

; ============================================================
; Stage 10: tagged-sum construction and elimination (unions.md §3–§5).
; `make` is the explicit-instance construction form; arm constructors and
; return-position target typing both lower to it. `match` is the sole
; eliminator: switch on the tag, typed binder loads per arm, cond's strict
; cross-branch join.
; ============================================================

; Build one arm value in place: alloca the backing struct, store the tag,
; store the payload fields (argument nodes from `call` starting at `argi`),
; and load the whole struct as a first-class value. Argument taints merge
; into the result (a with-owned pointer stored into the value escapes with
; it, and `return` already rejects tainted values).
(defn emit-union-construct (ud:raw:UnionDef arm:i32 call:ptr argi:i32 scope:ref:Scope):ref:Val
  (let (udd:raw:UnionDef ud
        cc:ptr:Node (unsafe/cast ptr:Node call)
        sd:raw:StructDef (udd 'sdef)
        arm-rec:ref:Arm (invoke (udd 'arms) arm:usize)
        nf:i32 (arm-rec 'nfields)
        nargs:i32 (- (node-len cc) argi)
        taint:ptr null)
    (when (!= nargs nf)
      (die-at (cc 'line)
        (fstr (udd 'name) ": arm '" (arm-rec 'name) "' takes a different number of fields")))
    (let (base:StrView (new-tmp))
      (emit g-entry-stream "  " base " = alloca %" (sd 'ir-name) ", align "
            (abi-struct-align sd) "\n")
      (let (tgep:StrView (new-tmp))
        (emit g-body-stream "  " tgep " = getelementptr inbounds %" (sd 'ir-name) ", ptr " base
              ", i32 0, i32 0\n")
        (emit g-body-stream "  store i32 " arm ", ptr " tgep ", align 4\n"))
      (when (> nf 0)
        (let (pp:StrView (new-tmp)
              ftypes:ptr (arm-rec 'ftypes)
              ptype:ptr:Type (unsafe/cast ptr:Type (arm-rec 'ptype)))
          (emit g-body-stream "  " pp " = getelementptr inbounds i8, ptr " base ", i64 "
                (union-payload-off ud) "\n")
          (dotimes (fi:i32 nf)
            (let (ftype:ptr (aref (as ptr:ptr ftypes) fi)
                  v:ref:Val (emit-node (node-at cc (+ argi fi)) scope)
                  coerced:ptr (coerce-int-val v ftype (cc 'line)))
              (when (= coerced null)
                (die-at (cc 'line)
                  (fstr (udd 'name) ": type mismatch for a field of arm '" (arm-rec 'name) "'")))
              (set! taint (taint-merge taint (v 'taint)))
              (let (cv:ptr:Val (as ptr:Val coerced)
                    fgep:StrView pp)
                ; Several fields → the payload is the memoized anon struct;
                ; one field → the payload IS the field, at offset 0.
                (when (> nf 1)
                  (set! fgep (new-tmp))
                  (emit g-body-stream "  " fgep " = getelementptr inbounds %"
                        ((unsafe/cast ptr:StructDef (ptype 'sdef)) 'name) ", ptr " pp
                        ", i32 0, i32 " fi "\n"))
                (emit-store (type-to-ir ftype) (cv 'val) fgep ftype))))))
      (let (v:StrView (new-tmp))
        (emit g-body-stream "  " v " = load %" (sd 'ir-name) ", ptr " base "\n")
        (let (rv:ref:Val (alloc-val (type-for-sdef sd) v))
          (set! (rv 'taint) taint)
          (return rv))))))

; (make Type arm args...) — explicit-instance construction (unions.md §5a).
; The niche layout (LAYOUT-NICHE-MAYBE / LAYOUT-NICHE-ERRPTR) a Type encodes, or
; LAYOUT-TAGGED for everything else. A niche type is a bare TY-PTR carrying the
; niche pkind (PTR-MAYBE / PTR-ERRPTR) and a present elem — exactly what the
; parser's `(Maybe (ref T))` / `!T` fast paths and a niche defunion stamp yield.
; The pkind alone identifies the niche, so a parser-produced niche and a
; defunion-stamped niche dispatch identically (the U4 convergence).
(defn niche-layout-of (t:raw:Type):i32
  (when (= t null) (return LAYOUT-TAGGED))
  (let (tt:raw:Type t)
    (when (!= (tt 'kind) TY-PTR) (return LAYOUT-TAGGED))
    (when (= (tt 'pkind) PTR-MAYBE) (return LAYOUT-NICHE-MAYBE))
    (when (= (tt 'pkind) PTR-ERRPTR) (return LAYOUT-NICHE-ERRPTR))
    (return LAYOUT-TAGGED)))

; Construct a niche-layout union value (unions.md §6 rules 2/3) — no struct, no
; tag word, just the encoded pointer. `ty` is the niche TY-PTR (elem = T).
;   NICHE-MAYBE:  (some p) → p relabeled PTR-MAYBE ; (none) → null PTR-MAYBE
;   NICHE-ERRPTR: (ok p)   → p relabeled PTR-ERRPTR (non-null, never top-page)
;                 (err E)  → inttoptr(0 - zext(E)) — a top-page sentinel
; The eliminators (match/unwrap/null-guard/is-err) read the same encoding back.
(defn emit-niche-construct (ty:raw:Type layout:i32 arm:CStr call:ptr argi:i32
                                    scope:ref:Scope line:i32):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        elem:ptr (ty 'elem))
    (if (= layout LAYOUT-NICHE-MAYBE)
      ; --- rule 2: nullable pointer, null = none ---
      (if (= arm "some")
        (do
          (when (!= (node-len cc) (+ argi 1))
            (die-at line "make: some takes one (ref T) field"))
          (let (v:ref:Val (emit-node (node-at cc argi) scope))
            (when (or (-> v (_ 'type) (unsafe/cast ptr:Type _) (_ 'kind) (!= _ TY-PTR))
                      (= (ptr-pkind (v 'type)) PTR-MAYBE))
              (die-at line "make: some expects a non-null (ref T) value"))
            (let (rv:ref:Val (alloc-val (type-as-pkind ty PTR-MAYBE) (v 'val)))
              (set! (rv 'taint) (v 'taint))
              (return rv))))
        (if (= arm "none")
          (do
            (when (!= (node-len cc) argi)
              (die-at line "make: none takes no fields"))
            (return (alloc-val (type-as-pkind ty PTR-MAYBE) "null")))
          (die-at line (fstr "make: niche (Maybe (ref T)) has arms `some`/`none`, not '" arm "'"))))
      ; --- rule 3: ERR_PTR-encoded pointer ---
      (if (= arm "ok")
        (do
          (when (!= (node-len cc) (+ argi 1))
            (die-at line "make: ok takes one (ref T) field"))
          (let (v:ref:Val (emit-node (node-at cc argi) scope))
            (when (-> v (_ 'type) (unsafe/cast ptr:Type _) (_ 'kind) (!= _ TY-PTR))
              (die-at line "make: ok expects a (ref T) pointer value"))
            ; p is stored directly; the flip guarantees it is non-null and never
            ; in the reserved top page, so it can't collide with an error.
            (let (rv:ref:Val (alloc-val (type-as-pkind ty PTR-ERRPTR) (v 'val)))
              (set! (rv 'taint) (v 'taint))
              (return rv))))
        (if (= arm "err")
          (do
            (when (!= (node-len cc) (+ argi 1))
              (die-at line "make: err takes one Err field"))
            (let (ev:ref:Val (emit-node (node-at cc argi) scope))
              (when (= (is-int-type (ev 'type)) 0)
                (die-at line "make: err expects an Err (i32) value"))
              ; (err E) = inttoptr(0 - zext(E to iptr)). Id 0 ("no error") maps to
              ; null, which is never a valid (ok) either, so it is a safe sentinel.
              (let (eid64:StrView (new-tmp)
                    neg:StrView (new-tmp)
                    pres:StrView (new-tmp))
                (emit g-body-stream "  " eid64 " = zext i32 " (ev 'val) " to " (ptr-int-ir) "\n")
                (emit g-body-stream "  " neg " = sub " (ptr-int-ir) " 0, " eid64 "\n")
                (emit g-body-stream "  " pres " = inttoptr " (ptr-int-ir) " " neg " to ptr\n")
                (return (alloc-val (type-as-pkind ty PTR-ERRPTR) pres)))))
          (die-at line (fstr "make: niche (Result (ref T) Err) has arms `ok`/`err`, not '" arm
                             "'")))))))

; (__niche-ctor arm args…) — internal: niche construction in return position,
; produced only by union-target-rewrite when the enclosing return type is a
; niche (rules 2/3). The encoding target is g-fn-ret-type (the niche pointer);
; the arm/args carry the original ok/err/some/none and their operands.
(defn emit-niche-ctor (call:ptr scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        ln:i32 ((unsafe/cast ptr:Node call) 'line)
        ty:ptr g-fn-ret-type
        layout:i32 (niche-layout-of g-fn-ret-type)
        arm-node:ptr:Node (unsafe/cast ptr:Node (node-at cc 1)))
    (when (= layout LAYOUT-TAGGED)
      (die-at ln "__niche-ctor: enclosing return type is not a niche"))
    (return (emit-niche-construct ty layout (symbol-as-cstr (arm-node 's)) call 2 scope ln))))

; Works for any defunion type, including stamped template instances, which
; have no constructor functions of their own.
(defn emit-make (call:ptr scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (< (node-len cc) 3)
      (die-at (cc 'line) "make: expects (make Type arm args...)"))
    (let (ty:ptr (parse-type-from-node (node-at cc 1) (cc 'line))
          layout:i32 (niche-layout-of ty))
      ; Niche layouts (rules 2/3) have no backing struct — construct the encoded
      ; pointer directly. uniondef-for-type would return null for these.
      (when (!= layout LAYOUT-TAGGED)
        (let (arm-node:ptr:Node (unsafe/cast ptr:Node (node-at cc 2)))
          (when (!= (arm-node 'kind) NODE-SYM)
            (die-at (node-line (as ptr arm-node) (cc 'line)) "make: arm must be a symbol"))
          (return (emit-niche-construct ty layout (symbol-as-cstr (arm-node 's)) call 3 scope (cc 'line)))))
      (let (ud:?ptr:UnionDef (uniondef-for-type ty))
        (when (= ud null)
          (die-at (cc 'line) "make: type is not a defunion"))
        (let (arm-node:ptr:Node (unsafe/cast ptr:Node (node-at cc 2)))
          (when (!= (arm-node 'kind) NODE-SYM)
            (die-at (node-line (as ptr arm-node) (cc 'line)) "make: arm must be a symbol"))
          (let (udd:ptr:UnionDef (unsafe/cast ptr:UnionDef ud)
                ai:i32 (union-arm-index (as ptr udd) (arm-node 's)))
            (when (< ai 0)
              (die-at (node-line (as ptr arm-node) (cc 'line))
                (fstr "make: no arm '" (arm-node 's) "' on '" (udd 'name) "'")))
            (return (emit-union-construct (as ptr udd) ai call 3 scope))))))))

; emit-handler-call — the shared chain-walk core of the handler negotiation
; (errors.md §4, §11.4), used by both the err-return form (__err-handled) and
; the standalone `signal` (C2). Walks g-handler-top for a handler matching
; (eid, type-token(repair-ty)) — exactly err-find-handler's key — and, on a
; match, applies the CL unbind rule (save top, set top = h->prev, call, restore)
; and yields the handler's (Maybe repair-ty). `none` (no handler, or the handler
; declined) is the default.
;
;   eid        : the Err value's SSA name (an i32)
;   repair-ty  : the repair/ok type T (a *value* type in v1 — a (ref X)
;                niche-pointer Maybe is not a struct, so the struct-return call
;                path below cannot carry it; errors.md §"E3 landed")
;   detail-val : the detail ptr's SSA name ("null" if none), borrowed for the call
;
; Yields a (Maybe repair-ty) Val, built into a slot defaulted to `none` and
; overwritten by the handler's result on a match (avoids a struct phi).
(defn emit-handler-call (eid:StrView repair-ty:raw:Type detail-val:StrView scope:ref:Scope line:i32):ref:Val
  (let (maybe-ty:ptr (stamp-maybe-type repair-ty line)
        mudd:ptr:UnionDef (unsafe/cast ptr:UnionDef (uniondef-for-type maybe-ty))
        msd:ptr:StructDef (unsafe/cast ptr:StructDef (mudd 'sdef))
        noneai:i32 (union-arm-index (as ptr mudd) (symbol-intern "none"))
        mslot:StrView (new-tmp)
        none-place:ptr (make-cell 'none null line)
        none-val:ref:Val (emit-union-construct (as ptr mudd) noneai none-place 1 scope))
    ; Result slot, defaulted to `none`.
    (emit g-entry-stream "  " mslot " = alloca %" (msd 'ir-name) ", align "
          (abi-struct-align (as ptr msd)) "\n")
    (emit g-body-stream "  store %" (msd 'ir-name) " " ((as ptr:Val none-val) 'val) ", ptr "
          mslot "\n")
    ; Token for repair-ty (its mangled name as a CStr), as with-handler's
    ; type-token emits, so the two agree (errors.md §11.2).
    (let (token:StrView (type-mangle-token repair-ty)
          tsid:i32 (intern-string token)
          tok:StrView (new-tmp))
      (emit g-body-stream "  " tok " = getelementptr inbounds ["
            (+ (unsafe/cast i32 (token 'len)) 1) " x i8], ptr @.str." tsid ", i64 0, i64 0\n")
      ; Find a willing handler. These three are non-null by the
      ; error-lib-in-scope precondition the callers check before reaching here;
      ; with no natural null-guard at the use sites, the cast-to-(ref) is the
      ; audited "known valid" assertion (nullability.md §5).
      (let (h:StrView (new-tmp)
            efh:ptr:Sym (unsafe/cast ptr:Sym (scope-lookup g-globals (symbol-intern "err-find-handler")))
            ght:ptr:Sym (unsafe/cast ptr:Sym (scope-lookup g-globals (symbol-intern "g-handler-top")))
            hsd:ptr:StructDef (unsafe/cast ptr:StructDef (struct-lookup-ref (sym-of (intern-str "Handler"))))
            id:i32 (new-label-id))
        (emit g-body-stream "  " h " = call ptr " (efh 'ir-name) "(i32 " eid ", ptr " tok ")\n")
        (let (hnull:StrView (new-tmp)
              have-lbl:StrView (fstr "hcall.have" id)
              join-lbl:StrView (fstr "hcall.join" id))
          (emit g-body-stream "  " hnull " = icmp eq ptr " h ", null\n")
          (emit g-body-stream "  br i1 " hnull ", label %" join-lbl ", label %" have-lbl "\n")
          ; Handler found: unbind it (CL rule §11.4), invoke, restore, store the
          ; (Maybe T) result into the slot.
          (emit g-body-stream have-lbl ":\n")
          (set! g-block-term 0)
          (let (saved:StrView (new-tmp)
                prevgep:StrView (new-tmp)
                prev:StrView (new-tmp)
                hfngep:StrView (new-tmp)
                hfn:StrView (new-tmp)
                ctxgep:StrView (new-tmp)
                ctx:StrView (new-tmp))
            (emit g-body-stream "  " saved " = load ptr, ptr " (ght 'ir-name) "\n")
            (emit g-body-stream "  " prevgep " = getelementptr inbounds %" (hsd 'ir-name)
                  ", ptr " h ", i32 0, i32 "
                  (struct-field-index (as ptr hsd) (sym-of (intern-str "prev"))) "\n")
            (emit g-body-stream "  " prev " = load ptr, ptr " prevgep "\n")
            (emit g-body-stream "  store ptr " prev ", ptr " (ght 'ir-name) "\n")
            (emit g-body-stream "  " hfngep " = getelementptr inbounds %" (hsd 'ir-name)
                  ", ptr " h ", i32 0, i32 "
                  (struct-field-index (as ptr hsd) (sym-of (intern-str "hfn"))) "\n")
            (emit g-body-stream "  " hfn " = load ptr, ptr " hfngep "\n")
            (emit g-body-stream "  " ctxgep " = getelementptr inbounds %" (hsd 'ir-name)
                  ", ptr " h ", i32 0, i32 "
                  (struct-field-index (as ptr hsd) (sym-of (intern-str "ctx"))) "\n")
            (emit g-body-stream "  " ctx " = load ptr, ptr " ctxgep "\n")
            ; m:(Maybe T) = hfn(ctx, detail) through the struct-return ABI.
            ; Emitted here rather than via emit-funcall-value: there is no AST
            ; for this call, so the ABI lowering has to be spelled out.
            (let (arglist:StrView (fstr "ptr " ctx ", ptr " detail-val)
                  mres:ref:Val (abi-emit-struct-call (abi-classify maybe-ty)
                                                     maybe-ty hfn arglist 2))
              (emit g-body-stream "  store ptr " saved ", ptr " (ght 'ir-name) "\n")
              (emit g-body-stream "  store %" (msd 'ir-name) " " ((as ptr:Val mres) 'val)
                    ", ptr " mslot "\n")
              (emit g-body-stream "  br label %" join-lbl "\n")))
          ; Join: load the (Maybe T).
          (emit g-body-stream join-lbl ":\n")
          (set! g-block-term 0)
          (let (mres-tmp:StrView (new-tmp))
            (emit g-body-stream "  " mres-tmp " = load %" (msd 'ir-name) ", ptr " mslot "\n")
            (return (alloc-val maybe-ty mres-tmp))))))))

; (signal E RepairType [detail]) — standalone handler negotiation (errors.md §4,
; §13 Q6; C2). Unlike `err`/`__err-handled` it is not tied to return position and
; does not wrap the result in (ok v): it hands the handler's (Maybe RepairType)
; straight back, so the caller decides what to do (continue in place, fall back,
; propagate). RepairType is a *type* operand, parsed not evaluated, like
; with-handler's type-token. Resolves only when (import error) is in scope.
(defn emit-signal (call:ptr scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        ln:i32 ((unsafe/cast ptr:Node call) 'line))
    (when (< (node-len cc) 3)
      (die-at ln "signal: expects (signal E RepairType [detail])"))
    (when (= (error-lib-in-scope) 0)
      (die-at ln "signal: requires (import error) — it walks the handler chain"))
    (let (ev:ref:Val (emit-node (node-at cc 1) scope)
          eid:StrView ((as ptr:Val ev) 'val)
          repair-ty:ptr (parse-type-from-node (node-at cc 2) ln)
          detail-val:StrView "null")
      (when (>= (node-len cc) 4)
        (let (dv:ref:Val (emit-node (node-at cc 3) scope))
          (set! detail-val (dv 'val))))
      (return (emit-handler-call eid repair-ty detail-val scope ln)))))

; (__err-handled E [detail]) — the handler-aware err negotiation (errors.md
; §11), produced only by union-target-rewrite at an `!T` (err arm = Err) return
; site when the error library is in scope. A value-expression of type
; (Result T Err), T = result-ok-type(g-fn-ret-type):
;
;   value = (err E)                              ; default (no handler / declined)
;   m:(Maybe T) = emit-handler-call(E, T, detail) ; shared chain walk (above)
;   match m: (some v) -> value = (ok v)          ; repaired; none stays err
;
; The (err E) default is built once into a result slot; only a repair overwrites
; it with (ok v), which avoids a struct phi and re-evaluating E along each path.
; `detail` is borrowed for the handler call and never stored (§11.5). E is the
; deferror Err value (a compile-time constant in every real use), so building the
; err arm and passing E to the find-walk evaluates it twice harmlessly.
(defn emit-err-handled (call:ptr scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        ln:i32 ((unsafe/cast ptr:Node call) 'line)
        ud:?ptr:UnionDef (result-union-of g-fn-ret-type))
    (when (= ud null)
      (die-at ln "__err-handled: enclosing return type is not a Result"))
    (let (udd:ptr:UnionDef (unsafe/cast ptr:UnionDef ud)
          okai:i32 (union-arm-index (as ptr udd) (symbol-intern "ok"))
          errai:i32 (union-arm-index (as ptr udd) (symbol-intern "err"))
          okty:ptr (result-ok-type g-fn-ret-type)
          rsd:ptr:StructDef (unsafe/cast ptr:StructDef (udd 'sdef))
          rty:ptr (type-for-sdef (udd 'sdef)))
      ; The error value E and an optional ptr detail.
      (when (< (node-len cc) 2)
        (die-at ln "err: expects (err E) or (err E detail)"))
      (let (enode:ptr (node-at cc 1)
            ev:ref:Val (emit-node enode scope)
            eid:StrView ((as ptr:Val ev) 'val)
            detail-val:StrView "null")
        (when (>= (node-len cc) 3)
          (let (dv:ref:Val (emit-node (node-at cc 2) scope))
            (set! detail-val (dv 'val))))
        ; Result slot, defaulted to (err E).
        (let (rslot:StrView (new-tmp)
              err-place:ptr (make-cell 'err
                              (make-cell enode null ln) ln)
              err-val:ref:Val (emit-union-construct (as ptr udd) errai err-place 1 scope))
          (emit g-entry-stream "  " rslot " = alloca %" (rsd 'ir-name) ", align "
                (abi-struct-align (as ptr rsd)) "\n")
          (emit g-body-stream "  store %" (rsd 'ir-name) " " ((as ptr:Val err-val) 'val)
                ", ptr " rslot "\n")
          ; Negotiate with bound handlers: the shared chain walk yields (Maybe T)
          ; (none if no handler matched or it declined).
          (let (m-val:ref:Val (emit-handler-call eid okty detail-val scope ln)
                maybe-ty:ptr (m-val 'type)
                id:i32 (new-label-id)
                mudd:ptr:UnionDef (unsafe/cast ptr:UnionDef (uniondef-for-type maybe-ty))
                msd:ptr:StructDef (unsafe/cast ptr:StructDef (mudd 'sdef))
                mslot:StrView (new-tmp)
                someai:i32 (union-arm-index (as ptr mudd) (symbol-intern "some"))
                tgep:StrView (new-tmp)
                tag:StrView (new-tmp)
                issome:StrView (new-tmp)
                some-lbl:StrView (fstr "errh.some" id)
                join-lbl:StrView (fstr "errh.join" id))
            ; match m: read its tag; some -> overwrite the slot with (ok v).
            (emit g-entry-stream "  " mslot " = alloca %" (msd 'ir-name) ", align "
                  (abi-struct-align (as ptr msd)) "\n")
            (emit g-body-stream "  store %" (msd 'ir-name) " " ((as ptr:Val m-val) 'val)
                  ", ptr " mslot "\n")
            (emit g-body-stream "  " tgep " = getelementptr inbounds %" (msd 'ir-name) ", ptr "
                  mslot ", i32 0, i32 0\n")
            (emit g-body-stream "  " tag " = load i32, ptr " tgep ", align 4\n")
            (emit g-body-stream "  " issome " = icmp eq i32 " tag ", " someai "\n")
            (emit g-body-stream "  br i1 " issome ", label %" some-lbl ", label %" join-lbl "\n")
            (emit g-body-stream some-lbl ":\n")
            (set! g-block-term 0)
            ; Load the repaired v from m's `some` payload (one field at the
            ; payload offset), then build (ok v) into the slot.
            (let (mpp:StrView (new-tmp)
                  vtmp:StrView (new-tmp)
                  vslot:StrView (fstr "%errh.v" id))
              (emit g-body-stream "  " mpp " = getelementptr inbounds i8, ptr " mslot ", i64 "
                    (union-payload-off (as ptr mudd)) "\n")
              (emit-load vtmp (type-to-ir okty) mpp okty)
              (emit g-entry-stream "  " vslot " = alloca " (type-to-ir okty) ", align "
                    (type-size okty) "\n")
              (emit-store (type-to-ir okty) vtmp vslot okty)
              (scope-define scope (symbol-intern "__errh_v") okty vslot 1)
              (let (ok-place:ptr (make-cell 'ok
                                   (make-cell '__errh_v null ln) ln)
                    ok-val:ref:Val (emit-union-construct (as ptr udd) okai ok-place 1 scope))
                (emit g-body-stream "  store %" (rsd 'ir-name) " " ((as ptr:Val ok-val) 'val)
                      ", ptr " rslot "\n")
                (emit g-body-stream "  br label %" join-lbl "\n")))
            ; Join: load the (Result T Err) value.
            (emit g-body-stream join-lbl ":\n")
            (set! g-block-term 0)
            (let (rv-tmp:StrView (new-tmp))
              (emit g-body-stream "  " rv-tmp " = load %" (rsd 'ir-name) ", ptr " rslot "\n")
              (return (alloc-val rty rv-tmp)))))))))

; Stamp the value-Maybe template instance (Maybe T) for the handler-call return
; type at an err site (errors.md §11.2). T is the !T's ok payload (a value type
; in v1; a (ref X) repair type — niche-encoded Maybe — is unsupported here).
(defn stamp-maybe-type (t:raw:Type line:i32):ref:Type
  (let (ut:?ptr:UnionTemplate (union-template-lookup-ref (symbol-intern "Maybe")))
    (when (= ut null)
      (die-at line (missing-template-message "err handler" (symbol-intern "Maybe"))))
    (let (argts:ptr (arena-alloc (ptr-bytes)))
      (set! (aref (as ptr:ptr argts) 0) t)
      (return (union-template-stamp-types ut argts 1 line)))))

; The error library (lib/error.nuc) is in scope: g-handler-top and
; err-find-handler resolve and the Handler struct is registered. The
; handler-aware err check (E3) is emitted only then — a program that never
; (import error) has no chain to consult, so plain err == err! and the compiler
; (which imports no error) self-compiles byte-identically.
(defn error-lib-in-scope ():i32
  (when (= (scope-lookup g-globals (symbol-intern "g-handler-top")) null) (return 0))
  (when (= (scope-lookup g-globals (symbol-intern "err-find-handler")) null) (return 0))
  (when (= (as ptr (struct-lookup-ref (sym-of (intern-str "Handler")))) null) (return 0))
  (return 1))

; True iff `ud`'s `err` arm is the `!T` shape: a single payload field of type
; Err (TY-ERR). Only then does errors.md §11.1 emit the handler check; a custom
; (Result T NonErr) is a plain union with no implicit machinery.
(defn result-err-arm-is-err (ud:raw:UnionDef):i32
  (let (ai:i32 (union-arm-index ud (symbol-intern "err")))
    (when (< ai 0) (return 0))
    (let (udd:raw:UnionDef ud
          arm:ref:Arm (invoke (udd 'arms) ai:usize))
      (when (!= (arm 'nfields) 1) (return 0))
      (let (pty:raw:Type (arm 'ptype))
        (when (= pty null) (return 0))
        (return (if (= (pty 'kind) TY-ERR) 1 0))))))

; Target typing (unions.md §5c, generalized by TC-5): when `target` is a
; defunion/niche and `form` reads `(arm args...)` for one of its arms, it is
; construction — rewrite to (make Type arm args...). Arm names win over
; functions/macros in exactly this position; everything else is untouched.
; `target` is the enclosing type: the function return type (g-fn-ret-type) at
; return positions, or the declared slot type at any want position (let/with
; binding init, set! RHS, .set! value — design/stage14/target-typed-
; constructors.md §TC-5). A null/non-union target leaves `form` unchanged.
(defn union-target-rewrite (form:ptr target:raw:Type):ptr
  (when (= form null) (return form))
  (when (= target null) (return form))
  ; Niche-ERRPTR target (unions.md §6 rule 3): the target type is a bare pointer,
  ; so uniondef-for-type is null. Rewrite ok/err/err! to the internal
  ; (__niche-ctor arm args…), which constructs against target's encoding.
  ; err! == err here (no handler path — a (ref X) repair isn't a struct, so the
  ; §11 negotiation doesn't apply). Niche-MAYBE targets are left untouched: their
  ; some/none already lower via emit-some / the null literal (byte-identical).
  (when (= (niche-layout-of target) LAYOUT-NICHE-ERRPTR)
    (when (and (= (-> (unsafe/cast ptr:Node form) (_ 'kind)) NODE-CELL) (> (node-len form) 0))
      (let (head:ptr:Node (unsafe/cast ptr:Node (node-at form 0))
            ln:i32 (-> (unsafe/cast ptr:Node form) (_ 'line)))
        (when (= (head 'kind) NODE-SYM)
          (let (hs:Symbol (head 's)
                arm:ptr null)
            (when (= hs "ok") (set! arm "ok"))
            (when (or (= hs "err") (= hs "err!")) (set! arm "err"))
            (when (!= arm null)
              (return (make-cell '__niche-ctor
                        (make-cell (intern-symbol arm)
                          (-> (unsafe/cast ptr:Node form) (_ 'cdr)) ln)
                        ln))))))))
  (let (ud:?ptr:UnionDef (uniondef-for-type target))
    (when (= ud null) (return form))
    (let (udd:ptr:UnionDef (unsafe/cast ptr:UnionDef ud)
          n:ptr:Node (unsafe/cast ptr:Node form))
      ; Bare `none` in return position of a value-Maybe function: construct the
      ; payload-less arm. `none` is a reserved keyword (never a user variable),
      ; so this can't shadow a binding; for a pointer-Maybe (niche) return,
      ; uniondef-for-type returned null above and `none` stays the relabel.
      (when (and (= (n 'kind) NODE-SYM)
                 (= (n 's) "none")
                 (>= (union-arm-index (as ptr udd) (symbol-intern "none")) 0))
        (let (ln:i32 (n 'line))
          (return (make-cell 'make
                    (make-cell (intern-node (udd 'name))
                      (make-cell 'none null ln) ln)
                    ln))))
      (when (!= (n 'kind) NODE-CELL) (return form))
      (when (= (node-len form) 0) (return form))
      (let (head:ptr:Node (unsafe/cast ptr:Node (node-at form 0))
            ln:i32 (n 'line))
        (when (!= (head 'kind) NODE-SYM) (return form))
        ; err! : construct the `err` arm unconditionally (the E3 opt-out that
        ; never consults handlers). It is the err arm with its `!` stripped.
        (when (= (head 's) "err!")
          (when (< (union-arm-index (as ptr udd) (symbol-intern "err")) 0) (return form))
          (return (make-cell 'make
                    (make-cell (intern-node (udd 'name))
                      (make-cell 'err (n 'cdr) ln)
                      ln)
                    ln)))
        ; Plain `err` at an `!T` (err arm = Err) return site, with the error
        ; library in scope: emit the handler negotiation (errors.md §11). The
        ; original `(err E [detail])` cdr is carried on a new internal special
        ; form `(__err-handled E [detail])`; emit-__err-handled does the IR.
        ; Without the library, or for a custom (Result T NonErr), `err` falls
        ; through to the plain `(make … err …)` construct below (== err!).
        (when (and (= (head 's) "err")
                   (= (result-err-arm-is-err (as ptr udd)) 1)
                   (= (error-lib-in-scope) 1))
          (return (make-cell '__err-handled (n 'cdr) ln)))
        (when (< (union-arm-index (as ptr udd) (head 's)) 0) (return form))
        (return (make-cell 'make
                  (make-cell (intern-node (udd 'name)) (as ptr n) ln)
                  ln))))))

; The EnumDef that owns `member`, or null. Member names are searched across
; every registered defenum; the first hit wins (defenum members are global
; constants, so a collision already means same-kind reuse).
(defn enumdef-lookup-member (member:Symbol):?ptr:EnumDef
  (dotimes (i (count g-enumdefs))
    (let (ed:ptr:EnumDef (as ptr:EnumDef (invoke g-enumdefs i)))
      (when (>= (enum-member-index ed member) 0)
        (return (as ptr ed)))))
  (return null))

(defn enum-member-index (ed:raw:EnumDef member:Symbol):i32
  (let (edd:raw:EnumDef ed)
    (dotimes (i (edd 'num-members))
      (when (= (aref (as ptr:Symbol (edd 'members)) i) member)
        (return i)))
    (return -1)))

; Bind one clause's payload binders into `inner`. `pp` is the payload pointer
; (already offset past the tag). Binders are positional: a symbol binds the
; field by value (a typed copy, like any field load — taint drops), `_`
; ignores it, and (ref x) binds a (ref FieldType) aliasing the field in place
; (pointer scrutinee only; the alias keeps the scrutinee's escape taint).
(defn emit-match-binders (ud:raw:UnionDef ai:i32 binders:ptr pp:StrView inner:ref:Scope
                               is-ptr:i32 staint:raw:Scope line:i32):void
  (let (udd:raw:UnionDef ud
        arm:ref:Arm (invoke (udd 'arms) ai:usize)
        nf:i32 (arm 'nfields)
        ftypes:ptr (arm 'ftypes)
        ptype:ptr:Type (unsafe/cast ptr:Type (arm 'ptype))
        bcur:ptr binders
        fi:i32 0)
    (while (!= bcur null)
      (let (b:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node bcur) 'car))
            ftype:ptr (aref (as ptr:ptr ftypes) fi)
            skip:i32 0)
        (when (and (= (b 'kind) NODE-SYM) (= (b 's) "_"))
          (set! skip 1))
        (when (= skip 0)
          ; Field address: the anon payload struct's member, or — single-field
          ; arm — the payload itself.
          (let (fa:StrView pp)
            (when (> nf 1)
              (set! fa (new-tmp))
              (emit g-body-stream "  " fa " = getelementptr inbounds %"
                    ((unsafe/cast ptr:StructDef (ptype 'sdef)) 'ir-name) ", ptr " pp
                    ", i32 0, i32 " fi "\n"))
            (if (= (b 'kind) NODE-SYM)
              ; By value: load the field into an ordinary local slot.
              (let (tmp:StrView (new-tmp)
                    slot:StrView (fstr "%" (ir-name-token (symbol-as-view (b 's))) ".addr." g-tmp))
                (inc! g-tmp)
                (emit-load tmp (type-to-ir ftype) fa ftype)
                (emit g-entry-stream "  " slot " = alloca " (type-to-ir ftype) ", align "
                      (type-size ftype) "\n")
                (emit-store (type-to-ir ftype) tmp slot ftype)
                (scope-define inner (b 's) ftype slot 1))
              ; (ref x): alias the field in place for mutation.
              (do
               (when (or (!= (b 'kind) NODE-CELL) (!= (node-len (as ptr b)) 2)
                         (!= (node-at (as ptr b) 0) 'ref))
                  (die-at (b 'line) "match: binder must be a name, _, or (ref name)"))
                (when (= is-ptr 0)
                  (die-at (b 'line)
                    "match: (ref ...) binder needs a pointer scrutinee — a by-value match binds copies"))
                (let (xn:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr b) 1)))
                  (when (!= (xn 'kind) NODE-SYM)
                    (die-at (b 'line) "match: (ref name) needs a symbol"))
                  (let (slot:StrView (fstr "%" (ir-name-token (symbol-as-view (xn 's))) ".addr." g-tmp))
                    (inc! g-tmp)
                    (emit g-entry-stream "  " slot " = alloca ptr, align 8\n")
                    (emit g-body-stream "  store ptr " fa ", ptr " slot ", align 8\n")
                    (let (rt:ptr:Type (as ptr:Type (make-type TY-PTR)))
                      (set! (rt 'elem) ftype)
                      (set! (rt 'pkind) PTR-REF)
                      (let (sym:ref:Sym (scope-define inner (xn 's) (as ptr rt) slot 1))
                        (set! (sym 'taint) staint))))))))))
      (inc! fi)
      (set! bcur ((unsafe/cast ptr:Node bcur) 'cdr)))))

; The shared lowering for match: an LLVM `switch` on the discriminant, one
; block per clause, cond's strict cross-branch typing and phi/void-collapse at
; the join. With no `_` clause the default block is `unreachable` (the match
; is exhaustive by construction; a corrupted tag is UB, the C contract).
; `ud`/`clause-binders` are null (and `base` empty) for the defenum variant.
(defn emit-match-clauses (call:ptr scope:ref:Scope disc:StrView disc-ty:StrView
                                  clause-val:ptr clause-binders:ptr ndefault:i32
                                  ud:raw:UnionDef is-ptr:i32 base:StrView staint:raw:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        nclauses:i32 (- (node-len cc) 2)
        ; TC-5 part 2: re-arm the want for each arm's value tail (a prior arm
        ; body or the dispatch may have consumed it).
        my-want:ptr g-want-type
        id:i32 (new-label-id)
        def-lbl:StrView (fstr "match.def" id)
        end-lbl:StrView (fstr "match.end" id)
        (vals (ref (Vector StrView))) (vector-new-in (addr-of g-arena-alloc))
        (preds (ref (Vector StrView))) (vector-new-in (addr-of g-arena-alloc))
        result-type:ptr null
        result-lit:i32 0
        result-taint:ptr null
        ci:i32 0)
    ; The dispatch: every non-default clause is a case on its arm/member value.
    (emit g-body-stream "  switch " disc-ty " " disc ", label %" def-lbl " [")
    (set! ci 0)
    (while (< ci nclauses)
      (when (>= (aref (as ptr:i32 clause-val) ci) 0)
        (emit g-body-stream " " disc-ty " " (aref (as ptr:i32 clause-val) ci) ", label %match.c"
              id "." ci))
      (inc! ci))
    (emit g-body-stream " ]\n")
    (set! g-block-term 1)
    ; Clause bodies (the `_` default's body is emitted under def-lbl).
    (set! ci 0)
    (while (< ci nclauses)
      (let (clause:ptr:Node (unsafe/cast ptr:Node (node-at cc (+ ci 2)))
            is-def:i32 (if (< (aref (as ptr:i32 clause-val) ci) 0) 1 0))
        (if (!= is-def 0)
          (emit g-body-stream def-lbl ":\n")
          (emit g-body-stream "match.c" id "." ci ":\n"))
        (set! g-block-term 0)
        (let (inner:ref:Scope (scope-new scope)
              tmark:i32 (narrow-mark))
          ; Payload binders (defunion clauses only).
          (when (and (!= ud null) (= is-def 0))
            (let (ai:i32 (aref (as ptr:i32 clause-val) ci)
                  binders:ptr (aref (as ptr:ptr clause-binders) ci))
              (when (!= binders null)
                (let (pp:StrView (new-tmp))
                  (emit g-body-stream "  " pp " = getelementptr inbounds i8, ptr " base ", i64 "
                        (union-payload-off ud) "\n")
                  (emit-match-binders ud ai binders pp inner is-ptr staint (cc 'line))))))
          ; Body: one or more forms, implicit do.
          (let (bv:ref:Val (alloc-val ty-void "")
                bcur:ptr ((unsafe/cast ptr:Node clause) 'cdr))
            (while (!= bcur null)
              (let (form:ptr ((unsafe/cast ptr:Node bcur) 'car))
                ; TC-5 part 2: target-type the tail (last) form against the armed want.
                (when (= ((unsafe/cast ptr:Node bcur) 'cdr) null)
                  (set! g-want-type my-want)
                  (set! form (union-target-rewrite form my-want)))
                (set! bv (emit-node form inner)))
              (set! bcur ((unsafe/cast ptr:Node bcur) 'cdr)))
            (emit-scope-cleanups inner)
            (let (bterm:i32 g-block-term)
              (when (= bterm 0)
                ; Stage 14 NS-3: a match arm ending in a string literal collapses
                ; to CStr (no IR) so the join/phi stays a plain pointer — unless
                ; the join is known to want a view. See join-strlit-branch.
                (set! bv (join-strlit-branch bv my-want (cc 'line)))
                (let (join-lbl:StrView (fstr "match.join" id "." ci)
                      bty:ptr (bv 'type))
                  ; cond's strict cross-branch typing: same type everywhere or
                  ; the whole form collapses to void; pointer kinds meet. MC-1's
                  ; shared type-join also absorbs bare-vs-typed ptr to (raw E);
                  ; LW-6: literal branches widen to a typed int sibling.
                  (if (= result-type null)
                    (do (set! result-type bty) (set! result-lit (bv 'is-lit)))
                    (do
                      (set! result-type (type-join result-type bty result-lit (bv 'is-lit)))
                      (set! result-lit (if (and (!= result-lit 0) (!= (bv 'is-lit) 0)) 1 0))))
                  (when (= ((as ptr:Type bty) 'kind) TY-VOID)
                    (set! result-type ty-void))
                  (set! result-taint (taint-merge result-taint (bv 'taint)))
                  (emit g-body-stream "  br label %" join-lbl "\n")
                  (emit g-body-stream join-lbl ":\n")
                  (emit g-body-stream "  br label %" end-lbl "\n")
                  (conj vals (bv 'val))
                  (conj preds join-lbl)))))
          (narrow-restore tmark)))
      (inc! ci))
    ; No `_` clause: the default is unreachable (exhaustiveness was verified).
    (when (= ndefault 0)
      (emit g-body-stream def-lbl ":\n")
      (emit g-body-stream "  unreachable\n"))
    (emit g-body-stream end-lbl ":\n")
    (set! g-block-term 0)
    (when (= (count vals) 0)
      (emit g-body-stream "  unreachable\n")
      (set! g-block-term 1))
    (if (or (= result-type null)
            (= ((as ptr:Type result-type) 'kind) TY-VOID))
      (return (alloc-val ty-void ""))
      (let (tmp:StrView (new-tmp)
            ty-ir:StrView (type-to-ir result-type)
            k:usize 0)
        (emit g-body-stream "  " tmp " = phi " ty-ir " ")
        (while (< k (count vals))
          (when (> k 0) (emit g-body-stream ", "))
          (emit g-body-stream "[ " (invoke vals k) ", %" (invoke preds k) " ]")
          (set! k (+ k 1)))
        (emit g-body-stream "\n")
        (let (rv:ref:Val (alloc-val result-type tmp))
          (set! (rv 'taint) result-taint)
          (return rv))))))

; match over a defenum scrutinee (the §4 freebie): bare member names as
; patterns, the same exhaustiveness rule, lowered to the same switch.
(defn emit-match-enum (call:ptr scope:ref:Scope sv:raw:Val):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        svv:raw:Val sv
        nclauses:i32 (- (node-len cc) 2)
        clause-val:ptr (arena-alloc (* (+ nclauses 1) 4))
        ed:ptr null
        ndefault:i32 0
        ci:i32 0)
    (when (< nclauses 1) (die-at (cc 'line) "match: at least one clause required"))
    ; Pass 1: resolve every pattern to a member value; find the default.
    (while (< ci nclauses)
      (let (clause:ptr:Node (unsafe/cast ptr:Node (node-at cc (+ ci 2))))
        (when (or (!= (clause 'kind) NODE-CELL) (< (node-len (as ptr clause)) 2))
          (die-at (clause 'line) "match: clause must be (pattern body...)"))
        (let (pat:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr clause) 0)))
          (when (!= (pat 'kind) NODE-SYM)
            (die-at (node-line (as ptr pat) (clause 'line)) "match: enum patterns are bare member names (or _)"))
          (if (= (pat 's) "_")
            (do
              (when (!= ci (- nclauses 1))
                (die-at (node-line (as ptr pat) (clause 'line)) "match: _ default must be the last clause"))
              (set! ndefault 1)
              (set! (aref (as ptr:i32 clause-val) ci) -1))
            (do
              (when (= ed null)
                (set! ed (as ptr (enumdef-lookup-member (pat 's))))
                (when (= ed null)
                  (die-at (node-line (as ptr pat) (clause 'line))
                    (fstr "match: '" (pat 's) "' is not a defenum member"))))
              (let (mi:i32 (enum-member-index ed (pat 's)))
                (when (< mi 0)
                  (die-at (node-line (as ptr pat) (clause 'line))
                    (fstr "match: '" (pat 's) "' is not a member of enum '"
                          ((as ptr:EnumDef ed) 'name) "'")))
                (let (cj:i32 0)
                  (while (< cj ci)
                    (when (= (aref (as ptr:i32 clause-val) cj) mi)
                      (die-at (node-line (as ptr pat) (clause 'line)) (fstr "match: duplicate arm '"
                                                                            (pat 's) "'")))
                    (inc! cj)))
                (set! (aref (as ptr:i32 clause-val) ci) mi))))))
      (inc! ci))
    (when (= ed null)
      (die-at (cc 'line) "match: enum match needs at least one member pattern"))
    ; Exhaustiveness: without _, every member must appear.
    (when (= ndefault 0)
      (let (edd:ptr:EnumDef (as ptr:EnumDef ed)
            mi:i32 0)
        (while (< mi (edd 'num-members))
          (let (hit:i32 0
                cj:i32 0)
            (while (< cj nclauses)
              (when (= (aref (as ptr:i32 clause-val) cj) mi) (set! hit 1))
              (inc! cj))
            (when (= hit 0)
              (die-at (cc 'line)
                (fstr "match: non-exhaustive — missing member '"
                      (aref (as ptr:Symbol (edd 'members)) mi) "' (add it or a _ default)"))))
          (inc! mi))))
    (return (emit-match-clauses call scope (svv 'val) (type-to-ir (svv 'type))
                                (as ptr clause-val) null ndefault
                                null 0 "" null))))

; is-err discriminant for a niche-ERRPTR value (errors.md §2/§8): one unsigned
; compare against -4096 (0xFFFF…F000). A valid object address is never ≥ that,
; so this cleanly separates the err sentinels (the top page) from real (ok)
; pointers with no discriminant word. Returns the SSA name of the i1 (bool) result.
(defn emit-errptr-is-err (rval:StrView):StrView
  (let (pi:StrView (new-tmp)
        thresh:StrView (new-tmp)
        cmp:StrView (new-tmp))
    (emit g-body-stream "  " pi " = ptrtoint ptr " rval " to " (ptr-int-ir) "\n")
    ; threshold = 0 - 4096, computed in iptr width (target-portable, no literal).
    (emit g-body-stream "  " thresh " = sub " (ptr-int-ir) " 0, 4096\n")
    (emit g-body-stream "  " cmp " = icmp uge " (ptr-int-ir) " " pi ", " thresh "\n")
    (return cmp)))

; (match r ((ok p) …) ((err e) …)) over a niche-ERRPTR value (unions.md §6
; rule 3) — the §3 switch-on-tag has no tag here, so branch on is-err. The ok
; clause binds p = r typed (ref T) (the niche elem); the err clause binds e =
; the extracted Err (0 - ptrtoint r, truncated to i32). Parallels the PTR-MAYBE
; some/none match lowering, with the ERR_PTR sentinel range as the discriminant.
; try/unwrap/unwrap-or route through here, so they need no niche-specific surface.
(defn emit-match-niche-errptr (call:ptr scope:ref:Scope sv:raw:Val elem:raw:Type):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        ; TC-5 part 2: emit-match re-arms the want just before dispatching here,
        ; so the arm emitters get it from the channel rather than the signature.
        my-want:ptr g-want-type
        rval:StrView (sv 'val)
        staint:ptr (sv 'taint)
        nclauses:i32 (- (node-len cc) 2)
        ok-body:ptr null   ok-bind:ptr null
        err-body:ptr null  err-bind:ptr null
        def-body:ptr null
        ci:i32 0)
    ; Resolve the (at most two) arm clauses + optional _ default.
    (while (< ci nclauses)
      (let (clause:ptr:Node (unsafe/cast ptr:Node (node-at cc (+ ci 2))))
        (when (or (!= (clause 'kind) NODE-CELL) (< (node-len (as ptr clause)) 2))
          (die-at (clause 'line) "match: clause must be (pattern body...)"))
        (let (pat:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr clause) 0)))
          (if (and (= (pat 'kind) NODE-SYM) (= (pat 's) "_"))
            (set! def-body ((unsafe/cast ptr:Node clause) 'cdr))
            (let (an:ptr:Node (if (= (pat 'kind) NODE-SYM) pat
                                (unsafe/cast ptr:Node (node-at (as ptr pat) 0))))
              (when (!= (an 'kind) NODE-SYM)
                (die-at (node-line (as ptr an) (clause 'line)) "match: arm name must be a symbol"))
              (let (binders:ptr (if (= (pat 'kind) NODE-CELL) (as ptr ((unsafe/cast ptr:Node pat) 'cdr)) null))
                (if (= (an 's) "ok")
                  (do (set! ok-body ((unsafe/cast ptr:Node clause) 'cdr)) (set! ok-bind binders))
                  (if (= (an 's) "err")
                    (do (set! err-body ((unsafe/cast ptr:Node clause) 'cdr)) (set! err-bind binders))
                    (die-at (node-line (as ptr an) (clause 'line))
                      (fstr "match: niche (Result (ref T) Err) has arms `ok`/`err`, not '"
                            (an 's) "'")))))))))
      (inc! ci))
    ; Exhaustiveness: cover both arms, or a _ default (unions.md §4).
    (when (= def-body null)
      (when (= ok-body null) (die-at (cc 'line) "match: non-exhaustive — missing arm 'ok' (add it or a _ default)"))
      (when (= err-body null) (die-at (cc 'line) "match: non-exhaustive — missing arm 'err' (add it or a _ default)")))
    ; A two-block diamond joined by a phi — cond's cross-branch typing applied
    ; across the ok/err arms (the §4 join logic, inlined for the two arms).
    (let (iserr:StrView (emit-errptr-is-err rval)
          id:i32 (new-label-id)
          err-lbl:StrView (fstr "match.err" id)
          ok-lbl:StrView (fstr "match.ok" id)
          end-lbl:StrView (fstr "match.end" id)
          (vals (ref (Vector StrView))) (vector-new-in (addr-of g-arena-alloc))
          (preds (ref (Vector StrView))) (vector-new-in (addr-of g-arena-alloc))
          ; result-type/result-taint are threaded through both arms; a single-
          ; element i32/ptr array stands in for a by-reference local. ltbox
          ; (LW-6) tracks whether every arm folded into rtbox so far was a
          ; bare int literal, so type-join knows when to widen.
          rtbox:ptr (arena-alloc (ptr-bytes))
          ttbox:ptr (arena-alloc (ptr-bytes))
          ltbox:ptr (arena-alloc 4))
      (set! (aref (as ptr:ptr rtbox) 0) null)
      (set! (aref (as ptr:ptr ttbox) 0) null)
      (set! (aref (as ptr:i32 ltbox) 0) 0)
      (emit g-body-stream "  br i1 " iserr ", label %" err-lbl ", label %" ok-lbl "\n")
      ; --- err arm: bind e = extracted id, run the err (or default) body ---
      (emit g-body-stream err-lbl ":\n")
      (set! g-block-term 0)
      (let (inner:ref:Scope (scope-new scope))
        (when (and (!= err-bind null) (!= (-> (unsafe/cast ptr:Node err-bind) (_ 'car)) null))
          (let (b:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node err-bind) 'car)))
            (when (and (= (b 'kind) NODE-SYM) (!= (b 's) "_"))
              (let (pineg:StrView (new-tmp) eid:StrView (new-tmp) idtr:StrView eid
                    slot:StrView (fstr "%" (ir-name-token (symbol-as-view (b 's))) ".addr." g-tmp))
                (inc! g-tmp)
                (emit g-body-stream "  " pineg " = ptrtoint ptr " rval " to " (ptr-int-ir) "\n")
                (emit g-body-stream "  " eid " = sub " (ptr-int-ir) " 0, " pineg "\n")
                ; Truncate to Err's i32 on a 64-bit target (no-op on 32-bit).
                (when (!= (ptr-int-ir) "i32")
                  (set! idtr (new-tmp))
                  (emit g-body-stream "  " idtr " = trunc " (ptr-int-ir) " " eid " to i32\n"))
                (emit g-entry-stream "  " slot " = alloca i32, align 4\n")
                (emit g-body-stream "  store i32 " idtr ", ptr " slot ", align 4\n")
                (scope-define inner (b 's) (as ptr ty-err) slot 1)))))
        (emit-niche-match-arm (if (!= err-body null) err-body def-body) inner
          vals preds rtbox ttbox ltbox end-lbl id 0 my-want))
      ; --- ok arm: bind p = r typed (ref T), run the ok (or default) body ---
      (emit g-body-stream ok-lbl ":\n")
      (set! g-block-term 0)
      (let (inner:ref:Scope (scope-new scope))
        (when (and (!= ok-bind null) (!= (-> (unsafe/cast ptr:Node ok-bind) (_ 'car)) null))
          (let (b:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node ok-bind) 'car)))
            (when (and (= (b 'kind) NODE-SYM) (!= (b 's) "_"))
              (let (rt:ptr:Type (as ptr:Type (make-type TY-PTR))
                    slot:StrView (fstr "%" (ir-name-token (symbol-as-view (b 's))) ".addr." g-tmp))
                (inc! g-tmp)
                (set! (rt 'elem) elem)
                (set! (rt 'pkind) PTR-REF)
                (emit g-entry-stream "  " slot " = alloca ptr, align 8\n")
                (emit g-body-stream "  store ptr " rval ", ptr " slot ", align 8\n")
                (let (sym:ref:Sym (scope-define inner (b 's) (as ptr rt) slot 1))
                  (set! (sym 'taint) staint))))))
        (emit-niche-match-arm (if (!= ok-body null) ok-body def-body) inner
          vals preds rtbox ttbox ltbox end-lbl id 1 my-want))
      ; --- join ---
      (emit g-body-stream end-lbl ":\n")
      (set! g-block-term 0)
      (let (result-type:ptr (aref (as ptr:ptr rtbox) 0)
            result-taint:ptr (aref (as ptr:ptr ttbox) 0))
        (when (= (count vals) 0)
          (emit g-body-stream "  unreachable\n")
          (set! g-block-term 1))
        (if (or (= result-type null) (= ((as ptr:Type result-type) 'kind) TY-VOID))
          (return (alloc-val ty-void ""))
          (let (tmp:StrView (new-tmp) ty-ir:StrView (type-to-ir result-type)
                k:usize 0)
            (emit g-body-stream "  " tmp " = phi " ty-ir " ")
            (while (< k (count vals))
              (when (> k 0) (emit g-body-stream ", "))
              (emit g-body-stream "[ " (invoke vals k) ", %" (invoke preds k) " ]")
              (set! k (+ k 1)))
            (emit g-body-stream "\n")
            (let (rv:ref:Val (alloc-val result-type tmp))
              (set! (rv 'taint) result-taint)
              (return rv))))))))

; (match m ((some p) …) (none …)) over a niche-MAYBE value (unions.md §6
; rule 2) — the §3 switch-on-tag has no tag here, so branch on a null test.
; The some clause binds p = r typed (ref T) (the niche elem); the none clause
; has no binder. Parallels the PTR-ERRPTR ok/err match lowering, with the
; null pointer as the discriminant.
(defn emit-match-niche-maybe (call:ptr scope:ref:Scope sv:raw:Val elem:raw:Type):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        ; TC-5 part 2: emit-match re-arms the want just before dispatching here,
        ; so the arm emitters get it from the channel rather than the signature.
        my-want:ptr g-want-type
        rval:StrView (sv 'val)
        staint:ptr (sv 'taint)
        nclauses:i32 (- (node-len cc) 2)
        some-body:ptr null   some-bind:ptr null
        none-body:ptr null
        def-body:ptr null
        ci:i32 0)
    ; Resolve the (at most two) arm clauses + optional _ default.
    (while (< ci nclauses)
      (let (clause:ptr:Node (unsafe/cast ptr:Node (node-at cc (+ ci 2))))
        (when (or (!= (clause 'kind) NODE-CELL) (< (node-len (as ptr clause)) 2))
          (die-at (clause 'line) "match: clause must be (pattern body...)"))
        (let (pat:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr clause) 0)))
          (if (and (= (pat 'kind) NODE-SYM) (= (pat 's) "_"))
            (set! def-body ((unsafe/cast ptr:Node clause) 'cdr))
            (let (an:ptr:Node (if (= (pat 'kind) NODE-SYM) pat
                                (unsafe/cast ptr:Node (node-at (as ptr pat) 0))))
              (when (!= (an 'kind) NODE-SYM)
                (die-at (node-line (as ptr an) (clause 'line)) "match: arm name must be a symbol"))
              (let (binders:ptr (if (= (pat 'kind) NODE-CELL) (as ptr ((unsafe/cast ptr:Node pat) 'cdr)) null))
                (if (= (an 's) "some")
                  (do (set! some-body ((unsafe/cast ptr:Node clause) 'cdr)) (set! some-bind binders))
                  (if (= (an 's) "none")
                    (do
                      (when (and (!= binders null) (!= (-> (unsafe/cast ptr:Node binders) (_ 'car)) null))
                        (die-at (node-line (as ptr an) (clause 'line)) "match: arm 'none' carries no payload — remove its binders"))
                      (set! none-body ((unsafe/cast ptr:Node clause) 'cdr)))
                    (die-at (node-line (as ptr an) (clause 'line))
                      (fstr "match: niche (Maybe (ref T)) has arms `some`/`none`, not '" (an 's)
                            "'")))))))))
      (inc! ci))
    ; Exhaustiveness: cover both arms, or a _ default (unions.md §4).
    (when (= def-body null)
      (when (= some-body null) (die-at (cc 'line) "match: non-exhaustive — missing arm 'some' (add it or a _ default)"))
      (when (= none-body null) (die-at (cc 'line) "match: non-exhaustive — missing arm 'none' (add it or a _ default)")))
    ; A two-block diamond joined by a phi — cond's cross-branch typing applied
    ; across the some/none arms.
    (let (cmp:StrView (new-tmp)
          id:i32 (new-label-id)
          none-lbl:StrView (fstr "match.none" id)
          some-lbl:StrView (fstr "match.some" id)
          end-lbl:StrView (fstr "match.end" id)
          (vals (ref (Vector StrView))) (vector-new-in (addr-of g-arena-alloc))
          (preds (ref (Vector StrView))) (vector-new-in (addr-of g-arena-alloc))
          rtbox:ptr (arena-alloc (ptr-bytes))
          ttbox:ptr (arena-alloc (ptr-bytes))
          ltbox:ptr (arena-alloc 4))
      (set! (aref (as ptr:ptr rtbox) 0) null)
      (set! (aref (as ptr:ptr ttbox) 0) null)
      (set! (aref (as ptr:i32 ltbox) 0) 0)
      ; Discriminant: null = none, non-null = some.
      (emit g-body-stream "  " cmp " = icmp eq ptr " rval ", null\n")
      (emit g-body-stream "  br i1 " cmp ", label %" none-lbl ", label %" some-lbl "\n")
      ; --- none arm: no binder, run the none (or default) body ---
      (emit g-body-stream none-lbl ":\n")
      (set! g-block-term 0)
      (let (inner:ref:Scope (scope-new scope))
        (emit-niche-match-arm (if (!= none-body null) none-body def-body) inner
          vals preds rtbox ttbox ltbox end-lbl id 0 my-want))
      ; --- some arm: bind p = r typed (ref T), run the some (or default) body ---
      (emit g-body-stream some-lbl ":\n")
      (set! g-block-term 0)
      (let (inner:ref:Scope (scope-new scope))
        (when (and (!= some-bind null) (!= (-> (unsafe/cast ptr:Node some-bind) (_ 'car)) null))
          (let (b:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node some-bind) 'car)))
            (when (and (= (b 'kind) NODE-SYM) (!= (b 's) "_"))
              (let (rt:ptr:Type (as ptr:Type (make-type TY-PTR))
                    slot:StrView (fstr "%" (ir-name-token (symbol-as-view (b 's))) ".addr." g-tmp))
                (inc! g-tmp)
                (set! (rt 'elem) elem)
                (set! (rt 'pkind) PTR-REF)
                (emit g-entry-stream "  " slot " = alloca ptr, align 8\n")
                (emit g-body-stream "  store ptr " rval ", ptr " slot ", align 8\n")
                (let (sym:ref:Sym (scope-define inner (b 's) (as ptr rt) slot 1))
                  (set! (sym 'taint) staint))))))
        (emit-niche-match-arm (if (!= some-body null) some-body def-body) inner
          vals preds rtbox ttbox ltbox end-lbl id 1 my-want))
      ; --- join ---
      (emit g-body-stream end-lbl ":\n")
      (set! g-block-term 0)
      (let (result-type:ptr (aref (as ptr:ptr rtbox) 0)
            result-taint:ptr (aref (as ptr:ptr ttbox) 0))
        (when (= (count vals) 0)
          (emit g-body-stream "  unreachable\n")
          (set! g-block-term 1))
        (if (or (= result-type null) (= ((as ptr:Type result-type) 'kind) TY-VOID))
          (return (alloc-val ty-void ""))
          (let (tmp:StrView (new-tmp) ty-ir:StrView (type-to-ir result-type)
                k:usize 0)
            (emit g-body-stream "  " tmp " = phi " ty-ir " ")
            (while (< k (count vals))
              (when (> k 0) (emit g-body-stream ", "))
              (emit g-body-stream "[ " (invoke vals k) ", %" (invoke preds k) " ]")
              (set! k (+ k 1)))
            (emit g-body-stream "\n")
            (let (rv:ref:Val (alloc-val result-type tmp))
              (set! (rv 'taint) result-taint)
              (return rv))))))))

; One arm body of a niche-ERRPTR match: run the forms (implicit do), apply
; cond's cross-branch typing into rtbox/ttbox (single-element ptr arrays), and
; (unless the block terminated) branch to a per-arm join feeding the end phi.
; `vals`/`preds` are the (ref (Vector ptr)) phi-incoming tables; the drain
; deferral makes the parametric type safe in this signature (see make-vec).
(defn emit-niche-match-arm (body:ptr inner:ref:Scope
                                 (vals (ref (Vector StrView))) (preds (ref (Vector StrView)))
                                 rtbox:ptr ttbox:ptr ltbox:ptr end-lbl:StrView id:i32 which:i32
                                 want:ptr):void
  (let (bv:ref:Val (alloc-val ty-void "")
        bcur:ptr body)
    (while (!= bcur null)
      (set! bv (emit-node ((unsafe/cast ptr:Node bcur) 'car) inner))
      (set! bcur ((unsafe/cast ptr:Node bcur) 'cdr)))
    (emit-scope-cleanups inner)
    (when (= g-block-term 0)
      ; Stage 14 NS-3: a niche/Result match arm ending in a string literal
      ; collapses to CStr (no IR) so the join/phi stays a plain pointer — unless
      ; the join is known to want a view. See join-strlit-branch.
      (set! bv (join-strlit-branch bv want g-form-line))
      (let (join-lbl:StrView (fstr "match.join" id "." which)
            bty:ptr (bv 'type)
            rt:ptr (aref (as ptr:ptr rtbox) 0)
            rlit:i32 (aref (as ptr:i32 ltbox) 0))
        (if (= rt null)
          (do (set! (aref (as ptr:ptr rtbox) 0) bty) (set! (aref (as ptr:i32 ltbox) 0) (bv 'is-lit)))
          ; MC-1: shared join (absorbs bare-vs-typed ptr to (raw E));
          ; LW-6: literal branches widen to a typed int sibling.
          (do
            (set! (aref (as ptr:ptr rtbox) 0) (type-join rt bty rlit (bv 'is-lit)))
            (set! (aref (as ptr:i32 ltbox) 0) (if (and (!= rlit 0) (!= (bv 'is-lit) 0)) 1 0))))
        (when (= ((as ptr:Type bty) 'kind) TY-VOID) (set! (aref (as ptr:ptr rtbox) 0) (as ptr ty-void)))
        (set! (aref (as ptr:ptr ttbox) 0) (taint-merge (aref (as ptr:ptr ttbox) 0) (bv 'taint)))
        (emit g-body-stream "  br label %" join-lbl "\n")
        (emit g-body-stream join-lbl ":\n")
        (emit g-body-stream "  br label %" end-lbl "\n")
        (conj vals (bv 'val))
        (conj preds join-lbl)))))

; (match scrutinee (pattern body...) ...) — the defunion eliminator
; (unions.md §4). Scrutinee: a defunion value, a ref/ptr to one (auto-deref
; for the tag; by-value binders copy payload fields, (ref x) binders alias
; them in place), or a defenum integer.
(defn emit-match (call:ptr scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (< (node-len cc) 3)
      (die-at (cc 'line) "match: expects a scrutinee and at least one clause"))
    (let (my-want:ptr g-want-type
          sv:ref:Val (emit-node (node-at cc 1) scope)
          st:ptr:Type (unsafe/cast ptr:Type (sv 'type)))
      ; TC-5 part 2: the scrutinee (a generic call) may have consumed the want;
      ; re-arm so clause/arm-body emitters distribute it to value tails.
      (set! g-want-type my-want)
      (case (niche-layout-of (sv 'type))
        LAYOUT-NICHE-ERRPTR
          (return (emit-match-niche-errptr call scope sv
                    ((sv 'type) 'elem)))
        LAYOUT-NICHE-MAYBE
          (return (emit-match-niche-maybe call scope sv
                    ((sv 'type) 'elem)))
        0)
      (when (!= (is-int-type (sv 'type)) 0)
        (return (emit-match-enum call scope sv)))
      (let (ud:ptr null
            base:StrView ""
            is-ptr:i32 0)
        (when (= (st 'kind) TY-STRUCT)
          (set! ud (as ptr (uniondef-for-type (sv 'type))))
          (when (!= ud null)
            ; Spill the by-value scrutinee so the tag and payload are addressable.
            (set! base (new-tmp))
            (let (sd:ptr:StructDef (unsafe/cast ptr:StructDef ((unsafe/cast ptr:UnionDef ud) 'sdef)))
              (emit g-entry-stream "  " base " = alloca %" (sd 'ir-name) ", align "
                    (abi-struct-align (as ptr sd)) "\n")
              (emit g-body-stream "  store %" (sd 'ir-name) " " (sv 'val) ", ptr " base "\n"))))
        (when (and (= (st 'kind) TY-PTR) (!= (st 'elem) null))
          (set! ud (as ptr (uniondef-for-type (st 'elem))))
          (when (!= ud null)
            (require-derefable st (cc 'line) "match")
            (set! base (sv 'val))
            (set! is-ptr 1)))
        (when (= ud null)
          (die-at (cc 'line)
            "match: scrutinee must be a defunion value, a pointer to one, or a defenum integer"))
        (let (udd:ptr:UnionDef (unsafe/cast ptr:UnionDef ud)
              nclauses:i32 (- (node-len cc) 2)
              clause-val:ptr (arena-alloc (* (+ nclauses 1) 4))
              clause-binders:ptr (arena-alloc (* (+ nclauses 1) (ptr-bytes)))
              ndefault:i32 0
              ci:i32 0)
          ; Pass 1: resolve patterns to arm indices; collect binder chains.
          (while (< ci nclauses)
            (let (clause:ptr:Node (unsafe/cast ptr:Node (node-at cc (+ ci 2))))
              (when (or (!= (clause 'kind) NODE-CELL) (< (node-len (as ptr clause)) 2))
                (die-at (clause 'line) "match: clause must be (pattern body...)"))
              (set! (aref (as ptr:ptr clause-binders) ci) null)
              (let (pat:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr clause) 0)))
                (if (= (pat 'kind) NODE-SYM)
                  (if (= (pat 's) "_")
                    (do
                      (when (!= ci (- nclauses 1))
                        (die-at (node-line (as ptr pat) (clause 'line)) "match: _ default must be the last clause"))
                      (set! ndefault 1)
                      (set! (aref (as ptr:i32 clause-val) ci) -1))
                    (let (ai:i32 (union-arm-index (as ptr udd) (pat 's)))
                      (when (< ai 0)
                        (die-at (node-line (as ptr pat) (clause 'line))
                          (fstr "match: no arm '" (pat 's) "' on '" (udd 'name) "'")))
                      (when (!= ((invoke (udd 'arms) ai:usize) 'nfields) 0)
                        (die-at (node-line (as ptr pat) (clause 'line))
                          (fstr "match: arm '" (pat 's)
                                "' carries a payload — bind its fields with (arm f...)")))
                      (set! (aref (as ptr:i32 clause-val) ci) ai)))
                  (do
                    (when (or (!= (pat 'kind) NODE-CELL) (= (node-len (as ptr pat)) 0))
                      (die-at (clause 'line) "match: pattern must be `arm`, `(arm binders...)`, or _"))
                    (let (an:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr pat) 0)))
                      (when (!= (an 'kind) NODE-SYM)
                        (die-at (node-line (as ptr an) (clause 'line)) "match: arm name must be a symbol"))
                      (let (ai:i32 (union-arm-index (as ptr udd) (an 's)))
                        (when (< ai 0)
                          (die-at (node-line (as ptr an) (clause 'line))
                            (fstr "match: no arm '" (an 's) "' on '" (udd 'name) "'")))
                        (when (!= (- (node-len (as ptr pat)) 1)
                                  ((invoke (udd 'arms) ai:usize) 'nfields))
                          (die-at (node-line (as ptr pat) (clause 'line))
                            (fstr "match: arm '" (an 's)
                                  "' binder count does not match its field count (use _ to ignore a field)")))
                        (set! (aref (as ptr:i32 clause-val) ci) ai)
                        (set! (aref (as ptr:ptr clause-binders) ci) ((unsafe/cast ptr:Node pat) 'cdr))))))
                ; Duplicate-arm check (defaults are -1 and can't collide).
                (when (>= (aref (as ptr:i32 clause-val) ci) 0)
                  (let (cj:i32 0)
                    (while (< cj ci)
                      (when (= (aref (as ptr:i32 clause-val) cj)
                               (aref (as ptr:i32 clause-val) ci))
                        (die-at (node-line (as ptr pat) (clause 'line)) "match: duplicate arm"))
                      (inc! cj))))))
            (inc! ci))
          ; Exhaustiveness: without _, every arm must appear (unions.md §4).
          (when (= ndefault 0)
            (let (ai:i32 0)
              (while (< ai (udd 'num-arms))
                (let (hit:i32 0
                      cj:i32 0)
                  (while (< cj nclauses)
                    (when (= (aref (as ptr:i32 clause-val) cj) ai) (set! hit 1))
                    (inc! cj))
                  (when (= hit 0)
                    (die-at (cc 'line)
                      (fstr "match: non-exhaustive — missing arm '"
                            ((invoke (udd 'arms) ai:usize) 'name) "' (add it or a _ default)"))))
                (inc! ai))))
          ; Read the tag and hand off to the shared switch/join emitter.
          (let (sd:ptr:StructDef (unsafe/cast ptr:StructDef (udd 'sdef))
                tgep:StrView (new-tmp)
                tag:StrView (new-tmp))
            (emit g-body-stream "  " tgep " = getelementptr inbounds %" (sd 'ir-name) ", ptr "
                  base ", i32 0, i32 0\n")
            (emit g-body-stream "  " tag " = load i32, ptr " tgep ", align 4\n")
            (return (emit-match-clauses call scope tag "i32"
                                        (as ptr clause-val) (as ptr clause-binders)
                                        ndefault (as ptr udd) is-ptr base
                                        (sv 'taint)))))))))

(defn emit-ptr-add (call:ptr scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 3) (die-at (cc 'line) "ptr+ expects 2 args"))
    (let (p:ref:Val (emit-node (node-at cc 1) scope))
      (when (or (-> p (_ 'type) (unsafe/cast ptr:Type _) (_ 'kind) (!= _ TY-PTR))
              (-> p (_ 'type) (unsafe/cast ptr:Type _) (_ 'elem) (= _ null)))
        (die-at (cc 'line) "ptr+: operand must be typed pointer"))
      (let (nv:ref:Val (emit-node (node-at cc 2) scope))
        (when (= (is-int-type (nv 'type)) 0)
          (die-at (cc 'line) "ptr+: offset must be integer"))
        ; The GEP index must be a pointer-sized integer and the register must
        ; match that annotation — `gep-index-ir` is that rule, shared with aref
        ; and aset! (Stage 15 W9 item 15).
        (let (idx:StrView (gep-index-ir nv))
          (let (elem:ptr (-> p (_ 'type) (unsafe/cast ptr:Type _) (_ 'elem))
                tmp:StrView (new-tmp))
            (emit g-body-stream "  " tmp " = getelementptr inbounds " (type-to-ir elem) ", ptr "
                  (p 'val) ", " (ptr-int-ir) " " idx "\n")
            ; An interior pointer aliases the resource: keep the taint
            ; (lifecycle.md §2.2) and, Stage 13 L1, the frame-region flag.
            (let (rv:ref:Val (alloc-val (p 'type) tmp))
              (val-copy-taint (as ptr rv) (as ptr p))
              (return rv))))))))

; Eliminate a condition to bool, for the six condition sites. An ELIMINATION,
; not a coercion — kept out of `coerce-int-val` so a `bool` slot does not become
; a universal sink. design/stage16-ergonomics/bool-truthiness.md
(defn condition-bool (v:ref:Val line:i32 ctx:ptr):ref:Val
  (let (t:ptr (v 'type))
    (when (= t null)
      (die-at line (fstr ctx ": condition has no type")))
    (let (tt:ptr:Type (unsafe/cast ptr:Type t))
      (when (= (tt 'kind) TY-BOOL) (return v))
      ; raw / bare raw / CStr / ?T. `ptr-pkind` answers PTR-RAW for CStr, which
      ; is what admits it without a kind arm of its own.
      (when (and (!= (is-ptr-like t) 0)
                 (or (= (ptr-pkind t) PTR-RAW) (= (ptr-pkind t) PTR-MAYBE)))
        (let (tmp:StrView (new-tmp))
          (emit g-body-stream "  " tmp " = icmp ne ptr " (v 'val) ", null\n")
          (return (alloc-val ty-bool tmp))))
      (when (and (= (tt 'kind) TY-PTR) (= (tt 'pkind) PTR-ERRPTR))
        (die-at line
          (fstr ctx
                ": a Result (!T) is neither true nor false -- eliminate it with match, try or unwrap")))
      (when (and (= (tt 'kind) TY-PTR) (= (tt 'pkind) PTR-REF))
        (die-at line
          (fstr ctx ": " (type-spelling t)
                " is non-null, so this test is always true -- spell the value (raw T) or ?T if it can be null")))
      (let (ud:?ptr:UnionDef (value-maybe-union-of t))
        (when (!= ud null)
          (let (si:i32 (union-arm-index (as ptr ud) (symbol-intern "some"))
                sd:ptr:StructDef (unsafe/cast ptr:StructDef (ud 'sdef))
                tag:StrView (new-tmp)
                tmp:StrView (new-tmp))
            (emit g-body-stream "  " tag " = extractvalue %" (sd 'ir-name) " " (v 'val) ", 0\n")
            (emit g-body-stream "  " tmp " = icmp eq i32 " tag ", " si "\n")
            (return (alloc-val ty-bool tmp)))))
      (die-at line
        (fstr ctx ": condition must be bool, not " (type-spelling t) " -- compare explicitly"))
      (return v))))

(defn emit-not (call:ptr scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 2) (die-at (cc 'line) "not expects 1 arg"))
    (let (a:ref:Val (condition-bool (emit-node (node-at cc 1) scope) (cc 'line) "not")
          tmp:StrView (new-tmp))
      (emit g-body-stream "  " tmp " = xor i1 " (a 'val) ", 1\n")
      (return (alloc-val ty-bool tmp)))))

(defn emit-short-circuit (call:ptr scope:ref:Scope is-and:i32):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        tag:ptr "or")
    (when (!= is-and 0) (set! tag "and"))
    (when (!= (node-len cc) 3)
      (die-at (cc 'line) (fstr tag " expects 2 args")))
    (let (id:i32 (new-label-id)
          rhs-lbl:StrView (fstr tag ".rhs" id)
          end-lbl:StrView (fstr tag ".end" id)
          slot:StrView (fstr "%" tag ".val" id))
      (emit g-entry-stream "  " slot " = alloca i1, align 1\n")
      (let (lhs:ref:Val (condition-bool (emit-node (node-at cc 1) scope)
                          (node-line (node-at cc 1) (cc 'line)) tag))
        (emit g-body-stream "  store i1 " (lhs 'val) ", ptr " slot ", align 1\n")
        (if (!= is-and 0)
          (emit g-body-stream "  br i1 " (lhs 'val) ", label %" rhs-lbl ", label %" end-lbl "\n")
          (emit g-body-stream "  br i1 " (lhs 'val) ", label %" end-lbl ", label %" rhs-lbl "\n"))
        (emit g-body-stream rhs-lbl ":\n")
        (set! g-block-term 0)
        ; Stage 10 narrowing: the rhs only runs when the lhs was true (and)
        ; or false (or) — so the lhs's facts hold while it is emitted. This
        ; is what makes (and (!= m null) (m kind)) check.
        (let (scmark:i32 (narrow-mark)
              (scfacts (ref (Vector Symbol))) (vector-new-in (addr-of g-arena-alloc)))
          (if (!= is-and 0)
            (test-true-nonnull (node-at cc 1) scfacts)
            (test-false-nonnull (node-at cc 1) scfacts))
          (narrow-names scope scfacts)
        (let (rhs:ref:Val (condition-bool (emit-node (node-at cc 2) scope)
                            (node-line (node-at cc 2) (cc 'line)) tag))
          (narrow-restore scmark)
          (emit g-body-stream "  store i1 " (rhs 'val) ", ptr " slot ", align 1\n")
          (emit g-body-stream "  br label %" end-lbl "\n")
          (emit g-body-stream end-lbl ":\n")
          (set! g-block-term 0)
          (let (tmp:StrView (new-tmp))
            (emit g-body-stream "  " tmp " = load i1, ptr " slot ", align 1\n")
            (return (alloc-val ty-bool tmp)))))))))

; ============================================================
; Stage 17 A1: `(try R)` — propagate an error out of the enclosing function.
; On `ok`, yield the payload; on `err`, `(return (err! e))`.
;
; A special form rather than a library macro because the `ok` arm's binder
; count depends on the operand's TYPE, which a macro cannot see: `!void`'s ok
; arm is payload-less (union-registry drops a `void` field), so `((ok v) v)` is
; an arity error there and `((ok) (do))` is an arity error everywhere else.
; See design/stage17-native-strings/overview.md phase A1.
; ============================================================

; Field count of the `ok` arm of `t`, or 1 when `t` is not a recognizable
; Result (the shape every pre-Stage-17 `!T` has, so an unknown type keeps the
; historical expansion and its diagnostics).
(defn try-ok-nfields (t:ptr):i32
  (when (= t null) (return 1))
  (let (ud:?ptr:UnionDef (result-union-of (as raw:Type t)))
    (when (= ud null) (return 1))
    (let (oi:i32 (union-arm-index (as ptr ud) (symbol-intern "ok")))
      (when (< oi 0) (return 1))
      (return ((invoke (ud 'arms) (as usize oi)) 'nfields)))))

(defn emit-try (call:ptr scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 2)
      (die-at (cc 'line) "try: expects exactly one operand — (try expr)"))
    (let (ln:i32 (cc 'line)
          rnode:ptr (node-at cc 1)
          nf:i32 (try-ok-nfields (as ptr (node-type (as raw:Node rnode) scope)))
          ev:ptr (as ptr (nucleus_gensym)))
      ; ((err E) (return (err! E)))
      (let (err-pat:ptr (make-cell 'err (make-cell ev null ln) ln)
            err-body:ptr (make-cell 'return
                           (make-cell (make-cell 'err! (make-cell ev null ln) ln)
                                      null ln) ln)
            ok-pat:ptr null
            ok-body:ptr null)
        (if (= nf 0)
          (do (set! ok-pat (make-cell 'ok null ln))
              (set! ok-body (make-cell 'do null ln)))
          (let (vv:ptr (as ptr (nucleus_gensym)))
            (set! ok-pat (make-cell 'ok (make-cell vv null ln) ln))
            (set! ok-body vv)))
        (let (ok-arm:ptr (make-cell ok-pat (make-cell ok-body null ln) ln)
              err-arm:ptr (make-cell err-pat (make-cell err-body null ln) ln))
          (return (emit-match
                    (make-cell 'match
                      (make-cell rnode
                        (make-cell ok-arm (make-cell err-arm null ln) ln) ln) ln)
                    scope)))))))

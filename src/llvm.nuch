; LLVM C API declarations for compile-time JIT
(declare LLVMInitializeX86TargetInfo () :void)
(declare LLVMInitializeX86Target () :void)
(declare LLVMInitializeX86TargetMC () :void)
(declare LLVMInitializeX86AsmPrinter () :void)
(declare LLVMInitializeAArch64TargetInfo () :void)
(declare LLVMInitializeAArch64Target () :void)
(declare LLVMInitializeAArch64TargetMC () :void)
(declare LLVMInitializeAArch64AsmPrinter () :void)
(declare LLVMInitializeARMTargetInfo () :void)
(declare LLVMInitializeARMTarget () :void)
(declare LLVMInitializeARMTargetMC () :void)
(declare LLVMInitializeARMAsmPrinter () :void)
(declare LLVMInitializeAVRTargetInfo () :void)
(declare LLVMInitializeAVRTarget () :void)
(declare LLVMInitializeAVRTargetMC () :void)
(declare LLVMInitializeAVRAsmPrinter () :void)
(declare LLVMOrcCreateLLJIT (builder:ptr options:ptr) :ptr)
(declare LLVMOrcLLJITGetMainJITDylib (jit:ptr) :ptr)
(declare LLVMOrcLLJITGetGlobalPrefix (jit:ptr) :i8)
(declare LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess (out:ptr prefix:i8 filter:ptr ctx:ptr) :ptr)
(declare LLVMOrcJITDylibAddGenerator (jd:ptr gen:ptr) :void)
(declare LLVMContextCreate () :ptr)
(declare LLVMOrcCreateNewThreadSafeContext () :ptr)
(declare LLVMOrcDisposeThreadSafeContext (ctx:ptr) :void)
(declare LLVMOrcCreateNewThreadSafeModule (mod:ptr ctx:ptr) :ptr)
(declare LLVMCreateMemoryBufferWithMemoryRangeCopy (data:ptr len:i64 name:ptr) :ptr)
(declare LLVMParseIRInContext (ctx:ptr buf:ptr mod:ptr msg:ptr) :i32)
(declare LLVMOrcLLJITAddLLVMIRModule (jit:ptr jd:ptr tsm:ptr) :ptr)
(declare LLVMOrcLLJITAddLLVMIRModuleWithRT (jit:ptr rt:ptr tsm:ptr) :ptr)
(declare LLVMOrcJITDylibCreateResourceTracker (jd:ptr) :ptr)
(declare LLVMOrcResourceTrackerRemove (rt:ptr) :ptr)
(declare LLVMOrcReleaseResourceTracker (rt:ptr) :void)
(declare LLVMOrcLLJITLookup (jit:ptr result:ptr name:ptr) :ptr)
(declare LLVMGetErrorMessage (err:ptr) :ptr)
(declare LLVMDisposeErrorMessage (msg:ptr) :void)
(declare LLVMConsumeError (err:ptr) :void)
; Target-machine APIs used by the binary (object-file) compilation path.
(declare LLVMGetDefaultTargetTriple () :ptr)
(declare LLVMGetTargetFromTriple (triple:ptr target:ptr msg:ptr) :i32)
(declare LLVMCreateTargetMachine (target:ptr triple:ptr cpu:ptr features:ptr level:i32 reloc:i32 model:i32) :ptr)
(declare LLVMDisposeTargetMachine (tm:ptr) :void)
(declare LLVMCreateTargetDataLayout (tm:ptr) :ptr)
(declare LLVMCopyStringRepOfTargetData (td:ptr) :ptr)
(declare LLVMDisposeTargetData (td:ptr) :void)
(declare LLVMPointerSize (td:ptr) :i32)
; ABI alignment of an LLVM type under a target's datalayout, in bytes. Used to
; derive Target.ptr-align from the datalayout (AVR aligns pointers at 1 byte,
; not pointer-size). LLVMInt8Type/LLVMPointerType manufacture an addrspace(0)
; `ptr` type in the global context to query.
(declare LLVMABIAlignmentOfType (td:ptr ty:ptr) :i32)
(declare LLVMInt8Type () :ptr)
(declare LLVMPointerType (elem:ptr addrspace:i32) :ptr)
(declare LLVMTargetMachineEmitToFile (tm:ptr mod:ptr filename:ptr filetype:i32 msg:ptr) :i32)
(declare LLVMDisposeMessage (msg:ptr) :void)
; Host CPU detection for -march=native (return strdup'd strings owned by caller).
(declare LLVMGetHostCPUName () :ptr)
(declare LLVMGetHostCPUFeatures () :ptr)
; New PassBuilder API: run the LLVM middle-end optimization pipeline on a module.
; LLVMRunPasses returns an LLVMErrorRef (null on success).
(declare LLVMCreatePassBuilderOptions () :ptr)
(declare LLVMDisposePassBuilderOptions (options:ptr) :void)
(declare LLVMRunPasses (mod:ptr passes:ptr tm:ptr options:ptr) :ptr)

(import-use arena)

; ABI lowering — SysV x86_64 and aarch64 struct-by-value classification and coercion.
; Source-imported by src/nucleusc.nuc after basic type functions are defined.

; ============================================================
; Aggregate ABI lowering — x86_64 System V and aarch64 (Stage 8 Phase C)
; ============================================================
; Struct-by-value parameters and returns must follow the platform C ABI, not
; LLVM's default by-value aggregate passing (which is not ABI-correct). The
; classifier below ports clang's eightbyte model: a struct ≤16 bytes is split
; into one or two eightbytes, each classified INTEGER or SSE and coerced to a
; register type; >16 bytes goes through memory (byval param / sret return on
; x86_64, plain pointer on aarch64).
; Only TY-STRUCT is ever non-DIRECT, so every scalar/pointer path is unchanged.
; See design/stage8/platform.md for the reverse-engineered coercion table.

; ============================================================
; Stage 14 §14.4 batch 3a — StructDef field table accessors.
; A StructDef's fields are one `(Vector (ref Field))` (was the two parallel
; arrays field-names/field-types). These are the shared read/build accessors.
; ============================================================

; Read field `i` of a field table. The cast asserts `fields` non-null: every caller
; loops under the `num-fields` bound, so a pre-registered struct's null is never indexed.
(defn field-at (fields:?&(Vector &Field) i:i32):&Field
  (return (invoke (unsafe/cast &(Vector &Field) fields) (as usize i))))

; Stage 16 PK-1: the alignment a load/store through a field of `sd` may claim.
; A packed field can sit at any byte, so the access must say `align 1` — an IR
; alignment the layout does not provide is a miscompile on a strict-alignment
; target and under vectorization on x86, and it is invisible to a sizeof/offset
; diff, which is why §11 asks for an access-side assertion of its own.
(defn field-load-align (sd:?&StructDef ty:?&Type):i32
  (when (= sd null) (return (type-size ty)))
  (when (!= ((unsafe/cast &StructDef sd) 'packed) 0) (return 1))
  (return (type-size ty)))

; The same rule for the two sites that emit a bare `store` with no align clause
; (a struct-literal field and a zero fill): empty leaves LLVM assuming the
; type's ABI alignment, which IS the answer for an unpacked struct, so every
; existing program's IR stays byte-identical.
(defn packed-align-suffix (sd:?&StructDef):StrView
  (when (= sd null) (return ""))
  (when (= ((unsafe/cast &StructDef sd) 'packed) 0) (return ""))
  (return ", align 1"))

; Stage 16 PK-1: write `%NAME = type { … }` — or `<{ … }>` when the struct is
; packed — for `sd`'s own field table. The line was open-coded at six sites, and
; the packed spelling has to be in one of them, not six; the same shape
; conventions.md records for the `declare` emitters, three of which had drifted.
; Every caller already ran `struct-set-fields`, which is what makes the field
; table (rather than the caller's own array) the source here.
(defn emit-struct-type-line ((stream ?&String) sd:?&StructDef):void
  (let (sdd:ptr:StructDef sd
        packed:i32 (sdd 'packed)
        nemit:i32 0
        el:i32 0 bt:i32 0 pad:i32 0 blob:i32 0 rs:i32 0
        ne:i32 0 sz:i32 0 tp:i32 0)
    (emit stream "%" (sdd 'ir-name) " = type " (if (!= packed 0) "<{ " "{ "))
    (dotimes (i (sdd 'num-fields))
      (struct-walk sd i (as &i32 &el) (as &i32 &bt)
                   (as &i32 &pad) (as &i32 &blob)
                   (as &i32 &rs) (as &i32 &ne)
                   (as &i32 &sz) (as &i32 &tp))
      ; PK-3: an `aligned(N)` gap is an element of its own, so the separator
      ; counts EMITTED elements rather than fields.
      (when (> pad 0)
        (when (!= nemit 0) (emit stream ", "))
        (emit stream "[" pad " x i8]")
        (inc! nemit))
      ; BF-1: a run of bitfields is ONE opaque `[k x i8]` storage element,
      ; written by the field that opens the run; the rest of the run adds
      ; nothing to the list. A zero-width member opens no run and emits nothing.
      (if (!= ((field-at (sdd 'fields) i) 'bit-width) 0)
        (when (!= rs 0)
          (when (!= nemit 0) (emit stream ", "))
          (emit stream "[" blob " x i8]")
          (inc! nemit))
        (do
          (when (!= nemit 0) (emit stream ", "))
          (emit stream (type-to-ir ((field-at (sdd 'fields) i) 'type)))
          (inc! nemit))))
    (let (tail:i32 (struct-tail-pad sd))
      (when (> tail 0)
        (when (!= nemit 0) (emit stream ", "))
        (emit stream "[" tail " x i8]")))
    (emit stream (if (!= packed 0) " }>\n\n" " }\n\n"))))

; ============================================================
; Structural type equality. Moved here from generics.nuc (Stage 16 FP-1): the
; coercion chokepoint `coerce-int-val` below needs it, and generics.nuc is
; imported after this file, so a call there could not resolve. It depends only
; on `field-at` above and the Type accessors, so this is the earliest point it
; can live. Every existing caller is downstream of here and is unaffected.
; ============================================================

; A function-pointer type IS its signature. Without this, `type-eq`'s default arm
; answered 1 for every TY-FN pair, so two closures differing only in return type
; shared one `apply` conformance — see design/stage16-ergonomics/bool-type-plan.md.
(defn fn-sig-eq (a:?&Type b:?&Type):i32
  (let (aa:ptr:Type a
        bb:ptr:Type b)
    (when (or (!= (aa 'num-params) (bb 'num-params))
              (!= (aa 'variadic) (bb 'variadic)))
      (return 0))
    (dotimes (i (aa 'num-params))
      (when (= (type-eq ((field-at (aa 'params) i) 'type)
                        ((field-at (bb 'params) i) 'type)) 0)
        (return 0)))
    (return (type-eq (aa 'ret) (bb 'ret)))))

; May a value of type `src` be stored in a slot declared `dst`? Introduced for
; function pointers (FP-1) and generalised in Stage 16 SE-1 to every same-kind
; pair, which is what it always computed. `type-eq` is *identity* and is the
; wrong question here — it is keyed on by the conformance registry, where two
; spellings of one type must agree exactly. Assignment is looser in the two ways
; C is looser, and only those two: pointer KIND is not part of the question
; (`pkind-flow-check` owns the nullability contract), and an elem-less bare `ptr`
; is `void *` — it matches any `ptr:T` in either direction, the same absorption
; `type-join` performs for a bare `ptr` branch (MC-1). A differing pointee, a
; differing StructDef, a differing arity or return type are refused.
; See design/stage16-ergonomics/template-ref-equality.md §4.
(defn slot-type-compat (src:?&Type dst:?&Type):i32
  (when (= src dst) (return 1))
  (when (or (= src null) (= dst null)) (return 0))
  (let (s:?&Type src
        d:?&Type dst)
    ; The void* rule. Only a *bare* ptr is the wildcard: `ptr:i32` against
    ; `ptr:Node` stays a refusal, which is the whole point of the check.
    ; `is-ptr-like`, NOT `is-ptr-repr` — the latter admits TY-FN, which would let
    ; a bare `ptr` parameter match a `(fn …)` one and reinstate exactly the
    ; data-pointer-into-callable-slot conversion `unsafe/cast` owns.
    (when (and (= (s 'kind) TY-PTR) (= (s 'elem) null)
               (!= (is-ptr-like d) 0))
      (return 1))
    (when (and (= (d 'kind) TY-PTR) (= (d 'elem) null)
               (!= (is-ptr-like s) 0))
      (return 1))
    ; Pointer kind is not part of the question: compare pointees, not pkinds.
    (when (and (= (s 'kind) TY-PTR) (= (d 'kind) TY-PTR))
      (return (slot-type-compat (s 'elem) (d 'elem))))
    (return (type-eq src dst))))

(defn fn-sig-compat (src:?&Type dst:?&Type):i32
  (let (s:ptr:Type src
        d:ptr:Type dst)
    (when (or (!= (s 'num-params) (d 'num-params))
              (!= (s 'variadic) (d 'variadic)))
      (return 0))
    (dotimes (i (s 'num-params))
      (when (= (slot-type-compat ((field-at (s 'params) i) 'type)
                                 ((field-at (d 'params) i) 'type)) 0)
        (return 0)))
    (return (slot-type-compat (s 'ret) (d 'ret)))))

; Structural type equality. Primitive types are singletons, so pointer equality
; handles them; structs are equal iff they share a StructDef; pointers compare
; their pointee (untyped ptr has elem=null, distinct from typed ptr).
(defn type-eq (a:?&Type b:?&Type):i32
  (when (= a b) (return 1))
  (when (or (= a null) (= b null)) (return 0))
  (let (aa:?&Type a
        bb:?&Type b)
    ; Stage 13 L7: a bare TY-FN (function pointer, as passed at a call site)
    ; and a (ref TY-FN) (as written in a generic param list after stamping)
    ; are compatible under the unify-tpat TY-FN-into-(ref G) rule. Treat them
    ; as type-eq so defn-ir-name finds the method registered with the bare
    ; argtype when emit-defn re-parses the stamped (ref __fnty_N) param.
    (when (and (= (aa 'kind) TY-FN)
               (= (bb 'kind) TY-PTR) (= (bb 'pkind) PTR-REF))
      (return (type-eq a (bb 'elem))))
    (when (and (= (bb 'kind) TY-FN)
               (= (aa 'kind) TY-PTR) (= (aa 'pkind) PTR-REF))
      (return (type-eq (aa 'elem) b)))
    (when (!= (aa 'kind) (bb 'kind)) (return 0))
    (case (aa 'kind)
      (:or TY-STRUCT TY-UNION) (if (= (aa 'sdef) (bb 'sdef)) (return 1) (return 0))
      TY-PTR (return (type-eq (aa 'elem) (bb 'elem)))
      ; Stage 15 W8 G-2: same element type AND same length. Reached from the
      ; constant-aggregate renderer, which checks the element type an
      ; `(array T …)` literal declares against the one its destination slot
      ; declares.
      TY-ARRAY (if (and (= (aa 'arr-len) (bb 'arr-len))
                        (!= (type-eq (aa 'elem) (bb 'elem)) 0))
                 (return 1) (return 0))
      ; Abstract type variables (A2 check only): equal iff the same variable of
      ; the same template (sdef = owning Method*, num-params = tyvar index).
      TY-TYVAR (if (and (= (aa 'sdef) (bb 'sdef)) (= (aa 'num-params) (bb 'num-params)))
                 (return 1) (return 0))
      TY-FN (return (fn-sig-eq a b))
      (return 1))))

; Stage 16 FP-3: a type as the USER wrote it, for a diagnostic.
;
; `type-spelling` cannot answer this and must not be taught to: its TY-FN arm
; returns `fnty-intern`'s `__fnty_<id>`, which is the conformance-registry key
; and has to stay round-trippable through `parse-type-name`. Printing it at a
; mismatch names nothing the user typed — `argument 4 has type __fnty_0, which
; does not match parameter type ptr` was the whole diagnostic for passing a
; function to `qsort`. Ask THIS one wherever the string is going into a message
; and `type-spelling` wherever it is going into a key.
;
; The signature format matches `fn-sig-spelling` (src/nuch.nuc), which renders
; the same shape from a flat param array for the `declare`-conflict message.
(defn fn-type-spelling (ft:?&Type):StrView
  (let (f:ptr:Type ft
        (acc String) (str-alloc (strfmt-alloc) "("))
    (dotimes (j (f 'num-params))
      (when (!= j 0) (str-into acc ", "))
      (str-into acc (type-display ((field-at (f 'params) j) 'type))))
    (when (!= (f 'variadic) 0)
      (str-into acc (if (= (f 'num-params) 0) "..." ", ...")))
    (str-into acc "):" (type-display (f 'ret)))
    (return (string-as-view acc))))

; The user's spelling of a type, for every message. `type-spelling` is the
; registry key: it writes each pointer as the kind-erased `ptr:T`.
(defn type-display (t:?&Type):StrView
  (when (= t null) (return "<none>"))
  (let (tt:?&Type t
        k:i32 (tt 'kind))
    (when (= k TY-FN) (return (fn-type-spelling t)))
    (when (= k TY-PTR) (return (ptr-type-display (tt 'pkind) (tt 'elem))))
    (when (= k TY-ARRAY)
      (return (fstr "(array " (type-display (tt 'elem)) " " (tt 'arr-len) ")")))
    (when (or (= k TY-STRUCT) (= k TY-UNION)) (return (sdef-display (tt 'sdef))))
    (return (symbol-as-view (type-spelling t)))))

; A struct or union name for a message. A stamped instance is printed from the
; origin its stamp recorded, not by its mangled registry name (`Vector.pPt`).
(defn sdef-display (sd:?&StructDef):StrView
  (let (s:ptr:StructDef sd
        st:?&StructTemplate (s 'origin-template)
        u:?&UnionDef (s 'udef))
    (when (!= st null)
      (return (template-app-display (st 'name) (s 'origin-args) (s 'origin-nargs))))
    (when (!= u null)
      (let (ut:?&UnionTemplate (u 'origin-template))
        (when (!= ut null)
          (return (template-app-display (ut 'name) (u 'origin-args) (u 'origin-nargs))))))
    (let (nv:StrView (symbol-as-view (s 'name))
          st?:bool (strview-has-prefix nv "__anon_struct_h"))
      (when (or st? (strview-has-prefix nv "__anon_union_h"))
        (let ((acc String) (str-alloc (strfmt-alloc) (if st? "(struct" "(union")))
          (dotimes (i (s 'num-fields))
            (let (f:&Field (field-at (s 'fields) i))
              (str-into acc " " (f 'name) ":" (type-display (f 'type)))))
          (str-into acc ")")
          (return (string-as-view acc))))
      (return nv))))

; A union by its instance type, so a niche `Maybe` reads `?&T` like its values.
(defn udef-display (ud:?&UnionDef):StrView
  (return (type-display (union-instance-type ud))))

; `(Name A …)`, except the prelude's `(Maybe T)` and `(Result T Err)`, whose
; canonical spellings are the sigils `?T` and `!T` (docs/types.md).
(defn template-app-display (name:Symbol args:ptr n:i32):StrView
  (let (a0:?&Type (if (> n 0) (unsafe/cast ptr:Type (aref (unsafe/cast &ptr args) 0)) null))
    (when (and (= n 1) (= name "Maybe"))
      (return (fstr "?" (type-display a0))))
    (when (and (= n 2) (= name "Result")
               (= (-> (aref (unsafe/cast &ptr args) 1) (unsafe/cast &Type _) (_ 'kind)) TY-ERR))
      (return (fstr "!" (type-display a0))))
    (let ((acc String) (str-alloc (strfmt-alloc) "(" name))
      (dotimes (i n)
        (str-into acc " " (type-display (unsafe/cast ptr:Type (aref (unsafe/cast &ptr args) i)))))
      (str-into acc ")")
      (return (string-as-view acc)))))

; The pointer-kind spellings of docs/types.md; an elem-less pointer is `void*`.
(defn ptr-type-display (pk:i32 e:?&Type):StrView
  (when (= e null)
    (when (= pk PTR-MAYBE) (return "?ptr"))
    (when (= pk PTR-ERRPTR) (return "!ptr"))
    (return "ptr"))
  (when (= pk PTR-RAW) (return (fstr "(ptr " (type-display e) ")")))
  (when (= pk PTR-MAYBE) (return (fstr "?&" (type-display e))))
  (when (= pk PTR-ERRPTR) (return (fstr "!&" (type-display e))))
  (return (fstr "&" (type-display e))))

; Populate a StructDef's `fields` Vector from parallel name/type arrays and set
; the cached `num-fields` count. Names are already interned by the caller (the
; array holds the canonical interned pointers, preserving struct-field-index's
; identity match); types are the raw Type* pointers. This is the single
; array→Vector conversion point for every StructDef builder.
(defn struct-set-fields (sd:&StructDef fnames:ptr ftypes:ptr nfields:i32):void
  (let (fields-vec:&(Vector &Field) (vector-new-in &g-arena-alloc))
    (dotimes (i:i32 nfields)
      (let (rec:&Field (new Field))
        (set! (rec 'name) (aref (unsafe/cast &Symbol fnames) i))
        (set! (rec 'type) (as ?&Type (aref (unsafe/cast &ptr ftypes) i)))
        (conj fields-vec rec)))
    (set! (sd 'fields) fields-vec)
    (set! (sd 'num-fields) nfields)
    ; W9 item 40: and this is what "has a layout" means from here on — see
    ; StructDef.laid-out. Same chokepoint argument as `opaque` below.
    (set! (sd 'laid-out) 1)
    ; W3a: giving a StructDef its layout is exactly what stops it being opaque.
    ; This is the single chokepoint every field-populating path funnels through
    ; (emit-defstruct, the .nuch import, the cheader struct-body parser, the
    ; anon-struct/union memoizer, the closure-env and fatptr builders), so a
    ; forward-declared C tag whose real definition arrives later upgrades in
    ; place here rather than at each of those call sites.
    (set! (sd 'opaque) 0)))

; Stage 16 PK-3: member `aligned(N)`, applied after struct-set-fields because it
; QUALIFIES a field rather than defining one — `faligns` is an i32 array parallel
; to the name/type arrays, null (or all-zero, the norm) when nothing carried it.
(defn struct-set-field-aligns (sd:&StructDef faligns:ptr nfields:i32):void
  (when (= faligns null) (return))
  (dotimes (i:i32 nfields)
    (let (a:i32 (aref (unsafe/cast &i32 faligns) i))
      (when (!= a 0)
        (set! ((field-at ((unsafe/cast &StructDef sd) 'fields) i) 'align-attr) a)))))

; Stage 16 BF-3: the same shape for `: width`. Signedness comes from the declared
; type rather than a separate flag, exactly as C reads it.
(defn struct-set-field-bits (sd:&StructDef fbits:ptr nfields:i32):void
  (when (= fbits null) (return))
  (dotimes (i:i32 nfields)
    (let (w:i32 (aref (unsafe/cast &i32 fbits) i))
      (when (!= w 0)
        (let (f:&Field (field-at ((unsafe/cast &StructDef sd) 'fields) i))
          (set! (f 'bit-width) w)
          (set! (f 'bf-signed) (if (!= (is-unsigned (f 'type)) 0) 0 1)))))))

; 1 when any member of `sd` is a bit-field.
(defn struct-has-bitfield (sd:&StructDef):i32
  (let (sdd:&StructDef sd)
    (dotimes (i:i32 (sdd 'num-fields))
      (when (!= ((field-at (sdd 'fields) i) 'bit-width) 0) (return 1)))
    (return 0)))

; A bit-field must have an integer declared type: its width, its boundary rule
; and its signedness all come from that type, and there is nothing to read them
; off a pointer or an aggregate.
(defn reject-bitfield-type (t:?&Type line:i32 w:i32 strict:i32):void
  (when (= strict 0) (return))
  (when (= (is-int-type t) 0)
    (die-at line
      (fstr "a ':bits' member must have an integer type, not " (type-display t))))
  (when (> w (* 8 (type-size t)))
    (die-at line
      (fstr "':bits " w "' exceeds the " (* 8 (type-size t)) " bits of its declared type"))))

; ============================================================
; Stage 14 §14.4: a TY-FN Type's parameter list is one `(Vector (ref Field))`
; (was the parallel `params`/`param-names` arrays). These are the shared
; build accessors; reads reuse `field-at` above (same `(ref Field)` element).
; ============================================================

; Build a `(Vector (ref Field))` from a raw ptr array of Type* param types.
; The `name` slot is left null — a Type's params carry no names (`param-names`
; was dead storage). Shared by `type-set-params` and the BoxedFn signature-token
; builder (union-registry.nuc), which must walk the same element shape.
(defn make-param-vec (ptypes:ptr np:i32):&(Vector &Field)
  (let (pv:&(Vector &Field) (vector-new-in &g-arena-alloc))
    (dotimes (i:i32 np)
      (let (rec:ref:Field (new Field))
        (set! (rec 'name) (symbol-none))
        (set! (rec 'type) (as ?&Type (aref (unsafe/cast &ptr ptypes) i)))
        (conj pv rec)))
    (return pv)))

; Populate a TY-FN Type's `params` Vector from a raw ptr array of Type* and set
; the cached `num-params`. The single array→Vector conversion point for every
; fn-type builder (mirrors struct-set-fields).
(defn type-set-params (t:&Type ptypes:ptr np:i32):void
  (set! (t 'params) (make-param-vec ptypes np))
  (set! (t 'num-params) np))

; Attach source parameter names to an already-built params Vector, for the REPL's
; `type-of` and `dir`. Separate from `type-set-params` because most fn-type
; builders have no names to give — a function-pointer type, an `extern` and a C
; import never had them, and positional `pN` is the honest answer there.
; Inert to the type system: `fn-sig-eq` compares only each Field's `type`.
(defn type-set-param-names (t:&Type pnames:ptr np:i32):void
  (when (= pnames null) (return))
  (dotimes (i:i32 np)
    (set! ((field-at (t 'params) i) 'name) (aref (unsafe/cast &Symbol pnames) i))))

; Check if target is aarch64 (AAPCS64 ABI uses plain pointers for large structs,
; not byval attributes).
(defn abi-is-aarch64 ():i32
  (return (if (strview-contains (symbol-as-view g-target-triple) "aarch64") 1 0)))

; Check if target is AVR (Stage 14 AVR-7). AVR is an 8-bit target: the SysV
; eightbyte model (8-byte-register chunks) does not fit, so `abi-classify`
; routes *every* aggregate (any size) through ABI-MEMORY with aarch64-style
; plain-pointer passing (no byval — AVR has no such attribute and byval's
; memcpy semantics don't map to its register-starved codegen). Spelled with the
; strncmp-prefix convention the rest of the codebase uses for AVR triples
; (reloc-for-triple / the datalayout is-avr check); AVR triples always begin
; `avr`. Inert on every hosted/RISC-V target (returns 0) → byte-identical.
(defn abi-is-avr ():i32
  (return (if (strview-has-prefix (symbol-as-view g-target-triple) "avr") 1 0)))

; Check if target is riscv64 (Stage 14 RV-3). riscv64's lp64d psABI passes and
; returns small aggregates via the INTEGER convention only in this v1 scope —
; hard-float FP-flattening of small FP-bearing structs into FPRs is deferred
; (it needs register-counting classification state, exactly like the aarch64
; HFA gap; design/stage14/riscv-linux.md §3). So abi-classify forces the INTEGER
; class for every eightbyte on riscv64 (skipping abi-class-eightbyte's field-type
; walk), and a >16-byte aggregate travels by aarch64-style plain pointer (no
; byval — abi-print-param / abi-arg-frag). Spelled with the same strncmp-prefix
; idiom as abi-is-avr / cpu-for-triple; riscv64 triples always begin `riscv64`.
; Inert on every hosted/x86_64/aarch64/AVR target (returns 0) → byte-identical.
(defn abi-is-riscv ():i32
  (return (if (strview-has-prefix (symbol-as-view g-target-triple) "riscv64") 1 0)))

; Stage 14 AVR-7 numerics policy: f64 is unsupported on AVR (8-bit target, no
; hardware double). Rejected at the two entry points where an f64-typed value is
; finalized: an explicit `:f64`/`double` annotation (parse-type-name,
; union-registry.nuc) and a bare float literal's f64 default (emit-float,
; nucleusc.nuc). Guarded by in-jit-module == 0 so a macro/CT body's compile-time
; f64 — which runs on the *host* at expansion time and is never emitted into the
; AVR program module — is unaffected; only the real target module (in-jit-module
; == 0) is gated. Inert on hosted targets (abi-is-avr == 0), so the compiler's
; own self-compile and every hosted program are byte-identical. f32 (a different
; type name, never rejected here) and i64 (correct via libgcc __*di3) are
; unaffected by design. abi.nuc is imported after scope.nuc (in-jit-module) and
; reader.nuc (die-at), and before union-registry.nuc / nucleusc.nuc, so this
; helper is in scope at both check sites.
(defn avr-reject-f64 (line:i32):void
  (when (and (!= (abi-is-avr) 0) (= (in-jit-module) 0))
    (die-at line
      "f64 is not supported on AVR by default (8-bit target, no hardware double); use f32, or a custom avr-gcc build with the -mdouble=64 multilib if you need genuine f64 -- see design/stage14/avr-targets.md")))

; Stage 16 FL-6: a wide float the emission target has no format for. AVR has
; none of the three; `f80` is x87 and exists nowhere else, so naming it off x86
; would otherwise emit an `x86_fp80` no other backend can select
; (design/stage16-ergonomics/c-boundary-defects.md §10, limit 3). C's own
; `long double` stays portable — the importer maps it per target — which is why
; only the representation SPELLING is refused here.
(defn reject-unavailable-float (name:Symbol line:i32):void
  (when (!= (in-jit-module) 0) (return))
  (when (!= (abi-is-avr) 0)
    (die-at line
      (fstr name " is not supported on AVR (8-bit target: f32 is the only float format)")))
  (when (and (= name "f80")
             (let (tv:StrView (symbol-as-view g-target-triple))
               (and (= (strview-contains tv "x86_64") false)
                    (= (strview-contains tv "i386") false))))
    (die-at line
      (fstr "f80 is the x87 80-bit format and exists only on x86 -- this target is "
            g-target-triple "; spell it `long double` in a C header, or use f128"))))

; Round x up to a multiple of a (a is a power of two in practice, but the
; arithmetic form works for any positive a).
(defn abi-align-up (x:i32 a:i32):i32
  (when (<= a 1) (return x))
  (return (* (/ (+ x (- a 1)) a) a)))

; ABI alignment of a type in bytes. Scalars use their natural alignment
; (== size); pointers/functions use the target pointer alignment; structs use
; the max alignment of any field.
(defn abi-alignof (t:ptr:Type):i32
  (let (k:i32 (t 'kind))
    (when (= k TY-STRUCT)
      (return (abi-struct-align (t 'sdef))))
    ; A union's alignment is its max member alignment — the same computation
    ; abi-struct-align performs, so it is shared.
    (when (= k TY-UNION)
      (return (abi-struct-align (t 'sdef))))
    ; Stage 15 W8 G-2: C's rule — an array's alignment is its element's.
    (when (= k TY-ARRAY) (return (abi-alignof (t 'elem))))
    ; Stage 16 PK-1: AVR's BIGGEST_ALIGNMENT is 8 bits — every SCALAR is
    ; byte-aligned, so a packed and an unpacked struct lay out identically there.
    ; Measured against `clang --target=avr`: `struct { int8_t; int32_t; int16_t; }`
    ; is 7 bytes, not 12. This was wrong before packing existed; the cross-target
    ; oracle §11 asks for is what surfaced it, on its first run. PK-3: it must
    ; sit BELOW the aggregate arms — an `aligned(N)` raises an alignment past
    ; BIGGEST_ALIGNMENT on AVR too, and short-circuiting here discarded it.
    (when (!= (abi-is-avr) 0) (return 1))
    ; TY-PTR / TY-CSTR / TY-FN had an arm each here; all three are the one rule
    ; `type-size` now answers via `is-ptr-repr` (W9 item 19), so they fall
    ; through to it below.
    (return (type-size t))))

; ABI size of a type in bytes. Unlike type-size (which returns the pointer size
; for any struct, sufficient for its by-reference slots), this walks struct
; fields so the classifier sees the real aggregate size.
(defn abi-sizeof (t:ptr:Type):i32
  (let (k:i32 (t 'kind))
    (when (= k TY-STRUCT)
      (return (abi-struct-size (t 'sdef))))
    (when (= k TY-UNION)
      (return (abi-union-size (t 'sdef))))
    ; The TY-FN arm that stood here is `type-size`'s answer since W9 item 19.
    ; Stage 15 W8 G-2: C's rule — N * sizeof(T), where sizeof(T) already
    ; includes T's own tail padding, so no extra rounding is needed (an array's
    ; alignment equals its element's, so the total is already a multiple of it).
    ; C1a: a flexible array member (arr-len -1) contributes no bytes.
    (when (= k TY-ARRAY)
      (when (< (t 'arr-len) 0) (return 0))
      (return (* (t 'arr-len) (abi-sizeof (t 'elem)))))
    (return (type-size t))))

; ABI size of an untagged union: the max member size, rounded up to the union's
; own (max member) alignment.
(defn abi-union-size (sd:?&StructDef):i32
  (let (sdd:ptr:StructDef sd
        n:i32 (sdd 'num-fields)
        mx:i32 0)
    (dotimes (i:i32 n)
      (let (fsz:i32 (abi-sizeof ((field-at (sdd 'fields) i) 'type)))
        (when (> fsz mx) (set! mx fsz))))
    (return (abi-align-up mx (abi-struct-align sd)))))

; Stage 16 PK-3: a declared alignment is a power of two, and C compilers cap it
; (clang at 2^29; 4096 is a page and is past anything a header asks for). A
; rejected value would otherwise reach LLVM as an unparseable `align 3`.
(defn align-attr-valid (n:i32):i32
  (when (or (< n 1) (> n 4096)) (return 0))
  (when (!= (bit-and n (- n 1)) 0) (return 0))
  (return 1))

; Stage 16 PK-1: the alignment field `i` is placed at inside `sd`. A packed
; struct gives every field alignment 1 — that single substitution is what makes
; the three offset walks below (size, eightbyte classification, riscv
; flattening) agree with clang without any of them growing a packed branch.
; PK-3: a member `aligned(N)` beats packing, which is why it is the max and not
; a second early-out — measured, `struct __attribute__((packed)) { char c; int i
; __attribute__((aligned(4))); }` puts `i` at 4.
; What a bit-field contributes to its struct's alignment. C leaves this to the
; psABI and the answers really differ — design/stage16-ergonomics/c-boundary-defects.md §14.8.
(defn bf-align-contrib (sd:?&StructDef i:i32):i32
  (let (sdd:ptr:StructDef sd
        f:ref:Field (field-at (sdd 'fields) i)
        a:i32 (abi-alignof (f 'type)))
    (when (!= (abi-is-aarch64) 0)
      (when (< (f 'bit-width) 0) (return a))
      (return (if (!= (sdd 'packed) 0) 1 a)))
    (when (< (f 'bit-width) 0) (return 1))
    ; C's unnamed bit-fields are minted `__bf.N` on import (cheader.nuc).
    (when (strview-has-prefix (symbol-as-view (f 'name)) "__bf.") (return 1))
    (return (if (!= (sdd 'packed) 0) 1 a))))

(defn abi-field-align (sd:?&StructDef i:i32):i32
  (let (sdd:ptr:StructDef sd
        f:ref:Field (field-at (sdd 'fields) i)
        na:i32 (if (!= (sdd 'packed) 0) 1 (abi-alignof (f 'type)))
        fa:i32 (f 'align-attr))
    (when (!= (f 'bit-width) 0) (set! na (bf-align-contrib sd i)))
    (when (> fa na) (return fa))
    (return na)))

; The alignment LLVM itself gives field `i` from the element list we emit — the
; baseline PK-3's explicit padding is measured against, and the reason `packed`
; is the only thing consulted here: LLVM has no notion of an aligned attribute.
(defn abi-field-ir-align (sd:?&StructDef i:i32):i32
  (let (sdd:ptr:StructDef sd)
    (when (!= (sdd 'packed) 0) (return 1))
    (return (abi-alignof ((field-at (sdd 'fields) i) 'type)))))

; Max field alignment of a struct (its own ABI alignment), raised by its own
; `aligned(N)`. PK-3: `aligned` can only ever raise — measured, `aligned(2)` on
; a struct of `int` leaves the alignment at 4 — so a max is the whole rule.
(defn abi-struct-align (sd:?&StructDef):i32
  (let (sdd:ptr:StructDef sd
        n:i32 (sdd 'num-fields)
        a:i32 1)
    (dotimes (i:i32 n)
      (let (fa:i32 (abi-field-align sd i))
        (when (> fa a) (set! a fa))))
    (when (> (sdd 'align-attr) a) (set! a (sdd 'align-attr)))
    (return a)))

; Stage 16 BF-1: THE struct layout walk. Everything positional about a struct is
; derived here — its size, the element list the type line prints, each field's
; GEP index, and each bitfield's bit position — so those four cannot drift apart.
; See design/stage16-ergonomics/c-boundary-defects.md §8 for the allocator and
; §14.8 for why the answers have to come from one walk.
;
; `q` is the field to report on (-1 for the totals alone). Bit offsets are
; ABSOLUTE from the struct's first byte, which is what C's "may not cross a
; boundary of the declared type" rule is stated against.
(defn struct-walk (sd:?&StructDef q:i32
                   out-elem:&i32      ; element index of field q
                   out-bit:&i32       ; absolute bit offset of field q's value
                   out-pad:&i32       ; pad bytes emitted before q's element
                   out-blob:&i32      ; byte size of q's storage run (0 = not a bitfield)
                   out-runstart:&i32  ; 1 = q is the first bitfield of its run
                   out-nelem:&i32     ; elements emitted in total
                   out-size:&i32      ; sizeof, tail padding included
                   out-tailpad:&i32   ; explicit tail pad bytes
                   ):void
  (let (sdd:ptr:StructDef sd
        n:i32 (sdd 'num-fields)
        packed:i32 (sdd 'packed)
        bit:i32 0        ; absolute bit cursor
        off:i32 0        ; byte cursor, which is also LLVM's once the pads are in
        elem:i32 0       ; next element index
        run:i32 0        ; a storage run is open
        run-start:i32 0  ; its first byte
        run-elem:i32 0   ; its element index
        run-q:i32 0      ; field q lives in the open run
        ira:i32 1)       ; LLVM's own alignment for the element list
    (set! (aref out-elem 0) (if (>= q 0) q 0))
    (set! (aref out-bit 0) 0)
    (set! (aref out-pad 0) 0)
    (set! (aref out-blob 0) 0)
    (set! (aref out-runstart 0) 0)
    (set! (aref out-nelem 0) n)
    (set! (aref out-tailpad 0) 0)
    ; A union's members all sit at offset 0 and its IR wrapper is built
    ; elsewhere (emit-union-ir-type), so none of this applies.
    (when (!= (sdd 'is-union) 0)
      (set! (aref out-size 0) (abi-union-size sd))
      (return))
    (dotimes (i:i32 n)
      (let (f:ref:Field (field-at (sdd 'fields) i)
            w:i32 (f 'bit-width))
        (if (!= w 0)
          ; C's storage-unit rule, and the ways a target or an attribute drop
          ; parts of it — measured against clang, design/stage16-ergonomics/c-boundary-defects.md §14.8.
          (let (avr:i32 (abi-is-avr)
                unit:i32 (if (!= (abi-is-avr) 0) 8 (* 8 (abi-sizeof (f 'type)))))
            (when (< w 0)
              ; A zero-width member allocates nothing, but it closes the open
              ; run and its forced boundary is padding — this field's element.
              (when (!= run 0)
                (let (endb:i32 (/ (+ bit 7) 8))
                  (when (!= run-q 0) (set! (aref out-blob 0) (- endb run-start)))
                  (set! off endb) (set! run 0) (set! run-q 0)))
              (set! bit (abi-align-up bit unit))
              (let (pad:i32 (- (/ bit 8) off))
                (when (= q i)
                  (set! (aref out-pad 0) pad) (set! (aref out-elem 0) elem) (set! (aref out-bit 0) bit))
                (when (> pad 0) (inc! elem))
                (set! off (/ bit 8))))
            (when (> w 0)
              (when (= packed 0)
                (when (= avr 0)
                  (when (> (+ (% bit unit) w) unit)
                    (set! bit (abi-align-up bit unit)))))
              (when (= run 0)
                (let (rs:i32 (/ bit 8)
                      pad:i32 (- (/ bit 8) off))
                  (when (= q i) (set! (aref out-pad 0) pad) (set! (aref out-runstart 0) 1))
                  (when (> pad 0) (inc! elem))
                  (set! off rs)
                  (set! run 1) (set! run-start rs) (set! run-elem elem)
                  (set! run-q 0)
                  (inc! elem)))
              (when (= q i)
                (set! (aref out-elem 0) run-elem)
                (set! (aref out-bit 0) bit)
                (set! run-q 1))
              (set! bit (+ bit w))))
          (do
            ; A non-bitfield closes the open run: its blob spans whole bytes.
            (when (!= run 0)
              (let (endb:i32 (/ (+ bit 7) 8))
                (when (!= run-q 0) (set! (aref out-blob 0) (- endb run-start)))
                (set! off endb) (set! bit (* endb 8))
                (set! run 0) (set! run-q 0)))
            (let (na:i32 (abi-field-ir-align sd i)
                  want:i32 (abi-align-up off (abi-field-align sd i)))
              (let (pad:i32 (- want (abi-align-up off na)))
                (when (= q i)
                  (set! (aref out-pad 0) pad)
                  (set! (aref out-bit 0) (* want 8))
                  (set! (aref out-elem 0) (+ elem (if (> pad 0) 1 0))))
                (when (> pad 0) (inc! elem)))
              (inc! elem)
              (when (> na ira) (set! ira na))
              (set! off (+ want (abi-sizeof (f 'type))))
              (set! bit (* off 8)))))))
    (when (!= run 0)
      (let (endb:i32 (/ (+ bit 7) 8))
        (when (!= run-q 0) (set! (aref out-blob 0) (- endb run-start)))
        (set! off endb)))
    (set! (aref out-nelem 0) elem)
    (let (size:i32 (abi-align-up off (abi-struct-align sd)))
      (set! (aref out-size 0) size)
      (set! (aref out-tailpad 0) (- size (abi-align-up off ira))))))

; The thin readers over `struct-walk`. Each is one question; none of them
; re-derives the allocation.
(defn struct-walk-size (sd:?&StructDef):i32
  (let (a:i32 0 b:i32 0 c:i32 0 d:i32 0 e:i32 0 f:i32 0 g:i32 0 h:i32 0)
    (struct-walk sd -1 (as &i32 &a) (as &i32 &b)
                 (as &i32 &c) (as &i32 &d)
                 (as &i32 &e) (as &i32 &f)
                 (as &i32 &g) (as &i32 &h))
    (return g)))

(defn struct-tail-pad (sd:?&StructDef):i32
  (let (a:i32 0 b:i32 0 c:i32 0 d:i32 0 e:i32 0 f:i32 0 g:i32 0 h:i32 0)
    (struct-walk sd -1 (as &i32 &a) (as &i32 &b)
                 (as &i32 &c) (as &i32 &d)
                 (as &i32 &e) (as &i32 &f)
                 (as &i32 &g) (as &i32 &h))
    (return h)))

; Source field index → element index in the emitted LLVM type. They differ by
; the pads `aligned(N)` inserts and by the storage runs bitfields share, so every
; `getelementptr … i32 0, i32 <n>` on a struct must go through here.
(defn field-ir-index (sd:?&StructDef i:i32):i32
  (when (= sd null) (return i))
  (let (a:i32 0 b:i32 0 c:i32 0 d:i32 0 e:i32 0 f:i32 0 g:i32 0 h:i32 0)
    (struct-walk sd i (as &i32 &a) (as &i32 &b)
                 (as &i32 &c) (as &i32 &d)
                 (as &i32 &e) (as &i32 &f)
                 (as &i32 &g) (as &i32 &h))
    (return a)))

; Absolute bit offset of field `i`'s value from the struct's first byte.
(defn field-bit-offset (sd:?&StructDef i:i32):i32
  (let (a:i32 0 b:i32 0 c:i32 0 d:i32 0 e:i32 0 f:i32 0 g:i32 0 h:i32 0)
    (struct-walk sd i (as &i32 &a) (as &i32 &b)
                 (as &i32 &c) (as &i32 &d)
                 (as &i32 &e) (as &i32 &f)
                 (as &i32 &g) (as &i32 &h))
    (return b)))

; The alignment an `alloca` holding `t` must state. Only ever RAISES what the
; site already said (`type-size`, the pointer size for any aggregate), so no
; existing line moves — but an over-aligned or `fp128`-bearing struct needs more
; than 8 and nothing else on the line says so.
(defn abi-slot-align (t:?&Type):i32
  (let (a:i32 (abi-alignof t)
        s:i32 (type-size t))
    (when (> a s) (return a))
    (return s)))

; The same question at the sites that print a bare `alloca %S` with no align:
; there the baseline is what LLVM derives from the element list, which knows
; nothing about `aligned(N)`. Empty whenever the two agree, which is every
; struct without one.
(defn struct-align-suffix (sd:&StructDef):StrView
  (let (sdd:&StructDef sd
        n:i32 (sdd 'num-fields)
        ira:i32 1
        a:i32 (abi-struct-align sd))
    (dotimes (i:i32 n)
      ; A bitfield's element is the run's `[k x i8]`, which LLVM aligns at 1.
      (when (= ((field-at (sdd 'fields) i) 'bit-width) 0)
        (let (fa:i32 (abi-field-ir-align sd i))
          (when (> fa ira) (set! ira fa)))))
    (when (<= a ira) (return ""))
    (return (fstr ", align " a))))

; ABI size of a struct — one line, because struct-walk is the layout.
(defn abi-struct-size (sd:?&StructDef):i32
  (return (struct-walk-size sd)))

; Classify the eightbyte covering absolute bytes [lo, lo+8) against the fields
; of struct sd placed at absolute base offset `base`. Recurses into nested
; struct fields by absolute offset. Returns a class code: 0 none, 1 SSE/float,
; 2 SSE/double, 3 INTEGER. Higher wins (INTEGER beats SSE; double beats float).
;
; Stage 16 FL-4 adds two above INTEGER, and the merge order is why they sit
; there: SysV says an aggregate containing an X87 field is MEMORY *whatever*
; else it holds, so ABI-CLS-X87 must win every merge; and an `fp128` occupies
; both eightbytes alone (its alignment is 16, so anything beside it takes the
; struct past 16 bytes and out through the MEMORY exit), so ABI-CLS-SSEUP can
; never actually be merged against anything but itself.
(defn abi-class-eightbyte (sd:?&StructDef base:i32 lo:i32):i32
  (let (sdd:ptr:StructDef sd
        n:i32 (sdd 'num-fields)
        hi:i32 (+ lo 8)
        off:i32 0
        cls:i32 0
        i:i32 0)
    (while (< i n)
      ; Union members all live at offset 0 — neutralize the running offset so
      ; every member is classified against the same base (SysV merges the
      ; classes of all members, which the max-merge below already does).
      (let (f:ref:Field (field-at (sdd 'fields) i)
            ft:ptr (f 'type)
            w:i32 (f 'bit-width))
        (set! off (if (!= (sdd 'is-union) 0) 0 (/ (field-bit-offset sd i) 8)))
        (if (!= w 0)
          ; BF-1: a bitfield's storage is bytes, and SysV classifies a bit-field
          ; as INTEGER whatever its declared type — so it contributes over the
          ; bytes its bits touch and never recurses.
          (when (> w 0)
            (let (b:i32 (field-bit-offset sd i)
                  fabs:i32 (+ base (/ b 8))
                  eend:i32 (+ base (/ (+ (+ b w) 7) 8)))
              (when (and (< fabs hi) (> eend lo))
                (when (> ABI-CLS-INTEGER cls) (set! cls ABI-CLS-INTEGER)))))
          (let (fsz:i32 (abi-sizeof ft)
                fabs:i32 (+ base off))
            ; Does this field overlap [lo, hi)?
            (when (and (< fabs hi) (> (+ fabs fsz) lo))
              (let (sub:i32 (abi-class-type-at ft fabs lo))
                (when (> sub cls) (set! cls sub)))))))
      (inc! i))
    (return cls)))

; The class contribution of ONE value of type `ft` placed at absolute offset
; `fabs`, for the eightbyte [lo, lo+8). Extracted from abi-class-eightbyte's
; field loop in Stage 15 W8 G-2 so the array case has somewhere to recurse: an
; `(array T N)` field is N consecutive T values, each of which classifies on its
; own, and only the ones overlapping this eightbyte contribute. Merging the
; classes of an array of floats element-by-element is what keeps
; `struct { float v[2]; }` an SSE eightbyte (`<2 x float>`) instead of being
; swept into INTEGER by the old "not a struct, not a float → 3" fall-through.
(defn abi-class-type-at (ft:?&Type fabs:i32 lo:i32):i32
  (let (ftt:ptr:Type ft
        fk:i32 (ftt 'kind))
    (when (or (= fk TY-STRUCT) (= fk TY-UNION))
      (return (abi-class-eightbyte (ftt 'sdef) fabs lo)))
    (when (= fk TY-ARRAY)
      (let (et:?&Type (ftt 'elem)
            esz:i32 (abi-sizeof (ftt 'elem))
            n:i32 (ftt 'arr-len)
            hi:i32 (+ lo 8)
            cls:i32 0)
        ; A zero-size element would make the scan below non-terminating in the
        ; "skip to the first overlapping element" sense; it cannot occur (every
        ; representable type has size ≥ 1) but the guard states it.
        (when (<= esz 0) (return 0))
        (dotimes (k n)
          (let (eabs:i32 (+ fabs (* k esz)))
            (when (and (< eabs hi) (> (+ eabs esz) lo))
              (let (sub:i32 (abi-class-type-at et eabs lo))
                (when (> sub cls) (set! cls sub))))))
        (return cls)))
    ; FL-4: measured against clang — `struct { long double x; }` is
    ; `ptr byval(...) align 16` (X87 poisons the aggregate to MEMORY), while
    ; `struct { __float128 x; }` is ONE `fp128` in xmm, so answering MEMORY
    ; there — the conservative answer — would be an ABI mismatch. `half` is
    ; ordinary SSE and merges with INTEGER to i64, which the max-merge above
    ; already produces.
    (when (= fk TY-F80)  (return ABI-CLS-X87))
    (when (= fk TY-F128) (return ABI-CLS-SSEUP))
    (when (!= (is-float-type ft) 0)
      (if (= fk TY-F64) (return 2) (return 1)))
    (return 3)))     ; integer / pointer → INTEGER

; Coercion IR type for one eightbyte: class `cls` holding `n` bytes (1..8).
; INTEGER → i(8·n) for n ≤ 4 (i8/i16/i24/i32), else i64. SSE/double → double.
; SSE/float → <2 x float> when the eightbyte is full, else float.
(defn abi-eightbyte-ir (cls:i32 n:i32):StrView
  ; FL-4: an fp128 is one value across both eightbytes, so its second half is
  ; never rendered — abi-classify collapses the pair before reaching here.
  (when (= cls ABI-CLS-SSEUP) (return "fp128"))
  (when (= cls 2) (return "double"))
  (when (= cls 1)
    (if (= n 8) (return "<2 x float>") (return "float")))
  (if (<= n 4)
    (return (fstr "i" (* n 8)))
    (return "i64")))

; Record one flattened scalar member. Past two members the aggregate is
; ineligible, so we only keep counting (the count is the eligibility test).
(defn rv-flat-add (f:&RvFlat isfp:i32 ir:StrView off:i32 sz:i32):void
  (let (n:i32 (f 'cnt))
    (when (= n 0)
      (set! (f 'fp0) isfp) (set! (f 'ir0) ir) (set! (f 'pos0) off) (set! (f 'sz0) sz))
    (when (= n 1)
      (set! (f 'fp1) isfp) (set! (f 'ir1) ir) (set! (f 'pos1) off) (set! (f 'sz1) sz))
    (set! (f 'cnt) (+ n 1))))

; Flatten `t` into scalar members at absolute offset `base`, accumulating into
; `f`. Recurses through nested structs AND arrays — `struct { float v[2]; }`
; flattens to two FP reals, which is what makes it an fa0/fa1 pair on riscv64
; where x86_64 SysV packs it into one `<2 x float>` eightbyte. A union is never
; flattened (psABI), so it poisons the count outright.
(defn rv-flatten-type (t:?&Type base:i32 f:&RvFlat):void
  (when (> (f 'cnt) 2) (return))
  (let (tt:ptr:Type t
        k:i32 (tt 'kind))
    (when (= k TY-UNION)
      (set! (f 'cnt) 99)
      (return))
    (when (= k TY-STRUCT)
      (let (sd:?&StructDef (tt 'sdef))
        (let (sdd:ptr:StructDef sd
              nf:i32 (sdd 'num-fields))
          (dotimes (i nf)
            ; BF-1: a bit-field is an integer member, and three of them in one
            ; storage unit are three members — which takes any struct holding
            ; them past the two-member FP rule and onto the integer convention,
            ; the conservative answer the psABI's own flattening reaches.
            (if (!= ((field-at (sdd 'fields) i) 'bit-width) 0)
              (set! (f 'cnt) 99)
              (rv-flatten-type ((field-at (sdd 'fields) i) 'type)
                               (+ base (/ (field-bit-offset sd i) 8)) f)))))
      (return))
    (when (= k TY-ARRAY)
      (let (et:?&Type (tt 'elem)
            esz:i32 (abi-sizeof (tt 'elem))
            n:i32 (tt 'arr-len))
        ; A zero-size element cannot occur (every representable type is ≥ 1
        ; byte); the guard states it rather than looping on a 0 stride.
        (when (<= esz 0)
          (set! (f 'cnt) 99)
          (return))
        (dotimes (i n)
          (rv-flatten-type et (+ base (* i esz)) f)))
      (return))
    ; Scalar: type-to-ir already yields `float`/`double` for the FP kinds and the
    ; natural `iN`/`ptr` for everything else, which is exactly the member type
    ; clang coerces to.
    (rv-flat-add f (if (!= (is-float-type t) 0) 1 0)
                 (type-to-ir t) base (abi-sizeof t))))

; riscv64 lp64d hard-float aggregate classification (Stage 14 RV-6,
; design/stage14/riscv-fp-abi.md §1). Fills `info` and returns the flattening
; RULE that applied — 1 a lone FP real, 2 two FP reals, 3 one FP real plus one
; integer — with the registers `gpr`/`fpr` still available; returns 0 to fall
; through to RV-3's integer convention. The rule is also recorded in
; `info.rvfp`, which is what `abi-rv-consume` debits against, so the register
; cost is read from the decision rather than re-derived from reg0/reg1.
; `off1` carries the second member's own offset — 4 for `{i32,f32}` and
; `{float[2]}`, NOT the SysV second eightbyte.
(defn abi-riscv-fp-classify (t:?&Type info:&AbiInfo gpr:i32 fpr:i32):i32
  (let (f:&RvFlat (unsafe/cast &RvFlat (arena-alloc (sizeof RvFlat))))
    (set! (f 'cnt) 0)
    (rv-flatten-type t 0 f)
    (let (n:i32 (f 'cnt))
      ; FLEN/XLEN are both 64 on lp64d: an over-wide member is ineligible.
      (when (or (< n 1) (> n 2)) (return 0))
      (when (and (!= (f 'fp0) 0) (> (f 'sz0) 8)) (return 0))
      (when (and (= (f 'fp0) 0) (> (f 'sz0) 8)) (return 0))
      ; Rule 1 — a lone FP real travels as that FP scalar.
      (when (= n 1)
        (when (= (f 'fp0) 0) (return 0))
        (when (< fpr 1) (return 0))
        (set! (info 'kind) ABI-COERCE1)
        (set! (info 'reg0) (f 'ir0))
        (set! (info 'rvfp) 1)
        (return 1))
      (when (> (f 'sz1) 8) (return 0))
      (let (nfp:i32 (+ (f 'fp0) (f 'fp1)))
        ; Rule 2 — two FP reals in two FPRs. Rule 3 — one FP real and one
        ; integer, EITHER order, in one FPR and one GPR. Member order is
        ; preserved in reg0/reg1, so LLVM's RISC-V CC assigns fa0/a0 correctly
        ; for both `{i32,f32}` and `{f32,i32}`.
        (when (= nfp 2)
          (when (< fpr 2) (return 0)))
        (when (= nfp 1)
          (when (or (< fpr 1) (< gpr 1)) (return 0)))
        (when (= nfp 0) (return 0))
        (set! (info 'kind) ABI-COERCE2)
        (set! (info 'reg0) (f 'ir0))
        (set! (info 'reg1) (f 'ir1))
        (set! (info 'off1) (f 'pos1))
        ; Rule 2 spends two FPRs; rule 3 spends one FPR and one GPR.
        (set! (info 'rvfp) (if (= nfp 2) 2 3))
        (return (if (= nfp 2) 2 3))))))

; Classify a type for the SysV aggregate ABI against a stated argument-register
; availability. Returns an AbiInfo*. Non-struct types are ABI-DIRECT
; (byte-identical to pre-ABI codegen).
;
; `gpr`/`fpr` matter on riscv64 only (Stage 14 RV-6c): its lp64d hard-float
; rules apply an FP-bearing aggregate to fa0-fa7 only while the registers it
; needs are free. Every other target ignores them, so the two entry points
; below — `abi-classify` (all registers available) and `abi-classify-arg` (the
; live counts) — are the same function there.
; `is-arg` is Stage 16 FL-4's one asymmetry: SysV classifies an X87 aggregate as
; MEMORY in ARGUMENT position but returns it on the x87 stack in st0, so the
; same struct is `ptr byval align 16` going in and `x86_fp80` coming out
; (measured against clang). Every other rule here is position-independent.
(defn abi-classify-avail (t:ptr:Type gpr:i32 fpr:i32 is-arg:i32):&AbiInfo
  (let (info:&AbiInfo (unsafe/cast &AbiInfo (arena-alloc (sizeof AbiInfo))))
    (set! (info 'kind) ABI-DIRECT)
    (set! (info 'reg0) "")
    (set! (info 'reg1) "")
    (set! (info 'size) 0)
    (set! (info 'align) 0)
    (set! (info 'off1) 8)   ; SysV: reg1 is the second eightbyte (riscv-fp-abi.md §3)
    (set! (info 'rvfp) 0)   ; no riscv flattening rule applied (RV-6c)
    ; Stage 15 W8 G-2 backstop. Every by-value parameter, argument and return
    ; funnels through here, and an `(array T N)` in any of those positions is
    ; refused at parse time (parse-type-from-node's g-array-ok gate) — but that
    ; gate is syntactic, so this catches a Type that arrived some other way
    ; (a `.nuch` re-parse, a stamped generic) before it becomes an ABI-DIRECT
    ; `[4 x i32] %x.arg`, which is legal LLVM and is NOT the C ABI.
    (reject-array-type t g-form-line "by-value parameter or return")
    (when (and (!= (t 'kind) TY-STRUCT)
               (!= (t 'kind) TY-UNION))
      (return info))
    ; Stage 15 W1d: this is the single chokepoint every by-value struct
    ; parameter, argument and return funnels through (emit-defn, the `declare`
    ; emitter, emit-call-with-args, emit-return/emit-struct-ret), which makes it
    ; the one place that catches BOTH sides of a cycle-crossing by-value struct.
    ; Without it the definition side classifies a 0-byte aggregate and emits
    ; `define … @f(i0 %v.arg)` while the call side (emitted after the layout
    ; landed) passes two i64s — a mismatch whose only symptom is an unlocated
    ; "failed to parse generated IR" from the LLVM parser. The ambient
    ; g-form-line is the fallback location, exactly as in type-to-ir's opaque
    ; backstop; emit-defn's parameter and return sites check first with their own
    ; node's line. No-op unless the unit has a skipped import cycle.
    (reject-cycle-pending-layout t g-form-line "by-value struct")
    (let (sd:?&StructDef (t 'sdef)
          sz:i32 (abi-sizeof t)
          al:i32 (abi-alignof t))
      (set! (info 'size) sz)
      (set! (info 'align) al)
      ; Stage 14 AVR-7: on AVR every aggregate (any size) is ABI-MEMORY —
      ; the SysV eightbyte classifier assumes 8-byte register chunks, which
      ; don't exist on this 8-bit target. Bypass eightbyte classification
      ; entirely; the MEMORY value travels by aarch64-style plain pointer
      ; (abi-print-param / abi-arg-frag). Inert on hosted targets.
      (when (!= (abi-is-avr) 0)
        (set! (info 'kind) ABI-MEMORY)
        (return info))
      (when (> sz 16)
        (set! (info 'kind) ABI-MEMORY)
        (return info))
      ; Stage 14 RV-6: riscv64 lp64d hard-float flattening, tried before the
      ; integer convention. A flattenable aggregate is at most two ≤8-byte
      ; members, hence ≤16 bytes, so the >16 MEMORY exit above cannot skip one.
      (when (!= (abi-is-riscv) 0)
        (when (!= (abi-riscv-fp-classify t info gpr fpr) 0)
          (return info)))
      ; Stage 14 RV-3: otherwise on riscv64 every eightbyte is INTEGER; skip the
      ; field-type walk and force class 3.
      (let (n0:i32 (if (< sz 8) sz 8)
            c0:i32 (if (!= (abi-is-riscv) 0) 3 (abi-class-eightbyte sd 0 0)))
        ; Stage 16 FL-4: an X87 member takes the whole aggregate to MEMORY as an
        ; argument, and to st0 as a return.
        (when (= c0 ABI-CLS-X87)
          (if (!= is-arg 0)
            (set! (info 'kind) ABI-MEMORY)
            (do (set! (info 'reg0) "x86_fp80")
                (set! (info 'kind) ABI-COERCE1)))
          (return info))
        ; An fp128 fills both eightbytes as a single xmm value, so it is one
        ; register of type fp128, not a coerced pair.
        (when (and (= c0 ABI-CLS-SSEUP) (= sz 16))
          (set! (info 'reg0) "fp128")
          (set! (info 'kind) ABI-COERCE1)
          (return info))
        (set! (info 'reg0) (abi-eightbyte-ir c0 n0)))
      (when (<= sz 8)
        (set! (info 'kind) ABI-COERCE1)
        (return info))
      (let (n1:i32 (- sz 8)
            c1:i32 (if (!= (abi-is-riscv) 0) 3 (abi-class-eightbyte sd 0 8)))
        (when (= c1 ABI-CLS-X87)
          (if (!= is-arg 0)
            (set! (info 'kind) ABI-MEMORY)
            (do (set! (info 'reg0) "x86_fp80")
                (set! (info 'kind) ABI-COERCE1)))
          (return info))
        (set! (info 'reg1) (abi-eightbyte-ir c1 n1)))
      (set! (info 'kind) ABI-COERCE2)
      (return info))))

; The all-registers-available classification, and the ONLY one a non-riscv
; target ever needs. Pure. This is the correct entry point for a RETURN: a
; return always has a0/a1/fa0/fa1 (clang's RISCVABIInfo::classifyReturnType
; likewise classifies against a fixed 2 GPR / 2 FPR budget, and no flattening
; rule needs more than that), so return classification never depends on the
; argument register state.
(defn abi-classify (t:?&Type):&AbiInfo
  (return (abi-classify-avail t 8 8 0)))

; ---- riscv64 argument register accounting (Stage 14 RV-6c) ----
; design/stage14/riscv-fp-abi.md §4. The ambient counters live beside
; g-form-line in src/nucleusc.nuc; their invariant is stated there.

; Debit the ambient budget. Floors at 0: past exhaustion the argument is on the
; stack and further arithmetic on the counter is meaningless (this mirrors
; clang's `if (NeededArgGPRs > ArgGPRsLeft) NeededArgGPRs = ArgGPRsLeft`).
(defn abi-take-regs (gpr:i32 fpr:i32):void
  (set! g-abi-gpr-left (if (>= g-abi-gpr-left gpr) (- g-abi-gpr-left gpr) 0))
  (set! g-abi-fpr-left (if (>= g-abi-fpr-left fpr) (- g-abi-fpr-left fpr) 0)))

; Begin one parameter/argument list. `ret-info` is the function's RETURN
; lowering when the caller has it (null otherwise): an ABI-MEMORY return passes
; a hidden sret pointer in a0, so it costs a GPR before the first real argument
; — clang's RISCVABIInfo::computeInfo starts from `NumArgGPRs - 1` for exactly
; this reason. §4's table omitted it; see the RV-6c status note in
; design/stage14/riscv-fp-abi.md.
(defn abi-args-begin (ret-info:?&AbiInfo):void
  (set! g-abi-gpr-left 8)
  (set! g-abi-fpr-left 8)
  (set! g-abi-varargs 0)
  (when (and (!= ret-info null) (= (ret-info 'kind) ABI-MEMORY))
    (set! g-abi-gpr-left 7)))

; Cross into a variadic callee's `...` tail. Idempotent, so a caller may assert
; it once per trailing argument rather than detecting the boundary exactly.
(defn abi-args-varargs ():void
  (set! g-abi-varargs 1))

; Debit what the lowering just chosen for argument `t` actually occupies.
; `eff-fpr` is the FP availability the classification ran with — 0 in the
; variadic tail — so the DIRECT-scalar arm cannot hand a vararg float an FPR
; the classifier already refused it.
(defn abi-rv-consume (t:?&Type info:&AbiInfo eff-fpr:i32):void
  (let (rule:i32 (info 'rvfp)
        k:i32 (info 'kind))
    (when (= rule 1) (abi-take-regs 0 1) (return))
    (when (= rule 2) (abi-take-regs 0 2) (return))
    (when (= rule 3) (abi-take-regs 1 1) (return))
    (when (= k ABI-DIRECT)
      ; An FP scalar ≤ FLEN takes an FPR while one is free, otherwise a GPR.
      (if (and (!= (is-float-type t) 0) (> eff-fpr 0))
        (abi-take-regs 0 1)
        (abi-take-regs 1 0))
      (return))
    ; COERCE2 is two eightbytes in two GPRs; COERCE1 is one; an ABI-MEMORY
    ; aggregate travels by reference, and the reference occupies one.
    (if (= k ABI-COERCE2)
      (abi-take-regs 2 0)
      (abi-take-regs 1 0))))

; Classify one ARGUMENT or PARAMETER, consuming the registers it occupies.
; On every non-riscv target this tail-calls the pure `abi-classify` and touches
; no ambient state, which is what keeps hosted IR byte-identical.
;
; Caller obligation (the RV-6c invariant, stated in full beside g-abi-gpr-left):
; `abi-args-begin` once per list, then this once per element in declaration
; order, with `abi-args-varargs` at the `...` boundary.
(defn abi-classify-arg (t:?&Type):&AbiInfo
  (when (= (abi-is-riscv) 0) (return (abi-classify-avail t 8 8 1)))
  ; A variadic argument takes the integer convention regardless of type: no FP
  ; registers and no flattening (psABI). Both fall out of an FP availability of
  ; 0, since every flattening rule needs at least one FPR.
  (let (eff-fpr:i32 (if (!= g-abi-varargs 0) 0 g-abi-fpr-left)
        info:&AbiInfo (abi-classify-avail t g-abi-gpr-left eff-fpr 1))
    (abi-rv-consume t info eff-fpr)
    (return info)))

; Return type string for a function signature given its return AbiInfo: void for
; MEMORY (the value goes through the sret pointer), the coercion reg(s) for
; COERCE, or the plain type for DIRECT.
(defn abi-ret-ir (info:ptr:AbiInfo ret:?&Type):StrView
  (let (k:i32 (info 'kind))
    (when (= k ABI-MEMORY)  (return "void"))
    (when (= k ABI-COERCE1) (return (info 'reg0)))
    (when (= k ABI-COERCE2)
      (return (fstr "{ " (info 'reg0) ", " (info 'reg1) " }")))
    (return (type-to-ir ret))))

; Print one lowered parameter to g-out. `name` is the param name for a `define`
; (emits the `%name.arg` operand) or null for a `declare` (types only). COERCE2
; expands to two comma-separated entries; the caller supplies the leading comma.
; On aarch64, ABI-MEMORY uses plain `ptr` (no byval attribute); on x86_64, it
; uses `ptr byval(%Ty) align N`.
; `name` stays elem-less `ptr` (not CStr): it is null-checked (`= name null`)
; below to distinguish a `define` (real param name) from a `declare` (types
; only, name is null) — a CStr retype would turn that guard into
; `strcmp(name, null)`, which crashes (the batch-1 null-check-on-parameter
; trap, conventions.md).
(defn abi-print-param-to ((out ?&String) info:&AbiInfo ptype:?&Type name:Symbol):void
  (let (ii:&AbiInfo info
        k:i32 (info 'kind)
        ; W9 item 39: a parameter name becomes an LLVM local identifier, so it
        ; needs the same transform a defn name gets. Applied here and in
        ; abi-emit-param-prologue, the only two producers of `%<param>.arg`, and
        ; nowhere else — `scope-define` still keys on the SOURCE name.
        nm:StrView "")
    (when (not (symbol-none? name)) (set! nm (ir-name-token (symbol-as-view name))))
    (when (= k ABI-DIRECT)
      (if (symbol-none? name)
        (emit out (type-to-ir ptype))
        (emit out (type-to-ir ptype) " %" nm ".arg"))
      (return))
    (when (= k ABI-MEMORY)
      ; x86_64 uses a `byval` attribute; aarch64, AVR (Stage 14 AVR-7) AND
      ; riscv64 (Stage 14 RV-3) pass a plain pointer (AVR has no byval concept;
      ; riscv64's psABI passes >16-byte aggregates by reference, no byval).
      ; byval only when the target is none of those three.
      (if (and (= (abi-is-aarch64) 0) (= (abi-is-avr) 0) (= (abi-is-riscv) 0))
        ; x86_64: byval attribute
        (if (symbol-none? name)
          (emit out "ptr byval(" (type-to-ir ptype) ") align " (ii 'align))
          (emit out "ptr byval(" (type-to-ir ptype) ") align " (ii 'align) " %" nm ".arg"))
        ; aarch64 / AVR / riscv64: plain pointer
        (if (symbol-none? name)
          (emit out "ptr")
          (emit out "ptr %" nm ".arg")))
      (return))
    (when (= k ABI-COERCE1)
      (if (symbol-none? name)
        (emit out (ii 'reg0))
        (emit out (ii 'reg0) " %" nm ".arg"))
      (return))
    ; COERCE2
    (if (symbol-none? name)
      (emit out (ii 'reg0) ", " (ii 'reg1))
      (emit out (ii 'reg0) " %" nm ".arg.0, " (ii 'reg1) " %" nm ".arg.1"))))

; The g-out spelling, which is every batch-emission caller. The REPL's preamble
; declares go to g-repl-preamble instead and call abi-print-param-to directly.
(defn abi-print-param (info:&AbiInfo ptype:?&Type name:Symbol):void
  (abi-print-param-to g-out info ptype name))

; Emit the entry-block reconstruction for one parameter into its `.addr` slot,
; and bind it in fn-scope. DIRECT keeps the prior alloca+store (byte-identical).
; MEMORY binds the byval pointer directly (it already points at the copy).
; COERCE allocas the struct and stores the register arg(s) at their offsets.
; RV-6c: classifies ONCE (it used to classify twice for `info` and `kind`,
; which is merely wasteful under a pure classifier and double-counts registers
; under a consuming one), through `abi-classify-arg` — the prologue is the
; second of the two walks over a `define`'s parameter list, so the caller loop
; owns the `abi-args-begin` reset.
(defn abi-emit-param-prologue (fn-scope:ref:Scope pname:Symbol ptype:?&Type):void
  (let (info:&AbiInfo (abi-classify-arg ptype)
        k:i32 (info 'kind)
        ; W9 item 39: must spell the parameter exactly as abi-print-param-to did.
        mn:StrView (ir-name-token (symbol-as-view pname))
        slot:StrView (fstr "%" mn ".addr")
        arg:StrView (fstr "%" mn ".arg"))
    (when (= k ABI-DIRECT)
      (let (palign:i32 (type-size ptype))
        (emit g-entry-stream "  " slot " = alloca " (type-to-ir ptype) ", align " palign "\n")
        (emit g-entry-stream "  store " (type-to-ir ptype) " " arg ", ptr " slot ", align "
              palign "\n")
        (scope-define fn-scope pname ptype slot 1))
      (return))
    (when (= k ABI-MEMORY)
      (scope-define fn-scope pname ptype arg 1)
      (return))
    ; COERCE1 / COERCE2: materialize the register arg(s) back into a struct slot.
    (emit g-entry-stream "  " slot " = alloca " (type-to-ir ptype) "\n")
    (if (= k ABI-COERCE1)
      (emit g-entry-stream "  store " (info 'reg0) " " arg ", ptr " slot "\n")
      (let (gp:StrView "")
        (emit g-entry-stream "  store " (info 'reg0) " %" mn ".arg.0, ptr " slot "\n")
        (set! gp (new-tmp))
        (emit g-entry-stream "  " gp " = getelementptr i8, ptr " slot ", i64 " (info 'off1) "\n")
        (emit g-entry-stream "  store " (info 'reg1) " %" mn ".arg.1, ptr " gp "\n")))
    (scope-define fn-scope pname ptype slot 1)))

; Emit a struct return for the current function per g-fn-ret-abi. `v` is the
; struct value to return — either a first-class struct (TY-STRUCT, e.g. a value
; loaded from a struct-returning call) or a pointer to its storage (TY-PTR — a
; struct literal's `(ref S)`, or a closure's `(ref Env)` whose env travels by
; value out of the frame).
;
; CE-3 (closure-enhancements.md §CE-3) fix (b): when the returned value is a
; *pointer* to the struct bytes, copy the bytes out — a typed load (the LLVM
; "typed memcpy") from the source address — instead of `store`-ing the pointer
; value itself into the sret/coerce slot. That earlier `store ptr ...` corrupted
; every by-value owning struct return (a struct literal / closure env arrives by
; pointer). The first-class struct case is unchanged (its `.val` already holds
; the aggregate), so scalar/pointer-only self-compilation stays byte-identical.
; MEMORY copies through the sret pointer and returns void; COERCE loads the
; eightbyte(s) and returns the reg(s).
(defn emit-struct-ret (v:?&Val):void
  (let (vv:ptr:Val v
        info:&AbiInfo (unsafe/cast &AbiInfo g-fn-ret-abi)
        k:i32 ((unsafe/cast &AbiInfo g-fn-ret-abi) 'kind))
    ; Stage 17 C6: a string literal returned into a `StrView` slot. Neither return
    ; path (explicit or implicit) runs the coercer before reaching here, and the
    ; chameleon's `val` is still the bare data pointer, so the aggregate below
    ; would be assembled out of a pointer-sized slot. Materialize {ptr,len} first.
    (when (and (!= (vv 'is-lit) 0) (!= (type-is-strview (vv 'type)) 0)
               (!= (type-is-strview g-fn-ret-type) 0))
      (let (mv:?&Val (coerce-int-val vv (as ?&Type g-fn-ret-type) g-form-line))
        (when (!= mv null) (set! vv mv))))
    ; By-pointer return (struct literal `(ref S)` / closure `(ref Env)`): the
    ; struct bytes live at `(vv val)`. Load eightbyte(s) / the whole aggregate
    ; straight from that address — never `store` the pointer itself.
    ;
    ; Stage 17 C6: and it must really BE that pointer. `return`'s aggregate path
    ; runs no coercion (only the DIRECT branch does), so any pointer at all used
    ; to reach here and be read as the address of the return struct — a wild
    ; 16-byte load off an IR type-name string, with nothing to reject it.
    (when (= ((vv 'type) 'kind) TY-PTR)
      (let (e:?&Type ((vv 'type) 'elem))
        (when (or (= e null) (= (type-eq e g-fn-ret-type) 0))
          (die-at g-form-line
            (fstr "internal: aggregate return of a " (type-display (vv 'type))
                  " where the declared return type is " (type-display g-fn-ret-type)))))
      (let (ty:StrView (type-to-ir g-fn-ret-type)
            src:StrView (vv 'val))
        (when (= k ABI-MEMORY)
          (let (agg:StrView (new-tmp))
            (emit g-body-stream "  " agg " = load " ty ", ptr " src "\n")
            (emit g-body-stream "  store " ty " " agg ", ptr " g-fn-sret-name "\n"))
          (emit g-body-stream "  ret void\n")
          (return))
        (if (= k ABI-COERCE1)
          (let (r:StrView (new-tmp))
            (emit g-body-stream "  " r " = load " (info 'reg0) ", ptr " src "\n")
            (emit g-body-stream "  ret " (info 'reg0) " " r "\n"))
          ; COERCE2: load both eightbytes from the struct address directly.
          (let (r0:StrView (new-tmp)
                gp:StrView ""
                r1:StrView ""
                a0:StrView ""
                a1:StrView "")
            (emit g-body-stream "  " r0 " = load " (info 'reg0) ", ptr " src "\n")
            (set! gp (new-tmp))
            (emit g-body-stream "  " gp " = getelementptr i8, ptr " src ", i64 " (info 'off1)
                  "\n")
            (set! r1 (new-tmp))
            (emit g-body-stream "  " r1 " = load " (info 'reg1) ", ptr " gp "\n")
            (set! a0 (new-tmp))
            (emit g-body-stream "  " a0 " = insertvalue { " (info 'reg0) ", " (info 'reg1)
                  " } undef, " (info 'reg0) " " r0 ", 0\n")
            (set! a1 (new-tmp))
            (emit g-body-stream "  " a1 " = insertvalue { " (info 'reg0) ", " (info 'reg1) " } "
                  a0 ", " (info 'reg1) " " r1 ", 1\n")
            (emit g-body-stream "  ret { " (info 'reg0) ", " (info 'reg1) " } " a1 "\n")))
        (return)))
    ; First-class struct value — the original (byte-identical) path: `.val`
    ; holds the aggregate, so store it / round it through memory directly.
    (let (ty:StrView (type-to-ir (vv 'type)))
      ; Stage 17 C6: the eightbyte loads below read the RETURN type's bytes back
      ; out of a slot sized by `ty`. Under opaque pointers a narrower value stores
      ; without complaint and the loads then run off the end of the alloca —
      ; garbage, not a verifier error. Refuse instead.
      (when (!= ty (type-to-ir g-fn-ret-type))
        (die-at g-form-line
          (fstr "internal: aggregate return of a " ty " where the declared return type is "
                (type-to-ir g-fn-ret-type))))
      (when (= k ABI-MEMORY)
        (emit g-body-stream "  store " ty " " (vv 'val) ", ptr " g-fn-sret-name "\n")
        (emit g-body-stream "  ret void\n")
        (return))
      (let (tmp:StrView (new-tmp))
        (emit g-entry-stream "  " tmp " = alloca " ty "\n")
        (emit g-body-stream "  store " ty " " (vv 'val) ", ptr " tmp "\n")
        (if (= k ABI-COERCE1)
          (let (r:StrView (new-tmp))
            (emit g-body-stream "  " r " = load " (info 'reg0) ", ptr " tmp "\n")
            (emit g-body-stream "  ret " (info 'reg0) " " r "\n"))
          ; COERCE2: load both eightbytes, build the {reg0,reg1} return aggregate.
          (let (r0:StrView (new-tmp)
                gp:StrView ""
                r1:StrView ""
                a0:StrView ""
                a1:StrView "")
            (emit g-body-stream "  " r0 " = load " (info 'reg0) ", ptr " tmp "\n")
            (set! gp (new-tmp))
            (emit g-body-stream "  " gp " = getelementptr i8, ptr " tmp ", i64 " (info 'off1)
                  "\n")
            (set! r1 (new-tmp))
            (emit g-body-stream "  " r1 " = load " (info 'reg1) ", ptr " gp "\n")
            (set! a0 (new-tmp))
            (emit g-body-stream "  " a0 " = insertvalue { " (info 'reg0) ", " (info 'reg1)
                  " } undef, " (info 'reg0) " " r0 ", 0\n")
            (set! a1 (new-tmp))
            (emit g-body-stream "  " a1 " = insertvalue { " (info 'reg0) ", " (info 'reg1) " } "
                  a0 ", " (info 'reg1) " " r1 ", 1\n")
            (emit g-body-stream "  ret { " (info 'reg0) ", " (info 'reg1) " } " a1 "\n")))))))

; Build the LLVM call-argument fragment for one already-emitted argument Val,
; emitting any materialization/coercion instructions as a side effect. Scalars
; and pointers return "<ty> <val>" unchanged; a struct is materialized to memory
; (a typed `store` of the first-class value, never `store ptr`) and lowered to
; byval / register load(s) per its AbiInfo. A struct-by-value argument must
; arrive here as a first-class TY-STRUCT value — the symmetric counterpart to
; emit-struct-ret's typed copy. A by-value struct passed as a `(ref S)`/`(ref
; Env)` pointer is normalized to first-class at the call site (emit-call-with-
; args, CE-3 fix (b)) before reaching here, since classification on the arg type
; alone cannot distinguish a by-value-struct arg from an ordinary pointer arg.
; On aarch64, ABI-MEMORY passes a plain pointer (no byval attribute).
(defn abi-arg-frag (av:?&Val):StrView
  (let (a:ptr:Val av)
    ; Stage 14 NS-3 (design/stage14/native-strings.md): an *unmaterialized* StrView
    ; string literal (chameleon: is-lit=1, `val` is the bare data GEP) reaching
    ; abi-arg-frag is always a variadic argument — a fixed StrView parameter is
    ; materialized to a real {ptr,len} value (is-lit=0) by the call-site coercion
    ; loop before this point. A printf-family `%s` expects a char*, so pass the
    ; literal's data pointer (already `val`) as a plain ptr, byte-identical to the
    ; old CStr vararg fragment. NOTE the split of responsibility: abi-arg-frag
    ; CANNOT distinguish a fixed StrView parameter (passed by value = two INTEGER
    ; eightbytes) from a *materialized* StrView variadic argument (must pass only
    ; `.data`) — both are is-lit=0 StrView values here. So the materialized-view
    ; variadic case is collapsed by the caller (emit-call-with-args), which knows
    ; the fixed/variadic boundary; here we only special-case the chameleon literal,
    ; which is unambiguously variadic. A fixed StrView value falls through to the
    ; generic struct ABI (COERCE2), exactly as it must.
    (when (and (!= (a 'is-lit) 0) (!= (type-is-strview (a 'type)) 0))
      ; RV-6c: this fragment is one pointer-sized vararg, so charge it as one —
      ; classifying the StrView type here instead would charge two (its integer
      ; convention is COERCE2). Discarding the AbiInfo is the point; the call is
      ; made for its register debit.
      (abi-classify-arg ty-ptr)
      (return (fstr "ptr " (a 'val))))
    ; RV-6c: classified ONCE (it used to classify twice, for `info` and `kind`),
    ; via abi-classify-arg — this is the argument position, so it consults and
    ; debits the live register budget. emit-call-with-args owns the
    ; abi-args-begin reset and the abi-args-varargs boundary.
    (let (info:&AbiInfo (abi-classify-arg (a 'type))
          k:i32 (info 'kind))
    (when (= k ABI-DIRECT)
      (return (fstr (type-to-ir (a 'type)) " " (a 'val))))
    (let (ty:StrView (type-to-ir (a 'type))
          addr:StrView (new-tmp))
      (emit g-entry-stream "  " addr " = alloca " ty "\n")
      (emit g-body-stream "  store " ty " " (a 'val) ", ptr " addr "\n")
      (when (= k ABI-MEMORY)
        ; x86_64: byval attribute; aarch64, AVR (Stage 14 AVR-7) AND riscv64
        ; (Stage 14 RV-3): plain pointer. byval only when the target is none of
        ; aarch64, AVR, or riscv64.
        (if (and (= (abi-is-aarch64) 0) (= (abi-is-avr) 0) (= (abi-is-riscv) 0))
          ; x86_64: byval attribute
          (return (fstr "ptr byval(" ty ") align " (info 'align) " " addr))
          ; aarch64 / AVR / riscv64: plain pointer
          (return (fstr "ptr " addr))))
      (when (= k ABI-COERCE1)
        (let (r:StrView (new-tmp))
          (emit g-body-stream "  " r " = load " (info 'reg0) ", ptr " addr "\n")
          (return (fstr (info 'reg0) " " r))))
      ; COERCE2
      (let (r0:StrView (new-tmp)
            gp:StrView ""
            r1:StrView "")
        (emit g-body-stream "  " r0 " = load " (info 'reg0) ", ptr " addr "\n")
        (set! gp (new-tmp))
        (emit g-body-stream "  " gp " = getelementptr i8, ptr " addr ", i64 " (info 'off1) "\n")
        (set! r1 (new-tmp))
        (emit g-body-stream "  " r1 " = load " (info 'reg1) ", ptr " gp "\n")
        (return (fstr (info 'reg0) " " r0 ", " (info 'reg1) " " r1)))))))

; Emit a direct call whose return is a struct lowered per `info`, reconstruct
; the first-class struct value, and return its Val. `arglist` is the already
; built scalar/coerced argument string; `nargs` is the count it holds (so a
; MEMORY sret prefix knows whether it needs a separating comma).
(defn abi-emit-struct-call (info:&AbiInfo ret:?&Type ir-name:StrView arglist:StrView nargs:i32):&Val
  (let (ii:&AbiInfo info
        k:i32 (info 'kind)
        ty:StrView (type-to-ir ret))
    (when (= k ABI-MEMORY)
      (let (slot:StrView (new-tmp)
            sep:StrView "")
        (emit g-entry-stream "  " slot " = alloca " ty "\n")
        (when (> nargs 0) (set! sep ", "))
        (emit g-body-stream "  call void " ir-name "(ptr sret(" ty ") align " (ii 'align) " "
              slot sep arglist ")\n")
        (let (v:StrView (new-tmp))
          (emit g-body-stream "  " v " = load " ty ", ptr " slot "\n")
          (return (alloc-val ret v)))))
    (when (= k ABI-COERCE1)
      (let (tmp:StrView (new-tmp))
        (emit g-body-stream "  " tmp " = call " (ii 'reg0) " " ir-name "(" arglist ")\n")
        (let (slot:StrView (new-tmp))
          (emit g-entry-stream "  " slot " = alloca " ty "\n")
          (emit g-body-stream "  store " (ii 'reg0) " " tmp ", ptr " slot "\n")
          (let (v:StrView (new-tmp))
            (emit g-body-stream "  " v " = load " ty ", ptr " slot "\n")
            (return (alloc-val ret v))))))
    ; COERCE2: call returns {reg0,reg1}; split it back into the struct slot.
    (let (rty:StrView (fstr "{ " (ii 'reg0) ", " (ii 'reg1) " }")
          tmp:StrView (new-tmp))
      (emit g-body-stream "  " tmp " = call " rty " " ir-name "(" arglist ")\n")
      (let (slot:StrView (new-tmp)
            e0:StrView ""
            gp:StrView ""
            e1:StrView ""
            v:StrView "")
        (emit g-entry-stream "  " slot " = alloca " ty "\n")
        (set! e0 (new-tmp))
        (emit g-body-stream "  " e0 " = extractvalue " rty " " tmp ", 0\n")
        (emit g-body-stream "  store " (ii 'reg0) " " e0 ", ptr " slot "\n")
        (set! gp (new-tmp))
        (emit g-body-stream "  " gp " = getelementptr i8, ptr " slot ", i64 " (ii 'off1) "\n")
        (set! e1 (new-tmp))
        (emit g-body-stream "  " e1 " = extractvalue " rty " " tmp ", 1\n")
        (emit g-body-stream "  store " (ii 'reg1) " " e1 ", ptr " gp "\n")
        (set! v (new-tmp))
        (emit g-body-stream "  " v " = load " ty ", ptr " slot "\n")
        (return (alloc-val ret v))))))

; Try to coerce a value to a target type. Returns a Val* or null on failure.
; Handles: same kind (identity), int-to-int (trunc/sext/zext), same-width sign change.
(defn coerce-int-val (v:?&Val target:ptr:Type line:i32):?&Val
  (let (vv:ptr:Val v
        src:ptr:Type (vv 'type)
        sk:i32 (src 'kind)
        dk:i32 (target 'kind))
    ; Stage 10: pointer-kind flow gate — unchecked/Maybe may not flow into a
    ; non-null (ref T) slot. Engages only when the destination is ref, so
    ; every pre-Stage-10 path is untouched.
    (when (= dk TY-PTR)
      (pkind-flow-check src target line "assignment"))
    ; Stage 14 NS-3 (design/stage14/native-strings.md): an *unmaterialized* StrView
    ; string literal (emit-string's default — is-lit=1, `val` is the bare data GEP,
    ; `lit-i64` the byte length). It adapts to its target with no wasted IR:
    ;   → ptr / CStr : the literal's data pointer already IS `val` (the backing
    ;     rodata is NUL-terminated at data[len]), so this is a pure retype, no
    ;     instruction — exactly today's CStr→ptr no-op. This is what keeps every
    ;     fprintf/fmt/strcmp/`= "lit"`/`:ptr`-slot site in the compiler's own
    ;     source byte-identical across the flip.
    ;   → StrView    : the consumer genuinely wants a view — materialize the
    ;     {data,len} struct here (deferred from emit-string). Compiler code never
    ;     hits this (no StrView targets); it is for lib/examples.
    ; Must precede the `sk == dk` identity return below, or a StrView target would
    ; pass the chameleon through unmaterialized (a bare ptr typed as %StrView).
    (when (and (!= (vv 'is-lit) 0) (!= (type-is-strview src) 0))
      (when (!= (strview-borrow-target target) 0)
        (let (rv:&Val (as &Val (alloc-val target (vv 'val))))
          (set! (rv 'taint) (vv 'taint))
          (set! (rv 'taint-frame) (vv 'taint-frame))
          (return (as ptr rv))))
      (when (!= (type-is-strview target) 0)
        (let (v0:StrView (new-tmp)
              v1:StrView (new-tmp)
              svir:StrView (type-to-ir target))
          (emit g-body-stream "  " v0 " = insertvalue " svir " undef, ptr " (vv 'val) ", 0\n")
          (emit g-body-stream "  " v1 " = insertvalue " svir " " v0 ", " (ptr-int-ir) " "
                (vv 'lit-i64) ", 1\n")
          (return (alloc-val target v1)))))
    ; Stage 14 NS-3 (design/stage14/native-strings.md): a StrView source (chameleon
    ; literal or materialized value) whose target is a *different* by-value struct
    ; must NOT be waved through by the `sk == dk` identity return below — both are
    ; TY-STRUCT, so that line would reinterpret the StrView (a bare `ptr` for a
    ; chameleon, a {ptr,len} aggregate for a value) as an unrelated struct and crash
    ; the LLVM verifier (`store %Box <ptr>`). Fall through to the coercion-failure
    ; (null) path instead, so the caller (`.set!`/`aset!`/let-init/…) reports a clean
    ; "type mismatch" diagnostic. StrView→StrView (target IS StrView) drops through to
    ; the identity return unchanged; StrView→ptr/CStr was already handled above.
    (when (and (= sk TY-STRUCT) (!= (type-is-strview src) 0)
               (= dk TY-STRUCT) (= (type-is-strview target) 0))
      (return null))
    ; Stage 16 FP-1: two function pointers are the same KIND and are not thereby
    ; the same type, so this pair has to be answered before the identity return
    ; below waves it through. It did not used to be: `type-eq` dispatches TY-FN
    ; to `fn-sig-eq`, computed the right answer at the call site, and then handed
    ; the mismatch here — where `sk == dk` accepted it. Every typed fn-pointer
    ; slot in the language (let init, set!, .set! store, argument) took any
    ; signature, silently: an `():f64` function through an `(fn i32)()` slot read
    ; an integer register the callee never wrote.
    ; c-boundary-defects.md §2.3. No IR either way — both are one ptr register.
    (when (and (= sk TY-FN) (= dk TY-FN))
      (if (!= (fn-sig-compat src target) 0) (return v) (return null)))
    ; Stage 16 SE-1: same KIND is not same TYPE. This line used to be a bare
    ; `(return v)`, so a `(ref (Vector i32))` entered a `(ref (Vector i64))` slot
    ; unexamined — every pointer lowers to `ptr`, so nothing downstream objected
    ; and the elements were read back at the wrong stride. FP-1 answered the
    ; TY-FN half of the same line above; `slot-type-compat` is that rule for
    ; every kind. template-ref-equality.md §4. No IR either way: a compatible
    ; pair is the identity return it always was.
    (when (= sk dk)
      (if (!= (slot-type-compat src target) 0) (return v) (return null)))
    ; Stage 15 W5d (design/stage15-stress-test/ergonomics.md §3.9): a
    ; pointer-to-S value flowing into a BY-VALUE S slot is loaded here. A struct
    ; compound literal `(S …)` is alloca-backed and evaluates to `(ref S)`, so
    ; before this EVERY by-value struct slot rejected it: `(array S (S 1 2) …)`
    ; died "array: type mismatch in positional initializer" and each element had
    ; to be spelled `(deref (S 1 2))` — the wart that made a generated table
    ; (Doom's 967-row `states[]`) unwritable in its natural form.
    ;
    ; This is not a new language liberty. The ARGUMENT position has done exactly
    ; this since Stage 13 CE-3 (the by-value normalization in emit-call-with-args
    ; loads a `(ref S)` argument for a by-value S parameter), so `(take (S 1 2))`
    ; already worked while `(let (v:S (S 1 2)) …)` did not. The rule now applies
    ; at the typed-slot positions that share this chokepoint too: let/with init,
    ; set!, `.set!` field store, ptr-set!/aset!, explicit and implicit return,
    ; struct-literal field and array (positional and designated) initializers,
    ; and union-variant construction.
    ;
    ; NOT reachable from the call-argument path, so arguments stay byte-identical
    ; twice over: safe-coerce-val delegates only StrView/int↔int/float↔float/
    ; defcast pairs down here (a ptr→struct pair falls through to its own null
    ; return), and the CE-3 block runs before it in any case.
    ;
    ; The emitted IR is exactly what the explicit `(deref …)` spelling produces
    ; (emit-deref = require-derefable + one load of the pointee), so this is a
    ; second spelling of one code path, not a second code path — and it costs one
    ; load per element, never a copy loop: the N elements of an array literal are
    ; N independent loads, the same shape and count `(deref …)` already emitted.
    ;
    ; `type-eq` lives in generics.nuc, which is imported AFTER abi.nuc, so its
    ; TY-STRUCT rule (same StructDef) is spelled out inline rather than called —
    ; a forward reference would not resolve when abi.nuc's bodies emit.
    (when (and (= sk TY-PTR) (= dk TY-STRUCT) (!= (src 'elem) null))
      (let (pointee:ptr:Type (src 'elem))
        (when (and (= (pointee 'kind) TY-STRUCT)
                   (!= (target 'sdef) null)
                   (= (pointee 'sdef) (target 'sdef)))
          ; Stage 10: loading through a `?T` needs the same narrowing `deref`
          ; demands. A compound literal is `(ref S)` and passes untouched.
          (require-derefable src line "assignment")
          (let (tmp:StrView (new-tmp))
            (emit-load tmp (type-to-ir target) (vv 'val) target)
            (return (alloc-val target tmp))))))
    ; Stage 15 W9 item 20: the literal `null` adapts to a function-pointer slot,
    ; with no IR — both are one `ptr` register and `null` is a fn pointer's
    ; honest zero (it is outside the Phase-F non-null regime by construction:
    ; `ptr-pkind` answers PTR-RAW for every non-TY-PTR kind). `defvar` has
    ; accepted this spelling since item 14 and `(= h null)` since item 18, so
    ; refusing `(let (f:(fn i32)(i32) null) …)` was the odd one out.
    ;
    ; The gate is `is-nlit`, NOT `is-ptr-repr src`: an arbitrary `ptr`/
    ; `CStr` value must still be refused here, because `fn`<->`ptr` is
    ; unsafe/cast's job (docs/types.md) — the whole point of the flag is to
    ; separate the literal from a loaded data pointer, which share a type.
    (when (and (!= (vv 'is-nlit) 0) (= dk TY-FN))
      (return (alloc-val target (vv 'val))))
    ; CStr is an opaque char* — freely interconvertible with a plain pointer,
    ; no IR (both lower to `ptr`). Keeps string literals (CStr) usable wherever a
    ; ptr is expected, and a ptr usable where a CStr slot is declared.
    (when (or (and (= sk TY-CSTR) (= dk TY-PTR))
              (and (= sk TY-PTR) (= dk TY-CSTR)))
      (let (rv:&Val (as &Val (alloc-val target (vv 'val))))
        (set! (rv 'taint) (vv 'taint))
        ; Stage 13 L1: carry the frame-region flag through CStr<->ptr coercion.
        (set! (rv 'taint-frame) (vv 'taint-frame))
        (return (as ptr rv))))
    ; Stage 14 NS-2 (design/stage14/native-strings.md): a StrView borrows to a
    ; CStr/ptr for free by taking its `data` field — a literal's backing rodata is
    ; NUL-terminated at data[len], so `data` is a valid char*. Mirrors the
    ; CStr<->ptr no-op above (the coexistence hinge that keeps every libc/format
    ; site working once literals are views). The NUL guarantee holds only for a
    ; LITERAL — a view `fstr` built ends at `len` with nothing after it — which is
    ; why the compiler's own remaining C-string seams take a `Symbol` and not this.
    (when (and (!= (type-is-strview src) 0)
               (!= (strview-borrow-target target) 0))
      (let (d:StrView (new-tmp))
        (emit g-body-stream "  " d " = extractvalue " (type-to-ir src) " " (vv 'val) ", 0\n")
        (return (alloc-val target d))))
    ; Both integers — emit cast if needed
    (when (and (!= (is-int-type src) 0) (!= (is-int-type target) 0))
      ; Stage 14 LW-4 (int-widening.md §"LW-4"): a known integer literal whose
      ; value is not representable in the target type is a compile-time error,
      ; never a silent trunc/wrap. Only genuine literals carry `is-lit` (set by
      ; emit-int); typed *values* are untouched — their runtime value is unknown,
      ; and narrowing them stays the caller's existing behavior (a non-goal). This
      ; is the single chokepoint: let/defvar init, field store, aset!, return,
      ; union-variant construction, plain/generic call args, and binop literal
      ; adoption (via coerce-num-val) all route a literal-tagged Val through here.
      (when (and (!= (vv 'is-lit) 0)
                 (= (int-literal-fits (vv 'lit-i64) target) 0))
        (die-at line
          (fstr "integer literal " (fstr (vv 'lit-i64)) " does not fit "
                (type-display target))))
      (let (sw:i32 (int-width src) dw:i32 (int-width target))
        (when (= sw dw)
          ; Same width, different signedness — reinterpret (no IR needed)
          (return (alloc-val target (vv 'val))))
        (let (tmp:StrView (new-tmp)
              instr:StrView "")
          (if (< dw sw)
            (set! instr "trunc")
            (if (!= (is-unsigned src) 0)
              (set! instr "zext")
              (set! instr "sext")))
          (emit g-body-stream "  " tmp " = " instr " " (type-to-ir src) " " (vv 'val) " to "
                (type-to-ir target) "\n")
          (return (alloc-val target tmp)))))
    ; Stage 15 W2d (design/stage15-stress-test/literal-typing.md §3.6): both
    ; floats. Before this, `coerce-int-val` had NO float case at all, and the two
    ; consequences were opposite: every position that treats a null return as a
    ; type error (let/with init, set!, .set! field store, explicit and implicit
    ; return, struct-literal and array positional initializers) rejected
    ; `(let (a:f32 0.0) …)` outright, while the ONE position that treats a null
    ; return as "leave the argument alone" — the call-argument coercion in
    ; emit-call-with-args, via safe-coerce-val — silently passed a `double` to a
    ; `float` parameter and miscompiled (`call float @take(double 2.5)` printed
    ; 0.000000). Both are fixed here, at the shared chokepoint.
    ;
    ; A float LITERAL adapts with no IR: it is re-rendered as a constant at the
    ; target's width (float-literal-ir-at's rule, reached through f32-const-ir
    ; since a literal Val is always f64). This is the §3.6 finding — a float
    ; constant in f32 code no longer needs `(unsafe/cast f32 …)`.
    ;
    ; A non-literal narrows SILENTLY (`fptrunc`) — Option A of the W2d design
    ; note. This is not a new policy: `coerce-int-val`'s integer branch a few
    ; lines up silently truncates an i64 value into an i32 slot at these exact
    ; same positions, and only range-checks *literals*. Floats now behave the
    ; same way. (Both share the standing tension that the explicit `(as f32 d)`
    ; spelling rejects the conversion as lossy while the implicit one at a typed
    ; slot does not; that is one language-wide question about implicit narrowing,
    ; already true for integers, and if it is ever revisited it must be revisited
    ; here — for both — not for floats alone.)
    (when (and (!= (is-float-type src) 0) (!= (is-float-type target) 0))
      ; Only f64→f32 can reach the fold: emit-float types every literal f64, and
      ; f64→f64 already returned at the `sk == dk` identity line above. Anything
      ; else (a widening of an already-narrowed value) takes the instruction path.
      ; Stage 16 FL-2: the same re-render at the three wide widths, which have
      ; no decimal spelling in LLVM at all — so for them this is not an
      ; optimization, it is the only way a literal reaches the slot.
      (when (!= (vv 'is-flit) 0)
        (let (tk:i32 (target 'kind))
          ; Stage 16 FL-3: a hex lexeme re-renders from its own bits, since the
          ; f64 beside it is only as precise as f64.
          (when (not (symbol-none? (vv 'lit-lex)))
            (match (hexfloat-const-ir (symbol-as-view (vv 'lit-lex)) tk)
              (none 0)
              ((some h) (return (alloc-val target h)))))
          (when (= tk TY-F32)  (return (alloc-val target (f32-const-ir (vv 'lit-f64)))))
          (when (= tk TY-F16)  (return (alloc-val target (f16-const-ir (vv 'lit-f64)))))
          (when (= tk TY-F80)  (return (alloc-val target (f80-const-ir (vv 'lit-f64)))))
          (when (= tk TY-F128) (return (alloc-val target (f128-const-ir (vv 'lit-f64)))))))
      (let (tmp:StrView (new-tmp)
            instr:StrView "fpext")
        (when (< (float-width target) (float-width src)) (set! instr "fptrunc"))
        (emit g-body-stream "  " tmp " = " instr " " (type-to-ir src) " " (vv 'val) " to "
              (type-to-ir target) "\n")
        (return (alloc-val target tmp))))
    ; Nothing built-in applies. Last resort is the user's own `defcast` registry
    ; (W9 item 47) — reached by an up-call because `lookup-cast-rule` needs
    ; `type-eq`, which lives further down the inlined stream. Placed HERE, at the
    ; one chokepoint every typed slot already funnels through, rather than at the
    ; nine call sites: hand-wiring the argument position and forgetting the other
    ; eight is precisely the defect this fixes. Only the final fallthrough gets
    ; it — the earlier `(return null)`s above are deliberate refusals of a
    ; specific pair, not "no built-in applies".
    (return (coerce-via-cast-rule v target))))

; A string literal feeding a phi materializes HERE — the only place a phi operand
; may be defined — unconditionally since C8, so `(if c "a" "b")` is a `StrView`.
(defn join-strlit-branch (v:ref:Val want:ptr line:i32):&Val
  (let (tgt:ptr want)
    (when (or (= tgt null) (= (type-is-strview tgt) 0)) (set! tgt (strview-type)))
    (when (and (!= tgt null) (!= (v 'is-lit) 0) (!= (type-is-strview (v 'type)) 0))
      (let (mv:?&Val (coerce-int-val v (as ?&Type tgt) line))
        (when (!= mv null) (return mv)))))
  (collapse-strlit-cstr (as ptr v))
  (return v))

; THE bool -> integer widening, in one function its two explicit askers CALL
; (`emit-as` step 5 and `vararg-promote`). It is deliberately NOT reachable from
; `coerce-int-val` above: an implicit bool->int would make `(let (n:i32 true) …)`
; compile, which is the divorce this item performs
; (design/stage16-ergonomics/bool-type-plan.md).
(defn widen-bool-to-int (v:?&Val target:?&Type):&Val
  (let (vv:ptr:Val v
        tmp:StrView (new-tmp))
    (emit g-body-stream "  " tmp " = zext " (type-to-ir (vv 'type)) " " (vv 'val) " to "
          (type-to-ir target) "\n")
    (return (alloc-val target tmp))))

; SM-5 diagnostic backstop (design/stage14/symbol-mangling.md): validate a
; FINAL ir-name at the point a defn/defvar/struct/union is defined or declared,
; so an LLVM-illegal character ir-name-token/sanitize-for-ir/sanitize-for-c
; don't already neutralize (e.g. a literal `%` — legal in a Nucleus symbol per
; lib/reader.nuc's permissive is-sym-char, but not in an unquoted LLVM
; identifier) is a source-level compiler error naming the original definition,
; never a raw LLVM parse error surfacing later at link/verify time.
; `ir-name-illegal-char` (the pure char-class predicate) lives in format.nuc
; beside ir-name-token/sanitize-for-ir/sanitize-for-c; this die-at-calling
; wrapper cannot live there too — format.nuc is import-used (nucleusc.nuc:420)
; before reader.nuc (507) where die-at is defined, so a call up to die-at from
; a format.nuc body would be an unresolved forward reference at emit time (the
; same import-order wall SM-3/SM-4 document). abi.nuc is imported (582) after
; reader.nuc and before every chokepoint that needs this wrapper
; (union-registry.nuc 584, generics.nuc 604, cheader.nuc 6921, and
; nucleusc.nuc's own emit-defvar/emit-extern/emit-defn/emit-defstruct further
; down that same file), so it is the earliest available home.
(defn check-ir-name-legal (line:i32 orig-name:Symbol ir-name:StrView):void
  (let (bad:i32 (ir-name-illegal-char ir-name))
    (when (>= bad 0)
      (die-at line
        (fstr "illegal character '" (as Char (as ui32 bad)) "' in generated symbol for '"
              orig-name "' (ir-name '" ir-name "') — LLVM identifiers allow only [A-Za-z0-9$._-]"))))
  ; W9 item 39: the position half of the same rule. ir-name-token escapes a
  ; leading digit, so reaching here means an ir-name was produced on a path that
  ; skipped it — report it against the definition rather than letting LLVM
  ; report it against the generated IR.
  (when (!= (ir-name-leading-digit ir-name) 0)
    (die-at line
      (fstr "generated symbol for '" orig-name "' (ir-name '" ir-name
            "') begins with a digit — an LLVM identifier may not"))))

(defn register-struct (name:Symbol):&StructDef
  (when (>= (unsafe/cast i32 (count g-structs)) MAX-STRUCTS)
    (eprint "nucleusc: too many structs\n") (exit 1))
  (let (sd:&StructDef (new StructDef))
    (set! (sd 'name) name)
    ; SM-4 + Stage 15 B3′: precompute the LLVM-safe type name once. `name` is
    ; the CANONICAL key, so the prefix is derived from the key's own namespace —
    ; never from `g-current-ns`, which is the stamping/importing file's whenever a
    ; template instance or an imported type is registered. `key-namespace` answers
    ; `user` for a bare key, `ns-ir-prefix` answers "" for `user`, and
    ; `ns-compose` is the identity on an empty prefix, so for every existing
    ; struct/union this is exactly `ir-name-token name` — byte-identical.
    (let (pre:Symbol (ns-ir-prefix (key-namespace name)))
      (set! (sd 'ir-prefix) pre)
      (set! (sd 'ir-name)
            (ns-compose pre (ir-name-token (symbol-as-view (strip-ns-qualifier name))))))
    (set! (sd 'num-fields) 0)
    (set! (sd 'emitted) 0)
    (set! (sd 'emit-epoch) 0)
    (set! (sd 'in-type-buf) 0)
    (set! (sd 'in-preamble) 0)
    (set! (sd 'queued) 0)
    (set! (sd 'laid-out) 0)
    ; W3a: a fresh registration is not opaque — `opaque` marks a type whose
    ; layout is known to be *unavailable* (a C forward declaration), which only
    ; the cheader parser sets. A name-only pre-registration by
    ; prescan-struct-names is a different state: its layout arrives later in the
    ; same unit, and until it does nothing may reference the type by value anyway
    ; (the definition is emitted before any use is compiled).
    (set! (sd 'opaque) 0)
    (set! (sd 'alias-of) null)
    (set! (sd 'is-union) 0)
    (set! (sd 'udef) null)
    (set! (sd 'origin-template) null)
    (set! (sd 'origin-args) null)
    (set! (sd 'origin-nargs) 0)
    ; Stage 15 B5: provenance for the shared binding interface. `priv` is NOT
    ; read from `g-defining-private` here — this is the sole StructDef allocator
    ; and it also mints closure-env, dyn-box, anon-struct and C-header types,
    ; which would inherit an enclosing `defn-`'s flag. Only the four private
    ; definers set it, at their own registration sites.
    (set! (sd 'priv) 0)
    (set! (sd 'src-ns) g-current-ns)
    (conj g-structs sd)
    (return sd)))

(import-use nucleus.arena)
(import-use nucleus.vector)
(import-use nucleus.intern)
(import-use nucleus.strview)
(import-use nucleus.node)
(import-use nucleus.string)
(import-use nucleus.strview-str)
(import-use nucleus.fmt)
(import-use nucleus.read)

; Union/struct registry and type-parsing — extracted from src/nucleusc.nuc.
; Source-imported by src/nucleusc.nuc after the ABI module is available.

; ============================================================
; Stage 8: anonymous structs — (struct field:type ...) types, memoized by
; content hash so two textually-identical shapes share one StructDef.
; ============================================================

(defn fnv-byte (h:i64 b:i64):i64
  (set! h (bit-xor h b))
  (set! h (* h 1099511628211))
  (return h))

(defn fnv-str (h:i64 s:Symbol):i64
  (let (n:i64 (as i64 (symbol-len s))
        i:i64 0)
    (while (< i n)
      (set! h (fnv-byte h (as i64 (symbol-byte-at s (as usize i)))))
      (set! i (+ i 1)))
    (return h)))

(defn hash-type (h:i64 t:?&Type):i64
  (when (= t null) (return (fnv-byte h 255)))
  (let (tt:?&Type t
        k:i32 (tt 'kind))
    (set! h (fnv-byte h k))
    (set! h (fnv-byte h (tt 'is-volatile)))
    (when (= k TY-PTR)
      (set! h (hash-type h (tt 'elem))))
    ; Stage 15 W8 G-2: two array types are the same shape only if both the
    ; element type and the length match, so both go into the hash.
    (when (= k TY-ARRAY)
      (set! h (fnv-byte h (tt 'arr-len)))
      (set! h (hash-type h (tt 'elem))))
    (when (= k TY-STRUCT)
      (set! h (fnv-str h ((tt 'sdef) 'name))))
    (when (= k TY-UNION)
      (set! h (fnv-str h ((tt 'sdef) 'name))))
    (when (= k TY-FN)
      (set! h (hash-type h (tt 'ret)))
      (set! h (fnv-byte h (tt 'num-params)))
      (dotimes (i (tt 'num-params))
        (set! h (hash-type h ((field-at (tt 'params) i) 'type)))))
    (return h)))

(defn hash-struct-shape (field-names:ptr field-types:ptr faligns:ptr fbits:ptr
                         nfields:i32):i64
  (let (h:i64 -3750763034362895579)
    (dotimes (i nfields)
      (set! h (fnv-str h (aref (unsafe/cast &Symbol field-names) i)))
      (set! h (fnv-byte h 0))
      (set! h (hash-type h (aref (unsafe/cast &ptr field-types) i)))
      ; PK-3: a member alignment moves offsets, so it is part of the SHAPE.
      ; Only a NON-ZERO one is folded in: "no alignment" and "alignment 0" are
      ; the same shape, and hashing the zero would rename every anonymous type
      ; the C importer has ever memoized.
      (when (and (!= faligns null) (!= (aref (unsafe/cast &i32 faligns) i) 0))
        (set! h (fnv-byte h (aref (unsafe/cast &i32 faligns) i))))
      ; BF-4: and a bit width, for the same reason and under the same rule.
      (when (and (!= fbits null) (!= (aref (unsafe/cast &i32 fbits) i) 0))
        (set! h (fnv-byte h (+ 257 (aref (unsafe/cast &i32 fbits) i))))))
    (return h)))

; Stage 16 PK-2: `packed` is part of the memoization KEY, not a property applied
; after the lookup — two structurally identical bodies, one packed and one not,
; are different types, and sharing one StructDef between them would be a silent
; wrong layout for whichever arrived second.
(defn lookup-or-make-anon-struct (field-names:ptr field-types:ptr faligns:ptr
                                  fbits:ptr nfields:i32 packed:i32
                                  align:i32):&StructDef
  (let (hash:i64 (+ (hash-struct-shape field-names field-types faligns fbits nfields)
                    (+ packed (* (as i64 align) 65599)))
        synth:Symbol (symbol-intern (fstr "__anon_struct_h" (hex hash 16)))
        sd:ptr (lookup-struct synth))
    (when (= sd null)
      (set! sd (register-struct synth))
      (let (sd2:&StructDef (unsafe/cast &StructDef sd))
        (set! (sd2 'packed) packed)
        (set! (sd2 'align-attr) align)
        (struct-set-fields sd2 field-names field-types nfields)
        (struct-set-field-aligns sd2 faligns nfields)
        (struct-set-field-bits sd2 fbits nfields)
        ; Stage 15 W9 item 26: this is the ONE eager writer among the anonymous
        ; type constructors — `lookup-or-make-anon-union` queues instead — and it
        ; is reachable from the signature prescan, which the header-emit modes run
        ; with no module stream open. `fprintf` to a null `FILE*` segfaulted, so
        ; `--emit-nuch` has always died on an anonymous struct in a signature;
        ; `--emit-cheader` inherited it the moment it started prescanning. Nothing
        ; is codegen'd in those modes, so there is nothing to write — and
        ; nothing may be recorded as written. Same guard the `!T` payload path at
        ; the bottom of this file already uses.
        (when (!= g-module-open 0)
          ; A prescanned defunion arm's payload can name `Pt` before `%Pt` exists;
          ; then the drain writes it, or a macro module inherits a dangling `%Pt`.
          (when (!= (type-line-resolves sd2) 0)
            (sdef-note-emitted sd2 &g-type-stream)
            (emit-struct-type-line &g-type-stream sd2))
          ; R4: queue it too, so this eager write is replayable into a later
          ; module like every other type. Inert wherever the eager write already
          ; landed — the drain re-checks `sdef-in-module` — so the IR is unmoved.
          (queue-type-line sd2))
        (set! (sd2 'src-file) g-source-path)
        (set! (sd2 'src-line) 0)))
    ; Both arms leave sd non-null, but the set!-kill is sticky across the join
    ; (nullability.md §4) — assert rather than re-test.
    (return (unsafe/cast &StructDef sd))))

; ============================================================
; Stage 10: untagged unions (design/stage10/unions.md §2). Anonymous and
; memoized like (struct ...). LLVM has no union type, so a union lowers the
; way clang does: a struct wrapping the largest-aligned member plus padding
; to the full size. The IR type definition needs member sizes, and members
; may name structs whose fields are registered later in the unit — so the
; definition text is deferred to drain-pending-union-irs, called at every
; module-assembly point (named types are order-independent in a module).
; ============================================================

(defn lookup-or-make-anon-union (field-names:ptr field-types:ptr faligns:ptr
                                 fbits:ptr nfields:i32 packed:i32
                                 align:i32):&StructDef
  (let (hash:i64 (+ (hash-struct-shape field-names field-types faligns fbits nfields)
                    (+ packed (* (as i64 align) 65599)))
        synth:Symbol (symbol-intern (fstr "__anon_union_h" (hex hash 16)))
        sd:ptr (lookup-struct synth))
    (when (= sd null)
      (set! sd (register-struct synth))
      (let (sd2:&StructDef (unsafe/cast &StructDef sd))
        (set! (sd2 'packed) packed)
        (set! (sd2 'align-attr) align)
        (struct-set-fields sd2 field-names field-types nfields)
        (struct-set-field-aligns sd2 faligns nfields)
        (struct-set-field-bits sd2 fbits nfields)
        (set! (sd2 'is-union) 1)
        (set! (sd2 'emitted) 0)
        (set! (sd2 'src-file) g-source-path)
        (set! (sd2 'src-line) 0)
        (queue-type-line sd2)))
    (return (unsafe/cast &StructDef sd))))

; The member a union's IR wrapper struct holds: the first member with maximal
; alignment (clang's rule); remaining bytes become an i8 padding array.
(defn union-repr-member (sd:?&StructDef):i32
  (let (sdd:ptr:StructDef sd
        n:i32 (sdd 'num-fields)
        best:i32 0
        besta:i32 0)
    (dotimes (i n)
      (let (fa:i32 (abi-alignof ((field-at (sdd 'fields) i) 'type)))
        (when (> fa besta) (set! besta fa) (set! best i))))
    (return best)))

; Write the deferred `%name = type { f0, f1, ... }` definition for one stamped
; parametric-struct instance (parametric-structs.md §3). Shares the pending queue
; with unions; distinguished by is-union == 0. A plain struct line — no
; repr-member/padding — so a stamped instance is byte-identical to the
; hand-written struct. `sdef-in-module` guards double-emit.
(defn emit-pending-struct-ir-type (sd:?&StructDef):void
  (let (sdd:?&StructDef sd)
    (when (!= (sdef-in-module sdd) 0) (return))
    (sdef-note-emitted sdd &g-type-stream)
    (emit-struct-type-line &g-type-stream sdd)))

; Write the deferred `%name = type { repr [, pad] }` definition for one union.
(defn emit-union-ir-type (sd:?&StructDef):void
  (let (sdd:ptr:StructDef sd)
    (when (!= (sdef-in-module sdd) 0) (return))
    ; Stage 11: a stamped parametric struct queued on the shared pending list is
    ; not a union — emit a plain struct line instead of the union wrapper.
    (when (= (sdd 'is-union) 0)
      (emit-pending-struct-ir-type sd)
      (return))
    (sdef-note-emitted sdd &g-type-stream)
    (let (ri:i32 (union-repr-member sd)
          rt:ptr ((field-at (sdd 'fields) ri) 'type)
          total:i32 (abi-union-size sd)
          pad:i32 (- total (abi-sizeof rt))
          ; PK-1: a union's line is `{ repr [, pad] }`, not its field table, so
          ; it cannot share emit-struct-type-line — only the brackets.
          op:StrView (if (!= (sdd 'packed) 0) "<{" "{")
          cl:StrView (if (!= (sdd 'packed) 0) "}>" "}"))
      (if (> pad 0)
        (emit g-type-stream "%" (sdd 'ir-name) " = type " op " " (type-to-ir rt) ", [" pad
              " x i8] " cl "\n\n")
        (emit g-type-stream "%" (sdd 'ir-name) " = type " op " " (type-to-ir rt) " " cl "\n\n")))))

; Is every by-value named-type field dependency of `sd` present in the module
; currently being assembled? A field lowers to a `%Name` reference only when its
; kind is TY-STRUCT/TY-UNION (type-to-ir); TY-PTR fields lower to opaque `ptr`
; and carry no named dependency. `sdef-in-module` is what makes the question true
; as stated rather than only in batch (Stage 16 R4). The deferral exists for a
; type stamped at prescan (signature occurrence) before the import that defines
; its struct-by-value field has run: it stays queued until a later drain, after
; that import emits the dependency. See cleanup3.md "two-stage boot refresh".
(defn pending-union-deps-ready (sd:?&StructDef):i32
  (let (sdd:ptr:StructDef sd
        n:i32 (sdd 'num-fields))
    (dotimes (i n)
      (let (ft:&Type (unsafe/cast &Type ((field-at (sdd 'fields) i) 'type))
            fk:i32 (ft 'kind))
        (when (or (= fk TY-STRUCT) (= fk TY-UNION))
          (let (dep:&StructDef (unsafe/cast &StructDef (ft 'sdef)))
            ; A null sdef (shape-only / unresolved) cannot be a satisfied named
            ; dependency; treat as not-ready so we defer rather than emit a
            ; dangling %ref.
            (when (= (as ptr dep) null) (return 0))
            (when (= (sdef-in-module dep) 0) (return 0)))))))
  (return 1))

; Emit every still-pending union/struct type definition whose named field
; dependencies are already present in the module being assembled. Idempotent
; (each emit re-checks `sdef-in-module`); entries are never removed from the
; queue, so a type skipped here for an unready dependency is retried on the next
; drain — and, since R4, a type whose module has come and gone is re-emitted into
; the next one. Called before each module assembly (batch output, compile-time
; JIT, macro JIT, REPL).
(defn drain-pending-union-irs ():void
  ; To a fixed point: a deferred type can sit in the queue after one naming it,
  ; and `type-line-resolves` promises everything resolvable is written here.
  (let (again:bool true)
    (while again
      (let (wrote:bool false
            skipped:bool false)
        (dotimes (i (unsafe/cast i32 (count g-pending-unions)))
          (let (sd:ptr (invoke g-pending-unions i:usize))
            (when (= (sdef-in-module sd) 0)
              (if (!= (pending-union-deps-ready sd) 0)
                (do (emit-union-ir-type sd)
                    (set! wrote true))
                (set! skipped true)))))
        (set! again (and wrote skipped))))))

; Put `sd`'s type line on the queue the drains write from.
(defn queue-type-line (sd:&StructDef):void
  (set! (sd 'queued) 1)
  (conj g-pending-unions sd))

; Will every by-value named type `sd`'s line mentions be in the module by the
; next drain — already there, or queued and resolvable itself? An eager writer
; may write when this holds; otherwise its line would dangle in a macro module.
(defn type-line-resolves (sd:&StructDef):i32
  (return (type-line-resolves-at sd 0)))

(defn type-line-resolves-at (sd:?&StructDef depth:i32):i32
  ; By-value types cannot nest cyclically; the bound only stops a malformed one.
  (when (> depth 64) (return 0))
  (let (sdd:ptr:StructDef sd)
    (dotimes (i (sdd 'num-fields))
      (let (ft:?&Type ((field-at (sdd 'fields) i) 'type))
        (while (and (!= ft null) (= (ft 'kind) TY-ARRAY))
          (set! ft (ft 'elem)))
        (when (and (!= ft null) (or (= (ft 'kind) TY-STRUCT) (= (ft 'kind) TY-UNION)))
          (let (dep:?&StructDef (ft 'sdef))
            (when (= dep null) (return 0))
            (when (= (sdef-in-module dep) 0)
              (when (= (dep 'queued) 0) (return 0))
              (when (= (type-line-resolves-at dep (+ depth 1)) 0) (return 0))))))))
  (return 1))

; Stage 15 B5: the visibility conjunct on this and the three lookups below is
; the enforcement of `defstruct-`/`defunion-` privacy. `g-priv-bindings` is 0
; unless the unit actually contains one of the four private definers that have
; no `Sym`, so for every existing program this is one global compare and the
; scan is unchanged. The rule itself lives in `binding-visible`
; (src/nucleusc.nuc) — one function, six callers, per §13.3.
; Stage 15 B3′: this is the KEY lookup — `name` must be a canonical registry key
; (`qualify-name`'s output, or a compiler-minted name, which is `user` by
; construction). A source *spelling* goes through `struct-lookup-ref` below. The
; split is B2a's, per kind, and it is the whole of the per-kind work: a definer's
; existence probe, a stamp memo and a `.nuch` replay all hold keys, while every
; `:T` annotation holds a spelling.
(defn lookup-struct (name:Symbol):?&StructDef
  (dotimes (i (unsafe/cast i32 (count g-structs)))
    (let (sd:&StructDef (as &StructDef (invoke g-structs i:usize)))
      (when (and (= (sd 'name) name)
                 (or (= g-priv-bindings 0) (!= (binding-visible (sd 'priv) (sd 'src-ns)) 0)))
        (return (as ptr sd)))))
  (return null))

; Stage 15 B3′: the five REFERENCE resolvers. Each is the shared candidate-key
; walk (`name-ref-key-count` / `name-ref-key-at`, src/nucleusc.nuc) plus this
; registry's own two-line probe, then the re-export alias table, then the
; synthesized-spelling key fallback (`g-type-key-ok`). A unit that declares no
; namespace runs exactly one probe with exactly the key the pre-B3′ code used.
(defn struct-lookup-ref (spelling:Symbol):?&StructDef
  (if-some (a (env-arg-of spelling))
    (do
      (when (!= (a 'type) null)
        (let (t:ptr:Type (a 'type))
          (when (or (= (t 'kind) TY-STRUCT) (= (t 'kind) TY-UNION)) (return (t 'sdef)))
          (return null)))
      (let (here:NameEnv (name-env-here)
            nm:Symbol (env-arg-name-enter a &here))
        (when (symbol-none? nm) (return null))
        (let (r:?&StructDef (struct-lookup-ref nm))
          (name-env-set here)
          (return r))))
    0)
  (dotimes (i (name-ref-key-count spelling))
    (match (name-ref-key-at spelling i)
      ((some k)
        (let (reach:Symbol (priv-reach-enter spelling)
              hit:?&StructDef (lookup-struct k))
          (set! g-priv-reach-ns reach)
          (when (!= hit null) (return hit))))
      (none 0)))
  (let (al:ptr (binding-alias-find spelling BK-STRUCT))
    (when (!= al null) (return (unsafe/cast &StructDef al))))
  (when (!= g-type-key-ok 0) (return (lookup-struct spelling)))
  (return null))

; The built-in type names, as a pure name -> Type lookup that answers null for a
; name that is not built in. Extracted from `parse-type-name` (Stage 15 W9 item
; 13) so that "is this list head a type rather than a type CONSTRUCTOR" can be
; asked without dying — `parse-type-name` itself ends in `die-at`, so it cannot
; serve as a probe, and a second copy of this list would drift from it.
(defn builtin-type-name (name:Symbol):?&Type
  (when (= name "int") (return (as ptr ty-i32)))
  (when (= name "Err") (return (as ptr ty-err)))
  (when (= name "i8") (return (as ptr ty-i8)))
  (when (= name "i16") (return (as ptr ty-i16)))
  (when (= name "i32") (return (as ptr ty-i32)))
  (when (= name "i64") (return (as ptr ty-i64)))
  (when (= name "bool") (return (as ptr ty-bool)))
  (when (= name "ptr") (return (as ptr ty-ptr)))
  (when (= name "CStr") (return (as ptr ty-cstr)))
  (when (= name "Char") (return (as ptr ty-char)))
  (when (= name "void") (return (as ptr ty-void)))
  (when (= name "ui8") (return (as ptr ty-ui8)))
  (when (= name "ui16") (return (as ptr ty-ui16)))
  (when (= name "ui32") (return (as ptr ty-ui32)))
  (when (= name "ui64") (return (as ptr ty-ui64)))
  ; Stage 11: pointer-sized integer aliases. usize is unsigned (size_t),
  ; ssize is signed (ssize_t/ptrdiff_t). Size follows g-target-ptr-bytes.
  (when (= name "usize") (return (as ptr ty-usize)))
  (when (= name "ssize") (return (as ptr ty-ssize)))
  (when (= name "f32") (return (as ptr ty-f32)))
  (when (= name "f64") (return (as ptr ty-f64)))
  (when (= name "float") (return (as ptr ty-f32)))
  (when (= name "double") (return (as ptr ty-f64)))
  ; Stage 16 FL-1: named for the REPRESENTATION, since C's `long double` is
  ; f80 on x86-64/i386 and f128 on aarch64/riscv64 — the C spelling maps per
  ; target (c-type-to-nucleus), these do not.
  (when (= name "f16") (return (as ptr ty-f16)))
  (when (= name "f80") (return (as ptr ty-f80)))
  (when (= name "f128") (return (as ptr ty-f128)))
  (return null))

; The leading `?`/`!` run of a type spelling. `symbol-byte-at` at `len` reads
; the interner's NUL, so the scan needs no bound of its own.
(defn type-sigil-run (name:Symbol):usize
  (let (i:usize 0)
    (while (or (= (symbol-byte-at name i) 63) (= (symbol-byte-at name i) 33))
      (set! i (+ i 1)))
    (return i)))

; The one-shot `(array T N)` permission (`g-array-ok`, src/nucleusc.nuc) is
; consumed HERE, as parse-type-from-node consumes it on entry, so every
; recursion below — `?T`, `!T`, the colon delegation, an alias body — sees 0 and
; an array can appear only at the very name a permitting site handed us.
(defn parse-type-name (name:Symbol line:i32):&Type
  (let (array-ok:i32 g-array-ok)
    (set! g-array-ok 0)
    (return (resolve-type-name name line array-ok))))

; PK-3: a spelling that is nothing but sigils is `? (Vector i32)` written with
; a space — name the near-miss rather than an empty `unknown type`.
(defn reject-bare-sigil (name:Symbol line:i32):void
  (let (run:usize (type-sigil-run name))
    (when (and (> run 0) (= run (symbol-len name)))
      (die-at line (fstr "a type sigil must be attached to its type -- write "
                         name "T or " name "(T ...) with no space")))))

; A dry parse (`g-dry-parse-ntv`) answers with this for a type variable and for
; anything it would otherwise have to stamp or register.
(defn dry-parse-type ():&Type
  (return (make-type TY-TYVAR)))

(defn dry-parse-tyvar (name:Symbol):i32
  (when (= g-dry-parse-ntv 0) (return 0))
  (if (>= (tyvar-index-of name g-dry-parse-tyvars g-dry-parse-ntv) 0) (return 1) (return 0)))

(defn resolve-type-name (name:Symbol line:i32 array-ok:i32):&Type
  (let (sv:StrView (symbol-as-view name))
  (if-some (at (env-arg-type name array-ok)) (return at) 0)
  (reject-bare-sigil name line)
  ; Stage 10 errors sugar: ?!T => (Maybe (Result T Err)) — a fallible result
  ; that may be absent. The leading ?! reads as a *value* Maybe over the Result
  ; (errors.md §10): the operand is already a complete value type, so it is not
  ; a niche pointer. Checked before the plain ? below. Needs the value-Maybe and
  ; Result templates (prelude).
  (when (strview-has-prefix sv "?!")
    (let (result-ty:ptr (parse-type-name (symbol-intern (strview-drop-bytes sv 1)) line)
          ut:?&UnionTemplate (union-template-lookup-ref (symbol-intern "Maybe")))
      (when (= ut null)
        (die-at line (missing-template-message "?!T" (symbol-intern "Maybe"))))
      (let (argts:ptr (arena-alloc (ptr-bytes)))
        (set! (aref (unsafe/cast &ptr argts) 0) result-ty)
        (return (union-template-stamp-types (as ptr ut) argts 1 line)))))
  ; Stage 10 sugar: ?T => (Maybe T), uniform (Phase F). A pointer operand
  ; (e.g. ?ptr:Node, ?ref:Node) niche-encodes (one pointer, null = none) by
  ; relabeling its kind to Maybe. A value operand (?Node) stamps the two-arm
  ; {tag, T} value-Maybe template (E2) and no longer auto-injects (ref ...). Our
  ; own source spells every nullable-pointer Maybe ?ptr:Foo, so no bare value
  ; ?Foo remains there (byte-identical); value ?Foo now means the value-Maybe.
  (when (strview-has-prefix sv "?")
    (let (inner:ptr (parse-type-name (symbol-intern (strview-drop-bytes sv 1)) line))
      (when (= (-> inner (unsafe/cast &Type _) (_ 'kind)) TY-PTR)
        (return (unsafe/cast &Type (type-as-pkind inner PTR-MAYBE))))
      ; Value operand: stamp the value-Maybe template (E2 / errors.md §10).
      (let (ut:?&UnionTemplate (union-template-lookup-ref (symbol-intern "Maybe")))
        (when (= ut null)
          (die-at line (missing-template-message "?T" (symbol-intern "Maybe"))))
        (let (argts:ptr (arena-alloc (ptr-bytes)))
          (set! (aref (unsafe/cast &ptr argts) 0) inner)
          (return (union-template-stamp-types (as ptr ut) argts 1 line))))))
  ; Stage 10 errors sugar: !T => (Result T Err). Recognized only in type
  ; positions (no collision with !=, which never parses as a type), and — unlike
  ; ? — takes the payload as written (A1's arbitrary payloads: !i64 is
  ; (Result i64 Err)). !?T composes for free: the rest "?T" recurses here.
  (when (strview-has-prefix sv "!")
    (let (inner:ptr (parse-type-name (symbol-intern (strview-drop-bytes sv 1)) line)
          ut:?&UnionTemplate (union-template-lookup-ref (symbol-intern "Result")))
      (when (= ut null)
        (die-at line (missing-template-message "!T" (symbol-intern "Result"))))
      (let (argts:ptr (arena-alloc (* 2 (ptr-bytes))))
        (set! (aref (unsafe/cast &ptr argts) 0) inner)
        (set! (aref (unsafe/cast &ptr argts) 1) (as ptr ty-err))
        (return (union-template-stamp-types (as ptr ut) argts 2 line)))))
  ; Colon-sugar reaching the string parser (only via the ?/!/?! recursion on a
  ; pointer operand, e.g. "ptr:Node" after stripping the leading ?): delegate to
  ; the node parser. Bare type names elsewhere never contain a colon, so this is
  ; inert for the existing flow.
  (when (symbol-contains-byte name 58)
    (return (parse-type-from-node (split-colon-segments name line) line)))
  (when (!= (dry-parse-tyvar name) 0) (return (dry-parse-type)))
  ; Stage 14 AVR-7: an explicit `:f64`/`double` annotation is a compile-time
  ; error on AVR (no hardware double). Checked before the resolution below so an
  ; annotated f64 never reaches codegen; the bare-float-literal default is caught
  ; separately in emit-float. `f32`/`float` are unaffected. Inert off AVR.
  ; Deliberately NOT inside `builtin-type-name`, which must answer without dying.
  (when (or (= name "f64") (= name "double")) (avr-reject-f64 line))
  (when (or (= name "f16") (or (= name "f80") (= name "f128")))
    (reject-unavailable-float name line))
  ; Retired in Stage 16 (design/stage16-ergonomics/bool-type-plan.md): bool is
  ; its own kind, so the language has no 1-bit integer for `i1` to name. Named
  ; here rather than left to `unknown type` so the replacement is in the message.
  (when (= name "i1") (die-at line "i1 is no longer a type — use bool"))
  (when (= name "raw") (die-raw-retired line))
  (let (bt:?&Type (builtin-type-name name))
    (when (!= bt null) (return (unsafe/cast &Type bt))))
  ; Stage 13 L7: a TY-FN spelling (interned "__fnty_<id>" from type-spelling)
  ; resolves back to the original function-pointer Type*. This is what lets a
  ; stamped generic body's `(ref __fnty_3)` re-parse to the fn's TY-FN, so the
  ; forwarding call on the function pointer can be reconstructed at emit time.
  (match (fnty-resolve name)
         ((some ft) (return ft))
         (none null))
  ; Stage 15 B3′ (name-resolution.md §8.1 step 1): a type spelling is a
  ; REFERENCE — resolved through the writing file's import environment, exactly
  ; like a global or a protocol. This replaces Stage 12 N4's `strip-ns-qualifier`,
  ; which discarded the qualifier without ever checking it: that is defect #4 (any
  ; qualifier, including one naming no namespace at all, resolved) and defect #7
  ; (type identity was bare and global, so two namespaces could not both define
  ; `Vector`) closing together. Identity under `user` → byte-identical.
  (let (sd:ptr (struct-lookup-ref name))
    (when (!= sd null)
      ; A niche defunion (unions.md §6 rules 2/3) resolves to its bare-pointer
      ; niche type, not the (dead) backing struct — union-instance-type decides.
      (let (ud:?&UnionDef ((unsafe/cast &StructDef sd) 'udef))
        (when (!= ud null)
          (return (union-instance-type ud))))
      (return (type-for-sdef sd))))
  ; Stage 16 (container-type-sugar.md §3.3): a type alias expands to its retained
  ; body. Probed after the real definers, so an alias can never mask one — though
  ; `guard-name-kind` already makes that collision unreachable. Transparent: the
  ; Type returned is the body's, so nothing downstream can tell the two spellings
  ; apart (§3.2), which is why `type-spelling` is deliberately not taught aliases.
  (if-some (ta (type-alias-lookup-ref name))
    (do
      ; §3.7: a parametric alias used bare would otherwise expand to a body full
      ; of free tyvars and fail as `unknown type: T`, naming the wrong thing.
      (when (!= (ta 'ntv) 0)
        (die-at line
          (fstr "type alias '" name "' takes " (ta 'ntv)
                " type arguments — apply it as (Name Arg...)")))
      (when (>= g-type-alias-depth MAX-TYPE-ALIAS-DEPTH)
        (die-at line (fstr "type alias '" name "' expands into a cycle")))
      (set! g-type-alias-depth (+ g-type-alias-depth 1))
      ; The alias body is this same type node under another spelling, so it
      ; inherits the array permission — `(deftype Buf (array i32 4))` must name
      ; storage wherever `(array i32 4)` itself can, and nowhere else.
      (set! g-array-ok array-ok)
      (let (t:&Type (alias-body-type ta (as ptr (ta 'body)) line))
        (set! g-type-alias-depth (- g-type-alias-depth 1))
        (return t)))
    0)
  ; Stage 16 L5 (c-header-layout.md §3.5): a C typedef imported by this unit is
  ; a Nucleus type name. Probed after every Nucleus definer, so an import can
  ; never mask a `deftype` or a struct; transparent like `deftype`, so `off_t`
  ; and `i64` are one type, one mangling and one overload. A recorded entry whose
  ; type is null is a name we know and cannot represent — `unknown-type-message`
  ; below says so in its own words.
  (if-some (td (c-typedef-find name))
    (when (!= (td 'ty) null)
      ; The Type arrives already built, which is the one case `parse-type-from-
      ; node`'s g-array-ok gate never sees; answer it here with the words the
      ; `(array T N)` spelling gives. `reject-array-type` stays the backstop.
      (when (and (= (-> (td 'ty) (_ 'kind)) TY-ARRAY) (= array-ok 0))
        (die-at line "(array T N) is a storage type: it is valid only as a defvar type or a defstruct / (struct ...) field type -- everywhere else use &T, the pointer an array decays to when it is read"))
      (return (unsafe/cast &Type (td 'ty))))
    0)
  ; Stage 15 W1c: `unknown-type-message` (src/nucleusc.nuc) says plainly that
  ; the name is defined nowhere in the unit, and — for §2.7's reachability
  ; constraint, which W1 keeps — names the on-path file that does define it.
  (die-at line (unknown-type-message name))))

; The registered Type for a StructDef — TY-UNION when the def is an untagged
; union, TY-STRUCT otherwise (including defunion backing structs).
(defn type-for-sdef (sd:ptr:StructDef):&Type
  (let (k:i32 (if (!= (sd 'is-union) 0) TY-UNION TY-STRUCT)
        t:&Type (make-type k))
    (set! (t 'sdef) sd)
    (return t)))

; Stage 14 NS-3 (design/stage14/native-strings.md): the Type* for the prelude
; `StrView` struct — the type a string literal (NODE-STR) carries once the flip
; lands. Unlike `ty-cstr` (a builtin, init-time global), StrView is a user struct
; promoted to the prelude in NS-1, so its Type must be resolved dynamically from
; the struct registry. It is always registered by the time any literal is
; typed/emitted (prescan-struct-names registers every struct name before any
; emission, and StrView sits near the top of the prelude), so this returns
; non-null in practice; a null result (a broken/missing prelude) lets the callers
; fall back to a bare pointer rather than crash. A fresh Type is built per call
; (like type-for-sdef); type-eq keys on the sdef pointer, not Type identity, so
; two StrView Types compare equal. Identity of "StrView" is the interned symbol
; name, exactly how lookup-struct keys the registry (and type-is-strview matches).
(defn strview-type ():?&Type
  ; By key: a literal is the core StrView whatever the file names `StrView`.
  (let (sd:ptr (lookup-struct g-key-core-strview))
    (when (= sd null) (return null))
    (return (as ptr (type-for-sdef sd)))))

; ============================================================
; Stage 13 type-erasure (TE-1): the shared fat-pointer aggregate.
; ============================================================
; A type-erased value (BoxedFn / (dyn P), design/stage13/type-erasure.md) is a
; two-word fat pointer, a by-value aggregate:
;   { data: ptr,        ; heap-allocated payload (the boxed env / boxed value)
;     vtable: ptr }      ; address of the static per-concrete-type vtable (TE-2)
; Field order is { data, vtable } (the committed CE-4 order). It is an ordinary
; 16-byte TY-STRUCT, so it rides the existing by-value-struct ABI with no new
; value-vs-pointer logic: abi-classify sees two INTEGER eightbytes → ABI-COERCE2,
; exactly the CE-3 pass/return/store path (emit-struct-ret TY-PTR typed copy,
; emit-call-with-args first-class load, abi-arg-frag). type-size returns the
; pointer size for the TY-STRUCT slot; LLVM computes the real 16-byte size for
; typed load/store.
;
; CRITICAL (inertness): the StructDef is registered LAZILY — only the first time
; a box type is actually needed (TE-3+). Registering it eagerly at init would
; emit a `%__fatptr = type { ptr, ptr }` line into every module's IR and drift
; the bootstrap. Nothing boxes a value in the compiler's own source, so the lazy
; registration fires in ZERO modules during self-compilation → byte-identical.
(defvar g-fatptr-sdef:ptr null)   ; memoized {data,vtable} StructDef*, or null
(defvar g-fatptr-type:ptr null)   ; memoized TY-STRUCT Type* over it, or null

; Register (once) and return the {data:ptr, vtable:ptr} StructDef. Mirrors the
; parametric-struct stamp (struct-template-stamp-types): reserve the name via
; register-struct, fill the two ptr fields, and queue its `%__fatptr = type {…}`
; IR on the shared deferred queue (emit-pending-struct-ir-type writes the plain
; struct line at drain time; `sdef-in-module` guards double-emit). Both fields
; are opaque `ptr`, so the type has no named dependency and emits on the next
; drain. Idempotent — subsequent calls return the cached def.
(defn ensure-fatptr-sdef ():ptr
  (when (!= g-fatptr-sdef null) (return g-fatptr-sdef))
  (let (sd:&StructDef (register-struct (symbol-intern (sanitize-for-ir "__fatptr"))))
    (let (fnm:ptr (arena-alloc (* 2 (ptr-bytes)))
          fty:ptr (arena-alloc (* 2 (ptr-bytes))))
      (set! (aref (unsafe/cast &Symbol fnm) 0) (symbol-intern "data"))
      (set! (aref (unsafe/cast &Symbol fnm) 1) (symbol-intern "vtable"))
      (set! (aref (unsafe/cast &ptr fty) 0) (as ptr ty-ptr))
      (set! (aref (unsafe/cast &ptr fty) 1) (as ptr ty-ptr))
      (struct-set-fields sd fnm fty 2))
    (set! (sd 'src-file) g-source-path)
    (set! (sd 'src-line) 0)
    (queue-type-line sd)
    (set! g-fatptr-sdef (as ptr sd))
    (return g-fatptr-sdef)))

; The fat-pointer Type (TY-STRUCT over the StructDef above), memoized so every
; box shares one immutable Type* (type-eq by sdef pointer identity). TE-3 uses
; this as the slot/binding type and to build the fat-pointer Val; it constructs
; a value by alloca'ing this type, storing the heap `data` ptr into field 0 and
; the TE-2 vtable address into field 1, then loading the first-class aggregate.
(defn fatptr-type ():ptr
  (when (= g-fatptr-type null)
    (set! g-fatptr-type (as ptr (type-for-sdef (ensure-fatptr-sdef)))))
  (return g-fatptr-type))

; ============================================================
; Stage 13 type-erasure (TE-5 minimal): BoxedFn instance types.
; ============================================================
; `(BoxedFn (params…) ret)` denotes the shared fat pointer (TE-1) specialised to
; the Fn family. Each distinct signature gets its OWN {data,vtable} StructDef so
; type-eq (sdef pointer identity) keeps `(BoxedFn (i32) i32)` and
; `(BoxedFn (f64) f64)` distinct — the shared 16-byte layout means the ABI is
; still the CE-3 COERCE2 path. The Fn signature (ret + non-self params) is carried
; on the returned TY-STRUCT Type's ret/params/num-params fields (unused for a
; struct otherwise), so the boxing coercion (TE-3) and the `(invoke box …)`
; forwarding (TE-4) recover it without a side table. Memoised per signature-key so
; one spelling → one Type* → one sdef. LAZY like ensure-fatptr-sdef: the
; `%__boxedfn.… = type {…}` line is queued only when a signature is first parsed,
; so a box-free unit (the whole compiler) emits nothing → byte-identical bootstrap.
; §14.5 batch 3: the parallel keys/types arrays collapsed into one
; `(Vector (ref BoxedFnEntry))`. Lazily constructed on first use (mirrors
; g-vtable-table) — never explicitly reset, so `&` not `?&`.
(defvar g-boxedfn-table:&(Vector &BoxedFnEntry) (vector-new-in &g-arena-alloc))

(defn boxedfn-memo-lookup (key:Symbol):?&Type
  (dotimes (i (unsafe/cast i32 (count g-boxedfn-table)))
    (let (e:&BoxedFnEntry (invoke g-boxedfn-table i:usize))
      (when (= (e 'key) key) (return (e 'ty)))))
  (return null))

(defn boxedfn-memo-put (key:Symbol ty:ptr):void
  (let (rec:&BoxedFnEntry (new BoxedFnEntry))
    (set! (rec 'key) key)
    (set! (rec 'ty) (as ?&Type ty))
    (conj g-boxedfn-table rec)))

; A dot-free signature token "<rettok>_<p0tok>_<p1tok>…" (each via
; type-mangle-token), keying the per-signature box StructDef name and memo entry.
; §14.4: `params` is a TY-FN Type's parameter Vector `(Vector (ref Field))`;
; each param type is read via `field-at`. Both callers (boxedfn-type below and
; ensure-fnfwd-vtable in nucleusc.nuc) pass a Vector handle.
(defn boxedfn-sig-token (params:?&(Vector &Field) num-p:i32 ret:ptr):StrView
  (let (s:StrView (type-mangle-token ret))
    (dotimes (i num-p)
      (set! s (fstr s "_" (type-mangle-token ((field-at params i) 'type)))))
    (return s)))

; The (memoised) BoxedFn instance Type for a signature. On a miss it registers a
; fresh {data:ptr, vtable:ptr} StructDef (mirroring ensure-fatptr-sdef but with a
; per-signature name), queues its IR on the shared pending-union list, builds the
; TY-STRUCT Type, stamps the Fn signature onto ret/params/num-params, and memoises.
(defn boxedfn-type (param-arr:ptr num-p:i32 ret:ptr line:i32):&Type
  (let (pvec:&(Vector &Field) (make-param-vec param-arr num-p)
        tok:StrView (boxedfn-sig-token pvec num-p ret)
        key:Symbol (symbol-intern (fstr "BoxedFn." tok))
        hit:?&Type (boxedfn-memo-lookup key))
    (when hit (return hit))
    (let (nm:Symbol (symbol-intern (sanitize-for-ir (fstr "__boxedfn." tok)))
          sd:&StructDef (register-struct nm))
      (let (fnm:ptr (arena-alloc (* 2 (ptr-bytes)))
            fty:ptr (arena-alloc (* 2 (ptr-bytes))))
        (set! (aref (unsafe/cast &Symbol fnm) 0) (symbol-intern "data"))
        (set! (aref (unsafe/cast &Symbol fnm) 1) (symbol-intern "vtable"))
        (set! (aref (unsafe/cast &ptr fty) 0) (as ptr ty-ptr))
        (set! (aref (unsafe/cast &ptr fty) 1) (as ptr ty-ptr))
        (struct-set-fields sd fnm fty 2))
      (set! (sd 'src-file) g-source-path)
      (set! (sd 'src-line) 0)
      (queue-type-line sd)
      (let (t:&Type (type-for-sdef (as ptr sd)))
        ; Carry the Fn signature on the struct Type for invoke-forwarding / boxing.
        ; Reuse the `pvec` built above (immutable after build) as the param list.
        (set! (t 'ret) ret)
        (set! (t 'params) pvec)
        (set! (t 'num-params) num-p)
        (boxedfn-memo-put key (as ptr t))
        (return t)))))

; If `ty` is a BoxedFn instance type, return its canonical box Type* (carrying the
; Fn signature in ret/params/num-params); else null. Detection is by StructDef
; pointer identity against the memo, so a loaded box value and any re-derived
; spelling both resolve.
(defn boxedfn-canonical (ty:ptr):ptr
  (when (= ty null) (return null))
  (let (tt:&Type (unsafe/cast &Type ty))
    (when (!= (tt 'kind) TY-STRUCT) (return null))
    (let (sd:ptr (tt 'sdef))
      (when (= sd null) (return null))
      (dotimes (i (unsafe/cast i32 (count g-boxedfn-table)))
        (let (e:&BoxedFnEntry (invoke g-boxedfn-table i:usize))
          (when (= ((e 'ty) 'sdef) sd) (return (as ptr (e 'ty))))))
      (return null))))

; ============================================================
; Stage 13 type-erasure TE-6: general `(dyn Protocol)` instance types.
; ============================================================
; `(dyn P)` denotes the SAME shared fat pointer (TE-1) as a BoxedFn — a two-word
; {data:ptr, vtable:ptr} — but erases a value of an arbitrary *user protocol* `P`
; via NOMINAL `extend P` conformance instead of the structural closure→Fn match.
; Each distinct protocol gets its OWN {data,vtable} StructDef so type-eq (sdef
; pointer identity) keeps `(dyn Show)` and `(dyn Eq)` distinct, and so a loaded box
; resolves its protocol. The protocol NAME (the interned symbol string, matching
; the protocol registry's key) is carried in a parallel memo array — `(dyn P)`
; needs no signature on the Type (the method set comes from the Protocol record at
; vtable-build time, nucleusc.nuc). LAZY like boxedfn-type: the `%__dyn.<P> = type
; {…}` line is queued only when a `(dyn P)` is first parsed, so a dyn-free unit (the
; whole compiler) emits nothing → byte-identical bootstrap. Protocol validation is
; deferred to box construction (union-registry is imported before generics, so the
; protocol registry is not yet visible here); a parse only stores the name.
; §14.5 batch 3: the parallel keys/types/protos arrays collapsed into one
; `(Vector (ref DynEntry))`. Lazily constructed on first use (mirrors
; g-vtable-table/g-boxedfn-table) — never explicitly reset, so `&` not `?&`.
(defvar g-dyn-table:&(Vector &DynEntry) (vector-new-in &g-arena-alloc))

(defn dyn-memo-lookup (key:Symbol):?&Type
  (dotimes (i (unsafe/cast i32 (count g-dyn-table)))
    (let (e:&DynEntry (invoke g-dyn-table i:usize))
      (when (= (e 'key) key) (return (e 'ty)))))
  (return null))

(defn dyn-memo-put (key:Symbol ty:ptr proto:Symbol):void
  (let (rec:&DynEntry (new DynEntry))
    (set! (rec 'key) key)
    (set! (rec 'ty) (as ?&Type ty))
    (set! (rec 'proto) proto)
    (conj g-dyn-table rec)))

; The (memoised) `(dyn P)` instance Type for protocol name `proto`. On a miss it
; registers a fresh {data:ptr, vtable:ptr} StructDef named `%__dyn.<P>`, queues its
; IR on the shared pending-union list, builds the TY-STRUCT Type, and records the
; protocol name in the parallel memo. Mirrors boxedfn-type exactly (same layout, so
; the same CE-3 COERCE2 ABI), differing only in the carried datum (protocol name vs
; Fn signature).
(defn dyn-type (proto:Symbol line:i32):&Type
  ; Stage 15 W9 defect 21: memoize on the protocol's CANONICAL (namespaced)
  ; identity, not on the source spelling, so every legal spelling of one protocol
  ; produces the SAME box StructDef — otherwise `type-eq` (sdef pointer identity)
  ; makes two spellings of one protocol two incompatible types. The canonicaliser
  ; lives in nucleusc.nuc precisely so this file — imported before generics.nuc —
  ; can reach it; it is the identity for a name it cannot resolve, which keeps the
  ; deferred "protocol validation happens later" behaviour intact.
  ;
  ; Stage 15 B6: `dyn-proto-key` — the canonical name derived from the writing
  ; file's IMPORT ENVIRONMENT rather than from the protocol registry, so
  ; `(dyn Describe)` inside `(ns dp)` and `(dyn dpx/Describe)` outside it land on
  ; one key and therefore one StructDef. It consults no registry precisely so it
  ; answers identically during `prescan-defn-signatures` and at emission; see its
  ; header for why that is the load-bearing property. Admission — may THIS file
  ; name this protocol? — is a different question with different data, and is
  ; recorded here and asked by `drain-dyn-annots` once the whole graph is in.
  (dyn-annot-record proto line)
  (set! proto (dyn-proto-key proto))
  (let (key:Symbol (symbol-intern (fstr "dyn." proto))
        hit:?&Type (dyn-memo-lookup key))
    (when hit (return hit))
    (let (sd:&StructDef (register-struct
                             (symbol-intern (sanitize-for-ir (fstr "__dyn." proto)))))
      (let (fnm:ptr (arena-alloc (* (as i64 2) (ptr-bytes)))
            fty:ptr (arena-alloc (* (as i64 2) (ptr-bytes))))
        (set! (aref (unsafe/cast &Symbol fnm) 0) (symbol-intern "data"))
        (set! (aref (unsafe/cast &Symbol fnm) 1) (symbol-intern "vtable"))
        (set! (aref (unsafe/cast &ptr fty) 0) (as ptr ty-ptr))
        (set! (aref (unsafe/cast &ptr fty) 1) (as ptr ty-ptr))
        (struct-set-fields sd fnm fty 2))
      (set! (sd 'src-file) g-source-path)
      (set! (sd 'src-line) 0)
      (queue-type-line sd)
      (let (t:&Type (type-for-sdef (as ptr sd)))
        (dyn-memo-put key (as ptr t) proto)
        (return t)))))

; If `ty` is a `(dyn P)` instance type, return its canonical box Type*; else null.
; Detection is by StructDef pointer identity against the memo (a loaded box value
; and any re-derived spelling both resolve).
(defn dyn-canonical (ty:ptr):ptr
  (when (= ty null) (return null))
  (let (tt:&Type (unsafe/cast &Type ty))
    (when (!= (tt 'kind) TY-STRUCT) (return null))
    (let (sd:ptr (tt 'sdef))
      (when (= sd null) (return null))
      (dotimes (i (unsafe/cast i32 (count g-dyn-table)))
        (let (e:&DynEntry (invoke g-dyn-table i:usize))
          (when (= ((e 'ty) 'sdef) sd) (return (as ptr (e 'ty))))))
      (return null))))

; The protocol name carried by a `(dyn P)` box Type (the interned symbol string,
; usable directly as a `protocol-lookup` key), or null if `ty` is not a dyn box.
(defn dyn-proto-of (ty:ptr):Symbol
  (when (= ty null) (return (symbol-none)))
  (let (tt:&Type (unsafe/cast &Type ty))
    (when (!= (tt 'kind) TY-STRUCT) (return (symbol-none)))
    (let (sd:ptr (tt 'sdef))
      (when (= sd null) (return (symbol-none)))
      (dotimes (i (unsafe/cast i32 (count g-dyn-table)))
        (let (e:&DynEntry (invoke g-dyn-table i:usize))
          (when (= ((e 'ty) 'sdef) sd) (return (e 'proto)))))
      (return (symbol-none)))))

; ============================================================
; Stage 10: tagged sums — defunion (design/stage10/unions.md §3) and the
; parameterized-template layer (§5). A defunion is a struct
; {tag:i32, payload:(union ...)} plus an arm table consumed by match/make.
; ============================================================

(defn uniondef-lookup (name:Symbol):?&UnionDef
  (dotimes (i (unsafe/cast i32 (count g-uniondefs)))
    (let (ud:&UnionDef (as &UnionDef (invoke g-uniondefs i:usize)))
      (when (and (= (ud 'name) name)
                 (or (= g-priv-bindings 0) (!= (binding-visible (ud 'priv) (ud 'src-ns)) 0)))
        (return (as ptr ud)))))
  (return null))

(defn uniondef-lookup-ref (spelling:Symbol):?&UnionDef
  (if-some (a (env-arg-of spelling))
    (do
      (when (!= (a 'type) null) (return (uniondef-for-type (a 'type))))
      (let (here:NameEnv (name-env-here)
            nm:Symbol (env-arg-name-enter a &here))
        (when (symbol-none? nm) (return null))
        (let (r:?&UnionDef (uniondef-lookup-ref nm))
          (name-env-set here)
          (return r))))
    0)
  (dotimes (i (name-ref-key-count spelling))
    (match (name-ref-key-at spelling i)
      ((some k)
        (let (reach:Symbol (priv-reach-enter spelling)
              hit:?&UnionDef (uniondef-lookup k))
          (set! g-priv-reach-ns reach)
          (when (!= hit null) (return hit))))
      (none 0)))
  (let (al:ptr (binding-alias-find spelling BK-UNION))
    (when (!= al null) (return (unsafe/cast &UnionDef al))))
  (when (!= g-type-key-ok 0) (return (uniondef-lookup spelling)))
  (return null))

(defn union-template-lookup (name:Symbol):?&UnionTemplate
  (doseq (ut g-union-templates (VecIter &UnionTemplate))
         (when (and (= (ut 'name) name)
                    (or (= g-priv-bindings 0) (!= (binding-visible (ut 'priv) (ut 'src-ns)) 0)))
               (return ut)))
  (return null))

(defn union-template-lookup-ref (spelling:Symbol):?&UnionTemplate
  (if-some (a (env-arg-of spelling))
    (let (here:NameEnv (name-env-here)
          nm:Symbol (env-arg-name-enter a &here))
      (when (symbol-none? nm) (return null))
      (let (r:?&UnionTemplate (union-template-lookup-ref nm))
        (name-env-set here)
        (return r)))
    0)
  (dotimes (i (name-ref-key-count spelling))
    (match (name-ref-key-at spelling i)
      ((some k)
        (let (reach:Symbol (priv-reach-enter spelling)
              hit:?&UnionTemplate (union-template-lookup k))
          (set! g-priv-reach-ns reach)
          (when (!= hit null) (return hit))))
      (none 0)))
  (let (al:ptr (binding-alias-find spelling BK-UNION-TEMPLATE))
    (when (!= al null) (return (unsafe/cast &UnionTemplate al))))
  (when (!= g-type-key-ok 0) (return (union-template-lookup spelling)))
  (return null))

; Stage 11: look up a registered defstruct template by (interned) name. Mirror
; union-template-lookup. Names compare by pointer equality, so callers pass an
; interned head symbol (parametric-structs.md §1).
(defn struct-template-lookup (name:Symbol):?&StructTemplate
  (doseq (st g-struct-templates (VecIter &StructTemplate))
           (when (and (= (st 'name) name)
                      (or (= g-priv-bindings 0) (!= (binding-visible (st 'priv) (st 'src-ns)) 0)))
                 (return st)))
  (return null))

(defn struct-template-lookup-ref (spelling:Symbol):?&StructTemplate
  (if-some (a (env-arg-of spelling))
    (let (here:NameEnv (name-env-here)
          nm:Symbol (env-arg-name-enter a &here))
      (when (symbol-none? nm) (return null))
      (let (r:?&StructTemplate (struct-template-lookup-ref nm))
        (name-env-set here)
        (return r)))
    0)
  (dotimes (i (name-ref-key-count spelling))
    (match (name-ref-key-at spelling i)
      ((some k)
        (let (reach:Symbol (priv-reach-enter spelling)
              hit:?&StructTemplate (struct-template-lookup k))
          (set! g-priv-reach-ns reach)
          (when (!= hit null) (return hit))))
      (none 0)))
  (let (al:ptr (binding-alias-find spelling BK-STRUCT-TEMPLATE))
    (when (!= al null) (return (unsafe/cast &StructTemplate al))))
  (when (!= g-type-key-ok 0) (return (struct-template-lookup spelling)))
  (return null))

; Stage 16 type aliases (container-type-sugar.md §3.4). Mirror of
; struct-template-lookup / -lookup-ref: names compare by pointer equality, so
; callers pass an interned spelling.
(defn type-alias-lookup (name:Symbol):?&TypeAlias
  (doseq (ta g-type-aliases (VecIter &TypeAlias))
           (when (and (= (ta 'name) name)
                      (or (= g-priv-bindings 0) (!= (binding-visible (ta 'priv) (ta 'src-ns)) 0)))
                 (return ta)))
  (return null))

(defn type-alias-lookup-ref (spelling:Symbol):?&TypeAlias
  (if-some (a (env-arg-of spelling))
    (let (here:NameEnv (name-env-here)
          nm:Symbol (env-arg-name-enter a &here))
      (when (symbol-none? nm) (return null))
      (let (r:?&TypeAlias (type-alias-lookup-ref nm))
        (name-env-set here)
        (return r)))
    0)
  (dotimes (i (name-ref-key-count spelling))
    (match (name-ref-key-at spelling i)
      ((some k)
        (let (reach:Symbol (priv-reach-enter spelling)
              hit:?&TypeAlias (type-alias-lookup k))
          (set! g-priv-reach-ns reach)
          (when (!= hit null) (return hit))))
      (none 0)))
  (let (al:ptr (binding-alias-find spelling BK-TYPE-ALIAS))
    (when (!= al null) (return (unsafe/cast &TypeAlias al))))
  (when (!= g-type-key-ok 0) (return (type-alias-lookup spelling)))
  (return null))

; The UnionDef behind a type, or null: a defunion value is TY-STRUCT whose
; StructDef carries the udef back-pointer.
(defn uniondef-for-type (t:?&Type):?&UnionDef
  (when (= t null) (return null))
  (let (tt:?&Type t)
    (when (!= (tt 'kind) TY-STRUCT) (return null))
    (when (= (tt 'sdef) null) (return null))
    (return ((tt 'sdef) 'udef))))

; The UnionDef behind a Result-shaped value (a tagged sum carrying both an `ok`
; arm and an `err` arm), or null. The shared eliminator for `unwrap`/`unwrap-or`
; over `!T` (errors.md §9): `ok` is the success arm, `err` the failure arm.
(defn result-union-of (t:?&Type):?&UnionDef
  (let (ud:?&UnionDef (uniondef-for-type t))
    (when (= ud null) (return null))
    (when (< (union-arm-index (as ptr ud) (symbol-intern "ok")) 0) (return null))
    (when (< (union-arm-index (as ptr ud) (symbol-intern "err")) 0) (return null))
    (return ud)))

; The `ok` arm's payload type for a Result-shaped union type, or null.
(defn result-ok-type (t:?&Type):?&Type
  (let (ud:?&UnionDef (result-union-of t))
    (when (= ud null) (return null))
    (let (oi:i32 (union-arm-index (as ptr ud) (symbol-intern "ok")))
      (return ((invoke (ud 'arms) (as usize oi)) 'ptype)))))

; The UnionDef behind a value-`Maybe`, or null. Structural like
; `result-union-of`: a stamped instance is named `Maybe.<mangled-arg>`, so the
; arms are the only stable tell.
(defn value-maybe-union-of (t:?&Type):?&UnionDef
  (let (ud:?&UnionDef (uniondef-for-type t))
    (when (= ud null) (return null))
    (when (!= (ud 'num-arms) 2) (return null))
    (let (si:i32 (union-arm-index (as ptr ud) (symbol-intern "some"))
          ni:i32 (union-arm-index (as ptr ud) (symbol-intern "none")))
      (when (or (< si 0) (< ni 0)) (return null))
      (when (!= ((invoke (ud 'arms) (as usize si)) 'nfields) 1) (return null))
      (when (!= ((invoke (ud 'arms) (as usize ni)) 'nfields) 0) (return null))
      (return ud))))

; An arm is never a global, so a template's full name in an arm position means the
; arm its file wrote (ambient-namespaces.md, "AN-4 as built").
(defn arm-spelling (name:Symbol):Symbol
  (when (= (qualifier-len name) 0) (return name))
  (let (r:&NameRef (resolve-spelling name))
    (if (= (r 'status) NR-QUALIFIED) (r 'bare) name)))

(defn union-arm-index (ud:?&UnionDef name:Symbol):i32
  (set! name (arm-spelling name))
  (let (udd:ptr:UnionDef ud)
    (dotimes (i (udd 'num-arms))
      (let (arm:&Arm (invoke (udd 'arms) i:usize))
        (when (= (arm 'name) name)
          (return i))))
    (return -1)))

; Byte offset of the payload union inside the backing struct: the i32 tag,
; aligned up to the payload's alignment. Computed on demand — member layouts
; may involve structs whose fields are registered after the defunion form.
(defn union-payload-off (ud:?&UnionDef):i32
  (let (udd:ptr:UnionDef ud)
    (when (= (udd 'union-sd) null) (return 0))
    (return (abi-align-up 4 (abi-struct-align (udd 'union-sd))))))

; True iff arm `i` carries exactly one field whose type is a *typed* (ref T)
; pointer — TY-PTR with elem present and non-void. The "typed" guard is the
; void* exemption (design/stage10/cleanup-prompt.md "byte-identity guard"): a
; niche over a typeless pointer buys no safety and would needlessly churn the
; reader's elem-less !ptr, so an elem-less payload stays TAGGED.
(defn arm-is-typed-ref (arm:&Arm):i32
  (when (!= (arm 'nfields) 1) (return 0))
  (let (pty:?&Type (arm 'ptype))
    (when (= pty null) (return 0))
    (when (!= (pty 'kind) TY-PTR) (return 0))
    (let (el:?&Type (pty 'elem))
      (when (= el null) (return 0))
      (when (= (el 'kind) TY-VOID) (return 0))
      (return 1))))

; True iff arm `i` carries exactly one field of type Err (TY-ERR) — the err
; side of a niche-ERRPTR (errors.md §8: Err is a distinct i32-repr scalar so
; rule-3 detection can key on it).
(defn arm-is-err-field (arm:&Arm):i32
  (when (!= (arm 'nfields) 1) (return 0))
  (let (pty:?&Type (arm 'ptype))
    (when (= pty null) (return 0))
    (return (if (= (pty 'kind) TY-ERR) 1 0))))

; The layout engine (design/stage10/unions.md §6) — the U4/A2 convergence step.
; Given a fully-built arm table and the parsed :repr mode, decide the layout in
; rule order. `:repr tagged` forces rule 4; `:repr niche` requires a niche.
; The two niche rules need a *typed* (ref T) ok payload (arm-is-typed-ref) — the
; void* exemption keeps the reader's elem-less !ptr TAGGED and the bootstrap
; byte-identical. Returns LAYOUT-* ; on a niche, *niche-elem-out (a &ptr) is
; set to the (ref T) payload's element Type so codegen can recover T.
(defn union-layout-classify (arms:&(Vector &Arm)
                                 narms:i32 repr:i32 niche-elem-out:ptr line:i32):i32
  (set! (aref (unsafe/cast &ptr niche-elem-out) 0) null)
  (when (= repr REPR-TAGGED) (return LAYOUT-TAGGED))
  ; Rule 1: every arm payload-less → just the i32 tag (≅ defenum).
  (let (all-payloadless:i32 1)
    (dotimes (i narms)
      (when (!= ((invoke arms i:usize) 'nfields) 0) (set! all-payloadless 0)))
    (when (!= all-payloadless 0)
      (when (= repr REPR-NICHE)
        (die-at line ":repr niche: an all-payload-less union is an enum, not a niche"))
      (return LAYOUT-ENUM)))
  ; Rules 2 & 3 are two-arm shapes (order-independent in the arms).
  (when (= narms 2)
    (let (arm0:&Arm (invoke arms 0)
          arm1:&Arm (invoke arms 1)
          none0:i32 (if (= (arm0 'nfields) 0) 1 0)
          none1:i32 (if (= (arm1 'nfields) 0) 1 0)
          ref0:i32 (arm-is-typed-ref arm0)
          ref1:i32 (arm-is-typed-ref arm1)
          err0:i32 (arm-is-err-field arm0)
          err1:i32 (arm-is-err-field arm1))
      ; Rule 2: one payload-less arm, one single typed (ref T) field.
      (when (or (and (!= none0 0) (!= ref1 0))
                (and (!= ref0 0) (!= none1 0)))
        (let (ri-arm:&Arm (if (!= ref0 0) arm0 arm1))
          (set! (aref (unsafe/cast &ptr niche-elem-out) 0) ((ri-arm 'ptype) 'elem))
          (return LAYOUT-NICHE-MAYBE)))
      ; Rule 3: one single typed (ref T) field, one single Err field.
      (when (or (and (!= ref0 0) (!= err1 0))
                (and (!= err0 0) (!= ref1 0)))
        (let (ri-arm:&Arm (if (!= ref0 0) arm0 arm1))
          (set! (aref (unsafe/cast &ptr niche-elem-out) 0) ((ri-arm 'ptype) 'elem))
          (return LAYOUT-NICHE-ERRPTR)))))
  ; Rule 4: the §3 tagged struct.
  (when (= repr REPR-NICHE)
    (die-at line ":repr niche: arms are not nicheable (need 2 arms: a typed (ref T) and a payload-less or Err arm)"))
  (return LAYOUT-TAGGED))

; Register a tagged sum under `name` from its arm forms (a Node chain of
; `(arm field:type ...)` / bare `arm` entries). Memoized by name — template
; instances and .nuch re-imports reuse the first registration. Emits the
; backing struct's IR type; the payload union's own definition is deferred
; (drain-pending-union-irs) because member layouts may not be final yet.
; Strip a trailing `:repr <mode>` marker (unions.md §6, §9) out of a defunion
; arm chain: `:repr` is a non-arm token (like :where/:rest elsewhere), followed
; by its mode (`tagged` or `niche`). Returns the filtered arm chain (the :repr
; pair removed) and writes the parsed REPR-* mode to *repr-out. With no marker,
; returns the chain unchanged and REPR-AUTO.
(defn defunion-strip-repr (arms:ptr repr-out:ptr line:i32):ptr
  (set! (aref (unsafe/cast &i32 repr-out) 0) REPR-AUTO)
  (let (b:&Node (node-list-new line)
        scur:ptr arms)
    (while (> (node-len scur) 0)
      ; W5f: an empty list `()` among the arms names no arm; diagnose it here
      ; rather than read a name off it below.
      (when (node-empty? (node-first (unsafe/cast &Node scur)))
        (die-at line "defunion: arm cannot be the empty list '()' -- write `name` or `(name field:type ...)`"))
      (let (a:&Node (unsafe/cast &Node (node-first (unsafe/cast &Node scur))))
        ; An arm chain is not desugared — its own chokepoint for the retired
        ; `&repr` spelling, which would otherwise register as a payload-less arm.
        (reject-legacy-marker a line)
        (if (!= (marker-named a "repr") 0)
          (let (mcell:ptr (node-rest (unsafe/cast &Node scur)))
            ; A missing mode, or an empty-list `()` mode (a NULL node), are the
            ; same user error; neither may reach the NODE-SYM check below.
            (when (or (= mcell null) (node-empty? (node-first (unsafe/cast &Node mcell))))
              (die-at line "defunion: :repr needs a mode (tagged or niche)"))
            (let (m:&Node (unsafe/cast &Node (node-first (unsafe/cast &Node mcell))))
              (when (!= (m 'kind) NODE-SYM)
                (die-at (m 'line) "defunion: :repr mode must be a symbol"))
              (if (= (m 's) "tagged")
                (set! (aref (unsafe/cast &i32 repr-out) 0) REPR-TAGGED)
                (if (= (m 's) "niche")
                  (set! (aref (unsafe/cast &i32 repr-out) 0) REPR-NICHE)
                  (die-at (node-line (as ptr m) line) "defunion: :repr mode must be `tagged` or `niche`"))))
            (set! scur mcell))   ; advance past the mode; the rest step skips it
          (node-push b a)))
      (set! scur (node-rest (unsafe/cast &Node scur))))
    (return (as ptr (node-list-done b)))))

(defn require-defunion-arm (arm:&Node line:i32):void
  (when (= (node-kind (as ptr arm)) NODE-SYM) (return))
  (when (or (!= (node-kind (as ptr arm)) NODE-LIST) (= (node-len arm) 0))
    (die-at (node-line (as ptr arm) line) "defunion: arm must be `name` or `(name field:type ...)`"))
  (when (!= (node-kind (as ptr (node-first arm))) NODE-SYM)
    (die-at (node-line (as ptr (node-first arm)) line) "defunion: arm name must be a symbol")))

(defn defunion-register (name:Symbol arms-raw:ptr line:i32):&UnionDef
  (let (existing:?&UnionDef (uniondef-lookup name))
    (when (!= existing null) (return existing)))
  (when (>= (unsafe/cast i32 (count g-uniondefs)) MAX-UNIONS)
    (die-at line "too many defunions"))
  (let (repr-box:i32 REPR-AUTO
        arms:ptr (defunion-strip-repr arms-raw (as &i32 &repr-box) line)
        repr:i32 repr-box
        narms:i32 (node-len arms)
        cur:ptr arms)
    (when (= narms 0)
      (die-at line "defunion: at least one arm required"))
    (when (> narms MAX-UNION-ARMS)
      (die-at line "defunion: too many arms"))
    (let (arms-vec:&(Vector &Arm) (vector-new-in &g-arena-alloc))
      (set! cur arms)
      (while (> (node-len cur) 0)
        (let (arm:&Node (unsafe/cast &Node (node-first (unsafe/cast &Node cur)))
              aname:Symbol (symbol-none)
              fnames:ptr null
              ftypes:ptr null
              nf:i32 0)
          (require-defunion-arm arm line)
          (if (= (arm 'kind) NODE-SYM)
            (set! aname (arm-spelling (arm 's)))
            (do
              (let (an:&Node (unsafe/cast &Node (node-at (as ptr arm) 0)))
                (set! aname (arm-spelling (an 's))))
              (set! nf (- (node-len (as ptr arm)) 1))
              (when (> nf 0)
                (set! fnames (arena-alloc (* (as i64 nf) (ptr-bytes))))
                (set! ftypes (arena-alloc (* (as i64 nf) (ptr-bytes))))
                (let (fi:i32 0
                      kept:i32 0)
                  (while (< fi nf)
                    (let (field:ptr (node-at (as ptr arm) (+ fi 1))
                          fname:Symbol (symbol-none)
                          fty:ptr (extract-name-and-type field (as &Symbol &fname)
                                                          (node-line field line)))
                      (when (= fty null)
                        (die-at (node-line field line)
                          (fstr "defunion: field '" fname "' missing :type")))
                      ; A `void` field carries no value, so it contributes none:
                      ; this is what makes `!void` — (Result void Err) — stamp an
                      ; `ok` arm that is payload-less rather than zero-width.
                      ; design/stage17-native-strings/overview.md phase A1.
                      (when (!= ((unsafe/cast &Type fty) 'kind) TY-VOID)
                        (set! (aref (unsafe/cast &Symbol fnames) kept) fname)
                        (set! (aref (unsafe/cast &ptr ftypes) kept) fty)
                        (inc! kept)))
                    (inc! fi))
                  (set! nf kept)
                  (when (= nf 0)
                    (set! fnames null)
                    (set! ftypes null))))))
          (when (>= (union-arm-index-in aname arms-vec) 0)
            (die-at (node-line (as ptr arm) line) (fstr "defunion: duplicate arm '" aname "'")))
          ; Arm payload: nothing (payload-less), the single field's type, or a
          ; memoized anonymous struct of the fields.
          (let (rec:&Arm (new Arm)
                pty:?&Type (if (= nf 0)
                               null
                               (if (= nf 1)
                                 (as ?&Type (aref (unsafe/cast &ptr ftypes) 0))
                                 (as &Type
                                   (type-for-sdef (lookup-or-make-anon-struct fnames ftypes null null nf 0 0))))))
            (set! (rec 'name) aname)
            (set! (rec 'ptype) pty)
            (set! (rec 'fnames) fnames)
            (set! (rec 'ftypes) ftypes)
            (set! (rec 'nfields) nf)
            (conj arms-vec rec)))
        (set! cur (node-rest (unsafe/cast &Node cur))))
      ; Classify the layout (unions.md §6 — the U4/A2 convergence). The arm
      ; table is now complete; the engine applies rules 1–4 in order, honoring
      ; :repr. Stage 1 records the decision on the UnionDef; the niche layouts
      ; (rules 2/3) are produced by the Type-returning callers (rule 2/3 codegen).
      (let (niche-elem-box:ptr null
            layout:i32 (union-layout-classify arms-vec
                          narms repr (as &ptr &niche-elem-box) line))
      ; The payload union: one member per payload-bearing arm, named by the arm.
      (let (npay:i32 0
            i:i32 0)
        (while (< i narms)
          (when (!= ((invoke arms-vec (as usize i)) 'ptype) null) (inc! npay))
          (inc! i))
        ; A niche layout (rules 2/3) lowers to a bare pointer with no backing
        ; struct or payload union — skip building the anon payload union (which
        ; would otherwise be emitted by drain-pending-union-irs).
        (let (is-niche:i32 (if (or (= layout LAYOUT-NICHE-MAYBE)
                                   (= layout LAYOUT-NICHE-ERRPTR)) 1 0)
              union-sd:ptr null)
          (when (and (> npay 0) (= is-niche 0))
            (let (mnames:ptr (arena-alloc (* (as i64 npay) (ptr-bytes)))
                  mtypes:ptr (arena-alloc (* (as i64 npay) (ptr-bytes)))
                  mi:i32 0)
              (set! i 0)
              (while (< i narms)
                (let (arm-rec:&Arm (invoke arms-vec i:usize))
                  (when (!= (arm-rec 'ptype) null)
                    (set! (aref (unsafe/cast &Symbol mnames) mi) (arm-rec 'name))
                    (set! (aref (unsafe/cast &ptr mtypes) mi) (arm-rec 'ptype))
                    (inc! mi)))
                (inc! i))
              (set! union-sd (as ptr (lookup-or-make-anon-union mnames mtypes null null npay 0 0)))))
          ; Backing struct: {tag:i32 [, payload:(union ...)]}.
          (let (sd:&StructDef (if-some (e (lookup-struct name)) e (register-struct name)))
            (check-ir-name-legal line name (symbol-as-view (sd 'ir-name)))
            (when (!= (sd 'emitted) 0)
              (die-at line (fstr "defunion: '" name "' already names a struct")))
            (let (bnf:i32 (if (!= union-sd null) 2 1)
                  bfn:ptr (arena-alloc (* 2 (ptr-bytes)))
                  bft:ptr (arena-alloc (* 2 (ptr-bytes))))
              (set! (aref (unsafe/cast &Symbol bfn) 0) (symbol-intern "tag"))
              (set! (aref (unsafe/cast &ptr bft) 0) ty-i32)
              (when (!= union-sd null)
                (set! (aref (unsafe/cast &Symbol bfn) 1) (symbol-intern "payload"))
                (set! (aref (unsafe/cast &ptr bft) 1) (type-for-sdef union-sd)))
              (struct-set-fields sd bfn bft bnf)
              (set! (sd 'src-file) g-source-path)
              (set! (sd 'src-line) line)
              ; Header-emit modes (--emit-nuch/--emit-cheader) prescan defn
              ; signatures, which can stamp template instances with no IR
              ; streams open — registration without emission is fine there.
              ; A niche layout (rules 2/3) lowers to a bare pointer and never
              ; references this backing struct, so its IR type is not emitted
              ; (the §3 struct that would defeat the whole point of the niche).
              ;
              ; Stage 15 W1a: the backing struct's line names the anon payload
              ; union, which is on the DEFERRED queue — so writing it here is only
              ; safe while that union will land in the very next drain (every
              ; module assembly is preceded by one). When the union's own named
              ; dependency is still unemitted — a struct payload such as
              ; `!String`, whose `%String` arrives with a later import — the union
              ; stays queued across an unbounded number of module assemblies, and
              ; each of them (a `compile-time` block, a `defmacro` JIT module)
              ; would carry `%X = type { i32, %anon }` with `%anon` undefined:
              ;   (compile-time …) (import-use nucleus.string) (defn f (…):!String …)
              ; reproduces it on the pre-W1a compiler. Queue the backing struct in
              ; that case so the shared drain writes it after the union, in
              ; dependency order. `is-union` is 0 here, so the queue emits it via
              ; emit-pending-struct-ir-type, whose text is identical to the
              ; fprintf below. The condition is exactly "would dangle", so every
              ; scalar/pointer payload (`!i32`, `!ptr`, `!ptr:Node` — all the
              ; compiler's own) keeps the eager write and its IR position.
              (if (and (!= g-module-open 0)
                       (!= layout LAYOUT-NICHE-MAYBE) (!= layout LAYOUT-NICHE-ERRPTR)
                       (!= union-sd null)
                       (= (sdef-in-module (as ?&StructDef union-sd)) 0)
                       (= (pending-union-deps-ready union-sd) 0))
                (queue-type-line sd)
                (do
                  (when (and (!= g-module-open 0)
                             (!= layout LAYOUT-NICHE-MAYBE) (!= layout LAYOUT-NICHE-ERRPTR))
                    (if (!= union-sd null)
                      (emit g-type-stream "%" (sd 'ir-name) " = type { i32, %"
                            ((unsafe/cast &StructDef union-sd) 'ir-name) " }\n\n")
                      (emit g-type-stream "%" (sd 'ir-name) " = type { i32 }\n\n")))
                  (sdef-note-emitted sd &g-type-stream))))
            (let (ud:&UnionDef (new UnionDef))
              (conj g-uniondefs ud)
              (set! (ud 'ctors-emitted) 0)
              (set! (ud 'name) name)
              (set! (ud 'sdef) sd)
              (set! (ud 'union-sd) union-sd)
              (set! (ud 'num-arms) narms)
              (set! (ud 'arms) arms-vec)
              (set! (ud 'layout) layout)
              (set! (ud 'niche-elem) niche-elem-box)
              (set! (ud 'src-line) line)
              ; Stage 15 B4 (R4): the file half of the redefinition blame.
              (set! (ud 'src-file) g-source-path)
              ; Stage 15 B5: `defunion-`'s privacy, mirrored onto the backing
              ; StructDef because `g-structs` is the registry a type REFERENCE
              ; actually probes (the union name and its backing struct share one
              ; key), so a filter that only knew about UnionDef would never fire.
              (set! (ud 'priv) g-defining-private)
              (set! (ud 'src-ns) g-current-ns)
              (when (!= g-defining-private 0)
                (set! (sd 'priv) 1)
                (set! (sd 'src-ns) g-current-ns)
                (set! g-priv-bindings 1))
              (set! (sd 'udef) ud)
              (return ud)))))))))

; Arm-name duplicate probe over the partially-built arm Vector (registration
; helper) — scans the arms conj'd so far.
(defn union-arm-index-in (name:Symbol arms:&(Vector &Arm)):i32
  (dotimes (i (unsafe/cast i32 (count arms)))
    (when (= ((invoke arms i:usize) 'name) name)
      (return i)))
  (return -1))

; Register `(defunion (Name T ...) arms...)` as a template. Defines no type;
; uses stamp instances via union-template-stamp.
(defn register-union-template (form:ptr):void
  (let (ff:&Node (unsafe/cast &Node form)
        head:&Node (unsafe/cast &Node (node-at form 1))
        name-node:&Node (unsafe/cast &Node (node-at (as ptr head) 0)))
    ; W9 item 45: `node-kind` — see register-struct-template below.
    (when (!= (node-kind (as ptr name-node)) NODE-SYM)
      (die-at (node-line (as ptr head) (ff 'line)) "defunion: template name must be a symbol"))
    ; Stage 15 B3′: `name` is the SOURCE spelling (diagnostics, `guard-name-kind`);
    ; `key` is the canonical registry key the template is stored and stamped under,
    ; so a stamped instance inherits the template's namespace rather than the
    ; stamping site's. Identity under `user`.
    (let (name:Symbol (name-node 's)
          key:Symbol (qualify-name (name-node 's))
          ntv:i32 (- (node-len (as ptr head)) 1))
      (when (< ntv 1)
        (die-at (node-line (as ptr head) (ff 'line)) "defunion: template needs at least one type parameter"))
      ; W4b sibling sweep: a single parameter that is itself a CELL (not a
      ; bare tyvar symbol) can only be the colon-paren-fused shape
      ; ("U:(i32)" -> (U (i32))) — a genuine template's extra parameters are
      ; always bare symbols (T, K, V, ...). Give the annotation-specific
      ; message here rather than falling into the generic, misleading "type
      ; parameter must be a symbol" below.
      (when (and (= ntv 1)
                 (= (node-kind (node-at (as ptr head) 1)) NODE-LIST))
        (die-at (node-line (as ptr head) (ff 'line))
          (fstr "defunion: takes no type annotation; write (defunion " name " ...)")))
      ; Stage 16: a template's arms are only parsed when it is stamped, so a
      ; never-instantiated template accepted `:repr bogus`, a mode-less `:repr`
      ; and the retired `&repr` in silence (keyword-markers.md §7). None of that
      ; needs a stamp — run the real stripper for its diagnostics and drop the
      ; filtered chain; a validate-only copy is the shape that drifts.
      (let (repr-box:i32 REPR-AUTO
            checked:ptr (defunion-strip-repr
                          (-> ff (node-rest _) (unsafe/cast &Node _) (node-rest _))
                          (as &i32 &repr-box) (ff 'line)))
        0)
      ; Re-import of the same template (e.g. via .nuch) is a no-op. Stage 15 B4
      ; (R4): a hit from a DIFFERENT defining site is a second definition.
      (if-some (prevt (union-template-lookup key))
        (do
          (when (!= (same-definition-site (prevt 'src-file) (prevt 'src-line) (ff 'line)) 0)
            ; An earlier pass may have registered it before the file's imports were read.
            (when (= (prevt 'src-imports) null) (set! (prevt 'src-imports) g-file-imports))
            (return))
          (die-redefinition name (ff 'line) BK-UNION-TEMPLATE
                            (prevt 'src-file) (prevt 'src-line)))
        0)
      (guard-name-kind name (ff 'line) NK-TYPE)
      (when (>= (unsafe/cast i32 (count g-union-templates)) MAX-UNION-TEMPLATES)
        (die-at (ff 'line) "too many defunion templates"))
      (let (tyvars:ptr (arena-alloc (* ntv (ptr-bytes))))
        (dotimes (i ntv)
          (let (tv:&Node (unsafe/cast &Node (node-at (as ptr head) (+ i 1))))
            (when (!= (node-kind (as ptr tv)) NODE-SYM)
              (die-at (node-line (as ptr tv) (ff 'line)) "defunion: type parameter must be a symbol"))
            (set! (aref (unsafe/cast &Symbol tyvars) i) (tv 's))))
        (let (ut:&UnionTemplate (unsafe/cast &UnionTemplate (arena-alloc (sizeof UnionTemplate))))
          (conj g-union-templates ut)
          (set! (ut 'name) key)
          (set! (ut 'tyvars) tyvars)
          (set! (ut 'ntv) ntv)
          (set! (ut 'form) form)
          ; Stage 15 B5: `defunion-`'s privacy. The caller (prescan-struct-names
          ; / emit-defunion) arms g-defining-private for the private spelling.
          (set! (ut 'priv) g-defining-private)
          (set! (ut 'src-ns) g-current-ns)
          ; Stage 15 B4 (R4): the defining site — see `same-definition-site`.
          (set! (ut 'src-file) g-source-path)
          (set! (ut 'src-line) (ff 'line))
          (set! (ut 'src-imports) g-file-imports)
          (when (!= g-defining-private 0) (set! g-priv-bindings 1)))))))

; Stage 11: register `(defstruct (Name T ...) field-specs...)` as a template.
; Exact analogue of register-union-template — defines no type, emits no IR; a
; use `(Name A B)` in type position stamps a concrete instance via
; struct-template-stamp-types. Re-import (idempotent prescan, .nuch) is a no-op.
; A name list with no parameters — `(Foo)` — is an error (parametric-structs.md
; §2): use a plain `defstruct`.
(defn register-struct-template (form:ptr):void
  (let (ff:&Node (unsafe/cast &Node form)
        head:&Node (unsafe/cast &Node (node-at form 1))
        name-node:&Node (unsafe/cast &Node (node-at (as ptr head) 0)))
    ; W9 item 45: `node-kind`, so a head spelled `(())` reaches this message
    ; instead of dereferencing the NULL node `()` reads as.
    (when (!= (node-kind (as ptr name-node)) NODE-SYM)
      (die-at (node-line (as ptr head) (ff 'line)) "defstruct: template name must be a symbol"))
    (let (name:Symbol (name-node 's)
          key:Symbol (qualify-name (name-node 's))
          ntv:i32 (- (node-len (as ptr head)) 1))
      (when (< ntv 1)
        (die-at (node-line (as ptr head) (ff 'line)) "defstruct: template needs at least one type parameter — use a plain defstruct"))
      ; W4b sibling sweep: a single parameter that is itself a CELL (not a
      ; bare tyvar symbol) can only be the colon-paren-fused shape
      ; ("S:(i32)" -> (S (i32))) — a genuine template's extra parameters are
      ; always bare symbols (T, K, V, ...). Give the annotation-specific
      ; message here rather than falling into the generic, misleading "type
      ; parameter must be a symbol" below.
      (when (and (= ntv 1)
                 (= (node-kind (node-at (as ptr head) 1)) NODE-LIST))
        (die-at (node-line (as ptr head) (ff 'line))
          (fstr "defstruct: takes no type annotation; write (defstruct " name " ...)")))
      ; Re-import of the same template (e.g. via .nuch, or the idempotent prescan
      ; pass) is a no-op. Stage 15 B4 (R4): a hit from a DIFFERENT defining site
      ; is a second template of the name, which used to be the same silent no-op.
      (if-some (prevt (struct-template-lookup key))
        (do
          (when (!= (same-definition-site (prevt 'src-file) (prevt 'src-line) (ff 'line)) 0)
            (when (= (prevt 'src-imports) null) (set! (prevt 'src-imports) g-file-imports))
            (return))
          (die-redefinition name (ff 'line) BK-STRUCT-TEMPLATE
                            (prevt 'src-file) (prevt 'src-line)))
        0)
      (guard-name-kind name (ff 'line) NK-TYPE)
      (when (>= (unsafe/cast i32 (count g-struct-templates)) MAX-STRUCT-TEMPLATES)
        (die-at (ff 'line) "too many defstruct templates"))
      (let (tyvars:ptr (arena-alloc (* ntv (ptr-bytes))))
        (dotimes (i ntv)
          (let (tv:&Node (unsafe/cast &Node (node-at (as ptr head) (+ i 1))))
            (when (!= (node-kind (as ptr tv)) NODE-SYM)
              (die-at (node-line (as ptr tv) (ff 'line)) "defstruct: type parameter must be a symbol"))
            (set! (aref (unsafe/cast &Symbol tyvars) i) (tv 's))))
        (let (st:&StructTemplate (unsafe/cast &StructTemplate (arena-alloc (sizeof StructTemplate))))
          (conj g-struct-templates st)
          (set! (st 'name) key)
          (set! (st 'tyvars) tyvars)
          (set! (st 'ntv) ntv)
          (set! (st 'form) form)
          ; Stage 15 B5: `defstruct-`'s privacy for the parametric spelling.
          (set! (st 'priv) g-defining-private)
          (set! (st 'src-ns) g-current-ns)
          ; Stage 15 B4 (R4): the defining site — see `same-definition-site`.
          (set! (st 'src-file) g-source-path)
          (set! (st 'src-line) (ff 'line))
          (set! (st 'src-imports) g-file-imports)
          (when (!= g-defining-private 0) (set! g-priv-bindings 1)))))))

; What `name` already names as a TYPE, as a noun for a diagnostic, or null.
;
; `guard-name-kind` cannot answer this: it skips every row reporting the kind
; being defined, and struct / template / enum / alias all report NK-TYPE, so a
; type-over-type collision is by construction invisible to it. The codebase
; leaves that gap open generally (`(defenum Pt …)` over a struct is accepted
; today), but an alias cannot afford it — `parse-type-name` probes aliases LAST,
; so a colliding alias is not merely ambiguous, it is dead on arrival and
; silently so. Scoped to `deftype` rather than fixing the general gap here.
(defn type-name-collision (name:Symbol):StrView
  (when (!= (builtin-type-name name) null) (return "a built-in type"))
  (when (!= (as ptr (struct-lookup-ref name)) null) (return "a type"))
  (when (!= (as ptr (struct-template-lookup-ref name)) null) (return "a struct template"))
  (when (!= (as ptr (union-template-lookup-ref name)) null) (return "a union template"))
  (when (!= (as ptr (enumdef-lookup-ref name)) null) (return "an enumeration"))
  ; Stage 16 L5: since a C typedef resolves in `parse-type-name`, an alias over
  ; one is dead on arrival in exactly the way this check exists to prevent.
  (if-some (td (c-typedef-find name))
    (return (fstr "a C typedef imported from " (td 'file)))
    0)
  (return ""))

; §3.7: replace each of a parametric alias's parameters in `node` with the
; corresponding argument NODE. Node substitution, not StructTemplate's spelling
; substitution, because in a method receiver pattern an argument may still be a
; free tyvar with no Type to spell.
(defn subst-alias-args (node:?&Node tyvars:ptr args:ptr ntv:i32 line:i32):?&Node
  (when (= node null) (return null))
  (let (n:?&Node node)
    (when (= (n 'kind) NODE-LIST)
      (return (node-cons (subst-alias-args (node-first n) tyvars args ntv line)
                (subst-alias-args (node-rest n) tyvars args ntv line) (n 'line))))
    (when (!= (n 'kind) NODE-SYM) (return node))
    (let (idx:i32 (tyvar-index-of (n 's) tyvars ntv))
      (when (>= idx 0)
        (return (as ?&Node (aref (unsafe/cast &ptr args) idx)))))
    ; A colon spelling in the body (`ref:T`) substitutes segment-wise, so the
    ; argument has to be one token — a segment has nowhere to put a paren form.
    (when (symbol-contains-byte (n 's) 58)
      (let (segs:ptr (split-colon-segments (n 's) line)
            acc:StrView ""
            hit:i32 0)
        (dotimes (i (node-len segs))
          (let (seg:Symbol ((unsafe/cast &Node (node-at segs i)) 's)
                si:i32 (tyvar-index-of seg tyvars ntv)
                piece:Symbol seg)
            (when (>= si 0)
              (do (set! hit 1)
                  (let (a:ptr (aref (unsafe/cast &ptr args) si))
                    (when (!= (node-kind a) NODE-SYM)
                      (die-at line (fstr "deftype: parameter '" seg
                                         "' is spelled in a colon chain, so its argument must be a single token — write the alias body in list form")))
                    (set! piece ((unsafe/cast &Node a) 's)))))
            (if (str-empty? &acc) (set! acc (symbol-as-view piece))
              (set! acc (fstr acc ":" piece)))))
        (when (and (!= hit 0) (not (str-empty? &acc)))
          (let (new:&Node (as &Node (alloc-node)))
            (set! (new 'kind) NODE-SYM)
            (set! (new 'line) (n 'line))
            (set! (new 's) (symbol-intern acc))
            (return (as ?&Node (as ptr new)))))))
    (return node)))

; §3.7: the substituted body of a parametric alias application `(Name Arg…)`, or
; null when `node` is not one. Callers guard the recursion with
; `g-type-alias-depth`, exactly as the plain-alias path in parse-type-name does.
(defn type-alias-apply (node:?&Node line:i32):?&Node
  (if-some (ta (type-alias-app-of node))
    (return (type-alias-subst ta (alias-own-body ta line) node line false))
    0)
  (return null))

; A pattern walker reads a foreign alias's body in the caller's file, so each name
; there that means something else here goes in as a marker read back in the alias's.
(defn alias-own-body (ta:&TypeAlias line:i32):?&Node
  (when (not (alias-foreign? ta)) (return (ta 'body)))
  (let (prev:StrView (foreign-read-context (ta 'src-file) "type alias" (ta 'name) line)
        body:?&Node (alias-mark-node ta (ta 'body)))
    (set! g-mono-context prev)
    (return body)))

; Rebuilt only where a name changed, so an alias whose names read alike stays shared.
(defn alias-mark-node (ta:&TypeAlias n:ptr:Node):ptr:Node
  (case (node-kind n)
    NODE-SYM (return (alias-mark-sym ta n 0))
    NODE-LIST
      (do
        (when (= (node-inline-aggregate n) 0) (return (alias-mark-list ta n 0)))
        ; A member's own name is not a type: `a:T` from its second segment, `(a T)` from its second element.
        (let (out:&Node (node-list-new (n 'line))
              changed:bool false)
          (dotimes (i (node-len (as ptr n)))
            (let (e:?&Node (as ?&Node (node-at (as ptr n) i))
                  m:?&Node e)
              (when (> i 0)
                (case (node-kind e)
                  NODE-SYM (set! m (alias-mark-sym ta e 1))
                  NODE-LIST (set! m (alias-mark-list ta e 1))
                  0))
              (when (!= m e) (set! changed true))
              (node-push out (as ptr m))))
          (return (if changed (as &Node (node-list-done out)) n))))
    (return n)))

(defn alias-mark-list (ta:&TypeAlias n:ptr:Node from:i32):ptr:Node
  (let (out:&Node (node-list-new (n 'line))
        changed:bool false)
    (dotimes (i (node-len (as ptr n)))
      (let (e:?&Node (as ?&Node (node-at (as ptr n) i))
            m:?&Node (if (< i from) e (alias-mark-node ta e)))
        (when (!= m e) (set! changed true))
        (node-push out (as ptr m))))
    (return (if changed (as &Node (node-list-done out)) n))))

; Segment-wise, so a colon chain or sigil keeps its spelling: `ref:Pt` → `ref:#env-arg-N`.
(defn alias-mark-sym (ta:&TypeAlias n:ptr:Node skip:i32):ptr:Node
  (let (s:Symbol (n 's)
        segs:ptr (if (symbol-contains-byte s 58) (split-colon-segments s (n 'line)) (as ptr (node-list1 (as ptr n) (n 'line))))
        acc:StrView ""
        changed:bool false)
    (dotimes (i (node-len segs))
      (let (seg:Symbol ((unsafe/cast &Node (node-at segs i)) 's)
            piece:Symbol seg)
        (when (>= i skip)
          (let (run:usize (type-sigil-run seg)
                sv:StrView (symbol-as-view seg)
                name:Symbol (symbol-intern (strview-drop-bytes sv run))
                own:Symbol (alias-own-name ta name))
            (when (!= own name)
              (set! changed true)
              (set! piece (symbol-intern (fstr (strview-take-bytes sv run) own))))))
        (set! acc (if (= i 0) (symbol-as-view piece) (fstr acc ":" piece)))))
    (when (not changed) (return n))
    (return (intern-node (symbol-intern acc)))))

; `name` as the alias's file reads it: itself where it means the same definition here.
(defn alias-own-name (ta:&TypeAlias name:Symbol):Symbol
  (when (or (= (symbol-len name) 0)
            (>= (tyvar-index-of name (ta 'tyvars) (ta 'ntv)) 0)
            (!= (as ptr (builtin-type-name name)) null))
    (return name))
  (let (mine:ptr (type-name-def name)
        saved:NameEnv (name-env-enter (ta 'src-ns) (ta 'src-file) (ta 'src-imports))
        theirs:ptr (type-name-def name))
    (when (or (= theirs null) (= theirs mine))
      (name-env-set saved)
      (return name))
    (let (m:Symbol (env-arg-sym (as ptr (intern-node name)) (ta 'src-line)))
      (name-env-set saved)
      (return m))))

; The definition a type name reads as in the current file, or null.
(defn type-name-def (name:Symbol):ptr
  (let (p:ptr (as ptr (struct-lookup-ref name)))
    (when (!= p null) (return p))
    (set! p (as ptr (struct-template-lookup-ref name)))
    (when (!= p null) (return p))
    (set! p (as ptr (union-template-lookup-ref name)))
    (when (!= p null) (return p))
    (set! p (as ptr (enumdef-lookup-ref name)))
    (when (!= p null) (return p))
    (return (as ptr (type-alias-lookup-ref name)))))

; The parametric alias `node` applies, or null when it is not an application of one.
(defn type-alias-app-of (node:?&Node):?&TypeAlias
  (when (!= (node-kind node) NODE-LIST) (return null))
  (let (head:ptr:Node (node-first node))
    (when (!= (node-kind head) NODE-SYM) (return null))
    (if-some (ta (type-alias-lookup-ref (head 's)))
      (when (!= (ta 'ntv) 0) (return ta))
      0)
    (return null)))

; `mark`: the body is another file's text, so each argument goes in as a marker
; the parser reads back in this file (`env-arg-sym`).
(defn type-alias-subst (ta:&TypeAlias body:?&Node n:?&Node line:i32 mark:bool):?&Node
  (let (nargs:i32 (- (node-len (as ptr n)) 1))
    (when (!= nargs (ta 'ntv))
      (die-at line
        (fstr (ta 'name) ": wrong number of type arguments for type alias (" nargs
              " given)")))
    (let (args:ptr (arena-alloc (* nargs (ptr-bytes))))
      (dotimes (i nargs)
        (let (a:ptr (node-at (as ptr n) (+ i 1)))
          ; An integer argument (an extent) names nothing, so it needs no marker.
          (set! (aref (unsafe/cast &ptr args) i)
                (if (and mark (!= (node-kind a) NODE-INT))
                  (as ptr (intern-node (env-arg-sym a line)))
                  a))))
      (return (subst-alias-args body (ta 'tyvars) args nargs line)))))

(defn alias-foreign? (ta:&TypeAlias):bool
  (return (and (not (symbol-none? (ta 'src-file))) (!= (ta 'src-file) g-source-path))))

; An alias body is its file's text: another file's is read there, blamed at its own line.
(defn alias-body-type (ta:&TypeAlias body:ptr line:i32):&Type
  (when (not (alias-foreign? ta)) (return (parse-type-from-node body line)))
  (let (array-ok:i32 g-array-ok
        ctx:StrView (foreign-read-context (ta 'src-file) "type alias" (ta 'name) line)
        here:NameEnv (name-env-enter (ta 'src-ns) (ta 'src-file) (ta 'src-imports)))
    (set! g-array-ok array-ok)
    (let (t:&Type (parse-type-from-node body (ta 'src-line)))
      (name-env-set here)
      (set! g-mono-context ctx)
      (return t))))

; The marker for type node `a`, read back in this file at `line`.
(defn env-arg-sym (a:ptr line:i32):Symbol
  (let (rec:&EnvArg (new EnvArg))
    (set! (rec 'node) (as ?&Node a))
    (set! (rec 'env) (name-env-here))
    (set! (rec 'line) line)
    (set! (rec 'ctx) g-mono-context)
    (set! (rec 'type) null)
    (return (env-arg-push rec))))

; The marker for a type already resolved. A stamp substitutes one where the type's
; spelling would be refused in the template's file (`stamp-key-spelling`).
(defn env-arg-of-type (t:&Type):Symbol
  (let (rec:&EnvArg (new EnvArg))
    (set! (rec 'node) null)
    (set! (rec 'env) (name-env-here))
    (set! (rec 'ctx) g-mono-context)
    (set! (rec 'type) t)
    (return (env-arg-push rec))))

(defn env-arg-push (rec:&EnvArg):Symbol
  (conj g-env-args rec)
  (let (idx:i32 (- (unsafe/cast i32 (count g-env-args)) 1))
    (return (symbol-intern (fstr "#env-arg-" idx)))))

; The record behind marker `name`, or null for any other symbol; `#` is unspellable.
(defn env-arg-of (name:Symbol):?&EnvArg
  (when (!= (symbol-byte-at name 0) 35) (return null))
  (let (sv:StrView (symbol-as-view name))
    (when (not (strview-has-prefix sv "#env-arg-")) (return null))
    (let (idx:usize 0
          i:usize 9)
      (while (< i (sv 'len))
        (set! idx (+ (* idx 10) (as usize (- (as i32 (aref (sv 'data) (as i64 i))) 48))))
        (set! i (+ i 1)))
      (return (invoke g-env-args idx)))))

; A marker is parsed as its writer spelled it, in its writer's file.
(defn env-arg-type (name:Symbol array-ok:i32):?&Type
  (if-some (a (env-arg-of name))
    (do
      (when (!= (a 'type) null) (return (a 'type)))
      (let (here:NameEnv (name-env-here)
            ctx:StrView g-mono-context)
        (name-env-set (a 'env))
        (set! g-mono-context (a 'ctx))
        (set! g-array-ok array-ok)
        (let (t:&Type (parse-type-from-node (as ptr (a 'node)) (a 'line)))
          (name-env-set here)
          (set! g-mono-context ctx)
          (return t))))
    (return null)))

; The name a node marker stands for, entered in its writer's environment; the
; caller looks it up and restores the returned environment. None for a type marker.
(defn env-arg-name-enter (a:&EnvArg out-here:&NameEnv):Symbol
  (when (!= (node-kind (a 'node)) NODE-SYM) (return (symbol-none)))
  (set! (aref out-here 0) (name-env-here))
  (name-env-set (a 'env))
  (return ((a 'node) 's)))

; Stage 16: register `(deftype Name Type)` / `(deftype- Name Type)`
; (container-type-sugar.md §3.4). Defines no type and emits no IR — a use of
; `Name` in type position re-parses `Type` through parse-type-name, so the alias
; never reaches type identity, mangling or dispatch (§3.2). The body is retained
; unparsed, which is what makes declaration order inside a file irrelevant.
;
; Called twice for each form: once from the prescan (is-priv 0, so signatures
; below it resolve) and once from the emit pass, which is the only point at which
; `g-defining-private` is armed — hence the same-site update rather than the
; early return `register-struct-template` can afford.
(defn register-type-alias (form:ptr is-priv:i32):void
  (let (ff:&Node (unsafe/cast &Node form))
    (when (!= (node-len form) 3)
      (die-at (ff 'line) "deftype: expects a name and one type — (deftype Name Type)"))
    (let (spec:ptr (node-at form 1)
          tyvars:ptr null
          ntv:i32 0)
      ; §3.7: `(deftype (Table V) …)` — the parameter list is spelled exactly as
      ; a struct template's, so the two definers read alike at a glance.
      (when (= (node-kind spec) NODE-LIST)
        (do (set! ntv (- (node-len spec) 1))
            (when (<= ntv 0)
              (die-at (ff 'line) "deftype: parameter list required — (deftype (Name T ...) Type)"))
            (set! tyvars (arena-alloc (* ntv (ptr-bytes))))
            (dotimes (i ntv)
              (let (tv:ptr (node-at spec (+ i 1)))
                (when (!= (node-kind tv) NODE-SYM)
                  (die-at (ff 'line) "deftype: each type parameter must be a symbol"))
                (set! (aref (unsafe/cast &Symbol tyvars) i) ((unsafe/cast &Node tv) 's))))
            (set! spec (node-at spec 0))))
      ; W9 item 45: `node-kind`, so a name spelled `()` reaches this message
      ; rather than dereferencing the NULL node it reads as.
      (when (!= (node-kind spec) NODE-SYM)
        (die-at (ff 'line) "deftype: alias name must be a symbol"))
      (reject-colon-in-def-name (as ?&Node spec) "deftype" (ff 'line))
      (let (name-node:&Node (unsafe/cast &Node spec)
            name:Symbol ((unsafe/cast &Node spec) 's)
            key:Symbol (qualify-name ((unsafe/cast &Node spec) 's))
            body:ptr (node-at form 2))
        (when (= body null)
          (die-at (ff 'line) "deftype: type expression required — (deftype Name Type)"))
        ; Deliberately ahead of the same-site early return, so it runs on BOTH
        ; calls: the prescan pass catches a type name defined ABOVE the alias,
        ; the emit pass one defined BELOW it (by then the whole unit is
        ; registered). One check, both directions, no other definer touched.
        (let (clash:StrView (type-name-collision name))
          (when (not (str-empty? &clash))
            (die-at (ff 'line)
              (fstr "deftype: '" name "' already names " clash
                    " — an alias of an existing type name would never resolve"))))
        (if-some (prev (type-alias-lookup key))
          (do
            (when (!= (same-definition-site (prev 'src-file) (prev 'src-line) (ff 'line)) 0)
              (do (set! (prev 'priv) is-priv)
                  (when (= (prev 'src-imports) null) (set! (prev 'src-imports) g-file-imports))
                  (when (!= is-priv 0)
                    (do (set! (prev 'src-ns) g-current-ns)
                        (set! g-priv-bindings 1)))
                  (return)))
            (die-redefinition name (ff 'line) BK-TYPE-ALIAS
                              (prev 'src-file) (prev 'src-line)))
          0)
        (guard-name-kind name (ff 'line) NK-TYPE)
        (when (>= (unsafe/cast i32 (count g-type-aliases)) MAX-TYPE-ALIASES)
          (die-at (ff 'line) "too many type aliases"))
        (let (ta:&TypeAlias (unsafe/cast &TypeAlias (arena-alloc (sizeof TypeAlias))))
          (conj g-type-aliases ta)
          (set! (ta 'name) key)
          (set! (ta 'body) (as ?&Node body))
          (set! (ta 'tyvars) tyvars)
          (set! (ta 'ntv) ntv)
          (set! (ta 'priv) is-priv)
          (set! (ta 'src-ns) g-current-ns)
          ; Stage 15 B4 (R4): the defining site — see `same-definition-site`.
          (set! (ta 'src-file) g-source-path)
          (set! (ta 'src-line) (ff 'line))
          (set! (ta 'src-imports) g-file-imports)
          (when (!= is-priv 0) (set! g-priv-bindings 1)))))))

; The Type a defunion instance resolves to. For a niche layout (unions.md §6
; rules 2/3) this is a bare pointer carrying the niche pkind and elem=T — the
; same TY-PTR the parser's `(Maybe (ref T))` / `!T` fast paths yield, so a
; `(defunion (Maybe2 T) (some v:(ref T)) none)` stamp and `(Maybe (ref T))`
; produce identical bits. For LAYOUT-TAGGED/ENUM it is the backing struct type.
; pkind is invisible to type-eq/mangle, so this never perturbs other types.
(defn union-instance-type (ud:?&UnionDef):&Type
  (let (udd:ptr:UnionDef ud
        lay:i32 (udd 'layout))
    (case lay
      LAYOUT-NICHE-MAYBE
        (let (pt:&Type (make-type TY-PTR))
          (set! (pt 'elem) (udd 'niche-elem))
          (set! (pt 'pkind) PTR-MAYBE)
          (return pt))
      LAYOUT-NICHE-ERRPTR
        (let (pt:&Type (make-type TY-PTR))
          (set! (pt 'elem) (udd 'niche-elem))
          (set! (pt 'pkind) PTR-ERRPTR)
          (return pt))
      (return (type-for-sdef (udd 'sdef))))))

(defn name-env-here ():NameEnv
  (return (NameEnv g-current-ns g-source-path g-file-imports)))

(defn name-env-set (e:NameEnv):void
  (set! g-current-ns (e 'ns))
  (set! g-source-path (e 'path))
  (set! g-file-imports (e 'imports)))

; Read a definition's own text as the file that wrote it; returns what to restore.
; A definition that recorded no namespace (compiler-minted) keeps the current file's.
(defn name-env-enter (ns:Symbol path:Symbol imports:?&ImportVec):NameEnv
  (let (saved:NameEnv (name-env-here))
    (when (not (symbol-none? ns))
      (set! g-current-ns ns)
      (when (not (symbol-none? path)) (set! g-source-path path))
      (set! g-file-imports imports))
    (return saved)))

; A substituted `type-spelling` is a registry KEY read in the template's file, where
; bare `Pt` would mean that file's own; `user/` makes `resolve-spelling` answer the key.
(defn spelling-as-key (s:Symbol):Symbol
  (when (or (= g-ns-declared 0) (symbol-contains-byte s 40)) (return s))
  (let (sv:StrView (symbol-as-view s)
        acc:String (string-new)
        start:usize 0
        i:usize 0
        slen:usize (symbol-len s))
    (while (<= i slen)
      (when (or (= i slen) (= (as i32 (aref (sv 'data) (as i64 i))) 58))
        (let (seg:Symbol (symbol-intern (strview-take-bytes (strview-drop-bytes sv start) (- i start)))
              keep:bool (or (!= (builtin-type-name seg) null) (!= (pointer-kind-named seg) 0)))
          (if-some (ft (fnty-resolve seg)) (set! keep true) 0)
          (when (> start 0) (str-into &acc ":"))
          (when (not keep) (str-into &acc "user/"))
          (str-into &acc (symbol-as-view seg)))
        (set! start (+ i 1)))
      (set! i (+ i 1)))
    (return (symbol-intern (string-as-view &acc)))))

; Name the use that asked for a stamp of another file's template, for errors raised
; while reading that file's text. Returns the context to restore.
(defn template-stamp-context (tfile:Symbol iname:Symbol line:i32):StrView
  (let (prev:StrView g-mono-context)
    (when (and (not (symbol-none? tfile)) (!= tfile g-source-path))
      (set! g-mono-context (fstr "while stamping " iname " (requested at " g-source-path ":" line ")")))
    (return prev)))

; Name the use that read another file's definition, for errors raised in its text.
; Returns the context to restore.
(defn foreign-read-context (dfile:Symbol kind:StrView name:Symbol line:i32):StrView
  (let (prev:StrView g-mono-context)
    (when (and (not (symbol-none? dfile)) (!= dfile g-source-path))
      (set! g-mono-context (fstr "while reading " kind " '" name "' (requested at "
                                 g-source-path ":" line ")")))
    (return prev)))

; The spellings a stamp substitutes for a template's type parameters.
(defn stamp-key-spellings (argts:ptr nargs:i32):ptr
  (let (out:ptr (arena-alloc (* (if (> nargs 0) nargs 1) (ptr-bytes))))
    (dotimes (i nargs)
      (set! (aref (unsafe/cast &Symbol out) i) (stamp-key-spelling (aref (unsafe/cast &&Type argts) i))))
    (return out)))

; A private type's key is refused in the template's file, so it goes in as itself:
; the caller already resolved it, and visibility governs spelling, not identity.
(defn stamp-key-spelling (t:&Type):Symbol
  (when (type-names-private? t) (return (env-arg-of-type t)))
  (return (spelling-as-key (type-spelling t))))

(defn type-names-private? (t:?&Type):bool
  (when (or (= t null) (= g-priv-bindings 0)) (return false))
  (case (t 'kind)
    TY-PTR (return (type-names-private? (t 'elem)))
    (:or TY-STRUCT TY-UNION)
      (let (sd:?&StructDef (t 'sdef))
        (when (= sd null) (return false))
        (when (!= (sd 'priv) 0) (return true))
        (let (ud:?&UnionDef (sd 'udef))
          (return (and (!= ud null) (!= (ud 'priv) 0)))))
    (return false)))

; Stamp (and memoize) a concrete instance of a defunion template from a type
; use `(Name A B)`. The instance is an ordinary defunion named
; `Name.<tok>.<tok>` (type-mangle-token per argument, the generic-fn scheme);
; construction is via `make` / return-position target typing — no per-instance
; constructor functions are stamped, so cross-unit stamping cannot collide.
(defn union-template-stamp (ut:?&UnionTemplate use-node:ptr line:i32):&Type
  (let (utt:?&UnionTemplate ut
        nargs:i32 (- (node-len use-node) 1)
        argts:ptr (arena-alloc (* (if (> nargs 0) nargs 1) (ptr-bytes))))
    (dotimes (i nargs)
      (set! (aref (unsafe/cast &ptr argts) i) (parse-type-from-node (node-at use-node (+ i 1)) line)))
    (return (union-template-stamp-types ut argts nargs line))))

; Stamp a template instance from already-parsed argument Type*s. Shared by the
; node-driven `(Result A B)` path and the `!T` sugar (which has Type* operands,
; not nodes). Memoized by the mangled instance name.
(defn union-template-stamp-types (ut:?&UnionTemplate argts:ptr nargs:i32 line:i32):&Type
; Stage 15 B3′: a template stamp is a SYNTHESIS region — every type spelling parsed inside it
; was written by the compiler (a `type-spelling` of a bound tyvar, a `Self`
; substitution), not by any file, so the type reference resolvers take an exact-key
; fallback here. See `g-type-key-ok` (src/nucleusc.nuc) for why this is a scoped
; permission rather than a global relaxation.
  (let (saved:i32 g-type-key-ok)
    (set! g-type-key-ok 1)
    (let (t:&Type (union-template-stamp-types-in ut argts nargs line))
      (set! g-type-key-ok saved)
      (return t))))

(defn union-template-stamp-types-in (ut:?&UnionTemplate argts:ptr nargs:i32 line:i32):&Type
  (let (utt:ptr:UnionTemplate ut)
    (when (!= nargs (utt 'ntv))
      (die-at line
        (fstr (utt 'name) ": wrong number of type arguments for defunion template")))
    (when (> g-dry-parse-ntv 0) (return (dry-parse-type)))
    (let (iname:Symbol (utt 'name))
      (dotimes (i nargs)
        (set! iname (symbol-intern (fstr iname "." (type-mangle-token (aref (unsafe/cast &ptr argts) i))))))
      (if-some (ud (uniondef-lookup iname))
        (return (union-instance-type ud))
        (let (arms:ptr (-> (unsafe/cast &Node (utt 'form)) (node-rest _) (unsafe/cast &Node _) (node-rest _))
              arms-subst:ptr (subst-tyvars-node arms (utt 'tyvars) (stamp-key-spellings argts nargs)
                                                (utt 'ntv))
              ctx:StrView (template-stamp-context (utt 'src-file) iname line)
              here:NameEnv (name-env-enter (utt 'src-ns) (utt 'src-file) (utt 'src-imports))
              ud2:&UnionDef (defunion-register iname arms-subst line)
              ; Copied, as struct-template-stamp-types-in does: the caller's
              ; `argts` may be reused.
              origin-args:ptr (arena-alloc (* (if (> nargs 0) nargs 1) (ptr-bytes))))
          (name-env-set here)
          (set! g-mono-context ctx)
          ; The instance itself belongs where it was asked for, as a struct stamp does.
          (let (usd:&StructDef (ud2 'sdef))
            (set! (usd 'src-file) g-source-path)
            (set! (usd 'src-ns) g-current-ns)
            (set! (ud2 'src-file) g-source-path)
            (set! (ud2 'src-ns) g-current-ns))
          (dotimes (oi nargs)
            (set! (aref (unsafe/cast &ptr origin-args) oi) (aref (unsafe/cast &ptr argts) oi)))
          (set! (ud2 'origin-template) ut)
          (set! (ud2 'origin-args) origin-args)
          (set! (ud2 'origin-nargs) nargs)
          (tmpl-conformance-check-union (as ptr ut) ud2 line)
          (return (union-instance-type ud2)))))))

; Stage 11: stamp (and memoize) a concrete instance of a defstruct template
; (parametric-structs.md §3). Exact analogue of union-template-stamp-types:
;   1. Mangled instance name `Vector.i32` (type-mangle-token per arg), interned
;      so the lookup-struct memoization is a pointer-identity hit.
;   2. Memoize via lookup-struct — a hit returns the existing type-for-sdef.
;   3. On a miss, register-struct the mangled name FIRST (so a pointer
;      self-reference `(ptr (Tree T))` resolving to (Tree i32) finds the
;      in-progress StructDef and terminates), then subst-tyvars-node the
;      field-spec list, parse each concrete field type, fill the StructDef, and
;      QUEUE its `%name = type {…}` line on the shared deferred-IR queue (drained
;      at module-assembly boundaries, exactly like unions). The result IS an
;      ordinary monomorphic TY-STRUCT — no new layout/ABI code.
(defn struct-template-stamp-types (st:?&StructTemplate argts:ptr nargs:i32 line:i32):&Type
  (let (saved:i32 g-type-key-ok)
    (set! g-type-key-ok 1)
    (let (t:&Type (struct-template-stamp-types-in st argts nargs line))
      (set! g-type-key-ok saved)
      (return t))))

(defn struct-template-stamp-types-in (st:?&StructTemplate argts:ptr nargs:i32 line:i32):&Type
  (let (stt:ptr:StructTemplate st)
    (when (!= nargs (stt 'ntv))
      (die-at line
        (fstr (stt 'name) ": wrong number of type arguments for defstruct template")))
    (when (> g-dry-parse-ntv 0) (return (dry-parse-type)))
    (let (spellings:ptr (arena-alloc (* nargs (ptr-bytes)))
          iname:Symbol (stt 'name))
      (dotimes (i nargs)
        (let (at:ptr (aref (unsafe/cast &ptr argts) i))
          (set! (aref (unsafe/cast &Symbol spellings) i) (type-spelling at))
          (set! iname (symbol-intern (fstr iname "." (type-mangle-token at))))))
      ; Memoized hit: the instance was already stamped (or is mid-stamp for a
      ; recursive self-reference) — return its Type without re-emitting.
      (let (existing:?&StructDef (lookup-struct iname))
        (when (!= existing null)
          (return (type-for-sdef existing))))
      ; Miss: reserve the name before filling fields so a pointer self-reference
      ; (Tree T → (ptr (Tree i32))) resolves to this in-progress StructDef.
      (let (sd:&StructDef (register-struct iname)
            ; The template form's field specs are everything after the (Name T...)
            ; head: (defstruct (Name T..) f0 f1 ...) → cdr-cdr.
            fields-tmpl:ptr (-> (unsafe/cast &Node (stt 'form)) (node-rest _) (unsafe/cast &Node _) (node-rest _))
            fields:ptr (subst-tyvars-node fields-tmpl (stt 'tyvars) (stamp-key-spellings argts nargs)
                                          (stt 'ntv))
            nfields:i32 (node-len fields)
            cur:ptr fields)
        ; Record the stamping origin (T2): the method unifier recovers
        ; (template, args) from a concrete instance to bind a pattern `(Vector T)`
        ; against a concrete `Vector.i32`. Copy the arg Type*s into a stable arena
        ; array, since the caller's `argts` may be reused.
        (let (origin-args:ptr (arena-alloc (* (if (> nargs 0) nargs 1) (ptr-bytes))))
          (dotimes (oi nargs)
            (set! (aref (unsafe/cast &ptr origin-args) oi) (aref (unsafe/cast &ptr argts) oi)))
          (set! (sd 'origin-template) st)
          (set! (sd 'origin-args) origin-args)
          (set! (sd 'origin-nargs) nargs))
        (let (fnm:ptr (arena-alloc (* nfields (ptr-bytes)))
              ftp:ptr (arena-alloc (* nfields (ptr-bytes))))
          (set! (sd 'src-file) g-source-path)
          (set! (sd 'src-line) line)
          (let (fi:i32 0
                ctx:StrView (template-stamp-context (stt 'src-file) iname line)
                here:NameEnv (name-env-enter (stt 'src-ns) (stt 'src-file) (stt 'src-imports)))
            (set! cur fields)
            (while (> (node-len cur) 0)
              (let (field:ptr (node-first (unsafe/cast &Node cur))
                    fname:Symbol (symbol-none)
                    fty:ptr (extract-name-and-type field (as &Symbol &fname)
                                                   ((unsafe/cast &Node field) 'line)))
                (when (= fty null)
                  (die-at ((unsafe/cast &Node field) 'line)
                    (fstr "defstruct template " (stt 'name) ": field '" fname "' missing :type")))
                (set! (aref (unsafe/cast &Symbol fnm) fi) fname)
                (set! (aref (unsafe/cast &ptr ftp) fi) fty))
              (inc! fi)
              (set! cur (node-rest (unsafe/cast &Node cur))))
            (name-env-set here)
            (set! g-mono-context ctx))
          (struct-set-fields sd fnm ftp nfields))
        ; Queue the `%name = type {…}` IR on the shared deferred queue. emit-pending
        ; -struct-ir-type writes the plain struct line at drain time, and
        ; `sdef-in-module` guards double-emit. Deferring (rather than emitting
        ; inline) keeps a mid-function stamp from interleaving into a def-stream
        ; body, the same discipline unions use.
        (queue-type-line sd)
        ; Stage 11 T4: per-instance protocol conformance check. For each template
        ; conformance recorded via `(extend (Vector T) (Seq T))`, substitute this
        ; instance's concrete args into the protocol bindings and confirm every
        ; required method resolves for the instance — erroring (naming the method)
        ; if not, and recording the concrete `(Vector.i32, Seq)` conformance so a
        ; Seq-bounded generic call finds it. Done after the StructDef is fully
        ; built so a required method that mentions the instance resolves.
        ; Stage 12 N8: the checker (tmpl-conformance-check-instance) now lives in
        ; the later-imported generics.nuc, so we dispatch through g-tmpl-conf-check-
        ; hook, installed right after `(import-use generics)`. The hook is non-null
        ; before any user struct template is stamped; a null hook (no parametric
        ; protocols loaded yet) means there is nothing to check.
        (when (!= g-tmpl-conf-check-hook null)
          (funcall (unsafe/cast ((fn void) (ptr Symbol ptr i32 i32)) g-tmpl-conf-check-hook)
                   st iname spellings nargs line))
        (return (type-for-sdef sd))))))

; Node-driven entry: stamp `(Name A B)` from a use node (mirrors
; union-template-stamp). Parses each type argument, then delegates.
(defn struct-template-stamp (st:?&StructTemplate use-node:ptr line:i32):&Type
  (let (stt:?&StructTemplate st
        nargs:i32 (- (node-len use-node) 1)
        argts:ptr (arena-alloc (* (as i64 (if (> nargs 0) nargs 1)) (ptr-bytes))))
    (dotimes (i nargs)
      (set! (aref (unsafe/cast &ptr argts) i) (parse-type-from-node (node-at use-node (+ i 1)) line)))
    (return (struct-template-stamp-types st argts nargs line))))

; ============================================================
; Stage 14 AT-1 — declaration attribute slot (design/stage14/attributes.md)
; ============================================================
; A declaration attribute is a leading keyword literal (`:volatile`) qualifying
; the declaration that follows it — never part of type identity, dispatch, or
; name mangling (§2). The cond below is the attribute registry: one clause per
; known attribute (add a row to introduce one), an explicit reserved-with-error
; row for `:thread-local`, and a catch-all that rejects unknown keywords so a
; typo (`:volatle`) can never silently no-op.
;
; Stage 16 PK-2: the leading `:keyword` attributes of a `defstruct` form, in the
; position `defvar`'s `:volatile` occupies. Returns how many there were,
; with their flags through `out-flags`. Positional rather than parse-decl-attrs'
; cursor walk because defstruct reads its parts by index. `strict` 0 only counts:
; the name prescan needs the count to find the name and must not diagnose, since
; a prescan defers every diagnostic to the emitter.
(defn struct-attr-scan (form:?&Node out-flags:&i32 out-align:&i32
                        strict:i32 line:i32):i32
  (let (cc:&Node (unsafe/cast &Node form)
        n:i32 (node-len (as ptr form))
        i:i32 1
        flags:i32 0
        align:i32 0
        done:i32 0)
    (while (and (= done 0) (< i n))
      (let (nd:ptr (node-at cc i))
        (if (!= (node-kind nd) NODE-KEYWORD)
          (set! done 1)
          (do
            (let (nm:Symbol ((unsafe/cast &Node nd) 's))
              (cond
                (= nm "packed")
                  (set! flags (bit-or flags STRUCT-ATTR-PACKED))
                ; PK-3: the one attribute that takes an argument, so it consumes
                ; the operand after it — `(defstruct :align 16 P …)`, keeping the
                ; flat shape `:packed` set rather than growing a nested list form.
                (= nm "align")
                  (let (av:ptr (if (< (+ i 1) n) (node-at cc (+ i 1)) null))
                    (if (or (= av null) (!= (node-kind av) NODE-INT))
                      (when (!= strict 0)
                        (die-at line "':align' takes an integer: (defstruct :align 16 Name …)"))
                      (do
                        (set! align (unsafe/cast i32 ((unsafe/cast &Node av) 'i)))
                        (when (and (!= strict 0) (= (align-attr-valid align) 0))
                          (die-at line
                            (fstr "':align " align "' must be a power of two between 1 and 4096")))
                        (set! i (+ i 1)))))
                true
                  (when (!= strict 0)
                    (die-at line
                      (fstr "unknown defstruct attribute ':" nm "' (known: :packed, :align)")))))
            (set! i (+ i 1))))))
    (set! (aref out-flags 0) flags)
    (set! (aref out-align 0) align)
    (return (- i 1))))

; parse-decl-attrs scans zero-or-more leading NODE-KEYWORD operands from a
; declaration operand list (`cursor` is a cons cell, or null), OR's each
; recognized attribute's flag bit into *out-flags (a DECL-ATTR-* bitset), and
; returns the list cursor advanced to the first non-attribute operand (the
; declared name / element type). Every declaration site funnels its attribute
; validation through here: def-forms (the keyword is a leading operand),
; struct/union fields and defn params (the keyword heads the field/param cell,
; reached via extract-name-and-type), let/with bindings (the keyword is wrapped
; onto its binding name by attrs-normalize-bindings, then reaches here through
; extract-name-and-type), and pointer target types `(ptr :volatile T)`.
(defn parse-decl-attrs (cursor:ptr out-flags:ptr line:i32):ptr
  (let (flags:i32 0
        cur:ptr cursor)
    (while (and (> (node-len cur) 0)
                (!= (node-first (unsafe/cast &Node cur)) null)
                (= (-> cur (unsafe/cast &Node _) (node-first _) (unsafe/cast &Node _) (_ 'kind))
                   NODE-KEYWORD))
      (let (kw:&Node (unsafe/cast &Node (node-first (unsafe/cast &Node cur)))
            nm:Symbol (kw 's))
        (cond
          (= nm "volatile")
            (set! flags (bit-or flags DECL-ATTR-VOLATILE))
          (= nm "const")
            (set! flags (bit-or flags DECL-ATTR-CONST))
          (= nm "thread-local")
            (die-at line "thread-local storage requires the threading stage -- see design/stage14/attributes.md §5")
          true
            (die-at line (fstr "unknown declaration attribute ':" nm
                               "' (known attributes: :volatile, :const, :thread-local)"))))
      (set! cur (node-rest (unsafe/cast &Node cur))))
    (set! (aref (unsafe/cast &i32 out-flags) 0) flags)
    (return cur)))

; A field, param, binding or pointer target has no storage class to select, so
; `:const` there is refused rather than ignored.
(defn reject-decl-attr-const (flags:i32 line:i32 where:StrView):void
  (when (!= (bit-and flags DECL-ATTR-CONST) 0)
    (die-at line (fstr "':const' applies only to an extern, not " where
                       " -- a read-only global is a defconst"))))

; AT-1: normalize a let/with binding list so a prefix attribute keyword becomes a
; wrapped binding-name cell `(:kw... name)`, restoring strict (name value) pairs.
;   (:volatile x:i32 0  y:i32 1) -> ((:volatile x:i32) 0  y:i32 1)
; The wrapped cell then funnels through extract-name-and-type's attribute branch
; (the single validation chokepoint), exactly like a `(:volatile field:type)`
; struct field. Returns `binds` unchanged — no allocation — when the list holds
; no attribute keyword at a name position, so an attribute-free binding list is
; byte-identical. The fast-path scan only inspects even indices (name positions
; in a well-formed attribute-free list); a keyword used as a binding *value* sits
; at an odd index and is left alone.
(defn attrs-normalize-bindings (binds:ptr line:i32):ptr
  (when (= binds null) (return binds))
  (let (has-attr:i32 0
        idx:i32 0
        scan:ptr binds)
    (while (> (node-len scan) 0)
      (when (and (= (% idx 2) 0)
                 (!= (node-first (unsafe/cast &Node scan)) null)
                 (= (-> scan (unsafe/cast &Node _) (node-first _) (unsafe/cast &Node _) (_ 'kind))
                    NODE-KEYWORD))
        (set! has-attr 1))
      (set! scan (node-rest (unsafe/cast &Node scan)))
      (inc! idx))
    (when (= has-attr 0) (return binds)))
  (let (out:&Node (node-list-new line)
        cur:ptr binds)
    (while (> (node-len cur) 0)
      ; Collect this binding's leading attribute keywords into (:kw...) list.
      (let (kw:&Node (node-list-new line)
            any-kw:i32 0)
        (while (and (> (node-len cur) 0)
                    (!= (node-first (unsafe/cast &Node cur)) null)
                    (= (-> cur (unsafe/cast &Node _) (node-first _) (unsafe/cast &Node _) (_ 'kind))
                       NODE-KEYWORD))
          (node-push kw (node-first (unsafe/cast &Node cur)))
          (set! any-kw 1)
          (set! cur (node-rest (unsafe/cast &Node cur))))
        (when (= cur null)
          (die-at line "declaration attribute must be followed by a binding name"))
        (let (name-node:ptr (node-first (unsafe/cast &Node cur))
              wrapped:ptr name-node)
          (when (!= any-kw 0)
            (node-push kw name-node)
            (set! wrapped (as ptr (node-list-done kw))))
          (node-push out wrapped)
          (set! cur (node-rest (unsafe/cast &Node cur)))
          ; The value element (verbatim). A missing value is reported downstream
          ; by the even-count check on the normalized list.
          (when (!= cur null)
            (node-push out (node-first (unsafe/cast &Node cur)))
            (set! cur (node-rest (unsafe/cast &Node cur)))))))
    (return (as ptr (node-list-done out)))))

; Parse a type from an AST node. Handles:
;   - symbol node: delegates to parse-type-name
;   - list node (ptr T) or (ptr ptr ... T): builds TY-PTR
;   - list node ((fn ret-type) (param-types...)) or (fn ret-type): builds TY-FN
; A list whose head is a type constructor parse-type-from-node reads — the
; test that tells an unnamed `(Vector i32)` from a `(name type)` cell.
(defn type-form-list? (n:?&Node):bool
  (when (or (= n null) (!= (node-kind (as ptr n)) NODE-LIST)) (return false))
  (let (h:?&Node (node-first n))
    (when (or (= h null) (!= (h 'kind) NODE-SYM)) (return false))
    (let (hp:ptr (as ptr h)
          hs:Symbol (h 's)
          hv:StrView (symbol-as-view hs)
          c0:i32 (if (> (hv 'len) 0) (as i32 (aref (hv 'data) 0)) 0))
      (return (or (= c0 63) (= c0 33)
                  (= hp 'ptr) (= hp 'raw) (= hp 'ref) (= hp 'array) (= hp 'fn)
                  (= hp 'struct) (= hp 'union) (= hp 'dyn) (= hp 'BoxedFn) (= hp 'Maybe)
                  (!= (struct-template-lookup-ref hs) null)
                  (!= (union-template-lookup-ref hs) null)
                  (!= (type-alias-app-of n) null))))))

; A function-pointer type is `(fn RET)` then one parameter list, `(fn i32)(i32 i64)`.
(defn die-fn-type-shape (n:ptr line:i32):void
  (let (s:String (node-str (as ?&Node n)))
    (die-at (node-line n line)
      (fstr "fn type: '" (string-as-view &s)
            "' has an extra operand -- the return type goes in the head and the parameters after it, e.g. (fn i32)(i32 i64)"))))

(defn die-raw-retired (line:i32):void
  (die-at line "'raw' was retired: write ptr for an untyped pointer, (ptr T) for a typed unchecked one"))

; One spelling for `void*`: a pointer over `void` would be a second one.
(defn die-void-pointee (elem:ptr line:i32):void
  (when (and (!= elem null) (= ((unsafe/cast &Type elem) 'kind) TY-VOID))
    (die-at line "void has no pointee: write ptr for an untyped pointer")))

(defn parse-type-from-node (node:ptr line:i32):&Type
  ; W9 item 45: `()` in a type position is a NULL node (W5f), and it names no
  ; type — the same answer this function gives any other node it cannot read,
  ; from the caller's line since there is no node to blame. One guard here is
  ; what covers every type position at once: a `defcast` operand, a return type,
  ; an `extend` subject, a field type.
  (when (= node null) (die-at line "unable to parse type expression"))
  (let (n:&Node (unsafe/cast &Node node)
        ; Stage 15 W8 G-2: consume the one-shot `(array T N)` permission (see
        ; g-array-ok, src/nucleusc.nuc). Read-and-clear on entry, so every
        ; nested parse this call makes sees 0 and an array can appear only at
        ; the very type node a permitting site handed us.
        array-ok:i32 g-array-ok)
    (set! g-array-ok 0)
    (case (n 'kind)
      NODE-SYM
      (do
      ; Colon-sugar in inline type position: "ptr:Node" → (ptr Node).
      (when (symbol-contains-byte (n 's) 58)
        (return (parse-type-from-node (split-colon-segments (n 's) line) line)))
      ; A bare name is this same type node under another spelling, not a nested
      ; one, so the permission crosses into parse-type-name (which consumes it):
      ; without this no transparent alias could ever name storage.
      (set! g-array-ok array-ok)
      (return (parse-type-name (n 's) line)))
      NODE-LIST
      (do
      ; Stage 10 Phase F: a list head carrying a ?/! type prefix — produced by the
      ; multi-colon desugar of e.g. ?ptr:Node -> (?ptr Node) or !ptr:Node ->
      ; (!ptr Node). Strip the prefix from the head, parse the remainder as a type,
      ; then apply the prefix's sugar (? = niche/value Maybe; ! = (Result T Err)).
      ; Bare ?Foo / !Foo never reach here (single token, handled in parse-type-name).
      ; PK-3: a head that is ONLY sigils is the list form of `?X` — X is its sole
      ; element; `(?! X)` → `(! X)` → X composes as resolve-type-name's `?!` does.
      (let (head0:ptr (node-first n))
        (when (and (!= head0 null) (= (-> head0 (unsafe/cast &Node _) (_ 'kind)) NODE-SYM))
          (let (hs:Symbol (-> head0 (unsafe/cast &Node _) (_ 's))
                hv:StrView (symbol-as-view hs)
                c0:i32 (if (> (hv 'len) 0) (as i32 (aref (hv 'data) 0)) 0))
            (when (or (= c0 63) (= c0 33))
              (let (bare:i32 (if (= (type-sigil-run hs) (hv 'len)) 1 0)
                    rest:ptr (node-rest n))
                (when (and (!= bare 0)
                           (or (= rest null) (!= (node-rest (unsafe/cast &Node rest)) null)))
                  (die-at line (fstr "'" hs "' takes one type -- (" hs " T)")))
                (let (inner:ptr
                        (if (and (!= bare 0) (= (hv 'len) 1))
                          (as ptr (parse-type-from-node (node-first (unsafe/cast &Node rest)) line))
                          (as ptr (parse-type-from-node
                                    (node-cons (as ptr (intern-node (symbol-intern (strview-drop-bytes hv 1))))
                                      rest line)
                                    line))))
                  (when (= c0 63)
                    (when (= (-> inner (unsafe/cast &Type _) (_ 'kind)) TY-PTR)
                      (return (unsafe/cast &Type (type-as-pkind inner PTR-MAYBE))))
                    ; Value operand: stamp the value-Maybe template (Phase F uniform ?).
                    (let (ut:?&UnionTemplate (union-template-lookup-ref (symbol-intern "Maybe")))
                      (when (= ut null)
                        (die-at line (missing-template-message "?T" (symbol-intern "Maybe"))))
                      (let (argts:ptr (arena-alloc (ptr-bytes)))
                        (set! (aref (unsafe/cast &ptr argts) 0) inner)
                        (return (union-template-stamp-types (as ptr ut) argts 1 line)))))
                  (let (ut:?&UnionTemplate (union-template-lookup-ref (symbol-intern "Result")))
                    (when (= ut null)
                      (die-at line (missing-template-message "!T" (symbol-intern "Result"))))
                    (let (argts:ptr (arena-alloc (* (as i64 2) (ptr-bytes))))
                      (set! (aref (unsafe/cast &ptr argts) 0) inner)
                      (set! (aref (unsafe/cast &ptr argts) 1) (as ptr ty-err))
                      (return (union-template-stamp-types (as ptr ut) argts 2 line))))))))))
      ; AT-3: postfix volatile is retired. (T volatile) / (T1 T2 ... volatile) —
      ; the list-form spelling — and colon-sugared T:volatile (which reduces to
      ; this same trailing-symbol shape via split-colon-segments before it ever
      ; reaches here, so one check catches both source spellings) used to strip
      ; the trailing 'volatile symbol and mark the head type volatile via
      ; type-with-volatile. Now a targeted hard error naming the AT-1
      ; attribute-slot replacement instead. Placed before ptr/fn, same as the
      ; retired stripping logic was, so the message fires before any other
      ; parse of the list is attempted.
      (let (nlen:i32 (node-len n))
        (when (>= nlen 2)
          (let (last:&Node (unsafe/cast &Node (node-at n (- nlen 1))))
            (when (and (!= (as ptr last) null)
                       (= (last 'kind) NODE-SYM)
                       (= (last 's) "volatile"))
              (die-at line "postfix 'volatile' is retired: use the ':volatile' attribute (e.g. '(:volatile name:T)' for a declaration, or '(ptr :volatile T)' for a pointer target)")))))
      ; Stage 15 W8 G-2 (design/global-init.md §5): `(array T N)` — a fixed-size
      ; array of N values of T, laid out inline exactly as C's `T x[N]`. Placed
      ; ahead of the struct/union-template lookups so the spelling cannot be
      ; captured by a user template that happens to be named `array`.
      ;
      ; The length is an arbitrary integer CONSTANT EXPRESSION, evaluated by
      ; G-1's `const-fold-int` — the same folder `defvar-init-ir` uses, called
      ; rather than re-derived (context/conventions.md's standing rule for this
      ; area), so `(array i32 (* 2 SLOTS))` works and a malformed length gets
      ; G-1's located overflow / divide-by-zero diagnostics for free.
      (let (head:ptr (node-first n))
        (when (= head 'array)
          (when (= array-ok 0)
            (die-at line "(array T N) is a storage type: it is valid only as a defvar type or a defstruct / (struct ...) field type -- everywhere else use &T, the pointer an array decays to when it is read"))
          (when (!= (node-len n) 3)
            (die-at line "(array T N): expects an element type and a constant length -- e.g. (array i32 8)"))
          (let (etn:ptr (node-at n 1)
                lnn:ptr (node-at n 2)
                lline:i32 (node-line lnn line)
                et:ptr (as ptr (parse-type-from-node etn (node-line etn line)))
                len:i64 0)
            ; A dry parse runs before layouts and macros: the use settles the rest.
            (when (> g-dry-parse-ntv 0) (return (dry-parse-type)))
            ; Mode 3 = W9 item 40's layout prescan, which must diagnose nothing
            ; and must never guess a length: report "not settled yet" and let
            ; `defstruct-fill-layout` abandon the struct, so `emit-defstruct`
            ; asks all three questions below with their own words and lines.
            (when (= array-ok 3)
              (when (or (!= (opaque-sdef-of et) null)
                        (!= (cycle-pending-sdef et) null)
                        (= (const-fold-int lnn (as &i64 &len) lline) 0))
                (set! g-layout-defer 1)
                (return (array-type et 0)))
              ; A length that folds to something the emitter will refuse is
              ; deferred too, so no rejected layout is ever registered.
              (when (or (<= len 0) (> (* len (as i64 (abi-sizeof et))) 2147483647))
                (set! g-layout-defer 1)
                (return (array-type et 0)))
              (return (array-type et (unsafe/cast i32 len))))
            ; An element with no layout would give the array a wrong size and
            ; the enclosing struct wrong offsets — the same two obligations a
            ; by-value defstruct field carries (W3a / W1d).
            (reject-opaque-type et (node-line etn line) "array element")
            (reject-cycle-pending-layout et (node-line etn line) "array element")
            ; Mode 2 = the prescan: leave the length provisional (0) rather than
            ; folding it, because macros are not registered during a prescan and
            ; folding there would accept `(_* K 2)` while refusing `(* K 2)`.
            ; See g-array-ok's note in src/nucleusc.nuc.
            (when (= array-ok 2) (return (array-type et 0)))
            (when (= (const-fold-int lnn (as &i64 &len) lline) 0)
              (die-at lline "(array T N): length must be a compile-time integer constant"))
            (when (<= len 0)
              (die-at lline
                (fstr "(array T N): length must be positive, got " len)))
            ; Sizes are computed in i32 throughout the layout walk (abi-sizeof),
            ; so refuse an array whose total byte size would not fit rather than
            ; wrapping into a plausible-looking small number.
            (let (total:i64 (* len (as i64 (abi-sizeof et))))
              (when (> total 2147483647)
                (die-at lline
                  (fstr "(array T N): total size " total
                        " bytes exceeds the 2147483647-byte limit"))))
            (return (array-type et (unsafe/cast i32 len))))))
      ; Anonymous struct: (struct field:type ...) — memoized by content hash so
      ; two textually-identical shapes share one synthesized StructDef.
      (let (head:ptr (node-first n))
        (when (= head 'struct)
          (let (rest:ptr (node-rest n)
                nfields:i32 0
                cur:ptr null)
            (set! cur rest)
            (while (> (node-len cur) 0)
              (inc! nfields)
              (set! cur (node-rest (unsafe/cast &Node cur))))
            (let (fnames:ptr (arena-alloc (* (as i64 nfields) 8))
                  ftypes:ptr (arena-alloc (* (as i64 nfields) 8))
                  i:i32 0)
              (set! cur rest)
              (while (> (node-len cur) 0)
                (let (field:ptr (node-first (unsafe/cast &Node cur))
                      fname:Symbol (symbol-none)
                      ; G-2: an anonymous struct's field is a field, so it may
                      ; be an `(array T N)` on the same terms a defstruct field
                      ; may — one rule for "a field of an aggregate", not two.
                      fty:ptr (extract-decl-name-and-type field (as &Symbol &fname) line))
                  (when (= fty null)
                    (die-at line (fstr "struct: field '" fname "' missing :type")))
                  ; Intern so field-name pointer-equality works at access sites.
                  (set! (aref (unsafe/cast &Symbol fnames) i) fname)
                  (set! (aref (unsafe/cast &ptr ftypes) i) fty))
                (inc! i)
                (set! cur (node-rest (unsafe/cast &Node cur))))
              (when (> g-dry-parse-ntv 0) (return (dry-parse-type)))
              (let (sd:ptr (lookup-or-make-anon-struct fnames ftypes null null nfields 0 0)
                    t:&Type (make-type TY-STRUCT))
                (set! (t 'sdef) sd)
                (return t))))))
      ; Anonymous untagged union: (union member:type ...) — memoized like the
      ; anonymous struct above. Raw and unchecked (unions.md §2): reading a
      ; member other than the one last written is a reinterpretation.
      (let (head:ptr (node-first n))
        (when (= head 'union)
          (let (rest:ptr (node-rest n)
                nfields:i32 0
                cur:ptr null)
            (set! cur rest)
            (while (> (node-len cur) 0)
              (inc! nfields)
              (set! cur (node-rest (unsafe/cast &Node cur))))
            (when (= nfields 0)
              (die-at line "union: at least one member required"))
            (let (fnames:ptr (arena-alloc (* (as i64 nfields) (ptr-bytes)))
                  ftypes:ptr (arena-alloc (* (as i64 nfields) (ptr-bytes)))
                  i:i32 0)
              (set! cur rest)
              (while (> (node-len cur) 0)
                (let (field:ptr (node-first (unsafe/cast &Node cur))
                      fname:Symbol (symbol-none)
                      ; G-2: same for an anonymous union member (C's
                      ; `union { char b[4]; int w; }`).
                      fty:ptr (extract-decl-name-and-type field (as &Symbol &fname) line))
                  (when (= fty null)
                    (die-at line (fstr "union: member '" fname "' missing :type")))
                  (set! (aref (unsafe/cast &Symbol fnames) i) fname)
                  (set! (aref (unsafe/cast &ptr ftypes) i) fty))
                (inc! i)
                (set! cur (node-rest (unsafe/cast &Node cur))))
              (when (> g-dry-parse-ntv 0) (return (dry-parse-type)))
              (let (sd:ptr (lookup-or-make-anon-union fnames ftypes null null nfields 0 0)
                    t:&Type (make-type TY-UNION))
                (set! (t 'sdef) sd)
                (return t))))))
      ; §3.7: a parametric alias application expands before any registry is
      ; consulted, so the alias name never reaches type identity or mangling —
      ; the same transparency the plain form has in parse-type-name.
      (if-some (ta (type-alias-app-of n))
        (let (ex:?&Node (type-alias-subst ta (ta 'body) (as ?&Node n) line (alias-foreign? ta)))
          (when (>= g-type-alias-depth MAX-TYPE-ALIAS-DEPTH)
            (die-at line "type alias expands into a cycle"))
          (set! g-type-alias-depth (+ g-type-alias-depth 1))
          (let (t:&Type (alias-body-type ta (as ptr ex) line))
            (set! g-type-alias-depth (- g-type-alias-depth 1))
            (return t)))
        0)
      ; Stage 11: a parameterized defstruct use — (Vector i32), (HashMap K V) —
      ; in type position stamps (and memoizes) a concrete monomorphic instance
      ; (parametric-structs.md §3). The colon-sugar composes for free: &T and
      ; (ref ...) reach here through the recursion above / the ptr/ref branches
      ; below with the inner (Vector i32) parsed via this same routine.
      (let (head:&Node (unsafe/cast &Node (node-first n)))
        (when (and (!= (as ptr head) null) (= (head 'kind) NODE-SYM))
          (let (st:ptr (struct-template-lookup-ref (head 's)))
            (when (!= st null)
              (return (struct-template-stamp st (as ptr n) line))))))
      ; A parameterized defunion use: (Result A B) stamps (and memoizes) a
      ; concrete instance of the template (unions.md §5). `Maybe` is excluded —
      ; it has bespoke handling below (one spelling, two layouts: niche pointer
      ; for (Maybe (ref T)), value stamp otherwise).
      (let (head:&Node (unsafe/cast &Node (node-first n)))
        (when (and (!= (as ptr head) null)
                   (= (head 'kind) NODE-SYM) (!= (head 's) "Maybe"))
          (let (ut:ptr (union-template-lookup-ref (head 's)))
            (when (!= ut null)
              (return (union-template-stamp ut (as ptr n) line))))))
      ; Check for pointer constructor: (ptr T) or (ptr ptr T) ...
      (let (head:ptr (node-first n))
        (when (= head 'ptr)
          (let (rest:ptr (node-rest n))
            (when (= rest null) (return ty-ptr))
            ; AT-1: (ptr :volatile T) — a volatile *pointee* (C's `volatile T *`,
            ; the MMIO case). The keyword moves inside the constructor and marks
            ; the element type, not the pointer slot.
            (let (vflags:i32 0)
              (set! rest (parse-decl-attrs rest (as &i32 &vflags) line))
              (reject-decl-attr-const vflags line "a pointer target type")
              (when (= rest null)
                (die-at line "ptr: element type required after attribute -- (ptr :volatile T)"))
              (let (elem:ptr null)
                (if (= (node-rest (unsafe/cast &Node rest)) null)
                  (set! elem (parse-type-from-node (node-first (unsafe/cast &Node rest)) line))
                  (set! elem (parse-type-from-node rest line)))
                (when (!= (bit-and vflags DECL-ATTR-VOLATILE) 0)
                  (set! elem (as ptr (type-with-volatile (unsafe/cast &Type elem)))))
                (die-void-pointee elem line)
                (let (pt:&Type (make-type TY-PTR))
                  (set! (pt 'elem) elem)
                  ; (ptr T) is the typed unchecked pointer (stage21 ptr-is-unchecked.md).
                  (set! (pt 'pkind) PTR-RAW)
                  (return pt)))))))
      (let (head:ptr (node-first n))
        (when (= head 'raw) (die-raw-retired line)))
      ; Stage 10: (ref T) — a non-null pointer to T. Same shape as (ptr T),
      ; (colon sugar ref:T and the standalone `&T` arrive here too), but the
      ; element is required.
      (let (head:ptr (node-first n))
        (when (= head 'ref)
          (let (rest:ptr (node-rest n))
            (when (= rest null)
              (die-at line "ref: element type required — (ref T)"))
            ; AT-1: (ref :volatile T) — volatile pointee on a non-null pointer.
            (let (vflags:i32 0)
              (set! rest (parse-decl-attrs rest (as &i32 &vflags) line))
              (reject-decl-attr-const vflags line "a pointer target type")
              (when (= rest null)
                (die-at line "ref: element type required after attribute -- (ref :volatile T)"))
              (let (elem:ptr null)
                (if (= (node-rest (unsafe/cast &Node rest)) null)
                  (set! elem (parse-type-from-node (node-first (unsafe/cast &Node rest)) line))
                  (set! elem (parse-type-from-node rest line)))
                (when (!= (bit-and vflags DECL-ATTR-VOLATILE) 0)
                  (set! elem (as ptr (type-with-volatile (unsafe/cast &Type elem)))))
                (die-void-pointee elem line)
                (let (pt:&Type (make-type TY-PTR))
                  (set! (pt 'elem) elem)
                  (set! (pt 'pkind) PTR-REF)
                  (return pt)))))))
      ; Stage 10: (Maybe X) — one spelling, two layouts (errors.md §10 / E2).
      ;   (Maybe (ref T)) keeps the N1 niche-encoded pointer (null = none);
      ;   (Maybe T) for any other T stamps the two-arm {tag, T} value union from
      ;   the prelude template. Value-Maybe is eliminated with `match` and built
      ;   with `make` / return-position target typing.
      (let (head:ptr (node-first n))
        (when (= head 'Maybe)
          (let (rest:ptr (node-rest n))
            (when (= rest null)
              (die-at line "Maybe: payload type required — (Maybe T) or (Maybe (ref T))"))
            (let (inner:ptr null)
              (if (= (node-rest (unsafe/cast &Node rest)) null)
                (set! inner (parse-type-from-node (node-first (unsafe/cast &Node rest)) line))
                (set! inner (parse-type-from-node rest line)))
              ; Any plain pointer payload niche-encodes: null is free to mean none.
              (when (and (= (-> inner (unsafe/cast &Type _) (_ 'kind)) TY-PTR)
                         (or (= (ptr-pkind inner) PTR-REF) (= (ptr-pkind inner) PTR-RAW)))
                (return (unsafe/cast &Type (type-as-pkind inner PTR-MAYBE))))
              ; Any other payload: stamp the value-Maybe template.
              (let (ut:?&UnionTemplate (union-template-lookup-ref (symbol-intern "Maybe")))
                (when (= ut null)
                  (die-at line (missing-template-message "(Maybe T)" (symbol-intern "Maybe"))))
                (let (argts:ptr (arena-alloc (ptr-bytes)))
                  (set! (aref (unsafe/cast &ptr argts) 0) inner)
                  (return (union-template-stamp-types (as ptr ut) argts 1 line))))))))
      ; Stage 13 TE-5: (BoxedFn (param-types…) ret) — the shared fat pointer
      ; (TE-1) specialised to the Fn family (design/stage13/type-erasure.md). Each
      ; signature is a distinct {data,vtable} instance type. Additive: no existing
      ; spelling reaches here, so the bootstrap stays byte-identical.
      (let (head:ptr (node-first n))
        (when (= head 'BoxedFn)
          (let (plist-node:ptr (node-rest n))
            (when (or (= plist-node null)
                      (= (node-rest (unsafe/cast &Node plist-node)) null))
              (die-at line "BoxedFn: expects (BoxedFn (param-types…) ret)"))
            (let (params-list:ptr (node-first (unsafe/cast &Node plist-node))
                  ret-node:ptr (-> plist-node (unsafe/cast &Node _) (node-rest _) (unsafe/cast &Node _) (node-first _))
                  num-p:i32 0
                  cur:ptr null)
              (set! cur params-list)
              (while (> (node-len cur) 0) (inc! num-p) (set! cur (node-rest (unsafe/cast &Node cur))))
              (let (param-arr:ptr (if (> num-p 0)
                                    (arena-alloc (* (as i64 num-p) (ptr-bytes)))
                                    null)
                    pi:i32 0)
                (set! cur params-list)
                (while (> (node-len cur) 0)
                  (set! (aref (unsafe/cast &ptr param-arr) pi) (parse-type-from-node (node-first (unsafe/cast &Node cur)) line))
                  (inc! pi)
                  (set! cur (node-rest (unsafe/cast &Node cur))))
                (let (ret-ty:ptr (parse-type-from-node ret-node line))
                  (when (> g-dry-parse-ntv 0) (return (dry-parse-type)))
                  (return (boxedfn-type param-arr num-p ret-ty line))))))))
      ; Stage 13 TE-6: (dyn P) — the shared fat pointer (TE-1) erasing a value of
      ; an arbitrary single user protocol P via nominal `extend` conformance
      ; (design/stage13/type-erasure.md "Instantiation B"). P must be a bare
      ; protocol symbol (parametric `(dyn (Seq E))` is deferred). The protocol is
      ; NOT resolved here — union-registry is imported before the protocol registry
      ; — only its name is stored; validation fires at box-construction time.
      ; Additive: no existing spelling reaches here, so the bootstrap stays
      ; byte-identical.
      (let (head:ptr (node-first n))
        (when (= head 'dyn)
          (let (rest:ptr (node-rest n))
            (when (or (= rest null) (= (node-first (unsafe/cast &Node rest)) null))
              (die-at line "(dyn P): expects (dyn Protocol)"))
            (let (pnode:&Node (unsafe/cast &Node (node-first (unsafe/cast &Node rest))))
              (when (!= (pnode 'kind) NODE-SYM)
                (die-at line "(dyn P): protocol must be a bare symbol (parametric protocols are not boxable)"))
              ; Admission is still asked: it is the one check `dyn-type` makes.
              (when (> g-dry-parse-ntv 0)
                (dyn-annot-record (pnode 's) line)
                (return (dry-parse-type)))
              (return (dyn-type (pnode 's) line))))))
      ; Check for function pointer type: ((fn ret) (param-types...))
      (let (head:ptr (node-first n))
        (when (!= head null)
          ; Head is a list (fn ret-type) — function pointer with params
         (when (= ((unsafe/cast &Node head) 'kind) NODE-LIST)
           (let (fn-head:ptr (node-first (unsafe/cast &Node head)))
             (when (= fn-head 'fn)
                (when (> (node-len head) 2) (die-fn-type-shape head line))
                (when (> (node-len n) 2) (die-fn-type-shape n line))
                ; Parse return type from (fn ret-type)
                (let (ret-node:ptr (node-rest (unsafe/cast &Node head))
                      ret-type:ptr ty-void)
                  (when (and (!= ret-node null)
                             (!= (node-first (unsafe/cast &Node ret-node)) null))
                    (set! ret-type (parse-type-from-node (node-first (unsafe/cast &Node ret-node)) line)))
                  ; Parse parameter types from the second element (param-types...)
                  (let (params-node:ptr (node-rest n)
                        num-p:i32 0
                        param-arr:ptr null
                        is-va:i32 0)
                    (when (!= params-node null)
                      (let (plist:ptr (node-first (unsafe/cast &Node params-node)))
                        (when (!= plist null)
                          ; Count params
                          (let (cur:ptr plist
                                count:i32 0)
                            (while (> (node-len cur) 0)
                              (inc! count)
                              (set! cur (node-rest (unsafe/cast &Node cur))))
                            (set! num-p count)
                            (set! param-arr (arena-alloc (* (as i64 count) (ptr-bytes))))
                            ; Parse each param type
                            (set! cur plist)
                            (let (pi:i32 0)
                              (while (> (node-len cur) 0)
                                (set! (aref (unsafe/cast &ptr param-arr) pi) (parse-type-from-node (node-first (unsafe/cast &Node cur)) line))
                                (inc! pi)
                                (set! cur (node-rest (unsafe/cast &Node cur)))))))))
                    (let (ft:&Type (make-type TY-FN))
                      (set! (ft 'ret) ret-type)
                      (type-set-params ft param-arr num-p)
                      (set! (ft 'variadic) is-va)
                      (return ft)))))))
          ; Head is a symbol "fn" — function pointer with no params: (fn ret-type)
         (when (= head 'fn)
             (when (> (node-len n) 2) (die-fn-type-shape n line))
             (let (ret-node:ptr (node-rest n)
                                ret-type:ptr ty-void)
               (when (and (!= ret-node null)
                          (!= (node-first (unsafe/cast &Node ret-node)) null))
                 (set! ret-type (parse-type-from-node (node-first (unsafe/cast &Node ret-node)) line)))
               (let (ft:&Type (make-type TY-FN))
                 (set! (ft 'ret) ret-type)
                 (set! (ft 'params) null)
                 (set! (ft 'num-params) 0)
                 (set! (ft 'variadic) 0)
                 (return ft))))))
      ; Stage 15 W9 item 13: every probe above failed, so this list is not a type.
      ; Falling off the end returned null, and NO caller distinguishes "no
      ; annotation was written" from "an annotation was written and is not a
      ; type" — so `(defn f (x:(Vector i32)) …)` without `(import-use nucleus.vector)`
      ; reported `missing :type on param 'x'`, blaming the one thing that is
      ; unambiguously present. The trailing `die-at` below cannot cover this: it
      ; is `case`'s label-less default arm, reachable only for a NodeKind outside
      ; {NODE-SYM, NODE-LIST}.
      ;
      ; Two different mistakes reach here, and one message for both would lie
      ; about one of them:
      ;   - the head names a real TYPE used where a constructor belongs. This is
      ;     what a doubled annotation desugars to — `x:i32:i32` is `(i32 i32)` —
      ;     and `unknown type: i32` would be simply false.
      ;   - the head names nothing reachable. That is the genuine unknown-type
      ;     case, so it routes through `unknown-type-message`, the same tiered
      ;     message `parse-type-name` gives a bare unknown type: the
      ;     out-of-scope-qualifier, defined-in-an-unimported-file note,
      ;     wrong-namespace and did-you-mean tiers all apply here too, and are
      ;     worth more than a second, poorer message invented locally.
      (let (head:ptr (node-first n))
        (when (and (!= head null)
                   (= (-> head (unsafe/cast &Node _) (_ 'kind)) NODE-SYM))
          (let (hs:Symbol (-> head (unsafe/cast &Node _) (_ 's)))
            (when (or (!= (builtin-type-name hs) null)
                      (!= (struct-lookup-ref hs) null)
                      (!= (dry-parse-tyvar hs) 0))
              (die-at line
                (fstr "'" hs "' is a type, not a type constructor -- (" hs
                      " ...) is not a type; a doubled annotation like x:T:T desugars to exactly this")))
            ; A retired value-form head in a type slot (`(addr-of T)`, once a legal
            ; spelling of `(ref T)`) gets the same answer the value path gives.
            (match (retired-form-message hs) (none 0) ((some retired) (die-at line retired)))
            (die-at line (unknown-type-message hs))))
        (die-at line "unable to parse type expression")))
    (die-at line "unable to parse type expression"))))

(import-use arena)

; Union/struct registry and type-parsing — extracted from src/nucleusc.nuc.
; Source-imported by src/nucleusc.nuc after the ABI module is available.

; ============================================================
; Stage 8: anonymous structs — (struct field:type ...) types, memoized by
; content hash so two textually-identical shapes share one StructDef.
; ============================================================

(defn fnv-byte (h:i64 b:i64):i64
  (set! h (bit-xor h b))
  (set! h (* h 1099511628211))
  (return h))

(defn fnv-str (h:i64 s:CStr):i64
  (let (i:i64 0
        c:i32 (bit-and (as i32 (aref (as ptr:i8 s) 0)) 255))
    (while (!= c 0)
      (set! h (fnv-byte h (as i64 c)))
      (set! i (+ i 1))
      (set! c (bit-and (as i32 (aref (as ptr:i8 s) i)) 255)))
    (return h)))

(defn hash-type (h:i64 t:raw:Type):i64
  (when (= t null) (return (fnv-byte h 255)))
  (let (tt:raw:Type t
        k:i32 (tt kind))
    (set! h (fnv-byte h (as i64 k)))
    (set! h (fnv-byte h (as i64 (tt is-volatile))))
    (when (= k TY-PTR)
      (set! h (hash-type h (tt elem))))
    (when (= k TY-STRUCT)
      (set! h (fnv-str h ((tt sdef) name))))
    (when (= k TY-UNION)
      (set! h (fnv-str h ((tt sdef) name))))
    (when (= k TY-FN)
      (set! h (hash-type h (tt ret)))
      (set! h (fnv-byte h (as i64 (tt num-params))))
      (dotimes (i (tt num-params))
        (set! h (hash-type h ((field-at (tt params) i) type)))))
    (return h)))

(defn hash-struct-shape (field-names:ptr field-types:ptr nfields:i32):i64
  (let (h:i64 -3750763034362895579)
    (dotimes (i nfields)
      (set! h (fnv-str h (aref (as ptr:ptr field-names) i)))
      (set! h (fnv-byte h 0))
      (set! h (hash-type h (aref (as ptr:ptr field-types) i))))
    (return h)))

(defn lookup-or-make-anon-struct (field-names:ptr field-types:ptr nfields:i32):ref:StructDef
  (let (hash:i64 (hash-struct-shape field-names field-types nfields)
        synth:ptr (fmt-i64 "__anon_struct_h%016lx" hash)
        sd:ptr (lookup-struct synth))
    (when (= sd null)
      (set! sd (register-struct synth))
      (let (sd2:ptr:StructDef (as ptr:StructDef sd))
        (struct-set-fields sd2 field-names field-types nfields)
        (.set! sd2 emitted 1)
        (.set! sd2 src-file g-source-path)
        (.set! sd2 src-line 0))
      (fprintf g-type-stream "%%%s = type { " synth)
      (dotimes (i nfields)
        (when (!= i 0) (fprintf g-type-stream ", "))
        (fprintf g-type-stream "%s" (type-to-ir (aref (as ptr:ptr field-types) i))))
      (fprintf g-type-stream " }\n\n"))
    ; Both arms leave sd non-null, but the set!-kill is sticky across the join
    ; (nullability.md §4) — assert rather than re-test.
    (return (as ref:StructDef sd))))

; ============================================================
; Stage 10: untagged unions (design/stage10/unions.md §2). Anonymous and
; memoized like (struct ...). LLVM has no union type, so a union lowers the
; way clang does: a struct wrapping the largest-aligned member plus padding
; to the full size. The IR type definition needs member sizes, and members
; may name structs whose fields are registered later in the unit — so the
; definition text is deferred to drain-pending-union-irs, called at every
; module-assembly point (named types are order-independent in a module).
; ============================================================

(defn lookup-or-make-anon-union (field-names:ptr field-types:ptr nfields:i32):ref:StructDef
  (let (hash:i64 (hash-struct-shape field-names field-types nfields)
        synth:ptr (fmt-i64 "__anon_union_h%016lx" hash)
        sd:ptr (lookup-struct synth))
    (when (= sd null)
      (set! sd (register-struct synth))
      (let (sd2:ptr:StructDef (as ptr:StructDef sd))
        (struct-set-fields sd2 field-names field-types nfields)
        (.set! sd2 is-union 1)
        (.set! sd2 emitted 0)
        (.set! sd2 src-file g-source-path)
        (.set! sd2 src-line 0)
        (conj g-pending-unions sd2)))
    (return (as ref:StructDef sd))))

; The member a union's IR wrapper struct holds: the first member with maximal
; alignment (clang's rule); remaining bytes become an i8 padding array.
(defn union-repr-member (sd:raw:StructDef):i32
  (let (sdd:raw:StructDef sd
        n:i32 (sdd num-fields)
        best:i32 0
        besta:i32 0)
    (dotimes (i n)
      (let (fa:i32 (abi-alignof ((field-at (sdd fields) i) type)))
        (when (> fa besta) (set! besta fa) (set! best i))))
    (return best)))

; Write the deferred `%name = type { f0, f1, ... }` definition for one stamped
; parametric-struct instance (parametric-structs.md §3). Shares the pending queue
; with unions; distinguished by is-union == 0. A plain struct line — no
; repr-member/padding — so a stamped instance is byte-identical to the
; hand-written struct. The `emitted` flag guards double-emit.
(defn emit-pending-struct-ir-type (sd:raw:StructDef):void
  (let (sdd:raw:StructDef sd)
    (when (!= (sdd emitted) 0) (return))
    (.set! sdd emitted 1)
    (fprintf g-type-stream "%%%s = type { " (sdd ir-name))
    (dotimes (i (sdd num-fields))
      (when (!= i 0) (fprintf g-type-stream ", "))
      (fprintf g-type-stream "%s" (type-to-ir ((field-at (sdd fields) i) type))))
    (fprintf g-type-stream " }\n\n")))

; Write the deferred `%name = type { repr [, pad] }` definition for one union.
(defn emit-union-ir-type (sd:raw:StructDef):void
  (let (sdd:raw:StructDef sd)
    (when (!= (sdd emitted) 0) (return))
    ; Stage 11: a stamped parametric struct queued on the shared pending list is
    ; not a union — emit a plain struct line instead of the union wrapper.
    (when (= (sdd is-union) 0)
      (emit-pending-struct-ir-type sd)
      (return))
    (.set! sdd emitted 1)
    (let (ri:i32 (union-repr-member sd)
          rt:ptr ((field-at (sdd fields) ri) type)
          total:i32 (abi-union-size sd)
          pad:i32 (- total (abi-sizeof rt)))
      (if (> pad 0)
        (fprintf g-type-stream "%%%s = type { %s, [%d x i8] }\n\n"
          (sdd ir-name) (type-to-ir rt) pad)
        (fprintf g-type-stream "%%%s = type { %s }\n\n"
          (sdd ir-name) (type-to-ir rt))))))

; Are all of `sd`'s by-value named-type field dependencies already emitted into
; the shared type buffer (g-type-bufp)? A field lowers to a `%Name` reference
; only when its kind is TY-STRUCT/TY-UNION (type-to-ir); TY-PTR fields lower to
; opaque `ptr` and carry no named dependency. Since `emitted` is set exactly
; when a StructDef's `%Name = type {...}` line is written into the single shared
; g-type-bufp (the one buffer every module — batch, CT, macro-JIT, REPL —
; concatenates), `dep.emitted == 1` is precisely "the dependency's definition is
; already present in the module currently being assembled." When every named
; dependency is present, this returns 1 and the type emits exactly as before
; (the current source never stamps a (Vector ptr) ahead of its %AllocHandle dep,
; so this is always 1 → zero deferrals → byte-identical). The deferral exists for
; a type stamped at prescan (signature occurrence) before the import that defines
; its struct-by-value field has run: it stays queued until a later drain, after
; that import emits the dependency. See cleanup3.md "two-stage boot refresh".
(defn pending-union-deps-ready (sd:raw:StructDef):i32
  (let (sdd:raw:StructDef sd
        n:i32 (sdd num-fields))
    (dotimes (i n)
      (let (ft:ptr:Type (unsafe/cast ptr:Type ((field-at (sdd fields) i) type))
            fk:i32 (ft kind))
        (when (or (= fk TY-STRUCT) (= fk TY-UNION))
          (let (dep:ptr:StructDef (unsafe/cast ptr:StructDef (ft sdef)))
            ; A null sdef (shape-only / unresolved) cannot be a satisfied named
            ; dependency; treat as not-ready so we defer rather than emit a
            ; dangling %ref.
            (when (= (as ptr dep) null) (return 0))
            (when (= (dep emitted) 0) (return 0)))))))
  (return 1))

; Emit every still-pending union/struct type definition whose named field
; dependencies are already present in the shared type buffer. Idempotent (each
; emit re-checks `emitted` and is a no-op once written); entries are never
; removed from the queue, so a type skipped here for an unready dependency is
; retried on the next drain — by which point the import that defines the
; dependency will have emitted it. Called before each module assembly (batch
; output, compile-time JIT, macro JIT, REPL).
(defn drain-pending-union-irs ():void
  (when (= g-pending-unions null) (return))
  (dotimes (i (unsafe/cast i32 (count g-pending-unions)))
    (let (sd:ptr (invoke g-pending-unions (as usize i)))
      (when (!= (pending-union-deps-ready sd) 0)
        (emit-union-ir-type sd)))))

(defn lookup-struct (name:CStr):?ptr:StructDef
  (dotimes (i (unsafe/cast i32 (count g-structs)))
    (let (sd:ptr:StructDef (as ptr:StructDef (invoke g-structs (as usize i))))
      (when (= (sd name) name)
        (return (as ptr sd)))))
  (return null))

(defn parse-type-name (name:CStr line:i32):ref:Type
  ; Stage 10 errors sugar: ?!T => (Maybe (Result T Err)) — a fallible result
  ; that may be absent. The leading ?! reads as a *value* Maybe over the Result
  ; (errors.md §10): the operand is already a complete value type, so it is not
  ; a niche pointer. Checked before the plain ? below. Needs the value-Maybe and
  ; Result templates (prelude).
  (when (and (= (char-at name 0) 63) (= (char-at name 1) 33))
    (let (result-ty:ptr (parse-type-name (unsafe/ptr+ (as ptr:i8 name) 1) line)
          ut:?ptr:UnionTemplate (union-template-lookup "Maybe"))
      (when (= ut null)
        (die-at line "?!T: value-Maybe template not in scope (import the prelude)"))
      (let (argts:ptr (arena-alloc (ptr-bytes)))
        (aset! (as ptr:ptr argts) 0 result-ty)
        (return (union-template-stamp-types (as ptr ut) argts 1 line)))))
  ; Stage 10 sugar: ?T => (Maybe T), uniform (Phase F). A pointer operand
  ; (e.g. ?ptr:Node, ?ref:Node) niche-encodes (one pointer, null = none) by
  ; relabeling its kind to Maybe. A value operand (?Node) stamps the two-arm
  ; {tag, T} value-Maybe template (E2) and no longer auto-injects (ref ...). Our
  ; own source spells every nullable-pointer Maybe ?ptr:Foo, so no bare value
  ; ?Foo remains there (byte-identical); value ?Foo now means the value-Maybe.
  (when (= (char-at name 0) 63)
    (let (inner:ptr (parse-type-name (unsafe/ptr+ (as ptr:i8 name) 1) line))
      (when (= (-> inner (unsafe/cast ptr:Type _) (_ kind)) TY-PTR)
        (return (unsafe/cast ref:Type (type-as-pkind inner PTR-MAYBE))))
      ; Value operand: stamp the value-Maybe template (E2 / errors.md §10).
      (let (ut:?ptr:UnionTemplate (union-template-lookup "Maybe"))
        (when (= ut null)
          (die-at line "?T: value-Maybe template not in scope (import the prelude)"))
        (let (argts:ptr (arena-alloc (ptr-bytes)))
          (aset! (as ptr:ptr argts) 0 inner)
          (return (union-template-stamp-types (as ptr ut) argts 1 line))))))
  ; Stage 10 errors sugar: !T => (Result T Err). Recognized only in type
  ; positions (no collision with !=, which never parses as a type), and — unlike
  ; ? — takes the payload as written (A1's arbitrary payloads: !i64 is
  ; (Result i64 Err)). !?T composes for free: the rest "?T" recurses here.
  (when (= (char-at name 0) 33)
    (let (inner:ptr (parse-type-name (unsafe/ptr+ (as ptr:i8 name) 1) line)
          ut:?ptr:UnionTemplate (union-template-lookup "Result"))
      (when (= ut null)
        (die-at line "!T: (Result T E) template not in scope (import the prelude)"))
      (let (argts:ptr (arena-alloc (* (as i64 2) (ptr-bytes))))
        (aset! (as ptr:ptr argts) 0 inner)
        (aset! (as ptr:ptr argts) 1 (as ptr ty-err))
        (return (union-template-stamp-types (as ptr ut) argts 2 line)))))
  ; Colon-sugar reaching the string parser (only via the ?/!/?! recursion on a
  ; pointer operand, e.g. "ptr:Node" after stripping the leading ?): delegate to
  ; the node parser. Bare type names elsewhere never contain a colon, so this is
  ; inert for the existing flow.
  (when (!= (strchr name 58) null)
    (return (parse-type-from-node (split-colon-segments name line) line)))
  (when (= name "int") (return ty-i32))
  (when (= name "Err") (return ty-err))
  (when (= name "i1") (return ty-i1))
  (when (= name "i8") (return ty-i8))
  (when (= name "i16") (return ty-i16))
  (when (= name "i32") (return ty-i32))
  (when (= name "i64") (return ty-i64))
  (when (= name "bool") (return ty-i1))
  (when (= name "ptr") (return ty-ptr))
  (when (= name "raw") (return ty-raw))
  (when (= name "CStr") (return ty-cstr))
  (when (= name "Char") (return ty-char))
  (when (= name "void") (return ty-void))
  (when (= name "ui8") (return ty-ui8))
  (when (= name "ui16") (return ty-ui16))
  (when (= name "ui32") (return ty-ui32))
  (when (= name "ui64") (return ty-ui64))
  ; Stage 11: pointer-sized integer aliases. usize is unsigned (size_t),
  ; ssize is signed (ssize_t/ptrdiff_t). Size follows g-target-ptr-bytes.
  (when (= name "usize") (return ty-usize))
  (when (= name "ssize") (return ty-ssize))
  (when (= name "f32") (return ty-f32))
  (when (= name "f64") (return ty-f64))
  (when (= name "float") (return ty-f32))
  (when (= name "double") (return ty-f64))
  ; Stage 13 L7: a TY-FN spelling (interned "__fnty_<id>" from type-spelling)
  ; resolves back to the original function-pointer Type*. This is what lets a
  ; stamped generic body's `(ref __fnty_3)` re-parse to the fn's TY-FN, so the
  ; forwarding call on the function pointer can be reconstructed at emit time.
  (match (fnty-resolve name)
         ((some ft) (return ft))
         (none null))
  ; Stage 12 N4: a struct/union type spelling may be namespace-qualified
  ; (`coll/Vector`); the type registry is keyed by the bare name, so strip the
  ; qualifier before lookup. Identity under `user` (no slash) → byte-identical.
  (let (sd:ptr (lookup-struct (strip-ns-qualifier name)))
    (when (!= sd null)
      ; A niche defunion (unions.md §6 rules 2/3) resolves to its bare-pointer
      ; niche type, not the (dead) backing struct — union-instance-type decides.
      (let (ud:?ptr:UnionDef ((as ptr:StructDef sd) udef))
        (when (!= ud null)
          (return (union-instance-type ud))))
      (return (type-for-sdef sd))))
  (die-at line (fmt-s "unknown type: %s" name)))

; The registered Type for a StructDef — TY-UNION when the def is an untagged
; union, TY-STRUCT otherwise (including defunion backing structs).
(defn type-for-sdef (sd:raw:StructDef):ref:Type
  (let (k:i32 (if (!= (sd is-union) 0) TY-UNION TY-STRUCT)
        t:ref:Type (make-type k))
    (.set! t sdef sd)
    (return t)))

; Stage 14 NS-3 (design/stage14/native-strings.md): the Type* for the prelude
; `StrView` struct — the type a string literal (NODE-STR) carries once the flip
; lands. Unlike `ty-cstr` (a builtin, init-time global), StrView is a user struct
; promoted to the prelude in NS-1, so its Type must be resolved dynamically from
; the struct registry. It is always registered by the time any literal is
; typed/emitted (prescan-struct-names registers every struct name before any
; emission, and StrView sits near the top of the prelude), so this returns
; non-null in practice; a null result (a broken/missing prelude) lets the callers
; fall back to a bare pointer rather than crash. A fresh Type is built per call
; (like type-for-sdef); type-eq keys on the sdef pointer, not Type identity, so
; two StrView Types compare equal. Identity of "StrView" is the interned symbol
; name, exactly how lookup-struct keys the registry (and type-is-strview matches).
(defn strview-type ():?ptr:Type
  (let (sd:ptr (lookup-struct ((as ptr:Node (intern-symbol "StrView")) s)))
    (when (= sd null) (return null))
    (return (as ptr (type-for-sdef sd)))))

; ============================================================
; Stage 13 type-erasure (TE-1): the shared fat-pointer aggregate.
; ============================================================
; A type-erased value (BoxedFn / (dyn P), design/stage13/type-erasure.md) is a
; two-word fat pointer, a by-value aggregate:
;   { data: ptr,        ; heap-allocated payload (the boxed env / boxed value)
;     vtable: ptr }      ; address of the static per-concrete-type vtable (TE-2)
; Field order is { data, vtable } (the committed CE-4 order). It is an ordinary
; 16-byte TY-STRUCT, so it rides the existing by-value-struct ABI with no new
; value-vs-pointer logic: abi-classify sees two INTEGER eightbytes → ABI-COERCE2,
; exactly the CE-3 pass/return/store path (emit-struct-ret TY-PTR typed copy,
; emit-call-with-args first-class load, abi-arg-frag). type-size returns the
; pointer size for the TY-STRUCT slot; LLVM computes the real 16-byte size for
; typed load/store.
;
; CRITICAL (inertness): the StructDef is registered LAZILY — only the first time
; a box type is actually needed (TE-3+). Registering it eagerly at init would
; emit a `%__fatptr = type { ptr, ptr }` line into every module's IR and drift
; the bootstrap. Nothing boxes a value in the compiler's own source, so the lazy
; registration fires in ZERO modules during self-compilation → byte-identical.
(defvar g-fatptr-sdef:ptr null)   ; memoized {data,vtable} StructDef*, or null
(defvar g-fatptr-type:ptr null)   ; memoized TY-STRUCT Type* over it, or null

; Register (once) and return the {data:ptr, vtable:ptr} StructDef. Mirrors the
; parametric-struct stamp (struct-template-stamp-types): reserve the name via
; register-struct, fill the two ptr fields, and queue its `%__fatptr = type {…}`
; IR on the shared deferred queue (emit-pending-struct-ir-type writes the plain
; struct line at drain time; the `emitted` flag guards double-emit). Both fields
; are opaque `ptr`, so the type has no named dependency and emits on the next
; drain. Idempotent — subsequent calls return the cached def.
(defn ensure-fatptr-sdef ():ptr
  (when (!= g-fatptr-sdef null) (return g-fatptr-sdef))
  (let (nm:ptr (intern-str (sanitize-for-ir "__fatptr"))
        sd:ref:StructDef (register-struct nm))
    (let (fnm:ptr (arena-alloc (* (as i64 2) (ptr-bytes)))
          fty:ptr (arena-alloc (* (as i64 2) (ptr-bytes))))
      (aset! (as ptr:ptr fnm) 0 (intern-str "data"))
      (aset! (as ptr:ptr fnm) 1 (intern-str "vtable"))
      (aset! (as ptr:ptr fty) 0 (as ptr ty-ptr))
      (aset! (as ptr:ptr fty) 1 (as ptr ty-ptr))
      (struct-set-fields sd fnm fty 2))
    (.set! sd src-file g-source-path)
    (.set! sd src-line 0)
    (conj g-pending-unions sd)
    (set! g-fatptr-sdef (as ptr sd))
    (return g-fatptr-sdef)))

; The fat-pointer Type (TY-STRUCT over the StructDef above), memoized so every
; box shares one immutable Type* (type-eq by sdef pointer identity). TE-3 uses
; this as the slot/binding type and to build the fat-pointer Val; it constructs
; a value by alloca'ing this type, storing the heap `data` ptr into field 0 and
; the TE-2 vtable address into field 1, then loading the first-class aggregate.
(defn fatptr-type ():ptr
  (when (= g-fatptr-type null)
    (set! g-fatptr-type (as ptr (type-for-sdef (ensure-fatptr-sdef)))))
  (return g-fatptr-type))

; ============================================================
; Stage 13 type-erasure (TE-5 minimal): BoxedFn instance types.
; ============================================================
; `(BoxedFn (params…) ret)` denotes the shared fat pointer (TE-1) specialised to
; the Fn family. Each distinct signature gets its OWN {data,vtable} StructDef so
; type-eq (sdef pointer identity) keeps `(BoxedFn (i32) i32)` and
; `(BoxedFn (f64) f64)` distinct — the shared 16-byte layout means the ABI is
; still the CE-3 COERCE2 path. The Fn signature (ret + non-self params) is carried
; on the returned TY-STRUCT Type's ret/params/num-params fields (unused for a
; struct otherwise), so the boxing coercion (TE-3) and the `(invoke box …)`
; forwarding (TE-4) recover it without a side table. Memoised per signature-key so
; one spelling → one Type* → one sdef. LAZY like ensure-fatptr-sdef: the
; `%__boxedfn.… = type {…}` line is queued only when a signature is first parsed,
; so a box-free unit (the whole compiler) emits nothing → byte-identical bootstrap.
; §14.5 batch 3: the parallel keys/types arrays collapsed into one
; `(Vector (ref BoxedFnEntry))`. Lazily constructed on first use (mirrors
; g-vtable-table) — never explicitly reset, so `ref` not `raw`.
(defvar (g-boxedfn-table (ref (Vector (ref BoxedFnEntry)))))

(defn boxedfn-memo-lookup (key:ptr):ptr
  (when (= g-boxedfn-table null) (return null))
  (dotimes (i (unsafe/cast i32 (count g-boxedfn-table)))
    (let (e:ref:BoxedFnEntry (invoke g-boxedfn-table (as usize i)))
      (when (= (e key) key) (return (as ptr (e ty))))))
  (return null))

(defn boxedfn-memo-put (key:ptr ty:ptr):void
  (when (= g-boxedfn-table null)
    (set! g-boxedfn-table
      (unsafe/cast (ref (Vector (ref BoxedFnEntry))) (vector-new-in (addr-of g-arena-alloc)))))
  (let (rec:ref:BoxedFnEntry (new BoxedFnEntry))
    (.set! rec key key)
    (.set! rec ty (as raw:Type ty))
    (conj g-boxedfn-table rec)))

; A dot-free signature token "<rettok>_<p0tok>_<p1tok>…" (each via
; type-mangle-token), keying the per-signature box StructDef name and memo entry.
; §14.4: `params` is a TY-FN Type's parameter Vector `(Vector (ref Field))`;
; each param type is read via `field-at`. Both callers (boxedfn-type below and
; ensure-fnfwd-vtable in nucleusc.nuc) pass a Vector handle.
(defn boxedfn-sig-token (params:(raw (Vector (ref Field))) num-p:i32 ret:ptr):ptr
  (let (s:ptr (type-mangle-token ret))
    (dotimes (i num-p)
      (set! s (fmt-2s "%s_%s" s (type-mangle-token ((field-at params i) type)))))
    (return s)))

; The (memoised) BoxedFn instance Type for a signature. On a miss it registers a
; fresh {data:ptr, vtable:ptr} StructDef (mirroring ensure-fatptr-sdef but with a
; per-signature name), queues its IR on the shared pending-union list, builds the
; TY-STRUCT Type, stamps the Fn signature onto ret/params/num-params, and memoises.
(defn boxedfn-type (param-arr:ptr num-p:i32 ret:ptr line:i32):ptr
  (let ((pvec (ref (Vector (ref Field)))) (make-param-vec param-arr num-p)
        tok:ptr (boxedfn-sig-token pvec num-p ret)
        key:ptr (intern-str (fmt-s "BoxedFn.%s" tok))
        hit:ptr (boxedfn-memo-lookup key))
    (when (!= hit null) (return hit))
    (let (nm:ptr (intern-str (sanitize-for-ir (fmt-s "__boxedfn.%s" tok)))
          sd:ref:StructDef (register-struct nm))
      (let (fnm:ptr (arena-alloc (* (as i64 2) (ptr-bytes)))
            fty:ptr (arena-alloc (* (as i64 2) (ptr-bytes))))
        (aset! (as ptr:ptr fnm) 0 (intern-str "data"))
        (aset! (as ptr:ptr fnm) 1 (intern-str "vtable"))
        (aset! (as ptr:ptr fty) 0 (as ptr ty-ptr))
        (aset! (as ptr:ptr fty) 1 (as ptr ty-ptr))
        (struct-set-fields sd fnm fty 2))
      (.set! sd src-file g-source-path)
      (.set! sd src-line 0)
      (conj g-pending-unions sd)
      (let (t:ref:Type (type-for-sdef (as ptr sd)))
        ; Carry the Fn signature on the struct Type for invoke-forwarding / boxing.
        ; Reuse the `pvec` built above (immutable after build) as the param list.
        (.set! t ret ret)
        (.set! t params pvec)
        (.set! t num-params num-p)
        (boxedfn-memo-put key (as ptr t))
        (return (as ptr t))))))

; If `ty` is a BoxedFn instance type, return its canonical box Type* (carrying the
; Fn signature in ret/params/num-params); else null. Detection is by StructDef
; pointer identity against the memo, so a loaded box value and any re-derived
; spelling both resolve. INERT until a box type is parsed (g-boxedfn-table stays
; null in a box-free unit) — the null check short-circuits, so no IR is affected.
(defn boxedfn-canonical (ty:ptr):ptr
  (when (= ty null) (return null))
  (when (= g-boxedfn-table null) (return null))
  (let (tt:ptr:Type (as ptr:Type ty))
    (when (!= (tt kind) TY-STRUCT) (return null))
    (let (sd:ptr (tt sdef))
      (when (= sd null) (return null))
      (dotimes (i (unsafe/cast i32 (count g-boxedfn-table)))
        (let (e:ref:BoxedFnEntry (invoke g-boxedfn-table (as usize i)))
          (when (= ((e ty) sdef) sd) (return (as ptr (e ty))))))
      (return null))))

; ============================================================
; Stage 13 type-erasure TE-6: general `(dyn Protocol)` instance types.
; ============================================================
; `(dyn P)` denotes the SAME shared fat pointer (TE-1) as a BoxedFn — a two-word
; {data:ptr, vtable:ptr} — but erases a value of an arbitrary *user protocol* `P`
; via NOMINAL `extend P` conformance instead of the structural closure→Fn match.
; Each distinct protocol gets its OWN {data,vtable} StructDef so type-eq (sdef
; pointer identity) keeps `(dyn Show)` and `(dyn Eq)` distinct, and so a loaded box
; resolves its protocol. The protocol NAME (the interned symbol string, matching
; the protocol registry's key) is carried in a parallel memo array — `(dyn P)`
; needs no signature on the Type (the method set comes from the Protocol record at
; vtable-build time, nucleusc.nuc). LAZY like boxedfn-type: the `%__dyn.<P> = type
; {…}` line is queued only when a `(dyn P)` is first parsed, so a dyn-free unit (the
; whole compiler) emits nothing → byte-identical bootstrap. Protocol validation is
; deferred to box construction (union-registry is imported before generics, so the
; protocol registry is not yet visible here); a parse only stores the name.
; §14.5 batch 3: the parallel keys/types/protos arrays collapsed into one
; `(Vector (ref DynEntry))`. Lazily constructed on first use (mirrors
; g-vtable-table/g-boxedfn-table) — never explicitly reset, so `ref` not `raw`.
(defvar (g-dyn-table (ref (Vector (ref DynEntry)))))

(defn dyn-memo-lookup (key:ptr):ptr
  (when (= g-dyn-table null) (return null))
  (dotimes (i (unsafe/cast i32 (count g-dyn-table)))
    (let (e:ref:DynEntry (invoke g-dyn-table (as usize i)))
      (when (= (e key) key) (return (as ptr (e ty))))))
  (return null))

(defn dyn-memo-put (key:ptr ty:ptr proto:ptr):void
  (when (= g-dyn-table null)
    (set! g-dyn-table
      (unsafe/cast (ref (Vector (ref DynEntry))) (vector-new-in (addr-of g-arena-alloc)))))
  (let (rec:ref:DynEntry (new DynEntry))
    (.set! rec key key)
    (.set! rec ty (as raw:Type ty))
    (.set! rec proto proto)
    (conj g-dyn-table rec)))

; The (memoised) `(dyn P)` instance Type for protocol name `proto`. On a miss it
; registers a fresh {data:ptr, vtable:ptr} StructDef named `%__dyn.<P>`, queues its
; IR on the shared pending-union list, builds the TY-STRUCT Type, and records the
; protocol name in the parallel memo. Mirrors boxedfn-type exactly (same layout, so
; the same CE-3 COERCE2 ABI), differing only in the carried datum (protocol name vs
; Fn signature).
(defn dyn-type (proto:ptr line:i32):ptr
  (let (key:ptr (intern-str (fmt-s "dyn.%s" proto))
        hit:ptr (dyn-memo-lookup key))
    (when (!= hit null) (return hit))
    (let (nm:ptr (intern-str (sanitize-for-ir (fmt-s "__dyn.%s" proto)))
          sd:ref:StructDef (register-struct nm))
      (let (fnm:ptr (arena-alloc (* (as i64 2) (ptr-bytes)))
            fty:ptr (arena-alloc (* (as i64 2) (ptr-bytes))))
        (aset! (as ptr:ptr fnm) 0 (intern-str "data"))
        (aset! (as ptr:ptr fnm) 1 (intern-str "vtable"))
        (aset! (as ptr:ptr fty) 0 (as ptr ty-ptr))
        (aset! (as ptr:ptr fty) 1 (as ptr ty-ptr))
        (struct-set-fields sd fnm fty 2))
      (.set! sd src-file g-source-path)
      (.set! sd src-line 0)
      (conj g-pending-unions sd)
      (let (t:ref:Type (type-for-sdef (as ptr sd)))
        (dyn-memo-put key (as ptr t) proto)
        (return (as ptr t))))))

; If `ty` is a `(dyn P)` instance type, return its canonical box Type*; else null.
; Detection is by StructDef pointer identity against the memo (a loaded box value
; and any re-derived spelling both resolve). INERT until a `(dyn P)` is parsed.
(defn dyn-canonical (ty:ptr):ptr
  (when (= ty null) (return null))
  (when (= g-dyn-table null) (return null))
  (let (tt:ptr:Type (as ptr:Type ty))
    (when (!= (tt kind) TY-STRUCT) (return null))
    (let (sd:ptr (tt sdef))
      (when (= sd null) (return null))
      (dotimes (i (unsafe/cast i32 (count g-dyn-table)))
        (let (e:ref:DynEntry (invoke g-dyn-table (as usize i)))
          (when (= ((e ty) sdef) sd) (return (as ptr (e ty))))))
      (return null))))

; The protocol name carried by a `(dyn P)` box Type (the interned symbol string,
; usable directly as a `protocol-lookup` key), or null if `ty` is not a dyn box.
(defn dyn-proto-of (ty:ptr):ptr
  (when (= ty null) (return null))
  (when (= g-dyn-table null) (return null))
  (let (tt:ptr:Type (as ptr:Type ty))
    (when (!= (tt kind) TY-STRUCT) (return null))
    (let (sd:ptr (tt sdef))
      (when (= sd null) (return null))
      (dotimes (i (unsafe/cast i32 (count g-dyn-table)))
        (let (e:ref:DynEntry (invoke g-dyn-table (as usize i)))
          (when (= ((e ty) sdef) sd) (return (e proto)))))
      (return null))))

; ============================================================
; Stage 10: tagged sums — defunion (design/stage10/unions.md §3) and the
; parameterized-template layer (§5). A defunion is a struct
; {tag:i32, payload:(union ...)} plus an arm table consumed by match/make.
; ============================================================

(defn uniondef-lookup (name:CStr):?ptr:UnionDef
  (dotimes (i (unsafe/cast i32 (count g-uniondefs)))
    (let (ud:ptr:UnionDef (as ptr:UnionDef (invoke g-uniondefs (as usize i))))
      (when (= (ud name) name)
        (return (as ptr ud)))))
  (return null))

(defn union-template-lookup (name:ptr):?ptr:UnionTemplate
  (doseq (ut g-union-templates (VecIter ref:UnionTemplate))
         (when (= (ut name) name)
               (return ut)))
  (return null))

; Stage 11: look up a registered defstruct template by (interned) name. Mirror
; union-template-lookup. Names compare by pointer equality, so callers pass an
; interned head symbol (parametric-structs.md §1).
(defn struct-template-lookup (name:ptr):?ptr:StructTemplate
  (doseq (st g-struct-templates (VecIter ref:StructTemplate))
           (when (= (st name) name)
                 (return st)))
  (return null))

; The UnionDef behind a type, or null: a defunion value is TY-STRUCT whose
; StructDef carries the udef back-pointer.
(defn uniondef-for-type (t:raw:Type):?ptr:UnionDef
  (when (= t null) (return null))
  (let (tt:raw:Type t)
    (when (!= (tt kind) TY-STRUCT) (return null))
    (when (= (tt sdef) null) (return null))
    (return ((tt sdef) udef))))

; The UnionDef behind a Result-shaped value (a tagged sum carrying both an `ok`
; arm and an `err` arm), or null. The shared eliminator for `unwrap`/`unwrap-or`
; over `!T` (errors.md §9): `ok` is the success arm, `err` the failure arm.
(defn result-union-of (t:raw:Type):?ptr:UnionDef
  (let (ud:?ptr:UnionDef (uniondef-for-type t))
    (when (= ud null) (return null))
    (when (< (union-arm-index (as ptr ud) "ok") 0) (return null))
    (when (< (union-arm-index (as ptr ud) "err") 0) (return null))
    (return ud)))

; The `ok` arm's payload type for a Result-shaped union type, or null.
(defn result-ok-type (t:raw:Type):?ptr:Type
  (let (ud:?ptr:UnionDef (result-union-of t))
    (when (= ud null) (return null))
    (let (oi:i32 (union-arm-index (as ptr ud) "ok"))
      (return ((invoke (ud arms) (as usize oi)) ptype)))))

(defn union-arm-index (ud:raw:UnionDef name:CStr):i32
  (let (udd:raw:UnionDef ud)
    (dotimes (i (udd num-arms))
      (let (arm:ref:Arm (invoke (udd arms) (as usize i)))
        (when (= (strcmp (arm name) name) 0)
          (return i))))
    (return -1)))

; Byte offset of the payload union inside the backing struct: the i32 tag,
; aligned up to the payload's alignment. Computed on demand — member layouts
; may involve structs whose fields are registered after the defunion form.
(defn union-payload-off (ud:raw:UnionDef):i32
  (let (udd:raw:UnionDef ud)
    (when (= (udd union-sd) null) (return 0))
    (return (abi-align-up 4 (abi-struct-align (udd union-sd))))))

; True iff arm `i` carries exactly one field whose type is a *typed* (ref T)
; pointer — TY-PTR with elem present and non-void. The "typed" guard is the
; void* exemption (design/stage10/cleanup-prompt.md "byte-identity guard"): a
; niche over a typeless pointer buys no safety and would needlessly churn the
; reader's elem-less !ptr, so an elem-less payload stays TAGGED.
(defn arm-is-typed-ref (arm:ref:Arm):i32
  (when (!= (arm nfields) 1) (return 0))
  (let (pty:raw:Type (arm ptype))
    (when (= pty null) (return 0))
    (when (!= (pty kind) TY-PTR) (return 0))
    (let (el:raw:Type (pty elem))
      (when (= el null) (return 0))
      (when (= (el kind) TY-VOID) (return 0))
      (return 1))))

; True iff arm `i` carries exactly one field of type Err (TY-ERR) — the err
; side of a niche-ERRPTR (errors.md §8: Err is a distinct i32-repr scalar so
; rule-3 detection can key on it).
(defn arm-is-err-field (arm:ref:Arm):i32
  (when (!= (arm nfields) 1) (return 0))
  (let (pty:raw:Type (arm ptype))
    (when (= pty null) (return 0))
    (return (if (= (pty kind) TY-ERR) 1 0))))

; The layout engine (design/stage10/unions.md §6) — the U4/A2 convergence step.
; Given a fully-built arm table and the parsed &repr mode, decide the layout in
; rule order. `&repr tagged` forces rule 4; `&repr niche` requires a niche.
; The two niche rules need a *typed* (ref T) ok payload (arm-is-typed-ref) — the
; void* exemption keeps the reader's elem-less !ptr TAGGED and the bootstrap
; byte-identical. Returns LAYOUT-* ; on a niche, *niche-elem-out (a ptr:ptr) is
; set to the (ref T) payload's element Type so codegen can recover T.
(defn union-layout-classify ((arms (ref (Vector (ref Arm))))
                                 narms:i32 repr:i32 niche-elem-out:ptr line:i32):i32
  (aset! (as ptr:ptr niche-elem-out) 0 null)
  (when (= repr REPR-TAGGED) (return LAYOUT-TAGGED))
  ; Rule 1: every arm payload-less → just the i32 tag (≅ defenum).
  (let (all-payloadless:i32 1)
    (dotimes (i narms)
      (when (!= ((invoke arms (as usize i)) nfields) 0) (set! all-payloadless 0)))
    (when (!= all-payloadless 0)
      (when (= repr REPR-NICHE)
        (die-at line "&repr niche: an all-payload-less union is an enum, not a niche"))
      (return LAYOUT-ENUM)))
  ; Rules 2 & 3 are two-arm shapes (order-independent in the arms).
  (when (= narms 2)
    (let (arm0:ref:Arm (invoke arms 0)
          arm1:ref:Arm (invoke arms 1)
          none0:i32 (if (= (arm0 nfields) 0) 1 0)
          none1:i32 (if (= (arm1 nfields) 0) 1 0)
          ref0:i32 (arm-is-typed-ref arm0)
          ref1:i32 (arm-is-typed-ref arm1)
          err0:i32 (arm-is-err-field arm0)
          err1:i32 (arm-is-err-field arm1))
      ; Rule 2: one payload-less arm, one single typed (ref T) field.
      (when (or (and (!= none0 0) (!= ref1 0))
                (and (!= ref0 0) (!= none1 0)))
        (let (ri-arm:ref:Arm (if (!= ref0 0) arm0 arm1))
          (aset! (as ptr:ptr niche-elem-out) 0 ((ri-arm ptype) elem))
          (return LAYOUT-NICHE-MAYBE)))
      ; Rule 3: one single typed (ref T) field, one single Err field.
      (when (or (and (!= ref0 0) (!= err1 0))
                (and (!= err0 0) (!= ref1 0)))
        (let (ri-arm:ref:Arm (if (!= ref0 0) arm0 arm1))
          (aset! (as ptr:ptr niche-elem-out) 0 ((ri-arm ptype) elem))
          (return LAYOUT-NICHE-ERRPTR)))))
  ; Rule 4: the §3 tagged struct.
  (when (= repr REPR-NICHE)
    (die-at line "&repr niche: arms are not nicheable (need 2 arms: a typed (ref T) and a payload-less or Err arm)"))
  (return LAYOUT-TAGGED))

; Register a tagged sum under `name` from its arm forms (a Node chain of
; `(arm field:type ...)` / bare `arm` entries). Memoized by name — template
; instances and .nuch re-imports reuse the first registration. Emits the
; backing struct's IR type; the payload union's own definition is deferred
; (drain-pending-union-irs) because member layouts may not be final yet.
; Strip a trailing `&repr <mode>` marker (unions.md §6, §9) out of a defunion
; arm chain: `&repr` is a non-arm token (like &where/&rest elsewhere), followed
; by its mode (`tagged` or `niche`). Returns the filtered arm chain (the &repr
; pair removed) and writes the parsed REPR-* mode to *repr-out. With no marker,
; returns the chain unchanged and REPR-AUTO.
(defn defunion-strip-repr (arms:ptr repr-out:ptr line:i32):ptr
  (aset! (as ptr:i32 repr-out) 0 REPR-AUTO)
  (let (head:ptr null
        tail:ptr null
        scur:ptr arms)
    (while (!= scur null)
      (let (a:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node scur) car)))
        (if (and (= (a kind) NODE-SYM) (= (strcmp (a s) "&repr") 0))
          (let (mcell:ptr ((unsafe/cast ptr:Node scur) cdr))
            (when (= mcell null)
              (die-at line "defunion: &repr needs a mode (tagged or niche)"))
            (let (m:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node mcell) car)))
              (when (!= (m kind) NODE-SYM)
                (die-at (m line) "defunion: &repr mode must be a symbol"))
              (if (= (strcmp (m s) "tagged") 0)
                (aset! (as ptr:i32 repr-out) 0 REPR-TAGGED)
                (if (= (strcmp (m s) "niche") 0)
                  (aset! (as ptr:i32 repr-out) 0 REPR-NICHE)
                  (die-at (m line) "defunion: &repr mode must be `tagged` or `niche`"))))
            (set! scur mcell))   ; advance past the mode; the cdr step skips it
          (let (cell:ptr (make-cell (as ptr a) null line))
            (when (= head null) (set! head cell))
            (when (!= tail null) (.set! (unsafe/cast ptr:Node tail) cdr cell))
            (set! tail cell))))
      (set! scur ((unsafe/cast ptr:Node scur) cdr)))
    (return head)))

(defn defunion-register (name:CStr arms-raw:ptr line:i32):ref:UnionDef
  (let (existing:?ptr:UnionDef (uniondef-lookup name))
    (when (!= existing null) (return existing)))
  (when (>= (unsafe/cast i32 (count g-uniondefs)) MAX-UNIONS)
    (die-at line "too many defunions"))
  (let (repr-box:i32 REPR-AUTO
        arms:ptr (defunion-strip-repr arms-raw (as ptr:i32 (addr-of repr-box)) line)
        repr:i32 repr-box
        narms:i32 (node-len arms)
        cur:ptr arms)
    (when (= narms 0)
      (die-at line "defunion: at least one arm required"))
    (when (> narms MAX-UNION-ARMS)
      (die-at line "defunion: too many arms"))
    (let ((arms-vec (ref (Vector (ref Arm)))) (vector-new-in (addr-of g-arena-alloc)))
      (set! cur arms)
      (while (!= cur null)
        (let (arm:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node cur) car))
              aname:ptr null
              fnames:ptr null
              ftypes:ptr null
              nf:i32 0)
          (if (= (arm kind) NODE-SYM)
            (set! aname (arm s))
            (do
              (when (or (!= (arm kind) NODE-CELL) (= (node-len (as ptr arm)) 0))
                (die-at (arm line) "defunion: arm must be `name` or `(name field:type ...)`"))
              (let (an:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr arm) 0)))
                (when (!= (an kind) NODE-SYM)
                  (die-at (an line) "defunion: arm name must be a symbol"))
                (set! aname (an s)))
              (set! nf (- (node-len (as ptr arm)) 1))
              (when (> nf 0)
                (set! fnames (arena-alloc (* (as i64 nf) (ptr-bytes))))
                (set! ftypes (arena-alloc (* (as i64 nf) (ptr-bytes))))
                (let (fi:i32 0)
                  (while (< fi nf)
                    (let (field:ptr (node-at (as ptr arm) (+ fi 1))
                          fname:ptr null
                          fty:ptr (extract-name-and-type field (as ptr:ptr (addr-of fname))
                                                          ((unsafe/cast ptr:Node field) line)))
                      (when (= fty null)
                        (die-at ((unsafe/cast ptr:Node field) line)
                          (fmt-s "defunion: field '%s' missing :type" fname)))
                      (aset! (as ptr:ptr fnames) fi (intern-str fname))
                      (aset! (as ptr:ptr ftypes) fi fty))
                    (inc! fi))))))
          (when (>= (union-arm-index-in aname arms-vec) 0)
            (die-at (arm line) (fmt-s "defunion: duplicate arm '%s'" aname)))
          ; Arm payload: nothing (payload-less), the single field's type, or a
          ; memoized anonymous struct of the fields.
          (let (rec:ref:Arm (new Arm)
                pty:raw:Type (if (= nf 0)
                               null
                               (if (= nf 1)
                                 (as raw:Type (aref (as ptr:ptr ftypes) 0))
                                 (as raw:Type
                                   (type-for-sdef (lookup-or-make-anon-struct fnames ftypes nf))))))
            (.set! rec name (as CStr (intern-str aname)))
            (.set! rec ptype pty)
            (.set! rec fnames fnames)
            (.set! rec ftypes ftypes)
            (.set! rec nfields nf)
            (conj arms-vec rec)))
        (set! cur ((unsafe/cast ptr:Node cur) cdr)))
      ; Classify the layout (unions.md §6 — the U4/A2 convergence). The arm
      ; table is now complete; the engine applies rules 1–4 in order, honoring
      ; &repr. Stage 1 records the decision on the UnionDef; the niche layouts
      ; (rules 2/3) are produced by the Type-returning callers (rule 2/3 codegen).
      (let (niche-elem-box:ptr null
            layout:i32 (union-layout-classify arms-vec
                          narms repr (as ptr:ptr (addr-of niche-elem-box)) line))
      ; The payload union: one member per payload-bearing arm, named by the arm.
      (let (npay:i32 0
            i:i32 0)
        (while (< i narms)
          (when (!= ((invoke arms-vec (as usize i)) ptype) null) (inc! npay))
          (inc! i))
        ; A niche layout (rules 2/3) lowers to a bare pointer with no backing
        ; struct or payload union — skip building the anon payload union (which
        ; would otherwise be emitted by drain-pending-union-irs).
        (let (is-niche:i32 (if (or (= layout LAYOUT-NICHE-MAYBE)
                                   (= layout LAYOUT-NICHE-ERRPTR)) 1 0)
              union-sd:ptr null)
          (when (and (> npay 0) (= is-niche 0))
            (let (mnames:ptr (arena-alloc (* (as i64 npay) (ptr-bytes)))
                  mtypes:ptr (arena-alloc (* (as i64 npay) (ptr-bytes)))
                  mi:i32 0)
              (set! i 0)
              (while (< i narms)
                (let (arm-rec:ref:Arm (invoke arms-vec (as usize i)))
                  (when (!= (arm-rec ptype) null)
                    (aset! (as ptr:ptr mnames) mi (arm-rec name))
                    (aset! (as ptr:ptr mtypes) mi (arm-rec ptype))
                    (inc! mi)))
                (inc! i))
              (set! union-sd (as ptr (lookup-or-make-anon-union mnames mtypes npay)))))
          ; Backing struct: {tag:i32 [, payload:(union ...)]}.
          (let (sd:ref:StructDef (if-some (e (lookup-struct name)) e (register-struct name)))
            (check-ir-name-legal line name (sd ir-name))
            (when (!= (sd emitted) 0)
              (die-at line (fmt-s "defunion: '%s' already names a struct" name)))
            (let (bnf:i32 (if (!= union-sd null) 2 1)
                  bfn:ptr (arena-alloc (* (as i64 2) (ptr-bytes)))
                  bft:ptr (arena-alloc (* (as i64 2) (ptr-bytes))))
              (aset! (as ptr:ptr bfn) 0 (intern-str "tag"))
              (aset! (as ptr:ptr bft) 0 ty-i32)
              (when (!= union-sd null)
                (aset! (as ptr:ptr bfn) 1 (intern-str "payload"))
                (aset! (as ptr:ptr bft) 1 (type-for-sdef union-sd)))
              (struct-set-fields sd bfn bft bnf)
              (.set! sd src-file g-source-path)
              (.set! sd src-line line)
              ; Header-emit modes (--emit-nuch/--emit-cheader) prescan defn
              ; signatures, which can stamp template instances with no IR
              ; streams open — registration without emission is fine there.
              ; A niche layout (rules 2/3) lowers to a bare pointer and never
              ; references this backing struct, so its IR type is not emitted
              ; (the §3 struct that would defeat the whole point of the niche).
              (when (and (!= g-type-stream null)
                         (!= layout LAYOUT-NICHE-MAYBE) (!= layout LAYOUT-NICHE-ERRPTR))
                (if (!= union-sd null)
                  (fprintf g-type-stream "%%%s = type { i32, %%%s }\n\n"
                    (sd ir-name) ((as ptr:StructDef union-sd) ir-name))
                  (fprintf g-type-stream "%%%s = type { i32 }\n\n" (sd ir-name))))
              (.set! sd emitted 1))
            (let (ud:ptr:UnionDef (new UnionDef))
              (conj g-uniondefs ud)
              (.set! ud name name)
              (.set! ud sdef sd)
              (.set! ud union-sd union-sd)
              (.set! ud num-arms narms)
              (.set! ud arms arms-vec)
              (.set! ud layout layout)
              (.set! ud niche-elem niche-elem-box)
              (.set! ud src-line line)
              (.set! sd udef ud)
              (return (as ref:UnionDef ud))))))))))

; Arm-name duplicate probe over the partially-built arm Vector (registration
; helper) — scans the arms conj'd so far.
(defn union-arm-index-in (name:CStr (arms (ref (Vector (ref Arm))))):i32
  (dotimes (i (unsafe/cast i32 (count arms)))
    (when (= (strcmp ((invoke arms (as usize i)) name) name) 0)
      (return i)))
  (return -1))

; Register `(defunion (Name T ...) arms...)` as a template. Defines no type;
; uses stamp instances via union-template-stamp.
(defn register-union-template (form:ptr):void
  (let (ff:ptr:Node (unsafe/cast ptr:Node form)
        head:ptr:Node (unsafe/cast ptr:Node (node-at form 1))
        name-node:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr head) 0)))
    (when (!= (name-node kind) NODE-SYM)
      (die-at (head line) "defunion: template name must be a symbol"))
    (let (name:ptr (name-node s)
          ntv:i32 (- (node-len (as ptr head)) 1))
      (when (< ntv 1)
        (die-at (head line) "defunion: template needs at least one type parameter"))
      ; Re-import of the same template (e.g. via .nuch) is a no-op.
      (when (!= (union-template-lookup name) null) (return))
      (guard-name-kind name (ff line) NK-TYPE)
      (when (>= (unsafe/cast i32 (count g-union-templates)) MAX-UNION-TEMPLATES)
        (die-at (ff line) "too many defunion templates"))
      (let (tyvars:ptr (arena-alloc (* (as i64 ntv) (ptr-bytes))))
        (dotimes (i ntv)
          (let (tv:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr head) (+ i 1))))
            (when (!= (tv kind) NODE-SYM)
              (die-at (tv line) "defunion: type parameter must be a symbol"))
            (aset! (as ptr:ptr tyvars) i (tv s))))
        (let (ut:ptr:UnionTemplate (as ptr:UnionTemplate (arena-alloc (sizeof UnionTemplate))))
          (conj g-union-templates ut)
          (.set! ut name name)
          (.set! ut tyvars tyvars)
          (.set! ut ntv ntv)
          (.set! ut form form))))))

; Stage 11: register `(defstruct (Name T ...) field-specs...)` as a template.
; Exact analogue of register-union-template — defines no type, emits no IR; a
; use `(Name A B)` in type position stamps a concrete instance via
; struct-template-stamp-types. Re-import (idempotent prescan, .nuch) is a no-op.
; A name list with no parameters — `(Foo)` — is an error (parametric-structs.md
; §2): use a plain `defstruct`.
(defn register-struct-template (form:ptr):void
  (let (ff:ptr:Node (unsafe/cast ptr:Node form)
        head:ptr:Node (unsafe/cast ptr:Node (node-at form 1))
        name-node:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr head) 0)))
    (when (!= (name-node kind) NODE-SYM)
      (die-at (head line) "defstruct: template name must be a symbol"))
    (let (name:ptr (name-node s)
          ntv:i32 (- (node-len (as ptr head)) 1))
      (when (< ntv 1)
        (die-at (head line) "defstruct: template needs at least one type parameter — use a plain defstruct"))
      ; Re-import of the same template (e.g. via .nuch, or the idempotent prescan
      ; pass) is a no-op.
      (when (!= (struct-template-lookup name) null) (return))
      (guard-name-kind name (ff line) NK-TYPE)
      (when (>= (unsafe/cast i32 (count g-struct-templates)) MAX-STRUCT-TEMPLATES)
        (die-at (ff line) "too many defstruct templates"))
      (let (tyvars:ptr (arena-alloc (* (as i64 ntv) (ptr-bytes))))
        (dotimes (i ntv)
          (let (tv:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr head) (+ i 1))))
            (when (!= (tv kind) NODE-SYM)
              (die-at (tv line) "defstruct: type parameter must be a symbol"))
            (aset! (as ptr:ptr tyvars) i (tv s))))
        (let (st:ptr:StructTemplate (as ptr:StructTemplate (arena-alloc (sizeof StructTemplate))))
          (conj g-struct-templates st)
          (.set! st name name)
          (.set! st tyvars tyvars)
          (.set! st ntv ntv)
          (.set! st form form))))))

; Stamp (and memoize) a concrete instance of a defunion template from a type
; The Type a defunion instance resolves to. For a niche layout (unions.md §6
; rules 2/3) this is a bare pointer carrying the niche pkind and elem=T — the
; same TY-PTR the parser's `(Maybe (ref T))` / `!T` fast paths yield, so a
; `(defunion (Maybe2 T) (some v:(ref T)) none)` stamp and `(Maybe (ref T))`
; produce identical bits. For LAYOUT-TAGGED/ENUM it is the backing struct type.
; pkind is invisible to type-eq/mangle, so this never perturbs other types.
(defn union-instance-type (ud:raw:UnionDef):ref:Type
  (let (udd:raw:UnionDef ud
        lay:i32 (udd layout))
    (case lay
      LAYOUT-NICHE-MAYBE
        (let (pt:ref:Type (make-type TY-PTR))
          (.set! pt elem (udd niche-elem))
          (.set! pt pkind PTR-MAYBE)
          (return pt))
      LAYOUT-NICHE-ERRPTR
        (let (pt:ref:Type (make-type TY-PTR))
          (.set! pt elem (udd niche-elem))
          (.set! pt pkind PTR-ERRPTR)
          (return pt))
      (return (type-for-sdef (udd sdef))))))

; use `(Name A B)`. The instance is an ordinary defunion named
; `Name.<tok>.<tok>` (type-mangle-token per argument, the generic-fn scheme);
; construction is via `make` / return-position target typing — no per-instance
; constructor functions are stamped, so cross-unit stamping cannot collide.
(defn union-template-stamp (ut:raw:UnionTemplate use-node:ptr line:i32):ref:Type
  (let (utt:raw:UnionTemplate ut
        nargs:i32 (- (node-len use-node) 1)
        argts:ptr (arena-alloc (* (as i64 (if (> nargs 0) nargs 1)) (ptr-bytes))))
    (dotimes (i nargs)
      (aset! (as ptr:ptr argts) i (parse-type-from-node (node-at use-node (+ i 1)) line)))
    (return (union-template-stamp-types ut argts nargs line))))

; Stamp a template instance from already-parsed argument Type*s. Shared by the
; node-driven `(Result A B)` path and the `!T` sugar (which has Type* operands,
; not nodes). Memoized by the mangled instance name.
(defn union-template-stamp-types (ut:raw:UnionTemplate argts:ptr nargs:i32 line:i32):ref:Type
  (let (utt:raw:UnionTemplate ut)
    (when (!= nargs (utt ntv))
      (die-at line
        (fmt-s "%s: wrong number of type arguments for defunion template" (utt name))))
    (let (spellings:ptr (arena-alloc (* (as i64 nargs) (ptr-bytes)))
          iname:ptr (utt name))
      (dotimes (i nargs)
        (let (at:ptr (aref (as ptr:ptr argts) i))
          (aset! (as ptr:ptr spellings) i (type-spelling at))
          (set! iname (fmt-2s "%s.%s" iname (type-mangle-token at)))))
      (if-some (ud (uniondef-lookup iname))
        (return (union-instance-type ud))
        (let (arms:ptr (-> (unsafe/cast ptr:Node (utt form)) (_ cdr) (unsafe/cast ptr:Node _) (_ cdr))
              arms-subst:ptr (subst-tyvars-node arms (utt tyvars) spellings (utt ntv))
              ud2:ref:UnionDef (defunion-register iname arms-subst line))
          (return (union-instance-type ud2)))))))

; Stage 11: stamp (and memoize) a concrete instance of a defstruct template
; (parametric-structs.md §3). Exact analogue of union-template-stamp-types:
;   1. Mangled instance name `Vector.i32` (type-mangle-token per arg), interned
;      so the lookup-struct memoization is a pointer-identity hit.
;   2. Memoize via lookup-struct — a hit returns the existing type-for-sdef.
;   3. On a miss, register-struct the mangled name FIRST (so a pointer
;      self-reference `(ptr (Tree T))` resolving to (Tree i32) finds the
;      in-progress StructDef and terminates), then subst-tyvars-node the
;      field-spec list, parse each concrete field type, fill the StructDef, and
;      QUEUE its `%name = type {…}` line on the shared deferred-IR queue (drained
;      at module-assembly boundaries, exactly like unions). The result IS an
;      ordinary monomorphic TY-STRUCT — no new layout/ABI code.
(defn struct-template-stamp-types (st:raw:StructTemplate argts:ptr nargs:i32 line:i32):ref:Type
  (let (stt:raw:StructTemplate st)
    (when (!= nargs (stt ntv))
      (die-at line
        (fmt-s "%s: wrong number of type arguments for defstruct template" (stt name))))
    (let (spellings:ptr (arena-alloc (* (as i64 nargs) (ptr-bytes)))
          iname:ptr (stt name))
      (dotimes (i nargs)
        (let (at:ptr (aref (as ptr:ptr argts) i))
          (aset! (as ptr:ptr spellings) i (type-spelling at))
          (set! iname (fmt-2s "%s.%s" iname (type-mangle-token at)))))
      ; Intern so the lookup-struct / register-struct name comparison (which is
      ; pointer-identity) memoizes across uses within the unit.
      (set! iname (intern-str iname))
      ; Memoized hit: the instance was already stamped (or is mid-stamp for a
      ; recursive self-reference) — return its Type without re-emitting.
      (let (existing:?ptr:StructDef (lookup-struct iname))
        (when (!= existing null)
          (return (type-for-sdef existing))))
      ; Miss: reserve the name before filling fields so a pointer self-reference
      ; (Tree T → (ptr (Tree i32))) resolves to this in-progress StructDef.
      (let (sd:ref:StructDef (register-struct iname)
            ; The template form's field specs are everything after the (Name T...)
            ; head: (defstruct (Name T..) f0 f1 ...) → cdr-cdr.
            fields-tmpl:ptr (-> (unsafe/cast ptr:Node (stt form)) (_ cdr) (unsafe/cast ptr:Node _) (_ cdr))
            fields:ptr (subst-tyvars-node fields-tmpl (stt tyvars) spellings (stt ntv))
            nfields:i32 (node-len fields)
            cur:ptr fields)
        ; Record the stamping origin (T2): the method unifier recovers
        ; (template, args) from a concrete instance to bind a pattern `(Vector T)`
        ; against a concrete `Vector.i32`. Copy the arg Type*s into a stable arena
        ; array, since the caller's `argts` may be reused.
        (let (origin-args:ptr (arena-alloc (* (as i64 (if (> nargs 0) nargs 1)) (ptr-bytes))))
          (dotimes (oi nargs)
            (aset! (as ptr:ptr origin-args) oi (aref (as ptr:ptr argts) oi)))
          (.set! sd origin-template st)
          (.set! sd origin-args origin-args)
          (.set! sd origin-nargs nargs))
        (let (fnm:ptr (arena-alloc (* (as i64 nfields) (ptr-bytes)))
              ftp:ptr (arena-alloc (* (as i64 nfields) (ptr-bytes))))
          (.set! sd src-file g-source-path)
          (.set! sd src-line line)
          (let (fi:i32 0)
            (set! cur fields)
            (while (!= cur null)
              (let (field:ptr ((unsafe/cast ptr:Node cur) car)
                    fname:ptr null
                    fty:ptr (extract-name-and-type field (as ptr:ptr (addr-of fname))
                                                   ((unsafe/cast ptr:Node field) line)))
                (when (= fty null)
                  (die-at ((unsafe/cast ptr:Node field) line)
                    (fmt-2s "defstruct template %s: field '%s' missing :type" (stt name) fname)))
                (aset! (as ptr:ptr fnm) fi (intern-str fname))
                (aset! (as ptr:ptr ftp) fi fty))
              (inc! fi)
              (set! cur ((unsafe/cast ptr:Node cur) cdr))))
          (struct-set-fields sd fnm ftp nfields))
        ; Queue the `%name = type {…}` IR on the shared deferred queue. emit-pending
        ; -struct-ir-type writes the plain struct line at drain time; the `emitted`
        ; flag guards double-emit. Deferring (rather than emitting inline) keeps a
        ; mid-function stamp from interleaving into a def-stream body, the same
        ; discipline unions use.
        (conj g-pending-unions sd)
        ; Stage 11 T4: per-instance protocol conformance check. For each template
        ; conformance recorded via `(extend (Vector T) (Seq T))`, substitute this
        ; instance's concrete args into the protocol bindings and confirm every
        ; required method resolves for the instance — erroring (naming the method)
        ; if not, and recording the concrete `(Vector.i32, Seq)` conformance so a
        ; Seq-bounded generic call finds it. Done after the StructDef is fully
        ; built so a required method that mentions the instance resolves.
        ; Stage 12 N8: the checker (tmpl-conformance-check-instance) now lives in
        ; the later-imported generics.nuc, so we dispatch through g-tmpl-conf-check-
        ; hook, installed right after `(import-use generics)`. The hook is non-null
        ; before any user struct template is stamped; a null hook (no parametric
        ; protocols loaded yet) means there is nothing to check.
        (when (!= g-tmpl-conf-check-hook null)
          (funcall (unsafe/cast ((fn void) (ptr ptr ptr i32 i32)) g-tmpl-conf-check-hook)
                   st iname spellings nargs line))
        (return (type-for-sdef sd))))))

; Node-driven entry: stamp `(Name A B)` from a use node (mirrors
; union-template-stamp). Parses each type argument, then delegates.
(defn struct-template-stamp (st:raw:StructTemplate use-node:ptr line:i32):ref:Type
  (let (stt:raw:StructTemplate st
        nargs:i32 (- (node-len use-node) 1)
        argts:ptr (arena-alloc (* (as i64 (if (> nargs 0) nargs 1)) (ptr-bytes))))
    (dotimes (i nargs)
      (aset! (as ptr:ptr argts) i (parse-type-from-node (node-at use-node (+ i 1)) line)))
    (return (struct-template-stamp-types st argts nargs line))))

; ============================================================
; Stage 14 AT-1 — declaration attribute slot (design/stage14/attributes.md)
; ============================================================
; A declaration attribute is a leading keyword literal (`:volatile`) qualifying
; the declaration that follows it — never part of type identity, dispatch, or
; name mangling (§2). The cond below is the attribute registry: one clause per
; known attribute (add a row to introduce one), an explicit reserved-with-error
; row for `:thread-local`, and a catch-all that rejects unknown keywords so a
; typo (`:volatle`) can never silently no-op.
;
; parse-decl-attrs scans zero-or-more leading NODE-KEYWORD operands from a
; declaration operand list (`cursor` is a cons cell, or null), OR's each
; recognized attribute's flag bit into *out-flags (a DECL-ATTR-* bitset), and
; returns the list cursor advanced to the first non-attribute operand (the
; declared name / element type). Every declaration site funnels its attribute
; validation through here: def-forms (the keyword is a leading operand),
; struct/union fields and defn params (the keyword heads the field/param cell,
; reached via extract-name-and-type), let/with bindings (the keyword is wrapped
; onto its binding name by attrs-normalize-bindings, then reaches here through
; extract-name-and-type), and pointer target types `(ptr :volatile T)`.
(defn parse-decl-attrs (cursor:ptr out-flags:ptr line:i32):ptr
  (let (flags:i32 0
        cur:ptr cursor)
    (while (and (!= cur null)
                (!= ((unsafe/cast ptr:Node cur) car) null)
                (= (-> cur (unsafe/cast ptr:Node _) (_ car) (unsafe/cast ptr:Node _) (_ kind))
                   NODE-KEYWORD))
      (let (kw:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node cur) car))
            nm:ptr (kw s))
        (cond
          (= nm "volatile")
            (set! flags (bit-or flags DECL-ATTR-VOLATILE))
          (= nm "thread-local")
            (die-at line "thread-local storage requires the threading stage -- see design/stage14/attributes.md §5")
          true
            (die-at line (fmt-s "unknown declaration attribute ':%s' (known attributes: :volatile, :thread-local)" nm))))
      (set! cur ((unsafe/cast ptr:Node cur) cdr)))
    (aset! (as ptr:i32 out-flags) 0 flags)
    (return cur)))

; AT-1: normalize a let/with binding list so a prefix attribute keyword becomes a
; wrapped binding-name cell `(:kw... name)`, restoring strict (name value) pairs.
;   (:volatile x:i32 0  y:i32 1) -> ((:volatile x:i32) 0  y:i32 1)
; The wrapped cell then funnels through extract-name-and-type's attribute branch
; (the single validation chokepoint), exactly like a `(:volatile field:type)`
; struct field. Returns `binds` unchanged — no allocation — when the list holds
; no attribute keyword at a name position, so an attribute-free binding list is
; byte-identical. The fast-path scan only inspects even indices (name positions
; in a well-formed attribute-free list); a keyword used as a binding *value* sits
; at an odd index and is left alone.
(defn attrs-normalize-bindings (binds:ptr line:i32):ptr
  (when (= binds null) (return binds))
  (let (has-attr:i32 0
        idx:i32 0
        scan:ptr binds)
    (while (!= scan null)
      (when (and (= (% idx 2) 0)
                 (!= ((unsafe/cast ptr:Node scan) car) null)
                 (= (-> scan (unsafe/cast ptr:Node _) (_ car) (unsafe/cast ptr:Node _) (_ kind))
                    NODE-KEYWORD))
        (set! has-attr 1))
      (set! scan ((unsafe/cast ptr:Node scan) cdr))
      (inc! idx))
    (when (= has-attr 0) (return binds)))
  (let (result:ptr null
        tail:ptr null
        cur:ptr binds)
    (while (!= cur null)
      ; Collect this binding's leading attribute keywords into (:kw...) list.
      (let (kw-head:ptr null
            kw-tail:ptr null)
        (while (and (!= cur null)
                    (!= ((unsafe/cast ptr:Node cur) car) null)
                    (= (-> cur (unsafe/cast ptr:Node _) (_ car) (unsafe/cast ptr:Node _) (_ kind))
                       NODE-KEYWORD))
          (let (cell:ptr (make-cell ((unsafe/cast ptr:Node cur) car) null line))
            (when (= kw-head null) (set! kw-head cell))
            (when (!= kw-tail null) (.set! (unsafe/cast ptr:Node kw-tail) cdr cell))
            (set! kw-tail cell))
          (set! cur ((unsafe/cast ptr:Node cur) cdr)))
        (when (= cur null)
          (die-at line "declaration attribute must be followed by a binding name"))
        (let (name-node:ptr ((unsafe/cast ptr:Node cur) car)
              wrapped:ptr name-node)
          (when (!= kw-head null)
            (.set! (unsafe/cast ptr:Node kw-tail) cdr (make-cell name-node null line))
            (set! wrapped kw-head))
          (let (ncell:ptr (make-cell wrapped null line))
            (when (= result null) (set! result ncell))
            (when (!= tail null) (.set! (unsafe/cast ptr:Node tail) cdr ncell))
            (set! tail ncell))
          (set! cur ((unsafe/cast ptr:Node cur) cdr))
          ; The value element (verbatim). A missing value is reported downstream
          ; by the even-count check on the normalized list.
          (when (!= cur null)
            (let (vcell:ptr (make-cell ((unsafe/cast ptr:Node cur) car) null line))
              (when (= result null) (set! result vcell))
              (when (!= tail null) (.set! (unsafe/cast ptr:Node tail) cdr vcell))
              (set! tail vcell))
            (set! cur ((unsafe/cast ptr:Node cur) cdr))))))
    (return result)))

; Parse a type from an AST node. Handles:
;   - symbol node: delegates to parse-type-name
;   - list node (ptr T) or (ptr ptr ... T): builds TY-PTR
;   - list node ((fn ret-type) (param-types...)) or (fn ret-type): builds TY-FN
(defn parse-type-from-node (node:ptr line:i32):ref:Type
  (let (n:ptr:Node (unsafe/cast ptr:Node node))
    (case (n kind)
      NODE-SYM
      (do
      ; Colon-sugar in inline type position: "ptr:Node" → (ptr Node).
      (when (!= (strchr (n s) 58) null)
        (return (parse-type-from-node (split-colon-segments (n s) line) line)))
      (return (parse-type-name (n s) line)))
      NODE-CELL
      (do
      ; Stage 10 Phase F: a list head carrying a ?/! type prefix — produced by the
      ; multi-colon desugar of e.g. ?ptr:Node -> (?ptr Node) or !ptr:Node ->
      ; (!ptr Node). Strip the prefix from the head, parse the remainder as a type,
      ; then apply the prefix's sugar (? = niche/value Maybe; ! = (Result T Err)).
      ; Bare ?Foo / !Foo never reach here (single token, handled in parse-type-name).
      (let (head0:ptr (n car))
        (when (and (!= head0 null) (= (-> head0 (unsafe/cast ptr:Node _) (_ kind)) NODE-SYM))
          (let (hs:ptr (-> head0 (unsafe/cast ptr:Node _) (_ s))
                c0:i32 (char-at hs 0))
            (when (or (= c0 63) (= c0 33))
              (let (stripped:ptr (as ptr (intern-symbol (unsafe/ptr+ (as ptr:i8 hs) 1)))
                    inner-list:ptr (make-cell stripped (n cdr) line)
                    inner:ptr (parse-type-from-node inner-list line))
                (when (= c0 63)
                  (when (= (-> inner (unsafe/cast ptr:Type _) (_ kind)) TY-PTR)
                    (return (unsafe/cast ref:Type (type-as-pkind inner PTR-MAYBE))))
                  ; Value operand: stamp the value-Maybe template (Phase F uniform ?).
                  (let (ut:?ptr:UnionTemplate (union-template-lookup "Maybe"))
                    (when (= ut null)
                      (die-at line "?T: value-Maybe template not in scope (import the prelude)"))
                    (let (argts:ptr (arena-alloc (ptr-bytes)))
                      (aset! (as ptr:ptr argts) 0 inner)
                      (return (union-template-stamp-types (as ptr ut) argts 1 line)))))
                (let (ut:?ptr:UnionTemplate (union-template-lookup "Result"))
                  (when (= ut null)
                    (die-at line "!T: (Result T E) template not in scope (import the prelude)"))
                  (let (argts:ptr (arena-alloc (* (as i64 2) (ptr-bytes))))
                    (aset! (as ptr:ptr argts) 0 inner)
                    (aset! (as ptr:ptr argts) 1 (as ptr ty-err))
                    (return (union-template-stamp-types (as ptr ut) argts 2 line)))))))))
      ; Postfix volatile: (T volatile) or (T1 T2 ... volatile). Strip the trailing
      ; 'volatile and recurse on the head, then mark volatile. Placed before ptr/fn
      ; so (ptr i32 volatile) ≡ volatile (ptr i32).
      (let (nlen:i32 (node-len n))
        (when (>= nlen 2)
          (let (last:ptr:Node (unsafe/cast ptr:Node (node-at n (- nlen 1))))
            (when (and (!= (as ptr last) null)
                       (= (last kind) NODE-SYM)
                       (= (strcmp (last s) "volatile") 0))
              (let (head-len:i32 (- nlen 1)
                    inner:ptr null)
                (if (= head-len 1)
                  (set! inner (n car))
                  (let (cur:ptr (as ptr n)
                        new-head:ptr null
                        new-tail:ptr null
                        i:i32 0)
                    (while (< i head-len)
                      (let (cell:ptr (make-cell ((unsafe/cast ptr:Node cur) car) null line))
                        (when (= new-head null) (set! new-head cell))
                        (when (!= new-tail null) (.set! (unsafe/cast ptr:Node new-tail) cdr cell))
                        (set! new-tail cell))
                      (set! cur ((unsafe/cast ptr:Node cur) cdr))
                      (inc! i))
                    (set! inner new-head)))
                (return (type-with-volatile (parse-type-from-node inner line))))))))
      ; Anonymous struct: (struct field:type ...) — memoized by content hash so
      ; two textually-identical shapes share one synthesized StructDef.
      (let (head:ptr (n car))
        (when (= head 'struct)
          (let (rest:ptr (n cdr)
                nfields:i32 0
                cur:ptr null)
            (set! cur rest)
            (while (!= cur null)
              (inc! nfields)
              (set! cur ((unsafe/cast ptr:Node cur) cdr)))
            (let (fnames:ptr (arena-alloc (* (as i64 nfields) 8))
                  ftypes:ptr (arena-alloc (* (as i64 nfields) 8))
                  i:i32 0)
              (set! cur rest)
              (while (!= cur null)
                (let (field:ptr ((unsafe/cast ptr:Node cur) car)
                      fname:ptr null
                      fty:ptr (extract-name-and-type field (as ptr:ptr (addr-of fname)) line))
                  (when (= fty null)
                    (die-at line (fmt-s "struct: field '%s' missing :type" fname)))
                  ; Intern so field-name pointer-equality works at access sites.
                  (aset! (as ptr:ptr fnames) i (intern-str fname))
                  (aset! (as ptr:ptr ftypes) i fty))
                (inc! i)
                (set! cur ((unsafe/cast ptr:Node cur) cdr)))
              (let (sd:ptr (lookup-or-make-anon-struct fnames ftypes nfields)
                    t:ref:Type (make-type TY-STRUCT))
                (.set! t sdef sd)
                (return t))))))
      ; Anonymous untagged union: (union member:type ...) — memoized like the
      ; anonymous struct above. Raw and unchecked (unions.md §2): reading a
      ; member other than the one last written is a reinterpretation.
      (let (head:ptr (n car))
        (when (= head 'union)
          (let (rest:ptr (n cdr)
                nfields:i32 0
                cur:ptr null)
            (set! cur rest)
            (while (!= cur null)
              (inc! nfields)
              (set! cur ((unsafe/cast ptr:Node cur) cdr)))
            (when (= nfields 0)
              (die-at line "union: at least one member required"))
            (let (fnames:ptr (arena-alloc (* (as i64 nfields) (ptr-bytes)))
                  ftypes:ptr (arena-alloc (* (as i64 nfields) (ptr-bytes)))
                  i:i32 0)
              (set! cur rest)
              (while (!= cur null)
                (let (field:ptr ((unsafe/cast ptr:Node cur) car)
                      fname:ptr null
                      fty:ptr (extract-name-and-type field (as ptr:ptr (addr-of fname)) line))
                  (when (= fty null)
                    (die-at line (fmt-s "union: member '%s' missing :type" fname)))
                  (aset! (as ptr:ptr fnames) i (intern-str fname))
                  (aset! (as ptr:ptr ftypes) i fty))
                (inc! i)
                (set! cur ((unsafe/cast ptr:Node cur) cdr)))
              (let (sd:ptr (lookup-or-make-anon-union fnames ftypes nfields)
                    t:ref:Type (make-type TY-UNION))
                (.set! t sdef sd)
                (return t))))))
      ; Stage 11: a parameterized defstruct use — (Vector i32), (HashMap K V) —
      ; in type position stamps (and memoizes) a concrete monomorphic instance
      ; (parametric-structs.md §3). The colon-sugar composes for free: ptr:T and
      ; (ref ...) reach here through the recursion above / the ptr/ref branches
      ; below with the inner (Vector i32) parsed via this same routine.
      (let (head:ptr:Node (unsafe/cast ptr:Node (n car)))
        (when (and (!= (as ptr head) null) (= (head kind) NODE-SYM))
          (let (st:ptr (struct-template-lookup (head s)))
            (when (!= st null)
              (return (struct-template-stamp st (as ptr n) line))))))
      ; A parameterized defunion use: (Result A B) stamps (and memoizes) a
      ; concrete instance of the template (unions.md §5). `Maybe` is excluded —
      ; it has bespoke handling below (one spelling, two layouts: niche pointer
      ; for (Maybe (ref T)), value stamp otherwise).
      (let (head:ptr:Node (unsafe/cast ptr:Node (n car)))
        (when (and (!= (as ptr head) null)
                   (= (head kind) NODE-SYM) (!= (head s) "Maybe"))
          (let (ut:ptr (union-template-lookup (head s)))
            (when (!= ut null)
              (return (union-template-stamp ut (as ptr n) line))))))
      ; Check for pointer constructor: (ptr T) or (ptr ptr T) ...
      (let (head:ptr (n car))
        (when (= head 'ptr)
          (let (rest:ptr (n cdr))
            (when (= rest null) (return ty-ptr))
            ; AT-1: (ptr :volatile T) — a volatile *pointee* (C's `volatile T *`,
            ; the MMIO case). The keyword moves inside the constructor and marks
            ; the element type, not the pointer slot.
            (let (vflags:i32 0)
              (set! rest (parse-decl-attrs rest (as ptr:i32 (addr-of vflags)) line))
              (when (= rest null)
                (die-at line "ptr: element type required after attribute -- (ptr :volatile T)"))
              (let (elem:ptr null)
                (if (= ((unsafe/cast ptr:Node rest) cdr) null)
                  (set! elem (parse-type-from-node ((unsafe/cast ptr:Node rest) car) line))
                  (set! elem (parse-type-from-node rest line)))
                (when (!= (bit-and vflags DECL-ATTR-VOLATILE) 0)
                  (set! elem (as ptr (type-with-volatile (unsafe/cast ref:Type elem)))))
                (let (pt:ref:Type (make-type TY-PTR))
                  (.set! pt elem elem)
                  ; Phase F flip: (ptr T) is now non-null, same as (ref T).
                  (.set! pt pkind PTR-REF)
                  (return pt)))))))
      ; Stage 10 Phase F: (raw T) — a nullable, unchecked pointer to T (today's
      ; raw `(ptr T)` behavior). The blessed spelling for C-boundary and
      ; deliberately-nullable pointers once the flip makes bare `ptr` non-null.
      (let (head:ptr (n car))
        (when (= head 'raw)
          (let (rest:ptr (n cdr))
            (when (= rest null)
              (die-at line "raw: element type required — (raw T)"))
            ; AT-1: (raw :volatile T) — volatile pointee on a nullable pointer.
            (let (vflags:i32 0)
              (set! rest (parse-decl-attrs rest (as ptr:i32 (addr-of vflags)) line))
              (when (= rest null)
                (die-at line "raw: element type required after attribute -- (raw :volatile T)"))
              (let (elem:ptr null)
                (if (= ((unsafe/cast ptr:Node rest) cdr) null)
                  (set! elem (parse-type-from-node ((unsafe/cast ptr:Node rest) car) line))
                  (set! elem (parse-type-from-node rest line)))
                (when (!= (bit-and vflags DECL-ATTR-VOLATILE) 0)
                  (set! elem (as ptr (type-with-volatile (unsafe/cast ref:Type elem)))))
                (let (pt:ref:Type (make-type TY-PTR))
                  (.set! pt elem elem)
                  (.set! pt pkind PTR-RAW)
                  (return pt)))))))
      ; Stage 10: (ref T) — a non-null pointer to T. Same shape as (ptr T)
      ; (colon sugar ref:T arrives here too), but the element is required.
      (let (head:ptr (n car))
        (when (= head 'ref)
          (let (rest:ptr (n cdr))
            (when (= rest null)
              (die-at line "ref: element type required — (ref T)"))
            ; AT-1: (ref :volatile T) — volatile pointee on a non-null pointer.
            (let (vflags:i32 0)
              (set! rest (parse-decl-attrs rest (as ptr:i32 (addr-of vflags)) line))
              (when (= rest null)
                (die-at line "ref: element type required after attribute -- (ref :volatile T)"))
              (let (elem:ptr null)
                (if (= ((unsafe/cast ptr:Node rest) cdr) null)
                  (set! elem (parse-type-from-node ((unsafe/cast ptr:Node rest) car) line))
                  (set! elem (parse-type-from-node rest line)))
                (when (!= (bit-and vflags DECL-ATTR-VOLATILE) 0)
                  (set! elem (as ptr (type-with-volatile (unsafe/cast ref:Type elem)))))
                (let (pt:ref:Type (make-type TY-PTR))
                  (.set! pt elem elem)
                  (.set! pt pkind PTR-REF)
                  (return pt)))))))
      ; Stage 10: (Maybe X) — one spelling, two layouts (errors.md §10 / E2).
      ;   (Maybe (ref T)) keeps the N1 niche-encoded pointer (null = none);
      ;   (Maybe T) for any other T stamps the two-arm {tag, T} value union from
      ;   the prelude template. Value-Maybe is eliminated with `match` and built
      ;   with `make` / return-position target typing.
      (let (head:ptr (n car))
        (when (= head 'Maybe)
          (let (rest:ptr (n cdr))
            (when (= rest null)
              (die-at line "Maybe: payload type required — (Maybe T) or (Maybe (ref T))"))
            (let (inner:ptr null)
              (if (= ((unsafe/cast ptr:Node rest) cdr) null)
                (set! inner (parse-type-from-node ((unsafe/cast ptr:Node rest) car) line))
                (set! inner (parse-type-from-node rest line)))
              ; Pointer payload that is non-null (ref T): niche-encode in place.
              (when (and (= (-> inner (unsafe/cast ptr:Type _) (_ kind)) TY-PTR)
                         (= (ptr-pkind inner) PTR-REF))
                (return (unsafe/cast ref:Type (type-as-pkind inner PTR-MAYBE))))
              ; Any other payload: stamp the value-Maybe template.
              (let (ut:?ptr:UnionTemplate (union-template-lookup "Maybe"))
                (when (= ut null)
                  (die-at line "(Maybe T): value-Maybe template not in scope (import the prelude)"))
                (let (argts:ptr (arena-alloc (ptr-bytes)))
                  (aset! (as ptr:ptr argts) 0 inner)
                  (return (union-template-stamp-types (as ptr ut) argts 1 line))))))))
      ; Stage 13 TE-5: (BoxedFn (param-types…) ret) — the shared fat pointer
      ; (TE-1) specialised to the Fn family (design/stage13/type-erasure.md). Each
      ; signature is a distinct {data,vtable} instance type. Additive: no existing
      ; spelling reaches here, so the bootstrap stays byte-identical.
      (let (head:ptr (n car))
        (when (= head 'BoxedFn)
          (let (plist-node:ptr (n cdr))
            (when (or (= plist-node null)
                      (= ((unsafe/cast ptr:Node plist-node) cdr) null))
              (die-at line "BoxedFn: expects (BoxedFn (param-types…) ret)"))
            (let (params-list:ptr ((unsafe/cast ptr:Node plist-node) car)
                  ret-node:ptr (-> plist-node (unsafe/cast ptr:Node _) (_ cdr) (unsafe/cast ptr:Node _) (_ car))
                  num-p:i32 0
                  cur:ptr null)
              (set! cur params-list)
              (while (!= cur null) (inc! num-p) (set! cur ((unsafe/cast ptr:Node cur) cdr)))
              (let (param-arr:ptr (if (> num-p 0)
                                    (arena-alloc (* (as i64 num-p) (ptr-bytes)))
                                    (as ptr null))
                    pi:i32 0)
                (set! cur params-list)
                (while (!= cur null)
                  (aset! (as ptr:ptr param-arr) pi
                         (parse-type-from-node ((unsafe/cast ptr:Node cur) car) line))
                  (inc! pi)
                  (set! cur ((unsafe/cast ptr:Node cur) cdr)))
                (let (ret-ty:ptr (parse-type-from-node ret-node line))
                  (return (boxedfn-type param-arr num-p ret-ty line))))))))
      ; Stage 13 TE-6: (dyn P) — the shared fat pointer (TE-1) erasing a value of
      ; an arbitrary single user protocol P via nominal `extend` conformance
      ; (design/stage13/type-erasure.md "Instantiation B"). P must be a bare
      ; protocol symbol (parametric `(dyn (Seq E))` is deferred). The protocol is
      ; NOT resolved here — union-registry is imported before the protocol registry
      ; — only its name is stored; validation fires at box-construction time.
      ; Additive: no existing spelling reaches here, so the bootstrap stays
      ; byte-identical.
      (let (head:ptr (n car))
        (when (= head 'dyn)
          (let (rest:ptr (n cdr))
            (when (or (= rest null) (= ((unsafe/cast ptr:Node rest) car) null))
              (die-at line "(dyn P): expects (dyn Protocol)"))
            (let (pnode:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node rest) car)))
              (when (!= (pnode kind) NODE-SYM)
                (die-at line "(dyn P): protocol must be a bare symbol (parametric protocols are not boxable)"))
              (return (dyn-type (pnode s) line))))))
      ; Check for function pointer type: ((fn ret) (param-types...))
      (let (head:ptr (n car))
        (when (!= head null)
          ; Head is a list (fn ret-type) — function pointer with params
         (when (= ((unsafe/cast ptr:Node head) kind) NODE-CELL)
           (let (fn-head:ptr ((unsafe/cast ptr:Node head) car))
             (when (= fn-head 'fn)
                ; Parse return type from (fn ret-type)
                (let (ret-node:ptr ((unsafe/cast ptr:Node head) cdr)
                      ret-type:ptr ty-void)
                  (when (and (!= ret-node null)
                             (!= ((unsafe/cast ptr:Node ret-node) car) null))
                    (set! ret-type (parse-type-from-node ((unsafe/cast ptr:Node ret-node) car) line)))
                  ; Parse parameter types from the second element (param-types...)
                  (let (params-node:ptr (n cdr)
                        num-p:i32 0
                        param-arr:ptr null
                        is-va:i32 0)
                    (when (!= params-node null)
                      (let (plist:ptr ((unsafe/cast ptr:Node params-node) car))
                        (when (!= plist null)
                          ; Count params
                          (let (cur:ptr plist
                                count:i32 0)
                            (while (!= cur null)
                              (inc! count)
                              (set! cur ((unsafe/cast ptr:Node cur) cdr)))
                            (set! num-p count)
                            (set! param-arr (arena-alloc (* (as i64 count) (ptr-bytes))))
                            ; Parse each param type
                            (set! cur plist)
                            (let (pi:i32 0)
                              (while (!= cur null)
                                (aset! (as ptr:ptr param-arr) pi
                                       (parse-type-from-node ((unsafe/cast ptr:Node cur) car) line))
                                (inc! pi)
                                (set! cur ((unsafe/cast ptr:Node cur) cdr))))))))
                    (let (ft:ref:Type (make-type TY-FN))
                      (.set! ft ret ret-type)
                      (type-set-params ft param-arr num-p)
                      (.set! ft variadic is-va)
                      (return ft)))))))
          ; Head is a symbol "fn" — function pointer with no params: (fn ret-type)
         (when (= head 'fn)
             (let (ret-node:ptr (n cdr)
                                ret-type:ptr ty-void)
               (when (and (!= ret-node null)
                          (!= ((unsafe/cast ptr:Node ret-node) car) null))
                 (set! ret-type (parse-type-from-node ((unsafe/cast ptr:Node ret-node) car) line)))
               (let (ft:ref:Type (make-type TY-FN))
                 (.set! ft ret ret-type)
                 (.set! ft params null)
                 (.set! ft num-params 0)
                 (.set! ft variadic 0)
                 (return ft)))))))
    (die-at line "unable to parse type expression"))))

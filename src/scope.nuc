; Symbol table, string-literal table, and codegen helpers, source-imported by
; src/nucleusc.nuc. Extracted from nucleusc.nuc (Stage 12 N8). Imported BEFORE
; abi.nuc/union-registry.nuc because abi.nuc calls scope-define/new-tmp; the one
; codegen helper that itself needs abi (macro-jit-ensure-decl) is kept in
; nucleusc.nuc to break the import cycle. Depends on: compiler-types.nuc
; (Scope/Sym/StrLit/ProgDefn structs), the g-* codegen globals, make-vec, and
; libc — all already in scope at the import point in nucleusc.nuc.

; ============================================================
; Symbol table
; ============================================================

(import-use nucleus.string)
(import-use nucleus.arena)
(import-use nucleus.create)
(import-use nucleus.vector)
(import-use nucleus.intern)
(import-use nucleus.strview)
(import-use nucleus.hashmap)
(import-use nucleus.intern-str)
(defn scope-new (parent:?&Scope):&Scope
  (let (s:&Scope (new Scope g-arena)
        cs:&(Vector &Cleanup) (new (Vector &Cleanup) g-arena))
    (set! (s 'parent) parent)
    (set! (s 'cleanup-slots) cs)
    (return s)))

(defn scope-define (s:&Scope name:Symbol type:?&Type ir-name:StrView is-local:i32):&Sym
  (when (!= (s 'parent) null) (refuse-qualified-binder name g-form-line))
  (let (sc:&Scope s)
    ; Stage 12: globals are keyed by their fully-qualified name. The global scope
    ; is the unique null-parent scope; local scopes (params, let bindings) always
    ; have a parent and keep their raw names. Under the default `user` namespace,
    ; qualify-name returns the bare name unchanged, so the key — and the whole
    ; bootstrap — is byte-identical. Only the lookup KEY (`name`) is qualified;
    ; `ir-name` is untouched (mangling is a separate, later concern).
    ; Stage 15 W5e: a *private* definer in the default `user` namespace is keyed
    ; under its file's implicit namespace (`#p1/helper`), so two files may each
    ; define a private `helper`. priv-key-define is the identity whenever no
    ; private definer is active — which is every definition in this compiler's
    ; own source — so the key, and the bootstrap, are unchanged.
    (when (= (sc 'parent) null)
      (set! name (qualify-name (priv-key-define name))))
    (when (= (sc 'len) (sc 'cap))
      (let (nc:i32 8)
        (when (!= (sc 'cap) 0) (set! nc (* (sc 'cap) 2)))
        (let (ns:ptr (arena-alloc (* nc (sizeof Sym))))
          (when (!= (sc 'len) 0)
            (memcpy ns (sc 'syms) (* (sc 'len) (sizeof Sym))))
          (set! (sc 'syms) ns)
          (set! (sc 'cap) nc))))
    (let (sym:&Sym (as &Sym (unsafe/ptr+ (unsafe/cast &Sym (sc 'syms)) (sc 'len))))
      (set! (sym 'name) name)
      (set! (sym 'type) type)
      (set! (sym 'ir-name) ir-name)
      (set! (sym 'is-local) is-local)
      (set! (sym 'home) s)
      (set! (sc 'len) (+ (sc 'len) 1))
      (when (= (as ptr sc) (as ptr g-globals)) (assoc g-globals-index name (- (sc 'len) 1)))
      (return sym))))

; Hide every binding of IR symbol `ir`. A Sym is never removed: its address may
; already be held, so the key is changed to one no source spelling can reach.
(defn scope-unbind-ir (sc:&Scope ir:StrView):void
  (dotimes (i (sc 'len))
    (let (sym:&Sym (as &Sym (unsafe/ptr+ (unsafe/cast &Sym (sc 'syms)) i)))
      (when (= (sym 'ir-name) ir)
        (set! (sym 'name) (symbol-intern "#unbound"))))))

; Where a global was defined, for the REPL's `locate`. Called only by the
; Nucleus definers: an `extern`, a C-header import and a prelude registration
; genuinely have no source line here, and `locate` says so rather than blaming
; whichever file was being compiled when they were registered.
(defn sym-record-src (sym:&Sym line:i32):void
  (set! (sym 'src-file) g-source-path)
  (set! (sym 'src-line) line))

; One frame of the chain, scanned newest-first (`scope-define` appends, so the
; backwards scan is what makes a redefinition shadow its predecessor — see the
; DEFVAR-REACHED note in nucleusc.nuc). `key` is already final: no qualification,
; no environment, no privacy rule. Extracted in Stage 15 B2b so the *policy*
; (which keys to try, and whether a private symbol counts) lives in one place
; and the *scan* in another.
; The global frame's newest slot per key, so a reference probe costs O(1) — a
; namespaced unit probes each flattened namespace. A hit is verified: a Sym may be
; re-keyed in place, and a REPL rollback truncates the frame.
(defvar g-globals-index:&(HashMap Symbol i32) (new (HashMap Symbol i32) g-arena))

; The indexed answer for the global frame: 1 found at `*out`, 0 absent, -1 unknown.
(defn globals-index-find (sc:ptr:Scope key:Symbol public:bool out:&?&Sym):i32
  (match (get g-globals-index key)
    (none (return 0))
    ((some i)
      (when (>= i (sc 'len)) (return -1))
      (let (sym:&Sym (as &Sym (unsafe/ptr+ (unsafe/cast &Sym (sc 'syms)) i)))
        (when (or (!= (sym 'name) key) (and public (!= (sym 'sym-private) 0))) (return -1))
        (set! (deref out) (as ptr sym))
        (return 1)))))

(defn scope-frame-find (sc:ptr:Scope key:Symbol):?&Sym
  (when (= (as ptr sc) (as ptr g-globals))
    (let (hit:?&Sym null
          r:i32 (globals-index-find sc key false &hit))
      (when (= r 1) (return hit))
      (when (= r 0) (return null))))
  (let (i:i32 (- (sc 'len) 1))
    (while (>= i 0)
      (let (sym:&Sym (as &Sym (unsafe/ptr+ (unsafe/cast &Sym (sc 'syms)) i)))
        (when (= (sym 'name) key)
          (return (as ptr sym))))
      (set! i (- i 1))))
  (return null))

; The newest global bound to IR symbol `ir`, whatever its key.
(defn scope-frame-find-ir (sc:ptr:Scope ir:StrView):?&Sym
  (let (i:i32 (- (sc 'len) 1))
    (while (>= i 0)
      (let (sym:&Sym (as &Sym (unsafe/ptr+ (unsafe/cast &Sym (sc 'syms)) i)))
        (when (= (sym 'ir-name) ir) (return (as ptr sym))))
      (set! i (- i 1))))
  (return null))

; The same scan, restricted to public symbols. Stage 15 B2b: this is where
; `inject-import-aliases`' `sym-private` filter went. A name reached through
; another file's namespace — a bound prefix, or a namespace this file flattened —
; must not see that file's private definitions; a name reached through the
; file's OWN namespace must.
(defn scope-frame-find-public (sc:ptr:Scope key:Symbol):?&Sym
  (when (= (as ptr sc) (as ptr g-globals))
    (let (hit:?&Sym null
          r:i32 (globals-index-find sc key true &hit))
      (when (= r 1) (return hit))
      (when (= r 0) (return null))))
  (let (i:i32 (- (sc 'len) 1))
    (while (>= i 0)
      (let (sym:&Sym (as &Sym (unsafe/ptr+ (unsafe/cast &Sym (sc 'syms)) i)))
        (when (and (= (sym 'name) key) (= (sym 'sym-private) 0))
          (return (as ptr sym))))
      (set! i (- i 1))))
  (return null))

; Resolve a source REFERENCE — a name as written in the file being compiled.
; Local frames match the raw name, so a local binding shadows a global before
; the qualifier is ever considered; the global frame is handed to
; `globals-lookup-ref` (src/nucleusc.nuc), which is the one place the file's
; import environment decides what a spelling may reach.
;
; Stage 15 B2b (name-resolution.md §9.2, §12.1): this is the reference half of
; what used to be one function. The key half is `scope-lookup-key` below. Do not
; route an already-canonical `g-globals` key through here — the file that reads
; such a key is routinely not the file that wrote it, and a reference resolver
; would refuse it.
(defn scope-lookup (s:?&Scope name:Symbol):?&Sym
  (let (cur:?&Scope s)
    (while (!= cur null)
      (let (sc:?&Scope cur)
        (when (= (sc 'parent) null)
          (return (globals-lookup-ref sc name)))
        (let (hit:?&Sym (scope-frame-find sc name))
          (when (!= hit null) (return hit)))
        (set! cur (sc 'parent)))))
  (return null))

; Look up an already-canonical KEY: a name this compiler computed and is about
; to write into `g-globals`, or has already written there. Definition-side
; existence checks (`extern`/`deferror` dedup, the `.nuch` declare replay, the C
; header registrar, the REPL's redefinition bookkeeping) all ask this question,
; and asking the reference question instead would be wrong in both directions —
; a bare definer name would additionally probe every flattened namespace and
; report an *imported* symbol as a redefinition.
;
; This is the pre-B1 `scope-lookup` body verbatim: `qualify-name(priv-key-use …)`
; on the global frame, the raw name on every inner one. Identity under `user`,
; which is why the bootstrap does not move.
(defn scope-lookup-key (s:&Scope name:Symbol):?&Sym
  (let (cur:?&Scope s)
    (while (!= cur null)
      (let (sc:?&Scope cur
            ; Stage 12: the global scope (the unique null-parent scope) keys its
            ; symbols by fully-qualified name. Stage 15 W5e: a name this file
            ; declared with a private definer keys under the file's own implicit
            ; namespace, and `priv-key-use` is the identity when it owns none.
            key:Symbol name)
        (when (= (sc 'parent) null)
          (set! key (qualify-name (priv-key-use name))))
        (let (hit:?&Sym (scope-frame-find sc key))
          (when (!= hit null) (return hit)))
        (set! cur (sc 'parent)))))
  (return null))

; Stage 10 Phase F1: after emitting a call to a `noreturn` callee in statement
; position, control cannot fall through. If the current block is not already
; terminated, close it with `unreachable` and set g-block-term so (a) LLVM sees
; a single terminator and (b) emit-cond's narrowing accumulation treats the
; guard body as terminated — narrowing the tested binding past the guard. No-op
; once a terminator (return/goto/trap) has already been emitted into the block.
(defn terminate-after-noreturn ():void
  (when (= g-block-term 0)
    (emit g-body-stream "  unreachable\n")
    (set! g-block-term 1)))

; Record an armed Cleanup* on a scope, fired at scope exit (and on each early
; return that unwinds past it) by emit-scope-cleanups, in reverse order.
(defn scope-push-cleanup (s:&Scope slot:ptr):void
  (let (sc:&Scope s)
    (conj (sc 'cleanup-slots) (unsafe/cast &Cleanup slot))))

; ============================================================
; String literal table
; ============================================================

; The id is the element's position in g-strs; each StrLit is individually
; arena-allocated and its pointer appended in order.
(defn intern-string (sv:StrView):i32
  (let (p:&StrView &sv
        id:i32 (unsafe/cast i32 (count g-strs))
        sl:&StrLit (new StrLit g-arena))
    (set! (sl 'bytes) (strview (unsafe/cast &ui8
                                 (arena-bytes (as ptr (p 'data)) (p 'len)))
                               (p 'len)))
    (set! (sl 'len) (unsafe/cast i32 (p 'len)))
    (set! (sl 'id) id)
    (conj g-strs sl)
    (return id)))

; Drop everything a compile-time module's body interned, once that module has
; been assembled — the program's own ids are unmoved because they are all below
; `n` (design/stage20-macros/string-table-per-module.md §3).
(defn strs-truncate-to (n:i32):void
  (while (> (unsafe/cast i32 (count g-strs)) n)
    (remove-at g-strs (as usize (- (unsafe/cast i32 (count g-strs)) 1)))))

; ============================================================
; Codegen helpers
; ============================================================

(defn new-tmp ():StrView
  (let (r:StrView (fstr "%t" g-tmp))
    (inc! g-tmp)
    (return r)))

(defn new-label-id ():i32
  (let (r:i32 g-label)
    (inc! g-label)
    (return r)))

; The emission buffers are process-wide and initialised once, lazily: the header
; modes never open a module, so `open-module-streams` is not a point every path
; passes through.
(defvar g-emit-buffers-ready:i32 0)

; Park a `String` in the arena so a `FnState` can hold it — see the field
; comment in compiler-types.nuc for why the field cannot be the value itself.
(defn string-box (v:&String):&String
  (let (p:&String (unsafe/cast &String (arena-alloc (sizeof String))))
    (set! (p 'bytes) (v 'bytes))
    (return p)))

; The three module buffers, emptied together. Was three `free`s of the
; memstream `bufp`s, which is why it reads as one step at seven call sites.
(defn clear-module-buffers ():void
  (string-clear g-type-stream)
  (string-clear g-decl-stream)
  (string-clear g-def-buf))

(defn ensure-emit-buffers ():void
  (when (= g-emit-buffers-ready 0)
    (set! g-entry-stream (make String))
    (set! g-body-stream (make String))
    (set! g-type-stream (make String))
    (set! g-decl-stream (make String))
    (set! g-def-buf (make String))
    (set! g-repl-preamble (make String))
    (set! g-emit-buffers-ready 1)))

(defn reset-function-state ():void
  (set! g-tmp 0)
  (set! g-label 0)
  (set! g-block-term 0)
  (set! g-lbl-tbl (new (Vector &LabelEntry) g-arena))
  (set! g-cur-fname "")
  (set! g-fn-ret-abi null)
  (set! g-fn-sret-name "")
  (set! g-fn-ret-type null)
  (set! g-init-fn-active 0)
  (set! g-loop-depth 0)
  (set! g-nundo (new (Vector &NarrowUndo) g-arena))
  (inc! g-narrow-gen-next)
  (set! g-narrow-gen g-narrow-gen-next)
  (ensure-emit-buffers)
  (string-clear g-entry-stream)
  (string-clear g-body-stream))

; Stage 16 (design/stage16-ergonomics/macrolet.md §5.2). Snapshot the state a
; nested emission is about to destroy. `macrolet` compiles a macro body while a
; function is mid-emission, which the mono-worklist answer ("emit a function on
; demand from a call site" -> defer to a drain) cannot serve: the macro must
; exist before the body it scopes over is emitted.
;
; Snapshot only — it does NOT call `reset-function-state`. The nested emission
; does that itself (compile-macro-body opens its own entry/body streams), and
; resetting here as well would clear the buffer the outer function is using.
;
; Kept adjacent to `reset-function-state` deliberately — a global added there
; and not here is the drift this placement exists to make obvious.
(defn push-function-state ():&FnState
  (let (s:&FnState (new FnState g-arena))
    (set! (s 'tmp) g-tmp)
    (set! (s 'label) g-label)
    (set! (s 'block-term) g-block-term)
    (set! (s 'lbl-tbl) g-lbl-tbl)
    (set! (s 'cur-fname) g-cur-fname)
    (set! (s 'fn-ret-abi) g-fn-ret-abi)
    (set! (s 'fn-sret-name) g-fn-sret-name)
    (set! (s 'fn-ret-type) g-fn-ret-type)
    (set! (s 'loop-depth) g-loop-depth)
    (set! (s 'nundo) g-nundo)
    (set! (s 'narrow-gen) g-narrow-gen)
    ; A MOVE, not a copy: the nested emission calls `reset-function-state`,
    ; which would clear the outer function's buffer if it were still installed.
    (set! (s 'entry-stream) (string-box g-entry-stream))
    (set! (s 'body-stream) (string-box g-body-stream))
    (set! g-entry-stream (make String))
    (set! g-body-stream (make String))
    (set! (s 'abi-gpr-left) g-abi-gpr-left)
    (set! (s 'abi-fpr-left) g-abi-fpr-left)
    (set! (s 'abi-varargs) g-abi-varargs)
    (set! (s 'want-type) g-want-type)
    (set! (s 'form-line) g-form-line)
    (return s)))

; Restore what push-function-state saved. The nested emission is responsible for
; closing and freeing the entry/body streams `reset-function-state` opened for
; it (emit-defmacro's body compiler already does); this only re-points the
; globals at the outer function's still-open pair.
(defn pop-function-state (s:&FnState):void
  (set! g-tmp (s 'tmp))
  (set! g-label (s 'label))
  (set! g-block-term (s 'block-term))
  (set! g-lbl-tbl (s 'lbl-tbl))
  (set! g-cur-fname (s 'cur-fname))
  (set! g-fn-ret-abi (s 'fn-ret-abi))
  (set! g-fn-sret-name (s 'fn-sret-name))
  (set! g-fn-ret-type (s 'fn-ret-type))
  (set! g-loop-depth (s 'loop-depth))
  (set! g-nundo (s 'nundo))
  (set! g-narrow-gen (s 'narrow-gen))
  (drop &g-entry-stream)
  (drop &g-body-stream)
  (set! g-entry-stream (deref (unsafe/cast &String (s 'entry-stream))))
  (set! g-body-stream (deref (unsafe/cast &String (s 'body-stream))))
  (set! g-abi-gpr-left (s 'abi-gpr-left))
  (set! g-abi-fpr-left (s 'abi-fpr-left))
  (set! g-abi-varargs (s 'abi-varargs))
  (set! g-want-type (s 'want-type))
  (set! g-form-line (s 'form-line)))

; True while codegen is redirected into a macro/compile-time JIT module rather
; than the main program module (g-decl-out is swapped away from g-decl-stream).
(defn in-jit-module ():i32
  (return (if (!= (as ptr g-decl-out) (as ptr &g-decl-stream)) 1 0)))

; Stage 20 L1: is a byte offset taken now an offset into the program's own
; definition buffer? `g-out` is also pointed at a macro/CT module's private
; stream, at an `import-ct` sink, and at the REPL's per-entry buffers, and an
; offset recorded against any of those is garbage a mirror would splice into a
; JIT module (design/stage20-macros/macro-call-linking.md §5.1).
(defn ct-span-recordable ():i32
  (when (= (as ptr g-out) null) (return 0))
  (when (!= (as ptr g-out) (as ptr g-def-stream-program)) (return 0))
  (when (!= (as ptr g-def-stream-program) (as ptr &g-def-buf)) (return 0))
  (return 1))

; §3.1 condition 1: is `path` a file under the library root this invocation
; resolved the prelude through? A directory prefix, so a root of `lib` does not
; claim `libfoo/x.nuc`. Spelling only — §3.5 edge 5 accepts that a symlinked or
; `..`-containing path may not match, because the failure direction is 0, which
; mirrors rather than binding the wrong function.
(defn path-under-ct-lib-root (path:Symbol):i32
  (when (symbol-none? g-ct-lib-root) (return 0))
  (when (symbol-none? path) (return 0))
  (let (rn:usize (symbol-len g-ct-lib-root))
    (when (= rn 0) (return 0))
    (when (<= (symbol-len path) rn) (return 0))
    (when (!= (symbol-byte-at path rn) 47) (return 0))
    (when (= (strview-has-prefix (symbol-as-view path)
                                 (symbol-as-view g-ct-lib-root))
             false)
      (return 0))
    (return 1)))

; The captured ProgDefn for an emitted @symbol, or null. Membership was by
; content and is now one `icmp`: C7-4b interned the ir-name substrate, which is
; what made content and identity the same question.
(defn program-defn-lookup (irn:Symbol):?&ProgDefn
  (dotimes (i (unsafe/cast i32 (count g-program-defns)))
    (let (pd:&ProgDefn (invoke g-program-defns i:usize))
      (when (= (pd 'ir-name) irn)
        (return pd))))
  (return null))

; Record a program-defined function's signature so macro/CT JIT modules can
; reproduce its declare. Idempotent by ir-name. Only main-module defns are
; recorded — a defn emitted *inside* a CT/macro JIT module already lives in that
; module, so re-declaring it there is a redefinition error.
;
; Stage 20 L1: also opens the `define`'s byte span, so it must be called with
; `g-out` positioned at the byte `define` is about to land on. Returns the fresh
; record — null whenever it declined, which is exactly when nothing may write
; `ir-end` (a second emission of one ir-name must not pair its end with the
; first's start).
(defn program-defn-record (irn:Symbol ret:?&Type ptypes:ptr nparams:i32 variadic:i32):?&ProgDefn
  (when (!= (in-jit-module) 0) (return null))
  (when (symbol-none? irn) (return null))
  (when (!= (as ptr (program-defn-lookup irn)) null) (return null))
  (let (pd:&ProgDefn (new ProgDefn g-arena))
    (set! (pd 'ir-name) irn)
    (set! (pd 'ret) ret)
    (set! (pd 'ptypes) ptypes)
    (set! (pd 'nparams) nparams)
    (set! (pd 'variadic) variadic)
    (set! (pd 'from-lib) (path-under-ct-lib-root g-source-path))
    (set! (pd 'ir-start) (if (!= (ct-span-recordable) 0)
                           (byte-len &g-def-buf)
                           (as usize 0)))
    (set! (pd 'ir-end) (as usize 0))
    (conj g-program-defns pd)
    (return pd)))

; Close the span `program-defn-record` opened. Re-asks the guard rather than
; testing `ir-start`, which is legitimately 0 for the first defn in the buffer.
(defn program-defn-note-end (pd:?&ProgDefn):void
  (when (= (as ptr pd) null) (return))
  (when (= (ct-span-recordable) 0) (return))
  (set! ((unsafe/cast &ProgDefn pd) 'ir-end) (byte-len &g-def-buf)))

; Stage 20 L6, the `defvar` half of the three above. Same contract in every
; respect: idempotent by ir-name, null when it declined, and `ir-start ==
; ir-end == 0` is the only "no span" test.
(defn program-global-lookup (irn:Symbol):?&ProgGlobal
  (dotimes (i (unsafe/cast i32 (count g-program-globals)))
    (let (pg:&ProgGlobal (invoke g-program-globals i:usize))
      (when (= (pg 'ir-name) irn)
        (return pg))))
  (return null))

(defn program-global-record (irn:Symbol is-const:i32):?&ProgGlobal
  (when (!= (in-jit-module) 0) (return null))
  (when (symbol-none? irn) (return null))
  (when (!= (as ptr (program-global-lookup irn)) null) (return null))
  (let (pg:&ProgGlobal (new ProgGlobal g-arena))
    (set! (pg 'ir-name) irn)
    (set! (pg 'ty-ir) (symbol-none))
    (set! (pg 'is-const) is-const)
    (set! (pg 'from-lib) (path-under-ct-lib-root g-source-path))
    (set! (pg 'ir-start) (if (!= (ct-span-recordable) 0)
                           (byte-len &g-def-buf)
                           (as usize 0)))
    (set! (pg 'ir-end) (as usize 0))
    (conj g-program-globals pg)
    (return pg)))

; `ty-ir` is taken here rather than at record time because `type-to-ir` may
; register a struct body in `g-type-stream`, and calling it early would reorder
; that stream against the constant renderer's own types.
(defn program-global-note-end (pg:?&ProgGlobal ty-ir:StrView):void
  (when (= (as ptr pg) null) (return))
  (set! ((unsafe/cast &ProgGlobal pg) 'ty-ir) (symbol-intern ty-ir))
  (when (= (ct-span-recordable) 0) (return))
  (set! ((unsafe/cast &ProgGlobal pg) 'ir-end) (byte-len &g-def-buf)))

; Nucleus self-hosted compiler
; Reads a .nuc source file and emits textual LLVM IR to stdout.

(import-use "stdio.h")
(import-use "string.h")
(import-use "ctype.h")
(import-use "unistd.h")
(import-use llvm)

; REPL shim FFI — declared up-front because reader.nuc and emit-* sites in
; this file call repl_throw on errors when running under the REPL. The
; implementations live in src/repl_shim.c; the rest of the REPL is in
; src/repl.nuc, source-imported below.
(declare repl_try ():i32)
(declare repl_throw ():void)
(declare repl_print_f64 (ptr):void)
(declare repl_print_f32 (ptr):void)

(extern stderr:ptr)
(extern stdout:ptr)
(extern stdin:ptr)

(import-use compiler-types)

; ============================================================
; Global variables
; ============================================================

; g-arena, g-arena-used, g-arena-cap are defined by lib/arena.nuc.

(defvar g-source-path:ptr)

(defvar g-src:ptr)
(defvar g-pos:i64 0)
(defvar g-line:i32 1)

(defvar g-peek:ptr)
(defvar g-peek-valid:i32 0)

; Stage 15 W4c (design/stage15-stress-test/diagnostics.md §W4c): bracket-balance
; tracking, maintained in `next-tok` as each token is produced and consumed only
; by reader diagnostics. All four are reset at the top of `read-program`, which
; is the single entry point for reading a whole file (batch, import, and REPL
; alike); reads never interleave, so no save/restore is needed at the import
; sites that already save g-src/g-pos/g-line/g-peek.
;
; g-paren-depth counts every bracket kind the lexer knows — `(` `[` `{` `#{` —
; and is deliberately NOT clamped at zero: a negative depth at an `unexpected )`
; is exactly "this `)` has no matching open anywhere", which distinguishes a
; stray top-level `)` from a `)` that merely turned up where a form was expected
; (e.g. inside an unclosed `[…]`).
(defvar g-paren-depth:i32 0)
; Opening line of the `(` that most recently took the depth from 0 to 1 — the
; top-level form currently being read, or the last one completed.
(defvar g-form-open-line:i32 0)
; The W4c heuristic itself: line of the FIRST `(` that starts a line in column 0
; while the depth is already nonzero, plus that depth. That is the first point at
; which an earlier missing `)` became observable — a new top-level form swallowed
; by an unclosed one — and it localizes the mistake far better than the innermost
; unclosed form's own opening line. 0 means "no such line" (the imbalance is in
; the file's last top-level form), in which case no second number is reported.
(defvar g-col0-open-line:i32 0)
(defvar g-col0-open-depth:i32 0)

; Singleton types. Stage 15 W8 G-5: each is built by its own initializer rather
; than by a `types-init` pass, so the `ref:Type` on the declaration is true from
; process start instead of true-after-someone-remembers-to-call-init. They are
; the first initializers to run (source order, and this is the top of the file);
; `make-type` needs only the arena, which `arena-alloc` brings up lazily.
(defvar ty-void:ref:Type (make-type TY-VOID))
(defvar ty-i1:ref:Type   (make-type TY-I1))
(defvar ty-i8:ref:Type   (make-type TY-I8))
(defvar ty-i16:ref:Type  (make-type TY-I16))
(defvar ty-i32:ref:Type  (make-type TY-I32))
(defvar ty-i64:ref:Type  (make-type TY-I64))
; Phase F flip: bare `ptr` / the ty-ptr singleton is non-null (PTR-REF), what
; `(ref T)` means. Nullable pointers use `raw` / `(raw T)` instead.
(defvar ty-ptr:ref:Type  (make-ptr-type PTR-REF))
(defvar ty-ui8:ref:Type  (make-type TY-UI8))
(defvar ty-ui16:ref:Type (make-type TY-UI16))
(defvar ty-ui32:ref:Type (make-type TY-UI32))
(defvar ty-ui64:ref:Type (make-type TY-UI64))
(defvar ty-f32:ref:Type  (make-type TY-F32))
(defvar ty-f64:ref:Type  (make-type TY-F64))
(defvar ty-cstr:ref:Type (make-type TY-CSTR))
; Stage 11 M6 (S0): the `Char` scalar singleton — a distinct 32-bit built-in over
; `ui32` (design/stage11/string.md §"Char types"), the model for char literals.
(defvar ty-char:ref:Type (make-type TY-CHAR))
; Stage 10 Phase F: bare `raw` — a nullable, unchecked pointer singleton
; (PTR-RAW). The flip makes bare `ptr` non-null, so `raw` is the spelling that
; keeps today's raw/nullable pointer behavior; `null`'s type and C-boundary
; pointers are raw. ABI-identical to bare `ptr` (both lower to IR `ptr`).
(defvar ty-raw:ref:Type  (make-ptr-type PTR-RAW))
; Stage 10 errors: the Err scalar singleton (i32-repr, distinct kind).
(defvar ty-err:ref:Type  (make-type TY-ERR))
; Stage 10: the type of `none` — an elem-less (Maybe (ref ?)) that coerces
; into any concrete ?T slot exactly as `null` coerces into any (ptr T).
(defvar ty-maybe-ptr:ref:Type (make-ptr-type PTR-MAYBE))
; Stage 11: pointer-sized integer singletons. usize is unsigned (like C size_t),
; ssize is signed (like C ssize_t / ptrdiff_t). Both lower to i32 on ILP32
; targets and i64 on LP64 targets, tracking signedness exactly like ui*/i*.
(defvar ty-usize:ref:Type (make-type TY-USIZE))
(defvar ty-ssize:ref:Type (make-type TY-SSIZE))
; Stage 14 MC-2: cached `(raw Node)` singleton for quasiquote / plain `quote` /
; `(gensym)` results (all produce a Node*). Built lazily on first use once the
; `Node` struct is registered (see ty-raw-node); null until then.
(defvar g-ty-raw-node:ptr)

; Target descriptor. The compiler emits code for a single target, described
; here so the "a pointer is i64" assumption lives in one place instead of being
; scattered as literal 8s / i64s through codegen. Set by target-init; defaults
; describe x86_64 Linux. To target a 32-bit platform, set g-target-ptr-bytes to
; 4 (and g-target-triple accordingly) — type sizes, alignments, sizeof, and the
; size/pointer-sized integer type all follow. (The macro/CT JIT still runs on
; the host, so its target machine stays the host triple.)
(defvar g-target-triple:ptr)
(defvar g-target-ptr-bytes:i32 8)

; Stage 8 cross-compilation: g-target is the resolved Target (triple + datalayout
; + pointer size from LLVM). g-host-target is always the native platform — the
; macro/CT JIT runs in-process, so its modules use the host. g-target-triple and
; g-target-ptr-bytes (above) are derived from g-target so the rest of codegen,
; which predates the Target struct, keeps working unchanged. The override is set
; by --target=<triple>; null means "use the host".
(defvar g-target:ptr)
(defvar g-host-target:ptr)
(defvar g-target-triple-override:ptr)
; --mcpu=<cpu> override: the CPU/device name passed to LLVMCreateTargetMachine
; for the cross-target (e.g. "attiny1634"). Null => empty CPU (host default).
; Only applies to the --target override; the host target always uses "".
(defvar g-mcpu-override:ptr)
; --linker=<cmd> override: the link-driver command name/path. Null => the
; triple default (clang for hosted targets, avr-gcc for AVR). When set it wins
; regardless of triple. General flag — available for every target.
(defvar g-linker-override:ptr)
; --mmcu=<device> override: the AVR device name for the link line (-mmcu=).
; Distinct from --mcpu (the LLVM codegen CPU/family). Null => fall back to
; g-mcpu-override at link time. Consulted only on an AVR triple; ignored else.
(defvar g-mmcu-override:ptr)

; Host pointer size in bytes — the platform the compiler itself runs on, used to
; size its own arrays-of-pointers. Distinct from g-target-ptr-bytes (the
; platform being compiled *for*): when cross-compiling they differ. Initialised
; from LLVM's host target by target-init; the literal default covers allocations
; before init runs.
(defvar g-host-ptr-bytes:i32 8)

; Stage 12 namespaces (design/stage12/namespaces.md). The current compilation
; unit's namespace name (an interned CStr). The default is "user", whose globals
; are stored under *bare* keys so existing lookups (and the whole bootstrap) are
; byte-identical. A leading `(ns foo)` form sets this; it is saved/restored
; across imports (each imported unit starts in "user").
;
; G-5: declared HERE, above g-generics (below), because `build-generics` calls
; `generic-new` → `ns-ir-prefix g-current-ns` → `strcmp(g-current-ns, "user")`.
; That dependency is laundered through two calls, so G-4's syntactic
; forward-reference check cannot see it — the second of the two source reorders
; this migration needs (§2.10 predicted only the g-arena-alloc one).
(defvar g-current-ns:ptr (intern-str "user"))

; Struct registry. (Vector ptr) of StructDef* (each individually arena-allocated,
; registration order). count = number of structs; invoke = indexed access.
(defvar (g-structs (ref (Vector (ref StructDef)))) (vector-new-in (addr-of g-arena-alloc)))
; Stage 10 unions: tagged-sum registry, templates, enum tables, and the list of
; untagged-union StructDefs whose IR type definition is still pending. Union IR
; needs member sizes (for padding), and members may name structs whose fields
; are registered later in the unit — so union type defs are written lazily, by
; drain-pending-union-irs, at every module-assembly point (LLVM named types are
; order-independent within a module).
; (Vector ptr) of UnionDef* (each individually arena-allocated, registration order).
(defvar (g-uniondefs (ref (Vector (ref UnionDef)))) (vector-new-in (addr-of g-arena-alloc)))
; (Vector ptr) of UnionTemplate* (each individually arena-allocated).
(defvar (g-union-templates (ref (Vector (ref UnionTemplate)))) (vector-new-in (addr-of g-arena-alloc)))
; Stage 11 parametric structs: defstruct-template registry. Inert until a use
; `(Vector i32)` in type position fires a stamp (parametric-structs.md §1).
(defvar (g-struct-templates (ref (Vector (ref StructTemplate)))) (vector-new-in (addr-of g-arena-alloc)))
; (Vector ptr) of EnumDef* (each individually arena-allocated).
(defvar (g-enumdefs (ref (Vector (ref EnumDef)))) (vector-new-in (addr-of g-arena-alloc)))
(defvar (g-pending-unions (ref (Vector (ref StructDef)))) (vector-new-in (addr-of g-arena-alloc)))
; Stage 10 errors: the deferror descriptor table, indexed by error id (1-based;
; slot 0 reserved). Each entry is the string-table id of the name / message, so
; the table emits as arrays of `@.str.N` pointers at module assembly. Emitted
; only when at least one deferror exists or an accessor is used, so programs that
; never touch errors stay byte-identical.
; Parallel (Vector ptr) registries indexed by 1-based error id; index 0 is a
; reserved placeholder ("no error"), conj'd at init so the vector index equals the
; runtime id. Each element is a string-table id stored in the ptr slot via an
; i64↔ptr cast. The old g-deferrors-len (highest id) is (count - 1).
(defvar (g-deferror-name-sids (ref (Vector i32))) (build-deferror-sids))
(defvar (g-deferror-msg-sids (ref (Vector i32))) (build-deferror-sids))
(defvar g-err-table-used:i32 0)

; Global scope
(defvar g-globals:ref:Scope (scope-new null))

; g-arena-alloc — the shared allocator handle — is declared further down, right
; after `(import-use vector)` brings in `%AllocHandle`'s layout. Its constant
; initializer needs that layout; nothing here needs its VALUE, only its address.

; Name-kind membership sets (built by their own initializers; never dropped).
; special-form-named and primitive-type-named consult these instead of long
; string-comparison chains.
(defvar (g-special-form-set (ref (HashSet CStr))) (build-special-form-set))
(defvar (g-primitive-type-set (ref (HashSet CStr))) (build-primitive-type-set))

; Stage 15 B5: the shared binding table — one row per name-keyed registry, in
; resolution priority order. See `build-binding-kinds` (beside `emit-dispatch`)
; for the rows and for what each column's 0s mean.
(defvar (g-binding-kinds (ref (Vector (ref BindingKind)))) (build-binding-kinds))

; String literal table. (Vector ptr) of StrLit* (each individually
; arena-allocated). The interned id is the element's position, so emit sites read
; back the StrLit by `(invoke g-strs id)` and emit `@.str.<id>`.
(defvar (g-strs (ref (Vector (ref StrLit)))) (vector-new-in (addr-of g-arena-alloc)))

; Per-function codegen state
(defvar g-tmp:i32 0)
(defvar g-label:i32 0)
(defvar g-entry-stream:ptr)
(defvar g-entry-bufp:ptr)
(defvar g-entry-sizep:i64 0)
(defvar g-body-stream:ptr)
(defvar g-body-bufp:ptr)
(defvar g-body-sizep:i64 0)
(defvar g-block-term:i32 0)

; defcast registry (Stage 8). g-cast-rules is a pre-allocated array of CastRule
; (length MAX-CAST-RULES), filled by register-cast-rule from `defcast` forms.
; (Vector ptr) of CastRule* (each individually arena-allocated, registration order).
(defvar (g-cast-rules (ref (Vector (ref CastRule)))) (vector-new-in (addr-of g-arena-alloc)))

; Label/goto support (Stage 8 C-parity). g-lbl-tbl is a Vec of LabelEntry*
; (name, total occurrence count, seen-so-far) reset per function by
; reset-function-state. g-cur-fname is the @-less IR symbol of the function
; currently being emitted (for blockaddress in label-addr).
(defvar (g-lbl-tbl (ref (Vector (ref LabelEntry)))) (vector-new-in (addr-of g-arena-alloc)))
(defvar g-cur-fname:ptr)

; Aggregate return ABI of the function currently being emitted (Stage 8 Phase C).
; g-fn-ret-abi is its AbiInfo* (ABI-DIRECT for scalar/pointer returns); when the
; return is ABI-MEMORY, g-fn-sret-name is the IR name of the hidden sret pointer
; param. Both reset by reset-function-state and set in emit-defn.
(defvar g-fn-ret-abi:ptr)
(defvar g-fn-sret-name:ptr)

; --- Stage 10 safety: per-function checking state ---
; Declared return Type* of the function being emitted (pointer-kind check on
; `return`); the loop-nesting depth and the narrowing undo stack (see the
; "flow narrowing" section); whether `declare void @llvm.trap()` has been
; written to the decl stream (lazy, used by `unwrap`).
(defvar g-fn-ret-type:ptr)
; TC-2: the downward expected-type ("want") channel. Armed by let/with binding
; inits, set! RHS, return positions, and field stores (the positions that
; already declare a type); consumed once at the first generic call emitted in
; that init (emit-generic-call reads+nulls it before emitting arguments, so an
; argument sub-call never inherits the outer want). Null when no want is in
; scope. Carries the same Type* generic-resolve consults to fill tyvars the
; arguments left unbound (TC-1); node-type mirrors it via the resolver param.
(defvar g-want-type:ptr)
(defvar g-loop-depth:i32 0)
(defvar (g-nundo (ref (Vector (ref NarrowUndo)))) (vector-new-in (addr-of g-arena-alloc)))
(defvar g-trap-declared:i32 0)

; Current output stream for top-level emission
(defvar g-out:ptr)
(defvar g-decl-out:ptr)
(defvar g-qq-used:i32 0)

; Main module streams (global so emit-compile-time can access them mid-compilation)
(defvar g-type-stream:ptr)
(defvar g-decl-stream:ptr)
(defvar g-def-stream:ptr)
(defvar g-type-bufp:ptr)
(defvar g-decl-bufp:ptr)
(defvar g-def-bufp:ptr)
(defvar g-type-sizep:i64 0)
(defvar g-decl-sizep:i64 0)
(defvar g-def-sizep:i64 0)

; JIT state
(defvar g-jit:ptr)
(defvar g-jit-dylib:ptr)
(defvar g-ct-id:i32 0)

; BinOp table
; (Vector ptr) of BinOp* (each individually arena-allocated, registration order).
(defvar (g-binops (ref (Vector (ref BinOp)))) (build-binops))

; Generic (polymorphism) registry. (Vector ptr) of Generic* (each Generic is
; individually arena-allocated; the vector holds the pointers in registration
; order). count = number of generics; invoke = indexed access.
(defvar (g-generics (ref (Vector (ref Generic)))) (build-generics))

; Monomorphization worklist (Stage 9 rung 4): stamped concrete defn forms
; awaiting emission. Generic calls resolve + register an instantiation eagerly
; (so the call site can name its symbol) but defer the body emission until the
; current function finishes; the worklist is drained at the end of the top-level
; loop. g-mono-drained is a persistent cursor so recursive drains never re-emit.
(defvar (g-mono-worklist (ref (Vector (ref MonoJob)))) (vector-new-in (addr-of g-arena-alloc)))
(defvar g-mono-drained:usize 0)

; Stage 15 W8 G-3 (design/global-init.md §5, §4.8): runtime global initializers
; awaiting emission into the single synthesized `@__nucleus_init`. A `defvar`
; whose initializer `defvar-init-ir` could not render as a constant is appended
; here in reach order and drained at `emit-toplevel-forms` depth 1 — the one
; point at which every top-level form of every reachable file has been walked,
; so "is the queue empty?" is EXACT rather than an approximation. Nothing about
; the runtime half is emitted anywhere else, which is what makes the feature
; cost exactly zero bytes for a program that has no runtime initializer.
; g-init-drained is a persistent cursor, mirroring g-mono-drained.
(defvar (g-init-worklist (ref (Vector (ref InitJob)))) (vector-new-in (addr-of g-arena-alloc)))
(defvar g-init-drained:usize 0)

; Stage 15 B6 (name-resolution.md §9.5): deferred `(dyn P)` annotation-site
; admission. Same worklist+cursor shape as the two above and for the same reason
; — the question cannot be answered where it is asked. `dyn-type` runs during
; `prescan-defn-signatures`, so "is P a protocol this file may name?" would
; reject every legal reference there; the job carries the spelling, its location
; and the file's name environment, and `drain-dyn-annots` asks it after the
; whole-graph prescan and every import has been emitted. The cursor is persistent
; so appends during the drain (there are none today) are still processed exactly
; once, which is also the completeness proof: the drain runs until the cursor
; reaches the count.
(defvar (g-dyn-annots (ref (Vector (ref DynAnnot)))) (vector-new-in (addr-of g-arena-alloc)))
(defvar g-dyn-annots-drained:usize 0)
; Set to the current instantiation's context string while a stamped generic body
; is being emitted; die-at appends it as a note so a stamp-time error points back
; to the instantiation (and its requesting call site). Null otherwise.
(defvar g-mono-context:ptr)
; Stage 15 W4a: the source line of the innermost enclosing form currently being
; emitted — the "line half" of a diagnostic location, ambient exactly like
; `g-source-path` is its file half (both are read by die-at/report-at).
;
; It exists because a bare symbol node is an interned singleton with no
; per-occurrence line (lib/node.nuc `node-line`), so `emit-symbol-ref` — reached
; from `emit-node`, which is handed only the operand — has no node to blame when
; a lookup fails. `emit-node` is the single dispatcher every operand passes
; through, so it maintains this with strict save/restore: on entry it adopts the
; node's own line when the node has one (cells/literals do), and restores the
; caller's on exit. The value therefore always names the innermost enclosing
; form with a real line, which is the reference's line.
;
; Every *other* W4a fix takes its line from a node the raising code already
; holds (lib/node.nuc `node-line` + the enclosing form's line); this global is
; consumed in exactly one place, emit-node's NODE-SYM branch.
(defvar g-form-line:i32 0)
; Stage 14 RV-6c (design/stage14/riscv-fp-abi.md §4): the riscv64 argument
; register budget still unspent while ONE parameter or argument list is being
; lowered. riscv64's lp64d classification is register-sensitive — an FP-bearing
; aggregate is flattened into fa0-fa7 only while the registers it needs are
; free, and falls back to the integer convention once they are not — so unlike
; every other target `abi-classify` alone cannot answer for an argument.
;
; Ambient rather than threaded because the deciding functions (`abi-arg-frag`,
; `abi-emit-param-prologue`) classify internally and are reached from ~8
; unrelated walks; a parameter would have to be plumbed through all of them and
; through `abi-print-param`'s callers. The invariant that replaces the plumbing:
;
;   Every walk over a function's parameter or argument list calls
;   `abi-args-begin` first, then `abi-classify-arg` once per element in
;   declaration order — and `abi-args-varargs` when it crosses into the
;   variadic tail.
;
; Two walks over the same signature (a `define`'s parameter list and its
; prologue loop) each reset and re-derive independently; they agree because
; they see the same types in the same order. Nothing reads these on a
; non-riscv target — `abi-classify-arg` tail-calls the pure `abi-classify`
; there — which is what keeps hosted IR byte-identical.
(defvar g-abi-gpr-left:i32 8)
(defvar g-abi-fpr-left:i32 8)
; 1 once the walk has crossed into a variadic callee's `...` tail. A variadic
; argument takes the integer convention regardless of type: no FP registers and
; no flattening (psABI).
(defvar g-abi-varargs:i32 0)
; Stage 15 W8 G-2 (design/global-init.md §5): "an `(array T N)` spelling is
; permitted at the very next type parse". An array is a STORAGE type — it is
; meaningful only as a `defvar` type and as a `defstruct`/`(struct …)` field
; type, and would silently miscompile as a by-value parameter, return, local
; binding or pointer element. Rather than N refusals scattered across every
; other position (which is the shape that drifts), permission is granted at the
; four sites that want it and `parse-type-from-node` CONSUMES it once on entry,
; exactly as `g-want-type` is consumed once by `emit-generic-call`.
;
; Consume-once is what makes nesting fall out for free: `(ptr (array i32 4))`
; consumes the permission at the outer parse, so the recursion into the element
; sees 0 and the array is refused — and so are `(array (array i32 2) 3)`,
; `(Vector (array i32 4))` and every other nesting, with no per-constructor
; check. Armed with strict save/set/restore (`g-array-ok` is 0 everywhere else).
;
; Three states, because the type is resolved TWICE for a `defvar` — once by
; G-0's `prescan-value-names` and once by `emit-defvar`:
;   0  refused
;   1  permitted; the length is folded (emission)
;   2  permitted, PROVISIONAL; the length is left 0 (prescan)
; Mode 2 exists because the length is a constant expression and `const-fold-int`
; goes through `macroexpand-form`, while macros are registered only when their
; file is EMITTED (the same structural property W1d and G-0 record). So
; `(array i32 (* K 2))` cannot fold during a prescan and `(array i32 (_* K 2))`
; can — a divergence, if the prescan tried. It does not: the prescan's Sym
; exists purely so a forward *reference* resolves, every read of an array
; binding goes through `array-decay` (which reads `elem`, never `arr-len`), and
; `emit-defvar` re-resolves the real type and re-defines the Sym. `type-to-ir`
; asserts that a provisional length never reaches IR, so the invariant is
; checked rather than merely asserted in this comment.
(defvar g-array-ok:i32 0)
; Stage 15 W8 G-3: "this initializer may turn out not to be constant". Armed
; (save/set/restore) only around `defvar-const-init-ir`'s single classifying
; call into `defvar-init-ir`, where it turns that function's terminal
; "init must be a compile-time constant" raise into a `null` return. Every
; OTHER diagnostic inside the renderer still fires unchanged, because a
; malformed constant, an out-of-range literal or a nullability violation is an
; error, not a runtime initializer.
;
; This flag is the whole reason there is exactly ONE constant-vs-runtime
; classifier rather than two: the queue decision is the renderer's own answer,
; not a predicate that re-derives its conditions (context/conventions.md's
; standing rule for `defvar-init-ir`, and the property §4.8 turns on). It is 0
; during aggregate element rendering, so an element that is not constant is
; still the hard error it has always been.
(defvar g-defvar-soft:i32 0)
; Nesting depth of emit-toplevel-forms (imports recurse). The A2 generic-body
; check runs only at the outermost level — after every import has registered its
; names and with g-source-path restored to the unit being compiled.
(defvar g-toplevel-depth:i32 0)

; Protocol / conformance registries (Stage 9 rung 2). (Vector ptr) of Protocol*
; (each individually arena-allocated, in registration order).
(defvar (g-protocols (ref (Vector (ref Protocol)))) (vector-new-in (addr-of g-arena-alloc)))
; (Vector (ref Conformance)) of Conformance* (each individually arena-allocated,
; registration order).
(defvar (g-conformances (ref (Vector (ref Conformance)))) (vector-new-in (addr-of g-arena-alloc)))
; Protocol inheritance edges (Stage 9 §10.3): `(extend Ord Eq)` records that
; conforming to Ord additionally requires conforming to Eq. Reuses the
; Conformance layout: type-name = sub-protocol, proto-name = required super.
; (Vector (ref Conformance)) of Conformance* edges (each individually arena-
; allocated).
(defvar (g-proto-supers (ref (Vector (ref Conformance)))) (vector-new-in (addr-of g-arena-alloc)))

; Stage 11 parametric structs (T4): template-level conformances. A
; `(extend (Vector T) (Seq T))` records that *every* stamped instance of the
; `Vector` template conforms to `Seq`, with the protocol's extra params bound
; positionally to the template's tyvar spellings (here `E := T`). The per-instance
; conformance check fires at stamp time (struct-template-stamp-types): when
; `Vector.i32` is stamped, the template tyvars are substituted to concrete args
; and each required method must resolve for the instance. Inert until a stamp
; fires, so byte-identical for programs using no parametric protocols.
; (Vector ptr) of TmplConformance* (each individually arena-allocated).
(defvar (g-tmpl-conformances (ref (Vector (ref TmplConformance)))) (vector-new-in (addr-of g-arena-alloc)))

; Stage 12 N8: late-binding hooks that bridge a single back-edge each, where an
; earlier-imported file must call a function that lives in a later-imported file
; (its body cannot name the callee directly). Both are installed in init-blanket,
; during compiler init, before any source is read — so the indirection is
; invisible at runtime. Declared as plain `ptr` (so the bootstrap host can null-
; initialise the global); the call sites cast back to the precise fn type.
;
; G-5 correction to §2.12 A1: these two are NOT constant initializers, and
; cannot be. A constant `@fn` reference would need the function's name to
; resolve at the defvar's own emission point, and the whole reason these hooks
; exist is that the callee lives in a LATER import — the defvar must sit above
; the file that reads the hook (union-registry.nuc) while the callee is defined
; below it (generics.nuc / union-emit.nuc). So they are run-time initializers,
; installed by `@__nucleus_init` before `main` — the same instant, relative to
; any source being read, at which `init-blanket` used to install them.
;
; g-tmpl-conf-check-hook: the per-instance protocol conformance check
; (tmpl-conformance-check-instance, in generics.nuc) is invoked from union-
; registry.nuc (struct-template-stamp-types), imported BEFORE generics.nuc.
(defvar g-tmpl-conf-check-hook:ptr (unsafe/cast ptr tmpl-conformance-check-instance))

; g-stamp-maybe-type-hook: stamp-maybe-type (in union-emit.nuc) is invoked from
; node-type-call (in generics.nuc, imported BEFORE union-emit.nuc) to type the
; `signal` form's (Maybe RepairType) result.
(defvar g-stamp-maybe-type-hook:ptr (unsafe/cast ptr stamp-maybe-type))

; Blanket protocols (Stage 9 §10.1): built-in protocols with automatic
; conformance — `Any` (every type) and `Struct` (every struct type). Stored as a
; small set of names plus a per-name predicate baked into blanket-conforms.
; (Vector CStr) of blanket-protocol name strings.
(defvar (g-blanket (ref (Vector CStr))) (build-blanket))

; Macro registry. (Vector ptr) of MacroDef* (each individually arena-allocated,
; registration order). The element index is also the macro's JIT-name uniquifier.
(defvar (g-macros (ref (Vector (ref MacroDef)))) (vector-new-in (addr-of g-arena-alloc)))
(defvar g-gensym-id:i32 0)

; Reader macro table
; Reader macro table. (Vector ptr) of RMacro* (each individually arena-allocated,
; registration order).
(defvar (g-rmacros (ref (Vector (ref RMacro)))) (build-rmacros))

; Set to 1 once @malloc has been declared via a C-header import (e.g. (import-use "stdlib.h")).
; Guards against emitting a duplicate malloc declaration in macro JIT modules.
(defvar g-malloc-decl-done:i32 0)

; Names (ir-name strings) already `declare`d into the current macro/CT JIT
; module. A macro/CT body may call ordinary `defn`s (e.g. node-at, intern-symbol
; from the prelude) that live only in the main program module; the JIT module
; needs a `declare` for each so it links the symbol from the -rdynamic host
; binary. Reset at the start of each macro/CT module; emit-call-with-args adds an
; entry (and emits the declare to g-decl-out) on first reference while redirected.
; (Vector CStr) of macro/CT-module declare-name strings (dedup set, compared by
; content via strcmp — never by identity).
(defvar (g-macro-decls (ref (Vector CStr))) (vector-new-in (addr-of g-arena-alloc)))

; Program-defined `defn`s (the `define`s emitted into the main module). Only
; these need a fresh `declare` in a macro/CT JIT module — externs and
; C-header import declarations already live in g-decl-bufp, which the JIT module
; copies in. Populated by emit-defn as it writes each `define`; the captured
; signature (ret + param Types + ABI) reproduces the declare losslessly (the
; g-globals Sym for an overloaded/generic name carries no usable param array).
(defvar (g-program-defns (ref (Vector (ref ProgDefn)))) (vector-new-in (addr-of g-arena-alloc)))

; Compiler mode flags.
(defvar g-emit-nuch:i32 0)    ; when 1, output .nuch header instead of LLVM IR
(defvar g-emit-cheader:i32 0) ; when 1, output C header instead of LLVM IR
(defvar g-emit-llvm:i32 0)    ; when 1, output textual LLVM IR to stdout instead of a binary
(defvar g-emit-obj:i32 0)     ; when 1 (-c), emit a .o file instead of linking a binary
(defvar g-output-path:ptr)    ; -o <path>; null = default ("a.out")
; argv-style pass-through args appended to the link line. Null until the first
; -l/-L flag is parsed. G-5: built by @__nucleus_init before main, from the
; load-time-constant arena handle, so it is arena-backed like everything else
; (it used to be lazily malloc-backed — see add-link-arg).
(defvar (g-link-args (ref (Vector CStr))) (vector-new-in (addr-of g-arena-alloc)))
(defvar g-interactive:i32 0)  ; when 1, run in REPL mode (-i / --interactive)
(defvar g-repl-format:i32 0)  ; 0 = text (default), 1 = json (one JSON object per error)
(defvar g-opt-level:i32 0)    ; -O0..-O3; LLVMCodeGenOptLevel: None=0, Less=1, Default=2, Aggressive=3

; REPL eval counter (for unique __repl_eval_N symbols).
(defvar g-repl-id:i32 0)

; REPL defn impl counter (for unique <fname>.impl.N symbols when wrapping a
; user-defined function with a thunk so that callers see redefinitions).
(defvar g-defn-impl-counter:i64 0)

; REPL declarations preamble — accumulated declarations and type defs
; that get prepended to each JIT module.
(defvar g-repl-preamble:ptr)
(defvar g-repl-preamble-bufp:ptr)
(defvar g-repl-preamble-sizep:i64 0)

; Import tracking — duplicate guard and cycle detection.
; Each is a linked list of (path-string . next) pairs using Node cells.
(defvar g-imported:ptr)     ; already-imported resolved paths (null = empty)
(defvar g-importing:ptr)   ; currently-importing stack for cycle detection (null = empty)
; Stage 12: (file, prefix) records for prefixed imports — a re-import under the
; same prefix is a no-op, while the same file under a new prefix re-injects
; aliases over the file's already-loaded symbols (null = empty).
(defvar g-import-aliased:ptr)
; Stage 12: prefix → file bindings (prefix in `s`, file path in `car`). Two
; different imports may not share a prefix (design decision 5); this enforces it
; (null = empty).
(defvar g-import-prefixes:ptr)
; Stage 15 W3b/W3c: C-header function declarations the importer recognized but
; could not describe (cheader.md §1.4/§1.5). One Node cell per function name,
; deduplicated: `s` = the function name, `car` = a pre-formatted
; "<header>:<line>: <reason>" note. Written by cheader.nuc's
; `cheader-record-skip`; read by `unresolved-name-message` (just below the
; globals block, well before `(import-use cheader)`) so a *use* of a skipped
; name says why it is missing instead of offering a spelling correction. The
; global lives here rather than in cheader.nuc for exactly that ordering reason.
(defvar (g-cheader-skipped (raw Node)))
; Stage 10: files whose types have already been pre-scanned for the signature
; prescan (so prelude types like Node/Result and the !T sugar resolve in the
; current unit's defn signatures, ahead of the actual import). Idempotent
; registration, so this only avoids redundant I/O and import cycles.
(defvar g-prescan-visited:ptr)
; Stage 15 W1a (design/stage15-stress-test/resolution.md): resolved `.nuc` paths
; whose protocols AND defn signatures have already been registered by the
; whole-graph signature prescan (`prescan-imported-signatures`). Unlike the type
; prescan above, signature registration is NOT idempotent —
; `generic-register-method` appends unconditionally and `generic-add-method`
; clears `finalized`, so a second pass over the same file makes every one of its
; signatures look like a duplicate overload. `emit-toplevel-forms` therefore
; skips its own protocol/signature prescan for a path on this list.
(defvar g-prescan-sigs:ptr)
; Stage 15 W1c: the compilation unit's root source path, recorded by
; `emit-toplevel-forms` at depth 1. Diagnostic-only — see `path-in-unit`.
(defvar g-unit-entry-path:ptr)
; Stage 15 W1d (Option 2): every circular import that `do-import` *skipped*
; instead of erroring. One Node cell per skip: `s` = the path that was already
; in progress (the cycle partner), `car` = the path of the file whose `import`
; form was skipped, `line` = that form's line. Never popped — a cycle is a
; property of the whole unit and the diagnostics that read this list all fire
; long after the cycle has unwound. Read only from diagnostic paths, so it can
; never move emitted IR.
(defvar g-import-cycles:ptr)
; g-current-ns is declared near the top of the file (above g-generics, whose
; builder reads it through generic-new → ns-ir-prefix).
; Set once a leading `ns` directive has been consumed in the current unit. A
; second `ns` warns at compile time (silent under the REPL flag). Reset per unit.
(defvar g-ns-seen:i32 0)
; Stage 12 N3: set to 1 while emitting a private definer (`defn-`, `defvar-`,
; `defconst-`, `defenum-`, `defstruct-`, `defunion-`, `defmacro-`,
; `defprotocol-`). The emit-* handlers check this to mark the symbol private
; and, for link-emitting forms, to emit internal LLVM linkage.
(defvar g-defining-private:i32 0)

; Stage 15 B5: has this unit registered ANY private binding of a kind that has
; no `Sym`? (`defstruct-` / `defunion-` / `defstruct-`-template / `defunion-`-
; template / `defmacro-` / `defprotocol-`.) Privacy for those four definers was
; accepted and enforced by nothing before B5 (name-resolution.md §13.2), and the
; enforcement is a filter inside each kind's reference lookup — so this flag is
; what keeps the filter provably inert: it is 0 for every build of this compiler
; and every program in `lib/`, `examples/` and `tests/`, exactly as
; `g-priv-files == null` short-circuits the W5e machinery.
(defvar g-priv-bindings:i32 0)
; Stage 12 N3: set to 1 by `unsafe-import-private` so inject-import-aliases
; includes private symbols in the alias walk. Cleared after the import.
(defvar g-import-include-private:i32 0)

; Stage 12 N4: per-namespace IR-mangling prefix (design/stage12/namespaces.md
; §"Implementation", decision 7). A `(Vector (ref NsPrefixEntry))` mapping an
; (interned) namespace name to its (interned, sanitized) ir-prefix string, as
; set by `set-ir-prefix`. A namespace with no explicit entry defaults to its
; own name (sanitized) — except `user`, which is the empty prefix (bare
; ir-names, the byte-identical escape hatch). An entry whose value is the
; empty string forces bare names regardless of the namespace. Keys compare by
; interned-pointer identity (ns-ir-prefix-set/-get). Lazily constructed on the
; first `set-ir-prefix` call (Stage 14 §14.5 batch 2 — was two cap-doubling
; parallel arrays); `raw` (not `ref`) because it is genuinely null until the
; first `set-ir-prefix` — which is what `raw` means, and what makes the G-5 flip
; leave it alone.
(defvar (g-ns-prefix-table (raw (Vector (ref NsPrefixEntry)))))

; Stage 15 B1 (design/stage15-stress-test/name-resolution.md §5.2 B1): the import
; environment of the file *currently being compiled* — one `ImportBind` per
; import form that file wrote. `do-import` saves it, clears it and restores it
; around every imported file, exactly as it already does for `g-current-ns` /
; `g-ns-seen`; that save/restore is the whole of the file scoping. `raw` because
; it is genuinely null for a file with no imports yet (the g-ns-prefix-table
; precedent), which is also what keeps a unit with no prefixed import on exactly
; the pre-B1 path.
(defvar (g-file-imports (raw (Vector (ref ImportBind)))))

; Stage 15 B2a (name-resolution.md §9.1): the unit-global `path → namespace` map
; B1 deliberately did not materialise. An `ImportBind` records the *file* an
; import bound, not its namespace; resolving a prefix to a namespace needs the
; other half. Written by `emit-ns` — the single point at which any file's
; namespace becomes known, and the one that also covers the already-loaded and
; W1d cycle-skip paths, which never reach a load block. A path with no record is
; in `user` (a file with no `(ns …)` never reaches `emit-ns`), so absence is a
; meaningful answer and no eager registration is needed. Node cells: path in `s`,
; interned namespace in `car`. Compared by CONTENT — `resolve-import` is free to
; hand back a fresh buffer per call.
(defvar g-file-ns:ptr)

; Stage 15 B2a: has any file in this unit declared a namespace? Nothing but
; `emit-ns` sets it, so it is 0 for every build of this compiler and for every
; program in `lib/`. It gates the flattened-namespace probe in the bare-name
; resolution path: with no namespace anywhere in the unit, every flattened import
; is in `user`, whose key is the bare name the probe already tried. Same shape as
; `g-priv-files` / `g-ns-prefix-table` — a feature table whose null/zero state is
; a proof that the pre-feature path is unchanged.
(defvar g-ns-declared:i32)

; Stage 15 B3′: "the type spellings resolved under this dynamic extent are
; compiler-generated KEYS, not source references." Since B3′ a type name resolves
; through the writing file's import environment (R3), and a *synthesized* spelling
; is not written by any file: `type-spelling` renders a stamped generic's tyvar
; binding, a protocol's `Self` substitution and a `.nuch` signature as the type's
; CANONICAL name (`dp/Fox`), which the stamping/importing file usually cannot name.
; Resolving those as references is the B2a false-rejection; resolving *every*
; qualified spelling as a key would put `type-annot zn/` back to `ok`.
;
; So the type reference resolvers (`struct-lookup-ref` and its four siblings) take
; an exact-key fallback ONLY while this is armed, and it is armed by save/set/
; restore around the synthesis regions — the template stampers, the monomorphized-
; body drain, the protocol-signature substitution, the conformance-arg re-parse and
; the `.nuch` replay. This is `g-defvar-soft`'s shape (soften one exit, leave every
; other raise alone), not a global relaxation. 0 for every program in the tree that
; declares no namespace, since the fallback only runs after a miss.
(defvar g-type-key-ok:i32 0)

; Stage 15 W5e (design/stage15-stress-test/ergonomics.md §W5e): the file-private
; name table. One `PrivFile` per source file that used a private definer while
; the default `user` namespace was current; `null` until the first such definer,
; which is what keeps every program (and this compiler, which uses none) on
; exactly the pre-W5e path. `raw`: genuinely null until then, like
; g-ns-prefix-table.
(defvar (g-priv-files (raw (Vector (ref PrivFile)))))
; Memo for `priv-file-current`: the `g-source-path` POINTER the cached answer was
; computed for, and that answer (which may legitimately be null — "this file owns
; no private names"). Path strings are arena-allocated once per file and never
; freed, so pointer identity is a sound cache key. Invalidated by setting the
; path back to null whenever a PrivFile is created.
(defvar g-priv-cache-path:ptr null)
(defvar (g-priv-cache (raw PrivFile)))

; Stage 14 AVR-5 (design/stage14/avr-targets.md §5 AVR-5): the function-attribute
; table set by `(fn-attr <name> "<attr>" …)`. A `(Vector (ref FnAttrEntry))`
; mapping a defn's (interned) source name to an LLVM string function attribute,
; scanned at emit-defn time to append the inline attribute suffix on the `define`
; line. There is deliberately NO forward-reference prescan for this table, so a
; `fn-attr` directive must precede the `defn` it targets in the unit (the dispatch
; loop processes top-level forms in order). Lazily constructed on the first
; `fn-attr` call; `raw` (not `ref`) because it is genuinely null until then.
(defvar (g-fn-attr-table (raw (Vector (ref FnAttrEntry)))))

; Include path list for -I flag. Null until the first -I flag is parsed (see
; add-include-path).
(defvar (g-include-paths (ref (Vector CStr))) (vector-new-in (addr-of g-arena-alloc)))

; stdlib (malloc/free/exit) is included here — after defmacro and defvar —
; so that g-decl-bufp is free of malloc when macro JIT modules are assembled.
(import-use "stdlib.h")

; ============================================================
; Arena allocator — imported from lib/arena.nuc
; ============================================================

(import-use arena)

; ============================================================
; Formatting helpers — imported from lib/format.nuc
; ============================================================

(import-use format)

; ============================================================
; Node utilities — imported from lib/node.nuc
; ============================================================

(import-use node)

; ============================================================
; Collections — imported from lib/vector.nuc, lib/hash.nuc, lib/hashset.nuc
; (Stage 11). The compiler's growable pointer tables are (Vector ptr) values;
; the globals/locals holding them are typed (ref (Vector ptr)) so use sites call
; conj/count/invoke directly (bounds-checked indexing, amortized growth) with no
; per-use cast. `vector-new-in (addr-of g-arena-alloc)` returns the concrete
; (ref (Vector ptr)) (the element type filled from the slot's declared type via
; the want channel), so construction sites need no cast either. Naming (Vector ptr)
; in vector-new-in's *signature* stamps the instance during the defn-signature
; prescan (which runs before the allocator import is emitted), queuing
; `%Vector.ptr = type { …, %AllocHandle }` on the
; pending-IR list ahead of `%AllocHandle`'s definition. The drain deferral
; (pending-union-deps-ready / drain-pending-union-irs) leaves `%Vector.ptr` queued
; while `%AllocHandle` is still undefined — so the prelude's macro-JIT module does
; not emit a dangling `%AllocHandle` reference — and emits it on a later drain,
; after the allocator import defines `%AllocHandle`. hash + hashset support
; (HashSet CStr) for special-form-named / primitive-type-named membership. All
; are arena-backed (g-arena-alloc), never dropped.
; vector pulls in its deps allocator/coll/iterator. These bring the generic
; method names count/conj/invoke/insert/contains?/iter/empty? into scope; the
; compiler uses suffixed names (defn-params-count, etc.) so there are no
; top-level collisions.
; ============================================================

(import-use vector)
(import-use hash)
(import-use hashset)

; Shared arena allocator handle backing every compiler-owned collection (the
; Vector pointer tables and the two HashSet name-kind sets). The arena's free is
; a no-op, so these process-lifetime globals are never dropped — the faithful
; match for the original arena-backed tables.
;
; Stage 15 W8 G-5 (design/global-init.md §2.10): this is a CONSTANT. The value
; `arena-allocator` used to write in at run time is `{ALLOC-ARENA, null}` — two
; constants — so it renders as `@g-arena-alloc = global %AllocHandle { i32 1,
; ptr null }` and the loader applies it before a single line of code runs. Three
; consequences, all load-bearing:
;   * every registry is arena-backed no matter what order the runtime
;     initializers run in — the ordering hazard §2.10 opens is dissolved, not
;     merely scheduled around;
;   * `add-include-path` / `add-link-arg`, which run during argv parsing (before
;     even `@__nucleus_init`, on the `-I`/`-l` path), no longer get libc-backed
;     Vectors from a still-zero handle — the split `context/build.md` documented
;     is gone;
;   * the failure mode of getting it wrong is SILENT (a zero-filled handle reads
;     as ALLOC-LIBC), so `assert-compiler-arena-backed` below asserts the value
;     positively rather than trusting a green test suite.
;
; §2.10 predicted this defvar would have to move UP, above the first registry at
; the top of the file, so the `(vector-new-in (addr-of g-arena-alloc))`
; initializers would not forward-reference it. Measured, the move is the
; opposite one and for a different reason. Upward is impossible: a constant
; struct literal needs `AllocHandle`'s LAYOUT, and `lib/allocator.nuc` is not
; imported until `(import-use vector)` directly above — at the old `:182` the
; renderer sees a fieldless registry entry and dies "too many initializers for
; struct 'AllocHandle'". Upward is also unnecessary: a constant initializer is
; applied by the loader, so it has no order (§4.1 consequence 4), and every
; reference to it is `(addr-of …)` — an address, which G-4 already exempts
; because it is a link-time constant requiring no initialization to have
; happened.
(defvar g-arena-alloc:AllocHandle (AllocHandle ALLOC-ARENA null))

; Stage 15 W8 G-5 (§4.4 item 5): the migration's one silent failure mode. A
; zero-filled AllocHandle reads as ALLOC-LIBC, so getting `g-arena-alloc`'s
; constant wrong would quietly make all 30+ compiler registries malloc-backed
; instead of arena-backed — every test would still pass. This asserts the value
; positively at run time, on the handle the registries were actually built
; through (`(v alloc)` is the by-value copy `vector-init-alloc` took at
; construction, not a re-read of the global), and it is called from `main` and
; from `repl-main` so the suite runs it on every single compile.
(defn assert-compiler-arena-backed ():void
  (let (h:ptr:AllocHandle (as ptr:AllocHandle (addr-of g-arena-alloc)))
    (when (!= (h kind) ALLOC-ARENA)
      (fprintf stderr "internal error: g-arena-alloc is not ALLOC-ARENA (kind=%d) -- every compiler registry is malloc-backed\n" (h kind))
      (exit 1)))
  ; …and on a registry, which is the property that actually matters: the handle
  ; is copied BY VALUE into each Vector at construction, so a Vector built before
  ; the constant took effect would stay libc-backed for its whole lifetime even
  ; with the global reading ALLOC-ARENA now.
  (let (a:ptr:AllocHandle (as ptr:AllocHandle (.& g-structs alloc)))
    (when (!= (a kind) ALLOC-ARENA)
      (fprintf stderr "internal error: g-structs is not arena-backed (kind=%d)\n" (a kind))
      (exit 1))))

; ============================================================
; Allocation helpers
; ============================================================

; Arena-backed allocators: arena-alloc aborts on exhaustion, never null.
(defn alloc-tok ():ref:Tok
  (return (as ref:Tok (arena-alloc (sizeof Tok)))))

; G-5 (§2.12 A2): the deferror sid tables are construct-then-populate — index 0
; is a reserved "no error" placeholder so the vector index equals the 1-based
; runtime error id — so they need a value-returning builder. One builder, both
; tables.
(defn build-deferror-sids ():(ref (Vector i32))
  (let (v:(ref (Vector i32))
          (unsafe/cast (ref (Vector i32)) (vector-new-in (addr-of g-arena-alloc))))
    (conj v 0)
    (return v)))

(defn nucleus_gensym ():(raw Node)
  (let (id:i32 g-gensym-id)
    (inc! g-gensym-id)
    (let (buf:ptr (malloc 32)
          n:ptr:Node (as ptr:Node (malloc (sizeof Node))))
      (snprintf buf 32 "__gs_%d" id)
      (memset (as ptr n) 0 (sizeof Node))
      (.set! n kind (as i32 NODE-SYM))
      (.set! n s buf)
      (return (as ptr n)))))

(defn alloc-type ():ref:Type
  (return (as ref:Type (arena-alloc (sizeof Type)))))

(defn alloc-val (ty:(raw Type) v:ptr):ref:Val
  (let (r:ref:Val (as ref:Val (arena-alloc (sizeof Val))))
    (.set! r type ty)
    (.set! r val v)
    (return r)))

; ============================================================
; Growable pointer/hash collections
; ============================================================
;
; The compiler's registries are (Vector ptr)/(Vector (ref X)) and one HashMap,
; built through the shared arena handle (g-arena-alloc, whose free is a no-op)
; so these process-lifetime tables are never dropped. Construction uses the
; target-typed lib constructors (design/stage14/target-typed-constructors.md):
; `(vector-new-in (addr-of g-arena-alloc))` fills the element type from the
; binding's declared type via the want channel — no per-use cast (the old
; `make-vec`/`mkvec`/`mkhash` cast-over-arena hole is retired).

; ============================================================
; Reader — imported from lib/reader.nuc
; ============================================================

(import-use reader)

; Stage 10 C3: condition class for recoverable malformed top-level forms that
; the compiler validates at definition time (e.g. a malformed `(deferror …)`).
; The reader uses `parse-error` for syntax faults; this is the distinct class
; for definition-shape faults. Like the reader's `parse-error`, the diagnostic
; is printed at the fault site (report-at) and this Err is the value-channel
; signal the single caller `match`es on (emit-toplevel-forms → exit 1). `import
; reader` above transitively pulls in `error`, so the !T sugar is available.
(deferror malformed-form "malformed definition form")

; ============================================================
; AST printer — inverse of the reader, serializes nodes to stdout
; ============================================================

(defn fprint-node (out:ptr n:(raw Node)):void
  (when (= n null) (fputs "()" out) (return))
  (let (nn:(raw Node) n)
    (case (nn kind)
      NODE-INT
        (fprintf out "%ld" (nn i))
      NODE-FLOAT
        (fputs (nn s) out)
      NODE-SYM
        (fputs (nn s) out)
      NODE-KEYWORD
        (do (fputc 58 out) (fputs (nn s) out))
      NODE-STR
        (do
          (fputc 34 out)
          (let (s:ptr (nn s)
                      len:i64 (strlen s))
            (dotimes (i len)
              (let (c:i32 (char-at s i))
                (case c
                  10 (do (fputc 92 out) (fputc 110 out))
                  9  (do (fputc 92 out) (fputc 116 out))
                  13 (do (fputc 92 out) (fputc 114 out))
                  92 (do (fputc 92 out) (fputc 92 out))
                  34 (do (fputc 92 out) (fputc 34 out))
                  0  (do (fputc 92 out) (fputc 48 out))
                  (fputc c out)))))
          (fputc 34 out))
      NODE-CELL
        (do
          (fputc 40 out)
          (let (cur:(raw Node) n
                        first:i32 1)
            (while (and (!= cur null)
                        (= (cur kind) NODE-CELL))
              (when (= first 0) (fputc 32 out))
              (set! first 0)
              (fprint-node out (cur car))
              (set! cur (cur cdr))))
          (fputc 41 out))
      0)))

(defn print-node (n:(raw Node)):void
  (fprint-node (as ptr stdout) n))

(import-use type-utils)

; type-mangle.nuc (type-spelling/type-mangle-token/tyvar-index-of/
; subst-tyvars-sym/subst-tyvars-node) is imported before union-registry.nuc and
; generics.nuc to break the generics↔union-registry import cycle: union-registry
; calls type-spelling/type-mangle-token/subst-tyvars-node while generics calls
; union-registry's lookup-struct/parse-type-from-node. These five depend only on
; split-colon-segments (from nucleusc.nuc, via the whole-unit prescan).
(import-use type-mangle)

; scope.nuc is imported before abi.nuc/union-registry.nuc because abi.nuc's
; struct-store/struct-load codegen calls scope-define and new-tmp (resolved at
; emit time, so they must already be in g-globals when abi's bodies emit).
(import-use scope)

(import-use abi)

(import-use union-registry)

; generics.nuc (the polymorphism registry: generic-lookup, finalize-generics,
; generic-method-bind, drain-mono-worklist, the Valid/structural-bound checker,
; etc. — AND, since N8, the protocol/conformance registry: protocol-lookup,
; conformance-lookup, blanket-conforms, verify-conformance, emit-extend, the
; tmpl-conformance family, …) is imported here, before node-type and the emit-*
; dispatch, because node-type and emit-call resolve generic-lookup/generic-find-
; method-exact/generic-has-receiver-method (and conformance-lookup) at emit time
; — they must be in g-globals by then. The protocol code is co-located with the
; generics code because the two are mutually recursive (generics calls protocol-
; lookup/conformance-lookup/emit-extend/…; the protocol checks call generic-
; lookup/generic-find-method-exact/generic-binds-for/…), so a single import-use
; registers both halves before either body emits. N8 also co-locates the
; node-type pass (non-emitting expression typing) here, for the same reason: the
; generic-body checkers (gcheck/valid-walk) call node-type/node-type-call/node-
; type-sym, while node-type calls generic-lookup/generic-find-method-exact/…. Its
; own bodies call back into nucleusc.nuc (emit-defn, split-typed, …); those
; resolve through nucleusc.nuc's whole-unit prescan, which registers every
; nucleusc.nuc defn before any import is processed.
(import-use generics)

; macro-jit-ensure-decl lives here, after abi/union-registry, rather than in
; scope.nuc: it needs abi-classify/abi-ret-ir, while scope.nuc must precede abi.
; Splitting it out of scope.nuc breaks the otherwise-mutual import cycle.
; Ensure a `declare` for an ordinary global function `ss` exists in the current
; macro/CT JIT module. No-op in the main module (the function is `define`d
; there) and for anything not a program-defined defn (externs/includes are
; already in g-decl-bufp, copied into the JIT module verbatim; locals/fn-pointer
; values/intrinsics are not @-named program defns). Deduplicated per module via
; g-macro-decls. The declare reproduces emit-defn's ABI-lowered signature from
; the captured ProgDefn (the Sym's type may carry no usable param array); the
; symbol resolves from the -rdynamic host binary at JIT link time.
(defn macro-jit-ensure-decl (ss:(raw Sym)):void
  (when (= (in-jit-module) 0) (return))
  (let (s:(raw Sym) ss
        irn:ptr (s ir-name))
    (when (= irn null) (return))
    (let (pd:?ptr:ProgDefn (program-defn-lookup irn))
      (when (= pd null) (return))
      ; Dedup within this module.
      (doseq (m g-macro-decls (VecIter CStr))
               (when (= (strcmp m irn)
                        0)
                     (return)))
      (conj g-macro-decls (as CStr (intern-str irn)))
      ; Variadic prototypes lower trivially (no struct args reach a macro body).
      (when (!= (pd variadic) 0)
        (fprintf g-decl-out "declare %s %s(...)\n" (type-to-ir (pd ret)) irn)
        (return))
      (let (ret-info:ptr:AbiInfo (unsafe/cast ptr:AbiInfo (abi-classify (pd ret))))
        (fprintf g-decl-out "declare %s %s(" (abi-ret-ir ret-info (pd ret)) irn)
        (let (need-comma:i32 0)
          (when (= ((as ptr:AbiInfo ret-info) kind) ABI-MEMORY)
            (fprintf g-decl-out "ptr sret(%s) align %d"
              (type-to-ir (pd ret)) ((as ptr:AbiInfo ret-info) align))
            (set! need-comma 1))
          ; RV-6c: one walk over this signature's parameters, so reset the
          ; riscv64 register budget before it (design/stage14/riscv-fp-abi.md §4).
          (abi-args-begin ret-info)
          (dotimes (j:i32 (pd nparams))
                   (when (!= need-comma 0) (fprintf g-decl-out ", "))
              ; abi-print-param writes to g-out (the def stream); format the
              ; declare's param types straight into g-decl-out instead.
              ; RV-6c: classified ONCE (it used to classify twice, for `pinfo`
              ; and `pk`) via abi-classify-arg, which debits the budget.
              (let (pty:ptr (aref (as ptr:ptr (pd ptypes)) j)
                    pinfo:ptr:AbiInfo (unsafe/cast ptr:AbiInfo (abi-classify-arg (aref (as ptr:ptr (pd ptypes)) j)))
                    pk:i32 (pinfo kind))
                (cond (= pk ABI-MEMORY)
                        (fprintf g-decl-out "ptr byval(%s) align %d"
                          (type-to-ir pty) (pinfo align))
                      (= pk ABI-COERCE1)
                        (fprintf g-decl-out "%s" (pinfo reg0))
                      (= pk ABI-COERCE2)
                        (fprintf g-decl-out "%s, %s" (pinfo reg0) (pinfo reg1))
                      true
                        (fprintf g-decl-out "%s" (type-to-ir pty))))
              (set! need-comma 1)))
        (fprintf g-decl-out ")\n")))))

(defn split-typed (sym:CStr out-name:ptr:ptr out-type-name:ptr:ptr):void
  (let (colon:ptr (strchr sym 58))
    (if (= colon null)
      (do
        (ptr-set! out-name (arena-strdup sym))
        (ptr-set! out-type-name null))
      (let (name-len:i64 (- (unsafe/cast i64 colon) (unsafe/cast i64 sym)))
        (ptr-set! out-name (arena-strndup sym name-len))
        (ptr-set! out-type-name (arena-strdup (unsafe/ptr+ (as ptr:i8 colon) 1)))))))

; W4b sibling sweep (design/stage15-stress-test/diagnostics.md): the defconst
; bug generalizes -- none of defenum/defprotocol/defmacro/defunion/deferror's
; own NAME position takes a type annotation (only defvar's binding legitimately
; does), yet before this check a bare symbol whose spelling embeds ':' (e.g.
; "E:i32") silently registered under that literal, unlookupable key at every
; one of them, exactly like the original defconst bug -- `desugar` never
; rewrites a definer's own name (context/conventions.md), so the colon-typed
; spelling survives as one undesugared NODE-SYM straight into the registry.
; Call this first, before any other dispatch on `name` (including a CELL/
; template-head check), in every top-level definer whose name is never
; annotated. It is a no-op for a CELL name (a legitimate template head, or
; handled by the caller) and for a plain symbol with no colon.
(defn reject-colon-in-def-name (name:(raw Node) word:CStr fallback-line:i32):void
  (let (nn:(raw Node) name)
    (when (= (nn kind) NODE-SYM)
      (let (base:ptr null tyname:ptr null)
        (split-typed (nn s) (as ptr:ptr (addr-of base)) (as ptr:ptr (addr-of tyname)))
        (when (!= tyname null)
          (die-at fallback-line
            (fmt-3s "%s: takes no type annotation; write (%s %s ...)" word word base)))))))

; Extract name and type-name from a node that is either:
;   - a symbol node (possibly containing :) — uses split-typed
;   - a list node (name type ...) from desugar — extracts car/cadr strings
; Sets out-name and out-type-name.  out-type-name is null if untyped.
(defn extract-name-type (node:(raw Node) out-name:ptr:ptr out-type-name:ptr:ptr):void
  ; W5f: an empty list `()` in a declaration position is a NULL node — report it
  ; as "untyped, unnamed" and let the caller's own diagnostic fire, rather than
  ; dereferencing it. (The fatal counterpart lives in extract-name-and-type.)
  (when (= node null)
    (ptr-set! out-name null)
    (ptr-set! out-type-name null)
    (return))
  (let (n:(raw Node) node)
    ; AT-1: skip leading attribute keywords on a wrapped declaration
    ; `(:volatile field:type)` and re-derive the inner name / type-name. Validation
    ; already happened at declaration time (extract-name-and-type), so this is a
    ; structural skip only — a keyword head never appears in a pre-AT-1 declaration.
    (when (and (= (n kind) NODE-CELL)
               (!= (n car) null)
               (= (-> n (_ car) (unsafe/cast ptr:Node _) (_ kind)) NODE-KEYWORD))
      (let (rest:(raw Node) node)
        (while (and (!= rest null)
                    (!= ((unsafe/cast ptr:Node rest) car) null)
                    (= (-> rest (_ car) (unsafe/cast ptr:Node _) (_ kind)) NODE-KEYWORD))
          (set! rest (as raw:Node ((unsafe/cast ptr:Node rest) cdr))))
        (when (= rest null)
          (ptr-set! out-name null)
          (ptr-set! out-type-name null)
          (return))
        (let (inner:(raw Node) (if (= ((unsafe/cast ptr:Node rest) cdr) null)
                                 (as raw:Node ((unsafe/cast ptr:Node rest) car))
                                 rest))
          (extract-name-type inner out-name out-type-name)
          (return))))
    (when (= (n kind) NODE-SYM)
      (split-typed (n s) out-name out-type-name)
      (return))
    (when (= (n kind) NODE-CELL)
      (let (car-node:(raw Node) (n car))
        (when (and (!= car-node null) (= (car-node kind) NODE-SYM))
          (ptr-set! out-name (car-node s))
          (let (rest:(raw Node) (n cdr))
            (if (!= rest null)
                (let (type-node:(raw Node) (rest car))
                  (when (and (!= type-node null) (= (type-node kind) NODE-SYM))
                    (ptr-set! out-type-name (type-node s)))
                  (return))
              (do (ptr-set! out-type-name null)
                  (return)))))))
    ; Fallback: treat as untyped
    (ptr-set! out-name null)
    (ptr-set! out-type-name null)))

; Extract name and parsed Type* from a node. Handles function pointer types.
; Returns the Type* or null if untyped. Sets out-name.
; For simple types: (name type-sym) → parse-type-name
; For function pointer types: (name (fn ret) (param-types)) → parse-type-from-node on rest
; Stage 15 W8 G-2: `extract-name-and-type` for a declaration whose type may be a
; fixed-size array — a `defvar` and a struct/union field, and nothing else. Arms
; the one-shot permission (`g-array-ok`, declared above) that
; `parse-type-from-node` consumes on entry, then clears it so the flag is 0
; everywhere else by construction. Every OTHER caller of extract-name-and-type —
; defn params, let/with bindings, defunion arm fields, the .nuch and cheader
; importers — keeps calling the bare version and therefore refuses an array with
; the located message the gate raises.
(defn extract-decl-name-and-type (node:(raw Node) out-name:ptr:ptr line:i32):(raw Type)
  (set! g-array-ok 1)
  (let (t:(raw Type) (extract-name-and-type node out-name line))
    (set! g-array-ok 0)
    (return t)))

; The prescan's variant: an array type resolves to its element type with a
; PROVISIONAL length (see g-array-ok mode 2 above). Used by prescan-defvar-name
; alone.
(defn extract-decl-name-and-type-provisional (node:(raw Node) out-name:ptr:ptr line:i32):(raw Type)
  (set! g-array-ok 2)
  (let (t:(raw Type) (extract-name-and-type node out-name line))
    (set! g-array-ok 0)
    (return t)))

(defn extract-name-and-type (node:(raw Node) out-name:ptr:ptr line:i32):(raw Type)
  ; W5f: an empty list `()` in a declaration position reads as a NULL node
  ; (read-list returns null for a zero-element list, and read-list then wraps it
  ; in a cell whose car is null). Every caller — `(struct …)`/`(union …)` members,
  ; defstruct fields, defn params, let/with bindings, defunion arm fields — reaches
  ; this shared chokepoint, and each would otherwise dereference the null here.
  ; Diagnose with the enclosing form's line instead of faulting.
  (when (= node null)
    (ptr-set! out-name null)
    (die-at line "expected a name:type declaration, found the empty list '()'"))
  (let (n:(raw Node) node)
    ; AT-1 (design/stage14/attributes.md): an attribute-annotated declaration is a
    ; cell whose head is a keyword literal — `(:volatile status:i32)` for a struct
    ; field / defn param, or the `(:volatile x:i32)` wrapper attrs-normalize-bindings
    ; produces for a let/with binding. Strip and validate the leading attributes
    ; (parse-decl-attrs is the registry chokepoint), parse the inner name:type, and
    ; re-apply `:volatile` to its type — attributes never enter type identity, and
    ; `:volatile` lowers to the is-volatile Type flag (type-with-volatile) exactly as
    ; the postfix `(T volatile)`/`T:volatile` spellings do. Only fires on a
    ; keyword-headed cell, which no pre-AT-1 declaration ever is, so byte-identical.
    (when (and (= (n kind) NODE-CELL)
               (!= (n car) null)
               (= (-> n (_ car) (unsafe/cast ptr:Node _) (_ kind)) NODE-KEYWORD))
      (let (flags:i32 0
            rest:(raw Node) (as raw:Node (parse-decl-attrs (as ptr node)
                                           (as ptr:i32 (addr-of flags)) line)))
        ; AVR-6: `:const` is only valid on a defvar global — every declaration
        ; that reaches here (struct/union field, defn param, let/with binding) has
        ; no global-vs-constant storage class to select, so reject rather than
        ; silently drop the flag. (The defvar path strips `:const` in emit-defvar
        ; before calling this on the bare name:type, so it never fires there.)
        (reject-decl-attr-const flags line "a field, parameter, or binding")
        (when (= rest null)
          (die-at line "declaration attribute must be followed by a name:type"))
        (let (inner:(raw Node) (if (= ((unsafe/cast ptr:Node rest) cdr) null)
                                 (as raw:Node ((unsafe/cast ptr:Node rest) car))
                                 rest)
              base:(raw Type) (extract-name-and-type inner out-name line))
          (when (= base null) (return null))
          (when (!= (bit-and flags DECL-ATTR-VOLATILE) 0)
            ; null-checked raw->ref: type-with-volatile takes a non-null Type*
            ; (there is no `as` spelling for a runtime-null-checked raw->ref).
            (return (as raw:Type (type-with-volatile (unsafe/cast ref:Type base)))))
          (return base))))
    ; Simple symbol: name:type[:more] — desugar first if multi-colon,
    ; else use split-typed and parse-type-name on the single tail token.
    (when (= (n kind) NODE-SYM)
      (let (s:ptr (n s)
            slen:i64 (as i64 (strlen (n s))))
        ; CP-3: a binding symbol ending in ':' is a whitespace near-miss (e.g. `x: (T)`) —
        ; desugar does not run inside defn bodies, so reject at this emit-time chokepoint.
        (when (and (> slen 0) (= (char-at s (- slen 1)) 58))
          (die-at line (fmt-s "binding name ends in ':' (%s) -- write name:(Type) with no space, or (name Type)" s)))
        (when (!= (strchr s 58) null)
          (let (sec-colon:ptr (strchr (unsafe/ptr+ (as ptr:i8 (strchr s 58)) 1) 58))
            (when (!= sec-colon null)
              ; Multi-colon: desugar to a list and re-dispatch
              (return (extract-name-and-type (desugar-symbol node line)
                                              out-name line)))))
        (let (tname:ptr null)
          (split-typed s out-name (as ptr:ptr (addr-of tname)))
          (when (!= tname null)
            (return (parse-type-name tname line)))
          (return null))))
    ; List node from desugar: (name type-info...)
    (when (= (n kind) NODE-CELL)
      (let (car-node:(raw Node) (n car))
        (when (and (!= car-node null) (= (car-node kind) NODE-SYM))
          ; CP-3: a field whose name cell is a trailing-colon symbol (e.g. `(f: (raw Node))`
          ; written with a space) — field CELLs bypass colon desugar, so reject here.
          (let (cs:ptr (car-node s)
                cslen:i64 (as i64 (strlen (car-node s))))
            (when (and (> cslen 0) (= (char-at cs (- cslen 1)) 58))
              (die-at line (fmt-s "binding name ends in ':' (%s) -- write name:(Type) with no space, or (name Type)" cs))))
         (ptr-set! out-name (car-node s))
         (let (rest:(raw Node) (n cdr))
           (when (= rest null) (return null))
           (let (type-node:(raw Node) (rest car))
             (when (= type-node null) (return null))
              ; If type is a symbol, parse it — parse-type-from-node also handles
              ; colon-sugar (`ptr:M7`), which arises when a generic instantiation
              ; substitutes a pointer type's spelling into a desugared (name T) head.
              (when (= (type-node kind) NODE-SYM)
                (return (parse-type-from-node type-node line)))
              ; If type is a list — (ptr T) or function-pointer type.
              ; Legacy fn-pointer form ((fn ret) (params)) was spread across
              ; the rest; for that case we still pass the whole rest.
              (when (= (type-node kind) NODE-CELL)
                (let (inner-head:(raw Node) (type-node car)
                      is-fn:i32 0)
                  (when (and (!= inner-head null)
                             (= (inner-head kind) NODE-SYM)
                             (= (inner-head s) "fn"))
                    (set! is-fn 1))
                  (if (!= is-fn 0)
                    (return (parse-type-from-node rest line))
                    (return (parse-type-from-node type-node line)))))
              (return null))))))
    (ptr-set! out-name null)
    (return null)))

; ============================================================
; Stage 14 defn-signature.md S1 — dual-acceptance signature accessor
; ============================================================
; The named-function signature is migrating from the legacy
;   (defn name:ret (params) body…)
; to the fn-style
;   (defn name (params) ret body…)
; During S1 the compiler accepts BOTH: a bare-symbol name with the return type as
; its own operand at index 3 (new), or a colon-typed / list-head name carrying the
; return type (legacy). Every reader of a defn shape funnels through these
; accessors so the two styles stay in lockstep and byte-identical for legacy code.

; True when a defn / protocol-sig name node is *new-style*: a bare symbol with no
; embedded return type. Legacy names are a colon-typed symbol (`name:ret`) or a
; desugared / list-head `(name ret)` cell. This is the single style-detection rule
; every consumer branches on.
(defn sig-name-is-bare (name-node:(raw Node)):i32
  (when (= name-node null) (return 0))
  (let (nn:(raw Node) name-node)
    (when (= (nn kind) NODE-CELL) (return 0))
    (when (and (= (nn kind) NODE-SYM) (!= (strchr (nn s) 58) null)) (return 0))
    (when (= (nn kind) NODE-SYM) (return 1))
    (return 0)))

; The raw return-type node embedded in a *legacy* defn name node: the type of a
; desugared / list-head `(name ret)` cell, or (for an un-desugared `name:ret`
; symbol) the type recovered by desugaring the symbol first. Null if the name
; carries no return type.
(defn legacy-ret-node (name-node:(raw Node)):(raw Node)
  (let (nn:(raw Node) name-node)
    (when (= (nn kind) NODE-CELL) (return (binding-type-node name-node)))
    (when (and (= (nn kind) NODE-SYM) (!= (strchr (nn s) 58) null))
      (return (binding-type-node (desugar-symbol name-node (nn line)))))
    (return null)))

; Central signature accessor for a full defn form `(defn NAME …)`. Detects style,
; writes the bare function name, the *raw* return-type node (a NODE-KEYWORD /
; NODE-SYM / NODE-CELL, left unparsed — the generic-template path must not eagerly
; parse a free-tyvar return, per the TY-TYVAR confinement rule), the parameter
; list node, and the index of the first body form. Returns 1 for new style, 0 for
; legacy. Diagnostics use the *form's* line (interned name/keyword nodes carry 0).
(defn defn-parse-sig (form:(raw Node) out-name:ptr:ptr out-ret-node:ptr:ptr
                          out-params:ptr:ptr out-body-start:ptr:i32):i32
  (let (ff:(raw Node) form
        name-node:(raw Node) (node-at form 1))
    (ptr-set! out-params (node-at form 2))
    (if (!= (sig-name-is-bare name-node) 0)
      ; New style: bare name, ret at index 3, body at 4.
      (do
        (ptr-set! out-name (name-node s))
        (when (< (node-len form) 4)
          (die-at (ff line)
            (fmt-2s "defn '%s': expected return type after the parameter list, e.g. (defn %s (params):i32 …)"
                    (name-node s)
                    (name-node s))))
        (ptr-set! out-ret-node (node-at form 3))
        (ptr-set! out-body-start 4)
        (return 1))
      ; S4: the legacy `name:ret` / list-head `(name ret)` signature is retired.
      ; The dual-detection machinery (sig-name-is-bare / legacy-ret-node /
      ; defn-name-only) is kept precisely so this diagnostic can recognize the
      ; legacy shape and quote the offending name; only the *behavior* changed
      ; from "parse it" to "die with a clear message". (return 0) is unreachable
      ; — die-at exits — but keeps the branch an i32-yielding terminator.
      (do
        (die-at (ff line)
          (fmt-2s "defn '%s': legacy 'name:ret' syntax is no longer supported — write (defn %s (params):ret …)"
                  (defn-name-only name-node) (defn-name-only name-node)))
        (return 0)))))

; Normalize a return-type node so a new-style NODE-KEYWORD ret (`:T`, `:i32`)
; reads as the equivalent NODE-SYM — making it structurally identical to a legacy
; desugared return, which the generic type-resolution machinery expects (bare-tyvar
; detection, tyvar collection, parse-type-from-node). NODE-SYM / NODE-CELL rets and
; null pass through unchanged, so legacy forms are byte-identical.
(defn normalize-ret-node (rn:(raw Node)):(raw Node)
  (when (= rn null) (return null))
  (let (rnn:(raw Node) rn)
    (when (= (rnn kind) NODE-KEYWORD)
      (let (new:ref:Node (alloc-node))
        (.set! new kind NODE-SYM)
        (.set! new line (rnn line))
        (.set! new s (rnn s))
        (return new)))
    (return rn)))

; The normalized return-type node of a defn form, style-agnostic and non-dying
; (null if the form carries no return). Byte-identical to
; `(binding-type-node name-node)` for a legacy form.
(defn defn-ret-node (form:(raw Node)):(raw Node)
  (let (name-node:(raw Node) (node-at form 1)
        rn:(raw Node) null)
    (if (!= (sig-name-is-bare name-node) 0)
      (when (>= (node-len form) 4) (set! rn (node-at form 3)))
      (set! rn (legacy-ret-node name-node)))
    (return (normalize-ret-node rn))))

; Parse a protocol method signature `(name params [ret])` (new style) or the
; legacy `(name:ret params)` / `((name ret) params)`. Sets *out-name (bare method
; name), *out-ret-node (normalized ret node; null if none) and *out-params.
; Returns 1 for new style, 0 for legacy. Byte-identical name/ret/params for the
; legacy shapes.
(defn proto-sig-parse (sig:(raw Node) out-name:ptr:ptr out-ret-node:ptr:ptr out-params:ptr:ptr):i32
  (let (name-node:(raw Node) (node-at sig 0))
    (ptr-set! out-params (node-at sig 1))
    (if (!= (sig-name-is-bare name-node) 0)
      (do
        (ptr-set! out-name (name-node s))
        (if (>= (node-len sig) 3)
          (ptr-set! out-ret-node (normalize-ret-node (node-at sig 2)))
          (ptr-set! out-ret-node null))
        (return 1))
      ; S4: legacy `(name:ret params)` / `((name ret) params)` protocol sigs are
      ; retired; detection stays so the diagnostic can quote the method name.
      (do
        (die-at (sig line)
          (fmt-2s "protocol method '%s': legacy 'name:ret' syntax is no longer supported — write (%s (params):ret)"
                  (defn-name-only name-node) (defn-name-only name-node)))
        (return 0)))))

; ============================================================
; Expression codegen
; ============================================================

; Stage 10 Phase F1: is `n` a (label NAME) form? Used by the emit-node dead-code
; guard, which must still emit labels after a terminator (they are goto targets).
(defn node-is-label-form (n:(raw Node)):i32
  (when (= n null) (return 0))
  (let (nn:(raw Node) n)
    (when (!= (nn kind) NODE-CELL) (return 0))
    (when (< (node-len n) 1) (return 0))
    (let (head:(raw Node) (node-at n 0))
      (when (!= (head kind) NODE-SYM) (return 0))
      (when (= head 'label) (return 1))
      (return 0))))

(defn emit-node (n:(raw Node) scope:ref:Scope):ref:Val
  ; Stage 10 Phase F1: the current block is already terminated (a return, goto,
  ; trap, or noreturn call closed it). Anything textually after the terminator in
  ; the same statement sequence is dead code; emitting it would put an
  ; instruction after a terminator, which LLVM rejects. Skip it and yield void —
  ; statement-sequence callers (do/let/with/defn-body/cond/match arms) already
  ; key their phi/join handling on g-block-term, so a void result is unused.
  ; Exception: a (label …) form must still emit — it opens a fresh block that is
  ; a goto/blockaddress target reachable from elsewhere, so it is *not* dead even
  ; after a terminator (emit-label already handles the terminated-predecessor
  ; case by omitting the fall-through branch).
  (when (!= g-block-term 0)
    (when (= (node-is-label-form n) 0)
      (return (alloc-val ty-void null))))
  ; W5f: `()` in expression position reads as a NULL node (read-list returns null
  ; for a zero-element list), and every line/kind read below dereferences it. No
  ; working program can reach here with null — this deref has always faulted — so
  ; diagnosing is strictly an improvement over the segfault. The ambient
  ; g-form-line is the enclosing form's, which is the only location `()` has.
  (when (= n null)
    (die-at g-form-line "'()' is not an expression -- the empty list has no value"))
  (let (nn:(raw Node) n
        ; Stage 15 W4a: adopt this node's line as the ambient diagnostic line for
        ; the duration of its emission, and restore the caller's on the way out
        ; (the single maintenance point for g-form-line — see its defvar). A node
        ; with no line of its own (an interned symbol; a macro-synthesized cell
        ; that stamp-macro-lines could not attribute) leaves the enclosing form's
        ; line standing, which is exactly what its diagnostics should blame.
        saved-form-line:i32 g-form-line
        v:ref:Val (alloc-val ty-void null))
    (when (!= (nn line) 0) (set! g-form-line (nn line)))
    (when (= (nn kind) NODE-INT)   (set! v (emit-int n)))
    (when (= (nn kind) NODE-CHAR)  (set! v (emit-char-literal n)))
    (when (= (nn kind) NODE-FLOAT) (set! v (emit-float n)))
    ; NS-2: pass a null target — literals stay CStr (bare GEP). NS-3 will thread
    ; the consumer's expected type here so a StrView context materializes a view.
    (when (= (nn kind) NODE-STR)   (set! v (emit-string n null)))
    (when (= (nn kind) NODE-SYM)   (set! v (emit-symbol-ref n scope g-form-line)))
    (when (= (nn kind) NODE-KEYWORD) (set! v (emit-keyword n scope)))
    (when (= (nn kind) NODE-CELL)  (set! v (emit-list n scope)))
    ; Rung 3: the type a node contributes to its parent is the shared node-type
    ; rule's answer, so codegen and the (non-emitting) type pass cannot drift —
    ; a mismatch corrupts the next bootstrap and is caught at once. node-type
    ; returns null for the forms it does not model; those keep emit's own type.
    (let (t:ptr (node-type n scope))
      (when (!= t null) (.set! v type t)))
    ; Restore last: node-type raises its own diagnostics (the retired-spelling
    ; checks in node-type-call) and must see this node's line too.
    (set! g-form-line saved-form-line)
    (return v)))

; Stage 14 LW-4: the *truthful* width of an integer literal whose value is `v`
; — `i32` when it fits (the overwhelming majority — keeps IR near-identical and
; preserves the emit-then-coerce path), `i64` otherwise, so a large literal
; carries its real value instead of silently wrapping through a 32-bit constant
; (the old bug: `5000000000` printed `705032704`; FNV constants truncated).
;
; Stage 15 W2b made this a shared function rather than three copies of the same
; `if`: `emit-int` below, `emit-defconst` (which hardcoded `ty-i32` and so
; reproduced the very wrapping bug LW-4 fixed for inline literals — `(defconst
; BIG 5000000000)` printed `705032704`), and `node-type`'s NODE-INT branch
; (src/generics.nuc, the emit/node-type lockstep). One rule, one home; see the
; `binop-result-type` note below for why that shape is the anti-drift device.
(defn int-literal-type (v:i64):ref:Type
  (when (!= (int-literal-fits v ty-i32) 0) (return ty-i32))
  (return ty-i64))

; Emit an integer literal at its truthful width (int-literal-type above). The
; Val is tagged with the known value so `coerce-int-val` can reject an
; out-of-range narrowing (`(take8 300)`) at compile time.
(defn emit-int (n:(raw Node)):ref:Val
  (let (v:i64 (n i)
        ty:ptr (as ptr (int-literal-type v))
        rv:ref:Val (alloc-val ty (fmt-i64 "%ld" v)))
    (.set! rv is-lit 1)
    (.set! rv lit-i64 v)
    (return rv)))

; Stage 11 M6 (S0): a `\a` / `\newline` / `\u{1F600}` char literal. The reader
; lexed the (validated) Unicode scalar value into the node's `i` field; emit it
; as a `Char`-typed i32 constant. Distinct from emit-int only in the result type,
; so `=`/`!=` dispatch and `Char`-vs-int overloads see a `Char`, not an `i32`.
(defn emit-char-literal (n:(raw Node)):ref:Val
  (return (alloc-val ty-char (fmt-i64 "%ld" (n i)))))

; Translate a float literal lexeme to an LLVM IR floating-point
; constant. Hex bit-patterns for the Scheme-style special tokens
; `+inf.0`, `-inf.0`, `+nan.0`. Otherwise normalize to LLVM's
; required form: a leading digit, an explicit `.` with at least
; one fractional digit, and optional exponent. So `1e3` -> `1.0e3`,
; `.5` -> `0.5`, `2.` -> `2.0`.
(defn float-literal-ir (lex:CStr):CStr
  (when (= lex "+inf.0") (return "0x7FF0000000000000"))
  (when (= lex "-inf.0") (return "0xFFF0000000000000"))
  (when (= lex "+nan.0") (return "0x7FF8000000000000"))
  (let (len:i64 (strlen lex)
        buf:ptr (malloc 96)
        out:i64 0
        in:i64 0)
    ; Optional sign.
    (when (and (> len 0)
               (or (= (char-at lex 0) 43)
                   (= (char-at lex 0) 45)))
          (aset! (as ptr:i8 buf) out (unsafe/cast i8 (char-at lex 0)))
      (set! out (+ out 1))
      (set! in 1))
    ; Integer part: insert leading 0 if absent.
    (let (had-int-digit:i32 0)
      (while (and (< in len)
                  (!= (isdigit (char-at lex in)) 0))
        (aset! (as ptr:i8 buf) out (unsafe/cast i8 (char-at lex in)))
        (inc! out)
        (inc! in)
        (set! had-int-digit 1))
      (when (= had-int-digit 0)
            (aset! (as ptr:i8 buf) out (unsafe/cast i8 (as i64 48)))
        (inc! out)))
    ; Decimal point + fraction. Synthesize a `.0` if missing.
    (cond (and (< in len) (= (char-at lex in) 46))
            (do (aset! (as ptr:i8 buf) out 46)
                (set! out (+ out 1))
                (set! in (+ in 1))
                (let (had-frac-digit:i32 0)
                  (while (and (< in len)
                              (!= (isdigit (char-at lex in)) 0))
                    (aset! (as ptr:i8 buf) out (unsafe/cast i8 (char-at lex in)))
                    (inc! out)
                    (inc! in)
                    (set! had-frac-digit 1))
                  (when (= had-frac-digit 0)
                    (aset! (as ptr:i8 buf) out 48)
                    (set! out (+ out 1)))))
          true
            (do (aset! (as ptr:i8 buf) out 46)
                (aset! (as ptr:i8 buf) (+ out 1) 48)
                (set! out (+ out 2))))
    ; Exponent (verbatim).
    (while (< in len)
      (aset! (as ptr:i8 buf) out (unsafe/cast i8 (char-at lex in)))
      (inc! out)
      (inc! in))
    (aset! (as ptr:i8 buf) out 0)
    (return buf)))

; Stage 15 W2d (design/stage15-stress-test/literal-typing.md §3.6): the VALUE a
; float-literal lexeme denotes, as a host double. The three Scheme-style special
; tokens are spelled out because `strtod` does not know them; every other lexeme
; the reader accepts (`1e3`, `.5`, `2.`, `-0.75`) is exactly what `strtod`
; accepts, so no normalization is needed here — `float-literal-ir` above
; normalizes for LLVM's *printer*, this parses for LLVM's *value*. Keeping the
; two in one place would be nice but they answer different questions; they are
; kept adjacent instead, and both are exercised by every f32 literal.
(defn float-literal-value (lex:CStr):f64
  (when (= lex "+inf.0") (return (strtod "inf" null)))
  (when (= lex "-inf.0") (return (strtod "-inf" null)))
  (when (= lex "+nan.0") (return (strtod "nan" null)))
  (return (strtod lex null)))

; Stage 15 W2d: render `d` as an LLVM constant valid for the `float` type.
;
; LLVM only accepts a *decimal* floating-point constant for `float` when the
; value round-trips exactly (`float 3.14` is rejected outright —
; "floating point constant invalid for type"), so the general spelling is the
; hexadecimal form: the 64 bits of the DOUBLE that the intended float value
; widens to. `(as f64 (unsafe/cast f32 d))` performs exactly that round trip —
; one round-to-nearest to single, then an exact widening back — and the bit
; pattern is read out through the value's own storage, since Nucleus has no
; bitcast operator. Output matches clang byte for byte (`3.14f` →
; 0x40091EB860000000).
;
; Note the rounding here is the same double-rounding (decimal → f64 → f32) that
; `(unsafe/cast f32 3.14)` has always performed; W2d makes the conversion
; implicit but does not add a rounding step (literal-typing.md §W2d).
; An out-of-range magnitude saturates to ±inf, as it does in C (`float d =
; 1e300;` is a clang warning, not an error) — deliberately NOT the LW-4
; integer treatment, see "the range check that isn't" in the W2d design note.
(defn f32-const-ir (d:f64):CStr
  (let (r:f64 (as f64 (unsafe/cast f32 d))
        p:ptr:f64 (addr-of r)
        bits:i64 (deref (unsafe/cast ptr:i64 p)))
    (return (fmt-i64 "0x%016lX" bits))))

; Stage 15 W2d: THE rule for "what text does this float literal have at this
; width" — one home, called by both the global-initializer path
; (`defvar-init-ir`) and the value path (`emit-float` → the literal fold in
; `coerce-int-val`), the same shape W2a used for `binop-result-type` and W2b
; for `int-literal-type`. An f64 target keeps the historical lexeme
; normalization verbatim, so every existing program's IR is byte-identical.
(defn float-literal-ir-at (lex:CStr ty:(raw Type)):CStr
  (when (= (ty kind) TY-F32) (return (f32-const-ir (float-literal-value lex))))
  (return (float-literal-ir lex)))

(defn emit-float (n:(raw Node)):ref:Val
  (let (nn:(raw Node) n)
    ; Stage 14 AVR-7: a bare float literal defaults to f64, which AVR cannot
    ; support (no hardware double). This is the second finalization point (the
    ; first is an explicit :f64/double annotation in parse-type-name): a literal
    ; whose f64-ness comes only from the default — e.g. `(let (x 1.5) …)`, or a
    ; literal passed to an f64 parameter — never touches parse-type-name, so it
    ; must be caught here. Inert off AVR (byte-identical).
    (avr-reject-f64 (nn line))
    ; Stage 15 W2d: tag the Val with the literal's value so the coercion
    ; chokepoint can re-render it at an f32 target with no instruction. The
    ; literal's OWN type stays f64 — adaptation is the consumer's decision, made
    ; where the target type is known, exactly as for an integer literal.
    (let (rv:ref:Val (alloc-val ty-f64 (float-literal-ir (nn s))))
      (.set! rv is-flit 1)
      (.set! rv lit-f64 (float-literal-value (nn s)))
      (return rv))))

(defn emit-string (n:(raw Node) target:(raw Type)):ref:Val
  (let (nn:(raw Node) n
        id:i32 (intern-string (nn s) (unsafe/cast i32 (strlen (nn s))))
         slen:i32 ((invoke g-strs (as usize id)) len)
        ir-len:i32 (+ slen 1)
        tmp:ptr (new-tmp))
    (fprintf g-body-stream
      "  %s = getelementptr inbounds [%d x i8], ptr @.str.%d, i64 0, i64 0\n"
      tmp ir-len id)
    ; Stage 14 NS-4 (design/stage14/native-strings.md): an explicit c"…" literal
    ; (the reader set Node.i=1) is a CStr — the bare char*, no StrView view header
    ; and no target-typing. Return the GEP as CStr regardless of the ambient
    ; target, short-circuiting the NS-3 StrView logic below. Dormant for the
    ; compiler's own literals (all i=0 → the StrView path), so byte-identical.
    (when (!= (nn i) 0)
      (return (alloc-val ty-cstr tmp)))
    ; Stage 14 NS-3 (design/stage14/native-strings.md): the flip — a string
    ; literal now types as StrView (node-type mirrors this at the three lockstep
    ; sites in generics.nuc). Emission stays *target-aware and byte-identical*: the
    ; bare GEP above is the only IR the common (ptr/CStr) case needs.
    ;
    ; Eager materialization: when a caller *explicitly* threads a StrView target,
    ; build the {data,len} view here (data = the bare GEP, len = the interned byte
    ; count, no runtime strlen). emit-node passes null, so this stays dormant for
    ; the compiler's own literals.
    (when (!= (type-is-strview target) 0)
      (let (v0:ptr (new-tmp)
            v1:ptr (new-tmp)
            svir:CStr (type-to-ir target))
        (fprintf g-body-stream "  %s = insertvalue %s undef, ptr %s, 0\n"
          v0 svir tmp)
        (fprintf g-body-stream "  %s = insertvalue %s %s, %s %d, 1\n"
          v1 svir v0 (ptr-int-ir) slen)
        (return (alloc-val target v1))))
    ; Default path (no threaded target): return an *unmaterialized* StrView
    ; literal. Only the bare GEP was emitted; the Val carries the data pointer in
    ; `val` and the byte length in `lit-i64`, with `is-lit=1` marking it a literal
    ; (a StrView type disambiguates it from an int literal — the only other is-lit
    ; user). A consumer that wants ptr/CStr *collapses* it back to that bare GEP
    ; with NO extra IR (coerce-int-val / safe-coerce-val / abi-arg-frag /
    ; strview-data-ir all special-case this literal), so every fprintf/fmt/strcmp/
    ; `= "lit"` site in the compiler emits exactly as before → byte-identical
    ; bootstrap. A consumer that genuinely wants a StrView materializes {ptr,len}
    ; from these fields (coerce-int-val). If StrView is somehow unregistered (a
    ; broken prelude), fall back to the old CStr literal — consistent with
    ; node-type returning null for NODE-STR in that case.
    (let (svty:(raw Type) (strview-type))
      (when (= svty null) (return (alloc-val ty-cstr tmp)))
      (let (rv:ref:Val (alloc-val svty tmp))
        (.set! rv is-lit 1)
        (.set! rv lit-i64 (as i64 slen))
        (return (as ptr rv))))))

; Keyword literal (Stage 11 cleanup §2). `:foo` self-evaluates to the one
; canonical `Keyword` value for "foo". Rather than hand-roll the (struct-by-value
; returning) call IR, lower to the synthetic call form `(keyword-intern "foo")`
; and route it through the ordinary emit path — so dispatch, the struct-return
; ABI, and node-type all reuse the existing machinery. The program must
; `(import keyword)` to provide `keyword-intern` (exactly as `[...]`/`{...}`
; require their collection libs). The node's `s` is the name with the leading
; colon already stripped by the reader.
(defn emit-keyword (n:(raw Node) scope:ref:Scope):ref:Val
  (let (nn:(raw Node) n
        line:i32 (nn line)
        ; Synthetic NODE-STR carrying the keyword name.
        strnode:ref:Node (alloc-node))
    (.set! strnode kind NODE-STR)
    (.set! strnode line line)
    (.set! strnode s (nn s))
    ; (keyword-intern "name")
    (let (call:ptr (make-cell (as ptr 'keyword-intern)
                     (make-cell (as ptr strnode) null line)
                     line))
      (return (emit-node call scope)))))

; Build a quoted Node tree at runtime so that quoted symbols share Node
; identity with reader-produced ones. Returns a body-stream tmp ref.
;
; - NODE-SYM:   call ptr @intern-symbol(spelling)
; - NODE-CELL:  recurse on car/cdr, then call ptr @make-cell(car, cdr, line)
; - NODE-INT/STR/FLOAT: alloc-node, then store the relevant fields
(defn emit-quote-tree (n:(raw Node)):CStr
  (when (= n null) (return "null"))
  (let (nn:(raw Node) n)
    (when (= (nn kind) NODE-SYM)
      (let (sid:i32 (intern-string (nn s) (unsafe/cast i32 (strlen (nn s))))
            ir-len:i32 (+ ((invoke g-strs (as usize sid)) len) 1)
            tmp:CStr (new-tmp))
        (fprintf g-body-stream
          "  %s = call ptr @intern-symbol(ptr getelementptr inbounds ([%d x i8], ptr @.str.%d, i64 0, i64 0))\n"
          tmp ir-len sid)
        (return tmp)))
    (when (= (nn kind) NODE-CELL)
      (let (car-ref:CStr (emit-quote-tree (nn car))
            cdr-ref:CStr (emit-quote-tree (nn cdr))
            tmp:CStr (new-tmp))
        (fprintf g-body-stream "  %s = call ptr @make-cell(ptr %s, ptr %s, i32 %d)\n"
                 tmp car-ref cdr-ref (nn line))
        (return tmp)))
    ; NODE-INT / NODE-STR / NODE-FLOAT / NODE-KEYWORD / NODE-CHAR — runtime alloc
    ; + fill. NODE-KEYWORD (Stage 11 cleanup §2) stores its name in `s` like
    ; NODE-STR but must also write its own kind (NODE-INT is 0, so alloc-node's
    ; zero-fill already names it for the INT case; every other literal kind is
    ; stored). NODE-CHAR (S0) stores its kind too, then its codepoint via the
    ; NODE-INT `i`-store branch below.
    (let (tmp:CStr (new-tmp))
      (fprintf g-body-stream "  %s = call ptr @alloc-node()\n" tmp)
      (when (or (= (nn kind) NODE-STR)
                (= (nn kind) NODE-FLOAT)
                (= (nn kind) NODE-KEYWORD) (= (nn kind) NODE-CHAR))
        (let (kp:CStr (new-tmp))
          (fprintf g-body-stream
            "  %s = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %s, i32 0, i32 0\n"
            kp tmp)
          (fprintf g-body-stream "  store i32 %d, ptr %s, align 4\n" (nn kind) kp)))
      (let (lp:CStr (new-tmp))
        (fprintf g-body-stream
          "  %s = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %s, i32 0, i32 1\n"
          lp tmp)
        (fprintf g-body-stream "  store i32 %d, ptr %s, align 4\n" (nn line) lp))
      (when (or (= (nn kind) NODE-INT) (= (nn kind) NODE-CHAR))
        (let (ip:CStr (new-tmp))
          (fprintf g-body-stream
            "  %s = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %s, i32 0, i32 2\n"
            ip tmp)
          (fprintf g-body-stream "  store i64 %ld, ptr %s, align 8\n" (nn i) ip)))
      (when (or (= (nn kind) NODE-STR)
                (= (nn kind) NODE-FLOAT)
                (= (nn kind) NODE-KEYWORD))
        (let (sid:i32 (intern-string (nn s) (unsafe/cast i32 (strlen (nn s))))
            ir-len:i32 (+ ((invoke g-strs (as usize sid)) len) 1)
              sp:CStr (new-tmp))
          (fprintf g-body-stream
            "  %s = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %s, i32 0, i32 3\n"
            sp tmp)
          (fprintf g-body-stream
            "  store ptr getelementptr inbounds ([%d x i8], ptr @.str.%d, i64 0, i64 0), ptr %s, align 8\n"
            ir-len sid sp)))
      (return tmp))))

; Stage 14 MC-2 (design/stage14/macro-conditional-casts.md): quasiquote results,
; plain `quote`, and `(gensym)` all produce a Node* — type them (raw Node)
; instead of bare `ptr` so pure-qq conds type as (raw Node) end to end and a qq
; result chains member access directly (`(`(a b)` car)`). Built the way
; emit-defmacro builds (raw Node) for macro params (make-type TY-PTR + elem =
; Node + PTR-RAW), cached on first success. Falls back to bare ty-ptr when `Node`
; is not registered — an (exclude-prelude) program can still use quote forms —
; and does not cache the fallback, so a later use once Node is registered still
; gets the honest type. `parse-type-name "Node"` would `die-at` on an unknown
; type, so `lookup-struct` (a non-dying, strcmp-content check — StructDef.name is
; CStr) guards it.
(defn ty-raw-node ():(raw Type)
  (when (= g-ty-raw-node null)
    (let (sd:(raw StructDef) (struct-lookup-ref "Node"))
      (when (!= sd null)
        (let (t:ref:Type (make-type TY-PTR))
          (.set! t elem (parse-type-name "Node" 0))
          (.set! t pkind PTR-RAW)
          (set! g-ty-raw-node (as ptr t))))))
  (if (= g-ty-raw-node null) ty-ptr g-ty-raw-node))

(defn emit-quote (call:(raw Node)):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len call) 2) (die-at (cc line) "quote: expects 1 arg"))
    (let (ref:CStr (emit-quote-tree (node-at call 1)))
      (return (alloc-val (ty-raw-node) ref)))))

(defn qq-is-tagged (n:(raw Node) tag:(raw Node)):i32
  (when (= n null) (return 0))
  (let (nn:(raw Node) n)
    (when (!= (nn kind) NODE-CELL) (return 0))
    (when (!= (node-len n) 2) (return 0))
    (let (h:(raw Node) (nn car))
      (when (= h null) (return 0))
      (when (!= (h kind) NODE-SYM) (return 0))
      (when (= h tag) (return 1))
      (return 0))))

(defn emit-qq-list (list:(raw Node) scope:ref:Scope):ref:Val
  (when (= list null) (return (alloc-val (ty-raw-node) "null")))
  (set! g-qq-used 1)
  (let (lc:(raw Node) list
        elem:(raw Node) (lc car))
    (when (!= (qq-is-tagged elem 'unquote-splice) 0)
      (let (inner:(raw Node) (node-at elem 1)
            a:ref:Val (emit-node inner scope)
            rest:ref:Val (emit-qq-list (lc cdr) scope)
            tmp:CStr (new-tmp))
        (fprintf g-body-stream "  %s = call ptr @__append(ptr %s, ptr %s)\n"
                 tmp (a val) (rest val))
        (return (alloc-val (ty-raw-node) tmp))))
    (let (head:ref:Val (emit-qq-form elem scope)
          tail:ref:Val (emit-qq-list (lc cdr) scope)
          tmp:CStr (new-tmp))
      (fprintf g-body-stream "  %s = call ptr @__cons(ptr %s, ptr %s)\n"
               tmp (head val) (tail val))
      (return (alloc-val (ty-raw-node) tmp)))))

(defn emit-qq-form (form:(raw Node) scope:ref:Scope):ref:Val
  (when (= form null) (return (alloc-val (ty-raw-node) "null")))
  (let (fn:(raw Node) form)
    (when (!= (fn kind) NODE-CELL)
      (let (ref:CStr (emit-quote-tree form))
        (return (alloc-val (ty-raw-node) ref))))
    (when (!= (qq-is-tagged form 'unquote) 0)
      (return (emit-node (node-at form 1) scope)))
    (when (!= (qq-is-tagged form 'unquote-splice) 0)
      (die-at (fn line) "unquote-splice outside list"))
    (return (emit-qq-list form scope))))

(defn emit-quasiquote (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len call) 2) (die-at (cc line) "quasiquote: expects 1 arg"))
    (return (emit-qq-form (node-at call 1) scope))))

; ============================================================
; Stage 10: flow narrowing (nullability.md §4) + escape analysis (lifecycle.md)
; ============================================================
; Narrowing: inside a region dominated by a successful non-null test, a local
; ?T binding reads as (ref T). State lives on Sym (ntype/ndepth/kstamp) with a
; global undo stack, and is maintained where control flow is emitted (cond,
; and/or, while, label, set!) — macro-expanded guards like `when`/`if` have
; already lowered to cond by then, so the compiler's own null-guard idioms are
; the narrowing points. Reads (emit-symbol-ref and node-type-sym) share
; sym-effective-type, so the type pass cannot drift from codegen.
;
; Soundness notes:
;  - A kill (assignment) bumps the binding's kstamp; undo entries record the
;    stamp at push and a restore is skipped if it changed, so a branch join can
;    never resurrect a narrow past a reassignment (kills are sticky).
;  - Loop bodies are pre-scanned for textual (set! x ...) so a narrow from
;    outside the loop is dropped before the body emits; a macro-synthesized
;    assignment is caught by the emit-set backstop (ndepth < g-loop-depth).
;  - (label ...) is a potential backward-goto target: all narrows are killed.

(defn sym-effective-type (sym:(raw Sym)):(raw Type)
  (let (ss:(raw Sym) sym)
    (when (!= (ss ntype) null) (return (ss ntype)))
    (return (ss type))))

(defn narrow-mark ():i32
  (return (unsafe/cast i32 (count g-nundo))))

; Narrow binding `name` (resolved in `scope`) to the non-null view of its
; current effective type, pushing an undo entry. No-op unless the binding
; currently reads as a local (Maybe (ref T)).
(defn narrow-apply (scope:ref:Scope name:CStr):void
  (let (sym:?ptr:Sym (scope-lookup scope name))
    (when (= sym null) (return))
    (when (= (sym is-local) 0) (return))
    (let (eff:ptr (sym-effective-type sym))
      (when (!= (ptr-pkind eff) PTR-MAYBE) (return))
      (let (u:ref:NarrowUndo (new NarrowUndo))
        (.set! u name name)
        (.set! u scope scope)
        (.set! u old-ntype (sym ntype))
        (.set! u old-ndepth (sym ndepth))
        (.set! u stamp (sym kstamp))
        (conj g-nundo u))
      (.set! sym ntype (type-as-pkind eff PTR-REF))
      (.set! sym ndepth g-loop-depth))))

; Undo narrows back to `mark` (a branch/region boundary). Entries whose
; binding was killed after the push are skipped.
(defn narrow-restore (mark:i32):void
  ; Read/shrink the undo stack's len via the explicit raw field intrinsic _get
  ; (not the callable form (g-nundo len), which a later dispatch change would
  ; route differently). The pop discards the entry; the buffer is reused.
  (while (> (unsafe/cast i32 (_get g-nundo len)) mark)
    (let (u:ref:NarrowUndo
            (invoke g-nundo (- (_get g-nundo len) 1)))
      (let (sym:?ptr:Sym (scope-lookup (u scope) (u name)))
        (when (!= sym null)
          (when (= (u stamp) (sym kstamp))
            (.set! sym ntype (u old-ntype))
            (.set! sym ndepth (u old-ndepth)))))
      (.set! g-nundo len (- (_get g-nundo len) 1)))))

; Kill a binding's narrow: reassignment invalidates the dominating test.
(defn narrow-kill (sym:(raw Sym)):void
  (let (ss:(raw Sym) sym)
    (.set! ss ntype null)
    (.set! ss kstamp (+ (ss kstamp) 1))))

; Kill every live narrow (label join points — a backward goto re-enters).
(defn narrow-kill-all ():void
  (when (= g-nundo null) (return))
  (doseq (n g-nundo (VecIter (ref NarrowUndo)))
    (let (u:ref:NarrowUndo n)
      (let (sym:?ptr:Sym (scope-lookup (u scope) (u name)))
        (when (and (!= sym null) (!= (sym ntype) null))
              (narrow-kill sym))))))

; Is `node` the symbol `null`? (content compare — macro-built nodes may not be
; interned).
(defn node-is-null-sym (node:(raw Node)):i32
  (when (= node null) (return 0))
  (let (nn:(raw Node) node)
    (when (!= (nn kind) NODE-SYM) (return 0))
    (when (= (strcmp (nn s) "null") 0) (return 1))
    (return 0)))

; If `node` is a plain binding reference, its lookup name (annotation
; stripped); else null. Return stays `ptr` (NOT CStr): callers `conj` it
; directly into a `(Vector ptr)` fact accumulator (test-true-nonnull /
; test-false-nonnull below) — a CStr argument does not adapt to that bare-ptr
; generic dispatch parameter (the batch-2 `Val.val` conj-sink trap).
(defn node-binding-name (node:(raw Node)):ptr
  (when (= node null) (return null))
  (let (nn:(raw Node) node)
    (when (!= (nn kind) NODE-SYM) (return null))
    (when (= (strcmp (nn s) "null") 0) (return null))
    (let (name:ptr null
          ti:ptr null)
      (split-typed (nn s) (as ptr:ptr (addr-of name)) (as ptr:ptr (addr-of ti)))
      (return name))))

; Collect binding names proven non-null when `test` is TRUE into `out`:
;   (!= m null) — m;  (and A B) / (_and A B) — both arms;  (not X) — X's false-facts.
; `out` is the (ref (Vector ptr)) fact accumulator; the drain deferral makes the
; parametric type safe in this signature (see make-vec).
(defn test-true-nonnull (test:(raw Node) (out (ref (Vector ptr)))):void
  (when (= test null) (return))
  (let (nn:(raw Node) test)
    (when (!= (nn kind) NODE-CELL) (return))
    (let (head:(raw Node) (node-at test 0))
      (when (or (= head null) (!= (head kind) NODE-SYM)) (return))
      (let (h:ptr (head s))
        ; Match both "_and" (the binary primitive, post-macro-expansion) and "and"
        ; (a raw variadic macro call still unexpanded in a cond/while test slot).
        (when (or (= (strcmp h "_and") 0) (= (strcmp h "and") 0))
          (dotimes (i (node-len test))
             (test-true-nonnull (node-at test i) out))
          (return))
        (when (= (strcmp h "not") 0)
          (when (= (node-len test) 2)
            (test-false-nonnull (node-at test 1) out))
          (return))
        (when (= (strcmp h "!=") 0)
          (when (= (node-len test) 3)
            (let (a:(raw Node) (node-at test 1)
                  b:(raw Node) (node-at test 2))
              (when (and (!= (node-is-null-sym b) 0) (!= (node-binding-name a) null))
                (conj out (node-binding-name a)))
              (when (and (!= (node-is-null-sym a) 0) (!= (node-binding-name b) null))
                (conj out (node-binding-name b)))))
          (return))))))

; Collect binding names proven non-null when `test` is FALSE into `out`:
;   (= m null) — m;  (or A B) / (_or A B) — both arms;  (not X) — X's true-facts.
; `out` is the (ref (Vector ptr)) fact accumulator (see test-true-nonnull).
(defn test-false-nonnull (test:(raw Node) (out (ref (Vector ptr)))):void
  (when (= test null) (return))
  (let (nn:(raw Node) test)
    (when (!= (nn kind) NODE-CELL) (return))
    (let (head:(raw Node) (node-at test 0))
      (when (or (= head null) (!= (head kind) NODE-SYM)) (return))
      (let (h:ptr (head s))
        ; Match both "_or" (the binary primitive, post-macro-expansion) and "or"
        ; (a raw variadic macro call still unexpanded in a cond/while test slot).
        (when (or (= (strcmp h "_or") 0) (= (strcmp h "or") 0))
          (dotimes (i (node-len test))
            (test-false-nonnull (node-at test i) out))
          (return))
        (when (= (strcmp h "not") 0)
          (when (= (node-len test) 2)
            (test-true-nonnull (node-at test 1) out))
          (return))
        (when (= (strcmp h "=") 0)
          (when (= (node-len test) 3)
            (let (a:(raw Node) (node-at test 1)
                  b:(raw Node) (node-at test 2))
              (when (and (!= (node-is-null-sym b) 0) (!= (node-binding-name a) null))
                (conj out (node-binding-name a)))
              (when (and (!= (node-is-null-sym a) 0) (!= (node-binding-name b) null))
                (conj out (node-binding-name b)))))
          (return))))))

; Narrow every name in `names` (a Vec) resolved against `scope`. `names` is the
; (ref (Vector ptr)) accumulator filled by test-true/false-nonnull; the drain
; deferral makes the parametric type safe in this signature (see make-vec).
(defn narrow-names (scope:ref:Scope (names (ref (Vector ptr)))):void
  (doseq (n names (VecIter ptr))
    (narrow-apply scope n)))

; Conservatively kill narrows for any textual (set! x ...) target inside `n` —
; run before a loop body emits, so a narrow established outside the loop can't
; license a use that a later iteration's assignment would invalidate.
(defn prescan-kill-sets (n:(raw Node) scope:ref:Scope):void
  (when (= n null) (return))
  (let (nn:(raw Node) n)
    (when (!= (nn kind) NODE-CELL) (return))
    (let (head:(raw Node) (node-at n 0))
      (when (and (!= head null)
                 (= (head kind) NODE-SYM) (= (strcmp (head s) "set!") 0))
        (when (>= (node-len n) 2)
          (let (tname:ptr (node-binding-name (node-at n 1)))
            (when (!= tname null)
              (let (sym:?ptr:Sym (scope-lookup scope tname))
                (when (and (!= sym null) (!= (sym ntype) null))
                  (narrow-kill sym))))))))
    (let (cur:(raw Node) n)
      (while (!= cur null)
        (prescan-kill-sets (cur car) scope)
        (set! cur (cur cdr))))))

; --- escape analysis helpers (lifecycle.md §2–3) ---

; Is scope `a` the same as, or lexically inside, scope `b`?
(defn scope-descends (a:(raw Scope) b:(raw Scope)):i32
  (when (= b null) (return 1))
  (let (cur:(raw Scope) a)
    (while (!= cur null)
      (when (= cur b) (return 1))
      (set! cur (cur parent))))
  (return 0))

; The deeper (shorter-lived) of two taint scopes. At any program point all
; live owning scopes enclose it, so two non-null taints are always nested.
(defn taint-merge (a:(raw Scope) b:(raw Scope)):(raw Scope)
  (when (= a null) (return b))
  (when (= b null) (return a))
  (when (!= (scope-descends a b) 0) (return a))
  (return b))

; Stage 13 L1: copy both escape-taint fields (the with/frame Scope* and the
; frame-region flag) from src to dst. Every identity-preserving op that today
; does `(.set! dst taint (src taint))` should call this instead so the
; frame-region distinction survives casts, ptr+, .&, and symbol reads.
(defn val-copy-taint (dst:(raw Val) src:(raw Val)):void
  (.set! dst taint (src taint))
  (.set! dst taint-frame (src taint-frame)))

; Escape sink for a store through a pointer (aset! / .set!, lifecycle.md §2.3):
; a tainted value may only be stored into memory that provably dies no later
; than the resource — memory owned by the same or an inner with-scope (its
; taint scope descends from the value's). Untainted targets (outer locals,
; globals, arena memory) outlive the with and are rejected.
(defn taint-store-check (tval:(raw Val) vval:(raw Val) line:i32 op:CStr):void
  (let (vtaint:(raw Scope) (vval taint))
    (when (= vtaint null) (return))
    ; Stage 13 L1: enforce only with-taint here; a frame-region pointer
    ; (taint-frame=1) stored through a pointer is an intra-frame borrow whose
    ; nested-region precision is deferred — the function-frame boundary is
    ; enforced at `return`.
    (when (!= (vval taint-frame) 0) (return))
    (when (= (scope-descends (tval taint) vtaint) 0)
      (die-at line
        (fmt-s "%s: resource bound by `with` escapes via store into longer-lived memory — use (move ...) to transfer ownership" op)))))

; ============================================================
; Unresolved-name diagnostics (Stage 15 W4a)
; ============================================================

; Levenshtein edit distance between two names, used only to suggest a spelling
; on an unresolved name. Returns a value > `limit` as soon as the answer cannot
; matter, so the common case (every registered name, scanned once per failed
; lookup) costs a length comparison. Allocation is a pair of DP rows, freed
; before returning.
(defconst NAME-SUGGEST-MAX 2)

; How many edits may separate `name` from a name worth suggesting. The allowance
; grows with length, and short names get none at all: without this, `K` "matches"
; the binop `%` at distance 1 and `gv` matches `_+`, which is worse than saying
; nothing. 4-6 characters buy one edit, 7 and up buy two.
(defn name-suggest-limit (name:CStr):i32
  (let (n:i32 (unsafe/cast i32 (strlen name)))
    (when (< n 4) (return 0))
    (when (< n 7) (return 1))
    (return NAME-SUGGEST-MAX)))

(defn name-edit-distance (a:CStr b:CStr limit:i32):i32
  (let (la:i32 (unsafe/cast i32 (strlen a))
        lb:i32 (unsafe/cast i32 (strlen b))
        result:i32 99)
    ; A length gap wider than the allowance needs at least that many edits.
    (when (> (- la lb) limit) (return 99))
    (when (> (- lb la) limit) (return 99))
    ; NOTE (W2a/§1.2): `(* 4 (as i64 (+ lb 1)))` used to mis-type — a literal-LEFT
    ; binop was typed i32 by node-type while emit widened to i64, so the i64
    ; binding got a bogus `sext i32 <i64 value>`. Fixed (binop-result-type is now
    ; the one shared rule), so either spelling is correct today; this one is kept
    ; because the committed boot compiler predates the fix and still mis-emits
    ; the literal-left form, which would break `make`.
    (let (row-bytes:i64 (as i64 (* 4 (+ lb 1)))
          prev:ptr:i32 (as ptr:i32 (malloc row-bytes))
          cur:ptr:i32 (as ptr:i32 (malloc row-bytes)))
      (dotimes (j (+ lb 1)) (aset! prev j j))
      (dotimes (i0 la)
        (aset! cur 0 (+ i0 1))
        (dotimes (j0 lb)
          (let (cost:i32 (if (= (char-at a (as i64 i0)) (char-at b (as i64 j0))) 0 1)
                d:i32 (+ (aref prev j0) cost)
                ins:i32 (+ (aref cur j0) 1)
                del:i32 (+ (aref prev (+ j0 1)) 1))
            (when (< ins d) (set! d ins))
            (when (< del d) (set! d del))
            (aset! cur (+ j0 1) d)))
        (dotimes (j (+ lb 1)) (aset! prev j (aref cur j))))
      (set! result (aref prev lb))
      (free (as ptr prev))
      (free (as ptr cur)))
    (return result)))

; Consider one candidate for the did-you-mean. `key` is the registry key; the
; distance is measured against its BARE name (a namespace-qualified key would
; otherwise never be near anything the author typed), and what is SUGGESTED is
; the spelling this file could actually write for it — `binding-usable-spelling`
; (Stage 15 B5), which consults the interface's `src-ns` column.
;
; This is defect #9. The suggester used to print the candidate's raw key, so a
; library function reachable only as `zx/zfun` was offered as `zfun` — the exact
; spelling that had just failed: `error: unknown: zfun (did you mean 'zfun'?)`.
; Two rules follow, and the second is the belt to the first's braces: a
; candidate this file cannot spell at all is not a suggestion, and a suggestion
; identical to the input is never emitted.
(defn suggest-better (name:CStr key:CStr kind:i32 payload:ptr limit:i32
                      best:ptr:ptr bestd:ptr:i32):void
  (let (bare:CStr (as CStr (strip-ns-qualifier (as ptr key)))
        d:i32 (name-edit-distance name bare limit))
    (when (>= d (aref bestd 0)) (return))
    (let (sp:ptr (binding-usable-spelling kind payload bare))
      (when (= sp null) (return))
      (when (= (strcmp (as CStr sp) name) 0) (return))
      (aset! bestd 0 d)
      (aset! best 0 sp))))

; The closest registered spelling to `name`, or null when nothing is close
; enough (see name-suggest-limit). Searched over the same four registries
; `guard-name-kind` consults — functions/multimethods, macros, struct and
; union type names, and global values — which is exactly the set a reference in
; value or head position can resolve against. Returns `ptr`, not `CStr`: the
; result is null-checked by the caller, and a CStr null-check lowers to
; strcmp(x, null) (conventions.md).
(defn closest-known-name (name:CStr):ptr
  (let (limit:i32 (name-suggest-limit name))
    (when (= limit 0) (return null))
    (let (best:ptr null
          best-d:i32 (+ limit 1)
          bp:ptr:ptr (as ptr:ptr (addr-of best))
          bd:ptr:i32 (as ptr:i32 (addr-of best-d)))
      (doseq (generic g-generics (VecIter ref:Generic))
        (suggest-better name (generic name) BK-GENERIC (as ptr generic) limit bp bd))
      (doseq (macro g-macros (VecIter ref:MacroDef))
        (suggest-better name (macro name) BK-MACRO (as ptr macro) limit bp bd))
      (doseq (struct g-structs (VecIter ref:StructDef))
        (suggest-better name (struct name) BK-STRUCT (as ptr struct) limit bp bd))
      (let (sc:ptr:Scope (as ptr:Scope g-globals))
        (dotimes (i (sc len))
          (let (sym:ptr:Sym (as ptr:Sym (unsafe/ptr+ (as ptr:Sym (sc syms)) i)))
            (suggest-better name (sym name) BK-GLOBAL (as ptr sym) limit bp bd))))
      (return best))))

; ============================================================
; Stage 15 W1c — the unreachable-file note
; (design/stage15-stress-test/resolution.md §W1c)
; ============================================================
;
; W1a made every reachable file's signatures visible to every other, so an
; `unknown:` for a function that exists *in the unit* is now impossible. What
; remains is a typo, a genuinely absent symbol — or §2.7's reachability
; constraint, which W1 deliberately keeps: the name IS defined, in a file that
; sits on the import search path and that no import in this unit reaches. That
; last case is the one the post-W1a mental model ("it's in my project, so it
; resolves") makes confusing, so name the file.
;
; **Error path only.** Both callers of `unresolved-name-message`
; (`emit-symbol-ref`, `emit-dispatch`) and the `unknown type:` raise in
; `parse-type-name` are `die-at`, which is `noreturn` — so the scan below runs
; at most once per compile, with the process already committed to failing. Do
; not call it from a speculative or recoverable path; a directory walk plus a
; file read per candidate is affordable here and nowhere else.

; POSIX directory enumeration. Declared here rather than imported from
; <dirent.h>: the C-header reader registers `struct dirent` as *opaque* (its
; `char d_name[256]` member is a shape the declaration parser declines), so a
; field access on it is refused — and the scan needs only the name. The
; compiler already depends on POSIX process/pipe calls (`popen`/`pclose`,
; src/cheader.nuc) to run `clang -E`, so this adds no new platform class.
(declare opendir (path:CStr):ptr)
(declare readdir (d:ptr):ptr)
(declare closedir (d:ptr):i32)

; Byte offset of `d_name` within `struct dirent` on 64-bit glibc and musl:
; ino_t(8) + off_t(8) + unsigned short(2) + unsigned char(1). POSIX does not fix
; the layout, so this is *validated, not trusted*: a directory entry is used only
; when the bytes at this offset are a short NUL-terminated string ending in
; `.nuc`/`.nuch` (`nuc-source-name`). On a platform whose layout differs, the
; scan simply finds nothing and the diagnostic degrades to its primary text — it
; can never put garbage in a message. The read stays inside the kernel-filled
; dirent buffer either way, because `d_name` is the last member and is
; NUL-terminated.
(defconst DIRENT-D-NAME-OFFSET 19)

; Does `fname` name a Nucleus source file? The length bound is what keeps a
; wrong DIRENT-D-NAME-OFFSET harmless (see above) and bounds the path we build.
(defn nuc-source-name (fname:CStr):i32
  (let (n:i64 (as i64 (strlen fname)))
    (when (or (< n 5) (> n 250)) (return 0))
    (when (= (as CStr (unsafe/ptr+ (as ptr:i8 fname) (- n 4))) ".nuc") (return 1))
    (when (and (> n 5)
               (= (as CStr (unsafe/ptr+ (as ptr:i8 fname) (- n 5))) ".nuch"))
      (return 1))
    (return 0)))

; Is the byte range [start, end) of `text` exactly the spelling `s`?
(defn text-token-is (text:CStr start:i64 end:i64 s:CStr):i32
  (let (n:i64 (as i64 (strlen s)))
    (when (!= (- end start) n) (return 0))
    (let (k:i64 0)
      (while (< k n)
        (when (!= (char-at text (+ start k)) (char-at s k)) (return 0))
        (set! k (+ k 1))))
    (return 1)))

; A character that continues a symbol token. Everything a reader treats as a
; delimiter ends one: whitespace, the bracket family, `;` and `"`.
(defn source-name-char (c:i32):i32
  (when (<= c 32) (return 0))
  (when (or (= c 40) (= c 41)) (return 0))      ; ( )
  (when (or (= c 91) (= c 93)) (return 0))      ; [ ]
  (when (or (= c 123) (= c 125)) (return 0))    ; { }
  (when (or (= c 59) (= c 34)) (return 0))      ; ; "
  (return 1))

; Does the token at [start, end) name a top-level definer that introduces a name
; in the namespace we are looking in? `want-type` selects the TYPE namespace
; (what `unknown type:` consults) over the value/head namespace. `declare` and
; `defmethod` are the `.nuch` spellings.
;
; A trailing `-` (the private-definer suffix — `defn-`, `defstruct-`, … see
; docs/toplevel.md) is dropped before comparing, so the private half of every
; pair is covered by one rule and cannot drift out of sync with the public half.
; A private definition is still worth naming: privacy is per *namespace*, so a
; same-namespace file that simply was not imported is exactly the case this note
; exists for. No non-definer spelling is at risk — dropping the `-` from an
; unrelated trailing-hyphen name still does not produce a definer keyword.
(defn text-token-is-definer (text:CStr start:i64 end:i64 want-type:i32):i32
  (let (e:i64 end)
    (when (and (> e start) (= (char-at text (- e 1)) 45))
      (set! e (- e 1)))
    (when (!= want-type 0)
      (when (!= (text-token-is text start e "defstruct") 0) (return 1))
      (when (!= (text-token-is text start e "defunion") 0) (return 1))
      (when (!= (text-token-is text start e "defprotocol") 0) (return 1))
      (return 0))
    (when (!= (text-token-is text start e "defn") 0) (return 1))
    (when (!= (text-token-is text start e "defmacro") 0) (return 1))
    (when (!= (text-token-is text start e "defvar") 0) (return 1))
    (when (!= (text-token-is text start e "defconst") 0) (return 1))
    (when (!= (text-token-is text start e "defenum") 0) (return 1))
    (when (!= (text-token-is text start e "deferror") 0) (return 1))
    (when (!= (text-token-is text start e "extern") 0) (return 1))
    (when (!= (text-token-is text start e "declare") 0) (return 1))
    (when (!= (text-token-is text start e "defmethod") 0) (return 1)))
  (return 0))

; Does the source text `text` (length `len`) define `name` with a top-level
; definer? A deliberately TEXTUAL scan: re-entering `read-program`/`desugar`
; from a diagnostic path would clobber g-src / g-pos / g-line / g-source-path /
; g-peek / g-peek-valid while a message is being composed, for no benefit.
;
; Line comments and string literals are skipped, so the two obvious
; false-positive sources are out; a definer spelled inside a quasiquoted macro
; body could still match, which is exactly why the caller phrases the result as
; a `note:` and keeps the primary error text true on its own.
(defn text-defines-name (text:CStr len:i64 name:CStr want-type:i32):i32
  (let (i:i64 0)
    (while (< i len)
      (let (c:i32 (char-at text i))
        (cond
          (= c 59)                                  ; `;` — comment to end of line
            (while (and (< i len) (!= (char-at text i) 10)) (set! i (+ i 1)))
          (= c 34)                                  ; `"` — string literal
            (do
              (set! i (+ i 1))
              (while (and (< i len) (!= (char-at text i) 34))
                (when (= (char-at text i) 92) (set! i (+ i 1)))
                (set! i (+ i 1)))
              (set! i (+ i 1)))
          (= c 40)                                  ; `(` — a form; is it a definer?
            (do
              (set! i (+ i 1))
              (while (and (< i len) (<= (char-at text i) 32)) (set! i (+ i 1)))
              (let (kw-start:i64 i)
                (while (and (< i len) (!= (source-name-char (char-at text i)) 0))
                  (set! i (+ i 1)))
                ; Stage 15 W1d: `(defenum Color RED GREEN BLUE)` introduces the
                ; MEMBER names into the value namespace, not just `Color` — and
                ; a member is exactly what a cycle partner reaches for. Every
                ; remaining token of the form is a member, so scan them all.
                ; (Bail on a nested `(` or a string: neither occurs in a
                ; well-formed defenum, and continuing would leave the outer walk
                ; mid-form.) Also fixes the same blind spot in W1c's
                ; unreachable-definer note, which this scan backs.
                (when (and (= want-type 0)
                           (!= (text-token-is text kw-start i "defenum") 0))
                  (let (j:i64 i
                        scanning:i32 1)
                    (while (and (!= scanning 0) (< j len))
                      (while (and (< j len) (<= (char-at text j) 32)) (set! j (+ j 1)))
                      (if (or (>= j len)
                              (= (source-name-char (char-at text j)) 0))
                        (set! scanning 0)
                        (let (ms:i64 j)
                          (while (and (< j len) (!= (source-name-char (char-at text j)) 0))
                            (set! j (+ j 1)))
                          (when (!= (text-token-is text ms j name) 0) (return 1)))))))
                (when (!= (text-token-is-definer text kw-start i want-type) 0)
                  (while (and (< i len) (<= (char-at text i) 32)) (set! i (+ i 1)))
                  ; A parametric definer names its head inside a nested list:
                  ; `(defstruct (Vector T) …)`. Step into it.
                  (when (and (< i len) (= (char-at text i) 40))
                    (set! i (+ i 1))
                    (while (and (< i len) (<= (char-at text i) 32)) (set! i (+ i 1))))
                  (let (nm-start:i64 i)
                    (while (and (< i len) (!= (source-name-char (char-at text i)) 0))
                      (set! i (+ i 1)))
                    (when (!= (text-token-is text nm-start i name) 0) (return 1))))))
          true (set! i (+ i 1))))))
  (return 0))

; Read `path` and ask whether it defines `name`. Non-fatal at every step (unlike
; `read-file`, which exits): this is a hint, so an unreadable or absurdly large
; file is simply not a match.
(defn file-defines-name (path:CStr name:CStr want-type:i32):i32
  (let (f:ptr (fopen path "rb"))
    (when (= f null) (return 0))
    (when (!= (fseek f 0 2) 0) (fclose f) (return 0))
    (let (sz:i64 (ftell f))
      (when (or (< sz 0) (> sz 4194304)) (fclose f) (return 0))
      (rewind f)
      (let (buf:ptr (malloc (+ sz 1)))
        (when (= buf null) (fclose f) (return 0))
        (let (nr:i64 (fread buf (as i64 1) sz f))
          (aset! (as ptr:i8 buf) nr 0)
          (fclose f)
          (let (hit:i32 (text-defines-name (as CStr buf) nr name want-type))
            (free buf)
            (return hit)))))))

; Is this resolved path already part of the compilation unit? A file in the unit
; cannot be the answer — if it were, the name would have resolved. The three
; lists together are every way a `.nuc` file enters the unit *through an import*:
; the type prescan's walk, W1a's signature prescan walk, and import emission.
; The unit's ROOT is on none of them (nothing imports it), which is what the last
; two checks are for — `g-source-path` covers it only while the root is the file
; being emitted, so `g-unit-entry-path` covers the rest of the compile.
(defn path-in-unit (path:CStr):i32
  (when (!= (import-list-has g-prescan-visited path) 0) (return 1))
  (when (!= (import-list-has g-prescan-sigs path) 0) (return 1))
  (when (!= (import-list-has g-imported path) 0) (return 1))
  (when (= path (as CStr g-source-path)) (return 1))
  (when (and (!= g-unit-entry-path null) (= path (as CStr g-unit-entry-path)))
    (return 1))
  (return 0))

; Scan one directory (non-recursive) for a `.nuc`/`.nuch` file outside the unit
; that defines `name`. First match wins and stops the scan.
(defn scan-dir-for-definer (dir:CStr name:CStr want-type:i32):ptr
  (let (d:ptr (opendir dir))
    (when (= d null) (return null))
    (while true
      (let (e:ptr (readdir d))
        (when (= e null)
          (closedir d)
          (return null))
        (let (fname:CStr (as CStr (unsafe/ptr+ (as ptr:i8 e) DIRENT-D-NAME-OFFSET)))
          (when (!= (nuc-source-name fname) 0)
            (let (path:ptr (fmt-2s "%s/%s" dir fname))
              (when (= (path-in-unit (as CStr path)) 0)
                (when (!= (file-defines-name (as CStr path) name want-type) 0)
                  (closedir d)
                  (return path)))))))))
  (return null))

; The directory of the file currently being emitted, or null when it has none
; (a bare filename in the cwd). Mirrors `try-import-path`'s first search step,
; so the note names files the author could have imported by bare name.
(defn source-file-dir ():ptr
  (let (pathlen:i64 (as i64 (strlen g-source-path))
        last-slash:i64 -1)
    (dotimes (i pathlen)
      (when (= (char-at g-source-path i) 47)
        (set! last-slash i)))
    (when (< last-slash 0) (return null))
    (return (strndup g-source-path last-slash))))

; The path of a Nucleus source file that is on the import search path, is NOT
; part of this compilation unit, and defines `name` — or null. Searches exactly
; the directories `resolve-import` searches first: the current source file's
; directory, `lib/` relative to cwd, and each `-I` directory. ($NUCLEUS_LIB and
; the compiled-in install prefix are deliberately left out: a file there is a
; *stdlib* file the user cannot add to their project by editing an import, so
; naming it would be advice they cannot act on.)
(defn unreachable-definer-file (name:CStr want-type:i32):ptr
  (let (scanned:ptr null)
    (let (own-dir:ptr (source-file-dir))
      (when (!= own-dir null)
        (set! scanned (import-list-push scanned (as CStr own-dir)))
        (let (hit:ptr (scan-dir-for-definer (as CStr own-dir) name want-type))
          (when (!= hit null) (return hit)))))
    (when (= (import-list-has scanned "lib") 0)
      (set! scanned (import-list-push scanned "lib"))
      (let (hit:ptr (scan-dir-for-definer "lib" name want-type))
        (when (!= hit null) (return hit))))
    (do
      (dotimes (j (unsafe/cast i32 (count g-include-paths)))
        (let (dir:CStr (invoke g-include-paths (as usize j)))
          (when (= (import-list-has scanned dir) 0)
            (set! scanned (import-list-push scanned dir))
            (let (hit:ptr (scan-dir-for-definer dir name want-type))
              (when (!= hit null) (return hit))))))))
  (return null))

; The `note:` line naming the file, appended to the primary message by every
; unresolved-name diagnostic. `die-at`/`report-at` print the message verbatim
; after the `path:line: error: ` prefix, so an embedded newline lays the note
; out exactly like the existing mono-context note.
(defn unreachable-file-note (name:CStr path:CStr):ptr
  (return (fmt-2s "'%s' is defined in %s, which no import in this unit reaches"
                  name path)))

; ============================================================
; Stage 15 W1d — diagnosing what a legal import cycle still cannot do.
;
; A circular `(import)` is no longer an error: `do-import` skips the re-entry
; and records the edge (note-import-cycle). Cross-file *function* references
; survive that, because W1a registers every reachable file's signatures before
; any emission. Three kinds of entity do not, because they only exist once their
; defining file has been EMITTED, and a cycle member's body is emitted before
; the rest of the file it back-imports:
;
;   * `defmacro` names, plus `deferror` ids and `extern` declarations (each is
;     written by its emitter). Stage 15 W8 G-0 REMOVED `defconst` / `defenum` /
;     `defvar` from this list: `prescan-value-names` now registers value names
;     on the same whole-graph walk that registers signatures, so a constant,
;     enum member or global defined by a cycle partner resolves (measured: all
;     three compile, link and return the right value across a cycle). The
;     scan behind `cycle-definer-file` is deliberately left broad — it is shared
;     with W1c's unreachable-definer note, which still needs every definer.
;   * struct and union LAYOUTS (`emit-defstruct` populates the field table that
;     `struct-field-index` and `abi-sizeof` read);
;   * `prefix/name` aliases (`do-import` aliases over the global-scope slice a
;     completed file contributed; a skipped re-entry has no slice).
;
; Each of the three would otherwise fail with a *true but misleading* message —
; "not defined anywhere in this compilation unit" for a name that is right there
; in the unit, "no field 'x' on struct 'S'" for a struct that does have that
; field, or an unlocated LLVM parse error on an `i0` aggregate. These helpers
; supply the real reason. All of them short-circuit on `g-import-cycles == null`,
; so they cost nothing and change nothing for a unit with no cycle — which is
; every unit that compiled before W1d, since a cycle was a hard error.
; ============================================================

; "<path> is in an import cycle with <partner>", or a partnerless fallback.
(defn import-cycle-note (defpath:CStr):ptr
  (let (partner:ptr (import-cycle-partner defpath))
    (when (= partner null)
      (return (fmt-s "%s is part of an import cycle in this unit" defpath)))
    (return (fmt-2s "%s is in an import cycle with %s" defpath (as CStr partner)))))

; The shared closing advice. Kept in one place so the macro/const/enum, layout
; and prefix messages cannot drift apart on what the user should actually do.
(defn import-cycle-advice ():CStr
  (return "break the cycle -- a cross-file reference does not require an import, so a common parent can import both files instead"))

; Tier 2b: the name IS defined in this unit, by a file the unit imports
; circularly, but by a definer whose effect is emission-time.
(defn cycle-definer-message (verb:CStr name:CStr):ptr
  (when (= g-import-cycles null) (return null))
  (let (defpath:ptr (cycle-definer-file name 0))
    (when (= defpath null) (return null))
    (let (head:ptr (fmt-2s "%s: %s — defined in a file this unit imports circularly, and not registered yet at this point"
                           verb name)
          ; Stage 15 W8 G-0 rewrote this sentence. It used to say "not macros,
          ; constants or enum members"; the value half moved into the prescan, so
          ; the only names left registering at emission time are macros,
          ; `deferror` ids and `extern` declarations. Keep it accurate — a note
          ; that names a coupling the compiler no longer has sends the reader to
          ; break a cycle they do not need to break.
          note:ptr (fmt-2s "  note: %s; a cycle resolves function signatures and value names before any emission, but a macro, deferror id or extern declaration registers only when its file is emitted -- and a cycle member's body is emitted before the rest of the file it back-imports. Either %s"
                           (import-cycle-note (as CStr defpath)) (import-cycle-advice)))
      (return (fmt-2s "%s\n%s" head note)))))

; The layout message, used by reject-cycle-pending-layout (src/type-utils.nuc).
; `what` names the construct that needed the layout ("defn parameter",
; "field access", "struct literal", …), matching reject-opaque-type's wording.
(defn cycle-layout-message (sname:CStr what:CStr):ptr
  (let (defpath:ptr (cycle-definer-file sname 1)
        where:ptr "it is defined in a file this unit imports circularly")
    (when (!= defpath null)
      (set! where (import-cycle-note (as CStr defpath))))
    (let (head:ptr (fmt-2s "%s: '%s' has no layout at this point — its definition has not been emitted yet"
                           what sname)
          note:ptr (fmt-2s "  note: %s; a cycle resolves function signatures but not struct layouts, so across a cycle a type is usable only behind a pointer. Either use ptr:%s here, or "
                           where sname))
      (return (fmt-3s "%s\n%s%s" head note (import-cycle-advice))))))

; The message for a name that did not resolve. `verb` is "unknown" (head
; position — no function/macro/special form by that name) or "undefined" (value
; position — no binding by that name).
; The "<header>:<line>: <reason>" note recorded when this name's C declaration
; was skipped by the importer, or null. Node-cell list walk, the same shape as
; the import lists (see g-cheader-skipped above).
(defn cheader-skip-note (fname:CStr):ptr
  (let (cur:ptr g-cheader-skipped)
    (while (!= cur null)
      (let (e:ptr:Node (unsafe/cast ptr:Node cur))
        (when (= (as CStr (e s)) fname) (return (as ptr (e car))))
        (set! cur (e cdr)))))
  (return null))

; Stage 15 B2b: a bare spelling that names an operation of the built-in `unsafe`
; namespace. That namespace is bound PREFIXED in every file and never flattened,
; so `cast` / `ptr+` / `funcall-ptr-*` do not resolve — which is the mechanism
; UN-5 wanted and previously spelled as six hard-coded refusals in the dispatch
; ladder (plus its mirror in `node-type-call`). The refusals are gone; the text
; they carried lives on here, verbatim, as a did-you-mean tier.
(defn unsafe-bare-message (name:CStr):ptr
  (when (= (unsafe-op-named name) 0) (return null))
  ; `import-private` is not a legacy bare spelling of anything — the retired
  ; form was `unsafe-import-private`, a different string, still refused by its
  ; own top-level arm.
  (when (= (strcmp name "import-private") 0) (return null))
  (when (= (strcmp name "cast") 0)
    (return "'cast' was split in Stage 14: use 'as' (safe) or 'unsafe/cast' (unchecked)"))
  (return (fmt-2s "'%s' was split in Stage 14: use 'unsafe/%s'" name name)))

; The qualifier is in scope nowhere in this file. Not a reachability failure:
; the definition is in the unit and the import graph reaches it; only the
; spelling cannot be written here. `qualifier-scope-note` carries the two tiers
; of explanation (B1's "another file binds that prefix" and B2a's general rule).
(defn qualifier-scope-message (verb:CStr name:CStr):ptr
  (let (note:ptr (qualifier-scope-note name))
    (when (= note null) (return null))
    (let (q:ptr (arena-strndup name (qualifier-len name)))
      (return (fmt-2s "%s\n%s"
                      (as CStr (fmt-3s "%s: %s — '%s' is not in scope in this file"
                                       verb name (as CStr q)))
                      (as CStr note))))))

(defn unresolved-name-message (verb:CStr name:CStr):ptr
  ; Stage 15 B2b: the retired bare `unsafe/` spellings first — the roster names
  ; are reserved, so this cannot shadow a user name, and its answer is exact
  ; where every tier below is a guess.
  (let (unsafe-note:ptr (unsafe-bare-message name))
    (when (!= unsafe-note null) (return unsafe-note)))
  ; Then an out-of-scope qualifier, before every reachability tier below,
  ; because it is the one failure here that is NOT about reachability.
  (let (unbound:ptr (qualifier-scope-message verb name))
    (when (!= unbound null) (return unbound)))
  ; Stage 15 W3c: a name whose C-header declaration was *skipped* is not merely
  ; unknown — the header declared it and the importer could not describe it. Say
  ; so, with the header, line and reason, rather than offering a did-you-mean
  ; that will not help. This is where the skip diagnosis is delivered: reporting
  ; every skip at import time instead put ~45 warnings on every build that
  ; touched <math.h>, <stdlib.h> or SDL2 (all real — `long double`, `_Float128`,
  ; `SDL_JoystickGUID`), including six in the REPL banner, which is exactly the
  ; "bury the signal" failure W3b's own warning policy was written to avoid.
  (let (skipped:ptr (cheader-skip-note name))
    (when (!= skipped null)
      (return (fmt-3s "%s: '%s' — its C header declaration was skipped (%s)"
                      verb name skipped))))
  ; Stage 15 W1d, tier 2b. Before blaming reachability, check the one way a
  ; name can be *in* this unit and still not resolve: it comes from a file the
  ; unit imports circularly, and its definer only takes effect at emission time.
  ; Returns null instantly when the unit has no skipped cycle.
  ;
  ; W1d's *prefix* tier (2a) is gone: it existed because a circular skip has no
  ; global-scope slice, so `inject-import-aliases` injected no `prefix/name`
  ; aliases and the qualified spelling resolved nowhere. B2b deletes the
  ; injection, and a prefix now names a file rather than a slice — the W1a
  ; whole-graph prescan has already registered the partner's signatures and
  ; recorded its namespace — so `prefix/name` resolves across a cycle like any
  ; other reference. That is one of the three emission-time couplings W1d
  ; enumerated (macros, layouts, prefix aliases) removed rather than diagnosed.
  (let (cyc:ptr (cycle-definer-message verb name))
    (when (!= cyc null) (return cyc)))
  ; Stage 15 W1c, tier 2. The name resolved nowhere in the unit — but it may be
  ; defined in a file the import graph never reaches. Naming that file is
  ; strictly more actionable than a spelling guess (it says which import to
  ; add), so it takes precedence over the did-you-mean and suppresses it: the
  ; two would otherwise offer contradictory diagnoses of the same failure. They
  ; rarely collide anyway — the scan matches the name EXACTLY, so a genuine
  ; misspelling finds no file and falls straight through to tier 3.
  (let (elsewhere:ptr (unreachable-definer-file name 0))
    (when (!= elsewhere null)
      (return (fmt-3s "%s: %s — not defined anywhere in this compilation unit\n  note: %s"
                      verb name (unreachable-file-note name (as CStr elsewhere))))))
  ; Stage 15 B3′: R1's failure mode reaches head position too — a bare struct
  ; constructor `(Zs 4)` for a type defined in a namespace this file did not
  ; import. Same answer as the annotation position gives, so the same function.
  (let (ns-note:ptr (type-in-other-namespace-message verb name))
    (when (!= ns-note null) (return ns-note)))
  (let (near:ptr (closest-known-name name))
    (when (!= near null)
      (return (fmt-3s "%s: %s (did you mean '%s'?)" verb name near)))
    ; Tier 4: the common typo with nothing close enough to suggest. Say plainly
    ; what was checked — post-W1a that is the whole unit, not "everything
    ; imported so far", and the old bare `unknown: <name>` did not say so.
    (return (fmt-2s "%s: %s — not defined anywhere in this compilation unit" verb name))))

; Stage 15 B3′: a type whose BARE name matches `name`'s, registered under a
; namespace this file did not import. This is R1's own failure mode and it is
; distinct from every W1c tier: the type is defined, its file is reachable, and
; the prescan already registered it — the reference is simply unspellable here.
; Two answers, in order of usefulness: the spelling this file *can* write (a
; prefix it already bound), else the namespace it would have to import.
;
; The scan is over `g-structs` only, which also covers every `defunion` (its
; backing StructDef is registered under the same key). Error path only — the
; caller is a `die-at` — so a linear scan is affordable.
(defn type-in-other-namespace-message (verb:CStr name:CStr):ptr
  (when (= g-ns-declared 0) (return null))
  (let (bare:CStr (as CStr (strip-ns-qualifier (as ptr name))))
    (dotimes (i (unsafe/cast i32 (count g-structs)))
      (let (sd:ptr:StructDef (as ptr:StructDef (invoke g-structs (as usize i))))
        (when (and (!= (qualifier-len (as ptr (sd name))) 0)
                   (= (strcmp (as CStr (strip-ns-qualifier (as ptr (sd name)))) bare) 0))
          (let (usable:ptr (binding-usable-spelling BK-STRUCT (as ptr sd) bare))
            (when (and (!= usable null) (!= (strcmp (as CStr usable) name) 0))
              (return (fmt-2s "%s\n  note: write '%s' here"
                              (as CStr (fmt-3s "%s: %s — defined in namespace '%s'"
                                               verb name (key-namespace (sd name))))
                              (as CStr usable))))
            (return (fmt-3s "%s: %s — defined in namespace '%s', which this file does not import"
                            verb name (key-namespace (sd name))))))))
    (return null)))

; Stage 15 W1c: the same treatment for §2.7's TYPE reachability constraint,
; which W1 deliberately does not remove — a struct/union/protocol named in a
; unit must still be defined in a reachable file. Raised by `parse-type-name`
; (src/union-registry.nuc), which calls up into this file.
;
; Stage 15 B3′ gave it the same TIER ORDER `unresolved-name-message` has, because
; R1 gave a type the same two ways to fail a global had since B2b: a qualifier
; that is not in scope here, and a name that is defined in the unit under a
; namespace this file did not import. Both would otherwise degrade into "not
; defined anywhere in this compilation unit", which for a type that is defined
; *and* reachable is exactly the lie W1c exists to remove.
(defn unknown-type-message (name:CStr):ptr
  ; An out-of-scope qualifier is not a reachability failure, so it precedes
  ; every reachability tier — B2b's ordering rule, applied to the type side.
  (let (unbound:ptr (qualifier-scope-message "unknown type" name))
    (when (!= unbound null) (return unbound)))
  (let (elsewhere:ptr (unreachable-definer-file name 1))
    (when (!= elsewhere null)
      (return (fmt-2s "unknown type: %s — not defined anywhere in this compilation unit\n  note: %s"
                      name (unreachable-file-note name (as CStr elsewhere))))))
  ; The type may be in this unit under a namespace this file cannot name — R1's
  ; new failure mode, and the one the reachability message describes wrongly.
  (let (ns-note:ptr (type-in-other-namespace-message "unknown type" name))
    (when (!= ns-note null) (return ns-note)))
  ; The type may be in this unit under a namespace this file cannot name. The
  ; did-you-mean renders a candidate through `binding-usable-spelling`, which
  ; since B3′ knows the type rows — so a bare `Fox` from a library imported as
  ; `dpx` is answered with `dpx/Fox`, the spelling that compiles.
  ; Two conversions, two arguments: `fmt-3s` here would read a garbage vararg as
  ; a pointer and segfault the compiler on a COLD path (conventions.md's
  ; fixed-arity trap). `tests/fixtures/b3-type-typo.nuc` executes this line.
  (let (near:ptr (closest-known-name name))
    (when (!= near null)
      (return (fmt-2s "unknown type: %s (did you mean '%s'?)" name (as CStr near)))))
  (return (fmt-s "unknown type: %s — not defined anywhere in this compilation unit" name)))

(defn unknown-name-message (name:CStr):ptr
  (return (unresolved-name-message "unknown" name)))

(defn undefined-name-message (name:CStr):ptr
  (return (unresolved-name-message "undefined" name)))

; `line` is the source line to blame for a failure here. A bare symbol node is
; an interned singleton with no per-occurrence line of its own (lib/node.nuc
; `node-line`), so the caller supplies the enclosing form's line: emit-node hands
; over the ambient g-form-line it maintains, emit-dispatch the call cell's line.
; Stage 15 W4a: before this, every raise below reported `:0:`.
(defn emit-symbol-ref (n:(raw Node) scope:ref:Scope line:i32):ref:Val
  (let (nn:(raw Node) n)
    (when (= n 'null)  (return (alloc-val ty-raw "null")))
    (when (= n 'true)  (return (alloc-val ty-i1 "1")))
    (when (= n 'false) (return (alloc-val ty-i1 "0")))
    (when (= n 'none)  (return (alloc-val ty-maybe-ptr "null")))
    ; Strip any trailing :type annotation so typed names (e.g. i:i32 from macro
    ; expansion) resolve correctly in value position.
    (let (lookup-name:ptr null
          ignored-type:ptr null)
      (split-typed (nn s) (as ptr:ptr (addr-of lookup-name)) (as ptr:ptr (addr-of ignored-type)))
      (if-some (sym (scope-lookup scope lookup-name))
        (do
          (when (!= (sym moved) 0)
            (die-at (node-line n line) (fmt-s "use after move: '%s'" (nn s))))
          (when (!= (sym is-const) 0)
            (let (cv:ref:Val (alloc-val (sym type) (sym const-val)))
              ; Stage 15 W2b: a `defconst`/`defenum` name stands for the integer
              ; literal it was defined with, so its Val carries the same
              ; `is-lit`/`lit-i64` provenance emit-int gives an inline literal.
              ; Two consequences, both wanted: the operand adapts at a binop
              ; (via binop-result-type's scope-aware literal test), and
              ; coerce-int-val's LW-4 range check rejects a narrowing the value
              ; does not survive rather than wrapping it silently. `deferror`
              ; constants leave const-lit at 0 — an `Err` is not an int literal.
              (when (!= (sym const-lit) 0)
                (.set! cv is-lit 1)
                (.set! cv lit-i64 (sym const-lit-i64)))
              (return cv)))
          (when (= (sym is-local) 0)
            (when (-> sym (_ type) (unsafe/cast ptr:Type _) (_ kind) (= _ TY-FN))
              ; AVR-6 Harvard hazard: on a target whose program memory is a
              ; distinct address space (prog-as != 0 — AVR's `P1`), a function
              ; materialized as a first-class data-pointer VALUE is `ptr
              ; addrspace(1)` where a plain `ptr` is required, an LLVM verifier
              ; error. Direct calls (routed to emit-call, never here) are fine;
              ; only value uses — funcall/dyn/BoxedFn sources, let inits, args —
              ; reach this single materialization chokepoint. v1 diagnoses rather
              ; than emitting IR the backend rejects; the full addrspace(1)-
              ; carrying fix is deferred (design/stage14/avr-targets.md §5 AVR-6).
              (when (!= ((as ptr:Target g-target) prog-as) 0)
                (die-at (node-line n line)
                  (fmt-sd "cannot use function '%s' as a value on this target: functions live in program memory (address space %d) and cannot be materialized as a data pointer -- call it directly instead"
                    (nn s) ((as ptr:Target g-target) prog-as))))
              (return (alloc-val (sym type) (sym ir-name))))
            (die-at (node-line n line) (fmt-s "cannot use '%s' as value" (nn s))))
          ; Stage 15 W8 G-2: an `(array T N)`-typed binding DECAYS — reading it
          ; yields the address of element 0, not a loaded aggregate. The Sym's
          ; ir-name already IS that address (`@g` for a global, the alloca slot
          ; for a local), so this is the load being skipped, not an extra
          ; instruction. `array-decay` (src/type-utils.nuc) is the shared rule
          ; node-type-sym calls too, so the two passes cannot drift.
          (when (= (-> sym (_ type) (unsafe/cast ptr:Type _) (_ kind)) TY-ARRAY)
            (return (alloc-val (array-decay (sym type)) (sym ir-name))))
          (let (tmp:ptr (new-tmp))
            (emit-load tmp (type-to-ir (sym type)) (sym ir-name) (sym type))
            ; Stage 10: the read uses the flow-narrowed view of the binding's
            ; type and carries the binding's escape taint.
            (let (rv:ref:Val (alloc-val (sym-effective-type sym) tmp))
              (.set! rv taint (sym taint))
              (.set! rv taint-frame (sym taint-frame))
              (return rv))))
        (die-at (node-line n line) (undefined-name-message (as CStr (nn s))))))))

; ============================================================
; Binary operations
; ============================================================

; G-5: `add-binop` appends to the vector it is HANDED rather than to the global,
; because `build-binops` runs as `g-binops`' own initializer — the global is
; still null while its value is being built. Same shape as `build-rmacros` /
; `build-generics` below; a builder may never name the global it initializes.
(defn add-binop (v:(ref (Vector (ref BinOp))) name:CStr instr:CStr instr-u:CStr is-cmp:i32):void
  (let (op:ptr:BinOp (as ptr:BinOp (arena-alloc (sizeof BinOp))))
    (.set! op name name)
    (.set! op instr instr)
    (.set! op instr-u instr-u)
    (.set! op is-cmp is-cmp)
    (conj v (as ref:BinOp op))))

(defn build-binops ():(ref (Vector (ref BinOp)))
  (let (v:(ref (Vector (ref BinOp))) (vector-new-in (addr-of g-arena-alloc)))
    (add-binop v "_+"     "add nsw"  "add"      0)
    (add-binop v "_-"     "sub nsw"  "sub"      0)
    (add-binop v "_*"     "mul nsw"  "mul"      0)
    (add-binop v "_/"     "sdiv"     "udiv"     0)
    (add-binop v "%"       "srem"     "urem"     0)
    (add-binop v "bit-and" "and"      "and"      0)
    (add-binop v "bit-or"  "or"       "or"       0)
    (add-binop v "bit-xor" "xor"      "xor"      0)
    (add-binop v "bit-shl" "shl"      "shl"      0)
    (add-binop v "bit-shr" "ashr"     "lshr"     0)
    (add-binop v "="       "icmp eq"  "icmp eq"  1)
    (add-binop v "!="      "icmp ne"  "icmp ne"  1)
    (add-binop v "<"       "icmp slt" "icmp ult" 1)
    (add-binop v "<="      "icmp sle" "icmp ule" 1)
    (add-binop v ">"       "icmp sgt" "icmp ugt" 1)
    (add-binop v ">="      "icmp sge" "icmp uge" 1)
    (return v)))

; True if a node denotes an untyped integer literal, so it may adapt to the type
; of the other operand in a binary operation (Stage 9 §10.1). Sees through the
; variadic operator macros' single-arg wrappers (`(+ 7)` → `7`) by expanding a
; cell head; cheap for the symbol/field/call operands that dominate (no macro).
(defn node-is-int-literal (n:(raw Node)):i32
  (when (= n null) (return 0))
  (let (nn:(raw Node) n)
    (when (= (nn kind) NODE-INT) (return 1))
    (when (= (nn kind) NODE-CELL)
      (let (e:(raw Node) (macroexpand-form n -1))
        (when (and (!= e null) (= (e kind) NODE-INT)) (return 1))))
    (return 0)))

; Stage 15 W2a: the float counterpart of node-is-int-literal. A bare float
; literal has no width of its own (the reader types it f64), so in a binary
; operation against an f32 operand it adapts to that operand's width instead of
; forcing the whole expression to double — the same courtesy an int literal has
; had since Stage 9 §10.1. Unlike an int literal it adapts only to a *float*
; type: a float literal against an int operand stays the "mixed float and
; non-float operands" error it is today.
(defn node-is-float-literal (n:(raw Node)):i32
  (when (= n null) (return 0))
  (let (nn:(raw Node) n)
    (when (= (nn kind) NODE-FLOAT) (return 1))
    (when (= (nn kind) NODE-CELL)
      (let (e:(raw Node) (macroexpand-form n -1))
        (when (and (!= e null) (= (e kind) NODE-FLOAT)) (return 1))))
    (return 0)))

; Stage 15 W2b (design/stage15-stress-test/literal-typing.md §3.1): true if `n`
; is a bare symbol naming a `defconst`/`defenum` member — i.e. a *name for* an
; integer literal, which must adapt at a use site exactly as the literal it
; stands for. `(defconst K 512)` + `(<= ans:ui32 K)` was rejected as
; mixed-signed while the identical program spelled `(<= ans:ui32 512)`
; compiled; naming a constant must not change how it types.
;
; Scope is required and cannot be shortcut to `g-globals`: a `defconst` always
; lives in the global scope, but a local binding of the same name shadows it
; (`(let (K:i32 3) …)`), and a shadowed local is emphatically not a literal.
; `scope` is nullable — a caller that has no scope (none today) simply gets 0,
; the conservative answer.
(defn node-is-const-int-literal (n:(raw Node) scope:(raw Scope)):i32
  (when (= n null) (return 0))
  (when (= scope null) (return 0))
  (let (nn:(raw Node) n)
    ; Like node-is-int-literal, see through the variadic operator macros'
    ; single-arg wrappers. This is not an optimization — it is required: `(* v
    ; K)` expands to `(_* v (* K))`, so the binop's SECOND operand node is the
    ; cell `(* K)`, never the bare symbol. Without this the fix worked in
    ; operand-1 position and silently did not in operand-2 position, exactly
    ; the order-dependence W2a existed to remove.
    (when (= (nn kind) NODE-CELL)
      (let (e:(raw Node) (macroexpand-form n -1))
        (when (or (= e null) (= (e kind) NODE-CELL)) (return 0))
        (set! nn e)))
    (when (!= (nn kind) NODE-SYM) (return 0))
    ; Strip a trailing :type annotation the same way emit-symbol-ref does, so
    ; the two passes resolve the identical Sym.
    (let (lookup-name:ptr null
          ignored-type:ptr null)
      (split-typed (nn s) (as ptr:ptr (addr-of lookup-name))
                          (as ptr:ptr (addr-of ignored-type)))
      (if-some (sym (scope-lookup scope lookup-name))
        (return (sym const-lit))
        (return 0)))))

; Stage 15 W2b: THE test for "this binop operand is an untyped integer literal
; and may adopt the other operand's type" — a bare literal (W2a) or a name bound
; to one (W2b). Used only by `binop-result-type`, so emit and node-type ask the
; same question of the same operand. NOT wired into the multimethod-dispatch
; `is-lit` flags in src/generics.nuc (arg-adapts): those decide *overload
; selection*, and widening the literal set there would silently re-route
; existing dispatch. Extending them is a separate, deliberate change.
(defn operand-is-int-literal (n:(raw Node) scope:(raw Scope)):i32
  (when (!= (node-is-int-literal n) 0) (return 1))
  (return (node-is-const-int-literal n scope)))

(defn float-width (t:(raw Type)):i32
  (let (k:i32 (t kind))
    (when (= k TY-F32) (return 32))
    (when (= k TY-F64) (return 64))
    (return 0)))

; Coerce a numeric Val to a target numeric type: int→int (trunc/sext/zext),
; int→float (sitofp/uitofp), float→float (fpext/fptrunc). Identity when already
; the target; null when the source is not numeric.
(defn coerce-num-val (v:(raw Val) target:(raw Type) line:i32):?ptr:Val
  (let (vv:(raw Val) v
        src:(raw Type) (vv type))
    (when (!= (type-eq src target) 0) (return v))
    (when (and (!= (is-int-type src) 0) (!= (is-int-type target) 0))
      (return (coerce-int-val v target line)))
    (when (and (!= (is-int-type src) 0) (!= (is-float-type target) 0))
      (let (tmp:ptr (new-tmp)
            instr:ptr "sitofp")
        (when (!= (is-unsigned src) 0) (set! instr "uitofp"))
        (fprintf g-body-stream "  %s = %s %s %s to %s\n"
          tmp instr (type-to-ir src) (vv val) (type-to-ir target))
        (return (alloc-val target tmp))))
    ; Stage 15 W2d: float→float lives in coerce-int-val (the shared coercion
    ; chokepoint) so the binop path and every typed-slot path fold a float
    ; literal by the same rule; this was a second copy of the fpext/fptrunc
    ; emission until W2d, and the binop side is exactly where an unfolded
    ; `fptrunc double 2.0 to float` would have shown up in `(* alpha:f32 2.0)`.
    (when (and (!= (is-float-type src) 0) (!= (is-float-type target) 0))
      (return (coerce-int-val v target line)))
    (return null)))

; ============================================================
; Stage 8: defcast registry + implicit safe coercion at call sites
; ============================================================

(defn register-cast-rule (from:(raw Type) to:(raw Type) ir-name:CStr):void
  (when (>= (unsafe/cast i32 (count g-cast-rules)) MAX-CAST-RULES)
    (fprintf stderr "nucleusc: too many defcast rules\n") (exit 1))
  (let (cr:ptr:CastRule (as ptr:CastRule (arena-alloc (sizeof CastRule))))
    (.set! cr from from)
    (.set! cr to to)
    (.set! cr ir-name ir-name)
    (conj g-cast-rules cr)))

(defn lookup-cast-rule (from:(raw Type) to:(raw Type)):?ptr:CastRule
  (doseq (cr g-cast-rules (VecIter ref:CastRule))
         (when (and (!= (type-eq (cr from) from) 0)
                    (!= (type-eq (cr to) to) 0))
               (return cr)))
  (return null))

; Coerce a Val to a target type at a call site (or any implicit context):
; same-kind identity, int↔int via coerce-int-val, f32→f64 fpext, and any
; user-registered defcast rule. Returns null when no safe conversion applies.
(defn safe-coerce-val (v:(raw Val) target:(raw Type) line:i32):?ptr:Val
  (let (vv:(raw Val) v
        src:(raw Type) (vv type)
        sk:i32 (src kind)
        dk:i32 (target kind))
    ; Stage 14 NS-3 (design/stage14/native-strings.md): a StrView source (notably
    ; an unmaterialized string literal, whose IR type "%StrView" differs from a
    ; ptr/CStr parameter's and so reaches the call-site coercion) routes through
    ; coerce-int-val — it collapses the literal to ptr/CStr with NO IR (keeping the
    ; compiler's own arg-passing byte-identical) or materializes {ptr,len} for a
    ; StrView parameter. Placed before the sk==dk short-circuit so a StrView→StrView
    ; literal materializes rather than passing the chameleon through.
    (when (!= (type-is-strview src) 0)
      (return (coerce-int-val v target line)))
    (when (= sk dk) (return v))
    (when (and (!= (is-int-type src) 0) (!= (is-int-type target) 0))
      (return (coerce-int-val v target line)))
    ; Stage 15 W2d: any float→float pair, not just the widening f32→f64 this
    ; used to spell inline. The narrowing direction was the silent
    ; **miscompile**: a null return here does not raise, it leaves the argument
    ; untouched (see the comment at the emit-call-with-args coercion loop), so
    ; `(take 2.5)` against `(defn take (x:f32) …)` emitted
    ; `call float @take(double 2.5)` and printed 0.000000. The widening branch
    ; produces byte-identical IR through coerce-int-val (same `fpext float …
    ; to double` text), so existing f32→f64 argument passing is unchanged.
    (when (and (!= (is-float-type src) 0) (!= (is-float-type target) 0))
      (return (coerce-int-val v target line)))
    (let (rule:(raw CastRule) (lookup-cast-rule src target))
      (when (!= rule null)
        (let (cr:(raw CastRule) rule
              tmp:ptr (new-tmp))
          (fprintf g-body-stream "  %s = call %s %s(%s %s)\n"
            tmp (type-to-ir target) (cr ir-name) (type-to-ir src) (vv val))
          (return (alloc-val target tmp)))))
    (return null)))

(defn emit-defcast (call:(raw Node)):void
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 4)
      (die-at (cc line) "defcast: expects (defcast From To conv-fn)"))
    (let (from-node:(raw Node) (node-at cc 1)
          to-node:(raw Node)   (node-at cc 2)
          fn-node:(raw Node) (node-at cc 3)
          from:(raw Type) (parse-type-from-node from-node (cc line))
          to:(raw Type)   (parse-type-from-node to-node   (cc line)))
      (when (!= (fn-node kind) NODE-SYM)
        (die-at (node-line (as ptr fn-node) (cc line)) "defcast: conv-fn must be a symbol"))
      ; Reject pairs already covered by built-in safe-coerce rules.
      (let (fk:i32 (from kind)
            tk:i32 (to kind))
        (when (= fk tk)
          (die-at (cc line) "defcast: identity cast is implicit; rule rejected"))
        (when (and (!= (is-int-type from) 0) (!= (is-int-type to) 0))
          (die-at (cc line)
            "defcast: integer↔integer pairs are handled by built-in coercion; rule rejected"))
        (when (and (= fk TY-F32) (= tk TY-F64))
          (die-at (cc line)
            "defcast: f32→f64 is handled by built-in coercion; rule rejected")))
      (when (!= (lookup-cast-rule from to) null)
        (die-at (cc line) "defcast: a rule for this pair is already registered"))
      (let (sym:ptr (scope-lookup g-globals (fn-node s)))
        (when (= sym null)
          (die-at (node-line (as ptr fn-node) (cc line)) (fmt-s "defcast: unknown function '%s'" (fn-node s))))
        (let (ss:(raw Sym) sym
              ft:(raw Type) (ss type))
          (when (!= (ft kind) TY-FN)
            (die-at (node-line (as ptr fn-node) (cc line)) (fmt-s "defcast: '%s' is not a function" (fn-node s))))
          (when (!= (ft num-params) 1)
            (die-at (node-line (as ptr fn-node) (cc line)) (fmt-s "defcast: '%s' must take exactly one argument" (fn-node s))))
          (when (!= (ft variadic) 0)
            (die-at (node-line (as ptr fn-node) (cc line)) (fmt-s "defcast: '%s' must not be variadic" (fn-node s))))
          (when (!= (ft has-rest) 0)
            (die-at (node-line (as ptr fn-node) (cc line)) (fmt-s "defcast: '%s' must not use &rest" (fn-node s))))
          (let (param0:ptr ((field-at (ft params) 0) type))
            (when (= (type-eq param0 from) 0)
              (die-at (node-line (as ptr fn-node) (cc line))
                (fmt-2s "defcast: '%s' parameter type does not match From; expected %s"
                  (fn-node s) (type-to-ir from)))))
          (when (= (type-eq (ft ret) to) 0)
            (die-at (node-line (as ptr fn-node) (cc line))
              (fmt-2s "defcast: '%s' return type does not match To; expected %s"
                (fn-node s) (type-to-ir to))))
          (register-cast-rule from to (ss ir-name)))))))

; ------------------------------------------------------------
; Stage 15 W2a (design/stage15-stress-test/literal-typing.md): THE single type
; rule for a binary operator's operands. Both halves of the node-type↔emit-node
; lockstep (conventions.md) call it: `binop-coerce` below for the value-level
; adaptation it emits, and `node-type-call` (src/generics.nuc, intrinsic-binop
; branch) for the type a binop contributes to its parent. Before W2a the type
; pass returned *operand 1's type alone* while emit unified both, so
; `(* 4096 (as i64 X))` emitted i64 but typed i32 (a bogus `sext i32 <i64>` from
; the argument coercer) and `(> t:ui32 (* 2 cl:ui32))` was rejected as
; mixed-sign. Do not re-derive this rule at a call site — a second copy is how it
; drifted the first time.
;
; Returns the type both operands unify to, or null when they cannot be
; reconciled *here* (the caller's own checks then report it — node-type is
; allowed to not know and must never die; emit-binop-vals raises the
; mixed-sign / operand-mismatch diagnostics). Literalness is probed only after
; the types are known to differ, so the same-type hot path costs nothing.
(defn binop-result-type (at:(raw Type) bt:(raw Type) a-node:(raw Node) b-node:(raw Node)
                         scope:(raw Scope)):?ptr:Type
  (when (= at null) (return null))
  (when (= bt null) (return null))
  (when (!= (type-eq at bt) 0) (return at))
  (let (a-num:i32 (or (!= (is-int-type at) 0) (!= (is-float-type at) 0))
        b-num:i32 (or (!= (is-int-type bt) 0) (!= (is-float-type bt) 0)))
    (when (or (= a-num 0) (= b-num 0)) (return null)))
  ; Stage 15 W2b: `scope` is what makes a *named* literal (`defconst`/`defenum`)
  ; count as one — see operand-is-int-literal. Both callers supply the scope the
  ; operands were resolved in, so emit and node-type classify identically.
  (let (a-lit:i32 (operand-is-int-literal a-node scope)
        b-lit:i32 (operand-is-int-literal b-node scope))
    ; An untyped int literal adopts the other operand's numeric type (Stage 9
    ; §10.1) — including a float type, via coerce-num-val's sitofp/uitofp. Two
    ; int literals fall through to the widening path below, where emit-int's
    ; LW-4 widths (i32, or i64 when the value does not fit) settle it.
    (when (and (!= a-lit 0) (= b-lit 0)) (return bt))
    (when (and (!= b-lit 0) (= a-lit 0)) (return at))
    ; W2a: the same courtesy for a float literal, but only against a *float*
    ; operand — `(* alpha:f32 2.0)` is f32, while `(* n:i32 2.0)` stays the
    ; "mixed float and non-float operands" error. Probed after the int-literal
    ; branches so `(+ 1.0 2)` keeps typing f64 (the int literal adapts to the
    ; float literal's f64, as today), and only when a float operand is in play.
    (when (and (= a-lit 0) (= b-lit 0)
               (or (!= (is-float-type at) 0) (!= (is-float-type bt) 0)))
      (let (a-flit:i32 (node-is-float-literal a-node)
            b-flit:i32 (node-is-float-literal b-node))
        (when (and (!= a-flit 0) (= b-flit 0) (!= (is-float-type bt) 0)) (return bt))
        (when (and (!= b-flit 0) (= a-flit 0) (!= (is-float-type at) 0)) (return at))))
    ; Both typed: int+float (non-literal) needs an explicit cast.
    (when (and (!= (is-float-type at) 0) (!= (is-int-type bt) 0)) (return null))
    (when (and (!= (is-int-type at) 0) (!= (is-float-type bt) 0)) (return null))
    ; Char is a distinct scalar (Stage 11 M6 S0): a typed Char must not silently
    ; unify with a same-width non-Char int (e.g. ui32). Bail so the kind-mismatch
    ; check in emit-binop-vals reports it; the programmer casts explicitly. (An
    ; untyped int *literal* still adapts to Char via the literal branches above —
    ; only two typed, differently-kinded operands are rejected.)
    (when (and (or (= (at kind) TY-CHAR)
                   (= (bt kind) TY-CHAR))
               (!= (at kind)
                   (bt kind)))
      (return null))
    (when (!= (is-float-type at) 0)
      (when (>= (float-width at) (float-width bt)) (return at))
      (return bt))
    ; Two typed ints of differing signedness are a real error — never
    ; sign-reinterpret one into the other. Report null so emit-binop-vals'
    ; "mixed signed/unsigned operands" diagnostic fires.
    (when (!= (is-unsigned at) (is-unsigned bt)) (return null))
    (when (>= (int-width at) (int-width bt)) (return at))
    (return bt)))

; The widen / untyped-int-literal resolution tier for a binary operator
; (Stage 9 §10.3). The *type* decision is `binop-result-type` above (shared with
; node-type); this is the value-level half — it emits the casts that put both
; operands at that type. Returns a 2-element Val* array [a' b'] sharing a type,
; or null when no adaptation applies (operands already match, or can't be
; reconciled here — the caller's checks then fire).
(defn binop-coerce (a:(raw Val) b:(raw Val) a-node:(raw Node) b-node:(raw Node)
                    scope:(raw Scope) line:i32):ptr
  (let (at:(raw Type) (a type)
        bt:(raw Type) (b type))
    ; Already the same type: nothing to emit. (binop-result-type would answer
    ; `at`; short-circuiting keeps the hot path free of a redundant coerce pair.)
    (when (!= (type-eq at bt) 0) (return null))
    (let (target:?ptr:Type (binop-result-type at bt a-node b-node scope))
      (when (= target null) (return null))
      (let (na:ptr (coerce-num-val a target line)
            nb:ptr (coerce-num-val b target line))
        (when (or (= na null) (= nb null)) (return null))
        (let (pair:ptr (arena-alloc (* (as i64 2) (ptr-bytes))))
          (aset! (as ptr:ptr pair) 0 na)
          (aset! (as ptr:ptr pair) 1 nb)
          (return pair))))))

; Stage 14 NS-2 (design/stage14/native-strings.md): the `ptr` (char*) operand
; for a content comparison of a Val that may be a StrView. A StrView yields its
; `data` field via one extractvalue (the view's bytes); a plain ptr/CStr already
; IS the pointer and is returned with no extra IR — so the existing CStr/ptr
; strcmp path allocates no stray tmp and stays byte-identical. DORMANT until a
; StrView operand exists (NS-3): `type-is-strview` is 0 for every current operand.
(defn strview-data-ir (v:(raw Val)):ptr
  (let (vv:(raw Val) v)
    ; Stage 14 NS-3: an *unmaterialized* string literal (is-lit=1, StrView type)
    ; keeps its data pointer directly in `val` (the bare GEP), so no extractvalue —
    ; `(= name "lit")` lowers to exactly the same strcmp as the old CStr literal.
    (when (and (!= (vv is-lit) 0) (!= (type-is-strview (vv type)) 0))
      (return (vv val)))
    (when (!= (type-is-strview (vv type)) 0)
      (let (d:ptr (new-tmp))
        (fprintf g-body-stream "  %s = extractvalue %s %s, 0\n"
          d (type-to-ir (vv type)) (vv val))
        (return d)))
    (return (vv val))))

; Emit an operator's inline instruction given already-emitted operand Vals. This
; is the front-end inline peephole (§10.3): a built-in numeric/pointer operator
; lowers to a single `add nsw`/`icmp slt`/`fadd`/… instruction, never a call.
; a-node/b-node are the operand source nodes (or null), consulted only to flag
; untyped int literals for the widen/adapt tier when the operand types differ. For
; operands that already share a type, the IR is byte-identical to the pre-Stage-9
; emit-binop (binop-coerce returns null and nothing is inserted).
(defn emit-binop-vals (a:(raw Val) b:(raw Val) a-node:(raw Node) b-node:(raw Node) op:(raw BinOp)
                       scope:(raw Scope) line:i32):ref:Val
  (let (bop:(raw BinOp) op
        av:(raw Val) a
        bv:(raw Val) b)
    ; C-string equality (Eq): =/!= where *either* operand is CStr lower to a
    ; strcmp content comparison, not pointer identity (the other operand must be
    ; a pointer/CStr — a string literal is CStr, so `(= some-ptr "lit")` does a
    ; content test). strcmp is declared by the prelude's (import-use "string.h"); CStr
    ; only supports = and != for now (no ordering). Two plain `ptr` operands fall
    ; through to the identity comparison below.
    ;
    ; Stage 14 NS-2 (design/stage14/native-strings.md): a StrView operand is also
    ; admitted here (against a ptr/CStr/StrView) — its `data` is extracted first
    ; (strview-data-ir) and the content is strcmp'd, keeping `(= name "lit")`
    ; exactly as it lowers today once literals become views. DORMANT: no StrView
    ; value exists yet (NODE-STR is CStr until NS-3), so `av-sv`/`bv-sv` are 0, the
    ; trigger fires only on CStr as before, strview-data-ir returns the bare ptr
    ; with no tmp, and this branch is byte-identical. Two plain `ptr` stay `icmp`
    ; identity (the Node.s interned-symbol path is untouched).
    ;
    ; Stage 15 W5c: comparing against the `null` LITERAL is an identity test, not
    ; a content test — it must NOT reach the strcmp lowering. `strcmp(x, NULL)`
    ; is undefined behaviour in C and segfaults under glibc, so this branch could
    ; never have been right for a null operand and no correct program can depend
    ; on it. Measured before the fix: `(defvar g:CStr null)` + `(= g null)`
    ; emitted `call i32 @strcmp(ptr %t0, ptr null)` and the program died with
    ; SIGSEGV. The hazard is NOT specific to globals — a `CStr` parameter or
    ; local null-checked with `=` lowered identically (this is conventions.md's
    ; documented "null-check trap", which until now could only be avoided by
    ; never giving a null-checked value the `CStr` type). W5c makes a `CStr`
    ; global spellable, so the trap became reachable by ordinary code and is
    ; closed here rather than documented as a footgun.
    ;
    ; Restricted to a ptr-like partner: a `StrView` is a 16-byte struct and can
    ; never be null, so `(= sv null)` is left exactly as it was (out of scope).
    (let (a-null:i32 (node-is-null-sym a-node)
          b-null:i32 (node-is-null-sym b-node)
          null-cmp:i32 0)
      (when (and (!= a-null 0) (!= (is-ptr-like (bv type)) 0)) (set! null-cmp 1))
      (when (and (!= b-null 0) (!= (is-ptr-like (av type)) 0)) (set! null-cmp 1))
    (let (av-sv:i32 (type-is-strview (av type))
          bv-sv:i32 (type-is-strview (bv type))
          av-cstr:i32 (= ((av type) kind) TY-CSTR)
          bv-cstr:i32 (= ((bv type) kind) TY-CSTR))
      (when (and (= null-cmp 0)
                 (or (!= av-cstr 0) (!= bv-cstr 0) (!= av-sv 0) (!= bv-sv 0)))
        ; Each operand must be a comparable string kind: ptr-like (ptr/CStr) or a
        ; StrView. Anything else (int/float/other struct) is a type error.
        (when (or (and (= (is-ptr-like (av type)) 0) (= av-sv 0))
                  (and (= (is-ptr-like (bv type)) 0) (= bv-sv 0)))
          (die-at line (fmt-s "%s: a CStr compares only with a CStr or pointer" (bop name))))
        (let (op-name:ptr (bop name))
          (when (and (!= op-name "=") (!= op-name "!="))
            (die-at line (fmt-s "%s: CStr supports only = and != (Eq)" op-name)))
          (let (a-ptr:ptr (strview-data-ir a)
                b-ptr:ptr (strview-data-ir b)
                c:ptr (new-tmp))
            (fprintf g-body-stream "  %s = call i32 @strcmp(ptr %s, ptr %s)\n"
              c a-ptr b-ptr)
            (let (r:ptr (new-tmp)
                  icmp-op:ptr "eq")
              (when (= op-name "!=") (set! icmp-op "ne"))
              (fprintf g-body-stream "  %s = icmp %s i32 %s, 0\n" r icmp-op c)
              (return (alloc-val ty-i1 r))))))))
    ; Pointer comparison.
    ; Stage 15 W5c: `is-ptr-like`, not TY-PTR — the only way a `CStr` operand
    ; reaches here is the null-literal escape above (any other CStr comparison
    ; already returned from the strcmp branch), so this admits exactly
    ; `(= cstr-value null)` and lowers it to the `icmp eq ptr` identity test it
    ; always should have been. Both-`ptr` behaviour is unchanged.
    (when (and (!= (is-ptr-like (av type)) 0)
             (!= (is-ptr-like (bv type)) 0))
      (when (!= (bop is-cmp) 0)
        (let (tmp:ptr (new-tmp))
          (fprintf g-body-stream "  %s = %s ptr %s, %s\n"
            tmp (bop instr) (av val) (bv val))
          (return (alloc-val ty-i1 tmp)))))
    ; Widen / adapt mixed numeric operands (untyped int literals + int/float widening).
    (let (adapted:ptr (binop-coerce a b a-node b-node scope line))
      (when (!= adapted null)
        (set! av (as ptr:Val (aref (as ptr:ptr adapted) 0)))
        (set! bv (as ptr:Val (aref (as ptr:ptr adapted) 1)))))
    ; Float arithmetic / comparison
    (when (or (!= (is-float-type (av type)) 0) (!= (is-float-type (bv type)) 0))
      (when (or (= (is-float-type (av type)) 0) (= (is-float-type (bv type)) 0))
        (die-at line (fmt-s "%s: mixed float and non-float operands — use explicit cast" (bop name))))
      (when (!= ((av type) kind)
               ((bv type) kind))
        (die-at line (fmt-s "%s float operand width mismatch — use explicit cast" (bop name))))
      (let (finstr:ptr null
            op-name:ptr (bop name))
        (cond (or (= op-name "+")
                  (= op-name "_+")
                  (= op-name "_+"))
                (set! finstr "fadd")
              (or (= op-name "-")
                  (= op-name "_-")
                  (= op-name "_-"))
                (set! finstr "fsub")
              (or (= op-name "*")
                  (= op-name "_*")
                  (= op-name "_*"))
                (set! finstr "fmul")
              (or (= op-name "/")
                  (= op-name "_/")
                  (= op-name "_/"))
                (set! finstr "fdiv")
              (= op-name "%")  (set! finstr "frem")
              (= op-name "=")  (set! finstr "fcmp oeq")
              (= op-name "!=") (set! finstr "fcmp one")
              (= op-name "<")  (set! finstr "fcmp olt")
              (= op-name "<=") (set! finstr "fcmp ole")
              (= op-name ">")  (set! finstr "fcmp ogt")
              (= op-name ">=") (set! finstr "fcmp oge")
              true (do))
        (when (= finstr null)
          (die-at line (fmt-s "%s does not apply to floats" op-name)))
        (let (tmp:ptr (new-tmp))
          (fprintf g-body-stream "  %s = %s %s %s, %s\n"
            tmp finstr (type-to-ir (av type)) (av val) (bv val))
          (let (rtype:ptr (av type))
            (when (!= (bop is-cmp) 0) (set! rtype ty-i1))
            (return (alloc-val rtype tmp))))))
    (when (or (= (is-int-type (av type)) 0) (= (is-int-type (bv type)) 0))
      (die-at line (fmt-s "%s expects integer operands" (bop name))))
    (when (!= (is-unsigned (av type)) (is-unsigned (bv type)))
      (die-at line (fmt-s "%s: mixed signed/unsigned operands — use explicit cast" (bop name))))
    (when (!= ((av type) kind)
             ((bv type) kind))
      (die-at line (fmt-s "%s operand type mismatch" (bop name))))
    (let (tmp:ptr (new-tmp)
          instr:ptr (bop instr))
      (when (!= (is-unsigned (av type)) 0) (set! instr (bop instr-u)))
      (fprintf g-body-stream "  %s = %s %s %s, %s\n"
        tmp instr (type-to-ir (av type)) (av val) (bv val))
      (let (rtype:ptr (av type))
        (when (!= (bop is-cmp) 0) (set! rtype ty-i1))
        (return (alloc-val rtype tmp))))))

(defn emit-binop (call:(raw Node) scope:ref:Scope op:(raw BinOp)):ref:Val
  (let (cc:(raw Node) call
        bop:(raw BinOp) op)
    (when (!= (node-len cc) 3)
      (die-at (cc line) (fmt-s "%s expects 2 args" (bop name))))
    (let (a:ref:Val (emit-node (node-at cc 1) scope)
          b:ref:Val (emit-node (node-at cc 2) scope))
      (return (emit-binop-vals a b (node-at cc 1) (node-at cc 2) op scope (cc line))))))

; ============================================================
; Cast
; ============================================================

(defn emit-cast (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 3)
      (die-at (cc line) "cast expects 2 args"))
    (let (type-node:(raw Node) (node-at cc 1))
      (let (dst:(raw Type) (parse-type-from-node type-node (type-node line))
            v:ref:Val (emit-node (node-at cc 2) scope)
            src:(raw Type) (v type))
        ; Stage 14 NS-3 (design/stage14/native-strings.md): a StrView chameleon
        ; literal's kind is TY-STRUCT, so the same-kind identity fast path below
        ; would fire for BOTH `(cast StrView "…")` and `(cast OtherStruct "…")`,
        ; returning the bare-GEP Val mislabeled as the destination struct (a `ptr`
        ; typed as `%Dst`) and crashing the LLVM verifier downstream. Route any
        ; StrView literal cast through the value coercer FIRST — it materializes a
        ; genuine {ptr,len} for a StrView target, collapses to the bare GEP for a
        ; ptr/CStr target (no IR, byte-identical to the old CStr cast), and returns
        ; null → a clean diagnostic for an unrelated struct target. Must precede the
        ; identity return.
        (when (and (!= (v is-lit) 0) (!= (type-is-strview src) 0))
          (let (cv:?ptr:Val (coerce-int-val v dst (cc line)))
            (when (= cv null)
              (die-at (cc line) "cast: unsupported StrView conversion"))
            (return (as ref:Val cv))))
        ; Reinterpreting casts preserve pointer identity, so the result keeps
        ; the operand's escape taint (lifecycle.md §2.2).
        (when (= (src kind) (dst kind))
          (let (rv:ref:Val (alloc-val dst (v val)))
            (val-copy-taint rv v)
            (return rv)))
        ; CStr <-> ptr: both lower to `ptr`, reinterpret with no IR.
        (when (and (!= (is-ptr-like src) 0) (!= (is-ptr-like dst) 0))
          (let (rv:ref:Val (alloc-val dst (v val)))
            (val-copy-taint rv v)
            (return rv)))
        ; Stage 14 NS-3 (design/stage14/native-strings.md): an explicit cast of a
        ; StrView to a pointer is the free borrow-to-ptr (`(cast ptr "…")` is common
        ; in the compiler — string literals stored into ptr registries). Delegates
        ; to the value coercer so the chameleon-collapse (unmaterialized literal →
        ; bare GEP, no IR) / extractvalue (general view → `data`) logic lives in one
        ; place. Byte-identical for `(cast ptr "lit")`: it was a CStr→ptr no-op
        ; before the flip and stays a no-op after.
        (when (and (!= (type-is-strview src) 0) (!= (is-ptr-like dst) 0))
          (let (cv:?ptr:Val (coerce-int-val v dst (cc line)))
            (when (= cv null)
              (die-at (cc line) "cast: unsupported StrView conversion"))
            (return (as ref:Val cv))))
        ; Function value <-> pointer: a TY-FN value is already `ptr` in opaque-
        ; pointer IR (a function pointer), so this is a no-IR reinterpret. Needed
        ; e.g. to type-erase a handler fn into a Handler's hfn:ptr (errors.md §11).
        (when (or (and (= (src kind) TY-FN) (!= (is-ptr-like dst) 0))
                  (and (!= (is-ptr-like src) 0) (= (dst kind) TY-FN)))
          (let (rv:ref:Val (alloc-val dst (v val)))
            (val-copy-taint rv v)
            (return rv)))
        (let (instr:ptr null)
          (when (and (!= (is-int-type src) 0) (!= (is-int-type dst) 0))
            (let (sw:i32 (int-width src) dw:i32 (int-width dst))
              (when (= sw dw)
                ; Same width, different signedness — reinterpret (no IR needed)
                (return (alloc-val dst (v val))))
              (if (< dw sw)
                (set! instr "trunc")
                (if (!= (is-unsigned src) 0)
                  (set! instr "zext")
                  (set! instr "sext")))))
          (when (and (!= (is-int-type src) 0) (!= (is-ptr-like dst) 0))
            (set! instr "inttoptr"))
          (when (and (!= (is-ptr-like src) 0) (!= (is-int-type dst) 0))
            (set! instr "ptrtoint"))
          ; Float-to-float (different widths): fpext or fptrunc.
          (when (and (!= (is-float-type src) 0) (!= (is-float-type dst) 0))
            (let (sk:i32 (src kind)
                  dk:i32 (dst kind))
              (cond (and (= sk TY-F32) (= dk TY-F64)) (set! instr "fpext")
                    (and (= sk TY-F64) (= dk TY-F32)) (set! instr "fptrunc")
                    true (do))))
          ; Int-to-float: sitofp or uitofp depending on src signedness.
          (when (and (!= (is-int-type src) 0) (!= (is-float-type dst) 0))
            (if (!= (is-unsigned src) 0)
              (set! instr "uitofp")
              (set! instr "sitofp")))
          ; Float-to-int: fptosi or fptoui depending on dst signedness.
          (when (and (!= (is-float-type src) 0) (!= (is-int-type dst) 0))
            (if (!= (is-unsigned dst) 0)
              (set! instr "fptoui")
              (set! instr "fptosi")))
          (when (= instr null)
            (die-at (cc line) "cast: unsupported conversion"))
          (let (tmp:ptr (new-tmp))
            (fprintf g-body-stream "  %s = %s %s %s to %s\n"
              tmp instr (type-to-ir src) (v val) (type-to-ir dst))
            (return (alloc-val dst tmp))))))))

; ============================================================
; Stage 14 UN-1: the `as` statically-safe conversion form
; (design/stage14/unsafe-namespace.md §D3). `(as TYPE expr)` accepts exactly (a)
; what the implicit-coercion machinery accepts in an assignment position, plus
; (b) pure pointer-contract weakening ((ref T)->(raw T); typed ptr -> elem-less
; bare `ptr`) — and refuses everything lossy or contract-manufacturing, routing
; each rejection to the right tool. Unlike `cast`, `as` HONORS pkind-flow-check,
; closing the raw->ref laundering hole for the safe spelling.
;
; node-type-as (src/generics.nuc) mirrors this under the node-type<->emit-node
; lockstep: emit-as returns a Val typed *exactly* the parsed target type for
; every accepted input, so node-type-as returns that same parsed target type.
; ============================================================

; Retype `v` to `dst` with no IR (a pure reinterpret), carrying the operand's
; escape taint (`as` preserves cast's taint-copy behavior — lifecycle.md §2.2).
(defn as-retype (v:(raw Val) dst:(raw Type)):ref:Val
  (let (rv:ref:Val (alloc-val dst (v val)))
    (val-copy-taint rv v)
    (return rv)))

; The raw/nullable -> non-null (ref/ptr) laundering diagnostic — `as` honoring
; pkind-flow-check, routed to the checked `as-ref` launder or the unchecked
; `unsafe/cast` assertion (never silently laundered as `cast` does).
(defn as-die-flow (src:(raw Type) dst:(raw Type) line:i32):void
  (if (= (ptr-pkind src) PTR-MAYBE)
    (die-at line
      (fmt-2s "as: nullable pointer %s where non-null %s is required -- narrow with if-some/unwrap, use as-ref (checked), or unsafe/cast (unchecked assertion)"
        (type-spelling src) (type-spelling dst)))
    (die-at line
      (fmt-2s "as: raw pointer %s where non-null %s is required -- use as-ref (checked) or unsafe/cast (unchecked assertion)"
        (type-spelling src) (type-spelling dst)))))

; Pointer-like (TY-PTR / TY-CSTR) source AND destination. Accepts CStr<->ptr-like,
; the void* hatch (elem-less bare `ptr` -> typed), and pure weakening ((ref)->(raw),
; typed -> bare); rejects element-retyping (reinterpretation) and raw/nullable ->
; non-null (laundering). No IR on any accepted path. Never uses a type-eq identity
; short-circuit: type-eq ignores pkind, so it would silently launder raw->ref.
(defn as-ptr-convert (v:(raw Val) src:(raw Type) dst:(raw Type) line:i32):ref:Val
  (let (sk:i32 (src kind)
        dk:i32 (dst kind))
    ; typed/CStr -> elem-less bare `ptr` (void*): weakening, always safe.
    (when (and (= dk TY-PTR) (= (dst elem) null))
      (return (as-retype v dst)))
    ; ptr-like -> CStr: an opaque char*, ptr-compatible, carries no obligation.
    (when (= dk TY-CSTR)
      (return (as-retype v dst)))
    ; here dst is a TYPED pointer (TY-PTR, elem != null).
    ; CStr -> typed pointer: CStr is ref-compatible (a C string is a non-null
    ; constant, mirroring pkind-flow-check's CStr refinement).
    (when (= sk TY-CSTR)
      (return (as-retype v dst)))
    ; elem-less bare `ptr` (void*) -> typed pointer: the void* hatch, gated by the
    ; same flow rule pkind-flow-check applies (bare `ptr` is PTR-REF and passes; a
    ; bare `raw`/Maybe void* into a non-null slot launders).
    (when (= (src elem) null)
      (when (and (= (ptr-pkind dst) PTR-REF) (!= (ptr-pkind src) PTR-REF))
        (as-die-flow src dst line))
      (return (as-retype v dst)))
    ; both typed: the pointee type must match, else this is a reinterpretation.
    (when (= (type-eq (src elem) (dst elem)) 0)
      (die-at line
        (fmt-2s "as: reinterpretation from %s to %s -- use unsafe/cast"
          (type-spelling src) (type-spelling dst))))
    ; same pointee: only a non-null obligation can reject (raw/nullable -> ref).
    (when (and (= (ptr-pkind dst) PTR-REF) (!= (ptr-pkind src) PTR-REF))
      (as-die-flow src dst line))
    (return (as-retype v dst))))

(defn emit-as (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 3)
      (die-at (cc line) "as expects 2 args"))
    (let (type-node:(raw Node) (node-at cc 1))
      (let (dst:(raw Type) (parse-type-from-node type-node (type-node line))
            ; TC-2 want channel: `as` NAMES a type at this position, exactly as a
            ; let/with binding, a `set!` target, a `return` or a `.set!` field
            ; does — so it must arm `g-want-type` for its operand. It was the one
            ; declared-type position missing from that list, and the omission is
            ; not academic: a return-only-tyvar generic in operand position
            ; (`(as (ref (Vector (ref Cleanup))) (vector-new-in …))` — scope.nuc's
            ; `scope-new`) resolved instead against whichever instance happened to
            ; be stamped FIRST in the unit. It read correctly only because that
            ; call site also *was* the compiler's first `vector-new-in`; stamping
            ; any other element type earlier silently retargeted it, and the
            ; `unsafe/cast` spelling of the same shape takes the wrong vector with
            ; no diagnostic at all. Save/restore, so the want does not leak past
            ; the operand.
            v:ref:Val (let (save-want:ptr g-want-type)
                        (set! g-want-type (as ptr dst))
                        (let (vv:ref:Val (emit-node (node-at cc 2) scope))
                          (set! g-want-type save-want)
                          vv))
            src:(raw Type) (v type)
            sk:i32 (src kind)
            dk:i32 (dst kind))
        ; 1. StrView source (chameleon literal or value): the coercer collapses a
        ; literal to ptr/CStr with no IR, materializes a StrView target, or returns
        ; null for an unrelated struct target (a reinterpretation).
        (when (!= (type-is-strview src) 0)
          (let (cv:?ptr:Val (coerce-int-val v dst (cc line)))
            (when (= cv null)
              (die-at (cc line)
                (fmt-2s "as: reinterpretation from %s to %s -- use unsafe/cast"
                  (type-spelling src) (type-spelling dst))))
            (return (as ref:Val cv))))
        ; 2. pointer-like <-> pointer-like: always route through as-ptr-convert so
        ; the pkind flow gate fires (a plain identity short-circuit would launder).
        (when (and (!= (is-ptr-like src) 0) (!= (is-ptr-like dst) 0))
          (return (as-ptr-convert v src dst (cc line))))
        ; 3. identity (non-pointer same type): struct, fn, same scalar — no IR.
        (when (!= (type-eq src dst) 0)
          (return (as-retype v dst)))
        ; 4. user `defcast` rule extends the safe set (implicit AND `as`). Every
        ; registered rule has distinct from/to kinds (emit-defcast rejects the
        ; built-in same-kind/int/float pairs), so this never shadows steps 5-7.
        (let (rule:(raw CastRule) (lookup-cast-rule src dst))
          (when (!= rule null)
            (let (cr:(raw CastRule) rule
                  tmp:ptr (new-tmp))
              (fprintf g-body-stream "  %s = call %s %s(%s %s)\n"
                tmp (type-to-ir dst) (cr ir-name) (type-to-ir src) (v val))
              (return (alloc-val dst tmp)))))
        ; 5. int -> int: widening (zext/sext) and same-width sign reinterpret are
        ; safe (coerce-int-val emits them / no IR); narrowing is lossy.
        ; The narrowing test lives in `as-int-narrowing` (src/type-utils.nuc) so
        ; the constant folder in `defvar-init-ir` (Stage 15 W8 G-1) asks the same
        ; question of the same rule rather than mirroring this comparison.
        (when (and (!= (is-int-type src) 0) (!= (is-int-type dst) 0))
          (when (!= (as-int-narrowing src dst) 0)
            (die-at (cc line)
              (fmt-2s "as: lossy conversion from %s to %s -- use unsafe/cast"
                (type-spelling src) (type-spelling dst))))
          (return (unsafe/cast ref:Val (coerce-int-val v dst (cc line)))))
        ; 6. f32 -> f64 (fpext) is safe (widening).
        (when (and (= sk TY-F32) (= dk TY-F64))
          (let (tmp:ptr (new-tmp))
            (fprintf g-body-stream "  %s = fpext float %s to double\n" tmp (v val))
            (return (alloc-val dst tmp))))
        ; 7. remaining float conversions (f64->f32, float<->int) are lossy.
        (when (or (and (!= (is-float-type src) 0) (!= (is-float-type dst) 0))
                  (and (!= (is-float-type src) 0) (!= (is-int-type dst) 0))
                  (and (!= (is-int-type src) 0) (!= (is-float-type dst) 0)))
          (die-at (cc line)
            (fmt-2s "as: lossy conversion from %s to %s -- use unsafe/cast"
              (type-spelling src) (type-spelling dst))))
        ; 8. everything else — ptr<->int, fn<->ptr, unrelated structs — is a
        ; reinterpretation: route to unsafe/cast.
        (die-at (cc line)
          (fmt-2s "as: reinterpretation from %s to %s -- use unsafe/cast"
            (type-spelling src) (type-spelling dst)))))))

; ============================================================
; Struct field access
; ============================================================

; Intern `s` and return its canonical string pointer. Two equal spellings yield
; the same pointer, so interned strings compare by pointer identity (`=`) rather
; than `strcmp`. Field names are stored interned (emit-defstruct,
; repl-register-node) and selectors arrive interned (the reader/`quote` intern at
; lex time), so struct-field-index matches by identity.
(defn intern-str (s:ptr):ptr
  (return ((as ptr:Node (intern-symbol s)) s)))

; Stage 12 namespaces (design/stage12/namespaces.md §"Syntax", §"Implementation").
; Map a *source spelling* to the interned key under which its global is stored in
; g-globals. Splitting is a pure resolver concern — the reader leaves `/` as an
; ordinary symbol char, so `foo/bar` arrives here as one spelling.
;
; Rules (decision 2):
;   - The FIRST interior slash divides namespace from name. "Interior" means the
;     slash is neither leading (index 0) nor trailing (last char), so a bare `/`
;     (slash at both ends), `_/` (trailing slash), and any leading-slash name stay
;     whole and unqualified. Later slashes belong to the name (`foo//bar` →
;     namespace `foo`, name `/bar`).
;   - An unqualified spelling resolves against the current namespace
;     (g-current-ns).
;   - The `user` namespace stores BARE keys, so `user/bar` and a bare `bar` in
;     `user` are the same key — and the whole bootstrap stays byte-identical
;     because no compiler/library source declares a namespace yet.
;
; The result is interned so scope-lookup's pointer-identity comparison matches.
; Idempotent: re-qualifying an already-qualified spelling returns the same key.
(defn qualify-name (spelling:ptr):ptr
  (let (slash:ptr (strchr spelling 47))
    ; No slash, or a leading/trailing-only slash → unqualified name; the whole
    ; spelling is the bare name and the namespace is the current one.
    (let (interior:i32 0
          ns-part:ptr null
          name-part:ptr spelling)
      (when (!= slash null)
        (let (idx:i64 (- (unsafe/cast i64 (as ptr:i8 slash)) (unsafe/cast i64 (as ptr:i8 spelling)))
              after:i32 (as i32 (aref (as ptr:i8 slash) 1)))
          (when (and (> idx 0) (!= after 0))
            (set! interior 1)
            (set! ns-part (arena-strndup spelling idx))
            (set! name-part (arena-strdup (unsafe/ptr+ (as ptr:i8 slash) 1))))))
      (when (= interior 0)
        (set! ns-part g-current-ns))
      ; `user` (whether the current namespace or an explicit `user/` qualifier)
      ; stores BARE keys — the byte-identical escape hatch.
      (when (= (strcmp ns-part "user") 0)
        (return (intern-str name-part)))
      (return (intern-str (fmt-2s "%s/%s" ns-part name-part))))))

; Stage 12 N4: the bare (un-namespaced) name part of a spelling — the text after
; the FIRST interior slash, mirroring qualify-name's split. A spelling with no
; interior slash (`Vector`, bare `/`, `_/`, leading-slash) is returned unchanged.
; The result is interned so pointer-identity comparisons match. Idempotent on a
; bare name.
;
; This is a pure STRING operation, and since Stage 15 B3′ that is all it is. It
; canonicalizes nothing:
;   * W9 defect 21 removed protocols from it (a protocol is namespace-keyed and
;     canonicalizes through `protocol-canon-name`);
;   * B3′ removed TYPES from it (a type is namespace-keyed too, and canonicalizes
;     through `type-canon-name`; a type *reference* resolves through
;     `struct-lookup-ref` and friends). Stage 12 N4's "the type registry is
;     bare-keyed, so discard the qualifier" is exactly defect #4 — the qualifier
;     was never checked against anything, so `zzz/Fox` resolved.
; What remains are the three jobs that genuinely want "the name without its
; namespace": the ir-name base (`register-struct`, `ns-ir-base`), the re-export
; bare name (`emit-export`), and a did-you-mean's edit-distance subject
; (`suggest-better`). Do not re-extend it to a resolution position.
(defn strip-ns-qualifier (spelling:ptr):ptr
  (let (slash:ptr (strchr spelling 47))
    (when (!= slash null)
      (let (idx:i64 (- (unsafe/cast i64 (as ptr:i8 slash)) (unsafe/cast i64 (as ptr:i8 spelling)))
            after:i32 (as i32 (aref (as ptr:i8 slash) 1)))
        ; Interior slash only (neither leading nor trailing): take the name part.
        (when (and (> idx 0) (!= after 0))
          (return (intern-str (arena-strdup (unsafe/ptr+ (as ptr:i8 slash) 1)))))))
    (return spelling)))

; ============================================================
; Stage 15 B1 — the file's import environment
; (design/stage15-stress-test/name-resolution.md §5.2 B1, §8.3).
;
; An import prefix is a FILE-scoped binding, not a unit-global one. Before B1 it
; was neither: `inject-import-aliases` copied the imported slice of `g-globals`
; under a second key `prefix/name`, and because `qualify-name` splits on the
; first interior slash that key was the same string in every namespace — so a
; prefix declared while compiling file A resolved from file B, which never
; declared it (§2.4). `g-file-imports` is the authority: `do-import` records one
; `ImportBind` per import form, and saves/clears/restores the table around every
; imported file exactly as it does `g-current-ns`.
;
; Stage 15 B2b removed the alias injection this table was built to replace.
; A qualified reference is resolved through the environment (`resolve-spelling`
; → `globals-lookup-ref`), so the prefix now names a FILE, the file names a
; NAMESPACE, and the namespace composes the key the library already registered.
; `g-import-prefixes` survives for two unrelated jobs: enforcing "two imports may
; not share a prefix" (a whole-unit rule), and naming the binding file in the
; out-of-scope diagnostic's first tier.
; ============================================================

; The length of `spelling`'s namespace/prefix qualifier: the text before the
; FIRST interior slash, mirroring `qualify-name`'s split ("interior" = neither
; leading nor trailing). 0 when the spelling carries no qualifier. Returns a
; length rather than a string so the hot path allocates nothing.
(defn qualifier-len (spelling:ptr):i64
  (let (slash:ptr (strchr spelling 47))
    (when (= slash null) (return 0))
    (let (idx:i64 (- (unsafe/cast i64 (as ptr:i8 slash)) (unsafe/cast i64 (as ptr:i8 spelling)))
          after:i32 (as i32 (aref (as ptr:i8 slash) 1)))
      (when (or (<= idx 0) (= after 0)) (return 0))
      (return idx))))

; Is the whole of `t` equal to the first `n` characters of `s`? Content
; comparison — see ImportBind's note on why identity will not do.
(defn qualifier-eq (s:ptr t:ptr n:i64):i32
  (dotimes (i n)
    (let (tc:i32 (char-at t i))
      (when (= tc 0) (return 0))
      (when (!= (char-at s i) tc) (return 0))))
  (when (!= (char-at t n) 0) (return 0))
  (return 1))

; The file some import in this UNIT bound this qualifier to as a prefix, or null
; if no import anywhere bound it. `g-import-prefixes` is the existing prefix →
; file list (`s` = prefix, `car` = path).
(defn unit-prefix-path (spelling:ptr n:i64):ptr
  (let (cur:ptr g-import-prefixes)
    (while (!= cur null)
      (let (e:ptr:Node (unsafe/cast ptr:Node cur))
        (when (!= (qualifier-eq spelling (e s) n) 0) (return (as ptr (e car))))
        (set! cur (e cdr)))))
  (return null))

; Record what one import form bound in the file that wrote it. `prefix` is null
; for a flattening `import-use`/`import-only`. Idempotent on (prefix, path) — a
; file may write the same import twice, and `do-import`'s own dedup returns
; before the load without reaching here a second time anyway.
;
; Stage 15 B2b: `private` is read from `g-import-include-private` rather than
; passed, because that global IS the answer at exactly this moment —
; `emit-unsafe-import-private` sets it around its `do-import` call and restores
; it after. Resolution happens much later, so the binding has to carry it.
(defn file-import-record (prefix:ptr path:ptr):void
  (when (= g-file-imports null)
    (set! g-file-imports (vector-new-in (addr-of g-arena-alloc))))
  (let (tbl:(ref (Vector (ref ImportBind))) (unsafe/cast (ref (Vector (ref ImportBind))) g-file-imports))
    (dotimes (i (unsafe/cast i32 (count tbl)))
      (let (e:ref:ImportBind (invoke tbl (as usize i)))
        ; Stage 15 B3′: the dedup compares CONTENT, not pointers. B1 could get
        ; away with identity because `do-import` was the only writer and reached
        ; each form once; `prescan-file-imports` now records the same form
        ; earlier, and `resolve-import` is documented to hand back a fresh buffer
        ; per call — so an identity dedup would stack a duplicate per import.
        (when (and (or (and (= (e prefix) null) (= prefix null))
                       (and (and (!= (e prefix) null) (!= prefix null))
                            (= (strcmp (e prefix) prefix) 0)))
                   (and (and (!= (e path) null) (!= path null))
                        (= (strcmp (e path) path) 0)))
          ; `private` is read from a TRANSIENT global (`g-import-include-private`,
          ; set only around `unsafe/import-private`'s own `do-import` call), so
          ; the prescan records the bind with it OFF and emission arrives later
          ; with it ON. Upgrade rather than ignore, or a private prefixed import
          ; loses its permission to the earlier record.
          (when (!= g-import-include-private 0) (.set! e private 1))
          (return))))
    (let (rec:ref:ImportBind (new ImportBind))
      (.set! rec prefix prefix)
      (.set! rec path path)
      (.set! rec private g-import-include-private)
      (conj tbl rec))))

; The prefixes bound in this file, comma-separated, or null when it binds none.
; Diagnostic-only, so the quadratic concatenation is fine (and `fmt-2s` clamps).
(defn file-prefixes-in-scope ():ptr
  (when (= g-file-imports null) (return null))
  (let (out:ptr null
        tbl:(ref (Vector (ref ImportBind))) (unsafe/cast (ref (Vector (ref ImportBind))) g-file-imports))
    (dotimes (i (unsafe/cast i32 (count tbl)))
      (let (e:ref:ImportBind (invoke tbl (as usize i)))
        (when (!= (e prefix) null)
          (if (= out null)
            (set! out (e prefix))
            (set! out (fmt-2s "%s, %s" (as CStr out) (as CStr (e prefix))))))))
    (return out)))

; ============================================================
; Stage 15 B2a — the canonicaliser
; (design/stage15-stress-test/name-resolution.md §5.2 B2, §8.3, §12.1 step 1).
;
; ONE function maps a source *reference* to the registry key it denotes:
; `resolve-spelling` splits at the first interior slash (`qualify-name`'s rule,
; unchanged) and resolves the qualifier **only** through the file's import
; environment (B1's `g-file-imports`) — never against a global list of
; namespaces, which is precisely what let `dp/Describe` reach a library the
; consumer imported as `dpx` (§2.1).
;
; §8.3's table, as implemented here:
;   * `(import-prefixed lib p)` binds `p/` and NOT the library's namespace;
;   * `(import-use lib)` / `(import-only lib …)` flatten, and the namespace's own
;     name is also a legal qualifier — R2's escape hatch for a collision;
;   * the file's own namespace is always a legal qualifier (a file may spell its
;     own names either way, and `lib/nsdescribe.nuc`'s bare self-reference is the
;     same rule with the qualifier omitted);
;   * `user` is always legal: the prelude is flattened into every file, and
;     `user` is the unqualified space itself.
; Anything else is NR-UNBOUND — a hard "not in scope here", *not* a fall-through
; to the raw spelling.
;
; This is the reference side only. A key already canonical — a stored
; `Constraint.proto`, a `(dyn P)` box's protocol, a super-protocol edge, a
; `.nuch` replay — is NOT a reference and must not come through here: it is
; looked up exactly (`protocol-lookup-ns` / `protocol-lookup-exact`). The two
; questions are genuinely different — "may this file name it?" versus "what does
; this key denote?" — and conflating them is what made the defect expressible.
; ============================================================

; (`NR-BARE` / `NR-QUALIFIED` / `NR-UNBOUND` and `NameRef` live in
; src/compiler-types.nuc, with the rest of the shared tags.)

; The namespace recorded for a source path, or null when none was — which means
; `user`, since a file with no `(ns …)` never reaches `emit-ns`. Content
; comparison: `resolve-import` may hand back a fresh buffer per call, so the
; pointer-identity idiom `import-list-find` uses is not safe here.
(defn file-ns-of (path:ptr):ptr
  (let (cur:ptr g-file-ns)
    (while (!= cur null)
      (let (e:ptr:Node (unsafe/cast ptr:Node cur))
        (when (= (strcmp (e s) path) 0) (return (as ptr (e car))))
        (set! cur (e cdr)))))
  (return null))

; Record (or re-record) a file's namespace. Called from `emit-ns` only, so a
; second `ns` directive in one file updates rather than shadows.
(defn file-ns-record (path:ptr ns:ptr):void
  (when (= path null) (return))
  (let (cur:ptr g-file-ns)
    (while (!= cur null)
      (let (e:ptr:Node (unsafe/cast ptr:Node cur))
        (when (= (strcmp (e s) path) 0)
          (.set! e car ns)
          (return))
        (set! cur (e cdr)))))
  (let (n:ref:Node (new Node))
    (.set! n kind NODE-STR)
    (.set! n line 0)
    (.set! n i 0)
    (.set! n s path)
    (.set! n car ns)
    (.set! n cdr g-file-ns)
    (set! g-file-ns (as ptr n))))

; The registry key for `bare` in namespace `ns` — the composition `qualify-name`
; performs for the *current* namespace, factored out so another namespace can be
; named. `user` stores bare keys (the byte-identical hatch), so this is the
; identity there. Interned, because every registry key compares by pointer.
(defn ns-qualify-in (ns:ptr bare:ptr):ptr
  (when (= (strcmp ns "user") 0) (return (intern-str bare)))
  (return (intern-str (fmt-2s "%s/%s" ns bare))))

; The namespace of an imported file: its recorded `(ns …)`, or `user` when it
; declared none (which is why absence of a record is an answer, not a gap).
(defn import-path-ns (path:ptr):ptr
  (when (= path null) (return (intern-str "user")))
  (let (ns:ptr (file-ns-of path))
    (when (= ns null) (return (intern-str "user")))
    (return ns)))

; The file this file bound `spelling`'s qualifier to as a PREFIX, or null.
; (B1's `file-prefix-bound` answers the yes/no; B2a needs the path, because the
; path is what names the namespace.)
(defn file-prefix-path (spelling:ptr n:i64):ptr
  (when (= g-file-imports null) (return null))
  (let (tbl:(ref (Vector (ref ImportBind))) (unsafe/cast (ref (Vector (ref ImportBind))) g-file-imports))
    (dotimes (i (unsafe/cast i32 (count tbl)))
      (let (e:ref:ImportBind (invoke tbl (as usize i)))
        (when (and (!= (e prefix) null) (!= (qualifier-eq spelling (e prefix) n) 0))
          (return (e path))))))
  (return null))

; The file this file bound `spelling`'s qualifier to as a PRIVATE prefix — i.e.
; through `unsafe/import-private`, the one form that asks for the imported file's
; file-private names as well as its public ones. Null for every other binding.
(defn file-prefix-private-path (spelling:ptr n:i64):ptr
  (when (= g-file-imports null) (return null))
  (let (tbl:(ref (Vector (ref ImportBind))) (unsafe/cast (ref (Vector (ref ImportBind))) g-file-imports))
    (dotimes (i (unsafe/cast i32 (count tbl)))
      (let (e:ref:ImportBind (invoke tbl (as usize i)))
        (when (and (!= (e prefix) null) (!= (e private) 0)
                   (!= (qualifier-eq spelling (e prefix) n) 0))
          (return (e path))))))
  (return null))

; How many import forms this file wrote — the iteration bound for the flattened
; set. Paired with `file-flattened-ns-at`, which answers null for a prefixed one.
(defn file-imports-count ():i32
  (when (= g-file-imports null) (return 0))
  (let (tbl:(ref (Vector (ref ImportBind))) (unsafe/cast (ref (Vector (ref ImportBind))) g-file-imports))
    (return (unsafe/cast i32 (count tbl)))))

; The namespace flattened by import form `i`, or null when that form bound a
; prefix instead (a prefixed import flattens nothing — §8.3 row 2, the whole
; point of the fix).
(defn file-flattened-ns-at (i:i32):ptr
  (when (= g-file-imports null) (return null))
  (let (tbl:(ref (Vector (ref ImportBind))) (unsafe/cast (ref (Vector (ref ImportBind))) g-file-imports))
    (when (>= i (unsafe/cast i32 (count tbl))) (return null))
    (let (e:ref:ImportBind (invoke tbl (as usize i)))
      (when (!= (e prefix) null) (return null))
      (return (import-path-ns (e path))))))

; Stage 15 B5: does this file flatten the namespace `ns` (given whole, not as a
; qualifier prefix of a longer spelling)?
(defn file-flattens-ns-named (ns:CStr):i32
  (dotimes (i (file-imports-count))
    (let (f:ptr (file-flattened-ns-at i))
      (when (and (!= f null) (= (strcmp (as CStr f) ns) 0)) (return 1))))
  (return 0))

; Stage 15 B5: a prefix this file bound whose library lives in namespace `ns`,
; or null. The inverse of `file-prefix-path` → `import-path-ns`, and the reason
; a did-you-mean can offer `zx/zfun` instead of echoing `zfun`.
(defn file-prefix-for-ns (ns:CStr):ptr
  (when (= g-file-imports null) (return null))
  (let (tbl:(ref (Vector (ref ImportBind))) (unsafe/cast (ref (Vector (ref ImportBind))) g-file-imports))
    (dotimes (i (unsafe/cast i32 (count tbl)))
      (let (e:ref:ImportBind (invoke tbl (as usize i)))
        (when (!= (e prefix) null)
          (let (pns:ptr (import-path-ns (e path)))
            (when (and (!= pns null) (= (strcmp (as CStr pns) ns) 0))
              (return (e prefix))))))))
  (return null))

; Does this file flatten a namespace spelled by `spelling`'s qualifier?
(defn file-flattens-ns (spelling:ptr n:i64):i32
  (dotimes (i (file-imports-count))
    (let (ns:ptr (file-flattened-ns-at i))
      (when (and (!= ns null) (!= (qualifier-eq spelling ns n) 0)) (return 1))))
  (return 0))

; THE canonicaliser. See the section header for the rules.
(defn resolve-spelling (spelling:ptr):ref:NameRef
  (let (r:ref:NameRef (new NameRef))
    (.set! r spelling spelling)
    (.set! r qual null)
    (.set! r bare spelling)
    (.set! r ns null)
    (.set! r canonical null)
    (.set! r status NR-BARE)
    (let (n:i64 (qualifier-len spelling))
      ; Unqualified: the current namespace's key. The caller walks the flattened
      ; set itself, because the *probe* is per-registry and this is not.
      (when (<= n 0)
        (.set! r canonical (qualify-name spelling))
        (return r))
      (.set! r qual (arena-strndup spelling n))
      (.set! r bare (intern-str (arena-strdup (unsafe/ptr+ (as ptr:i8 spelling) (+ n 1)))))
      (.set! r status NR-UNBOUND)
      (cond
        ; A file may always name its own namespace, qualified or not.
        (= (strcmp (r qual) g-current-ns) 0)
          (.set! r ns g-current-ns)
        ; `user` is the unqualified space and the prelude's namespace; it is
        ; flattened into every file by construction.
        (= (strcmp (r qual) "user") 0)
          (.set! r ns (intern-str "user"))
        ; Stage 15 B2b (§8.3's last row): `unsafe` is a BUILT-IN namespace, bound
        ; as an implicit prefix in every file's environment. Bound *prefixed*, so
        ; it is never flattened — which is what makes bare `cast`/`ptr+`/
        ; `funcall-ptr-*` unreachable as a consequence of the binding rather than
        ; as seven hard-coded refusals (UN-5's intent). `(ns unsafe)` stays
        ; rejected because this binding pre-owns the name.
        (= (strcmp (r qual) "unsafe") 0)
          (.set! r ns (intern-str "unsafe"))
        true
          (let (p:ptr (file-prefix-path spelling n))
            (if (!= p null)
              (.set! r ns (import-path-ns p))
              (when (!= (file-flattens-ns spelling n) 0)
                (.set! r ns (intern-str (r qual)))))))
      (when (= (r ns) null) (return r))
      (.set! r status NR-QUALIFIED)
      (.set! r canonical (ns-qualify-in (r ns) (r bare)))
      (return r))))

; ------------------------------------------------------------
; Stage 15 B2b — globals cut over to the canonicaliser
; (name-resolution.md §9, the B2b row; §12.1 step 2 for `g-globals`).
;
; This is the REFERENCE half of `scope-lookup`'s global-scope resolution; the
; KEY half is `scope-lookup-key` (src/scope.nuc), which keeps the pre-B1 body
; verbatim. The split is the per-kind work B2a's §9.2 flagged, and it is a
; property of where the *string* came from, not of the registry: a name written
; in the file being compiled is resolved through that file's import environment,
; while a key this compiler itself computed and is about to write (or has
; written) into `g-globals` must be looked up exactly.
;
; What replaced `inject-import-aliases`: a prefixed import no longer copies the
; imported slice under a second `prefix/name` key. The prefix names a *file*, the
; file names a *namespace*, and the namespace composes the key the library
; already registered. That deletes the two accidental filters the copy carried —
; `is-local` (every `defvar` sets it) and a null `ir-name` (every `defconst` and
; enum member) — which is §1.1 defect #2 closing by deletion rather than by fix.
; The one filter that was NOT accidental, `sym-private`, becomes a resolution
; rule here instead: privacy is checked at the reference, where the binding that
; asked for it (`ImportBind.private`) is still available.
; ------------------------------------------------------------

; Resolve a source REFERENCE against the global scope. `sc` is the global frame
; (the unique null-parent Scope); `name` is the spelling as written.
(defn globals-lookup-ref (sc:raw:Scope name:CStr):?ptr:Sym
  (let (n:i64 (qualifier-len name))
    (when (<= n 0)
      ; Unqualified: the current namespace's key — the pre-B2b rule, unchanged,
      ; and identity under `user`.
      (let (hit:?ptr:Sym (scope-frame-find sc (qualify-name (priv-key-use name))))
        (when (!= hit null) (return hit)))
      ; No file in this unit declared a namespace ⇒ every flattened namespace is
      ; `user`, `qualify-name` is the identity and the probes below are provably
      ; the same scan that just missed. Every build of this compiler, and every
      ; program in `lib/`, takes this exit — which is what makes the addition
      ; below inert on emitted IR rather than merely believed to be.
      (when (= g-ns-declared 0) (return null))
      ; §8.3 row 1: `import-use`/`import-only` flatten the imported namespace
      ; into the unqualified space. Public names only — a flattened namespace is
      ; someone else's file.
      (dotimes (i (file-imports-count))
        (let (fns:ptr (file-flattened-ns-at i))
          (when (and (!= fns null) (!= (strcmp fns g-current-ns) 0))
            (let (hit:?ptr:Sym (scope-frame-find-public sc (ns-qualify-in fns name)))
              (when (!= hit null) (return hit))))))
      ; And `user` last: it is the unqualified space itself and the prelude's
      ; namespace, flattened into every file by construction. Without this a file
      ; with an explicit `(ns …)` cannot name `default-allocator` or `printf` at
      ; all — the "global-resolution gap" lib/nsdescribe.nuc's header records.
      (when (!= (strcmp g-current-ns "user") 0)
        (return (scope-frame-find-public sc (intern-str name))))
      (return null))
    ; Qualified: the file's import environment is the only authority (R3).
    (let (r:ref:NameRef (resolve-spelling name))
      (when (= (r status) NR-UNBOUND) (return null))
      (let (hit:?ptr:Sym null)
        ; A file naming its own namespace sees its own private names; a name
        ; reached through anyone else's does not.
        (if (= (strcmp (r ns) g-current-ns) 0)
          (set! hit (scope-frame-find sc (r canonical)))
          (set! hit (scope-frame-find-public sc (r canonical))))
        (when (!= hit null) (return hit)))
      ; `unsafe/import-private` additionally reaches the imported file's
      ; file-private key space (`#pN/name`), which is the whole of what
      ; `g-import-include-private` used to buy in `inject-import-aliases`.
      ; Deliberately NOT inside the else-branch above: an imported file with no
      ; `(ns …)` is in `user`, so when the importer is also in `user` the two
      ; namespaces compare equal and the public probe above is the *first* one,
      ; not the only one. That is the ordinary case, not a corner.
      (let (pp:ptr (file-prefix-private-path name n))
        (when (= pp null) (return null))
        (let (pns:ptr (priv-ns-of-path pp))
          (when (= pns null) (return null))
          (return (scope-frame-find sc (ns-qualify-in pns (r bare)))))))))

; ------------------------------------------------------------
; Stage 15 B3′ — the candidate-key policy, shared by the type registries
; (name-resolution.md §8.1 step 1).
;
; B2b measured that only ~2 lines of `globals-lookup-ref` are registry-specific
; (scan this frame for this key); everything else is *policy* — which keys to try
; and in what order — and that policy is identical across kinds. So the six type
; registries do not each grow their own copy of it: they walk this key sequence
; and probe their own table with each key.
;
; The sequence, for an unqualified spelling, is exactly `globals-lookup-ref`'s:
;   0            the current namespace's key (the pre-B3′ rule, and the identity
;                under `user` — this is the ONLY probe when the unit declares no
;                namespace, which is what makes B3′ byte-identical for the tree);
;   1..n         each namespace an `import-use`/`import-only` in this file
;                flattened (a prefixed import flattens nothing — §8.3 row 2);
;   n+1          `user`, the unqualified space and the prelude's namespace. A
;                namespaced file must still be able to name `StrView`, `Maybe`,
;                `Node` and every C-header type, all of which key bare.
; For a QUALIFIED spelling the file's import environment is the only authority
; (R3): `resolve-spelling` answers one key, or none at all — which is defect #4
; (`nope/Zs`) and defect #3 (`zn/Zs` from a file that imported the library under
; a prefix) closing together.
; ------------------------------------------------------------

; How many keys `spelling` may denote here. 0 means "this file cannot name it".
(defn name-ref-key-count (spelling:CStr):i32
  (when (> (qualifier-len (as ptr spelling)) 0)
    (when (= ((resolve-spelling (as ptr spelling)) status) NR-UNBOUND) (return 0))
    (return 1))
  (when (= g-ns-declared 0) (return 1))
  (return (+ (file-imports-count) 2)))

; The i-th candidate key, or null for a slot that names nothing (a prefixed
; import flattens no namespace, so its slot is empty).
(defn name-ref-key-at (spelling:CStr i:i32):CStr
  (when (> (qualifier-len (as ptr spelling)) 0)
    (let (r:ref:NameRef (resolve-spelling (as ptr spelling)))
      (when (= (r status) NR-UNBOUND) (return null))
      (return (as CStr (r canonical)))))
  (when (= i 0) (return (as CStr (qualify-name (as ptr spelling)))))
  (let (n:i32 (file-imports-count))
    (when (<= i n)
      (let (fns:ptr (file-flattened-ns-at (- i 1)))
        (when (= fns null) (return null))
        ; The current namespace was slot 0; re-probing it here would be a second
        ; identical scan.
        (when (= (strcmp fns g-current-ns) 0) (return null))
        (return (as CStr (ns-qualify-in fns (as ptr spelling)))))))
  (when (= (strcmp g-current-ns "user") 0) (return null))
  (return (as CStr (intern-str spelling))))

; The qualifiers legal in this file, comma-separated, or null when it has none
; beyond `user`: every bound prefix, every flattened non-`user` namespace, and
; the file's own namespace. Diagnostic-only.
(defn file-qualifiers-in-scope ():ptr
  (let (out:ptr null)
    (when (!= (strcmp g-current-ns "user") 0)
      (set! out g-current-ns))
    (dotimes (i (file-imports-count))
      (let (ns:ptr (file-flattened-ns-at i))
        (when (and (!= ns null) (!= (strcmp ns "user") 0))
          (if (= out null)
            (set! out ns)
            (set! out (fmt-2s "%s, %s" (as CStr out) (as CStr ns)))))))
    (let (pre:ptr (file-prefixes-in-scope))
      (when (!= pre null)
        (if (= out null)
          (set! out pre)
          (set! out (fmt-2s "%s, %s" (as CStr out) (as CStr pre))))))
    (return out)))

; The note that turns a bare "unknown X" into a SCOPE diagnostic: null when
; `spelling` is unqualified or its qualifier is in scope, else prose naming the
; qualifier and what this file can actually spell.
;
; A name that is defined, reachable, and one import line away must not be
; reported as "unknown", full stop.
;
; Stage 15 B2b folded B1's `unbound-prefix-message` in here, because B1's gate
; (`prefix-out-of-scope`) and B2a's resolver had started to DISAGREE: with
; globals still on the narrow gate, a file that `import-use`s a namespaced
; library could name its protocols by namespace but was refused `geom/area`.
; One gate (`resolve-spelling`) now decides, and this is the one place that
; explains it — with two tiers, because "another file in this unit binds that
; prefix" is strictly more actionable than the general rule and naming the file
; is the whole fix.
(defn qualifier-scope-note (spelling:ptr):ptr
  (let (n:i64 (qualifier-len spelling))
    (when (<= n 0) (return null))
    (let (r:ref:NameRef (resolve-spelling spelling))
      (when (!= (r status) NR-UNBOUND) (return null))
      (let (tail:ptr "This file has no import qualifiers in scope."
            inscope:ptr (file-qualifiers-in-scope))
        (when (!= inscope null)
          (set! tail (fmt-s "In scope here: %s." (as CStr inscope))))
        ; Tier 1 (was B1's `unbound-prefix-message`): some OTHER file in this
        ; unit binds this qualifier as an import prefix. Cannot collide with
        ; W1d's cycle tier — that one fires for a prefix the file DID declare,
        ; for which `resolve-spelling` returns NR-QUALIFIED and this returns null.
        (let (path:ptr (unit-prefix-path spelling n))
          (when (!= path null)
            (return
              (fmt-3s "  note: an import prefix is file-scoped: another file in this unit binds '%s' to %s, but a prefix reaches only the file whose own import declares it. %s"
                      (as CStr (r qual)) (as CStr path) (as CStr tail)))))
        ; Tier 2: the general rule.
        (return
          (fmt-2s "  note: '%s' is not in scope in this file — a prefixed import binds its library under the prefix it names and not under the library's own namespace, and an unimported namespace is not nameable at all. %s"
                  (as CStr (r qual)) (as CStr tail)))))))

; Append `qualifier-scope-note` to a diagnostic head, when there is one to
; append. Every raise about an unresolved *reference* should go through this:
; the head says what failed, the note says why the spelling could not reach it.
(defn with-qualifier-note (head:ptr spelling:ptr):ptr
  (let (note:ptr (qualifier-scope-note spelling))
    (when (= note null) (return head))
    (return (fmt-2s "%s\n%s" (as CStr head) (as CStr note)))))

; Stage 15 W9 defect 21: the PROTOCOL half of what `strip-ns-qualifier` used to
; do for both halves. Map a protocol *reference* (any source spelling) to the
; canonical registry key of the protocol it names — i.e. that Protocol's own
; `name`, which `protocol-new` set from `qualify-name`. Every registry that keys
; on a protocol (the conformance registry, the super-protocol edges, `&where`
; constraint records, `(dyn P)`'s box type) canonicalizes through this, so an
; `extend` site and a dispatch site land on the same key no matter which
; namespace each was written in.
;
; A spelling that names no registered protocol is returned UNCHANGED, and that
; is load-bearing in three ways: the blanket protocol names (`Any`, `Struct`,
; `Clone` before the prelude is reached) and the structural bound `Valid` live
; outside `g-protocols` and must keep their bare spelling; a diagnostic about an
; undeclared protocol must quote what the author actually wrote; and a reference
; parsed before its protocol is registered degrades to the raw spelling, which
; every consumer re-canonicalizes later (this function is idempotent on a
; canonical key, so double application is free).
;
; Lives here rather than beside `protocol-lookup` in generics.nuc because
; union-registry.nuc — imported *before* generics.nuc — needs it for `dyn-type`.
; The ordinal import rule allows a module to call *up* into nucleusc.nuc
; (`prescan-defn-signatures` registers every nucleusc.nuc signature before any
; form is emitted); union-registry.nuc already up-calls `intern-str` and
; `guard-name-kind` this way. This function's own body sits well below
; `(import-use generics)`, so `protocol-lookup` resolves for it.
; Stage 15 B2a: `protocol-lookup` is now the REFERENCE resolver, so this
; canonicalizes through the file's import environment (§8.3). The
; "unregistered → unchanged" contract above now covers a second case —
; a qualifier that is not in scope here — and it is the same answer for the
; same reason: this function must never invent a resolution the file cannot
; spell. Note the consequence for the registries that call it on an ALREADY
; canonical key (`conformance-lookup`, `proto-super-add`): the key passes through
; unchanged, which is exactly right, because a canonical key is already the
; answer. What must *not* be done is to hand such a key onward to a lookup that
; re-resolves it as a reference — see `protocol-lookup-ns`.
(defn protocol-canon-name (spelling:CStr):CStr
  (let (p:?ptr:Protocol (protocol-lookup spelling))
    (when (= p null) (return spelling))
    (return (-> p (as ptr:Protocol _) (_ name)))))

; Stage 15 B6 — the `(dyn P)` box's IDENTITY key (name-resolution.md §9.5), and
; the one caller is `dyn-type`. B2a keyed it on `protocol-canon-name-ns`, which
; resolved by namespace alone and therefore could not map an import *prefix* to a
; namespace: `(dyn Describe)` inside `(ns dp)` keyed `dp/Describe` while
; `(dyn dpx/Describe)` outside it keyed `dpx/Describe`, so one protocol got two
; box `StructDef`s and — `type-eq` being StructDef-pointer identity — a library
; taking the first could not be called with the second.
;
; The constraint that shaped B2a is unchanged and is why this resolves through
; the ENVIRONMENT rather than through the registry: `dyn-type` runs from a `defn`
; signature during `prescan-defn-signatures`, where an *imported* protocol is not
; registered yet, and again from the same signature at emission, where it is. A
; key that consulted `g-protocols` for those spellings would differ between the
; two moments and mint two StructDefs for one protocol — W9 defect 21 in a new
; shape. `resolve-spelling` consults only `g-file-imports` and `g-file-ns`, both
; filled for the whole reachable graph before any prescan that resolves a name
; (`prescan-file-imports`, `prescan-imported-types`), so it answers identically in
; both phases.
;
;   * NR-QUALIFIED — the qualifier resolved here, so the canonical key is the
;     answer, and every legal spelling of one protocol produces the same one.
;   * NR-BARE — the current namespace's key when this file's OWN namespace
;     declares it, else the bare spelling. The registry probe is `-exact` and on
;     `qualify-name`'s key only, which is phase-stable for a different reason:
;     a file's own protocols are registered by `prescan-protocols` before its own
;     `prescan-defn-signatures`, in every prescan and at emission. This
;     reproduces `protocol-canon-name-ns`'s answer for every bare spelling, so
;     every namespace-free program keys byte-identically.
;   * NR-UNBOUND — verbatim. In a `g-type-key-ok` synthesis region that string
;     already IS the canonical key; outside one it is a scope error, reported by
;     the deferred annotation check (`dyn-annot-record`) rather than here.
;
; The scope question — may THIS file name this protocol? — is deliberately not
; asked here. Identity and admission need different data; admission is asked at
; the annotation site, where the spelling the author wrote still exists.
(defn dyn-proto-key (spelling:CStr):CStr
  (let (r:ref:NameRef (resolve-spelling (as ptr spelling)))
    (when (= (r status) NR-UNBOUND) (return spelling))
    (when (= (r status) NR-QUALIFIED) (return (as CStr (r canonical))))
    (when (!= (protocol-lookup-exact (as CStr (r canonical))) null)
      (return (as CStr (r canonical))))
    (return spelling)))

; Stage 15 B3′: the TYPE half's canonicalizer — the exact counterpart of
; `protocol-canon-name`, and what replaced Stage 12 N4's `strip-ns-qualifier` in
; the conformance registry. A conformance key's type half arrives from two
; provenances and this answers both idempotently:
;
;   * a SOURCE spelling (`extend`'s subject, `Cat` or `dpx/Fox`) resolves through
;     the file's import environment and yields the StructDef's canonical name;
;   * an already-canonical name (`type-spelling` at a dispatch site, a stored
;     conformance arg, a `.nuch` replay) is looked up as a KEY and yields itself.
;
; A spelling that names no registered type — `i32`, `ptr:Node`, a blanket
; protocol, a tyvar, a template application — passes through UNCHANGED, which is
; what keeps the primitive and structural conformance keys working. Identity for
; every `user` type, so every existing conformance key is byte-identical.
(defn type-canon-name (spelling:CStr):CStr
  (let (sd:?ptr:StructDef (struct-lookup-ref spelling))
    (when (!= sd null) (return (-> sd (as ptr:StructDef _) (_ name))))
    (let (sd2:?ptr:StructDef (lookup-struct (intern-str spelling)))
      (when (!= sd2 null) (return (-> sd2 (as ptr:StructDef _) (_ name)))))
    (return spelling)))

; Stage 12 N4: IR mangling (design/stage12/namespaces.md §"Implementation",
; decision 7). A namespace's source name (or a `set-ir-prefix` override) lowers to
; a deterministic, C-legal IR prefix. The qualified-name divider `/` is not a legal
; LLVM/C identifier character, so it is lowered to the double-underscore `__`
; separator (`lib/string` → `lib__string`), and any other illegal char follows the
; ordinary sanitize-for-ir mapping. The result composes *before* the existing
; method/instance mangling, so an overloaded `foo/bar` becomes `foo__bar.tok.tok`.
(defn ns-prefix-sanitize (prefix:ptr):ptr
  (let (n:i64 (strlen prefix)
        ; Worst case every char becomes `__` (2 bytes), plus the NUL.
        s:ptr (arena-alloc (+ (* n 2) 1))
        o:i64 0)
    (dotimes (i n)
      (let (c:i32 (bit-and (as i32 (aref (as ptr:i8 prefix) i)) 255)
            is-digit:i1 (!= (isdigit c) 0)
            is-lower:i1 (and (>= c 97) (<= c 122))
            is-upper:i1 (and (>= c 65) (<= c 90))
            is-safe:i1  (or (= c 95) (= c 46))
            ok:i1       (or is-digit is-lower is-upper is-safe))
        (cond
          ; The namespace divider lowers to the `__` separator.
          (= c 47)
            (do (aset! (as ptr:i8 s) o 95)
                (aset! (as ptr:i8 s) (+ o 1) 95)
                (set! o (+ o 2)))
          ok
            (do (aset! (as ptr:i8 s) o (unsafe/cast i8 c)) (set! o (+ o 1)))
          true
            (do (aset! (as ptr:i8 s) o 95) (set! o (+ o 1))))))
    (aset! (as ptr:i8 s) o 0)
    (return s)))

; Record `prefix` (already sanitized + interned) as the ir-prefix for the
; (interned) namespace `ns`. Set by `set-ir-prefix`. Keys compare by pointer
; identity; a re-set overwrites the prior value (REPL re-entry, second directive).
(defn ns-ir-prefix-set (ns:ptr prefix:ptr):void
  (when (= g-ns-prefix-table null)
    (set! g-ns-prefix-table (vector-new-in (addr-of g-arena-alloc))))
  (let (tbl:(ref (Vector (ref NsPrefixEntry))) (unsafe/cast (ref (Vector (ref NsPrefixEntry))) g-ns-prefix-table))
    (dotimes (i (unsafe/cast i32 (count tbl)))
      (let (e:ref:NsPrefixEntry (invoke tbl (as usize i)))
        (when (= (e ns) ns)
          (.set! e prefix prefix)
          (return))))
    (let (rec:ref:NsPrefixEntry (new NsPrefixEntry))
      (.set! rec ns ns)
      (.set! rec prefix prefix)
      (conj tbl rec))))

; The recorded ir-prefix for (interned) namespace `ns`, or null if none was set.
(defn ns-ir-prefix-get (ns:ptr):ptr
  (when (= g-ns-prefix-table null) (return null))
  (let (tbl:(ref (Vector (ref NsPrefixEntry))) (unsafe/cast (ref (Vector (ref NsPrefixEntry))) g-ns-prefix-table))
    (dotimes (i (unsafe/cast i32 (count tbl)))
      (let (e:ref:NsPrefixEntry (invoke tbl (as usize i)))
        (when (= (e ns) ns) (return (e prefix))))))
  (return null))

; Stage 14 AVR-5 (design/stage14/avr-targets.md §5 AVR-5): record LLVM string
; function attribute `attr` for the (interned) source function name `name`, as set
; by `(fn-attr …)`. Every attribute is a fresh entry — a function may carry several
; (accumulated from one `fn-attr` with several strings, or several `fn-attr`s on the
; same name); emit-fn-attrs-for collects all matching entries. Lazily constructs the
; table (the §14.5 small-table idiom, mirroring ns-ir-prefix-set) from the shared
; arena, never dropped (process-lifetime).
(defn fn-attr-add (name:ptr attr:ptr):void
  (when (= g-fn-attr-table null)
    (set! g-fn-attr-table (vector-new-in (addr-of g-arena-alloc))))
  (let (tbl:(ref (Vector (ref FnAttrEntry))) (unsafe/cast (ref (Vector (ref FnAttrEntry))) g-fn-attr-table))
    (let (rec:ref:FnAttrEntry (new FnAttrEntry))
      (.set! rec name name)
      (.set! rec attr attr)
      (conj tbl rec))))

; Stage 14 AVR-5: append every recorded string attribute for the (interned) source
; function name `fname` to g-out — the inline function-attribute suffix on a
; `define` line, each as a space-prefixed quoted string (e.g. ` "signal"`). LLVM
; textual IR accepts string attributes directly after the parameter list; the
; shared `attributes #N = {…}` group is only needed to share a set across
; functions. Emits nothing (a pure no-op) when the function has no fn-attr entries
; — so a program that never uses `fn-attr` is byte-identical. Matches by the
; SOURCE name (the name `fn-attr` was called with), which in the default `user`
; namespace equals the emitted @-symbol, so no ir-name mangling is involved.
(defn emit-fn-attrs-for (fname:ptr):void
  (when (= g-fn-attr-table null) (return))
  (let (tbl:(ref (Vector (ref FnAttrEntry))) (unsafe/cast (ref (Vector (ref FnAttrEntry))) g-fn-attr-table))
    (dotimes (i (unsafe/cast i32 (count tbl)))
      (let (e:ref:FnAttrEntry (invoke tbl (as usize i)))
        (when (= (e name) fname)
          (fprintf g-out " \"%s\"" (e attr)))))))

; The effective ir-prefix for namespace `ns` (decision 7):
;   - `user`            → empty string (bare ir-names; the byte-identical hatch);
;   - an explicit `set-ir-prefix` entry → that value (which may itself be empty,
;     forcing bare names for a non-`user` namespace);
;   - otherwise          → the namespace name itself, sanitized to a C-legal prefix.
; Returns "" (empty) for the bare cases so a single empty-test gates the whole
; mangling at the production sites.
(defn ns-ir-prefix (ns:ptr):ptr
  (when (= (strcmp ns "user") 0) (return ""))
  (let (p:ptr (ns-ir-prefix-get ns))
    (when (!= p null) (return p))
    (return (ns-prefix-sanitize ns))))

; Compose an explicit ir-prefix string onto a (bare, already-tokenized) base —
; `<prefix>__<base>`, or bare `base` when the prefix is empty. The atomic
; namespace-mangling primitive: it runs BEFORE the per-parameter `.tok` method
; mangling, so an overloaded `foo/bar` becomes `foo__bar.tok.tok`. Threading the
; prefix explicitly (rather than reading g-current-ns) lets a generic carry the
; prefix of its *defining* namespace, so a monomorphization stamped while another
; namespace is current still mangles correctly.
(defn ns-compose (prefix:ptr base:ptr):ptr
  (when (= (char-at prefix 0) 0) (return base))
  (return (fmt-2s "%s__%s" prefix base)))

; Compose the *current* namespace's ir-prefix onto a bare source name. Used at the
; solitary-defn / defvar production sites (and the symmetric `.nuch` import /
; cheader name derivation), where the symbol is always defined in the current
; namespace. The bare name is first run through ir-name-token so `?`/`!` become
; `_QMARK`/`_BANG` — the single chokepoint that gives defvar globals, extern
; re-resolves, and solitary `.nuch` imports the same IR-legal symbol the defn
; emits. Identity under `user` (empty prefix) and for any name without `?`/`!`
; (ir-name-token returns it unchanged) → byte-identical bootstrap.
(defn ns-ir-base (name:ptr):ptr
  (return (ns-compose (ns-ir-prefix g-current-ns) (ir-name-token name))))

; ============================================================
; Stage 15 W5e — file-scoped private names
; (design/stage15-stress-test/ergonomics.md §W5e)
; ============================================================
;
; A private definer (`defn-`/`defvar-`/`defconst-`/`defenum-`) means "private to
; a namespace", and every file that declares no `(ns …)` shares the single `user`
; namespace — so two files privately defining `helper` collided. W5e gives each
; such file an *implicit* namespace of its own, used ONLY for the names its
; private definers introduce: `helper` in `a.nuc` is keyed `#p1/helper` and in
; `b.nuc` `#p2/helper`, while every public name in both files stays bare.
;
; The whole mechanism is expressed in the Stage 12 namespace vocabulary rather
; than beside it: the key is an ordinary `<ns>/<name>` spelling, so `qualify-name`
; is idempotent on it, `strip-ns-qualifier` recovers the bare name (which is what
; makes `import-alias-one` correct for free), and the synthetic namespace's
; registered ir-prefix flows through `ns-compose`/`mangle-fn-name` unchanged.
;
; A file with an explicit `(ns …)` is deliberately NOT given a private namespace:
; there, `defn-` already means "private to *this* namespace", which is a real,
; user-chosen scope. Two files in one explicit namespace still collide, and the
; duplicate-signature diagnostic says so.
;
; Everything below short-circuits on `g-priv-files == null` — no private definer
; anywhere in the unit — so a program that uses none (this compiler included)
; takes exactly the pre-W5e path and emits byte-identical IR.

; The synthetic namespace of a private key, or null if `name` is not one. A
; private key always begins `#p`; `#` cannot start a user namespace (emit-ns
; rejects it), so this test cannot misfire on a real qualified spelling.
(defn priv-qualifier-of (name:CStr):CStr
  (when (= (char-at name 0) 35) ; '#'
    (let (slash:ptr (strchr name 47))
      (when (!= slash null)
        (let (idx:i64 (- (unsafe/cast i64 (as ptr:i8 slash)) (unsafe/cast i64 (as ptr:i8 name)))
              after:i32 (as i32 (aref (as ptr:i8 slash) 1)))
          (when (and (> idx 0) (!= after 0))
            (return (intern-str (arena-strndup name idx))))))))
  (return null))

; `name` with any synthetic private qualifier removed; identity for every other
; spelling (including a real `geom/area`, whose qualifier must be preserved).
; Used wherever a private key has to be rendered back as the source name: the
; emitted IR symbol base and the duplicate-definition diagnostic.
(defn strip-priv-qualifier (name:CStr):CStr
  (when (= (as ptr (priv-qualifier-of name)) null) (return name))
  (return (strip-ns-qualifier name)))

; The PrivFile owning `path`, creating it (and its synthetic namespace + ir-prefix
; registration) on first use. The ir-prefix is `<basename>_pN` — readable in the
; emitted IR, and unique even when two directories hold the same basename because
; N is the 1-based creation order.
(defn priv-file-for-path (path:ptr):ref:PrivFile
  (when (= g-priv-files null)
    (set! g-priv-files (vector-new-in (addr-of g-arena-alloc))))
  (let (tbl:(ref (Vector (ref PrivFile))) (unsafe/cast (ref (Vector (ref PrivFile))) g-priv-files))
    (dotimes (i (unsafe/cast i32 (count tbl)))
      (let (pf:ref:PrivFile (invoke tbl (as usize i)))
        (when (= (strcmp (pf path) path) 0) (return pf))))
    (let (n:i32 (+ (unsafe/cast i32 (count tbl)) 1)
          base:ptr (path-basename-token path)
          pf:ref:PrivFile (new PrivFile))
      (.set! pf path (intern-str path))
      (.set! pf ns (intern-str (fmt-i32 "#p%d" n)))
      (.set! pf prefix (intern-str (fmt-sd "%s_p%d" base n)))
      (.set! pf names (vector-new-in (addr-of g-arena-alloc)))
      (ns-ir-prefix-set (pf ns) (pf prefix))
      (conj tbl pf)
      ; A path that previously answered "owns no private names" now owns some.
      (set! g-priv-cache-path null)
      (set! g-priv-cache null)
      (return pf))))

; The synthetic private namespace (`#pN`) already registered for `path`, or null.
; Stage 15 B2b: deliberately NON-creating, unlike `priv-file-for-path` above —
; this answers a *resolution* question ("does that file own private names?") and
; minting a namespace for a file that declared none would both allocate on a
; lookup path and make the answer stop being "no".
(defn priv-ns-of-path (path:ptr):ptr
  (when (= g-priv-files null) (return null))
  (let (tbl:(ref (Vector (ref PrivFile))) (unsafe/cast (ref (Vector (ref PrivFile))) g-priv-files))
    (dotimes (i (unsafe/cast i32 (count tbl)))
      (let (pf:ref:PrivFile (invoke tbl (as usize i)))
        (when (= (strcmp (pf path) path) 0) (return (pf ns))))))
  (return null))

; The file component of `path`, without directories or extension, sanitized to a
; C-legal identifier fragment. Only ever used to make an emitted symbol readable.
(defn path-basename-token (path:CStr):CStr
  (let (n:i64 (as i64 (strlen path))
        start:i64 0
        end:i64 n
        i:i64 0)
    ; Last '/' → start of the basename.
    (while (< i n)
      (when (= (char-at path i) 47) (set! start (+ i 1)))
      (inc! i))
    ; Last '.' at or after that → start of the extension. Scanning backwards and
    ; clamping j to `start` on the first hit ends the loop at the LAST dot.
    (let (j:i64 n)
      (while (> j start)
        (set! j (- j 1))
        (when (= (char-at path j) 46)
          (set! end j)
          (set! j start))))
    ; A dotfile or an empty basename leaves nothing to name it with; fall back to
    ; the whole path (sanitizing makes the separators legal).
    (when (<= end start) (set! start 0) (set! end n))
    (return (ns-prefix-sanitize (arena-strndup (unsafe/ptr+ (as ptr:i8 path) start)
                                               (- end start))))))

; The PrivFile of the file currently being processed, or null. Memoized on the
; `g-source-path` pointer: paths are arena-allocated once per file and never
; freed, so identity is a sound key, and the memo makes this a single compare on
; the hot lookup path.
(defn priv-file-current ():?ptr:PrivFile
  (when (= g-priv-files null) (return null))
  (when (= g-source-path null) (return null))
  (when (= g-priv-cache-path g-source-path) (return (as ptr g-priv-cache)))
  (let (tbl:(ref (Vector (ref PrivFile))) (unsafe/cast (ref (Vector (ref PrivFile))) g-priv-files)
        r:ptr null)
    (dotimes (i (unsafe/cast i32 (count tbl)))
      (let (pf:ref:PrivFile (invoke tbl (as usize i)))
        (when (= (strcmp (pf path) g-source-path) 0) (set! r (as ptr pf)))))
    (set! g-priv-cache-path g-source-path)
    (set! g-priv-cache (unsafe/cast (raw PrivFile) r))
    (return r)))

; The PrivFile a definer being registered *right now* belongs to, or null. Only a
; private definer in the default `user` namespace gets one: in an explicit
; namespace `defn-` already denotes a real, user-chosen private scope.
(defn priv-owner-file ():?ptr:PrivFile
  (when (= g-defining-private 0) (return null))
  (when (!= (strcmp g-current-ns "user") 0) (return null))
  (when (= g-source-path null) (return null))
  (return (as ptr (priv-file-for-path g-source-path))))

; DEFINE side: the key to register `name` under. When a private definer is active
; this declares `name` file-private (idempotently — the same defn is registered by
; both the signature prescan and `emit-defn`) and returns its file-scoped key;
; otherwise `name` is returned unchanged.
(defn priv-key-define (name:CStr):CStr
  (let (pf:?ptr:PrivFile (priv-owner-file))
    (when (= pf null) (return name))
    ; An already-qualified spelling (a re-registration of a key we produced, or a
    ; genuinely namespaced name) is left alone.
    (when (!= (strchr name 47) null) (return name))
    (let (p:ptr:PrivFile (unsafe/cast ptr:PrivFile pf))
      (dotimes (i (unsafe/cast i32 (count (p names))))
        (let (pn:ref:PrivName (invoke (p names) (as usize i)))
          (when (= (pn bare) name) (return (pn key)))))
      (let (pn:ref:PrivName (new PrivName))
        (.set! pn bare (intern-str name))
        (.set! pn key (intern-str (fmt-2s "%s/%s" (p ns) name)))
        (conj (p names) pn)
        (return (pn key))))))

; USE side: the key a reference to `name` from the file currently being processed
; resolves to — the file-scoped key when this file privately defines `name`
; (a file's own private definition shadows any public one elsewhere, exactly as a
; namespace-local name shadows an imported one), else `name` unchanged.
(defn priv-key-use (name:CStr):CStr
  (let (pf:?ptr:PrivFile (priv-file-current))
    (when (= pf null) (return name))
    (let (p:ptr:PrivFile (unsafe/cast ptr:PrivFile pf))
      (dotimes (i (unsafe/cast i32 (count (p names))))
        (let (pn:ref:PrivName (invoke (p names) (as usize i)))
          (when (= (pn bare) name) (return (pn key)))))
      (return name))))

; The IR base symbol for a definer's own name: `ns-ir-base`, except that a
; private definer in `user` composes its file's synthetic prefix instead, so
; `helper` in `a.nuc` emits `@a_p1__helper`. Identity (and therefore
; byte-identical) whenever no private definer is active.
(defn def-ir-base (name:ptr):ptr
  (let (pf:?ptr:PrivFile (priv-owner-file))
    (when (= pf null) (return (ns-ir-base name)))
    (return (ns-compose ((unsafe/cast ptr:PrivFile pf) prefix) (ir-name-token name)))))

; Index of field `fname` in struct `sd`, or -1. Shared by `.`, the `get`
; intrinsic, and the non-emitting type pass so the three cannot drift. `fname`
; and the stored field names are interned, so this is a pointer-identity scan.
; No field access on a defunion's backing struct outside `match`/`make`
; (unions.md §3): the tag and payload are not addressable. The raw escape
; hatch is an explicit cast to the §2 representation.
(defn union-field-guard (sd:(raw StructDef) line:i32 op:CStr):void
  (when (!= (sd udef) null)
    (die-at line
      (fmt-2s "%s: '%s' is a tagged union — eliminate with (match ...), construct with (make ...) or an arm constructor; raw access requires an explicit cast"
              op (sd name)))))

(defn struct-field-index (sd:(raw StructDef) fname:ptr):i32
  (let (sdd:(raw StructDef) sd)
    (dotimes (i (sdd num-fields))
      (when (= ((field-at (sdd fields) i) name) fname)
        (return i)))
    (return -1)))

; Emit `getelementptr + load` of field `idx` from the pointer-to-struct value
; `p`. This is the zero-overhead member-access core shared by the `.` special
; form (emit-field-get) and the `get` blanket intrinsic (emit-get-intrinsic);
; a literal-symbol `(s 'field)` const-folds straight to this, byte-identical.
(defn emit-field-load (p:(raw Val) sd:(raw StructDef) idx:i32):ref:Val
  (let (pv:(raw Val) p
        sdd:(raw StructDef) sd
        ftype:ptr ((field-at (sdd fields) idx) type)
        gep:ptr (new-tmp))
    (fprintf g-body-stream
      "  %s = getelementptr inbounds %%%s, ptr %s, i32 0, i32 %d\n"
      gep (sdd ir-name) (pv val) idx)
    ; Stage 15 W8 G-2: an `(array T N)` field decays — the GEP already holds
    ; the address of element 0 (the field's address and its first element's
    ; address coincide), so the read is the GEP with no load. Shared rule
    ; (array-decay); node-type-field / callable-get-type call the same one.
    ; This is the chokepoint BOTH `_get` and head-position `(s field)` reach.
    (when (= ((as ptr:Type ftype) kind) TY-ARRAY)
      (return (alloc-val (array-decay ftype) gep)))
    (let (val:ptr (new-tmp))
      (emit-load val (type-to-ir ftype) gep ftype)
      (return (alloc-val ftype val)))))

(defn emit-field-get (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 3)
      (die-at (cc line) "_get expects 2 args"))
    (let (p:ref:Val (emit-node (node-at cc 1) scope)
          pt:(raw Type) (p type)
          ek:i32 (if (and (= (pt kind) TY-PTR) (!= (pt elem) null))
                   ((pt elem) kind)
                   TY-VOID))
      (when (and (!= ek TY-STRUCT) (!= ek TY-UNION))
        (die-at (cc line) "_get: operand must be pointer to struct or union"))
      (require-derefable pt (cc line) "field access")
      (let (fn-node:(raw Node) (node-at cc 2))
        (when (!= (fn-node kind) NODE-SYM)
          (die-at (node-line (as ptr fn-node) (cc line)) "_get: field name must be symbol"))
        (let (sd:(raw StructDef) ((pt elem) sdef)
              idx:i32 (struct-field-index sd (fn-node s)))
          ; W3a: an opaque type has no fields at all, so "no field 'x'" would be
          ; a misleading answer — the layout is simply not visible here.
          (reject-opaque-type (pt elem) (node-line (as ptr fn-node) (cc line))
                              "field access")
          ; W1d: same reasoning for a layout the import cycle has not produced
          ; yet — the field table is empty, so "no field 'x'" would blame the
          ; field rather than the cycle.
          (reject-cycle-pending-sdef sd (node-line (as ptr fn-node) (cc line))
                                     "field access")
          (union-field-guard sd (cc line) "_get")
          (when (< idx 0)
            (die-at (node-line (as ptr fn-node) (cc line))
              (fmt-2s "_get: no field '%s' on struct '%s'" (fn-node s) (sd name))))
          ; Union member: every member sits at offset 0, so the access is a
          ; typed load straight through the pointer — no GEP, no checks (raw
          ; reinterpretation, exactly cast's contract).
          (when (= ek TY-UNION)
            (let (ftype:ptr ((field-at (sd fields) idx) type)
                  v:ptr (new-tmp))
              ; G-2: an array member decays to the union's own address (every
              ; member is at offset 0), same rule as the struct-field path.
              (when (= ((as ptr:Type ftype) kind) TY-ARRAY)
                (return (alloc-val (array-decay ftype) (p val))))
              (emit-load v (type-to-ir ftype) (p val) ftype)
              (return (alloc-val ftype v))))
          (return (emit-field-load p sd idx)))))))

; ============================================================
; Callable values (non-function call position) — callable-values.md
;
; A non-function value `s` in head position, `(s arg…)`, desugars by the sole
; argument into one of two reserved generics:
;   (s 'field) / (s field)  [a literal symbol]  → (get s 'field)   member access
;   (s 3)      / (s a b …)  [anything else]      → (invoke s 3 …)   general call
; `get` carries a built-in Struct intrinsic (GEP+load, zero overhead, overridable
; by a user `get` method); `invoke` is purely user-supplied (indexing, function objects).
; ============================================================

; If `node` is a literal field selector — a bare symbol `field` or an explicit
; `(quote field)` — return the symbol Node; else null (a computed selector). A
; bare symbol is always a field, never a variable: field interpretation wins so
; it never depends on what is in scope (callable-values.md §3.5).
(defn selector-literal-sym (node:(raw Node)):(raw Node)
  (when (= node null) (return null))
  (let (nn:(raw Node) node)
    (when (= (nn kind) NODE-SYM) (return node))
    (when (and (= (nn kind) NODE-CELL) (= (node-len node) 2))
      (when (= (node-at node 0) 'quote)
        (let (inner:(raw Node) (node-at node 1))
          (when (= (inner kind) NODE-SYM) (return inner)))))
    (return null)))

; Stage 15 W7 (design/stage15-stress-test/selector-ambiguity.md): does the callee
; type `ct` denote a pointer to a struct/union that actually carries a field named
; by the interned symbol node `sym`? Mirrors emit-get-intrinsic's own unwrapping
; (TY-PTR with a TY-STRUCT/TY-UNION elem, then struct-field-index) so the two can
; never disagree about what "names a field" means — this predicate decides whether
; the field reading of a bare symbol is even available, and emit-get-intrinsic is
; what reports the error when it is not.
(defn callee-has-field (ct:(raw Type) sym:(raw Node)):i32
  (let (cct:(raw Type) ct)
    (when (or (!= (cct kind) TY-PTR) (= (cct elem) null)) (return 0))
    (let (ek:i32 ((cct elem) kind))
      (when (and (!= ek TY-STRUCT) (!= ek TY-UNION)) (return 0))
      (let (sd:(raw StructDef) ((cct elem) sdef))
        (when (= sd null) (return 0))
        (when (< (struct-field-index sd (sym s)) 0) (return 0))
        (return 1)))))

; Stage 15 W7: is the selector symbol also a **local** binding in scope? Only
; locals count. A global would be far too broad a net: every function lives in the
; global scope too, so accepting non-locals would demote `(sd name)` to a value
; lookup the moment any global named `name` existed. A global genuinely used as a
; key has the explicit `(invoke m g-key)` spelling (see emit-invoke-with-callee).
(defn selector-shadowed-by-local (scope:ref:Scope sym:(raw Node)):i32
  (if-some (sy (scope-lookup scope (as CStr (sym s))))
    (return (if (!= (sy is-local) 0) 1 0))
    (return 0)))

; Emit the selector argument as a value for a user `get` method: a literal
; selector becomes its interned symbol Node* (the same pointer the reader / a
; `'sym` quote produce); a computed selector is evaluated normally.
(defn emit-selector-value (sel-node:(raw Node) scope:ref:Scope):ref:Val
  (let (lit:(raw Node) (selector-literal-sym sel-node))
    (if (!= lit null)
      (return (alloc-val ty-ptr (emit-quote-tree lit)))
      (return (emit-node sel-node scope)))))

; Computed-symbol field access (callable-values.md §3.2/§3.3, step 3): the
; selector is dynamic but the struct type is static. Restricted to a homogeneous
; struct (all fields one type) so the result type is well-defined. Emits a
; bounded branch comparing the selector against each interned field symbol
; (pointer identity), then an array-style GEP+load at the matched index.
(defn emit-computed-field (n:(raw Node) scope:ref:Scope callee-val:(raw Val) sd:(raw StructDef) sel-node:(raw Node) line:i32):ref:Val
  (let (sdd:(raw StructDef) sd
        nf:i32 (sdd num-fields))
    (when (= nf 0) (die-at line "get: cannot index an empty struct with a computed selector"))
    (let (ftype:ptr ((field-at (sdd fields) 0) type))
      ; Homogeneity gate — a heterogeneous struct has no single result type.
      (dotimes (fi nf)
        (when (= (type-eq ((field-at (sdd fields) fi) type) ftype) 0)
          (die-at line
            (fmt-s "get: computed field access requires a homogeneous struct, but '%s' has fields of differing types"
                   (sdd name)))))
      (let (cv:(raw Val) callee-val
            sel:ref:Val (emit-node sel-node scope))
        (when (!= ((sel type) kind) TY-PTR)
          (die-at line "get: computed selector must evaluate to a symbol (ptr)"))
        ; Build the field index by a chain of select instructions, innermost
        ; default 0: idx = (sel==f0)?0 : (sel==f1)?1 : … : 0.
        (let (idx:ptr "0"
              k:i32 (- nf 1))
          (while (>= k 0)
            (let (fsym-node:ref:Node (alloc-node))
              (.set! fsym-node kind NODE-SYM)
              (.set! fsym-node line line)
              (.set! fsym-node s ((field-at (sdd fields) k) name))
              (let (fsym:CStr (emit-quote-tree fsym-node)
                    cmp:ptr (new-tmp))
                (fprintf g-body-stream "  %s = icmp eq ptr %s, %s\n" cmp (sel val) fsym)
                (let (nidx:ptr (new-tmp))
                  (fprintf g-body-stream "  %s = select i1 %s, i64 %d, i64 %s\n"
                    nidx cmp k idx)
                  (set! idx nidx))))
            (set! k (- k 1)))
          ; Homogeneous layout is contiguous, so index it as an array of ftype.
          (let (gep:ptr (new-tmp))
            (fprintf g-body-stream
              "  %s = getelementptr inbounds %s, ptr %s, i64 %s\n"
              gep (type-to-ir ftype) (cv val) idx)
            (let (val:ptr (new-tmp))
              (fprintf g-body-stream "  %s = load %s, ptr %s, align %d\n"
                val (type-to-ir ftype) gep (type-size ftype))
              (return (alloc-val ftype val)))))))))

; The `get` blanket intrinsic: member access on a pointer-to-struct callee. A
; literal selector const-folds to a static GEP+load (byte-identical to `.`); a
; computed selector takes the homogeneous runtime branch above.
(defn emit-get-intrinsic (n:(raw Node) scope:ref:Scope callee-val:(raw Val) sel-node:(raw Node) line:i32):ref:Val
  (let (cv:(raw Val) callee-val
        ct:(raw Type) (cv type)
        ek:i32 (if (and (= (ct kind) TY-PTR) (!= (ct elem) null))
                 ((ct elem) kind)
                 TY-VOID))
    (when (and (!= ek TY-STRUCT) (!= ek TY-UNION))
      (die-at line "callable value: not callable — no matching get/invoke method and not a pointer-to-struct"))
    (require-derefable ct line "field access")
    (let (sd:(raw StructDef) ((ct elem) sdef)
          lit:(raw Node) (selector-literal-sym sel-node))
      ; W3a: head-position `(handle field)` on an opaque type — same rule as the
      ; `_get` path above, which this mirrors.
      (reject-opaque-type (ct elem) line "field access")
      (reject-cycle-pending-sdef sd line "field access")
      (union-field-guard sd line "get")
      (when (= lit null)
        (when (= ek TY-UNION)
          (die-at line "get: computed member access on a union is not supported"))
        (return (emit-computed-field n scope callee-val sd sel-node line)))
      (let (idx:i32 (struct-field-index sd (lit s)))
        (when (< idx 0)
          ; Stage 15 W7: the bare-symbol-names-a-field rule is the one place a
          ; symbol is not a variable reference, so when the name IS a local the
          ; unadorned message actively misleads — it names a struct the user was
          ; not trying to read a field of. Say so, and name the escape hatch. Only
          ; reachable for a genuine miss: emit-get-with-callee already demoted the
          ; selector to a value if a `get` method could take it.
          (when (!= (selector-shadowed-by-local scope lit) 0)
            (die-at line
              (fmt-3s "get: no field '%s' on struct '%s' -- and '%s' is a local binding here, but a bare symbol in selector position always names a field. To look it up by value, give the type a `get` method for the key type (then `(callee key)` works), or write `(invoke callee key)`."
                      (lit s) (sd name) (lit s))))
          (die-at line
            (fmt-2s "get: no field '%s' on struct '%s'" (lit s) (sd name))))
        ; Union member: typed load at offset 0 (mirrors emit-field-get).
        (when (= ek TY-UNION)
          (let (ftype:ptr ((field-at (sd fields) idx) type)
                v:ptr (new-tmp))
            ; G-2 array decay, mirroring emit-field-get's union arm.
            (when (= ((as ptr:Type ftype) kind) TY-ARRAY)
              (return (alloc-val (array-decay ftype) (cv val))))
            (emit-load v (type-to-ir ftype) (cv val) ftype)
            (return (alloc-val ftype v))))
        (return (emit-field-load callee-val sd idx))))))

; Like generic-resolve, but returns null on no match instead of dying — a
; non-dying generic resolve for callsites where an unmatched generic is a normal
; fallback case (e.g. value-keyed `get`, where a miss means "use the struct
; intrinsic" not "error"). Mirrors generic-resolve's tier 0 (exact METHOD-USER)
; and tier 1 (METHOD-GENERIC: bind tyvars, check &where constraints, instantiate
; the winning candidate). Tier 2 (untyped-literal widening) is intentionally
; omitted: this resolver is only used for value-keyed dispatch where an exact or
; constrained-generic match is required to override the intrinsic, and a partial
; widen-match must not silently shadow the blanket fallback. A no-match path has
; no side effects — instantiation (which registers a method and queues a MonoJob)
; only runs when exactly one tier-1 candidate is found.
(defn generic-resolve-nullable (g:(raw Generic) argtypes:ptr nargs:i32 line:i32):?ptr:Method
  (let (gg:(raw Generic) g
        found:?ptr:Method null)
    ; tier 0: exact concrete (METHOD-USER) match.
    (dotimes (i (unsafe/cast i32 (count (gg methods))))
      (let (m:(raw Method) (invoke (gg methods) (as usize i)))
        (when (and (= (m kind) METHOD-USER)
                   (= (m num-params) nargs)
                   (!= (params-type-eq (m param-types) argtypes nargs) 0))
          (set! found m))))
    (when (!= found null) (return found))
    ; tier 1: bounded-generic templates — bind the tyvars then check &where.
    (let (cand:ptr null
          cand-bound:ptr null
          ncand:i32 0)
      (dotimes (j (unsafe/cast i32 (count (gg methods))))
        (let (m:(raw Method) (invoke (gg methods) (as usize j)))
          (when (= (m kind) METHOD-GENERIC)
            (let (bound:ptr (arena-alloc (* (as i64 (+ (m num-tyvars) 1)) (ptr-bytes))))
              ; Stage 15 W9 defect 12 (found by the new arity check): this call
              ; was missing its trailing `arg-nodes` argument, so the callee read
              ; an uninitialized register as the argument-node array. This
              ; resolver has no argument nodes to offer — it types from
              ; `argtypes` alone — so the honest value is null, which
              ; generic-method-bind's literal-spotting path already guards.
              (when (!= (generic-method-bind m argtypes nargs bound null null) 0)
                (when (!= (generic-constraints-ok m bound line) 0)
                  (do (set! cand m) (set! cand-bound bound) (inc! ncand))))))))
      (when (> ncand 1)
        (die-at line (fmt-s "ambiguous generic match for '%s'" (gg name))))
      (when (= ncand 1)
        (return (generic-instantiate g cand cand-bound argtypes nargs line)))
      (return null))))

; Side-effect-free probe: does generic `g` carry a method whose *first parameter*
; (the receiver) accepts the callee type `ct`? Used by the callable-value router
; to make the `invoke → get → _get` decision *before* emitting any argument, so a
; plain struct (no `invoke`, no custom `get`) lands on the raw `_get` field
; intrinsic with byte-identical IR. A METHOD-USER receiver must `type-eq` `ct`; a
; METHOD-GENERIC (parametric, e.g. `(ref (Vector T))`) is probed by unifying its
; first-parameter type pattern against `ct` — the same structural unifier
; generic-method-bind uses, but over the receiver alone (no args), writing only to
; a throwaway bound array. Returns 1 on the first match, else 0.
(defn generic-has-receiver-method (g:(raw Generic) ct:(raw Type)):i32
  (when (= g null) (return 0))
  (let (gg:(raw Generic) g)
    (dotimes (i (unsafe/cast i32 (count (gg methods))))
      (let (m:(raw Method) (invoke (gg methods) (as usize i)))
        (when (> (m num-params) 0)
          (if (= (m kind) METHOD-USER)
            (when (!= (type-eq (aref (as ptr:ptr (m param-types)) 0) ct) 0)
              (return 1))
            ; METHOD-GENERIC: unify the receiver pattern against ct. The unifier
            ; only writes the scratch bound array, so this is side-effect-free.
            (let (params-node:(raw Node) (node-at (m body) 2)
                  ntv:i32 (m num-tyvars)
                  bound:ptr (arena-alloc (* (as i64 (+ ntv 1)) (ptr-bytes)))
                  ptn:(raw Node) (binding-type-node (node-at params-node 0)))
              (when (!= ptn null)
                (dotimes (k ntv) (aset! (as ptr:ptr bound) k null))
                (when (!= (unify-tpat ptn ct (m tyvars) ntv bound
                                      ((m body) line)) 0)
                  (return 1))))))))
    (return 0)))

; Resolve `(get callee selector)` for an already-emitted callee value, splitting
; on the selector kind (callable-values.md §3.2/§3.3).
;
; Branch A — literal-symbol selector (`'field` or bare `field`): member access.
; A user `get` method for (callee-type, symbol-ptr) sits at tier 0 and out-ranks
; the intrinsic (concrete beats blanket); otherwise the Struct intrinsic does the
; GEP+load. The selector's value type is always ty-ptr here (an interned symbol).
;
; Branch B — computed/value selector (an i32/CStr/any non-symbol key): value-keyed
; lookup. Emit the selector to a real value, then resolve the `get` generic on the
; selector's *actual* type — including parametric (METHOD-GENERIC) overrides such
; as a `(Bag K V)` key getter — via the non-dying resolver. On a hit, call the
; resolved method with the already-emitted selector value (do not re-emit). On a
; miss, fall through to the struct intrinsic's computed-field branch.
(defn emit-get-with-callee (n:(raw Node) scope:ref:Scope callee-val:(raw Val) sel-node:(raw Node)):ref:Val
  (let (cv:(raw Val) callee-val
        ct:(raw Type) (cv type)
        line:i32 (n line)
        g:(raw Generic) (generic-lookup "get")
        sym:(raw Node) (selector-literal-sym sel-node))
    ; Stage 15 W7: a bare symbol in selector position always *names a field*, which
    ; is the only place in the language where a bare symbol is not a variable
    ; reference. Branch A used to be a one-way door: once classified as a symbol
    ; the value reading was unreachable, so `(m k)` on a `(HashMap CStr i32)` died
    ; with "no field 'k'" even though `k` was a CStr local sitting right there and
    ; `(m "foo")` worked. Demote to a value selector when the field reading is
    ; *provably unavailable* — the callee has no such field — and the symbol is a
    ; local binding. A quoted `'field` is never demoted: it is the explicit
    ; always-a-name spelling.
    ;
    ; This cannot change the meaning of code that compiles today: every existing
    ; site resolves its field, so `callee-has-field` is 1 and the demotion never
    ; fires (measured — 79 sites in the compiler's own source shadow a local with
    ; a real field name, and all 79 keep the field). Diagnostics are preserved
    ; too: when Branch B then finds no method it falls through to
    ; emit-get-intrinsic, which re-reads the still-symbol sel-node and reports the
    ; same "no field" error, now with a hint.
    ; `(= sym sel-node)` is the bare-vs-quoted discriminator: selector-literal-sym
    ; returns the node itself for a bare symbol and the *inner* node for `'sym`.
    (when (and (!= sym null)
               (= sym sel-node)
               (= (callee-has-field ct sym) 0)
               (!= (selector-shadowed-by-local scope sym) 0))
      (set! sym null))
    (if (!= sym null)
      ; --- Branch A: literal-symbol selector (unchanged field-access path) ---
      (when (!= g null)
        (let (argtypes:ptr (arena-alloc (* (as i64 2) (ptr-bytes))))
          (aset! (as ptr:ptr argtypes) 0 ct)
          (aset! (as ptr:ptr argtypes) 1 ty-ptr)
          (let (m:?ptr:Method (generic-find-method-exact g argtypes 2))
            (when (!= m null)
              (let (sel-val:ref:Val (emit-selector-value sel-node scope)
                    args:ptr (arena-alloc (* (as i64 2) (sizeof Val))))
                (memcpy (unsafe/ptr+ (as ptr:Val args) 0) cv (sizeof Val))
                (memcpy (unsafe/ptr+ (as ptr:Val args) 1) sel-val (sizeof Val))
                (return (emit-resolved-call n scope "get" m args 2 line)))))))
      ; --- Branch B: computed/value selector (value-keyed generic dispatch) ---
      (when (!= g null)
        (let (sel-val:ref:Val (emit-node sel-node scope)
              kt:(raw Type) (sel-val type)
              argtypes:ptr (arena-alloc (* (as i64 2) (ptr-bytes))))
          (aset! (as ptr:ptr argtypes) 0 ct)
          (aset! (as ptr:ptr argtypes) 1 kt)
          (let (m:?ptr:Method (generic-resolve-nullable g argtypes 2 line))
            ; Stage 14 NS-3 (design/stage14/native-strings.md): a string-literal key
            ; is an unmaterialized StrView. `generic-resolve-nullable` matches keys
            ; exactly (no borrow), so a StrView key does not match a CStr-keyed `get`
            ; method — the overwhelmingly common case (`(get cstr-map "k")`). If the
            ; StrView-keyed resolution fails, retry with the free CStr borrow:
            ; collapse the literal to CStr (a no-IR retype — `val` is the bare GEP)
            ; and re-resolve. StrView-keyed maps (should any exist) still bind on the
            ; first attempt, so their behavior is unchanged. Dead for the compiler
            ; (no value-keyed `get` on a string literal in src/).
            (when (and (= m null)
                       (!= (sel-val is-lit) 0)
                       (!= (type-is-strview kt) 0))
              (.set! sel-val type ty-cstr)
              (aset! (as ptr:ptr argtypes) 1 ty-cstr)
              (set! m (generic-resolve-nullable g argtypes 2 line)))
            (when (!= m null)
              (let (args:ptr (arena-alloc (* (as i64 2) (sizeof Val))))
                (memcpy (unsafe/ptr+ (as ptr:Val args) 0) cv (sizeof Val))
                (memcpy (unsafe/ptr+ (as ptr:Val args) 1) (as ptr sel-val) (sizeof Val))
                (return (emit-resolved-call n scope "get" m args 2 line))))))))
    (return (emit-get-intrinsic n scope callee-val sel-node line))))

; Stage 15 W4d (design/stage15-stress-test/diagnostics.md §W4d): a bare integer
; literal (or a bound `_`) in call/head position is never a valid call — the
; overwhelmingly common cause is `docs/special-forms.md`'s now-fixed but still
; muscle-memory nested-clause `case` shape, `(case x (0 body) (1 body) ...)`,
; where `(0 body)` is parsed as "call the integer 0". Detected here rather than
; inside the `case` macro body: a macro body is ordinary user-scope Nucleus code
; JIT-compiled through the same path as any `defmacro`, and `die-at`/`report-at`
; (lib/reader.nuc) are only in scope for the compiler's own source (which
; explicitly imports reader.nuc) — not for a user program's macro expansions.
; Confirmed empirically: a `defmacro` body calling `die-at` fails to compile
; with `unknown: die-at`. Fixing the message at this one chokepoint instead is
; strictly more general — it also catches the identical mistake spelled outside
; a `case` form (any integer literal called as a function) — at no extra cost.
(defn case-clause-hint (head-node:(raw Node)):ptr
  (when (= (head-node kind) NODE-INT)
    (return (fmt-i64 "%ld is not callable -- an integer literal can never appear in call position; if you meant a `case` clause: case takes flat value/result pairs, not clauses: (case x 1 \"one\" 2 \"two\" \"other\")" (head-node i))))
  (when (and (= (head-node kind) NODE-SYM) (= (head-node s) "_"))
    (return (as ptr "'_' is not callable in this position; if you meant a `case` clause: case takes flat value/result pairs, not clauses: (case x 1 \"one\" 2 \"two\" \"other\")")))
  (return null))

; Resolve `(invoke callee arg…)` for an already-emitted callee value. The callee
; is the first dispatch argument; the rest are emitted here. Dispatch is ordinary
; multimethod resolution over the `invoke` generic — a type "becomes callable" by
; defining `invoke` methods (indexing, function objects). No built-in default.
(defn emit-invoke-with-callee (n:(raw Node) scope:ref:Scope callee-val:(raw Val) arg-start:i32 nargs:i32):ref:Val
  (let (cv:(raw Val) callee-val
        line:i32 (n line)
        total:i32 (+ nargs 1)
        args:ptr (arena-alloc (* (as i64 (+ total 1)) (sizeof Val)))
        argtypes:ptr (arena-alloc (* (as i64 (+ total 1)) (ptr-bytes)))
        arg-nodes:ptr (arena-alloc (* (as i64 (+ total 1)) (ptr-bytes))))
    ; Stage 13 TE-4: a BoxedFn callee dispatches through its vtable invoke slot,
    ; not the `invoke` generic (no method has the box as receiver). Inert otherwise.
    (when (!= (boxedfn-canonical (cv type)) null)
      (return (emit-box-invoke n scope callee-val arg-start nargs)))
    (memcpy (unsafe/ptr+ (as ptr:Val args) 0) cv (sizeof Val))
    (aset! (as ptr:ptr argtypes) 0 (cv type))
    (aset! (as ptr:ptr arg-nodes) 0 null)
    (dotimes (i nargs)
      (let (anode:(raw Node) (node-at n (+ arg-start i))
                      v:ref:Val (emit-node anode scope))
        (memcpy (unsafe/ptr+ (as ptr:Val args) (+ i 1)) v (sizeof Val))
        (aset! (as ptr:ptr argtypes) (+ i 1) (v type))
        (aset! (as ptr:ptr arg-nodes) (+ i 1) anode)))
    (let (g:(raw Generic) (generic-lookup "invoke"))
      ; Stage 15 W7: no `invoke` method accepts this receiver, but the callee may
      ; still answer through `get` — a `HashMap` exposes its lookup as `get` and
      ; has no `invoke` at all, so `(invoke m k)` used to die with "no `invoke`
      ; method is defined for this type" while a perfectly good `get` sat right
      ; there. With the fallback, `invoke` becomes the unambiguous **always-a-value**
      ; spelling (`'sym` being the always-a-name one), which is the escape hatch
      ; for the two cases the bare-symbol demotion above deliberately does not
      ; cover: a selector that collides with a real field name, and a *global*
      ; used as a key.
      ;
      ; generic-has-receiver-method is the side-effect-free probe (it writes only a
      ; throwaway bound array) and tolerates a null generic. Gating on it leaves the
      ; ordinary invoke path below completely untouched — in particular its tier-2
      ; untyped-literal widening, which generic-resolve-nullable does not implement.
      (when (and (= total 2) (= (generic-has-receiver-method g (cv type)) 0))
        (let (gg:(raw Generic) (generic-lookup "get"))
          (when (!= gg null)
            (let (gm:?ptr:Method (generic-resolve-nullable gg argtypes total line))
              (when (!= gm null)
                (return (emit-resolved-call n scope "get" gm args total line)))))))
      (when (= g null)
        (let (head-node:(raw Node) (node-at n (- arg-start 1))
              hint:ptr (case-clause-hint head-node))
          (if (!= hint null)
            (die-at line hint)
            (die-at line "value is not callable: no `invoke` method is defined for this type"))))
      (let (m:ref:Method (generic-resolve g argtypes arg-nodes total line null))
        (return (emit-resolved-call n scope "invoke" m args total line))))))

; The desugar entry point: an already-emitted non-function head value `callee-val`
; in `(callee arg…)`. Routing is `invoke → get → _get`: if the callee type
; participates in the `invoke` generic it indexes/applies (the arg is a *value*, so
; `(v idx)` evaluates `idx`); else if it has a *custom* `get` method that runs;
; else a single literal-symbol arg is the raw `_get` field intrinsic. A plain
; struct (no invoke, no custom get) therefore lands on the field intrinsic with the
; same IR as before this change.
(defn emit-callable-value (n:(raw Node) scope:ref:Scope callee-val:(raw Val)):ref:Val
  (let (nargs:i32 (- (node-len n) 1)
        ct:(raw Type) (callee-val type))
    ; A function-pointer value folds to an indirect call (callable-values.md §4.2).
    (when (= (ct kind) TY-FN)
      (return (emit-funcall-value n scope callee-val 1)))
    ; Stage 13 TE-4: a BoxedFn value applies through its vtable regardless of the
    ; argument shape (a symbol arg must not be mis-routed to `get`/`_get`). Inert
    ; otherwise — the compiler has no box value.
    (when (!= (boxedfn-canonical ct) null)
      (return (emit-invoke-with-callee n scope callee-val 1 nargs)))
    ; invoke takes precedence: any callee whose type has an `invoke` method treats
    ; the arg(s) as values (so `(v idx)` indexes, not a field-named-`idx` get).
    (when (!= (generic-has-receiver-method (generic-lookup "invoke") ct) 0)
      (return (emit-invoke-with-callee n scope callee-val 1 nargs)))
    ; A custom `get` method (the intrinsic is not registered) handles its own
    ; literal-vs-computed selector split inside emit-get-with-callee.
    (when (and (= nargs 1)
               (!= (generic-has-receiver-method (generic-lookup "get") ct) 0))
      (return (emit-get-with-callee n scope callee-val (node-at n 1))))
    ; Fall back: a single literal-symbol arg is the raw `_get` field intrinsic;
    ; anything else has no callable meaning (emit-invoke-with-callee reports it).
    (when (and (= nargs 1) (!= (selector-literal-sym (node-at n 1)) null))
      (return (emit-get-with-callee n scope callee-val (node-at n 1))))
    (return (emit-invoke-with-callee n scope callee-val 1 nargs))))

; Explicit `(get value selector)` and `(invoke value arg…)` surface forms. They
; share the resolution above so `(get s 'f)` ≡ `(s f)` and `(invoke v 3)` ≡ `(v 3)`.
(defn emit-get (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 3) (die-at (cc line) "get expects (get value selector)"))
    (let (callee-val:ref:Val (emit-node (node-at cc 1) scope))
      (return (emit-get-with-callee call scope callee-val (node-at cc 2))))))

(defn emit-invoke (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (< (node-len cc) 2) (die-at (cc line) "invoke expects (invoke value arg...)"))
    (let (callee-val:ref:Val (emit-node (node-at cc 1) scope))
      (return (emit-invoke-with-callee call scope callee-val 2 (- (node-len cc) 2))))))

; ============================================================
; sizeof, alloca, array ops, char, pointer ops
; ============================================================

(defn emit-sizeof (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 2) (die-at (cc line) "sizeof expects 1 arg"))
    (let (tn:(raw Node) (node-at cc 1))
      ; G-2: `(sizeof (array T N))` is meaningful and is how a program asks for
      ; the table's byte size. parse-type-from-node consumes the flag on entry,
      ; so no restore is needed.
      (set! g-array-ok 1)
      (let (ty:(raw Type) (parse-type-from-node tn (tn line))
            gep:ptr (new-tmp))
        ; W3a: an opaque C type has no size. Refuse here rather than emitting a
        ; GEP over an undefined `%Foo` (or, worse, a plausible-looking number).
        (reject-opaque-type ty (node-line (as ptr tn) (cc line)) "sizeof")
        (fprintf g-body-stream "  %s = getelementptr %s, ptr null, i32 1\n"
          gep (type-to-ir ty))
        (let (sz:ptr (new-tmp))
          ; sizeof yields a pointer-sized integer (size_t), not a hardcoded i64.
          (fprintf g-body-stream "  %s = ptrtoint ptr %s to %s\n"
            sz gep (ptr-int-ir))
          (return (alloc-val (ptr-int-type) sz)))))))

(defn emit-alloca-form (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (and (!= (node-len cc) 2) (!= (node-len cc) 3))
      (die-at (cc line) "alloca expects 1 or 2 args"))
    (let (tn:(raw Node) (node-at cc 1))
      ; G-2: `(alloca (array T N))` reserves a zero-length-free fixed frame
      ; table and, like every other array read, hands back the decayed `ptr:T`
      ; (below) rather than a pointer-to-array.
      (set! g-array-ok 1)
      (let (ty:(raw Type) (parse-type-from-node tn (tn line))
            slot:ptr (new-tmp)
            pt:ref:Type (make-type TY-PTR))
        ; W3a: no layout means no stack slot can be reserved for it.
        (reject-opaque-type ty (node-line (as ptr tn) (cc line)) "alloca")
        ; G-2: `(alloca (array T N))` yields `ptr:T`, not `ptr:(array T N)` —
        ; the same decay a read of an array-typed slot performs, so the result
        ; is directly `aref`-able. The alloca's own IR type stays `[N x T]`.
        (if (= ((unsafe/cast ptr:Type ty) kind) TY-ARRAY)
          (.set! pt elem ((unsafe/cast ptr:Type ty) elem))
          (.set! pt elem ty))
        ; alloca always yields a valid, non-null stack address (ref T).
        (.set! pt pkind PTR-REF)
        (if (= (node-len cc) 3)
          (let (nv:ref:Val (emit-node (node-at cc 2) scope))
            (fprintf g-body-stream "  %s = alloca %s, i32 %s, align %d\n"
              slot (type-to-ir ty) (nv val) (type-size ty)))
          (fprintf g-entry-stream "  %s = alloca %s, align %d\n"
            slot (type-to-ir ty) (type-size ty)))
        (return (alloc-val pt slot))))))

(defn emit-aref (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 3) (die-at (cc line) "aref expects 2 args"))
    (let (p:ref:Val (emit-node (node-at cc 1) scope))
      (when (or (!= ((p type) kind) TY-PTR)
              (= ((p type) elem) null))
        (die-at (cc line) "aref: operand must be typed pointer"))
      (require-derefable (p type) (cc line) "aref")
      (let (idx:ref:Val (emit-node (node-at cc 2) scope))
        (when (= (is-int-type (idx type)) 0)
          (die-at (cc line) "aref: index must be integer"))
        (let (idx64:ptr (idx val))
          ; Extend the index to i64 for the GEP unless it is already pointer-wide
          ; (i64 on LP64, i32 on ILP32). usize/ssize are pointer-sized so no sext.
          (when (< (type-size (idx type)) g-target-ptr-bytes)
            (let (t:ptr (new-tmp))
              (fprintf g-body-stream "  %s = sext %s %s to i64\n"
                t (type-to-ir (idx type)) (idx val))
              (set! idx64 t)))
          (let (elem:(raw Type) ((p type) elem)
                gep:ptr (new-tmp))
            (fprintf g-body-stream
              "  %s = getelementptr inbounds %s, ptr %s, i64 %s\n"
              gep (type-to-ir elem) (p val) idx64)
            (let (val:ptr (new-tmp))
              (fprintf g-body-stream "  %s = load %s, ptr %s, align %d\n"
                val (type-to-ir elem) gep (type-size elem))
              (return (alloc-val elem val)))))))))

(defn emit-aset (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 4) (die-at (cc line) "aset! expects 3 args"))
    (let (p:ref:Val (emit-node (node-at cc 1) scope))
      (when (or (!= ((p type) kind) TY-PTR)
              (= ((p type) elem) null))
        (die-at (cc line) "aset!: operand must be typed pointer"))
      (require-derefable (p type) (cc line) "aset!")
      (let (idx:ref:Val (emit-node (node-at cc 2) scope))
        (when (= (is-int-type (idx type)) 0)
          (die-at (cc line) "aset!: index must be integer"))
        (let (idx64:ptr (idx val))
          ; Same pointer-width guard as emit-aref: skip sext when already i64.
          (when (< (type-size (idx type)) g-target-ptr-bytes)
            (let (t:ptr (new-tmp))
              (fprintf g-body-stream "  %s = sext %s %s to i64\n"
                t (type-to-ir (idx type)) (idx val))
              (set! idx64 t)))
          (let (elem:(raw Type) ((p type) elem)
                v:ref:Val (emit-node (node-at cc 3) scope)
                coerced:ptr (coerce-int-val v elem (cc line)))
            (when (= coerced null)
              (die-at (cc line) "aset!: value type mismatch"))
            (taint-store-check p v (cc line) "aset!")
            (let (cv:ptr:Val (unsafe/cast ptr:Val coerced)
                  gep:ptr (new-tmp))
              (fprintf g-body-stream
                "  %s = getelementptr inbounds %s, ptr %s, i64 %s\n"
                gep (type-to-ir elem) (p val) idx64)
              (fprintf g-body-stream "  store %s %s, ptr %s, align %d\n"
                (type-to-ir elem) (cv val) gep (type-size elem))
              (return (alloc-val ty-void null)))))))))

; (char "x") — now sugar for the `\x` char literal: produces a `Char`-typed
; value from the first byte of a single-byte string (Stage 11 M6 S0). Superseded
; by the `\x` reader literal; kept so existing call sites read as `Char`, not the
; old raw `i8`. The byte is in 0..127 in practice (ASCII source), already a valid
; scalar value, so no codepoint validation is needed.
(defn emit-char (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 2) (die-at (cc line) "char expects 1 arg"))
    (let (arg:(raw Node) (node-at cc 1))
      (when (or (!= (arg kind) NODE-STR) (!= (as i64 (strlen (arg s))) 1))
        (die-at (node-line (as ptr arg) (cc line)) "char: arg must be single-char string"))
      (return (alloc-val ty-char (fmt-i32 "%d" (char-at (arg s) 0)))))))

(defn emit-addr-of (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 2) (die-at (cc line) "addr-of expects 1 arg"))
    (let (target:(raw Node) (node-at cc 1))
      (when (!= (target kind) NODE-SYM)
        (die-at (node-line (as ptr target) (cc line)) "addr-of: target must be symbol"))
      (let (sym:?ptr:Sym (scope-lookup scope (target s)))
        (when (= sym null)
          (die-at (node-line (as ptr target) (cc line)) (fmt-s "addr-of: undefined '%s'" (target s))))
        ; CE-3 (closure-enhancements.md §CE-3): a moved-out binding is consumed,
        ; so taking its address is a use-after-move just like reading it
        ; (emit-symbol-ref). Newly reachable now that struct-VALUE with-bindings
        ; can be moved (owns=1) and the only way to read a struct value's field
        ; is through its address — so an unchecked addr-of would silently revive a
        ; moved struct value.
        (when (!= (sym moved) 0)
          (die-at (node-line (as ptr target) (cc line)) (fmt-s "use after move: '%s'" (target s))))
        (when (= ((sym type) kind) TY-FN)
          (die-at (node-line (as ptr target) (cc line)) (fmt-s "addr-of: cannot take address of function '%s'" (target s))))
        (let (pt:ref:Type (make-type TY-PTR))
          (.set! pt elem (sym type))
          ; The address of a binding's slot is always a valid, non-null address,
          ; so (addr-of x) is a (ref T) — it flows into ref/ptr slots directly.
          (.set! pt pkind PTR-REF)
          ; The slot address reaches the same resource the binding does, so it
          ; carries the binding's escape taint (lifecycle.md §2.2).
          (let (rv:ref:Val (alloc-val pt (sym ir-name))
                sym-kind:i32 ((sym type) kind))
            ; The slot address reaches the same resource the binding does, so it
            ; inherits the binding's existing (with-owned) escape taint, if any.
            (.set! rv taint (sym taint))
            ; Stage 13 L1 (lambda.md §"Lifetime and escape analysis"):
            ; taking the address of *frame-local storage* taints the resulting
            ; pointer with the region (Scope*) the storage lives in, so it
            ; cannot escape the frame (rejected at `return`). This generalizes
            ; the with-only taint to every let/with value binding and by-value
            ; parameter (all of which live in a frame alloca). The frame-region
            ; IS the binding's home scope; a binding whose home is the unique
            ; global scope (g-globals) is NOT frame-local (its address outlives
            ; any frame), which excludes globals — note defvar globals carry
            ; is-local=1, so `home != g-globals` is the authoritative test, not
            ; is-local. Also EXCLUDED:
            ;   * reference/pointer parameters and pointer locals (TY-PTR) —
            ;     their slot holds a pointer whose pointee is caller-owned, so a
            ;     pointer *loaded out of* the slot may legitimately be returned;
            ;     that load is the existing untracked imprecision boundary.
            ; taint-frame=1 distinguishes this from a with-resource so the store
            ; sinks (intra-frame borrows) skip it; only `return` (the function-
            ; frame boundary) rejects it. A binding already carrying with-taint
            ; keeps that with-taint (taint-frame stays 0).
            (when (and (= (sym taint) null)
                       (!= (sym home) g-globals)
                       (!= sym-kind TY-PTR) (!= sym-kind TY-FN))
              (.set! rv taint (sym home))
              (.set! rv taint-frame 1))
            (return rv)))))))

(defn emit-funcall-void (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 2) (die-at (cc line) "funcall-void expects 1 arg"))
    (let (fn:ref:Val (emit-node (node-at cc 1) scope))
      (when (!= ((fn type) kind) TY-PTR)
        (die-at (cc line) "funcall-void: arg must be ptr"))
      (fprintf g-body-stream "  call void %s()\n" (fn val))
      (return (alloc-val ty-void null)))))

; (funcall-ptr-1 fn arg) — call fn(arg) as ptr(ptr) via pointer, return ptr
(defn emit-funcall-ptr-1 (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 3) (die-at (cc line) "funcall-ptr-1 expects 2 args"))
    (let (fn:ref:Val  (emit-node (node-at cc 1) scope)
          arg:ref:Val (emit-node (node-at cc 2) scope))
      (when (!= ((fn type) kind) TY-PTR)
        (die-at (cc line) "funcall-ptr-1: fn must be ptr"))
      (when (!= ((arg type) kind) TY-PTR)
        (die-at (cc line) "funcall-ptr-1: arg must be ptr"))
      (let (tmp:ptr (new-tmp))
        (fprintf g-body-stream "  %s = call ptr %s(ptr %s)\n"
          tmp (fn val) (arg val))
        (return (alloc-val ty-ptr tmp))))))

; (funcall-ptr-i32 fn) — call fn() as i32() via pointer, return i32
(defn emit-funcall-ptr-i32 (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 2) (die-at (cc line) "funcall-ptr-i32 expects 1 arg"))
    (let (fn:ref:Val (emit-node (node-at cc 1) scope))
      (when (!= ((fn type) kind) TY-PTR)
        (die-at (cc line) "funcall-ptr-i32: arg must be ptr"))
      (let (tmp:ptr (new-tmp))
        (fprintf g-body-stream "  %s = call i32 %s()\n" tmp (fn val))
        (return (alloc-val ty-i32 tmp))))))

; (funcall-ptr-i64 fn) — call fn() as i64() via pointer, return i64
(defn emit-funcall-ptr-i64 (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 2) (die-at (cc line) "funcall-ptr-i64 expects 1 arg"))
    (let (fn:ref:Val (emit-node (node-at cc 1) scope))
      (when (!= ((fn type) kind) TY-PTR)
        (die-at (cc line) "funcall-ptr-i64: arg must be ptr"))
      (let (tmp:ptr (new-tmp))
        (fprintf g-body-stream "  %s = call i64 %s()\n" tmp (fn val))
        (return (alloc-val ty-i64 tmp))))))

; (funcall-ptr-ptr fn) — call fn() as ptr() via pointer, return ptr
(defn emit-funcall-ptr-ptr (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 2) (die-at (cc line) "funcall-ptr-ptr expects 1 arg"))
    (let (fn:ref:Val (emit-node (node-at cc 1) scope))
      (when (!= ((fn type) kind) TY-PTR)
        (die-at (cc line) "funcall-ptr-ptr: arg must be ptr"))
      (let (tmp:ptr (new-tmp))
        (fprintf g-body-stream "  %s = call ptr %s()\n" tmp (fn val))
        (return (alloc-val ty-ptr tmp))))))

; ------------------------------------------------------------
; The call-arity rule, in ONE function every call path CALLS (Stage 15 W9
; defect 12; context/conventions.md "mirror a call, not the logic"). Before
; this, the rule was written inline at the indirect-call and BoxedFn sites and
; **not at all** on the solitary-`defn` path, so `(f 1 2)` against a
; one-parameter `f` emitted `call i32 @f(i32 1, i32 2)` and linked.
;
; `sig` is the callee's signature-carrying Type. That is a TY-FN for a `defn` /
; `extern` / `declare` / function-pointer value, but a **TY-STRUCT** for a
; `(BoxedFn …)`/`(dyn P)` fat pointer, which carries `ret`/`params`/`num-params`
; on the struct Type (union-registry.nuc `boxedfn-type`) — so this must NOT gate
; on `kind == TY-FN` or the box path would silently stop being checked.
;
; The five shapes, and why each is admissible:
;   variadic  (a C header's `int printf(const char*, ...)`): only the fixed
;              prefix is constrained.
;   open-tail: the callee's signature came from a `declare` rather than a body
;              the compiler has seen. Nucleus has no `...` spelling, so a C
;              variadic function is declared with its fixed parameters only and
;              the extra arguments ride the call site (docs/toplevel.md, and the
;              very idiom nuch.nuc's `&rest`-in-a-declaration diagnostic points
;              at). Same rule as `variadic`; carried separately because it is a
;              property of the SYMBOL, not of the signature.
;   &rest:     the trailing parameter is the folded Node list, so the fixed
;              prefix is num-params-1 and anything at or above it is legal.
;   &optional: the trailing `nopt` parameters may be omitted; `emit-call` then
;              fills each from its default expression.
;   otherwise: exactly num-params.
; A zero-filled non-fn Type answers variadic/has-rest/nopt = 0 and num-params 0,
; i.e. the exact rule — which is what a box wants.
(defn call-arity-ok (sig:(raw Type) nargs:i32 open-tail:i32):i32
  (when (= sig null) (return 1))
  (let (np:i32 (sig num-params))
    (when (or (!= (sig variadic) 0) (!= open-tail 0)) (return (if (< nargs np) 0 1)))
    (when (!= (sig has-rest) 0) (return (if (< nargs (- np 1)) 0 1)))
    (when (!= (sig nopt) 0)
      (when (< nargs (- np (sig nopt))) (return 0))
      (return (if (> nargs np) 0 1)))
    (return (if (!= nargs np) 0 1))))

; Raise the located arity diagnostic for a call the rule above rejects. `name`
; is the callee spelling, or null for an indirect/anonymous callee, in which
; case `what` ("call", "BoxedFn call") is the diagnostic subject. The subject is
; formatted only on the failure path, so the check costs nothing on the hot
; direct-call path.
(defn check-call-arity (what:ptr name:ptr sig:(raw Type) nargs:i32
                        open-tail:i32 line:i32):void
  (when (!= (call-arity-ok sig nargs open-tail) 0) (return))
  (let (subject:ptr what
        np:i32 (sig num-params))
    (when (!= name null) (set! subject (fmt-s "call to '%s'" name)))
    (when (or (!= (sig variadic) 0) (!= open-tail 0))
      (die-at line (fmt-s-2i "%s: expected at least %d args, got %d" subject np nargs)))
    (when (!= (sig has-rest) 0)
      (die-at line
        (fmt-s-2i "%s: expected at least %d args, got %d" subject (- np 1) nargs)))
    (when (!= (sig nopt) 0)
      (when (< nargs (- np (sig nopt)))
        (die-at line (fmt-s-2i "%s: expected at least %d args, got %d"
                               subject (- np (sig nopt)) nargs)))
      (die-at line (fmt-s-2i "%s: expected at most %d args, got %d" subject np nargs)))
    (die-at line (fmt-s-2i "%s: expected %d args, got %d" subject np nargs))))

; Indirect call of an already-emitted function-pointer value `fn-val`; arguments
; are node-at(arg-start)..end. Shared by the explicit `funcall` surface and the
; call position — a TY-FN value in head position folds to this, so `funcall` is
; effectively compiler-internal (callable-values.md §4.2).
(defn emit-funcall-value (n:(raw Node) scope:ref:Scope fn-val:(raw Val) arg-start:i32):ref:Val
  (let (cc:(raw Node) n
        fv:(raw Val) fn-val
        fn-type:(raw Type) (fv type)
        ret-type:(raw Type) (fn-type ret)
        nargs:i32 (- (node-len cc) arg-start))
    (check-call-arity "call" null fn-type nargs 0 (cc line))
    (let (arg-vals:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes)))
          i:i32 0)
      (while (< i nargs)
        (aset! (as ptr:ptr arg-vals) i (emit-node (node-at cc (+ i arg-start)) scope))
        (inc! i))
      (let (ret-ir:ptr (type-to-ir ret-type))
        (if (= (ret-type kind) TY-VOID)
          (do
            (fprintf g-body-stream "  call void %s(" (fv val))
            (set! i 0)
            (while (< i nargs)
              (when (!= i 0) (fprintf g-body-stream ", "))
              (let (av:(raw Val) (aref (as ptr:ptr arg-vals) i))
                (fprintf g-body-stream "%s %s" (type-to-ir (av type)) (av val)))
              (inc! i))
            (fprintf g-body-stream ")\n")
            (return (alloc-val ty-void null)))
          (let (tmp:ptr (new-tmp))
            (fprintf g-body-stream "  %s = call %s %s(" tmp ret-ir (fv val))
            (set! i 0)
            (while (< i nargs)
              (when (!= i 0) (fprintf g-body-stream ", "))
              (let (av:(raw Val) (aref (as ptr:ptr arg-vals) i))
                (fprintf g-body-stream "%s %s" (type-to-ir (av type)) (av val)))
              (inc! i))
            (fprintf g-body-stream ")\n")
            (return (alloc-val ret-type tmp))))))))

; (funcall fn-ptr args...) — general typed function pointer call.
; fn-ptr must have TY-FN type. Emits call with proper LLVM IR signature.
(defn emit-funcall (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (< (node-len cc) 2)
      (die-at (cc line) "funcall expects at least 1 arg"))
    (let (fn-val:ref:Val (emit-node (node-at cc 1) scope))
      (when (!= ((fn-val type) kind) TY-FN)
        (die-at (cc line) "funcall: first arg must be a function pointer"))
      (return (emit-funcall-value call scope fn-val 2)))))

(defn emit-deref (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 2) (die-at (cc line) "deref expects 1 arg"))
    (let (p:ref:Val (emit-node (node-at cc 1) scope))
      (when (or (!= ((p type) kind) TY-PTR)
              (= ((p type) elem) null))
        (die-at (cc line) "deref: operand must be typed pointer"))
      (require-derefable (p type) (cc line) "deref")
      (let (elem:(raw Type) ((p type) elem)
            tmp:ptr (new-tmp))
        (emit-load tmp (type-to-ir elem) (p val) elem)
        (return (alloc-val elem tmp))))))

(defn emit-ptr-set (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 3) (die-at (cc line) "ptr-set! expects 2 args"))
    (let (p:ref:Val (emit-node (node-at cc 1) scope))
      (when (or (!= ((p type) kind) TY-PTR)
              (= ((p type) elem) null))
        (die-at (cc line) "ptr-set!: operand must be typed pointer"))
      (require-derefable (p type) (cc line) "ptr-set!")
      (let (elem:(raw Type) ((p type) elem)
            v:ref:Val (emit-node (node-at cc 2) scope)
            coerced:ptr (coerce-int-val v elem (cc line)))
        (when (= coerced null)
          (die-at (cc line) "ptr-set!: value type mismatch"))
        (taint-store-check p v (cc line) "ptr-set!")
        (let (cv:ptr:Val (unsafe/cast ptr:Val coerced))
          (emit-store (type-to-ir elem) (cv val) (p val) elem)
          (return (alloc-val ty-void null)))))))

; Stage 12 N8: the tagged-sum / Maybe / error-handling codegen (the Maybe-
; transition and tagged-sum-construction-and-elimination sections) lives in
; union-emit.nuc, imported here at its original position. It depends on union-
; registry/generics (imported above) and on nucleusc.nuc emit helpers (resolved
; via the whole-unit prescan); its functions (emit-make/emit-match/union-target-
; rewrite/emit-not/emit-short-circuit/emit-ptr-add/…) are called by the emit-*
; dispatch that follows.
(import-use union-emit)

; TC-5 part 2 (int-widening.md LW-6 follow-up): emit-field-set lives here, after
; the union-emit import, specifically so its value expression can go through
; union-target-rewrite — a bare union-construction shorthand in `.set!`'s value
; position (`(.set! s f (some 5))`) needs the same target-typing let/with/return/
; if/cond/match value tails already get. Moved out of its original position
; (just after emit-field-load, above) because nucleusc.nuc's own whole-unit
; prescan makes a same-file forward call work regardless of order, but a
; not-yet-`import-use`d sibling file's functions are only registered once its
; import statement is textually reached — union-target-rewrite was unreachable
; from emit-field-set's original position, before this import.
(defn emit-field-set (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 4)
      (die-at (cc line) ".set! expects 3 args"))
    (let (p:ref:Val (emit-node (node-at cc 1) scope)
          pt:(raw Type) (p type)
          ek:i32 (if (and (= (pt kind) TY-PTR) (!= (pt elem) null))
                   ((pt elem) kind)
                   TY-VOID))
      (when (and (!= ek TY-STRUCT) (!= ek TY-UNION))
        (die-at (cc line) ".set!: operand must be pointer to struct or union"))
      (require-derefable pt (cc line) ".set!")
      (let (fn-node:(raw Node) (node-at cc 2))
        (when (!= (fn-node kind) NODE-SYM)
          (die-at (node-line (as ptr fn-node) (cc line)) ".set!: field name must be symbol"))
        (let (sd:(raw StructDef) ((pt elem) sdef)
              idx:i32 (struct-field-index sd (fn-node s)))
          (reject-cycle-pending-sdef sd (node-line (as ptr fn-node) (cc line))
                                     "field assignment")
          (union-field-guard sd (cc line) ".set!")
          (when (< idx 0)
            (die-at (node-line (as ptr fn-node) (cc line))
              (fmt-2s ".set!: no field '%s' on struct '%s'" (fn-node s) (sd name))))
          ; Stage 15 W8 G-2: an array field is not assignable as a whole, exactly
          ; as in C (`s.xs = …` is not an expression there either). Refuse here,
          ; before the RHS is emitted, rather than letting coerce-int-val answer
          ; with a generic "type mismatch" that does not say why.
          (reject-array-type ((field-at (sd fields) idx) type)
            (node-line (as ptr fn-node) (cc line))
            (fmt-s ".set!: field '%s'" (fn-node s)))
          (let (ftype:ptr ((field-at (sd fields) idx) type)
                ; TC-2: arm the want channel with the field's type so a generic
                ; constructor stored into a field infers a return-only tyvar.
                ; TC-5 part 2: also rewrite a bare union-construction shorthand
                ; (`(some 5)`/`(err e)`) against the field's type, same as
                ; let/with/return/if/cond/match value tails.
                v:ref:Val (let (save-want:ptr g-want-type)
                            (set! g-want-type ftype)
                            (let (vv:ref:Val (emit-node (union-target-rewrite (node-at cc 3) ftype) scope))
                              (set! g-want-type save-want)
                              vv))
                coerced:ptr (coerce-int-val v ftype (cc line)))
            (when (= coerced null)
              (die-at (cc line) (fmt-s ".set!: type mismatch for field '%s'" (fn-node s))))
            (taint-store-check p v (cc line) ".set!")
            (let (cv:ptr:Val (unsafe/cast ptr:Val coerced))
              ; Union member: typed store at offset 0, straight through the pointer.
              (if (= ek TY-UNION)
                (emit-store (type-to-ir ftype) (cv val) (p val) ftype)
                (let (gep:ptr (new-tmp))
                  (fprintf g-body-stream
                    "  %s = getelementptr inbounds %%%s, ptr %s, i32 0, i32 %d\n"
                    gep (sd ir-name) (p val) idx)
                  (emit-store (type-to-ir ftype) (cv val) gep ftype)))
              (return (alloc-val ty-void null)))))))))

; ============================================================
; Function calls
; ============================================================

(defn emit-call (call:(raw Node) scope:ref:Scope sym:ref:Sym):ref:Val
  (let (cc:(raw Node) call
        ss:ref:Sym sym
        ft0:(raw Type) (ss type)
        nargs:i32 (- (node-len cc) 1)
        max-args:i32 (- (node-len cc) 1))
    ; &optional callee: the arg buffer may need to grow up to num-params.
    (when (and (!= ft0 null) (= (ft0 kind) TY-FN))
      (when (> (ft0 num-params) max-args) (set! max-args (ft0 num-params))))
    ; Stage 15 W9 defect 12: the solitary-`defn` call path had NO arity check at
    ; all — `(f 1 2)` against a one-parameter `f` emitted `call i32 @f(i32 1,
    ; i32 2)` and linked. The overloaded path diagnoses it implicitly (a method
    ; only matches at `num-params == nargs`, so a wrong count falls out as "no
    ; matching method"); this path resolves the callee by NAME, so nothing ever
    ; compared the counts. Checked here, before any argument is emitted, so the
    ; diagnostic is the first thing reported and no argument's own errors mask
    ; it. `&rest` / `&optional` / a variadic `declare` are all admitted by the
    ; shared rule — the check is one CALL, not a second copy of the rule.
    (check-call-arity "call" (ss name) ft0 nargs (ss extern-decl) (cc line))
    ; Stage 10 escape analysis (lifecycle.md §2.3): manually freeing a
    ; with-owned binding double-frees — the armed cleanup also fires at scope
    ; exit. (free (move p)) is the sanctioned spelling: move disarms first.
    (when (and (= (strcmp (ss name) "free") 0) (= nargs 1))
      (let (tname:ptr (node-binding-name (node-at cc 1)))
        (when (!= tname null)
          (let (tsym:?ptr:Sym (scope-lookup scope tname))
            (when (and (!= tsym null) (!= (tsym owns) 0))
              (die-at (cc line)
                (fmt-2s "double free: '%s' is freed at `with` scope exit — use (move %s) to take ownership first" tname tname)))))))
    (let (args:ptr (arena-alloc (* (as i64 (+ max-args 1)) (sizeof Val)))
          i:i32 0)
      (while (< i nargs)
        (let (v:ref:Val (emit-node (node-at cc (+ i 1)) scope))
          (memcpy (unsafe/ptr+ (as ptr:Val args) i) v (sizeof Val)))
        (inc! i))
      ; Fill defaults for missing trailing &optional args, emitting each default
      ; expression in the caller's scope. The former `too few args` / `too many
      ; args` pair that stood here re-derived the &optional bounds; the shared
      ; `check-call-arity` above now owns that rule and has already rejected
      ; both, so `required <= nargs <= np` holds by the time we get here.
      (when (and (= (ft0 kind) TY-FN) (!= (ft0 nopt) 0))
        (let (np:i32 (ft0 num-params)
              required:i32 (- (ft0 num-params) (ft0 nopt)))
          (let (oi:i32 nargs)
            (while (< oi np)
              (let (default-node:ptr (aref (as ptr:ptr (ft0 opt-defaults)) (- oi required))
                    v:ref:Val (emit-node default-node scope))
                (memcpy (unsafe/ptr+ (as ptr:Val args) oi) v (sizeof Val)))
              (inc! oi))
            (set! nargs np))))
      (return (emit-call-with-args call scope sym args nargs)))))

; Emit a call given already-emitted argument Vals. Shared by the ordinary call
; path and the multimethod dispatch path (which must resolve the method from
; argument types before the call can be emitted). Handles &rest folding, the
; variadic signature, and void/non-void returns.
(defn emit-call-with-args (call:(raw Node) scope:ref:Scope sym:ref:Sym args:ptr nargs:i32):ref:Val
  (let (cc:(raw Node) call
        ss:ref:Sym sym
        i:i32 0)
    ; If the callee has &rest, fold trailing args into a runtime Node cons
    ; list and replace them with a single ptr arg pointing at the list.
    (let (eff-nargs:i32 nargs
          ft0:(raw Type) (ss type))
      (when (and (= (ft0 kind) TY-FN) (!= (ft0 has-rest) 0))
        (let (fixed:i32 (- (ft0 num-params) 1))
          (when (< nargs fixed)
            (die-at (cc line)
              (fmt-s "%s: too few args for &rest function" (ss name))))
          ; Build list right-to-left: prev = null; for i = nargs-1..fixed:
          ;   cell = make-cell(arg-as-ptr, prev, 0); prev = cell.
          (let (prev-name:ptr "null"
                ri:i32 nargs)
            (while (> ri fixed)
              (set! ri (- ri 1))
              (let (av:ptr:Val (as ptr:Val (unsafe/ptr+ (as ptr:Val args) ri))
                    av-val:ptr (av val)
                    aty:ptr:Type (unsafe/cast ptr:Type (av type)))
                ; Stage 14 NS-3: a string-literal &rest arg collapses to CStr so it
                ; folds into Node.car as a plain pointer — its `val` is already the
                ; bare data GEP, exactly as a CStr literal did before the flip (no
                ; inttoptr). Re-read the type after the in-place collapse.
                (collapse-strlit-cstr (as ptr av))
                (set! aty (unsafe/cast ptr:Type (av type)))
                ; A *materialized* (non-literal) StrView value is not collapsed by
                ; collapse-strlit-cstr (that only retypes the chameleon literal);
                ; its `val` is a real {ptr,len} aggregate that is-ptr-like rejects and
                ; the inttoptr below cannot take (inttoptr needs an integer operand,
                ; not a struct). Extract its `.data` pointer so it folds into Node.car
                ; as a plain char*, matching the literal path.
                (when (!= (type-is-strview (as ptr aty)) 0)
                  (let (d:ptr (new-tmp))
                    (fprintf g-body-stream "  %s = extractvalue %s %s, 0\n"
                      d (type-to-ir (as ptr aty)) av-val)
                    (set! av-val d)
                    (set! aty ty-ptr)))
                ; Coerce non-pointer values to ptr so they fit in Node.car
                ; (a CStr is already a pointer — no inttoptr).
                (when (= (is-ptr-like (as ptr aty)) 0)
                  (let (tmp:ptr (new-tmp))
                    (fprintf g-body-stream "  %s = inttoptr %s %s to ptr\n"
                      tmp (type-to-ir (as ptr aty)) av-val)
                    (set! av-val tmp)))
                (let (cell:ptr (new-tmp))
                  (fprintf g-body-stream
                    "  %s = call ptr @make-cell(ptr %s, ptr %s, i32 0)\n"
                    cell av-val prev-name)
                  (set! prev-name cell))))
            ; Place list ptr as the trailing arg slot at index `fixed`.
            (let (slot:ptr:Val (as ptr:Val (unsafe/ptr+ (as ptr:Val args) fixed)))
              (.set! slot type ty-ptr)
              (.set! slot val prev-name))
            (set! eff-nargs (+ fixed 1)))))
      ; Stage 8 implicit casts: coerce each fixed argument whose IR type differs
      ; from its parameter's via safe-coerce-val (int widen, f32→f64, defcast).
      ; When the IR types already match, or no safe conversion exists, the
      ; argument is left untouched — preserving the prior pass-through behavior.
      (let (ncoerce:i32 (ft0 num-params))
        (when (!= (ft0 has-rest) 0) (set! ncoerce (- (ft0 num-params) 1)))
        (when (> ncoerce eff-nargs) (set! ncoerce eff-nargs))
        (dotimes (ci ncoerce)
          (let (slot:ptr:Val (as ptr:Val (unsafe/ptr+ (as ptr:Val args) ci))
                             ptype:ptr ((field-at (ft0 params) ci) type))
              ; Stage 14 NS-3 (design/stage14/native-strings.md): materialize an
              ; unmaterialized StrView string literal that flows into a StrView-typed
              ; parameter. Its IR type already matches the parameter ("%StrView"),
              ; so the type-to-ir coercion guard below would skip it and pass the
              ; bare data pointer where a {ptr,len} view is expected; coerce-int-val
              ; builds the view. Dead for the compiler (no StrView params); a StrView
              ; literal into a ptr/CStr parameter is collapsed (no IR) by the guard's
              ; safe-coerce-val path instead.
              (when (and (!= (slot is-lit) 0)
                         (!= (type-is-strview (slot type)) 0)
                         (!= (type-is-strview ptype) 0))
                (let (nc:ptr (coerce-int-val (as ptr slot) ptype (cc line)))
                  (when (and (!= nc null) (!= nc (as ptr slot)))
                    (memcpy slot nc (sizeof Val)))))
              ; Stage 13 TE-3: a closure (ref Env) argument flowing into a
              ; BoxedFn-typed parameter is heap-boxed into the shared fat pointer
              ; BEFORE the CE-3 by-value normalization (which would otherwise see a
              ; pointer whose pointee != ptype and pass the raw env pointer). After
              ; boxing, slot holds the {data,vtable} value and the CE-3 block's
              ; TY-PTR guard is false, so abi-arg-frag lowers the box by value.
              ; Inert when ptype is not a box (the compiler never has one).
              ;
              ; Stage 15 B6: the argument position is a SECOND erased-slot
              ; coercion, not a caller of `maybe-box-into-slot` — so the
              ; already-a-box arm needs the identity check separately, and it
              ; needs it more, because here the SysV ABI decomposes the fat
              ; pointer into two words and even LLVM never sees the mismatch.
              ; Both arms call `box-require-same-kind` rather than restating it.
              (let (bcanon:ptr (boxedfn-canonical ptype))
                (when (!= bcanon null)
                  (let (vcanon:ptr (boxedfn-canonical (slot type)))
                    (if (!= vcanon null)
                      (box-require-same-kind vcanon bcanon (cc line))
                      (when (= ((slot type) kind) TY-PTR)
                        (let (boxed:ref:Val (emit-box-closure (as ptr slot) bcanon scope (cc line)))
                          (memcpy slot (as ptr boxed) (sizeof Val))))))))
              ; Stage 13 TE-6: symmetric path for a concrete value flowing into a
              ; `(dyn P)`-typed parameter — box it (the nominal value box) before the
              ; CE-3 normalization. Inert when ptype is not a dyn box.
              (let (dcanon:ptr (dyn-canonical ptype))
                (when (!= dcanon null)
                  (let (vcanon:ptr (dyn-canonical (slot type)))
                    (if (!= vcanon null)
                      (box-require-same-kind vcanon dcanon (cc line))
                      (when (= ((slot type) kind) TY-PTR)
                        (let (boxed:ref:Val (emit-box-value (as ptr slot) dcanon scope (cc line)))
                          (memcpy slot (as ptr boxed) (sizeof Val))))))))
              ; CE-3 (closure-enhancements.md §CE-3) fix (b), symmetric arg path:
              ; passing a struct *by value* — the parameter is a by-value struct
              ; (TY-STRUCT) but the argument is represented as a pointer to that
              ; struct (a struct literal's `(ref S)`, or a closure's `(ref Env)`).
              ; Load the struct bytes into a first-class value so abi-arg-frag
              ; lowers it byval/coerced per the ABI, instead of (abi-classify of a
              ; pointer being DIRECT) passing the raw pointer where the callee
              ; expects the aggregate. abi-arg-frag itself classifies on the arg
              ; type alone and cannot tell a by-value-struct arg from a pointer
              ; arg, so the normalization must happen here, where ptype is known.
              (when (and (= ((as ptr:Type ptype) kind) TY-STRUCT)
                         (= ((slot type) kind) TY-PTR)
                         (!= ((slot type) elem) null)
                         (!= (type-eq ((slot type) elem) ptype) 0))
                (let (fc:ptr (new-tmp))
                  (emit-load fc (type-to-ir ptype) (slot val) ptype)
                  (.set! slot type ptype)
                  (.set! slot val fc)))
              ; Stage 10: pointer-kind contract on arguments — raw/Maybe may
              ; not flow into a (ref T) parameter. Checked independently of IR
              ; coercion (all pointer flavors share the IR type `ptr`).
              (pkind-flow-check (slot type) ptype (cc line) "argument")
              (when (!= (strcmp (type-to-ir (slot type)) (type-to-ir ptype)) 0)
                (let (nc:ptr (safe-coerce-val (as ptr slot) ptype (cc line)))
                  (when (and (!= nc null) (!= nc (as ptr slot)))
                    (memcpy slot nc (sizeof Val))))))))
      (let (arglist:ptr (alloca i8 2048)
            apos:i64 0
            ; RV-6c: the callee's return lowering, needed HERE rather than only
            ; at the call emission below because an ABI-MEMORY return passes a
            ; hidden sret pointer in a0 — a register the arguments do not get.
            ; Reused verbatim by the non-variadic call path further down, so
            ; the return is still classified exactly once.
            call-ret-info:raw:AbiInfo (abi-classify (ft0 ret)))
        (aset! (as ptr:i8 arglist) 0 0)
        ; RV-6c: one walk over this call's arguments, in order — reset the
        ; riscv64 register budget before it (design/stage14/riscv-fp-abi.md §4).
        (abi-args-begin call-ret-info)
        (set! i 0)
        (while (< i eff-nargs)
        (let (av:ptr:Val (as ptr:Val (unsafe/ptr+ (as ptr:Val args) i))
              sep:ptr "")
          (when (!= i 0) (set! sep ", "))
          ; Stage 14 NS-3 (design/stage14/native-strings.md): a *materialized*
          ; StrView value flowing into a C variadic slot (index beyond a variadic
          ; callee's fixed params) must pass only its data pointer — a printf `%s`
          ; wants a char*, not the {ptr,len} pair as two INTEGER eightbytes (which
          ; would occupy two vararg slots and shift every later argument, leaking
          ; the byte length into the next conversion). This is the site that knows
          ; the fixed/variadic boundary: a fixed StrView PARAMETER (i < num-params)
          ; is passed by value (COERCE2) and is left untouched; a chameleon literal
          ; vararg is handled by abi-arg-frag's is-lit guard. So this collapses only
          ; a genuine StrView VALUE at a variadic position. Dead for the compiler
          ; (no materialized StrView reaches a vararg in src/), so byte-identical.
          ; RV-6c: mark the `...` boundary before this argument is classified —
          ; a variadic argument takes the integer convention (no FP registers,
          ; no flattening). Idempotent, so asserting it per trailing argument is
          ; the same as detecting the crossing exactly once.
          (when (and (!= (ft0 variadic) 0) (>= i (ft0 num-params)))
            (abi-args-varargs))
          (when (and (!= (ft0 variadic) 0)
                     (>= i (ft0 num-params))
                     (!= (type-is-strview (av type)) 0)
                     (= (av is-lit) 0))
            (let (d:ptr (new-tmp))
              (fprintf g-body-stream "  %s = extractvalue %s %s, 0\n"
                d (type-to-ir (av type)) (av val))
              (.set! av type ty-ptr)
              (.set! av val d)))
          ; abi-arg-frag returns "<ty> <val>" for scalars/pointers (unchanged),
          ; or the byval / register-coerced fragment for a struct-by-value arg
          ; (emitting the materialization instructions as a side effect).
          (let (w:i32 (snprintf (unsafe/ptr+ (as ptr:i8 arglist) apos)
                                (- (as i64 2048) apos)
                                "%s%s" sep
                                (abi-arg-frag (as ptr av))))
            (set! apos (+ apos (as i64 w)))))
        (inc! i))
      (let (ft:ptr:Type (unsafe/cast ptr:Type (ss type)))
        (when (!= (ft kind) TY-FN)
          (die-at (cc line) (fmt-s "not a function: %s" (ss name))))
        ; In a macro/CT JIT module, a call to an ordinary program-module defn
        ; needs a local `declare` (the symbol resolves from the -rdynamic host).
        (macro-jit-ensure-decl ss)
        (if (!= (ft variadic) 0)
          (do
            (let (sig:ptr (alloca i8 512)
                  sp:i64 0
                  w:i32 (snprintf sig (as i64 512) "%s (" (type-to-ir (ft ret))))
              (set! sp (as i64 w))
              (set! i 0)
              (while (< i (ft num-params))
                (let (pt:ptr ((field-at (ft params) i) type)
                      sep:ptr "")
                  (when (!= i 0) (set! sep ", "))
                  (set! w (snprintf (unsafe/ptr+ (as ptr:i8 sig) sp) (- (as i64 512) sp)
                                    "%s%s" sep (type-to-ir pt)))
                  (set! sp (+ sp (as i64 w))))
                (inc! i))
              (let (va-sep:ptr "")
                (when (!= (ft num-params) 0) (set! va-sep ", "))
                (snprintf (unsafe/ptr+ (as ptr:i8 sig) sp) (- (as i64 512) sp)
                          "%s...)" va-sep))
              (if (-> ft (_ ret) (unsafe/cast ptr:Type _) (_ kind) (= _ TY-VOID))
                (do
                  (fprintf g-body-stream "  call %s %s(%s)\n"
                    sig (ss ir-name) arglist)
                  ; Stage 10 Phase F1: noreturn callee — close the block.
                  (when (!= (ss noreturn) 0) (terminate-after-noreturn)))
                (let (tmp:ptr (new-tmp))
                  (fprintf g-body-stream "  %s = call %s %s(%s)\n"
                    tmp sig (ss ir-name) arglist)
                  (return (alloc-val (ft ret) tmp))))))
          (do
            (let (ret-info:ptr:AbiInfo (unsafe/cast ptr:AbiInfo call-ret-info))
              (if (!= ((as ptr:AbiInfo ret-info) kind) ABI-DIRECT)
                ; Struct return: emit the lowered call + reconstruction.
                (return (abi-emit-struct-call ret-info (ft ret) (ss ir-name)
                                              (as ptr arglist) eff-nargs))
                (if (-> ft (_ ret) (unsafe/cast ptr:Type _) (_ kind) (= _ TY-VOID))
                  (do
                    (fprintf g-body-stream "  call %s %s(%s)\n"
                      (type-to-ir (ft ret)) (ss ir-name) arglist)
                    ; Stage 10 Phase F1: noreturn callee — close the block.
                    (when (!= (ss noreturn) 0) (terminate-after-noreturn)))
                  (let (tmp:ptr (new-tmp))
                    (fprintf g-body-stream "  %s = call %s %s(%s)\n"
                      tmp (type-to-ir (ft ret)) (ss ir-name) arglist)
                    (return (alloc-val (ft ret) tmp))))))))
        (return (alloc-val ty-void null)))))))

; ============================================================
; Special forms
; ============================================================

; Recognize a libc allocator call as a binding init for `with`. Walks past
; (cast T <inner>) so that the typical (cast ptr:Node (malloc N)) idiom is
; detected. Purely syntactic — no type inference.
(defn is-libc-alloc (node:(raw Node)):i32
  (when (= node null) (return 0))
  (let (n:(raw Node) node)
    (when (!= (n kind) NODE-CELL) (return 0))
    (when (< (node-len node) 1) (return 0))
    (let (head:(raw Node) (node-at node 0))
      (when (!= (head kind) NODE-SYM) (return 0))
      (let (hp:(raw Node) head)
        (when (= hp 'cast)
          (when (>= (node-len node) 3)
            (return (is-libc-alloc (node-at node 2))))
          (return 0))
        (when (or (= hp 'malloc) (= hp 'calloc)) (return 1))
        (when (or (= hp 'realloc) (= hp 'strdup)) (return 1))
        (return 0)))))

; The drop method to arm for a with-binding of declared type `ty` (lifecycle.md
; §5): ty must be a pointer to a struct that conforms to the Drop protocol
; (recorded by `extend <S> Drop`), and the `drop` generic must resolve exactly
; on [ty]. Returns the Method*, or null when the binding is not Drop-managed.
; type-eq ignores pointer kinds, so (ref S) resolves the same method as (ptr S).
;
; A `drop` defined over a *parametric* struct template (`(defn drop:void
; ((v (ptr (Vec T)))))`) is a METHOD-GENERIC, which generic-find-method-exact
; (METHOD-USER only) cannot see. After the Drop conformance is confirmed for the
; concrete instance, fall through to generic-resolve, which binds the template's
; tyvars to the concrete instance and instantiates the per-instance monomorph
; (real ir-name + queued MonoJob) so emit-drop-cleanup can call it directly —
; exactly how an ordinary `(drop v)` call on the stamped instance would resolve.
; Resolve the Drop method to arm for a with-binding of type `ty`, or null if the
; binding is not an owning Drop type. Two binding shapes own a Drop resource:
;   - TY-PTR to a Drop struct — the `ptr:Res` idiom; the slot holds the resource
;     pointer and the drop receiver is that same pointer type.
;   - CE-3 (closure-enhancements.md §CE-3) fix (c): a struct-VALUE binding whose
;     struct conforms to Drop — an owning closure exported by value (its env is a
;     by-value TY-STRUCT), or a hand-written owning struct value. The drop method
;     always takes a *pointer* to the struct (self:ptr:S), so the generic is
;     queried with a synthesized (ref S) whose elem is this struct (type-eq on a
;     TY-PTR compares only the pointee, so pkind is immaterial). emit-with arms
;     the cleanup against a handle pointing at the binding's stack slot, so the
;     existing pointer-shaped emit-drop-cleanup / move-disarm path is reused
;     verbatim — the same `owns=1` that lets emit-move consume a struct-value
;     capture into an `mfn`.
(defn with-drop-method (ty:(raw Type)):?ptr:Method
  ; Stage 13 TE-4: a BoxedFn box is Drop-conforming via the shared @__boxedfn_drop
  ; thunk (vtable.drop(data) + free), which is NOT registered on the `drop` generic
  ; (it is hand-emitted by ensure-box-drop-fn at box-construction time). Short-
  ; circuit with a synthetic Method carrying that symbol so emit-with arms the
  ; box's scope-exit drop through the normal cleanup path. Inert for any non-box ty.
  (let (bdt:ptr (boxedfn-drop-target ty))
    (when (!= bdt null)
      (let (m:ref:Method (new Method))
        (.set! m ir-name "@__boxedfn_drop")
        (.set! m ret-type ty-void)
        (.set! m kind METHOD-USER)
        (.set! m num-params 1)
        (return m))))
  (let (tt:(raw Type) ty
        sd:(raw StructDef) null
        qty:(raw Type) null)
    (cond
      (= (tt kind) TY-PTR)
        (do
          (when (= (tt elem) null) (return null))
          (let (et:(raw Type) (tt elem))
            (when (!= (et kind) TY-STRUCT) (return null))
            (set! sd (et sdef))
            (set! qty ty)))
      (= (tt kind) TY-STRUCT)
        (let (pt:ref:Type (make-type TY-PTR))
          (.set! pt elem tt)
          (.set! pt pkind PTR-REF)
          (set! sd (tt sdef))
          (set! qty pt))
      true (return null))
    (when (= sd null) (return null))
    (when (= (conformance-lookup (sd name) "Drop") 0) (return null))
    (let (g:(raw Generic) (generic-lookup "drop"))
      (when (= g null) (return null))
      (let (argtypes:ptr (arena-alloc (ptr-bytes)))
        (aset! (as ptr:ptr argtypes) 0 qty)
        (let (exact:?ptr:Method (generic-find-method-exact g argtypes 1))
          (when (!= exact null) (return exact))
          ; Parametric drop (METHOD-GENERIC): resolve+instantiate for this
          ; concrete instance. The conformance check above guarantees a drop
          ; exists, so generic-resolve will not die.
          (return (generic-resolve g argtypes null 1 0 null)))))))

; unions.md §7: the name of the first defunion arm holding a Drop-conforming
; payload field (a pointer to a struct that conforms to Drop), or null.
; Dropping such a union is a tag switch on the live arm; until the compiler
; emits that switch, a with-managed union with Drop-conforming arms is
; rejected unless the union itself conforms to Drop (the manual tag switch).
(defn union-drop-arm (ud:(raw UnionDef)):ptr
  (let (udd:(raw UnionDef) ud)
    (dotimes (i (udd num-arms))
      (let (arm:ref:Arm (invoke (udd arms) (as usize i))
            nf:i32 (arm nfields)
            ftypes:ptr (arm ftypes))
        (dotimes (j nf)
          (let (ft:(raw Type) (aref (as ptr:ptr ftypes) j))
            (when (and (= (ft kind) TY-PTR) (!= (ft elem) null))
              (let (et:(raw Type) (ft elem))
                (when (and (= (et kind) TY-STRUCT)
                           (!= (et sdef) null)
                           (!= (conformance-lookup
                                ((et sdef) name) "Drop") 0))
                  (return (arm name)))))))))
    (return null)))

; (defer expr) — register expr as an ad-hoc cleanup on the enclosing binding
; scope (nearest let/with/function body), re-emitted at every exit path in
; reverse registration order. Lexical, not dynamic: the cleanup runs at scope
; exit whether or not control reached the defer site at runtime.
(defn emit-defer (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call)
    (when (!= (node-len cc) 2) (die-at (cc line) "defer expects 1 expression"))
    (let (cl:ref:Cleanup (new Cleanup))
      (ptr-set! cl (Cleanup-defer (node-at cc 1) scope))
      (scope-push-cleanup scope cl)
      (return (alloc-val ty-void null)))))

; ============================================================
; Stage 13 — lambdas / closures (design/stage13/lambda.md)
; ============================================================
; The four forms (`fn`/`vfn`/`mfn`/`cfn`) share one capture-analysis pass and a
; lambda-lifting step. L3 implements the non-capturing `fn`: it rejects ANY
; reference to an enclosing runtime local and lifts its body to a fresh top-level
; defn, decaying to that function's pointer. The capture classifier below is
; factored so L4 (`vfn`) and the later forms can reuse it to *collect* captures
; rather than reject them.

(defvar g-fn-lift-id:i32 0)

; Bound-name set used by the capture walker: a Node-based string list (reusing
; import-list-push to cons a NODE-STR cell whose `s` is the bare name). Names
; arrive from node-binding-name (arena-strdup'd, not interned), so membership is
; by strcmp rather than the pointer `=` import-list-has uses.
(defn fn-bound-has (list:(raw Node) name:CStr):i32
  (let (cur:(raw Node) list)
    (while (!= cur null)
      (let (entry:(raw Node) cur)
        (when (= (strcmp (entry s) name) 0) (return 1))
        (set! cur (entry cdr))))
    (return 0)))

; Add every binding name introduced by a let/with binding list (the even-indexed
; name slots) to `bound`, returning the extended list. The init expressions are
; NOT walked here — the caller walks them in the pre-binding scope so a capture in
; an init form is still caught.
(defn fn-bind-let-names (binds:(raw Node) bound:(raw Node)):(raw Node)
  (let (i:i32 0
        acc:ptr bound)
    (while (< i (node-len binds))
      (let (bn:ptr (node-binding-name (node-at binds i)))
        (when (!= bn null) (set! acc (import-list-push acc bn))))
      (set! i (+ i 2)))
    (return acc)))

; Add a lambda form's own parameter names to `bound`, returning the extended
; list. `params` is the parameter list node (index 1 of an fn/vfn/mfn/cfn form).
(defn fn-bind-param-names (params:(raw Node) bound:(raw Node)):(raw Node)
  (let (acc:ptr bound)
    (dotimes (i (node-len params))
      (let (pn:ptr (node-binding-name (node-at params i)))
        (when (!= pn null) (set! acc (import-list-push acc pn)))))
    (return acc)))

; True if `head` (a symbol string) names one of the lambda forms, whose first
; sub-form (index 1) is a parameter list whose names bind in its body. `cfn` is
; the exception: its index-1 operand is the allocator and the param list is at
; index 2 — handled at the call site.
(defn fn-is-lambda-head (head:CStr):i32
  (when (= (strcmp head "fn") 0) (return 1))
  (when (= (strcmp head "vfn") 0) (return 1))
  (when (= (strcmp head "mfn") 0) (return 1))
  (return 0))

; Free-variable / capture walker. Descends `node` and, for every symbol that is
; a free variable reference resolving to an *enclosing runtime local* (a let/with
; binding or a by-value parameter — Sym.is-local != 0) in `scope`, takes one of
; two actions depending on `cap-box`:
;
;   * cap-box == null — REJECT mode (`fn`): dies with a directed error pointing
;     the author at vfn/mfn/cfn (L3, the non-capturing form).
;   * cap-box != null — COLLECT mode (`vfn`/`mfn`/`cfn`): `cap-box` is a one-slot
;     box (ptr to a ptr) holding the head of a NODE-STR capture-name list; each
;     newly-seen captured local's *bare* name is consed on (deduped against the
;     names already collected), so the caller gets the unique set of captured
;     enclosing-locals in the body. The Sym (type/is-local) is recovered at emit
;     time via scope-lookup, so only the name is retained here.
;
; `bound` accumulates the names that are bound *inside* the lambda body (its own
; params plus any nested let/with/lambda bindings), which are therefore not
; captures.
;
; A symbol that resolves to a top-level name (Sym.is-local == 0 — a defn, global
; defvar, or defconst) is an ordinary global reference, not capture. A symbol
; that does not resolve at all (a not-yet-defined forward reference, or a name
; that is only meaningful in a non-value position) is left for the real emit to
; diagnose. Positions that are NOT value references are skipped so a field name
; or quoted datum that happens to collide with an enclosing local is not
; mis-flagged: quoted forms, and the field-name operand of `.`/`_get`/`.&`/
; `.set!`.
(defn fn-capture-walk (node:(raw Node) scope:ref:Scope bound:(raw Node) cap-box:ptr:ptr line:i32):void
  (when (= node null) (return))
  (let (nn:(raw Node) node)
    ; A bare symbol in value position: classify it.
    (when (= (nn kind) NODE-SYM)
      (let (name:ptr null
            ti:ptr null)
        (split-typed (nn s) (as ptr:ptr (addr-of name)) (as ptr:ptr (addr-of ti)))
        ; null/true/false/none and the like are self-evaluating, never locals.
        (when (= name null) (return))
        (when (!= (fn-bound-has bound name) 0) (return))
        (if-some (sym (scope-lookup scope name))
          (when (!= (sym is-local) 0)
            (if (= cap-box null)
              ; REJECT mode (`fn`).
              (die-at line
                (fmt-s "`fn` cannot capture runtime local '%s'; use vfn (clone), mfn (move), or cfn (reference)"
                       name))
              ; COLLECT mode (`vfn`/`mfn`/`cfn`): record the capture once.
              (let (head:ptr (deref cap-box))
                (when (= (fn-bound-has head name) 0)
                  (ptr-set! cap-box (import-list-push head name))))))
          0))
      (return))
    (when (!= (nn kind) NODE-CELL) (return))
    (let (hd:ptr:Node (unsafe/cast ptr:Node (node-at node 0)))
      ; A non-symbol head (e.g. ((mk) 3)) — walk every element generically.
      (when (or (= (as ptr hd) null) (!= (hd kind) NODE-SYM))
        (dotimes (i (node-len node))
          (fn-capture-walk (node-at node i) scope bound cap-box line))
        (return))
      (let (h:ptr (hd s))
        ; Quoted data: the symbols inside are not variable references.
        (when (or (= (strcmp h "quote") 0) (= (strcmp h "quasiquote") 0))
          (return))
        ; Field access: index-2 operand is a literal field name, not a value.
        (when (or (= (strcmp h ".") 0)
                  (= (strcmp h "_get") 0)
                  (= (strcmp h ".&") 0))
          (fn-capture-walk (node-at node 1) scope bound cap-box line)
          (return))
        (when (= (strcmp h ".set!") 0)
          (fn-capture-walk (node-at node 1) scope bound cap-box line)
          (fn-capture-walk (node-at node 3) scope bound cap-box line)
          (return))
        ; let / with: init expressions evaluate in the pre-binding scope (a
        ; capture there is still a capture); the body sees the extended set.
        (when (or (= (strcmp h "let") 0) (= (strcmp h "with") 0))
          (let (binds:ptr (node-at node 1))
            (when (!= (node-is-list binds) 0)
              (let (bi:i32 1)
                (while (< bi (node-len binds))
                  (fn-capture-walk (node-at binds bi) scope bound cap-box line)
                  (set! bi (+ bi 2))))
              (let (inner-bound:ptr (fn-bind-let-names binds bound)
                    j:i32 2)
                (while (< j (node-len node))
                  (fn-capture-walk (node-at node j) scope inner-bound cap-box line)
                  (inc! j)))))
          (return))
        ; Nested lambda: its own params bind in its body. A reference inside the
        ; inner lambda to one of OUR enclosing locals is a transitive capture —
        ; the inner lambda captures it from us, and we capture it from our
        ; enclosing scope — so it must still be collected/rejected here (cap-box
        ; threads through). We only avoid flagging the inner lambda's own params.
        (when (!= (fn-is-lambda-head h) 0)
          (let (params:ptr (node-at node 1))
            (when (!= (node-is-list params) 0)
              (let (inner-bound:ptr (fn-bind-param-names params bound)
                    j:i32 2)
                (while (< j (node-len node))
                  (fn-capture-walk (node-at node j) scope inner-bound cap-box line)
                  (inc! j)))))
          (return))
        ; Ordinary form: the head symbol is a call/special-form name, not a value
        ; reference, so skip it; walk every argument.
        (let (i:i32 1)
          (while (< i (node-len node))
            (fn-capture-walk (node-at node i) scope bound cap-box line)
            (inc! i)))))))

; L3 reject-mode entry point (`fn`): rejects any enclosing-local capture. A thin
; wrapper over the shared walker with a null capture box.
(defn fn-capture-check (node:(raw Node) scope:ref:Scope bound:(raw Node) line:i32):void
  (fn-capture-walk node scope bound (unsafe/cast ptr:ptr null) line))

; Parse a lambda return-type operand. The reader lexes a colon-led atom (`:i32`)
; as a NODE-KEYWORD carrying the bare type name, so the natural `(fn (x:i32):i32
; …)` spelling lands the return type as a keyword at index 2. A space-separated
; bare type symbol or a parenthesised list-form type (`(ref T)`, per the
; colon-paren caveat) are also accepted.
(defn fn-parse-ret-type (node:(raw Node) line:i32):(raw Type)
  (when (= node null) (return ty-void))
  (let (nn:(raw Node) node)
    (when (= (nn kind) NODE-KEYWORD) (return (parse-type-name (nn s) line)))
    (when (= (nn kind) NODE-SYM) (return (parse-type-from-node node line)))
    (when (= (nn kind) NODE-CELL) (return (parse-type-from-node node line)))
    (die-at line "fn: malformed return type")))

; Stage 13 L3: emit an anonymous function `(fn (params):ret body…)`.
;
;   1. Parse the parameter list and return type exactly like a defn.
;   2. Run the capture check: reject any reference to an enclosing runtime local.
;   3. Lambda-lift — synthesize a fresh top-level `(defn <lifted> (params):ret
;      body…)` node and queue it on the mono worklist so drain-mono-worklist
;      emits the body (and registers the symbol) after the current top-level form
;      (assumption 5, lambda-prompt L0).
;   4. The value of the expression is the lifted function's pointer — exactly the
;      Val a bare defn name decays to in emit-symbol-ref (a TY-FN global yields
;      `(alloc-val type ir-name)`).
(defn emit-fn (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:(raw Node) call
        line:i32 (call line))
    (when (< (node-len cc) 4)
      (die-at line "fn: expects (fn (params):ret body…)"))
    (let (params-node:ptr (node-at cc 1)
          ret-node:ptr (node-at cc 2))
      (when (= (node-is-list params-node) 0)
        (die-at line "fn: params must be a list"))
      ; Capture analysis over the body. The fn's own parameters are bound; any
      ; free symbol resolving to an enclosing runtime local is rejected.
      (let (bound:ptr (fn-bind-param-names params-node null)
            bi:i32 3)
        (while (< bi (node-len cc))
          (fn-capture-check (node-at cc bi) scope bound line)
          (inc! bi)))
      ; Parse the param types/names (mirrors emit-defn's required-param path; the
      ; lambda forms take only plain required params — no &rest/&optional).
      (let (nparams:i32 (node-len params-node)
            ret:ptr (fn-parse-ret-type ret-node line)
            param-types:ptr null
            param-names:ptr null)
        (when (> nparams 0)
          (set! param-types (arena-alloc (* (as i64 nparams) (ptr-bytes))))
          (set! param-names (arena-alloc (* (as i64 nparams) (ptr-bytes)))))
        (dotimes (pi nparams)
          (let (pname:ptr null
                          pty:ptr (extract-name-and-type (node-at params-node pi)
                                                         (as ptr:ptr (addr-of pname))
                                                         (node-line (node-at params-node pi) line)))
            (when (= pty null)
                  (die-at line (fmt-s "fn: missing :type on param '%s'" pname)))
            (aset! (as ptr:ptr param-types) pi pty)
            (aset! (as ptr:ptr param-names) pi pname)))
        ; Fresh IR-legal lifted name (no `!`/`?`; routed through sanitize-for-ir
        ; for safety). Deterministic counter rather than runtime gensym so the
        ; name is stable across the analysis.
        (let (lifted:ptr (sanitize-for-ir (fmt-i32 "__fn_lift_%d" g-fn-lift-id)))
          (inc! g-fn-lift-id)
          ; The expression's value is the lifted function's pointer, built
          ; directly: a TY-FN global decays in emit-symbol-ref to
          ; `(alloc-val type ir-name)`, so we construct that Val here without a
          ; scope binding. The drain's emit-defn registers the symbol and computes
          ; the identical ir-name (`@<lifted>` — defn-ir-name's solitary form, the
          ; identity under the user namespace), so the value matches the define.
          (let (ft:ptr:Type (as ptr:Type (make-type TY-FN)))
            (.set! ft ret ret)
            (type-set-params ft param-types nparams)
            (.set! ft variadic 0)
            (.set! ft has-rest 0)
            (.set! ft nopt 0)
            (.set! ft opt-defaults null)
            (let (irn:ptr (defn-ir-name lifted param-types nparams))
              ; Synthesize the new-style (defn <lifted> (params) <ret> body…) by
              ; consing the defn keyword, the bare lifted name, the params node,
              ; and the return operand onto the fn form's body tail. The return
              ; type is a standalone NODE-SYM operand (`fn-parse-ret-type` accepts
              ; a bare type name); its spelling is exactly `(type-spelling ret)`.
              ; Body tail: the cons cell whose car is the first body form. The fn
              ; form is (fn . (params . (ret . body…))), so the body sublist is
              ; the cdr of the cdr of the cdr of the head cell.
              (let (defn-sym:ptr (as ptr (intern-symbol "defn"))
                    name-sym:ptr (as ptr (intern-symbol lifted))
                    ret-node:ptr (as ptr (intern-symbol (type-spelling ret)))
                    body-list:ptr (-> cc (_ cdr) (_ cdr) (_ cdr))
                    after-ret:ptr (make-cell ret-node body-list line)
                    after-params:ptr (make-cell params-node after-ret line)
                    after-name:ptr (make-cell name-sym after-params line)
                    defn-form:ptr (make-cell defn-sym after-name line)
                    job:ptr:MonoJob (new MonoJob))
                (.set! job form defn-form)
                (.set! job context
                       (fmt-2s-i "while emitting lambda %s (defined at %s:%d)"
                                 lifted g-source-path line))
                (conj g-mono-worklist job)
                ; The expression's value: the lifted function pointer.
                (return (alloc-val (as ptr ft) irn))))))))))

; ============================================================
; Stage 13 L4 — closure environment + `invoke`, and `vfn`
; ============================================================
; A capturing closure lowers to an anonymous by-value struct (one field per
; captured enclosing-local) plus an `invoke` method of the closure's natural
; arity. Callable-values routes `(c arg…)` to `invoke` on the mere existence of
; an `invoke` method (emit-callable-value), so the closure needs no new call
; form. `vfn` populates each field by *clone* (the source survives): a POD
; capture is a bitwise copy (the env owns nothing, no Drop) and an owning (Drop)
; capture is a deep clone (the env owns the copy, so the env conforms to Drop
; with a synthesized field-wise drop). L5 (`mfn`) and L6 (`cfn`) reuse the same
; env/invoke/drop machinery; only the per-field population mode differs.

(defvar g-vfn-env-id:i32 0)

; Force a generic to dispatch by argument type (mangled), used after adding a
; synthesized closure method (`invoke`/`drop`) to a generic that may otherwise be
; SOLITARY. A solitary generic keeps an unmangled `@name` and emit-defn installs
; a bare `@name` scope binding for *each* of its defns; adding the closure method
; as a second method would make emit-defn re-bind `@name` to the closure method,
; hijacking every call to the original solitary method. Setting `mangled` + a
; final `finalized` makes emit-dispatch route through generic-resolve (by type)
; and stops emit-defn from installing the bare binding. Existing methods keep
; their already-assigned ir-names — a solitary method's `@name` define still
; matches its `@name` calls (now reached by type resolution), and the closure
; method uses its own mangled name — so no already-emitted symbol is renamed.
; The closest precedent is finalize-generics' overloaded branch, minus the
; re-mangle (which would rename an already-emitted solitary define).
(defn fn-force-generic-mangled (gname:CStr):void
  (let (g:ptr (generic-lookup gname))
    (when (!= g null)
      (let (gg:ptr:Generic (as ptr:Generic g))
        (.set! gg mangled 1)
        (.set! gg finalized 1)))))

; The number of captures collected into the NODE-STR list `caps`.
(defn fn-caps-count (caps:(raw Node)):i32
  (let (n:i32 0
        cur:(raw Node) caps)
    (while (!= cur null)
      (inc! n)
      (set! cur (cur cdr)))
    (return n)))

; Depth of a Scope* in the lexical chain (root = 1). Used by the cfn region
; join (L6) to pick the innermost (most-recently-entered, first-to-exit) region
; among a set of capture taints — the strongest constraint, matching the L1
; escape sink's direction (lambda.md §"Lifetime and escape analysis": an escape
; is rejected when the destination outlives the source's region; the innermost
; region is exited first, so joining it makes the closure escape-earliest).
(defn scope-depth (s:(raw Scope)):i32
  (let (d:i32 0
        cur:(raw Scope) s)
    (while (!= cur null)
      (inc! d)
      (set! cur (cur parent)))
    (return d)))

; Construct a NODE-INT literal node (arena zero-fills, so kind defaults to
; NODE-INT = 0; set it explicitly + the i64 payload). Used to synthesize the
; integer literal for the allocator align argument in the cfn env drop body.
(defn fn-make-int-node (v:i64):ptr
  (let (n:ref:Node (alloc-node))
    (.set! n kind NODE-INT)
    (.set! n i v)
    (return (as ptr n))))

; Rewrite the lambda body so every reference to a captured enclosing-local
; `name` becomes a field access `(. self name)` on the closure environment.
; Mirrors fn-capture-walk's position discipline exactly: a name in `bound`
; (the lambda's own params / a nested let/with/lambda binding) is left alone, a
; field-name operand of `.`/`_get`/`.&`/`.set!` is not a value reference, and
; quoted data is opaque. `caps` is the collected capture-name list; a symbol is
; rewritten iff it is in `caps` and not shadowed by `bound`. Returns a new Node
; tree (structure-sharing where nothing was rewritten).
(defn fn-rewrite-captures (node:(raw Node) caps:(raw Node) bound:(raw Node) self-sym:(raw Node) line:i32 mode:i32):ptr
  (when (= node null) (return null))
  (let (nn:(raw Node) node)
    ; A bare symbol: rewrite to (. self name) iff it is a (non-shadowed) capture.
    (when (= (nn kind) NODE-SYM)
      (let (name:ptr null
            ti:ptr null)
        (split-typed (nn s) (as ptr:ptr (addr-of name)) (as ptr:ptr (addr-of ti)))
        (when (= name null) (return node))
        (when (!= (fn-bound-has bound name) 0) (return node))
        (when (and (= ti null) (!= (fn-bound-has caps name) 0))
          ; A capture reference rewrites to a field access on `self`. mode 2
          ; (cfn): the env field holds a POINTER into the captured local, so a
          ; value use reads through it — (deref (. self name)). mode 0/1
          ; (vfn/mfn): the field holds the value — (. self name).
          (if (= mode 2)
            (let (field-access:ptr
                    (make-cell (as ptr (intern-symbol "."))
                      (make-cell self-sym
                        (make-cell (as ptr (intern-symbol name)) null line)
                        line)
                      line))
              (return (make-cell (as ptr (intern-symbol "deref"))
                        (make-cell field-access null line)
                        line)))
            (return (make-cell (as ptr (intern-symbol "."))
                      (make-cell self-sym
                        (make-cell (as ptr (intern-symbol name)) null line)
                        line)
                      line)))))
      (return node))
    (when (!= (nn kind) NODE-CELL) (return node))
    (let (hd:ptr:Node (unsafe/cast ptr:Node (node-at node 0)))
      ; Non-symbol head — rewrite every element.
      (when (or (= (as ptr hd) null) (!= (hd kind) NODE-SYM))
        (return (fn-rewrite-list node 0 caps bound self-sym line mode)))
      (let (h:ptr (hd s))
        ; Quoted data is opaque.
        (when (or (= (strcmp h "quote") 0) (= (strcmp h "quasiquote") 0))
          (return node))
        ; addr-of a capture: `(addr-of cap)` takes the address of the by-value
        ; local. Inside the closure that local lives as an env field. mode 0/1
        ; (vfn/mfn): the address is `(.& self cap)` (the field's address) —
        ; addr-of's target must be a binding name, and a field load is an rvalue.
        ; mode 2 (cfn): the field ALREADY holds the captured local's address, so
        ; `(addr-of cap)` == `(. self cap)` (no extra indirection). A non-capture
        ; / shadowed operand keeps the ordinary addr-of.
        (when (and (= (strcmp h "addr-of") 0) (= (node-len node) 2))
          (let (opnode:ptr:Node (unsafe/cast ptr:Node (node-at node 1)))
            (when (= (opnode kind) NODE-SYM)
              (let (oname:ptr null
                    oti:ptr null)
                (split-typed (opnode s) (as ptr:ptr (addr-of oname)) (as ptr:ptr (addr-of oti)))
                (when (and (!= oname null)
                           (= (fn-bound-has bound oname) 0)
                           (!= (fn-bound-has caps oname) 0))
                  (if (= mode 2)
                    (return (make-cell (as ptr (intern-symbol "."))
                              (make-cell self-sym
                                (make-cell (as ptr (intern-symbol oname)) null line)
                                line)
                              line))
                    (return (make-cell (as ptr (intern-symbol ".&"))
                              (make-cell self-sym
                                (make-cell (as ptr (intern-symbol oname)) null line)
                                line)
                              line))))))))
        ; Field access: index-2 operand is a literal field name; rewrite only the
        ; subject (index 1) and rebuild around the verbatim field name.
        (when (or (= (strcmp h ".") 0)
                  (= (strcmp h "_get") 0) (= (strcmp h ".&") 0))
          (let (subj:ptr (fn-rewrite-captures (node-at node 1) caps bound self-sym line mode))
            (return (make-cell (as ptr hd)
                      (make-cell subj
                        (make-cell (node-at node 2) null line)
                        line)
                      line))))
        (when (= (strcmp h ".set!") 0)
          (let (subj:ptr (fn-rewrite-captures (node-at node 1) caps bound self-sym line mode)
                val:ptr (fn-rewrite-captures (node-at node 3) caps bound self-sym line mode))
            ; Stage 15 W9 defect 12 (found by the new arity check): the OUTER
            ; make-cell was missing its `line` argument, so the rewritten
            ; `.set!` cell of a closure capture took an uninitialized register
            ; as its line. Every sibling cell here passes `line`.
            (return (make-cell (as ptr hd)
                      (make-cell subj
                        (make-cell (node-at node 2)
                          (make-cell val null line)
                          line)
                        line)
                      line))))
        ; set! on a captured name: rewrite to a field store so that mutations
        ; of the capture persist across invoke calls (mode 0/1) or write back
        ; through the captured pointer (mode 2 cfn).
        ; (set! c v) -> mode 0/1: (.set! self c (rewrite v))
        ;           -> mode 2:   (ptr-set! (. self c) (rewrite v))
        ; A set! whose target is NOT a capture falls through to the generic
        ; rewrite, which leaves the target symbol verbatim (correct).
        (when (and (= (strcmp h "set!") 0) (= (node-len node) 3))
          (let (tgt:ptr:Node (unsafe/cast ptr:Node (node-at node 1)))
            (when (= (tgt kind) NODE-SYM)
              (let (cname:ptr null
                    cti:ptr null)
                (split-typed (tgt s)
                             (as ptr:ptr (addr-of cname))
                             (as ptr:ptr (addr-of cti)))
                (when (and (!= cname null)
                           (= (fn-bound-has bound cname) 0)
                           (!= (fn-bound-has caps cname) 0))
                  (let (val-rw:ptr (fn-rewrite-captures (node-at node 2) caps bound self-sym line mode)
                        cname-sym:ptr (as ptr (intern-symbol cname))
                        field-access:ptr
                          (make-cell (as ptr (intern-symbol "."))
                            (make-cell self-sym
                              (make-cell cname-sym null line)
                              line)
                            line))
                    (if (= mode 2)
                      (return (make-cell (as ptr (intern-symbol "ptr-set!"))
                                (make-cell field-access
                                  (make-cell val-rw null line)
                                  line)
                                line))
                      (return (make-cell (as ptr (intern-symbol ".set!"))
                                (make-cell self-sym
                                  (make-cell cname-sym
                                    (make-cell val-rw null line)
                                    line)
                                  line)
                                line)))))))))
        ; inc!/dec! on a captured name: read-modify-write through the env field.
        ; (inc! c) -> mode 0/1: (.set! self c (+ (. self c) 1))
        ;         -> mode 2:   (ptr-set! (. self c) (+ (deref (. self c)) 1))
        ; (dec! uses - instead of +). A non-captured target falls through.
        (when (and (or (= (strcmp h "inc!") 0) (= (strcmp h "dec!") 0))
                   (= (node-len node) 2))
          (let (tgt:ptr:Node (unsafe/cast ptr:Node (node-at node 1)))
            (when (= (tgt kind) NODE-SYM)
              (let (cname:ptr null
                    cti:ptr null)
                (split-typed (tgt s)
                             (as ptr:ptr (addr-of cname))
                             (as ptr:ptr (addr-of cti)))
                (when (and (!= cname null)
                           (= (fn-bound-has bound cname) 0)
                           (!= (fn-bound-has caps cname) 0))
                  (let (op-sym:ptr (if (= (strcmp h "inc!") 0)
                                     (as ptr (intern-symbol "+"))
                                     (as ptr (intern-symbol "-")))
                        cname-sym:ptr (as ptr (intern-symbol cname)))
                    (if (= mode 2)
                      (let (fa1:ptr
                              (make-cell (as ptr (intern-symbol "."))
                                (make-cell self-sym
                                  (make-cell cname-sym null line)
                                  line)
                                line)
                            fa2:ptr
                              (make-cell (as ptr (intern-symbol "."))
                                (make-cell self-sym
                                  (make-cell cname-sym null line)
                                  line)
                                line)
                            deref-node:ptr
                              (make-cell (as ptr (intern-symbol "deref"))
                                (make-cell fa2 null line)
                                line)
                            arith:ptr
                              (make-cell op-sym
                                (make-cell deref-node
                                  (make-cell (fn-make-int-node 1) null line)
                                  line)
                                line))
                        (return (make-cell (as ptr (intern-symbol "ptr-set!"))
                                  (make-cell fa1
                                    (make-cell arith null line)
                                    line)
                                  line)))
                      (let (read-field:ptr
                              (make-cell (as ptr (intern-symbol "."))
                                (make-cell self-sym
                                  (make-cell cname-sym null line)
                                  line)
                                line)
                            arith:ptr
                              (make-cell op-sym
                                (make-cell read-field
                                  (make-cell (fn-make-int-node 1) null line)
                                  line)
                                line))
                        (return (make-cell (as ptr (intern-symbol ".set!"))
                                  (make-cell self-sym
                                    (make-cell cname-sym
                                      (make-cell arith null line)
                                      line)
                                    line)
                                  line))))))))))
        ; let / with: init exprs see the outer set; the body sees `bound`
        ; extended by the new binding names (a shadowing binding stops rewrite).
        (when (or (= (strcmp h "let") 0) (= (strcmp h "with") 0))
          (let (binds:ptr (node-at node 1))
            (when (!= (node-is-list binds) 0)
              (let (inner-bound:ptr (fn-bind-let-names binds bound)
                    new-binds:ptr (fn-rewrite-let-binds binds caps bound self-sym line mode)
                    new-body:ptr (fn-rewrite-list-from node 2 caps inner-bound self-sym line mode))
                (return (make-cell (as ptr hd)
                          (make-cell new-binds new-body line)
                          line))))
            ; A malformed binding list is left to the real emit to diagnose.
            (return node)))
        ; Nested lambda: rewrite its body with the inner params added to `bound`
        ; (a transitive capture of OUR enclosing local still rewrites to a field
        ; access on our env; the inner lambda then captures it from us).
        (when (!= (fn-is-lambda-head h) 0)
          (let (params:ptr (node-at node 1))
            (when (!= (node-is-list params) 0)
              (let (inner-bound:ptr (fn-bind-param-names params bound)
                    new-body:ptr (fn-rewrite-list-from node 2 caps inner-bound self-sym line mode))
                (return (make-cell (as ptr hd)
                          (make-cell params new-body line)
                          line))))
            (return node)))
        ; Ordinary form: keep the head verbatim, rewrite every argument.
        (return (make-cell (as ptr hd)
                  (fn-rewrite-list-rest node caps bound self-sym line mode)
                  line))))))

; Rewrite a Node list (cons spine) element-by-element starting at index `start`,
; returning a fresh spine. Used for non-symbol-head forms.
(defn fn-rewrite-list (node:(raw Node) start:i32 caps:(raw Node) bound:(raw Node) self-sym:(raw Node) line:i32 mode:i32):ptr
  (let (n:i32 (node-len node)
        head:ptr null
        tail:ptr null
        i:i32 start)
    (while (< i n)
      (let (e:ptr (fn-rewrite-captures (node-at node i) caps bound self-sym line mode)
            cell:ptr (make-cell e null line))
        (if (= head null) (set! head cell) (.set! (unsafe/cast ptr:Node tail) cdr cell))
        (set! tail cell))
      (inc! i))
    (return head)))

; The tail spine (args) of a symbol-headed form: indices 1..end, fresh spine.
(defn fn-rewrite-list-rest (node:(raw Node) caps:(raw Node) bound:(raw Node) self-sym:(raw Node) line:i32 mode:i32):ptr
  (return (fn-rewrite-list node 1 caps bound self-sym line mode)))

; A fresh body spine from index `start` (used for let/with/nested-lambda bodies).
(defn fn-rewrite-list-from (node:(raw Node) start:i32 caps:(raw Node) bound:(raw Node) self-sym:(raw Node) line:i32 mode:i32):ptr
  (return (fn-rewrite-list node start caps bound self-sym line mode)))

; Rewrite the init expressions of a let/with binding list: even slots are
; binding names (kept verbatim), odd slots are init expressions (rewritten in
; the pre-binding `bound` set, matching fn-capture-walk's init handling).
(defn fn-rewrite-let-binds (binds:(raw Node) caps:(raw Node) bound:(raw Node) self-sym:(raw Node) line:i32 mode:i32):ptr
  (let (n:i32 (node-len binds)
        head:ptr null
        tail:ptr null)
    (dotimes (i n)
      (let (e:ptr (if (= (% i 2) 0)
                    (unsafe/cast ptr (node-at binds i))
                    (fn-rewrite-captures (node-at binds i) caps bound self-sym line mode))
            cell:ptr (as ptr (make-cell e null line)))
        (if (= head null) (set! head cell) (.set! (unsafe/cast ptr:Node tail) cdr cell))
        (set! tail cell)))
    (return head)))

; Build a `(ref <Env>)` Type from the env StructDef.
(defn fn-env-ref-type (sd:(raw StructDef)):ptr
  (let (st:ptr:Type (as ptr:Type (make-type TY-STRUCT))
        pt:ptr:Type (as ptr:Type (make-type TY-PTR)))
    (.set! st sdef sd)
    (.set! pt elem (as ptr st))
    (.set! pt pkind PTR-REF)
    (return (as ptr pt))))

; Build a `(ptr <Env>)` Type (the synthesized drop's self param mirrors the
; collection idiom — with-cleanup invokes drop with a plain ptr-to-struct).
(defn fn-env-ptr-type (sd:(raw StructDef)):ptr
  (let (st:ptr:Type (as ptr:Type (make-type TY-STRUCT))
        pt:ptr:Type (as ptr:Type (make-type TY-PTR)))
    (.set! st sdef sd)
    (.set! pt elem (as ptr st))
    (return (as ptr pt))))

; Register and emit the anonymous closure-environment struct: one field per
; captured local (field name = capture name, field type = capture's resolved
; type). Returns the StructDef. The name is a fresh dot-free IR-legal symbol
; routed through sanitize-for-ir; the `%name = type {…}` line is emitted to
; g-out now (the env is monomorphic and fully known here, exactly like a plain
; defstruct). `caps` is the capture-name list; `scope` resolves each capture's
; Sym for its declared type.
(defn fn-make-env-struct (caps:(raw Node) scope:ref:Scope line:i32 mode:i32 alloc-field-ty:(raw Type)):ptr
  (let (ncaps:i32 (fn-caps-count caps)
        ; mode 2 (cfn): the env is a struct of POINTERS into the captured locals,
        ; preceded by a leading `__alloc` field holding the (ref AllocHandle) so
        ; the synthesized drop can free the env block through the same allocator
        ; that backed it. mode 0/1 (vfn/mfn): one value field per capture, no
        ; alloc field (unchanged).
        has-alloc:i32 (if (= mode 2) 1 0)
        off:i32 has-alloc
        nf:i32 (+ ncaps has-alloc)
        ename:ptr (sanitize-for-ir (intern-str (fmt-i32 "__vfn_env_%d" g-vfn-env-id))))
    (inc! g-vfn-env-id)
    (let (sd:ref:StructDef (register-struct ename)
          fnm:ptr (arena-alloc (* (as i64 nf) (ptr-bytes)))
          ftp:ptr (arena-alloc (* (as i64 nf) (ptr-bytes))))
      (.set! sd src-file g-source-path)
      (.set! sd src-line line)
      (when (!= has-alloc 0)
        (aset! (as ptr:ptr fnm) 0 (intern-str "__alloc"))
        (aset! (as ptr:ptr ftp) 0 alloc-field-ty))
      (let (i:i32 0
            cur:(raw Node) caps)
        (while (!= cur null)
          (let (cname:ptr (cur s))
            (if-some (csym (scope-lookup scope cname))
              (do
                (let (fty:ptr (sym-effective-type csym))
                  ; mode 2 (cfn): the field stores a POINTER to the captured
                  ; local's storage, so its type is (ref <T>) (PTR-REF, mirroring
                  ; what (addr-of cap) yields). mode 0/1: the value type as-is.
                  (when (= mode 2)
                    (let (pt:ptr:Type (as ptr:Type (make-type TY-PTR)))
                      (.set! pt elem fty)
                      (.set! pt pkind PTR-REF)
                      (set! fty (as ptr pt))))
                  (aset! (as ptr:ptr fnm) (+ off i) (intern-str cname))
                  (aset! (as ptr:ptr ftp) (+ off i) fty)))
              (die-at line (fmt-s "vfn: internal — capture '%s' not in scope" cname)))
            (inc! i)
            (set! cur (cur cdr)))))
      (struct-set-fields sd fnm ftp nf)
      (fprintf g-out "%%%s = type { " ename)
      (dotimes (i nf)
        (when (!= i 0) (fprintf g-out ", "))
        (fprintf g-out "%s" (type-to-ir (aref (as ptr:ptr ftp) i))))
      (fprintf g-out " }\n\n")
      (.set! sd emitted 1)
      (return (as ptr sd)))))

; Synthesize, register, and queue the closure's `invoke` method:
;   (defn invoke:<ret> ((self (ref <Env>)) <orig-params…>) <body'>)
; where <body'> is the lambda body with each captured local rewritten to a field
; access on `self`. The method is registered on the `invoke` generic eagerly
; (with a pre-mangled ir-name) so that a later `(closure arg…)` resolves to it
; and emit-defn re-derives the identical ir-name from defn-ir-name; its body is
; emitted by drain-mono-worklist, exactly as a parametric stamp is (mirrors
; generic-instantiate). `params-node` is the lambda's param list; the env type
; is prepended as the `self` receiver. Returns nothing — the caller already has
; the env value.
(defn fn-make-invoke-method (env-sd:(raw StructDef) caps:(raw Node) params-node:(raw Node) ret:(raw Type)
                                  param-types:ptr param-names:ptr nparams:i32
                                  body-list:(raw Node) line:i32 mode:i32):void
  ; Receiver-extended param Type* array: [(ref Env), p0, p1, …]. This is the
  ; exact signature generic-find-method-exact / defn-ir-name will match on.
  (let (self-ty:ptr (fn-env-ref-type env-sd)
        total:i32 (+ nparams 1)
        mtypes:ptr (arena-alloc (* (as i64 total) (ptr-bytes))))
    (aset! (as ptr:ptr mtypes) 0 self-ty)
    (dotimes (i nparams)
      (aset! (as ptr:ptr mtypes) (+ i 1) (aref (as ptr:ptr param-types) i)))
    ; The lambda's own params + `self` shadow the captures inside the body.
    (let (self-sym:ptr (as ptr (intern-symbol "self"))
          inner-bound:ptr (fn-bind-param-names params-node
                            (import-list-push null "self"))
          body2:ptr (fn-rewrite-list body-list 0 caps inner-bound self-sym line mode))
      ; Synthesized params: (self (ref Env)) prepended to the original param
      ; specs. The receiver uses the list form so the env name (which never
      ; contains a colon) is parsed as a type node, not colon-sugar.
      (let (env-ref-node:ptr (make-cell (as ptr (intern-symbol "ref"))
                               (make-cell (as ptr (intern-symbol (env-sd name)))
                                 null line)
                               line)
            self-spec:ptr (make-cell self-sym
                            (make-cell env-ref-node null line)
                            line)
            ; Prepend the `self` spec to the ENTIRE original param spine, so the
            ; synthesized params are ((self (ref Env)) p0 p1 …). params-node is a
            ; NODE-CELL whose own spine is the original params; cons self in front.
            new-params:ptr (make-cell self-spec params-node line)
            name-sym:ptr (as ptr (intern-symbol "invoke"))
            ret-node:ptr (as ptr (intern-symbol (type-spelling ret)))
            defn-sym:ptr (as ptr (intern-symbol "defn"))
            ; New-style: (defn invoke (params) <ret> body…).
            after-ret:ptr (make-cell ret-node body2 line)
            after-params:ptr (make-cell new-params after-ret line)
            after-name:ptr (make-cell name-sym after-params line)
            defn-form:ptr (make-cell defn-sym after-name line))
        ; Register the method (METHOD-USER on the `invoke` generic) and assign a
        ; deterministic mangled ir-name. defn-ir-name finds this method at emit
        ; time and returns the same name, so the define and the call agree.
        (let (newm:ref:Method (generic-register-method "invoke" ret mtypes total 0 0 defn-form)
              mangled:ptr (mangle-fn-name "" "invoke" mtypes total)
              job:ptr:MonoJob (new MonoJob))
          (.set! newm ir-name mangled)
          ; Route `invoke` by argument type so the closure's `invoke` doesn't
          ; hijack (or get hijacked by) any solitary user `invoke`.
          (fn-force-generic-mangled "invoke")
          (.set! job form defn-form)
          (.set! job context
                 (fmt-2s-i "while emitting closure invoke %s (defined at %s:%d)"
                           mangled g-source-path line))
          (conj g-mono-worklist job))))))

; Synthesize, register, and queue the closure's `drop` method for an OWNING env.
; mode 0/1 (vfn/mfn — at least one field is a Drop type):
;   (defn drop:void ((self (ptr <Env>))) (drop (.& self fK)) … reverse order)
; Each owned field is dropped via `(drop (.& self f))` — `.&` yields a (ref
; FieldType) whose nominal Drop method resolves through the `drop` generic,
; exactly like a collection's hand-written drop (e.g. String drops its `bytes`).
; Fields are dropped in REVERSE declaration order (innermost-first, mirroring
; emit-scope-cleanups). The (Env, Drop) conformance is recorded so with-bound
; closures arm the cleanup (with-drop-method keys on conformance-lookup + a
; resolvable drop method). Only owning fields are dropped; POD fields own
; nothing and are skipped (a null-bodied drop over a POD-only env is never
; synthesized — the caller gates on owns-anything).
; mode 2 (cfn — the env holds borrowed pointers, no owned referents): the env's
; own storage was allocated through the `alloc` operand, so drop frees that block
; via the stored handle (the leading __alloc field), mirroring how a collection's
; drop frees its buffer through its stored AllocHandle (lib/vector.nuc):
;   (defn drop:void ((self (ptr <Env>)))
;     (alloc-handle-free (. self __alloc) (unsafe/cast (raw ui8) self) (sizeof Env) 8))
; The (Env, Drop) conformance is recorded unconditionally (a cfn always owns its
; env storage), so a with-bound cfn arms the cleanup.
(defn fn-make-drop-method (env-sd:(raw StructDef) line:i32 mode:i32):void
  (let (sd:(raw StructDef) env-sd
        nf:i32 (sd num-fields)
        self-sym:ptr (as ptr (intern-symbol "self"))
        body:ptr null)
    (if (= mode 2)
      ; cfn: free the env block through the stored allocator handle.
      (let (alloc-sym:ptr (as ptr (intern-symbol "__alloc"))
            ; (. self __alloc) → the stored (ref AllocHandle).
            handle-access:ptr (make-cell (as ptr (intern-symbol "."))
                                  (make-cell self-sym
                                    (make-cell alloc-sym null line)
                                    line)
                                  line)
            ; (unsafe/cast (raw ui8) self) — self is (ptr Env); reinterpret as
            ; (raw ui8) (both lower to ptr; unsafe/cast is a no-IR reinterpret).
            raw-ty:ptr (make-cell (as ptr (intern-symbol "raw"))
                          (make-cell (as ptr (intern-symbol "ui8")) null line)
                          line)
            ; Stage 14 UN-5: bare "cast" is retired — synthesize the
            ; `unsafe/cast` spelling instead (D2 Class 1: identical emitter).
            raw-self:ptr (make-cell (as ptr (intern-symbol "unsafe/cast"))
                            (make-cell raw-ty
                              (make-cell self-sym null line)
                              line)
                            line)
            ; (sizeof Env) — the block size, matching the alloc-handle-alloc call.
            sizeof-node:ptr (make-cell (as ptr (intern-symbol "sizeof"))
                              (make-cell (as ptr (intern-symbol (sd name))) null line)
                              line)
            ; 8 — pointer alignment of the env block. Stage 14 UN-5: bare "cast"
            ; is retired — synthesize `unsafe/cast` (same emitter as before).
            align-node:ptr (make-cell (as ptr (intern-symbol "unsafe/cast"))
                            (make-cell (as ptr (intern-symbol "usize"))
                              (make-cell (fn-make-int-node 8) null line)
                              line)
                            line)
            freecall:ptr (make-cell (as ptr (intern-symbol "alloc-handle-free"))
                            (make-cell handle-access
                              (make-cell raw-self
                                (make-cell sizeof-node
                                  (make-cell align-node null line)
                                  line)
                                line)
                              line)
                            line))
        (set! body (make-cell freecall null line)))
      ; vfn/mfn: reverse-order (drop (.& self fK)) over the Drop fields. Built
      ; head-first by prepending in forward order → final spine is reverse order.
      (dotimes (k nf)
        (let (fty:ptr ((field-at (sd fields) k) type))
          (when (!= (type-conforms-drop fty) 0)
                (let (fname:ptr ((field-at (sd fields) k) name)
                                addr:ptr (make-cell (as ptr (intern-symbol ".&"))
                                                    (make-cell self-sym
                                                               (make-cell (as ptr (intern-symbol fname)) null line)
                                                               line)
                                                    line)
                                dropcall:ptr (make-cell (as ptr (intern-symbol "drop"))
                                                        (make-cell addr null line)
                                                        line))
                  (set! body (make-cell dropcall body line)))))))
    ; Synthesize (defn drop:void ((self (ptr Env))) body…).
    (let (env-ptr-node:ptr (make-cell (as ptr (intern-symbol "ptr"))
                             (make-cell (as ptr (intern-symbol (sd name))) null line)
                             line)
          self-spec:ptr (make-cell self-sym
                           (make-cell env-ptr-node null line)
                           line)
          new-params:ptr (make-cell self-spec null line)
          name-sym:ptr (as ptr (intern-symbol "drop"))
          ret-node:ptr (as ptr (intern-symbol "void"))
          defn-sym:ptr (as ptr (intern-symbol "defn"))
          ; New-style: (defn drop (params) void body…).
          after-ret:ptr (make-cell ret-node body line)
          after-params:ptr (make-cell new-params after-ret line)
          after-name:ptr (make-cell name-sym after-params line)
          defn-form:ptr (make-cell defn-sym after-name line)
          self-ptr-ty:ptr (fn-env-ptr-type env-sd)
          mtypes:ptr (arena-alloc (ptr-bytes)))
      (aset! (as ptr:ptr mtypes) 0 self-ptr-ty)
      ; Record the conformance so with-drop-method finds (Env, Drop).
      (conformance-add (sd name) "Drop" null 0 line)
      (let (newm:ref:Method (generic-register-method "drop" ty-void mtypes 1 0 0 defn-form)
            mangled:ptr (mangle-fn-name "" "drop" mtypes 1)
            job:ptr:MonoJob (new MonoJob))
        (.set! newm ir-name mangled)
        ; Route `drop` by argument type so the env's drop and each field type's
        ; own drop (e.g. a solitary `@drop`) coexist without one re-binding the
        ; other's bare `@drop` symbol.
        (fn-force-generic-mangled "drop")
        (.set! job form defn-form)
        (.set! job context
               (fmt-2s-i "while emitting closure drop %s (defined at %s:%d)"
                         mangled g-source-path line))
        (conj g-mono-worklist job)))))

; ============================================================
; Stage 13 type-erasure (TE-2): static per-concrete-type vtable synthesis.
; ============================================================
; For each concrete type ever boxed into a fat pointer (TE-1), synthesize ONE
; static immutable global vtable holding the addresses of that type's thunks:
;   @__vt.<type>.<proto> = internal constant { ptr, ptr }
;     { ptr <invoke-thunk>, ptr <drop-thunk-or-null> }
; slot 0 = the type's invoke/dispatch thunk, slot 1 = its drop thunk (null for a
; POD / non-owning type). For a BoxedFn these thunks are the *already-synthesized*
; per-env `invoke` (fn-make-invoke-method) and `drop` (fn-make-drop-method)
; methods — the vtable just takes their addresses; no new thunks are written. The
; box's `vtable` field (TE-3) is set to this global's address at construction.
;
; Dedup: memoized per (concrete-type spelling, protocol/signature) in a
; `(Vector (ref VtableEntry))` — reserve-key-first, intern, reuse — so a second
; box of the same type shares one global. The vtable symbol routes through
; sanitize-for-ir so `!`/`?`/`/` never reach the emitted name.
;
; Emission target is g-out (mirroring fn-make-env-struct): at box time g-out is
; the current module's def stream (batch / CT-JIT / macro-JIT), so the vtable
; lands in the same module as the @invoke/@drop thunks it references (those are
; queued on g-mono-worklist when the closure is emitted in that module). LLVM
; permits a constant to reference function globals defined later in the module.
(defvar (g-vtable-table (ref (Vector (ref VtableEntry)))) (vector-new-in (addr-of g-arena-alloc)))

; Memo lookup: the already-emitted vtable symbol for interned `key`, or null.
(defn vtable-memo-lookup (key:ptr):ptr
  (dotimes (i (unsafe/cast i32 (count g-vtable-table)))
    (let (e:ref:VtableEntry (invoke g-vtable-table (as usize i)))
      (when (= (e key) key) (return (e name)))))
  (return null))

; Record (key → vtable-symbol) (mirrors fnty-intern).
(defn vtable-memo-put (key:ptr name:ptr):void
  (let (rec:ref:VtableEntry (new VtableEntry))
    (.set! rec key key)
    (.set! rec name name)
    (conj g-vtable-table rec)))

; The emitted `@invoke.p<Env>.<argtoks>` symbol for a concrete env type: scan the
; `invoke` generic for the METHOD-USER whose self param (param-types[0]) is
; (ref Env) with Env matching `env-ty`'s StructDef — the exact scan
; derive-closure-conformance uses to locate a closure's invoke. Names compare by
; pointer identity (interned struct name). Returns the method's pre-mangled
; ir-name (already including the leading `@`), or null if none is registered.
(defn vtable-invoke-irname (env-ty:(raw Type)):ptr
  (let (ev:(raw Type) env-ty)
    (when (!= (ev kind) TY-STRUCT) (return null))
    (let (envname:ptr (-> ev (_ sdef) (unsafe/cast ptr:StructDef _) (_ name))
          ig:ptr (generic-lookup "invoke"))
      (when (= ig null) (return null))
      (let (igg:ptr:Generic (as ptr:Generic ig))
        (dotimes (mi (unsafe/cast i32 (count (igg methods))))
          (let (mm:ptr:Method (as ptr:Method (invoke (igg methods) (as usize mi))))
            (when (= (mm kind) METHOD-USER)
              (let (self-ty:ptr (aref (as ptr:ptr (mm param-types)) 0))
                (when (!= self-ty null)
                  (let (st:ptr:Type (as ptr:Type self-ty))
                    (when (and (= (st kind) TY-PTR)
                               (and (!= (st elem) null) (= (st pkind) PTR-REF)))
                      (let (et:ptr:Type (unsafe/cast ptr:Type (st elem)))
                        (when (= (et kind) TY-STRUCT)
                          (let (sd:ptr:StructDef (unsafe/cast ptr:StructDef (et sdef)))
                            (when (and (!= (as ptr sd) null) (= (sd name) envname))
                              (return (mm ir-name))))))))))))))
      (return null))))

; The emitted `@drop.p<Env>` symbol for a concrete type that conforms to Drop, or
; null for a non-owning / POD type (the vtable's drop slot is then `null`).
; Delegates to with-drop-method (handles the TY-STRUCT→(ref T) self shape and
; resolves exact or parametric drop) and reads the resolved method's ir-name.
(defn vtable-drop-irname (concrete-ty:(raw Type)):ptr
  ; TE-4: a cfn env (mode 2 — a leading `__alloc` field) captures by REFERENCE, so
  ; it owns no Drop fields; its synthesized drop merely FREES the env block through
  ; the stored handle. When such an env is boxed the box owns (and frees) its heap
  ; copy, so the vtable drop slot must be null — otherwise the box-drop free plus
  ; the env-drop free would double-free. (The original cfn env block then leaks: the
  ; documented cfn-box ownership gap, consistent with the cfn-of-pointer escape open
  ; question.) A vfn/mfn env's drop is field-drops only and composes correctly with
  ; the box's free, so it stays in the slot.
  (let (ct:(raw Type) concrete-ty)
    (when (= (ct kind) TY-STRUCT)
      (let (sd:ptr:StructDef (unsafe/cast ptr:StructDef (ct sdef)))
        (when (and (!= (as ptr sd) null) (> (sd num-fields) 0)
                   (= (strcmp ((field-at (sd fields) 0) name) "__alloc") 0))
          (return null)))))
  (let (m:?ptr:Method (with-drop-method concrete-ty))
    (when (= m null) (return null))
    (let (mm:ptr:Method (as ptr:Method m))
      (return (mm ir-name)))))

; The one place that answers "does `(dyn P)`'s P name a declared protocol?", and
; the one place that phrases the answer. Stage 15 W9 defect 21 made this an
; ordering question rather than a formatting one: box construction asks about
; *conformance* first, so before the protocol registry and the conformance
; registry agreed on their key, an undeclared `P` surfaced as the misleading
; `(dyn Nope): type 'Cat' does not conform to the protocol`. Both askers —
; `emit-box-value` (early, so the message is precise) and
; `dyn-vtable-method-irname` (the backstop, reached through `ensure-vtable-for`)
; — CALL this rather than re-deriving the test, which is the standing rule for a
; predicate with a second asker (context/conventions.md, `binop-result-type`).
; Protocol validation for a `(dyn P)` type deliberately happens here and not at
; type-parse time: `dyn-type` may be reached during a prescan, before the
; protocol's own file has registered it.
;
; Stage 15 B2a: this is also the `(dyn P)` SCOPE gate — `protocol-lookup` is the
; reference resolver, so a protocol this file cannot name is refused.
;
; Stage 15 B6: the ONE caller is now the annotation-site check
; (`dyn-annot-check`), asked against the spelling the author wrote and in that
; file's environment. It is no longer reachable from box construction, and must
; not become so again: since B6 a box carries its protocol's CANONICAL name, and
; a canonical `dp/Describe` is not nameable in a consumer that only bound the
; prefix `dpx`, so asking the scope question there would refuse every legal box.
; That is §9.2's "downstream of a gate, do not gate again" — box construction
; wants `dyn-resolve-protocol` (a key lookup), not this.
(defn dyn-require-protocol (proto:CStr line:i32):ptr:Protocol
  (let (pp:?ptr:Protocol (protocol-lookup proto))
    (when (= pp null)
      (die-at line
        (with-qualifier-note
          (fmt-2s "(dyn %s): '%s' is not a declared protocol" proto proto)
          (as ptr proto))))
    (return (as ptr:Protocol pp))))

; The box-construction / vtable side of the same question. `proto` here is the
; box's STORED name, i.e. the canonical key `dyn-proto-key` computed — a key, not
; a reference — so it resolves with `protocol-resolve-any` (reference, else key)
; and asks no scope question. Admission was already asked at the annotation site;
; this is the existence backstop for a box reached through a re-derived type in a
; file that never named the protocol at all.
(defn dyn-resolve-protocol (proto:CStr line:i32):ptr:Protocol
  (let (pp:?ptr:Protocol (protocol-resolve-any proto))
    (when (= pp null)
      (die-at line
        (with-qualifier-note
          (fmt-2s "(dyn %s): '%s' is not a declared protocol" proto proto)
          (as ptr proto))))
    (return (as ptr:Protocol pp))))

; ------------------------------------------------------------
; Stage 15 B6 — deferred `(dyn P)` annotation-site admission
; (name-resolution.md §9.5).
;
; Every `(dyn P)` a *file* writes is admitted here and nowhere else. The check
; cannot run where the spelling is parsed — `dyn-type` is reached from
; `prescan-defn-signatures`, before any imported protocol is registered — so it
; is recorded and drained once the whole graph is in. The two exits from
; `dyn-annot-record` are the whole mechanism:
;
;   * `g-type-key-ok` armed — the spelling was synthesized by the compiler (a
;     protocol-signature `Self` substitution, a `.nuch` replay, a stamped body),
;     so there is no file to ask and no author to blame. Same permission, same
;     arm sites, as the type reference resolvers use; grep them to enumerate.
;   * a REPL form typed at the PROMPT (`g-toplevel-depth` 0 — no whole-unit walk
;     is in progress, which happens only there). The session's registry is
;     already complete and its environment is the one that is never
;     saved/restored, so the question is answered on the spot and the answer
;     lands on the form the user just typed. A REPL `(import-use …)` does NOT
;     take this path: it runs `emit-toplevel-forms` at depth 1, so the imported
;     file's annotations defer exactly as in batch and are drained there —
;     without that distinction, an annotation naming a protocol from the
;     library's OWN imports would be refused, since the signature prescan
;     precedes the imported-signature prescan.
; ------------------------------------------------------------

; Ask the admission question for one annotation, in the caller's current
; environment. Split out so the immediate and deferred paths cannot drift.
(defn dyn-annot-check (spelling:CStr line:i32):void
  (dyn-require-protocol spelling line))

(defn dyn-annot-record (spelling:CStr line:i32):void
  (when (!= g-type-key-ok 0) (return))
  (when (and (!= g-interactive 0) (= g-toplevel-depth 0))
    (dyn-annot-check spelling line)
    (return))
  (let (j:ref:DynAnnot (new DynAnnot))
    (.set! j spelling (as ptr spelling))
    (.set! j path g-source-path)
    (.set! j line line)
    (.set! j ns g-current-ns)
    (.set! j imports g-file-imports)
    (conj g-dyn-annots j)))

; Ask every recorded question as the file that asked it. The three globals
; restored per job are exactly `resolve-spelling`'s inputs plus `die-at`'s file
; half; nothing else about the annotation's context is needed, because the
; question is a pure name lookup.
(defn drain-dyn-annots ():void
  (let (save-path:ptr g-source-path
        save-ns:ptr g-current-ns
        save-imports:(raw (Vector (ref ImportBind))) g-file-imports)
    (while (< g-dyn-annots-drained (count g-dyn-annots))
      (let (j:ref:DynAnnot (invoke g-dyn-annots g-dyn-annots-drained))
        (set! g-dyn-annots-drained (+ g-dyn-annots-drained (as usize 1)))
        (set! g-source-path (j path))
        (set! g-current-ns (j ns))
        (set! g-file-imports (j imports))
        (dyn-annot-check (as CStr (j spelling)) (j line))))
    (set! g-source-path save-path)
    (set! g-current-ns save-ns)
    (set! g-file-imports save-imports)))

; TE-6: the emitted concrete-impl symbol for the SOLE method of single-method
; protocol `proto` on concrete type `concrete-ty` — the `(dyn P)` analogue of
; vtable-invoke-irname (which resolves the env's structural `invoke`). Mirrors
; proto-sigs-resolve / method-satisfies-sig: substitute Self→concrete-ty in the
; protocol's single signature, then find the exact concrete method on the
; method-name generic. v1 restricts `(dyn P)` to a single-method, non-parametric
; protocol so the vtable is the 2-slot `{ method0, drop }` layout (drop at index 1)
; that the shared @__boxedfn_drop thunk reads verbatim. Dies on a missing protocol,
; a multi/parametric protocol (deferred), or a missing concrete impl.
(defn dyn-vtable-method-irname (concrete-ty:(raw Type) proto:CStr line:i32):ptr
  ; Stage 15 B3′: a synthesis region. It substitutes `Self` in the protocol's
  ; signature with `(type-spelling concrete-ty)`, which since B3′ is the type's
  ; CANONICAL name (`dp/Fox`) — a key, not a spelling this file can necessarily
  ; write. `examples/w9-dyn-ns.nuc` boxes exactly that case.
  (let (saved:i32 g-type-key-ok)
    (set! g-type-key-ok 1)
    (let (r:ptr (dyn-vtable-method-irname-in concrete-ty proto line))
      (set! g-type-key-ok saved)
      (return r))))

(defn dyn-vtable-method-irname-in (concrete-ty:(raw Type) proto:CStr line:i32):ptr
  (let (pp:ptr:Protocol (dyn-resolve-protocol proto line))
    (let (ppp:ptr:Protocol (as ptr:Protocol pp))
      (when (!= (ppp num-sigs) 1)
        (die-at line (fmt-s "(dyn %s): only single-method protocols are boxable in v1" proto)))
      (when (> (ppp num-params) 0)
        (die-at line (fmt-s "(dyn %s): parametric protocols are not boxable in v1" proto)))
      (let (typename:ptr (type-spelling concrete-ty)
            sig:ptr (aref (as ptr:ptr (ppp sigs)) 0)
            csig:ptr (subst-proto-sig-node sig typename (ppp params) null 0)
            name-node:ptr (node-at csig 0)
            params-node:ptr (node-at csig 1)
            mname:ptr null)
        (extract-name-and-type name-node (as ptr:ptr (addr-of mname)) line)
        (let (nparams:i32 (defn-params-count params-node)
              ptypes:ptr (defn-params-to-types params-node)
              g:ptr (generic-lookup mname))
          (when (= g null)
            (die-at line (fmt-2s "(dyn %s): no method '%s' is defined" proto mname)))
          (let (m:?ptr:Method (generic-find-method-exact g ptypes nparams))
            (when (= m null)
              (die-at line (fmt-3s "(dyn %s): type '%s' does not implement %s"
                                   proto typename mname)))
            (return (-> m (as ptr:Method _) (_ ir-name)))))))))

; Emit (once) and return the vtable global symbol for (concrete-ty, proto). On a
; memo hit returns the existing symbol without re-emitting; on a miss it ensures
; the fat-pointer layout is registered (TE-1), resolves the method0/drop thunk
; symbols, emits one `internal constant { ptr, ptr }` to g-out, records the memo,
; and returns the `@__vt...` symbol. Box construction stores this address into the
; fat pointer's `vtable` field. Slot 0 (method0) is the env's structural `invoke`
; for a BoxedFn (proto "Fn") or the concrete `extend P` impl for a `(dyn P)` box;
; slot 1 (drop) is the type's drop thunk (null for a POD/non-owning type). Dies if
; the boxed type has no method0 thunk (an invoke/impl is mandatory; drop optional).
; AVR-6 Harvard hazard (second path). A type-erasure box (BoxedFn, `dyn`, a
; boxed closure) stores function pointers as DATA — the vtable is an
; `internal constant { ptr @forwarder, ... }` and the boxed body `store`s the
; lifted fn pointer into a heap cell. On a target whose functions live in a
; distinct program address space (prog-as != 0 — AVR's `P1`), every such fn
; pointer is `ptr addrspace(1)` where a plain `ptr` is required — an LLVM
; verifier error (confirmed: boxedfn on AVR fails `llc` at the vtable/indirect
; call). Unlike a bare-fn value (caught in emit-symbol-ref), a boxed `(fn …)`
; closure is lambda-lifted and never passes through emit-symbol-ref, so the box
; construction is diagnosed here instead. Boxed closures / `dyn` / function
; values are out of scope for AVR v1 (design/stage14/avr-targets.md §3, §5 AVR-6);
; the full addrspace(1)-carrying fix is deferred. Inert on hosted targets
; (prog-as == 0), so the compiler's own dyn/BoxedFn self-compile is byte-identical.
(defn avr-reject-fn-value (line:i32 what:ptr):void
  (when (!= ((as ptr:Target g-target) prog-as) 0)
    (die-at line
      (fmt-sd "%s materializes a function as a data pointer, which is unsupported on this target: functions live in program memory (address space %d) -- boxed closures, `dyn`, and function values are not available on AVR in v1"
        what ((as ptr:Target g-target) prog-as)))))

(defn ensure-vtable-for (concrete-ty:(raw Type) proto:CStr line:i32):ptr
  (avr-reject-fn-value line "type-erasure (BoxedFn / dyn) construction")
  (let (key:ptr (intern-str (fmt-2s "%s/%s" (type-spelling concrete-ty) proto))
        hit:ptr (vtable-memo-lookup key))
    (when (!= hit null) (return hit))
    ; The box that will reference this vtable is a fat pointer of the TE-1 type.
    (ensure-fatptr-sdef)
    (let (inv:ptr (if (= (strcmp proto "Fn") 0)
                    (vtable-invoke-irname concrete-ty)
                    (dyn-vtable-method-irname concrete-ty proto line))
          drp:ptr (vtable-drop-irname concrete-ty))
      (when (= inv null)
        (die-at line (fmt-s "type-erasure: no invoke thunk for boxed type %s"
                            (type-spelling concrete-ty))))
      (let (vbare:ptr (sanitize-for-ir (fmt-2s "__vt.%s.%s"
                                               (type-mangle-token concrete-ty) proto))
            vname:ptr (intern-str (fmt-s "@%s" vbare)))
        (if (= drp null)
          (fprintf g-out "%s = internal constant { ptr, ptr } { ptr %s, ptr null }\n\n"
                   vname inv)
          (fprintf g-out "%s = internal constant { ptr, ptr } { ptr %s, ptr %s }\n\n"
                   vname inv drp))
        (vtable-memo-put key vname)
        (return vname)))))

; ============================================================
; Stage 13 type-erasure TE-3 — the boxing coercion at assignment into an
; erased slot (design/stage13/type-erasure.md §"(c) The boxing coercion").
; ============================================================
; When a concrete closure value (an emitted `__vfn_env_N` env produced by
; vfn/mfn/cfn) flows into a `(BoxedFn …)` slot, it is moved to the heap and
; wrapped in the shared two-word fat pointer (TE-1) pointing at the per-env
; static vtable (TE-2). Every closure value is emitted as a `(ref Env)` (a
; PTR-REF to its TY-STRUCT env: stack storage for vfn/mfn, heap storage for
; cfn), so the box always moves the env *by value* into a fresh heap block.
;
; INERTNESS / byte-identity: the compiler's own source never spells `(BoxedFn …)`,
; so `boxedfn-canonical` returns null at every coercion site during self-compile,
; `maybe-box-into-slot` returns its input unchanged, and zero box IR is emitted →
; byte-identical bootstrap, no refresh. Verify, do not assume.

; The closure's synthesized `invoke` METHOD-USER for a concrete env type: the same
; env-receiver scan vtable-invoke-irname uses, but returning the Method so the
; structural admission can compare its signature against the box's. Returns null
; for a non-struct type or a type with no registered invoke (e.g. a bare `fn`).
(defn closure-invoke-method (env-ty:(raw Type)):?ptr:Method
  (let (ev:(raw Type) env-ty)
    (when (!= (ev kind) TY-STRUCT) (return null))
    (let (envname:ptr (-> ev (_ sdef) (unsafe/cast ptr:StructDef _) (_ name))
          ig:ptr (generic-lookup "invoke"))
      (when (= ig null) (return null))
      (let (igg:ptr:Generic (as ptr:Generic ig))
        (dotimes (mi (unsafe/cast i32 (count (igg methods))))
          (let (mm:ptr:Method (as ptr:Method (invoke (igg methods) (as usize mi))))
            (when (= (mm kind) METHOD-USER)
              (let (self-ty:ptr (aref (as ptr:ptr (mm param-types)) 0))
                (when (!= self-ty null)
                  (let (st:ptr:Type (as ptr:Type self-ty))
                    (when (and (= (st kind) TY-PTR)
                               (and (!= (st elem) null) (= (st pkind) PTR-REF)))
                      (let (et:ptr:Type (unsafe/cast ptr:Type (st elem)))
                        (when (= (et kind) TY-STRUCT)
                          (let (sd:ptr:StructDef (unsafe/cast ptr:StructDef (et sdef)))
                            (when (and (!= (as ptr sd) null) (= (sd name) envname))
                              (return (as ptr mm))))))))))))))
      (return null))))

; The single, unified conformance-admission entry point the boxing coercion uses
; (design/stage13.md §"Conformance: structural vs nominal must unify"). It tries
; STRUCTURAL derivation first (closures → the Fn family) and falls back to NOMINAL
; `extend` conformance (arbitrary protocols). Returns 1 when `concrete-ty` may be
; boxed into `box-ty`, 0 otherwise; dies with a clear message when a closure is
; found but its signature is incompatible with the BoxedFn slot.
;   * box-ty is a fat-pointer instance Type. If it is a BoxedFn (boxedfn-canonical
;     non-null), structural admission = the env's `invoke` method's non-self
;     signature must match the box's (params…) ret (carried on box-ty).
;   * proto-name is the protocol-name string for a `(dyn P)` box (TE-6), or null
;     for a BoxedFn box. The nominal path (derive-closure-conformance for a named
;     Fn protocol, then conformance-lookup) is wired but only fires when a proto
;     name is supplied — i.e. it is dormant under TE-3 (BoxedFn only).
; Coherence (one-conformance-per-(type,proto)) is preserved: derive-closure-
; conformance is idempotent on an existing record and the structural BoxedFn match
; records nothing (the env's invoke is its sole, fixed callable shape).
(defn admit-erased-conformance (concrete-ty:(raw Type) box-ty:(raw Type) proto-name:ptr line:i32):i32
  (let (canon:ptr (boxedfn-canonical box-ty))
    ; (a) BoxedFn (Fn-family) box: structural signature match.
    (when (!= canon null)
      (let (im:?ptr:Method (closure-invoke-method concrete-ty))
        (when (= im null) (return 0))
        (let (m:ptr:Method (as ptr:Method im)
              bt:ptr:Type (as ptr:Type canon)
              np:i32 (bt num-params))
          (when (!= (- (m num-params) 1) np)
            (die-at line "BoxedFn: closure takes a different number of arguments than the slot's signature"))
          (dotimes (k np)
            (when (= (type-eq (aref (as ptr:ptr (m param-types)) (+ k 1))
                              ((field-at (bt params) k) type)) 0)
              (die-at line "BoxedFn: closure parameter type does not match the slot's signature")))
          (when (= (type-eq (m ret-type) (bt ret)) 0)
            (die-at line "BoxedFn: closure return type does not match the slot's signature"))
          (return 1))))
    ; (b) general (dyn P) box (TE-6): structural closure→named-Fn protocol, then
    ;     nominal extend conformance. Dormant under TE-3 (proto-name null).
    (when (!= proto-name null)
      (when (!= (derive-closure-conformance concrete-ty proto-name line) 0)
        (return 1))
      (when (!= (conformance-lookup (type-spelling concrete-ty) proto-name) 0)
        (return 1)))
    (return 0)))

; Build the first-class fat-pointer value {data = blk, vtable = vname} of box type
; `box-ty`: alloca the box, store the two pointers, load the aggregate. Shared by
; the closure-box and bare-fn-box paths.
(defn build-fatptr-val (blk:ptr vname:ptr box-ty:(raw Type)):ref:Val
  (let (box-ir:ptr (type-to-ir box-ty)
        fpslot:ptr (new-tmp))
    (fprintf g-entry-stream "  %s = alloca %s, align 8\n" fpslot box-ir)
    (let (g0:ptr (new-tmp))
      (fprintf g-body-stream "  %s = getelementptr inbounds %s, ptr %s, i32 0, i32 0\n"
        g0 box-ir fpslot)
      (fprintf g-body-stream "  store ptr %s, ptr %s, align 8\n" blk g0))
    (let (g1:ptr (new-tmp))
      (fprintf g-body-stream "  %s = getelementptr inbounds %s, ptr %s, i32 0, i32 1\n"
        g1 box-ir fpslot)
      (fprintf g-body-stream "  store ptr %s, ptr %s, align 8\n" vname g1))
    (let (fp:ptr (new-tmp))
      (fprintf g-body-stream "  %s = load %s, ptr %s, align 8\n" fp box-ir fpslot)
      (return (alloc-val box-ty fp)))))

; TE-5: the static vtable for a BARE-`fn` box. A non-capturing closure has no env
; and no synthesized `invoke` method, so the vtable invoke slot is a per-signature
; FORWARDER thunk `@__fnfwd.<sig>(ptr data, args…)` that loads the function pointer
; from the heap cell `data` and indirect-calls it; the drop slot is null (the box's
; @__boxedfn_drop just frees the cell). Memoized per signature (reuses the vtable
; memo with an `fnfwd.<sig>` key); the forwarder + vtable are emitted once to g-out.
(defn ensure-fnfwd-vtable (box-ty:(raw Type) line:i32):ptr
  (avr-reject-fn-value line "boxing a function into a BoxedFn")
  (let (canon:ptr (boxedfn-canonical box-ty)
        bt:ptr:Type (as ptr:Type canon)
        np:i32 (bt num-params)
        ret:ptr (bt ret)
        sigtok:ptr (boxedfn-sig-token (bt params) np ret)
        key:ptr (intern-str (fmt-s "fnfwd.%s" sigtok))
        hit:ptr (vtable-memo-lookup key))
    (when (!= hit null) (return hit))
    (ensure-fatptr-sdef)
    (let (fwd:ptr (intern-str (fmt-s "@%s" (sanitize-for-ir (fmt-s "__fnfwd.%s" sigtok))))
          vtname:ptr (intern-str (fmt-s "@%s" (sanitize-for-ir (fmt-s "__vtfn.%s" sigtok))))
          ret-ir:ptr (type-to-ir ret))
      (fprintf g-out "define internal %s %s(ptr %%data" ret-ir fwd)
      (dotimes (i np)
        (fprintf g-out ", %s %%a%d" (type-to-ir ((field-at (bt params) i) type)) i))
      (fprintf g-out ") {\nentry:\n")
      (fprintf g-out "  %%fp = load ptr, ptr %%data, align 8\n")
      (if (= (-> ret (unsafe/cast ptr:Type _) (_ kind)) TY-VOID)
        (do
          (fprintf g-out "  call void %%fp(")
         (dotimes (i np)
           (when (!= i 0) (fprintf g-out ", "))
           (fprintf g-out "%s %%a%d" (type-to-ir ((field-at (bt params) i) type)) i))
          (fprintf g-out ")\n  ret void\n}\n\n"))
        (do
          (fprintf g-out "  %%r = call %s %%fp(" ret-ir)
         (dotimes (i np)
           (when (!= i 0) (fprintf g-out ", "))
           (fprintf g-out "%s %%a%d" (type-to-ir ((field-at (bt params) i) type)) i))
          (fprintf g-out ")\n  ret %s %%r\n}\n\n" ret-ir)))
      (fprintf g-out "%s = internal constant { ptr, ptr } { ptr %s, ptr null }\n\n" vtname fwd)
      (vtable-memo-put key vtname)
      (return vtname))))

; TE-5: box a bare `fn` pointer (a non-capturing closure). data = a heap cell
; holding the function pointer; vtable = the per-signature forwarder. The box is
; still Drop (its @__boxedfn_drop frees the cell; the forwarder's drop slot is
; null — there is no env to run). Args at call time go through emit-box-invoke,
; whose indirect call lands on the forwarder, which loads+calls the real fn.
(defn emit-box-bare-fn (v:(raw Val) box-ty:(raw Type) scope:ref:Scope line:i32):ref:Val
  (let (vv:(raw Val) v
        fnty:ptr:Type (unsafe/cast ptr:Type (vv type))
        canon:ptr (boxedfn-canonical box-ty)
        bt:ptr:Type (as ptr:Type canon)
        np:i32 (bt num-params))
    ; Structural admission: the fn signature must match the box's (params…) ret.
    (when (!= (fnty num-params) np)
      (die-at line "BoxedFn: function takes a different number of arguments than the slot's signature"))
    (dotimes (k np)
      (when (= (type-eq ((field-at (fnty params) k) type)
                        ((field-at (bt params) k) type)) 0)
            (die-at line "BoxedFn: function parameter type does not match the slot's signature")))
    (when (= (type-eq (fnty ret) (bt ret)) 0)
      (die-at line "BoxedFn: function return type does not match the slot's signature"))
    (ensure-box-drop-fn box-ty line)
    (let (vname:ptr (ensure-fnfwd-vtable box-ty line))
      (when (= (scope-lookup scope "default-allocator") null)
        (die-at line "BoxedFn: boxing a function requires (import-use allocator)"))
      (let (ahsym:?ptr:Sym (scope-lookup scope "alloc-handle-alloc"))
        (when (= ahsym null)
          (die-at line "BoxedFn: boxing a function requires (import-use allocator)"))
        (let (da-node:ptr (make-cell (as ptr (intern-symbol "default-allocator")) null line)
              hv:ref:Val (emit-node da-node scope)
              blk:ptr (new-tmp))
          (fprintf g-body-stream "  %s = call ptr %s(ptr %s, %s %d, %s 8)\n"
            blk ((unsafe/cast ptr:Sym ahsym) ir-name) (hv val)
            (ptr-int-ir) (unsafe/cast i32 (ptr-bytes)) (ptr-int-ir))
          (fprintf g-body-stream "  store ptr %s, ptr %s, align 8\n" (vv val) blk)
          (return (build-fatptr-val blk vname box-ty)))))))

; Emit the boxing coercion: heap-move the concrete closure env `v` (a `(ref Env)`)
; into the shared fat pointer for `box-ty`, yielding a first-class `{data,vtable}`
; value (design/stage13/type-erasure.md §"(c)"). Steps:
;   1. admit conformance via the unified entry point (structural Fn-family);
;   2. resolve the per-env static vtable (TE-2 ensure-vtable-for);
;   3. heap-allocate a fresh block (v1: the process-default libc allocator — see
;      the allocator note below) and copy the env into it BY VALUE (the CE-3
;      by-value-struct move: a typed load + store of the whole env aggregate);
;   4. build the fat pointer {data = heap block, vtable = &__vt…} and return it.
;
; ALLOCATOR DECISION (v1, documented open question): the fat pointer is exactly
; two words {data,vtable} with no room for an AllocHandle, so the box does NOT
; thread the closure's own allocator. It boxes through the *process-default* libc
; allocator (default-allocator), which is a process-lifetime global constant;
; TE-4's box-Drop recovers it the same way (or frees directly) — no per-box handle
; storage and no leak. A future per-allocator box would prepend an allocator-
; handle header word to the heap block; flagged as an Open-Questions change.
(defn emit-box-closure (v:(raw Val) box-ty:(raw Type) scope:ref:Scope line:i32):ref:Val
  (let (vv:(raw Val) v
        vt:ptr:Type (unsafe/cast ptr:Type (vv type)))
    ; TE-5: a non-capturing closure decays to a bare `fn` pointer (TY-FN). Box it
    ; via a per-signature forwarder thunk (data = a heap cell holding the fn ptr).
    (when (= (vt kind) TY-FN)
      (return (emit-box-bare-fn v box-ty scope line)))
    ; Otherwise the value is a capturing closure — a `(ref Env)`.
    (when (or (!= (vt kind) TY-PTR) (= (vt elem) null)
              (!= (-> (vt elem) (unsafe/cast ptr:Type _) (_ kind)) TY-STRUCT))
      (die-at line "BoxedFn: can only box a closure value (a capturing closure's (ref Env), or a bare `fn`)"))
    (let (env-ty:ptr (vt elem))
      ; (1) Conformance admission (structural → nominal).
      (when (= (admit-erased-conformance env-ty box-ty (as ptr null) line) 0)
        (die-at line (fmt-s "BoxedFn: type '%s' has no invoke method (not a closure)"
                            (type-spelling env-ty))))
      ; (2) The static per-type vtable (TE-2): one @__vt.<env>.Fn global.
      (let (vname:ptr (ensure-vtable-for env-ty "Fn" line))
        ; (TE-4) Ensure the box is Drop-conforming: record the (box, Drop)
        ; conformance and emit the shared @__boxedfn_drop thunk (lazy, once per
        ; module) so a with/scope-exit drop of this box runs vtable.drop + frees.
        (ensure-box-drop-fn box-ty line)
        ; (3+4) Heap-move the env by value and build the fat pointer. The env is a
        ;       TY-STRUCT travelling by value into the heap box, exactly the move a
        ;       `(dyn P)` performs on a concrete struct — shared helper.
        (return (emit-box-struct-move v (unsafe/cast (raw StructDef) (-> env-ty (unsafe/cast ptr:Type _) (_ sdef)))
                                      box-ty vname scope line))))))

; The shared payload move (TE-3 step 3+4): heap-allocate a fresh block through the
; process-default libc allocator and copy the concrete TY-STRUCT value `v` (a
; `(ref Struct)`) into it BY VALUE (the CE-3 typed load+store), then build the fat
; pointer {data = heap block, vtable = vname}. `sd` is the payload's StructDef (an
; env for a BoxedFn, the boxed value's struct for a `(dyn P)`). The box does NOT
; thread the source allocator (the fat pointer has no room for an AllocHandle); it
; boxes through default-allocator and @__boxedfn_drop frees through libc free — the
; symmetric recovery of the v1 allocator decision (no per-box handle, no leak).
; Stage 15 B3′: takes the StructDef, not its name — since B3′ `(sd name)` is the
; canonical KEY (`dp/Fox`) and `(sd ir-name)` the LLVM spelling (`%dp__Fox`), and
; this function needs one of each. The `(sizeof <name>)` node it synthesizes is a
; source-symbol construction over the key, so it is emitted with the synthesized-
; spelling permission armed (see `g-type-key-ok`).
(defn emit-box-struct-move (v:(raw Val) sd:(raw StructDef) box-ty:(raw Type) vname:ptr scope:ref:Scope line:i32):ref:Val
  (let (vv:(raw Val) v
        struct-name:CStr (sd name)
        irn:CStr (sd ir-name))
    (when (= (scope-lookup scope "default-allocator") null)
      (die-at line "type-erasure: boxing a value requires (import-use allocator)"))
    (let (ahsym:?ptr:Sym (scope-lookup scope "alloc-handle-alloc"))
      (when (= ahsym null)
        (die-at line "type-erasure: boxing a value requires (import-use allocator)"))
      (let (da-node:ptr (make-cell (as ptr (intern-symbol "default-allocator")) null line)
            hv:ref:Val (emit-node da-node scope)
            sz-node:ptr (make-cell (as ptr (intern-symbol "sizeof"))
                          (make-cell (as ptr (intern-symbol struct-name)) null line)
                          line)
            saved-key-ok:i32 g-type-key-ok
            sz-val:ref:Val (do (set! g-type-key-ok 1)
                               (let (t:ref:Val (emit-node sz-node scope))
                                 (set! g-type-key-ok saved-key-ok)
                                 t))
            blk:ptr (new-tmp))
        (fprintf g-body-stream "  %s = call ptr %s(ptr %s, %s %s, %s 8)\n"
          blk ((unsafe/cast ptr:Sym ahsym) ir-name) (hv val)
          (type-to-ir (sz-val type)) (sz-val val) (ptr-int-ir))
        ; Copy the aggregate by value into the heap block (CE-3 path).
        (let (evec:ptr (new-tmp))
          (fprintf g-body-stream "  %s = load %%%s, ptr %s, align 8\n"
            evec irn (vv val))
          (fprintf g-body-stream "  store %%%s %s, ptr %s, align 8\n"
            irn evec blk))
        (return (build-fatptr-val blk vname box-ty))))))

; TE-6: box an arbitrary concrete VALUE into a `(dyn P)` fat pointer. Unlike a
; BoxedFn (which erases a closure env via the structural `invoke`), `(dyn P)` erases
; a struct value via its NOMINAL `extend P` conformance, with the per-(type,P)
; vtable holding the concrete `extend P` method address(es). The payload move is
; identical to the closure-env move (a struct travelling by value into the heap),
; so it shares emit-box-struct-move. v1 boxes a struct VALUE produced as a
; `(ref Struct)` (a struct literal, a `(default-allocator)`-free local); the drop
; slot is the struct's own drop (null for a POD struct → free only).
(defn emit-box-value (v:(raw Val) box-ty:(raw Type) scope:ref:Scope line:i32):ref:Val
  (let (vv:(raw Val) v
        vt:ptr:Type (unsafe/cast ptr:Type (vv type))
        proto:ptr (dyn-proto-of box-ty))
    (when (or (!= (vt kind) TY-PTR) (= (vt elem) null)
              (!= (-> (vt elem) (unsafe/cast ptr:Type _) (_ kind)) TY-STRUCT))
      (die-at line "(dyn P): can only box a concrete struct value (a (ref Struct))"))
    (let (struct-ty:ptr (vt elem))
      ; (0) The protocol must exist before "does this type conform to it?" is a
      ;     meaningful question — otherwise an undeclared `P` is reported as a
      ;     conformance failure. Shared with dyn-vtable-method-irname's backstop.
      ;     B6: a KEY lookup — `proto` is the box's canonical name, and the scope
      ;     question was already asked at the annotation site.
      (dyn-resolve-protocol proto line)
      ; (1) Nominal conformance admission (the dormant path in admit-erased-
      ;     conformance fires now that a protocol name is supplied).
      (when (= (admit-erased-conformance struct-ty box-ty proto line) 0)
        (die-at line (fmt-2s "(dyn %s): type '%s' does not conform to the protocol"
                             proto (type-spelling struct-ty))))
      ; (2) The static per-(type,P) vtable (TE-2): one @__vt.<type>.<P> global.
      (let (vname:ptr (ensure-vtable-for struct-ty proto line))
        ; (TE-4) Register the box's Drop (shared @__boxedfn_drop thunk).
        (ensure-box-drop-fn box-ty line)
        ; (3+4) Heap-move the value by value and build the fat pointer.
        (return (emit-box-struct-move v (unsafe/cast (raw StructDef) (-> struct-ty (unsafe/cast ptr:Type _) (_ sdef)))
                                      box-ty vname scope line))))))

; Coercion chokepoint: if `target` is an erased slot — a `(BoxedFn …)` (structural
; closure box) or a `(dyn P)` (nominal value box) — and `v` is not already a box of
; that kind, box `v`; otherwise return `v` untouched. Called from every erased-slot
; coercion site (let/with binding init, return, call-arg) immediately before
; coerce-int-val / safe-coerce-val so the boxed value then coerces as an identity
; (same TY-STRUCT box). Inert for any non-box target (the compiler has none).
; A box type as the author would write it: `(dyn P)` for a nominal box (the
; StructDef is named `__dyn.<P>`, which is an IR spelling, not a source one),
; the ordinary type spelling otherwise.
(defn box-spelling (canon:(raw Type)):ptr
  (let (p:ptr (dyn-proto-of (as ptr canon)))
    (when (!= p null) (return (fmt-s "(dyn %s)" p)))
    (return (as ptr (type-spelling canon)))))

; Stage 15 B6: the erased-slot coercion's missing type check. TE-3 returned an
; existing box untouched whenever the target was *a* box of the same flavour,
; never asking whether it was the same box — so a `(dyn P)` flowed into a
; `(dyn Q)` slot, and a `(BoxedFn (i32) i32)` into a `(BoxedFn (f32) f32)`,
; caught only by LLVM's parser (`'%t25' defined with type … but expected …`) with
; no source location, or not at all when the SysV ABI happened to decompose the
; fat pointer into two words at the call boundary. Both canonical Types come from
; the same memo, so `type-eq` here is the box-identity question exactly.
(defn box-require-same-kind (have:(raw Type) want:(raw Type) line:i32):void
  (when (!= (type-eq have want) 0) (return))
  (die-at line
    (fmt-2s "type mismatch: a %s value cannot be used where %s is required"
            (box-spelling have) (box-spelling want))))

(defn maybe-box-into-slot (v:(raw Val) target:(raw Type) scope:ref:Scope line:i32):ref:Val
  (let (bcanon:ptr (boxedfn-canonical target))
    (when (!= bcanon null)
      (let (vcanon:ptr (boxedfn-canonical (v type)))
        ; Already a box (re-binding / passing through an existing BoxedFn value).
        (when (!= vcanon null)
          (box-require-same-kind vcanon bcanon line)
          (return (unsafe/cast ref:Val v)))
        (return (emit-box-closure v bcanon scope line))))
    (let (dcanon:ptr (dyn-canonical target))
      (when (!= dcanon null)
        (let (vcanon:ptr (dyn-canonical (v type)))
          ; Already a (dyn P) box — pass through, but only if it is a box of the
          ; SAME protocol.
          (when (!= vcanon null)
            (box-require-same-kind vcanon dcanon line)
            (return (unsafe/cast ref:Val v)))
          (return (emit-box-value v dcanon scope line)))))
    (return (unsafe/cast ref:Val v))))

; ============================================================
; Stage 13 type-erasure TE-4 — box `Drop` + forwarding-through-vtable
; (design/stage13/type-erasure.md §"(d) Box Drop" + §"(e) Forwarding").
; ============================================================

; The single SHARED box-drop thunk. Every fat pointer has the same `{data,vtable}`
; layout, so one function drops any box: null-guard `data`, indirect-call the
; vtable's drop slot (the boxed env's own field-drops; null for a POD env), then
; free `data` through the process-default libc allocator the box was built with
; (the symmetric recovery of the TE-3 allocator decision — no per-box handle).
; The null guards make a moved-out (`set! …null`) or POD box a safe no-op, exactly
; like libc free / the Drop cleanup null-guard. Emitted once per module (lazy) to
; g-out; INERT under self-compilation (the compiler boxes nothing).
(defvar g-boxdrop-emitted:i32 0)

(defn ensure-box-drop-fn (box-ty:(raw Type) line:i32):void
  ; A `(dyn P)` box is the same fat pointer as a BoxedFn, so it reuses the shared
  ; @__boxedfn_drop thunk verbatim (drop slot at vtable index 1, free `data`).
  (let (canon:ptr (boxedfn-canonical box-ty))
    (when (= canon null) (set! canon (dyn-canonical box-ty)))
    (when (= canon null) (return))
    ; Register the box's drop on the `drop` generic ONCE per box-sdef (gated on the
    ; conformance memo), so an explicit `(drop box-addr)` in user/library code — a
    ; struct's field-drop, a collection element-drop — dispatches to the shared
    ; @__boxedfn_drop. All box types share the one layout-only thunk: each distinct
    ; box receiver gets its own Method, all pointing at the same symbol. The
    ; conformance record also makes type-conforms-drop / with-drop-method (its TE-4
    ; short-circuit) see the box as Drop-conforming.
    (let (sd:ptr (-> canon (unsafe/cast ptr:Type _) (_ sdef))
          sd-name:ptr (-> canon (unsafe/cast ptr:Type _) (_ sdef) (unsafe/cast ptr:StructDef _) (_ name)))
      (when (= (conformance-lookup sd-name "Drop") 0)
        (let (recv:ptr:Type (as ptr:Type (make-type TY-PTR))
              mtypes:ptr (arena-alloc (ptr-bytes)))
          (.set! recv elem canon)
          (.set! recv pkind PTR-REF)
          (aset! (as ptr:ptr mtypes) 0 (as ptr recv))
          (let (m:ref:Method (generic-register-method "drop" ty-void mtypes 1 0 0 (as ptr null)))
            (.set! m ir-name "@__boxedfn_drop"))
          ; Route `drop` by argument type so the box drop and every other type's
          ; drop coexist without one re-binding the other's bare @drop symbol.
          (fn-force-generic-mangled "drop")
          (conformance-add sd-name "Drop" (as ptr null) 0 line))))
    (when (= g-boxdrop-emitted 0)
      (set! g-boxdrop-emitted 1)
      (fprintf g-out "define internal void @__boxedfn_drop(ptr %%self) {\n")
      (fprintf g-out "entry:\n")
      (fprintf g-out "  %%data = load ptr, ptr %%self, align 8\n")
      (fprintf g-out "  %%dnull = icmp eq ptr %%data, null\n")
      (fprintf g-out "  br i1 %%dnull, label %%bd_done, label %%bd_live\n")
      (fprintf g-out "bd_live:\n")
      (fprintf g-out "  %%vtp = getelementptr inbounds { ptr, ptr }, ptr %%self, i32 0, i32 1\n")
      (fprintf g-out "  %%vt = load ptr, ptr %%vtp, align 8\n")
      (fprintf g-out "  %%dslotp = getelementptr inbounds { ptr, ptr }, ptr %%vt, i32 0, i32 1\n")
      (fprintf g-out "  %%dropfn = load ptr, ptr %%dslotp, align 8\n")
      (fprintf g-out "  %%fnull = icmp eq ptr %%dropfn, null\n")
      (fprintf g-out "  br i1 %%fnull, label %%bd_free, label %%bd_calldrop\n")
      (fprintf g-out "bd_calldrop:\n")
      (fprintf g-out "  call void %%dropfn(ptr %%data)\n")
      (fprintf g-out "  br label %%bd_free\n")
      (fprintf g-out "bd_free:\n")
      (fprintf g-out "  call void @free(ptr %%data)\n")
      (fprintf g-out "  br label %%bd_done\n")
      (fprintf g-out "bd_done:\n")
      (fprintf g-out "  ret void\n")
      (fprintf g-out "}\n\n"))))

; If `ty` is an erased box — a BoxedFn or a `(dyn P)`, as a TY-STRUCT value or a
; pointer to one ((ref box)) — return its canonical box Type; else null. Used by
; with-drop-method to arm the box's Drop (both kinds share @__boxedfn_drop).
(defn boxedfn-drop-target (ty:ptr):ptr
  (when (= ty null) (return null))
  (let (c:ptr (boxedfn-canonical ty))
    (when (!= c null) (return c))
    (let (dc:ptr (dyn-canonical ty))
      (when (!= dc null) (return dc)))
    (let (tt:ptr:Type (as ptr:Type ty))
      (when (and (= (tt kind) TY-PTR) (!= (tt elem) null))
        (let (ce:ptr (boxedfn-canonical (tt elem)))
          (when (!= ce null) (return ce)))
        (let (de:ptr (dyn-canonical (tt elem)))
          (when (!= de null) (return de)))))
    (return null)))

; Forwarding-through-vtable (§(e)): lower `(invoke box args…)` / `(box args…)` to an
; indirect call through the box's vtable invoke slot. Extract `{data,vtable}` from
; the first-class box value, load the invoke thunk (vtable field 0), and call
; `invoke(data, args…)` — `data` is the boxed `(ref Env)` receiver. Args are
; coerced to the box signature's parameter types (carried on the box Type); the
; call is type-checked by that signature. Scalar/pointer Fn signatures only (the
; live path); a struct-by-value param/ret in a box signature is a TE-5 follow-up.
(defn emit-box-invoke (n:(raw Node) scope:ref:Scope callee-val:(raw Val) arg-start:i32 nargs:i32):ref:Val
  (let (cv:ptr:Val (unsafe/cast ptr:Val callee-val)
        box-ty:ptr (boxedfn-canonical (cv type))
        bt:ptr:Type (unsafe/cast ptr:Type box-ty)
        line:i32 (-> n (unsafe/cast ptr:Node _) (_ line))
        ret-ty:ptr (bt ret)
        box-ir:ptr (type-to-ir box-ty))
    (check-call-arity "BoxedFn call" null box-ty nargs 0 line)
    (let (data:ptr (new-tmp)
          vt:ptr (new-tmp))
      (fprintf g-body-stream "  %s = extractvalue %s %s, 0\n" data box-ir (cv val))
      (fprintf g-body-stream "  %s = extractvalue %s %s, 1\n" vt box-ir (cv val))
      (let (invslotp:ptr (new-tmp)
            invfn:ptr (new-tmp))
        (fprintf g-body-stream "  %s = getelementptr inbounds { ptr, ptr }, ptr %s, i32 0, i32 0\n"
          invslotp vt)
        (fprintf g-body-stream "  %s = load ptr, ptr %s, align 8\n" invfn invslotp)
        (let (arg-vals:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes)))
              i:i32 0)
          (while (< i nargs)
            (let (av:ref:Val (emit-node (node-at n (+ arg-start i)) scope)
                  pty:ptr ((field-at (bt params) i) type)
                  coerced:ptr (coerce-int-val (as ptr av) pty line))
              (when (= coerced null)
                (die-at line "BoxedFn call: argument type does not match the slot's signature"))
              (aset! (as ptr:ptr arg-vals) i coerced))
            (inc! i))
          (let (ret-ir:ptr (type-to-ir ret-ty))
            (if (= (-> ret-ty (unsafe/cast ptr:Type _) (_ kind)) TY-VOID)
              (do
                (fprintf g-body-stream "  call void %s(ptr %s" invfn data)
                (set! i 0)
                (while (< i nargs)
                  (let (av:ptr:Val (as ptr:Val (aref (as ptr:ptr arg-vals) i)))
                    (fprintf g-body-stream ", %s %s" (type-to-ir (av type)) (av val)))
                  (inc! i))
                (fprintf g-body-stream ")\n")
                (return (alloc-val ty-void null)))
              (let (tmp:ptr (new-tmp))
                (fprintf g-body-stream "  %s = call %s %s(ptr %s" tmp ret-ir invfn data)
                (set! i 0)
                (while (< i nargs)
                  (let (av:ptr:Val (as ptr:Val (aref (as ptr:ptr arg-vals) i)))
                    (fprintf g-body-stream ", %s %s" (type-to-ir (av type)) (av val)))
                  (inc! i))
                (fprintf g-body-stream ")\n")
                (return (alloc-val ret-ty tmp))))))))))

; TE-6: the vtable slot index of protocol method `gname` on the `(dyn P)` box
; `box-ty`, or -1 if P declares no such method (so a generic call whose first
; argument is a dyn box but whose name is NOT one of P's methods falls through to
; ordinary resolution). v1 single-method protocols always answer 0 (method0 at
; vtable index 0; the drop slot is index 1, read verbatim by @__boxedfn_drop).
(defn dyn-method-slot (box-ty:(raw Type) gname:CStr):i32
  (let (proto:ptr (dyn-proto-of box-ty))
    (when (= proto null) (return -1))
    ; B2a: downstream of the box-construction gate — see `protocol-resolve-any`.
    (let (pp:?ptr:Protocol (protocol-resolve-any proto))
      (when (= pp null) (return -1))
      (let (ppp:ptr:Protocol (as ptr:Protocol pp))
        (dotimes (i (ppp num-sigs))
          (let (sig:ptr (aref (as ptr:ptr (ppp sigs)) i)
                name-node:ptr (node-at sig 0)
                mname:ptr null)
            (extract-name-and-type name-node (as ptr:ptr (addr-of mname)) 0)
            (when (and (!= mname null) (= (strcmp mname gname) 0)) (return i))))
        (return -1)))))

; TE-6: forward a `(dyn P)` method call `(method box args…)` through the box's
; vtable (§(e)). `args` holds the PRE-EMITTED argument Vals (args[0] = the box,
; args[1…] = the call args, already lowered by emit-generic-call); `slot` is the
; method's vtable index. Extract {data,vtable} from the first-class box, load the
; method thunk from vtable[slot], coerce each call arg to P's method signature, and
; emit the indirect call `method(data, args…)` — `data` is the boxed value passed
; as the method's `(ref Self)` receiver. Type-checked by the protocol method's sig;
; its non-self params and return must be concrete (v1 object-safety: no `Self` in a
; non-receiver position — such a method makes the protocol non-boxable).
(defn emit-dyn-forward (box-ty:(raw Type) args:ptr nargs:i32 slot:i32 line:i32):ref:Val
  (let (proto:ptr (dyn-proto-of box-ty)
        ; B2a: downstream of the box-construction gate (`protocol-resolve-any`).
        pp:ptr:Protocol (unsafe/cast ptr:Protocol (protocol-resolve-any proto))
        sig:ptr (aref (as ptr:ptr (pp sigs)) slot)
        name-node:ptr (node-at sig 0)
        params-node:ptr (node-at sig 1)
        mname:ptr null
        ret-ty:ptr null
        np:i32 (- (node-len params-node) 1)
        box-val:ptr:Val (as ptr:Val (unsafe/ptr+ (as ptr:Val args) 0))
        box-ir:ptr (type-to-ir box-ty))
    ; S1: a new-style protocol sig `(m (params) :ret)` carries the return at index
    ; 2; legacy `(m:ret (params))` keeps the exact extract-name-and-type parse
    ; (byte-identical). Object-safe (v1) methods have no `Self` in the return, so
    ; the raw sig's return parses concretely without Self substitution.
    (if (!= (sig-name-is-bare name-node) 0)
      (do (set! mname (-> name-node (unsafe/cast ptr:Node _) (_ s)))
          (set! ret-ty (fn-parse-ret-type (node-at sig 2) line)))
      (set! ret-ty (extract-name-and-type name-node (as ptr:ptr (addr-of mname)) line)))
    (when (= ret-ty null) (set! ret-ty ty-void))
    (when (!= (- nargs 1) np)
      (die-at line (fmt-2s "(dyn %s) call: %s expects a different number of arguments"
                           proto mname)))
    (let (data:ptr (new-tmp)
          vt:ptr (new-tmp))
      (fprintf g-body-stream "  %s = extractvalue %s %s, 0\n" data box-ir (box-val val))
      (fprintf g-body-stream "  %s = extractvalue %s %s, 1\n" vt box-ir (box-val val))
      (let (slotp:ptr (new-tmp)
            mfn:ptr (new-tmp))
        (fprintf g-body-stream "  %s = getelementptr inbounds { ptr, ptr }, ptr %s, i32 0, i32 %d\n"
          slotp vt slot)
        (fprintf g-body-stream "  %s = load ptr, ptr %s, align 8\n" mfn slotp)
        ; Coerce each (already-emitted) call arg to the protocol method's non-self
        ; param type.
        (let (arg-vals:ptr (arena-alloc (* (as i64 (+ np 1)) (ptr-bytes)))
              i:i32 0)
          (while (< i np)
            (let (pnode:ptr (node-at params-node (+ i 1))
                  pname:ptr null
                  pty:ptr (extract-name-and-type pnode (as ptr:ptr (addr-of pname)) line)
                  av:ptr:Val (as ptr:Val (unsafe/ptr+ (as ptr:Val args) (+ i 1)))
                  coerced:ptr (coerce-int-val (as ptr av) pty line))
              (when (= coerced null)
                (die-at line (fmt-2s "(dyn %s) call: argument type does not match %s's signature"
                                     proto mname)))
              (aset! (as ptr:ptr arg-vals) i coerced))
            (inc! i))
          (let (ret-ir:ptr (type-to-ir ret-ty))
            (if (= (-> ret-ty (unsafe/cast ptr:Type _) (_ kind)) TY-VOID)
              (do
                (fprintf g-body-stream "  call void %s(ptr %s" mfn data)
                (set! i 0)
                (while (< i np)
                  (let (av:ptr:Val (as ptr:Val (aref (as ptr:ptr arg-vals) i)))
                    (fprintf g-body-stream ", %s %s" (type-to-ir (av type)) (av val)))
                  (inc! i))
                (fprintf g-body-stream ")\n")
                (return (alloc-val ty-void null)))
              (let (tmp:ptr (new-tmp))
                (fprintf g-body-stream "  %s = call %s %s(ptr %s" tmp ret-ir mfn data)
                (set! i 0)
                (while (< i np)
                  (let (av:ptr:Val (as ptr:Val (aref (as ptr:ptr arg-vals) i)))
                    (fprintf g-body-stream ", %s %s" (type-to-ir (av type)) (av val)))
                  (inc! i))
                (fprintf g-body-stream ")\n")
                (return (alloc-val ret-ty tmp))))))))))

; Stage 13 L4: emit a clone-capture closure `(vfn (params):ret body…)`.
;
;   1. Parse params/return type like a defn (mirrors emit-fn).
;   2. Collect the set of captured enclosing-locals via the shared walker
;      (fn-capture-walk in COLLECT mode).
;   3. No captures → a `vfn` is just an `fn` (function pointer, zero overhead);
;      delegate to emit-fn so the non-capturing path stays a bare pointer.
;   4. Capturing → generate the anonymous env struct, synthesize+register the
;      `invoke` method (callable-values routes `(c arg…)` to it), classify each
;      capture (POD → bitwise clone = bare-symbol field init; Drop-with-Clone →
;      deep clone via `(clone (addr-of x))`; Drop-without-Clone → directed mfn
;      error), and if any field is Drop, synthesize the env's `drop` + record
;      its Drop conformance. The expression's value is the populated env (a
;      stack-allocated struct, returned as a (ref Env)).

; Emit the closure environment value: alloca the env struct, populate each field
; per capture, return its (ref Env). The init for each capture is emitted as an
; AST node (POD → the bare capture symbol = bitwise value copy, zero overhead;
; Drop-with-Clone → `(clone (addr-of x))` = deep, independently-owned copy) and
; stored into the field GEP, mirroring emit-struct-lit's field loop. Emitting
; directly (rather than synthesizing a `(<Env> …)` struct literal) avoids the
; struct-literal designated-initializer heuristic, which would mis-read a
; `(clone …)` call as a `clone`-field initializer. Sets *out-owns-drop to 1 iff
; any field is a Drop type (the closure then owns resources). Captures are
; iterated in the same order as fn-make-env-struct laid out the fields. `mode`
; selects the per-field population: 0 = vfn clone (POD bitwise / Drop deep-clone
; via Clone, else the directed mfn error); 1 = mfn move (a with-owned capture is
; routed through the `move` sink to disarm its with-cleanup + mark it consumed,
; a non-owned capture is bitwise-copied since move == copy when nothing disarms).
(defn fn-emit-env-value (env-sd:(raw StructDef) caps:(raw Node) scope:ref:Scope
                                 out-owns-drop:ptr:i32 line:i32 mode:i32 alloc-aptr:ptr):ref:Val
  (let (sd:ptr:StructDef (unsafe/cast ptr:StructDef env-sd)
        slot:ptr (new-tmp))
    (if (= mode 2)
      ; cfn (L6): the env is a struct of POINTERS into the captured locals plus a
      ; leading __alloc field (the (ref AllocHandle) that backed the env). The env
      ; storage is heap-allocated through `alloc-aptr`'s handle (always-heap first
      ; cut, per lambda-prompt L6). Each capture field is populated by storing
      ; (addr-of cap) into it. The closure value inherits the JOIN of the
      ; captures' addr-of taints (L1 region inheritance): a with-owned capture
      ; contributes with-taint (rejected at return AND store-out sinks), a frame-
      ; local capture contributes frame-taint (rejected at return), a ref/ptr-
      ; param or global capture contributes nothing. The join picks the innermost
      ; (first-to-exit) region within each class, with with-taint preferred over
      ; frame-taint — the strongest constraint, matching the L1 sink direction.
      (let (ahsym:?ptr:Sym (scope-lookup scope "alloc-handle-alloc"))
        (when (= ahsym null)
          (die-at line "cfn: 'alloc-handle-alloc' not in scope — (import-use allocator) is required to use cfn"))
        (let (ah-ir:ptr (ahsym ir-name)
              ; sizeof Env as a runtime usize (mirrors emit-sizeof).
              sz-node:ptr (make-cell (as ptr (intern-symbol "sizeof"))
                              (make-cell (as ptr (intern-symbol (sd name))) null line)
                              line)
              sz-val:ref:Val (emit-node sz-node scope)
              blk:ptr (new-tmp))
          ; Allocate the env block through the handle. alloc-handle-alloc is
          ; (raw ui8)((ref AllocHandle) usize usize) -> ptr at the IR level.
          (fprintf g-body-stream "  %s = call ptr %s(ptr %s, %s %s, %s 8)\n"
            blk ah-ir alloc-aptr (type-to-ir (sz-val type)) (sz-val val) (ptr-int-ir))
          ; Store the handle pointer into field 0 (__alloc) so the synthesized
          ; drop can free this block through the same handle. join-* are bound at
          ; this level so they are in scope for BOTH the per-capture while below
          ; and the final closure-Val build after it.
          (let (g0:ptr (new-tmp)
                join-taint:ptr null
                join-frame:i32 0
                join-depth:i32 -1)
            (fprintf g-body-stream "  %s = getelementptr inbounds %%%s, ptr %s, i32 0, i32 0\n"
              g0 (sd ir-name) blk)
            (fprintf g-body-stream "  store ptr %s, ptr %s, align 8\n" alloc-aptr g0)
            ; Per-capture: store (addr-of cap) into field k+1; join addr-of taints.
            (let (k:i32 0
                  cur:ptr caps)
              (while (!= cur null)
                (let (cname:ptr ((unsafe/cast ptr:Node cur) s)
                      gep:ptr (new-tmp))
                  (fprintf g-body-stream "  %s = getelementptr inbounds %%%s, ptr %s, i32 0, i32 %d\n"
                    gep (sd ir-name) blk (+ k 1))
                  (let (addr-node:ptr (make-cell (as ptr (intern-symbol "addr-of"))
                                          (make-cell (as ptr (intern-symbol cname)) null line)
                                          line)
                        av:ref:Val (emit-node addr-node scope))
                    (fprintf g-body-stream "  store ptr %s, ptr %s, align 8\n" (av val) gep)
                    ; Join the addr-of taint (L1 region inheritance).
                    (when (!= (av taint) null)
                      (let (d:i32 (scope-depth (av taint)))
                        (if (= (av taint-frame) 0)
                          ; with-taint beats frame-taint (rejected at store-out too).
                          (when (or (= join-taint null)
                                    (and (= join-frame 0) (> d join-depth))
                                    (= join-frame 1))
                            (set! join-taint (av taint))
                            (set! join-frame 0)
                            (set! join-depth d))
                          ; frame-taint: only when no with-taint joined yet.
                          (when (or (= join-taint null)
                                    (and (= join-frame 1) (> d join-depth)))
                            (set! join-taint (av taint))
                            (set! join-frame 1)
                            (set! join-depth d)))))))
                (inc! k)
                (set! cur ((unsafe/cast ptr:Node cur) cdr))))
            ; The closure value: a (ref Env) into the heap block, carrying the
            ; joined taint so returning it past a captured frame/with local's
            ; scope is rejected at the existing escape sinks.
            (let (pt:ptr:Type (as ptr:Type (make-type TY-PTR))
                  st:ptr:Type (as ptr:Type (make-type TY-STRUCT)))
              (.set! st sdef env-sd)
              (.set! pt elem (as ptr st))
              (.set! pt pkind PTR-REF)
              (let (rv:ref:Val (alloc-val (as ptr pt) blk))
                (.set! rv taint join-taint)
                (.set! rv taint-frame join-frame)
                (return rv))))))
      ; vfn/mfn: stack alloca + per-field clone/move.
      (do
        (fprintf g-entry-stream "  %s = alloca %%%s\n" slot (sd ir-name))
        (let (k:i32 0
              cur:ptr caps)
          (while (!= cur null)
            (let (cname:ptr ((unsafe/cast ptr:Node cur) s)
                  fty:ptr ((field-at (sd fields) k) type)
                  fty-ir:ptr (type-to-ir fty)
                  gep:ptr (new-tmp))
              (fprintf g-body-stream
                "  %s = getelementptr inbounds %%%s, ptr %s, i32 0, i32 %d\n"
                gep (sd ir-name) slot k)
              ; Per-capture population: mode 0 = vfn clone, mode 1 = mfn move.
              (if (= mode 0)
                (if (= (type-conforms-drop fty) 0)
                  ; POD / trivially-copyable: a plain value copy (bitwise clone).
                  (let (init-node:ptr (as ptr (intern-symbol cname))
                        v:ref:Val (emit-node init-node scope)
                        coerced:ptr (coerce-int-val v fty line))
                    (when (= coerced null)
                      (die-at line (fmt-s "vfn: capture '%s' value type mismatch" cname)))
                    (fprintf g-body-stream "  store %s %s, ptr %s\n"
                      fty-ir (-> coerced (as ptr:Val _) (_ val)) gep))
                  ; Drop capture: require a hand-written Clone, else direct to mfn; then
                  ; deep-clone via `(clone (addr-of x))`.
                  (do
                    (when (= (conformance-lookup (type-spelling fty) "Clone") 0)
                      (die-at line
                        (fmt-2s "vfn cannot clone-capture '%s' (type %s is Drop with no Clone); use mfn to move it instead"
                                cname (type-spelling fty))))
                    (ptr-set! out-owns-drop 1)
                    (let (clone-node:ptr (make-cell (as ptr (intern-symbol "clone"))
                                           (make-cell (make-cell (as ptr (intern-symbol "addr-of"))
                                                        (make-cell (as ptr (intern-symbol cname)) null line)
                                                        line)
                                                     null line)
                                           line)
                          v:ref:Val (emit-node clone-node scope)
                          coerced:ptr (coerce-int-val v fty line))
                      (when (= coerced null)
                        (die-at line (fmt-s "vfn: clone of capture '%s' type mismatch" cname)))
                      (fprintf g-body-stream "  store %s %s, ptr %s\n"
                        fty-ir (-> coerced (as ptr:Val _) (_ val)) gep))))
                ; mfn move: classify by with-ownership. A with-owned capture (owns=1)
                ; is routed through `(move x)` — emit-move disarms its with-cleanup
                ; (stores null into its cslot), marks it consumed (moved=1; any later
                ; reference is use-after-move), and yields its value with escape taint
                ; cleared so the closure may outlive the source's original scope. A
                ; non-owned capture (a let binding / by-value param) has no with-cleanup
                ; to disarm, so moving it == copying it: a bare-symbol bitwise copy.
                (do
                  (when (!= (type-conforms-drop fty) 0)
                    (ptr-set! out-owns-drop 1))
                  (if-some (csym (scope-lookup scope cname))
                    (if (= (csym owns) 0)
                      (let (init-node:ptr (as ptr (intern-symbol cname))
                            v:ref:Val (emit-node init-node scope)
                            coerced:ptr (coerce-int-val v fty line))
                        (when (= coerced null)
                          (die-at line (fmt-s "mfn: capture '%s' value type mismatch" cname)))
                        (fprintf g-body-stream "  store %s %s, ptr %s\n"
                          fty-ir (-> coerced (as ptr:Val _) (_ val)) gep))
                      (let (move-node:ptr (make-cell (as ptr (intern-symbol "move"))
                                              (make-cell (as ptr (intern-symbol cname)) null line)
                                              line)
                            v:ref:Val (emit-move move-node scope)
                            coerced:ptr (coerce-int-val v fty line))
                        (when (= coerced null)
                          (die-at line (fmt-s "mfn: move of capture '%s' type mismatch" cname)))
                        (fprintf g-body-stream "  store %s %s, ptr %s\n"
                          fty-ir (-> coerced (as ptr:Val _) (_ val)) gep)))
                    (die-at line (fmt-s "mfn: internal — capture '%s' not in scope" cname))))))
            (inc! k)
            (set! cur ((unsafe/cast ptr:Node cur) cdr))))
        ; A stack compound literal is a valid, non-null (ref Env) address.
        (let (pt:ptr:Type (as ptr:Type (make-type TY-PTR))
              st:ptr:Type (as ptr:Type (make-type TY-STRUCT)))
          (.set! st sdef env-sd)
          (.set! pt elem (as ptr st))
          (.set! pt pkind PTR-REF)
          (return (alloc-val (as ptr pt) slot)))))))

(defn emit-vfn (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        line:i32 ((unsafe/cast ptr:Node call) line))
    (when (< (node-len cc) 4)
      (die-at line "vfn: expects (vfn (params):ret body…)"))
    (let (params-node:ptr (node-at cc 1)
          ret-node:ptr (node-at cc 2))
      (when (= (node-is-list params-node) 0)
        (die-at line "vfn: params must be a list"))
      ; --- Capture collection (COLLECT mode) ---
      (let (bound:ptr (fn-bind-param-names params-node null)
            caps-head:ptr null
            bi:i32 3)
        (while (< bi (node-len cc))
          (fn-capture-walk (node-at cc bi) scope bound
                           (as ptr:ptr (addr-of caps-head)) line)
          (inc! bi))
        ; No runtime capture → identical to `fn`: a bare function pointer, zero
        ; overhead. Reuse emit-fn so the decay path is shared.
        (when (= caps-head null)
          (return (emit-fn call scope)))
        ; --- Parse params (mirrors emit-fn / emit-defn required-param path) ---
        (let (nparams:i32 (node-len params-node)
              ret:ptr (fn-parse-ret-type ret-node line)
              param-types:ptr null
              param-names:ptr null)
          (when (> nparams 0)
            (set! param-types (arena-alloc (* (as i64 nparams) (ptr-bytes))))
            (set! param-names (arena-alloc (* (as i64 nparams) (ptr-bytes)))))
          (dotimes (pi nparams)
            (let (pname:ptr null
                            pty:ptr (extract-name-and-type (node-at params-node pi)
                                                           (as ptr:ptr (addr-of pname))
                                                           (node-line (node-at params-node pi) line)))
              (when (= pty null)
                    (die-at line (fmt-s "vfn: missing :type on param '%s'" pname)))
              (aset! (as ptr:ptr param-types) pi pty)
              (aset! (as ptr:ptr param-names) pi pname)))
          ; --- Env struct + invoke method ---
          (let (env-sd:ptr (fn-make-env-struct caps-head scope line 0 (as ptr null))
                body-list:ptr (-> cc (_ cdr) (unsafe/cast ptr:Node _) (_ cdr)
                                     (unsafe/cast ptr:Node _) (_ cdr))
                owns-drop:i32 0)
            (fn-make-invoke-method env-sd caps-head params-node ret
                                   param-types param-names nparams body-list line 0)
            ; Determine ownership up front by scanning the env field types: if any
            ; field is a Drop type, the closure owns its cloned resources, so
            ; synthesize its `drop` + record the (Env, Drop) conformance BEFORE the
            ; env value is emitted — a with-binding of this env (in the enclosing
            ; scope, currently being emitted) consults the conformance to arm its
            ; scope-exit drop, so it must already be recorded.
            (let (nf:i32 (-> env-sd (unsafe/cast ptr:StructDef _) (_ num-fields)))
              (dotimes (fi nf)
                (when (!= (type-conforms-drop
                            ((field-at (-> env-sd (unsafe/cast ptr:StructDef _) (_ fields)) fi) type)) 0)
                  (set! owns-drop 1))))
            (when (!= owns-drop 0)
              (fn-make-drop-method env-sd line 0))
            ; Emit the populated env value (a (ref Env)). Per-capture clone
            ; classification (POD bitwise / Drop deep-clone / Drop-no-Clone error)
            ; happens inside fn-emit-env-value; the owns-drop it computes must
            ; agree with the pre-scan above (same type-conforms-drop predicate).
            (let (chk:i32 0)
              (return (fn-emit-env-value env-sd caps-head scope
                                         (as ptr:i32 (addr-of chk)) line 0
                                         (as ptr null))))))))))

; Stage 13 L5 (lambda.md §"mfn — capture by move"): a move-capture closure
; `(mfn (params):ret body…)`. Mirrors emit-vfn exactly — reuses fn-capture-walk
; (COLLECT), fn-make-env-struct, fn-make-invoke-method, fn-rewrite-captures (via
; fn-make-invoke-method), fn-make-drop-method, and fn-force-generic-mangled
; (via the invoke/drop registration) unchanged. The ONLY difference is the
; per-field population mode passed to fn-emit-env-value (1 = move): each
; with-owned capture is routed through the `move` sink (disarm its with-cleanup,
; mark it consumed → later use is use-after-move, yield its value with taint
; cleared), and each non-owned capture is bitwise-copied (move == copy when
; nothing disarms). The closure owns the moved resources → fn-make-drop-method
; synthesizes its drop over the Drop fields; no allocator; travels by value.
; Because the move clears the source's with-cleanup + taint, an mfn created
; inside a `with` may be returned out of it without an escape error (the
; export-from-`with` case) — ownership transferred, not a dangling borrow.
(defn emit-mfn (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        line:i32 ((unsafe/cast ptr:Node call) line))
    (when (< (node-len cc) 4)
      (die-at line "mfn: expects (mfn (params):ret body…)"))
    (let (params-node:ptr (node-at cc 1)
          ret-node:ptr (node-at cc 2))
      (when (= (node-is-list params-node) 0)
        (die-at line "mfn: params must be a list"))
      ; --- Capture collection (COLLECT mode) — shared with vfn ---
      (let (bound:ptr (fn-bind-param-names params-node null)
            caps-head:ptr null
            bi:i32 3)
        (while (< bi (node-len cc))
          (fn-capture-walk (node-at cc bi) scope bound
                           (as ptr:ptr (addr-of caps-head)) line)
          (inc! bi))
        ; No runtime capture → identical to `fn`: a bare function pointer, zero
        ; overhead. Reuse emit-fn so the decay path is shared.
        (when (= caps-head null)
          (return (emit-fn call scope)))
        ; --- Parse params (mirrors emit-fn / emit-vfn) ---
        (let (nparams:i32 (node-len params-node)
              ret:ptr (fn-parse-ret-type ret-node line)
              param-types:ptr null
              param-names:ptr null)
          (when (> nparams 0)
            (set! param-types (arena-alloc (* (as i64 nparams) (ptr-bytes))))
            (set! param-names (arena-alloc (* (as i64 nparams) (ptr-bytes)))))
          (dotimes (pi nparams)
            (let (pname:ptr null
                            pty:ptr (extract-name-and-type (node-at params-node pi)
                                                           (as ptr:ptr (addr-of pname))
                                                           (node-line (node-at params-node pi) line)))
              (when (= pty null)
                    (die-at line (fmt-s "mfn: missing :type on param '%s'" pname)))
              (aset! (as ptr:ptr param-types) pi pty)
              (aset! (as ptr:ptr param-names) pi pname)))
          ; --- Env struct + invoke method (reused from L4 as-is) ---
          (let (env-sd:ptr (fn-make-env-struct caps-head scope line 1 (as ptr null))
                body-list:ptr (-> cc (_ cdr) (unsafe/cast ptr:Node _) (_ cdr)
                                     (unsafe/cast ptr:Node _) (_ cdr))
                owns-drop:i32 0)
            (fn-make-invoke-method env-sd caps-head params-node ret
                                   param-types param-names nparams body-list line 1)
            ; Pre-scan env field types: if any field is a Drop type, the closure
            ; owns the moved resource, so synthesize its `drop` + record the
            ; (Env, Drop) conformance BEFORE the env value is emitted (a with-
            ; binding of this env consults the conformance to arm its scope-exit
            ; drop, so it must already be recorded).
            (let (nf:i32 (-> env-sd (unsafe/cast ptr:StructDef _) (_ num-fields)))
              (dotimes (fi nf)
                (when (!= (type-conforms-drop
                            ((field-at (-> env-sd (unsafe/cast ptr:StructDef _) (_ fields)) fi) type)) 0)
                  (set! owns-drop 1))))
            (when (!= owns-drop 0)
              (fn-make-drop-method env-sd line 0))
            ; Emit the populated env value (a (ref Env)). Per-capture move
            ; classification (non-owned bitwise / with-owned move) happens inside
            ; fn-emit-env-value in mode 1; the owns-drop it computes must agree
            ; with the pre-scan above (same type-conforms-drop predicate).
            (let (chk:i32 0)
              (return (fn-emit-env-value env-sd caps-head scope
                                         (as ptr:i32 (addr-of chk)) line 1
                                         (as ptr null))))))))))

; Stage 13 L6 (lambda.md §"cfn — capture by reference"): a reference-capture
; closure `(cfn alloc (params):ret body…)`. The index-1 operand `alloc` is a bare
; `(ref AllocHandle)` (NOT part of the params/return group); the params list is at
; index 2, the return type at index 3, the body at index 4+. Mirrors emit-vfn/
; emit-mfn — reuses fn-capture-walk (COLLECT), fn-make-env-struct, fn-make-
; invoke-method, fn-rewrite-captures (via fn-make-invoke-method), fn-make-drop-
; method, and fn-force-generic-mangled — with mode 2 throughout. The differences:
;   * the env is a struct of POINTERS into the captured locals, preceded by a
;     leading __alloc field holding the (ref AllocHandle);
;   * the env storage is heap-allocated through `alloc` (always-heap first cut);
;   * each capture field is populated by storing (addr-of cap);
;   * the closure conforms to Drop unconditionally (it owns the env storage), and
;     the synthesized drop frees the env block via the stored handle;
;   * the closure value inherits the join of the captures' addr-of taints (L1
;     region inheritance) so escaping a captured frame/with local's scope is
;     rejected at the existing sinks.
; A non-capturing cfn folds to a bare `fn` pointer (zero overhead), dropping the
; (unused) allocator operand. A local named `cfn` shadows this keyword.
(defn emit-cfn (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        line:i32 ((unsafe/cast ptr:Node call) line))
    (when (< (node-len cc) 5)
      (die-at line "cfn: expects (cfn alloc (params):ret body…)"))
    (let (alloc-node:ptr (node-at cc 1)
          params-node:ptr (node-at cc 2)
          ret-node:ptr (node-at cc 3))
      (when (= (node-is-list params-node) 0)
        (die-at line "cfn: params must be a list"))
      ; --- Capture collection (COLLECT mode) — shared with vfn/mfn ---
      (let (bound:ptr (fn-bind-param-names params-node null)
            caps-head:ptr null
            bi:i32 4)
        (while (< bi (node-len cc))
          (fn-capture-walk (node-at cc bi) scope bound
                           (as ptr:ptr (addr-of caps-head)) line)
          (inc! bi))
        ; No runtime capture → identical to `fn`: a bare function pointer, zero
        ; overhead. The cfn shape (alloc at index 1) differs from `fn`'s, so
        ; rebuild an fn-shaped node (fn params ret body…) and delegate to emit-fn.
        (when (= caps-head null)
          (let (fn-sym:ptr (as ptr (intern-symbol "fn"))
                body-list:ptr (-> cc (_ cdr) (unsafe/cast ptr:Node _) (_ cdr)
                                     (unsafe/cast ptr:Node _) (_ cdr) (unsafe/cast ptr:Node _) (_ cdr)))
            (return (emit-fn
                      (make-cell fn-sym
                        (make-cell params-node
                          (make-cell ret-node body-list line)
                          line)
                        line)
                      scope))))
        ; --- Emit the allocator operand once; validate it is a (ref AllocHandle) ---
        (let (alloc-val:ref:Val (emit-node alloc-node scope)
              alloc-ty:ptr:Type (unsafe/cast ptr:Type (alloc-val type)))
          (when (or (!= (alloc-ty kind) TY-PTR)
                    (= (alloc-ty elem) null)
                    (!= (-> (alloc-ty elem) (unsafe/cast ptr:Type _) (_ kind)) TY-STRUCT))
            (die-at line "cfn: allocator operand must be a (ref AllocHandle) — (import-use allocator) and pass e.g. (default-allocator)"))
          ; --- Parse params (mirrors emit-fn / emit-vfn) ---
          (let (nparams:i32 (node-len params-node)
                ret:ptr (fn-parse-ret-type ret-node line)
                param-types:ptr null
                param-names:ptr null)
            (when (> nparams 0)
              (set! param-types (arena-alloc (* (as i64 nparams) (ptr-bytes))))
              (set! param-names (arena-alloc (* (as i64 nparams) (ptr-bytes)))))
            (dotimes (pi nparams)
              (let (pname:ptr null
                              pty:ptr (extract-name-and-type (node-at params-node pi)
                                                             (as ptr:ptr (addr-of pname))
                                                             (node-line (node-at params-node pi) line)))
                (when (= pty null)
                      (die-at line (fmt-s "cfn: missing :type on param '%s'" pname)))
                (aset! (as ptr:ptr param-types) pi pty)
                (aset! (as ptr:ptr param-names) pi pname)))
            ; --- Env struct (mode 2: __alloc + ptr fields) + invoke (mode 2) ---
            (let (env-sd:ptr (fn-make-env-struct caps-head scope line 2 (alloc-val type))
                  body-list:ptr (-> cc (_ cdr) (unsafe/cast ptr:Node _) (_ cdr)
                                     (unsafe/cast ptr:Node _) (_ cdr) (unsafe/cast ptr:Node _) (_ cdr)))
              (fn-make-invoke-method env-sd caps-head params-node ret
                                     param-types param-names nparams body-list line 2)
              ; A cfn always owns its (heap) env storage, so it always conforms to
              ; Drop and gets a synthesized drop that frees the env via the stored
              ; handle. Record the (Env, Drop) conformance BEFORE the env value is
              ; emitted (a with-binding of this env consults it to arm cleanup).
              (fn-make-drop-method env-sd line 2)
              ; Emit the populated env value (a (ref Env) carrying the joined taint).
              ; alloc-aptr is the handle's IR pointer, evaluated once above.
              (let (chk:i32 0)
                (return (fn-emit-env-value env-sd caps-head scope
                                           (as ptr:i32 (addr-of chk)) line 2
                                           (alloc-val val)))))))))))

; (move p) — affine ownership transfer out of a with (lifecycle.md §4):
; disarm p's cleanup slot (store null; free(NULL) / the drop null-guard make
; the armed cleanup a no-op), yield p's value with its escape taint cleared so
; it may legitimately return or store out, and mark p consumed — any later use
; is "use after move" (a reassignment revives the binding).
(defn emit-move (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 2) (die-at (cc line) "move expects 1 binding name"))
    (let (tname:ptr (node-binding-name (node-at cc 1)))
      (when (= tname null) (die-at (cc line) "move: operand must be a binding name"))
      (if-some (sym (scope-lookup scope tname))
        (do
          (when (!= (sym moved) 0)
            (die-at (cc line) (fmt-s "use after move: '%s'" tname)))
          (when (= (sym owns) 0)
            (die-at (cc line) (fmt-s "move: '%s' does not own a with-bound resource" tname)))
          (let (tmp:ptr (new-tmp))
            (emit-load tmp (type-to-ir (sym type)) (sym ir-name) (sym type))
            (fprintf g-body-stream "  store ptr null, ptr %s, align 8\n" (sym cslot))
            (.set! sym moved 1)
            (return (alloc-val (sym-effective-type sym) tmp))))
        (die-at (cc line) (fmt-s "move: undefined '%s'" tname))))))

; Emit a Drop-protocol cleanup: load the resource pointer from its slot and,
; when non-null, statically dispatch to the resolved drop method. The null
; guard mirrors free(NULL)-is-a-no-op so `move` / (set! name null) disarm
; Drop resources exactly like libc ones.
(defn emit-drop-cleanup (slot:ptr dropfn:ptr dropret:(raw Type)):void
  (let (tmp:ptr (new-tmp)
        isn:ptr (new-tmp)
        id:i32 (new-label-id)
        do-lbl:ptr (fmt-i32 "drop.do%d" id)
        skip-lbl:ptr (fmt-i32 "drop.skip%d" id))
    (fprintf g-body-stream "  %s = load ptr, ptr %s, align 8\n" tmp slot)
    (fprintf g-body-stream "  %s = icmp eq ptr %s, null\n" isn tmp)
    (fprintf g-body-stream "  br i1 %s, label %%%s, label %%%s\n" isn skip-lbl do-lbl)
    (fprintf g-body-stream "%s:\n" do-lbl)
    (if (or (= dropret null)
            (= (dropret kind) TY-VOID))
      (fprintf g-body-stream "  call void %s(ptr %s)\n" dropfn tmp)
      (let (r:ptr (new-tmp))
        (fprintf g-body-stream "  %s = call %s %s(ptr %s)\n"
          r (type-to-ir dropret) dropfn tmp)))
    (fprintf g-body-stream "  br label %%%s\n" skip-lbl)
    (fprintf g-body-stream "%s:\n" skip-lbl)))

; Emit every armed cleanup in this scope, in reverse order of registration
; (innermost binding releases first, matching C++/RAII intuition). Three
; shapes: legacy libc free (free(NULL) is a no-op, so a slot disarmed via
; (set! name null) or `move` is safe), a Drop-protocol call (null-guarded for
; the same reason), and a (defer expr) re-emitted in its registration scope.
(defn emit-scope-cleanups (scope:ref:Scope):void
  (when (= g-block-term 1) (return))
  (let (sc:ptr:Scope (as ptr:Scope scope)
        n:i32 (unsafe/cast i32 (count (sc cleanup-slots))))
    (when (= n 0) (return))
    (let (i:i32 (- n 1))
      (while (>= i 0)
        (let (cl:ref:Cleanup (invoke (sc cleanup-slots) (as usize i)))
          ; The tag makes the three shapes exhaustive (was a null-probing cond on
          ; defer-node then drop-fn, else free). Arm order is irrelevant — match
          ; dispatches on the stored tag, so the shapes cannot be confused, and
          ; adding a fourth shape breaks this loudly (no `_` default).
          (match cl
            ((defer dnode dscope) (emit-node dnode dscope))
            ((drop slot dropfn dropret) (emit-drop-cleanup slot dropfn dropret))
            ((libc-free slot)
              (let (tmp:ptr (new-tmp))
                (fprintf g-body-stream "  %s = load ptr, ptr %s, align 8\n" tmp slot)
                (fprintf g-body-stream "  call void @free(ptr %s)\n" tmp)))))
        (set! i (- i 1))))))

; Walk the lexical scope chain emitting cleanups at every level. Used by
; emit-return so an early return inside nested `with` bodies still frees
; bound resources before terminating the basic block.
(defn emit-walk-cleanups (scope:ref:Scope):void
  (let (cur:?ptr:Scope (some scope))
    (while (!= cur null)
      (emit-scope-cleanups cur)
      (set! cur ((as ptr:Scope cur) parent)))))

(defn emit-return (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (= (node-len cc) 1)
      (emit-walk-cleanups scope)
      (fprintf g-body-stream "  ret void\n")
      (set! g-block-term 1)
      (return (alloc-val ty-void null)))
    (when (!= (node-len cc) 2)
      (die-at (cc line) "return expects 0 or 1 args"))
    ; Stage 10 target typing (unions.md §5c): in return position, a bare
    ; `(arm args...)` of the declared defunion return type means construction.
    ; Stage 13 TE-3: a closure returned into a (BoxedFn …) return slot is heap-
    ; boxed here — this is also what closes the CE-4 env-naming return gap (the
    ; anonymous env can't be spelled, but BoxedFn can). The boxed value owns heap
    ; storage, so the escape-taint check below sees a clean (untainted) value and
    ; the box may legitimately leave the frame. Inert when the return type is not
    ; a box (maybe-box-into-slot passes the value through unchanged).
    (let (v:ref:Val (maybe-box-into-slot
                      ; TC-2: g-fn-ret-type doubles as the want for return position —
                      ; arm it around the return-value emit so a generic constructor
                      ; returned directly infers a return-only tyvar. save/restore so
                      ; an explicit (return …) does not leak the want past itself.
                      (let (save-want:ptr g-want-type)
                        (set! g-want-type g-fn-ret-type)
                        (let (rv:ref:Val (emit-node (union-target-rewrite (node-at cc 1) g-fn-ret-type) scope))
                          (set! g-want-type save-want)
                          rv))
                      g-fn-ret-type scope (cc line)))
      ; Stage 10 escape analysis: returning unwinds every with-scope, so a
      ; tainted value always dangles past its cleanup (lifecycle.md §2.3).
      ; Stage 10/13: returning unwinds every frame scope, so any tainted value —
      ; a with-owned resource (Stage 10) or a pointer into frame-local storage
      ; (Stage 13 L1, taint-frame) — dangles past its storage. `return` is the
      ; outermost (function-frame) sink and rejects both.
      (when (!= (v taint) null)
        (if (= (v taint-frame) 0)
          (die-at (cc line)
            "resource bound by `with` escapes via return — use (move ...) to transfer ownership")
          (die-at (cc line)
            "address of frame-local storage escapes via return — the pointed-to storage is reclaimed when this function returns")))
      ; Stage 10 nullability: a declared (ref T) return requires a ref value.
      (when (!= g-fn-ret-type null)
        (pkind-flow-check (v type) g-fn-ret-type (cc line) "return"))
      (emit-walk-cleanups scope)
      (if (and (!= g-fn-ret-abi null)
               (!= ((unsafe/cast ptr:AbiInfo g-fn-ret-abi) kind) ABI-DIRECT))
        (emit-struct-ret (as ptr v))
        ; LW-3: coerce the returned value against the declared return type
        ; before emitting `ret`, mirroring the implicit end-of-body return
        ; path above (emit-defn: `coerce-int-val last-val ret`). Guard on
        ; g-fn-ret-type being non-null — some contexts leave it null, and
        ; today's uncoerced emission is kept there. This branch (ABI-DIRECT
        ; or no ABI info) never carries a struct/union return type —
        ; abi-classify only assigns a non-DIRECT kind to TY-STRUCT/TY-UNION —
        ; so coerce-int-val's int/CStr-only logic is always in-scope here.
        (if (= g-fn-ret-type null)
          (fprintf g-body-stream "  ret %s %s\n" (type-to-ir (v type)) (v val))
          (let (coerced:ptr (coerce-int-val (as ptr v) g-fn-ret-type (cc line)))
            (when (= coerced null)
              (die-at (cc line)
                (fmt-2s "return type mismatch — returned value of type %s does not match declared return type %s"
                        (type-spelling (v type)) (type-spelling g-fn-ret-type))))
            (let (cv:ptr:Val (unsafe/cast ptr:Val coerced))
              (fprintf g-body-stream "  ret %s %s\n" (type-to-ir (cv type)) (cv val))))))
      (set! g-block-term 1)
      (return (alloc-val ty-void null)))))

(defn emit-do (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        last:ref:Val (alloc-val ty-void null)
        ; TC-5 part 2: a non-tail form may consume the want; re-arm for the tail.
        my-want:ptr g-want-type
        i:i32 1)
    (while (< i (node-len cc))
      (let (cur:ptr (node-at cc i))
        (when (= i (- (node-len cc) 1))
          (set! g-want-type my-want)
          (set! cur (union-target-rewrite cur my-want)))
        (set! last (emit-node cur scope)))
      (inc! i))
    (return last)))

; CP-3: scan a (possibly malformed) let/with binding list for a name element that
; is a symbol ending in ':' — a whitespace near-miss like `(x: (raw Node) null)`.
; Runs before the even-count check, which would otherwise mask it behind a confusing
; "binding list must be even". defn bodies are not desugared, so this is the only
; chokepoint that catches a trailing-colon let/with name.
(defn check-colon-bindings (binds:(raw Node)):void
  ; W4a: the offending element is a bare symbol (no line of its own), so blame
  ; the binding list's own opening line.
  (let (encl:i32 (node-line (as ptr binds) 0)
        cur:ptr binds)
    (while (!= cur null)
      (let (e:ptr ((unsafe/cast ptr:Node cur) car))
        (when (!= e null)
          (let (en:ptr:Node (unsafe/cast ptr:Node e))
            (when (= (en kind) NODE-SYM)
              (let (es:ptr (en s)
                    elen:i64 (as i64 (strlen (en s))))
                (when (and (> elen 0) (= (char-at es (- elen 1)) 58))
                  (die-at (node-line (as ptr en) encl) (fmt-s "binding name ends in ':' (%s) -- write name:(Type) with no space, or (name Type)" es))))))))
      (set! cur ((unsafe/cast ptr:Node cur) cdr)))))

; Stage 15 W4c (design/stage15-stress-test/diagnostics.md §W4c): a let/with BODY
; form that is a bare colon-typed symbol is never a meaningful expression — it is
; the residue of a binding that fell out of the binding list because an extra `)`
; closed the list early:
;
;   (let (a:i32 1)          <- the `)` here ends the binding list
;         b:i32 2)          <- `b:i32` and `2` are now BODY forms
;     ...
;
; Note the binding list left behind is `(a:i32 1)`, an EVEN two elements, so the
; existing even-count check cannot see this; and the reader cannot see it either,
; because the file is still perfectly balanced when the user compensates with one
; fewer `)` at the end. It surfaced as `undefined: b:i32`, which names the
; symptom. Diagnosed here, before the body is emitted, so the message names the
; cause. Gated on the spelling not resolving in scope, so it can only ever
; replace a diagnostic that was already fatal — never pre-empt a working program.
(defn check-stray-typed-body (cc:(raw Node) scope:ref:Scope kw:CStr):void
  (let (n:i32 (node-len (as ptr cc))
        j:i32 2)
    (while (< j n)
      (let (e:ptr (node-at (as ptr cc) j))
        (when (!= e null)
          (let (en:ptr:Node (unsafe/cast ptr:Node e))
            (when (and (= (en kind) NODE-SYM)
                       (!= (strchr (en s) 58) null)
                       (= (scope-lookup scope (en s)) null))
              ; W4a: the offending element is an interned symbol with no line of
              ; its own, so blame the enclosing let/with form's line.
              (die-at (node-line (as ptr en) (node-line (as ptr cc) 0))
                (fmt-2s "%s: '%s' is a body form, not a binding -- an extra ')' probably ended the binding list early"
                  kw (en s)))))))
      (inc! j))))

; TC-3 (design/stage14/target-typed-constructors.md §TC-3): materialize a
; by-value struct `S` result into a fresh stack slot and yield a `(ref S)` to
; it. The backing alloca is frame storage (taint-frame, like any alloca ref),
; so `with` ownership drops it through the EXISTING with-drop-method TY-PTR arm
; — no new drop logic. Used by tc3-emit-binding-init when a declared `(ref S)`
; binding is initialized with a by-value `S`.
(defn tc3-materialize (v:(raw Val) ty:(raw Type) pointee:(raw Type) line:i32):ref:Val
  (let (vv:ptr:Val (unsafe/cast ptr:Val v)
        slot:ptr (fmt-i32 "%%tc3.mat.%d" g-tmp))
    (inc! g-tmp)
    (fprintf g-entry-stream "  %s = alloca %s, align %d\n"
      slot (type-to-ir pointee) (type-size pointee))
    (fprintf g-body-stream "  store %s %s, ptr %s, align %d\n"
      (type-to-ir pointee) (vv val) slot (type-size pointee))
    (let (rv:ptr:Val (as ptr:Val (alloc-val ty slot)))
      (.set! rv taint (vv taint))
      (.set! rv taint-frame (vv taint-frame))
      (return (as ref:Val rv)))))

; TC-3: emit a let/with binding init with target-typed materialization. For a
; declared `(ref S)` where `S` is a struct, derive the want from the declared
; type via two non-emitting node-type probes (deterministic, two probes max),
; arm the chosen want, and emit ONCE — avoiding double emission. If the init
; resolves to a by-value `S`, materialize (alloca backing + store + yield ref);
; otherwise emit with the declared want and return the value as-is (today's
; path, byte-identical). Strictly additive: materialization fires only where
; today's emit dies ("let: init type mismatch"), so existing code is unchanged.
;
; Probe 1 arms the whole declared `(ref S)` (what heap constructors return —
; TC-4); if the init types ref-shaped, bind directly. If probe 1 instead yields
; the by-value pointee (a concrete constructor ignores want) OR fails to resolve
; (a return-only-tyvar generic constructor can't fill its tyvar from `(ref S)`),
; retry with the pointee `S` (probe 2) and arm materialization iff it resolves
; to by-value `S`.
(defn tc3-emit-binding-init (bval-node:(raw Node) scope:ref:Scope ty:(raw Type) line:i32):ref:Val
  ; TC-5: target-type the init form against the declared slot type — rewrites
  ; `(arm args…)`/none/ok/err into (make Type arm …) when ty is a defunion/niche.
  ; union-target-rewrite is a no-op for a null/non-union target, so non-union
  ; bindings are byte-identical. `form` is the (possibly rewritten) init node.
  (let (form:ptr (union-target-rewrite bval-node ty)
        tt:ptr:Type (unsafe/cast ptr:Type ty))
    ; Fast path: declared type is not (ref S)-to-struct — today's TC-2 arming,
    ; byte-identical with the pre-TC-3 emit.
    (when (or (!= (tt kind) TY-PTR) (= (tt elem) null)
              (!= (-> (tt elem) (unsafe/cast ptr:Type _) (_ kind)) TY-STRUCT))
      (let (save:ptr g-want-type)
        (set! g-want-type ty)
        (let (vv:ref:Val (emit-node form scope))
          (set! g-want-type save)
          (return vv))))
    ; Declared is (ref S), S a struct: two-probe want derivation.
    (let (pointee:ptr (tt elem)
          arm-want:ptr ty
          mater:i32 0)
      (let (s1:ptr g-want-type)
        ; Probe 1: want = declared (ref S). node-type is want-aware (TC-3:
        ; node-type-call's tier-2 reads g-want-type), so a heap constructor
        ; returning (ref S) resolves and we bind directly (mater stays 0).
        (set! g-want-type ty)
        (let (t1:ptr (node-type bval-node scope))
          (set! g-want-type s1)
          ; A concrete constructor ignores want and types as by-value S here —
          ; arm materialization (the declared want is fine: no tyvars to fill).
          (when (and (!= t1 null)
                     (= (-> t1 (unsafe/cast ptr:Type _) (_ kind)) TY-STRUCT)
                     (!= (type-eq t1 pointee) 0))
            (set! mater 1))
          ; Probe 2: only when probe 1 did not resolve (a return-only-tyvar
          ; generic by-value constructor). Retry with the pointee S as want.
          (when (and (= t1 null) (= mater 0))
            (set! g-want-type pointee)
            (let (t2:ptr (node-type form scope))
              (set! g-want-type s1)
              (when (and (!= t2 null)
                          (= (-> t2 (unsafe/cast ptr:Type _) (_ kind)) TY-STRUCT)
                          (!= (type-eq t2 pointee) 0))
                (set! mater 1)
                (set! arm-want pointee))))))
      ; Emit ONCE with the chosen want.
      (let (s2:ptr g-want-type)
        (set! g-want-type arm-want)
        (let (vv:ref:Val (emit-node form scope))
          (set! g-want-type s2)
          (when (= mater 0) (return vv))
          ; Materialize, but only if the emitted value really is by-value S
          ; (the probe is non-emitting and could diverge from emit on a control-
          ; flow/expansion-dependent form; fall back to today's coerce otherwise).
          (let (vt:ptr ((as ptr:Val vv) type))
            (when (and (!= vt null)
                       (= (-> vt (unsafe/cast ptr:Type _) (_ kind)) TY-STRUCT)
                       (!= (type-eq vt pointee) 0))
              (return (tc3-materialize vv ty pointee line))))
          (return vv))))))

(defn emit-let (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (or (< (node-len cc) 2) (-> cc (node-at _ 1) (unsafe/cast ptr:Node _) (_ kind) (!= _ NODE-CELL)))
      (die-at (cc line) "let: bad form"))
    ; AT-1: normalize a leading `:volatile` (etc.) into a wrapped binding name so
    ; the (name value) pairing survives; attribute-free lists pass through
    ; unchanged (byte-identical). extract-name-and-type applies the attribute.
    (let (binds:ptr:Node (unsafe/cast ptr:Node
                           (attrs-normalize-bindings (as ptr (node-at cc 1)) (cc line))))
      (check-colon-bindings binds)
      (when (!= (% (node-len binds) 2) 0)
        (die-at (binds line) "let: binding list must be even"))
      (let (inner:ref:Scope (scope-new scope)
            i:i32 0)
        (while (< i (node-len binds))
          (let (bname:ptr (node-at binds i)
                bval-node:ptr (node-at binds (+ i 1)))
            (let (name:ptr null
                  ty:ptr (extract-name-and-type bname (as ptr:ptr (addr-of name))
                                                (node-line bname (cc line)))
                  pre-v:ptr null)
              ; CE-1 (closure-enhancements.md §CE-1): env-type inference. A bare-
              ; symbol binding with no spelled type — which previously always died
              ; here — adopts the type of its emitted init value, so a closure
              ; (whose anonymous env type cannot be written) can be `let`-bound.
              ; Gated to bare symbols so typed/destructuring bindings are untouched;
              ; existing source always spells a type, so this path is inert under
              ; self-compilation (byte-identical bootstrap, no refresh).
              (when (and (= ty null)
                         (= ((unsafe/cast ptr:Node bname) kind) NODE-SYM))
                (set! pre-v (as ptr (emit-node bval-node inner)))
                (set! ty ((as ptr:Val pre-v) type)))
              (when (= ty null)
                (die-at (node-line bname (cc line)) (fmt-s "let: missing :type on '%s'" name)))
              ; Stage 15 W5d (ergonomics.md §3.10): an `(array T …)` initializer
              ; refines an elem-less declared pointer to `ptr:T`, so `(aref a i)`
              ; works on a binding annotated with the bare `ptr`. IR-inert (every
              ; pointer allocas/stores identically); see array-lit-binding-type
              ; (generics.nuc), which node-type-block calls too — the lockstep.
              (set! ty (array-lit-binding-type ty bval-node))
              (let (slot:ptr (fmt-sd "%%%s.addr.%d" name g-tmp)
                    align:i32 (type-size ty))
                (inc! g-tmp)
                (fprintf g-entry-stream "  %s = alloca %s, align %d\n"
                  slot (type-to-ir ty) align)
                (let (v:ref:Val (if (= pre-v null)
                                  ; TC-3: emit the init with target-typed
                                  ; materialization (derived want + value→ref
                                  ; coercion for a declared (ref S)). CE-1 bare
                                  ; bindings took the pre-v path (no declared
                                  ; type) and inherit the surrounding want.
                                  (tc3-emit-binding-init bval-node inner ty
                                    (node-line bval-node (cc line)))
                                  (as ref:Val pre-v))
                      ; Stage 13 TE-3: a closure flowing into a (BoxedFn …) slot is
                      ; heap-boxed into the shared fat pointer here (inert otherwise).
                      coerced:ptr (coerce-int-val
                                    (maybe-box-into-slot v ty inner (node-line bval-node (cc line)))
                                    ty (node-line bval-node (cc line))))
                  (when (= coerced null)
                    (die-at (node-line bval-node (cc line))
                      (fmt-s "let: init type mismatch for '%s'" name)))
                  (let (cv:ptr:Val (unsafe/cast ptr:Val coerced))
                    (fprintf g-body-stream "  store %s %s, ptr %s, align %d\n"
                      (type-to-ir ty) (cv val) slot align)
                    (let (sym:ref:Sym (scope-define inner name ty slot 1))
                      ; Stage 10 escape analysis: a binding initialized from a
                      ; tainted value aliases the same resource (§2.2). Stage 13
                      ; L1: also inherit the frame-region flag.
                      (.set! sym taint ((as ptr:Val v) taint))
                      (.set! sym taint-frame ((as ptr:Val v) taint-frame))
                      ; Narrowing: a ?T binding initialized with a known
                      ; non-null value starts narrowed (parity with set!).
                      (when (and (= (ptr-pkind ty) PTR-MAYBE)
                                 (= (ptr-pkind ((as ptr:Val v) type)) PTR-REF))
                        (narrow-apply inner name))))))))
          (set! i (+ i 2)))
        ; W4c: catch a binding that an extra `)` pushed out of the binding list
        ; before the body emits it as an undefined name.
        (check-stray-typed-body (as ptr cc) inner "let")
        (let (last:ref:Val (alloc-val ty-void null)
              ; TC-5 part 2: re-arm the outer want for the body tail (a binding
              ; init or prior body form may have consumed it).
              my-want:ptr g-want-type
              j:i32 2)
          (while (< j (node-len cc))
            (let (cur:ptr (node-at cc j))
              (when (= j (- (node-len cc) 1))
                (set! g-want-type my-want)
                (set! cur (union-target-rewrite cur my-want)))
              (set! last (emit-node cur inner)))
            (inc! j))
          ; Fire (defer …) cleanups registered on this scope (no-op otherwise:
          ; let itself never arms one).
          (emit-scope-cleanups inner)
          (return last))))))

; `with` is `let` plus auto-free for any binding whose init expression is a
; libc allocator call (malloc/calloc/realloc/strdup, optionally wrapped in
; cast). Frees fire on fall-through (after the body) and on early `return`
; via emit-walk-cleanups in emit-return.
(defn emit-with (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (or (< (node-len cc) 2) (-> cc (node-at _ 1) (unsafe/cast ptr:Node _) (_ kind) (!= _ NODE-CELL)))
      (die-at (cc line) "with: bad form"))
    ; AT-1: normalize the attribute slot (see emit-let); byte-identical when absent.
    (let (binds:ptr:Node (unsafe/cast ptr:Node
                           (attrs-normalize-bindings (as ptr (node-at cc 1)) (cc line))))
      (check-colon-bindings binds)
      (when (!= (% (node-len binds) 2) 0)
        (die-at (binds line) "with: binding list must be even"))
      (let (inner:ref:Scope (scope-new scope)
            i:i32 0)
        (while (< i (node-len binds))
          (let (bname:ptr (node-at binds i)
                bval-node:ptr (node-at binds (+ i 1)))
            (let (name:ptr null
                  ty:ptr (extract-name-and-type bname (as ptr:ptr (addr-of name))
                                                (node-line bname (cc line)))
                  pre-v:ptr null)
              ; CE-1 (closure-enhancements.md §CE-1): env-type inference, mirror of
              ; emit-let. A bare-symbol binding with no spelled type adopts the type
              ; of its emitted init value so a closure (e.g. a cfn whose owning env
              ; drops at this with-scope via the TY-PTR with-drop-method path) can be
              ; `with`-bound. Gated to bare symbols; inert under self-compilation.
              (when (and (= ty null)
                         (= ((unsafe/cast ptr:Node bname) kind) NODE-SYM))
                (set! pre-v (as ptr (emit-node bval-node inner)))
                (set! ty ((as ptr:Val pre-v) type)))
              (when (= ty null)
                (die-at (node-line bname (cc line)) (fmt-s "with: missing :type on '%s'" name)))
              ; W5d (§3.10), mirror of emit-let: an `(array T …)` initializer
              ; refines an elem-less declared pointer to `ptr:T`.
              (set! ty (array-lit-binding-type ty bval-node))
              (let (slot:ptr (fmt-sd "%%%s.addr.%d" name g-tmp)
                    align:i32 (type-size ty)
                    autofree:i32 (is-libc-alloc bval-node))
                (inc! g-tmp)
                (fprintf g-entry-stream "  %s = alloca %s, align %d\n"
                  slot (type-to-ir ty) align)
                (let (v:ref:Val (if (= pre-v null)
                                  ; TC-3: emit the init with target-typed
                                  ; materialization (mirror of emit-let).
                                  (tc3-emit-binding-init bval-node inner ty
                                    (node-line bval-node (cc line)))
                                  (as ref:Val pre-v))
                      ; Stage 13 TE-3: a closure flowing into a (BoxedFn …) slot is
                      ; heap-boxed into the shared fat pointer here (inert otherwise).
                      ; (TE-4 wires the box's Drop; for now an unboxed with-binding
                      ; of a BoxedFn is non-owning — with-drop-method box-ty = null.)
                      coerced:ptr (coerce-int-val
                                    (maybe-box-into-slot v ty inner (node-line bval-node (cc line)))
                                    ty (node-line bval-node (cc line))))
                  (when (= coerced null)
                    (die-at (node-line bval-node (cc line))
                      (fmt-s "with: init type mismatch for '%s'" name)))
                  (let (cv:ptr:Val (unsafe/cast ptr:Val coerced))
                    (fprintf g-body-stream "  store %s %s, ptr %s, align %d\n"
                      (type-to-ir ty) (cv val) slot align)
                    (let (sym:ref:Sym (scope-define inner name ty slot 1))
                      (let (dm:ptr:Method (unsafe/cast ptr:Method (with-drop-method ty)))
                        ; unions.md §7: an owning binding of a tagged union
                        ; whose arms hold Drop resources would free the box
                        ; and leak the live arm — dropping a union is a tag
                        ; switch the compiler does not emit yet. Rejected
                        ; unless the union itself conforms to Drop (a manual
                        ; (match ...) in its drop method).
                        (when (and (= autofree 1) (= (as ptr dm) null))
                          (let (bt:ptr:Type (as ptr:Type ty))
                            (when (and (= (bt kind) TY-PTR) (!= (bt elem) null))
                              (if-some (ud (uniondef-for-type (bt elem)))
                                (let (darm:ptr (union-drop-arm (as ptr ud)))
                                  (when (!= darm null)
                                    (die-at (binds line)
                                      (fmt-2s "with: arm '%s' of tagged union '%s' holds a Drop resource — dropping needs a tag switch; extend the union with Drop and (match ...) on the arms in its drop method"
                                        darm (ud name)))))
                                0))))
                        (cond
                          ; Owning binding, libc shape: arm the legacy free
                          ; cleanup and seed the escape analysis — the value
                          ; aliases a resource freed when this with-scope
                          ; exits (lifecycle.md §2.1).
                          (= autofree 1)
                            (let (cl:ref:Cleanup (new Cleanup))
                              (ptr-set! cl (Cleanup-libc-free slot))
                              (scope-push-cleanup inner (as ptr cl))
                              (.set! sym owns 1)
                              (.set! sym cslot slot)
                              (.set! sym taint inner))
                          ; Owning binding, Drop shape: statically dispatched
                          ; (drop binding) at scope exit (lifecycle.md §5).
                          ; CE-3 fix (c): a struct-VALUE binding (TY-STRUCT — an
                          ; owning closure exported by value, or a hand-written
                          ; owning struct value) keeps its bytes inline in `slot`,
                          ; so the drop receiver is the slot's *address*. The
                          ; cleanup/move machinery is pointer-shaped (loads a ptr,
                          ; null-guards, calls drop on it; `move` disarms by
                          ; storing null), so arm against a fresh handle pointing
                          ; at the slot: drop sees the struct address, and a move
                          ; nulls the handle to disarm exactly like a TY-PTR
                          ; binding. This is the `owns=1` that lets emit-move
                          ; consume a struct-value Drop capture into an `mfn`.
                          (!= (as ptr dm) null)
                            (let (cslot:ptr slot)
                              (when (= (-> ty (unsafe/cast ptr:Type _) (_ kind)) TY-STRUCT)
                                (set! cslot (fmt-sd "%%%s.drophandle.%d" name g-tmp))
                                (inc! g-tmp)
                                (fprintf g-entry-stream "  %s = alloca ptr, align 8\n" cslot)
                                (fprintf g-body-stream "  store ptr %s, ptr %s, align 8\n" slot cslot))
                              (let (cl:ref:Cleanup (new Cleanup))
                                ; drop-ty was write-only in the old struct — omitted.
                                (ptr-set! cl (Cleanup-drop cslot (dm ir-name) (dm ret-type)))
                                (scope-push-cleanup inner (as ptr cl))
                                (.set! sym owns 1)
                                (.set! sym cslot cslot)
                                (.set! sym taint inner)))
                          ; Non-owning with-binding: behaves like let (adopts
                          ; the init value's taint and frame-region flag).
                          true
                            (do
                              (.set! sym taint ((as ptr:Val v) taint))
                              (.set! sym taint-frame ((as ptr:Val v) taint-frame)))))
                      (when (and (= (ptr-pkind ty) PTR-MAYBE)
                                 (= (ptr-pkind ((as ptr:Val v) type)) PTR-REF))
                        (narrow-apply inner name))))))))
          (set! i (+ i 2)))
        ; W4c: mirror of emit-let — catch a binding that an extra `)` pushed out
        ; of the binding list before the body emits it as an undefined name.
        (check-stray-typed-body (as ptr cc) inner "with")
        (let (last:ref:Val (alloc-val ty-void null)
              my-want:ptr g-want-type
              j:i32 2)
          (while (< j (node-len cc))
            (let (cur:ptr (node-at cc j))
              ; TC-5 part 2: target-type the tail (last) form against the armed want.
              (when (= j (- (node-len cc) 1))
                (set! g-want-type my-want)
                (set! cur (union-target-rewrite cur my-want)))
              (set! last (emit-node cur inner)))
            (inc! j))
          (emit-scope-cleanups inner)
          (return last))))))

; cond is an expression: each branch's last value contributes to a phi at
; cond.end. If all live branches agree on a non-void type, that's the cond's
; type. On any disagreement (or any void branch), fall back to void — the
; cond is then statement-shaped and any caller that uses it in value position
; will fail its own type-check downstream. If no clause has `true` as its
; test, the implicit fallthrough contributes `undef` of the result type.
(defn emit-cond (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        nargs:i32 (- (node-len cc) 1))
    (when (or (< nargs 2) (!= (% nargs 2) 0))
      (die-at (cc line) "cond: expects pairs of (test body)"))
    (let (npairs:i32 (/ nargs 2)
          ; TC-5 part 2: capture the armed want at entry; a clause test (a generic
          ; call) consumes it via emit-generic-call's consume-once, so re-arm it
          ; before each clause's value tail (body). Byte-identical when null.
          my-want:ptr g-want-type
          id:i32 (new-label-id)
          end-lbl:ptr (fmt-i32 "cond.end%d" id)
          fall-lbl:ptr (fmt-i32 "cond.fall%d" id)
          (vals (ref (Vector ptr))) (vector-new-in (addr-of g-arena-alloc))
          (preds (ref (Vector ptr))) (vector-new-in (addr-of g-arena-alloc))
          result-type:ptr null
          result-lit:i32 0
          result-taint:ptr null
          has-fallthrough:i32 0
          ; Stage 10 narrowing: `acc` holds names proven non-null for every
          ; subsequent pair (a failed null-test); `after` holds names to
          ; narrow past the cond (a terminated guard body whose predecessors
          ; all terminated too); all-term tracks the latter condition.
          (acc (ref (Vector ptr))) (vector-new-in (addr-of g-arena-alloc))
          (after (ref (Vector ptr))) (vector-new-in (addr-of g-arena-alloc))
          all-term:i32 1
          i:i32 0)
      (while (< i npairs)
        (let (test-node:ptr:Node (unsafe/cast ptr:Node (node-at cc (+ 1 (* i 2))))
              body-node:ptr (node-at cc (+ 2 (* i 2)))
              is-last:i32 0
              is-final-true:i32 0
              then-lbl:ptr (fmt-i32-i32 "cond.then%d.%d" id i)
              next-lbl:ptr null
              tmark:i32 (narrow-mark))
          (narrow-names scope acc)
          (when (= i (- npairs 1)) (set! is-last 1))
          (when (and (= is-last 1) (= (test-node kind) NODE-SYM))
            (when (= (test-node s) "true")
              (set! is-final-true 1)))
          (if (= is-final-true 1)
            (do
              (fprintf g-body-stream "  br label %%%s\n" then-lbl)
              (fprintf g-body-stream "%s:\n" then-lbl)
              (set! g-block-term 0))
            (do
              (if (= is-last 1)
                (do
                  (set! next-lbl fall-lbl)
                  (set! has-fallthrough 1))
                (set! next-lbl (fmt-i32-i32 "cond.test%d.%d" id (+ i 1))))
              (let (test:ref:Val (emit-node (as ptr test-node) scope))
                (when (!= ((test type) kind) TY-I1)
                  (die-at (node-line (as ptr test-node) (cc line)) "cond: test must be i1"))
                (fprintf g-body-stream "  br i1 %s, label %%%s, label %%%s\n"
                  (test val) then-lbl next-lbl))
              (fprintf g-body-stream "%s:\n" then-lbl)
              (set! g-block-term 0)
              ; Inside the taken branch the test's non-null facts hold.
              (let ((tfacts (ref (Vector ptr))) (vector-new-in (addr-of g-arena-alloc)))
                (test-true-nonnull (as ptr test-node) tfacts)
                (narrow-names scope tfacts))))
          ; TC-5 part 2: target-type each clause's value tail (union construction
          ; w/o explicit make) against the armed want. Re-arm first: a prior test
          ; (a generic call) may have consumed it. No-op when want is null or not a
          ; union; recursion into nested control forms happens via emit-node.
          (set! g-want-type my-want)
          (set! body-node (union-target-rewrite body-node my-want))
          (let (bv:ref:Val (emit-node body-node scope)
                bterm:i32 g-block-term)
            ; Stage 14 NS-3: a string-literal cond/if branch collapses to CStr (no
            ; IR) so the branch join and phi stay a plain pointer, exactly as a
            ; CStr-literal branch did before the flip. See collapse-strlit-cstr.
            (collapse-strlit-cstr (as ptr bv))
            (when (= bterm 0)
              (let (join-lbl:ptr (fmt-i32-i32 "cond.join%d.%d" id i)
                    bty:ptr (bv type))
                (if (= result-type null)
                  (do (set! result-type bty) (set! result-lit (bv is-lit)))
                  ; MC-1: shared join (absorbs bare-vs-typed ptr to (raw E);
                  ; LW-6: literal branches widen to a typed int sibling).
                  (do
                    (set! result-type (type-join result-type bty result-lit (bv is-lit)))
                    (set! result-lit (if (and (!= result-lit 0) (!= (bv is-lit) 0)) 1 0))))
                (when (= ((as ptr:Type bty) kind) TY-VOID)
                  (set! result-type ty-void))
                (set! result-taint (taint-merge result-taint (bv taint)))
                (fprintf g-body-stream "  br label %%%s\n" join-lbl)
                (fprintf g-body-stream "%s:\n" join-lbl)
                (fprintf g-body-stream "  br label %%%s\n" end-lbl)
                (conj vals (bv val))
                (conj preds join-lbl)))
            (narrow-restore tmark)
            (when (= is-final-true 0)
              ; Failed tests hold for every later pair...
              (test-false-nonnull (as ptr test-node) acc)
              ; ...and past the cond, iff every body so far has terminated
              ; (so the only ways to reach the code after the cond evaluated
              ; this test as false).
              (when (and (= bterm 1) (= all-term 1))
                (test-false-nonnull (as ptr test-node) after)))
            (when (= bterm 0) (set! all-term 0)))
          (when (and (= is-last 0) (= is-final-true 0))
            (fprintf g-body-stream "%s:\n" next-lbl)
            (set! g-block-term 0)))
        (inc! i))
      ; Guard-narrows that dominate the rest of the enclosing region.
      (narrow-names scope after)
      (when (= has-fallthrough 1)
        (fprintf g-body-stream "%s:\n" fall-lbl)
        (fprintf g-body-stream "  br label %%%s\n" end-lbl))
      (fprintf g-body-stream "%s:\n" end-lbl)
      (set! g-block-term 0)
      ; If every branch terminated (no live phi incomings) and there is no
      ; fallthrough, end-lbl is unreachable — terminate it so callers know
      ; control does not flow past the cond.
      (when (and (= (count vals) 0) (= has-fallthrough 0))
        (fprintf g-body-stream "  unreachable\n")
        (set! g-block-term 1))
      (if (or (= result-type null)
              (= ((as ptr:Type result-type) kind) TY-VOID))
        (return (alloc-val ty-void null))
        (let (tmp:ptr (new-tmp)
              ty-ir:ptr (type-to-ir result-type))
          (fprintf g-body-stream "  %s = phi %s " tmp ty-ir)
          (dotimes (k (count vals))
            (when (> k 0) (fprintf g-body-stream ", "))
            (fprintf g-body-stream "[ %s, %%%s ]"
              (invoke vals k)
              (invoke preds k)))
          (when (= has-fallthrough 1)
            (fprintf g-body-stream ", [ undef, %%%s ]" fall-lbl))
          (fprintf g-body-stream "\n")
          (let (rv:ref:Val (alloc-val result-type tmp))
            (.set! rv taint result-taint)
            (return rv)))))))

(defn emit-while (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (< (node-len cc) 2) (die-at (cc line) "while: missing condition"))
    (let (id:i32 (new-label-id)
          cond-lbl:ptr (fmt-i32 "while.cond%d" id)
          body-lbl:ptr (fmt-i32 "while.body%d" id)
          end-lbl:ptr (fmt-i32 "while.end%d" id))
      ; Stage 10 narrowing: the loop re-executes, so any binding the loop
      ; assigns loses a narrowing established outside it — kill those before
      ; anything inside the loop is emitted (the emit-set backstop catches
      ; macro-synthesized assignments the prescan cannot see).
      (inc! g-loop-depth)
      (let (psi:i32 1)
        (while (< psi (node-len cc))
          (prescan-kill-sets (node-at cc psi) scope)
          (inc! psi)))
      (fprintf g-body-stream "  br label %%%s\n" cond-lbl)
      (fprintf g-body-stream "%s:\n" cond-lbl)
      (set! g-block-term 0)
      (let (cnd:ref:Val (emit-node (node-at cc 1) scope))
        (when (-> cnd (_ type) (unsafe/cast ptr:Type _) (_ kind) (!= _ TY-I1))
          (die-at ((unsafe/cast ptr:Node (node-at cc 1)) line)
            "while condition must be i1"))
        (fprintf g-body-stream "  br i1 %s, label %%%s, label %%%s\n"
          (cnd val) body-lbl end-lbl))
      (fprintf g-body-stream "%s:\n" body-lbl)
      (set! g-block-term 0)
      ; The condition's non-null facts hold inside the body (re-established
      ; by the back-edge re-test); they are undone at loop exit.
      (let (wmark:i32 (narrow-mark)
            (wfacts (ref (Vector ptr))) (vector-new-in (addr-of g-arena-alloc)))
        (test-true-nonnull (node-at cc 1) wfacts)
        (narrow-names scope wfacts)
        (let (i:i32 2)
          (while (< i (node-len cc))
            (emit-node (node-at cc i) scope)
            (inc! i)))
        (narrow-restore wmark))
      (dec! g-loop-depth)
      (when (= g-block-term 0)
        (fprintf g-body-stream "  br label %%%s\n" cond-lbl))
      (fprintf g-body-stream "%s:\n" end-lbl)
      (set! g-block-term 0)
      (return (alloc-val ty-void null)))))

(defn emit-set (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 3) (die-at (cc line) "set! expects 2 args"))
    (let (target:ptr:Node (unsafe/cast ptr:Node (node-at cc 1)))
      (when (!= (target kind) NODE-SYM)
        (die-at (node-line (as ptr target) (cc line)) "set!: target must be symbol"))
      ; Strip any :type annotation so typed names from macro expansions resolve.
      (let (set-name:ptr null
            set-type-ignored:ptr null)
        (split-typed (target s)
                     (as ptr:ptr (addr-of set-name))
                     (as ptr:ptr (addr-of set-type-ignored)))
        (if-some (sym (scope-lookup scope set-name))
          (do
          (when (= (sym is-local) 0)
            (die-at (node-line (as ptr target) (cc line)) (fmt-s "set!: undefined local '%s'" (target s))))
          ; AVR-6 gap fix: a `:const` defvar's storage is LLVM `constant`
          ; (read-only) — a `set!` against it would emit a `store` into
          ; read-only storage (undefined behavior, segfaults at runtime on
          ; the host). Reject at compile time instead, before the RHS is
          ; even emitted.
          (when (!= (sym readonly-global) 0)
            (die-at (node-line (as ptr target) (cc line)) (fmt-s "set!: cannot assign to '%s' -- declared :const" (target s))))
          ; Stage 15 W8 G-2: an `(array T N)` binding names storage, not a
          ; value — assigning a whole array is not an operation (in C either).
          ; Refuse before the RHS is emitted, with a message that says why.
          (reject-array-type (sym type) (node-line (as ptr target) (cc line))
            (fmt-s "set!: '%s'" (target s)))
            (let (v:ref:Val
                   ; TC-2: arm the want channel with the slot's declared type so a
                   ; generic constructor on the RHS infers a return-only tyvar.
                   ; TC-5: target-type the RHS (union construction w/o explicit make).
                   (let (save-want:ptr g-want-type)
                     (set! g-want-type (sym type))
                     (let (vv:ref:Val (emit-node (union-target-rewrite (node-at cc 2) (sym type)) scope))
                       (set! g-want-type save-want)
                       vv))
                 coerced:?ptr:Val (coerce-int-val v (sym type) (cc line)))
            (when (= coerced null)
              (die-at (cc line) (fmt-s "set!: type mismatch for '%s'" (target s))))
            ; Stage 10 escape analysis: a with-owned resource may only be
            ; stored into a binding that lives no longer than the resource
            ; (same-or-inner scope relative to the owning with). Stage 13 L1:
            ; this store sink enforces only with-taint; a frame-region pointer
            ; (taint-frame=1) assigned into another binding is an intra-frame
            ; borrow — nested-region store precision is deferred, the function-
            ; frame boundary is enforced at `return`.
            (let (vtaint:ptr (v taint))
              (when (and (!= vtaint null) (= (v taint-frame) 0))
                (when (= (scope-descends (sym home) vtaint) 0)
                  (die-at (cc line)
                    (fmt-s "resource bound by `with` escapes via assignment to longer-lived '%s' — use (move ...) to transfer ownership" (target s)))))
              (let (cv:ptr:Val (unsafe/cast ptr:Val coerced))
                (emit-store (type-to-ir (sym type)) (cv val) (sym ir-name) (sym type))
                ; An owning binding's slot stays armed whatever is stored, so
                ; it keeps its taint; an ordinary binding adopts the value's
                ; taint and frame-region flag. Either way a reassignment revives
                ; a moved-out binding.
                (when (= (sym owns) 0)
                  (.set! sym taint vtaint)
                  (.set! sym taint-frame (v taint-frame)))
                (.set! sym moved 0)
                ; Narrowing: reassignment kills the dominating test's fact.
                ; Inside a loop, a narrow established outside the loop has
                ; already licensed earlier uses in this body — reject the
                ; assignment the prescan could not see (macro-expanded set!).
                (when (= (ptr-pkind (sym type)) PTR-MAYBE)
                  (when (and (!= (sym ntype) null) (< (sym ndepth) g-loop-depth))
                    (die-at (cc line)
                      (fmt-s "assignment to '%s' invalidates a null-narrowing established outside this loop — re-guard inside the loop" (target s))))
                  (narrow-kill (as ptr sym))
                  ; Assigning a known non-null value re-narrows going forward.
                  (when (= (ptr-pkind (v type)) PTR-REF)
                    (narrow-apply scope set-name)))
                ; set! yields the assigned value (so the REPL echoes it).
                (let (rv:ref:Val (alloc-val (sym type) (cv val)))
                  (.set! rv taint vtaint)
                  (return rv))))))
          (die-at (node-line (as ptr target) (cc line)) (fmt-s "set!: undefined local '%s'" (target s))))))))

; ============================================================
; Stage 8: scalar load/store helpers (volatile-aware)
; ============================================================

; Emit a scalar load into dst-tmp. When `ty` is volatile, emits `load volatile`.
(defn emit-load (dst-tmp:ptr ir-type:ptr ptr-name:ptr ty:(raw Type)):void
  (let (vol:ptr ""
        align:i32 (type-size ty))
    (when (and (!= ty null) (!= ((unsafe/cast ptr:Type ty) is-volatile) 0))
      (set! vol "volatile "))
    (fprintf g-body-stream "  %s = load %s%s, ptr %s, align %d\n"
      dst-tmp vol ir-type ptr-name align)))

; Emit a scalar store of `val`. When `ty` is volatile, emits `store volatile`.
(defn emit-store (ir-type:ptr val:ptr ptr-name:ptr ty:(raw Type)):void
  (let (vol:ptr ""
        align:i32 (type-size ty))
    (when (and (!= ty null) (!= ((unsafe/cast ptr:Type ty) is-volatile) 0))
      (set! vol "volatile "))
    (fprintf g-body-stream "  store %s%s %s, ptr %s, align %d\n"
      vol ir-type val ptr-name align)))

; Store a zero/null of `field-type` into the slot at `gep` (struct/array fill).
(defn emit-zero-store (field-type:(raw Type) gep:ptr):void
  (let (ft:ptr:Type (unsafe/cast ptr:Type field-type)
        ir:ptr (type-to-ir field-type)
        zero:ptr "0")
    ; Stage 15 W5d: the pointer test is `is-ptr-like`, not a bare TY-PTR kind —
    ; a `CStr` (and a `TY-FN` function pointer) lowers to `ptr` in IR, and
    ; `store ptr 0` is an LLVM parse error ("integer constant must have integer
    ; type"). This is the exact TY-PTR-vs-is-ptr-like trap conventions.md
    ; documents, found via an unfilled slot in `(array CStr (1 c"x"))` and an
    ; omitted `CStr` field in a struct literal. Behaviour for TY-PTR itself is
    ; unchanged ("null"), so every zero-fill that worked before is byte-identical.
    (when (!= (is-ptr-like ft) 0) (set! zero "null"))
    (when (= (ft kind) TY-FN) (set! zero "null"))
    (when (= (ft kind) TY-F32) (set! zero "0.000000e+00"))
    (when (= (ft kind) TY-F64) (set! zero "0.000000e+00"))
    ; Stage 15 W8 G-2: an array slot is an aggregate, so it takes the same
    ; `zeroinitializer` the struct/union arm below takes — `store [4 x i32] 0`
    ; is the same LLVM parse error W5d found for `store %P 0`.
    (when (= (ft kind) TY-ARRAY) (set! zero "zeroinitializer"))
    ; Stage 15 W5d: an aggregate slot zero-fills with `zeroinitializer`;
    ; `store %P 0` is the same LLVM parse error. Reachable from an unspecified
    ; slot in an `(array S …)` — a sparse/designated table of structs, which is
    ; precisely the shape §3.9's relaxation makes writable — and from a struct
    ; literal that omits a struct-typed (or StrView-typed) field.
    (when (or (= (ft kind) TY-STRUCT) (= (ft kind) TY-UNION))
      (set! zero "zeroinitializer"))
    (fprintf g-body-stream "  store %s %s, ptr %s\n" ir zero gep)))

; Return a copy of `t` with is-volatile=1. Primitive type singletons are shared,
; so we clone rather than mutate. If `t` is already volatile, returns it as-is.
(defn type-with-volatile (t:ref:Type):ref:Type
  (let (src:ptr:Type (as ptr:Type t))
    (when (!= (src is-volatile) 0) (return t))
    (let (dst:ref:Type (alloc-type))
      (.set! dst kind        (src kind))
      (.set! dst ret         (src ret))
      (.set! dst params      (src params))
      (.set! dst num-params  (src num-params))
      (.set! dst variadic    (src variadic))
      (.set! dst has-rest    (src has-rest))
      (.set! dst nopt        (src nopt))
      (.set! dst opt-defaults (src opt-defaults))
      (.set! dst elem        (src elem))
      (.set! dst sdef        (src sdef))
      (.set! dst is-volatile 1)
      (.set! dst pkind       (src pkind))
      ; Stage 15 W8 G-2: the array length is part of the type; a clone that
      ; dropped it would silently become a zero-length array.
      (.set! dst arr-len     (src arr-len))
      (return dst))))

; ============================================================
; Stage 8: inc! / dec!
; ============================================================

(defn emit-inc-dec (call:(raw Node) scope:ref:Scope op-instr:ptr op-name:CStr):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 2) (die-at (cc line) (fmt-s "%s expects 1 arg" op-name)))
    (let (target:ptr:Node (unsafe/cast ptr:Node (node-at cc 1)))
      (when (!= (target kind) NODE-SYM)
        (die-at (node-line (as ptr target) (cc line)) (fmt-s "%s: target must be symbol" op-name)))
      ; Strip any :type annotation so typed names from macro expansions resolve.
      (let (nm:ptr null
            type-ignored:ptr null)
        (split-typed (target s)
                     (as ptr:ptr (addr-of nm))
                     (as ptr:ptr (addr-of type-ignored)))
        (let (sym:?ptr:Sym (scope-lookup scope nm))
          (when (or (= sym null) (= (sym is-local) 0))
            (die-at (node-line (as ptr target) (cc line)) (fmt-s "%s: undefined local" op-name)))
          (when (= (is-int-type (sym type)) 0)
            (die-at (cc line) (fmt-s "%s: must be integer" op-name)))
          (let (ir:ptr (type-to-ir (sym type))
                t1:ptr (new-tmp))
            (emit-load t1 ir (sym ir-name) (sym type))
            (let (t2:ptr (new-tmp))
              (fprintf g-body-stream "  %s = %s nsw %s %s, 1\n" t2 op-instr ir t1)
              (emit-store ir t2 (sym ir-name) (sym type))
              (return (alloc-val ty-void null)))))))))

(defn emit-inc (call:(raw Node) scope:ref:Scope):ref:Val
  (return (emit-inc-dec call scope "add" "inc!")))

(defn emit-dec (call:(raw Node) scope:ref:Scope):ref:Val
  (return (emit-inc-dec call scope "sub" "dec!")))

; ============================================================
; Stage 8: labels and goto (incl. computed goto via blockaddress)
; ============================================================

(defn lbl-find (name:CStr):?ptr:LabelEntry
  (doseq (lbl g-lbl-tbl (VecIter (ref LabelEntry)))
    (let (e:ref:LabelEntry lbl)
      (when (= (strcmp (e name) name) 0)
        (return e))))
  (return null))

(defn lbl-add-occurrence (name:CStr):void
  (let (e:ptr:LabelEntry (unsafe/cast ptr:LabelEntry (lbl-find name)))
    (when (= (as ptr e) null)
      (let (ne:ref:LabelEntry (as ref:LabelEntry (arena-alloc (sizeof LabelEntry))))
        (.set! ne name name)
        (.set! ne total 0)
        (.set! ne seen 0)
        (conj g-lbl-tbl ne)
        (set! e ne)))
    (.set! e total (+ (e total) 1))))

; Pre-scan a function body form for (label NAME) declarations so forward gotos
; and last-decl-wins resolution work. Skips inside quote/quasiquote.
(defn prescan-labels (form:(raw Node)):void
  (when (= form null) (return))
  (let (n:ptr:Node (unsafe/cast ptr:Node form))
    (when (!= (n kind) NODE-CELL) (return))
    (when (= (node-len n) 0) (return))
    (let (head:ptr:Node (unsafe/cast ptr:Node (node-at n 0)))
      (when (= (head kind) NODE-SYM)
        (when (or (= (strcmp (head s) "quote") 0)
                  (= (strcmp (head s) "quasiquote") 0))
          (return))
        (when (and (= (strcmp (head s) "label") 0)
                   (= (node-len n) 2))
          (let (nm:ptr:Node (unsafe/cast ptr:Node (node-at n 1)))
            (when (= (nm kind) NODE-SYM)
              (lbl-add-occurrence (nm s)))))))
    (let (it:ptr:Node n)
      (while (and (!= (as ptr it) null) (= (it kind) NODE-CELL))
        (prescan-labels (it car))
        (set! it (unsafe/cast ptr:Node (it cdr)))))))

(defn emit-label (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 2) (die-at (cc line) "label: expects 1 name"))
    ; Stage 10 narrowing: a label is a potential backward-goto target — a
    ; join with unknown predecessors — so no narrow survives it.
    (narrow-kill-all)
    (let (nm:ptr:Node (unsafe/cast ptr:Node (node-at cc 1)))
      (when (!= (nm kind) NODE-SYM)
        (die-at (node-line (as ptr nm) (cc line)) "label: name must be symbol"))
      (let (e:ptr:LabelEntry (unsafe/cast ptr:LabelEntry (lbl-find (nm s))))
        (when (= (as ptr e) null)
          ; Pre-scan missed this label (e.g. from a macro expansion). Treat as a
          ; single decl; computed gotos may miss it in the indirectbr dest list.
          (lbl-add-occurrence (nm s))
          (set! e (unsafe/cast ptr:LabelEntry (lbl-find (nm s)))))
        (.set! e seen (+ (e seen) 1))
        (let (bb-name:ptr null)
          (if (= (e seen) (e total))
            (set! bb-name (fmt-s "lbl.%s" (nm s)))
            (set! bb-name (fmt-sd "lbl.%s.dead%d" (nm s) (e seen))))
          (when (= g-block-term 0)
            (fprintf g-body-stream "  br label %%%s\n" bb-name))
          (fprintf g-body-stream "%s:\n" bb-name)
          (set! g-block-term 0)
          (return (alloc-val ty-void null)))))))

(defn emit-goto (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 2) (die-at (cc line) "goto: expects 1 label name"))
    (let (nm:ptr:Node (unsafe/cast ptr:Node (node-at cc 1)))
      (when (!= (nm kind) NODE-SYM)
        (die-at (node-line (as ptr nm) (cc line)) "goto: name must be symbol"))
      (let (e:ptr:LabelEntry (unsafe/cast ptr:LabelEntry (lbl-find (nm s))))
        (when (= (as ptr e) null)
          (die-at (node-line (as ptr nm) (cc line)) (fmt-s "goto: no such label '%s' in function" (nm s))))
        (fprintf g-body-stream "  br label %%lbl.%s\n" (nm s))
        ; Start a fresh dead BB so subsequent forms in a do/let body have a valid
        ; insertion point. LLVM eliminates it (no predecessors).
        (let (dead:ptr (fmt-i32 "goto.dead%d" (new-label-id)))
          (fprintf g-body-stream "%s:\n" dead))
        (set! g-block-term 0)
        (return (alloc-val ty-void null))))))

(defn emit-label-addr (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 2) (die-at (cc line) "label-addr: expects 1 label name"))
    (let (nm:ptr:Node (unsafe/cast ptr:Node (node-at cc 1)))
      (when (!= (nm kind) NODE-SYM)
        (die-at (node-line (as ptr nm) (cc line)) "label-addr: name must be symbol"))
      (let (e:ptr:LabelEntry (unsafe/cast ptr:LabelEntry (lbl-find (nm s))))
        (when (= (as ptr e) null)
          (die-at (node-line (as ptr nm) (cc line)) (fmt-s "label-addr: no such label '%s' in function" (nm s)))))
      (when (= g-cur-fname null)
        (die-at (cc line) "label-addr: not inside a function"))
      (let (tmp:ptr (new-tmp))
        ; getelementptr offset 0 is a no-op binding the blockaddress to an SSA name.
        (fprintf g-body-stream
          "  %s = getelementptr i8, ptr blockaddress(@%s, %%lbl.%s), i64 0\n"
          tmp g-cur-fname (nm s))
        (return (alloc-val ty-ptr tmp))))))

(defn emit-goto-ptr (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 2) (die-at (cc line) "goto-ptr: expects 1 ptr arg"))
    (let (v:ref:Val (emit-node (node-at cc 1) scope))
      (when (!= ((v type) kind) TY-PTR)
        (die-at (cc line) "goto-ptr: arg must be ptr"))
      (do
        (when (= (count g-lbl-tbl) 0)
          (die-at (cc line) "goto-ptr: no labels declared in function"))
        (fprintf g-body-stream "  indirectbr ptr %s, [" (v val))
        (let (i:usize 0
              first:i32 1)
          (while (< i (count g-lbl-tbl))
            (let (e:ref:LabelEntry (invoke g-lbl-tbl i))
              (when (= first 0) (fprintf g-body-stream ","))
              (set! first 0)
              (fprintf g-body-stream " label %%lbl.%s" (e name)))
            (set! i (+ i 1))))
        (fprintf g-body-stream " ]\n"))
      (let (dead:ptr (fmt-i32 "goto-ptr.dead%d" (new-label-id)))
        (fprintf g-body-stream "%s:\n" dead))
      (set! g-block-term 0)
      (return (alloc-val ty-void null)))))

; ============================================================
; Stage 8: struct/array compound literals and field-address
; ============================================================

(defn struct-field-idx (sd:(raw StructDef) name:CStr):i32
  (let (sdef:ptr:StructDef (unsafe/cast ptr:StructDef sd))
    (dotimes (i (sdef num-fields))
      (when (= (strcmp ((field-at (sdef fields) i) name) name) 0)
        (return i)))
    (return -1)))

; (.& p field) -> pointer to the field within struct *p.
(defn emit-field-addr (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 3) (die-at (cc line) ".& expects 2 args"))
    (let (p:ref:Val (emit-node (node-at cc 1) scope)
          pt:ptr:Type (unsafe/cast ptr:Type (p type))
          ek:i32 (if (and (= (pt kind) TY-PTR) (!= (pt elem) null))
                   (-> pt (_ elem) (unsafe/cast ptr:Type _) (_ kind))
                   TY-VOID))
      (when (and (!= ek TY-STRUCT) (!= ek TY-UNION))
        (die-at (cc line) ".&: operand must be pointer to struct or union"))
      (require-derefable pt (cc line) ".&")
      (let (fn-node:ptr:Node (unsafe/cast ptr:Node (node-at cc 2)))
        (when (!= (fn-node kind) NODE-SYM)
          (die-at (node-line (as ptr fn-node) (cc line)) ".&: field name must be symbol"))
        (let (sd:ptr:StructDef (unsafe/cast ptr:StructDef ((pt elem) sdef))
              idx:i32 (struct-field-idx (as ptr sd) (fn-node s)))
          (reject-cycle-pending-sdef (as ptr sd)
                                     (node-line (as ptr fn-node) (cc line))
                                     "field address")
          (union-field-guard (as ptr sd) (cc line) ".&")
          (when (< idx 0)
            (die-at (node-line (as ptr fn-node) (cc line))
              (fmt-2s ".&: no field '%s' on struct '%s'" (fn-node s) (sd name))))
          (let (ftype:ptr ((field-at (sd fields) idx) type)
                gep:ptr (p val))
            ; A union member's address is the union's address (offset 0).
            (when (!= ek TY-UNION)
              (set! gep (new-tmp))
              (fprintf g-body-stream
                "  %s = getelementptr inbounds %%%s, ptr %s, i32 0, i32 %d\n"
                gep (sd ir-name) (p val) idx))
            ; Stage 15 W8 G-2: `.&` on an `(array T N)` field would otherwise
            ; produce `ptr:(array T N)` — a pointer-to-array, whose only legal
            ; uses are the ones an array type is refused in. The address is
            ; numerically the same either way, so hand back the decayed
            ; `ptr:T`, matching what a plain read of the field gives.
            (when (= ((as ptr:Type ftype) kind) TY-ARRAY)
              (set! ftype (as ptr ((array-decay ftype) elem))))
            (let (rt:ptr:Type (as ptr:Type (make-type TY-PTR)))
              (.set! rt elem ftype)
              ; A field's address inside a (non-null) struct is non-null (ref T).
              (.set! rt pkind PTR-REF)
              ; Interior address into the resource: keep the escape taint
              ; (lifecycle.md §2.2) and, Stage 13 L1, the frame-region flag —
              ; so `(.& (addr-of p) f)` over a by-value struct param p stays
              ; frame-tainted and is rejected if returned.
              (let (rv:ref:Val (alloc-val (as ptr rt) gep))
                (val-copy-taint (as ptr rv) (as ptr p))
                (return rv)))))))))

; (array T e0 e1 ... | (idx v) ...) -> ptr:T to a stack array of int elements.
(defn emit-array-lit (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        nargs:i32 (- (node-len cc) 1))
    (when (< nargs 1)
      (die-at (cc line) "array: expects element type and 0+ initializers"))
    (let (etype-node:ptr (node-at cc 1)
          etype:ptr (parse-type-from-node etype-node ((unsafe/cast ptr:Node etype-node) line))
          ninits:i32 (- nargs 1))
      ; Pass 1: scan inits to compute length and parse designated keys.
      (let (max-idx:i32 -1
            pos-count:i32 0
            keys:ptr (arena-alloc (* (as i64 ninits) 4)))
        (dotimes (i ninits)
          (let (arg:ptr:Node (unsafe/cast ptr:Node (node-at cc (+ 2 i)))
                is-designated:i32 0)
            (when (and (= (arg kind) NODE-CELL)
                       (= (node-len arg) 2)
                       (= ((unsafe/cast ptr:Node (node-at arg 0)) kind) NODE-INT))
              (set! is-designated 1))
            (if (!= is-designated 0)
              (let (k:i64 ((unsafe/cast ptr:Node (node-at arg 0)) i))
                (when (< k 0)
                  (die-at (node-line (as ptr arg) (cc line)) "array: designated index must be non-negative"))
                (when (> (unsafe/cast i32 k) max-idx) (set! max-idx (unsafe/cast i32 k)))
                (aset! (as ptr:i32 keys) i (unsafe/cast i32 k)))
              (do
                (aset! (as ptr:i32 keys) i -1)
                (inc! pos-count)))))
        (let (length:i32 pos-count)
          (when (> (+ max-idx 1) length) (set! length (+ max-idx 1)))
          (when (= length 0) (die-at (cc line) "array: at least one initializer required"))
          (let (vals:ptr (arena-alloc (* (as i64 length) 8))
                seen:ptr (arena-alloc (* (as i64 length) 4))
                pos-cursor:i32 0
                j:i32 0)
            (while (< j length)
              (aset! (as ptr:ptr vals) j null)
              (aset! (as ptr:i32 seen) j 0)
              (inc! j))
            ; Place designated inits.
            (set! j 0)
            (while (< j ninits)
              (let (k:i32 (aref (as ptr:i32 keys) j))
                (when (>= k 0)
                  (when (!= (aref (as ptr:i32 seen) k) 0)
                    (die-at ((unsafe/cast ptr:Node (node-at cc (+ 2 j))) line)
                      (fmt-i32 "array: index %d specified twice" k)))
                  (aset! (as ptr:i32 seen) k 1)
                  (let (vexpr:ptr (node-at (unsafe/cast ptr:Node (node-at cc (+ 2 j))) 1)
                        v:ref:Val (emit-node vexpr scope)
                        coerced:ptr (coerce-int-val v etype (cc line)))
                    (when (= coerced null)
                      (die-at (cc line) "array: type mismatch in designated initializer"))
                    (aset! (as ptr:ptr vals) k coerced))))
              (inc! j))
            ; Positional inits fill the next unspecified slots.
            (set! j 0)
            (while (< j ninits)
              (let (k:i32 (aref (as ptr:i32 keys) j))
                (when (< k 0)
                  (while (and (< pos-cursor length)
                              (!= (aref (as ptr:i32 seen) pos-cursor) 0))
                    (inc! pos-cursor))
                  (when (>= pos-cursor length)
                    (die-at (cc line) "array: positional initializer overflows length"))
                  (let (arg:ptr (node-at cc (+ 2 j))
                        v:ref:Val (emit-node arg scope)
                        coerced:ptr (coerce-int-val v etype (cc line)))
                    (when (= coerced null)
                      (die-at (cc line) "array: type mismatch in positional initializer"))
                    (aset! (as ptr:i32 seen) pos-cursor 1)
                    (aset! (as ptr:ptr vals) pos-cursor coerced)
                    (inc! pos-cursor))))
              (inc! j))
            ; Emit alloca in entry stream, then fill slots.
            (let (slot:ptr (new-tmp)
                  etype-ir:ptr (type-to-ir etype))
              (fprintf g-entry-stream "  %s = alloca %s, i32 %d\n" slot etype-ir length)
              (dotimes (k length)
                (let (gep:ptr (new-tmp))
                  (fprintf g-body-stream
                           "  %s = getelementptr inbounds %s, ptr %s, i64 %d\n"
                           gep etype-ir slot k)
                  (let (vp:ptr (aref (as ptr:ptr vals) k))
                    (if (= vp null)
                        (emit-zero-store etype gep)
                        (let (cv:ptr:Val (as ptr:Val vp))
                          (fprintf g-body-stream "  store %s %s, ptr %s\n"
                                   etype-ir (cv val) gep))))))
              (let (pt:ptr:Type (as ptr:Type (make-type TY-PTR)))
                (.set! pt elem etype)
                ; A stack array literal is a valid, non-null address (ref T).
                (.set! pt pkind PTR-REF)
                (return (alloc-val (as ptr pt) slot))))))))))

; (S e0 e1 ... | (field v) ...) -> ptr:S compound literal (struct-name head).
(defn emit-struct-lit (call:(raw Node) scope:ref:Scope sd:(raw StructDef)):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call)
        sdef:ptr:StructDef (unsafe/cast ptr:StructDef sd)
        nargs:i32 (- (node-len cc) 1)
        nfields:i32 ((unsafe/cast ptr:StructDef sd) num-fields))
    ; W1d: a cycle-pending layout has nfields == 0, so every initializer would
    ; look like one too many. Say what actually went wrong.
    (reject-cycle-pending-sdef sd (cc line) "struct literal")
    (when (> nargs nfields)
      (die-at (cc line) (fmt-s "struct literal: too many initializers for struct '%s'" (sdef name))))
    (let (vals:ptr (arena-alloc (* (as i64 nfields) 8))
          seen:ptr (arena-alloc (* (as i64 nfields) 4))
          pos-idx:i32 0
          i:i32 0)
      (while (< i nfields)
        (aset! (as ptr:ptr vals) i null)
        (aset! (as ptr:i32 seen) i 0)
        (inc! i))
      (set! i 0)
      (while (< i nargs)
        (let (arg:ptr:Node (unsafe/cast ptr:Node (node-at cc (+ 1 i)))
              is-designated:i32 0)
          (when (= (arg kind) NODE-CELL)
            (when (and (= (node-len arg) 2)
                       (= ((unsafe/cast ptr:Node (node-at arg 0)) kind) NODE-SYM))
              (set! is-designated 1)))
          (if (!= is-designated 0)
            (let (fname-node:ptr:Node (unsafe/cast ptr:Node (node-at arg 0))
                  vexpr:ptr (node-at arg 1)
                  fidx:i32 (struct-field-idx sd (fname-node s)))
              (when (< fidx 0)
                (die-at (node-line (as ptr fname-node) (cc line))
                  (fmt-s "struct literal: no field '%s'" (fname-node s))))
              (when (!= (aref (as ptr:i32 seen) fidx) 0)
                (die-at (node-line (as ptr fname-node) (cc line))
                  (fmt-s "struct literal: field '%s' specified twice" (fname-node s))))
              (aset! (as ptr:i32 seen) fidx 1)
              (let (ftype:ptr ((field-at (sdef fields) fidx) type)
                    v:ref:Val (emit-node vexpr scope)
                    coerced:ptr (coerce-int-val v ftype (cc line)))
                (when (= coerced null)
                  (die-at (cc line)
                    (fmt-s "struct literal: type mismatch for field '%s'" (fname-node s))))
                (aset! (as ptr:ptr vals) fidx coerced)))
            (do
              (while (and (< pos-idx nfields)
                          (!= (aref (as ptr:i32 seen) pos-idx) 0))
                (inc! pos-idx))
              (when (>= pos-idx nfields)
                (die-at (node-line (as ptr arg) (cc line)) "struct literal: too many positional initializers"))
              (let (ftype:ptr ((field-at (sdef fields) pos-idx) type)
                    v:ref:Val (emit-node arg scope)
                    coerced:ptr (coerce-int-val v ftype (cc line)))
                (when (= coerced null)
                  (die-at (cc line) "struct literal: type mismatch for positional initializer"))
                (aset! (as ptr:i32 seen) pos-idx 1)
                (aset! (as ptr:ptr vals) pos-idx coerced)
                (inc! pos-idx)))))
        (inc! i))
      (let (slot:ptr (new-tmp)
            sname:ptr (sdef ir-name))
        (fprintf g-entry-stream "  %s = alloca %%%s\n" slot sname)
        (dotimes (k nfields)
          (let (ftype:ptr ((field-at (sdef fields) k) type)
                          ftype-ir:ptr (type-to-ir ftype)
                          gep:ptr (new-tmp))
            (fprintf g-body-stream
                     "  %s = getelementptr inbounds %%%s, ptr %s, i32 0, i32 %d\n"
                     gep sname slot k)
            (let (vp:ptr (aref (as ptr:ptr vals) k))
              (if (= vp null)
                  (emit-zero-store ftype gep)
                  (let (cv:ptr:Val (as ptr:Val vp))
                    (fprintf g-body-stream "  store %s %s, ptr %s\n"
                             ftype-ir (cv val) gep))))))
        (let (pt:ptr:Type (as ptr:Type (make-type TY-PTR))
              st:ptr:Type (as ptr:Type (make-type TY-STRUCT)))
          (.set! st sdef sd)
          (.set! pt elem (as ptr st))
          ; A stack compound literal is a valid, non-null address (ref T).
          (.set! pt pkind PTR-REF)
          (return (alloc-val (as ptr pt) slot)))))))

; ============================================================
; Macro expansion (calls JIT-compiled macro functions at compiler runtime)
; ============================================================

; Stage 15 B7 — macros are the last kind cut over to the canonicaliser
; (name-resolution.md §9.7), so they get the same reference/key split every
; other kind has (conventions.md, "a name-resolution rule has TWO entry
; points"). It is unusually clean here: `find-macro` is the registry's ONLY
; reader, and of its call sites exactly one — `emit-defmacro`'s redefinition
; guard — holds a key rather than a source spelling.
;
; The KEY lookup: `key` is already canonical (`qualify-name` of the definer's
; own name). The visibility filter stays on this side as well as the reference
; side, and a define always finds its own entry regardless, because its
; `src-ns` is `g-current-ns` at the moment it asks.
(defn find-macro-exact (key:CStr):?ptr:MacroDef
  (doseq (mdef g-macros (VecIter ref:MacroDef))
           (when (and (= (mdef name) key)
                      (or (= g-priv-bindings 0)
                          (!= (binding-visible (mdef priv) (mdef src-ns)) 0)))
                 (return (as ptr mdef))))
  (return null))

; The REFERENCE resolver: `spelling` is a head symbol as written in the file
; being compiled. Same candidate-key walk as the six type registries B3′ cut
; over — the current namespace's key, then each namespace this file flattened,
; then `user` — and a qualified spelling resolves through the import
; environment alone, so `p/mac` works and the library's own namespace does not
; (R3). The alias probe is what makes `(export some-macro)` reachable through a
; facade; it is a single global compare for any program with no facade.
(defn find-macro (spelling:CStr):?ptr:MacroDef
  (dotimes (i (name-ref-key-count spelling))
    (let (k:CStr (name-ref-key-at spelling i))
      (when (!= k null)
        (let (hit:?ptr:MacroDef (find-macro-exact k))
          (when (!= hit null) (return hit))))))
  (let (al:ptr (binding-alias-find spelling BK-MACRO))
    (when (!= al null) (return (as ptr:MacroDef al))))
  (return null))

; Run one expansion of a macro call: invoke the JIT-compiled macro function
; and return the resulting (ptr Node). Does not desugar or emit IR.
; Attribute macro-generated nodes to the call site. Nodes synthesized during
; expansion (the cons cells built by the __cons/__append quasiquote helpers)
; carry line 0; spliced user arguments keep their real reader line. Stamping
; only line-0 nodes fills in the macro's own structure with the call-site line
; so downstream errors (e.g. a malformed `cond` from a bad `case`/`if`) point at
; the user's code instead of line 0. A non-zero line means the whole subtree is
; already attributed (a user argument), so we stop there.
(defn stamp-macro-lines (node:(raw Node) ln:i32):void
  (when (= node null) (return))
  (let (n:ptr:Node (unsafe/cast ptr:Node node))
    ; Stage 15 W4a: NEVER stamp a symbol node. A symbol is an interned singleton
    ; shared by every occurrence of that spelling program-wide (lib/node.nuc
    ; `node-line`), so writing a line into it is observed by every *other*
    ; occurrence too — the first macro expansion mentioning `x` would make every
    ; later diagnostic about any `x` anywhere report that macro's call line.
    ; Symbols legitimately have no line; their diagnostics borrow the enclosing
    ; form's, which this function does attribute. (Symbols have no children, so
    ; skipping them costs no traversal.)
    (when (= (n kind) NODE-SYM) (return))
    (when (!= (n line) 0) (return))
    (.set! n line ln)
    (when (= (n kind) NODE-CELL)
      (stamp-macro-lines (n car) ln)
      (stamp-macro-lines (n cdr) ln))))

(defn expand-macro-call (call:(raw Node) macro-def:(raw MacroDef)):ptr
  (let (mdef:ptr:MacroDef (unsafe/cast ptr:MacroDef macro-def)
        nargs:i32 (- (node-len (unsafe/cast ptr:Node call)) 1))
    (when (!= (mdef variadic) 0)
      (when (< nargs (- (mdef num-params) 1))
        (die-at ((unsafe/cast ptr:Node call) line)
                (fmt-s-2i "macro '%s': expects at least %d args, got %d"
                          (mdef name) (- (mdef num-params) 1) nargs))))
    (when (= (mdef variadic) 0)
      (when (!= nargs (mdef num-params))
        ; Stage 15 W4d: a one-armed `(if test then)` is the single most common
        ; fixed-arity macro miscall (C/JS habit carried over) -- name the fix
        ; directly rather than a generic arg-count message.
        (if (and (= (mdef name) "if") (= nargs 2))
          (die-at ((unsafe/cast ptr:Node call) line)
                  (as ptr "if requires an else branch; use (when test then…) for a guard"))
          (die-at ((unsafe/cast ptr:Node call) line)
                  (fmt-s-2i "macro '%s': expects %d args, got %d"
                            (mdef name) (mdef num-params) nargs)))))
    (let (args-arr:ptr (malloc (* (as i64 (mdef num-params)) (ptr-bytes)))
          regular-params:i32 (mdef num-params))
      (when (!= (mdef variadic) 0)
        (set! regular-params (- (mdef num-params) 1)))
      (dotimes (i regular-params)
        (aset! (as ptr:ptr args-arr) i (node-at (unsafe/cast ptr:Node call) (+ i 1))))
      (when (!= (mdef variadic) 0)
        (let (rest-list:ptr null
              rj:i32 nargs)
          (while (> rj regular-params)
            (set! rj (- rj 1))
            (set! rest-list (make-cell (node-at (unsafe/cast ptr:Node call) (+ rj 1)) rest-list 0)))
          (aset! (as ptr:ptr args-arr) regular-params rest-list)))
      (let (addr:i64 0
            err:ptr (LLVMOrcLLJITLookup g-jit (addr-of addr) (mdef jit-name)))
        (when (!= err null)
          (fprintf stderr "%s: macro '%s': JIT lookup failed\n"
                        g-source-path (mdef name))
          (exit 1))
        (when (= (unsafe/cast ptr addr) null)
          (fprintf stderr "%s: macro '%s': JIT function not found\n"
                        g-source-path (mdef name))
          (exit 1))
        (let (result:ptr (unsafe/funcall-ptr-1 (unsafe/cast ptr addr) args-arr))
          (free args-arr)
          (when (= result null)
            (fprintf stderr "%s: macro '%s': returned null\n"
                          g-source-path (mdef name))
            (exit 1))
          ; Attribute the expansion to the macro call site so errors in
          ; macro-generated forms report a real source line, not line 0.
          (stamp-macro-lines result ((unsafe/cast ptr:Node call) line))
          (return result))))))

; Expand a form by macros. depth=1 expands once; depth<0 expands until the
; head is no longer a macro (fixpoint). Subforms are not recursed into,
; matching Common Lisp macroexpand semantics.
(defn macroexpand-form (form:(raw Node) depth:i32):ptr
  (let (cur:ptr form
        steps:i32 0
        keep-going:i32 1)
    (while (!= keep-going 0)
      (set! keep-going 0)
      (when (and (!= cur null)
                 (= ((unsafe/cast ptr:Node cur) kind) NODE-CELL)
                 (!= (node-len (unsafe/cast ptr:Node cur)) 0))
        (let (head:ptr:Node (unsafe/cast ptr:Node (node-at (unsafe/cast ptr:Node cur) 0)))
          (when (= (head kind) NODE-SYM)
            (let (mdef:ptr (find-macro (head s)))
              (when (!= mdef null)
                (when (or (< depth 0) (< steps depth))
                  (set! cur (expand-macro-call cur mdef))
                  (inc! steps)
                  (set! keep-going 1))))))))
    (return cur)))

; Like macroexpand-form but recursively expands subforms after the head
; reaches fixpoint. Quoted/quasiquoted forms are left untouched.
(defn macroexpand-all-form (form:(raw Node)):ptr
  (let (cur:ptr (macroexpand-form form -1))
    (when (or (= cur null)
              (!= ((unsafe/cast ptr:Node cur) kind) NODE-CELL))
      (return cur))
    (when (= (node-len (unsafe/cast ptr:Node cur)) 0) (return cur))
    (let (head:ptr:Node (unsafe/cast ptr:Node (node-at (unsafe/cast ptr:Node cur) 0)))
      (when (and (= (head kind) NODE-SYM)
                 (or (= (head s) "quote")
                     (= (head s) "quasiquote")))
        (return cur)))
    (let (out:ptr null
          tail:ptr null
          it:ptr:Node (unsafe/cast ptr:Node cur))
      (while (and (!= (as ptr it) null) (= (it kind) NODE-CELL))
        (let (child:ptr (macroexpand-all-form (it car))
              new:ptr (make-cell child null (it line)))
          (if (= out null)
            (do (set! out new) (set! tail new))
            (do (.set! (unsafe/cast ptr:Node tail) cdr new)
                (set! tail new))))
        (set! it (unsafe/cast ptr:Node (it cdr))))
      (return out))))

(defn emit-macro-expand (call:(raw Node) scope:ref:Scope macro-def:(raw MacroDef)):ref:Val
  (let (result:ptr (expand-macro-call call macro-def))
    (return (emit-node (desugar result) scope))))

; ============================================================
; List dispatch
; ============================================================

; Emit a call to a resolved method `m` of generic `gname`, given the argument
; Vals already emitted into `args`. Coerces each argument to the method's
; parameter type (identity for an exact match, so the IR is unchanged) then
; emits the call to the selected symbol. Shared by ordinary overloaded dispatch
; and the operator user-overload path.
(defn emit-resolved-call (n:(raw Node) scope:ref:Scope gname:CStr m:ref:Method args:ptr nargs:i32 line:i32):ref:Val
  (let (ss:ref:Sym (new Sym))
    (when (and (!= (m param-types) null)
               (= (m has-rest) 0)
               (= (m num-params) nargs))
      (let (ci:i32 0)
        (while (< ci nargs)
          (let (slot:ptr (unsafe/ptr+ (as ptr:Val args) ci)
                pt:ptr (aref (as ptr:ptr (m param-types)) ci)
                na:ptr (coerce-num-val slot pt line))
            (when (and (!= na null) (!= na slot)) (memcpy slot na (sizeof Val))))
          (inc! ci))))
    ; Stage 13 L7: a bare TY-FN argument (function pointer) flowing into a
    ; (ref TY-FN) param (unify-tpat's TY-FN-into-(ref G) rule) needs calling-
    ; convention adaptation. The callee treats the param as pointer-to-fn-ptr
    ; (it will (deref self) to load the function pointer), but the caller has
    ; a bare function pointer. Emit an alloca, store the fn ptr into it, and
    ; pass the slot's address so the callee's deref loads the right value.
    (when (and (!= (m param-types) null)
               (= (m has-rest) 0)
               (= (m num-params) nargs))
          (dotimes (ci nargs)
            (let (slot:ptr (unsafe/ptr+ (as ptr:Val args) ci)
                           pt:ptr (aref (as ptr:ptr (m param-types)) ci)
                           av:ptr:Val (as ptr:Val slot)
                           aty:ptr:Type (unsafe/cast ptr:Type (av type))
                           ptt:ptr:Type (as ptr:Type pt))
              (when (and (= (aty kind) TY-FN)
                         (= (ptt kind) TY-PTR)
                         (= (ptt pkind) PTR-REF)
                         (!= (ptt elem) null)
                         (= (-> (ptt elem) (unsafe/cast ptr:Type _) (_ kind)) TY-FN))
                    (let (tmp:ptr (new-tmp))
                      (fprintf g-body-stream "  %s = alloca ptr, align 8\n" tmp)
                      (fprintf g-body-stream "  store ptr %s, ptr %s, align 8\n" (av val) tmp)
                      (.set! av type pt)
                      (.set! av val tmp))))))
    (.set! ss name gname)
    (.set! ss type (m fn-type))
    (.set! ss ir-name (m ir-name))
    (.set! ss is-local 0)
    (return (emit-call-with-args n scope ss args nargs))))

; Emit a call to an overloaded generic: emit the arguments, resolve the method
; from their concrete types, then emit the call to the selected mangled symbol.
(defn emit-generic-call (n:(raw Node) scope:ref:Scope g:ref:Generic):ref:Val
  (let (nn:ptr:Node (unsafe/cast ptr:Node n)
        nargs:i32 (- (node-len nn) 1)
        args:ptr (arena-alloc (* (as i64 (+ nargs 1)) (sizeof Val)))
        argtypes:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes)))
        arg-nodes:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes))))
    ; TC-2: consume the want channel once, at entry and BEFORE emitting any
    ; argument, so an argument sub-expression that is itself a call never sees
    ; the outer want. The first generic call emitted in a binding init claims it;
    ; a control form (if/cond/do/match/let body) leaves g-want-type armed, so the
    ; first call anywhere in the init is the consumer. `want` is null in every
    ; non-want context (statement position, most calls) — generic-resolve's tier-0
    ; ignores it and want only fills tyvars args left unbound, so this is inert
    ; for every call that resolves without it.
    (let (want:ptr g-want-type)
      (set! g-want-type null)
      (dotimes (i nargs)
        (let (anode:ptr (node-at nn (+ i 1))
              v:ref:Val (emit-node anode scope))
          (memcpy (unsafe/ptr+ (as ptr:Val args) i) v (sizeof Val))
          (aset! (as ptr:ptr argtypes) i ((as ptr:Val v) type))
          (aset! (as ptr:ptr arg-nodes) i anode)))
      ; Stage 13 TE-6: `(dyn P)` method dispatch. When the first argument is a
      ; `(dyn P)` box and this generic names one of P's methods, the box has no
      ; concrete receiver method to resolve — forward through the vtable slot instead
      ; (an indirect call `method(data, args…)`). Inert otherwise (the compiler boxes
      ; nothing; dyn-canonical is null at every call site during self-compilation).
      (when (> nargs 0)
        (let (dbox:ptr (dyn-canonical (aref (as ptr:ptr argtypes) 0)))
          (when (!= dbox null)
            (let (slot:i32 (dyn-method-slot dbox (g name)))
              (when (>= slot 0)
                (return (emit-dyn-forward dbox args nargs slot (nn line))))))))
      (let (m:ref:Method (generic-resolve g argtypes arg-nodes nargs (nn line) want))
        (return (emit-resolved-call n scope (g name) m
                                    args nargs (nn line)))))))

; Emit an operator that carries user overloads (§10.3). Emit the operands, then
; resolve a user method on the operator's argument types; if one matches, emit a
; call to it, otherwise fall back to the built-in numeric/pointer inline peephole
; (emit-binop-vals). A pure operator (no user overloads) never reaches here — it
; short-circuits to emit-binop in emit-dispatch, preserving byte-identical IR.
(defn emit-operator-dispatch (n:(raw Node) scope:ref:Scope g:ref:Generic binop:(raw BinOp)):ref:Val
  (let (nn:ptr:Node (unsafe/cast ptr:Node n)
        nargs:i32 (- (node-len nn) 1)
        args:ptr (arena-alloc (* (as i64 (+ nargs 1)) (sizeof Val)))
        argtypes:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes)))
        arg-nodes:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes))))
    (dotimes (i nargs)
      (let (anode:ptr (node-at nn (+ i 1))
            v:ref:Val (emit-node anode scope))
        (memcpy (unsafe/ptr+ (as ptr:Val args) i) v (sizeof Val))
        (aset! (as ptr:ptr argtypes) i ((as ptr:Val v) type))
        (aset! (as ptr:ptr arg-nodes) i anode)))
    (let (m:?ptr:Method (operator-user-resolve g argtypes arg-nodes nargs))
      (when (!= m null)
        (return (emit-resolved-call n scope (g name) m
                                    args nargs (nn line))))
      (when (!= nargs 2)
        (die-at (nn line) (fmt-s "%s expects 2 args" ((unsafe/cast ptr:BinOp binop) name))))
      (return (emit-binop-vals (unsafe/ptr+ (as ptr:Val args) 0) (unsafe/ptr+ (as ptr:Val args) 1)
                               (aref (as ptr:ptr arg-nodes) 0) (aref (as ptr:ptr arg-nodes) 1)
                               binop scope (nn line))))))

; ============================================================
; Stage 15 B5 — THE SHARED BINDING INTERFACE
; (design/stage15-stress-test/name-resolution.md §13.3 "B+", §13.4)
; ============================================================
;
; §1 counted eleven name-keyed registries and two correctly-global name sets.
; Each is one row here, and the ROW ORDER IS THE RESOLUTION PRIORITY ORDER —
; the single answer to defect #8, which had the one-symbol-one-kind guard ranking
; special > builtin > type > macro > function > value while `emit-dispatch`
; probed generic → scope → struct → struct-template. Both now walk this table.
;
; Rows 0–2 (`macro`, `special form`, `built-in type`) are answered by
; `emit-list`, which dispatches macros and then special forms by interned head
; pointer before `emit-dispatch` is ever reached; `emit-dispatch` therefore
; starts at `BK-DISPATCH-FIRST`. That split is stated, not accidental — and the
; macro-before-special order `emit-list` uses is *provably* the same function as
; this table's, because `guard-name-kind` refuses to register a macro over a
; special form (so no name can be in both rows). See §13.3 in the design doc.
;
; The five operations §13.3 asked for, and where they live:
;   probe(canonical)              `binding-probe`
;   kind-noun                     `binding-noun` (row column, refined for globals)
;   is-private(binding)           `binding-is-private`  → the rule: `binding-visible`
;   src-ns(binding)               `binding-src-ns`
;   re-register(binding, key)     `binding-re-register`
;
; Adding a kind means adding a row: the `collides` / `name-keyed` /
; `reregisterable` columns make a kind that does NOT participate in a shared
; concern a stated fact rather than a silent omission, which is exactly the
; failure mode §13.2 found twice (NK-PROTOCOL never returned; four private
; definers nothing enforced).

(defn add-binding-kind (v:(ref (Vector (ref BindingKind)))
                        kind:i32 noun:CStr nk:i32
                        collides:i32 name-keyed:i32 reregisterable:i32):void
  (let (r:ref:BindingKind (new BindingKind))
    (.set! r kind kind)
    (.set! r noun noun)
    (.set! r nk nk)
    (.set! r collides collides)
    (.set! r name-keyed name-keyed)
    (.set! r reregisterable reregisterable)
    (conj v r)))

; The table. Row i has `kind` == i, so `binding-row` is an index.
;
; `collides` is 1 for exactly the rows the one-symbol-one-kind guard probed
; before B5, PLUS protocols (the reported defect), PLUS — since B4 — unions and
; enums. What remains 0 is now stated as policy rather than as inheritance:
;   * BK-UNION was 0 because `register-uniondef` also registers the union's
;     backing StructDef under the same key, so BK-STRUCT (an earlier row) answers
;     for every union name. It is 1 anyway: the row is where a kind's
;     participation is DECLARED, and leaving it 0 made the rule depend on another
;     registry's implementation detail. Measured inert — BK-STRUCT still answers
;     first for every union in the tree.
;   * BK-ENUM was 0 and that was a genuine hole, not a redundancy: an enum
;     registers its MEMBERS in g-globals but never its own name, so nothing
;     probed it and `(defenum E …) (defn E …)`, `(defvar E …)` and `(defmacro E …)`
;     all compiled with `E` naming two things at once.
;   * BK-FNTY stays 0 on the same ground as its `reregisterable`: a `__fnty_N` is
;     minted by `fnty-intern`, has no source spelling, and cannot be the subject
;     of a definer — so the row has no collision to report and probing it would
;     cost every definer a hashmap lookup.
;   * BK-CONFORMANCE has no single-name probe at all (see `name-keyed`).
; `reregisterable` is 1 only for `g-globals`, which is what `export` re-binds
; today. Every other row raises a located diagnostic — §11.6's conclusion that
; a facade cannot re-export a type or protocol, now said in one place instead
; of being unrepresentable. B3′ flips BK-STRUCT and friends when it re-keys
; them.
(defn build-binding-kinds ():(ref (Vector (ref BindingKind)))
  (let (v:(ref (Vector (ref BindingKind))) (vector-new-in (addr-of g-arena-alloc)))
    ;                kind                noun                 nk           col nk? rereg?
    ; Stage 15 B7: `reregisterable` 1. It was 0 with the justification that a
    ; macro "is identified by a globally-unique bare name" — which was true only
    ; because macros had never been keyed by namespace, i.e. the gap was being
    ; quoted as the reason not to close it (name-resolution.md §11.6's
    ; correction box). Now that `g-macros` is ns-keyed, a facade re-exports a
    ; macro through the same alias table types and protocols use.
    (add-binding-kind v BK-MACRO          "a macro"            NK-MACRO      1   1   1)
    (add-binding-kind v BK-SPECIAL        "a special form"     NK-SPECIAL    1   1   0)
    (add-binding-kind v BK-PRIMITIVE      "a built-in type"    NK-BUILTIN    1   1   0)
    (add-binding-kind v BK-GENERIC        "a function"         NK-FUNCTION   1   1   0)
    (add-binding-kind v BK-GLOBAL         "a value"            NK-VALUE      1   1   1)
    (add-binding-kind v BK-PROTOCOL       "a protocol"         NK-PROTOCOL   1   1   1)
    (add-binding-kind v BK-STRUCT         "a type"             NK-TYPE       1   1   1)
    (add-binding-kind v BK-UNION          "a type"             NK-TYPE       1   1   1)
    (add-binding-kind v BK-STRUCT-TEMPLATE "a struct template" NK-TYPE       1   1   1)
    (add-binding-kind v BK-UNION-TEMPLATE "a type"             NK-TYPE       1   1   1)
    (add-binding-kind v BK-ENUM           "an enumeration"     NK-TYPE       1   1   1)
    ; BK-FNTY stays 0: a `__fnty_N` is minted by the compiler, has no source
    ; spelling, and is not re-keyed by B3′ (see `binding-probe`).
    (add-binding-kind v BK-FNTY           "a function type"    NK-TYPE       0   1   0)
    (add-binding-kind v BK-CONFORMANCE    "a conformance"      NK-NONE       0   0   0)
    (return v)))

(defn binding-row (kind:i32):ref:BindingKind
  (return (invoke g-binding-kinds (as usize kind))))

; ------------------------------------------------------------
; is-private / src-ns, and the ONE visibility rule they feed
; ------------------------------------------------------------

; THE rule, written once (§13.3: "privacy is implemented once against
; `is-private` rather than once per kind"). A private binding is visible only
; inside its defining NAMESPACE — W5e's deliberate split: `defn-`/`defvar-`/
; `defconst-`/`defenum-` are additionally file-scoped inside `user` because
; their keys can carry a synthetic namespace, while a type, protocol or macro
; name is bare-keyed and globally identified (Stage 12 decision 9), so
; file-scoping those is a separate, larger question.
;
; Every caller is short-circuited by `g-priv-bindings`, which no program in
; `src/`, `lib/`, `examples/` or `tests/` ever sets — so this is provably inert
; for the whole tree and can only ever refuse a name a `defstruct-`/`defunion-`/
; `defmacro-`/`defprotocol-` created.
(defn binding-visible (priv:i32 src-ns:CStr):i32
  (when (= priv 0) (return 1))
  (when (= src-ns null) (return 1))
  (when (= (strcmp src-ns g-current-ns) 0) (return 1))
  (return 0))

; The namespace part of an already-composed registry key (`zn/zfun` → `zn`), or
; `user` when the key is bare. `g-globals`, `g-protocols` and (since B3′) the six
; type registries key this way. INTERNED, because `ns-ir-prefix-get` matches its
; namespace column by pointer identity — B3′'s `register-struct` derives a type's
; ir-prefix from its key through exactly that path.
(defn key-namespace (key:CStr):CStr
  (let (n:i64 (qualifier-len (as ptr key)))
    (when (<= n 0) (return (as CStr (intern-str "user"))))
    (return (as CStr (intern-str (arena-strndup (as ptr key) n))))))

(defn binding-is-private (kind:i32 payload:ptr):i32
  (when (= payload null) (return 0))
  (case kind
    BK-GLOBAL          (return ((as ptr:Sym payload) sym-private))
    BK-GENERIC
      (let (g:ptr:Generic (as ptr:Generic payload))
        (when (= (unsafe/cast i32 (count (g methods))) 0) (return 0))
        (return ((as ptr:Method (invoke (g methods) 0)) priv)))
    BK-MACRO           (return ((as ptr:MacroDef payload) priv))
    BK-PROTOCOL        (return ((as ptr:Protocol payload) priv))
    BK-STRUCT          (return ((as ptr:StructDef payload) priv))
    BK-UNION           (return ((as ptr:UnionDef payload) priv))
    BK-STRUCT-TEMPLATE (return ((as ptr:StructTemplate payload) priv))
    BK-UNION-TEMPLATE  (return ((as ptr:UnionTemplate payload) priv))
    BK-ENUM            (return ((as ptr:EnumDef payload) priv))
    0)
  ; BK-SPECIAL / BK-PRIMITIVE / BK-FNTY / BK-CONFORMANCE: built-in or
  ; compiler-minted, never private.
  (return 0))

(defn binding-src-ns (kind:i32 payload:ptr):CStr
  (when (= payload null) (return null))
  (case kind
    BK-GLOBAL          (return (key-namespace ((as ptr:Sym payload) name)))
    BK-GENERIC
      (let (g:ptr:Generic (as ptr:Generic payload))
        (when (= (unsafe/cast i32 (count (g methods))) 0) (return null))
        (return ((as ptr:Method (invoke (g methods) 0)) src-ns)))
    BK-MACRO           (return ((as ptr:MacroDef payload) src-ns))
    BK-PROTOCOL        (return ((as ptr:Protocol payload) src-ns))
    BK-STRUCT          (return ((as ptr:StructDef payload) src-ns))
    BK-UNION           (return ((as ptr:UnionDef payload) src-ns))
    BK-STRUCT-TEMPLATE (return ((as ptr:StructTemplate payload) src-ns))
    BK-UNION-TEMPLATE  (return ((as ptr:UnionTemplate payload) src-ns))
    BK-ENUM            (return ((as ptr:EnumDef payload) src-ns))
    0)
  ; No namespace: a special form, a primitive type name, a compiler-minted
  ; `__fnty_N`, or the conformance relation.
  (return null))

; How the file being compiled would have to SPELL this binding, or null when it
; cannot spell it at all. The `src-ns` column is the whole input: a binding in
; the file's own namespace, in `user`, or in a namespace this file flattened is
; named bare; one reached only through a bound prefix is named `p/bare`;
; anything else is unreachable from here and must not be offered as a
; suggestion. This is what closes defect #9 — see `suggest-better`.
(defn binding-usable-spelling (kind:i32 payload:ptr bare:CStr):ptr
  ; A binding this file may not see is not a suggestion. `binding-visible` is
  ; the same rule the reference lookups apply, called here so the did-you-mean
  ; cannot offer a `defstruct-`/`defmacro-` name the very next compile refuses.
  (when (= (binding-visible (binding-is-private kind payload)
                            (binding-src-ns kind payload)) 0)
    (return null))
  (let (ns:CStr (binding-src-ns kind payload))
    ; No namespace at all: a special form, a primitive type name, a
    ; compiler-minted `__fnty_N`. The bare spelling is the only spelling.
    (when (= ns null) (return (as ptr bare)))
    (when (= (strcmp ns g-current-ns) 0) (return (as ptr bare)))
    (when (= (strcmp ns "user") 0) (return (as ptr bare)))
    (when (!= (file-flattens-ns-named ns) 0) (return (as ptr bare)))
    ; A `prefix/name` spelling is offered for every registry where a qualified
    ; reference actually resolves — `g-globals` (B2b), `g-protocols` (B2a), the
    ; five type registries B3′ re-keyed, `g-generics` (B4, through
    ; `Method.src-ns` rather than through a key) and `g-macros` (B7). Since B7
    ; that is every row that HAS a `src-ns`; the rows this excludes are the ones
    ; with no owning namespace at all — a special form, a built-in type name, a
    ; compiler-minted `__fnty_N` — whose bare spelling is their only spelling and
    ; which returned above.
    (when (or (or (or (= kind BK-GLOBAL) (= kind BK-PROTOCOL)) (= kind BK-GENERIC))
              (or (or (or (= kind BK-STRUCT) (= kind BK-UNION)) (= kind BK-MACRO))
                  (or (= kind BK-STRUCT-TEMPLATE)
                      (or (= kind BK-UNION-TEMPLATE) (= kind BK-ENUM)))))
      (let (p:ptr (file-prefix-for-ns ns))
        (when (!= p null) (return (fmt-2s "%s/%s" (as CStr p) bare)))))
    (return null)))

; ------------------------------------------------------------
; probe
; ------------------------------------------------------------

; One row's probe. `name` is a spelling as written in the file being compiled;
; each row applies its OWN registry's reference resolution, which after B2a/B2b
; already routes through `resolve-spelling` for the two ns-keyed registries
; (`g-globals`, `g-protocols`) and is the bare spelling for the rest. B3′ re-keys
; the type rows, at which point their arms become the same two lines the ns-keyed
; ones already are — the interface is the seam where that happens.
;
; `scope` is the local chain for a head-position lookup; null asks the global
; frame only (what a definer's collision check wants).
(defn binding-probe (kind:i32 name:CStr scope:raw:Scope):ptr
  (when (= ((binding-row kind) name-keyed) 0) (return null))
  (case kind
    BK-MACRO      (return (as ptr (find-macro name)))
    ; The two sets have no payload record; the spelling itself is the non-null
    ; "yes". §13.2's payload-free binding, which is what B could not house.
    BK-SPECIAL    (if (!= (special-form-named name) 0) (return (as ptr name)) (return null))
    BK-PRIMITIVE  (if (!= (primitive-type-named name) 0) (return (as ptr name)) (return null))
    ; Stage 15 B4: a REFERENCE resolver, like the rows below it — but one that
    ; recovers the qualified spelling from `Method.src-ns` rather than from a
    ; namespaced key, because R2 keeps a generic's methods merged across every
    ; flattened namespace (see `generic-lookup-ref`).
    BK-GENERIC    (return (as ptr (generic-lookup-ref name)))
    BK-GLOBAL     (if (= scope null)
                    (return (as ptr (scope-lookup g-globals name)))
                    (return (as ptr (scope-lookup scope name))))
    BK-PROTOCOL   (return (as ptr (protocol-lookup name)))
    ; Stage 15 B3′: rows 6–10 are now `resolve-spelling` + an exact probe, which
    ; is exactly what BK-GLOBAL and BK-PROTOCOL already were — B5's prediction,
    ; held. Row 11 (`__fnty_N`) is NOT re-keyed: its names are compiler-minted,
    ; never source-spelled and unit-globally unique, so qualifying them would
    ; only break `type-spelling`'s TY-FN round-trip.
    BK-STRUCT     (return (as ptr (struct-lookup-ref name)))
    BK-UNION      (return (as ptr (uniondef-lookup-ref name)))
    BK-STRUCT-TEMPLATE (return (as ptr (struct-template-lookup-ref name)))
    BK-UNION-TEMPLATE  (return (as ptr (union-template-lookup-ref name)))
    BK-ENUM       (return (as ptr (enumdef-lookup-ref name)))
    BK-FNTY       (return (as ptr (fnty-resolve name)))
    0)
  (return null))

; Walk the table in priority order. `only-colliding` restricts it to the rows
; that participate in the one-symbol-one-kind rule; `from` is the first row to
; try (`emit-dispatch` starts past the rows `emit-list` already answered) and
; `to` the first row NOT to try. The window is how `node-type-call` mirrors
; `emit-dispatch` without re-deriving the order: it models the rows that produce
; a value (through BK-GLOBAL) and stops, rather than probing rows whose only
; answer is a diagnostic.
;
; `skip-nk` (NK-NONE = off) skips rows that report exactly that noun, which is
; what turns this walk into the one-symbol-one-kind check: `guard-name-kind`
; asks for the first binding whose kind is NOT the one it is about to define.
; That question is order-INDEPENDENT — the table order then only chooses which
; of several conflicting kinds to name — and it is the reason a single shared
; order is possible at all. The pre-B5 `name-existing-kind` (now folded into
; `guard-name-kind`) asked "what is the
; highest-priority binding?", which is a different question and only agreed
; with the answer by accident of its ordering: every definer registers itself
; through a prescan BEFORE its own guard runs, so under the dispatch order
; (generic first) a `defn` would find its own freshly-prescanned Generic,
; report NK-FUNCTION, match, and never look at the protocol or struct it
; actually collided with.
(defn binding-find (name:CStr scope:raw:Scope from:i32 to:i32
                    only-colliding:i32 skip-nk:i32):?ref:BindingHit
  (let (i:i32 from)
    (while (< i to)
      (let (row:ref:BindingKind (binding-row i))
        (when (or (= only-colliding 0) (!= (row collides) 0))
          (let (p:ptr (binding-probe i name scope))
            (when (and (!= p null)
                       (or (= skip-nk NK-NONE) (!= (binding-nk i p) skip-nk)))
              (let (hit:ref:BindingHit (new BindingHit))
                (.set! hit kind i)
                (.set! hit payload p)
                (return hit))))))
      (inc! i)))
  (return null))

; ------------------------------------------------------------
; kind-noun
; ------------------------------------------------------------

; The row's noun, refined for `g-globals`: a `defn`/`extern` Sym is a function
; and a `defvar`/`defconst`/enum member is a value, and the discriminator is the
; same two-conjunct test `emit-dispatch` uses to decide a direct call.
(defn binding-nk (kind:i32 payload:ptr):i32
  (when (and (= kind BK-GLOBAL) (!= payload null))
    (let (sym:ptr:Sym (as ptr:Sym payload))
      (when (and (!= (sym type) null)
                 (= (-> sym (_ type) (unsafe/cast ptr:Type _) (_ kind)) TY-FN)
                 (= (sym is-local) 0))
        (return NK-FUNCTION))
      (return NK-VALUE)))
  (return ((binding-row kind) nk)))

; ------------------------------------------------------------
; re-register
; ------------------------------------------------------------

; Stage 15 B3′: the alias table §11.6 needs. `g-globals` stores one entry per KEY,
; so re-exporting into it is a second `scope-define`; every other registry stores
; one record per THING and keys it by a field, so a second key has nowhere to go
; inside it. Rather than teach six registries to hold two names — which would put
; a "which name is this?" question at every read — one shared table maps the extra
; key to the same payload, and each reference lookup consults it after its own
; miss. Null until an `export` of a non-global kind, so the six extra probes cost
; one global compare for every program that does not use one.
(defvar g-binding-aliases:ptr)

(defn binding-alias-add (key:CStr kind:i32 payload:ptr):void
  (when (= g-binding-aliases null)
    (set! g-binding-aliases (vector-new-in (addr-of g-arena-alloc))))
  (let (tbl:(ref (Vector (ref BindingAlias))) (unsafe/cast (ref (Vector (ref BindingAlias))) g-binding-aliases))
    (dotimes (i (unsafe/cast i32 (count tbl)))
      (let (e:ref:BindingAlias (invoke tbl (as usize i)))
        ; Idempotent: a facade re-exporting the same name twice (or a re-imported
        ; facade) must not stack entries.
        (when (and (= (e kind) kind) (= (strcmp (e key) key) 0)) (return))))
    (let (rec:ref:BindingAlias (new BindingAlias))
      (.set! rec key (as CStr (intern-str key)))
      (.set! rec kind kind)
      (.set! rec payload payload)
      (conj tbl rec))))

; The payload `spelling` names through a re-export, or null. `spelling` is a
; source reference, so it is resolved through the file's import environment
; exactly as the registry probes are — a facade's alias is reachable only from a
; file that can name the facade.
(defn binding-alias-find (spelling:CStr kind:i32):ptr
  (when (= g-binding-aliases null) (return null))
  (let (tbl:(ref (Vector (ref BindingAlias))) (unsafe/cast (ref (Vector (ref BindingAlias))) g-binding-aliases))
    (dotimes (i (name-ref-key-count spelling))
      (let (k:CStr (name-ref-key-at spelling i))
        (when (!= k null)
          (dotimes (j (unsafe/cast i32 (count tbl)))
            (let (e:ref:BindingAlias (invoke tbl (as usize j)))
              (when (and (= (e kind) kind) (= (strcmp (e key) k) 0))
                (return (e payload)))))))))
  (return null))

; Bind an existing binding under a second, differently-namespaced key — what
; `export` does, and what §11.6 concluded the resolver must be able to express
; for types and protocols too. Unsupported rows RAISE (never a silent no-op):
; the diagnostic names the kind, so `(export some-macro)` says why instead of
; failing as "symbol not found".
;
; Stage 15 B3′ flipped `reregisterable` on the type and protocol rows. §11.6's
; argument is that R1 forces it: once type identity is namespaced, a facade that
; re-exports `geom/area` but cannot re-export `geom/Pt` exports a function whose
; signature names a type the consumer has no way to spell.
(defn binding-re-register (kind:i32 payload:ptr bare:CStr line:i32):void
  (let (row:ref:BindingKind (binding-row kind))
    ; Stage 15 B7: the reason is stated per what is actually true of the
    ; remaining rows, rather than as one claim about "a globally-unique bare
    ; name". That phrasing cited §11.6 — a defect report, which says no such
    ; thing — and for macros it was circular: a macro was bare-keyed only
    ; because macros had never been cut over, so the gap justified itself. The
    ; rows still 0 are the ones genuinely not keyed by namespace: an overloaded
    ; name is merged across namespaces on purpose (§8.2's R2), and a special
    ; form, a built-in type name and a `__fnty_N` have no owning namespace at all.
    (when (= (row reregisterable) 0)
      (die-at line
        (fmt-2s "export: '%s' is %s — that kind is not keyed by namespace, so a re-export would not change how it resolves\n  note: an overloaded name is deliberately merged across namespaces (name-resolution.md §8.2); a special form and a built-in type name have no owning namespace"
                bare (row noun))))
    ; `g-globals` is keyed per entry, so a re-export is a second `scope-define` —
    ; and `scope-define` qualifies against the CURRENT namespace, which is the
    ; facade's. Every other row goes through the shared alias table.
    (when (= kind BK-GLOBAL)
      (let (sym:ptr:Sym (as ptr:Sym payload))
        (scope-define g-globals bare (sym type) (sym ir-name) 0))
      (return))
    (binding-alias-add (as CStr (ns-qualify-in g-current-ns (as ptr bare))) kind payload)))

; Unified dispatch tail for emit-list: the head symbol `h` is neither a macro
; nor a special form. Resolve it through the shared binding table (above),
; starting past the rows `emit-list` already answered — a pure operator routes
; to emit-binop (byte-identical IR); an operator carrying user overloads
; resolves user-method-or-inline; overloaded sets dispatch on argument types;
; solitary names and C/extern functions fall through to the ordinary scope-bound
; call (also byte-identical).
(defn emit-dispatch (n:(raw Node) scope:ref:Scope h:CStr head:(raw Node)):ref:Val
  ; Stage 10 (lifecycle.md §2.3): manually dropping a with-owned binding
  ; double-frees — the armed cleanup also fires at scope exit.
  (when (and (= h "drop") (= (node-len n) 2))
    (let (tname:ptr (node-binding-name (node-at n 1)))
      (when (!= tname null)
        (when-some (tsym (scope-lookup scope tname))
          (when (!= (tsym owns) 0)
            (die-at ((unsafe/cast ptr:Node n) line)
              (fmt-2s "double drop: '%s' is dropped at `with` scope exit — use (move %s) to take ownership first" tname tname)))))))
  ; Stage 15 B5: ONE walk over the shared table, from the first row `emit-list`
  ; has not already answered. The order — generic, global, protocol, struct,
  ; union, struct-template, … — is `build-binding-kinds`', not a second copy of
  ; it, and `guard-name-kind` and `node-type-call` walk the same rows.
  (if-some (hit (binding-find h scope BK-DISPATCH-FIRST BINDING-KIND-COUNT 0 NK-NONE))
    (do
      (when (= (hit kind) BK-GENERIC)
        (let (g:ptr:Generic (as ptr:Generic (hit payload))
              m:ptr:Method (as ptr:Method (invoke (g methods) 0)))
          (when (= (m kind) METHOD-INTRINSIC)
            (if (= (g mangled) 0)
              (return (emit-binop n scope (m binop)))
              (return (emit-operator-dispatch n scope g (m binop)))))
          (when (!= (g mangled) 0)
            (return (emit-generic-call n scope g)))
          ; A solitary (unmangled, non-intrinsic) generic is ALSO bound in
          ; g-globals under the same name, and that binding is what carries the
          ; callable Sym — so this row falls through to the next one exactly as
          ; the pre-B5 ladder did.
          (if-some (h2 (binding-find h scope (+ BK-GENERIC 1) BINDING-KIND-COUNT 0 NK-NONE))
            (return (emit-dispatch-hit n scope h h2 head))
            (die-at (node-line head ((unsafe/cast ptr:Node n) line)) (unknown-name-message h)))))
      (return (emit-dispatch-hit n scope h hit head)))
    (die-at (node-line head ((unsafe/cast ptr:Node n) line)) (unknown-name-message h))))

; Emit the head-position meaning of one table row's hit. Split out of
; `emit-dispatch` so the solitary-generic fall-through above reuses it verbatim.
(defn emit-dispatch-hit (n:(raw Node) scope:ref:Scope h:CStr
                         hit:ref:BindingHit head:(raw Node)):ref:Val
  (let (k:i32 (hit kind))
    ; A defn/extern symbol (is-local 0, TY-FN) is a direct call. Anything else in
    ; head position is a value: emit it once, then route. A function-pointer value
    ; (a local/global TY-FN variable) folds to an indirect call; a non-function
    ; value routes to get (member access) / invoke (callable-values.md §4.1/§4.2).
    (when (= k BK-GLOBAL)
      (let (sym:ptr:Sym (as ptr:Sym (hit payload)))
        (when (and (-> sym (_ type) (unsafe/cast ptr:Type _) (_ kind) (= _ TY-FN))
                   (= (sym is-local) 0))
          (return (emit-call n scope sym)))
        (return (emit-callable-value n scope (emit-symbol-ref head scope ((unsafe/cast ptr:Node n) line))))))
    ; struct-name-as-constructor (S init...) -> ptr:S compound literal.
    (when (= k BK-STRUCT)
      (return (emit-struct-lit n scope (as ptr:StructDef (hit payload)))))
    ; Stage 11: bare (Template arg ...) with a struct-template name in head
    ; position is ambiguous (type arg vs first field value) and is an error.
    ; Point at the explicit ((Template <type-args>) field0 ...) form.
    (when (= k BK-STRUCT-TEMPLATE)
      (die-at (node-line head ((unsafe/cast ptr:Node n) line))
        (fmt-s "'%s' is a struct template; construct with the explicit form ((Template <type-args>) field0 field1 ...)" h)))
    ; Every other row names something real that is not callable. Before B5 these
    ; all reported "unknown: X — not defined anywhere in this compilation unit",
    ; which is false: the name IS defined, in a registry with no head-position
    ; meaning. This is the `kind-noun` column earning its keep.
    (die-at (node-line head ((unsafe/cast ptr:Node n) line))
      (fmt-2s "'%s' names %s, not a function" h ((binding-row k) noun)))))

(defn emit-list (n:(raw Node) scope:ref:Scope):ref:Val
  (let (nn:ptr:Node (unsafe/cast ptr:Node n))
    (when (= (node-len nn) 0) (die-at (nn line) "empty list"))
    (let (head:ptr:Node (unsafe/cast ptr:Node (node-at nn 0)))
      ; An arbitrary-expression head — `((mk) 3)`, `(@p 3)` — cannot be a macro or
      ; special form (those are symbol-keyed): emit it and route as a callable
      ; value (callable-values.md §4.1). Symbol heads continue below.
      ; Stage 11: ((Vector i32) v0 v1 ...) — a list head that is a struct-template
      ; application. The inner (Vector i32) is parsed via parse-type-from-node to
      ; stamp (or look up) the concrete instance; the outer form is then an ordinary
      ; compound literal over that StructDef (parametric-structs.md §6).
      (when (!= (head kind) NODE-SYM)
        (when (= (head kind) NODE-CELL)
          (let (hcar:ptr (head car))
            (when (!= hcar null)
              (let (hcar-node:ptr:Node (unsafe/cast ptr:Node hcar))
                (when (= (hcar-node kind) NODE-SYM)
                  (when (!= (as ptr (struct-template-lookup-ref (hcar-node s))) null)
                    (let (stamped-ty:ptr (parse-type-from-node (as ptr head) (head line)))
                      (when (= ((as ptr:Type stamped-ty) kind) TY-STRUCT)
                        (return (emit-struct-lit n scope ((as ptr:Type stamped-ty) sdef)))))))))))
        (return (emit-callable-value n scope (emit-node (as ptr head) scope))))
      (let (h:ptr (head s)
            hp:ptr (as ptr head))
        ; Check macro table before special forms. Stage 15 B5: through
        ; `find-macro` rather than an inline scan, so `defmacro-`'s visibility
        ; filter applies here — this is the site a macro reference actually
        ; reaches. The two scans were otherwise identical (both first-match,
        ; both content comparison).
        (if-some (mdef (find-macro (as CStr h)))
          (return (emit-macro-expand n scope (as ptr mdef)))
          0)
        (when (and (= hp 'gensym) (= (node-len nn) 1))
          (let (tmp:ptr (new-tmp))
            (fprintf g-body-stream "  %s = call ptr @nucleus_gensym()\n" tmp)
            (return (alloc-val (ty-raw-node) tmp))))
        ; Stage 14 UN-5 / Stage 15 B2b: the bare `funcall-ptr-*` spellings do not
        ; resolve because the `unsafe` namespace is bound PREFIXED in every file
        ; and never flattened — the binding is the mechanism, and the targeted
        ; text is a did-you-mean tier in `unresolved-name-message`
        ; (`unsafe-bare-message`). Nothing to refuse here any more.
        (when (= hp 'unsafe/funcall-ptr-1) (return (emit-funcall-ptr-1 n scope)))
        (when (= hp 'unsafe/funcall-ptr-i32) (return (emit-funcall-ptr-i32 n scope)))
        (when (= hp 'unsafe/funcall-ptr-i64) (return (emit-funcall-ptr-i64 n scope)))
        (when (= hp 'unsafe/funcall-ptr-ptr) (return (emit-funcall-ptr-ptr n scope)))
        (when (= hp 'return) (return (emit-return n scope)))
        (when (= hp 'do) (return (emit-do n scope)))
        (when (= hp 'let) (return (emit-let n scope)))
        (when (= hp 'with) (return (emit-with n scope)))
        (when (= hp 'cond) (return (emit-cond n scope)))
        (when (= hp 'quote) (return (emit-quote n)))
        (when (= hp 'quasiquote) (return (emit-quasiquote n scope)))
        (when (= hp 'while) (return (emit-while n scope)))
        (when (= hp 'set!) (return (emit-set n scope)))
        (when (= hp 'inc!) (return (emit-inc n scope)))
        (when (= hp 'dec!) (return (emit-dec n scope)))
        (when (= hp 'label) (return (emit-label n scope)))
        (when (= hp 'goto) (return (emit-goto n scope)))
        (when (= hp 'label-addr) (return (emit-label-addr n scope)))
        (when (= hp 'goto-ptr) (return (emit-goto-ptr n scope)))
        (when (= hp 'array) (return (emit-array-lit n scope)))
        (when (= hp 'not) (return (emit-not n scope)))
        (when (= hp '_and) (return (emit-short-circuit n scope 1)))
        (when (= hp '_or) (return (emit-short-circuit n scope 0)))
        (when (= hp 'unsafe/cast) (return (emit-cast n scope)))
        (when (= hp 'as) (return (emit-as n scope)))
        (when (= hp 'addr-of) (return (emit-addr-of n scope)))
        (when (= hp 'funcall-void) (return (emit-funcall-void n scope)))
        (when (= hp 'funcall) (return (emit-funcall n scope)))
        (when (= hp 'deref) (return (emit-deref n scope)))
        (when (= hp 'ptr-set!) (return (emit-ptr-set n scope)))
        (when (= hp 'unsafe/ptr+) (return (emit-ptr-add n scope)))
        (when (= hp '_get) (return (emit-field-get n scope)))
        (when (= hp '.) (return (emit-field-get n scope)))
        (when (= hp '.&) (return (emit-field-addr n scope)))
        (when (= hp '.set!) (return (emit-field-set n scope)))
        (when (= hp 'get) (return (emit-get n scope)))
        (when (= hp 'invoke) (return (emit-invoke n scope)))
        (when (= hp 'sizeof) (return (emit-sizeof n scope)))
        (when (= hp 'alloca) (return (emit-alloca-form n scope)))
        (when (= hp 'char) (return (emit-char n scope)))
        (when (= hp 'aref) (return (emit-aref n scope)))
        (when (= hp 'aset!) (return (emit-aset n scope)))
        ; Stage 10: Maybe transition forms (nullability.md §3)
        (when (= hp 'some) (return (emit-some n scope)))
        (when (= hp 'as-ref) (return (emit-as-ref n scope)))
        (when (= hp 'unwrap) (return (emit-unwrap n scope)))
        (when (= hp 'unwrap-or) (return (emit-unwrap-or n scope)))
        (when (= hp 'err-name) (return (emit-err-accessor n scope 0)))
        (when (= hp 'err-message) (return (emit-err-accessor n scope 1)))
        (when (= hp 'type-token) (return (emit-type-token n scope)))
        (when (= hp 'if-some) (return (emit-if-some n scope 0)))
        (when (= hp 'when-some) (return (emit-if-some n scope 1)))
        (when (= hp 'defer) (return (emit-defer n scope)))
        (when (= hp 'move) (return (emit-move n scope)))
        ; Stage 13 L3 (lambda.md §"fn — anonymous function"): an anonymous
        ; function literal. fn rejects any enclosing-local capture and lambda-lifts
        ; its body to a fresh top-level defn whose pointer is the value. A local
        ; binding named `fn` shadows the keyword (the compiler's own source binds
        ; `fn` as a Node* local pervasively — `(fn kind)` is field access on it),
        ; so the lambda form fires only when `fn` is NOT a bound local. This keeps
        ; the bootstrap byte-identical: every existing `(fn …)` resolves to its
        ; local exactly as before.
        (when (and (= hp 'fn) (= (as ptr (scope-lookup scope "fn")) null))
          (return (emit-fn n scope)))
        ; Stage 13 L4 (lambda.md §"vfn — capture by clone"): a clone-capture
        ; closure. Gated on `vfn` not being a bound local (same one-symbol-one-
        ; kind shadow rule as `fn`). A non-capturing vfn folds to a bare function
        ; pointer (emit-vfn delegates to emit-fn); a capturing vfn lowers to an
        ; anonymous env struct + `invoke` method, callable through callable-values.
        (when (and (= hp 'vfn) (= (as ptr (scope-lookup scope "vfn")) null))
          (return (emit-vfn n scope)))
        ; Stage 13 L5 (lambda.md §"mfn — capture by move"): a move-capture
        ; closure. Gated on `mfn` not being a bound local (same one-symbol-one-
        ; kind shadow rule as `fn`/`vfn`). A non-capturing mfn folds to a bare
        ; function pointer (emit-mfn delegates to emit-fn); a capturing mfn
        ; lowers to an anonymous env struct + `invoke` method, with each
        ; with-owned capture moved (disarmed + consumed) into the env and the
        ; closure's `drop` synthesized over the owned fields.
        (when (and (= hp 'mfn) (= (as ptr (scope-lookup scope "mfn")) null))
          (return (emit-mfn n scope)))
        ; Stage 13 L6 (lambda.md §"cfn — capture by reference"): a reference-
        ; capture closure. Gated on `cfn` not being a bound local (same one-
        ; symbol-one-kind shadow rule as fn/vfn/mfn). A non-capturing cfn folds to
        ; a bare function pointer (emit-cfn delegates to emit-fn); a capturing cfn
        ; lowers to an anonymous env struct of pointers (plus a stored AllocHandle)
        ; heap-allocated through the `alloc` operand, an `invoke` method, and a
        ; synthesized `drop` that frees the env via the handle. The closure value
        ; inherits the join of the captures' addr-of taints (L1) so escaping a
        ; captured frame/with local's scope is rejected at the existing sinks.
        (when (and (= hp 'cfn) (= (as ptr (scope-lookup scope "cfn")) null))
          (return (emit-cfn n scope)))
        ; Stage 10 tagged sums (unions.md §3–§4)
        (when (= hp 'match) (return (emit-match n scope)))
        (when (= hp 'make) (return (emit-make n scope)))
        ; Internal: niche construction in return position (unions.md §6 rules
        ; 2/3), produced only by union-target-rewrite for a niche return type.
        (when (= hp '__niche-ctor) (return (emit-niche-ctor n scope)))
        ; Internal: handler-aware err negotiation, produced only by
        ; union-target-rewrite at an !T err return site (errors.md §11).
        (when (= hp '__err-handled) (return (emit-err-handled n scope)))
        ; Standalone handler negotiation outside return position (errors.md §4).
        (when (= hp 'signal) (return (emit-signal n scope)))
        (return (emit-dispatch n scope h (as ptr head)))))))

; ============================================================
; Top-level forms
; ============================================================

; ============================================================
; Name (non-)shadowing — a symbol may name only one kind of thing
; (special form, built-in type, struct type, protocol, macro, function, value).
; Each top-level definer checks its name against every other namespace and errors
; on a cross-kind collision. Same-kind reuse (overloaded defn, struct/value
; redefinition) is allowed. Lookups are by content (strcmp) so they don't depend
; on whether a given table stores interned names.
; ============================================================

; Stage 15 B2b: the roster of the built-in `unsafe` namespace, by BARE name
; (design/stage14/unsafe-namespace.md D2 Class 1/2). It is a roster rather than
; seven more entries in `g-special-form-set` because after B2b the members are
; reached by *resolving* `unsafe/x` — `resolve-spelling` binds `unsafe` as an
; implicit prefix in every file — and a set of whole qualified strings cannot
; answer a resolved question.
(defn unsafe-op-named (bare:CStr):i32
  (when (= (strcmp bare "cast") 0) (return 1))
  (when (= (strcmp bare "ptr+") 0) (return 1))
  (when (= (strcmp bare "import-private") 0) (return 1))
  (when (= (strcmp bare "funcall-ptr-1") 0) (return 1))
  (when (= (strcmp bare "funcall-ptr-i32") 0) (return 1))
  (when (= (strcmp bare "funcall-ptr-i64") 0) (return 1))
  (when (= (strcmp bare "funcall-ptr-ptr") 0) (return 1))
  (return 0))

; Does `spelling` name a member of the built-in `unsafe` namespace, qualified?
; The qualifier must resolve to `unsafe` through the ordinary environment, so a
; user namespace could not answer yes even if one could be called `unsafe` —
; which `emit-ns` refuses precisely because this binding pre-owns the name.
(defn unsafe-qualified-op (spelling:CStr):i32
  (let (n:i64 (qualifier-len spelling))
    (when (<= n 0) (return 0))
    (let (r:ref:NameRef (resolve-spelling spelling))
      (when (= (r ns) null) (return 0))
      (when (!= (strcmp (r ns) "unsafe") 0) (return 0))
      (return (unsafe-op-named (as CStr (r bare)))))))

(defn special-form-named (name:CStr):i32
  (when (!= (contains? g-special-form-set name) 0) (return 1))
  ; The `unsafe/` roster left the set in B2b, but the spellings stay reserved:
  ; a `defn`/`defvar`/… may not shadow one, exactly as before.
  (return (unsafe-qualified-op name)))

(defn primitive-type-named (name:CStr):i32
  (return (contains? g-primitive-type-set name)))

(defn kind-noun (k:i32):CStr
  (when (= k NK-SPECIAL)  (return "a special form"))
  (when (= k NK-BUILTIN)  (return "a built-in type"))
  (when (= k NK-TYPE)     (return "a type"))
  (when (= k NK-PROTOCOL) (return "a protocol"))
  (when (= k NK-MACRO)    (return "a macro"))
  (when (= k NK-FUNCTION) (return "a function"))
  (when (= k NK-VALUE)    (return "a value"))
  (return "something"))

; The noun for one hit. The row supplies it, except for `g-globals`, whose two
; nouns are decided per-Sym: a `defn`/`extern` symbol (is-local 0, TY-FN) is a
; function, everything else a value. The second conjunct is load-bearing — a
; function-pointer-typed `defvar` is a TY-FN *value*, and without `is-local` it
; collided with ITSELF once W8 G-0 started registering value names in the
; whole-graph prescan (the prescan's Sym was already in `g-globals` when
; `emit-defvar` ran its own `guard-name-kind`).
(defn binding-noun (kind:i32 payload:ptr):CStr
  (when (= kind BK-GLOBAL) (return (kind-noun (binding-nk kind payload))))
  (return ((binding-row kind) noun)))

; Error if `name` already names a different kind of thing than `newk`.
;
; Stage 15 B5: ONE walk over the shared table (`build-binding-kinds`, beside
; `emit-dispatch`), restricted to the rows whose `collides` column is 1 — so the
; enforcement order and the consumption order are the same list, which is
; defect #8. It asks for the first binding whose kind is NOT `newk`; see
; `binding-find`'s `skip-nk` note for why that, and not "the highest-priority
; binding", is the question the one-symbol-one-kind rule actually poses. (This
; replaced `name-existing-kind`, which asked the other question and had this as
; its only caller.)
;
; Two things the walk changed. The globals row is now `scope-lookup`, the
; reference resolver, rather than a raw strcmp over the frame — under `user`
; with no namespace declared anywhere `qualify-name`/`priv-key-use` are the
; identity and `g-ns-declared` is 0, so it is exactly the scan it replaced, and
; in a namespaced file it is stricter and correct (`(ns zn) (defvar zg …)
; (defstruct zg …)` used to miss, because the frame holds `zn/zg` and the guard
; asked for `zg`). And BK-PROTOCOL is a genuinely new row: nothing here probed
; `g-protocols`, so NK-PROTOCOL was declared, accepted as an input, and never
; returned (name-resolution.md §13.2). It sits above BK-STRUCT so a
; defprotocol/defstruct clash names the protocol; `prescan-protocols` moved
; ahead of `prescan-struct-names` so the protocol is registered by the time the
; struct's own guard runs (before that the struct prescan always won the race
; and the clash was reported at the protocol's line as "a type").
(defn guard-name-kind (name:CStr line:i32 newk:i32):void
  (if-some (hit (binding-find name null 0 BINDING-KIND-COUNT 1 newk))
    (die-at line
      (fmt-2s "'%s' already names %s — a symbol may name only one kind of thing"
              name (binding-noun (hit kind) (hit payload))))
    0))

; Stage 15 B4 — R4's rule (name-resolution.md §11.1): two definitions of one
; name reaching one scope. `guard-name-kind` above answers the CROSS-kind
; question and deliberately skips its own kind, because every definer registers
; its own name in a prescan before its own guard runs. The complementary
; SAME-kind question cannot be a walk over the same table for exactly that
; reason: only the definer can tell its own prescan stub from somebody else's
; finished definition, and the tell is per registry (a `StructDef` carries
; `emitted`; a `UnionDef` / `Protocol` / `MacroDef` / `EnumDef` / template record
; is created only by its real definer). So the table supplies the noun, this
; supplies the message, and each definer supplies the fact — §14.7's "the site,
; not the table".
;
; What it replaces: silent acceptance with no agreed winner. Measured before B4,
; a second `defstruct` / `defunion` / `defprotocol` / `defmacro` / template kept
; the FIRST definition, a second `defconst` kept the second, and a second
; `defvar` reached LLVM's own parser with no source location at all. §11.1's
; measured casualty — `Node`, declared in both `lib/prelude.nuc` and
; `lib/list.nuc` with different field nullability, the winner decided by import
; order — was this class, and §11.7 cleared the tree of it ahead of the rule.
; Is an existing record THIS definition, being registered again? Several
; definers are legitimately re-entered for one form — `prescan-protocols` runs
; over the whole import graph and again per file, `register-struct-template` is
; reached from a prescan and from `emit-defstruct`, a `.nuch` replays what a
; `.nuc` already declared, the REPL re-evaluates. For those registries "an entry
; exists" therefore does NOT mean "a second definition"; only `defstruct` has a
; state flag (`emitted`) that says so directly.
;
; The discriminator is the defining location. `g-source-path` is set per file
; around every prescan and every load block, so (file, line) identifies a form,
; and one form cannot be two definitions. A record carrying no location at all
; predates B4's provenance or was minted by something other than a source
; definer — treated as the same definition, so an unrecorded registrar keeps its
; pre-B4 no-op rather than becoming a false rejection.
(defn same-definition-site (prev-file:CStr prev-line:i32 line:i32):i32
  ; R4 is a rule about a COMPILATION UNIT, and a REPL session is a sequence of
  ; them typed one at a time — redefinition is the point of a REPL, and
  ; `repl.nuc` already evicts a redefined `defn`'s old method rather than
  ; refusing it. Answering "same definition" here turns every B4 check back into
  ; the pre-B4 behaviour at each definer, which is what an interactive session
  ; had and should keep.
  (when (!= g-interactive 0) (return 1))
  (when (= (as ptr prev-file) null) (return 1))
  (when (= prev-line 0) (return 1))
  (when (and (= prev-line line) (= (strcmp prev-file g-source-path) 0)) (return 1))
  (return 0))

; Stage 15 B4 (R4) — the value row's same-kind check for the two definers whose
; binding is a compile-time CONSTANT: `defconst` and a `defenum` member. A
; `defvar` has a stronger tell of its own (`Sym.defvar-state`, checked inline in
; `emit-defvar`); a constant has none, because W8 G-0's prescan registers exactly
; the Sym the emitter goes on to register — so the discriminator is the defining
; site, as it is for the protocol / template / macro registrars.
;
; Restricted to `is-const` hits on purpose. `guard-name-kind` has already refused
; a function, and an `extern`/`declare`/C-header global is a declaration of
; storage that lives elsewhere, not a second definition of this constant.
(defn guard-const-redefinition (name:CStr line:i32):void
  (if-some (prev (scope-lookup-key g-globals name))
    (do
      (when (= (prev is-const) 0) (return))
      (when (!= (same-definition-site (prev src-file) (prev src-line) line) 0) (return))
      ; Blame the SECOND definition. W8 G-0's prescan registers every form's Sym
      ; before any form is emitted, so `scope-lookup-key`'s backwards scan can
      ; land on a LATER form's prescan entry while the earlier one is being
      ; emitted — which would report the pair at the first definition's line. A
      ; hit below this form in the same file is therefore skipped; the later form
      ; finds the earlier one's emitted Sym when it reaches its own check.
      (when (and (= (strcmp (prev src-file) g-source-path) 0)
                 (> (prev src-line) line))
        (return))
      (die-redefinition name line BK-GLOBAL (prev src-file) (prev src-line)))
    0))

(defn die-redefinition (name:CStr line:i32 kind:i32 prev-file:CStr prev-line:i32):void
  (let (where:CStr "earlier in this compilation unit")
    (when (and (!= (as ptr prev-file) null) (> prev-line 0))
      (set! where (fmt-sd "at %s:%d" (as ptr prev-file) prev-line)))
    (die-at line
      (fmt-3s "redefinition of '%s' — it already names %s defined %s\n  note: a name may be defined only once in a compilation unit. If two imported libraries both define it, rename one — or give one an (ns ...) of its own and import that library with `import-prefixed`."
              (as ptr name) (as ptr ((binding-row kind) noun)) (as ptr where)))))

; Record the defining source location on a freshly-defined Sym (used by the
; REPL and for error attribution). Tolerates a null sym.
(defn sym-set-src-loc (sym:(raw Sym) line:i32):void
  (when (= sym null) (return))
  (let (s:ptr:Sym (unsafe/cast ptr:Sym sym))
    (.set! s src-file g-source-path)
    (.set! s src-line line)))

; ============================================================
; Stage 15 W8 G-1 — constant expressions in a global initializer
; (design/global-init.md §5 "G-1"; §3 Option 3b)
; ============================================================
;
; An LLVM global initializer is a *constant*: there is no instruction stream to
; emit into, so an initializer expression is either evaluated by the compiler or
; refused. G-1 evaluates the integer subset here, with **no JIT** — §3's Option
; 3a is rejected on measured grounds (a CT/macro JIT module can reference
; neither a program `defvar` nor a program `defn`; a fold that runs in the host
; process is cross-compilation-unsound, the `-ffast-math` hazard
; context/conventions.md already records; and it can never yield a runtime
; address).
;
; TYPING DISCIPLINE. A folded expression's result is treated as an *untyped
; integer literal of that value* — precisely what `(defvar g:T 5)` is — so the
; W2b range gate `int-literal-fits` at the destination is the single check for a
; folded value and a written one alike, reached through the same call.
; `(defvar g:i32 (* BIG 2))` is therefore rejected for exactly the reason
; `(defvar g:i32 BIG)` is, rather than wrapping.
;
; OVERFLOW. Evaluation is in signed 64-bit, matching an untyped literal, and
; every operation that can leave that range is a *located compile-time error*,
; never a wrap: `+`/`-`/`*` overflow, `/` and `%` by zero or the INT64_MIN/-1
; pair, and a shift count outside [0,64). A silent wrap here would be the W2b
; bug in a new spelling. The overflow tests run BEFORE the operation, because the
; compiler's own `+`/`-`/`*` emit `add nsw` / `sub nsw` / `mul nsw` and
; inspecting an overflowed result would be inspecting LLVM poison.

; The i64 bounds. Built with a shift rather than written as decimal literals:
; `-9223372036854775808` has no positive spelling `strtoll` accepts, and
; `(- (bit-shl 1 63) 1)` would itself be a signed-overflow subtraction. `shl` and
; `xor` carry no `nsw`, so both of these are well-defined bit operations.
(defn cfold-i64-min ():i64
  (let (one:i64 1) (return (bit-shl one 63))))

(defn cfold-i64-max ():i64
  (return (bit-not (cfold-i64-min))))

(defn cfold-overflow (line:i32):void
  (die-at line "defvar: constant initializer overflows 64-bit signed integer arithmetic"))

(defn cfold-add (a:i64 b:i64 line:i32):i64
  (when (and (> b 0) (> a (- (cfold-i64-max) b))) (cfold-overflow line))
  (when (and (< b 0) (< a (- (cfold-i64-min) b))) (cfold-overflow line))
  (return (+ a b)))

(defn cfold-sub (a:i64 b:i64 line:i32):i64
  (when (and (< b 0) (> a (+ (cfold-i64-max) b))) (cfold-overflow line))
  (when (and (> b 0) (< a (+ (cfold-i64-min) b))) (cfold-overflow line))
  (return (- a b)))

; The four sign quadrants each reduce to one comparison against a truncating
; quotient, which is exact here: truncation toward zero is floor for a positive
; quotient and ceiling for a negative one, and both are the bound the test wants.
; `-1 * INT64_MIN` is the one product no quotient test can screen (the quotient
; itself traps), so it is screened first, both ways round.
(defn cfold-mul (a:i64 b:i64 line:i32):i64
  (when (or (= a 0) (= b 0)) (return 0))
  (when (and (= a -1) (= b (cfold-i64-min))) (cfold-overflow line))
  (when (and (= b -1) (= a (cfold-i64-min))) (cfold-overflow line))
  (let (mx:i64 (cfold-i64-max)
        mn:i64 (cfold-i64-min))
    (cond (and (> a 0) (> b 0)) (when (> a (/ mx b)) (cfold-overflow line))
          (and (> a 0) (< b 0)) (when (< b (/ mn a)) (cfold-overflow line))
          (and (< a 0) (> b 0)) (when (< a (/ mn b)) (cfold-overflow line))
          true                  (when (< a (/ mx b)) (cfold-overflow line))))
  (return (* a b)))

(defn cfold-div (a:i64 b:i64 line:i32):i64
  (when (= b 0) (die-at line "defvar: division by zero in constant initializer"))
  (when (and (= a (cfold-i64-min)) (= b -1)) (cfold-overflow line))
  (return (/ a b)))

(defn cfold-rem (a:i64 b:i64 line:i32):i64
  (when (= b 0) (die-at line "defvar: remainder by zero in constant initializer"))
  ; INT64_MIN % -1 is mathematically 0 but traps on x86 `idiv`. Answer it
  ; directly rather than executing the instruction to find that out.
  (when (= b -1) (return 0))
  (return (% a b)))

; A shift count outside [0,64) is `poison` in LLVM, so the runtime path has no
; answer to give either; refusing it at the fold is strictly more informative
; than baking poison into a constant.
(defn cfold-shift (a:i64 b:i64 left:i32 line:i32):i64
  (when (or (< b 0) (>= b 64))
    (die-at line
      (fmt-i64 "defvar: shift amount %ld out of range in constant initializer (must be 0..63)" b)))
  (if (!= left 0) (return (bit-shl a b)) (return (bit-shr a b))))

; The foldable binary operators, by their POST-macroexpansion spelling: the
; variadic `+`/`-`/`*`/`/` and `bit-not` are macros (lib/macros.nuc) that expand
; to these, so a source-level `(+ a b c)` arrives as nested `_+` cells.
; Comparisons and `_and`/`_or` are deliberately absent — they yield i1 and belong
; to a value domain this folder does not model (see the G-1 record).
; 0 means "not a foldable operator".
(defn cfold-op-code (h:ptr):i32
  (cond (= h "_+")      (return 1)
        (= h "_-")      (return 2)
        (= h "_*")      (return 3)
        (= h "_/")      (return 4)
        (= h "%")       (return 5)
        (= h "bit-and") (return 6)
        (= h "bit-or")  (return 7)
        (= h "bit-xor") (return 8)
        (= h "bit-shl") (return 9)
        (= h "bit-shr") (return 10)
        true            (return 0)))

; `bit-shr` folds as an ARITHMETIC shift, matching the `ashr` the binop table
; selects for the signed operand types two untyped literals produce.
(defn cfold-apply (op:i32 a:i64 b:i64 line:i32):i64
  (case op
    1  (return (cfold-add a b line))
    2  (return (cfold-sub a b line))
    3  (return (cfold-mul a b line))
    4  (return (cfold-div a b line))
    5  (return (cfold-rem a b line))
    6  (return (bit-and a b))
    7  (return (bit-or a b))
    8  (return (bit-xor a b))
    9  (return (cfold-shift a b 1 line))
    10 (return (cfold-shift a b 0 line))
    (return 0)))

; `(sizeof T)` as a constant. The value path lowers `sizeof` to a GEP over the
; LLVM *named* type and lets LLVM compute it; a constant initializer cannot, so
; this asks the compiler's own layout model instead — `abi-sizeof`, the same one
; the SysV classifier uses and `make abi-test` / `make layout-test` gate.
;
; That swap has one consequence the GEP form does not have, and it is exactly
; what src/type-utils.nuc's W1d note warns about: LLVM resolves `%Name` from a
; `%Name = type {…}` line emitted anywhere in the module, but `abi-sizeof` reads
; the compiler's own field table, which an import cycle may not have populated
; yet. So this site needs `reject-cycle-pending-layout` where `emit-sizeof` does
; not — otherwise a cross-cycle `(sizeof S)` would silently fold to 0.
(defn cfold-sizeof (tn:(raw Node) line:i32):i64
  (set! g-array-ok 1)   ; G-2: `(sizeof (array T N))` folds, like every sizeof
  (let (tl:i32 (node-line (as ptr tn) line)
        ty:(raw Type) (parse-type-from-node (as ptr tn) tl))
    (reject-opaque-type ty tl "sizeof")
    (reject-cycle-pending-layout ty tl "sizeof")
    (return (as i64 (abi-sizeof ty)))))

; Evaluate `n` as an integer constant expression. Returns 1 and stores the value
; through `out` on success; 0 when `n` is simply not a constant expression (the
; caller then reports the whole initializer). A *malformed* constant expression —
; overflow, division by zero, a lossy `as` — is a `die-at` here rather than a 0,
; because "this is arithmetic and it is wrong" is a different answer from "this
; is not arithmetic".
;
; `encl` is the enclosing form's line, blamed when a sub-node has none of its own
; (interned symbols carry line 0 — context/conventions.md).
(defn const-fold-int (n:(raw Node) out:ptr:i64 encl:i32):i32
  (when (= n null) (return 0))
  ; Expand the head to fixpoint at every level: `(+ a b)` is a MACRO call, and
  ; the tail-wrapping expansion means an operand is frequently a CELL rather than
  ; the bare operand (`(* v K)` → `(_* v (* K))`). This is the same expander
  ; `node-is-int-literal` uses, for the same reason.
  (let (e:ptr (macroexpand-form n -1))
    (when (= e null) (return 0))
    (let (ee:ptr:Node (unsafe/cast ptr:Node e)
          nl:i32 (node-line e encl))
      ; a) an integer literal
      (when (= (ee kind) NODE-INT)
        (aset! out 0 (ee i))
        (return 1))
      ; b) a name bound by `defconst` / `defenum`. The provenance read here is
      ; W2b's (`const-lit` + `const-lit-i64`), which G-0 additionally arms at
      ; PRESCAN time — so a constant referenced before its own definition folds
      ; identically to one referenced after it. A constant that is not an integer
      ; literal (a `deferror` id carries `is-const` but not `const-lit`) is not
      ; foldable and falls through to 0.
      (when (= (ee kind) NODE-SYM)
        (let (nm:ptr null
              ignored:ptr null)
          (split-typed (ee s) (as ptr:ptr (addr-of nm)) (as ptr:ptr (addr-of ignored)))
          (let (sym:?ptr:Sym (scope-lookup g-globals nm))
            (when (and (!= sym null) (!= (sym is-const) 0) (!= (sym const-lit) 0))
              (aset! out 0 (sym const-lit-i64))
              (return 1))))
        (return 0))
      (when (!= (ee kind) NODE-CELL) (return 0))
      (let (nargs:i32 (- (node-len (as ptr ee)) 1)
            hd:ptr (node-at (as ptr ee) 0))
        (when (= hd null) (return 0))
        (when (!= ((unsafe/cast ptr:Node hd) kind) NODE-SYM) (return 0))
        ; (sizeof T)
        (when (and (= hd 'sizeof) (= nargs 1))
          (aset! out 0 (cfold-sizeof (node-at (as ptr ee) 1) nl))
          (return 1))
        ; (char "x") — the same one-byte literal defvar-init-ir renders directly,
        ; repeated here so it composes: `(+ (char "a") 1)`.
        (when (and (= hd 'char) (= nargs 1))
          (let (arg:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr ee) 1)))
            (when (or (= (as ptr arg) null)
                      (!= (arg kind) NODE-STR)
                      (!= (strlen (arg s)) 1))
              (die-at nl "defvar: (char ...) requires a single-char string"))
            (aset! out 0 (as i64 (char-at (arg s) 0)))
            (return 1)))
        ; (as T x) at an INTEGER T. The narrowing rule is `as-int-narrowing`
        ; (src/type-utils.nuc), the same call `emit-as` step 5 makes, so the two
        ; positions cannot drift on what `as` may narrow. The source type is the
        ; folded value's truthful width (`int-literal-type`, W2b's shared rule).
        ; A non-integer T is left to defvar-init-ir's own `as` branch.
        (when (and (= hd 'as) (= nargs 2))
          (let (dst:(raw Type) (parse-type-from-node (node-at (as ptr ee) 1) nl))
            (when (= (is-int-type dst) 0) (return 0))
            (let (v:i64 0)
              (when (= (const-fold-int (node-at (as ptr ee) 2)
                                       (as ptr:i64 (addr-of v)) nl) 0)
                (return 0))
              (let (src:(raw Type) (int-literal-type v))
                (when (!= (as-int-narrowing src dst) 0)
                  (die-at nl
                    (fmt-2s "as: lossy conversion from %s to %s -- use unsafe/cast"
                      (type-spelling src) (type-spelling dst)))))
              (aset! out 0 v)
              (return 1))))
        ; arithmetic / bit operators. The operator is identified BEFORE the
        ; operands are folded, so a non-constant call whose arguments happen to
        ; be malformed arithmetic — `(f (/ 1 0))` — reports "not a constant"
        ; rather than a division-by-zero the program never performs.
        (when (= nargs 2)
          (let (op:i32 (cfold-op-code ((unsafe/cast ptr:Node hd) s)))
            (when (!= op 0)
              (let (a:i64 0
                    b:i64 0)
                (when (= (const-fold-int (node-at (as ptr ee) 1)
                                         (as ptr:i64 (addr-of a)) nl) 0)
                  (return 0))
                (when (= (const-fold-int (node-at (as ptr ee) 2)
                                         (as ptr:i64 (addr-of b)) nl) 0)
                  (return 0))
                (aset! out 0 (cfold-apply op a b nl))
                (return 1)))))
        (return 0)))))

; `(addr-of g)` as a global initializer: the address of another global is a
; link-time constant, so `@g` is a legal initializer operand — and it is provably
; non-null, which makes this the one G-1 spelling that can initialize a
; **non-null** `(ref T)` global with no runtime store at all (design/
; global-init.md §3 Option 3b, "interaction with the nullability fix").
;
; The resolution rules mirror `emit-addr-of`'s, minus the two that are
; meaningless at file scope: a global is never moved, and it has no frame region
; to escape from. A forward reference resolves because G-0's `prescan-defvar-name`
; registers the Sym — with the same `def-ir-base` symbol, under the same
; `g-defining-private` arming — before any form is emitted, and LLVM's textual
; parser resolves a forward `@g` at end of module.
(defn defvar-addr-of-ir (target:(raw Node) ty:(raw Type) line:i32):ptr
  (when (= target null)
    (die-at line "defvar: addr-of target must be a symbol"))
  (let (tn:ptr:Node (unsafe/cast ptr:Node target))
    (when (!= (tn kind) NODE-SYM)
      (die-at line "defvar: addr-of target must be a symbol"))
    (let (sym:?ptr:Sym (scope-lookup g-globals (tn s)))
      (when (= sym null)
        (die-at line (fmt-s "defvar: addr-of: undefined '%s'" (tn s))))
      ; A `defconst` / `defenum` member / `deferror` id is a compile-time value
      ; with no storage, so there is no address to take.
      (when (or (!= (sym is-const) 0) (= (sym ir-name) null))
        (die-at line
          (fmt-s "defvar: addr-of: '%s' is a compile-time constant and has no address"
            (tn s))))
      (when (= ((sym type) kind) TY-FN)
        (die-at line
          (fmt-s "defvar: addr-of: cannot take the address of function '%s'" (tn s))))
      (when (= (is-ptr-like ty) 0)
        (die-at line
          (fmt-s "defvar: addr-of requires ptr or CStr type, not %s" (type-spelling ty))))
      ; The address of a global IS a `(ref T)`. Handing pkind-flow-check a
      ; PTR-REF source is what admits it into a non-null slot — the same call the
      ; `null` branch below makes with `ty-raw`, so the two spellings move
      ; together if the flow rule ever changes.
      (let (pt:ref:Type (make-type TY-PTR))
        (.set! pt elem (sym type))
        (.set! pt pkind PTR-REF)
        (pkind-flow-check (as ptr pt) ty line "defvar")
        (return (sym ir-name))))))

; ============================================================
; Stage 15 W8 G-2 — constant aggregates (design/global-init.md §5)
; ============================================================
;
; These STREAM to `g-out` rather than returning a string, and that is a
; correctness requirement, not a style choice. The `fmt-*` helpers format into a
; fixed buffer and clamp through `fmt-take` (context/conventions.md), so an
; accumulate-with-fmt-2s renderer would silently TRUNCATE any table longer than
; ~1KB — which is every table this feature exists for (the port's `mobjinfo` is
; 137 × 3 fields). Streaming has no length limit and no quadratic copying.
;
; Nesting is uniform: an element is written as `<type> <constant>`, and
; `defvar-write-const` dispatches on the element's own type, so an array of
; structs, a struct with an array field, and an array of arrays all fall out of
; the same two functions.

; Is `n` an `(array …)` compound literal?
(defn const-array-lit? (n:(raw Node)):i32
  (when (= n null) (return 0))
  (let (nn:(raw Node) n)
    (when (!= (nn kind) NODE-CELL) (return 0))
    (when (< (node-len (as ptr nn)) 2) (return 0))
    (when (= (node-at (as ptr nn) 0) 'array) (return 1))
    (return 0)))

; Is `n` a compound literal `(S …)` whose head names struct `sd`?
(defn const-struct-lit? (n:(raw Node) sd:(raw StructDef)):i32
  (when (or (= n null) (= sd null)) (return 0))
  (let (nn:(raw Node) n)
    (when (!= (nn kind) NODE-CELL) (return 0))
    (when (< (node-len (as ptr nn)) 1) (return 0))
    (let (hd:(raw Node) (node-at (as ptr nn) 0))
      (when (or (= hd null) (!= (hd kind) NODE-SYM)) (return 0))
      (when (= (struct-lookup-ref (hd s)) (as ptr sd)) (return 1))
      (return 0))))

; Distribute an `(array T e…)` literal's elements into `slots` (length `n`,
; pre-filled with null), honouring the designated form `(index value)` exactly
; as emit-array-lit does in value position. An unfilled slot stays null and is
; written as the type's zero.
(defn const-array-place (init:(raw Node) slots:ptr n:i32 encl:i32):void
  (let (cc:ptr:Node (unsafe/cast ptr:Node init)
        ninits:i32 (- (node-len (as ptr init)) 2)
        pos-cursor:i32 0)
    ; Pass 1: designated indices, so positional fills skip the slots they claim
    ; (same two-pass order emit-array-lit uses).
    (dotimes (i ninits)
      (let (arg:(raw Node) (node-at (as ptr cc) (+ 2 i))
            aline:i32 (node-line (as ptr arg) encl))
        (when (and (!= arg null) (= (arg kind) NODE-CELL) (= (node-len (as ptr arg)) 2)
                   (!= (node-at (as ptr arg) 0) null)
                   (= (-> (node-at (as ptr arg) 0) (unsafe/cast ptr:Node _) (_ kind)) NODE-INT))
          (let (k:i64 (-> (node-at (as ptr arg) 0) (unsafe/cast ptr:Node _) (_ i)))
            (when (< k 0)
              (die-at aline "defvar: array initializer: designated index must be non-negative"))
            (when (>= k (as i64 n))
              (die-at aline
                (fmt-i32-i32 "defvar: array initializer: index %d is out of range for a %d-element array"
                  (unsafe/cast i32 k) n)))
            (when (!= (aref (as ptr:ptr slots) (unsafe/cast i32 k)) null)
              (die-at aline
                (fmt-i32 "defvar: array initializer: index %d specified twice" (unsafe/cast i32 k))))
            (aset! (as ptr:ptr slots) (unsafe/cast i32 k) (as ptr arg))))))
    ; Pass 2: positional initializers fill the next unclaimed slot.
    (dotimes (i ninits)
      (let (arg:(raw Node) (node-at (as ptr cc) (+ 2 i))
            aline:i32 (node-line (as ptr arg) encl)
            designated:i32 0)
        (when (and (!= arg null) (= (arg kind) NODE-CELL) (= (node-len (as ptr arg)) 2)
                   (!= (node-at (as ptr arg) 0) null)
                   (= (-> (node-at (as ptr arg) 0) (unsafe/cast ptr:Node _) (_ kind)) NODE-INT))
          (set! designated 1))
        (when (= designated 0)
          (while (and (< pos-cursor n)
                      (!= (aref (as ptr:ptr slots) pos-cursor) null))
            (inc! pos-cursor))
          (when (>= pos-cursor n)
            (die-at aline
              (fmt-i32 "defvar: array initializer: too many initializers for a %d-element array" n)))
          (aset! (as ptr:ptr slots) pos-cursor (as ptr arg))
          (inc! pos-cursor))))))

; The element type an `(array T …)` literal declares, plus (through `out-len`)
; the length it implies: one past the highest designated index, or the number of
; positional initializers, whichever is larger. Used for the `(defvar g:ptr:T
; (array T …))` shape, where the literal alone fixes the table's shape.
(defn const-array-lit-etype (init:(raw Node) out-len:ptr:i32 encl:i32):(raw Type)
  (let (cc:ptr:Node (unsafe/cast ptr:Node init)
        nargs:i32 (- (node-len (as ptr init)) 1))
    (when (< nargs 1)
      (die-at (node-line init encl) "defvar: (array T …): element type required"))
    (let (etn:ptr (node-at (as ptr cc) 1)
          ety:(raw Type) (parse-type-from-node etn (node-line etn encl))
          ninits:i32 (- nargs 1)
          maxi:i32 -1
          pos:i32 0)
      (dotimes (i ninits)
        (let (arg:(raw Node) (node-at (as ptr cc) (+ 2 i)))
          (if (and (!= arg null) (= (arg kind) NODE-CELL) (= (node-len (as ptr arg)) 2)
                   (!= (node-at (as ptr arg) 0) null)
                   (= (-> (node-at (as ptr arg) 0) (unsafe/cast ptr:Node _) (_ kind)) NODE-INT))
            (let (k:i64 (-> (node-at (as ptr arg) 0) (unsafe/cast ptr:Node _) (_ i)))
              (when (> k (as i64 maxi)) (set! maxi (unsafe/cast i32 k))))
            (inc! pos))))
      (let (n:i32 pos)
        (when (> (+ maxi 1) n) (set! n (+ maxi 1)))
        (when (<= n 0)
          (die-at (node-line init encl)
            "defvar: (array T …): at least one initializer is required to size the table"))
        (ptr-set! out-len n))
      (return ety))))

; Write the LLVM constant for a value of type `ty` initialized by `init`.
; Aggregates stream their bracketed/braced element list; everything else defers
; to defvar-init-ir, so every scalar rule (integer folding, range checks, float
; re-rendering at the target width, `pkind-flow-check`, `(as CStr …)`,
; `(addr-of g)`) applies to an ELEMENT exactly as it applies to a whole global.
(defn defvar-write-const (init:(raw Node) ty:(raw Type) encl:i32):void
  (let (tt:(raw Type) ty
        tk:i32 (tt kind))
    (when (= tk TY-ARRAY)
      (when (= (const-array-lit? init) 0)
        (die-at (node-line init encl)
          (fmt-s "defvar: an %s slot must be initialized with an (array T ...) literal"
            (type-spelling ty))))
      (let (ety:(raw Type) (tt elem)
            n:i32 (tt arr-len)
            lit-ety:(raw Type) (parse-type-from-node (node-at (as ptr init) 1)
                                 (node-line (node-at (as ptr init) 1) encl)))
        (when (= (type-eq lit-ety ety) 0)
          (die-at (node-line init encl)
            (fmt-2s "defvar: array initializer element type %s does not match the declared element type %s"
              (type-spelling lit-ety) (type-spelling ety))))
        (let (slots:ptr (arena-alloc (* (as i64 n) (ptr-bytes)))
              ety-ir:CStr (type-to-ir ety))
          (dotimes (i n) (aset! (as ptr:ptr slots) i null))
          (const-array-place init slots n encl)
          (fprintf g-out "[")
          (dotimes (i n)
            (when (!= i 0) (fprintf g-out ", "))
            (fprintf g-out "%s " ety-ir)
            (let (slot:(raw Node) (as raw:Node (aref (as ptr:ptr slots) i)))
              (if (= slot null)
                (fprintf g-out "%s" (type-zero-const-ir ety))
                ; A designated element is the cell `(index value)`; a positional
                ; one is the value itself.
                (if (and (= (slot kind) NODE-CELL) (= (node-len (as ptr slot)) 2)
                         (!= (node-at (as ptr slot) 0) null)
                         (= (-> (node-at (as ptr slot) 0) (unsafe/cast ptr:Node _) (_ kind)) NODE-INT))
                  (defvar-write-const (as raw:Node (node-at (as ptr slot) 1)) ety encl)
                  (defvar-write-const slot ety encl)))))
          (fprintf g-out "]"))
        (return)))
    (when (or (= tk TY-STRUCT) (= tk TY-UNION))
      (let (sd:(raw StructDef) (tt sdef))
        (when (= (const-struct-lit? init sd) 0)
          (die-at (node-line init encl)
            (fmt-2s "defvar: a %s slot must be initialized with a (%s ...) compound literal"
              (sd name) (sd name))))
        (when (!= (sd is-union) 0)
          (die-at (node-line init encl)
            (fmt-s "defvar: '%s' is a union -- a constant union initializer has no unambiguous member; leave it zero-initialized and assign a member at run time"
              (sd name))))
        (reject-cycle-pending-sdef sd (node-line init encl) "struct literal")
        (let (nfields:i32 (sd num-fields)
              nargs:i32 (- (node-len (as ptr init)) 1)
              slots:ptr (arena-alloc (* (as i64 (+ nfields 1)) (ptr-bytes)))
              pos-idx:i32 0)
          (when (> nargs nfields)
            (die-at (node-line init encl)
              (fmt-s "defvar: too many initializers for struct '%s'" (sd name))))
          (dotimes (i nfields) (aset! (as ptr:ptr slots) i null))
          ; Designated `(field value)` first, so positional fills skip them —
          ; the same order emit-struct-lit uses in value position.
          (dotimes (i nargs)
            (let (arg:(raw Node) (node-at (as ptr init) (+ 1 i))
                  aline:i32 (node-line (as ptr arg) encl))
              (when (and (!= arg null) (= (arg kind) NODE-CELL) (= (node-len (as ptr arg)) 2)
                         (!= (node-at (as ptr arg) 0) null)
                         (= (-> (node-at (as ptr arg) 0) (unsafe/cast ptr:Node _) (_ kind)) NODE-SYM))
                (let (fnn:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr arg) 0))
                      fidx:i32 (struct-field-idx (as ptr sd) (fnn s)))
                  (when (< fidx 0)
                    (die-at aline (fmt-2s "defvar: no field '%s' on struct '%s'" (fnn s) (sd name))))
                  (when (!= (aref (as ptr:ptr slots) fidx) null)
                    (die-at aline (fmt-s "defvar: field '%s' specified twice" (fnn s))))
                  (aset! (as ptr:ptr slots) fidx (as ptr arg))))))
          (dotimes (i nargs)
            (let (arg:(raw Node) (node-at (as ptr init) (+ 1 i))
                  aline:i32 (node-line (as ptr arg) encl)
                  designated:i32 0)
              (when (and (!= arg null) (= (arg kind) NODE-CELL) (= (node-len (as ptr arg)) 2)
                         (!= (node-at (as ptr arg) 0) null)
                         (= (-> (node-at (as ptr arg) 0) (unsafe/cast ptr:Node _) (_ kind)) NODE-SYM))
                (set! designated 1))
              (when (= designated 0)
                (while (and (< pos-idx nfields)
                            (!= (aref (as ptr:ptr slots) pos-idx) null))
                  (inc! pos-idx))
                (when (>= pos-idx nfields)
                  (die-at aline
                    (fmt-s "defvar: too many positional initializers for struct '%s'" (sd name))))
                (aset! (as ptr:ptr slots) pos-idx (as ptr arg))
                (inc! pos-idx))))
          (fprintf g-out "{")
          (dotimes (i nfields)
            (when (!= i 0) (fprintf g-out ","))
            (let (ftype:(raw Type) ((field-at (sd fields) i) type))
              (fprintf g-out " %s " (type-to-ir ftype))
              (let (slot:(raw Node) (as raw:Node (aref (as ptr:ptr slots) i)))
                (if (= slot null)
                  (fprintf g-out "%s" (type-zero-const-ir ftype))
                  (if (and (= (slot kind) NODE-CELL) (= (node-len (as ptr slot)) 2)
                           (!= (node-at (as ptr slot) 0) null)
                           (= (-> (node-at (as ptr slot) 0) (unsafe/cast ptr:Node _) (_ kind)) NODE-SYM))
                    (defvar-write-const (as raw:Node (node-at (as ptr slot) 1)) ftype encl)
                    (defvar-write-const slot ftype encl))))))
          (fprintf g-out " }"))
        (return)))
    (fprintf g-out "%s" (defvar-init-ir init ty encl))))

; G-2 shape 4 (design/global-init.md §2.7, measured end-to-end there):
; `(defvar g:ptr:T (array T e…))` becomes
;   @g.data = internal global [N x T] [ … ], align A
;   @g      = global ptr @g.data,             align 8
; The pointer is the address of a global, so it is provably non-null with no
; runtime code — which is exactly what lets it satisfy the Phase-F contract for
; a `ptr:T` / `(ref T)` global. Emits the backing global (g-out is already the
; def stream at this point, and this runs before the `@g` line is written, so
; the two land in dependency order) and returns the symbol to point at.
(defn defvar-emit-array-backing (ir-name:ptr init:(raw Node) ty:(raw Type) encl:i32):ptr
  (let (n:i32 0
        ety:(raw Type) (const-array-lit-etype init (as ptr:i32 (addr-of n)) encl))
    ; An elem-less destination (bare `ptr`, `CStr`) claims nothing about the
    ; element type, so there is nothing to check; a typed one must agree.
    (let (tt:(raw Type) ty
          dst-elem:(raw Type) (tt elem))
      (when (and (!= dst-elem null) (= (type-eq dst-elem ety) 0))
        (die-at (node-line init encl)
          (fmt-2s "defvar: array initializer element type %s does not match the declared pointer element type %s"
            (type-spelling ety) (type-spelling dst-elem)))))
    (let (at:(raw Type) (as raw:Type (array-type ety n))
          data-name:ptr (fmt-s "%s.data" ir-name))
      (fprintf g-out "%s = internal global %s " data-name (type-to-ir at))
      (defvar-write-const init at encl)
      (fprintf g-out ", align %d\n" (type-size at))
      ; Same call the `(addr-of g)` branch makes, with the same PTR-REF source:
      ; the flow rule lives in one predicate, never re-derived here.
      (let (pt:ref:Type (make-type TY-PTR))
        (.set! pt elem ety)
        (.set! pt pkind PTR-REF)
        (pkind-flow-check (as ptr pt) ty (node-line init encl) "defvar"))
      (return data-name))))

; Produce the LLVM initializer string for a `defvar` init form at `ty`.
; Accepts int / float / string / null / true / false / defconst-name / (char "x").
; `encl` is the enclosing `defvar` form's line, blamed when the init node is a
; bare symbol (`null`/`true`/`false`/a defconst name) — an interned singleton
; with no line of its own (lib/node.nuc `node-line`). Stage 15 W4a.
(defn defvar-init-ir (init:(raw Node) ty:(raw Type) encl:i32):ptr
  (let (nn:ptr:Node (unsafe/cast ptr:Node init)
        ty-kind:i32 ((unsafe/cast ptr:Type ty) kind))
    ; Integer literal: any int type (signed or unsigned).
    (when (= (nn kind) NODE-INT)
      (when (= (is-int-type ty) 0)
        (die-at (node-line init encl)
          (fmt-s "defvar: integer literal incompatible with type %s" (type-to-ir ty))))
      ; Stage 15 W2b: this is a *second* literal-narrowing site, outside
      ; coerce-int-val's chokepoint — a global initializer is a decimal string
      ; handed straight to LLVM, which truncates `i32 5000000000` to 705032704
      ; without complaint. Apply LW-4's range rule here too, so a global and a
      ; local reject the same out-of-range literal. (Pre-existing for inline
      ; literals, not introduced by W2b; found while fixing the named case.)
      (when (= (int-literal-fits (nn i) ty) 0)
        (die-at (node-line init encl)
          (fmt-2s "defvar: integer literal %s does not fit %s"
            (fmt-i64 "%ld" (nn i)) (type-spelling ty))))
      (return (fmt-i64 "%ld" (nn i))))
    ; Float literal: f32 or f64.
    ; Stage 15 W2d: the old comment here claimed "LLVM accepts the same
    ; decimal/hex form for both" — measured FALSE. LLVM accepts a decimal
    ; constant for `float` only when it round-trips exactly, so
    ; `(defvar gf:f32 1.5)` happened to work while `(defvar gf:f32 3.14)`
    ; emitted `@gf = global float 3.14` and died at IR-parse time with
    ; "floating point constant invalid for type". A global initializer is a
    ; constant, so unlike every other position it cannot be fixed with an
    ; `fptrunc` instruction — it needs the literal rendered at the target width,
    ; which is exactly what `float-literal-ir-at` is for.
    (when (= (nn kind) NODE-FLOAT)
      (when (= (is-float-type ty) 0)
        (die-at (node-line init encl)
          (fmt-s "defvar: float literal incompatible with type %s" (type-to-ir ty))))
      (return (float-literal-ir-at (nn s) ty)))
    ; String literal: any pointer-like type (`ptr` or `CStr`). Intern into the
    ; string table and refer to it as @.str.N (decays to a byte pointer for
    ; printf consumers).
    ;
    ; Stage 15 W5c: this gate was `(!= ty-kind TY-PTR)`, which rejected a
    ; `CStr`-typed global outright. `CStr` is ABI-identical to `ptr`
    ; (context/conventions.md's string-type lattice) — same `ptr` IR type, same
    ; single word, same `null` zero-init — so there was never a representation
    ; reason for the rejection; it was an untested corner, not a policy. Gate on
    ; `is-ptr-like` per that note's standing rule ("when adding a new
    ; pointer/integer ABI decision, branch on `is-ptr-like`", not on TY-PTR).
    ;
    ; BOTH literal spellings are accepted, for `ptr` and `CStr` alike. A plain
    ; `"…"` is a `StrView` since NS-3 and `c"…"` is a raw `CStr` (NS-4), but at
    ; a *global initializer* the distinction has already collapsed: the backing
    ; `@.str.N` rodata is NUL-terminated either way, so an unmaterialized
    ; literal's value simply *is* its `data` pointer — the hidden-NUL free
    ; coercion `coerce-int-val` performs in value position, which likewise
    ; admits a StrView literal into a `ptr` *and* a `CStr` target without
    ; distinguishing them. A plain `"…"` was already accepted here for `ptr`
    ; before W5c, so rejecting it only for `CStr` would have invented an
    ; asymmetry the value path does not have.
    (when (= (nn kind) NODE-STR)
      (when (= (is-ptr-like ty) 0)
        (die-at (node-line init encl)
          (fmt-s "defvar: string literal requires ptr or CStr type, not %s"
            (type-spelling ty))))
      (let (sid:i32 (intern-string (nn s) (unsafe/cast i32 (strlen (nn s)))))
        (return (fmt-i32 "@.str.%d" sid))))
    ; Symbol literal: null, true, false, or a defconst/defenum name.
    (when (= (nn kind) NODE-SYM)
      ; Stage 15 W5c: `is-ptr-like`, not `TY-PTR` — a `CStr` global zero-inits to
      ; `null` exactly as a `ptr` one does (same reasoning as the NODE-STR gate
      ; above). `emit-defvar`'s *no-init* default already branched on
      ; `is-ptr-like`, so `(defvar g:CStr)` emitted `global ptr null` while the
      ; explicit `(defvar g:CStr null)` was rejected — this closes that split.
      (when (= (strcmp (nn s) "null") 0)
        ; --- CStr: an EXPLICIT, permanent exemption ---------------------------
        ; `CStr` is the C `char*` FFI type and is **flow-exempt** by design
        ; (context/conventions.md's string-type lattice groups it with `void*`
        ; as outside the Phase-F non-null regime): a null `char*` is ordinary,
        ; meaningful C, and `(defvar g:CStr null)` is exactly the "not yet set"
        ; global this item exists to enable. Handled here as its own early
        ; return rather than by falling through the `is-ptr-like` test below, so
        ; that the exemption is stated rather than incidental.
        ;
        ; DO NOT fold this back into the ptr path. W5c left a KNOWN, SEPARATE
        ; null-safety hole in the `TY-PTR` branch below; W6 (see the note there)
        ; has since closed it with a `pkind-flow-check`, and the only reason
        ; `CStr` survives that check today is an implementation detail —
        ; `ptr-pkind` answers PTR-RAW for every non-`TY-PTR` kind, so a `CStr`
        ; destination falls out of `pkind-flow-check` at its first line. That is
        ; an accident, not the policy. Keeping the exemption as its own early
        ; return states it. tests/fixtures/w5c-cstr-null-exempt.nuc is the
        ; tripwire that fails if a later tightening sweeps `CStr` up with `ptr`.
        (when (= ty-kind TY-CSTR) (return "null"))
        ; --- ptr (all pkinds) + TY-FN -----------------------------------------
        ; `is-ptr-like` is {TY-PTR, TY-CSTR}: TY-FN is deliberately NOT a member
        ; (src/type-utils.nuc), so it is admitted by name here rather than by
        ; widening that predicate — exactly how `emit-zero-store` and
        ; `type-zero-const-ir` already spell the same three-way rule.
        ;
        ; A function pointer is `ptr` in IR and its slot's implicit zero is
        ; ALREADY `null` (`type-zero-const-ir`'s TY-FN arm), so rejecting the
        ; explicit spelling reproduced precisely the split W5c closed for
        ; `CStr`: `(defvar hook:(fn i32)(i32))` emitted `global ptr null` while
        ; `(defvar hook:(fn i32)(i32) null)` was refused.
        ;
        ; This does not re-open W6's hole. That hole is a PTR-REF *destination*
        ; accepting null, and a TY-FN destination can never be one: `ptr-pkind`
        ; answers PTR-RAW for every non-`TY-PTR` kind, and `(fn ret)(params)` is
        ; the whole function-pointer spelling — the wrapper forms `ptr:(fn …)` /
        ; `(ref (fn …))` denote a pointer *to* a function pointer, are still
        ; PTR-REF, and still reject null through the `pkind-flow-check` below.
        ; So the non-null contract that exists is untouched; TY-FN simply never
        ; carried one, like `CStr` and the elem-less `void*` ptr.
        (when (and (= (is-ptr-like ty) 0) (!= ty-kind TY-FN))
          (die-at (node-line init encl)
            (fmt-s "defvar: null requires ptr, CStr or a function-pointer type, not %s"
              (type-spelling ty))))
        ; Stage 15 W6 (nullability): close the global-initializer half of the
        ; Phase-F non-null gate. This function is a *constant renderer* — it
        ; never routes through `coerce-int-val` (src/abi.nuc), the chokepoint
        ; where every value-position assignment gets its `pkind-flow-check` — so
        ; before this line `(defvar g:ptr:Thing null)` / `(defvar g:(ref Thing)
        ; null)` compiled clean and segfaulted on first use, while the identical
        ; *local* `(let (p:ptr:Thing null) …)` was correctly rejected.
        ;
        ; Call the SAME predicate the local path calls rather than re-deriving
        ; its rules, so the two cannot drift. `null`'s own type is `ty-raw` —
        ; exactly what `emit-symbol-ref` gives the `null` symbol in value
        ; position — and `pkind-flow-check` then supplies all three carve-outs
        ; for free: a `(raw T)` / `?T` destination is not PTR-REF so it returns
        ; at once, and an elem-less bare `ptr` (the `void*` escape hatch, ~1550
        ; bindings in this compiler's own source) is exempt by its
        ; untyped-destination refinement. Only a typed non-null pointer — `ptr:T`
        ; post-flip and its `(ref T)` spelling — rejects, and with the same
        ; wording the local path uses.
        (pkind-flow-check ty-raw ty (node-line init encl) "defvar")
        (return "null"))
      (when (= (strcmp (nn s) "true") 0)
        (when (!= ty-kind TY-I1)
          (die-at (node-line init encl) "defvar: true requires i1/bool type"))
        (return "true"))
      (when (= (strcmp (nn s) "false") 0)
        (when (!= ty-kind TY-I1)
          (die-at (node-line init encl) "defvar: false requires i1/bool type"))
        (return "false"))
      (let (sym:?ptr:Sym (scope-lookup g-globals (nn s)))
        (when (and (!= sym null) (!= (sym is-const) 0))
          (when (= (is-int-type ty) 0)
            (die-at (node-line init encl)
              (fmt-s "defvar: constant '%s' incompatible with non-integer type" (nn s))))
          ; Stage 15 W2b: a named literal narrows exactly as the literal it
          ; names — `(defvar g:i32 BIG)` is the same silent LLVM truncation as
          ; `(defvar g:i32 5000000000)` and gets the same rejection.
          (when (and (!= (sym const-lit) 0)
                     (= (int-literal-fits (sym const-lit-i64) ty) 0))
            (die-at (node-line init encl)
              (fmt-3s "defvar: constant '%s' (%s) does not fit %s"
                (nn s) (fmt-i64 "%ld" (sym const-lit-i64)) (type-spelling ty))))
          (return (sym const-val))))
      ; G-3: a name that is not `null`/`true`/`false` and not a `defconst` is a
      ; read of another global — a run-time value, not a constant. Soft mode
      ; reports that; the hard path (an aggregate ELEMENT) keeps the diagnostic,
      ; because an element must be constant. Without this, `(defvar a:i32 b)`
      ; would be refused while `(defvar a:i32 (+ b 0))` — which reaches the
      ; terminal fall-through below — was accepted, an arbitrary asymmetry.
      (when (!= g-defvar-soft 0) (return null))
      (die-at (node-line init encl) (fmt-s "defvar: unsupported init symbol '%s'" (nn s))))
    ; (char "x") — char literal, one byte stored in an int field.
    (when (and (= (nn kind) NODE-CELL) (= (node-len nn) 2))
      (let (head:ptr:Node (unsafe/cast ptr:Node (node-at nn 0)))
        (when (and (= (head kind) NODE-SYM) (= (strcmp (head s) "char") 0))
          (let (arg:ptr:Node (unsafe/cast ptr:Node (node-at nn 1)))
            (when (or (!= (arg kind) NODE-STR)
                      (!= (strlen (arg s)) 1))
              (die-at (node-line (as ptr arg) encl) "defvar: (char ...) requires a single-char string"))
            (when (= (is-int-type ty) 0)
              (die-at (node-line init encl) "defvar: char literal requires integer type"))
            (return (fmt-i32 "%d" (char-at (arg s) 0)))))))
    ; ---- Stage 15 W8 G-1: constant expressions ------------------------------
    ; Every shape below dies today with "init must be a literal", so no program
    ; that compiles now can have its IR moved by adding them — which is why the
    ; design predicts a byte-identical bootstrap for this step.
    (when (= (nn kind) NODE-CELL)
      (let (nargs0:i32 (- (node-len (as ptr nn)) 1)
            hd0:ptr (node-at (as ptr nn) 0))
        (when (and (!= hd0 null) (= ((unsafe/cast ptr:Node hd0) kind) NODE-SYM))
          ; `(as T x)` at a POINTER-LIKE destination — the shape §1b names, and
          ; the one W5c's progress note recorded as out of scope under "the
          ; general expressions-aren't-literals rule". G-1 IS that rule changing,
          ; not an exception carved into it. Rendered by recursion at `T` and
          ; then put through the same pkind gate `as-ptr-convert` applies in
          ; value position, so `(as (raw T) null)` cannot launder a null into a
          ; `(ref T)` global.
          (when (and (= hd0 'as) (= nargs0 2))
            (let (dst:(raw Type) (parse-type-from-node (node-at (as ptr nn) 1)
                                                       (node-line init encl)))
              (when (and (!= (is-ptr-like dst) 0) (!= (is-ptr-like ty) 0))
                (let (rendered:ptr (defvar-init-ir (node-at (as ptr nn) 2) dst encl))
                  ; G-3: in soft mode the recursion may report "not a constant";
                  ; the whole `as` is then a runtime initializer and the pkind
                  ; gate belongs to the `set!` that lowers it, not here. Inert
                  ; outside soft mode, where the recursion cannot return null.
                  (when (= rendered null) (return null))
                  (pkind-flow-check dst ty (node-line init encl) "defvar")
                  (return rendered)))))
          ; `(addr-of g)` — the address of another global.
          (when (and (= hd0 'addr-of) (= nargs0 1))
            (return (defvar-addr-of-ir (node-at (as ptr nn) 1) ty (node-line init encl)))))))
    ; An integer destination folds an arbitrary integer constant expression. The
    ; result is an untyped literal of that value, so it faces the SAME
    ; `int-literal-fits` gate the written literal above faces — a folded
    ; `(* 2000000000 3)` is rejected exactly as the written `6000000000` is.
    (when (!= (is-int-type ty) 0)
      (let (folded:i64 0)
        (when (!= (const-fold-int init (as ptr:i64 (addr-of folded)) encl) 0)
          (when (= (int-literal-fits folded ty) 0)
            (die-at (node-line init encl)
              (fmt-2s "defvar: constant expression value %s does not fit %s"
                (fmt-i64 "%ld" folded) (type-spelling ty))))
          (return (fmt-i64 "%ld" folded)))))
    ; Stage 15 W8 G-3: this is THE constant-vs-runtime decision point, and the
    ; only one. Under `g-defvar-soft` (armed solely by `defvar-const-init-ir`)
    ; the answer "no constant rendering exists" comes back as `null` and the
    ; initializer is queued for `@__nucleus_init`; otherwise it is the error it
    ; has always been. Nothing anywhere else re-derives this question.
    (when (!= g-defvar-soft 0) (return null))
    (die-at (node-line init encl)
      "defvar: init must be a compile-time constant (a literal, a named constant, or an expression over them)")
    (return null)))

; ============================================================
; Stage 15 W8 G-3 — the runtime-initializer queue (design/global-init.md §5)
; ============================================================

; The single constant-vs-runtime classifier. Returns 1 when `init` HAS a
; compile-time constant rendering at `ty`, 0 when it is a RUNTIME initializer
; that must be queued for `@__nucleus_init`.
;
; On 1 it stores through `out-ir` either the rendered constant string, or
; `null` meaning "this is an aggregate — stream it with `defvar-write-const`".
; An aggregate constant cannot be returned as a string: the `fmt-*` helpers
; clamp at ~1KB (context/conventions.md) and these tables are unbounded, which
; is exactly why G-2 made the aggregate renderer stream.
;
; This is NOT a second predicate sitting beside the renderer. For a scalar
; destination the answer IS `defvar-init-ir`'s, obtained by arming
; `g-defvar-soft` for precisely that one call; for an aggregate destination it
; is `const-array-lit?` / `const-struct-lit?`, the same two functions
; `defvar-write-const` gates on. §4.8's zero-cost guarantee turns on there
; being exactly one classifier, and `context/conventions.md`'s standing rule
; for `defvar-init-ir` is to call the shared predicate rather than re-derive
; its conditions — this stage has been bitten by re-derivation twice.
;
; `(array T N)` is deliberately constant-only. G-2 ruled that an array binding
; names storage no assignment can target (`emit-set` refuses one), so there is
; no `set!` for a runtime lowering to produce; `defvar-write-const` keeps
; raising its existing diagnostic, which names the `ptr:T` + `(array T lit…)`
; spelling that does work.
(defn defvar-const-init-ir (init:(raw Node) ty:(raw Type) encl:i32 out-ir:ptr):i32
  (aset! (as ptr:ptr out-ir) 0 null)
  (let (tt:(raw Type) ty
        tk:i32 (tt kind))
    (when (= tk TY-ARRAY) (return 1))
    (when (or (= tk TY-STRUCT) (= tk TY-UNION))
      ; The constant grammar at an aggregate slot is a compound literal, and
      ; `const-struct-lit?` is the same gate `defvar-write-const` applies, so
      ; the two cannot disagree about what is constant.
      (when (!= (const-struct-lit? init (tt sdef)) 0) (return 1))
      ; Not this struct's literal. A LEAF node — an integer/float/string
      ; literal, `null`, a bare name — cannot be a compound literal at all, so
      ; it is a type error, and `defvar-write-const`'s diagnostic (which names
      ; the `(S …)` spelling that works) is a better answer than the `set!`
      ; lowering could give; hand it back. A CELL that is not this struct's
      ; literal is an expression, and an expression at an aggregate slot is
      ; exactly a run-time initializer.
      ;
      ; The one shape this costs is `(defvar p2:P p1)` — a whole-struct copy
      ; from another global, which `set!` would accept. Deliberate: it is worth
      ; less than the diagnostic, and the explicit spelling is one `set!` in an
      ; init function.
      (when (!= ((unsafe/cast ptr:Node init) kind) NODE-CELL) (return 1))
      (return 0))
    (let (saved:i32 g-defvar-soft
          rendered:ptr null)
      (set! g-defvar-soft 1)
      (set! rendered (defvar-init-ir init ty encl))
      (set! g-defvar-soft saved)
      (when (= rendered null) (return 0))
      (aset! (as ptr:ptr out-ir) 0 rendered)
      (return 1))))

; Append a runtime initializer to the queue, in reach order.
;
; The emitted form is an ordinary `(set! name init)`. That is the whole
; lowering, and it is what makes §2.8's `pkind-flow-check` apply with no second
; nullability path: the store runs through `coerce-int-val` exactly as a
; hand-written assignment does, so a `(raw T)` value into a `ptr:T` global is
; refused here for the same reason and with the same wording it is refused in a
; function body.
;
; Every cell carries the `defvar`'s line, so a diagnostic raised while emitting
; the initializer at drain time is located at the `defvar` the user wrote —
; interned symbols (the `set!` head and the target name) have no line of their
; own (context/conventions.md).
(defn defvar-queue-init (name:CStr init:(raw Node) line:i32):void
  (let (args:ptr (as ptr (make-cell (as ptr (intern-symbol name))
                                    (as ptr (make-cell (as ptr init) null line))
                                    line))
        form:ptr (as ptr (make-cell (as ptr (intern-symbol "set!")) args line))
        job:ptr:InitJob (new InitJob))
    (.set! job form (as raw:Node form))
    (.set! job ns g-current-ns)
    (.set! job path g-source-path)
    (.set! job line line)
    (.set! job name name)
    (conj g-init-worklist job)))

; ============================================================
; Stage 15 W8 G-4 — the initializer-ordering diagnostic
; (design/global-init.md §4.2)
; ============================================================
;
; §4.1 settles the order rule: a run-time initializer runs when its `defvar` is
; *reached* during emission — source order within a file, import order across
; files. §4.2 settles how much of the resulting hazard is checkable, and draws
; the boundary exactly:
;
; * A **syntactic** reference is checkable. `(defvar a:i32 (+ b 1))` either has
;   `b`'s `defvar` before `a`'s in emission order or it does not, and answering
;   that is one lookup.
; * A reference **laundered through a call** is not, and is not going to be: it
;   needs callee effect summaries, which `design/stage15-stress-test/
;   nullability.md` §9 declares a permanent non-goal for exactly this reason.
;   This compiler's own shape, `(vector-new-in (addr-of g-arena-alloc))`, is
;   that case. It is undiagnosed and **documented as undiagnosed**
;   (docs/toplevel.md) — the honest boundary W6 §4.5 draws, not a silent gap.
; * A genuine **cycle** falls out of the same check with no cycle machinery of
;   its own: whichever of the two is emitted first names a global the other has
;   not reached. Through calls it is likewise invisible and becomes a read of a
;   zero.
; * A computed **topological order** is a non-goal (§6): same analysis, same
;   reason.
;
; Two questions §4.2 left open, decided here:
;
; 1. **"Not yet reached" is about EMISSION, not resolution**, and the two are
;    now genuinely different questions. Before G-0 they coincided — a forward
;    name simply did not resolve. G-0 made every reachable file's `defvar` names
;    resolve before the first form is emitted, *precisely* so that resolution
;    stopped being ordinal (§4.1's argument for why this is not the rule W1
;    retired depends on it). So a successful `scope-lookup` proves nothing here,
;    and this check reads `Sym.defvar-state` instead: the prescan's Sym says
;    DECLARED, and `emit-defvar` appends a second Sym for the same key saying
;    REACHED. This check therefore never reports "undefined" — that is still
;    resolution's answer, and it is still order-independent.
; 2. **`(addr-of g)` is not a read.** A global's address is a link-time constant
;    that requires no initialization to have happened — it is exactly what G-1
;    folds to a bare `@g` — so taking it before the target's `defvar` is
;    legitimate, and this compiler's own source does it. Reading the *value*
;    (`(+ g 1)`) is what gets a zero. `examples/g1-const-init.nuc` already ships
;    the forward `(addr-of g-later-target)` shape and must keep compiling;
;    `tests/fixtures/g4-addr-of-forward-ok.nuc` pins the decision on the
;    run-time path too, where the exemption is not incidental.
;
; Blame one symbol named by an initializer. Silent unless it resolves to a
; global whose own `defvar` is still only DECLARED.
(defn defvar-blame-forward-ref (name:CStr self:CStr encl:i32):void
  (let (sym:?ptr:Sym (scope-lookup g-globals name))
    ; Unresolved is not this check's business: an initializer naming nothing is
    ; already `undefined: x` from the emitter that lowers it, and answering here
    ; would put a resolution verdict in an ordering diagnostic.
    (when (= sym null) (return))
    ; A `defconst` / `defenum` member / `deferror` id is a compile-time value
    ; with no storage, so there is no initialization for it to be waiting on.
    (when (!= (sym is-const) 0) (return))
    ; 0 covers a function, an `extern`, and a `.nuch`-imported global. An
    ; `extern` is deliberately outside the rule: its storage belongs to another
    ; translation unit and cross-TU initialization order is unspecified here for
    ; the same reason it is in C++ (§4.1).
    (when (!= (sym defvar-state) DEFVAR-DECLARED) (return))
    (when (= name self)
      (die-at encl
        (fmt-2s "%s\n%s"
          (fmt-2s "defvar: the initializer for '%s' names '%s' itself, whose defvar has not been reached yet -- the slot still holds its zero"
            name name)
          "  note: a global's initializer runs at the point its own defvar is reached, so it cannot read the global it is initializing")))
    (let (site:ptr (as ptr "elsewhere in this compilation unit"))
      ; src-file/src-line come from `sym-set-src-loc`, which the prescan runs
      ; with `g-source-path` set to the file it is walking — so the note's
      ; location is the target's OWN file even though the target has not been
      ; emitted yet, which is what makes "name both sites" possible at all.
      (when (!= (sym src-file) null)
        (set! site (fmt-sd "%s:%d" (as ptr (sym src-file)) (sym src-line))))
      (die-at encl
        (fmt-2s "%s\n%s"
          (fmt-2s "defvar: the initializer for '%s' names global '%s', whose own defvar has not been reached yet -- it still holds its zero at this point"
            self name)
          ; The advice is hedged deliberately: a genuine CYCLE reaches this same
          ; message (§4.2 — it needs no machinery of its own), and reordering is
          ; exactly what cannot fix one (§4.1 consequence 3).
          (fmt-2s "  note: '%s' is declared at %s; initializers run in the order their defvars are reached (source order within a file, import order across files), so move that defvar above this one -- unless it depends on this one in turn, which is a cycle no order satisfies"
            name site))))))

; Walk an initializer expression, blaming every symbol it names. `self` is the
; name being defined, so `(defvar a:i32 (+ a 1))` reports itself rather than a
; note pointing back at its own line.
(defn defvar-check-init-order (n:(raw Node) self:CStr encl:i32):void
  (when (= n null) (return))
  (let (nn:ptr:Node (unsafe/cast ptr:Node n))
    (when (= (nn kind) NODE-SYM)
      (defvar-blame-forward-ref (as CStr (nn s)) self encl)
      (return))
    (when (!= (nn kind) NODE-CELL) (return))
    ; Three heads whose operands are not value reads, skipped subtree and all:
    ;   `addr-of`     — an address, not a value (see the decision above);
    ;   `quote` /     — the symbols inside are DATA. Walking them would reject
    ;   `quasiquote`    `(defvar g:(raw Node) (quote (b c)))` for "naming" a
    ;                   global `b` it never reads. A quasiquote's `~b` unquote
    ;                   IS a read, and is given up with the rest of the subtree:
    ;                   a false positive breaks a program that compiles today,
    ;                   which is strictly worse than a missed diagnosis in a
    ;                   class that is already documented as incomplete.
    (let (hd:ptr (node-at (as ptr nn) 0))
      (when (and (!= hd null)
                 (= ((unsafe/cast ptr:Node hd) kind) NODE-SYM)
                 (or (= hd 'addr-of) (= hd 'quote) (= hd 'quasiquote)))
        (return)))
    ; Head position included on purpose: a call through a function-POINTER
    ; global — `(g-hook 1)` — reads that global's value like any other use.
    (let (i:i32 0
          n-elems:i32 (node-len (as ptr nn)))
      (while (< i n-elems)
        (defvar-check-init-order (as raw:Node (node-at (as ptr nn) i)) self encl)
        (inc! i)))))

; Stage 15 W8 G-5 step 4 — the flip (design/global-init.md §5 G-5, and the
; remaining half of nullability.md §1.5). A `defvar` whose declared type is a
; NON-NULL typed pointer must be initialized: without an initializer the slot
; gets `type-zero-const-ir`'s `null`, which is exactly the value the type
; promises it can never hold. Every other position in the language has enforced
; this since Phase F; the global declaration was the one hole left, and it was
; only tolerable while there was no way to write the initializer at all.
;
; The predicate is `pkind-flow-check`'s, deliberately: PTR-REF destination, and
; an element type. Both carve-outs are inherited rather than re-derived —
; `CStr` is TY-CSTR (ptr-pkind PTR-RAW) and an elem-less bare `ptr` names no
; pointee, so neither carries a non-null contract. `raw`/`(raw T)`/`?T` are
; unaffected: a nullable global with no initializer is honest and stays legal.
(defn defvar-require-init (name:CStr ty:(raw Type) line:i32):void
  (when (!= (ptr-pkind ty) PTR-REF) (return))
  (when (= (ty elem) null) (return))
  (die-at line
    (fmt-2s "%s\n%s"
      (fmt-s "defvar: '%s' has a non-null pointer type but no initializer -- the slot would start as null, which is exactly the value its type says it can never hold"
        name)
      "  note: give it an initializer, or declare it nullable with `raw` (`(raw T)` / `raw:T`) if it genuinely may be null before first use")))

(defn emit-defvar (call:(raw Node)):void
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (< (node-len cc) 2)
      (die-at (cc line) "defvar: expects name and optional init"))
    ; AT-1 (design/stage14/attributes.md §2): the attribute slot sits between the
    ; `defvar` head and the name — `(defvar :volatile trap-zero:i32 0)`. Strip and
    ; validate leading keywords, then read the name/init off the advanced cursor.
    ; No keyword => decl == (cc cdr), name/init unchanged => byte-identical.
    (let (attr-flags:i32 0
          decl:ptr (parse-decl-attrs (as ptr (cc cdr)) (as ptr:i32 (addr-of attr-flags)) (cc line)))
      (when (= decl null)
        (die-at (cc line) "defvar: expects name and optional init"))
      (let (declc:ptr:Node (unsafe/cast ptr:Node decl)
            name-node:ptr (declc car)
            init-cell:ptr (declc cdr))
        ; name + optional init; nothing may follow the init.
        (when (and (!= init-cell null) (!= ((unsafe/cast ptr:Node init-cell) cdr) null))
          (die-at (cc line) "defvar: expects name and optional init"))
        (let (name:ptr null
              ; W4b sibling sweep: `name-node` is frequently a bare NODE-SYM
              ; (the common `(defvar x:i32 0)` shape), whose own `line` is
              ; always 0 (interned symbols carry no line — context/
              ; conventions.md). Reading `(name-node line)` directly here
              ; used to leak that 0 into both extract-name-and-type's
              ; internal fallback and the "missing :type" die-at below,
              ; reporting `:0:` for the plain, very-plausible mistake
              ; `(defvar x 0)` (no type at all). node-line borrows the
              ; enclosing `defvar` form's real line instead.
              name-line:i32 (node-line (as ptr name-node) (cc line))
              ; G-2: a defvar's own type may be `(array T N)` — one of the two
              ; storage positions the array type exists for.
              ty:ptr (extract-decl-name-and-type name-node (as ptr:ptr (addr-of name)) name-line))
          (when (= ty null)
            (die-at name-line (fmt-s "defvar: missing :type on '%s'" name)))
          ; :volatile marks the storage slot volatile (lowers to the is-volatile
          ; Type flag, identical to the postfix spelling `trap-zero:i32:volatile`).
          (when (!= (bit-and attr-flags DECL-ATTR-VOLATILE) 0)
            (set! ty (as ptr (type-with-volatile (unsafe/cast ref:Type ty)))))
          (guard-name-kind name (cc line) NK-VALUE)
          ; Stage 15 B4 (R4): a second `defvar` of one name. The tell here is
          ; neither existence nor a location — W8 G-0 front-loads every reachable
          ; file's `defvar` names into this same frame, so a Sym under this key is
          ; the NORMAL state — it is `defvar-state`: the prescan's Sym says
          ; DECLARED and only `emit-defvar` promotes one to REACHED, so REACHED
          ; means another `defvar` form already emitted its `@g = global`. This
          ; used to reach LLVM's own parser as two `@g = global` lines, which
          ; reports without a source location at all.
          ; The probe is the KEY lookup, not the reference resolver: this is the
          ; key `scope-define` is about to write (conventions.md, "Splitting a
          ; lookup into reference/key").
          (if-some (prevv (scope-lookup-key g-globals name))
            (when (and (= (prevv defvar-state) DEFVAR-REACHED)
                       (= (same-definition-site (prevv src-file) (prevv src-line) (cc line)) 0))
              (die-redefinition (as CStr name) (cc line) BK-GLOBAL
                                (prevv src-file) (prevv src-line)))
            0)
          ; G-5 step 4: a non-null typed-pointer global must be initialized.
          (when (= init-cell null)
            (defvar-require-init name (as raw:Type ty) (cc line)))
          ; Stage 12 N4: a global emits `@name`, prefixed with the namespace
          ; ir-prefix in a non-`user` namespace (`@foo__name`). Identity under
          ; `user`, so the bootstrap is byte-identical.
          ; Stage 15 W5e: def-ir-base is ns-ir-base plus the owning file's
          ; private prefix when this is a `defvar-` in the default `user`
          ; namespace — so two files' private `g-counter`s emit two distinct
          ; `internal` globals instead of two `@g-counter` definitions (which
          ; LLVM rejected with an unlocated parse error).
          (let (ir-name:ptr (fmt-s "@%s" (def-ir-base name))
                align:i32 (type-size ty)
                init-ir:ptr null
                init-node:(raw Node) null
                ; G-3: set when the classifier below reports that this
                ; initializer has no constant rendering. The slot then gets the
                ; type's zero and the initializer is queued for @__nucleus_init.
                runtime-init:i32 0)
            (check-ir-name-legal (cc line) name ir-name)
            (when (!= init-cell null)
              (set! init-node (as raw:Node ((unsafe/cast ptr:Node init-cell) car))))
            ; G-2 shape 4: a pointer-typed global initialized with an array
            ; literal gets a `@g.data` backing global and points at it.
            (when (and (!= init-node null)
                       (!= (is-ptr-like ty) 0)
                       (!= (const-array-lit? init-node) 0))
              (set! init-ir (defvar-emit-array-backing ir-name init-node ty (cc line))))
            ; G-3: ask the classifier ONCE, for every shape shape 4 did not
            ; already render. A 0 answer is "runtime initializer"; a 1 answer
            ; with a null string is "constant aggregate — stream it below".
            (when (and (= init-ir null) (!= init-node null))
              (let (rendered:ptr null)
                (if (= (defvar-const-init-ir init-node ty (cc line)
                         (as ptr (addr-of rendered))) 0)
                  (set! runtime-init 1)
                  (set! init-ir rendered))))
            (when (!= runtime-init 0)
              ; §2.9 / §4.5: a compile-time or macro JIT module has no program
              ; globals and never reaches a drain point, so an initializer
              ; queued from one would simply never run. Refuse, located, rather
              ; than leave a silent zero.
              (when (!= (in-jit-module) 0)
                (die-at (cc line)
                  (fmt-s "defvar: '%s' needs a run-time initializer, which a compile-time or macro body cannot have -- that module has no program globals"
                    name)))
              ; `:const` storage is LLVM `constant` (read-only), so there is no
              ; store that could initialize it — `emit-set` refuses one for the
              ; same reason. Say so here, where the cause is.
              (when (!= (bit-and attr-flags DECL-ATTR-CONST) 0)
                (die-at (cc line)
                  (fmt-s "defvar: '%s' is :const, so its initializer must be a compile-time constant -- read-only storage cannot be written at startup"
                    name)))
              ; G-4 (§4.2): the ordering diagnostic runs here, on the RUN-TIME
              ; path only. A constant initializer is folded from literals, named
              ; constants, `(sizeof T)`, `(as T x)` and addresses — not one of
              ; which reads a global's value — so there is nothing for it to
              ; check, and confining it here is also what keeps it free of false
              ; positives on the constant-aggregate grammar, whose designated
              ; field names (`(P (y 9))`) and index cells are selectors rather
              ; than references. An initializer with a non-constant ELEMENT
              ; inside a constant aggregate never reaches this point either: an
              ; element must be constant regardless of order, and it keeps the
              ; better "init must be a compile-time constant" diagnostic.
              (defvar-check-init-order init-node (as CStr name) (cc line))
              (defvar-queue-init name init-node (cc line)))
            ; No initializer (or a runtime one, whose slot starts at zero and is
            ; filled by @__nucleus_init): the type's zero. G-2 moved the
            ; three-bucket rule (pointers `null`, aggregates `zeroinitializer` —
            ; which now covers `(array T N)` as well — everything else
            ; `0`/`0.0`/`false`) into `type-zero-const-ir` so the
            ; constant-aggregate renderer's unspecified slots use the identical
            ; rule rather than a copy of it.
            (when (and (= init-ir null) (or (= init-node null) (!= runtime-init 0)))
              (set! init-ir (type-zero-const-ir ty)))
            ; Stage 12 N3: private defvar emits `internal` LLVM linkage.
            ; AVR-6: `:const` selects the LLVM `constant` storage class over
            ; `global` (read-only; on mapped-flash AVR parts it stays out of RAM).
            ; Four combinations: private/public × global/constant. `storage` binds
            ; from an if over two StrView literals (homogeneous join, no collapse);
            ; when the CONST bit is clear it is "global" and both branches are
            ; byte-identical to the historical output.
            ; G-2 split this from one fprintf into three so a constant aggregate
            ; can be STREAMED between the prefix and the suffix. The bytes are
            ; identical for every pre-G-2 shape (init-ir non-null → one "%s"),
            ; which is why the bootstrap does not move; streaming matters because
            ; a `fmt-*`-accumulated table would silently clamp at ~1KB
            ; (context/conventions.md, format-helper buffer sizes).
            (let (storage:ptr (if (!= (bit-and attr-flags DECL-ATTR-CONST) 0) "constant" "global"))
              (if (!= g-defining-private 0)
                (fprintf g-out "%s = internal %s %s " ir-name storage (type-to-ir ty))
                (fprintf g-out "%s = %s %s " ir-name storage (type-to-ir ty)))
              (if (!= init-ir null)
                (fprintf g-out "%s" init-ir)
                (defvar-write-const init-node ty (cc line)))
              (fprintf g-out ", align %d\n\n" align))
            (let (vsym:ref:Sym (scope-define g-globals name ty ir-name 1))
              (when (!= g-defining-private 0) (.set! (unsafe/cast ptr:Sym vsym) sym-private 1))
              ; AVR-6 gap fix: mark the Sym so `set!` can reject writes to
              ; this `constant`-storage global at compile time (emit-set).
              (when (!= (bit-and attr-flags DECL-ATTR-CONST) 0)
                (.set! (unsafe/cast ptr:Sym vsym) readonly-global 1))
              ; G-4: the `@g = global` line is out, so this global's `defvar` has
              ; now been REACHED — every initializer emitted after this point may
              ; read its value. A later `scope-lookup` finds this Sym rather than
              ; the prescan's (backwards scan), which is the whole mechanism.
              (.set! (unsafe/cast ptr:Sym vsym) defvar-state DEFVAR-REACHED)
              (sym-set-src-loc (as ptr vsym) (cc line)))))))))

(defn emit-defconst (call:(raw Node)):void
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 3) (die-at (cc line) "defconst: expects name and value"))
    (let (name:ptr:Node (unsafe/cast ptr:Node (node-at cc 1))
          val:ptr:Node (unsafe/cast ptr:Node (node-at cc 2)))
      ; W4b (design/stage15-stress-test/diagnostics.md): `defconst` takes no
      ; type annotation -- its value is always ty-i32 from an integer literal,
      ; so there is nothing an annotation could mean. Before this check, a
      ; colon-typed name silently registered under the WRONG key: `desugar`
      ; never rewrites a `defconst` name (only defn/defvar/extern/declare
      ; names, defstruct fields, and let/with binding names are desugared —
      ; see context/conventions.md), so `K:i32` arrived as one undesugared
      ; NODE-SYM whose spelling is literally "K:i32", passed the old
      ; `(!= (name kind) NODE-SYM)` check unchanged, and got registered under
      ; that literal, unlookupable name -- every later use of `K` then died
      ; `undefined: K` with no diagnostic at the definition. Reject both
      ; surface shapes: a bare symbol whose spelling embeds ':' ("K:i32"), and
      ; the colon-paren-fused CELL shape ("K:(i32)" -> (K (i32)), produced by
      ; `fuse-colon-paren` in lib/reader.nuc) which would otherwise fall into
      ; the generic, misleading "name must be symbol" die below.
      (when (= (name kind) NODE-SYM)
        (let (base:ptr null tyname:ptr null)
          (split-typed (name s) (as ptr:ptr (addr-of base)) (as ptr:ptr (addr-of tyname)))
          (when (!= tyname null)
            (die-at (cc line)
              (fmt-sd "defconst: takes no type annotation; write (defconst %s %d)"
                      base (if (= (val kind) NODE-INT) (unsafe/cast i32 (val i)) 0))))))
      (when (= (name kind) NODE-CELL)
        (let (base-node:(raw Node) (name car))
          (when (and (!= base-node null) (= (base-node kind) NODE-SYM))
            (die-at (node-line (as ptr name) (cc line))
              (fmt-sd "defconst: takes no type annotation; write (defconst %s %d)"
                      (base-node s) (if (= (val kind) NODE-INT) (unsafe/cast i32 (val i)) 0))))))
      (when (!= (name kind) NODE-SYM)
        (die-at (name line) "defconst: name must be symbol"))
      (when (!= (val kind) NODE-INT)
        (die-at (val line) "defconst: value must be integer literal"))
      (guard-name-kind (name s) (cc line) NK-VALUE)
      (guard-const-redefinition (name s) (cc line))
      ; Stage 15 W2b: the constant's type is the literal's *truthful* width
      ; (int-literal-type — emit-int's LW-4 rule, shared, not re-derived). This
      ; was hardcoded `ty-i32` while `const-val` carried the full decimal string,
      ; so `(defconst BIG 5000000000)` emitted the i32 constant `5000000000` and
      ; `(let (x:i64 BIG) …)` printed 705032704 — the exact silent wrap LW-4 had
      ; already fixed for inline literals. (The spec doc's premise that such
      ; constants "are stored i64 today" was wrong; measured.)
      (let (sym:ref:Sym (scope-define g-globals (name s)
                          (as ptr (int-literal-type (val i))) null 0))
        (.set! sym is-const 1)
        (.set! sym const-val (fmt-i64 "%ld" (val i)))
        ; W2b: the name stands for the literal — carry the VALUE, not just a
        ; flag, so a reference adapts at a use site (binop-result-type) and an
        ; out-of-range narrowing is caught (coerce-int-val) rather than wrapped.
        (.set! sym const-lit 1)
        (.set! sym const-lit-i64 (val i))
        ; Stage 12 N3: mark private when defined via `defconst-`.
        (when (!= g-defining-private 0) (.set! sym sym-private 1))
        ; Stage 15 B4 (R4): the defining site, which `guard-const-redefinition`
        ; reads to tell this form's own prescan Sym from a second `defconst`.
        (sym-set-src-loc (as ptr sym) (cc line))))))

; Stage 10 errors (design/stage10/errors.md §8). (deferror name "message")
; binds `name` as a compile-time Err constant whose value is a dense id (from 1)
; and records {name, message} in the descriptor table emitted at module
; assembly. The name is the contract; the id is per-build representation.
; Stage 10 C3: returns `!i32` (= (Result i32 Err)) rather than `void`. Each
; malformed-form fault prints the identical `path:line: error: msg` diagnostic
; via `report-at` (byte-for-byte as the old `die-at`) and then returns
; `(err! malformed-form)` on the value channel; the single caller
; (emit-toplevel-forms) absorbs it with a local `match` → `exit 1`, matching the
; old abort behavior. The success path returns `(ok 0)`. The cascade terminates
; at the caller — emit-node and the emit-* spine are never threaded with `try`.
(defn emit-deferror (call:(raw Node)):!i32
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 3)
      (do (report-at (cc line) "deferror: expects (deferror name \"message\")")
          (return (err! malformed-form))))
    (let (name-node:ptr:Node (unsafe/cast ptr:Node (node-at cc 1))
          msg-node:ptr:Node (unsafe/cast ptr:Node (node-at cc 2)))
      ; W4b sibling sweep: a colon-typed name ("MyErr:i32") silently registered
      ; under that literal, unlookupable key -- the same defconst-shaped bug
      ; (see reject-colon-in-def-name). deferror uses report-at + (err!
      ; malformed-form) rather than die-at (its own established non-aborting
      ; convention, per the comment above emit-deferror), so this is a bespoke
      ; check rather than a call to the shared die-at-based helper.
      (when (= (name-node kind) NODE-SYM)
        (let (base:ptr null tyname:ptr null)
          (split-typed (name-node s) (as ptr:ptr (addr-of base)) (as ptr:ptr (addr-of tyname)))
          (when (!= tyname null)
            (do (report-at (cc line)
                  (fmt-s "deferror: takes no type annotation; write (deferror %s \"message\")" base))
                (return (err! malformed-form))))))
      (when (!= (name-node kind) NODE-SYM)
        (do (report-at (name-node line) "deferror: name must be a symbol")
            (return (err! malformed-form))))
      (when (!= (msg-node kind) NODE-STR)
        (do (report-at (msg-node line) "deferror: message must be a string literal")
            (return (err! malformed-form))))
      ; Re-import dedup: an existing Err constant of this name keeps its id, so
      ; .nuc re-imports never renumber (the name is the stable contract).
      ; B2b: a KEY question — the id this `deferror` would register under.
      (let (existing:?ptr:Sym (scope-lookup-key g-globals (name-node s)))
        (when (and (!= existing null)
                   (!= (existing is-const) 0)
                   (= (-> existing (_ type) (unsafe/cast ptr:Type _) (_ kind)) TY-ERR))
          (return (ok 0))))
      (guard-name-kind (name-node s) (cc line) NK-VALUE)
      (when (>= (- (unsafe/cast i32 (count g-deferror-name-sids)) 1) MAX-DEFERRORS)
        (do (report-at (cc line) "deferror: too many error definitions (id cap 4095)")
            (return (err! malformed-form))))
      ; The next 1-based id is the index the new element lands at — i.e. the
      ; current count (index 0 is the reserved placeholder).
      (let (id:i32 (unsafe/cast i32 (count g-deferror-name-sids))
            name-sid:i32 (intern-string (name-node s) (unsafe/cast i32 (strlen (name-node s))))
            msg-sid:i32 (intern-string (msg-node s) (unsafe/cast i32 (strlen (msg-node s)))))
        (conj g-deferror-name-sids name-sid)
        (conj g-deferror-msg-sids msg-sid)
        (let (sym:ref:Sym (scope-define g-globals (name-node s) (as ptr ty-err) null 0))
          (.set! sym is-const 1)
          (.set! sym const-val (fmt-i32 "%d" id)))
        (return (ok 0))))))

; (err-name e) / (err-message e) — descriptor-table accessors over an Err value.
; Inline lookups (a GEP+load on the flush-emitted table); a corrupted id is UB,
; the same C contract as match's tag switch. `which`: 0 = names, 1 = messages.
(defn emit-err-accessor (call:(raw Node) scope:ref:Scope which:i32):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 2)
      (die-at (cc line) "err-name/err-message expects 1 arg"))
    (let (v:ref:Val (emit-node (node-at cc 1) scope))
      (when (= (is-int-type (v type)) 0)
        (die-at (cc line) "err-name/err-message: argument must be an Err"))
      (set! g-err-table-used 1)
      (let (idv:?ptr:Val (coerce-int-val (as ptr v) (as ptr ty-i64) (cc line)))
        (when (= idv null)
          (die-at (cc line) "err-name/err-message: argument must be an Err"))
        (let (gep:ptr (new-tmp)
              res:ptr (new-tmp)
              tbl:ptr (if (= which 0) "@nuc_err_names" "@nuc_err_messages"))
          (fprintf g-body-stream "  %s = getelementptr ptr, ptr %s, i64 %s\n"
            gep tbl ((as ptr:Val idv) val))
          (fprintf g-body-stream "  %s = load ptr, ptr %s, align 8\n" res gep)
          (return (alloc-val ty-cstr res)))))))

; (type-token T) — the mangled-name token of type T as a CStr literal. Used by
; with-handler to label a handler with its declared repair type; the err site
; computes the same token for its own T, so the two agree (errors.md §11.2).
(defn emit-type-token (call:(raw Node) scope:ref:Scope):ref:Val
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 2) (die-at (cc line) "type-token expects 1 type arg"))
    (let (ty:ptr (parse-type-from-node (node-at cc 1) (cc line))
          token:ptr (type-mangle-token ty)
          sid:i32 (intern-string token (unsafe/cast i32 (strlen token)))
          tmp:ptr (new-tmp))
      (fprintf g-body-stream
        "  %s = getelementptr inbounds [%d x i8], ptr @.str.%d, i64 0, i64 0\n"
        tmp (+ (unsafe/cast i32 (strlen token)) 1) sid)
      (return (alloc-val ty-cstr tmp)))))

(defn emit-defenum (call:(raw Node)):void
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (< (node-len cc) 2) (die-at (cc line) "defenum: missing name"))
    (let (enum-name-node:ptr:Node (unsafe/cast ptr:Node (node-at cc 1)))
      (reject-colon-in-def-name (as raw:Node enum-name-node) "defenum" (cc line))
      ; W4b sibling sweep: defenum has no template/parametric-name concept
      ; (unlike defstruct/defprotocol/defunion), so any CELL name here can
      ; only be the colon-paren-fused single-annotation shape ("E:(i32)" ->
      ; (E (i32))). Before this check, a CELL name-node silently skipped
      ; EnumDef registration below (its own `(= (en kind) NODE-SYM)` guard)
      ; while the flat member loop still ran and defined A/B/C fine — so the
      ; mistake was invisible unless the enum's own type name was later
      ; referenced (e.g. as a generic receiver's tyvar-vs-concrete-type check
      ; in generics.nuc's tyname-resolvable).
      (when (= (enum-name-node kind) NODE-CELL)
        (let (base-node:(raw Node) (enum-name-node car))
          (when (and (!= base-node null) (= (base-node kind) NODE-SYM))
            (die-at (node-line (as ptr enum-name-node) (cc line))
              (fmt-s "defenum: takes no type annotation; write (defenum %s ...)" (base-node s))))))
      ; Stage 15 B4 (R4): checked BEFORE the member loop, so a second `defenum`
      ; of one name is blamed at its own line rather than at whichever member
      ; happens to collide first — and so an enum whose members are all fresh
      ; (which used to skip the EnumDef registration silently, keeping the first
      ; member table for `match` exhaustiveness) is refused at all.
      (when (= (enum-name-node kind) NODE-SYM)
        (if-some (preve (enumdef-lookup (as CStr (qualify-name (enum-name-node s)))))
          (when (= (same-definition-site (preve src-file) (preve src-line) (cc line)) 0)
            (die-redefinition (enum-name-node s) (cc line) BK-ENUM
                              (preve src-file) (preve src-line)))
          0)))
    (let (i:i32 2)
      (while (< i (node-len cc))
        (let (name:ptr:Node (unsafe/cast ptr:Node (node-at cc i)))
          (when (!= (name kind) NODE-SYM)
            (die-at (name line) "defenum: value must be symbol"))
          (guard-name-kind (name s) (cc line) NK-VALUE)
          ; Stage 15 B4 (R4): two `defenum`s sharing a member name. The enum's own
          ; NAME is checked above, before this loop; this catches the case the
          ; name check cannot see — two differently-named enums that both declare
          ; the member, which used to define it twice with the second's ordinal
          ; silently winning at every use site.
          (guard-const-redefinition (name s) (cc line))
          (let (sym:ref:Sym (scope-define g-globals (name s) ty-i32 null 0))
            (.set! sym is-const 1)
            (.set! sym const-val (fmt-i32 "%d" (- i 2)))
            ; Stage 15 W2b: an enum member is a named integer literal too — it
            ; carries no distinct nominal type (its Sym type is plain i32, and
            ; `match` exhaustiveness keys off the EnumDef, not the type), so
            ; withholding literal provenance here would recreate the very wart
            ; W2b removes one level over: `(= c:ui32 RED)` rejected while
            ; `(= c:ui32 0)` compiles. The ordinal always fits i32, so no
            ; int-literal-type call is needed (unlike defconst).
            (.set! sym const-lit 1)
            (.set! sym const-lit-i64 (as i64 (- i 2)))
            ; Stage 12 N3: mark private when defined via `defenum-`.
            (when (!= g-defining-private 0) (.set! sym sym-private 1))
            ; Stage 15 B4 (R4): the defining site — see `guard-const-redefinition`.
            (sym-set-src-loc (as ptr sym) (cc line))))
        (inc! i)))
    ; Record the member table so `match` can check exhaustiveness over the
    ; enum (unions.md §4 freebie). Re-registration (import dedup) is a no-op.
    (let (en:ptr:Node (unsafe/cast ptr:Node (node-at cc 1)))
      (when (and (= (en kind) NODE-SYM)
                 (< (unsafe/cast i32 (count g-enumdefs)) MAX-ENUMS)
                 ; Stage 15 B3′: an existence probe on the key the definer is
                 ; about to write, so `enumdef-lookup` (exact), never the
                 ; reference resolver.
                 (= (as ptr (enumdef-lookup (as CStr (qualify-name (en s))))) null))
        (let (n:i32 (- (node-len cc) 2)
              members:ptr (arena-alloc (* (as i64 n) (ptr-bytes)))
              ed:ptr:EnumDef (as ptr:EnumDef (arena-alloc (sizeof EnumDef))))
          (dotimes (j n)
            (aset! (as ptr:ptr members) j
                   (intern-str ((unsafe/cast ptr:Node (node-at cc (+ j 2))) s))))
          (.set! ed name (as CStr (qualify-name (en s))))
          (.set! ed members members)
          (.set! ed num-members n)
          ; Stage 15 B5: the enum NAME's own provenance. Its members already
          ; carry `sym-private` on their Syms (the g-globals row).
          (.set! ed priv g-defining-private)
          (.set! ed src-ns g-current-ns)
          ; Stage 15 B4 (R4): the defining site — see `same-definition-site`.
          (.set! ed src-file g-source-path)
          (.set! ed src-line (cc line))
          (conj g-enumdefs ed))))))

(defn enumdef-lookup (name:CStr):?ptr:EnumDef
  (dotimes (i (count g-enumdefs))
    (let (ed:ptr:EnumDef (invoke g-enumdefs (as usize i)))
      (when (= (ed name) name)
        (return (as ptr ed)))))
  (return null))

; Stage 15 B3′: the reference resolver for the enum NAME (its members are
; ordinary `g-globals` entries and were cut over by B2b).
(defn enumdef-lookup-ref (spelling:CStr):?ptr:EnumDef
  (dotimes (i (name-ref-key-count spelling))
    (let (k:CStr (name-ref-key-at spelling i))
      (when (!= k null)
        (let (hit:?ptr:EnumDef (enumdef-lookup k))
          (when (!= hit null) (return hit))))))
  (let (al:ptr (binding-alias-find spelling BK-ENUM))
    (when (!= al null) (return (as ptr:EnumDef al))))
  (when (!= g-type-key-ok 0) (return (enumdef-lookup (intern-str spelling))))
  (return null))

(defn emit-defstruct (call:(raw Node)):void
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (< (node-len cc) 2) (die-at (cc line) "defstruct: missing name"))
    (let (name-node:ptr:Node (unsafe/cast ptr:Node (node-at cc 1)))
      ; W4b sibling sweep: a bare colon-typed name ("S:i32") used to sail past
      ; the `!= NODE-SYM` check below unchanged and register a StructDef under
      ; that literal spelling, which then failed downstream at
      ; check-ir-name-legal with a confusing "illegal character ':'" message
      ; reported at line 0 (S:i32 is an interned NODE-SYM, whose own `line` is
      ; always 0 — the W4a class of bug, resurfacing here because this specific
      ; failure mode wasn't among W4a's confirmed cases). Reject up front, at
      ; the defstruct line, before any of that.
      (reject-colon-in-def-name (as raw:Node name-node) "defstruct" (cc line))
      ; Stage 11: a parameterized head — `(defstruct (Vector T) ...)` — is a
      ; template; defines no type, emits no IR (parametric-structs.md §2). A use
      ; `(Vector i32)` in type position stamps a concrete instance.
      (when (= (name-node kind) NODE-CELL)
        (register-struct-template (as ptr cc))
        ; Stage 15 B5: `defstruct-`'s privacy for a template. The registration
        ; above is a no-op when prescan-struct-names already created the entry,
        ; and that prescan runs under the wrong namespace (see its note), so the
        ; provenance is written here, where `g-current-ns` is the defining file's.
        (when (!= g-defining-private 0)
          (let (base:(raw Node) (name-node car))
            (when (and (!= base null) (= ((unsafe/cast ptr:Node base) kind) NODE-SYM))
              (if-some (st (struct-template-lookup (qualify-name ((unsafe/cast ptr:Node base) s))))
                (do (.set! st priv 1)
                    (.set! st src-ns g-current-ns)
                    (set! g-priv-bindings 1))
                0))))
        (return))
      (when (!= (name-node kind) NODE-SYM)
        (die-at (name-node line) "defstruct: name must be symbol"))
      (guard-name-kind (name-node s) (cc line) NK-TYPE)
      ; Reuse a StructDef pre-registered by prescan-struct-names (name only), or
      ; register fresh.
      ; Stage 15 B3′: the definition side always holds a KEY — `qualify-name` of
      ; its own name — never a reference. Routing it through `struct-lookup-ref`
      ; would let a `defstruct Vector` inside `(ns coll)` find `user`'s `Vector`
      ; through the flattened-prelude fallback and then *fill in the prelude's
      ; StructDef*, which is the R1 collision reintroduced as memory corruption.
      (let (key:CStr (as CStr (qualify-name (name-node s))))
      ; Stage 15 B4 (R4): `emitted` is the tell that separates this defstruct's
      ; OWN name-only prescan entry from a second definition of the name — which
      ; is why §14.7 named this site. It used to be a silent `return`, so the
      ; first definition won and which one that was depended on import order.
      (let (existing:?ptr:StructDef (lookup-struct key))
        (when (and (!= existing null) (!= (existing emitted) 0))
          (when (= (same-definition-site (existing src-file) (existing src-line) (cc line)) 0)
            (die-redefinition (name-node s) (cc line) BK-STRUCT
                              (existing src-file) (existing src-line)))
          ; Same form re-emitted, or an interactive session: the pre-B4 no-op.
          (return)))
      (let (sd:ref:StructDef (if-some (e (lookup-struct key))
                               e
                               (register-struct key))
            nfields:i32 (- (node-len cc) 2))
        ; Stage 15 B5: `defstruct-`'s privacy. Set here as well as in
        ; prescan-struct-names because the prescan may have created the entry
        ; and `register-struct` deliberately does not read g-defining-private
        ; (it is also the anon/closure/cheader StructDef allocator).
        (when (!= g-defining-private 0)
          (.set! sd priv 1)
          (.set! sd src-ns g-current-ns)
          (set! g-priv-bindings 1))
        ; Stage 15 B4: `register-struct` mints anon/closure/dyn-box/C-header
        ; StructDefs too, so the SOURCE definition's location is recorded here,
        ; where there is one. It is what the redefinition diagnostic blames.
        (.set! sd src-file g-source-path)
        (.set! sd src-line (cc line))
        (check-ir-name-legal (name-node line) (name-node s) (sd ir-name))
        (let (fnm:ptr (arena-alloc (* (as i64 nfields) (ptr-bytes)))
              ftp:ptr (arena-alloc (* (as i64 nfields) (ptr-bytes))))
          (dotimes (i nfields)
            ; W5f: `field` may be NULL — an empty list `()` in the field list
            ; reads as a null node — so its line must come from the null-safe
            ; `node-line` (which also upgrades an interned symbol field's line-0
            ; to the defstruct's own line), never a raw `(field line)` deref.
            (let (field:ptr (node-at cc (+ i 2))
                            fname:ptr null
                            ; G-2: a defstruct field's type may be `(array T N)`
                            ; — the second (and, per the port's Major finding,
                            ; the load-bearing) storage position.
                            fty:ptr (extract-decl-name-and-type field (as ptr:ptr (addr-of fname))
                                                           (node-line field (cc line))))
              (when (= fty null)
                    (die-at (node-line field (cc line)) (fmt-s "defstruct: field '%s' missing :type" fname)))
              ; W3a: a by-value field of an opaque C type has no size, so the
              ; enclosing struct has no layout either. `ptr:Foo` is the fix.
              (reject-opaque-type fty
                (node-line (as ptr field) (cc line)) "defstruct field")
              ; W1d: a by-value field whose type the cycle has not laid out yet
              ; would give THIS struct a wrong size and wrong offsets.
              (reject-cycle-pending-layout fty
                (node-line (as ptr field) (cc line)) "defstruct field")
              (aset! (as ptr:ptr fnm) i (intern-str fname))
              (aset! (as ptr:ptr ftp) i fty)))
          (struct-set-fields sd fnm ftp nfields)
          (fprintf g-out "%%%s = type { " (sd ir-name))
          (dotimes (i nfields)
            (when (!= i 0) (fprintf g-out ", "))
            (fprintf g-out "%s" (type-to-ir (aref (as ptr:ptr ftp) i))))
          (fprintf g-out " }\n\n")
          (.set! sd emitted 1)))))))

; The synthesized constructor defn for one defunion arm (new-style signature):
;   (defn Shape-circle (r:f64) Shape (make Shape circle r))
; Built from the original arm AST so field type spellings round-trip exactly.
(defn union-ctor-form (uname:CStr arm:(raw Node) line:i32):ptr
  (let (an:ptr:Node (unsafe/cast ptr:Node arm)
        aname:ptr (if (= (an kind) NODE-SYM) (an s)
                    (-> an (node-at _ 0) (unsafe/cast ptr:Node _) (_ s)))
        fields:ptr (if (= (an kind) NODE-SYM) null (as ptr ((unsafe/cast ptr:Node arm) cdr)))
        name-node:ptr (intern-symbol (fmt-2s "%s-%s" uname aname)))
    ; (make uname aname f1 f2 ...) — args are the field names.
    (let (make-args:ptr null
          make-tail:ptr null
          fcur:ptr fields)
      (while (!= fcur null)
        (let (fname:ptr null
              tname:ptr null)
          (extract-name-type ((unsafe/cast ptr:Node fcur) car)
                             (as ptr:ptr (addr-of fname)) (as ptr:ptr (addr-of tname)))
          (let (cell:ptr (make-cell (as ptr (intern-symbol fname)) null line))
            (when (= make-args null) (set! make-args cell))
            (when (!= make-tail null) (.set! (unsafe/cast ptr:Node make-tail) cdr cell))
            (set! make-tail cell)))
        (set! fcur ((unsafe/cast ptr:Node fcur) cdr)))
      (let (body:ptr (make-cell (as ptr 'make)
                       (make-cell (as ptr (intern-symbol uname))
                         (make-cell (as ptr (intern-symbol aname)) make-args line)
                         line)
                       line)
            params:ptr null
            ptail:ptr null)
        ; Fresh param list re-using the arm's field spec nodes verbatim.
        (set! fcur fields)
        (while (!= fcur null)
          (let (cell:ptr (make-cell ((unsafe/cast ptr:Node fcur) car) null line))
            (when (= params null) (set! params cell))
            (when (!= ptail null) (.set! (unsafe/cast ptr:Node ptail) cdr cell))
            (set! ptail cell))
          (set! fcur ((unsafe/cast ptr:Node fcur) cdr)))
        ; An empty params list is null — node-is-list treats null as a list.
        ; New-style: the return operand (the union type name) sits between the
        ; params and the body.
        (return (make-cell (as ptr 'defn)
                  (make-cell name-node
                    (make-cell params
                      (make-cell (as ptr (intern-symbol uname))
                        (make-cell body null line)
                        line)
                      line)
                    line)
                  line))))))

; (defunion Name arms...) | (defunion (Name T ...) arms...) — register the
; tagged sum (or template) and emit the per-arm constructor functions
; (unions.md §3). Template instances get no constructors — `make` and target
; typing construct them — so stamping is collision-free across units.
(defn emit-defunion (call:(raw Node)):void
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (< (node-len cc) 3)
      (die-at (cc line) "defunion: expects a name and at least one arm"))
    (let (name-node:ptr:Node (unsafe/cast ptr:Node (node-at cc 1)))
      ; W4b sibling sweep: a bare colon-typed name ("U:i32") used to sail past
      ; the `!= NODE-SYM` check below unchanged and register the UnionDef
      ; under that literal, unlookupable key — the same defconst-shaped bug.
      (reject-colon-in-def-name (as raw:Node name-node) "defunion" (cc line))
      ; Parameterized head — a template; defines no type, emits no code.
      (when (= (name-node kind) NODE-CELL)
        (register-union-template (as ptr cc))
        ; Stage 15 B5: `defunion-`'s privacy for a template — see the identical
        ; note in emit-defstruct's template branch.
        (when (!= g-defining-private 0)
          (let (base:(raw Node) (name-node car))
            (when (and (!= base null) (= ((unsafe/cast ptr:Node base) kind) NODE-SYM))
              (if-some (ut (union-template-lookup (qualify-name ((unsafe/cast ptr:Node base) s))))
                (do (.set! ut priv 1)
                    (.set! ut src-ns g-current-ns)
                    (set! g-priv-bindings 1))
                0))))
        (return))
      (when (!= (name-node kind) NODE-SYM)
        (die-at (name-node line) "defunion: name must be a symbol"))
      ; Stage 15 B4 (R4): a second definition of the name, which used to be a
      ; silent no-op that kept the first. A `UnionDef` is created only by this
      ; definer — there is no name-only prescan entry to confuse it with, so mere
      ; existence is the tell (unlike `defstruct`, which needs `emitted`).
      ; Stage 15 B3′: a definition-side existence probe holds a KEY.
      (if-some (prev (uniondef-lookup (as CStr (qualify-name (name-node s)))))
        (do
          (when (= (same-definition-site (prev src-file) (prev src-line) (cc line)) 0)
            (die-redefinition (name-node s) (cc line) BK-UNION
                              (prev src-file) (prev src-line)))
          (return))
        0)
      (guard-name-kind (name-node s) (cc line) NK-TYPE)
      ; `defunion-register` is handed the canonical KEY (it registers the backing
      ; StructDef and the UnionDef under it); `union-ctor-form` below is handed the
      ; SOURCE spelling, because what it builds is source — a `(defn Shape-circle
      ; … Shape (make Shape circle …))` form re-parsed in this same file, where the
      ; bare name resolves.
      (let (repr-box:i32 REPR-AUTO
            ud:ref:UnionDef (defunion-register (as CStr (qualify-name (name-node s)))
                              (-> cc (_ cdr) (unsafe/cast ptr:Node _) (_ cdr)) (cc line))
            ; Strip &repr before generating constructors: it is a layout marker,
            ; not an arm (defunion-register strips it for layout independently).
            arms:ptr (defunion-strip-repr (-> cc (_ cdr) (unsafe/cast ptr:Node _) (_ cdr))
                       (as ptr:i32 (addr-of repr-box)) (cc line))
            saved-out:ptr g-out)
        ; Constructors are ordinary functions; their signatures were
        ; pre-registered by the prescan so earlier defns can call them.
        ; A niche layout (rules 2/3) still gets constructors — they build the
        ; niche encoding via `make`, which is layout-aware (no struct).
        (set! g-out g-def-stream)
        (let (cur:ptr arms)
          (while (!= cur null)
            (emit-defn (union-ctor-form (name-node s) ((unsafe/cast ptr:Node cur) car) (cc line)))
            (set! cur ((unsafe/cast ptr:Node cur) cdr))))
        (set! g-out saved-out)))))

(defn emit-extern (call:(raw Node)):void
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 2)
      (die-at (cc line) "extern: expects name:type"))
    (let (arg1:ptr (node-at cc 1)
          name:ptr null
          ty:ptr null)
      ; G-2: `--emit-nuch` exports an array-typed `defvar` as
      ; `(extern (g (array i32 3)))`, so this — the import side of that export —
      ; is a declaration position and grants the same permission emit-defvar
      ; does. Without it a library with an array global emits a header its own
      ; consumer cannot read.
      (set! ty (extract-decl-name-and-type arg1 (as ptr:ptr (addr-of name))
                                      ((unsafe/cast ptr:Node arg1) line)))
      (when (= ty null)
        (die-at ((unsafe/cast ptr:Node arg1) line)
          (fmt-s "extern: missing :type on '%s'" name)))
      (guard-name-kind name (cc line) NK-VALUE)
      ; Dedup: an `(extern X)` re-declared by a second imported library (e.g. two
      ; collection libs both declaring `stderr`) must emit `@X = external global`
      ; only once — LLVM rejects a duplicate global definition. A redeclaration of
      ; an already-bound extern is an idempotent no-op, so skip both the emission
      ; and the re-define. (Imports dedup whole files by path, but the same symbol
      ; declared in two different files still reaches here twice.)
      ; B2b: a KEY question, paired with the `scope-define` at the end of this
      ; function — not a reference this file wrote.
      (when (!= (scope-lookup-key g-globals name) null)
        (return))
      ; Stage 12 N6: a namespaced library's global re-resolves to its mangled link
      ; name. When this `extern` arrives from a `.nuch` whose leading `(ns NAME)`
      ; set g-current-ns, ns-ir-base composes the prefix (`g` → `geom__g`) — the
      ; same name emit-defvar produced. Identity under `user`, so a hand-written
      ; `(extern stderr)` and the bootstrap stay byte-identical.
      (let (ir-name:ptr (fmt-s "@%s" (ns-ir-base name)))
        (check-ir-name-legal (cc line) name ir-name)
        (fprintf g-out "%s = external global %s\n\n" ir-name (type-to-ir ty))
        (scope-define g-globals name ty ir-name 1)))))

; ============================================================
; C header handling — imported from src/cheader.nuc
; .nuch header emit/import — imported from src/nuch.nuc
; ============================================================

(import-use cheader)
(import-use nuch)

; Stage 15 W3c (cheader.md §1.4): settle the precedence between a C-header
; declaration and this unit's explicit `(declare …)` of the same function.
; Called from `c-parse-func-decl`, which has already decided to stand down.
;
; It lives HERE rather than in cheader.nuc for an ordering reason worth naming:
; cheader.nuc is imported one line above nuch.nuc, so at the moment its forms are
; emitted `emit-nuch-declare-import` does not yet exist as a name. This wrapper
; sits below both imports and can call it; cheader.nuc in turn reaches this
; function because `prescan-defn-signatures` registers every nucleusc.nuc
; signature before the first form of any import is emitted.
;
; The interesting half is the *early emission*. Simply dropping the header's
; declaration and waiting for the explicit one is wrong: everything between the
; import and the declare's own position would fail to resolve. (Measured —
; `examples/cstr-lit-test.nuc` declares `strlen` at line 15, and `lib/arena.nuc`
; calls it from inside the prelude import that precedes it, so suppression alone
; broke that build with `unknown: strlen`.) Emitting the explicit declaration at
; the point of first need keeps exactly one `declare` in the module, gives it the
; author's signature, and leaves the later `(declare …)` form an idempotent
; no-op — `emit-nuch-declare-import` already returns early for an
; already-registered name.
(defn cheader-yield-to-explicit-declare (fname:CStr hsig:ptr hline:i32):void
  (when (= (as ptr (cdecl-site-find g-cheader-shadowed fname)) null)
    (set! g-cheader-shadowed
          (cdecl-site-push g-cheader-shadowed (as ptr fname) g-cheader-file
                           hline hsig null)))
  (let (site:ptr (as ptr (cheader-explicit-declare-site fname)))
    (when (= site null) (return))
    ; B2b: "has the explicit declare been registered yet" — a KEY question.
    (if (= (scope-lookup-key g-globals fname) null)
      ; The explicit declare has not been reached yet — emit it now. It records
      ; its own signature on the site and raises the conflict warning itself.
      (emit-nuch-declare-import ((as ptr:CDeclSite site) form))
      ; Already emitted (it precedes this import), so its signature is on the
      ; site; compare here instead.
      (when (and (!= ((as ptr:CDeclSite site) sig) null)
                 (!= (as CStr ((as ptr:CDeclSite site) sig)) (as CStr hsig)))
        (cheader-warn-decl-conflict (as raw:CDeclSite site)
                                    (cdecl-site-find g-cheader-shadowed fname))))))

(import-use repl)

; ============================================================
; defn
; ============================================================

(defn emit-defn (call:(raw Node)):void
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
      ; S1: a bare-name (new-style) defn that stops before its return operand gets
      ; the targeted diagnostic from defn-signature.md — the same message a stale
      ; legacy spelling receives in Phase S4. Every other malformed shape (including
      ; a bodyless legacy `name:ret`) keeps the generic "bad form". Error-path only;
      ; no valid defn has < 4 elements, so bootstrap IR is unaffected.
      (when (< (node-len cc) 4)
        (if (and (>= (node-len cc) 2) (!= (sig-name-is-bare (node-at cc 1)) 0))
          (die-at (cc line)
            (fmt-2s "defn '%s': expected return type after the parameter list, e.g. (defn %s (params):i32 …)"
                    (-> (node-at cc 1) (unsafe/cast ptr:Node _) (_ s))
                    (-> (node-at cc 1) (unsafe/cast ptr:Node _) (_ s))))
          (die-at (cc line) "defn: bad form")))
    (let (name-node:ptr (node-at cc 1)
          params-node:ptr (node-at cc 2))
      (when (= (node-is-list params-node) 0)
        (die-at ((unsafe/cast ptr:Node name-node) line) "defn: params must be list"))
      ; A bounded-generic template — `&where` or a parametric-struct receiver —

      ; emits no code itself; it is registered in prescan and monomorphized per
      ; call site.
      (when (!= (defn-is-generic-template call) 0) (return))
      ; S1: route name/return/body-start through the central accessor. Legacy forms
      ; keep the exact extract-name-and-type parse (byte-identical); new-style forms
      ; parse the index-3 return operand with fn-parse-ret-type (the fn grammar).
      (let (fname:ptr null
            ret-node:ptr null
            sig-params:ptr null
            body-start:i32 3
            sig-style:i32 (defn-parse-sig call (as ptr:ptr (addr-of fname))
                            (as ptr:ptr (addr-of ret-node))
                            (as ptr:ptr (addr-of sig-params))
                            (as ptr:i32 (addr-of body-start)))
            ret:ptr (if (!= sig-style 0)
                      (fn-parse-ret-type ret-node (cc line))
                      (extract-name-and-type name-node (as ptr:ptr (addr-of fname))
                                             ((unsafe/cast ptr:Node name-node) line))))
        (when (= ret null)
          (die-at ((unsafe/cast ptr:Node name-node) line) (fmt-s "defn: missing :type on '%s'" fname)))
        ; W3a: a by-value return of an opaque C type has no ABI classification
        ; (no size, no layout) — refuse at the signature, where the line is exact,
        ; rather than at type-to-ir's ambient-line backstop.
        (reject-opaque-type ret (cc line) "defn return type")
        (reject-cycle-pending-layout ret (cc line) "defn return type")
        (guard-name-kind fname (cc line) NK-FUNCTION)
        ; L8: warn when a public defn's signature exposes a capturing-closure env
        ; type (__vfn_env_N) or a type-erased box type (BoxedFn/dyn) — it is
        ; excluded from --emit-cheader (see cheader-mentions-closure). Gated on
        ; public (defn-, not defn) and on a real top-level defn (g-mono-context is
        ; set only during the mono drain, which emits synthesized closure
        ; invoke/drop methods whose `self` param is (ref Env) — those are internal,
        ; not a public API surface). A plain fn pointer is C-ABI and does not
        ; trigger this.
        (when (and (= g-defining-private 0) (= g-mono-context null))
          (let (mc:i32 (cheader-mentions-closure
                         (if (!= sig-style 0)
                           ret-node
                           (extract-type-node name-node ((unsafe/cast ptr:Node name-node) line))))
                mcpi:i32 0
                mcp:i32 (node-len params-node))
            (while (< mcpi mcp)
              ; W5f: a parameter may be NULL (an empty list `()` reads as a null
              ; node) — `extract-type-node` tolerates that, but computing its line
              ; with a raw deref did not. `node-line` is the null-safe accessor.
              (when (!= (cheader-mentions-closure
                          (extract-type-node (node-at params-node mcpi)
                                             (node-line (node-at params-node mcpi) (cc line)))) 0)
                (set! mc 1))
              (inc! mcpi))
            (when (!= mc 0)
              (fprintf stderr "%s:%d: warning: %s\n" g-source-path (cc line)
                       (fmt-s "'%s' exposes a closure or type-erased box type and will be excluded from generated C headers" fname)))))
        ; Stage 10 Phase F1: an optional `noreturn` attribute keyword in
        ; body-position 0 (right after the params) marks the function as never
        ; returning — die-at, repl_throw and friends. It is stripped so the body
        ; proper starts at body-start; the flag drives the LLVM `noreturn`
        ; attribute on the define and is recorded on the function's Sym so a
        ; statement-position call terminates its block (terminate-after-noreturn).
        ; body-start is 3 (legacy) or 4 (new style) from defn-parse-sig above; an
        ; optional `noreturn` sits at body-start and shifts the real body one past.
        (let (is-noreturn:i32 0)
          (when (> (node-len cc) (+ body-start 1))
            (let (b0:ptr (node-at cc body-start))
              (when (and (!= b0 null)
                         (= (-> b0 (unsafe/cast ptr:Node _) (_ kind)) NODE-SYM)
                         (= (-> b0 (unsafe/cast ptr:Node _) (_ s)) "noreturn"))
                (set! is-noreturn 1)
                (set! body-start (+ body-start 1)))))
        (let (
              raw-nparams:i32 (node-len params-node)
              has-rest:i32 0
              rest-idx:i32 -1
              opt-idx:i32 -1
              nopt:i32 0)
          ; Scan for &rest and &optional. &rest must be second-to-last so the rest
          ; param itself is the trailing entry. &optional comes after all required
          ; params; everything after it (until end or &rest) is an optional spec.
          (dotimes (si raw-nparams)
            ; W5f: a parameter may be NULL — an empty list `()` in the parameter
            ; list reads as a null node. It is not an &rest/&optional marker;
            ; the param loop below raises the located diagnostic for it.
            (let (sp:(raw Node) (as raw:Node (node-at params-node si)))
              (when (and (!= sp null) (= (sp kind) NODE-SYM))
                    (when (= (sp s) "&rest")
                          (when (!= si (- raw-nparams 2))
                                (die-at (node-line (as ptr sp) (cc line)) "defn: &rest must be second-to-last param"))
                          (when (!= has-rest 0)
                                (die-at (node-line (as ptr sp) (cc line)) "defn: multiple &rest in params"))
                          (set! has-rest 1)
                          (set! rest-idx si))
                    (when (= (sp s) "&optional")
                          (when (!= opt-idx -1)
                                (die-at (node-line (as ptr sp) (cc line)) "defn: multiple &optional in params"))
                          (set! opt-idx si)))))
          (when (and (!= opt-idx -1) (!= has-rest 0))
            (die-at ((unsafe/cast ptr:Node (node-at params-node opt-idx)) line)
                    "defn: &optional cannot be combined with &rest"))
          (when (!= opt-idx -1)
            (when (= opt-idx (- raw-nparams 1))
              (die-at ((unsafe/cast ptr:Node (node-at params-node opt-idx)) line)
                      "defn: &optional must be followed by at least one param"))
            (set! nopt (- (- raw-nparams 1) opt-idx)))
          (let (nparams:i32 raw-nparams)
            (when (!= has-rest 0) (set! nparams (- nparams 1)))
            (when (!= opt-idx -1) (set! nparams (- nparams 1)))
            (let (param-types:ptr null
                  param-names:ptr null
                  opt-defaults:ptr null
                  required:i32 (- nparams nopt))
              (when (> nparams 0)
                  (set! param-types (arena-alloc (* (as i64 nparams) (ptr-bytes))))
                  (set! param-names (arena-alloc (* (as i64 nparams) (ptr-bytes)))))
              (when (> nopt 0)
                  (set! opt-defaults (arena-alloc (* (as i64 nopt) (ptr-bytes)))))
              (let (i:i32 0
                    di:i32 0)
                (while (< i raw-nparams)
                  (let (skip:i32 0)
                    (when (and (!= has-rest 0) (= i rest-idx)) (set! skip 1))
                    (when (= i opt-idx) (set! skip 1))
                    (when (= skip 0)
                      (let (p:ptr (node-at params-node i)
                            pname:ptr null
                            is-opt:i32 0
                            spec:ptr (node-at params-node i)
                            default-node:ptr null)
                        (when (and (!= opt-idx -1) (> i opt-idx)) (set! is-opt 1))
                        (when (!= is-opt 0)
                          ; Optional param: a 2-element list (name:type default).
                          (when (or (= (node-is-list p) 0) (!= (node-len p) 2))
                            (die-at (node-line p (cc line))
                              "defn: &optional param must be (name:type default)"))
                          (set! spec (node-at p 0))
                          (set! default-node (node-at p 1)))
                        ; W5f: `spec`/`p` may be NULL (an empty list `()` in the
                        ; parameter list reads as a null node), and a plain
                        ; `name:type` param is an interned symbol whose own line
                        ; is 0 — `node-line` handles both.
                        (let (pty:ptr (extract-name-and-type spec (as ptr:ptr (addr-of pname))
                                                             (node-line spec (cc line))))
                          (when (= pty null)
                            (die-at (node-line p (cc line)) (fmt-s "defn: missing :type on param '%s'" pname)))
                          ; W3a: a by-value parameter of an opaque C type cannot
                          ; be passed (no size, no ABI class).
                          (reject-opaque-type pty
                            (node-line (as ptr spec) (cc line)) "defn parameter")
                          (reject-cycle-pending-layout pty
                            (node-line (as ptr spec) (cc line)) "defn parameter")
                          ; The &rest parameter receives a Node* cons-list head.
                          ; The user's declared type annotates element type only;
                          ; the actual param is always ptr.
                          (when (and (!= has-rest 0) (= di (- nparams 1)))
                            (set! pty ty-ptr))
                          (aset! (as ptr:ptr param-types) di pty)
                          (aset! (as ptr:ptr param-names) di pname)
                          (when (!= is-opt 0)
                            (aset! (as ptr:ptr opt-defaults) (- di required) default-node))))
                      (inc! di)))
                  (inc! i)))
          ; Register function in globals
          (let (ft:ptr:Type (as ptr:Type (make-type TY-FN)))
            (.set! ft ret ret)
            (type-set-params ft param-types nparams)
            (.set! ft variadic 0)
            (.set! ft has-rest has-rest)
            (.set! ft nopt nopt)
            (.set! ft opt-defaults opt-defaults)
            ; Solitary names (and fallback defns with no registered generic) keep
            ; their scope binding under @name. Overloaded methods dispatch through
            ; the generic registry, so no bare-name binding is installed.
            (when (= (defn-is-mangled fname) 0)
              (check-ir-name-legal (cc line) fname (defn-ir-name fname param-types nparams))
              (let (fsym:ref:Sym (scope-define g-globals fname (as ptr ft)
                                  (defn-ir-name fname param-types nparams) 0))
                (when (!= is-noreturn 0) (.set! (unsafe/cast ptr:Sym fsym) noreturn 1))
                ; Stage 12 N3: mark private when defined via `defn-`.
                (when (!= g-defining-private 0) (.set! (unsafe/cast ptr:Sym fsym) sym-private 1)))))
          ; Codegen
          (reset-function-state)
          ; g-cur-fname is the @-less IR symbol of this function (for blockaddress
          ; in label-addr). defn-ir-name returns "@sym"; skip the leading '@'.
          (set! g-cur-fname (unsafe/ptr+ (as ptr:i8 (defn-ir-name fname param-types nparams))
                                  1))
          ; Aggregate return ABI (Stage 8 Phase C): drives the signature, the
          ; sret hidden param, and how `return` lowers a struct value.
          (set! g-fn-ret-abi (abi-classify ret))
          ; Stage 10: declared return type, for the pointer-kind check on
          ; `return` (a (ref T) return requires a ref value).
          (set! g-fn-ret-type ret)
          (when (= ((unsafe/cast ptr:AbiInfo g-fn-ret-abi) kind) ABI-MEMORY)
            (set! g-fn-sret-name "%.sret"))
          (let (fn-scope:ref:Scope (scope-new g-globals)
                i:i32 0)
            ; RV-6c: the prologue is one of the TWO independent walks over this
            ; signature (the `define`'s parameter list below is the other); each
            ; resets the riscv64 register budget for itself and they agree
            ; because they see the same types in the same order.
            (abi-args-begin (unsafe/cast raw:AbiInfo g-fn-ret-abi))
            (while (< i nparams)
              (abi-emit-param-prologue fn-scope
                (aref (as ptr:ptr param-names) i)
                (aref (as ptr:ptr param-types) i))
              (inc! i))
            (set! i body-start)
            ; Pre-scan the body for (label NAME) decls so forward gotos and
            ; last-decl-wins resolution work.
            (let (psi:i32 i)
              (while (< psi (node-len cc))
                (prescan-labels (node-at cc psi))
                (inc! psi)))
            (let (last-val:ptr:Val (alloc-val ty-void null))
              (while (< i (node-len cc))
                ; The tail expression is an implicit return — apply the same
                ; defunion target typing as an explicit (return ...).
                (let (bf:ptr (node-at cc i)
                      is-tail:i32 (if (= i (- (node-len cc) 1)) 1 0))
                  (when (!= is-tail 0)
                    (set! bf (union-target-rewrite bf g-fn-ret-type)))
                  ; TC-2: the tail expression is an implicit return — arm the want
                  ; channel with g-fn-ret-type so a returned generic constructor
                  ; infers a return-only tyvar (g-fn-ret-type doubles as the want,
                  ; same as explicit return). Non-tail body forms are statement
                  ; positions and stay want-free here.
                  (let (save-want:ptr g-want-type)
                    (when (!= is-tail 0) (set! g-want-type g-fn-ret-type))
                    (let (lv:ref:Val (emit-node bf fn-scope))
                      (set! g-want-type save-want)
                      (set! last-val lv))))
                (inc! i))
              ; Fire function-scope (defer …) cleanups on the implicit-return
              ; fall-off path (explicit returns walk the scope chain instead).
              (emit-scope-cleanups fn-scope)
              (when (= g-block-term 0)
                ; Stage 10: the implicit return is a return — same escape sink
                ; as the explicit one (the (ref T) kind check runs inside
                ; coerce-int-val below).
                (when (!= ((as ptr:Val last-val) taint) null)
                  (die-at (cc line)
                    "resource bound by `with` escapes via implicit return — use (move ...) to transfer ownership"))
                (if (!= ((unsafe/cast ptr:AbiInfo g-fn-ret-abi) kind) ABI-DIRECT)
                  ; Struct return via the aggregate ABI. A void last expression
                  ; (degenerate fall-off) returns a zeroed struct.
                  (emit-struct-ret
                    (if (= ((unsafe/cast ptr:Type ((as ptr:Val last-val) type)) kind) TY-VOID)
                      (alloc-val ret "zeroinitializer")
                      last-val))
                (if (= ((as ptr:Type ret) kind) TY-VOID)
                  (fprintf g-body-stream "  ret void\n")
                  ; Implicit return: if the last expression yielded a value
                  ; matching the declared return type, return it. If the last
                  ; expression was void (e.g., a side-effect or a no-return
                  ; call like die-at the compiler can't recognize), fall back
                  ; to a zero/null return so the function has a well-typed
                  ; terminator.
                  (if (= ((unsafe/cast ptr:Type ((as ptr:Val last-val) type)) kind) TY-VOID)
                    (let (zero:ptr "0")
                      (when (!= (is-ptr-like ret) 0) (set! zero "null"))
                      (fprintf g-body-stream "  ret %s %s\n" (type-to-ir ret) zero))
                    (let (coerced:ptr (coerce-int-val last-val ret (cc line)))
                      (when (= coerced null)
                        (die-at (cc line)
                          (fmt-s "%s: implicit return type mismatch — last expression does not match declared return type"
                                 fname)))
                      (let (cv:ptr:Val (unsafe/cast ptr:Val coerced))
                        (fprintf g-body-stream "  ret %s %s\n"
                          (type-to-ir ret) (cv val)))))))))
            ; Close streams and emit function
            (fclose g-entry-stream)
            (fclose g-body-stream)
            ; Stage 12 N3: private defn emits `internal` LLVM linkage.
            (if (!= g-defining-private 0)
              (fprintf g-out "define internal %s %s("
                (abi-ret-ir g-fn-ret-abi ret) (defn-ir-name fname param-types nparams))
              (fprintf g-out "define %s %s("
                (abi-ret-ir g-fn-ret-abi ret) (defn-ir-name fname param-types nparams)))
            ; Record so a macro/CT JIT module can re-declare it (the define lives
            ; only here in the program module). param-types/nparams are exactly
            ; the signature emitted above (rest param already folded to ptr).
            (program-defn-record (defn-ir-name fname param-types nparams)
                                 ret param-types nparams 0)
            ; A MEMORY return prepends the hidden sret pointer parameter.
            (let (need-comma:i32 0)
              (when (= ((unsafe/cast ptr:AbiInfo g-fn-ret-abi) kind) ABI-MEMORY)
                (fprintf g-out "ptr sret(%s) align %d %s"
                  (type-to-ir ret) ((unsafe/cast ptr:AbiInfo g-fn-ret-abi) align) g-fn-sret-name)
                (set! need-comma 1))
              ; RV-6c: the second walk over this signature (see the prologue
              ; loop above) — reset the riscv64 register budget for it.
              (abi-args-begin (unsafe/cast raw:AbiInfo g-fn-ret-abi))
              (set! i 0)
              (while (< i nparams)
                (when (!= need-comma 0) (fprintf g-out ", "))
                (abi-print-param
                  (abi-classify-arg (aref (as ptr:ptr param-types) i))
                  (aref (as ptr:ptr param-types) i)
                  (aref (as ptr:ptr param-names) i))
                (set! need-comma 1)
                (inc! i)))
            ; Stage 10 Phase F1: the LLVM `noreturn` function attribute lets the
            ; optimizer and verifier know control never returns from this define.
            ; Stage 14 AVR-5: emit-fn-attrs-for then appends any string function
            ; attributes registered by `(fn-attr fname …)` (e.g. AVR "signal"/
            ; "interrupt" ISR attributes). Split into pieces so both a keyword attr
            ; (noreturn) and string attrs can coexist on one `define` line; with no
            ; fn-attr entries the emitted bytes are exactly the historical
            ; `") noreturn {\n"` / `") {\n"` (byte-identical for existing programs).
            (fprintf g-out ")")
            (when (!= is-noreturn 0) (fprintf g-out " noreturn"))
            (emit-fn-attrs-for fname)
            (fprintf g-out " {\n")
            (fprintf g-out "entry:\n")
            (when (and (!= g-entry-bufp null) (!= (char-at g-entry-bufp 0) 0))
              (fputs g-entry-bufp g-out))
            (when (and (!= g-body-bufp null) (!= (char-at g-body-bufp 0) 0))
              (fputs g-body-bufp g-out))
            (fprintf g-out "}\n\n")
            (free g-entry-bufp)
            (free g-body-bufp)
            (set! g-entry-bufp null)
            (set! g-body-bufp null))))))))))

; ============================================================
; Compile-time JIT helpers
; ============================================================

(defn jit-ensure-init (line:i32):void
  (when (!= g-jit null) (return))
  ; Backends are already registered process-wide by targets-init-all (called from
  ; target-init, which runs before any JIT use on every path —
  ; batch CT-JIT via emit-toplevel-forms, and the REPL via repl-main
  ; before repl-preload-macros), so no per-call native-target init is needed here.
  ; Create LLJIT
  (let (jit-ref:ptr null
        err:ptr (LLVMOrcCreateLLJIT (addr-of jit-ref) null))
    (when (!= err null)
       (fprintf stderr "%s:%d: JIT error in LLVMOrcCreateLLJIT: %s\n"
                   g-source-path line (LLVMGetErrorMessage err))
          (when (!= g-interactive 0) (repl_throw))
          (exit 1))
    (set! g-jit jit-ref))
  (set! g-jit-dylib (LLVMOrcLLJITGetMainJITDylib g-jit))
  ; Expose host process symbols so CT code can call printf, malloc, etc.
  (let (prefix:i8 (LLVMOrcLLJITGetGlobalPrefix g-jit)
        gen:ptr null
        err:ptr (LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess
                   (addr-of gen) prefix null null))
    (when (!= err null)
       (fprintf stderr "%s:%d: JIT error in CreateDynLibSearchGen: %s\n"
                   g-source-path line (LLVMGetErrorMessage err))
          (when (!= g-interactive 0) (repl_throw))
          (exit 1))
    (LLVMOrcJITDylibAddGenerator g-jit-dylib gen)))

(defn jit-add-module (ir:ptr line:i32):void
  (jit-add-module-rt ir line null))

; Add a module to the JIT, optionally under a resource tracker. Pass rt=null to
; add to the main JITDylib without a tracker (used by compile-time and macro JIT).
; Pass a tracker to add under it so the module's symbols can be removed later
; via LLVMOrcResourceTrackerRemove (used by the REPL for redefinition).
(defn jit-add-module-rt (ir:ptr line:i32 rt:ptr):void
  (jit-ensure-init line)
  ; LLVMOrcThreadSafeContextGetContext was removed in LLVM 20+. Create the
  ; parsing context directly. tsctx is only used for ThreadSafeModule locking
  ; which is irrelevant in single-threaded compilation. ctx leaks (fine).
  (let (ctx:ptr (LLVMContextCreate)
        ir-len:i64 (as i64 (strlen ir))
        mb:ptr (LLVMCreateMemoryBufferWithMemoryRangeCopy ir ir-len "<compile-time>")
        mod:ptr null
        errmsg:ptr null
        parse-err:i32 (LLVMParseIRInContext ctx mb (addr-of mod) (addr-of errmsg)))
    (when (!= parse-err 0)
       (fprintf stderr "%s:%d: compile-time: IR parse error: %s\n"
                   g-source-path line errmsg)
          (when (!= g-interactive 0) (repl_throw))
          (exit 1))
    (let (tsctx:ptr (LLVMOrcCreateNewThreadSafeContext)
          tsmod:ptr (LLVMOrcCreateNewThreadSafeModule mod tsctx)
          err:ptr null)
      (LLVMOrcDisposeThreadSafeContext tsctx)
      (if (= rt null)
        (set! err (LLVMOrcLLJITAddLLVMIRModule g-jit g-jit-dylib tsmod))
        (set! err (LLVMOrcLLJITAddLLVMIRModuleWithRT g-jit rt tsmod)))
      (when (!= err null)
         (fprintf stderr "%s:%d: JIT error in AddLLVMIRModule: %s\n"
                     g-source-path line (LLVMGetErrorMessage err))
            (when (!= g-interactive 0) (repl_throw))
            (exit 1)))))

(defn jit-call-ct-main-sym (line:i32 sym:ptr):void
  (let (addr:i64 0)
    (let (err:ptr (LLVMOrcLLJITLookup g-jit (as ptr (addr-of addr)) sym))
      (when (!= err null)
         (LLVMConsumeError err) (return))
      (when (= addr 0) (return))
      ; Redirect stdout -> stderr so CT printf does not corrupt the IR output
      (fflush (as ptr stdout))
      (let (saved-fd:i32 (dup 1))
        (dup2 2 1)
        (funcall-void (unsafe/cast ptr addr))
        (fflush (as ptr stdout))
        (dup2 saved-fd 1)
        (close saved-fd)))))

; ============================================================
; compile-time special form
; ============================================================

(defn emit-compile-time (form:(raw Node)):void
  ; (compile-time body-form...)
  (let (nforms:i32 (node-len (unsafe/cast ptr:Node form))
        ff:ptr:Node   (unsafe/cast ptr:Node form))
    (when (< nforms 2)
      (die-at (ff line) "compile-time: expected at least one body form"))

    ; Flush the main streams so g-type-bufp / g-decl-bufp are current.
    (drain-pending-union-irs)
    (fflush g-type-stream)
    (fflush g-decl-stream)

    ; Open fresh CT streams.
    (let (ct-type-bufp:ptr null
          ct-type-sizep:i64 0
          ct-decl-bufp:ptr null
          ct-decl-sizep:i64 0
          ct-def-bufp:ptr null
          ct-def-sizep:i64 0
          ct-type:ptr (open_memstream (addr-of ct-type-bufp) (as ptr (addr-of ct-type-sizep)))
          ct-decl:ptr (open_memstream (addr-of ct-decl-bufp) (as ptr (addr-of ct-decl-sizep)))
          ct-def:ptr  (open_memstream (addr-of ct-def-bufp)  (as ptr (addr-of ct-def-sizep))))

      ; Redirect global state to CT streams.
      (let (saved-g-out:ptr g-out
            saved-decl-out:ptr g-decl-out
            saved-qq-used:i32 g-qq-used)
        (set! g-qq-used 0)
        (set! g-decl-out ct-decl)
        ; Fresh per-module declare set (see emit-defmacro / macro-jit-ensure-decl).
        (set! g-macro-decls (unsafe/cast (ref (Vector CStr)) (vector-new-in (addr-of g-arena-alloc))))

        ; Pre-scan: register defn signatures from CT body.
        (let (bi:i32 1)
          (while (< bi nforms)
            (let (bf:ptr:Node (unsafe/cast ptr:Node (node-at ff bi)))
              (when (and (!= (as ptr bf) null)
                         (= (bf kind) NODE-CELL)
                         (>= (node-len bf) 4)
                         (-> bf (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind) (= _ NODE-SYM))
                         (-> bf (node-at _ 0) (unsafe/cast ptr:Node _) (_ s) (= _ "defn")))
                (let (name-node:ptr (node-at bf 1)
                      params-node:ptr (node-at bf 2))
                  (when (!= (node-is-list params-node) 0)
                    (let (fname:ptr null
                          ct-ret-node:ptr null
                          ct-params:ptr null
                          ct-bstart:i32 3
                          ct-style:i32 (defn-parse-sig (as ptr bf) (as ptr:ptr (addr-of fname))
                                         (as ptr:ptr (addr-of ct-ret-node))
                                         (as ptr:ptr (addr-of ct-params))
                                         (as ptr:i32 (addr-of ct-bstart)))
                          ret:ptr (if (!= ct-style 0)
                                    (fn-parse-ret-type ct-ret-node ((unsafe/cast ptr:Node name-node) line))
                                    (extract-name-and-type name-node (as ptr:ptr (addr-of fname))
                                                            ((unsafe/cast ptr:Node name-node) line))))
                      (when (!= ret null)
                        (let (nparams:i32 (node-len params-node)
                              ptypes:ptr null)
                          (when (> nparams 0)
                            (set! ptypes (arena-alloc (* (as i64 nparams) (ptr-bytes)))))
                          (let (j:i32 0)
                            (while (< j nparams)
                              (let (p:ptr (node-at params-node j)
                                    pn:ptr null
                                    pty:ptr (extract-name-and-type p (as ptr:ptr (addr-of pn))
                                                                    ((unsafe/cast ptr:Node p) line)))
                                (if (!= pty null)
                                  (aset! (as ptr:ptr ptypes) j pty)
                                  (aset! (as ptr:ptr ptypes) j ty-i32)))
                              (inc! j)))
                          (let (ft:ptr:Type (as ptr:Type (make-type TY-FN)))
                            (.set! ft ret ret)
                            (type-set-params ft ptypes nparams)
                            (scope-define g-globals fname (as ptr ft)
                                          (fmt-s "@%s" fname) 0)))))))))
            (inc! bi)))

        ; Collect expression forms (non-top-level) for __compile_time_main.
        (let (expr-forms:ptr (arena-alloc (* (as i64 256) (ptr-bytes)))
              nexpr:i32 0
              bi:i32 1)
          (while (< bi nforms)
            (let (bf:ptr:Node (unsafe/cast ptr:Node (node-at ff bi))
                  is-tl:i32 0)
              (when (and (!= (as ptr bf) null)
                          (= (bf kind) NODE-CELL)
                          (!= (node-len bf) 0)
                          (-> bf (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind) (= _ NODE-SYM)))
                (let (bh:ptr (-> bf (node-at _ 0) (unsafe/cast ptr:Node _) (_ s)))
                  (when (= bh "defstruct")
                     (set! is-tl 1) (set! g-out ct-type) (emit-defstruct (as ptr bf)))
                  (when (= bh "defconst")
                     (set! is-tl 1) (emit-defconst (as ptr bf)))
                  (when (= bh "defenum")
                     (set! is-tl 1) (emit-defenum (as ptr bf)))
                  (when (= bh "defvar")
                     (set! is-tl 1) (set! g-out ct-decl) (emit-defvar (as ptr bf)))
                  (when (= bh "extern")
                     (set! is-tl 1) (set! g-out ct-decl) (emit-extern (as ptr bf)))
                  (when (= bh "defn")
                     (set! is-tl 1) (set! g-out ct-def) (emit-defn (as ptr bf)))))
              (when (and (= is-tl 0) (< nexpr 256))
                 (aset! (as ptr:ptr expr-forms) nexpr (as ptr bf))
                    (inc! nexpr)))
            (inc! bi))

          ; Emit unique @__compile_time_main_N wrapping the expression forms.
          (let (ct-sym:ptr (fmt-i64 "__compile_time_main_%ld" (as i64 g-ct-id)))
          (inc! g-ct-id)
          (set! g-out ct-def)
          (reset-function-state)
          (let (fn-scope:ref:Scope (scope-new g-globals))
            (dotimes (ei nexpr)
              (emit-node (aref (as ptr:ptr expr-forms) ei) fn-scope)))
          (when (= g-block-term 0)
            (fprintf g-body-stream "  ret void\n"))
          ; Flush streams so bufp pointers are populated
          (fclose g-entry-stream)
          (fclose g-body-stream)
          (fprintf ct-def "define void @%s() {\n" ct-sym)
          (fprintf ct-def "entry:\n")
          (when (and (!= g-entry-bufp null) (!= (char-at g-entry-bufp 0) 0))
            (fputs g-entry-bufp ct-def))
          (when (and (!= g-body-bufp null) (!= (char-at g-body-bufp 0) 0))
            (fputs g-body-bufp ct-def))
          (fprintf ct-def "}\n\n")
          (free g-entry-bufp)
          (free g-body-bufp)
          (set! g-entry-bufp null)
          (set! g-body-bufp null)

          (let (ct-qq:i32 g-qq-used)
            ; Restore global state.
            (set! g-out saved-g-out)
            (set! g-decl-out saved-decl-out)
            (set! g-qq-used saved-qq-used)

            ; If CT used quasiquote, add private helpers and declare the
            ; host-defined helpers (alloc-node, make-cell, intern-symbol).
            (when (!= ct-qq 0)
               (fprintf ct-decl "declare ptr @malloc(i64)\n")
                  (fprintf ct-decl "declare ptr @alloc-node()\n")
                  (fprintf ct-decl "declare ptr @make-cell(ptr, ptr, i32)\n")
                  (fprintf ct-decl "declare ptr @intern-symbol(ptr)\n")
                  (fprintf ct-def "define private ptr @__cons(ptr %%a, ptr %%b) {\n")
                  (fprintf ct-def "  %%c = call ptr @malloc(i64 40)\n")
                  (fprintf ct-def "  %%p0 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%c, i32 0, i32 0\n")
                  (fprintf ct-def "  store i32 3, ptr %%p0, align 8\n")
                  (fprintf ct-def "  %%p4 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%c, i32 0, i32 4\n")
                  (fprintf ct-def "  store ptr %%a, ptr %%p4, align 8\n")
                  (fprintf ct-def "  %%p5 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%c, i32 0, i32 5\n")
                  (fprintf ct-def "  store ptr %%b, ptr %%p5, align 8\n")
                  (fprintf ct-def "  ret ptr %%c\n")
                  (fprintf ct-def "}\n\n")
                  (fprintf ct-def "define private ptr @__append(ptr %%a, ptr %%b) {\n")
                  (fprintf ct-def "entry:\n")
                  (fprintf ct-def "  %%z = icmp eq ptr %%a, null\n")
                  (fprintf ct-def "  br i1 %%z, label %%nil, label %%rec\n")
                  (fprintf ct-def "nil:\n")
                  (fprintf ct-def "  ret ptr %%b\n")
                  (fprintf ct-def "rec:\n")
                  (fprintf ct-def "  %%p4 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%a, i32 0, i32 4\n")
                  (fprintf ct-def "  %%car = load ptr, ptr %%p4, align 8\n")
                  (fprintf ct-def "  %%p5 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%a, i32 0, i32 5\n")
                  (fprintf ct-def "  %%cdr = load ptr, ptr %%p5, align 8\n")
                  (fprintf ct-def "  %%rest = call ptr @__append(ptr %%cdr, ptr %%b)\n")
                  (fprintf ct-def "  %%c = call ptr @__cons(ptr %%car, ptr %%rest)\n")
                  (fprintf ct-def "  ret ptr %%c\n")
                  (fprintf ct-def "}\n\n"))

            (fclose ct-type)
            (fclose ct-decl)
            (fclose ct-def)

            ; Assemble full CT module IR in a memstream.
            (let (ir-bufp:ptr null  ir-sizep:i64 0
                  irs:ptr (open_memstream (addr-of ir-bufp) (as ptr (addr-of ir-sizep))))
              (fprintf irs "; ModuleID = '<compile-time>'\n")
              (fprintf irs "target triple = \"%s\"\n\n" ((as ptr:Target g-host-target) triple))
              ; In REPL mode, include the accumulated preamble
              (when (!= g-interactive 0)
                 (fflush g-repl-preamble)
                    (when (and (!= g-repl-preamble-bufp null)
                               (!= (char-at g-repl-preamble-bufp 0) 0))
                      (fputs g-repl-preamble-bufp irs)))
              ; Type defs: main-so-far + CT-specific
              (when (and (!= g-type-bufp null) (!= (char-at g-type-bufp 0) 0))
                (fputs g-type-bufp irs))
              (when (and (!= ct-type-bufp null) (!= (char-at ct-type-bufp 0) 0))
                (fputs ct-type-bufp irs))
              ; String constants (shared)
              (emit-string-table irs)
              ; Declarations: main-so-far + CT-specific
              (when (and (!= g-decl-bufp null) (!= (char-at g-decl-bufp 0) 0))
                (fputs g-decl-bufp irs))
              (when (and (!= ct-decl-bufp null) (!= (char-at ct-decl-bufp 0) 0))
                (fputs ct-decl-bufp irs))
              ; Definitions from CT body + @__compile_time_main
              (when (and (!= ct-def-bufp null) (!= (char-at ct-def-bufp 0) 0))
                (fputs ct-def-bufp irs))
              (fclose irs)

              (jit-add-module ir-bufp (ff line))
              (jit-call-ct-main-sym (ff line) ct-sym)

              (free ct-type-bufp)
              (free ct-decl-bufp)
              (free ct-def-bufp)
              (free ir-bufp)))))))))

; ============================================================
; defmacro top-level form
; ============================================================

(defn emit-defmacro (form:(raw Node)):void
  ; (defmacro name (params...) body...)
  (let (ff:ptr:Node (unsafe/cast ptr:Node form))
    (when (< (node-len ff) 4)
      (die-at (ff line) "defmacro: expects name, params, and body"))
    (let (name-node:ptr:Node (unsafe/cast ptr:Node (node-at ff 1))
          params-node:ptr (node-at ff 2))
      ; W4b sibling sweep: a bare colon-typed name ("m:i32") used to sail past
      ; the `!= NODE-SYM` check below unchanged and register the macro under
      ; that literal, unlookupable key — the same defconst-shaped bug (the
      ; call site then failed as an ordinary "unknown: m" at the use, with no
      ; diagnostic at the definition).
      (reject-colon-in-def-name (as raw:Node name-node) "defmacro" (ff line))
      (when (!= (name-node kind) NODE-SYM)
        (die-at (name-node line) "defmacro: name must be symbol"))
      (when (= (node-is-list params-node) 0)
        (die-at (name-node line) "defmacro: params must be a list"))
      (guard-name-kind (name-node s) (ff line) NK-MACRO)
      ; Stage 15 B4 (R4): a second `defmacro` of one name used to append a second
      ; MacroDef that `find-macro`'s first-match scan could never reach — the
      ; first definition won, silently.
      ; Stage 15 B7: the probe is the KEY lookup, not the reference resolver —
      ; this asks about the key `defmacro` is about to write. Routing it through
      ; `find-macro` would consult the flattened-namespace walk and report an
      ; unrelated namespace's macro as a redefinition of this one.
      (if-some (prevm (find-macro-exact (as CStr (qualify-name (name-node s)))))
        (when (= (same-definition-site (prevm src-file) (prevm src-line) (ff line)) 0)
          (die-redefinition (name-node s) (ff line) BK-MACRO
                            (prevm src-file) (prevm src-line)))
        0)
      (let (macro-name:ptr (name-node s)
            ; Stage 15 B7: the registry KEY is namespace-qualified, exactly as
            ; every other kind's is (identity under `user`, so the tree is
            ; unaffected). The BARE name still feeds `jit-name` below.
            macro-key:CStr (as CStr (qualify-name (name-node s)))
            num-params:i32 (node-len params-node)
            ; Stage 15 B7: deliberately the BARE name, not the key. A `jit-name`
            ; is a private JIT symbol already made unique by its `_%d` counter,
            ; so it never needs to encode a namespace — which means B3′ step 2's
            ; `ns-ir-prefix`/`ir-name-token` composition is not wanted here, and
            ; `sanitize-for-ir` keeps seeing a spelling with no `/` in it. (§9.7
            ; predicted this would need the composition; measured, it does not.)
            jit-name:ptr (fmt-sd "__macro_%s_%d" (sanitize-for-ir macro-name) (unsafe/cast i32 (count g-macros))))
        ; Detect &rest variadic parameter (must be second-to-last in param list).
        (let (variadic:i32 0
              pcount:i32 num-params)
          (dotimes (vi num-params)
            ; W5f: a NULL (empty-list `()`) param is not `&rest`; the loop below
            ; raises the located "param must be a symbol" diagnostic for it.
            (let (vp:(raw Node) (as raw:Node (node-at params-node vi)))
              (when (and (!= vp null) (= (vp s) "&rest"))
                    (when (!= vi (- num-params 2))
                          (die-at (node-line (as ptr vp) (ff line)) "defmacro: &rest must be second-to-last param"))
                    (set! variadic 1)
                    (set! pcount (- num-params 1)))))
        ; Collect param names, skipping &rest keyword.
        (let (pnames:ptr null
              pi:i32 0
              ai:i32 0)
          (when (> pcount 0)
            (set! pnames (arena-alloc (* (as i64 pcount) (ptr-bytes)))))
          (while (< pi num-params)
            (let (p:(raw Node) (as raw:Node (node-at params-node pi)))
              ; W5f: `()` reads as a NULL node — same user error as a non-symbol
              ; param, reported at the defmacro's line (a null node has none).
              (when (= p null)
                (die-at (ff line) "defmacro: param must be a symbol"))
              (when (!= (p kind) NODE-SYM)
                (die-at (node-line (as ptr p) (ff line)) "defmacro: param must be a symbol"))
              (when (!= (p s) "&rest")
                  (aset! (as ptr:ptr pnames) ai (p s))
                  (inc! ai)))
            (inc! pi))
          ; Register in macro table
          (when (>= (unsafe/cast i32 (count g-macros)) 256)
            (die-at (ff line) "defmacro: macro table full"))
          (let (mdef:ptr:MacroDef (as ptr:MacroDef (arena-alloc (sizeof MacroDef))))
            (.set! mdef name (as ptr macro-key))
            (.set! mdef jit-name jit-name)
            (.set! mdef num-params pcount)
            (.set! mdef variadic variadic)
            ; Stage 15 B5: `defmacro-`'s privacy (§13.2 — nothing enforced it
            ; before, because a macro has no Sym and Sym is where privacy lived).
            (.set! mdef priv g-defining-private)
            (.set! mdef src-ns g-current-ns)
            ; Stage 15 B4 (R4): the fields existed and nothing wrote them — see
            ; `same-definition-site`.
            (.set! mdef src-file g-source-path)
            (.set! mdef src-line (ff line))
            (when (!= g-defining-private 0) (set! g-priv-bindings 1))
            (conj g-macros mdef))

          ; Flush main streams
          (fflush g-type-stream)
          (fflush g-decl-stream)

          ; Open fresh CT streams
          (let (ct-decl-bufp:ptr null  ct-decl-sizep:i64 0
                ct-def-bufp:ptr null   ct-def-sizep:i64  0
                ct-decl:ptr (open_memstream (addr-of ct-decl-bufp) (as ptr (addr-of ct-decl-sizep)))
                ct-def:ptr  (open_memstream (addr-of ct-def-bufp)  (as ptr (addr-of ct-def-sizep))))

            ; Redirect global state
            (let (saved-g-out:ptr g-out
                  saved-decl-out:ptr g-decl-out
                  saved-qq-used:i32 g-qq-used)
              (set! g-qq-used 0)
              (set! g-decl-out ct-decl)
              (set! g-out ct-def)
              ; Fresh per-module declare set: macro bodies that call ordinary
              ; defns (node-at, intern-symbol, ...) get those declared here.
              (set! g-macro-decls (unsafe/cast (ref (Vector CStr)) (vector-new-in (addr-of g-arena-alloc))))

              ; Set up function codegen state
              (reset-function-state)
              (let (fn-scope:ref:Scope (scope-new g-globals))

                ; Entry prologue: alloca for args pointer, then load each param
                (fprintf g-entry-stream "  %%__args.addr = alloca ptr, align 8\n")
                (fprintf g-entry-stream "  store ptr %%__args.arg, ptr %%__args.addr, align 8\n")
                ; Macro params are Node* — type them (raw Node) so bodies can
                ; access (p car)/(p cdr) without (cast ptr:Node …). raw (PTR-RAW)
                ; keeps them null-tolerant and deref-allowed; the IR is still
                ; `ptr`, so codegen is unchanged.
                (let (raw-node-ty:ref:Type (make-type TY-PTR))
                  (.set! raw-node-ty elem (parse-type-name "Node" 0))
                  (.set! raw-node-ty pkind PTR-RAW)
                  (dotimes (ei pcount)
                    (let (pname:ptr (aref (as ptr:ptr pnames) ei))
                      (fprintf g-entry-stream "  %%%s.addr = alloca ptr, align 8\n" pname)
                      (fprintf g-entry-stream "  %%__ap%d = load ptr, ptr %%__args.addr, align 8\n" ei)
                      (fprintf g-entry-stream "  %%__ag%d = getelementptr ptr, ptr %%__ap%d, i32 %d\n" ei ei ei)
                      (fprintf g-entry-stream "  %%__av%d = load ptr, ptr %%__ag%d, align 8\n" ei ei)
                      (fprintf g-entry-stream "  store ptr %%__av%d, ptr %%%s.addr, align 8\n" ei pname)
                      (scope-define fn-scope
                                    pname
                                    (as ptr raw-node-ty)
                                    (fmt-s "%%%s.addr" pname) 1))))

                ; Compile body forms; last result is return value
                (let (last-val:ptr "null"
                      bi:i32 3)
                  (while (< bi (node-len ff))
                    (let (bv:ref:Val (emit-node (node-at ff bi) fn-scope))
                      (when (and (!= (as ptr bv) null)
                                 (!= (bv val) null)
                                 (-> bv (_ type) (unsafe/cast ptr:Type _) (_ kind) (= _ TY-PTR)))
                        (set! last-val (bv val))))
                    (inc! bi))
                  (fprintf g-body-stream "  ret ptr %s\n" last-val))

                (let (macro-qq:i32 g-qq-used)
                  ; Restore global state
                  (set! g-out saved-g-out)
                  (set! g-decl-out saved-decl-out)
                  (set! g-qq-used saved-qq-used)

                  ; Finalize the function
                  (fclose g-entry-stream)
                  (fclose g-body-stream)
                  (fprintf ct-def "define ptr @%s(ptr %%__args.arg) {\n" jit-name)
                  (fprintf ct-def "entry:\n")
                  (when (and (!= g-entry-bufp null) (!= (char-at g-entry-bufp 0) 0))
                    (fputs g-entry-bufp ct-def))
                  (when (and (!= g-body-bufp null) (!= (char-at g-body-bufp 0) 0))
                    (fputs g-body-bufp ct-def))
                  (fprintf ct-def "}\n\n")
                  (free g-entry-bufp)
                  (free g-body-bufp)
                  (set! g-entry-bufp null)
                  (set! g-body-bufp null)

                  ; Add QQ helpers if needed.
                  ; Only emit malloc declaration if it's not already in g-decl-bufp
                  ; (e.g. from an earlier (import-use "stdlib.h")).
                  (when (!= macro-qq 0)
                     (when (= g-malloc-decl-done 0)
                          (fprintf ct-decl "declare ptr @malloc(i64)\n"))
                        (fprintf ct-decl "declare ptr @alloc-node()\n")
                        (fprintf ct-decl "declare ptr @make-cell(ptr, ptr, i32)\n")
                        (fprintf ct-decl "declare ptr @intern-symbol(ptr)\n")
                        (fprintf ct-def "define private ptr @__cons(ptr %%a, ptr %%b) {\n")
                        (fprintf ct-def "  %%c = call ptr @malloc(i64 40)\n")
                        (fprintf ct-def "  %%p0 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%c, i32 0, i32 0\n")
                        (fprintf ct-def "  store i32 3, ptr %%p0, align 8\n")
                        (fprintf ct-def "  %%p1 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%c, i32 0, i32 1\n")
                        (fprintf ct-def "  store i32 0, ptr %%p1, align 4\n")
                        (fprintf ct-def "  %%p2 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%c, i32 0, i32 2\n")
                        (fprintf ct-def "  store i64 0, ptr %%p2, align 8\n")
                        (fprintf ct-def "  %%p3 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%c, i32 0, i32 3\n")
                        (fprintf ct-def "  store ptr null, ptr %%p3, align 8\n")
                        (fprintf ct-def "  %%p4 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%c, i32 0, i32 4\n")
                        (fprintf ct-def "  store ptr %%a, ptr %%p4, align 8\n")
                        (fprintf ct-def "  %%p5 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%c, i32 0, i32 5\n")
                        (fprintf ct-def "  store ptr %%b, ptr %%p5, align 8\n")
                        (fprintf ct-def "  ret ptr %%c\n")
                        (fprintf ct-def "}\n\n")
                        (fprintf ct-def "define private ptr @__append(ptr %%a, ptr %%b) {\n")
                        (fprintf ct-def "entry:\n")
                        (fprintf ct-def "  %%z = icmp eq ptr %%a, null\n")
                        (fprintf ct-def "  br i1 %%z, label %%nil, label %%rec\n")
                        (fprintf ct-def "nil:\n")
                        (fprintf ct-def "  ret ptr %%b\n")
                        (fprintf ct-def "rec:\n")
                        (fprintf ct-def "  %%p4 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%a, i32 0, i32 4\n")
                        (fprintf ct-def "  %%car = load ptr, ptr %%p4, align 8\n")
                        (fprintf ct-def "  %%p5 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%a, i32 0, i32 5\n")
                        (fprintf ct-def "  %%cdr = load ptr, ptr %%p5, align 8\n")
                        (fprintf ct-def "  %%rest = call ptr @__append(ptr %%cdr, ptr %%b)\n")
                        (fprintf ct-def "  %%c = call ptr @__cons(ptr %%car, ptr %%rest)\n")
                        (fprintf ct-def "  ret ptr %%c\n")
                        (fprintf ct-def "}\n\n"))

                  ; Always declare nucleus_gensym
                  (fprintf ct-decl "declare ptr @nucleus_gensym()\n")

                  (fclose ct-decl)
                  (fclose ct-def)

                  ; Union type defs are emitted lazily; make sure any pending
                  ; ones land in g-type-bufp before it is copied into the module.
                  (drain-pending-union-irs)
                  (fflush g-type-stream)

                  ; Assemble the macro JIT module IR
                  (let (ir-bufp:ptr null  ir-sizep:i64 0
                        irs:ptr (open_memstream (addr-of ir-bufp) (as ptr (addr-of ir-sizep))))
                    (fprintf irs "; ModuleID = '<defmacro %s>'\n" macro-name)
                    (fprintf irs "target triple = \"%s\"\n\n" ((as ptr:Target g-host-target) triple))
                    ; In REPL mode, include the accumulated preamble
                    (when (!= g-interactive 0)
                       (fflush g-repl-preamble)
                          (when (and (!= g-repl-preamble-bufp null)
                                     (!= (char-at g-repl-preamble-bufp 0) 0))
                            (fputs g-repl-preamble-bufp irs)))
                    (when (and (!= g-type-bufp null) (!= (char-at g-type-bufp 0) 0))
                      (fputs g-type-bufp irs))
                    (emit-string-table irs)
                    (when (and (!= g-decl-bufp null) (!= (char-at g-decl-bufp 0) 0))
                      (fputs g-decl-bufp irs))
                    (when (and (!= ct-decl-bufp null) (!= (char-at ct-decl-bufp 0) 0))
                      (fputs ct-decl-bufp irs))
                    (when (and (!= ct-def-bufp null) (!= (char-at ct-def-bufp 0) 0))
                      (fputs ct-def-bufp irs))
                    (fclose irs)
                    (jit-add-module ir-bufp (ff line))
                    (free ct-decl-bufp)
                    (free ct-def-bufp)
                    (free ir-bufp))))))))))))

; ============================================================
; String table emission
; ============================================================

(defn emit-string-table (out:ptr):void
  (doseq (sl g-strs (VecIter ref:StrLit))
    (let (ir-len:i32 (+ (sl len) 1))
      (fprintf out "@.str.%d = private unnamed_addr constant [%d x i8] c\""
        (sl id) ir-len)
      (dotimes (j (sl len))
        (let (c:i32 (char-at (sl bytes) (as i64 j)))
          (if (or (= c 92)
                  (= c 34)
                  (< c 32) (>= c 127))
            (fprintf out "\\%02X" c)
            (fputc c out))))
      (fprintf out "\\00\", align 1\n")))
  (when (!= (count g-strs) 0) (fputc 10 out)))

; Stage 10 errors: the deferror descriptor table (design/stage10/errors.md §8).
; Two arrays of name/message pointers, indexed by error id (slot 0 reserved =
; "no error"). The accessors GEP into these by element type, so no length is
; needed at the call site. Emitted only when errors are in play, keeping
; error-free programs (incl. the compiler's own bootstrap) byte-identical.
(defn emit-deferror-table (out:ptr):void
  ; count == 1 means only the reserved placeholder (no real deferrors).
  (when (and (= (count g-deferror-name-sids) 1) (= g-err-table-used 0)) (return))
  (let (n:i32 (unsafe/cast i32 (count g-deferror-name-sids)))
    (fprintf out "@nuc_err_names = constant [%d x ptr] [" n)
    (dotimes (i n)
      (when (> i 0) (fprintf out ", "))
      (if (= i 0)
          (fprintf out "ptr null")
          (fprintf out "ptr @.str.%d" (invoke g-deferror-name-sids (as usize i)))))
    (fprintf out "]\n")
    (fprintf out "@nuc_err_messages = constant [%d x ptr] [" n)
    (dotimes (i n)
      (when (> i 0) (fprintf out ", "))
      (if (= i 0)
          (fprintf out "ptr null")
          (fprintf out "ptr @.str.%d" (invoke g-deferror-msg-sids (as usize i)))))
    (fprintf out "]\n\n")))

; ============================================================
; Driver
; ============================================================

(defn read-file (path:CStr):ptr
  (let (f:ptr (fopen path "rb"))
    (when (= f null) (perror path) (exit 1))
    (when (!= (fseek f 0 2) 0) (perror "fseek") (exit 1))
    (let (sz:i64 (ftell f))
      (when (< sz 0) (perror "ftell") (exit 1))
      (rewind f)
      (let (buf:ptr (malloc (+ sz 1)))
        (when (= buf null) (perror "malloc") (exit 1))
        (let (nr:i64 (fread buf (as i64 1) sz f))
          (aset! (as ptr:i8 buf) nr 0)
          (fclose f)
          (return buf))))))

; ============================================================
; Desugar pass — split colon-typed symbols into lists
; ============================================================

; Split a symbol string containing : into a list of symbol nodes.
; Split a colon-separated symbol string into a flat list of SYM nodes.
; "ptr:Node" → (ptr Node), "ptr:ptr:Node" → (ptr ptr Node).
(defn split-colon-segments (s:CStr line:i32):ptr
  (let (result:ptr null
        tail:ptr null
        start:i64 0
        i:i64 0
        slen:i64 (as i64 (strlen s)))
    ; CP-3: a binding name ending in ':' is a whitespace near-miss (e.g. `x: (T)`) —
    ; reject here instead of letting the empty final segment produce a remote error.
    (when (and (> slen 0) (= (char-at s (- slen 1)) 58))
      (die-at line (fmt-s "binding name ends in ':' (%s) -- write name:(Type) with no space, or (name Type)" s)))
    (while (<= i slen)
      (when (or (= i slen) (= (char-at s i) 58))
         (let (seg-len:i64 (- i start)
                  seg:ptr (arena-strndup (unsafe/ptr+ (as ptr:i8 s) start) seg-len)
                  n:ptr (intern-symbol seg))
              (let (cell:ptr (make-cell n null line))
                (when (= tail null) (set! result cell))
                (when (!= tail null) (.set! (unsafe/cast ptr:Node tail) cdr cell))
                (set! tail cell)))
            (set! start (+ i 1)))
      (set! i (+ i 1)))
    (return result)))

; Desugar a colon-typed symbol into a binding list:
;   "foo:int"        → (foo int)
;   "node:ptr:Node"  → (node (ptr Node))    ; type tail wrapped
;   "pp:ptr:ptr:Node"→ (pp (ptr ptr Node))
(defn desugar-symbol (sym:(raw Node) line:i32):ptr
  (let (result:ptr (split-colon-segments ((unsafe/cast ptr:Node sym) s) line))
    ; If 3+ segments (name + multi-symbol type), wrap the type tail
    ; in a sublist so the binding becomes (name (seg1 seg2 ...)).
    (when (!= result null)
      (let (rest:ptr ((unsafe/cast ptr:Node result) cdr))
        (when (and (!= rest null) (!= ((unsafe/cast ptr:Node rest) cdr) null))
          (let (wrap:ptr (make-cell rest null line))
            (.set! (unsafe/cast ptr:Node result) cdr wrap)))))
    (return result)))

; Desugar a single typed-name node (symbol with :).
; Returns the node unchanged if it has no colon.
;
; Stage 15 W3a: `encl` is the enclosing form's line, used as the line stamped on
; the cells this produces. A colon-typed binding name is a bare NODE-SYM, and an
; interned symbol node's own `line` is always 0 (W4a / lib/node.nuc node-line) —
; so without the fallback every desugared `(name (ptr T))` cell carried line 0,
; and every diagnostic raised off a defn parameter, defvar/extern/declare name,
; defstruct field or let/with binding name reported `:0:`. That is what made
; `(defn f (m:ptr:Nope):i32 …)` report `unknown type: Nope` with no location.
(defn desugar-typed (node:(raw Node) encl:i32):ptr
  (when (= node null) (return null))
  (let (n:ptr:Node (unsafe/cast ptr:Node node))
    (when (and (= (n kind) NODE-SYM) (!= (strchr (n s) 58) null))
      (return (desugar-symbol node (node-line (as ptr node) encl))))
    (return node)))

; Desugar a parameter list: each element that is a typed symbol gets split.
(defn desugar-params (params:(raw Node) encl:i32):ptr
  (when (= params null) (return null))
  (let (n:ptr:Node (unsafe/cast ptr:Node params))
    (when (!= (n kind) NODE-CELL) (return params))
    (let (new-car:ptr (desugar-typed (n car) (node-line (as ptr params) encl))
          new-cdr:ptr (desugar-params (n cdr) encl))
      (when (and (= new-car (n car)) (= new-cdr (n cdr)))
        (return params))
      (let (c:ptr:Node (as ptr:Node (alloc-node)))
        (.set! c kind NODE-CELL)
        (.set! c line (n line))
        (.set! c car new-car)
        (.set! c cdr new-cdr)
        (return (as ptr c))))))

; Desugar a let binding list: pairs of (name val) where name may be typed.
(defn desugar-let-bindings (binds:(raw Node) encl:i32):ptr
  (when (= binds null) (return null))
  (let (n:ptr:Node (unsafe/cast ptr:Node binds))
    (when (!= (n kind) NODE-CELL) (return binds))
    ; Even-indexed children are binding names, odd are values — desugar names only.
    (let (result:ptr null
          tail:ptr null
          cur:ptr binds
          idx:i32 0
          changed:i32 0)
      (while (!= cur null)
        (let (cn:ptr:Node (unsafe/cast ptr:Node cur)
              elem:ptr (cn car)
              new-elem:ptr elem)
          (when (= (% idx 2) 0)
            (set! new-elem (desugar-typed elem (node-line cur encl))))
          (when (!= new-elem elem) (set! changed 1))
          (let (cell:ptr (make-cell new-elem null (cn line)))
            (when (= tail null) (set! result cell))
            (when (!= tail null) (.set! (unsafe/cast ptr:Node tail) cdr cell))
            (set! tail cell)))
        (set! cur ((unsafe/cast ptr:Node cur) cdr))
        (inc! idx))
      (when (= changed 0) (return binds))
      (return result))))

; Desugar a top-level form list.  Recognises defn, defvar, defstruct,
; extern, declare, and let, and desugars only the binding-position symbols.
; Expression bodies are NOT desugared (they may contain typed symbols from
; macro expansion that should stay as symbols for split-typed in value position).
(defn desugar (forms:(raw Node)):ptr
  (when (= forms null) (return null))
  (let (n:ptr:Node (unsafe/cast ptr:Node forms))
    (when (!= (n kind) NODE-CELL) (return forms))
    (let (new-car:ptr (desugar-form (n car))
          new-cdr:ptr (desugar (n cdr)))
      (when (and (= new-car (n car)) (= new-cdr (n cdr)))
        (return forms))
      (let (c:ptr:Node (as ptr:Node (alloc-node)))
        (.set! c kind NODE-CELL)
        (.set! c line (n line))
        (.set! c car new-car)
        (.set! c cdr new-cdr)
        (return (as ptr c))))))

; Desugar a single form.  Only touches binding positions of known forms.
(defn desugar-form (form:(raw Node)):ptr
  (when (= form null) (return null))
  (let (f:ptr:Node (unsafe/cast ptr:Node form))
    (when (!= (f kind) NODE-CELL) (return form))
    (when (= (node-len form) 0) (return form))
    (let (head:ptr:Node (unsafe/cast ptr:Node (node-at form 0)))
      (when (!= (head kind) NODE-SYM) (return form))
      (let (h:ptr (head s))
        ; (defn name:type (params...) body...)
        (when (= h "defn")
          (when (>= (node-len form) 3)
            (let (new-name:ptr (desugar-typed (node-at form 1) (f line))
                  new-params:ptr (desugar-params (node-at form 2) (f line)))
              (when (and (= new-name (node-at form 1))
                         (= new-params (node-at form 2)))
                (return form))
              ; Rebuild: (defn new-name new-params body...)
              (return (make-cell (as ptr head)
                       (make-cell new-name
                         (make-cell new-params
                           ((unsafe/cast ptr:Node ((unsafe/cast ptr:Node (f cdr)) cdr)) cdr)
                           (f line))
                         (f line))
                       (f line))))))
        ; (defvar name:type [init])
        (when (= h "defvar")
          (when (>= (node-len form) 2)
            (let (new-name:ptr (desugar-typed (node-at form 1) (f line)))
              (when (= new-name (node-at form 1)) (return form))
              (return (make-cell (as ptr head)
                       (make-cell new-name
                         ((unsafe/cast ptr:Node (f cdr)) cdr)
                         (f line))
                       (f line))))))
        ; (defstruct name field:type ...)
        (when (= h "defstruct")
          (when (>= (node-len form) 2)
            ; Desugar fields (positions 2+)
            (let (new-rest:ptr (desugar-params ((unsafe/cast ptr:Node (f cdr)) cdr) (f line)))
              (when (= new-rest ((unsafe/cast ptr:Node (f cdr)) cdr))
                (return form))
              (return (make-cell (as ptr head)
                       (make-cell (node-at form 1)
                         new-rest
                         (f line))
                       (f line))))))
        ; (extern name:type)
        (when (= h "extern")
          (when (= (node-len form) 2)
            (let (new-name:ptr (desugar-typed (node-at form 1) (f line)))
              (when (= new-name (node-at form 1)) (return form))
              (return (make-cell (as ptr head)
                       (make-cell new-name null (f line))
                       (f line))))))
        ; (declare name:type (params...))            — legacy
        ; (declare name (params...) ret)             — new style (S1)
        ; Desugar the name (index 1) and, when present, the param list (index 2);
        ; everything from index 3 onward (a new-style return operand and/or a
        ; trailing Stage 10 `noreturn`) rides through verbatim, so emit-nuch-
        ; declare-import still sees the return type and can mark the symbol. The
        ; param list is at index 2 in both shapes. This is byte-identical to the
        ; former legacy-only rebuild for every legacy shape (len 2/3 ± noreturn).
        (when (= h "declare")
          (when (>= (node-len form) 2)
            (let (new-name:ptr (desugar-typed (node-at form 1) (f line)))
              (if (>= (node-len form) 3)
                (let (new-params:ptr (desugar-params (node-at form 2) (f line))
                      tail3:ptr (-> f (_ cdr) (unsafe/cast ptr:Node _) (_ cdr)
                                      (unsafe/cast ptr:Node _) (_ cdr)))
                  (when (and (= new-name (node-at form 1)) (= new-params (node-at form 2)))
                    (return form))
                  (return (make-cell (as ptr head)
                           (make-cell new-name
                             (make-cell new-params tail3 (f line))
                             (f line))
                           (f line))))
                (do
                  (when (= new-name (node-at form 1)) (return form))
                  (return (make-cell (as ptr head)
                           (make-cell new-name null (f line))
                           (f line))))))))
        ; (let (bindings...) body...) — desugar binding names
        ; (with (bindings...) body...) — same shape; auto-frees libc-alloc'd bindings
        (when (or (= h "let") (= h "with"))
          (when (>= (node-len form) 2)
            (let (new-binds:ptr (desugar-let-bindings (node-at form 1) (f line)))
              (when (= new-binds (node-at form 1)) (return form))
              (return (make-cell (as ptr head)
                       (make-cell new-binds
                         ((unsafe/cast ptr:Node (f cdr)) cdr)
                         (f line))
                       (f line))))))
        ; Recurse into body of compile-time and do blocks
        (when (or (= h "compile-time") (= h "do"))
          (let (new-body:ptr (desugar (f cdr)))
            (when (= new-body (f cdr)) (return form))
            (return (make-cell (as ptr head) new-body (f line)))))
        (return form)))))

; Pre-register the names of all top-level structs so that defn signatures
; mentioning a struct type (e.g. a param typed ptr:Circle) resolve during
; prescan-defn-signatures, which runs before any defstruct is emitted. Only the
; name is registered here; fields and the IR type are filled by emit-defstruct.
; Stage 10 (nullability §9 friction 2 / errors prereq): make imported types
; visible to the *current unit's* signature prescan. The toplevel prescan runs
; before any `(import …)` is processed, so a defn signature naming a prelude
; type (`Node`, `Result`, the `!T` sugar) would otherwise fail. This walks the
; import tree depth-first, reads each `.nuc`/`.nuch` file, and registers its
; struct names + union templates (names only — no IR, no emission). Registration
; is idempotent, so the actual import later is unaffected. C-string imports
; (`"stdio.h"`) are skipped (no Nucleus types; reading would invoke clang).
; Stage 15 B3′: fill THIS file's import environment before its own prescans run.
;
; B2a recorded that `prescan-defn-signatures` runs before any import form is
; processed, so `g-file-imports` is empty there by construction — which was
; harmless while only globals and protocols resolved through the environment
; (neither appears in a type position). R1 makes it fatal: a `defn` signature is
; the first place a namespaced type is named, and `(defn f ((x (ref dpx/Fox))) …)`
; was refused as "'dpx' is not in scope in this file" in the file that bound
; `dpx`. That would have made a namespaced type unusable in any signature, i.e.
; unusable.
;
; This walks only the top-level import forms and records the same
; `(prefix, path)` binds `do-import` records, doing none of the work: no file is
; read, no symbol is registered, nothing is emitted. `do-import` still records
; them later (the dedup above makes that a no-op), so the environment a form
; declares is unchanged — only its availability moves earlier. It is also half of
; B2a's "still open" item (b); the other half, moving the imported signature
; prescan ahead of the root's own, is not needed for this.
(defn prescan-file-imports (forms:(raw Node)):void
  (let (fc:ptr forms)
    (while (!= fc null)
      (let (f:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node fc) car)))
        (when (and (!= (as ptr f) null) (= (f kind) NODE-CELL)
                   (>= (node-len (as ptr f)) 2)
                   (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind) (= _ NODE-SYM)))
          (let (ph:ptr (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ s))
                prefix:ptr null
                kind-ok:i32 0
                priv-head:i32 0)
            ; Classify the head first, then derive its prefix — because getting
            ; the second wrong is INVISIBLE: a prefixing form recorded with a
            ; null prefix silently becomes a FLATTENING bind, which leaks every
            ; name the library defines into this file's bare namespace.
            (when (or (= ph "unsafe-import-private") (= ph "unsafe/import-private"))
              (set! kind-ok 1) (set! priv-head 1))
            (when (or (or (= ph "import") (= ph "import-prefixed"))
                      (or (= ph "import-use") (= ph "import-only")))
              (set! kind-ok 1))
            (when (!= priv-head 0)
              ; `(unsafe-import-private lib prefix sym…)` — the prefix is always
              ; explicit, at index 2, and the form may be longer than 3.
              (when (>= (node-len (as ptr f)) 3)
                (let (pn:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr f) 2)))
                  (when (= (pn kind) NODE-SYM) (set! prefix (pn s))))))
            (when (and (= priv-head 0)
                       (or (= ph "import") (= ph "import-prefixed")))
              (set! prefix (import-form-prefix (as ptr f) (f line))))
            ; A prefixing head whose prefix does not derive is malformed;
            ; `emit-import-prefixed` reports it at its own line. Skip it here.
            (when (and (= prefix null)
                       (or (!= priv-head 0)
                           (or (= ph "import") (= ph "import-prefixed"))))
              (set! kind-ok 0))
            (when (!= kind-ok 0)
              (let (nn:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr f) 1)))
                (when (= (nn kind) NODE-STR)
                  (file-import-record prefix (nn s)))
                (when (= (nn kind) NODE-SYM)
                  ; A missing library is diagnosed by `do-import`, at the import
                  ; form's own line. Staying silent here keeps one diagnosis.
                  (let (path:ptr (resolve-import (nn s) 0))
                    (when (!= path null) (file-import-record prefix path)))))))))
      (set! fc ((unsafe/cast ptr:Node fc) cdr)))))

(defn prescan-imported-types (forms:(raw Node)):void
  (let (fc:ptr forms)
    (while (!= fc null)
      (let (f:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node fc) car)))
        ; Stage 12: every import form carries the library at index 1 — the legacy
        ; flatten `(import LIB)` plus the new `import-use`/`import-only`/
        ; `import-prefixed`/`unsafe-import-private`. The prescan only needs the
        ; library's file path (to pre-register its types for the importer's defn
        ; signatures); the prefix/symbol-list tail is irrelevant here. The legacy
        ; `import` keeps the node-len==2 guard so its byte-identical path is
        ; untouched; the new heads accept a longer tail.
        (when (and (!= (as ptr f) null) (= (f kind) NODE-CELL)
                   (>= (node-len (as ptr f)) 2)
                   (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind) (= _ NODE-SYM)))
          (let (ph:ptr (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ s)))
           (when (or (and (= ph "import") (= (node-len (as ptr f)) 2))
                     (= ph "import-use")
                     (= ph "import-only")
                     (= ph "import-prefixed")
                     (= ph "unsafe-import-private")
                     ; Stage 14 UN-2: reserved-namespace spelling, same shape.
                     (= ph "unsafe/import-private"))
            (let (nn:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr f) 1)))
              ; Stage 15 W3a: a C-header string import (`(import-use "stdio.h")`).
              ; Recover just its OPAQUE type names (cheader-prescan-opaque), so a
              ; defn signature in this unit may name a C handle type
              ; (`m:ptr:Mix_Music`) — the signature prescan below runs before any
              ; import is processed, so import-time registration is too late. A
              ; `.nuc`/`.nuch` string path is a Nucleus file (do-import treats it
              ; as one) and is left to the symbol branch's shape.
              (when (and (= (nn kind) NODE-STR)
                         (= (str-ends-with (nn s) ".nuc") 0)
                         (= (str-ends-with (nn s) ".nuch") 0)
                         (= (import-list-has g-prescan-visited (nn s)) 0))
                (set! g-prescan-visited (import-list-push g-prescan-visited (nn s)))
                (cheader-prescan-opaque (nn s)))
              (when (= (nn kind) NODE-SYM)
                (let (path:ptr (resolve-import (nn s) (f line)))
                  (when (and (!= path null)
                             (= (import-list-has g-prescan-visited path) 0))
                    (set! g-prescan-visited (import-list-push g-prescan-visited path))
                    (let (save-src:ptr g-src
                          save-pos:i64 g-pos
                          save-line:i32 g-line
                          save-path:ptr g-source-path
                          save-peek:ptr g-peek
                          save-peek-valid:i32 g-peek-valid
                          ; Stage 15 B3′: pass 1 crosses a file boundary, and
                          ; since B3′ what it registers is KEYED by the defining
                          ; file's namespace — so it must save/clear/restore the
                          ; namespace exactly as `prescan-imported-signatures`
                          ; (pass 2) already does, and apply the imported file's
                          ; own leading `(ns …)`. Without this the prescan keys a
                          ; namespaced library's types under the IMPORTER's
                          ; namespace and `emit-defstruct` then registers a second
                          ; StructDef under the right key — B5's §14.4 finding,
                          ; recurring here as a key rather than as provenance.
                          save-ns:ptr g-current-ns
                          save-ns-seen:i32 g-ns-seen
                          save-file-imports:(raw (Vector (ref ImportBind))) g-file-imports)
                      (let (src:ptr (read-file path))
                        (set! g-source-path path)
                        (set! g-src src)
                        (set! g-pos 0)
                        (set! g-line 1)
                        (set! g-peek-valid 0)
                        (set! g-current-ns (intern-str "user"))
                        (set! g-ns-seen 0)
                        (set! g-file-imports null)
                        (let (ifs:ptr (apply-leading-ns (desugar (read-program-or-die))))
                          ; A leading `set-ir-prefix` must be applied before any
                          ; type is registered: `register-struct` snapshots the
                          ; namespace's ir-prefix into `StructDef.ir-prefix`.
                          (apply-early-set-ir-prefix ifs)
                          (prescan-imported-types ifs)
                          (prescan-struct-names ifs))
                        (free src))
                      (set! g-source-path save-path)
                      (set! g-src save-src)
                      (set! g-pos save-pos)
                      (set! g-line save-line)
                      (set! g-peek save-peek)
                      (set! g-peek-valid save-peek-valid)
                      (set! g-current-ns save-ns)
                      (set! g-ns-seen save-ns-seen)
                      (set! g-file-imports save-file-imports))))))))))
      (set! fc ((unsafe/cast ptr:Node fc) cdr)))))

(defn prescan-struct-names (forms:(raw Node)):void
  (let (fc:ptr forms)
    (while (!= fc null)
      (let (f:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node fc) car)))
        (when (and (!= (as ptr f) null) (= (f kind) NODE-CELL)
                   (>= (node-len (as ptr f)) 2)
                   (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind) (= _ NODE-SYM)))
          (let (h:ptr (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ s)))
            ; Stage 15 B5: this prescan records NO privacy provenance — the four
            ; private definers write `priv`/`src-ns` at emission, and a prescan
            ; entry is `priv` 0, so `binding-visible` returns early and never
            ; consults `src-ns`. B5 needed that because pass 1 ran under the
            ; IMPORTER's namespace; B3′ fixed *that* (pass 1 now applies the
            ; imported file's leading `(ns …)`, because since B3′ the registry KEY
            ; depends on it too), so the constraint is weaker than it was — but
            ; capturing provenance at emission remains the rule, since emission is
            ; the only point at which `g-defining-private` is armed.
            (when (or (= h "defstruct") (= h "defstruct-"))
              (let (nn:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr f) 1)))
                (if (= (nn kind) NODE-SYM)
                  (when (= (as ptr (lookup-struct (as CStr (qualify-name (nn s))))) null)
                    (register-struct (as CStr (qualify-name (nn s)))))
                  ; Stage 11: a parameterized head — (defstruct (Vector T) ...) —
                  ; registers a template here so defn signatures naming
                  ; (Vector i32) resolve in the signature prescan that follows.
                  (when (= (nn kind) NODE-CELL)
                    (register-struct-template (as ptr f))))))
            ; defunion/defunion-: pre-register the backing struct's name (monomorphic)
            ; or the template, so defn signatures mentioning the type resolve in
            ; the signature prescan that follows.
            (when (or (= h "defunion") (= h "defunion-"))
              (let (nn:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr f) 1)))
                (if (= (nn kind) NODE-SYM)
                  (when (= (as ptr (lookup-struct (as CStr (qualify-name (nn s))))) null)
                    (register-struct (as CStr (qualify-name (nn s)))))
                  (when (= (nn kind) NODE-CELL)
                    (register-union-template (as ptr f)))))))))
      (set! fc ((unsafe/cast ptr:Node fc) cdr)))))

; Register the constructor signatures of a (monomorphic) defunion form:
; per arm, `Name-arm : Name (field types...)`. Runs in the signature prescan,
; after prescan-struct-names registered the backing struct's name.
(defn prescan-union-ctors (form:(raw Node)):void
  (let (ff:ptr:Node (unsafe/cast ptr:Node form)
        name-node:ptr:Node (unsafe/cast ptr:Node (node-at form 1)))
    (when (!= (name-node kind) NODE-SYM) (return))   ; templates: no constructors
    ; Skip when already registered (re-import of the same unit).
    ; Stage 15 B3′: both probes are definition-side, so both hold the KEY.
    (when (!= (uniondef-lookup (as CStr (qualify-name (name-node s)))) null) (return))
    (let (sd:ptr (lookup-struct (as CStr (qualify-name (name-node s)))))
      (when (= sd null) (return))
      ; Strip &repr (a layout marker, not an arm) so it does not become a bogus
      ; constructor. The forward-declared return type is the backing struct; the
      ; real signature (niche pointer for rules 2/3) is set by emit-defunion's
      ; emit-defn, which re-resolves `:Name` once the layout is registered —
      ; consistent because constructors are never called before their definition
      ; (target-typed `ok`/`some` in return position go through union-target-
      ; rewrite, not the named constructor).
      (let (repr-box:i32 REPR-AUTO
            ret:ptr (as ptr (type-for-sdef sd))
            cur:ptr (defunion-strip-repr (-> ff (_ cdr) (unsafe/cast ptr:Node _) (_ cdr))
                      (as ptr:i32 (addr-of repr-box)) (ff line)))
        (while (!= cur null)
          (let (arm:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node cur) car))
                aname:ptr null
                fields:ptr null
                nf:i32 0)
            (if (= (arm kind) NODE-SYM)
              (set! aname (arm s))
              (when (and (= (arm kind) NODE-CELL)
                         (-> arm (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind) (= _ NODE-SYM)))
                (set! aname (-> arm (node-at _ 0) (unsafe/cast ptr:Node _) (_ s)))
                (set! fields ((unsafe/cast ptr:Node arm) cdr))
                (set! nf (- (node-len (as ptr arm)) 1))))
            (when (!= aname null)
              (let (ptypes:ptr null)
                (when (> nf 0)
                  (set! ptypes (arena-alloc (* (as i64 nf) (ptr-bytes))))
                  (let (fi:i32 0
                        fcur:ptr fields)
                    (while (!= fcur null)
                      (let (fname:ptr null
                            fty:ptr (extract-name-and-type ((unsafe/cast ptr:Node fcur) car)
                                                            (as ptr:ptr (addr-of fname))
                                                            (ff line)))
                        (when (= fty null) (set! fty (as ptr ty-i32)))
                        (aset! (as ptr:ptr ptypes) fi fty))
                      (inc! fi)
                      (set! fcur ((unsafe/cast ptr:Node fcur) cdr)))))
                (generic-register-method (fmt-2s "%s-%s" (name-node s) aname)
                                         ret ptypes nf 0 0 null))))
          (set! cur ((unsafe/cast ptr:Node cur) cdr)))))))

; Pre-scan a form list and forward-declare all defn signatures in g-globals.
(defn prescan-defn-signatures (forms:(raw Node)):void
  (let (fc:ptr forms)
    (while (!= fc null)
      (let (f:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node fc) car)))
        ; defunion/defunion-: pre-register the arm constructors' signatures so
        ; defns earlier in the unit can call them (mirrors the defn prescan below).
        (when (and (!= (as ptr f) null) (= (f kind) NODE-CELL)
                   (>= (node-len (as ptr f)) 3)
                   (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind) (= _ NODE-SYM)))
          (let (ph2:ptr (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ s)))
            (when (or (= ph2 "defunion") (= ph2 "defunion-"))
              (prescan-union-ctors (as ptr f)))))
        (when (and (!= (as ptr f) null) (= (f kind) NODE-CELL)
                   (>= (node-len (as ptr f)) 4)
                   (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind) (= _ NODE-SYM)))
          (let (ph3:ptr (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ s)))
            (when (or (= ph3 "defn") (= ph3 "defn-"))
          ; Stage 15 W5e: signature registration happens HERE, before any form is
          ; emitted (W1a), so the private flag the top-level dispatch loop sets
          ; around `emit-defn` is not yet on. Arm it for the registration so the
          ; name is keyed under this file's implicit private namespace, and
          ; recorded as private for the duplicate-definition diagnostic. Restored
          ; immediately: a prescan walks a whole file's forms in one call, and
          ; the very next `defn` must register publicly.
          (let (save-priv:i32 g-defining-private)
            (set! g-defining-private (if (= ph3 "defn-") 1 0))
          (let (name-node:ptr (node-at (as ptr f) 1)
                params-node:ptr (node-at (as ptr f) 2))
            (when (!= (node-is-list params-node) 0)
              ; A `&where` clause OR a receiver over a parametric struct marks a
              ; bounded-generic template: retain it for on-demand monomorphization
              ; rather than parsing its (free-tyvar) parameter/return types now.
              (if (!= (defn-is-generic-template (as ptr f)) 0)
                (register-generic-defn (as ptr f) 0)
                (let (fname:ptr null
                      ps-ret-node:ptr null
                      ps-params:ptr null
                      ps-bstart:i32 3
                      ps-style:i32 (defn-parse-sig (as ptr f) (as ptr:ptr (addr-of fname))
                                     (as ptr:ptr (addr-of ps-ret-node))
                                     (as ptr:ptr (addr-of ps-params))
                                     (as ptr:i32 (addr-of ps-bstart)))
                      ; W3a: `name-node` is the defn's NAME — an interned
                      ; NODE-SYM whose own line is always 0 — so resolving the
                      ; signature's types against it reported every failure
                      ; (`unknown type: T`) at `:0:`. Borrow the return operand's
                      ; own line, falling back to the defn form's.
                      ret:ptr (if (!= ps-style 0)
                                (fn-parse-ret-type ps-ret-node
                                  (node-line ps-ret-node (f line)))
                                (extract-name-and-type name-node (as ptr:ptr (addr-of fname))
                                                        (f line))))
                  (when (!= ret null)
                    (let (nparams:i32 (defn-params-count params-node)
                          ptypes:ptr (defn-params-to-types params-node)
                          has-rest:i32 (if (< (defn-params-count params-node)
                                              (node-len params-node)) 1 0))
                      (generic-register-method fname ret ptypes nparams has-rest 0
                                               (as ptr f))))))))
            (set! g-defining-private save-priv))))))
      (set! fc ((unsafe/cast ptr:Node fc) cdr)))
    (finalize-generics)))

; ============================================================
; Stage 15 W8 G-0 (design/global-init.md §5) — the VALUE half of W1a's
; whole-graph prescan.
;
; W1a made `defn` signatures, protocols and type names resolve on *reachability*
; rather than import order. Value names — `defvar`, `defconst`, `defenum` members
; — were left behind: they were registered by their emitters, so a reference to
; one that had not been emitted yet died `undefined: X — not defined anywhere in
; this compilation unit`, asserting something false about a name that is in the
; unit (global-init.md §2.5 records the four probes). These three functions
; register the same bindings the emitters do, at the point W1a registers
; signatures — before any form of any reachable file is emitted.
;
; REGISTRATION ONLY. Nothing here writes to an IR stream: the `@g = global …`
; line still comes out of `emit-defvar`, in its own file's emission position, and
; a reference emitted before it is an ordinary forward reference to a module-level
; global, which LLVM's textual parser resolves at end of module (verified).
;
; The emitters still register too, so each value name is defined twice in
; `g-globals` (prescan, then emission). That is deliberate and it is the cheap
; half of the not-idempotent problem W1a had to solve for signatures: unlike
; `generic-register-method`, `scope-define` appends and `scope-lookup` scans
; backwards, so a re-definition of an identical binding is inert — the emission
; copy simply wins, exactly as it does today for the *same* name defined twice by
; two files. There is therefore no relaxation of any duplicate check here: two
; `defvar`s of one name still emit two `@g = global` lines (rejected at the LLVM
; parse), and two `defn`s of one signature still hit `finalize-generics`'
; duplicate-definition diagnostic. Per-path skipping is still what keeps the
; SIGNATURE pass single-shot (`g-prescan-sigs`); these run under exactly the same
; guard, so a file is never value-prescanned twice.
;
; Namespaces are applied by the caller (`prescan-imported-signatures` saves and
; restores `g-current-ns`/`g-ns-seen` and applies each visited file's own leading
; `(ns …)` / `set-ir-prefix`), and W5e's synthetic per-file private namespace is
; reproduced by arming `g-defining-private` around a `defvar-`/`defconst-`/
; `defenum-` — `scope-define` keys through `priv-key-define` and `def-ir-base`
; composes the file's private ir-prefix, both of which read that flag. Without the
; arming a private value would register under the public key and emit under a
; different symbol than the one the prescan advertised.
;
; Malformed forms are SKIPPED, never diagnosed: every shape check below has a
; matching `die-at` in the emitter, and moving a diagnostic earlier would move
; which error a broken file reports first. The one thing the prescan does not
; tolerate is an unresolvable *type*, because `extract-name-and-type` dies on its
; own — the same constraint `prescan-defn-signatures` has carried since W1a, and
; the reason W1c's `unknown type: X` reachability rule (resolution.md §2.7) now
; covers a `defvar`'s type exactly as it covers a `defn` parameter's.
; ============================================================

; The `defvar`/`defvar-` half: the same Sym `emit-defvar` defines, minus the
; `@g = global …` line, the `type-size` alignment and the name-kind guard.
(defn prescan-defvar-name (form:(raw Node)):void
  (let (cc:ptr:Node (unsafe/cast ptr:Node form))
    (when (< (node-len cc) 2) (return))
    (let (attr-flags:i32 0
          decl:ptr (parse-decl-attrs (as ptr (cc cdr))
                     (as ptr:i32 (addr-of attr-flags)) (cc line)))
      (when (= decl null) (return))
      (let (declc:ptr:Node (unsafe/cast ptr:Node decl)
            name-node:ptr (declc car)
            name:ptr null
            name-line:i32 (node-line (as ptr name-node) (cc line))
            ; G-2: the prescan resolves the very same type node and must not
            ; refuse what emission accepts — but it must not fold an array
            ; length either (macros are not registered yet), so it takes the
            ; provisional variant.
            ty:ptr (extract-decl-name-and-type-provisional name-node (as ptr:ptr (addr-of name)) name-line))
        ; No type annotation: `(defvar x 0)` is an error emit-defvar reports.
        (when (or (= ty null) (= name null)) (return))
        (when (!= (bit-and attr-flags DECL-ATTR-VOLATILE) 0)
          (set! ty (as ptr (type-with-volatile (unsafe/cast ref:Type ty)))))
        (let (vsym:ref:Sym (scope-define g-globals name ty
                             (fmt-s "@%s" (def-ir-base name)) 1))
          (when (!= g-defining-private 0)
            (.set! (unsafe/cast ptr:Sym vsym) sym-private 1))
          ; AVR-6: a `:const` global is not assignable; emit-set reads this flag,
          ; and a `set!` emitted before the defvar's own file must see it too.
          (when (!= (bit-and attr-flags DECL-ATTR-CONST) 0)
            (.set! (unsafe/cast ptr:Sym vsym) readonly-global 1))
          ; G-4: this Sym is the "declared, not yet reached" half of the pair.
          ; `emit-defvar` appends a second Sym for the same key with
          ; DEFVAR-REACHED, and scope-lookup's backwards scan is what makes the
          ; state a reference sees flip at exactly the right moment.
          (.set! (unsafe/cast ptr:Sym vsym) defvar-state DEFVAR-DECLARED)
          (sym-set-src-loc (as ptr vsym) (cc line)))))))

; The `defconst`/`defconst-` half. The value is an integer literal and is
; therefore available here, so the constant carries its full W2b provenance
; (`int-literal-type`'s truthful width plus `const-lit`/`const-lit-i64`) rather
; than only its name — a forward reference must type exactly as a backward one.
(defn prescan-defconst-name (form:(raw Node)):void
  (let (cc:ptr:Node (unsafe/cast ptr:Node form))
    (when (!= (node-len cc) 3) (return))
    (let (name:ptr:Node (unsafe/cast ptr:Node (node-at cc 1))
          val:ptr:Node (unsafe/cast ptr:Node (node-at cc 2)))
      (when (or (= (as ptr name) null) (= (as ptr val) null)) (return))
      (when (!= (name kind) NODE-SYM) (return))
      (when (!= (val kind) NODE-INT) (return))
      ; A colon-typed name ("K:i32") is W4b's rejected shape; leave it to
      ; emit-defconst, which explains it.
      (when (!= (strchr (name s) 58) null) (return))
      (let (sym:ref:Sym (scope-define g-globals (name s)
                          (as ptr (int-literal-type (val i))) null 0))
        (.set! sym is-const 1)
        (.set! sym const-val (fmt-i64 "%ld" (val i)))
        (.set! sym const-lit 1)
        (.set! sym const-lit-i64 (val i))
        (when (!= g-defining-private 0) (.set! sym sym-private 1))
        ; Stage 15 B4 (R4): the site, so the emitter's own check can recognise
        ; this prescan Sym as the same definition rather than an earlier one.
        (sym-set-src-loc (as ptr sym) (cc line))))))

; The `defenum`/`defenum-` half: the MEMBER names (the enum's own type name is a
; type, and W1c deliberately keeps type reachability as it is). The EnumDef table
; that `match` exhaustiveness reads is NOT registered here — it is emission-time
; state keyed by the enum's type name, not a value binding, and front-loading it
; would change `g-enumdefs` order against MAX-ENUMS for no G-0 benefit.
(defn prescan-defenum-names (form:(raw Node)):void
  (let (cc:ptr:Node (unsafe/cast ptr:Node form))
    (when (< (node-len cc) 2) (return))
    (let (i:i32 2)
      (while (< i (node-len cc))
        (let (name:ptr:Node (unsafe/cast ptr:Node (node-at cc i)))
          (when (and (!= (as ptr name) null) (= (name kind) NODE-SYM))
            (let (sym:ref:Sym (scope-define g-globals (name s) ty-i32 null 0))
              (.set! sym is-const 1)
              (.set! sym const-val (fmt-i32 "%d" (- i 2)))
              (.set! sym const-lit 1)
              (.set! sym const-lit-i64 (as i64 (- i 2)))
              (when (!= g-defining-private 0) (.set! sym sym-private 1))
              ; Stage 15 B4 (R4): the site — see `guard-const-redefinition`.
              (sym-set-src-loc (as ptr sym) (cc line)))))
        (inc! i)))))

; Pre-scan one file's top-level forms and register every value name it defines.
; Runs immediately after `prescan-defn-signatures` for the same form list, under
; the same per-path guard, with the file's namespace already applied.
(defn prescan-value-names (forms:(raw Node)):void
  (let (fc:ptr forms)
    (while (!= fc null)
      (let (f:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node fc) car)))
        (when (and (!= (as ptr f) null) (= (f kind) NODE-CELL)
                   (>= (node-len (as ptr f)) 2)
                   (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind) (= _ NODE-SYM)))
          (let (h:ptr (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ s))
                priv:i32 (if (or (= h "defvar-") (= h "defconst-") (= h "defenum-")) 1 0))
            (when (or (= h "defvar") (= h "defvar-")
                      (= h "defconst") (= h "defconst-")
                      (= h "defenum") (= h "defenum-"))
              ; W5e: the top-level dispatch loop arms this around the emitter, so
              ; the prescan must arm it too or a private name registers under the
              ; public key. Restored immediately — the very next form may be public.
              (let (save-priv:i32 g-defining-private)
                (set! g-defining-private priv)
                (cond
                  (or (= h "defvar") (= h "defvar-"))
                    (prescan-defvar-name (as ptr f))
                  (or (= h "defconst") (= h "defconst-"))
                    (prescan-defconst-name (as ptr f))
                  true
                    (prescan-defenum-names (as ptr f)))
                (set! g-defining-private save-priv))))))
      (set! fc ((unsafe/cast ptr:Node fc) cdr)))))

; Stage 15 W1a/W1b (design/stage15-stress-test/resolution.md) — the second
; whole-graph prescan pass. `prescan-imported-types` (pass 1, above) has already
; walked the import graph and registered every reachable file's struct/union type
; NAMES; this pass walks the same graph and registers every reachable file's
; PROTOCOLS and DEFN SIGNATURES. After it, a cross-file function reference
; resolves on *reachability* rather than on import order — the old rule was purely
; ordinal ("X may reference a function in Y iff Y begins processing before X is
; emitted"), which made a mutually recursive pair inexpressible with
; import-what-you-use discipline in *any* ordering.
;
; Two passes rather than one: a signature's types must resolve against the WHOLE
; graph's type names, so registering names and signatures in a single walk would
; reintroduce exactly the ordering dependency this removes, one level down (file F
; prescanned before a sibling G that their parent imports after it).
;
; The traversal is PRE-order (a file's own signatures, then its imports') and this
; runs *after* the outermost unit's own prescans, so the sequence of registrations
; — and therefore of parametric-instance stampings, which are memoized on first
; use and queued for IR in stamp order — is the same one today's interleaved
; prescan/emit walk produces. Only the *timing* moves: everything is registered
; before any form is emitted.
;
; W1b: each visited file's own leading `(ns …)` / `set-ir-prefix` is applied while
; prescanning it, and restored afterwards, exactly as `emit-toplevel-forms` and
; `do-import` do. Defn signatures are namespace-qualified — `scope-define`
; qualifies the key against `g-current-ns` and `generic-new` snapshots the
; namespace's ir-prefix — so prescanning a namespaced file under the *importer's*
; namespace would register it under the wrong key and bake the wrong ir-name.
; (Pass 1 does not need this: it registers struct names only, which are unqualified.)
;
; Skips, each for a specific reason:
;   * a path already on `g-prescan-sigs` — the graph may reach it twice (diamond);
;   * a path already on `g-imported` — the REPL processes one import per command,
;     so a later command's walk can reach a file the session has already loaded,
;     whose signatures are therefore already registered;
;   * a `.nuch` header — its importer (`emit-nuch-import-forms`) deliberately does
;     NOT run `prescan-defn-signatures`; declares/defmethods/templates each have
;     their own registration path, so prescanning here would double-register;
;   * a C-header string import — reading one shells out to clang (pass 1's rule).
; Only the NODE-SYM spelling is walked, matching pass 1 (a `.nuc`/`.nuch` *string*
; path import is left to emission, as it is today).
(defn prescan-imported-signatures (forms:(raw Node)):void
  (let (fc:ptr forms)
    (while (!= fc null)
      (let (f:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node fc) car)))
        (when (and (!= (as ptr f) null) (= (f kind) NODE-CELL)
                   (>= (node-len (as ptr f)) 2)
                   (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind) (= _ NODE-SYM)))
          (let (ph:ptr (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ s)))
           (when (or (and (= ph "import") (= (node-len (as ptr f)) 2))
                     (= ph "import-use")
                     (= ph "import-only")
                     (= ph "import-prefixed")
                     (= ph "unsafe-import-private")
                     (= ph "unsafe/import-private"))
            (let (nn:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr f) 1)))
              (when (= (nn kind) NODE-SYM)
                (let (path:ptr (resolve-import (nn s) (f line)))
                  (when (and (!= path null)
                             (= (str-ends-with path ".nuch") 0)
                             (= (import-list-has g-prescan-sigs path) 0)
                             (= (as ptr (import-list-find g-imported path)) null))
                    (set! g-prescan-sigs (import-list-push g-prescan-sigs path))
                    (let (save-src:ptr g-src
                          save-pos:i64 g-pos
                          save-line:i32 g-line
                          save-path:ptr g-source-path
                          save-peek:ptr g-peek
                          save-peek-valid:i32 g-peek-valid
                          save-ns:ptr g-current-ns
                          save-ns-seen:i32 g-ns-seen
                          ; Stage 15 B1: the prescan crosses a file boundary too,
                          ; so it saves/clears the import environment for the same
                          ; reason it saves the namespace. It never *fills* one —
                          ; it walks import forms without calling `do-import` — so
                          ; the honest state while prescanning file F is "F has no
                          ; bindings yet", not "F inherits its importer's".
                          save-file-imports:(raw (Vector (ref ImportBind))) g-file-imports)
                      (let (src:ptr (read-file path))
                        (set! g-source-path path)
                        (set! g-src src)
                        (set! g-pos 0)
                        (set! g-line 1)
                        (set! g-peek-valid 0)
                        (set! g-current-ns (intern-str "user"))
                        (set! g-ns-seen 0)
                        (set! g-file-imports null)
                        (let (ifs:ptr (apply-leading-ns (desugar (read-program-or-die))))
                          (apply-early-set-ir-prefix ifs)
                          ; Stage 15 B3′: the imported file's own environment,
                          ; so ITS signatures may name a namespaced type through
                          ; a prefix it bound.
                          (prescan-file-imports ifs)
                          (prescan-protocols ifs)
                          (prescan-defn-signatures ifs)
                          ; Stage 15 W8 G-0: the value half, registered under the
                          ; same per-path guard and the same applied namespace.
                          (prescan-value-names ifs)
                          (prescan-imported-signatures ifs))
                        (free src))
                      (set! g-source-path save-path)
                      (set! g-src save-src)
                      (set! g-pos save-pos)
                      (set! g-line save-line)
                      (set! g-peek save-peek)
                      (set! g-peek-valid save-peek-valid)
                      (set! g-current-ns save-ns)
                      (set! g-ns-seen save-ns-seen)
                      (set! g-file-imports save-file-imports))))))))))
      (set! fc ((unsafe/cast ptr:Node fc) cdr)))))

(defn emit-def-rmacro (call:(raw Node)):void
  (let (cc:ptr:Node (unsafe/cast ptr:Node call))
    (when (!= (node-len cc) 3)
      (die-at (cc line) "def-rmacro: expects (def-rmacro \"prefix\" symbol)"))
    (let (prefix-node:ptr:Node (unsafe/cast ptr:Node (node-at cc 1))
          sym-node:ptr:Node (unsafe/cast ptr:Node (node-at cc 2)))
      (when (!= (prefix-node kind) NODE-STR)
        (die-at (prefix-node line) "def-rmacro: prefix must be a string"))
      (when (!= (sym-node kind) NODE-SYM)
        (die-at (sym-node line) "def-rmacro: wrap symbol must be a symbol"))
      (register-rmacro (prefix-node s) (sym-node s)))))

; Stage 12 namespaces. Validate an `(ns NAME)` form and set the current
; namespace. `ns` is deliberately minimal — it sets the namespace and nothing
; else (no Clojure-style :require). A second `ns` in the same unit (the per-unit
; g-ns-seen guard) warns at compile time but is silent under the REPL flag
; (g-interactive), where redefinition is the norm. Cross-unit "namespace already
; exists" tracking is a later concern (it needs the N2 import-graph machinery).
(defn emit-ns (form:(raw Node)):void
  (let (ff:ptr:Node (unsafe/cast ptr:Node form))
    ; The form cell carries the real source line; interned symbol nodes (the
    ; namespace name) have line 0, so use (ff line) for every diagnostic.
    (when (!= (node-len form) 2)
      (die-at (ff line) "ns: expected (ns name)"))
    (let (name-node:ptr:Node (unsafe/cast ptr:Node (node-at form 1)))
      (when (!= (name-node kind) NODE-SYM)
        (die-at (ff line) "ns: namespace must be a symbol"))
      (when (!= (strchr (name-node s) 47) null)
        (die-at (ff line) "ns: namespace name may not contain a slash"))
      ; Stage 14 UN-2: `unsafe` is a reserved pseudo-namespace (design/stage14/
      ; unsafe-namespace.md D1) — the `unsafe/<op>` heads are routed by special-
      ; form dispatch identity, not real namespace resolution, so no user
      ; namespace may ever claim the `unsafe/` key.
      (when (= (name-node s) "unsafe")
        (die-at (ff line) "'unsafe' is a reserved namespace name"))
      ; Stage 15 W5e: `#…` is the reserved shape for the implicit per-file
      ; namespace that keys a file's private definers (`#p1`, `#p2`, …). Keeping
      ; it unspellable is what guarantees a synthetic key can never collide with
      ; a user one.
      (when (= (char-at (name-node s) 0) 35)
        (die-at (ff line) "ns: a namespace name may not begin with '#' (reserved for file-private scopes)"))
      ; A second `ns` in this unit warns (compile) / is silent (REPL).
      (when (!= g-ns-seen 0)
        (when (= g-interactive 0)
          (fprintf stderr "%s:%d: warning: %s\n" g-source-path
                   (ff line)
                   (fmt-s "second ns directive; namespace re-set to '%s'"
                          (name-node s)))))
      (set! g-current-ns (intern-str (name-node s)))
      (set! g-ns-seen 1)
      ; Stage 15 B2a (name-resolution.md §9.1): this is the one point at which a
      ; file's namespace becomes known, and it is reached from every file entry —
      ; the root, `do-import`'s two load blocks, and `prescan-imported-signatures`
      ; (via `apply-leading-ns`). Recording here is what gives `resolve-spelling`
      ; the prefix → namespace half `ImportBind` does not carry, including on the
      ; already-loaded and W1d cycle-skip paths, which never enter a load block.
      (file-ns-record g-source-path g-current-ns)
      (set! g-ns-declared 1))))

; Stage 12 N4: `(set-ir-prefix "prefix")` overrides the IR-mangling prefix for the
; current namespace (design/stage12/namespaces.md §"Export", decision 7). A null or
; empty string means *no* prefix — bare ir-names, the escape hatch for hand-written
; C-ABI libraries — and is recorded as the empty string so ns-ir-prefix returns it
; verbatim (overriding the namespace-name default). The prefix is sanitized to a
; C-legal identifier exactly as the namespace-name default is, so a slash lowers to
; `__`. Takes effect for symbols defined after this directive in the unit; like
; `ns`, a library conventionally places it at the top.
(defn emit-set-ir-prefix (form:(raw Node)):void
  (let (ff:ptr:Node (unsafe/cast ptr:Node form))
    (when (!= (node-len form) 2)
      (die-at (ff line) "set-ir-prefix: expected (set-ir-prefix \"prefix\")"))
    (let (arg:ptr:Node (unsafe/cast ptr:Node (node-at form 1))
          prefix:ptr "")
      ; Accept a string literal (the common form) or the bare symbol/nil for the
      ; empty escape hatch. A string literal is the documented spelling.
      (cond
        (= (arg kind) NODE-STR) (set! prefix (arg s))
        (and (= (arg kind) NODE-SYM) (= (arg s) "null")) (set! prefix "")
        true (die-at (ff line) "set-ir-prefix: argument must be a string literal"))
      ; Empty → bare; otherwise sanitize the override to a C-legal prefix. Both are
      ; interned so the table key/value compare by pointer identity downstream.
      (if (= (char-at prefix 0) 0)
        (ns-ir-prefix-set g-current-ns (intern-str ""))
        (ns-ir-prefix-set g-current-ns (intern-str (ns-prefix-sanitize prefix)))))))

; Stage 14 AVR-5 (design/stage14/avr-targets.md §5 AVR-5): `(fn-attr <name>
; "<attr>" …)` attaches one or more LLVM string function attributes to the `defn`
; named <name>, appended inline to that function's emitted `define` line. It is
; deliberately generic — the AVR ISR use ("signal"/"interrupt", what clang lowers
; `__attribute__((signal))` to) is the first case; later uses include "noinline",
; "section", "used". The attribute value is stored and emitted verbatim (LLVM
; accepts arbitrary string attributes), so the grammar admits any string.
;
; Registered in the fn-attr table keyed by the SOURCE name and consumed at
; emit-defn time. There is no forward-reference prescan for this table, so a
; `fn-attr` directive MUST appear BEFORE the `defn` it targets in the unit
; (house-style precedent: emit-set-ir-prefix, likewise an order-sensitive
; top-level directive). In the default `user` namespace the source name equals
; the emitted @-symbol, so no ir-name plumbing is needed.
(defn emit-fn-attr (form:(raw Node)):void
  (let (ff:ptr:Node (unsafe/cast ptr:Node form))
    (when (< (node-len form) 3)
      (die-at (ff line) "fn-attr: expected (fn-attr <name> \"attr\" ...)"))
    (let (name-node:ptr:Node (unsafe/cast ptr:Node (node-at form 1)))
      (when (!= (name-node kind) NODE-SYM)
        (die-at (node-line (as ptr name-node) (ff line))
                "fn-attr: first argument must be a function name symbol"))
      (let (fname:ptr (name-node s)
            i:i32 2
            n:i32 (node-len form))
        (while (< i n)
          (let (arg:ptr:Node (unsafe/cast ptr:Node (node-at form i)))
            (when (!= (arg kind) NODE-STR)
              (die-at (node-line (as ptr arg) (ff line))
                      "fn-attr: each attribute must be a string literal"))
            ; Intern the attribute so the stored pointer is stable and canonical
            ; (it is only ever printed, never identity-compared). `fname` is
            ; already the interned symbol spelling, matching emit-defn's `fname`.
            (fn-attr-add fname (intern-str (arg s))))
          (inc! i))))))

; Stage 12 N5: `(export sym1 sym2 ...)` re-exports an explicit list of symbols
; under the host namespace's qualified name. Each symbol must already be in scope
; (e.g. imported via `import-prefixed`) using its qualified spelling (`ns/name`).
; The bare name part is extracted with `strip-ns-qualifier` and re-defined in
; the current namespace so `g-current-ns/bare-name` resolves to the same
; type and ir-name — a pure resolution alias, no code emitted. Idempotent:
; `scope-define` (via `import-alias-one`'s pattern) silently no-ops on a
; re-export of the same symbol.
(defn emit-export (form:(raw Node)):void
  (let (ff:ptr:Node (unsafe/cast ptr:Node form))
    (when (< (node-len form) 2)
      (die-at (ff line) "export: expected (export sym ...)"))
    (let (i:i32 1
          n:i32 (node-len form))
      (while (< i n)
        (let (arg:ptr:Node (unsafe/cast ptr:Node (node-at form i)))
          (when (!= (arg kind) NODE-SYM)
            (die-at (node-line (as ptr arg) (ff line)) "export: each argument must be a symbol"))
          ; Stage 15 B5: resolve through the shared table, then re-register
          ; through the interface. A name that IS defined but in a registry
          ; `export` cannot re-bind (a macro, a special form) gets the §11.6
          ; explanation from `binding-re-register` instead of the misleading
          ; "symbol not found".
          ;
          ; Stage 15 B3′: take the first hit whose row is actually
          ; `reregisterable`, falling through the rest — the same solitary-generic
          ; fall-through `emit-dispatch` performs, and for the same reason: a
          ; solitary `defn` answers on BOTH `g-generics` (row 3) and `g-globals`
          ; (row 4), and only the second carries the Sym a re-export binds. Without
          ; the fall-through a bare `(export f)` inside a facade that flattened the
          ; library reported *"'f' is a function — only functions … can be
          ; re-exported"*, a self-contradicting message; `lib/nsgfacade.nuc` never
          ; hit it only because it spells its arguments qualified, and a qualified
          ; spelling misses the bare-keyed generic registry.
          (let (spelling:ptr (arg s)
                lin:i32 (node-line (as ptr arg) (ff line))
                first:?ref:BindingHit (binding-find (as CStr spelling) g-globals
                                                    0 BINDING-KIND-COUNT 0 NK-NONE)
                hit:?ref:BindingHit null
                k:i32 0)
            (when (= (as ptr first) null)
              (die-at lin (fmt-s "export: symbol not found: '%s'" spelling)))
            (while (< k BINDING-KIND-COUNT)
              (let (h2:?ref:BindingHit (binding-find (as CStr spelling) g-globals
                                                     k BINDING-KIND-COUNT 0 NK-NONE))
                (when (= (as ptr h2) null) (set! k BINDING-KIND-COUNT))
                (when (!= (as ptr h2) null)
                  (let (hh2:ptr:BindingHit (unsafe/cast ptr:BindingHit h2))
                    (if (!= ((binding-row (hh2 kind)) reregisterable) 0)
                      (do (set! hit h2) (set! k BINDING-KIND-COUNT))
                      (set! k (+ (hh2 kind) 1)))))))
            ; Nothing re-registerable: report against the FIRST hit, so the
            ; diagnostic names the kind the author actually wrote.
            (when (= (as ptr hit) null) (set! hit first))
            ; Strip the source namespace qualifier to get the bare name, then
            ; let the re-register qualify it against g-current-ns.
            (let (bare:ptr (strip-ns-qualifier spelling)
                  hh:ptr:BindingHit (unsafe/cast ptr:BindingHit hit))
              (binding-re-register (hh kind) (hh payload) (as CStr bare) lin))))
        (inc! i)))))

; Consume a leading `(ns NAME)` directive, setting the current namespace for the
; rest of the unit. Mirrors strip-exclude-prelude's first-form handling: the
; directive is only honored as the first form. Returns the forms with the
; directive consumed, or the original forms if absent. A non-leading `ns` (e.g. a
; second one) is left for the dispatch loop, which routes it back to emit-ns.
(defn apply-leading-ns (forms:(raw Node)):(raw Node)
  (when (= (is-leading-ns forms) 0) (return forms))
  (emit-ns ((unsafe/cast ptr:Node forms) car))
  (return ((unsafe/cast ptr:Node forms) cdr)))

; Stage 12 N4: scan forms for the first `set-ir-prefix` that appears before any
; defining form (`defn`, `defvar`, `defstruct`, etc.) and apply it now, before
; the prescans. `set-ir-prefix` conventionally appears at the top of a file
; (after `ns`); applying it here ensures `finalize-generics` — called at the end
; of `prescan-defn-signatures` — picks up the correct prefix when baking the
; ir-name into the Generic's solitary method. The form is left in the list so
; the dispatch loop re-processes it (a harmless idempotent re-set). Stops at
; the first definer so a mid-file `set-ir-prefix` retains in-order semantics.
(defn apply-early-set-ir-prefix (forms:(raw Node)):void
  (let (fc:ptr forms)
    (while (!= fc null)
      (let (f:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node fc) car)))
        (when (and (!= (as ptr f) null)
                   (= (f kind) NODE-CELL)
                   (> (node-len (as ptr f)) 0)
                   (= (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind)) NODE-SYM))
          (let (h:ptr (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ s)))
            (cond
              (= h "set-ir-prefix")
                (do (emit-set-ir-prefix (as ptr f)) (return))
              ; Stop scanning at any definer — a mid-file set-ir-prefix keeps
              ; in-order semantics and is handled solely by the dispatch loop.
              (or (= h "defn")
                  (= h "defn-")
                  (= h "defvar")
                  (= h "defvar-"))
                (return)))))
      (set! fc ((unsafe/cast ptr:Node fc) cdr)))))

; ============================================================
; Stage 15 W8 G-3 — @__nucleus_init (design/global-init.md §5, §4.8)
; ============================================================

; Emit every queued runtime initializer into ONE nullary function named `sym`.
; Returns 1 if a function was emitted, 0 if the queue was empty — and when it is
; empty, not one byte is written. This function is where the zero-cost
; guarantee lives: the queue, the function and (in the caller) the registration
; global are the complete set of artefacts the runtime half produces, and all
; three are produced here and nowhere else in the pipeline.
;
; `g-out` must already be the definition stream. `internal` picks LLVM linkage:
; the batch path wants `internal` (the symbol is reachable only through
; `llvm.global_ctors`, and two Nucleus objects must not collide on it), the
; REPL wants external so `LLVMOrcLLJITLookup` can find it.
;
; Each job restores the namespace and source path its `defvar` was reached in
; before its `set!` is emitted, so a name resolves — and any diagnostic is
; located — exactly as it would have at the `defvar` itself. That is why the
; job record carries them: the drain happens at the end of the outermost unit,
; long after those globals have moved on.
(defn init-emit-function (sym:ptr internal:i32):i32
  (when (>= g-init-drained (count g-init-worklist)) (return 0))
  (reset-function-state)
  (let (save-ns:ptr g-current-ns
        save-path:ptr g-source-path
        save-line:i32 g-form-line)
    (let (fn-scope:ref:Scope (scope-new g-globals))
      (while (< g-init-drained (count g-init-worklist))
        (let (job:ptr:InitJob (as ptr:InitJob (invoke g-init-worklist g-init-drained)))
          (inc! g-init-drained)
          (set! g-current-ns (job ns))
          (set! g-source-path (job path))
          (set! g-form-line (job line))
          (emit-node (as ptr (job form)) fn-scope))))
    (set! g-current-ns save-ns)
    (set! g-source-path save-path)
    (set! g-form-line save-line))
  (when (= g-block-term 0)
    (fprintf g-body-stream "  ret void\n"))
  (fclose g-entry-stream)
  (fclose g-body-stream)
  (if (!= internal 0)
    (fprintf g-out "define internal void @%s() {\n" sym)
    (fprintf g-out "define void @%s() {\n" sym))
  (fprintf g-out "entry:\n")
  (when (and (!= g-entry-bufp null) (!= (char-at g-entry-bufp 0) 0))
    (fputs g-entry-bufp g-out))
  (when (and (!= g-body-bufp null) (!= (char-at g-body-bufp 0) 0))
    (fputs g-body-bufp g-out))
  (fprintf g-out "}\n\n")
  (free g-entry-bufp)
  (free g-body-bufp)
  (set! g-entry-bufp null)
  (set! g-body-bufp null)
  (return 1))

; The batch drain, called once per compilation at `emit-toplevel-forms` depth 1
; — the one point at which every top-level form of every reachable file has been
; walked, so "is the queue empty?" is EXACT rather than an over- or
; under-approximation (§4.8). An empty queue returns here having written
; nothing, which is why a program with no runtime initializer is byte-for-byte
; what it was before this feature existed.
(defn drain-init-worklist ():void
  (when (>= g-init-drained (count g-init-worklist)) (return))
  ; §4.5: the REPL is NOT a triple case. Its modules are JITed, and LLVM 19's
  ; ORC C API has no initializer entry point (§2.9), so an appended
  ; `llvm.global_ctors` here would be precisely the silently-dead section §4.6
  ; refuses on AVR — the initializer would be emitted, registered, and never
  ; run. The REPL drains this same queue itself (`repl-emit-init-fn`) and CALLS
  ; the function once the module is JITed; leaving the queue intact here is what
  ; routes an `import-use`d library's initializer through that path as well as a
  ; directly typed `defvar`'s. Measured: without this the imported global read
  ; back 0.
  (when (!= g-interactive 0) (return))
  ; A target with no verified append-only startup mechanism refuses, naming the
  ; `defvar` that made the queue non-empty (§4.6). Reported before anything is
  ; emitted, so a NONE target never carries a dead constructor.
  (when (= (ctor-mechanism-for-triple g-target-triple) CTOR-NONE)
    (let (job:ptr:InitJob (as ptr:InitJob (invoke g-init-worklist g-init-drained)))
      (set! g-source-path (job path))
      (die-at (job line)
        (fmt-2s "defvar: '%s' needs a run-time initializer, and target '%s' has no startup-constructor mechanism -- give it a compile-time constant initializer, or declare it without one and assign it explicitly"
          (job name) g-target-triple))))
  (set! g-out g-def-stream)
  (when (!= (init-emit-function "__nucleus_init" 1) 0)
    ; The registration global, appended right here. This is the whole of
    ; "registration must be append-only": one global, emitted after the queue is
    ; known non-empty, so nothing about it can leak into a program that has no
    ; runtime initializer. It crosses translation units — a library object's
    ; `.init_array` entry runs even when `main` is in another TU and is not
    ; Nucleus at all (§2.4), which is the case no synthetic entry point covers.
    (fprintf g-def-stream
      "@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @__nucleus_init, ptr null }]\n\n")))

; Emit a list of top-level forms (pre-scan + dispatch loop).
; Used by main and by emit-import for recursive processing.
(defn emit-toplevel-forms (forms:(raw Node)):void
  (set! g-toplevel-depth (+ g-toplevel-depth 1))
  ; Stage 15 W1c: remember the unit's root file. It is the one file in the unit
  ; that appears on none of the import lists (nothing imports it), so
  ; `path-in-unit` would otherwise let the unreachable-file scan name it — a
  ; note saying "no import reaches your own entry point" is true and useless.
  (when (= g-toplevel-depth 1)
    (set! g-unit-entry-path g-source-path))
  ; Stage 15 W1a: has this file's protocol/signature prescan already been done by
  ; the whole-graph walk below? Sampled BEFORE the walk runs, and keyed on the
  ; file path (`g-source-path` is set to the resolved path by do-import before it
  ; calls us; the outermost unit's own path is never on the list, since the walk
  ; only records *imported* files). Registration is not idempotent — see
  ; g-prescan-sigs — so the answer decides whether the two prescans run at all.
  (let (sigs-done:i32 (import-list-has g-prescan-sigs g-source-path))
  ; Stage 12: a leading `(ns NAME)` sets the unit's namespace BEFORE the
  ; prescans register any names, so global keys (and forward references) are
  ; qualified consistently from the first definition onward.
  (set! forms (apply-leading-ns forms))
  ; Stage 12 N4: apply a leading `set-ir-prefix` before prescans so
  ; `finalize-generics` sees the correct ir-prefix when baking ir-names.
  (apply-early-set-ir-prefix forms)
  ; Outermost unit only: pre-register imported types so this unit's defn
  ; signatures can name prelude types and the !T sugar (nested units' imports
  ; are already processed in dependency order by the time they are reached).
  ; Stage 15 B3′: this file's own import environment, before any prescan that
  ; resolves a NAME. Cheap (no file is read) and idempotent with `do-import`.
  (prescan-file-imports forms)
  (when (= g-toplevel-depth 1)
    (prescan-imported-types forms))
  ; Stage 15 W3c: the unit's explicit `(declare …)` names, collected before any
  ; import is processed so the "explicit declare wins over a header-derived one"
  ; rule is order-independent (cheader.md §1.4). Per unit, not just the
  ; outermost: a source-imported library's declares outrank a header import that
  ; follows them, for the same reason.
  (prescan-explicit-declares forms)
  ; Stage 15 B5: protocols BEFORE struct names. `prescan-struct-names` registers
  ; a name-only StructDef and does not guard, so whichever of the two ran first
  ; won every `defprotocol`/`defstruct` name clash — and the struct always ran
  ; first, which is why the clash was reported at the PROTOCOL's line as
  ; "already names a type" (§2.5). `protocol-register-form` stores its method
  ; sigs verbatim and parses them lazily, so it needs no struct name to be
  ; registered yet; the reorder is safe by construction.
  (when (= sigs-done 0) (prescan-protocols forms))
  (prescan-struct-names forms)
  ; Stage 15 W1a: skip when the whole-graph walk already registered this file's
  ; protocols and signatures. `finalize-generics` still runs at exactly the point
  ; prescan-defn-signatures would have called it, so a generic that gained methods
  ; since (a `.nuch` defmethod import, a REPL redefinition) is still mangled at the
  ; same moment as before — only the *registration* moved earlier.
  (if (= sigs-done 0)
    (do
      (prescan-defn-signatures forms)
      ; Stage 15 W8 G-0: this file's own value names, so a `defn` body may name a
      ; `defvar`/`defconst`/`defenum` member declared LATER in the same file. The
      ; unit's root file is on no import list, so this is the only place it is
      ; reached; an imported file already walked by prescan-imported-signatures
      ; takes the `sigs-done` branch and is not re-registered.
      (prescan-value-names forms))
    (finalize-generics))
  ; Stage 15 W1a: outermost unit only — register every reachable file's protocols
  ; and defn signatures now, so cross-file references resolve on reachability
  ; instead of import order. Runs AFTER this unit's own prescans so the whole
  ; registration sequence matches today's interleaved order (see the function's
  ; header comment); pass 1 (types) above must precede this unit's signatures and
  ; therefore stays where it is.
  (when (= g-toplevel-depth 1)
    (prescan-imported-signatures forms))
  (let (fc:ptr forms)
    (while (!= fc null)
      (let (f:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node fc) car)))
        (when (or (= (as ptr f) null)
                  (!= (f kind) NODE-CELL)
                  (= (node-len (as ptr f)) 0)
                  (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind) (!= _ NODE-SYM)))
              (die-at (node-line (as ptr f) ((unsafe/cast ptr:Node fc) line))
                      "top-level form must be a list starting with a symbol"))
        (let (h:ptr (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ s))
              hp:ptr (-> f (node-at _ 0)))
          (case hp
            'ns
              ; A leading `ns` is consumed by apply-leading-ns before the loop;
              ; reaching it here means a non-leading (e.g. second) `ns`, which
              ; emit-ns warns about (silent under the REPL) and re-sets.
              (emit-ns (as ptr f))
            'set-ir-prefix
              ; Stage 12 N4: override the current namespace's IR-mangling prefix.
              (emit-set-ir-prefix (as ptr f))
            'fn-attr
              ; Stage 14 AVR-5: register LLVM string function attributes for a
              ; later `defn` (must precede that defn in the unit; consumed at
              ; emit-defn time — no forward-reference prescan for the attr table).
              (emit-fn-attr (as ptr f))
            'export
              ; Stage 12 N5: re-export symbols under the host namespace's name.
              (emit-export (as ptr f))
            'defconst
              (emit-defconst (as ptr f))
            'defenum
              (emit-defenum (as ptr f))
            'deferror
              ; Stage 10 C3: emit-deferror now returns `!i32`; absorb the
              ; Result locally. On a malformed form the diagnostic has already
              ; printed at the fault site (report-at), so `exit 1` matches the
              ; old die-at abort. The cascade ends here — this dispatch stays
              ; `void` and emit-node is never threaded with `try`.
              (match (emit-deferror (as ptr f))
                ((ok _) 0)
                ((err e) (do (exit 1) 0)))
            'defvar
              ; Globals go to the def-stream rather than the decl-stream
              ; so they appear only in the main module IR. CT and macro
              ; JIT modules pull in g-decl-bufp but not g-def-bufp, and
              ; resolve global references back to the host process via
              ; the dylib generator. Otherwise prelude globals (from node
              ; / arena / intern table) would duplicate across modules.
              (do (set! g-out g-def-stream) (emit-defvar (as ptr f)))
            'defstruct
              (do (set! g-out g-type-stream) (emit-defstruct (as ptr f)))
            'defunion
              (do (set! g-out g-type-stream) (emit-defunion (as ptr f)))
            'defcast
              (emit-defcast (as ptr f))
            'extern
              (do (set! g-out g-decl-stream) (emit-extern (as ptr f)))
            'defn
              (do (set! g-out g-def-stream) (emit-defn (as ptr f)))
            'defprotocol
              ; Registered in prescan-protocols; emits no code.
              0
            'extend
              (emit-extend (as ptr f))
            'compile-time
              (emit-compile-time (as ptr f))
            'defmacro
              (emit-defmacro (as ptr f))
            'def-rmacro
              (emit-def-rmacro (as ptr f))
            ; Stage 12 N3: private definers — same as their public counterparts
            ; but with g-defining-private=1 set around the call. For link-emitting
            ; forms (defn-/defvar-) this drives internal LLVM linkage and sets
            ; sym-private on the Sym; compile-time-only forms just set sym-private
            ; on any Sym they register (defenum-/defconst-) or have no Sym at all
            ; (defstruct-/defunion-/defmacro-/defprotocol-).
            'defconst-
              (do (set! g-defining-private 1)
                  (emit-defconst (as ptr f))
                  (set! g-defining-private 0))
            'defenum-
              (do (set! g-defining-private 1)
                  (emit-defenum (as ptr f))
                  (set! g-defining-private 0))
            'defvar-
              (do (set! g-defining-private 1)
                  (set! g-out g-def-stream)
                  (emit-defvar (as ptr f))
                  (set! g-defining-private 0))
            'defstruct-
              (do (set! g-defining-private 1)
                  (set! g-out g-type-stream)
                  (emit-defstruct (as ptr f))
                  (set! g-defining-private 0))
            'defunion-
              (do (set! g-defining-private 1)
                  (set! g-out g-type-stream)
                  (emit-defunion (as ptr f))
                  (set! g-defining-private 0))
            'defn-
              (do (set! g-defining-private 1)
                  (set! g-out g-def-stream)
                  (emit-defn (as ptr f))
                  (set! g-defining-private 0))
            'defprotocol-
              ; Registered in prescan-protocols; emits no code.
              ; The private flag is honored by prescan-protocols (N3).
              0
            'defmacro-
              (do (set! g-defining-private 1)
                  (emit-defmacro (as ptr f))
                  (set! g-defining-private 0))
            'import
              (emit-import (as ptr f))
            'import-use
              (emit-import-use (as ptr f))
            'import-only
              (emit-import-only (as ptr f))
            'import-prefixed
              (emit-import-prefixed (as ptr f))
            ; Stage 14 UN-5: bare `unsafe-import-private` is retired (D6);
            ; `unsafe/import-private` keeps calling the same emitter as before.
            'unsafe-import-private
              (die-at (f line) "'unsafe-import-private' was split in Stage 14: use 'unsafe/import-private'")
            'unsafe/import-private
              (emit-unsafe-import-private (as ptr f))
            'declare
              (do (set! g-out g-decl-stream) (emit-nuch-declare-import (as ptr f)))
            (die-at (f line) (fmt-s "unknown top-level form: %s" h)))))
      (set! fc ((unsafe/cast ptr:Node fc) cdr))))
  ; A2: type-check generic template bodies against their abstract protocol
  ; interface. Only at the outermost level — every import has now registered its
  ; names/protocols/conformances and g-source-path is back to this unit — and
  ; before the worklist drain, so a body error lands at the defn (ahead of any A1
  ; stamp-time error from instantiation).
  (when (= g-toplevel-depth 1)
    (check-generic-templates)
    ; Stage 15 W8 G-3: synthesize @__nucleus_init from the runtime-initializer
    ; queue. Depth 1 only — every reachable file has been walked by now, so the
    ; queue is complete — and BEFORE the mono drain, so a generic instantiated
    ; by an initializer body is emitted by the drain that follows.
    (drain-init-worklist))
  ; Emit the bodies of any generic instantiations these forms triggered.
  (drain-mono-worklist)
  ; Stage 15 B6: admit every `(dyn P)` a file wrote. Last, and depth 1 only —
  ; by here every reachable file has been read (including one reached only
  ; through a string-path import, which no prescan walks) and every protocol it
  ; declares is registered, which is precisely what the annotation site did not
  ; have. Emits nothing, so unlike `drain-init-worklist` it has no JIT hazard;
  ; the REPL takes the immediate path in `dyn-annot-record` instead.
  (when (= g-toplevel-depth 1) (drain-dyn-annots))
  (set! g-toplevel-depth (- g-toplevel-depth 1))))

; Check if a path is in a Node-based string list.
(defn import-list-has (list:(raw Node) path:CStr):i32
  (let (cur:ptr list)
    (while (!= cur null)
      (let (entry:ptr:Node (unsafe/cast ptr:Node cur))
        (when (= (entry s) path)
          (return 1))
        (set! cur (entry cdr))))
    (return 0)))

; Stage 12: find a path's record in a Node-based string list, or null. The
; loaded-file list (g-imported) packs the global-scope slice the file
; contributed into the record (start in `i`, end in `line`) so a later import of
; the same file under a *different* prefix can alias those already-loaded symbols
; without re-emitting the file's code.
(defn import-list-find (list:(raw Node) path:CStr):ptr
  (let (cur:ptr list)
    (while (!= cur null)
      (let (entry:ptr:Node (unsafe/cast ptr:Node cur))
        (when (= (entry s) path)
          (return cur))
        (set! cur (entry cdr))))
    (return null)))

; Push a path onto a Node-based string list, return new head.
; (Returns a fresh non-null cell; spelled :ptr because Node is a prelude type
; and the toplevel signature prescan runs before the prelude import — see
; design/stage10/nullability.md N2 friction notes.)
(defn import-list-push (list:(raw Node) path:CStr):ptr
  (let (n:ref:Node (new Node))
    (.set! n kind NODE-STR)
    (.set! n line 0)
    (.set! n i 0)
    (.set! n s path)
    (.set! n car null)
    (.set! n cdr list)
    (return n)))

; Stage 12: push a loaded-file record that also carries the [start, end) slice of
; the global scope the file contributed (start in `i`, end in `line`). A later
; prefix import of the same file reuses the slice to inject fresh aliases without
; re-processing — and re-emitting — the file's definitions.
(defn import-list-push-slice (list:(raw Node) path:CStr start:i32 end:i32):ptr
  (let (n:ref:Node (new Node))
    (.set! n kind NODE-STR)
    (.set! n line end)
    (.set! n i (as i64 start))
    (.set! n s path)
    (.set! n car null)
    (.set! n cdr list)
    (return n)))

; Remove the head of a Node-based string list, return new head.
(defn import-list-pop (list:(raw Node)):ptr
  (when (= list null) (return null))
  (return ((unsafe/cast ptr:Node list) cdr)))

; Stage 15 W1d (Option 2). Record a circular import that was *skipped* rather
; than rejected: `path` is the cycle partner that is already mid-import, and the
; file doing the importing is whatever `g-source-path` names right now.
;
; Stage 15 B2b dropped the second list this kept (prefix → suppressed path).
; It existed because a skipped re-entry has no global-scope slice, so
; `inject-import-aliases` injected nothing and a `prefix/name` spelling resolved
; nowhere. With injection deleted, a prefix names the file rather than a slice
; and resolves across a cycle like any other reference.
;
; The list is diagnostic-only and grows at most once per cycle edge, so this
; costs nothing on a compiling program and cannot perturb emitted IR.
(defn note-import-cycle (path:CStr line:i32):void
  (let (n:ref:Node (new Node))
    (.set! n kind NODE-STR)
    (.set! n line line)
    (.set! n i 0)
    (.set! n s path)
    (.set! n car (unsafe/cast ptr:Node g-source-path))
    (.set! n cdr g-import-cycles)
    (set! g-import-cycles (as ptr n))))

; Is `path` a member of some import cycle this unit skipped? (Either end of the
; edge counts — a cycle is symmetric, and the diagnostics want to know "is this
; file entangled", not "which way did the skip point".)
(defn path-in-import-cycle (path:CStr):i32
  (let (cur:ptr g-import-cycles)
    (while (!= cur null)
      (let (e:ptr:Node (unsafe/cast ptr:Node cur))
        (when (= (as CStr (e s)) path) (return 1))
        (when (and (!= (as ptr (e car)) null)
                   (= (as CStr (as ptr (e car))) path))
          (return 1))
        (set! cur (e cdr)))))
  (return 0))

; The cycle partner recorded for `path`, i.e. the other file of the edge — used
; to name both files in a diagnostic. Null when `path` is in no skipped cycle.
(defn import-cycle-partner (path:CStr):ptr
  (let (cur:ptr g-import-cycles)
    (while (!= cur null)
      (let (e:ptr:Node (unsafe/cast ptr:Node cur))
        (when (= (as CStr (e s)) path) (return (as ptr (e car))))
        (when (and (!= (as ptr (e car)) null)
                   (= (as CStr (as ptr (e car))) path))
          (return (e s)))
        (set! cur (e cdr)))))
  (return null))

; Search every skipped-cycle file for a top-level definer of `name`, using the
; same textual scan W1c's unreachable-file note uses. Returns the defining path
; or null. `want-type` selects the type namespace, exactly as in
; `unreachable-definer-file`.
(defn cycle-definer-file (name:CStr want-type:i32):ptr
  (let (cur:ptr g-import-cycles)
    (while (!= cur null)
      (let (e:ptr:Node (unsafe/cast ptr:Node cur))
        (when (!= (file-defines-name (as CStr (e s)) name want-type) 0)
          (return (e s)))
        (when (and (!= (as ptr (e car)) null)
                   (!= (file-defines-name (as CStr (as ptr (e car))) name want-type) 0))
          (return (as ptr (e car))))
        (set! cur (e cdr)))))
  (return null))

; Test whether a file exists by attempting to open it.
(defn file-exists (path:CStr):i32
  (let (f:ptr (fopen path "r"))
    (when (= f null) (return 0))
    (fclose f)
    (return 1)))

; Try to find a file by name in the import search path.
; Search order: directory of current source file; lib/ relative to cwd;
; -I include paths; $NUCLEUS_LIB; the compiled-in default install path.
; The last two let an installed compiler find its standard libraries
; (macros, prelude, …) when run from an arbitrary working directory.
(defn try-import-path (filename:CStr):ptr
  ; Try directory of the current source file
  (let (pathlen:i64 (as i64 (strlen g-source-path))
        last-slash:i64 -1)
    (dotimes (i pathlen)
      (when (= (char-at g-source-path i) 47)
        (set! last-slash i)))
    (when (>= last-slash 0)
      (let (dir:ptr (strndup g-source-path last-slash)
            candidate:ptr (fmt-2s "%s/%s" dir filename))
        (when (!= (file-exists candidate) 0)
          (return candidate)))))
  ; Try lib/ relative to cwd
  (let (candidate:ptr (fmt-s "lib/%s" filename))
    (when (!= (file-exists candidate) 0)
      (return candidate)))
  ; Try -I include paths
  (do
    (dotimes (j (unsafe/cast i32 (count g-include-paths)))
      (let (candidate:ptr (fmt-2s "%s/%s" (invoke g-include-paths (as usize j)) filename))
        (when (!= (file-exists candidate) 0)
          (return candidate)))))
  ; Try $NUCLEUS_LIB (a single directory; lets a custom-PREFIX install be found)
  (let (libenv:ptr (getenv "NUCLEUS_LIB"))
    (when (!= libenv null)
      (let (candidate:ptr (fmt-2s "%s/%s" libenv filename))
        (when (!= (file-exists candidate) 0)
          (return candidate)))))
  ; Try the compiled-in default install path (default-prefix `make install`)
  (let (candidate:ptr (fmt-s "/usr/local/share/nucleus/lib/%s" filename))
    (when (!= (file-exists candidate) 0)
      (return candidate)))
  (return null))

; Resolve an import name to a .nuc or .nuch file path.
; Tries .nuc first, then .nuch. Returns null if neither found.
(defn resolve-import (name:CStr line:i32):ptr
  (let (nuc-path:ptr (try-import-path (fmt-s "%s.nuc" name)))
    (when (!= nuc-path null) (return nuc-path)))
  (let (nuch-path:ptr (try-import-path (fmt-s "%s.nuch" name)))
    (when (!= nuch-path null) (return nuch-path)))
  (return null))

; Stage 12 (design/stage12/namespaces.md §"Import"): import dedup is keyed on
; (file, prefix), not file alone — the same library may be imported under two
; prefixes (aliasing), but the same prefix from two imports is an error and a
; re-import of the same (file, prefix) is a no-op. Build the composite key.
; A null/empty prefix (the flatten `import-use`/`include`/`import` path) returns
; the bare path unchanged, so its dedup key — and the whole bootstrap — stays
; byte-identical to before namespaces. The newline separator cannot appear in a
; file path or a symbol prefix, so the composite is unambiguous.
(defn import-key (path:CStr prefix:ptr):ptr
  (when (or (= prefix null) (= (char-at prefix 0) 0))
    (return path))
  (return (fmt-2s "%s\n%s" path prefix)))

; Stage 12 core import driver. Reads, parses, and processes all top-level forms
; from an imported Nucleus file or C header into the current compilation.
;
;   prefix == null  → flatten (the `import-use`/`include`/legacy-`import`
;                     behavior): every imported symbol enters g-globals under its
;                     own key and is directly visible. Dedup keyed on the file
;                     alone — byte-identical to pre-namespaces.
;   prefix != null  → prefix-qualified: the file is processed the same way, then
;                     each public symbol it added gets a `prefix/name` alias.
;                     Dedup keyed on (file, prefix).
;
; A string path (`(import "stdio.h" 'c)`) routes to C-header parsing; the default
; prefix for a string import is `c` (handled by the callers).
(defn do-import (form:(raw Node) name-node:(raw Node) prefix:ptr line:i32):void
  (let (nn:ptr:Node (unsafe/cast ptr:Node name-node))
    ; String path → C header (for .h paths) or Nucleus file (for .nuc/.nuch).
    ; C extern symbols keep bare `@name` ir-names; a prefix only adds aliases.
    (when (= (nn kind) NODE-STR)
      (let (spath:ptr (nn s))
        ; A .nuc or .nuch string path is a Nucleus file import. Fall through to
        ; the symbol-path branch using the string value directly as the path.
        (when (or (!= (str-ends-with spath ".nuc") 0)
                  (!= (str-ends-with spath ".nuch") 0))
          ; Synthesize a fake sym-name by stripping leading directories.
          (let (name:ptr (nn s)
                path:ptr (nn s))
            ; Jump to Nucleus file import logic (shared with NODE-SYM path).
            (when (= path null)
              (die-at line (fmt-s "import: cannot find '%s'" name)))
            ; Stage 15 B1: bind in the importing FILE's environment before any
            ; early return below. Every one of them — the (file, prefix) dedup,
            ; the already-loaded flatten dedup and the W1d cycle skip — leaves
            ; the import *declared here* even though it does no further work, and
            ; a file that declared an import must be able to use its prefix. The
            ; cycle case matters most: skipping the bind there would make
            ; `unbound-prefix-message` answer a question W1d's
            ; `cycle-prefix-message` already answers correctly.
            (file-import-record prefix path)
            ; Prefix-level dedup: this exact (file, prefix) has already been aliased.
            (when (and (!= prefix null)
                       (!= (import-list-has g-import-aliased (import-key path prefix)) 0))
              (return))
            ; Two different imports may not share a prefix (design decision 5).
            (when (!= prefix null)
              (let (bound:ptr (import-list-find g-import-prefixes prefix))
                (when (and (!= bound null) (!= ((unsafe/cast ptr:Node bound) car) path))
                  (die-at line
                    (fmt-2s "import: prefix '%s' is already bound to '%s'"
                            prefix ((unsafe/cast ptr:Node bound) car))))))
            (let (loaded:ptr (import-list-find g-imported path))
              (when (and (= prefix null) (!= loaded null))
                (return))
              (let (start-len:i32 0
                    end-len:i32 0)
                (if (!= loaded null)
                  (do (set! start-len (unsafe/cast i32 ((unsafe/cast ptr:Node loaded) i)))
                      (set! end-len ((unsafe/cast ptr:Node loaded) line)))
                  (do
                    ; Stage 15 W1d (Option 2): a cycle is legal. The partner is
                    ; mid-emission higher up this stack and will finish on its
                    ; own; every cross-file reference already resolves from the
                    ; whole-graph signature prescan (W1a), so there is nothing
                    ; left to do here. Record the edge for the diagnostics that
                    ; cover the three emission-time couplings a cycle cannot
                    ; satisfy (macros, layouts, prefix aliases) and return —
                    ; deliberately WITHOUT recording the path on g-imported,
                    ; which stays the "finished" list.
                    (when (!= (import-list-has g-importing path) 0)
                      (note-import-cycle path line)
                      (return))
                    (set! start-len ((as ptr:Scope g-globals) len))
                    (let (save-src:ptr g-src
                          save-pos:i64 g-pos
                          save-line:i32 g-line
                          save-path:ptr g-source-path
                          save-peek:ptr g-peek
                          save-peek-valid:i32 g-peek-valid
                          save-ns:ptr g-current-ns
                          save-ns-seen:i32 g-ns-seen
                          ; Stage 15 B1: the imported file gets its OWN import
                          ; environment — this save/clear/restore is what makes
                          ; a prefix file-scoped rather than unit-scoped.
                          save-file-imports:(raw (Vector (ref ImportBind))) g-file-imports)
                      (set! g-importing (import-list-push g-importing path))
                      (let (src:ptr (read-file path))
                        (set! g-source-path path)
                        (set! g-src src)
                        (set! g-pos 0)
                        (set! g-line 1)
                        (set! g-peek-valid 0)
                        (set! g-current-ns (intern-str "user"))
                        (set! g-ns-seen 0)
                        (set! g-file-imports null)
                        (let (forms:ptr (desugar (read-program-or-die))
                              is-nuch:i32 (str-ends-with path ".nuch"))
                          (if (!= is-nuch 0)
                            (emit-nuch-import-forms forms)
                            (emit-toplevel-forms forms))
                          (free src)))
                      (set! g-importing (import-list-pop g-importing))
                      (set! g-source-path save-path)
                      (set! g-src save-src)
                      (set! g-pos save-pos)
                      (set! g-line save-line)
                      (set! g-peek save-peek)
                      (set! g-peek-valid save-peek-valid)
                      (set! g-current-ns save-ns)
                      (set! g-ns-seen save-ns-seen)
                      (set! g-file-imports save-file-imports))
                    (set! end-len ((as ptr:Scope g-globals) len))
                    (set! g-imported
                          (import-list-push-slice g-imported path start-len end-len))))
                (when (!= prefix null)
                  (set! g-import-aliased
                        (import-list-push g-import-aliased (import-key path prefix)))
                  (let (pn:ref:Node (new Node))
                    (.set! pn kind NODE-STR)
                    (.set! pn line 0)
                    (.set! pn i 0)
                    (.set! pn s prefix)
                    (.set! pn car path)
                    (.set! pn cdr g-import-prefixes)
                    (set! g-import-prefixes (as ptr pn))))))
            (return)))
        ; Not a Nucleus file — treat as C header.
        ; A C header is re-preprocessed on each import; the extern registrar only
        ; adds a symbol to g-globals the FIRST time it sees it (and a header like
        ; <string.h> may already have surfaced `printf` via the prelude), so the
        ; g-globals delta is not a reliable list of the header's symbols, which is
        ; why the prefixed case used to drive `emit-c-include` in a collect mode
        ; and alias each name it saw.
        ;
        ; Stage 15 B2b: none of that is needed. A C header declares its symbols
        ; under bare `user` keys, and the header spelling has no `(ns …)`, so
        ; `import-path-ns` answers `user` and `c/printf` canonicalises straight
        ; back to `printf` — the same Sym, with its bare `@printf` ir-name
        ; (decision 8) — through the one resolver. Collect mode is gone with it.
        ;
        ; Stage 15 B1: a C header binds in the importing file's environment too —
        ; `(import-prefixed "stdio.h" c)` makes `c/` legal in *this* file only.
        ; There is no imported-file body here, so no environment to save.
        (file-import-record prefix spath)
        (set! g-out g-decl-stream)
        (emit-c-include spath line))
      (return))
    (when (!= (nn kind) NODE-SYM)
      (die-at line "import: name must be a symbol or string path"))
    (let (name:ptr (nn s)
          path:ptr (resolve-import name line))
      (when (= path null)
        (die-at line (fmt-s "import: cannot find '%s'" name)))
      ; Stage 15 B1: bind in the importing FILE's environment before any early
      ; return below — see the twin site in the string-path branch above.
      (file-import-record prefix path)
      ; Prefix-level dedup: this exact (file, prefix) has already been aliased.
      (when (and (!= prefix null)
                 (!= (import-list-has g-import-aliased (import-key path prefix)) 0))
        (return))
      ; Two different imports may not share a prefix (design decision 5): the same
      ; prefix is now claimed for a different file. The (file, prefix) no-op above
      ; already let a repeat of the identical import through, so reaching here with
      ; this prefix already bound means a genuine conflict.
      (when (!= prefix null)
        (let (bound:ptr (import-list-find g-import-prefixes prefix))
          (when (and (!= bound null) (!= ((unsafe/cast ptr:Node bound) car) path))
            (die-at line
              (fmt-2s "import: prefix '%s' is already bound to '%s'"
                      prefix ((unsafe/cast ptr:Node bound) car))))))
      ; Flatten-level dedup (byte-identical to pre-namespaces): the file is
      ; already loaded and there is no prefix to alias under, so nothing to do.
      (let (loaded:ptr (import-list-find g-imported path))
        (when (and (= prefix null) (!= loaded null))
          (return))
        ; Determine the file's global-scope slice. If already loaded, reuse the
        ; recorded slice (do NOT re-process — that would re-emit its definitions).
        ; Otherwise load it now and record the slice it contributes.
        (let (start-len:i32 0
              end-len:i32 0)
          (if (!= loaded null)
            (do (set! start-len (unsafe/cast i32 ((unsafe/cast ptr:Node loaded) i)))
                (set! end-len ((unsafe/cast ptr:Node loaded) line)))
            (do
              ; Cycle detection keys on the file alone — a file that is mid-import
              ; is circular regardless of prefix. Stage 15 W1d (Option 2): the
              ; cycle is legal and the re-entry is simply skipped; see the twin
              ; site in the string-path branch above for the reasoning.
              (when (!= (import-list-has g-importing path) 0)
                (note-import-cycle path line)
                (return))
              (set! start-len ((as ptr:Scope g-globals) len))
              ; Save reader state
              (let (save-src:ptr g-src
                    save-pos:i64 g-pos
                    save-line:i32 g-line
                    save-path:ptr g-source-path
                    save-peek:ptr g-peek
                    save-peek-valid:i32 g-peek-valid
                    ; Stage 12: the imported unit gets its own namespace state. It
                    ; starts in `user` (its own leading `ns`, if any, sets it) and
                    ; the importer's namespace is restored afterward, so neither
                    ; leaks across the boundary.
                    save-ns:ptr g-current-ns
                    save-ns-seen:i32 g-ns-seen
                    ; Stage 15 B1: and its own import environment — the
                    ; save/clear/restore below is what makes a prefix
                    ; file-scoped rather than unit-scoped (§2.4).
                    save-file-imports:(raw (Vector (ref ImportBind))) g-file-imports)
                ; Push onto importing stack
                (set! g-importing (import-list-push g-importing path))
                ; Read and parse the imported file
                (let (src:ptr (read-file path))
                  (set! g-source-path path)
                  (set! g-src src)
                  (set! g-pos 0)
                  (set! g-line 1)
                  (set! g-peek-valid 0)
                  (set! g-current-ns (intern-str "user"))
                  (set! g-ns-seen 0)
                  (set! g-file-imports null)
                  (let (forms:ptr (desugar (read-program-or-die))
                        is-nuch:i32 (str-ends-with path ".nuch"))
                    ; Process imported forms
                    (if (!= is-nuch 0)
                      (emit-nuch-import-forms forms)
                      (emit-toplevel-forms forms))
                    ; Free imported source buffer
                    (free src)))
                ; Pop from importing stack
                (set! g-importing (import-list-pop g-importing))
                ; Restore reader state
                (set! g-source-path save-path)
                (set! g-src save-src)
                (set! g-pos save-pos)
                (set! g-line save-line)
                (set! g-peek save-peek)
                (set! g-peek-valid save-peek-valid)
                (set! g-current-ns save-ns)
                (set! g-ns-seen save-ns-seen)
                (set! g-file-imports save-file-imports))
              (set! end-len ((as ptr:Scope g-globals) len))
              ; Record the loaded file and the slice it contributed.
              (set! g-imported
                    (import-list-push-slice g-imported path start-len end-len))))
          ; Prefixed import: inject `prefix/name` aliases over the file's slice and
          ; record (file, prefix) so a re-import under this prefix is a no-op, plus
          ; the prefix → file binding so a clashing prefix on another file errors.
          (when (!= prefix null)
            (set! g-import-aliased
                  (import-list-push g-import-aliased (import-key path prefix)))
            (let (pn:ref:Node (new Node))
              (.set! pn kind NODE-STR)
              (.set! pn line 0)
              (.set! pn i 0)
              (.set! pn s prefix)
              (.set! pn car path)
              (.set! pn cdr g-import-prefixes)
              (set! g-import-prefixes (as ptr pn)))))))))

; `import-use` — the flatten-everything import (design decision 5). The old
; `import`/`include` behavior, factored out so the legacy keywords can keep
; calling it unchanged (byte-identical bootstrap). Good for the REPL and for
; libraries; discouraged for deliberate API design. Signature: (import-use NAME)
; where NAME is a symbol (Nucleus file) or a string (C header path).
(defn emit-import-use (form:(raw Node)):void
  (let (ff:ptr:Node (unsafe/cast ptr:Node form))
    (when (!= (node-len form) 2)
      (die-at (ff line) "import-use: expected (import-use name)"))
    (do-import form (node-at form 1) null (ff line))))

; `import` keyword — the prefix-qualified import (Stage 12 N7 flip). The bare
; `import` keyword now means what `import-prefixed` means: it injects the
; imported library's public symbols as `prefix/name` alias keys, where the
; prefix defaults to the library's last path component (or `c` for a C-header
; string path) and may be overridden by an explicit second argument. The old
; flatten-everything behavior now lives only under `import-use`.
(defn emit-import (form:(raw Node)):void
  (emit-import-prefixed form))

; `import` with an optional prefix (design decision 5). Signature:
;   (import LIB)         → prefix defaults to LIB's last path component
;   (import LIB PREFIX)  → explicit prefix symbol
;   (import "hdr.h" 'c)  → C header; prefix defaults to `c`
; Injects the imported public symbols as `prefix/name` alias keys. After the
; N7 flip the bare `import` keyword binds here (via `emit-import`); the
; `import-prefixed` keyword remains as an explicit synonym and underlies
; `unsafe-import-private`.
; Stage 15 B3′: the prefix an `import`/`import-prefixed` form binds — the explicit
; second argument, else the default derived from the library spelling. Extracted
; from `emit-import-prefixed` so `prescan-file-imports` binds exactly what
; emission binds; deriving a default prefix in two places is the drift the shared
; -rule convention exists to prevent, and getting it wrong here is invisible (a
; prescan bind with a null prefix silently turns a PREFIXED import into a
; FLATTENING one, which leaks every name the library defines).
;
; Default prefix: a symbol defaults to its last dotted component (`foo.bar.baz` →
; `baz`; `foo/bar` keeps its name). A string path defaults to `c` only when it is
; a C HEADER — a `.nuc`/`.nuch` string path is a Nucleus file (do-import treats it
; as one) and defaults from its basename, exactly as the symbol spelling does.
;
; Stage 15 W1d: before that split, EVERY string import defaulted to `c`, so a
; second `.nuc` path import in one file died `prefix 'c' is already bound to
; '<first path>'` — naming a prefix the author never wrote, for a conflict that
; does not exist.
;
; Returns null only for a shape `emit-import-prefixed` goes on to reject.
(defn import-form-prefix (form:(raw Node) line:i32):ptr
  (let (n:i32 (node-len form))
    (when (or (< n 2) (> n 3)) (return null))
    (let (name-node:ptr:Node (unsafe/cast ptr:Node (node-at form 1)))
      (when (= n 3)
        (let (pn:ptr:Node (unsafe/cast ptr:Node (node-at form 2)))
          (when (!= (pn kind) NODE-SYM) (return null))
          (return (pn s))))
      (when (= (name-node kind) NODE-STR)
        (if (or (!= (str-ends-with (name-node s) ".nuc") 0)
                (!= (str-ends-with (name-node s) ".nuch") 0))
          (return (path-import-default-prefix (name-node s) line))
          (return "c")))
      (when (= (name-node kind) NODE-SYM)
        (return (import-default-prefix (name-node s))))
      (return null))))

(defn emit-import-prefixed (form:(raw Node)):void
  (let (ff:ptr:Node (unsafe/cast ptr:Node form)
        n:i32 (node-len form))
    (when (or (< n 2) (> n 3))
      (die-at (ff line) "import: expected (import lib [prefix])"))
    (let (name-node:ptr:Node (unsafe/cast ptr:Node (node-at form 1))
          prefix:ptr (import-form-prefix form (ff line)))
      (when (= n 3)
        (let (pn:ptr:Node (unsafe/cast ptr:Node (node-at form 2)))
          (when (!= (pn kind) NODE-SYM)
            (die-at (ff line) "import: prefix must be a symbol"))))
      (when (= prefix null)
        (die-at (ff line) "import: name must be a symbol or string path"))
      (when (!= (strchr prefix 47) null)
        (die-at (ff line) "import: prefix may not contain a slash"))
      (do-import form (as ptr name-node) prefix (ff line)))))

; Default prefix for a symbol import: the last component of a dotted module path
; (`foo.bar.baz` → `baz`). A bare name (or one with no dots) is its own prefix.
; Scans for the last `.` inline rather than via strrchr so it depends on no extra
; libc declaration beyond what `strlen`/the prelude already provide.
(defn import-default-prefix (name:CStr):ptr
  (let (n:i64 (as i64 (strlen name))
        last-dot:i64 -1)
    (dotimes (i n)
      (when (= (char-at name i) 46)
        (set! last-dot i)))
    (when (< last-dot 0) (return name))
    (return (arena-strdup (unsafe/ptr+ (as ptr:i8 name) (+ last-dot 1))))))

; Stage 15 W1d: default prefix for a `.nuc`/`.nuch` STRING-path import — the
; basename with its extension removed, then the same last-dotted-component rule
; the symbol spelling uses, so `(import "lib/list.nuc")` and `(import list)` both
; bind `list/…`. Note the path is used verbatim (do-import does not run
; resolve-import on a string path), so the basename is taken from what the author
; wrote; two paths with the same basename collide, which is the same
; already-bound diagnostic the symbol form gives and is fixed the same way — an
; explicit second operand.
(defn path-import-default-prefix (path:CStr line:i32):ptr
  (let (n:i64 (as i64 (strlen path))
        base:i64 0
        end:i64 (as i64 (strlen path)))
    (dotimes (i n)
      (when (= (char-at path i) 47)
        (set! base (+ i 1))))
    (if (!= (str-ends-with path ".nuch") 0)
      (set! end (- end 5))
      (when (!= (str-ends-with path ".nuc") 0) (set! end (- end 4))))
    (when (<= end base)
      (die-at line
        (fmt-2s "import: cannot derive a prefix from path '%s' -- give one explicitly, as (import \"%s\" name)" path path)))
    (let (stem:ptr (strndup (unsafe/ptr+ (as ptr:i8 path) base) (- end base)))
      (return (import-default-prefix (as CStr stem))))))

; `import-only` — import a concrete list of symbols (design decision 5).
; Signature: (import-only LIB SYM1 SYM2 ...). The listed symbols are brought in
; under their bare names in the current namespace. In N2 the flatten machinery
; already registers every imported symbol directly into g-globals (there is no
; per-import visibility gate until N3's privacy layer), so this currently behaves
; like `import-use`: the listed symbols are guaranteed available; the restriction
; to *only* those becomes enforceable when N3 adds private/visibility filtering.
(defn emit-import-only (form:(raw Node)):void
  (let (ff:ptr:Node (unsafe/cast ptr:Node form))
    (when (< (node-len form) 2)
      (die-at (ff line) "import-only: expected (import-only lib sym...)"))
    ; Process the library with flatten semantics; the explicit symbol list is the
    ; documented intent (and the N3 visibility filter's input).
    (do-import form (node-at form 1) null (ff line))))

; `unsafe-import-private` — prefixed import that also reaches a library's private
; symbols (design decision 5). Signature:
;   (unsafe-import-private LIB PREFIX & PRIVATESYMS)
; Stage 12 N3: sets g-import-include-private so inject-import-aliases exposes
; private symbols (sym-private=1) under the prefix. The listed PRIVATESYMS are
; advisory (not yet filtered) — any private symbol from the lib is aliased.
(defn emit-unsafe-import-private (form:(raw Node)):void
  (let (ff:ptr:Node (unsafe/cast ptr:Node form)
        n:i32 (node-len form))
    (when (< n 3)
      (die-at (ff line)
              "unsafe-import-private: expected (unsafe-import-private lib prefix sym...)"))
    (let (name-node:ptr:Node (unsafe/cast ptr:Node (node-at form 1))
          pn:ptr:Node (unsafe/cast ptr:Node (node-at form 2)))
      (when (!= (pn kind) NODE-SYM)
        (die-at (ff line) "unsafe-import-private: prefix must be a symbol"))
      (when (!= (strchr (pn s) 47) null)
        (die-at (ff line) "unsafe-import-private: prefix may not contain a slash"))
      (let (save-include-private:i32 g-import-include-private)
        (set! g-import-include-private 1)
        (do-import form (as ptr name-node) (pn s) (ff line))
        (set! g-import-include-private save-include-private)))))

; ============================================================
; Compiler initialization — shared by batch and REPL modes
; ============================================================

(defn register-rmacro (prefix:ptr wrap-sym:ptr):void
  (let (rm:ptr:RMacro (as ptr:RMacro (arena-alloc (sizeof RMacro))))
    (.set! rm prefix prefix)
    (.set! rm prefix-len (unsafe/cast i32 (strlen prefix)))
    (.set! rm wrap-sym wrap-sym)
    (conj g-rmacros rm)))

; G-5: appends to the vector it is handed — see add-binop's note.
(defn register-rmacro (v:(ref (Vector (ref RMacro))) prefix:StrView wrap-sym:CStr):void
  (let (rm:ptr:RMacro (as ptr:RMacro (arena-alloc (sizeof RMacro)))
        pp:ptr:StrView (addr-of prefix))
    (.set! rm prefix (as ptr (pp data)))
    (.set! rm prefix-len (unsafe/cast i32 (pp len)))
    (.set! rm wrap-sym wrap-sym)
    (conj v (as ref:RMacro rm))))

(defn build-rmacros ():(ref (Vector (ref RMacro)))
  (let (v:(ref (Vector (ref RMacro))) (vector-new-in (addr-of g-arena-alloc)))
    ; Register longest prefixes first for correct matching.
    (register-rmacro v "~@" "unquote-splice")
    (register-rmacro v "~" "unquote")
    (register-rmacro v "'" "quote")
    (register-rmacro v "`" "quasiquote")
    (register-rmacro v "@" "deref")
    (return v)))

; Register the built-in blanket protocols (§10.1). Hardcoded for now; a
; user-declarable blanket facility is parked in design/stage999-future.md.
; G-5: the two late-binding hooks `init-blanket` used to install are now
; CONSTANT initializers on their own defvars — the address of a function is a
; link-time constant, so the loader applies them and there is no install step
; left to forget. What remains here is the blanket-protocol name list.
(defn build-blanket ():(ref (Vector CStr))
  (let (v:(ref (Vector CStr))
          (unsafe/cast (ref (Vector CStr)) (vector-new-in (addr-of g-arena-alloc))))
    (conj v "Any")
    (conj v "Struct")
    (return v)))

; Register the LLVM backends the --target matrix can select (X86 + AArch64 +
; ARM, covering Linux/Darwin/Windows variants). Safe to call repeatedly.
(defn targets-init-all ():void
  (LLVMInitializeX86TargetInfo)
  (LLVMInitializeX86Target)
  (LLVMInitializeX86TargetMC)
  (LLVMInitializeX86AsmPrinter)
  (LLVMInitializeAArch64TargetInfo)
  (LLVMInitializeAArch64Target)
  (LLVMInitializeAArch64TargetMC)
  (LLVMInitializeAArch64AsmPrinter)
  (LLVMInitializeARMTargetInfo)
  (LLVMInitializeARMTarget)
  (LLVMInitializeARMTargetMC)
  (LLVMInitializeARMAsmPrinter)
  (LLVMInitializeAVRTargetInfo)
  (LLVMInitializeAVRTarget)
  (LLVMInitializeAVRTargetMC)
  (LLVMInitializeAVRAsmPrinter)
  (LLVMInitializeRISCVTargetInfo)
  (LLVMInitializeRISCVTarget)
  (LLVMInitializeRISCVTargetMC)
  (LLVMInitializeRISCVAsmPrinter))

; LLVM RelocMode for a triple: Static(0) for AVR (a freestanding MCU target has
; no dynamic loader / GOT), PIC(2) otherwise (the hosted default). Keyed off the
; triple string alone, so every hosted target keeps its previous PIC behavior.
(defn reloc-for-triple (triple:ptr):i32
  (if (= (strncmp triple "avr" 3) 0) 0 2))

; The three triple-keyed target descriptor defaults for the "features cliff"
; (design/stage14/riscv-linux.md §1.2): with an empty CPU/features string LLVM
; codegens bare RV64I with a soft-float ABI that is *silently* incompatible with
; riscv64 glibc (lp64d). RV64GC / lp64d is the glibc baseline, so a riscv64 triple
; defaults to CPU generic-rv64, features +m,+a,+f,+d,+c, and the lp64d ABI. Every
; other triple keeps empty "" for all three (byte-identical hosted-target IR).

; Effective CPU: honor an explicit --mcpu (a non-empty `cpu`) so a future override
; is never clobbered; otherwise pick the per-triple default.
(defn cpu-for-triple (triple:ptr cpu:ptr):ptr
  (when (!= (char-at cpu 0) 0) (return cpu))
  (when (= (strncmp triple "riscv64" 7) 0) (return "generic-rv64"))
  (return cpu))

; LLVMCreateTargetMachine features string, keyed on the triple.
(defn features-for-triple (triple:ptr):ptr
  (when (= (strncmp triple "riscv64" 7) 0) (return "+m,+a,+f,+d,+c"))
  (return ""))

; LLVM "target-abi" module-flag value, keyed on the triple.
(defn abi-for-triple (triple:ptr):ptr
  (when (= (strncmp triple "riscv64" 7) 0) (return "lp64d"))
  (return ""))

; Stage 15 W8 G-3 (design/global-init.md §4.6, §4.8): how a synthesized
; `@__nucleus_init` gets run before `main`. Two v1 answers, and a mechanism
; qualifies only if it can be emitted ENTIRELY at the drain point, appending to
; the module — which is what rules a synthesized `main` wrapper out of v1 (the
; rename would have to happen in `emit-defn`, long before the queue's emptiness
; is known, and `main` is only conventionally the last form).
(defconst CTOR-NONE 0)
(defconst CTOR-GLOBAL-CTORS 1)

; Keyed off the triple string alone, the same idiom as reloc-/cpu-/features-/
; abi-for-triple above.
;
; AVR gets NONE, and that is a measurement, not caution (§2.6): LLVM emits
; `.init_array` into AVR's *data* region while avr-libc's `__do_global_ctors`
; walks `__ctors_start..__ctors_end`, which the linker leaves empty — so the
; constructor is emitted, linked, occupies RAM and never executes, with no
; diagnostic anywhere. Under the zero-cost rule that is doubly wrong: it spends
; exactly the resource the rule exists to protect. A non-empty queue on a NONE
; target is therefore a located error naming the offending `defvar`, never a
; dead section. Whether a `section ".ctors"` global with the word-address
; relocation avr-gcc's linker script collects would work is the one open
; question this design leaves; if it does, AVR gains a third answer here and
; nothing else changes.
(defn ctor-mechanism-for-triple (triple:ptr):i32
  (when (= (strncmp triple "avr" 3) 0) (return CTOR-NONE))
  (return CTOR-GLOBAL-CTORS))

; Resolve `triple` to a Target descriptor, pulling the datalayout string and
; pointer size from LLVM so emitted IR matches the target ABI. `cpu` is the
; --mcpu name ("" for host targets); the effective cpu/features/abi are the
; triple-keyed defaults resolved above (folding an explicit --mcpu in first).
; ptr-align is derived from the datalayout via LLVMABIAlignmentOfType on a `ptr`
; type rather than assumed == ptr-size: x86-64/aarch64 answer 8 either way, AVR 1.
; AVR-6: parse the program address space from an LLVM datalayout string. The
; datalayout is a `-`-separated list of tokens; the program-memory address-space
; token is exactly `P<n>` (e.g. `P1` on AVR: `e-P1-p:16:8-…`). Scans for a `P` at
; a token boundary (string start or immediately after a `-`, never a bare
; substring `P`), reads the following decimal digits, and returns that value; 0
; when no such token exists (every hosted/RISC-V datalayout has no `P` segment).
(defn datalayout-prog-as (dl:ptr):i32
  (when (= dl null) (return 0))
  (let (n:i64 (as i64 (strlen dl))
        i:i64 0)
    (while (< i n)
      ; 'P' == 80; token boundary is start-of-string or a preceding '-' (45).
      (when (and (= (char-at dl i) 80)
                 (or (= i 0) (= (char-at dl (- i 1)) 45)))
        (let (j:i64 (+ i 1)
              val:i32 0
              got:i32 0)
          ; digits '0'..'9' == 48..57
          (while (and (< j n)
                      (>= (char-at dl j) 48)
                      (<= (char-at dl j) 57))
            (set! val (+ (* val 10) (- (char-at dl j) 48)))
            (set! got 1)
            (inc! j))
          (when (!= got 0) (return val))))
      (inc! i))
    (return 0)))

(defn make-target-for-triple (triple:ptr cpu:ptr):ref:Target
  (let (target:ptr null
        terr:ptr null
        tres:i32 (LLVMGetTargetFromTriple triple (addr-of target) (addr-of terr)))
    (when (!= tres 0)
      (fprintf stderr "nucleusc: target lookup failed for '%s': %s\n" triple terr)
      (LLVMDisposeMessage terr)
      (exit 1))
    (let (eff-cpu:ptr (cpu-for-triple triple cpu)
          eff-features:ptr (features-for-triple triple)
          eff-abi:ptr (abi-for-triple triple))
    (let (tm:ptr (LLVMCreateTargetMachine target triple eff-cpu eff-features 0 (reloc-for-triple triple) 0))
      (when (= tm null)
        (fprintf stderr "nucleusc: failed to create TargetMachine for '%s'\n" triple)
        (exit 1))
      (let (td:ptr (LLVMCreateTargetDataLayout tm)
            tgt:ptr:Target (as ptr:Target (arena-alloc (sizeof Target))))
        (let (dl-str:ptr (LLVMCopyStringRepOfTargetData td)
              psize:i32 (LLVMPointerSize td)
              ptr-ty:ptr (LLVMPointerType (LLVMInt8Type) 0)
              palign:i32 (LLVMABIAlignmentOfType td ptr-ty))
          (.set! tgt triple triple)
          (.set! tgt datalayout dl-str)
          (.set! tgt ptr-size psize)
          (.set! tgt ptr-align palign)
          (.set! tgt cpu eff-cpu)
          (.set! tgt features eff-features)
          (.set! tgt abi eff-abi)
          ; AVR-6: program address space from the datalayout `P<n>` token (1 on
          ; AVR, 0 everywhere else). Gates the function-value diagnostic.
          (.set! tgt prog-as (datalayout-prog-as dl-str)))
        (LLVMDisposeTargetData td)
        (LLVMDisposeTargetMachine tm)
        (return (as ref:Target tgt)))))))

; Populate g-host-target (always native) and g-target (== host unless
; --target=<triple> overrides). Derives g-target-triple / g-target-ptr-bytes so
; the rest of codegen, which predates the Target struct, sees the right values.
(defn target-init ():void
  (targets-init-all)
  (let (host-triple:ptr (LLVMGetDefaultTargetTriple))
    (set! g-host-target (make-target-for-triple host-triple ""))
    (if (= g-target-triple-override null)
      (set! g-target g-host-target)
      ; Normalize the --mcpu string in a value position (StrView literal ""
      ; collapses to its data ptr on set!): a mixed StrView/ptr value-position
      ; `if` would join to void and emit a bad call argument.
      (let (mcpu:ptr g-mcpu-override)
        (when (= mcpu null) (set! mcpu ""))
        (set! g-target (make-target-for-triple g-target-triple-override mcpu)))))
  (let (tg:ptr:Target (as ptr:Target g-target)
        hg:ptr:Target (as ptr:Target g-host-target))
    (set! g-target-triple (tg triple))
    (set! g-target-ptr-bytes (tg ptr-size))
    (set! g-host-ptr-bytes (hg ptr-size))))

; Build the two name-kind membership sets used by special-form-named and
; primitive-type-named. Each runs once, as its global's own initializer, before
; any parsing occurs. The sets are heap-malloc'd and never dropped (batch-process lifetime).
; Each set is allocated from the shared arena (one raw->ref cast per set) and
; initialised with hashset-init-alloc so it owns its buffers through g-arena-alloc
; (never dropped, process-lifetime). Members are inserted as bare string literals
; (already CStr), and the typed globals need no per-insert cast.
; G-5: `init-name-sets` split into two value-returning builders, one per set —
; §4.4 item 1. Each still allocates through g-arena-alloc and is never dropped
; (process lifetime).
(defn build-special-form-set ():(ref (HashSet CStr))
  ; --- special-form-named set (86 members) ---
  ; Stage 15 B2b removed the seven `unsafe/*` whole-string entries UN-2 added:
  ; `unsafe` is a real built-in namespace now, so `special-form-named` answers
  ; for them through `unsafe-qualified-op` (resolve the qualifier, then the
  ; roster) instead of by string membership. The bare retired spellings (`cast`,
  ; `ptr+`, `funcall-ptr-*`, `unsafe-import-private`) stay in the set, still
  ; reserved so nothing may shadow them.
  (let (s:(ref (HashSet CStr))
          (unsafe/cast (ref (HashSet CStr))
            (alloc-handle-alloc (addr-of g-arena-alloc) (sizeof (HashSet CStr)) 8)))
  (hashset-init-alloc s (addr-of g-arena-alloc))
  (into s
    #{ ; control flow / binding
       "let" "with" "do" "cond" "return" "while"
       ; mutation
       "set!" "inc!" "dec!"
       ; memory / pointers
       "array" "label" "goto" "label-addr" "goto-ptr"
       "." ".&" "cast" "as" "addr-of" "deref"
       "ptr-set!" "ptr+" "_get" ".set!"
       "sizeof" "alloca" "aref" "aset!"
       ; literals / quoting
       "quote" "quasiquote" "char"
        ; logic
        "not" "_and" "_or"
       ; macros / functions
       "gensym" "funcall" "funcall-void"
       "funcall-ptr-1" "funcall-ptr-i32" "funcall-ptr-i64" "funcall-ptr-ptr"
       ; Stage 14 UN-2: reserved `unsafe/` pseudo-namespace spellings (D2) —
       ; each routes to the exact same emitter as its bare alias above. UN-5
       ; retired the bare aliases as dispatch-time hard errors (D6); the bare
       ; spellings stay in this set only so the names remain reserved (a defn/
       ; defvar/etc. still may not shadow them).
       ; option / result
       "some" "as-ref" "unwrap" "unwrap-or" "if-some" "when-some"
       ; ownership / control
       "move" "defer" "match" "make"
       ; error handling
       "defunion" "deferror" "err!" "err-name" "err-message"
       "type-token" "__err-handled" "signal"
       ; top-level definers
       "defn" "defvar" "defconst" "defenum" "defstruct"
       "defmacro" "defprotocol" "extend" "def-rmacro"
       ; Stage 12 N3: private definer variants (trailing `-`)
       "defn-" "defvar-" "defconst-" "defenum-" "defstruct-"
       "defmacro-" "defprotocol-" "defunion-"
       "import" "import-use" "import-only" "import-prefixed"
       "unsafe-import-private" "extern" "declare" "compile-time"
       ; Stage 12 N4: namespace IR-prefix override
       "set-ir-prefix"
       ; Stage 12 N5: re-export form
       "export"
       ; Stage 14 AVR-5: LLVM string function-attribute directive (reserved so a
       ; defn/defvar/etc. cannot shadow it).
       "fn-attr" }
    (HashSetIter CStr))
  (return s)))

; --- primitive-type-named set (19 members) ---
(defn build-primitive-type-set ():(ref (HashSet CStr))
  (let (s:(ref (HashSet CStr))
          (unsafe/cast (ref (HashSet CStr))
            (alloc-handle-alloc (addr-of g-arena-alloc) (sizeof (HashSet CStr)) 8)))
  (hashset-init-alloc s (addr-of g-arena-alloc))
  (into s
    #{ ; integer types
       "int" "bool" "i1" "i8" "i16" "i32" "i64"
       "ui8" "ui16" "ui32" "ui64"
       ; float types
       "f32" "f64" "float" "double"
       ; pointer / special
       "ptr" "void" "CStr" "Err" }
    (HashSetIter CStr))
  (return s)))

; Stage 15 W8 G-5 — `compiler-init` is gone (design/global-init.md §5 G-5,
; acceptance criterion (A)). Its 52 statements resolved as §2.12 measured them:
; 48 globals became combined declaration+initializations at their own `defvar`,
; 20 statements were dead restatements of the `defvar` zero default and were
; deleted, and exactly one — `(target-init)` — was genuinely special and is now
; called directly from `main` (and from `repl-main`) right after argv parsing.
;
; `target-init` is special for two independent reasons, both of which rule out
; expressing it as an initializer: it READS ARGV (`--target=` / `--mcpu=`, which
; `main`'s flag loop parses, and which a load-time initializer cannot see), and
; it sets FIVE globals from one call, deriving them from each other. That is
; configuration, not construction.

; ============================================================
; Emit quasiquote helpers (__cons / __append) into the given streams
; ============================================================

; The alignment to annotate on a store/load at byte `offset` into the __cons
; Node cell, given the target's maximum allocator/ABI pointer alignment `pa`
; (Target.ptr-align — 8 on hosts, 1 on AVR). This is gcd(offset, pa), with
; gcd(0, pa) := pa (the malloc base is pa-aligned). `pa` is always a power of
; two in practice, so for a non-zero offset the gcd is the largest power of two
; dividing `offset`, capped at `pa`. For pa=8 the six cell offsets 0,4,8,16,24,32
; give 8,4,8,8,8,8 — the historical hand-written literals — so hosted output is
; byte-identical; for pa=1 every field becomes align 1 (AVR, byte-addressable).
(defn qq-cell-align (offset:i32 pa:i32):i32
  (when (= offset 0) (return pa))
  (let (a:i32 1)
    (while (and (< a pa) (= (% offset (* a 2)) 0))
      (set! a (* a 2)))
    (return a)))

; Emit the quasiquote runtime helpers @__cons / @__append into the *target*
; module streams. The Node cell layout is the fixed literal struct
; { i32, i32, i64, ptr, ptr, ptr }; LLVM resolves each field's byte offset from
; that type against the module's target datalayout, so the getelementptr index
; lines are target-independent. Only two things are target-derived (Stage 14
; AVR-2): the malloc byte size and the per-store/load `align`. The i32/i32/i64
; header is a fixed 16 bytes on every target (4+4, then i64 at offset 8, no
; padding under any datalayout that aligns i64 at ≤8 bytes), and the three
; trailing pointer fields each add ptr-size bytes → total = 16 + 3*ptr-size
; (40 on 8-byte hosts, 22 on AVR). Alignments come from qq-cell-align at the six
; field offsets (0,4,8, then 16, 16+ptr-size, 16+2*ptr-size). Hosted output is
; byte-identical (malloc 40, align 8/4/8/8/8/8); this closes the long-standing
; 32-bit/16-bit target blocker (stage9/cleanup.md).
(defn emit-qq-helpers (decl:ptr def:ptr):void
  (when (= g-malloc-decl-done 0)
    (fprintf decl "declare ptr @malloc(i64)\n"))
  (let (psize:i32 ((as ptr:Target g-target) ptr-size)
        pa:i32    ((as ptr:Target g-target) ptr-align)
        cell-size:i32 (+ 16 (* 3 psize))
        a0:i32 (qq-cell-align 0 pa)
        a1:i32 (qq-cell-align 4 pa)
        a2:i32 (qq-cell-align 8 pa)
        a3:i32 (qq-cell-align 16 pa)
        a4:i32 (qq-cell-align (+ 16 psize) pa)
        a5:i32 (qq-cell-align (+ 16 (* 2 psize)) pa))
    (fprintf def "define ptr @__cons(ptr %%a, ptr %%b) {\n")
    (fprintf def "  %%c = call ptr @malloc(i64 %d)\n" cell-size)
    (fprintf def "  %%p0 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%c, i32 0, i32 0\n")
    (fprintf def "  store i32 3, ptr %%p0, align %d\n" a0)
    (fprintf def "  %%p1 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%c, i32 0, i32 1\n")
    (fprintf def "  store i32 0, ptr %%p1, align %d\n" a1)
    (fprintf def "  %%p2 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%c, i32 0, i32 2\n")
    (fprintf def "  store i64 0, ptr %%p2, align %d\n" a2)
    (fprintf def "  %%p3 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%c, i32 0, i32 3\n")
    (fprintf def "  store ptr null, ptr %%p3, align %d\n" a3)
    (fprintf def "  %%p4 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%c, i32 0, i32 4\n")
    (fprintf def "  store ptr %%a, ptr %%p4, align %d\n" a4)
    (fprintf def "  %%p5 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%c, i32 0, i32 5\n")
    (fprintf def "  store ptr %%b, ptr %%p5, align %d\n" a5)
    (fprintf def "  ret ptr %%c\n")
    (fprintf def "}\n\n")
    (fprintf def "define ptr @__append(ptr %%a, ptr %%b) {\n")
    (fprintf def "entry:\n")
    (fprintf def "  %%z = icmp eq ptr %%a, null\n")
    (fprintf def "  br i1 %%z, label %%nil, label %%rec\n")
    (fprintf def "nil:\n")
    (fprintf def "  ret ptr %%b\n")
    (fprintf def "rec:\n")
    (fprintf def "  %%p4 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%a, i32 0, i32 4\n")
    (fprintf def "  %%car = load ptr, ptr %%p4, align %d\n" a4)
    (fprintf def "  %%p5 = getelementptr inbounds { i32, i32, i64, ptr, ptr, ptr }, ptr %%a, i32 0, i32 5\n")
    (fprintf def "  %%cdr = load ptr, ptr %%p5, align %d\n" a5)
    (fprintf def "  %%rest = call ptr @__append(ptr %%cdr, ptr %%b)\n")
    (fprintf def "  %%c = call ptr @__cons(ptr %%car, ptr %%rest)\n")
    (fprintf def "  ret ptr %%c\n")
    (fprintf def "}\n\n")))

; ============================================================
; Open fresh memstreams for a compilation unit
; ============================================================

(defn open-module-streams ():void
  (set! g-type-stream (open_memstream (addr-of g-type-bufp) (as ptr (addr-of g-type-sizep))))
  (set! g-decl-stream (open_memstream (addr-of g-decl-bufp) (as ptr (addr-of g-decl-sizep))))
  (set! g-def-stream  (open_memstream (addr-of g-def-bufp)  (as ptr (addr-of g-def-sizep))))
  (set! g-decl-out g-decl-stream)
  (set! g-macro-decls (unsafe/cast (ref (Vector CStr)) (vector-new-in (addr-of g-arena-alloc))))
  (set! g-program-defns (vector-new-in (addr-of g-arena-alloc))))

; ============================================================
; Close module streams, output IR to stdout (batch mode)
; ============================================================

; Assemble the full module IR into a heap-allocated buffer. Caller must free
; the returned pointer (g-type-bufp/g-decl-bufp/g-def-bufp are also freed).
; Stores the buffer length through `len-out` (pointer to i64).
(defn assemble-module-ir (source-file:ptr len-out:ptr):ptr
  (let (ir-bufp:ptr null  ir-sizep:i64 0
        irs:ptr (open_memstream (addr-of ir-bufp) (as ptr (addr-of ir-sizep))))
    (fprintf irs "; ModuleID = '%s'\n" source-file)
    (fprintf irs "source_filename = \"%s\"\n" source-file)
    (fprintf irs "target datalayout = \"%s\"\n" ((as ptr:Target g-target) datalayout))
    (fprintf irs "target triple = \"%s\"\n" g-target-triple)
    ; RV-1: pin the psABI in the module (survives --emit-llvm; llc errors loudly
    ; on a target-abi flag without the matching float feature rather than
    ; miscompiling). Emitted only when the descriptor carries a non-empty abi, so
    ; every existing hosted-target module is byte-for-byte unchanged (no flags
    ; block at all — the blank line below reproduces the prior "\n\n").
    (let (target-abi:ptr ((as ptr:Target g-target) abi))
      (when (!= (char-at target-abi 0) 0)
        (fprintf irs "!llvm.module.flags = !{!0}\n")
        (fprintf irs "!0 = !{i32 1, !\"target-abi\", !\"%s\"}\n" target-abi)))
    (fprintf irs "\n")
    (when (and (!= g-type-bufp null) (!= (char-at g-type-bufp 0) 0))
      (fputs g-type-bufp irs))
    (emit-string-table irs)
    (emit-deferror-table irs)
    (when (and (!= g-decl-bufp null) (!= (char-at g-decl-bufp 0) 0))
      (fputs g-decl-bufp irs))
    (when (and (!= g-def-bufp null) (!= (char-at g-def-bufp 0) 0))
      (fputs g-def-bufp irs))
    (fclose irs)
    (free g-type-bufp)
    (free g-decl-bufp)
    (free g-def-bufp)
    (aset! (as ptr:i64 len-out) 0 ir-sizep)
    (return ir-bufp)))

; Parse the in-memory IR, emit an object file, and (unless -c) invoke clang
; to link a final binary. Exits with a non-zero status on failure.
(defn compile-and-link (ir:ptr ir-len:i64 source-file:ptr):void
  ; Backends are already registered process-wide by targets-init-all (called from
  ; target-init, which runs before this on every batch code path),
  ; so no per-call target init is needed here.
  (let (ctx:ptr (LLVMContextCreate)
        mb:ptr  (LLVMCreateMemoryBufferWithMemoryRangeCopy ir ir-len source-file)
        mod:ptr null
        parse-err:ptr null
        rc:i32 (LLVMParseIRInContext ctx mb (addr-of mod) (addr-of parse-err)))
    (when (!= rc 0)
      (fprintf stderr "nucleusc: failed to parse generated IR: %s\n" parse-err)
      (LLVMDisposeMessage parse-err)
      (exit 1))

    (let (target:ptr null
          terr:ptr null
          tres:i32 (LLVMGetTargetFromTriple g-target-triple (addr-of target) (addr-of terr)))
      (when (!= tres 0)
        (fprintf stderr "nucleusc: target lookup failed: %s\n" terr)
        (LLVMDisposeMessage terr)
        (exit 1))
      ; CodeGenLevel = g-opt-level, Reloc keyed on triple (Static(0) for AVR,
      ; PIC(2) otherwise), CodeModel = Default(0). CPU and features from the Target
      ; descriptor (empty "" for host targets; the effective --mcpu / triple-keyed
      ; features for a cross-target, e.g. generic-rv64 / +m,+a,+f,+d,+c for riscv64).
      (let (tm:ptr (LLVMCreateTargetMachine target g-target-triple
                     ((as ptr:Target g-target) cpu)
                     ((as ptr:Target g-target) features) g-opt-level
                     (reloc-for-triple g-target-triple) 0))
        (let (out-path:ptr g-output-path
              obj-path:ptr null
              keep-obj:i32 g-emit-obj)
          (when (= out-path null)
            (set! out-path (if (!= g-emit-obj 0) "out.o" "a.out")))
          (if (!= g-emit-obj 0)
            (set! obj-path out-path)
            (set! obj-path (fmt-s "%s.o" out-path)))
          (let (emit-err:ptr null
                eres:i32 (LLVMTargetMachineEmitToFile tm mod obj-path 1 (addr-of emit-err)))
            (when (!= eres 0)
              (fprintf stderr "nucleusc: failed to emit object file '%s': %s\n"
                obj-path emit-err)
              (LLVMDisposeMessage emit-err)
              (exit 1)))
          (LLVMDisposeTargetMachine tm)
          (when (= keep-obj 0)
            ; Build the link command: <driver> [-mmcu=<device>] <obj> -o <out>
            ;   [link-args...]. The driver defaults to clang for hosted triples,
            ; avr-gcc for an AVR triple, and riscv64-linux-gnu-gcc when
            ; CROSS-compiling to riscv64-linux (the Debian cross toolchain — it
            ; carries the riscv64 sysroot + crt startup objects, which clang
            ; would need an explicit --sysroot for; riscv64 needs no extra
            ; command-line flag beyond the driver name, unlike AVR's -mmcu
            ; device selection). The --sysroot need is a cross artifact only: on
            ; a riscv64 HOST the sysroot is /, so the hosted clang default links
            ; natively with no flag, and the triplet-prefixed cross name is a
            ; Debian-family convention no other riscv64 distro guarantees. Hence
            ; the host-triple guard; AVR is never a host, so it needs none.
            ; --linker=<cmd> overrides any of them (wins regardless of triple).
            ; On an AVR triple a -mmcu=<device> flag is inserted, the device
            ; being --mmcu if given else --mcpu (no device table — a family
            ; --mcpu without --mmcu lets avr-gcc fail on its own, per
            ; design/stage14/avr-targets.md §5 AVR-3). driver:ptr is initialised
            ; to the StrView literal "clang" and overridden via statement-form
            ; set! (a mixed StrView/ptr value-position `if` would join to void
            ; and emit a bad call argument — the same idiom target-init uses for
            ; the --mcpu string). AVR and riscv64 triple prefixes are mutually
            ; exclusive, so the two set!s never both fire.
            (let (driver:ptr "clang"
                  host-triple:ptr ((as ptr:Target g-host-target) triple)
                  is-avr:i32 (if (= (strncmp g-target-triple "avr" 3) 0) 1 0)
                  is-riscv:i32 (if (= (strncmp g-target-triple "riscv64" 7) 0) 1 0)
                  host-is-riscv:i32 (if (= (strncmp host-triple "riscv64" 7) 0) 1 0))
              (when (!= is-avr 0)
                (set! driver "avr-gcc"))
              (when (and (!= is-riscv 0) (= host-is-riscv 0))
                (set! driver "riscv64-linux-gnu-gcc"))
              (when (!= g-linker-override null)
                (set! driver g-linker-override))
              (let (cmd-bufp:ptr null  cmd-sizep:i64 0
                    cmds:ptr (open_memstream (addr-of cmd-bufp) (as ptr (addr-of cmd-sizep))))
                (fprintf cmds "%s" driver)
                (when (!= is-avr 0)
                  (let (device:ptr g-mmcu-override)
                    (when (= device null) (set! device g-mcpu-override))
                    (when (!= device null)
                      (fprintf cmds " -mmcu=%s" device))))
                (fprintf cmds " %s -o %s" obj-path out-path)
                (dotimes (j (unsafe/cast i32 (count g-link-args)))
                  (fprintf cmds " %s" (invoke g-link-args (as usize j))))
                (fclose cmds)
                (let (rc2:i32 (system cmd-bufp))
                  (free cmd-bufp)
                  (when (!= rc2 0)
                    (fprintf stderr "nucleusc: link step failed (%s exit %d)\n" driver rc2)
                    (exit 1)))))
            (unlink obj-path)))))))

; Close module streams; emit either textual IR (--emit-llvm) or an object/binary.
(defn flush-module-ir (source-file:ptr):void
  (when (!= g-qq-used 0)
    (emit-qq-helpers g-decl-stream g-def-stream))
  (drain-pending-union-irs)
  (fclose g-type-stream)
  (fclose g-decl-stream)
  (fclose g-def-stream)
  (let (ir-len:i64 0
        ir:ptr (assemble-module-ir source-file (as ptr (addr-of ir-len))))
    (if (!= g-emit-llvm 0)
      (do
        (fputs ir (as ptr stdout))
        (free ir))
      (do
        (compile-and-link ir ir-len source-file)
        (free ir)))))


; ============================================================
; Main entry point
; ============================================================

; Detect a leading (exclude-prelude) directive in the parsed form list.
; If present, returns the rest of the forms (with the directive consumed).
; If absent, returns null to signal "auto-prepend prelude".
;
; The directive must be the first form in the file. It takes no arguments;
; presence anywhere else is treated as a normal (and unknown) top-level form.
(defn strip-exclude-prelude (forms:(raw Node)):ptr
  (when (= forms null) (return null))
  (let (first:ptr ((unsafe/cast ptr:Node forms) car))
    (when (= first null) (return null))
    (when (!= ((unsafe/cast ptr:Node first) kind) NODE-CELL) (return null))
    (when (!= (node-len first) 1) (return null))
    (let (head:ptr (node-at first 0))
      (when (= head null) (return null))
      (when (!= ((unsafe/cast ptr:Node head) kind) NODE-SYM) (return null))
      (when (!= ((unsafe/cast ptr:Node head) s) "exclude-prelude")
        (return null))
      (return ((unsafe/cast ptr:Node forms) cdr)))))

; True if the first form is a leading `(ns NAME)` directive. Stage 12: the
; prelude import is spliced AFTER such a directive so that `ns` stays the unit's
; first form (apply-leading-ns then consumes it before the prescans).
(defn is-leading-ns (forms:(raw Node)):i32
  (when (= forms null) (return 0))
  (let (first:ptr ((unsafe/cast ptr:Node forms) car))
    (when (= first null) (return 0))
    (when (!= ((unsafe/cast ptr:Node first) kind) NODE-CELL) (return 0))
    (let (head:ptr (node-at first 0))
      (when (= head null) (return 0))
      (when (!= ((unsafe/cast ptr:Node head) kind) NODE-SYM) (return 0))
      (when (!= ((unsafe/cast ptr:Node head) s) "ns") (return 0))
      (return 1))))

; Prepend a synthetic (import-use prelude) cell onto the given forms list. The
; auto-prelude flattens the prelude's symbols into the unit under their bare
; names (`import-use`, not the prefix-qualified `import`). If the unit opens with
; a leading `(ns NAME)`, the prelude import is spliced in just after it,
; preserving `ns` as the first form so apply-leading-ns sees it.
(defn prepend-prelude-import (forms:(raw Node)):ptr
  (let (import-sym:ptr (intern-symbol "import-use")
        name-sym:ptr   (intern-symbol "prelude")
        name-cell:ptr  (make-cell name-sym null 0)
        import-form:ptr (make-cell import-sym name-cell 0))
    (when (!= (is-leading-ns forms) 0)
      ; forms = (ns ...) . rest ; result = (ns ...) . (import-use prelude) . rest
      (let (ns-cell:ptr forms
            rest:ptr ((unsafe/cast ptr:Node forms) cdr))
        (.set! (unsafe/cast ptr:Node ns-cell) cdr (make-cell import-form rest 0))
        (return ns-cell)))
    (return (make-cell import-form forms 0))))

; Called from argv parsing in `main`. These used to be lazily constructed here,
; which — because argv parsing ran before `compiler-init` armed the allocator —
; left the `-I`/`-l` vectors libc-backed for their whole lifetime while every
; other compiler collection was arena-backed (the split `context/build.md`
; recorded). G-5 removes both halves of that: `g-arena-alloc` is a load-time
; constant, and these vectors are built by `@__nucleus_init`, which the loader
; runs before `main` is entered. So the lazy guard is gone and the backing is
; uniform.
(defn add-include-path (path:ptr):void
  (conj g-include-paths (as CStr path)))

(defn add-link-arg (arg:ptr):void
  (conj g-link-args (as CStr arg)))

(defn main (argc:i32 argv:ptr):int
  (let (source-file:ptr null
        i:i32 1)
    (while (< i argc)
      (let (arg:ptr (aref (as ptr:ptr argv) i))
        (cond (= arg "--emit-nuch")
                (set! g-emit-nuch 1)
              (= arg "--emit-cheader")
                (set! g-emit-cheader 1)
              (or (= arg "--emit-llvm") (= arg "-S"))
                (set! g-emit-llvm 1)
              (= arg "-c")
                (set! g-emit-obj 1)
              (= arg "-o")
                (do (inc! i)
                    (when (>= i argc)
                      (do (fprintf stderr "-o requires an argument\n") (return 2)))
                    (set! g-output-path (aref (as ptr:ptr argv) i)))
              (or (= arg "-i") (= arg "--interactive"))
                (set! g-interactive 1)
              (= arg "--repl-format=text")
                (set! g-repl-format 0)
              (= arg "--repl-format=json")
                (set! g-repl-format 1)
              (= arg "-O0")
                (set! g-opt-level 0)
              (= arg "-O1")
                (set! g-opt-level 1)
              (or (= arg "-O") (= arg "-O2"))
                (set! g-opt-level 2)
              (= arg "-O3")
                (set! g-opt-level 3)
              (= (strncmp arg "--target=" 9) 0)
                (set! g-target-triple-override (unsafe/ptr+ (as ptr:i8 arg) 9))
              (= (strncmp arg "--mcpu=" 7) 0)
                (set! g-mcpu-override (unsafe/ptr+ (as ptr:i8 arg) 7))
              (= (strncmp arg "--mmcu=" 7) 0)
                (set! g-mmcu-override (unsafe/ptr+ (as ptr:i8 arg) 7))
              (= (strncmp arg "--linker=" 9) 0)
                (set! g-linker-override (unsafe/ptr+ (as ptr:i8 arg) 9))
              (= (strncmp arg "--link-arg=" 11) 0)
                (add-link-arg (unsafe/ptr+ (as ptr:i8 arg) 11))
              (= (strncmp arg "-I" 2) 0)
                (if (> (as i64 (strlen arg)) 2)
                  ; -I/path/to/dir (no space)
                  (add-include-path (unsafe/ptr+ (as ptr:i8 arg) 2))
                  ; -I /path/to/dir (next arg)
                  (do (inc! i)
                      (when (>= i argc)
                        (do (fprintf stderr "-I requires an argument\n") (return 2)))
                      (add-include-path (aref (as ptr:ptr argv) i))))
              (or (= (strncmp arg "-l" 2) 0)
                  (= (strncmp arg "-L" 2) 0))
                (add-link-arg arg)
              (= (char-at arg 0) 45)
                (do (fprintf stderr "unknown flag: %s\n" arg) (return 2))
              true
                (if (= source-file null)
                  (set! source-file arg)
                  (do (fprintf stderr "unexpected argument: %s\n" arg) (return 2)))))
      (inc! i))

    ; REPL mode
    (when (!= g-interactive 0)
       (repl-main) (return 0))

    ; Batch mode — require source file
    (when (= source-file null)
       (fprintf stderr "usage: nucleusc [--emit-llvm|-S] [-c] [-O0|-O1|-O2|-O3] [-o <path>] [--target=<triple>] [--mcpu=<cpu>] [--mmcu=<device>] [--linker=<cmd>] [--link-arg=<arg>] [-l<lib>] [-L<dir>] [--emit-nuch] [--emit-cheader] [-i] [--repl-format=text|json] [-I<path>] <file.nuc>\n") (return 2))
    (set! g-source-path source-file)
    (let (src:ptr (read-file source-file))
      ; G-5: `compiler-init` is gone. Every global it used to build is now built
      ; by its own `defvar` initializer — the constants by the loader, the rest
      ; by `@__nucleus_init` before this function was entered. What is left is
      ; the one genuinely special case: `target-init` reads the `--target=` /
      ; `--mcpu=` flags the loop above just parsed, so it cannot run any earlier.
      (target-init)
      (assert-compiler-arena-backed)

      ; Lex/parse
      (set! g-src src)
      (set! g-pos 0)
      (set! g-line 1)

      (let (raw-forms:ptr (read-program-or-die))
      (let (forms:ptr (desugar raw-forms))

        ; Apply the standard prelude unless the source begins with
        ; (exclude-prelude). Skipped for header-emit modes, which only need
        ; declarations from the user's source.
        (when (and (= g-emit-nuch 0) (= g-emit-cheader 0))
          (let (after:ptr (strip-exclude-prelude forms))
            (if (!= after null)
              (set! forms after)
              (set! forms (prepend-prelude-import forms)))))

        ; .nuch header mode — emit declarations and exit
        (when (!= g-emit-nuch 0)
           (emit-nuch-header forms source-file)
              (return 0))

        ; C header mode — emit C declarations and exit
        (when (!= g-emit-cheader 0)
           (emit-cheader-header forms source-file)
              (return 0))

        ; Open module streams and compile
        (open-module-streams)
        (emit-toplevel-forms forms)
        ; Stage 15 B6: the deferred-worklist completeness check, asserted rather
        ; than argued. A dynamic-extent mechanism has no compile-time evidence
        ; its extent is complete (name-resolution.md §9.4), and an undrained
        ; `(dyn P)` admission job is a silently unclosed hole — the failure mode
        ; that is invisible to a tree in which nothing exercises it.
        (when (!= g-dyn-annots-drained (count g-dyn-annots))
          (fprintf stderr "nucleusc: internal error: %d (dyn P) annotation checks were never drained\n"
                   (unsafe/cast i32 (- (count g-dyn-annots) g-dyn-annots-drained)))
          (exit 1))
        (flush-module-ir source-file))))
    (return 0)))

; .nuch header emission and import — extracted from src/nucleusc.nuc.
;
; Provides:
;   * --emit-nuch output — write a .nuch header (S-expression declarations)
;     describing the current translation unit's exported forms.
;   * .nuch import processing — re-resolve declarations, methods, unions, and
;     conformances arriving through (import-use foo.nuch) / (import "foo.nuch" p).
;
; Source-imported by src/nucleusc.nuc. Depends on the compiler's internals
; (g-globals, prescans, the type/generic/conformance registries, the ABI
; lowering, and the namespace machinery) — this dependence is intentional, since
; the .nuch round-trip mirrors the same emit/register paths the batch driver uses.


; ============================================================
; .nuch header emission
; ============================================================

(import-use nucleus.node)
(import-use nucleus.intern)
(import-use nucleus.string)
(import-use nucleus.strview)
(import-use nucleus.fmt)
(import-use nucleus.arena)
(import-use nucleus.vector)
(import-use nucleus.strview-str)
(defn emit-nuch-list (form:ptr):void
  (dotimes (i (node-len form))
    (when (!= i 0) (emit g-hdr " "))
    (header-print-node (node-at form i))))

(defn emit-nuch-defstruct (form:ptr):void
  (emit g-hdr "(defstruct ")
  (dotimes (i (- (node-len form) 1))
    (when (!= i 0) (emit g-hdr " "))
    (header-print-node (node-at form (+ i 1))))
  (emit g-hdr ")\n"))

; Emit a new-style return operand for a .nuch declare/defmethod entry: ` :spell`
; for a scalar / colon-chain type (a NODE-SYM after defn-ret-node normalization,
; whose `s` carries the full colon spelling), or ` (T…)` for a parenthesised list
; type (NODE-LIST). The leading space keeps it space-separated from the params —
; exactly as the verbatim template export space-separates its ` :T` via print-node.
; Style-agnostic: defn-ret-node recovers the return from either signature style.
(defn emit-nuch-ret (form:ptr):void
  (let (rn:ptr (defn-ret-node form))
    (when (= rn null) (return))
    (let (rnn:&Node (unsafe/cast &Node rn))
      (if (= (rnn 'kind) NODE-LIST)
        (do (emit g-hdr " ") (header-print-node rn))
        (emit g-hdr " :" (rnn 's))))))

; A `defn`'s declaration attributes ride the exported entry, after the return
; operand — they are a property of the signature, so the importing unit's
; `declare` has to carry the same LLVM attributes the defining unit's `define`
; does. `defn-scan-attrs` is the same reader emit-defn uses, so the exported and
; consumed spellings cannot drift.
(defn emit-nuch-fn-attrs (form:ptr):void
  (let (fname:Symbol (symbol-none)
        rn:ptr null
        ps:ptr null
        bstart:i32 3
        style:i32 (defn-parse-sig (as ?&Node form) (as &Symbol &fname)
                    (as &ptr &rn) (as &ptr &ps)
                    (as &i32 &bstart))
        nr:i32 0
        rt:i32 0
        body:i32 (defn-scan-attrs (as ?&Node form) bstart
                   (as &i32 &nr) (as &i32 &rt)
                   (node-line (as ?&Node form) 0)))
    (when (!= nr 0) (emit g-hdr " :noreturn"))
    (when (!= rt 0) (emit g-hdr " :returns-twice"))))

; S3: a .nuch header names functions in the new signature style — `NAME (params)
; :ret` — matching every rewritten source form. Both signature styles funnel
; through the bare name (defn-name-only) + normalized return (emit-nuch-ret), so a
; still-legacy source (e.g. an unmigrated import) exports the same new-style entry.
(defn emit-nuch-declare (form:ptr):void
  (emit g-hdr "(declare " (defn-name-only (node-at form 1)) " (")
  (let (params:ptr (node-at form 2))
    (dotimes (i (node-len params))
      (when (!= i 0) (emit g-hdr " "))
      (let (p:ptr (node-at params i))
        ; A cell named like a type constructor (`ptr`, `Vector`) would read back as
        ; that type (declare-param-types), so it exports under `_`.
        (if (type-form-list? (as ?&Node p))
          (do (emit g-hdr "(_")
              (let (cur:ptr (node-rest (as ?&Node p)))
                (while (> (node-len cur) 0)
                  (emit g-hdr " ")
                  (header-print-node (node-first (unsafe/cast &Node cur)))
                  (set! cur (node-rest (unsafe/cast &Node cur)))))
              (emit g-hdr ")"))
          (header-print-node p)))))
  (emit g-hdr ")")
  (emit-nuch-ret form)
  (emit-nuch-fn-attrs form)
  (emit g-hdr ")\n"))

; A literal constant exports its folded value; a stored one, its storage.
(defn emit-nuch-defconst (form:ptr):void
  (let (name-node:?&Node (node-at form 1)
        sym:?&Sym (scope-lookup g-globals (defconst-bare-name name-node)))
    (when (and (!= sym null) (= (sym 'is-const) 0))
      (emit g-hdr "(extern :const ")
      (if (defconst-annotated? name-node)
        (header-print-node name-node)
        (let (tn:ptr (defconst-type-node form (sym 'type)))
          (emit g-hdr "(" (defconst-bare-name name-node) " ")
          (if (= tn null)
            (emit g-hdr (type-spelling (sym 'type)))
            (header-print-node tn))
          (emit g-hdr ")")))
      (emit g-hdr ")\n")
      (return))
    (emit g-hdr "(defconst ")
    (header-print-node name-node)
    (emit g-hdr " ")
    (cond
      (= sym null) (header-print-node (node-at form 2))
      (!= (sym 'const-node) null) (header-print-node (sym 'const-node))
      true (emit g-hdr (sym 'const-lit-i64)))
    (emit g-hdr ")\n")))

(defn emit-nuch-defenum (form:ptr):void
  (emit g-hdr "(defenum")
  (dotimes (i (- (node-len form) 1))
    (emit g-hdr " ")
    (header-print-node (node-at form (+ i 1))))
  (emit g-hdr ")\n"))

(defn emit-nuch-defmacro (form:ptr):void
  (header-print-node form)
  (emit g-hdr "\n"))

; Export one overloaded method, carrying its mangled symbol explicitly so the
; importer can declare it and register it for dispatch (new-style signature):
;   (defmethod "@area.pCircle" area ((c (ptr Circle))) :i32)
(defn emit-nuch-defmethod (form:ptr mangled:Symbol):void
  (emit g-hdr "(defmethod \"" mangled "\" " (defn-name-only (node-at form 1)) " (")
  (let (params:ptr (node-at form 2))
    (dotimes (i (node-len params))
      (when (!= i 0) (emit g-hdr " "))
      (header-print-node (node-at params i))))
  (emit g-hdr ")")
  (emit-nuch-ret form)
  (emit-nuch-fn-attrs form)
  (emit g-hdr ")\n"))

; A solitary function exports as a plain (declare ...); an overloaded one
; exports a (defmethod ...) per method so each keeps its distinct symbol. A
; bounded-generic template exports verbatim so importers can monomorphize it.
; "Bounded-generic" covers both an explicit `:where` clause and a method whose
; receiver/return is over a parametric struct (`(Vector T)`, §4): both carry free
; tyvars, so defn-form-mangled-name's concrete param-type parse would die
; `unknown type: T`. defn-is-generic-template is the same predicate the prescan
; and emit-defn skip consult, so the three never disagree.
(defn emit-nuch-defn (form:ptr):void
  (when (!= (defn-is-generic-template form) 0)
    (header-print-node form)
    (emit g-hdr "\n")
    (return))
  (let (mangled:Symbol (defn-form-mangled-name form))
    (if (not (symbol-none? mangled))
      (emit-nuch-defmethod form mangled)
      (emit-nuch-declare form))))

; Protocols and conformances export verbatim — the importer re-registers them
; (and trusts the recorded conformance rather than re-checking).
(defn emit-nuch-defprotocol (form:ptr):void
  (header-print-node form)
  (emit g-hdr "\n"))

; Export every node of the form, not just the subject (1) and protocol (2). A
; template-subject extend may carry a trailing `:where` clause (assoc-types-
; extend.md §10): `(extend (MapIter I F) (Iterator E) :where ((Iterator S) I)
; ((UnaryFn S E) F))`. The clause is needed so the importer can re-run the
; determination fixpoint and recover the associated args at stamp time in its
; own unit (register-imported-conformance → emit-extend). For a `:where`-free
; extend (node-len == 3) this prints `(extend Subject Protocol)`, byte-identical
; to the previous subject+protocol-only emission.
(defn emit-nuch-extend (form:ptr):void
  (emit g-hdr "(extend")
  (dotimes (i (- (node-len form) 1))
    (emit g-hdr " ")
    (header-print-node (node-at form (+ i 1))))
  (emit g-hdr ")\n"))

; Cast rules export verbatim (the conv-fn is exported separately as a declare,
; which must precede this form in the header). The importer re-runs emit-defcast.
(defn emit-nuch-defcast (form:ptr):void
  (header-print-node form)
  (emit g-hdr "\n"))

; A module's top-level globals export as `extern` so importers see the symbol
; without its initializer (the producing module owns the definition). Index 1 is
; the desugared name:type node; any initializer is intentionally dropped.
(defn emit-nuch-extern (form:ptr):void
  (emit g-hdr "(extern")
  (let (i:i32 1)
    (while (= (node-kind (node-at form i)) NODE-KEYWORD)
      (emit g-hdr " ")
      (header-print-node (node-at form i))
      (inc! i))
    (emit g-hdr " ")
    (header-print-node (node-at form i)))
  (emit g-hdr ")\n"))

; The import forms that bind a name in this file's environment — a prefix, or a
; flattened namespace other than `user` and the prelude (which every file already
; sees) — so the importer reads the header's templates and signatures as this file
; read them.
(defn emit-nuch-import-env (forms:ptr):void
  (dotimes (fi (node-len forms))
    (let (f:ptr:Node (as ptr:Node (node-at forms fi)))
      (when (and (= (node-kind f) NODE-LIST) (>= (node-len f) 2)
                 (= (node-kind (node-at f 0)) NODE-SYM))
        (let (h:Symbol ((as ptr:Node (node-at f 0)) 's)
              lib:?&Node (as ?&Node (node-at f 1)))
          (cond
            (or (= h "import") (= h "import-prefixed"))
              ; Spelled explicitly: the prefix may have been a derived default.
              (let (prefix:Symbol (import-form-prefix f (f 'line)))
                (when (not (symbol-none? prefix))
                  (emit g-hdr "(import-prefixed ")
                  (header-print-node lib)
                  (emit g-hdr " " prefix ")\n")))
            (or (= h "import-use") (= h "import-only"))
              (let (path:Symbol (import-form-path lib (f 'line)))
                (when (and (not (symbol-none? path)) (!= (import-path-ns path) "user")
                           (not (prelude-ns? (import-path-ns path))))
                  (header-print-node f)
                  (emit g-hdr "\n")))
            ; Always a prefix, and the one binding that reaches private names.
            (and (= h "unsafe/import-private") (>= (node-len f) 3))
              (do (header-print-node f) (emit g-hdr "\n"))
            ; Binds nothing but the closure, which the header's text may lean on.
            (and (require-head? h) (= (node-len f) 2))
              (do (header-print-node f) (emit g-hdr "\n"))
            true 0))))))

; A C header's constant in an array extent is written as its value: the importer
; binds this header's C imports but never reads them.
(defn nuch-extent-values (n:?&Node):void
  (when (!= (node-kind n) NODE-LIST) (return))
  (let (arr:bool (and (= (node-len n) 3) (= (node-kind (node-at n 0)) NODE-SYM)
                      (= ((as ptr:Node (node-at n 0)) 's) "array")))
    (dotimes (i (node-len n))
      (if (and arr (= i 2))
        (nuch-cconst-values n i)
        (nuch-extent-values (as ?&Node (node-at n i)))))))

(defn nuch-cconst-values (lst:?&Node i:i32):void
  (let (e:ptr:Node (as ptr:Node (node-at lst i)))
    (cond
      (= (node-kind e) NODE-SYM)
        (if-some (s (scope-lookup g-globals (e 's)))
          (when (!= (s 'c-const) 0)
            (node-set-at (unsafe/cast &Node lst) i (node-int (s 'const-lit-i64))))
          0)
      (= (node-kind e) NODE-LIST)
        (dotimes (j (node-len e)) (nuch-cconst-values e j))
      true 0)))

; Run after the compile, whose registries it reads; its `(ns …)` was applied there.
(defn emit-nuch-header (forms:ptr source-file:Symbol):void
  (when (!= (is-leading-ns forms) 0) (set! forms (node-rest forms)))
  (emit g-hdr "; .nuch header for " source-file "\n")
  ; Stage 12 N6: a namespaced library carries its namespace into the header so an
  ; importer's do-import re-runs the SAME ns-ir-base computation when it
  ; re-resolves the symbols — a solitary `(declare area:i32 ...)` then rebinds to
  ; `@geom__area` instead of bare `@area`. Emit `(ns NAME)` for any non-`user`
  ; namespace, and `(set-ir-prefix "...")` when the library overrode the default
  ; prefix (so the importer mangles identically). Under `user` neither is emitted,
  ; so existing libraries' headers stay byte-identical.
  (when (!= g-current-ns "user")
    (emit g-hdr "(ns " g-current-ns ")\n")
    (let (override:Symbol (ns-ir-prefix-get g-current-ns))
      (when (not (symbol-none? override))
        (emit g-hdr "(set-ir-prefix \"" override "\")\n"))))
  (emit-nuch-import-env forms)
  (dotimes (fi (node-len forms))
    (let (fc:?&Node (as ?&Node (node-at forms fi)))
      (let (f:&Node (unsafe/cast &Node fc))
        (when (and (= (f 'kind) NODE-LIST)
                   (> (node-len (as ptr f)) 0)
                   (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 'kind) (= _ NODE-SYM))
                   (not (gensym-definition? fc)))
          (nuch-extent-values fc)
          (let (h:Symbol (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 's)))
            (case h
              "defstruct"    (emit-nuch-defstruct (as ptr f))
              ; defunion exports verbatim (template or monomorphic); the
              ; importer registers the type and declares the constructors.
              "defunion"     (do (header-print-node (as ptr f)) (emit g-hdr "\n"))
              "defn"         (emit-nuch-defn (as ptr f))
              "defprotocol"  (emit-nuch-defprotocol (as ptr f))
              "extend"       (emit-nuch-extend (as ptr f))
              "defcast"      (emit-nuch-defcast (as ptr f))
              "defvar"       (emit-nuch-extern (as ptr f))
              "defconst"     (emit-nuch-defconst (as ptr f))
              ; Both export verbatim. `deferror`: the importer re-registers it,
              ; getting a fresh id in its own dense order (ids are per-build).
              ; `deftype` (Stage 16): a type alias has to be carried — a `defn`
              ; exported below may name it in its signature, and the importer
              ; resolves that spelling in its own unit.
              ; `export`: a facade's re-exports are its interface; the importer
              ; re-runs them against the imports the header carries.
              (:or "deferror" "deftype" "export")
                             (do (header-print-node (as ptr f)) (emit g-hdr "\n"))
              "defenum"      (emit-nuch-defenum (as ptr f))
              "defmacro"     (emit-nuch-defmacro (as ptr f))
              0)))))))

; ============================================================
; .nuch import processing
; ============================================================

; do-import's extension dispatch (.nuc/.nuch). The comparison is the library's;
; this only views the name's bytes, with no `strlen`.
(defn str-ends-with (s:Symbol suffix:StrView):i32
  (let (sv:StrView (symbol-as-view s))
    (when (strview-ends-with &sv &suffix) (return 1))
    (return 0)))

; `:rest`/`:optional` are defn-only, and a declaration has no machinery for
; them; a C variadic tail needs no marker, since a declared signature is open-tailed.
(defn reject-declare-marker (n:?&Node line:i32):void
  (when (or (!= (marker-named n "rest") 0) (!= (marker-named n "optional") 0))
    (die-at line
      (fstr "declare: '" (marker-spelling n)
            "' is not supported in a declaration -- declare the fixed parameters only (extra arguments are passed positionally at the call site)"))))

; A `declare` parameter as it reads before types resolve.
(defn declare-param-named? (p:ptr):bool
  (return (or (node-empty? (as ?&Node p))
              (and (= (node-kind p) NODE-SYM) (= (type-sigil-run (-> p (unsafe/cast &Node _) (_ 's))) 0))
              (and (= (node-kind p) NODE-LIST)
                   (not (type-form-list? (as ?&Node p)))
                   (!= (node-kind (as ptr (node-first (as ?&Node p)))) NODE-LIST)))))

; Stage 15 W3c fallout (cheader.md, "Unnamed `declare` parameters carry types"):
; a `declare` parameter list admits an UNNAMED parameter written as its bare type
; — `(declare lseek (i32 i64 i32):i64)` — alongside the named `name:type` form
; docs/toplevel.md documents. An element carrying no `name:type` annotation is
; therefore a *type operand*, not an untyped name, and is parsed as one here.
;
; It used to fall back to `ty-i32`, so every non-`i32` unnamed parameter silently
; declared the wrong ABI — including, at the time, the compiler's own
; `(declare repl_print_f64 (ptr):void)`, which declared an `i32` parameter and
; worked only because x86-64 SysV happens to pass a pointer and an `i32` in the
; same register. The default also defeated W3c's declaration-precedence rule: a
; bare-list `declare` that *agreed* with the C header rendered as all-`i32`,
; overrode the header's correct signature, and warned about a conflict that did
; not exist.
;
; A spelling that does not name a type raises the ordinary located
; `unknown type: …` through parse-type-name / parse-type-from-node. Defaulting is
; what produced the defect; there is nothing to fall back to.
(defn declare-param-type (node:?&Node line:i32):&Type
  (when (= node null) (die-at line "declare: empty parameter"))
  (let (n:?&Node node)
    ; Before the keyword arm, which would read `:rest` as `unknown type: rest`.
    (reject-declare-marker n line)
    ; A keyword operand (`:i64`) carries the spelling without the colon, exactly
    ; as a return operand does (fn-parse-ret-type).
    (when (= (n 'kind) NODE-KEYWORD) (return (parse-type-name (n 's) line)))
    (return (parse-type-from-node (as ptr node) line))))

; A `declare`'s parameter list as a flat Type array, with the count written back
; through `io-n`. Extracted from nuch-declare-import so item 36's conflict message
; can render the declared signature by calling the very parse the import runs,
; rather than a second copy of it.
(defn declare-param-types (params-node:ptr line:i32 io-n:&i32):ptr
  (let (nparams:i32 0)
    (when (!= params-node null) (set! nparams (node-len params-node)))
    (set! (aref io-n 0) nparams)
    (when (<= nparams 0) (return null))
    (let (ptypes:ptr (arena-alloc (* nparams (ptr-bytes))))
      (dotimes (j nparams)
        ; A parameter node is either an annotated `name:type` (a colon symbol, or
        ; the `(name type)` cell desugar produces) or a bare type operand. The line
        ; must be borrowed from the enclosing form: an unannotated parameter is an
        ; interned NODE-SYM, whose own line is always 0 (W4a).
        (let (p:ptr (node-at params-node j)
              pn:Symbol (symbol-none)
              pline:i32 (node-line p line)
              ; `:i64`, `((fn …) …)` and a type-constructor list are types; any
              ; other list is a `(name type)` cell, whose reader diagnoses a bad name.
              named:bool (declare-param-named? p)
              pty:ptr (if named (extract-name-and-type p (as &Symbol &pn) pline) null))
          (when (= pty null)
            (set! pty (declare-param-type (as ?&Node p) pline)))
          (set! (aref (unsafe/cast &ptr ptypes) j) pty)))
      (return ptypes))))

; A function type's parameter Types as the flat array `fn-sig-spelling` takes —
; the same shape `declare-param-types` builds from source.
(defn fn-type-param-array (ft:&Type):ptr
  (when (<= (ft 'num-params) 0) (return null))
  (let (a:ptr (arena-alloc (* (ft 'num-params) (ptr-bytes))))
    (dotimes (j (ft 'num-params))
      (set! (aref (unsafe/cast &ptr a) j) (unsafe/cast ptr ((field-at (ft 'params) j) 'type))))
    (return a)))

; `(i32):i32` — a signature in SOURCE spellings, for a diagnostic. Deliberately
; not `c-fn-sig-render`, which lowers through `type-to-ir`: every pointer flavour
; would print `ptr` (W9 item 34), and a declaration conflict is precisely a
; question about the types, not about what they lower to.
(defn fn-sig-spelling (ret:ptr ptypes:ptr nparams:i32):StrView
  (let (acc:StrView "(")
    (dotimes (j nparams)
      (when (!= j 0) (set! acc (fstr acc ", ")))
      (set! acc (fstr acc (type-display (unsafe/cast ptr:Type (aref (unsafe/cast &ptr ptypes) j))))))
    (return (fstr acc "):" (type-display (unsafe/cast ptr:Type ret))))))

; `file:line` of a DEFINITION of `fname` in this unit, or null if it has none —
; the second of the two questions the skip below asks (Stage 15 W9 item 36). Only
; a `defn` carries a body, so only a definition is located here: a C-header import
; and an imported `declare` both answer null, which is the case the skip is FOR.
; Same provenance `duplicate-signature-message` uses.
(defn nuch-definition-site (fname:Symbol):StrView
  (let (g:?&Generic (generic-lookup fname))
    (when (= g null) (return ""))
    (let (gg:&Generic g
          i:i32 0)
      (while (< i (unsafe/cast i32 (count (gg 'methods))))
        (let (mi:&Method (as &Method (invoke (gg 'methods) i:usize)))
          (when (and (= (mi 'kind) METHOD-USER) (!= (as ptr (mi 'body)) null))
            (let (f:Symbol (mi 'src-file))
              (when (symbol-none? f) (set! f (symbol-intern "<unknown file>")))
              (return (fstr f ":" (-> mi (_ 'body) (unsafe/cast &Node _) (_ 'line)))))))
        (inc! i))
      (return ""))))

; Item 36's message. Both signatures are printed — they are usually different
; types as well as different functions, and seeing both is what makes the clash
; obvious — and the note states the mechanism: one name is one key, so the
; header's function has no spelling left that reaches it, not even a qualified
; one. Giving the library an `(ns …)` is a real fix rather than advice: its
; exports then key as `lib/helper` and link as `@lib__helper`, and the two coexist
; (the skip never fires, because the keys differ).
(defn nuch-declare-conflict-message (fname:Symbol site:StrView params-node:ptr
                                     ret:ptr line:i32):StrView
  (let (nparams:i32 0
        ptypes:ptr (declare-param-types params-node line (as &i32 &nparams))
        prev:ptr (as ptr (scope-lookup-key g-globals fname))
        theirs:StrView "a value of another kind")
    (when (!= prev null)
      (let (pt:?&Type ((unsafe/cast &Sym prev) 'type))
        (when (!= pt null)
          (let (ft:&Type (unsafe/cast &Type pt))
            (when (= (ft 'kind) TY-FN)
              (set! theirs (fstr fname
                                 (fn-sig-spelling (unsafe/cast ptr (ft 'ret))
                                        (fn-type-param-array ft) (ft 'num-params)))))))))
    (return
      (fstr (fstr "declare '" fname "': this compilation unit already defines '" fname
                  "', at " site)
            "\n  note: "
            (fstr "the header declares " fname
                  (fn-sig-spelling ret ptypes nparams) ", the unit has " theirs
                  ". One name is one key here, so nothing — not even a qualified call — would reach the header's. Rename one, or give the library an (ns ...) so its exports key and link under it.")))))

(defn emit-nuch-declare-import (form:?&Node):void
  (nuch-declare-import form NUCH-BOTH))

; Stage 15 W9 item 29: split by NUCH-* mode. The prescan registers a header's
; declares (NUCH-REG) so they resolve on reachability; the import emits their
; LLVM `declare` lines (NUCH-AFTER) from exactly where it always has.
(defn nuch-declare-import (form:?&Node mode:i32):void
  (let (ff:&Node (unsafe/cast &Node form))
    ; Trailing declaration attributes (`:noreturn`, `:returns-twice`), carried
    ; verbatim by desugar — e.g. (declare abort () :void :noreturn).
    ; eff-len is the length with the run stripped, so the param-list index logic
    ; below is unchanged; the flags drive the Sym fields and the LLVM attribute.
    (let (is-noreturn:i32 0
          is-returns-twice:i32 0
          m:i32 mode
          eff-len:i32 (declare-scan-attrs form (node-len form) 4
                        (as &i32 &is-noreturn)
                        (as &i32 &is-returns-twice)
                        (ff 'line)))
      ; A new-style declare `(declare name (params) :rettype [:noreturn])` has a
      ; bare name and the return operand at index 3 (eff-len 4). Both the toplevel
      ; `declare` form (desugared) and .nuch imports reach here; as of S3 the .nuch
      ; writer emits new-style, so every well-formed input takes the bare-name path.
      ; S4: the legacy `(declare name:ret [(params)])` shape is retired — detection
      ; (sig-name-is-bare) stays so the diagnostic can quote the name and say what
      ; moved.
      (let (name-node:ptr (node-at form 1)
            ndi-new:i32 (sig-name-is-bare (node-at form 1))
            params-node:ptr null)
        ; W9 item 45: a name spelled `()` is a NULL node (W5f). It is not a legacy
        ; signature — the message below would quote it as '(null)' — it is no name
        ; at all, so it gets the wording every other definer uses for that.
        (require-declare-name (as ?&Node name-node) (ff 'line))
        (if (!= ndi-new 0)
          (do
            (when (!= eff-len 4)
              (die-at (ff 'line) "declare: expected (declare name (params) :rettype)"))
            (set! params-node (node-at form 2)))
          (die-at (ff 'line)
            (fstr "declare '" (defn-name-only name-node)
                  "': legacy 'name:ret' syntax is no longer supported — write (declare "
                  (defn-name-only name-node) " (params) :ret)")))
        (let (fname:Symbol (symbol-none)
              ret:ptr (if (!= ndi-new 0)
                        (fn-parse-ret-type (node-at form 3) (ff 'line))
                        (extract-name-and-type name-node (as &Symbol &fname)
                                               ((unsafe/cast &Node name-node) 'line))))
          (when (!= ndi-new 0) (set! fname (-> name-node (unsafe/cast &Node _) (_ 's))))
          (when (= ret null)
            (die-at ((unsafe/cast &Node name-node) 'line) (fstr "declare: missing :type on '" fname
                                                          "'")))
          ; W9 item 29: emit-only is a promise the prescan registered THIS name
          ; from THIS header. It registers nothing the skip below already
          ; refused, so ask before assuming; a name it skipped is still a plain
          ; register-and-emit.
          (when (= m NUCH-AFTER)
            (when (= (import-list-has g-nuch-registered
                       (nuch-reg-key g-source-path fname)) 0)
              (set! m NUCH-BOTH)))
          ; Skip if already defined (e.g. from include or c-include).
          ; B2b: a KEY question — this is the definition side of the `scope-define`
          ; a few lines below, not a reference written in this file.
          ; Stage 15 W9 item 36: but a bound name is one of two different things,
          ; and the skip used to assume it was always the first. Either the same
          ; function named twice — the diamond above, or W1e's cross-file
          ; cycle-breaker `(declare f …)`, whose whole job is to be a no-op once
          ; the prescan reaches the real `defn` — or a DIFFERENT function that
          ; happens to share the name, in which case dropping the header entry
          ; whole (no binding, no `declare`, no method) left even a qualified
          ; `lib/helper` reaching the unit's own `helper`, silently and at whatever
          ; type the local one had.
          ;
          ; Two questions separate them, and both are needed. WHERE the declare is
          ; written: a `.nuch` describes some OTHER unit's exports, and `--emit-nuch`
          ; never re-exports a top-level `declare`, so a header entry is never a
          ; forward declaration of a function this unit defines — while a `.nuc`
          ; declare always may be. And whether this unit DEFINES the name: only a
          ; `defn` carries a body, so the libc diamond (a C header and a `.nuch`
          ; both naming `strlen`) answers no, which is every occurrence in this repo.
          (when (and (!= m NUCH-AFTER)
                     (!= (scope-lookup-key g-globals fname) null))
            (when (and (not (symbol-none? g-source-path))
                       (!= (str-ends-with g-source-path ".nuch") 0))
              (let (site:StrView (nuch-definition-site fname))
                (when (not (str-empty? &site))
                  (die-at (ff 'line)
                    (nuch-declare-conflict-message fname site params-node ret (ff 'line))))))
            (return))
          (let (nparams:i32 0
                ptypes:ptr (declare-param-types params-node (ff 'line)
                             (as &i32 &nparams)))
            ; Stage 12 N6: a solitary symbol from a namespaced header re-resolves
            ; to its mangled link name. The header's leading `(ns NAME)` has set
            ; g-current-ns, so ns-ir-base composes the namespace ir-prefix onto the
            ; bare name (`area` → `geom__area`) — the SAME computation the producer
            ; ran in emit-defvar / defn-ir-name. scope-define qualifies the *key*
            ; against g-current-ns (`geom/area`) independently. Identity under
            ; `user`, so non-namespaced headers stay byte-identical.
            ; W9 item 29: computed for both halves — the emit-only pass needs the
            ; symbol, and it is a pure function of the name and the namespace.
          (let (link-ir:Symbol (symbol-intern (fstr "@" (ns-ir-base fname))))
          (when (!= m NUCH-AFTER)
            ; Stage 15 W3c declaration precedence (cheader.md §1.4). Record this
            ; declaration's rendered signature on its prescanned site, so a C
            ; header import LATER in the unit can compare against it; and if a
            ; header import EARLIER already stood down for this name, compare now
            ; and warn. Only a top-level `(declare …)` in a .nuc unit has a site
            ; (prescan-explicit-declares); a .nuch-borne declare has none and is
            ; unaffected.
            (let (site:ptr (as ptr (cheader-explicit-declare-site fname)))
              (when (!= site null)
                (let (msig:StrView (c-fn-sig-render (as ?&Type ret) ptypes nparams 0)
                      shadow:ptr (as ptr (cdecl-site-find g-cheader-shadowed
                                                          fname)))
                  (set! ((unsafe/cast &CDeclSite site) 'sig) msig)
                  (when (and (!= shadow null)
                             (!= ((unsafe/cast &CDeclSite shadow) 'sig) msig))
                    (cheader-warn-decl-conflict (as ?&CDeclSite site)
                                                (as ?&CDeclSite shadow))))))
            (let (ft:&Type (as &Type (make-type TY-FN)))
              (set! (ft 'ret) ret)
              (type-set-params ft ptypes nparams)
              (set! (ft 'variadic) 0)
              (let (dsym:&Sym (scope-define g-globals fname (as ptr ft)
                                  (symbol-as-view link-ir) 0))
                ; Stage 15 W9 defect 12: mark this as a DECLARED (prototype-only)
                ; signature, so the new call-arity check admits the extra trailing
                ; arguments a C variadic call needs — the idiom this very file's
                ; `:rest`-in-a-declaration diagnostic points users at, and which
                ; `docs/toplevel.md` documents. Too few arguments is still refused.
                (set! (dsym 'extern-decl) 1)
                (when (!= is-noreturn 0) (set! (dsym 'noreturn) 1))
                (when (!= is-returns-twice 0)
                  (set! (dsym 'returns-twice) 1))))
            ; Stage 15 W9 item 24: and in the generic registry, which is where
            ; every OTHER producer of a callable name puts it — `emit-defn`
            ; registers even a solitary function, and that is why a protocol
            ; method, a `drop`/`invoke` thunk and a `(dyn P)` vtable can be
            ; resolved at all. A `declare` was the one exception, so a function
            ; that arrives through a header was invisible to every asker that
            ; poses the question by NAME AND SIGNATURE rather than by name:
            ; `method-satisfies-sig` (so `extend` reported a conforming type as
            ; non-conforming) and `dyn-vtable-method-irname` (so boxing died
            ; "no method 'describe' is defined" for a method that is declared,
            ; defined and linkable). `ir-fixed` because the producing unit
            ; already chose this symbol — see finalize-generics.
            (let (dm:ptr (generic-register-method fname ret ptypes nparams 0 0 null))
              (set! ((unsafe/cast &Method dm) 'ir-name) link-ir)
              (set! ((unsafe/cast &Method dm) 'ir-fixed) 1))
            (when (= m NUCH-REG)
              (set! g-nuch-registered
                    (import-list-push g-nuch-registered
                      (nuch-reg-key g-source-path fname)))))
          (when (!= m NUCH-REG)
            ; Emit LLVM declare, lowering struct-by-value params/return to the
            ; platform C ABI (sret / byval / register coercion) just like a defn.
            (let (ret-info:&AbiInfo (unsafe/cast &AbiInfo (abi-classify ret)))
              (emit g-out "declare " (abi-ret-ir ret-info ret) " " link-ir "(")
              (let (need-comma:i32 0)
                (when (= (ret-info 'kind) ABI-MEMORY)
                  (emit g-out "ptr sret(" (type-to-ir ret) ") align "
                        (ret-info 'align))
                  (set! need-comma 1))
                ; RV-6c: one walk over this declare's parameters — reset the
                ; riscv64 register budget (design/stage14/riscv-fp-abi.md §4).
                (abi-args-begin ret-info)
                (dotimes (j nparams)
                  (when (!= need-comma 0) (emit g-out ", "))
                  (abi-print-param
                   (abi-classify-arg (aref (unsafe/cast &ptr ptypes) j))
                   (aref (unsafe/cast &ptr ptypes) j)
                   (symbol-none))
                  (set! need-comma 1)))
              ; Trailing LLVM function attributes, additive so a `declare` and the
              ; `define` it names carry the same set (emit-defn does the same).
              (emit g-out ")")
              (when (!= is-noreturn 0) (emit g-out " noreturn"))
              (when (!= is-returns-twice 0) (emit g-out " returns_twice"))
              (emit g-out "\n"))))))))))

; Import one exported overloaded method: register it (with its mangled symbol)
; in the generic registry so calls in the importing unit dispatch to it, and
; emit an LLVM declare under the mangled symbol (resolved at link time).
(defn emit-nuch-defmethod-import (form:&Node):void
  (nuch-defmethod-import form NUCH-BOTH))

; Stage 15 W9 item 29: split by NUCH-* mode, as nuch-declare-import. This one
; needs no per-name list — it has no "already defined" skip, so the prescan
; registers every `defmethod` in the header and the import emits every one.
(defn nuch-defmethod-import (form:?&Node mode:i32):void
  (let (ff:&Node (unsafe/cast &Node form))
    ; S3: new-style entry `(defmethod "@sym" NAME (params) :ret)` — the mangled
    ; symbol (1), a bare name (2), the params (3) and the return operand (4),
    ; plus any trailing declaration attributes.
    (let (is-noreturn:i32 0
          is-returns-twice:i32 0
          eff-len:i32 (declare-scan-attrs form (node-len form) 5
                        (as &i32 &is-noreturn)
                        (as &i32 &is-returns-twice)
                        (ff 'line)))
    (when (!= eff-len 5)
      (die-at (ff 'line) "defmethod: expected (defmethod \"@sym\" name (params...) :ret)"))
    (let (sym-node:&Node (unsafe/cast &Node (node-at form 1))
          name-node:&Node (unsafe/cast &Node (node-at form 2))
          params-node:ptr (node-at form 3))
      (when (!= (sym-node 'kind) NODE-STR)
        (die-at (sym-node 'line) "defmethod: first element must be the mangled symbol string"))
      (let (mangled:Symbol (sym-node 's)
            fname:Symbol (name-node 's)
            ret:ptr (fn-parse-ret-type (node-at form 4) (ff 'line)))
        (when (= ret null)
          (die-at (ff 'line) "defmethod: missing return type"))
        (let (nparams:i32 (defn-params-count params-node)
              ptypes:ptr (defn-params-to-types params-node)
              has-rest:i32 (defn-params-has-rest params-node))
          (when (!= mode NUCH-AFTER)
            (let (m:ptr (generic-register-method fname ret ptypes nparams has-rest 0 null))
              (defn-params-set-opt (as ?&Node params-node)
                (unsafe/cast &Type ((unsafe/cast &Method m) 'fn-type)))
              (set! ((unsafe/cast &Method m) 'ir-name) mangled)
              ; Stage 15 W9 item 24: the producing unit emitted this symbol, so
              ; finalize-generics may not rename it. Until now that held only by
              ; coincidence — a re-mangle recomputed the same string — and stopped
              ; holding the moment a local overload joined the set and shifted the
              ; per-prefix count.
              (set! ((unsafe/cast &Method m) 'ir-fixed) 1))
            (let (g:ptr (generic-lookup fname))
              (set! ((unsafe/cast &Generic g) 'mangled) 1)
              (set! ((unsafe/cast &Generic g) 'finalized) 1)))
          (when (!= mode NUCH-REG)
          ; Lower struct-by-value params/return to the platform C ABI exactly as
          ; emit-nuch-declare-import (above) and emit-defn do. Emitting raw
          ; type-to-ir here declared a by-value struct as its aggregate type
          ; while the defining unit's `define` lowered it (sret / byval /
          ; register coercion), so the two disagreed on EVERY target — an
          ; imported overloaded method taking or returning a struct by value.
          (let (ret-info:&AbiInfo (unsafe/cast &AbiInfo (abi-classify ret)))
            (emit g-out "declare " (abi-ret-ir ret-info ret) " " mangled "(")
            (let (need-comma:i32 0)
              (when (= (ret-info 'kind) ABI-MEMORY)
                (emit g-out "ptr sret(" (type-to-ir ret) ") align "
                      (ret-info 'align))
                (set! need-comma 1))
              ; RV-6c: one walk over this declare's parameters — reset the
              ; riscv64 register budget (design/stage14/riscv-fp-abi.md §4).
              (abi-args-begin ret-info)
              (dotimes (j nparams)
                (when (!= need-comma 0) (emit g-out ", "))
                (abi-print-param
                  (abi-classify-arg (aref (unsafe/cast &ptr ptypes) j))
                  (aref (unsafe/cast &ptr ptypes) j)
                  (symbol-none))
                (set! need-comma 1)))
            (emit g-out ")")
            (when (!= is-noreturn 0) (emit g-out " noreturn"))
            (when (!= is-returns-twice 0) (emit g-out " returns_twice"))
            (emit g-out "\n")))))))))

; A defunion arriving via .nuch: register the type (or template) exactly as
; the defining unit did, but emit `declare`s for the arm constructors — their
; definitions live in the exporting unit's object file.
(defn emit-defunion-import (form:?&Node):void
  (let (ff:&Node (unsafe/cast &Node form))
    (require-defunion-form (as ptr ff))
    (let (name-node:&Node (unsafe/cast &Node (node-at form 1)))
      (case (name-node 'kind)
        NODE-LIST
          (do (register-union-template (as ptr ff)) (return))
        NODE-SYM
          (do
            ; Stage 15 W9 item 46: the registry takes the canonical KEY and
            ; `union-ctor-form` below takes the SOURCE spelling — the same split
            ; `emit-defunion` documents, and the reason this arm was wrong is that
            ; it used the source spelling for both. `emit-defstruct`, one `case`
            ; arm away in this very walk, has always keyed on `qualify-name`, so a
            ; header carrying `(ns nsu)` registered the backing struct as `nsu/Opt`
            ; and the UnionDef as `Opt`, where no reference looks.
            ; And, exactly as in `emit-defunion`, mere existence is no longer the
            ; tell now that `prescan-union-layouts` creates a UnionDef for this
            ; same form: the discriminator is `ctors-emitted`, which here means
            ; the arm `declare`s below are already in the stream. Keying the
            ; skip on existence would drop them and link against nothing.
            (if-some (prev (uniondef-lookup (qualify-name (name-node 's))))
              (when (!= (prev 'ctors-emitted) 0) (return))
              0)
            (guard-name-kind (name-node 's) (ff 'line) NK-TYPE)
            (let (arms:ptr (-> ff (node-rest _) (unsafe/cast &Node _) (node-rest _))
                  ud:&UnionDef (defunion-register (qualify-name (name-node 's))
                                    arms (ff 'line)))
              ; Constructor declares: (declare Name-arm:Name (fields...)).
              (let (saved-out:?&String g-out)
                (set! g-out &g-decl-stream)
                (dotimes (ai (node-len arms))
                  (let (cur:?&Node (as ?&Node (node-at arms ai)))
                    (let (ctor:&Node (unsafe/cast &Node
                                           (union-ctor-form (name-node 's)
                                                            cur (ff 'line))))
                      ; Reshape the synthesized new-style defn into a new-style declare:
                      ; same bare name (1), same params (2), same return operand (3), no
                      ; body — `(declare NAME (params) RET)`.
                      (emit-nuch-declare-import
                        (node-list4 (as ptr 'declare)
                          (node-at (as ptr ctor) 1)
                          (node-at (as ptr ctor) 2)
                          (node-at (as ptr ctor) 3) (ff 'line))))))
                (set! (ud 'ctors-emitted) 1)
                (set! g-out saved-out))))
        (die-at (name-node 'line) "defunion: name must be a symbol")))))

(defn emit-nuch-import-forms (forms:?&Node):void
  ; Stage 15 W9 item 29: did the whole-graph prescan already register this
  ; header? It keys on the SAME list `emit-toplevel-forms` reads for a `.nuc`
  ; file, and `do-import` has set g-source-path to the header's own path. When it
  ; did, the three registering arms below emit only — re-registering would append
  ; a second Method for every `defmethod`, which `finalize-generics` then reports
  ; as a duplicate overload.
  (let (mode:i32 (if (and (not (symbol-none? g-source-path))
                          (!= (import-list-has g-prescan-sigs g-source-path) 0))
                   NUCH-AFTER NUCH-BOTH))
  (dotimes (fi (node-len forms))
    (let (fc:?&Node (as ?&Node (node-at forms fi)))
      (let (f:&Node (unsafe/cast &Node fc))
        (when (and (!= (as ptr f) null) (= (f 'kind) NODE-LIST)
                   (> (node-len (as ptr f)) 0)
                   (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 'kind) (= _ NODE-SYM)))
          (let (h:Symbol (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 's)))
            (case h
              ; Stage 12 N6: a namespaced library's header opens with `(ns NAME)`
              ; (and optionally `(set-ir-prefix ...)`). Honor them so the importer
              ; re-runs ns-ir-base under the producing namespace and re-binds each
              ; solitary symbol's ir-name to its mangled form (`@geom__area`) and
              ; keys it under `geom/area`. do-import already saved g-current-ns and
              ; set it to `user` for this unit, restoring it afterward, so the
              ; namespace state is scoped to the header and never leaks.
              "ns"
                (emit-ns (as ptr f))
              "set-ir-prefix"
                (emit-set-ir-prefix (as ptr f))
              ; The source file's bindings (emit-nuch-import-env): they name what
              ; its text was written against and load nothing, like its `declare`s.
              (:or "import" "import-prefixed" "import-use" "import-only" "unsafe/import-private"
                   "require" "require-ct")
                (when (not (import-form-bind f))
                  (die-import-not-found (-> f (node-at _ 1) (unsafe/cast &Node _) (_ 's))
                                        (f 'line)))
              ; A facade's re-exports, from the libraries the lines above bind.
              "export"
                (emit-export f)
              "defstruct"
                (do (set! g-out &g-type-stream) (emit-defstruct (as ptr f)))
              "defunion"
                (do (set! g-out &g-type-stream) (emit-defunion-import (as ptr f)))
              "declare"
                (do (set! g-out &g-decl-stream) (nuch-declare-import (as ptr f) mode))
              "defmethod"
                (do (set! g-out &g-decl-stream) (nuch-defmethod-import (as ptr f) mode))
              "defn"
                ; Only bounded-generic templates are exported as whole defns;
                ; register (exporter-verified, so trusted) so calls in this
                ; unit can instantiate them.
                (register-generic-defn (as ptr f) 1)
              "defprotocol"
                (protocol-register-form (as ptr f))
              "extend"
                (register-imported-conformance (as ptr f))
              "defcast"
                (emit-defcast (as ptr f))
              "extern"
                (do (set! g-out &g-decl-stream) (emit-extern-mode (as ptr f) mode true))
              "defconst"
                (do (set! g-out g-def-stream) (emit-defconst (as ptr f)))
              "defenum"
                (emit-defenum (as ptr f))
              ; Stage 16: re-register the alias in this unit. Emits nothing —
              ; the exported signatures below resolve its spelling through the
              ; importer's own registry.
              "deftype"
                (register-type-alias (as ptr f) 0)
              "defmacro"
                (emit-defmacro (as ptr f))
              ; `def-rmacro` is the reader's, already applied while reading.
              0)))))
  ; Finalize any newly-imported generic templates so their names dispatch
  ; through the registry (imported concrete methods finalize themselves).
  (finalize-generics))))

; Stage 15 W9 item 29: register — without emitting — everything a `.nuch` header
; contributes to the VALUE and FUNCTION namespaces, so one of its names resolves
; on reachability rather than on where the import form happens to sit. This is
; the header counterpart of `prescan-defn-signatures` + `prescan-value-names`,
; and it covers exactly the kinds those two cover for a `.nuc` library: a
; `declare` is that library's `defn`, an `extern` its `defvar`, and a `defmethod`
; one member of an overload set. Types need nothing here — pass 1
; (`prescan-imported-types`) walks a header like any other file.
;
; REGISTRATION ONLY, deliberately. Every LLVM `declare` / `external global` line
; stays exactly where `emit-nuch-import-forms` has always written it, which is
; what keeps each module's IR byte-identical; only the moment the NAME becomes
; known moves. It also means this pass needs no output stream, so it is equally
; correct under `--emit-nuch` / `--emit-cheader`, which return before
; `open-module-streams`.
(defn prescan-nuch-signatures (forms:?&Node):void
  (dotimes (fi (node-len forms))
    (let (fc:?&Node (as ?&Node (node-at forms fi)))
      (let (f:&Node (unsafe/cast &Node fc))
        (when (and (!= (as ptr f) null) (= (f 'kind) NODE-LIST)
                   (> (node-len (as ptr f)) 0)
                   (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 'kind) (= _ NODE-SYM)))
          (let (h:Symbol (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 's)))
            (case h
              "declare"
                (nuch-declare-import (as ptr f) NUCH-REG)
              "defmethod"
                (nuch-defmethod-import (as ptr f) NUCH-REG)
              "extern"
                (emit-extern-mode (as ptr f) NUCH-REG true)
              ; The two constant kinds already have a registration-only pass —
              ; the very one a `.nuc` file's own `defconst`/`defenum` gets. The
              ; full emitters still run at import time and must: only
              ; `emit-defenum` builds the EnumDef table `match` exhaustiveness
              ; reads, and `guard-value-redefinition` recognises this prescan's
              ; Sym as the same definition by its site.
              "defconst"
                (prescan-defconst-name (as ptr f))
              "defenum"
                (prescan-defenum-names (as ptr f))
              0))))))
  ; Stage 15 W9 item 40: and a header's struct LAYOUTS, after its `defconst`s
  ; above (an `(array T N)` field length is a constant expression). A header's
  ; `defstruct` reaches the very same `emit-defstruct`, so this is the identical
  ; register-now/emit-later split a `.nuc` library gets. W9 item 46: and its
  ; `defunion`s too, which item 40 had to leave out because
  ; `emit-defunion-import` keyed the registry on the bare spelling and this
  ; prescan on `qualify-name`, so the two filed the same union in two places.
  ; Now that both use the key, the header path is the `.nuc` path: register
  ; here, and let the import emit the arm `declare`s (`ctors-emitted`).
  (prescan-struct-layouts forms)
  (prescan-union-layouts forms))

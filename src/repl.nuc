; REPL — interactive Read-Eval-Print Loop, extracted from src/nucleusc.nuc.
;
; Source-imported by src/nucleusc.nuc. Depends on the compiler's internals
; (g-globals, emit-defn, type registry, etc.) — this dependence is intentional
; since the REPL needs the full compiler API to evaluate forms incrementally.

(import-use "setjmp.h")
(import-use "poll.h")

; ============================================================
; Non-local exit — the protected call and its throw. The callback shape and the
; depth stack are both load-bearing; the reasons are in
; design/stage16-ergonomics/repl-libraries.md §3.4 and c-header-layout.md §11.
; ============================================================

(defconst REPL-MAX-PROTECT 16)

; A jump buffer belongs in the frame the jump returns into, so each protected
; frame allocas its own and publishes the pointer here. (A `defvar` could not
; hold them anyway: c-header-layout.md §11.2.)
(defvar g-repl-jmpbufs:(array ptr REPL-MAX-PROTECT))
(defvar g-repl-depth:i32 0)

; Run `(body ctx)`: 0 if it returned normally, 1 if `repl-throw` unwound out.
(defn repl-protect (body:(fn void)(ptr) ctx:ptr):i32
  ; `d` is read after the jump, and a longjmp does not restore registers.
  (let (:volatile d:i32 g-repl-depth
        :volatile fd:i32 g-fault-depth)
    (when (>= d REPL-MAX-PROTECT)
      (emit stderr "nucleus: repl-protect nested deeper than " REPL-MAX-PROTECT "\n")
      (exit 1))
    ; `_setjmp`, not `setjmp`: the latter is an unconditional glibc *function-like*
    ; macro, which a header import never admits (docs/structs-unions.md).
    (let (env:ptr (alloca (array __jmp_buf_tag 1)))
      (set! (aref g-repl-jmpbufs d) env)
      (set! g-repl-depth (+ d 1))
      (if (= (_setjmp env) 0)
        (do (body ctx)
            (set! g-repl-depth d)
            (return 0))
        (do (set! g-repl-depth d)
            ; A `macro-error` jumps out of an armed JIT call.
            (ct-fault-unwind-to fd)
            (return 1))))))

; Unwind to the innermost `repl-protect`. Never returns.
(defn repl-throw ():void
  (when (= g-repl-depth 0)
    ; Exiting is what batch does, and beats jumping into a dead frame.
    (emit stderr "nucleus: fatal error outside the REPL's protected region\n")
    (exit 1))
  (longjmp (aref g-repl-jmpbufs (- g-repl-depth 1)) 1))

; Print a rendered float on stderr as a Nucleus literal: `.0` is appended unless
; the rendering already carries a decimal point, an exponent, or is nan/inf.
(defn repl-print-float (rendered:StrView):void
  (let (i:i64 0
        n:i64 (as i64 (rendered 'len))
        marked:i32 0)
    (while (and (= marked 0) (< i n))
      (let (c:i32 (text-byte-at rendered i))
        (when (or (= c 46)     ; .
                  (= c 101)    ; e
                  (= c 69)     ; E
                  (= c 110)    ; n  (nan)
                  (= c 105))   ; i  (inf)
          (set! marked 1)))
      (set! i (+ i 1)))
    (if (!= marked 0)
      (emit stderr "  " rendered "\n")
      (emit stderr "  " rendered ".0\n"))))

; Call a JIT'd nullary thunk and print its result. `ToStr` renders f64 at
; `%.17g` and f32 at `%.9g` — the shortest round-trip widths, which is exactly
; what a REPL echo wants, so there is no format string here at all.
(defn repl-print-f64 (fp:(fn f64)()):void
  (repl-print-float (fstr (fp))))

(defn repl-print-f32 (fp:(fn f32)()):void
  (repl-print-float (fstr (fp))))

; Print a single character to stderr, JSON-escaping if needed.
(defn repl-error-json-putc (c:i32):void
  (cond (= c 34)  (emit stderr "\\\"")        ; "
        (= c 92)  (emit stderr "\\\\")        ; \
        (= c 10)  (emit stderr "\\n")
        (= c 13)  (emit stderr "\\r")
        (= c 9)   (emit stderr "\\t")
        (< c 32)  (emit stderr "\\u" (hex c 4))
        true      (emit stderr (as Char (as ui32 c)))))

(defn repl-error-json-puts (s:StrView):void
  (dotimes (i (unsafe/cast i32 (strview-byte-len &s)))
    (match (strview-byte-at &s (as usize i))
      ((err e) 0)
      ((ok b) (repl-error-json-putc (bit-and (as i32 b) 255))))))

; The most recent recovered error, for `(last-error)`. Interned rather than
; copied: an error message repeats across a session far more often than it is
; distinct, and the interner is what makes storing it free the second time.
(defvar g-last-error-msg:Symbol)
(defvar g-last-error-line:i32 0)

; Emit a structured REPL error. In text mode, prints the legacy
; "  error: <msg>\n" form. In JSON mode, prints a single JSON object on
; one line: {"file":..,"line":..,"message":..}. line of 0 is omitted.
(defn repl-error (line:i32 msg:StrView):void
  (set! g-last-error-msg (symbol-intern msg))
  (set! g-last-error-line line)
  (cond (= g-repl-format 1)
          (do (emit stderr "{\"file\":\"")
              (repl-error-json-puts (symbol-as-view g-source-path))
              (emit stderr "\",\"line\":" line ",\"message\":\"")
              (repl-error-json-puts msg)
              (emit stderr "\"}\n"))
        true
          (emit stderr "  error: " msg "\n")))

; `clock()` for `(time form)`. Declared rather than imported from <time.h>,
; which would bring a dozen struct types the compiler has no other use for.
; POSIX fixes CLOCKS_PER_SEC at 1000000 for `clock`, which is what makes the
; difference already microseconds.
(declare clock ():i64)

; ---------------------------------------------------------------------------
; REPL meta forms — design/stage18-tooling/overview.md.
;
; These were built in 2026-05, lost to a rebase a month later, and documented
; continuously throughout (docs/compiler.md "REPL meta forms"). Every one is
; restored here against the registries as they now are.
; ---------------------------------------------------------------------------

; The type printer `type-of` and `dir` need: `type-display`, but a function type
; prints as the `(fn ret p0:T …)` a prompt user would write.
(defn repl-type-to-nuc (t:?&Type):StrView
  (when (= t null) (return "?"))
  (when (!= (t 'kind) TY-FN) (return (type-display t)))
  (let ((out String) (string-new-alloc (strfmt-alloc))
        np:i32 (t 'num-params))
    (str-into &out "(fn " (repl-type-to-nuc (t 'ret)))
    (dotimes (i np)
      (let (fld:&Field (field-at (t 'params) i))
        (str-into &out " ")
        ; A name only exists where one was captured (R2). A function-pointer
        ; type, an extern and a C import never had one, so they print `pN`.
        (if (symbol-none? (fld 'name))
          (str-into &out "p" i)
          (str-into &out (fld 'name)))
        (str-into &out ":" (repl-type-to-nuc (fld 'type)))))
    (when (!= (t 'has-rest) 0) (str-into &out " :rest"))
    (when (!= (t 'nopt) 0) (str-into &out " :optional"))
    (when (!= (t 'variadic) 0)
      (when (!= np 0) (str-into &out " "))
      (str-into &out "..."))
    (str-into &out ")")
    (return (string-as-view &out))))

; Classify a bound name: "fn", "macro", "rmacro", "var", "const", "struct", or
; "" for unbound. Searched macro > rmacro > struct > scope, which is the order
; a head position resolves in. Reader macros are keyed by their PREFIX, not by
; a name, so `(kind-of "'")` is the way to ask about one.
(defn repl-classify (name:Symbol):StrView
  (when (!= (find-macro name) null) (return "macro"))
  (when (>= (rd-macro-find repl-rmacros (symbol-as-view name)) 0) (return "rmacro"))
  (when (!= (lookup-struct name) null) (return "struct"))
  (let (sym:?&Sym (scope-lookup g-globals name))
    (when (!= sym null)
      (when (or (!= (sym 'is-const) 0) (!= (sym 'readonly-global) 0)) (return "const"))
      (let (ty:?&Type (sym 'type))
        (when (and (!= ty null) (= (ty 'kind) TY-FN)) (return "fn")))
      (return "var")))
  (return ""))

; The name argument of a meta form, or `symbol-none` after reporting why not.
; A string is accepted beside a symbol because a reader-macro prefix is not a
; symbol — `(kind-of "'")` is the only way to reach the documented `rmacro`
; answer, and the quote would be consumed by the reader if written bare.
(defn repl-meta-sym-arg (form:?&Node cmd:StrView):Symbol
  (let (f:&Node (unsafe/cast &Node form))
    (when (< (node-len f) 2)
      (repl-error (f 'line) (fstr cmd ": missing symbol argument"))
      (return (symbol-none)))
    (let (a:&Node (unsafe/cast &Node (node-at f 1)))
      (when (and (!= (a 'kind) NODE-SYM) (!= (a 'kind) NODE-STR))
        (repl-error (f 'line) (fstr cmd ": argument must be a symbol or string"))
        (return (symbol-none)))
      (return (a 's)))))

; One line describing a bound name, for `dir`. Functions print the signature in
; the spelling a `defn` would take; everything else prints kind and type.
(defn repl-print-name-info (name:Symbol):void
  (let (mdef:?&MacroDef (find-macro name))
    (when (!= mdef null)
      (emit stderr "  (" name " (")
      (let (np:i32 (mdef 'num-params)
            pn:ptr (mdef 'param-names))
        (dotimes (i np)
          (when (!= i 0) (emit stderr " "))
          (if (= pn null)
            (emit stderr "p" i)
            (emit stderr (aref (unsafe/cast &Symbol pn) i))))
        (when (!= (mdef 'variadic) 0)
          (when (!= np 0) (emit stderr " "))
          (emit stderr ":rest")))
      (emit stderr ")) : macro\n")
      (return)))
  (let (sym:?&Sym (scope-lookup g-globals name))
    (when (!= sym null)
      (let (ty:?&Type (sym 'type))
        (cond (and (!= ty null) (= (ty 'kind) TY-FN))
                (do (emit stderr "  (" name " (")
                    (dotimes (i (ty 'num-params))
                      (when (!= i 0) (emit stderr " "))
                      (let (fld:&Field (field-at (ty 'params) i))
                        (if (symbol-none? (fld 'name))
                          (emit stderr "p" i)
                          (emit stderr (fld 'name)))
                        (emit stderr ":" (repl-type-to-nuc (fld 'type)))))
                    (when (!= (ty 'has-rest) 0) (emit stderr " :rest"))
                    (when (!= (ty 'nopt) 0) (emit stderr " :optional"))
                    (when (!= (ty 'variadic) 0) (emit stderr " ..."))
                    (emit stderr "):" (repl-type-to-nuc (ty 'ret)) ")\n"))
              (and (!= (sym 'is-const) 0) (!= (sym 'const-node) null))
                (do (emit stderr "  " name " : const = ")
                    (fprint-node stderr (sym 'const-node))
                    (emit stderr "\n"))
              (!= (sym 'is-const) 0)
                (emit stderr "  " name " : const = " (sym 'const-val) "\n")
              (!= (sym 'readonly-global) 0)
                (emit stderr "  " name " : const " (repl-type-to-nuc ty) "\n")
              true
                (emit stderr "  " name " : " (repl-type-to-nuc ty) "\n")))
      (return)))
  (let (sd:?&StructDef (lookup-struct name))
    (when (!= sd null) (emit stderr "  " name " : struct\n"))))

; A name's docstring, or `symbol-none`. Macros win, matching `repl-classify`.
(defn repl-docstring-of (name:Symbol):Symbol
  (let (mdef:?&MacroDef (find-macro name))
    (when (!= mdef null) (return (mdef 'docstring))))
  (let (sym:?&Sym (scope-lookup g-globals name))
    (when (!= sym null) (return (sym 'docstring))))
  (return (symbol-none)))

; Indented to line up under the `  …` the rest of the meta output uses, so an
; editor parsing the response sees one shape.
(defn repl-print-docstring (ds:Symbol):void
  (when (symbol-none? ds) (return))
  (let (v:StrView (symbol-as-view ds)
        n:i32 (unsafe/cast i32 (v 'len)))
    (when (> n 0)
      (emit stderr "    ")
      (dotimes (i n)
        (let (b:i32 (text-byte-at v (as i64 i)))
          (emit stderr (as Char (as ui32 b)))
          (when (and (= b 10) (< i (- n 1))) (emit stderr "    "))))
      (when (!= (text-byte-at v (as i64 (- n 1))) 10) (emit stderr "\n")))))

; The needle for the search modes, a module global because `repl-visit-name` is
; called per name and threading it through would be the same global by hand.
(defvar g-repl-needle:StrView)

; mode 0 = dir (info), 1 = apropos (substring over name AND docstring, then
; info + docstring), 2 = complete (prefix match, name only).
(defn repl-visit-name (name:Symbol mode:i32):void
  (when (symbol-none? name) (return))
  (cond (= mode 0)
          (repl-print-name-info name)
        (= mode 1)
          (let (nv:StrView (symbol-as-view name)
                ds:Symbol (repl-docstring-of name)
                hit:i32 0)
            (when (contains-str? &nv &g-repl-needle) (set! hit 1))
            (when (and (= hit 0) (not (symbol-none? ds)))
              (let (dv:StrView (symbol-as-view ds))
                (when (contains-str? &dv &g-repl-needle) (set! hit 1))))
            (when (!= hit 0)
              (repl-print-name-info name)
              (repl-print-docstring ds)))
        (= mode 2)
          (let (nv:StrView (symbol-as-view name))
            (when (starts-with? &nv &g-repl-needle)
              (emit stderr "  " name "\n")))
        true (do)))

; Every name the session knows: globals, macros, structs. Reader macros are
; deliberately absent — they are keyed by prefix, not by name, so they have
; nothing to list under.
(defn repl-walk-names (mode:i32):void
  (let (sc:&Scope g-globals)
    (dotimes (i (sc 'len))
      (let (sym:&Sym (as &Sym (unsafe/ptr+ (unsafe/cast &Sym (sc 'syms)) i)))
        ; A name can hold several frame entries — prescan and emit-defn both
        ; register a `defn`, and a redefinition appends. `scope-frame-find`
        ; scans backwards, so the entry it returns is the live one and every
        ; other copy is a duplicate to skip.
        (when (= (as ptr (scope-frame-find sc (sym 'name))) (as ptr sym))
          (repl-visit-name (sym 'name) mode)))))
  (dotimes (i (unsafe/cast i32 (count g-macros)))
    (let (md:&MacroDef (invoke g-macros (as usize i)))
      ; Some definers register in both tables; listing the macro again would
      ; double the entry.
      (when (= (scope-lookup g-globals (md 'name)) null)
        (repl-visit-name (md 'name) mode))))
  (dotimes (i (unsafe/cast i32 (count g-structs)))
    (let (sd:&StructDef (invoke g-structs (as usize i)))
      (when (= (scope-lookup g-globals (sd 'name)) null)
        (repl-visit-name (sd 'name) mode)))))

; The static type of an expression, printed without committing any IR. The
; module streams are opened only to satisfy `emit-node`'s writers and are
; cleared unparsed, so `(type-of (launch-missiles))` types the call and runs
; nothing.
(defn repl-type-of (arg:?&Node):void
  (open-module-streams)
  (set! g-out g-def-stream)
  (reset-function-state)
  (let (fn-scope:&Scope (scope-new g-globals)
        result:?&Val (as ?&Val (emit-node (unsafe/cast &Node arg) fn-scope)))
    (when (!= result null)
      (emit stderr "  " (repl-type-to-nuc (result 'type)) "\n")))
  (reset-function-state)
  (clear-module-buffers))

; Try `form` as a meta form. 1 = handled (including handled-and-errored).
(defn repl-handle-builtin (form:?&Node):i32
  (let (f:&Node (unsafe/cast &Node form))
    (when (or (!= (f 'kind) NODE-LIST) (= (node-len f) 0)) (return 0))
    (let (h0:&Node (unsafe/cast &Node (node-at f 0)))
      (when (!= (h0 'kind) NODE-SYM) (return 0))
      (let (h:Symbol (h0 's))
        (when (= h "defined?")
          (let (n:Symbol (repl-meta-sym-arg form "defined?"))
            (when (not (symbol-none? n))
              (let (k:StrView (repl-classify n))
                (emit stderr "  " (if (str-empty? &k) 0 1) "\n"))))
          (return 1))
        (when (= h "kind-of")
          (let (n:Symbol (repl-meta-sym-arg form "kind-of"))
            (when (not (symbol-none? n))
              (let (k:StrView (repl-classify n))
                (emit stderr "  " (if (str-empty? &k) "<unbound>" k) "\n"))))
          (return 1))
        (when (= h "type-of")
          (when (< (node-len f) 2)
            (repl-error (f 'line) "type-of: missing expression argument")
            (return 1))
          (repl-type-of (node-at f 1))
          (return 1))
        (when (= h "dir")
          (repl-walk-names 0)
          (return 1))
        (when (= h "doc")
          (let (n:Symbol (repl-meta-sym-arg form "doc"))
            (when (not (symbol-none? n))
              (let (k:StrView (repl-classify n))
                (if (str-empty? &k)
                  (emit stderr "  <unbound>\n")
                  ; A reader macro has no name-info line — the kind is the
                  ; whole answer for one.
                  (do (emit stderr "  kind: " k "\n")
                      (repl-print-name-info n)
                      (repl-print-docstring (repl-docstring-of n)))))))
          (return 1))
        (when (= h "apropos")
          (let (n:Symbol (repl-meta-sym-arg form "apropos"))
            (when (not (symbol-none? n))
              (set! g-repl-needle (symbol-as-view n))
              (repl-walk-names 1)))
          (return 1))
        (when (= h "complete")
          (let (n:Symbol (repl-meta-sym-arg form "complete"))
            (when (not (symbol-none? n))
              (set! g-repl-needle (symbol-as-view n))
              (repl-walk-names 2)))
          (return 1))
        (when (= h "locate")
          (let (n:Symbol (repl-meta-sym-arg form "locate"))
            (when (not (symbol-none? n))
              (let (file:Symbol (symbol-none) ln:i32 0 found:i32 0)
                (let (sym:?&Sym (scope-lookup g-globals n))
                  (when (!= sym null)
                    (set! file (sym 'src-file)) (set! ln (sym 'src-line))
                    (set! found 1)))
                (when (= found 0)
                  (let (md:?&MacroDef (find-macro n))
                    (when (!= md null)
                      (set! file (md 'src-file)) (set! ln (md 'src-line))
                      (set! found 1))))
                (when (= found 0)
                  (let (sd:?&StructDef (lookup-struct n))
                    (when (!= sd null)
                      (set! file (sd 'src-file)) (set! ln (sd 'src-line))
                      (set! found 1))))
                (cond (= found 0)       (emit stderr "  <unbound>\n")
                      (symbol-none? file) (emit stderr "  (no source recorded)\n")
                      true              (emit stderr "  " file ":" ln "\n")))))
          (return 1))
        (when (= h "trace")
          (let (n:Symbol (repl-meta-sym-arg form "trace"))
            (when (not (symbol-none? n))
              (let (sym:?&Sym (scope-lookup g-globals n))
                (cond (= sym null)
                        (emit stderr "  trace: <unbound>\n")
                      (or (= (sym 'type) null) (!= ((sym 'type) 'kind) TY-FN))
                        (emit stderr "  trace: " n " is not a function\n")
                      (!= (sym 'trace-tracker) null)
                        (emit stderr "  trace: " n " already traced\n")
                      true
                        (let (rt:ptr (jit-trace-module (f 'line) n (sym 'type))
                              trace-fn:i64 0 trace-impl:i64 0 tgt:i64 0)
                          (jit-lookup-addr (fstr n ".trace") (as ptr &trace-fn))
                          (jit-lookup-addr (fstr n ".trace.impl") (as ptr &trace-impl))
                          (jit-lookup-addr (fstr n ".tgt") (as ptr &tgt))
                          (if (or (= trace-fn 0) (or (= trace-impl 0) (= tgt 0)))
                            (emit stderr "  trace: JIT lookup failed\n")
                            (let (cur:ptr (aref (unsafe/cast &ptr tgt) 0))
                              (set! (aref (unsafe/cast &ptr trace-impl) 0) cur)
                              (set! (aref (unsafe/cast &ptr tgt) 0)
                                    (unsafe/cast ptr trace-fn))
                              (set! (sym 'trace-tracker) rt)
                              (set! (sym 'trace-saved) cur)
                              (emit stderr "  traced\n"))))))))
          (return 1))
        (when (= h "untrace")
          (let (n:Symbol (repl-meta-sym-arg form "untrace"))
            (when (not (symbol-none? n))
              (let (sym:?&Sym (scope-lookup g-globals n))
                (cond (= sym null)
                        (emit stderr "  untrace: <unbound>\n")
                      (= (sym 'trace-tracker) null)
                        (emit stderr "  untrace: " n " is not traced\n")
                      true
                        (let (tgt:i64 0)
                          (jit-lookup-addr (fstr n ".tgt") (as ptr &tgt))
                          (when (!= tgt 0)
                            (set! (aref (unsafe/cast &ptr tgt) 0) (sym 'trace-saved)))
                          (let (rt:ptr (sym 'trace-tracker))
                            (let (rerr:ptr (LLVMOrcResourceTrackerRemove rt))
                              (when (!= rerr null) (LLVMConsumeError rerr)))
                            (LLVMOrcReleaseResourceTracker rt))
                          (set! (sym 'trace-tracker) null)
                          (set! (sym 'trace-saved) null)
                          (emit stderr "  untraced\n"))))))
          (return 1))
        (when (or (= h "forget") (= h "reset!"))
          (let (n:Symbol (repl-meta-sym-arg form (if (= h "forget") "forget" "reset!")))
            (when (not (symbol-none? n))
              (let (handled:i32 0 warn-thunk:i32 0)
                ; Every frame entry, not just the live one: prescan and emit-defn
                ; both register, so unnaming only the latest leaves an earlier
                ; copy findable.
                (let (sc:&Scope g-globals)
                  (dotimes (i (sc 'len))
                    (let (sym:&Sym (as &Sym (unsafe/ptr+ (unsafe/cast &Sym (sc 'syms)) i)))
                      (when (= (sym 'name) n)
                        (set! handled 1)
                        (let (ty:?&Type (sym 'type))
                          (when (and (!= ty null) (= (ty 'kind) TY-FN))
                            (let (rt:ptr (sym 'tracker))
                              (when (!= rt null)
                                (let (rerr:ptr (LLVMOrcResourceTrackerRemove rt))
                                  (when (!= rerr null) (LLVMConsumeError rerr)))
                                (LLVMOrcReleaseResourceTracker rt)
                                (set! (sym 'tracker) null)))
                            (set! warn-thunk 1)))
                        (set! (sym 'name) (symbol-none))))))
                (when (= handled 0)
                  (let (md:?&MacroDef (find-macro n))
                    (when (!= md null)
                      (set! (md 'name) (symbol-none))
                      (set! handled 1))))
                (when (= handled 0)
                  (let (sd:?&StructDef (lookup-struct n))
                    (when (!= sd null)
                      (set! (sd 'name) (symbol-none))
                      (set! handled 1))))
                (cond (= handled 0)  (emit stderr "  <unbound>\n")
                      (!= warn-thunk 0)
                        ; The thunk module was added without a tracker, so the
                        ; name's ABI outlives the definition it forgot.
                        (emit stderr "  forgotten (function thunk persists; signature is locked for this session)\n")
                      true (emit stderr "  forgotten\n")))))
          (return 1))
        (when (= h "last-error")
          (cond (symbol-none? g-last-error-msg)
                  (emit stderr "  (none)\n")
                (= g-repl-format 1)
                  (do (emit stderr "  {\"line\":" g-last-error-line ",\"message\":\"")
                      (repl-error-json-puts (symbol-as-view g-last-error-msg))
                      (emit stderr "\"}\n"))
                true
                  (emit stderr "  line " g-last-error-line ": " g-last-error-msg "\n"))
          (return 1))
        (when (= h "imports")
          (let (n:i32 (node-len g-imported))
            (dotimes (i n)
              (let (e:&Node (unsafe/cast &Node (node-at g-imported i)))
                (emit stderr "  " (e 's) "\n")))
            (when (= n 0) (emit stderr "  (none)\n")))
          (return 1))
        (when (= h "casts")
          (when (= (count g-cast-rules) 0) (emit stderr "  (none)\n"))
          (dotimes (i (unsafe/cast i32 (count g-cast-rules)))
            (let (cr:&CastRule (invoke g-cast-rules (as usize i)))
              (emit stderr "  " (repl-type-to-nuc (cr 'from))
                    " -> " (repl-type-to-nuc (cr 'to))
                    " via " (cr 'ir-name) "\n")))
          (return 1))
        (when (= h "expansion-of")
          (when (< (node-len f) 2)
            (repl-error (f 'line) "expansion-of: missing form argument")
            (return 1))
          (emit stderr "  ")
          (fprint-node stderr (macroexpand-all-form (node-at f 1)))
          (emit stderr "\n")
          (return 1))
        ; The build line (repl-build-line.md §2): with arguments a form adds,
        ; with none it reports what is in force.
        (when (= h "cflag")
          (when (< (node-len f) 2)
            (repl-list-symbols g-cflags)
            (return 1))
          (let (args:&(Vector Symbol) (vector-new-in &g-arena-alloc))
            (when (!= (repl-build-args form "cflag" args) 0)
              (repl-apply-cflags args)))
          (return 1))
        (when (= h "import-path")
          (when (< (node-len f) 2)
            (repl-list-symbols g-include-paths)
            (return 1))
          (let (args:&(Vector Symbol) (vector-new-in &g-arena-alloc))
            (when (!= (repl-build-args form "import-path" args) 0)
              (repl-apply-dirs args "import-path" g-include-paths
                               "  import path: " (f 'line))))
          (return 1))
        (when (= h "library-path")
          (when (< (node-len f) 2)
            (repl-list-symbols g-library-paths)
            (return 1))
          (let (args:&(Vector Symbol) (vector-new-in &g-arena-alloc))
            (when (!= (repl-build-args form "library-path" args) 0)
              (repl-apply-dirs args "library-path" g-library-paths
                               "  library path: " (f 'line))))
          (return 1))
        (when (= h "load-library")
          (when (< (node-len f) 2)
            (repl-list-symbols g-loaded-libraries)
            (return 1))
          (let (args:&(Vector Symbol) (vector-new-in &g-arena-alloc))
            (when (!= (repl-build-args form "load-library" args) 0)
              (repl-apply-libs args (f 'line))))
          (return 1))
        (when (= h "pkg-config")
          (when (< (node-len f) 2)
            (repl-error (f 'line) "pkg-config: missing package argument")
            (return 1))
          (let (args:&(Vector Symbol) (vector-new-in &g-arena-alloc))
            (when (!= (repl-build-args form "pkg-config" args) 0)
              (repl-pkg-config args (f 'line))))
          (return 1))
        (return 0)))))

; A prompt for a line that has already arrived only stacks up ahead of the output,
; e.g. when an editor sends a multi-line form. Piped stdin keeps every prompt:
; the REPL tests' expected output is separated by them.
(defn repl-input-waiting ():i32
  (when (= (isatty 0) 0) (return 0))
  (when (< g-in-pos g-in-len) (return 1))
  (let (pf:&pollfd (as &pollfd (alloca pollfd 1)))
    (set! (pf 'fd) 0)
    (set! (pf 'events) POLLIN)
    (set! (pf 'revents) 0)
    (when (> (poll pf 1 0) 0) (return 1))
    (return 0)))

; Read lines from stdin until parens are balanced, return the accumulated buffer,
; or `none` at EOF.
(defn repl-read-input ():?String
  (let ((buf String) (string-new)
        depth:i32 0
        got-input:i32 0
        in-string:i32 0
        in-comment:i32 0
        first-line:i32 1
        done:i32 0)
    (while (= done 0)
      (when (= (repl-input-waiting) 0)
        (if (!= first-line 0)
          (emit stderr "nuc> ")
          (emit stderr "...> ")))
      (match (read-line)
        (none
          (if (= got-input 0)
            (do (drop &buf) (return (none)))
            (set! done 1)))
        ((some line)
          (let ((ln String) line)
            ; `read-line` strips the terminator; the accumulated text is source,
            ; so the newline goes back — it ends a `;` comment and it is what
            ; every reported line number counts.
            (string-push-char &ln \newline)
            (let (lv:StrView (string-as-view ln)
                  line-len:i64 (as i64 (lv 'len))
                  line-buf:ptr (as ptr (lv 'data)))
              (string-push-str-unchecked &buf &lv)
              (set! got-input 1)
              (set! first-line 0)
              ; Scan the line for paren balance, respecting strings and comments
              (let (li:i64 0)
                (while (< li line-len)
                  (let (c:i32 (bit-and (as i32 (aref (unsafe/cast &i8 line-buf) li)) 255))
                    (cond (!= in-comment 0)
                            (when (= c 10) (set! in-comment 0))
                          (!= in-string 0)
                            (cond (= c 92)  ; backslash — skip next char
                                    (set! li (+ li 1))
                                  (= c 34)  ; closing quote
                                    (set! in-string 0)
                                  true (do))
                          (= c 59)  ; semicolon — start comment
                            (set! in-comment 1)
                          (= c 34)  ; opening quote
                            (set! in-string 1)
                          (= c 40)  ; open paren
                            (set! depth (+ depth 1))
                          (= c 41)  ; close paren
                            (set! depth (- depth 1))
                          true (do)))
                  (set! li (+ li 1))))
              ; Done when parens are balanced and we have input
              (when (and (<= depth 0) (!= got-input 0))
                (set! done 1))
              (drop &ln))))))
    ; The caller drops it once read: everything the reader returns is interned.
    (return (some buf))))

; Stage 15 W8 G-3, the REPL half (design/global-init.md §4.5). There is no queue
; to accumulate across a session, because each form is its own unit: a `defvar`
; whose initializer is not constant — whether typed directly or reached through
; an `import-use` — is initialized IMMEDIATELY, by emitting a nullary init
; function into the module the global was JITed into and calling it right after.
;
; `llvm.global_ctors` is deliberately never emitted here: LLVM 19's ORC C API
; has no initializer entry point (§2.9), so a registration global would be
; exactly the silently-dead section §4.6 refuses on AVR. `drain-init-worklist`
; returns early under `g-interactive` for the same reason, leaving the queue for
; these two functions.
;
; Split in two around the JIT step: emit BEFORE `repl-jit-module` (the function
; has to be in the module), call AFTER it (the symbol has to exist). The linkage
; is external so `LLVMOrcLLJITLookup` can find it — the batch path's `internal`
; would be invisible.
(defn repl-emit-init-fn ():Symbol
  (when (>= g-init-drained (count g-init-worklist)) (return (symbol-none)))
  (let (sym:Symbol (symbol-intern (fstr "__nucleus_init_" g-repl-id)))
    (inc! g-repl-id)
    (set! g-out g-def-stream)
    (when (= (init-emit-function sym 0) 0) (return (symbol-none)))
    (return sym)))

(defn repl-run-init-fn (sym:Symbol line:i32):void
  (when (symbol-none? sym) (return))
  (let (addr:i64 0
        err:ptr (LLVMOrcLLJITLookup g-jit (as ptr &addr) (symbol-as-cstr sym)))
    (when (!= err null)
      (LLVMConsumeError err)
      (repl-error line "JIT lookup error: global initializer")
      (return))
    (when (!= addr 0)
      (funcall-void (unsafe/cast ptr addr)))))

; A stored constant is a global: JIT it and declare it to later modules.
(defn repl-finish-defconst (f:&Node):void
  (let (nm:Symbol (defconst-bare-name (node-at f 1)))
    (if-some (sym (scope-lookup g-globals nm))
      (when (= (sym 'is-const) 0)
        (repl-flush-mono (f 'line))
        (repl-jit-module (f 'line))
        (emit g-repl-preamble (sym 'ir-name) " = external global " (type-to-ir (sym 'type)) "\n")
        (repl-preamble-note-decl (symbol-intern (sym 'ir-name)))
        (return))
      0))
  (clear-module-buffers))

; Non-zero while the session boots its own `(import-use prelude)`, which goes
; through the ordinary import arm but is not something the user typed.
(defvar g-repl-booting:i32 0)

; Redefining a global (docs/compiler.md): same type reuses the storage so compiled
; code sees the new value; otherwise fresh storage that only later code sees.
(defvar g-repl-global-redef:i32 0)  ; 0 defined, 1 value replaced, 2 retyped
(defvar g-repl-redef-id:i32 0)
(defvar g-repl-retype-suffix:StrView)

(defn repl-redefine-global (cc:&Node name:Symbol ty:?&Type init-node:?&Node attr-flags:i32):bool
  (when (or (= g-interactive 0) (!= (in-jit-module) 0)) (return false))
  (if-some (prev (scope-lookup-key g-globals name))
    (let (stored:bool (= (prev 'defvar-state) DEFVAR-REACHED))
      (when (and (not stored) (= (prev 'is-const) 0)) (return false))
      (inc! g-repl-redef-id)
      ; Storage that cannot take the value: the old name is in the preamble.
      (when (or (not stored) (!= (prev 'readonly-global) 0)
                (!= (bit-and attr-flags DECL-ATTR-CONST) 0)
                (= (type-eq (as ?&Type (prev 'type)) ty) 0))
        (set! g-repl-global-redef (if stored 2 1))
        (set! g-repl-retype-suffix (fstr "." g-repl-redef-id))
        (return false))
      ; The ordinary path builds the new value in a scratch global of every
      ; initializer shape; the init function then copies it in.
      (let (tmp:Symbol (symbol-intern (fstr "__repl-redef-" g-repl-redef-id "-" name))
            line:i32 (cc 'line))
        (emit-global-def cc tmp (as ptr ty) init-node attr-flags)
        ; An array is storage, which `set!` refuses.
        (init-queue-form
          (if (= ((unsafe/cast &Type ty) 'kind) TY-ARRAY)
            (node-list4 (intern-node (symbol-intern "memcpy")) (intern-node name) (intern-node tmp)
                        (node-int (as i64 (abi-sizeof (as ptr ty)))) line)
            (node-list3 (intern-node (symbol-intern "set!")) (intern-node name) (intern-node tmp) line))
          name (symbol-intern (prev 'ir-name)) line)
        (set! g-repl-global-redef 1)
        (return true)))
    (return false)))

; Confirm what an import form did. Success and the dedup no-op were both silent,
; so a swallowed retry looked exactly like a fresh import (repl-libraries.md §3.5).
(defn repl-report-import (form:?&Node fresh:i32):void
  (when (!= g-repl-booting 0) (return))
  (let (nn:ptr (node-at form 1)
        k:i32 (node-kind nn))
    (when (and (!= k NODE-SYM) (!= k NODE-STR)) (return))
    (let (name:Symbol ((unsafe/cast &Node nn) 's))
      (if (!= fresh 0)
        (emit stderr "  imported " name "\n")
        (emit stderr "  " name " already imported\n")))))

; Process a single REPL form: parse, compile to IR, JIT, and call.
; Returns the result type kind (TY-VOID, TY-I32, etc.) or -1 on error.
(defn repl-eval-form (form:?&Node):void
  (let (f:&Node (unsafe/cast &Node form))
    (when (= (as ptr f) null) (return))
    ; Short-circuit: a bare string literal prints as itself.
    (when (= (f 'kind) NODE-STR)
      (emit stderr "  ")
      (fprint-node stderr form)
      (emit stderr "\n")
      (return))
    ; Short-circuit: '(form) — print the quoted AST without JIT.
    (when (and (= (f 'kind) NODE-LIST)
                (!= (node-len form) 0)
                (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 'kind) (= _ NODE-SYM))
                (= (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 's)) "quote"))
      (emit stderr "  ")
      (fprint-node stderr (node-at form 1))
      (emit stderr "\n")
      (return))
    ; Check if it's a list starting with a known keyword
    (let (h:Symbol (symbol-none)
          is-expr:i32 1)
      (when (and (= (f 'kind) NODE-LIST)
                 (!= (node-len (as ptr f)) 0)
                 (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 'kind) (= _ NODE-SYM)))
        (set! h (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 's))))
      ; The meta forms, before the defining chain: they are REPL-only spellings
      ; and `repl-handle-builtin` answers for no other head.
      (when (!= (repl-handle-builtin form) 0) (return))
      ; Top-level defining forms
      (cond (and (not (symbol-none? h)) (= h "ns"))
              ; Stage 12: set the current namespace. emit-ns is silent on a
              ; second `ns` under the REPL flag (g-interactive), as designed.
              (do (emit-ns (as ptr f)) (set! is-expr 0))
            (and (not (symbol-none? h)) (= h "defconst"))
              (do (open-module-streams)
                  (set! g-out &g-decl-stream)
                  (set! g-repl-retype-suffix "")
                  (emit-defconst (as ptr f))
                  (repl-finish-defconst f)
                  (set! is-expr 0))
            (and (not (symbol-none? h)) (= h "defenum"))
              (do (emit-defenum (as ptr f)) (set! is-expr 0))
            (and (not (symbol-none? h)) (= h "defvar"))
              ; Stage 15 W8 G-3 (design/global-init.md §4.5): a non-constant
              ; initializer runs immediately — see repl-emit-init-fn above.
              (do (open-module-streams)
                  (set! g-out &g-decl-stream)
                  (set! g-repl-global-redef 0)
                  (set! g-repl-retype-suffix "")
                  (emit-defvar (as ptr f))
                  (let (init-sym:Symbol (repl-emit-init-fn))
                    (repl-flush-mono (f 'line))
                    (repl-jit-module (f 'line))
                    (repl-run-init-fn init-sym (f 'line)))
                  ; Add external global reference to preamble AFTER successful JIT
                  (let (var-node:ptr (node-at form 1))
                    (when (!= var-node null)
                      (let (vname:Symbol (symbol-none))
                        ; G-2: this re-resolves the SAME defvar type node
                        ; emit-defvar just resolved, so it needs the same
                        ; `(array T N)` permission.
                        (extract-decl-name-and-type var-node (as &Symbol &vname)
                                                    ((unsafe/cast &Node var-node) 'line))
                        ; The Sym's IR name, not a re-derivation: a retyped
                        ; global's carries a suffix.
                        (if-some (vs (scope-lookup-key g-globals vname))
                          (let (irn:Symbol (symbol-intern (vs 'ir-name)))
                            (when (= (repl-preamble-has-decl irn) 0)
                              (emit g-repl-preamble irn " = external global "
                                    (type-to-ir (vs 'type)) "\n")
                              (repl-preamble-note-decl irn)))
                          0))))
                  (cond (= g-repl-global-redef 1) (emit stderr "  redefined\n")
                        (= g-repl-global-redef 2)
                          (emit stderr "  redefined with a new type; code compiled earlier still uses the old storage\n")
                        true (emit stderr "  defined\n")))
            ; Stage 16: an alias emits no IR and defines no layout, so unlike
            ; defstruct it has no module to open and no preamble to push —
            ; registering it is the whole job (container-type-sugar.md §3.2).
            (and (not (symbol-none? h)) (or (= h "deftype") (= h "deftype-")))
              (do (register-type-alias (as ptr f) (if (= h "deftype-") 1 0))
                  (alias-body-check f)
                  (emit stderr "  defined\n"))
            (and (not (symbol-none? h)) (= h "defstruct"))
              (do (open-module-streams)
                  (set! g-out &g-type-stream)
                  (emit-defstruct (as ptr f))
                  (drain-pending-union-irs)
                  (repl-absorb-type-buf)
                  (clear-module-buffers)
                  (emit stderr "  defined\n"))
            (and (not (symbol-none? h)) (= h "defunion"))
              ; Tagged sum: register the type (or template), JIT the arm
              ; constructors, then push the type defs + constructor declares
              ; into the preamble for future modules.
              (do (open-module-streams)
                  (set! g-out &g-type-stream)
                  ; Stage 15 B3′: the definition side holds a KEY. `emit-defunion`
                  ; below registers under `qualify-name`'s key, so pre-registering
                  ; the bare name would mint a second StructDef the moment a REPL
                  ; session declares a namespace. Identity in `user`, which is
                  ; every session that does not.
                  (let (nn:&Node (unsafe/cast &Node (node-at form 1)))
                    (when (and (= (nn 'kind) NODE-SYM)
                               (= (as ptr (lookup-struct (qualify-name (nn 's)))) null))
                      (register-struct (qualify-name (nn 's)))))
                  (prescan-union-ctors (as ptr f))
                  (finalize-generics)
                  (set! g-out g-def-stream)
                  (emit-defunion (as ptr f))
                  (drain-pending-union-irs)
                  (repl-flush-mono (f 'line))
                  (repl-jit-module (f 'line))
                  (let (nn:&Node (unsafe/cast &Node (node-at form 1)))
                    (when (= (nn 'kind) NODE-SYM)
                      (repl-declare-union-ctors (nn 's))))
                  (emit stderr "  defined\n"))
            (and (not (symbol-none? h)) (= h "extern"))
              (let (pre-len:i32 (g-globals 'len))
                  (open-module-streams)
                  (set! g-out &g-decl-stream)
                  (emit-extern (as ptr f))
                  (repl-absorb-type-buf)
                  (emit-all g-repl-preamble g-decl-stream)
                  (clear-module-buffers)
                  (repl-note-globals-decls pre-len))
            (and (not (symbol-none? h)) (= h "defn"))
              ; Redefinition strategy: each defn produces a stable thunk
              ; @<fname> (defined once on first sight) that loads its current
              ; impl from @<fname>.tgt and dispatches. The function body is
              ; JIT'd under a fresh resource tracker as @<fname>.impl.<N>, and
              ; @<fname>.tgt is updated to point at it. On redefinition, the
              ; old impl tracker is removed, a new impl is JIT'd as
              ; @<fname>.impl.<N+1>, and @<fname>.tgt is repointed. Existing
              ; callers and `&foo` bind to the thunk and pick up the
              ; new impl transparently.
              (let (name-node:ptr (node-at form 1)
                    fname:Symbol (symbol-none)  ret-name:Symbol (symbol-none))
                (when (not (node-empty? (as ?&Node name-node)))
                  (require-sig-name (as ?&Node name-node) "defn: name" (f 'line))
                  (extract-name-type name-node (as &Symbol &fname)
                                               (as &Symbol &ret-name)))
                (cond
                  (symbol-none? fname)
                    (repl-error (f 'line) "defn: missing name")
                  ; R3 (repl-libraries.md §6): a bounded-generic / parametric-
                  ; receiver template emits no `define` at all — it is stamped
                  ; per call site — so the thunk + @name.impl.N machinery below
                  ; has nothing to rename and reported a spurious
                  ; `lookup of <name>.impl.0 failed`. Registering it is the
                  ; whole job; the stamps are drained by repl-flush-mono at
                  ; whichever entry first calls it.
                  (!= (defn-is-generic-template f) 0)
                    (do (open-module-streams)
                        (let (one-form:ptr (node-list1 form (f 'line)))
                          (prescan-defn-signatures one-form))
                        (drain-where-checks)
                        (set! g-out g-def-stream)
                        (emit-defn (as ptr f))
                        (drain-pending-union-irs)
                        (repl-absorb-type-buf)
                        (clear-module-buffers)
                        (emit stderr "  defined\n"))
                  true
                    ; Derive fname-ir the same way batch does for a solitary
                    ; defn: ns-ir-base composes the current namespace's prefix
                    ; onto ir-name-token(fname), so `?`→_QMARK / `!`→_BANG and
                    ; hyphens pass through unchanged. This is exactly the symbol
                    ; emit-defn writes (via defn-ir-name → ns-ir-base), so the
                    ; thunk / @fname.impl.N / @fname.tgt machinery and the
                    ; rewrite of "@fname(" all reference the real emitted symbol.
                    ; Raw sanitize-for-ir diverged (arena-alloc → arena_alloc,
                    ; full? → full_) and broke redefinition of any such name.
                    ; The REPL only handles the solitary (non-overloaded) case,
                    ; which is precisely defn-ir-name's ns-ir-base fallback.
                    (let (fname-ir:Symbol (ns-ir-base fname)
                          is-redef:i32 0
                          ; B2b: definition-side (is this a redefinition?), so
                          ; the KEY lookup — same question `scope-define` answers.
                          old-sym:?&Sym (scope-lookup-key g-globals fname))
                      (when (!= old-sym null)
                        (set! is-redef 1)
                        (let (old-rt:ptr (old-sym 'tracker))
                          (when (!= old-rt null)
                            (let (rerr:ptr (LLVMOrcResourceTrackerRemove old-rt))
                              (when (!= rerr null)
                                (repl-error (f 'line)
                                  (fstr "redefinition: tracker remove failed: "
                                        (as CStr (LLVMGetErrorMessage rerr))))))
                            (LLVMOrcReleaseResourceTracker old-rt)
                            (set! (old-sym 'tracker) null))))
                      (let (impl-id:i32 (unsafe/cast i32 g-defn-impl-counter)
                            impl-name:Symbol (symbol-none))
                        (set! g-defn-impl-counter (+ g-defn-impl-counter 1))
                        (set! impl-name (symbol-intern (fstr fname-ir ".impl." impl-id)))
                        ; When redefining, remove the old method from the
                        ; generic before prescan adds the new one.
                        ; Otherwise finalize-generics sees a duplicate signature.
                        (when (and (!= is-redef 0) (!= old-sym null))
                          (let (old-g:?&Generic (generic-lookup fname))
                            (when (!= old-g null)
                              (let (old-ft:&Type (unsafe/cast &Type (old-sym 'type)))
                                (when (= (old-ft 'kind) TY-FN)
                                  ; §14.4: materialize the fn Type's param Vector back
                                  ; into a raw Type*[] — generic-remove-matching-user-method
                                  ; compares against Method.param-types (still a raw array).
                                  (let (onp:i32 (old-ft 'num-params)
                                        oparr:ptr (if (> onp 0)
                                                    (arena-alloc (* onp (ptr-bytes)))
                                                    null))
                                    (dotimes (ok onp)
                                      (set! (aref (unsafe/cast &ptr oparr) ok) (as ptr ((field-at (old-ft 'params) ok) 'type))))
                                    (generic-remove-matching-user-method
                                      old-g oparr onp)))))))
                        (open-module-streams)
                        (let (one-form:ptr (node-list1 form (f 'line)))
                          (prescan-defn-signatures one-form))
                        (set! g-out g-def-stream)
                        (emit-defn (as ptr f))
                        (jit-ensure-init (f 'line))
                        ; First definition: JIT the thunk module and add a
                        ; declare for @fname-ir to the preamble so subsequent
                        ; modules can call it.
                        (when (= is-redef 0)
                          ; B2b: reads back the Sym `emit-defn` just wrote — a
                          ; KEY, not a reference.
                          (let (sym:?&Sym (scope-lookup-key g-globals fname))
                            (when (!= sym null)
                              (let (ft:&Type (unsafe/cast &Type (sym 'type)))
                                (when (= (ft 'kind) TY-FN)
                                  (jit-thunk-module (f 'line) fname-ir (as ptr ft))
                                  ; ABI-lower the preamble declare the same way
                                  ; emit-defn lowered the define it names — raw
                                  ; type-to-ir disagreed on any by-value struct
                                  ; param/return, on every target.
                                  (let (rinfo:&AbiInfo
                                          (unsafe/cast &AbiInfo (abi-classify (ft 'ret))))
                                    (emit g-repl-preamble "declare "
                                          (abi-ret-ir rinfo (ft 'ret)) " @" fname-ir "(")
                                    (let (need-comma:i32 0)
                                      (when (= (rinfo 'kind) ABI-MEMORY)
                                        (emit g-repl-preamble "ptr sret(" (type-to-ir (ft 'ret))
                                              ") align " (rinfo 'align))
                                        (set! need-comma 1))
                                      (abi-args-begin rinfo)
                                      (dotimes (pi (ft 'num-params))
                                        (when (!= need-comma 0) (emit g-repl-preamble ", "))
                                        (abi-print-param-to g-repl-preamble
                                          (abi-classify-arg ((field-at (ft 'params) pi) 'type))
                                          ((field-at (ft 'params) pi) 'type)
                                          (symbol-none))
                                        (set! need-comma 1)))
                                    (emit g-repl-preamble ")\n")
                                    ; R3/D8: a later macro JIT module is
                                    ; assembled with this preamble, so its own
                                    ; declare latch has to know this line exists.
                                    (repl-preamble-note-decl
                                      (symbol-intern (fstr "@" fname-ir)))))))))
                        ; R3 constraint 4: after the thunk (a lifted lambda can
                        ; call @fname-ir recursively, so its declare must be in
                        ; the preamble first) and into a module of its own — the
                        ; tracker created below is removed on the next
                        ; redefinition of THIS defn, which would take every
                        ; unrelated stamp drained beside it.
                        (repl-flush-mono (f 'line))
                        ; JIT the impl module under a fresh tracker, renaming
                        ; the captured "@fname-ir(" to "@impl-name(".
                        (let (rt:ptr (LLVMOrcJITDylibCreateResourceTracker g-jit-dylib))
                          (repl-jit-module-rt-rewrite (f 'line) rt fname-ir impl-name)
                          ; Patch @fname-ir.tgt to point at @impl-name. Stash
                          ; the tracker on the latest Sym for the next
                          ; redefinition to remove.
                          (when (= (update-fn-tgt (f 'line) fname-ir impl-name) 0)
                            (let (sym:?&Sym (scope-lookup-key g-globals fname))
                              (when (!= sym null)
                                (set! (sym 'tracker) rt))))))
                      (if (!= is-redef 0)
                        (emit stderr "  redefined\n")
                        (emit stderr "  defined\n")))))
            (and (not (symbol-none? h)) (= h "compile-time"))
              ; R4: the CT module is assembled inside emit-compile-time; close
              ; this entry's own buffers after it and carry their types forward.
              (do (open-module-streams)
                  (emit-compile-time (as ptr f))
                  (repl-absorb-type-buf)
                  (clear-module-buffers))
            (and (not (symbol-none? h)) (= h "defmacro"))
              ; open-module-streams first, exactly as the `compile-time` arm
              ; above does and for the same reason: compile-macro-body starts by
              ; flushing g-type-stream/g-decl-stream, and between REPL forms
              ; those FILE*s are closed — so a user `defmacro` typed at the
              ; prompt aborted the session with "glibc detected an invalid stdio
              ; handle" (pre-Stage-16 behaviour; reproduced on the stage-15
              ; boot). The prelude's own macros never hit this: they are loaded
              ; through repl-preload-prelude, not this arm.
              (do (open-module-streams)
                  (emit-defmacro (as ptr f))
                  (repl-absorb-type-buf)
                  (clear-module-buffers)
                  (emit stderr "  defined\n"))
            ; Already registered in `repl-rmacros` while the input was read.
            (and (not (symbol-none? h)) (= h "def-rmacro"))
              (emit stderr "  defined\n")
            (and (not (symbol-none? h))
                 (or (= h "macroexpand")
                     (= h "macroexpand-1")
                     (= h "macroexpand-all")))
              (do (set! is-expr 0)
                  ; Default depth: -1 (fixpoint) for macroexpand, 1 for macroexpand-1.
                  ; macroexpand-all uses recursive expansion (depth ignored).
                  (let (depth:i32 -1
                        is-all:bool (= h "macroexpand-all"))
                    (when (= h "macroexpand-1") (set! depth 1))
                    ; Optional second arg overrides the default depth.
                    (when (>= (node-len f) 3)
                      (let (d-node:&Node (unsafe/cast &Node (node-at form 2)))
                        (when (= (d-node 'kind) NODE-INT)
                          (set! depth (unsafe/cast i32 (d-node 'i))))))
                    (when (< (node-len f) 2)
                      (repl-error (f 'line) (fstr h " requires a form argument"))
                      (return))
                    (let (arg:ptr (node-at form 1))
                      ; Peel a leading (quote X) so the user can write 'form.
                      (when (and (!= arg null)
                                 (= ((unsafe/cast &Node arg) 'kind) NODE-LIST)
                                 (!= (node-len (unsafe/cast &Node arg)) 0))
                        (let (qh:&Node (unsafe/cast &Node (node-at (unsafe/cast &Node arg) 0)))
                          (when (and (= (qh 'kind) NODE-SYM)
                                     (= (qh 's) "quote"))
                            (set! arg (node-at (unsafe/cast &Node arg) 1)))))
                      ; Detect whether the form is actually a macro call. If
                      ; not, macroexpand-form would silently return the input
                      ; unchanged, which looks identical to a successful
                      ; expansion that produced the same form. Report it
                      ; explicitly so the user isn't misled.
                      (let (head-name:Symbol (symbol-none))
                        (when (and (!= arg null)
                                   (= ((unsafe/cast &Node arg) 'kind) NODE-LIST)
                                   (!= (node-len (unsafe/cast &Node arg)) 0))
                          (let (ah:&Node (unsafe/cast &Node (node-at (unsafe/cast &Node arg) 0)))
                            (when (= (ah 'kind) NODE-SYM)
                              (set! head-name (ah 's)))))
                        (if (and (not is-all)
                                 (or (symbol-none? head-name)
                                     (= (find-macro head-name) null)))
                          (do (emit stderr "  not a macro call: ")
                              (fprint-node stderr arg)
                              (emit stderr "\n"))
                          (let (expanded:ptr (if is-all
                                               (macroexpand-all-form arg)
                                               (macroexpand-form arg depth)))
                            (emit stderr "  ")
                            (fprint-node stderr expanded)
                            (emit stderr "\n")))))))
            ; All six import spellings. Stage 15 B2b retired the alias `Sym`s a
            ; prefixed import injected, so the backfill below sees what a flat one gives.
            (and (not (symbol-none? h))
                 (or (or (= h "import-use") (= h "import-only"))
                     (or (or (= h "import") (= h "import-prefixed"))
                         (or (= h "import-ct") (= h "unsafe/import-private")))))
              (do (let (pre-len:i32 (g-globals 'len)
                        pre-imported:ptr g-imported
                        pre-ct-imported:ptr g-ct-imported
                        pre-aliased:ptr g-import-aliased)
                    (open-module-streams)
                    (cond (= h "import-use")  (emit-import-use (as ptr f))
                          (= h "import-only") (emit-import-only (as ptr f))
                          (= h "import-ct")   (emit-import-ct (as ptr f))
                          (= h "unsafe/import-private")
                            (emit-unsafe-import-private (as ptr f))
                          true (emit-import-prefixed (as ptr f)))
                    ; Land lazily-emitted union type defs in this module's type
                    ; buffer, copy it, and append the copy to the preamble only
                    ; AFTER the module is JIT'd — the module itself already
                    ; includes both the preamble and its own type buffer, so an
                    ; early append would define every type twice.
                    ; R3: emit-toplevel-forms already drains into THIS module at
                    ; every depth, so this is normally a no-op; it is here for
                    ; anything an import queues after that tail drain.
                    (repl-flush-mono (f 'line))
                    (drain-pending-union-irs)
                    ; G-3 (§4.5): an imported file's `defvar` with a run-time
                    ; initializer queues exactly as a directly typed one does,
                    ; and `drain-init-worklist` deliberately leaves it alone
                    ; under `g-interactive`. Drain it here, into this module,
                    ; and call it after the JIT — otherwise the import would
                    ; register an `llvm.global_ctors` entry ORC never runs and
                    ; the global would silently read back its zero (measured).
                    (let (init-sym:Symbol (repl-emit-init-fn))
                      (repl-jit-module (f 'line))
                      (repl-run-init-fn init-sym (f 'line)))
                    ; R3 (D7): a stamp, a lifted lambda and a closure
                    ; invoke/drop are emitted into this module by the drain at
                    ; the tail of emit-toplevel-forms, and none of them is a
                    ; `Sym` — so the name-keyed walk below cannot see them and
                    ; the next entry that calls one finds no declare. Same for
                    ; every overloaded defn the library exports, which lives in
                    ; the generic registry rather than in g-globals.
                    (repl-backfill-progdefn-decls)
                    ; Add declares for newly imported functions to preamble
                    ; Skip duplicate scope entries (prescan + emit-defn both register)
                    (let (si:i32 pre-len)
                      (while (< si (g-globals 'len))
                        (let (sym:&Sym (as &Sym (unsafe/ptr+ (unsafe/cast &Sym (g-globals 'syms)) si))
                              ft:&Type (unsafe/cast &Type (sym 'type)))
                          (when (= (ft 'kind) TY-FN)
                            ; Only emit if no later entry has the same name (dedup)
                            (let (is-dup:i32 0
                                  dj:i32 (+ si 1))
                              (while (< dj (g-globals 'len))
                                (let (nxt:&Sym (as &Sym (unsafe/ptr+ (unsafe/cast &Sym (g-globals 'syms)) dj)))
                                  (when (= (nxt 'name) (sym 'name))
                                    (set! is-dup 1)))
                                (inc! dj))
                              ; R3/D8: the preamble is a module buffer of its
                              ; own, and a second `declare` of one name in one
                              ; module is an LLVM parse error.
                              (when (!= (repl-preamble-has-decl (symbol-intern (sym 'ir-name))) 0)
                                (set! is-dup 1))
                              (when (= is-dup 0)
                                (repl-preamble-note-decl (symbol-intern (sym 'ir-name)))
                                ; ABI-lower exactly as the define does (see the
                                ; first-definition declare above). need-comma
                                ; rather than `pi != 0` / `num-params != 0`
                                ; because an sret prefix already occupies the
                                ; first operand slot even at zero parameters.
                                (let (rinfo:&AbiInfo
                                        (unsafe/cast &AbiInfo (abi-classify (ft 'ret))))
                                  (emit g-repl-preamble "declare " (abi-ret-ir rinfo (ft 'ret))
                                        " " (sym 'ir-name) "(")
                                  (let (need-comma:i32 0)
                                    (when (= (rinfo 'kind) ABI-MEMORY)
                                      (emit g-repl-preamble "ptr sret(" (type-to-ir (ft 'ret))
                                            ") align " (rinfo 'align))
                                      (set! need-comma 1))
                                    (abi-args-begin rinfo)
                                    (dotimes (pi (ft 'num-params))
                                      (when (!= need-comma 0) (emit g-repl-preamble ", "))
                                      (abi-print-param-to g-repl-preamble
                                        (abi-classify-arg ((field-at (ft 'params) pi) 'type))
                                        ((field-at (ft 'params) pi) 'type)
                                        (symbol-none))
                                      (set! need-comma 1))
                                    (when (!= (ft 'variadic) 0)
                                      (let (sep:StrView "")
                                        (when (!= need-comma 0) (set! sep ", "))
                                        (emit g-repl-preamble sep "..."))))
                                  (emit g-repl-preamble ")\n"))))))
                        (inc! si)))
                    ; Nothing new on any of the four registries an import can
                    ; grow means `do-import` returned on a dedup gate.
                    (let (fresh:i32 0)
                      (when (!= g-imported pre-imported) (set! fresh 1))
                      (when (!= g-ct-imported pre-ct-imported) (set! fresh 1))
                      (when (!= g-import-aliased pre-aliased) (set! fresh 1))
                      (when (> (g-globals 'len) pre-len) (set! fresh 1))
                      (repl-report-import form fresh))))
            (and (not (symbol-none? h)) (= h "time"))
              ; Not in `repl-handle-builtin`: it re-enters the evaluator, and
              ; same-function recursion needs no forward declaration.
              (do (set! is-expr 0)
                  (if (< (node-len f) 2)
                    (repl-error (f 'line) "time: missing form argument")
                    (let (t0:i64 (clock))
                      (repl-eval-form (node-at form 1))
                      (emit stderr "  ; elapsed: " (- (clock) t0) " us\n"))))
            true
              ; Expression — wrap in __repl_eval_N and JIT
              (do (open-module-streams)
                  (let (eval-sym:Symbol (symbol-intern (fstr "__repl_eval_" g-repl-id)))
                    (inc! g-repl-id)
                    (set! g-out g-def-stream)
                    (reset-function-state)
                    (let (fn-scope:&Scope (scope-new g-globals)
                          result:&Val (as &Val (emit-node (as ptr f) fn-scope))
                          result-kind:i32 ((result 'type) 'kind)
                          ; Returned as i64, printed by signedness.
                          wide-int:bool (or (= result-kind TY-UI8) (= result-kind TY-UI16)
                                            (= result-kind TY-UI32) (= result-kind TY-UI64)
                                            (= result-kind TY-USIZE) (= result-kind TY-SSIZE)))
                      ; Generate the return based on result type
                      (when (= g-block-term 0)
                        (cond (= result-kind TY-VOID)
                                (emit g-body-stream "  ret void\n")
                              (or (= result-kind TY-I32)
                                  (= result-kind TY-BOOL)
                                  (= result-kind TY-I8) (= result-kind TY-I16))
                                (do (let (ret-val:StrView (result 'val))
                                      (when (!= result-kind TY-I32)
                                        (let (ext-tmp:StrView (new-tmp))
                                          (cond (= result-kind TY-BOOL)
                                                  (emit g-body-stream "  " ext-tmp " = zext i1 "
                                                        (result 'val) " to i32\n")
                                                (= result-kind TY-I8)
                                                  (emit g-body-stream "  " ext-tmp " = sext i8 "
                                                        (result 'val) " to i32\n")
                                                (= result-kind TY-I16)
                                                  (emit g-body-stream "  " ext-tmp
                                                        " = sext i16 " (result 'val) " to i32\n")
                                                true (do))
                                          (set! ret-val ext-tmp)))
                                      (emit g-body-stream "  ret i32 " ret-val "\n")))
                              (= result-kind TY-I64)
                                (emit g-body-stream "  ret i64 " (result 'val) "\n")
                              wide-int
                                (let (irt:StrView (type-to-ir (result 'type))
                                      rv:StrView (result 'val))
                                  (when (!= irt "i64")
                                    (set! rv (new-tmp))
                                    (emit g-body-stream "  " rv " = "
                                          (if (!= (is-unsigned (result 'type)) 0) "zext " "sext ")
                                          irt " " (result 'val) " to i64\n"))
                                  (emit g-body-stream "  ret i64 " rv "\n"))
                              (= result-kind TY-PTR)
                                (emit g-body-stream "  ret ptr " (result 'val) "\n")
                              (= result-kind TY-F32)
                                (emit g-body-stream "  ret float " (result 'val) "\n")
                              (= result-kind TY-F64)
                                (emit g-body-stream "  ret double " (result 'val) "\n")
                              ; FL-1: the wide widths return through the JIT the
                              ; same way; only the PRINTING side below has no
                              ; helper for them yet, so they show as <value>.
                              (!= (is-float-type (result 'type)) 0)
                                (emit g-body-stream "  ret " (type-to-ir (result 'type)) " "
                                      (result 'val) "\n")
                              true
                                (emit g-body-stream "  ret void\n")))
                      ; Build function definition
                      (let (ret-ir:StrView "void")
                        (when (or (= result-kind TY-I32)
                                  (= result-kind TY-BOOL)
                                  (= result-kind TY-I8)
                                  (= result-kind TY-I16))
                          (set! ret-ir "i32"))
                        (when (or (= result-kind TY-I64) wide-int) (set! ret-ir "i64"))
                        (when (= result-kind TY-PTR) (set! ret-ir "ptr"))
                        (when (= result-kind TY-F32) (set! ret-ir "float"))
                        (when (= result-kind TY-F64) (set! ret-ir "double"))
                        (when (or (= result-kind TY-F16)
                                  (or (= result-kind TY-F80) (= result-kind TY-F128)))
                          (set! ret-ir (type-to-ir (result 'type))))
                        (emit g-def-stream "define " ret-ir " @" eval-sym "() {\n")
                        (emit g-def-stream "entry:\n")
                        (emit-all g-def-stream g-entry-stream)
                        (emit-all g-def-stream g-body-stream)
                        (emit g-def-stream "}\n\n")
                        (string-clear g-entry-stream)
                        (string-clear g-body-stream)
                        ; Build and JIT module
                        ; R3: the expression may have stamped a generic, lifted
                        ; a lambda or built a closure — their bodies and the
                        ; preamble `declare`s this module needs come from here.
                        (repl-flush-mono (f 'line))
                        (repl-jit-module (f 'line))
                        ; Look up and call the eval function
                        (let (addr:i64 0)
                          (let (err:ptr (LLVMOrcLLJITLookup g-jit (as ptr &addr) (symbol-as-cstr eval-sym)))
                            (when (!= err null)
                              (repl-error (f 'line)
                                (fstr "JIT lookup error: "
                                      (as CStr (LLVMGetErrorMessage err))))
                              (return))
                            (when (!= addr 0)
                              ; Call and print result based on type
                                  (cond (or (= result-kind TY-I32)
                                            (= result-kind TY-BOOL)
                                            (= result-kind TY-I8)
                                            (= result-kind TY-I16))
                                      (let (fn:ptr (unsafe/cast ptr addr)
                                            rv:i32 (unsafe/funcall-ptr-i32 fn))
                                        (emit stderr "  " rv "\n"))
                                    (= result-kind TY-I64)
                                      (let (fn:ptr (unsafe/cast ptr addr)
                                            rv:i64 (unsafe/funcall-ptr-i64 fn))
                                        (emit stderr "  " rv "\n"))
                                    wide-int
                                      (let (rv:i64 (unsafe/funcall-ptr-i64 (unsafe/cast ptr addr)))
                                        (if (!= (is-unsigned (result 'type)) 0)
                                          (emit stderr "  " (unsafe/cast ui64 rv) "\n")
                                          (emit stderr "  " rv "\n")))
                                    (= result-kind TY-PTR)
                                      (let (fn:ptr (unsafe/cast ptr addr)
                                            rv:ptr (unsafe/funcall-ptr-ptr fn))
                                        (if (!= rv null)
                                          ; glibc's `%p` is "0x" then minimal
                                          ; lowercase hex, which is `hex … 0`.
                                          (emit stderr "  #<ptr 0x"
                                                (hex (unsafe/cast i64 rv) 0) ">\n")
                                          (emit stderr "  null\n")))
                                    (= result-kind TY-F64)
                                      (repl-print-f64
                                        (unsafe/cast ((fn f64)()) (unsafe/cast ptr addr)))
                                    (= result-kind TY-F32)
                                      (repl-print-f32
                                        (unsafe/cast ((fn f32)()) (unsafe/cast ptr addr)))
                                    (= result-kind TY-VOID)
                                      (funcall-void (unsafe/cast ptr addr))
                                    true
                                      ; A wide float (FL-1) returns its value and stays
                                      ; uncalled: an f80 through a void call is left on the x87 stack.
                                      (when (= ret-ir "void")
                                        (funcall-void (unsafe/cast ptr addr)))))))))))))))

; Replace the first "@<fname>(" in buf with "@<impl-name>(" and write the
; result to out. Used when wrapping a user-defined REPL function in a thunk:
; the captured IR `define <ret> @<fname>(...) { ... }` becomes
; `define <ret> @<impl-name>(...) { ... }`. Subsequent occurrences of
; `@<fname>(` (self-recursion call sites in the body) are left intact so they
; go through the thunk.
(defn rewrite-first-fname (body:StrView fname:Symbol impl-name:Symbol out:&String):void
  (let (pat:StrView (fstr "@" fname "(")
        rep:StrView (fstr "@" impl-name "(")
        n:i64 (as i64 (body 'len))
        i:i64 0
        done:i32 0)
    (let (pat-len:i64 (as i64 (pat 'len)))
      (while (and (= done 0) (<= (+ i pat-len) n))
        (when (= (memcmp (as ptr (unsafe/ptr+ (body 'data) i)) (as ptr (pat 'data)) pat-len) 0)
          (emit out (strview-take-bytes body (as usize i)) rep)
          (emit out (strview-drop-bytes body (as usize (+ i pat-len))))
          (set! done 1))
        (set! i (+ i 1)))
      (when (= done 0)
        (emit out body)))))

; Emit a "thunk" function `@<fname>` that loads the current implementation
; pointer from `@<fname>.tgt` and calls it. The thunk is what callers (and
; `&foo`) bind to; the tgt global is updated on every redefinition so
; callers transparently dispatch to the latest implementation.
;
; ft is a (ptr Type) with kind=TY-FN; type-to-ir handles each parameter and return.
; The thunk's signature must be the SAME ABI lowering emit-defn gave the impl it
; forwards to — raw type-to-ir declared a by-value struct as its aggregate type
; (`define i32 @area(%Pt %a0)`), which disagreed with the impl's lowered
; `define i32 @area.impl(i64 %p.arg)` and named a `%Pt` the thunk module did not
; even define. Since the thunk forwards its parameters untouched and the callee
; has the identical lowered signature, the operand list is byte-for-byte the
; same in the signature and in the forwarded call — so it is built ONCE and
; printed twice. byval/sret attributes are legal on a call operand, which is
; what makes the verbatim reuse correct for the MEMORY cases too.
(defn emit-fn-thunk (out:&String fname:Symbol ft:?&Type):void
  (let (ftt:(ptr Type) ft
        nparams:i32 (ftt 'num-params)
        ret-info:&AbiInfo (unsafe/cast &AbiInfo (abi-classify (ftt 'ret)))
        ret-ir:StrView (abi-ret-ir ret-info (ftt 'ret)))
    ; Global pointer holding the address of the current implementation.
    (emit out "@" fname ".tgt = global ptr null\n")
    (let ((ob String) (string-new)
          os:&String &ob)
      (let (need-comma:i32 0)
        (when (= (ret-info 'kind) ABI-MEMORY)
          (emit os "ptr sret(" (type-to-ir (ftt 'ret)) ") align "
                (ret-info 'align) " %sret.arg")
          (set! need-comma 1))
        ; RV-6c: one walk over this signature's parameters.
        (abi-args-begin ret-info)
        (dotimes (i nparams)
          (when (!= need-comma 0) (emit os ", "))
          (abi-print-param-to os
            (abi-classify-arg ((field-at (ftt 'params) i) 'type))
            ((field-at (ftt 'params) i) 'type)
            (symbol-intern (fstr "a" i)))
          (set! need-comma 1)))
      (let (obuf:StrView (string-as-view ob))
        (emit out "define " ret-ir " @" fname "(" obuf ") {\nentry:\n")
        (emit out "  %fp = load ptr, ptr @" fname ".tgt, align 8\n")
        ; A MEMORY return lowers to `void` + the sret operand, so it takes the
        ; same no-result path a genuinely void function does.
        (if (or (= ((ftt 'ret) 'kind) TY-VOID)
                (= (ret-info 'kind) ABI-MEMORY))
          (emit out "  call void %fp(" obuf ")\n  ret void\n}\n\n")
          (emit out "  %r = call " ret-ir " %fp(" obuf ")\n  ret " ret-ir " %r\n}\n\n"))
        (drop &ob)))))

; `@<fname>.trace`: the same ABI-lowered signature as the thunk, wrapped in an
; enter/exit `printf` pair, calling the real impl through `@<fname>.trace.impl`.
;
; The parameter list is built exactly as `emit-fn-thunk` builds it, and for the
; same reason — a per-param `type-to-ir` (which is what the 2026-05 original did)
; gets an aggregate's lowering wrong and names a `%Struct` this module never
; defined.
(defn emit-fn-trace-shim (out:&String fname:Symbol ft:?&Type):void
  (let (ftt:(ptr Type) ft
        nparams:i32 (ftt 'num-params)
        ret-info:&AbiInfo (unsafe/cast &AbiInfo (abi-classify (ftt 'ret)))
        ret-ir:StrView (abi-ret-ir ret-info (ftt 'ret))
        nlen:i32 (unsafe/cast i32 (symbol-len fname)))
    (emit out "@" fname ".trace.impl = global ptr null\n")
    (emit out "@" fname ".trace.enter = private constant [" (+ nlen 16)
          " x i8] c\"[trace] enter " fname "\\0A\\00\"\n")
    (emit out "@" fname ".trace.exit = private constant [" (+ nlen 15)
          " x i8] c\"[trace] exit " fname "\\0A\\00\"\n")
    ; The preamble carries the session's `declare`s; emitting a second identical
    ; one is a redefinition error, not a merge.
    (let (pv:StrView (string-as-view g-repl-preamble))
      (when (= (strview-contains pv "declare i32 @printf") false)
        (emit out "declare i32 @printf(ptr, ...)\n")))
    (let (ob:String (string-new)
          os:&String &ob)
      (let (need-comma:i32 0)
        (when (= (ret-info 'kind) ABI-MEMORY)
          (emit os "ptr sret(" (type-to-ir (ftt 'ret)) ") align "
                (ret-info 'align) " %sret.arg")
          (set! need-comma 1))
        (abi-args-begin ret-info)
        (dotimes (i nparams)
          (when (!= need-comma 0) (emit os ", "))
          (abi-print-param-to os
            (abi-classify-arg ((field-at (ftt 'params) i) 'type))
            ((field-at (ftt 'params) i) 'type)
            (symbol-intern (fstr "a" i)))
          (set! need-comma 1)))
      (let (obuf:StrView (string-as-view ob))
        (emit out "define " ret-ir " @" fname ".trace(" obuf ") {\nentry:\n")
        (emit out "  call i32 (ptr, ...) @printf(ptr @" fname ".trace.enter)\n")
        (emit out "  %fp = load ptr, ptr @" fname ".trace.impl, align 8\n")
        (if (or (= ((ftt 'ret) 'kind) TY-VOID)
                (= (ret-info 'kind) ABI-MEMORY))
          (do (emit out "  call void %fp(" obuf ")\n")
              (emit out "  call i32 (ptr, ...) @printf(ptr @" fname ".trace.exit)\n")
              (emit out "  ret void\n}\n\n"))
          (do (emit out "  %r = call " ret-ir " %fp(" obuf ")\n")
              (emit out "  call i32 (ptr, ...) @printf(ptr @" fname ".trace.exit)\n")
              (emit out "  ret " ret-ir " %r\n}\n\n")))
        (drop &ob)))))

; A JIT'd symbol's address, or 0. The error is consumed rather than reported —
; each caller tests the address and names what it was looking for.
(defn jit-lookup-addr (name:StrView out:ptr):void
  (set! (aref (unsafe/cast &i64 out) 0) 0)
  (let (err:ptr (LLVMOrcLLJITLookup g-jit out (symbol-as-cstr (symbol-intern name))))
    (when (!= err null)
      (LLVMConsumeError err)
      (set! (aref (unsafe/cast &i64 out) 0) 0))))

; The shim under its own resource tracker, returned so `untrace` can remove it.
(defn jit-trace-module (line:i32 fname-ir:Symbol ft:?&Type):ptr
  (let (rt:ptr (LLVMOrcJITDylibCreateResourceTracker g-jit-dylib)
        (s String) (string-new))
    (emit s "; ModuleID = '<repl-trace>'\n")
    (emit s "target triple = \"" ((unsafe/cast &Target g-host-target) 'triple) "\"\n\n")
    (repl-put-preamble s (symbol-none))
    (emit-fn-trace-shim s fname-ir ft)
    (let (v:StrView (string-as-view s))
      (when (> (v 'len) 0)
        (when (!= (getenv "NUC_REPL_DUMP_IR") null)
          (emit stderr "----- TRACE IR -----\n" v "----- END -----\n"))
        (jit-add-module-rt v line rt)))
    (drop &s)
    (return rt)))

; Build a tiny module containing the @fname thunk + @fname.tgt global, and add
; it to the JIT permanently (no resource tracker). This is the stable public
; symbol callers see; on each redefinition, only @fname.tgt is updated.
(defn jit-thunk-module (line:i32 fname-ir:Symbol ft:?&Type):void
  (let ((s String) (string-new))
    (emit s "; ModuleID = '<repl-thunk>'\n")
    (emit s "target triple = \"" ((unsafe/cast &Target g-host-target) 'triple) "\"\n\n")
    ; The accumulated preamble carries the `%Name = type {…}` lines for every
    ; struct defined so far in the session. A thunk whose lowered signature
    ; names one (an sret/byval aggregate) is otherwise emitted into a module
    ; that never defined it — `use of undefined type named 'Pt'`. The preamble
    ; holds only types, `declare`s and `external global`s, so pulling it in
    ; cannot collide with the two symbols this module defines.
    (repl-put-preamble s (symbol-none))
    (emit-fn-thunk s fname-ir ft)
    (let (v:StrView (string-as-view s))
      (when (> (v 'len) 0)
        (when (!= (getenv "NUC_REPL_DUMP_IR") null)
          (emit stderr "----- THUNK IR -----\n" v "----- END -----\n"))
        (jit-add-module-rt v line null)))
    (drop &s)))

; After JIT'ing an impl module, look up @<impl-name> and @<fname-ir>.tgt and
; store impl-addr into (ptr tgt-addr) so subsequent calls through @<fname-ir>
; dispatch to this impl. Returns 0 on success, -1 on error.
(defn update-fn-tgt (line:i32 fname-ir:Symbol impl-name:Symbol):i32
  (let (impl-addr:i64 0
        tgt-addr:i64 0
        err1:ptr (LLVMOrcLLJITLookup g-jit (as ptr &impl-addr) (symbol-as-cstr impl-name)))
    (when (!= err1 null)
      (repl-error line (fstr "redefinition: lookup of " impl-name " failed: "
                             (as CStr (LLVMGetErrorMessage err1))))
      (return -1))
    (let (tgt-name:Symbol (symbol-intern (fstr fname-ir ".tgt"))
          err2:ptr (LLVMOrcLLJITLookup g-jit (as ptr &tgt-addr) (symbol-as-cstr tgt-name)))
      (when (!= err2 null)
        (repl-error line (fstr "redefinition: lookup of " tgt-name " failed: "
                               (as CStr (LLVMGetErrorMessage err2))))
        (return -1)))
    (set! (aref (unsafe/cast &ptr (unsafe/cast ptr tgt-addr)) 0) (unsafe/cast ptr impl-addr))
    (return 0)))

; Append ABI-lowered `declare`s for a defunion's arm constructors to the REPL
; preamble so later modules can call them (the defining module owns the bodies).
(defn repl-declare-union-ctors (uname:Symbol):void
  (if-some (ud (uniondef-lookup uname))
    (let (ret:ptr (type-for-sdef (ud 'sdef))
          ret-info:ptr (abi-classify (type-for-sdef (ud 'sdef)))
          saved-out:?&String g-out)
      (set! g-out &g-repl-preamble)
      (dotimes (i (ud 'num-arms))
        (let (arm:&Arm (invoke (ud 'arms) i:usize)
              aname:Symbol (arm 'name)
              nf:i32 (arm 'nfields)
              ftypes:ptr (arm 'ftypes))
          (emit g-out "declare " (abi-ret-ir ret-info ret) " @" uname "-" aname "(")
          (let (need-comma:i32 0)
            (when (= ((unsafe/cast &AbiInfo ret-info) 'kind) ABI-MEMORY)
              (emit g-out "ptr sret(" (type-to-ir ret) ") align "
                    ((unsafe/cast &AbiInfo ret-info) 'align))
              (set! need-comma 1))
            ; RV-6c: one walk over this constructor's parameters — reset the
            ; riscv64 register budget (design/stage14/riscv-fp-abi.md §4).
            (abi-args-begin (unsafe/cast ptr:AbiInfo ret-info))
            (dotimes (j nf)
              (when (!= need-comma 0) (emit g-out ", "))
              (abi-print-param (abi-classify-arg (aref (unsafe/cast &ptr ftypes) j))
                               (aref (unsafe/cast &ptr ftypes) j) (symbol-none))
              (set! need-comma 1)))
          (emit g-out ")\n")
          (repl-preamble-note-decl (symbol-intern (fstr "@" uname "-" aname)))))
      (set! g-out saved-out))
    0))

; Build a JIT module from the current module streams and add it to the JIT.
; Includes the REPL preamble (accumulated declarations/types) in the module.
(defn repl-jit-module (line:i32):void
  (repl-jit-module-rt-rewrite line null (symbol-none) (symbol-none)))

; Same as repl-jit-module but adds the module under the given resource tracker
; so its symbols can later be removed via LLVMOrcResourceTrackerRemove.
; Pass rt=null to use the main JITDylib without a tracker.
(defn repl-jit-module-rt (line:i32 rt:ptr):void
  (repl-jit-module-rt-rewrite line rt (symbol-none) (symbol-none)))

; Like repl-jit-module-rt but additionally rewrites the first occurrence of
; "@<fname>(" in the captured def buffer to "@<impl-name>(". Used by the defn
; redefinition path: the user's "(defn foo ...)" is captured as
; "define ... @foo(...) { ... }" but JIT'd as "@foo.impl.N" so the stable
; @foo thunk symbol can dispatch to the latest impl on each redefinition.
(defn repl-jit-module-rt-rewrite (line:i32 rt:ptr fname:Symbol impl-name:Symbol):void
  ; Union type definitions are emitted lazily — land any pending ones in this
  ; module's type buffer before it is captured.
  (drain-pending-union-irs)
  (repl-absorb-type-buf)
  (let ((irs String) (string-new))
    (emit irs "; ModuleID = '<repl>'\n")
    (emit irs "target triple = \"" ((unsafe/cast &Target g-host-target) 'triple) "\"\n\n")
    ; Preamble (accumulated types + declarations from includes), minus any
    ; declare this module defines — see repl-put-preamble. R4: this module's own
    ; types were just absorbed into it, so it is the whole type section.
    (repl-put-preamble irs (if (symbol-none? fname) (symbol-none) (symbol-intern (fstr "@" fname))))
    ; From 0: this is the entry's PROGRAM module, and its def buffer names every
    ; id the session has interned so far. Unfiltered: the preamble above is a
    ; second buffer a `g-def-buf` scan does not cover (§8.2).
    (emit-string-table irs 0 0 null)
    ; This module's declarations
    (emit-all irs g-decl-stream)
    ; This module's definitions — optionally renaming the first "@<fname>("
    ; to "@<impl-name>(" so the def is JIT'd under a unique impl symbol.
    (if (and (not (symbol-none? fname)) (not (symbol-none? impl-name)))
      (rewrite-first-fname (string-as-view g-def-buf) fname impl-name irs)
      (emit-all irs g-def-buf))
    (let (v:StrView (string-as-view irs))
      (when (> (v 'len) 0)
        (when (!= (getenv "NUC_REPL_DUMP_IR") null)
          (emit stderr "----- IR -----\n" v "----- END -----\n"))
        (jit-add-module-rt v line rt)))
    (clear-module-buffers)
    (drop &irs)))

; ============================================================
; Monomorphization drain + declare backfill (Stage 16 R3)
; ============================================================
; design/stage16-ergonomics/repl-libraries.md §3.2 (D3).

; ABI-lower a `declare` for one emitted definition into the preamble, exactly as
; `emit-defn` lowered the `define` it names — the ProgDefn holds that very
; signature, which is why this covers stamps and lifted lambdas as well as
; ordinary defns (neither is a `Sym`, so the name-keyed backfills cannot see
; them). Idempotent: a second `declare` of one name is an LLVM parse error.
(defn repl-preamble-declare-progdefn (pd:&ProgDefn):void
  (when (!= (repl-preamble-has-decl (pd 'ir-name)) 0) (return))
  (repl-preamble-note-decl (pd 'ir-name))
  (progdefn-declare-to g-repl-preamble pd))

; Does the `@symbol` starting at `buf[a]` name a function THIS module defines?
; `keep` (an `@`-prefixed name, or null) is the one exception: a defn's impl
; module renamed its own `define` to `@name.impl.N` and calls back through the
; thunk, so it declares `@name` without defining it.
(defn repl-preamble-line-defines-here (buf:StrView a:i64 keep:Symbol):i32
  (dotimes (k (unsafe/cast i32 (count g-program-defns)))
    (let (pd:&ProgDefn (invoke g-program-defns k:usize)
          irn:Symbol (pd 'ir-name)
          l:i64 (as i64 (symbol-len irn)))
      (when (and (= (memcmp (as ptr (unsafe/ptr+ (buf 'data) a)) (as ptr (irn 'p)) l) 0)
                 (= (text-byte-at buf (+ a l)) 40))
        (when (or (symbol-none? keep) (!= irn keep))
          (return 1)))))
  (return 0))

; R4: the one place a type line crosses out of a module — the preamble is the
; type section of every module the session assembles
; (design/stage16-ergonomics/repl-libraries.md §3.3). Type stream already closed.
(defn repl-absorb-type-buf ():void
  (emit-all g-repl-preamble g-type-stream)
  (dotimes (i (unsafe/cast i32 (count g-structs)))
    (let (sd:&StructDef (invoke g-structs i:usize))
      (when (and (!= (sd 'in-type-buf) 0) (= (sd 'emit-epoch) g-module-epoch))
        (set! (sd 'in-preamble) 1)))))

; R4: hand the entry's types to the preamble and start a fresh buffer, so a
; module assembled INSIDE this one (the mono drain) can name them without the
; entry's own module then defining them twice.
(defn repl-cycle-type-buf ():void
  (repl-absorb-type-buf)
  (string-clear g-type-stream)
  (inc! g-module-epoch))

; Copy the preamble into a module being assembled, minus any `declare` for a
; function that module defines itself — one name cannot be both in one module
; (LLVM: "invalid redefinition of function"). The preamble is written for OTHER
; modules, which still need the declare, so this filters the copy rather than
; the source. Stage 16 R3 / D8, repl-libraries.md §3.2.
(defn repl-put-preamble (out:&String keep:Symbol):void
  (let (pv0:StrView (string-as-view g-repl-preamble))
    (when (= (pv0 'len) 0) (return)))
  ; An expression module defines nothing, which is most prompt entries.
  (when (= (count g-program-defns) 0)
    (emit-all out g-repl-preamble)
    (return))
  (let (buf:StrView (string-as-view g-repl-preamble)
        n:i64 (as i64 (byte-len g-repl-preamble))
        i:i64 0)
    (while (< i n)
      (let (e:i64 i)
        (while (and (< e n) (!= (text-byte-at buf e) 10)) (set! e (+ e 1)))
        (when (< e n) (set! e (+ e 1)))
        (let (drop:i32 0)
          (when (and (>= (- e i) 8)
                     (strview-has-prefix (strview-drop-bytes buf (as usize i)) "declare "))
            (let (a:i64 i)
              (while (and (< a e) (!= (text-byte-at buf a) 64)) (set! a (+ a 1)))
              (when (< a e)
                (set! drop (repl-preamble-line-defines-here buf a keep)))))
          (when (= drop 0)
            (emit out (strview-take-bytes (strview-drop-bytes buf (as usize i))
                                          (as usize (- e i))))))
        (set! i e)))))

; Record — without emitting — that every function Sym from `from` onward is
; already declared in the preamble. Used where the preamble receives a whole
; declaration buffer verbatim (the libc preload, `extern`) rather than one
; ABI-lowered line at a time, so the D8 latch still knows what is in there.
(defn repl-note-globals-decls (from:i32):void
  (let (si:i32 from)
    (while (< si (g-globals 'len))
      (let (sym:&Sym (as &Sym (unsafe/ptr+ (unsafe/cast &Sym (g-globals 'syms)) si))
            ft:&Type (unsafe/cast &Type (sym 'type)))
        (let (irv:StrView (sym 'ir-name))
          (when (and (= (ft 'kind) TY-FN) (not (str-empty? &irv)))
            (repl-preamble-note-decl (symbol-intern irv)))))
      (inc! si))))

; Publish every function the module just JIT'd defines. `g-program-defns` is
; per-module (open-module-streams resets it), so this is exactly that module's
; `define`s — call it AFTER the module is assembled, since a `declare` and a
; `define` of one name in one module is the same LLVM error a duplicate
; `declare` is.
(defn repl-backfill-progdefn-decls ():void
  (dotimes (i (unsafe/cast i32 (count g-program-defns)))
    (repl-preamble-declare-progdefn (invoke g-program-defns i:usize))))

; Emit the bodies of every stamped instance, lifted lambda and closure
; invoke/drop queued since the last flush. `drain-mono-worklist`'s only compiler
; call site is the tail of `emit-toplevel-forms`, which a prompt entry never
; reaches — so the call was emitted and the callee never was.
;
; Into a module of its OWN, for two reasons: a `defn`'s per-impl module carries
; a resource tracker that the next redefinition of that `defn` removes, which
; would silently un-define every unrelated stamp drained alongside it; and
; `g-mono-drained` is a persistent cursor, so a body emitted here is invisible
; to the next entry unless its `declare` reaches the preamble.
(defn repl-flush-mono (line:i32):void
  (when (>= g-mono-drained (count g-mono-worklist)) (return))
  ; R4: the drained bodies are assembled from the preamble, so the entry's types
  ; go there first — and its type buffer restarts, or its own module would then
  ; define them a second time.
  (repl-cycle-type-buf)
  ; The caller's module streams are mid-assembly; open-module-streams rebinds
  ; all of them plus the two per-module registries.
  ; The three module buffers are MOVED out, not aliased: `open-module-streams`
  ; clears them in place, and a copy left behind would carry a stale length over
  ; a buffer the nested module then reallocates.
  (let ((s-type String) g-type-stream
        s-epoch:i32 g-module-epoch
        (s-decl String) g-decl-stream
        (s-def-buf String) g-def-buf
        s-def:?&String g-def-stream
        s-def-prog:?&String g-def-stream-program
        s-decl-out:?&String g-decl-out
        s-out:?&String g-out
        s-macro-decls:&(Vector Symbol) g-macro-decls
        s-prog-defns:&(Vector &ProgDefn) g-program-defns)
    (set! g-type-stream (string-new))
    (set! g-decl-stream (string-new))
    (set! g-def-buf (string-new))
    (open-module-streams)
    ; Before drain-pending-union-irs (repl-jit-module's first step): a drained
    ; body can stamp new parametric instances that then need their type lines.
    (drain-mono-worklist)
    (drain-pending-union-irs)
    ; Untracked, on the main dylib: a stamp outlives every `defn` that asked for
    ; it. R4: the assembler absorbs this module's types into the preamble.
    (repl-jit-module line)
    (repl-backfill-progdefn-decls)
    (set! g-program-defns s-prog-defns)
    (set! g-macro-decls s-macro-decls)
    (set! g-out s-out)
    (set! g-decl-out s-decl-out)
    (set! g-def-stream-program s-def-prog)
    (drop &g-type-stream)
    (drop &g-decl-stream)
    (drop &g-def-buf)
    (set! g-type-stream s-type)
    (set! g-decl-stream s-decl)
    (set! g-def-buf s-def-buf)
    (set! g-def-stream s-def)
    (set! g-module-epoch s-epoch)))

; Pre-include standard libc headers into the REPL preamble and global scope.
(defn repl-include-all-libc ():void
  (open-module-streams)
  (set! g-out &g-decl-stream)
  (emit-c-include (symbol-intern "stdio.h") 0)
  (emit-c-include (symbol-intern "stdlib.h") 0)
  (emit-c-include (symbol-intern "string.h") 0)
  (emit-c-include (symbol-intern "ctype.h") 0)
  (emit-c-include (symbol-intern "unistd.h") 0)
  ; Header unions register with lazily-emitted IR type defs; land them in this
  ; throwaway module's type buffer so the preamble gets them exactly once
  ; (leaving them pending would make them surface inside a later module that
  ; already sees them via the preamble — a redefinition error).
  (drain-pending-union-irs)
  (repl-absorb-type-buf)
  (emit-all g-repl-preamble g-decl-stream)
  (clear-module-buffers)
  ; The whole declaration buffer went in verbatim, so tell the D8 latch which
  ; names it just carried (`@malloc` is the one a macro body re-declares).
  (repl-note-globals-decls 0)
  (emit g-repl-preamble "\n"))

; ============================================================
; Session state snapshot / restore (Stage 16 R1)
; ============================================================
;
; A longjmp skips every `let`-save / `set!`-restore pair on the stack, so the
; roster is spelled here once instead of at each site.
; See design/stage16-ergonomics/repl-libraries.md §3.4 (D4) for what is left out.
(defstruct ReplState
  source-path:Symbol
  ; --- import bookkeeping (prepend-only lists: the head IS the watermark) ---
  imported:ptr
  importing:ptr
  ct-imported:ptr
  prescan-sigs:ptr
  prescan-inflight:ptr
  prescan-visited:ptr
  real-reachable:ptr
  nuch-registered:ptr
  import-aliased:ptr
  import-prefixes:ptr
  (cheader-skipped ?&(Vector &CheaderSkip))
  ; Stage 16 L5: a C typedef is a Nucleus type NAME now, so a half-loaded header
  ; that leaves one behind is not merely untidy — the entry can hold a Type over
  ; a StructDef `g-structs` just rolled back, and the next module emits a `%X`
  ; reference nothing defines.
  (cheader-typedefs ?&CTypedef)
  ; --- unit / namespace / privacy ---
  toplevel-depth:i32
  unit-entry-path:Symbol
  root-hoist-ok:i32
  current-ns:Symbol
  ns-seen:i32
  (file-imports ?&ImportVec)
  import-ct:i32
  import-include-private:i32
  defining-private:i32
  mono-context:StrView
  ; --- emission streams ---
  out:ptr
  def-stream:ptr
  def-stream-program:ptr
  decl-out:ptr
  ct-emitting:i32
  ; --- scoped modes and depths: a die inside one would leave it armed ---
  dry-parse-tyvars:ptr
  dry-parse-ntv:i32
  type-alias-depth:i32
  type-key-ok:i32
  array-ok:i32
  want-type:ptr
  defvar-soft:i32
  emitting-copy:i32
  ct-body-name:Symbol
  ct-body-arg:i32
  cheader-unrep-quiet:i32
  cheader-typedef-provisional:i32
  cmacro-folding:i32
  cenum-folding:i32
  bind-call:BindCall
  where-checked:i32
  qq-resolve:i32
  ; --- registry watermarks ---
  globals-len:i32
  n-structs:i32
  n-uniondefs:i32
  n-union-templates:i32
  n-struct-templates:i32
  n-type-aliases:i32
  n-enumdefs:i32
  n-pending-unions:i32
  n-generics:i32
  n-protocols:i32
  n-conformances:i32
  n-proto-supers:i32
  n-tmpl-conformances:i32
  n-macros:i32
  n-macrolet:i32
  n-cast-rules:i32
  n-rmacros:i32
  n-vtables:i32
  n-boxedfns:i32
  n-dyns:i32
  n-mono:i32
  n-init:i32
  n-dyn-annots:i32
  n-where-checks:i32
  n-hyg-envs:i32
  n-file-macros:i32)

; Truncating `g-generics` recovers only the generics a died import CREATED; a
; method appended to a pre-existing one needs this per-entry watermark instead.
(defstruct GenericMark
  n-methods:i32
  finalized:i32
  mangled:i32)

(defvar g-repl-saved:ReplState)
; The desugared form list of the input line, handed back from the protected
; `desugar` step (a callback returns nothing).
(defvar g-repl-forms:ptr)
; The session's reader-macro table: every input is read through it, so a
; `def-rmacro` at one prompt is in force at the next. Rolled back by count.
(defvar repl-rmacros:&(Vector RMacro) (read-macro-table-new))
; Reused, not rebuilt: a snapshot per top-level form would grow the arena forever.
(defvar g-repl-generic-marks:&(Vector &GenericMark)
  (vector-new-in &g-arena-alloc))

; Every registry below is append-only, so dropping the tail is a true rollback.
(defn repl-vec-truncate (v:&(Vector T) n:i32):void
  (while (> (unsafe/cast i32 (count v)) n)
    (remove-at v (as usize (- (unsafe/cast i32 (count v)) 1)))))

; The roster, once: a row is (ReplState-field global), and no row's source is
; another's destination — which is what lets one table serve both directions,
; in table order. design/stage20-macros/overview.md §9.8; `repl-roster` gates it.
(macrolet ((over-repl-globals (spec)
             `(macmap ~spec
                ((source-path g-source-path)
                 (imported g-imported)
                 (importing g-importing)
                 (ct-imported g-ct-imported)
                 (prescan-sigs g-prescan-sigs)
                 (prescan-inflight g-prescan-inflight)
                 (prescan-visited g-prescan-visited)
                 (real-reachable g-real-reachable)
                 (nuch-registered g-nuch-registered)
                 (import-aliased g-import-aliased)
                 (import-prefixes g-import-prefixes)
                 (cheader-skipped g-cheader-skipped)
                 (cheader-typedefs g-cheader-typedefs)
                 (toplevel-depth g-toplevel-depth)
                 (unit-entry-path g-unit-entry-path)
                 (root-hoist-ok g-root-hoist-ok)
                 (current-ns g-current-ns)
                 (ns-seen g-ns-seen)
                 (file-imports g-file-imports)
                 (import-ct g-import-ct)
                 (import-include-private g-import-include-private)
                 (defining-private g-defining-private)
                 (mono-context g-mono-context)
                 (out g-out)
                 (def-stream g-def-stream)
                 (def-stream-program g-def-stream-program)
                 (decl-out g-decl-out)
                 (ct-emitting g-ct-emitting)
                 (dry-parse-tyvars g-dry-parse-tyvars)
                 (dry-parse-ntv g-dry-parse-ntv)
                 (type-alias-depth g-type-alias-depth)
                 (type-key-ok g-type-key-ok)
                 (array-ok g-array-ok)
                 (want-type g-want-type)
                 (defvar-soft g-defvar-soft)
                 (emitting-copy g-emitting-copy)
                 (ct-body-name g-ct-body-name)
                 (ct-body-arg g-ct-body-arg)
                 (cheader-unrep-quiet g-cheader-unrep-quiet)
                 (cheader-typedef-provisional g-cheader-typedef-provisional)
                 (cmacro-folding g-cmacro-folding)
                 (cenum-folding g-cenum-folding)
                 (bind-call g-bind-call)
                 (where-checked g-where-checked)
                 (qq-resolve g-qq-resolve))))
           (over-repl-registries (spec)
             `(macmap ~spec
                ((n-structs g-structs)
                 (n-uniondefs g-uniondefs)
                 (n-union-templates g-union-templates)
                 (n-struct-templates g-struct-templates)
                 (n-type-aliases g-type-aliases)
                 (n-enumdefs g-enumdefs)
                 (n-pending-unions g-pending-unions)
                 (n-generics g-generics)
                 (n-protocols g-protocols)
                 (n-conformances g-conformances)
                 (n-proto-supers g-proto-supers)
                 (n-tmpl-conformances g-tmpl-conformances)
                 (n-macros g-macros)
                 ; A longjmp out of emit-macrolet skips its pop.
                 (n-macrolet g-macrolet-stack)
                 (n-cast-rules g-cast-rules)
                 (n-rmacros repl-rmacros)
                 ; These three hand back a StructDef, so an entry must not
                 ; outlive g-structs'.
                 (n-vtables g-vtable-table)
                 (n-boxedfns g-boxedfn-table)
                 (n-dyns g-dyn-table)
                 (n-mono g-mono-worklist)
                 (n-init g-init-worklist)
                 (n-dyn-annots g-dyn-annots)
                 (n-where-checks g-where-checks)
                 (n-hyg-envs g-hyg-envs)
                 (n-file-macros g-file-macros)))))

  (defn repl-snapshot (st:&ReplState):void
    (over-repl-globals ((f g) `(set! (st '~f) ~g)))
    (set! (st 'globals-len) (g-globals 'len))
    (over-repl-registries ((f g) `(set! (st '~f) (unsafe/cast i32 (count ~g)))))
    ; Per-generic method watermarks, refilled in place.
    (let (n:i32 (unsafe/cast i32 (count g-generics))
          have:i32 (unsafe/cast i32 (count g-repl-generic-marks))
          gi:i32 0)
      (while (< gi n)
        (when (>= gi have)
          (conj g-repl-generic-marks (new GenericMark)))
        (let (mk:&GenericMark (as &GenericMark (invoke g-repl-generic-marks gi:usize))
              gg:&Generic (as &Generic (invoke g-generics gi:usize)))
          (set! (mk 'n-methods) (unsafe/cast i32 (count (gg 'methods))))
          (set! (mk 'finalized) (gg 'finalized))
          (set! (mk 'mangled) (gg 'mangled)))
        (inc! gi))))

  (defn repl-restore (st:&ReplState):void
    ; Methods first: the table's `g-generics` truncate below drops the entries
    ; these marks index.
    (let (n:i32 (st 'n-generics)
          have:i32 (unsafe/cast i32 (count g-repl-generic-marks))
          gi:i32 0)
      (when (> n have) (set! n have))
      (when (> n (unsafe/cast i32 (count g-generics)))
        (set! n (unsafe/cast i32 (count g-generics))))
      (while (< gi n)
        (let (mk:&GenericMark (as &GenericMark (invoke g-repl-generic-marks gi:usize))
              gg:&Generic (as &Generic (invoke g-generics gi:usize)))
          (repl-vec-truncate (gg 'methods) (mk 'n-methods))
          (set! (gg 'finalized) (mk 'finalized))
          (set! (gg 'mangled) (mk 'mangled)))
        (inc! gi)))
    (over-repl-registries ((f g) `(repl-vec-truncate ~g (st '~f))))
    ; A drain cursor may not point past the queue it indexes.
    (when (> g-mono-drained (as usize (st 'n-mono))) (set! g-mono-drained (as usize (st 'n-mono))))
    (when (> g-init-drained (as usize (st 'n-init))) (set! g-init-drained (as usize (st 'n-init))))
    (when (> g-dyn-annots-drained (as usize (st 'n-dyn-annots)))
      (set! g-dyn-annots-drained (as usize (st 'n-dyn-annots))))
    (set! (g-globals 'len) (st 'globals-len))
    (over-repl-globals ((f g) `(set! ~g (st '~f))))))

; The three protected-callback bodies. `repl-protect` runs them as callbacks so
; its `_setjmp` frame is still live when `repl-throw` fires.
(defn repl-protect-desugar (ctx:ptr):void
  (set! g-repl-forms (desugar ctx))
  (return))

(defn repl-protect-eval (ctx:ptr):void
  (repl-eval-form ctx)
  (return))

; The body of repl-preload-prelude, as a protected callback.
(defn repl-protect-preload (ctx:ptr):void
  (match (read-source-or-report "(import-use prelude)" repl-rmacros)
    ((ok parsed)
      (let (fc:ptr (desugar parsed))
        (while (> (node-len fc) 0)
          (repl-eval-form (node-first (unsafe/cast &Node fc)))
          (set! fc (node-rest (unsafe/cast &Node fc))))))
    ((err e) (do)))
  (return))

; The prelude goes through the ordinary import arm, exactly as batch `main`
; splices it, so a session and a batch compile agree on its types; a hand mirror
; here did not (design/stage16-ergonomics/repl-libraries.md §3.1).
(defn repl-preload-prelude ():void
  (repl-snapshot &g-repl-saved)
  (set! g-repl-booting 1)
  (when (!= (repl-protect repl-protect-preload null) 0)
    (repl-restore &g-repl-saved))
  (set! g-repl-booting 0))

; ============================================================
; The build line at the prompt — `cflag`, `import-path`, `library-path`,
; `load-library`, `pkg-config`, and `-l`/`-L` under `-i`.
; design/stage21-cleanup/repl-build-line.md
; ============================================================

; Each argument a string or bare symbol, non-empty — all checked before any is
; applied, so a bad third argument adds nothing. 0 = reported.
(defn repl-build-args (form:?&Node cmd:StrView out:&(Vector Symbol)):i32
  (let (f:&Node (unsafe/cast &Node form)
        n:i32 (node-len f)
        i:i32 1)
    (while (< i n)
      (let (nn:ptr (node-at f i)
            k:i32 (node-kind nn))
        (when (and (!= k NODE-SYM) (!= k NODE-STR))
          (repl-error (f 'line) (fstr cmd ": argument must be a string"))
          (return 0))
        (let (s:Symbol ((unsafe/cast &Node nn) 's))
          (when (= (symbol-len s) 0)
            (repl-error (f 'line) (fstr cmd ": empty argument"))
            (return 0))
          (conj out s)))
      (inc! i))
    (return 1)))

; `(imports)`' shape: one per line, or `(none)`.
(defn repl-list-symbols (v:&(Vector Symbol)):void
  (when (= (count v) 0) (emit stderr "  (none)\n"))
  (dotimes (i (count v))
    (emit stderr "  " (invoke v i) "\n")))

(defn repl-apply-cflags (args:&(Vector Symbol)):void
  (dotimes (i (count args))
    (add-cflag (invoke args i))
    (emit stderr "  cflag: " (invoke args i) "\n"))
  (when (> (count args) 0) (cheader-flags-changed)))

; Every directory must exist before any is added — a prompt-time courtesy the
; batch `-I`/`-L` do not extend, where a typo surfaces three forms later.
(defn repl-apply-dirs (args:&(Vector Symbol) cmd:StrView into:&(Vector Symbol)
                       label:StrView line:i32):i32
  (dotimes (i (count args))
    (when (not (dir-exists? (symbol-as-view (invoke args i))))
      (repl-error line (fstr cmd ": no such directory '" (invoke args i) "'"))
      (return 0)))
  (dotimes (i (count args))
    (conj into (invoke args i))
    (emit stderr label (invoke args i) "\n"))
  (return 1))

; The file a `-l`-style name means. A name that already looks like a file
; (`libgtk-4.so.1`, `/opt/x/libfoo.so`) is verbatim.
(defn repl-library-file (name:Symbol):Symbol
  (let (nv:StrView (symbol-as-view name))
    (when (or (strview-contains nv "/") (strview-contains nv ".")) (return name))
    (let (tv:StrView (symbol-as-view ((unsafe/cast &Target g-host-target) 'triple))
          suffix:StrView ".so")
      (when (or (strview-contains tv "darwin") (strview-contains tv "apple"))
        (set! suffix ".dylib"))
      (when (strview-contains tv "windows") (set! suffix ".dll"))
      (return (symbol-intern (fstr "lib" nv suffix))))))

(defn repl-library-loaded? (spelling:Symbol):i32
  (dotimes (i (count g-loaded-libraries))
    (when (= (invoke g-loaded-libraries i) spelling) (return 1)))
  (return 0))

(defn repl-tried-add (tried:StrView s:StrView):StrView
  (when (str-empty? &tried) (return s))
  (return (fstr tried ", " s)))

; Loads into the process, where LLJIT resolves every module (repl-build-line.md
; §1.3). Empty on success, else the `cannot load …` text — the C API gives a bool.
(defn repl-library-load (name:Symbol):StrView
  (let (file:Symbol (repl-library-file name)
        fv:StrView (symbol-as-view file)
        chosen:Symbol file
        tried:StrView "")
    (if (strview-contains fv "/")
      (set! tried fv)
      (let (found:i32 0)
        (dotimes (j (count g-library-paths))
          (when (= found 0)
            (let (cand:StrView (fstr (invoke g-library-paths j) "/" fv))
              (set! tried (repl-tried-add tried cand))
              (when (!= (file-exists cand) 0)
                (set! chosen (symbol-intern cand))
                (set! found 1)))))
        (when (= found 0) (set! tried (repl-tried-add tried fv)))))
    (when (!= (repl-library-loaded? chosen) 0)
      (emit stderr "  " chosen " already loaded\n")
      (return ""))
    ; Non-zero is FAILURE (llvm.nuch).
    (when (!= (LLVMLoadLibraryPermanently (symbol-as-cstr chosen)) 0)
      (return (fstr "cannot load '" name "' (tried " tried ")")))
    (conj g-loaded-libraries chosen)
    ; A `host-exports?` answer taken before the load describes a process that
    ; no longer exists; the handle (`g-host-lib-loaded`) is still open.
    (repl-vec-truncate g-host-export-names 0)
    (repl-vec-truncate g-host-export-answers 0)
    (emit stderr "  loaded " chosen "\n")
    (return "")))

(defn repl-load-library (name:Symbol line:i32):i32
  (let (fail:StrView (repl-library-load name))
    (when (str-empty? &fail) (return 1))
    (repl-error line (fstr "load-library: " fail))
    (return 0)))

; A load is not un-doable, so the ones before a failure stay and were reported.
(defn repl-apply-libs (args:&(Vector Symbol) line:i32):i32
  (dotimes (i (count args))
    (when (= (repl-load-library (invoke args i) line) 0) (return 0)))
  (return 1))

; Argv `-L`/`-l` as `ld` reads them, every `-L` before any `-l`; a bad `-l` is
; fatal as a batch link's is. The rest of the vector is the linker's; the REPL never links.
(defn repl-load-link-args ():void
  (dotimes (i (count g-link-args))
    (let (a:StrView (symbol-as-view (invoke g-link-args i)))
      (when (and (strview-has-prefix a "-L") (> (a 'len) 2))
        (conj g-library-paths (symbol-intern (strview-drop-bytes a 2))))))
  (dotimes (i (count g-link-args))
    (let (a:StrView (symbol-as-view (invoke g-link-args i)))
      (when (and (strview-has-prefix a "-l") (> (a 'len) 2))
        (let (name:Symbol (symbol-intern (strview-drop-bytes a 2))
              fail:StrView (repl-library-load name))
          (when (not (str-empty? &fail))
            (eprint "error: -l" name ": " fail "\n")
            (exit 1)))))))

; One `pkg-config <mode> <pkgs…>` child, stdout into `out` and its diagnosis
; into `errs`. -1 = did not spawn.
(defn repl-pkg-config-run (pkgs:&(Vector Symbol) mode:StrView
                           out:&String errs:&String):i32
  (let (c:Command (command "pkg-config")
        status:i32 -1)
    (command-arg &c mode)
    (dotimes (i (count pkgs))
      (command-arg &c (symbol-as-view (invoke pkgs i))))
    (command-capture &c true)
    (match (spawn &c)
      ((ok p)
       (match (process-capture &p out errs)
         (ok
          (match (process-wait &p)
            ((ok st) (set! status (exit-code &st)))
            ((err e) (set! status -1))))
         ((err e) (set! status -1))))
      ((err e) (set! status -1)))
    (drop &c)
    (return status)))

; Split pkg-config's output on whitespace. A backslash escapes the byte after
; it — a path with a space prints as `with\ space` (probed with pkgconf 2.x).
(defn repl-pkg-config-words (out:&String into:&(Vector Symbol)):void
  (let (v:StrView (string-as-view out)
        n:i64 (as i64 (v 'len))
        w:String (string-new)
        i:i64 0)
    (while (< i n)
      (let (c:i32 (text-byte-at v i))
        (cond (and (= c 92) (< (+ i 1) n))
                (do (inc! i)
                    (string-push-bytes-raw &w (unsafe/ptr+ (v 'data) i) 1))
              (or (= c 32) (= c 9) (= c 10) (= c 13))
                (do (when (> (byte-len &w) 0)
                      (conj into (symbol-intern (string-as-view &w))))
                    (string-clear &w))
              true
                (string-push-bytes-raw &w (unsafe/ptr+ (v 'data) i) 1)))
      (inc! i))
    (when (> (byte-len &w) 0)
      (conj into (symbol-intern (string-as-view &w))))
    (drop &w)))

; The child's diagnosis, or its exit code when it said nothing. pkg-config
; puts the line that matters first (`Package 'x' was not found …`).
(defn repl-pkg-config-failure (errs:&String status:i32):StrView
  (let (ev:StrView (string-as-view errs))
    (when (> (ev 'len) 0)
      (match (strview-find-byte &ev 10)
        ((some k) (return (fstr "pkg-config: " (strview-take-bytes ev k))))
        (none (return (fstr "pkg-config: " ev)))))
    ; `spawn` reports an exec that failed as exit 127 with nothing said.
    (when (or (< status 0) (= status 127)) (return "pkg-config: not found"))
    (return (fstr "pkg-config: exited " status))))

; Both children succeed before anything is applied, then the batch order: cflags,
; `-L`, `-l`. What the REPL cannot use (`-pthread`) is named once, not dropped.
(defn repl-pkg-config (pkgs:&(Vector Symbol) line:i32):void
  (let (cf:String (string-new) cf-err:String (string-new)
        lb:String (string-new) lb-err:String (string-new)
        ok:i32 1)
    (let (st:i32 (repl-pkg-config-run pkgs "--cflags" &cf &cf-err))
      (when (!= st 0)
        (repl-error line (repl-pkg-config-failure &cf-err st))
        (set! ok 0)))
    (when (!= ok 0)
      (let (st:i32 (repl-pkg-config-run pkgs "--libs" &lb &lb-err))
        (when (!= st 0)
          (repl-error line (repl-pkg-config-failure &lb-err st))
          (set! ok 0))))
    (when (!= ok 0)
      (let (cflags:&(Vector Symbol) (vector-new-in &g-arena-alloc)
            libs:&(Vector Symbol) (vector-new-in &g-arena-alloc)
            dirs:&(Vector Symbol) (vector-new-in &g-arena-alloc)
            names:&(Vector Symbol) (vector-new-in &g-arena-alloc)
            other:&(Vector Symbol) (vector-new-in &g-arena-alloc))
        (repl-pkg-config-words &cf cflags)
        (repl-pkg-config-words &lb libs)
        (dotimes (i (count libs))
          (let (w:StrView (symbol-as-view (invoke libs i)))
            (cond (strview-has-prefix w "-L")
                    (conj dirs (symbol-intern (strview-drop-bytes w 2)))
                  (strview-has-prefix w "-l")
                    (conj names (symbol-intern (strview-drop-bytes w 2)))
                  true
                    (conj other (invoke libs i)))))
        (repl-apply-cflags cflags)
        (when (!= (repl-apply-dirs dirs "library-path" g-library-paths
                                   "  library path: " line) 0)
          (when (!= (repl-apply-libs names line) 0)
            (dotimes (i (count other))
              (emit stderr "  skipped: " (invoke other i) "\n"))))))
    (drop &cf) (drop &cf-err)
    (drop &lb) (drop &lb-err)))

; REPL main loop
(defn repl-main ():void
  (emit stderr "Nucleus REPL (type Ctrl-D to exit)\n")
  ; Line-buffer stdout so JIT'd printf output is visible immediately even when
  ; the REPL is driven by a pipe (stdin not a tty makes stdout block-buffered
  ; by default). _IOLBF == 1 on glibc.
  (setvbuf stdout null 1 0)
  (set! g-source-path (symbol-intern "<repl>"))
  ; G-5: see main. `target-init` is the residue of `compiler-init`; the REPL has
  ; no argv overrides of its own but still needs the host Target resolved before
  ; the first JIT module is built.
  (target-init)
  (assert-compiler-arena-backed)
  ; After `target-init` (the library suffix needs the host triple) and before
  ; any header is read.
  (repl-load-link-args)
  ; Initialize preamble stream
  (ensure-emit-buffers)
  ; Pre-include all libc functions (so they're available without explicit include)
  (repl-include-all-libc)
  ; Tolerates failure so a session still starts without lib/prelude.nuc; the
  ; user just gets "unknown type" for everything the prelude defines.
  (repl-preload-prelude)
  (let (running:i32 1)
    (while (!= running 0)
      (match (repl-read-input)
        (none
          (do (emit stderr "\n") (set! running 0)))
        ((some input)
          (let ((text String) input)
              ; A syntax error has already been reported; nothing to reset.
              (match (read-source-or-report (string-as-view &text) repl-rmacros)
                ((ok parsed)
                  (do
                    ; `desugar` can die too, and runs before any form does.
                    (set! g-repl-forms null)
                    (repl-snapshot &g-repl-saved)
                    (when (!= (repl-protect repl-protect-desugar parsed) 0)
                      (repl-restore &g-repl-saved)
                      (repl-error 0 "error (recovered)"))
                    ; One snapshot per form, so a form that dies rolls back only
                    ; its own registrations.
                    (let (fc:ptr g-repl-forms)
                      (while (> (node-len fc) 0)
                        (let (f:ptr (node-first (unsafe/cast &Node fc)))
                          (repl-snapshot &g-repl-saved)
                          (when (!= (repl-protect repl-protect-eval f) 0)
                            (repl-restore &g-repl-saved)
                            (repl-error (node-line f 0) "error (recovered)")))
                        (set! fc (node-rest (unsafe/cast &Node fc)))))))
                ((err e) (do)))
              (drop &text)))))))

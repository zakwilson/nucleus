; Diagnostics — the compiler's error/warning layer, plus the byte helpers it
; and the rest of src/ scan text with. In src/, not beside a library reader,
; because it reads compiler globals (g-source-path, g-interactive,
; g-mono-context, g-bind-call, g-diag-note); a macro body cannot call it (context/macros-jit.md).

(import-use error)

(deferror parse-error "parse error")

(defn cstr-byte-at (s:ptr pos:i64):i32
  (return (bit-and (as i32 (aref (unsafe/cast &i8 s) pos)) 255)))

; Its `StrView` peer, for the scanners that bound `i` themselves — the library's
; `strview-byte-at` returns `!ui8`, a `try` per byte on a per-character loop.
(defn text-byte-at (text:StrView i:i64):i32
  (return (bit-and (as i32 (aref (text 'data) i)) 255)))

; ============================================================
; Error reporting
; ============================================================

; Stage 18 TF-5: a diagnostic is a location, a message and its notes, rendered by
; whichever back-end the `--diagnostics` flag selected
; (design/stage18-tooling/overview.md §T4.2). `line` -1 means no location — a
; message about the toolchain rather than the source.

; 0 = the human rendering (`path:line: error: msg`), 1 = `--diagnostics=edn`.
; Both write to stderr: the flag changes the shape, never the stream, so a
; caller's `2>&1 >/dev/null` keeps working.
(defvar g-diag-edn:i32 0)

; W9 item 42, generalized: a note the diagnosing site stages before calling,
; because `die-at` is noreturn and there is no "and also" after it. Appending
; rather than overwriting is what lets two sites each contribute to one error.
(defn diag-stage-note (note:StrView):void
  (if (str-empty? &g-diag-note)
    (set! g-diag-note note)
    (set! g-diag-note (fstr g-diag-note "\n  note: " note))))

; The index at or after `from` where a `\n  note: ` marker starts, else the end.
; Notes reach here inside the message because that is how the diagnosing sites
; build them (`(fstr "…" "\n  note: " …)`, 20-odd sites); splitting here is what
; gives the EDN form a `:notes` vector without touching any of them.
(defn diag-note-start (s:StrView from:i64):i64
  (let (n:i64 (as i64 (s 'len))
        i:i64 from)
    (while (< i n)
      (when (and (= (text-byte-at s i) 10) (< (+ i 8) n)
                 (= (text-byte-at s (+ i 1)) 32) (= (text-byte-at s (+ i 2)) 32)
                 (= (text-byte-at s (+ i 3)) 110) (= (text-byte-at s (+ i 4)) 111)
                 (= (text-byte-at s (+ i 5)) 116) (= (text-byte-at s (+ i 6)) 101)
                 (= (text-byte-at s (+ i 7)) 58) (= (text-byte-at s (+ i 8)) 32))
        (return i))
      (set! i (+ i 1)))
    (return n)))

(defn diag-hex-digit (v:i32):StrView
  (let (digits:StrView "0123456789abcdef")
    (return (strview (unsafe/ptr+ (digits 'data) (as i64 v)) 1))))

; An EDN string, escaped as lib/edn's `edn-write-string` does; src/ cannot import
; lib/edn (design/stage22-edn/test-records.md §1).
(defn diag-write-string (out:&String sv:StrView):void
  (str-into out "\"")
  (let (n:i64 (as i64 (sv 'len))
        i:i64 0)
    (while (< i n)
      (let (c:i32 (text-byte-at sv i))
        (cond (= c 34) (str-into out "\\\"")
              (= c 92) (str-into out "\\\\")
              (= c 10) (str-into out "\\n")
              (= c 9)  (str-into out "\\t")
              (= c 13) (str-into out "\\r")
              (or (< c 32) (= c 127))
                (str-into out "\\u00" (diag-hex-digit (bit-shr c 4)) (diag-hex-digit (bit-and c 15)))
              true (str-into out (strview (unsafe/ptr+ (sv 'data) i) 1))))
      (set! i (+ i 1))))
  (str-into out "\""))

; Render one diagnostic onto `out`, allocating nothing but `out`'s growth: the
; fault boundary (src/ct-fault.nuc) renders one per macro expansion.
; `msg` carries its notes as `\n  note: ` markers, so the text form is `msg`
; verbatim. The EDN form is one map per line, `:severity` first so a line is
; recognised by its opening bytes; an absent location is `nil`.
(defn diag-render (out:&String severity:StrView path:Symbol line:i32 msg:StrView):void
  (when (= g-diag-edn 0)
    (when (>= line 0) (str-into out path ":" line ": "))
    (str-into out severity ": " msg "\n")
    (return))
  (let (n:i64 (as i64 (msg 'len))
        head:i64 (diag-note-start msg 0))
    (str-into out "{:severity :" severity " :file ")
    (if (symbol-none? path)
      (str-into out "nil")
      (diag-write-string out (symbol-as-view path)))
    (if (< line 0)
      (str-into out " :line nil")
      (str-into out " :line " line))
    (str-into out " :message ")
    (diag-write-string out (strview (msg 'data) (as usize head)))
    (str-into out " :notes [")
    (let (i:i64 head)
      (while (< i n)
        (let (start:i64 (+ i 9)
              stop:i64 (diag-note-start msg start))
          (when (> i head) (str-into out " "))
          (diag-write-string out (strview (unsafe/ptr+ (msg 'data) start) (as usize (- stop start))))
          (set! i stop))))
    (str-into out "]}\n")))

; The one point a diagnostic becomes bytes. Every staged note is folded in here
; and the stage cleared, so an interactive session — where `repl-throw` unwinds
; instead of exiting — cannot carry one onto an unrelated later error.
(defn diag-emit (severity:StrView path:Symbol line:i32 msg:StrView):void
  (let (full:StrView msg)
    (when (not (str-empty? &g-diag-note))
      (set! full (fstr full "\n  note: " g-diag-note))
      (set! g-diag-note ""))
    (let (s:String (string-new))
      (diag-render &s severity path line full)
      (eprint (string-as-view &s))
      (drop &s))))

; An error about the source being compiled. The monomorphization context is
; ambient rather than staged — it says which instantiation the compiler is
; inside — so it is attached here rather than at the 688 call sites.
(defn diag-error (line:i32 msg:StrView):void
  (let (full:StrView msg
        bc:BindCall g-bind-call)
    (when (and (not (symbol-none? (bc 'name)))
               (not (and (= (bc 'path) g-source-path) (= (bc 'line) line))))
      (set! full (fstr full "\n  note: while binding a call to '" (bc 'name) "' (at "
                       (bc 'path) ":" (bc 'line) ")")))
    (when (not (str-empty? &g-mono-context))
      (set! full (fstr full "\n  note: " g-mono-context)))
    (diag-emit "error" g-source-path line full)))

(defn die-at (line:i32 msg:StrView):void
  :noreturn
  ; Stage 10 C3: consult the panic-tier debugger hook before aborting. With no
  ; (unhandled-error, i32) handler bound this is a one-load chain walk that
  ; returns none and falls straight through to today's abort; a bound handler
  ; may log/record `msg` first. The repair value is ignored (we abort anyway).
  ; Stage 17 C6: the detail is a `(ptr StrView)`, not the bytes — `signal`'s
  ; `detail:ptr` has no slot for a length, and the message is no longer
  ; NUL-terminated.
  (signal unhandled-error i32 (as ptr &msg))
  (diag-error line msg)
  (when (!= g-interactive 0)
    (repl-throw))
  ; A `macro-error` exits from inside an armed JIT call; nothing after it is one.
  (ct-fault-unwind-to 0)
  (exit 1))

; Stage 10 E4: report a recoverable reader error without aborting. Emits the
; same diagnostic `die-at` does, but returns to the caller, which then
; propagates `(err! parse-error)`.
(defn report-at (line:i32 msg:StrView):void
  (diag-error line msg))

; Formatting helpers — arena-backed sprintf wrappers.
;
; Requires: arena (arena-strndup, arena-alloc), snprintf, strlen, isdigit.
;
; ARITY IS FIXED (context/conventions.md): each helper takes exactly the number
; of conversions its name says. A format string with MORE conversions than the
; helper has parameters makes snprintf read a garbage vararg and typically
; segfaults the compiler. Add a new shape here rather than overloading one.
;
; TRUNCATION (Stage 15 W1d): `snprintf` returns the length the output WOULD have
; had, not what it wrote — so `arena-strndup buf n` with an over-long result
; memcpy'd past the end of the stack buffer. Every helper now clamps through
; `fmt-take`. This became reachable once diagnostics started embedding absolute
; file paths (W1c's unreachable-definer note, W1d's import-cycle notes): two
; long paths plus prose overruns a 512-byte buffer with no warning at all. The
; string-carrying helpers also moved 512 → 1024 so those messages fit whole
; rather than being clamped mid-sentence.

; Bytes actually available in `buf` after an `snprintf` of capacity `cap`:
; snprintf's return is the unbounded length, and it NUL-terminates at cap-1.
(defn fmt-take (n:i32 cap:i32):i64
  (when (< n 0) (return 0))
  (when (>= n cap) (return (as i64 (- cap 1))))
  (return (as i64 n)))

(defn fmt-i32 (fmt:ptr d:i32):ptr
  (let (buf:ptr (alloca i8 256)
        n:i32 (snprintf buf (as i64 256) fmt d))
    (return (arena-strndup buf (fmt-take n 256)))))

(defn fmt-i32-i32 (fmt:ptr a:i32 b:i32):ptr
  (let (buf:ptr (alloca i8 256)
        n:i32 (snprintf buf (as i64 256) fmt a b))
    (return (arena-strndup buf (fmt-take n 256)))))

(defn fmt-i64 (fmt:ptr d:i64):ptr
  (let (buf:ptr (alloca i8 256)
        n:i32 (snprintf buf (as i64 256) fmt d))
    (return (arena-strndup buf (fmt-take n 256)))))

(defn fmt-s (fmt:ptr s:ptr):ptr
  (let (buf:ptr (alloca i8 1024)
        n:i32 (snprintf buf (as i64 1024) fmt s))
    (return (arena-strndup buf (fmt-take n 1024)))))

(defn fmt-sd (fmt:ptr s:ptr d:i32):ptr
  (let (buf:ptr (alloca i8 1024)
        n:i32 (snprintf buf (as i64 1024) fmt s d))
    (return (arena-strndup buf (fmt-take n 1024)))))

(defn fmt-2s (fmt:ptr s1:ptr s2:ptr):ptr
  (let (buf:ptr (alloca i8 1024)
        n:i32 (snprintf buf (as i64 1024) fmt s1 s2))
    (return (arena-strndup buf (fmt-take n 1024)))))

(defn fmt-3s (fmt:ptr s1:ptr s2:ptr s3:ptr):ptr
  (let (buf:ptr (alloca i8 1024)
        n:i32 (snprintf buf (as i64 1024) fmt s1 s2 s3))
    (return (arena-strndup buf (fmt-take n 1024)))))

(defn fmt-2s-i (fmt:ptr s1:ptr s2:ptr d:i32):ptr
  (let (buf:ptr (alloca i8 1024)
        n:i32 (snprintf buf (as i64 1024) fmt s1 s2 d))
    (return (arena-strndup buf (fmt-take n 1024)))))

; One string, two ints (Stage 15 W4d: "macro '%s': expects %d args, got %d").
(defn fmt-s-2i (fmt:ptr s:ptr a:i32 b:i32):ptr
  (let (buf:ptr (alloca i8 1024)
        n:i32 (snprintf buf (as i64 1024) fmt s a b))
    (return (arena-strndup buf (fmt-take n 1024)))))

; Replace chars invalid in LLVM IR identifiers with underscores.
(defn sanitize-for-ir (name:ptr):ptr
  (let (n:i64 (strlen name)
        s:ptr (arena-alloc (+ n 1))
        i:i64 0)
    (while (< i n)
      (let (c:i32 (bit-and (as i32 (aref (as ptr:i8 name) i)) 255)
            is-digit:i1 (!= (isdigit c) 0)
            is-lower:i1 (and (>= c 97) (<= c 122))
            is-upper:i1 (and (>= c 65) (<= c 90))
            is-safe:i1  (or (= c 95) (= c 46))
            ok:i1       (or is-digit is-lower is-upper is-safe))
        (if ok
          (aset! (as ptr:i8 s) i (unsafe/cast i8 c))
          (aset! (as ptr:i8 s) i 95)))
      (set! i (+ i 1)))
    (aset! (as ptr:i8 s) n 0)
    (return s)))

; Replace chars invalid in C identifiers with underscores.
; Like sanitize-for-ir but dots (.) are also replaced — C identifiers are
; [A-Za-z_][A-Za-z0-9_]* and dots are not legal. Used only on the
; --emit-cheader path so IR struct names (which legally contain dots) are
; unaffected.
;
; This is a *blanket* sanitizer: it lossily collapses `?`, `!`, and `-` all to
; `_`. To name the REAL linkable symbol of a `?`/`!`-bearing name, the caller must
; run `ir-name-token` (in src/generics.nuc — the shared `?`→_QMARK / `!`→_BANG
; mnemonic map) FIRST, then hand the result here: `(sanitize-for-c (ir-name-token
; name))` (SM-3). sanitize-for-c does not call ir-name-token itself because
; format.nuc is imported before generics.nuc, so ir-name-token is not yet in scope
; here; the three cheader.nuc call sites compose the two in the correct order.
;
; Purely the CHARACTER half of the C-identifier rule; the first-position half
; (no leading digit) is `cheader-escape-leading-digit`, applied one layer up in
; cheader.nuc for the reason cheader-c-ident-join already gives for the reserved
; escape — it belongs on a complete identifier, and a fragment about to be joined
; after a prefix is never at position 0. W9 item 39.
(defn sanitize-for-c (name:ptr):ptr
  (let (n:i64 (strlen name)
        s:ptr (arena-alloc (+ n 1))
        i:i64 0)
    (while (< i n)
      (let (c:i32 (bit-and (as i32 (aref (as ptr:i8 name) i)) 255)
            is-digit:i1 (!= (isdigit c) 0)
            is-lower:i1 (and (>= c 97) (<= c 122))
            is-upper:i1 (and (>= c 65) (<= c 90))
            ok:i1       (or is-digit is-lower is-upper (= c 95)))
        (if ok
          (aset! (as ptr:i8 s) i (unsafe/cast i8 c))
          (aset! (as ptr:i8 s) i 95)))
      (set! i (+ i 1)))
    (aset! (as ptr:i8 s) n 0)
    (return s)))

; Copy the NUL-terminated C-string `lit` into `dst` at byte offset `off`;
; return the offset just past the copied bytes (excludes the terminator).
(defn ir-name-append (dst:ptr off:i64 lit:ptr):i64
  (let (m:i64 (strlen lit)
        i:i64 0)
    (while (< i m)
      (aset! (as ptr:i8 dst) (+ off i) (aref (as ptr:i8 lit) i))
      (set! i (+ i 1)))
    (return (+ off m))))

; Map the two symbol characters that are legal in Nucleus but illegal in an LLVM
; unquoted identifier — `?` and `!` — to greppable, C-linkable mnemonic escapes
; (`?`→`_QMARK`, `!`→`_BANG`; Clojure's munge precedent). EVERY OTHER CHARACTER,
; crucially the hyphen, passes through byte-for-byte. This is the shared base-name
; transform on every ir-name production path: the function/variable naming layer
; (op-name-token's overloaded path, the solitary-defn branch, ns-ir-base, and thus
; emit-defvar / .nuch import) AND the LLVM struct/union type-name layer (type-to-ir
; references + emit-defstruct / emit-pending-struct-ir-type / emit-union-ir-type /
; defunion-register definitions). It lives here in format.nuc — beside
; sanitize-for-ir / sanitize-for-c — rather than beside op-name-token in
; generics.nuc, because type-utils.nuc and union-registry.nuc are import-used
; before generics.nuc, so a call up to a generics.nuc definition would be an
; unresolved forward reference at emit time (the SM-3 import-order wall). Routing a
; non-`?`/`!` char through it — or ever calling sanitize-for-ir here — would rename
; the compiler's own hyphenated symbols and break the byte-identical bootstrap
; (§1.3). Fast path: a name with neither character is returned pointer-unchanged,
; so non-`?`/`!` names are a strict no-op.
;
; Stage 15 W9 item 39: LLVM's unquoted identifier is
; `[%@][-a-zA-Z$._][-a-zA-Z$._0-9]*` — a body character class, which the `?`/`!`
; map above covers, AND a rule about the FIRST position that no character class
; can express: it may not be a digit. `(defn 2fast …)` therefore passed every
; front-end check (a digit is in the legal *set*) and emitted `define i32 @2fast`,
; which LLVM reads as the numeric global id `@2` and rejects while parsing the
; module the compiler just wrote — a diagnostic naming a line of generated IR and
; nothing in the user's source. One leading `_` fixes the position, keeps the
; escape greppable, and stays a legal C identifier so `sanitize-for-c` (which
; applies the identical rule, C having the same restriction) agrees with it. The
; collision hazard is the `_QMARK` one exactly: a user's own `_2fast` now shares
; this name. That is the accepted cost of a targeted map — the blanket
; alternative renames every hyphenated symbol the compiler defines and breaks the
; byte-identical bootstrap (§1.3).
(defn ir-name-token (name:ptr):ptr
  (let (n:i64 (strlen name)
        special:i32 0
        lead:i32 0
        i:i64 0)
    (when (> n 0)
      (when (!= (isdigit (bit-and (as i32 (aref (as ptr:i8 name) 0)) 255)) 0)
        (set! lead 1)))
    (while (< i n)
      (let (c:i32 (bit-and (as i32 (aref (as ptr:i8 name) i)) 255))
        (when (or (= c 63) (= c 33)) (set! special 1)))
      (set! i (+ i 1)))
    (when (and (= special 0) (= lead 0)) (return name))
    ; Sizing pass: `?`→6 bytes (_QMARK), `!`→5 bytes (_BANG), else 1.
    (let (outn:i64 0
          j:i64 0)
      (when (!= lead 0) (set! outn 1))
      (while (< j n)
        (let (c:i32 (bit-and (as i32 (aref (as ptr:i8 name) j)) 255))
          (cond (= c 63) (set! outn (+ outn 6))
                (= c 33) (set! outn (+ outn 5))
                true     (set! outn (+ outn 1))))
        (set! j (+ j 1)))
      (let (s:ptr (arena-alloc (+ outn 1))
            si:i64 0
            k:i64 0)
        (when (!= lead 0)
          (aset! (as ptr:i8 s) 0 95)
          (set! si 1))
        (while (< k n)
          (let (c:i32 (bit-and (as i32 (aref (as ptr:i8 name) k)) 255))
            (cond (= c 63) (set! si (ir-name-append s si "_QMARK"))
                  (= c 33) (set! si (ir-name-append s si "_BANG"))
                  true     (do (aset! (as ptr:i8 s) si (unsafe/cast i8 c))
                               (set! si (+ si 1)))))
          (set! k (+ k 1)))
        (aset! (as ptr:i8 s) si 0)
        (return s)))))

; SM-5 (design/stage14/symbol-mangling.md): a small reusable validity check for
; a FINAL ir-name — the diagnostic backstop that catches any LLVM-illegal
; character ir-name-token/sanitize-for-ir/sanitize-for-c don't already handle.
; ir-name-token only special-cases `?`/`!`; the overloaded/mangled path and the
; cheader path both end in a blanket sanitize (`[0-9a-zA-Z_.]` / `[A-Za-z0-9_]`
; respectively) and can never emit anything illegal — this predicate exists for
; the SOLITARY ir-name path (ns-ir-base / defn-ir-name's fallback / emit-defvar
; / register-struct's ir-name), which applies only ir-name-token and nothing
; else. LLVM's unquoted identifier body allows [A-Za-z0-9$._-] — hyphen IS
; legal, never flag it (that's the whole point of SM-1's targeted-not-blanket
; approach); `$` is also legal. A leading `@`/`%` SIGIL (present on strings some
; callers pass whole, e.g. defn-ir-name's "@name") is skipped rather than
; flagged — it isn't part of the identifier body being validated.
; Returns the first illegal character code found (scanning after any leading
; sigil), or -1 if `name` is entirely legal.
(defn ir-name-illegal-char (name:ptr):i32
  (let (n:i64 (strlen name)
        i:i64 0)
    (when (> n 0)
      (let (c0:i32 (bit-and (as i32 (aref (as ptr:i8 name) 0)) 255))
        (when (or (= c0 64) (= c0 37)) (set! i 1))))   ; skip @ or %
    (while (< i n)
      (let (c:i32 (bit-and (as i32 (aref (as ptr:i8 name) i)) 255)
            is-digit:i1 (!= (isdigit c) 0)
            is-lower:i1 (and (>= c 97) (<= c 122))
            is-upper:i1 (and (>= c 65) (<= c 90))
            is-safe:i1  (or (= c 95) (= c 46) (= c 36) (= c 45))  ; _ . $ -
            ok:i1       (or is-digit is-lower is-upper is-safe))
        (when (= ok 0) (return c)))
      (set! i (+ i 1)))
    (return -1)))

; Non-zero when the identifier body of `name` (after any leading `@`/`%` sigil)
; begins with a digit — the other half of LLVM's identifier rule, about the first
; POSITION rather than the character set. W9 item 39.
;
; A separate predicate rather than a case inside ir-name-illegal-char because the
; two answer different questions and need different messages: a digit is legal in
; every position but the first, so reporting one as an "illegal character" would
; name a character that the same message's list of legal characters contains.
; ir-name-token now escapes this before it reaches emission, so this is purely
; the backstop for a future path that skips that transform.
(defn ir-name-leading-digit (name:ptr):i32
  (let (n:i64 (strlen name)
        i:i64 0)
    (when (= n 0) (return 0))
    (let (c0:i32 (bit-and (as i32 (aref (as ptr:i8 name) 0)) 255))
      (when (or (= c0 64) (= c0 37)) (set! i 1)))
    (when (>= i n) (return 0))
    (when (!= (isdigit (bit-and (as i32 (aref (as ptr:i8 name) i)) 255)) 0) (return 1))
    (return 0)))

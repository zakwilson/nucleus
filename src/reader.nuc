; Reader — lexer and S-expression parser for Nucleus source.
;
; Requires: Tok and Node structs, TOK-* and NODE-* constants,
; arena (arena-strndup, alloc-tok via arena-alloc), node utilities
; (alloc-node, make-cell), and reader globals (g-src, g-pos, g-line,
; g-source-path, g-peek, g-peek-valid).
; Also needs libc: isspace, isdigit, memcpy, fprintf, exit, and the stderr
; extern.
;
; Stage 10 E4: the reader's recoverable syntax errors are returned as `!ptr`
; values (a `(Result ptr Err)`) rather than aborting via `die-at`/`repl-throw`.
; The human-readable diagnostic is still printed at the fault site by
; `report-at` (so line/path context is preserved exactly); the propagated
; `parse-error` is the value-channel signal callers `try`/`match` on. `die-at`
; itself stays the panic tier for unrecoverable compiler bugs elsewhere.

(import-use error)

(deferror parse-error "parse error")

(defn cstr-byte-at (s:ptr pos:i64):i32
  (return (bit-and (as i32 (aref (as ptr:i8 s) pos)) 255)))

; ============================================================
; Error reporting
; ============================================================

(defn die-at (line:i32 msg:StrView):void
  :noreturn
  ; Stage 10 C3: consult the panic-tier debugger hook before aborting. With no
  ; (unhandled-error, i32) handler bound this is a one-load chain walk that
  ; returns none and falls straight through to today's abort; a bound handler
  ; may log/record `msg` first. The repair value is ignored (we abort anyway).
  ; Stage 17 C6: the detail is a `(ptr StrView)`, not the bytes — `signal`'s
  ; `detail:ptr` has no slot for a length, and the message is no longer
  ; NUL-terminated.
  (signal unhandled-error i32 (as ptr &msg))
  (eprint g-source-path ":" line ": error: " msg "\n")
  ; If a generic instantiation is being emitted, point back to it (and its call
  ; site). g-mono-context is null except during the monomorphization drain.
  (when (!= g-mono-context null)
    (eprint "  note: " g-mono-context "\n"))
  ; W9 item 42: a note the diagnosing site staged before calling. Cleared here so
  ; an interactive session, where repl-throw unwinds instead of exiting, cannot
  ; carry it onto an unrelated later error.
  (when (!= g-diag-note null)
    (eprint "  note: " g-diag-note "\n")
    (set! g-diag-note null))
  (when (!= g-interactive 0)
    (repl-throw))
  (exit 1))

; Stage 10 E4: report a recoverable reader error without aborting. Prints the
; same diagnostic `die-at` does (path:line: error: msg, plus the mono-context
; note), but returns to the caller, which then propagates `(err! parse-error)`.
(defn report-at (line:i32 msg:StrView):void
  (eprint g-source-path ":" line ": error: " msg "\n")
  (when (!= g-mono-context null)
    (eprint "  note: " g-mono-context "\n"))
  (when (!= g-diag-note null)
    (eprint "  note: " g-diag-note "\n")
    (set! g-diag-note null)))

; ============================================================
; Bracket-balance tracking (Stage 15 W4c)
;
; design/stage15-stress-test/diagnostics.md §W4c. An unterminated form is
; reported at the innermost unclosed form's opening line, which past a few
; nesting levels is only half a location: with eight `let`s open, "line 8" says
; where the compiler ran out of input, not where the `)` went missing. The other
; half is the first line that opens a NEW form in column 0 while a form is still
; open — the first point at which the imbalance became observable. Idiomatic
; Nucleus never indents a continuation line to column 0 (verified: zero
; occurrences of a column-0 `(` at nonzero depth across src/, lib/, examples/,
; and tests/), so a column-0 open at depth > 0 is always a top-level form that an
; earlier missing `)` swallowed.
;
; Both numbers are collected WHILE SCANNING — no second pass over the source.
; The column test is a single-character lookbehind at the moment the token is
; produced (`g-pos` still points at the bracket, so `g-src[g-pos-1] == '\n'` is
; exactly "this bracket is the first character on its line"), which is why the
; lexer needs no column counter threaded through `next-char`.
; ============================================================

; Called from `next-tok` for each opening bracket, BEFORE g-pos advances past it.
; `is-paren` is 1 only for `(`: a top-level form is always a parenthesised list,
; so `[`/`{`/`#{` contribute to the depth but are never column-0 candidates.
(defn reader-open-bracket (line:i32 is-paren:i32):void
  (when (= g-paren-depth 0)
    (set! g-form-open-line line))
  (when (and (!= is-paren 0) (> g-paren-depth 0) (= g-col0-open-line 0)
             (or (= g-pos 0) (= (cstr-byte-at g-src (- g-pos 1)) 10)))
    (set! g-col0-open-line line)
    (set! g-col0-open-depth g-paren-depth))
  (set! g-paren-depth (+ g-paren-depth 1)))

; Called from `next-tok` for each closing bracket (`)`, `]`, `}`). Not clamped —
; see the g-paren-depth commentary in src/nucleusc.nuc.
(defn reader-close-bracket ():void
  (set! g-paren-depth (- g-paren-depth 1)))

; Report an unterminated bracket: the opening line as the primary location, plus
; the second location that actually localizes the mistake. `closer` is the
; bracket the form is waiting for (")", "]", "}"), named in the note so the
; advice is right for a vector/map/set literal too. When there is no column-0
; candidate the imbalance is inside the file's last top-level form, and we say
; only how many forms were left open — never a bogus second number.
(defn report-unterminated (open-line:i32 msg:StrView closer:ptr):void
  (report-at open-line msg)
  (if (and (!= g-col0-open-line 0) (!= g-col0-open-line open-line))
    (eprint "  note: line " g-col0-open-line " starts a new form in column 0 while "
            g-col0-open-depth " form(s) are still open -- a '" closer
            "' is probably missing before line " g-col0-open-line "\n")
    (eprint "  note: end of file reached with " g-paren-depth " form(s) still open\n")))

; ============================================================
; Lexer
; ============================================================

(defn peek-char ():i32
  (return (cstr-byte-at g-src g-pos)))

(defn next-char ():i32
  (let (c:i32 (peek-char))
    (when (= c 0) (return 0))
    (set! g-pos (+ g-pos 1))
    (when (= c 10) (inc! g-line))
    (return c)))

(defn skip-ws ():void
  (while (!= 0 1)
    (let (c:i32 (peek-char))
      (when (= c 0) (return))
      (if (!= (isspace c) 0)
        (do (next-char))
        (if (= c 59)
          (do
            (while (and (!= (peek-char) 0) (!= (peek-char) 10))
              (next-char)))
          (return))))))

(defn is-sym-char (c:i32):i32
  (when (= c 0) (return 0))
  (when (!= (isspace c) 0) (return 0))
  (when (= c 40) (return 0))   ; (
  (when (= c 41) (return 0))   ; )
  (when (= c 34) (return 0))   ; "
  (when (= c 59) (return 0))   ; ;
  ; Collection-literal delimiters (Stage 11 M5) terminate an atom so that e.g.
  ; the trailing `]` in `[1 2 3]` is not swallowed into the `3` token. These
  ; characters appear in current source only inside string literals.
  (when (= c 91) (return 0))   ; [
  (when (= c 93) (return 0))   ; ]
  (when (= c 123) (return 0))  ; {
  (when (= c 125) (return 0))  ; }
  (return 1))

(defn lex-string (open-line:i32):!ptr
  (let (buf:ptr (alloca i8 4096)
        n:i64 0
        done:i32 0)
    (while (= done 0)
      (let (c:i32 (next-char))
        (when (= c 0)
          (do (report-at open-line "unterminated string literal")
              (return (err! parse-error))))
        (if (= c 34)
          (set! done 1)
          (do
            (when (= c 92)
              (let (e:i32 (next-char)
                    handled:i32 0)
                (when (= e 110) (do (set! c 10) (set! handled 1)))
                (when (= e 116) (do (set! c 9)  (set! handled 1)))
                (when (= e 114) (do (set! c 13) (set! handled 1)))
                (when (= e 48)  (do (set! c 0)  (set! handled 1)))
                (when (= e 92)  (do (set! c 92) (set! handled 1)))
                (when (= e 34)  (do (set! c 34) (set! handled 1)))
                ; `\xHH` — a raw byte as one or two hex digits (Stage 15 W5a).
                ; Deliberately **capped at two digits**, unlike C, which is
                ; greedy: in C `"\x41BC"` is a single (overflowing) character,
                ; whereas here it is `A`, `B`, `C`. Two digits address every
                ; practical case for a byte-oriented literal without C's
                ; run-on footgun. One digit is accepted (`"\xa"` == `"\x0a"`)
                ; because the following character is unambiguous either way.
                (when (= e 120)
                  (let (h1:i32 (hex-digit-val (peek-char)))
                    (when (< h1 0)
                      (do (report-at g-line "\\x escape needs at least one hex digit")
                          (return (err! parse-error))))
                    (next-char)
                    (set! c h1)
                    (let (h2:i32 (hex-digit-val (peek-char)))
                      (when (>= h2 0)
                        (do (next-char)
                            (set! c (+ (* c 16) h2)))))
                    (set! handled 1)))
                (when (= handled 0)
                  (do (report-at g-line (fstr "unknown escape \\" (as Char (as ui32 e))))
                      (return (err! parse-error))))))
            (when (>= n 4095)
              (do (report-at open-line "string literal too long")
                  (return (err! parse-error))))
            (set! (aref (as ptr:i8 buf) n) (unsafe/cast i8 c))
            (set! n (+ n 1))))))
    (let (t:ptr:Tok (as ptr:Tok (alloc-tok)))
      (set! (t 'kind) TOK-STRING)
      (set! (t 'line) open-line)
      (set! (t 's) (arena-strndup buf n))
      (return (ok (as ptr t))))))

; Stage 11 M6 (S0): char literals (design/stage11/string.md §"Char types",
; Q-char-literal). Backslash-led so they collide with neither keywords (leading
; `:`) nor strings (`"`):
;   \a          a single printable codepoint (the byte after the backslash)
;   \newline …  a named control code (newline/return/tab/space/nul/escape/
;               backspace/delete)
;   \u{1F600}   an explicit hex codepoint, validated to be a Unicode scalar
;               value (0..=0x10FFFF, surrogates 0xD800..=0xDFFF rejected)
; Emits a TOK-CHAR carrying the validated scalar value in `i`. At entry g-pos
; points at the leading backslash.

; ASCII hex digit -> 0..15, or -1 if not a hex digit. Self-contained (no libc
; isxdigit dependency), so the reader stays standalone-lexable.
(defn hex-digit-val (c:i32):i32
  (when (and (>= c 48) (<= c 57)) (return (- c 48)))     ; 0-9
  (when (and (>= c 97) (<= c 102)) (return (+ (- c 97) 10))) ; a-f
  (when (and (>= c 65) (<= c 70)) (return (+ (- c 65) 10)))  ; A-F
  (return -1))

; Build a TOK-CHAR with codepoint `cp` at `line`.
(defn make-char-tok (cp:i32 line:i32):ptr
  (let (t:ptr:Tok (as ptr:Tok (alloc-tok)))
    (set! (t 'kind) TOK-CHAR)
    (set! (t 'line) line)
    (set! (t 'i) cp)
    (return (as ptr t))))

(defn lex-char-literal (open-line:i32):!ptr
  ; Consume the leading backslash.
  (next-char)
  (let (c0:i32 (peek-char))
    (when (= c0 0)
      (do (report-at open-line "unterminated char literal")
          (return (err! parse-error))))
    ; `\u{XXXX}` hex form — only when 'u' is immediately followed by '{'. A bare
    ; `\u` (no brace) is the ordinary printable literal for the letter 'u'.
    (when (and (= c0 117) (= (cstr-byte-at g-src (+ g-pos 1)) 123))
      (next-char) (next-char)   ; consume 'u' and '{'
      (let (cp:i32 0 ndigits:i32 0 done:i32 0)
        (while (= done 0)
          (let (h:i32 (peek-char))
            (cond
              (= h 125) (do (next-char) (set! done 1))   ; '}'
              (= h 0)   (do (report-at open-line "unterminated \\u{...} char literal")
                            (return (err! parse-error)))
              true
                (let (hv:i32 (hex-digit-val h))
                  (when (< hv 0)
                    (do (report-at open-line "invalid hex digit in \\u{...} char literal")
                        (return (err! parse-error))))
                  (next-char)
                  (set! cp (+ (* cp 16) hv))
                  (set! ndigits (+ ndigits 1))
                  ; Guard against absurdly long sequences overflowing the
                  ; accumulator before the range check below can run.
                  (when (> ndigits 6)
                    (do (report-at open-line "codepoint out of range in \\u{...} (max 0x10FFFF)")
                        (return (err! parse-error))))))))
        (when (= ndigits 0)
          (do (report-at open-line "empty \\u{...} char literal")
              (return (err! parse-error))))
        ; Reject non-scalar values: > 0x10FFFF, or a UTF-16 surrogate.
        (when (> cp 1114111)
          (do (report-at open-line "invalid-codepoint: value exceeds 0x10FFFF")
              (return (err! parse-error))))
        (when (and (>= cp 55296) (<= cp 57343))
          (do (report-at open-line "invalid-codepoint: surrogate 0xD800..0xDFFF is not a scalar value")
              (return (err! parse-error))))
        (return (ok (make-char-tok cp open-line)))))
    ; If the character after the backslash is not a symbol char (e.g. `\(`,
    ; `\)`, `\"`, or a literal space `\ `), it is a single-codepoint literal of
    ; exactly that byte — consume just it.
    (when (= (is-sym-char c0) 0)
      (next-char)
      (return (ok (make-char-tok c0 open-line))))
    ; Otherwise read the run of symbol chars: length 1 is a printable scalar,
    ; a longer run must be a recognized named control code.
    (let (start:i64 g-pos)
      (while (!= (is-sym-char (peek-char)) 0)
        (next-char))
      (let (len:i64 (- g-pos start)
            text:ptr (unsafe/ptr+ (as ptr:i8 g-src) start)
            tv:StrView (strview (unsafe/cast ptr:ui8 (unsafe/ptr+ (as ptr:i8 g-src) start))
                                (unsafe/cast usize (- g-pos start))))
        (when (= len 1)
          (return (ok (make-char-tok (cstr-byte-at text 0) open-line))))
        ; Named control codes (string.md §"Char types"). One length-checked
        ; compare each; the `strncmp` form needed a paired length test beside it.
        (when (= tv "newline")   (return (ok (make-char-tok 10 open-line))))
        (when (= tv "return")    (return (ok (make-char-tok 13 open-line))))
        (when (= tv "tab")       (return (ok (make-char-tok 9 open-line))))
        (when (= tv "space")     (return (ok (make-char-tok 32 open-line))))
        (when (= tv "nul")       (return (ok (make-char-tok 0 open-line))))
        (when (= tv "escape")    (return (ok (make-char-tok 27 open-line))))
        (when (= tv "backspace") (return (ok (make-char-tok 8 open-line))))
        (when (= tv "delete")    (return (ok (make-char-tok 127 open-line))))
        (do (report-at open-line (fstr "unknown named char literal '\\" (arena-strndup text len)
                                       "'"))
            (return (err! parse-error)))))))

; Returns 1 if `text` (length `len`) is a float literal in the syntactic
; sense: optional sign, at least one digit, contains either `.` or
; `e`/`E`, and consists otherwise of digits and at most one exponent
; with optional sign. Also accepts the special tokens `+inf.0`,
; `-inf.0`, `+nan.0` (Scheme convention).
(defn is-float-literal (text:ptr len:i64):i32
  (when (<= len 0) (return 0))
  ; Special tokens.
  (when (= len 6)
    (let (tv:StrView (strview (unsafe/cast ptr:ui8 text) (unsafe/cast usize len)))
      (when (or (= tv "+inf.0") (or (= tv "-inf.0") (= tv "+nan.0"))) (return 1))))
  (let (i:i64 0
        c0:i32 (cstr-byte-at text 0))
    (when (or (= c0 43) (= c0 45)) (set! i 1))
    (let (start:i64 i
          digits-before:i32 0
          digits-after:i32 0
          digits-exp:i32 0
          saw-dot:i32 0
          saw-e:i32 0)
      (while (and (< i len)
                  (!= (isdigit (cstr-byte-at text i)) 0))
        (set! digits-before 1)
        (set! i (+ i 1)))
      (when (and (< i len) (= (cstr-byte-at text i) 46))
        (set! saw-dot 1)
        (set! i (+ i 1))
        (while (and (< i len)
                    (!= (isdigit (cstr-byte-at text i)) 0))
          (set! digits-after 1)
          (set! i (+ i 1))))
      (when (and (< i len)
                 (or (= (cstr-byte-at text i) 101) (= (cstr-byte-at text i) 69)))
        (set! saw-e 1)
        (set! i (+ i 1))
        (when (and (< i len)
                   (or (= (cstr-byte-at text i) 43) (= (cstr-byte-at text i) 45)))
          (set! i (+ i 1)))
        (while (and (< i len)
                    (!= (isdigit (cstr-byte-at text i)) 0))
          (set! digits-exp 1)
          (set! i (+ i 1))))
      (when (!= i len) (return 0))
      ; Must contain a `.` or `e`/`E` to be a float (otherwise it's an int).
      (when (and (= saw-dot 0) (= saw-e 0)) (return 0))
      ; Must have some digits somewhere.
      (when (and (= digits-before 0) (= digits-after 0)) (return 0))
      ; If there's an exponent, must have exponent digits.
      (when (and (!= saw-e 0) (= digits-exp 0)) (return 0))
      (return 1))))

; Stage 16 FL-3: 0 = not a hex literal, 1 = hex integer, 2 = hex float. C makes
; the binary exponent mandatory on a hex float, which is exactly what separates
; the two — `0x1F` is an integer, `0x1p0` is a float, and `0x1.8` is neither
; (clang: "hexadecimal floating constant requires an exponent").
(defn hex-atom-kind (text:ptr len:i64):i32
  (let (i:i64 0)
    (when (< len 3) (return 0))
    (when (or (= (cstr-byte-at text 0) 43) (= (cstr-byte-at text 0) 45)) (set! i 1))
    (when (> (+ i 3) len) (return 0))
    (when (!= (cstr-byte-at text i) 48) (return 0))
    (when (and (!= (cstr-byte-at text (+ i 1)) 120) (!= (cstr-byte-at text (+ i 1)) 88))
      (return 0))
    (set! i (+ i 2))
    (let (digits:i32 0
          seen-dot:i32 0)
      (while (and (< i len) (>= (hex-digit-val (cstr-byte-at text i)) 0))
        (set! digits 1)
        (set! i (+ i 1)))
      (when (and (< i len) (= (cstr-byte-at text i) 46))
        (do (set! seen-dot 1)
            (set! i (+ i 1))
            (while (and (< i len) (>= (hex-digit-val (cstr-byte-at text i)) 0))
              (set! digits 1)
              (set! i (+ i 1)))))
      (when (= digits 0) (return 0))
      (when (= i len)
        (if (= seen-dot 0) (return 1) (return 0)))
      (when (and (!= (cstr-byte-at text i) 112) (!= (cstr-byte-at text i) 80)) (return 0))
      (set! i (+ i 1))
      (when (and (< i len)
                 (or (= (cstr-byte-at text i) 43) (= (cstr-byte-at text i) 45)))
        (set! i (+ i 1)))
      (let (edig:i32 0)
        (while (and (< i len) (!= (isdigit (cstr-byte-at text i)) 0))
          (set! edig 1)
          (set! i (+ i 1)))
        (when (= edig 0) (return 0))
        (when (!= i len) (return 0))
        (return 2)))))

; Stage 16: `&T` is sugar for `ref:T`, expanded before the parser so that every
; reader of a type spelling — not just the type parser — sees the colon chain
; (design/stage16-ergonomics/ref-sigil.md).

; Does the character after this one still start a chain segment? A sigil and a
; ':' open one; `?`/`!` keep one open, so `?&T` reads as `?ref:T`.
(defn ref-sigil-seg-next (c:i32 seg:i32):i32
  (when (and (= c 38) (!= seg 0)) (return 1))
  (when (or (= c 63) (= c 33)) (return seg))
  (return (if (= c 58) 1 0)))

(defn expand-ref-sigil (text:ptr len:i64):ptr
  (let (n:i64 0
        i:i64 0
        seg:i32 1)
    (while (< i len)
      (let (c:i32 (cstr-byte-at text i))
        (when (and (= c 38) (!= seg 0)) (set! n (+ n 1)))
        (set! seg (ref-sigil-seg-next c seg)))
      (set! i (+ i 1)))
    (let (s:ptr (arena-strndup text len))
      (when (= n 0) (return s))
      ; Left unexpanded so a retired marker still reaches reject-legacy-marker,
      ; which names its replacement instead of failing as `unknown type: rest`.
      (when (!= (legacy-marker-tail s) null) (return s))
      (let (out:ptr (arena-alloc (+ (+ len (* 3 n)) 1))
            o:i64 0
            j:i64 0
            seg2:i32 1)
        (while (< j len)
          (let (c:i32 (cstr-byte-at text j))
            (if (and (= c 38) (!= seg2 0))
              (do (set! (aref (as ptr:i8 out) o) (unsafe/cast i8 114))          ; 'r'
                  (set! (aref (as ptr:i8 out) (+ o 1)) (unsafe/cast i8 101))    ; 'e'
                  (set! (aref (as ptr:i8 out) (+ o 2)) (unsafe/cast i8 102))    ; 'f'
                  (set! (aref (as ptr:i8 out) (+ o 3)) (unsafe/cast i8 58))     ; ':'
                  (set! o (+ o 4)))
              (do (set! (aref (as ptr:i8 out) o) (unsafe/cast i8 c))
                  (set! o (+ o 1))))
            (set! seg2 (ref-sigil-seg-next c seg2)))
          (set! j (+ j 1)))
        (set! (aref (as ptr:i8 out) o) (unsafe/cast i8 0))
        (return out)))))

; A retired `&x` marker must reach reject-legacy-marker, which names its keyword
; replacement, instead of being consumed by the `&` reader macro (ref-sigil.md §6).
(defn at-legacy-marker ():i32
  (let (end:i64 g-pos)
    (while (!= (is-sym-char (cstr-byte-at g-src end)) 0)
      (set! end (+ end 1)))
    (when (<= (- end g-pos) 1) (return 0))
    (let (tok:ptr (arena-strndup (unsafe/ptr+ (as ptr:i8 g-src) g-pos) (- end g-pos)))
      (return (if (= (legacy-marker-tail tok) null) 0 1)))))

; LW-4's two-step, as one place. `lib/parse.nuc`'s `FromStr` is keyed only on
; the target TYPE, so it cannot say "signed at this width, and if that overflows
; try unsigned at the same width" — nor take a radix, which the `0x` literal
; needs; `strview-parse-magnitude` is the primitive underneath it that can.
;
; The u64 bits land in the signed i64 field, where `%ld` emission plus LLVM's
; two's-complement wrap reproduce the value the source wrote. A NEGATIVE literal
; gets no second chance: below -2^63 there is nothing wider to widen to.
(defn lex-int-value (tv:StrView radix:i32):!i64
  (let (start:usize 0
        neg:i32 (strview-parse-sign tv (addr-of start))
        digits:StrView (strview-drop-bytes tv start)
        smax:ui64 (if (!= neg 0) 9223372036854775808 9223372036854775807))
    ; `strtol` skipped the `0x` itself in base 16; the magnitude parser reads
    ; digits only, so the sigil comes off here. `hex-atom-kind` has already
    ; established that it is present and followed by at least one hex digit.
    (when (and (= radix 16)
               (or (strview-has-prefix digits "0x") (strview-has-prefix digits "0X")))
      (set! digits (strview-drop-bytes digits 2)))
    (match (strview-parse-magnitude digits radix smax)
      ((ok m) (if (!= neg 0)
                (return (ok (- 0 (unsafe/cast i64 m))))
                (return (ok (unsafe/cast i64 m)))))
      ((err e) 0))
    (when (!= neg 0) (return (err! parse-error)))
    (return (ok (unsafe/cast i64
                  (try (strview-parse-magnitude digits radix 18446744073709551615)))))))

(defn lex-atom ():!ptr
  (let (start-line:i32 g-line
        start:i64 g-pos)
    (while (!= (is-sym-char (peek-char)) 0)
      (next-char))
    (let (len:i64 (- g-pos start)
          text:ptr (unsafe/ptr+ (as ptr:i8 g-src) start)
          is-int:i32 1
          i0:i64 0)
      (when (= len 0) (set! is-int 0))
      (when (and (> len 0)
               (or (= (cstr-byte-at text 0) 45)
                   (= (cstr-byte-at text 0) 43)))
        (set! i0 1))
      (when (= i0 len) (set! is-int 0))
      (let (i:i64 i0)
        (while (< i len)
          (if (= (isdigit (cstr-byte-at text i)) 0)
            (do (set! is-int 0) (set! i len))
            (set! i (+ i 1)))))
      (when (!= is-int 0)
        (let (t:ptr:Tok (as ptr:Tok (alloc-tok))
              tv:StrView (strview (unsafe/cast ptr:ui8 text) (unsafe/cast usize len)))
          (set! (t 'kind) TOK-INT)
          (set! (t 'line) start-line)
          ; LW-4: a non-negative literal that overflows signed i64 may still fit
          ; unsigned 64 (ui64/usize scale), so it is retried at the wider limit;
          ; the u64 bits are stored into the signed i64 field where `%ld`
          ; emission plus LLVM's two's-complement wrap reproduce the intended
          ; value. A negative overflow, or a value above u64, is a positioned
          ; reader error.
          (match (lex-int-value tv 10)
            ((ok v) (set! (t 'i) v))
            ((err e)
              (do (report-at start-line "integer literal out of range")
                  (return (err! parse-error)))))
          (return (ok (as ptr t)))))
      ; Stage 16 FL-3: C's hex literals. Both spellings were plain symbols
      ; before — and so an "undefined" error at every use — which is why this
      ; is purely additive to every existing program.
      (let (hk:i32 (hex-atom-kind text len))
        (when (= hk 2)
          (let (tf:ptr:Tok (as ptr:Tok (alloc-tok)))
            (set! (tf 'kind) TOK-FLOAT)
            (set! (tf 'line) start-line)
            (set! (tf 's) (arena-strndup text len))
            (return (ok (as ptr tf)))))
        (when (= hk 1)
          (let (t:ptr:Tok (as ptr:Tok (alloc-tok))
                tv:StrView (strview (unsafe/cast ptr:ui8 text) (unsafe/cast usize len)))
              (set! (t 'kind) TOK-INT)
              (set! (t 'line) start-line)
              ; Same two-step as the decimal path (LW-4): a positive literal
              ; that overflows signed i64 may still be a ui64/usize value.
              (match (lex-int-value tv 16)
                ((ok v) (set! (t 'i) v))
                ((err e)
                  (do (report-at start-line "integer literal out of range")
                      (return (err! parse-error)))))
              (return (ok (as ptr t))))))
      (when (!= (is-float-literal text len) 0)
        (let (tf:ptr:Tok (as ptr:Tok (alloc-tok)))
          (set! (tf 'kind) TOK-FLOAT)
          (set! (tf 'line) start-line)
          (set! (tf 's) (arena-strndup text len))
          (return (ok (as ptr tf)))))
      ; Keyword literal (Stage 11 cleanup §2): an atom that begins with ':' and
      ; has a non-empty remainder is a keyword. The token carries the NAME only
      ; (the leading colon stripped), so downstream interning and printing never
      ; re-handle the sigil. A lone ':' (len 1) is not a keyword — it falls
      ; through to a plain symbol. No existing source has a colon-led atom, so
      ; this is additive (the compiler's own source stays a bootstrap fixed
      ; point). Colon-CHAIN spellings like `ptr:i8` or trailing-colon sugar
      ; `name:` do not begin with ':' and are unaffected.
      (when (and (> len 1) (= (cstr-byte-at text 0) 58))
        (let (tk:ptr:Tok (as ptr:Tok (alloc-tok)))
          (set! (tk 'kind) TOK-KEYWORD)
          (set! (tk 'line) start-line)
          (set! (tk 's) (expand-ref-sigil (unsafe/ptr+ (as ptr:i8 text) 1) (- len 1)))
          (return (ok (as ptr tk)))))
      (let (ts:ptr:Tok (as ptr:Tok (alloc-tok)))
        (set! (ts 'kind) TOK-SYMBOL)
        (set! (ts 'line) start-line)
        (set! (ts 's) (expand-ref-sigil text len))
        (return (ok (as ptr ts)))))))

(defn next-tok ():!ptr
  (skip-ws)
  (let (c:i32 (peek-char)
        line:i32 g-line)
    (when (= c 0)
      (let (te:ptr:Tok (as ptr:Tok (alloc-tok)))
        (set! (te 'kind) TOK-EOF)
        (set! (te 'line) line)
        (return (ok (as ptr te)))))
    (when (= c 40)
      (do (reader-open-bracket line 1)
          (next-char)
        (let (tl:ptr:Tok (as ptr:Tok (alloc-tok)))
          (set! (tl 'kind) TOK-LPAREN)
          (set! (tl 'line) line)
          (return (ok (as ptr tl))))))
    (when (= c 41)
      (do (reader-close-bracket)
          (next-char)
        (let (tr:ptr:Tok (as ptr:Tok (alloc-tok)))
          (set! (tr 'kind) TOK-RPAREN)
          (set! (tr 'line) line)
          (return (ok (as ptr tr))))))
    ; Collection-literal delimiters (Stage 11 M5). `[` … `]` is a Vector
    ; literal, `{` … `}` a HashMap literal, `#{` … `}` a HashSet literal. The
    ; `#{` two-char sequence must be matched before `#` is lexed as a symbol
    ; char (a lone `#` still falls through to lex-atom). `[` `]` `{` `}` were
    ; previously symbol chars but appear in current source only inside string
    ; literals, so claiming them as delimiters is non-breaking.
    (when (= c 91)
      (do (reader-open-bracket line 0)
          (next-char)
        (let (tlb:ptr:Tok (as ptr:Tok (alloc-tok)))
          (set! (tlb 'kind) TOK-LBRACK)
          (set! (tlb 'line) line)
          (return (ok (as ptr tlb))))))
    (when (= c 93)
      (do (reader-close-bracket)
          (next-char)
        (let (trb:ptr:Tok (as ptr:Tok (alloc-tok)))
          (set! (trb 'kind) TOK-RBRACK)
          (set! (trb 'line) line)
          (return (ok (as ptr trb))))))
    (when (and (= c 35) (= (cstr-byte-at g-src (+ g-pos 1)) 123))
      (do (reader-open-bracket line 0)
          (next-char) (next-char)
        (let (thb:ptr:Tok (as ptr:Tok (alloc-tok)))
          (set! (thb 'kind) TOK-HASHBRACE)
          (set! (thb 'line) line)
          (return (ok (as ptr thb))))))
    (when (= c 123)
      (do (reader-open-bracket line 0)
          (next-char)
        (let (tlc:ptr:Tok (as ptr:Tok (alloc-tok)))
          (set! (tlc 'kind) TOK-LBRACE)
          (set! (tlc 'line) line)
          (return (ok (as ptr tlc))))))
    (when (= c 125)
      (do (reader-close-bracket)
          (next-char)
        (let (trc:ptr:Tok (as ptr:Tok (alloc-tok)))
          (set! (trc 'kind) TOK-RBRACE)
          (set! (trc 'line) line)
          (return (ok (as ptr trc))))))
    ; The `&` reader macro must not swallow a retired marker (at-legacy-marker).
    (when (and (= c 38) (!= (at-legacy-marker) 0))
      (return (lex-atom)))
    ; Reader macro table lookup — longest prefix match
    (let (best-idx:i32 -1
          best-len:i32 0
          ri:i32 0)
      (while (< ri (unsafe/cast i32 (count g-rmacros)))
        (let (rm:ptr:RMacro (as ptr:RMacro (invoke g-rmacros (as usize ri)))
              plen:i32 (rm 'prefix-len)
              match:i32 1
              j:i32 0)
          (while (< j plen)
            (when (!= (cstr-byte-at g-src (+ g-pos j))
                      (cstr-byte-at (rm 'prefix) j))
              (do (set! match 0)
                  (set! j plen)))
            (set! j (+ j 1)))
          (when (and (!= match 0) (> plen best-len))
            (do (set! best-idx ri)
                (set! best-len plen))))
        (inc! ri))
      (when (>= best-idx 0)
        (let (rm:ptr:RMacro (as ptr:RMacro (invoke g-rmacros best-idx:usize)))
          ; Advance past prefix characters (tracking newlines)
          (let (k:i32 0)
            (while (< k best-len)
              (next-char)
              (inc! k)))
          (let (tq:ptr:Tok (as ptr:Tok (alloc-tok)))
            (set! (tq 'kind) TOK-RMACRO)
            (set! (tq 'line) line)
            (set! (tq 's) (rm 'wrap-sym))
            (return (ok (as ptr tq)))))))
    ; Stage 14 NS-4 (design/stage14/native-strings.md): `c"…"` — a `c` glued
    ; directly to an opening quote with no whitespace — is an explicit CStr
    ; literal: the bare char* GEP, no StrView view header, no target-typing (the
    ; direct "I mean char*" spelling for FFI/format hot spots). `c"` adjacency is
    ; otherwise unreachable — a bare symbol `c` is delimiter-separated from a
    ; following string — so this is purely additive and no existing source uses
    ; it. Consume the `c` and the quote, lex the body exactly as a plain literal,
    ; and flag the token CStr via `i=1`, carried into NODE-STR.i and read by
    ; emit-string / node-type. A plain `"…"` leaves `i=0` → StrView (NS-3).
    (when (and (= c 99) (= (cstr-byte-at g-src (+ g-pos 1)) 34))
      (do (next-char)
          (next-char)
          (let (cst:ptr (try (lex-string line)))
            (set! ((as ptr:Tok cst) 'i) 1)
            (return (ok cst)))))
    (when (= c 34)
      (do (next-char) (return (lex-string line))))
    ; Char literal (Stage 11 M6 S0): a leading backslash. No current source has a
    ; bare backslash outside a string literal (handled above), so this is purely
    ; additive — the compiler's own source stays a bootstrap fixed point.
    (when (= c 92)
      (return (lex-char-literal line)))
    (return (lex-atom))))

; ============================================================
; Reader / AST
; ============================================================

(defn peek-tok ():!ptr
  (when (= g-peek-valid 0)
    (do (set! g-peek (try (next-tok)))
        (set! g-peek-valid 1)))
  (return (ok g-peek)))

(defn eat-tok ():!ptr
  (let (t:ptr (try (peek-tok)))
    (set! g-peek-valid 0)
    (return (ok t))))

; ============================================================
; Collection-literal sugar (Stage 11 M5)
;
; `[e1 e2 …]`     -> Vector  literal
; `{k1 v1 k2 v2}` -> HashMap  literal
; `#{e1 e2 …}`    -> HashSet  literal
;
; Each reads as `(vector-lit <g> e …)` / `(hashset-lit <g> e …)` /
; `(hashmap-lit <g> k v …)` and is EXPANDED at emit time by
; `emit-collection-lit` (src/nucleusc.nuc), which stack-allocates the stamped
; collection, runs its in-place init with the default allocator, conj/assoc-es
; every element, and yields the `(ref Coll)`.
;
; Stage 16: the expansion used to happen right here, which is why an element had
; to be a scalar *literal* — the reader can only type what it can see in a token,
; and `read-program` finishes before any binding is registered. Deferring it to
; the first phase that has types is what lets an element be a variable
; (design/stage16-ergonomics/collection-literal-variables.md).
;
; The gensym is still minted HERE so its counter order — and therefore the
; emitted IR — is unchanged from when the reader built the whole expansion.
; ============================================================

; Build a single-symbol Node from a C string (interned: identical spellings
; share identity, matching reader-produced symbols elsewhere).
(defn lit-sym (s:ptr):ptr
  (return (as ptr (intern-symbol s))))

; Build the node list `( <a> <b> )`.
(defn lit-list2 (a:ptr b:ptr line:i32):ptr
  (return (as ptr (make-cell a (make-cell b null line) line))))

; Build the node list `( <a> <b> <c> )`.
(defn lit-list3 (a:ptr b:ptr c:ptr line:i32):ptr
  (return (as ptr (make-cell a (make-cell b (make-cell c null line) line) line))))

; Build `(ref <ty>)` where <ty> is an already-built type node.
(defn lit-ref (ty:ptr line:i32):ptr
  (return (lit-list2 (lit-sym "ref") ty line)))

; Build `(alloca <ty>)` where <ty> is an already-built type node.
(defn lit-alloca (ty:ptr line:i32):ptr
  (return (lit-list2 (lit-sym "alloca") ty line)))

; Is `n` the form `(quote <symbol>)` — i.e. `'foo`? A symbol ELEMENT has to be
; written quoted (bare `foo` is a variable reference), and the reader macro turns
; `'foo` into a two-element list, so this is a shape check rather than the kind
; check every other element kind gets.
(defn lit-is-quoted-sym (n:ptr):i32
  (when (= n null) (return 0))
  (let (nn:ptr:Node (as ptr:Node n))
    (when (!= (nn 'kind) NODE-CELL) (return 0))
    (when (!= (node-len n) 2) (return 0))
    (let (h:ptr (node-at n 0)
          a:ptr (node-at n 1))
      (when (or (= h null) (= a null)) (return 0))
      (let (hn:ptr:Node (as ptr:Node h)
            an:ptr:Node (as ptr:Node a))
        (when (!= (hn 'kind) NODE-SYM) (return 0))
        (when (!= (hn 's) "quote") (return 0))
        (when (!= (an 'kind) NODE-SYM) (return 0))
        (return 1)))))

; Classify one literal element node into a coarse "kind": 1 = integer, 2 = float,
; 3 = string, 4 = keyword, 5 = quoted symbol, 0 = anything else, whose type
; `emit-collection-lit` asks `node-type` for instead.
;
; Kinds 1 and 2 are *adaptable* — an integer literal alongside an `i64` value
; makes the collection `i64`, exactly as `(conj v 1)` on a `(Vector i64)` is
; already accepted. Kinds 3-5 are fixed, and deliberately keep the spelling the
; reader always gave them: `node-type` types a NODE-STR as StrView (NS-3), so
; asking it here would silently retype every existing `["a" "b"]`.
(defn lit-elem-kind (n:ptr):i32
  (when (= n null) (return 0))
  (let (nn:ptr:Node (as ptr:Node n))
    (when (= (nn 'kind) NODE-INT) (return 1))
    (when (= (nn 'kind) NODE-FLOAT) (return 2))
    (when (= (nn 'kind) NODE-STR) (return 3))
    (when (= (nn 'kind) NODE-KEYWORD) (return 4))
    (when (!= (lit-is-quoted-sym n) 0) (return 5))
    (return 0)))

; The element type for a kind, as a FRESH type node.
;
; A node rather than a spelling because a symbol's type is the compound
; `(ref Node)`, which `lit-sym` cannot spell. Fresh per call because the readers
; stamp the type into two positions (the `ref` binding and the `alloca`) and must
; not share one node between them.
;
; `Keyword` is defined in lib/keyword.nuc, so a keyword literal is the one bracket
; literal whose element type the collection import does not reach; the
; unknown-type diagnostic names the file to import. `Node` is in lib/prelude.nuc,
; so a symbol literal needs nothing extra.
(defn lit-type-node (kind:i32 line:i32):ptr
  (when (= kind 1) (return (lit-sym "i32")))
  (when (= kind 2) (return (lit-sym "f64")))
  (when (= kind 3) (return (lit-sym "CStr")))
  (when (= kind 4) (return (lit-sym "Keyword")))
  ; A quoted symbol lowers to intern-symbol, whose result is non-null — see
  ; quoted-datum-type in src/nucleusc.nuc.
  (when (= kind 5) (return (lit-list2 (lit-sym "ref") (lit-sym "Node") line)))
  (return null))

; Read literal elements until the given close-token kind, collecting them into a
; cell-list (head returned via out-pointer slots is awkward here, so we return
; the head node and the count). Consumes the close token. On EOF before close,
; reports an "unterminated" diagnostic and returns the parse-error.
;   what       : "vector"/"map"/"set" (diagnostic text)
;   close-kind : TOK-RBRACK or TOK-RBRACE
;   open-line  : line of the opening delimiter
; Returns the head of the element cell-list (null when empty).
(defn read-lit-elems (what:ptr close-kind:i32 open-line:i32):!ptr
  (let (head:ptr null
        tail:ptr null)
    (while (!= 0 1)
      (let (t:ptr:Tok (as ptr:Tok (try (peek-tok))))
        (when (= (t 'kind) TOK-EOF)
          (do (report-unterminated open-line (fstr "unterminated " what " literal")
                (if (= close-kind TOK-RBRACK) "]" "}"))
              (return (err! parse-error))))
        (when (= (t 'kind) close-kind)
          (do (try (eat-tok)) (return (ok head))))
        (let (child:ptr (try (read-form))
              cell:ptr (make-cell child null open-line))
          (when (= tail null) (set! head cell))
          (when (!= tail null) (set! ((as ptr:Node tail) 'cdr) cell))
          (set! tail cell))))
    (return (ok head))))

; `[e1 e2 …]` -> `(vector-lit <g> e1 e2 …)`. The empty case is NOT refused here
; any more: with a declared target type there is an element type to build from,
; so `emit-collection-lit` owns that diagnostic now.
(defn read-vector-literal (line:i32):!ptr
  (let (head:ptr (try (read-lit-elems "vector" TOK-RBRACK line)))
    (return (ok (make-cell (lit-sym "vector-lit")
                  (make-cell (nucleus_gensym) head line) line)))))

; `#{e1 e2 …}` -> `(hashset-lit <g> e1 e2 …)`.
(defn read-hashset-literal (line:i32):!ptr
  (let (head:ptr (try (read-lit-elems "set" TOK-RBRACE line)))
    (return (ok (make-cell (lit-sym "hashset-lit")
                  (make-cell (nucleus_gensym) head line) line)))))

; `{k1 v1 k2 v2 …}` -> `(hashmap-lit <g> k1 v1 k2 v2 …)`. The odd-count check
; stays here because it is purely syntactic — it needs no types.
(defn read-hashmap-literal (line:i32):!ptr
  (let (head:ptr (try (read-lit-elems "map" TOK-RBRACE line)))
    (when (!= (bit-and (node-len head) 1) 0)
      (do (report-at line "map literal: odd number of elements")
          (return (err! parse-error))))
    (return (ok (make-cell (lit-sym "hashmap-lit")
                  (make-cell (nucleus_gensym) head line) line)))))

(defn read-form ():!ptr
  (let (t:ptr:Tok (as ptr:Tok (try (eat-tok))))
    (when (= (t 'kind) TOK-LPAREN) (return (read-list (t 'line))))
    (when (= (t 'kind) TOK-LBRACK) (return (read-vector-literal (t 'line))))
    (when (= (t 'kind) TOK-HASHBRACE) (return (read-hashset-literal (t 'line))))
    (when (= (t 'kind) TOK-LBRACE) (return (read-hashmap-literal (t 'line))))
    (when (= (t 'kind) TOK-RBRACK)
      (do (report-at (t 'line) "unexpected ]")
          (return (err! parse-error))))
    (when (= (t 'kind) TOK-RBRACE)
      (do (report-at (t 'line) "unexpected }")
          (return (err! parse-error))))
    (when (= (t 'kind) TOK-RPAREN)
      (do (report-at (t 'line) "unexpected )")
          ; W4c: a NEGATIVE depth means this `)` has no matching `(` anywhere —
          ; as opposed to a `)` that merely turned up where a form was expected
          ; (inside an unclosed `[…]`, say), where the bracket it closes is real.
          ; The form it would have closed is already closed, so the stray `)` (or
          ; the one that closed a form too early) is between that form's opening
          ; line and here. This is the shape an extra `)` in a `let` binding list
          ; produces once the file no longer balances.
          (when (and (< g-paren-depth 0) (!= g-form-open-line 0))
            (eprint "  note: the form opened at line " g-form-open-line
                    " is already closed -- look for an extra ')' between lines "
                    g-form-open-line " and " (t 'line) "\n"))
          (return (err! parse-error))))
    (when (= (t 'kind) TOK-RMACRO)
      (let (quoted:ptr (try (read-form))
            sym:ptr (intern-symbol (t 's)))
        (return (ok (make-cell sym
                               (make-cell quoted null (t 'line))
                               (t 'line))))))
    (when (= (t 'kind) TOK-INT)
      (let (n:ptr:Node (as ptr:Node (alloc-node)))
        (set! (n 'kind) NODE-INT)
        (set! (n 'line) (t 'line))
        (set! (n 'i) (t 'i))
        (return (ok (as ptr n)))))
    ; Char literal (Stage 11 M6 S0): a NODE-CHAR carrying the validated Unicode
    ; scalar value in `i`. Self-evaluating; the compiler emits it as a Char-typed
    ; i32 constant (emit-char-literal).
    (when (= (t 'kind) TOK-CHAR)
      (let (n:ptr:Node (as ptr:Node (alloc-node)))
        (set! (n 'kind) NODE-CHAR)
        (set! (n 'line) (t 'line))
        (set! (n 'i) (t 'i))
        (return (ok (as ptr n)))))
    (when (= (t 'kind) TOK-FLOAT)
      (let (n:ptr:Node (as ptr:Node (alloc-node)))
        (set! (n 'kind) NODE-FLOAT)
        (set! (n 'line) (t 'line))
        (set! (n 's) (t 's))
        (return (ok (as ptr n)))))
    (when (= (t 'kind) TOK-STRING)
      (let (n:ptr:Node (as ptr:Node (alloc-node)))
        (set! (n 'kind) NODE-STR)
        (set! (n 'line) (t 'line))
        ; NS-4: carry the CStr flag (0 = StrView default, 1 = explicit c"…").
        ; A plain string token has i=0 (arena zero-fill), so this is a no-op for
        ; every existing literal — byte-identical.
        (set! (n 'i) (t 'i))
        (set! (n 's) (t 's))
        (return (ok (as ptr n)))))
    (when (= (t 'kind) TOK-SYMBOL)
      (return (ok (intern-symbol (t 's)))))
    ; Keyword literal (Stage 11 cleanup §2): build a NODE-KEYWORD carrying the
    ; name (colon already stripped by the lexer). Self-evaluating; the compiler
    ; lowers it to a keyword-intern call.
    (when (= (t 'kind) TOK-KEYWORD)
      (let (n:ptr:Node (as ptr:Node (alloc-node)))
        (set! (n 'kind) NODE-KEYWORD)
        (set! (n 'line) (t 'line))
        (set! (n 's) (t 's))
        (return (ok (as ptr n)))))
    (do (report-at (t 'line) "unexpected end of input")
        (return (err! parse-error)))))

; Colon-paren binding sugar (design/stage11/cleanup.md §1).
;
; The colon is an ordinary symbol char, so `name:(ref (Vector T))` lexes as the
; atom `name:` immediately followed by a separate `(ref …)` list — and nothing
; rejoins them. In list (binding) context, when a just-read symbol ends in `:`
; and the very next raw character is `(` with no intervening whitespace, fuse
; them into the canonical list node `(name <paren-form>)` — exactly the shape
; `extract-name-and-type` already accepts from the `(name type)` list form.
;
; The check is gated on `g-peek-valid == 0`: a bare symbol token is produced by
; `read-form` without lexing ahead, so after it returns `g-pos` sits exactly at
; the character following the atom. If a token had been peeked, `g-pos` would be
; past the `(` and the raw peek would be unreliable; in that case we never fuse
; (and that case never arises here, since `read-form` on a symbol does not peek).
;
; Additive: no existing source has a trailing-colon atom adjacent to `(`, so the
; bootstrap stays byte-identical. Returns the (possibly fused) child node.

; True iff `form` is a `(fn …)`-headed list — the return-type half of a function
; pointer type. Used by the colon-paren fuse below to decide whether a second,
; immediately-adjacent parenthesised group is this type's parameter list.
(defn is-fn-type-form (form:ptr):i32
  (when (= form null) (return 0))
  (let (f:(raw Node) (as raw:Node form))
    (when (!= (f 'kind) NODE-CELL) (return 0))
    (let (h:(raw Node) (as raw:Node (f 'car)))
      (when (= h null) (return 0))
      (when (!= (h 'kind) NODE-SYM) (return 0))
      (return (if (= (strcmp (h 's) "fn") 0) 1 0)))))

; W5f: a function-pointer type is TWO parenthesised groups — `(fn ret)` followed
; by the parameter list — so the single-group colon-paren fuse above cannot
; express it. `f:(fn i32)` alone fuses to `(f (fn i32))`, a *zero-parameter* fn
; type, and the parameter list that follows is left dangling as a sibling of the
; binding: silently mistyped in a defn param list, and (when it is the empty list
; `()`, which reads as a NULL node) a null member in a `(struct …)`/`(union …)`
; type expression that crashed the compiler.
;
; So: when the just-read colon-paren form is `(fn …)`-headed and the very next
; raw character is `(` with no intervening whitespace, absorb that group too and
; return the nested canonical spelling `((fn ret) (params))` — exactly what
; `parse-type-from-node`'s function-pointer branch consumes. The name/colon-chain
; wrapping then proceeds unchanged, so `acv:(fn void)()` reads as
; `(acv ((fn void) ()))` and `p:ptr:(fn i32)(i32)` as `(p (ptr ((fn i32) (i32))))`.
;
; Adjacency is required (as it is for the first group): a *space*-separated
; second group is genuinely ambiguous with the next binding in the enclosing
; list — in `(f:(fn i32) (i32 i32) a:i32)` nothing distinguishes the parameter
; list from a `(name type)` binding — so it is not absorbed.
(defn fuse-fn-params (paren-form:ptr line:i32):!ptr
  (when (= (is-fn-type-form paren-form) 0) (return (ok paren-form)))
  (when (!= g-peek-valid 0) (return (ok paren-form)))
  (when (!= (peek-char) 40) (return (ok paren-form)))
  (let (plist:ptr (try (read-form)))
    (return (ok (make-cell paren-form (make-cell plist null line) line)))))

(defn fuse-colon-paren (child:ptr line:i32):!ptr
  ; Only consider a freshly-lexed symbol/keyword with no token peeked past it.
  (when (or (= child null) (!= g-peek-valid 0)) (return (ok child)))
  (let (cn:ptr:Node (as ptr:Node child))
    (when (and (!= (cn 'kind) NODE-SYM) (!= (cn 'kind) NODE-KEYWORD)) (return (ok child)))
    (let (s:ptr (cn 's)
          len:i64 (strlen (cn 's)))
      ; Must end in ':' and the next raw stream char must be '(' (no whitespace).
      (when (or (= len 0)
                (!= (cstr-byte-at s (- len 1)) 58))
        (return (ok child)))
      (when (!= (peek-char) 40) (return (ok child)))
      ; Read the following parenthesised form once, plus (for a `(fn …)` head)
      ; the immediately-adjacent parameter-list group.
      (let (paren-form:ptr (try (fuse-fn-params (try (read-form)) line))
            body:ptr (arena-strndup s (- len 1)))
        ; CP-2a: a bare ':' (NODE-SYM, empty body) fuses to the paren form
        ; directly, so (fn (x:i32):(ref T) ...) reads as (fn (x:i32) (ref T) ...).
        (when (and (= (cn 'kind) NODE-SYM) (= len 1))
          (return (ok paren-form)))
        ; CP-1 / keyword: split body on ':' into segments. The first segment is
        ; the binding name for NODE-SYM (empty for NODE-KEYWORD, whose leading
        ; ':' the lexer already stripped); remaining segments wrap the paren
        ; form right-to-left as unary constructors.
        (let (cur:ptr body
              done:i32 0
              head:ptr null
              tail:ptr null)
          (while (= done 0)
            (let (colon:ptr (strchr cur 58))
              (let (seg-len:i64 0)
                (if (= colon null)
                  (set! seg-len (strlen cur))
                  (set! seg-len (- (unsafe/cast i64 colon) (unsafe/cast i64 cur))))
                ; An empty segment (e.g. body "a:" from atom "a::") is a reader error.
                (when (= seg-len 0)
                  (do (report-at line (fstr "empty segment in colon-chain '" s
                                            "' -- write name:k1:(Type) with no '::'"))
                      (return (err! parse-error))))
                (let (seg-node:ptr (as ptr (intern-symbol (arena-strndup cur seg-len)))
                      cell:ptr (make-cell seg-node null line))
                  (when (= tail null) (set! head cell))
                  (when (!= tail null) (set! ((as ptr:Node tail) 'cdr) cell))
                  (set! tail cell)))
              (if (= colon null)
                (set! done 1)
                (set! cur (unsafe/ptr+ (as ptr:i8 colon) 1)))))
          ; Name part: first segment for NODE-SYM, empty for NODE-KEYWORD.
          (let (name-node:ptr null
                ctor-list:ptr head)
            (when (= (cn 'kind) NODE-SYM)
              (do (set! name-node ((as ptr:Node head) 'car))
                  (set! ctor-list ((as ptr:Node head) 'cdr))))
            ; Reverse the constructor list, then fold it right-to-left around
            ; the paren form, wrapping the name last if non-empty.
            (let (rev:ptr null
                  p:ptr ctor-list
                  result:ptr paren-form
                  q:ptr null)
              (while (!= p null)
                (let (nxt:ptr ((as ptr:Node p) 'cdr))
                  (set! ((as ptr:Node p) 'cdr) rev)
                  (set! rev p)
                  (set! p nxt)))
              (set! q rev)
              (while (!= q null)
                (set! result (make-cell ((as ptr:Node q) 'car)
                                        (make-cell result null line)
                                        line))
                (set! q ((as ptr:Node q) 'cdr)))
              (when (!= name-node null)
                (set! result (make-cell name-node (make-cell result null line) line)))
              (return (ok (as ptr result))))))))))

(defn read-list (line:i32):!ptr
  (let (head:ptr null
        tail:ptr null)
    (while (!= 0 1)
      (let (t:ptr:Tok (as ptr:Tok (try (peek-tok))))
        (when (= (t 'kind) TOK-EOF)
          (do (report-unterminated line "unterminated list" ")")
              (return (err! parse-error))))
        (when (= (t 'kind) TOK-RPAREN)
          (do (try (eat-tok)) (return (ok head))))
        (let (raw:ptr (try (read-form))
              child:ptr (try (fuse-colon-paren raw line))
              cell:ptr (make-cell child null line))
          (when (= tail null) (set! head cell))
          (when (!= tail null) (set! ((as ptr:Node tail) 'cdr) cell))
          (set! tail cell))))
    (return (ok head))))

(defn read-program ():!ptr
  ; W4c: the bracket-balance trackers are scoped to one whole-file read.
  ; read-program is the single entry point for that (batch driver, import, and
  ; REPL all call it) and reads never interleave — an import's read runs only
  ; after the importing file's own read has completed — so resetting here is the
  ; complete hygiene; the import sites that save/restore g-src/g-pos/g-line need
  ; no counterpart for these.
  (set! g-paren-depth 0)
  (set! g-form-open-line 0)
  (set! g-col0-open-line 0)
  (set! g-col0-open-depth 0)
  (let (head:ptr null
        tail:ptr null)
    (while (!= 0 1)
      (let (pk:ptr:Tok (as ptr:Tok (try (peek-tok))))
        (when (= (pk 'kind) TOK-EOF) (return (ok head)))
        ; Stage 15 W4a: seed the spine cell with the line of the form's FIRST
        ; TOKEN, then prefer the form's own line when it has one. Identical for
        ; every list/literal (whose line is that same token's), but it gives a
        ; top-level *bare symbol* — an interned singleton with no line — a real
        ; location, so "top-level form must be a list..." no longer reports :0:.
        (let (start-line:i32 (pk 'line))
          (let (form:ptr (try (read-form))
                line:i32 start-line)
            (when (!= form null)
              (let (fl:i32 ((as ptr:Node form) 'line))
                (when (!= fl 0) (set! line fl))))
            (let (cell:ptr (make-cell form null line))
              (when (= tail null) (set! head cell))
              (when (!= tail null) (set! ((as ptr:Node tail) 'cdr) cell))
              (set! tail cell))))))
    (return (ok head))))

; Stage 10 E4 boundary: batch-compile driver entry. On a parse error the
; diagnostic has already been printed at the fault site (report-at), so just
; abort the build (exit 1), matching the pre-E4 die-at behavior. The REPL calls
; `read-program` directly and `match`es it so a syntax error recovers instead.
(defn read-program-or-die ():ptr
  (match (read-program)
    ((ok forms) forms)
    ((err e) (do (exit 1) (return null)))))

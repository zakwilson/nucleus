; Stage 17 D3 — `--strict-cstr`, the residual-C-string enumerator.
;
; Design: design/stage17-native-strings/migration-tooling.md §3. This file is
; deleted at C8, together with its three hook lines in nucleusc.nuc and the seam
; list it reads.
;
; Grep cannot answer "is the conversion complete". Most of the compiler's C
; strings are typed `ptr`, which is also everything else, and the calls that pass
; them are as often stamped from a template or synthesized by a macro as written
; down. This counts them where the compiler already knows the answer — at
; `emit-call-with-args`, the funnel every direct and multimethod call reaches,
; after macro expansion and after monomorphization — so the number is a fact
; about the emitted program rather than about the text.
;
; It is a report over types the compiler already computed; it must stay that
; cheap. If it ever needs dataflow of its own, the design is wrong.
;
; Depends on: compiler-types.nuc (Type, TY-FN/TY-CSTR), abi.nuc (field-at),
; strfmt.nuc (fstr, and through it String/StrView/file/allocator), and
; nucleusc.nuc's `g-source-path`/`g-cur-fname` — all in scope at the import point.

; 0 = off, 1 = report, 2 = report and fail the compile (C8).
(defvar g-strict-cstr:i32 0)
(defvar g-cstr-seams-path:ptr "scripts/stage17/cstr-seams.txt")
(defvar g-strict-cstr-hits:i64 0)

; Own arena handle, for the same reason strfmt.nuc has one: a module cannot see
; its importer's globals until the whole unit is linked, and the seam list must
; outlive every call site that consults it.
(defvar g-sc-alloc:AllocHandle (AllocHandle ALLOC-ARENA null))

(defvar g-sc-loaded:i32 0)
; The seam file's text, retained: every entry is a StrView into it.
(defvar g-sc-text:String)
(defvar g-sc-names:(raw (Vector StrView)))
(defvar g-sc-kinds:(raw (Vector i32)))

(defconst SC-SEAM 0)          ; an allowed C-interop seam
(defconst SC-SEAM-PREFIX 1)   ; …and everything whose name starts with this
(defconst SC-STRPTR 2)        ; a `ptr`-as-string producer the types cannot see
; A libc string function. Named rather than typed because the C-header importer
; lowers `char *` to bare `ptr`: `declare i32 @strcmp(ptr, ptr)` carries no CStr
; for the signature walk to find, so nothing but a name would report the 150
; `strcmp`s C6 deletes.
(defconst SC-CFN 3)

(defn sc-space (b:ui8):i32
  (let (c:i32 (as i32 b))
    (when (or (= c 32) (= c 9)) (return 1))
    (when (= c 13) (return 1))
    (return 0)))

(defn sc-add (kind:i32 nm:StrView):void
  (conj (unsafe/cast (ref (Vector StrView)) g-sc-names) nm)
  (conj (unsafe/cast (ref (Vector i32)) g-sc-kinds) kind))

; One `<keyword> <name>` line, or a `#` comment, or blank.
(defn sc-parse-line ((d (ptr ui8)) lo:usize hi:usize):void
  (let (a:usize lo)
    (while (and (< a hi) (!= (sc-space (aref d (as i64 a))) 0)) (set! a (+ a 1)))
    (when (>= a hi) (return))
    (when (= (as i32 (aref d (as i64 a))) 35) (return))
    (let (b:usize a)
      (while (and (< b hi) (= (sc-space (aref d (as i64 b))) 0)) (set! b (+ b 1)))
      (let (kw:StrView (strview (unsafe/ptr+ d (as i64 a)) (- b a))
            c:usize b)
        (while (and (< c hi) (!= (sc-space (aref d (as i64 c))) 0)) (set! c (+ c 1)))
        (let (e:usize c)
          (while (and (< e hi) (= (sc-space (aref d (as i64 e))) 0)) (set! e (+ e 1)))
          (when (<= e c) (return))
          (let (nm:StrView (strview (unsafe/ptr+ d (as i64 c)) (- e c)))
            (when (= kw "seam") (sc-add SC-SEAM nm) (return))
            (when (= kw "seam-prefix") (sc-add SC-SEAM-PREFIX nm) (return))
            (when (= kw "strptr") (sc-add SC-STRPTR nm) (return))
            (when (= kw "cfn") (sc-add SC-CFN nm) (return))
            (eprint "strict-cstr: unknown seam-list keyword\n")))))))

(defn sc-parse ((s (ref String))):void
  (let (v:StrView (string-as-view s)
        d:(ptr ui8) (v 'data)
        n:usize (v 'len)
        i:usize 0)
    (while (< i n)
      (let (j:usize i)
        (while (and (< j n) (!= (as i32 (aref d (as i64 j))) 10)) (set! j (+ j 1)))
        (sc-parse-line d i j)
        (set! i (+ j 1))))))

; A missing seam list is not fatal: with no seams every C-string call site is
; reported, which is the honest reading of "nothing is declared interop yet".
(defn sc-load ():void
  (when (!= g-sc-loaded 0) (return))
  (set! g-sc-loaded 1)
  (set! g-sc-names (unsafe/cast (raw (Vector StrView)) (vector-new-in (addr-of g-sc-alloc))))
  (set! g-sc-kinds (unsafe/cast (raw (Vector i32)) (vector-new-in (addr-of g-sc-alloc))))
  (let (pv:StrView (strview-from-cstr (as CStr g-cstr-seams-path)))
    (match (file-open-read pv)
      ((err e)
        (eprint "strict-cstr: cannot open seam list '" g-cstr-seams-path
                "' -- reporting every C-string site\n"))
      ((ok f)
        (let ((fh File) f)
          (match (file-read-to-string fh)
            ((err e2)
              (do (file-close fh)
                  (eprint "strict-cstr: cannot read seam list '" g-cstr-seams-path "'\n")))
            ((ok text)
              (do (set! g-sc-text text)
                  (file-close fh)
                  (sc-parse (addr-of g-sc-text))))))))))

; The listed kind (a prefix match answers SC-SEAM), or -1 for "not listed".
(defn sc-classify (nv:StrView):i32
  (let (v:(ref (Vector StrView)) (unsafe/cast (ref (Vector StrView)) g-sc-names)
        k:(ref (Vector i32)) (unsafe/cast (ref (Vector i32)) g-sc-kinds)
        n:usize (count v)
        i:usize 0
        res:i32 -1)
    (while (< i n)
      (let (e:StrView (invoke v i)
            kd:i32 (invoke k i))
        (when (= kd SC-SEAM-PREFIX)
          (when (strview-starts-with &nv &e) (set! res SC-SEAM) (set! i n)))
        (when (!= kd SC-SEAM-PREFIX)
          (when (= nv e) (set! res kd) (set! i n))))
      (set! i (+ i 1)))
    (return res)))

(defn sc-report (line:i32 msg:StrView):void
  (set! g-strict-cstr-hits (+ g-strict-cstr-hits 1))
  (let (fnm:ptr "<toplevel>")
    (when (!= g-cur-fname null) (set! fnm g-cur-fname))
    (eprint g-source-path ":" line ": strict-cstr: " msg " [in " fnm "]\n")))

; Walk a TY-FN signature and report every CStr in it. `what` names the callee
; for the report and has already been cleared against the seam list.
(defn sc-check-sig ((ft (raw Type)) what:StrView line:i32):void
  (when (= ft null) (return))
  (when (!= (ft 'kind) TY-FN) (return))
  (let (r:(raw Type) (ft 'ret))
    (when (!= r null)
      (when (= (r 'kind) TY-CSTR)
        (sc-report line (fstr "CStr returned by " what)))))
  (let (np:i32 (ft 'num-params)
        i:i32 0)
    (while (< i np)
      (let (pt:(raw Type) ((field-at (ft 'params) i) 'type))
        (when (!= pt null)
          (when (= (pt 'kind) TY-CSTR)
            (sc-report line (fstr "CStr argument " (+ i 1) " to " what)))))
      (set! i (+ i 1)))))

; The hook on the named-call funnel. `ft` is the callee's TY-FN type as
; `emit-call-with-args` has it.
(defn strict-cstr-check-call (name:Symbol (ft (raw Type)) line:i32):void
  (when (= g-strict-cstr 0) (return))
  (when (symbol-none? name) (return))
  (sc-load)
  (let (nv:StrView (symbol-as-view name)
        cls:i32 (sc-classify nv))
    (when (= cls SC-SEAM) (return))
    (when (= cls SC-STRPTR)
      (sc-report line (fstr "ptr-as-string returned by '" name "'"))
      (return))
    (when (= cls SC-CFN)
      (sc-report line (fstr "C string function '" name "'"))
      (return))
    (sc-check-sig ft (fstr "'" name "'") line)))

; A libc string call the compiler writes into the IR as text, so it never
; reaches the call funnel. Counted under the same `cfn` entry as a written one —
; it is the same site to C6, and it is the class no source sweep finds.
(defn strict-cstr-check-synth (name:StrView line:i32):void
  (when (= g-strict-cstr 0) (return))
  (sc-load)
  (when (= (sc-classify name) SC-SEAM) (return))
  (sc-report line (fstr "C string function '" name "' (compiler-synthesized)")))

; A materialized `StrView` coerced to `ptr`/`CStr` by taking its `data` field.
; The one residual class no *type* marks: the borrow is accepted silently, and
; the borrowed pointer is only a valid C string if the view's buffer happens to
; be NUL-terminated at `data[len]` — true of a literal, false of anything `fstr`
; built. So every hit is either a seam to declare or a consumer left to convert.
(defn strict-cstr-check-borrow (line:i32):void
  (when (= g-strict-cstr 0) (return))
  (sc-load)
  (sc-report line "StrView borrowed as a C string (its .data may not be NUL-terminated)"))

; A call through a function pointer or a BoxedFn. No name, so the seam list
; cannot exempt one — which is the intent: by C8 there must be no CStr-typed
; indirect call left, and this is the only thing that would notice one.
(defn strict-cstr-check-indirect ((ft (raw Type)) line:i32):void
  (when (= g-strict-cstr 0) (return))
  (sc-load)
  (sc-check-sig ft "a function pointer" line))

; The process exit code, so `--strict-cstr=error` is a gate and not a wish.
(defn strict-cstr-exit-code ():i32
  (when (= g-strict-cstr 0) (return 0))
  (eprint "strict-cstr: " g-strict-cstr-hits " residual C-string site(s)\n")
  (when (= g-strict-cstr 2)
    (when (> g-strict-cstr-hits 0) (return 3)))
  (return 0))

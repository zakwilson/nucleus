; Type model and pointer-kind helpers, source-imported by src/nucleusc.nuc.
; Extracted from nucleusc.nuc (Stage 12 N8). Depends on: compiler-types.nuc
; (Type/StructDef structs, TY-*/PTR-* constants), the type singletons and
; g-target-ptr-bytes/g-host-ptr-bytes globals, alloc-type, fmt-s, and die-at —
; all already in scope at the import point in nucleusc.nuc.

; ============================================================
; Types
; ============================================================

(defn make-type (k:i32):ref:Type
  (let (t:ref:Type (alloc-type))
    (set! (t 'kind) k)
    (return t)))

; Stage 15 W8 G-5: the three pointer-kind singletons are the only `ty-*` that
; were construct-then-mutate rather than construct, so they are the one
; value-returning builder §4.4 item 1 asks for. `types-init` is gone — each
; `ty-X` is now its own `(defvar ty-X:ref:Type (make-type TY-X))` in
; nucleusc.nuc, which is what lets the singletons keep their non-null `ref:Type`
; declaration honestly.
(defn make-ptr-type (pk:i32):ref:Type
  (let (t:ref:Type (make-type TY-PTR))
    (set! (t 'pkind) pk)
    (return t)))

; ============================================================
; Stage 15 W3a: opaque (forward-declared) C types
; (design/stage15-stress-test/cheader.md §1.6)
;
; A C header's `struct Foo;` / `typedef struct Foo Foo;` names a type whose
; layout the translation unit never sees — the standard opaque-handle idiom
; (SDL_Window, Mix_Music, FILE). The registry entry carries the name so
; `ptr:Foo` resolves, and `StructDef.opaque` records that its size/alignment/
; fields are unknown. Everything that needs a layout must refuse it *at the
; source*, with the header location the declaration came from, rather than
; emitting `%Foo` and letting the LLVM parser fail thousands of lines later —
; and never silently substituting a zero or pointer-sized "size", which would
; miscompile an allocation.
;
; These live here (not abi.nuc beside register-struct) because `type-to-ir` — the
; single funnel through which a struct type reaches an IR stream as an aggregate
; — is in this file, and a call from here up into abi.nuc would be an unresolved
; forward reference across the import boundary (the same wall SM-5 documents).
; ============================================================

; The opaque StructDef behind `t`, or null. Only a by-value struct/union type
; qualifies: a POINTER to an opaque type is exactly what is legal, and its own
; kind is TY-PTR, so it never matches here.
(defn opaque-sdef-of (t:raw:Type):(raw StructDef)
  (when (= t null) (return null))
  (let (tt:raw:Type t)
    (when (and (!= (tt 'kind) TY-STRUCT) (!= (tt 'kind) TY-UNION)) (return null))
    (when (= (tt 'sdef) null) (return null))
    (let (sd:(raw StructDef) (tt 'sdef))
      (when (= (sd 'opaque) 0) (return null))
      (return sd))))

; Reject a by-value use of an opaque type. `what` names the construct doing the
; use ("sizeof", "alloca", "field access", "defn parameter", …) so the message
; says which rule was broken as well as which type broke it. No-op for every
; non-opaque type, so this is free to call from any type-consuming site.
(defn reject-opaque-type (t:raw:Type line:i32 what:CStr):void
  (let (sd:(raw StructDef) (opaque-sdef-of t))
    (when (!= sd null)
      (let (loc:ptr (fstr (sd 'src-file) ":" (sd 'src-line)))
        (die-at line
          (fstr what ": '" (sd 'name) "' is an opaque type declared at " loc
                "; only pointers to it are valid"))))))

; ============================================================
; Stage 15 W3c: the C typedef table (stage15-stress-test/cheader.md §1.4)
;
; Before this, `c-parse-type` resolved every name it did not recognize as a
; builtin to `ptr`, so EVERY scalar typedef degraded — `off_t f(int)` imported as
; `declare ptr @f(i32)`, and so did SDL's `Uint8`/`Uint32` and even a one-level
; `typedef int myint;`. Only `size_t`/`ssize_t` resolved, and only because
; c-type-to-nucleus hardcodes those two names.
;
; A typedef is resolved ONCE, at the point its `typedef` declaration is parsed,
; and the table stores the *resolved* Type. Two consequences are worth keeping:
;
;   * A chain (`off_t` → `__off_t` → `long int`) costs one lookup at each use,
;     not a walk — the intermediate entry was already collapsed.
;   * A cycle is impossible by construction. A name can only ever resolve against
;     entries recorded strictly before it, so a malformed `typedef foo foo;`
;     records `foo` as unrepresentable instead of looping forever.
;
; A record whose `ty` is null means "this is a real C type name and we cannot
; represent it" (a typedef of an unparsable aggregate, a `long double`). That is
; deliberately distinct from an *absent* record: a by-value use of either is
; refused, but the messages differ, and only the recorded form proves the name
; was declared rather than merely unknown.
;
; The table lives here rather than in `src/cheader.nuc` (where it was written)
; because Stage 16 L5 made a C typedef a Nucleus type name: `parse-type-name`
; and `type-name-collision` (src/union-registry.nuc) and `unknown-type-message`
; (src/nucleusc.nuc) all read it, and all three are processed before
; `(import-use cheader)` — the cross-import wall the W3a block above records.
; ============================================================
(defstruct CTypedef
  ; `name`/`file` are `ptr`, not `CStr`, for the reason CDeclSite records: they
  ; are compared and null-checked as identities, and a `CStr` operand lowers
  ; `=`/`!=` to `strcmp`.
  name:ptr
  ; The resolved type, or null = "known C type name, no Nucleus representation".
  (ty (raw Type))
  ; Where the typedef was declared, for the L5 diagnostics.
  file:ptr
  line:i32
  ; Stage 16: the header spelling the SOURCE imported to reach it — `"stdio.h"`,
  ; not the `/usr/include/…` file a linemarker names. `--emit-cheader` writes an
  ; `#include` of it, and only the imported spelling is portable.
  hdr:ptr
  ; 1 = written by the signature prescan, which resolves types with every C
  ; struct still opaque. A real import overwrites it; see c-typedef-record.
  provisional:i32
  (next (raw CTypedef)))

(defvar (g-cheader-typedefs (raw CTypedef)))
; Armed for the duration of `cheader-prescan-opaque` (src/cheader.nuc). A global
; rather than a parameter because the prescan reaches c-typedef-record through
; the whole real declaration parser, which has no business knowing which pass it
; is running in.
(defvar g-cheader-typedef-provisional:i32 0)
; The `(import-use "…")` spelling currently being read, for `CTypedef.hdr`. Set
; at the top of emit-c-include / cheader-prescan-opaque and, unlike
; g-cheader-file, never rewritten by a linemarker: a typedef reached through
; <stdio.h> is spelled `#include <stdio.h>` by a consumer whatever glibc header
; it physically lives in. Lives here for the same cross-import reason as the
; table itself.
(defvar g-cheader-import-header:ptr)

(defn c-typedef-find (name:CStr):?ptr:CTypedef
  (let (cur:ptr g-cheader-typedefs)
    (while (!= cur null)
      (let (e:ptr:CTypedef (as ptr:CTypedef cur))
        (when (= (as CStr (e 'name)) name) (return e))
        (set! cur (e 'next)))))
  (return null))

; Record `name` as resolving to `ty` (null = known but not representable).
; Idempotent: a header imported twice, or included transitively by two headers,
; re-declares the same typedef and must not grow the table without bound.
;
; With one exception: a PROVISIONAL record — one the L5 signature prescan made —
; is overwritten by the real import. The prescan resolves a typedef with every C
; struct still opaque, so `typedef __sigset_t sigset_t;` is unrepresentable there
; and representable at the import; first-wins would freeze the prescan's verdict
; and silently skip every declaration using it. Provisional never overwrites.
(defn c-typedef-record (name:ptr ty:ptr file:ptr line:i32):void
  (if-some (prev (c-typedef-find name:CStr))
    (do
      (when (or (= (prev 'provisional) 0) (!= g-cheader-typedef-provisional 0))
        (return))
      (set! (prev 'ty) (as raw:Type ty))
      (set! (prev 'file) file)
      (set! (prev 'line) line)
      (set! (prev 'hdr) g-cheader-import-header)
      (set! (prev 'provisional) 0)
      (return))
    0)
  (let (e:ptr:CTypedef (new CTypedef))
    (set! (e 'name) (intern-str name))
    (set! (e 'ty) (as raw:Type ty))
    (set! (e 'file) file)
    (set! (e 'line) line)
    (set! (e 'hdr) g-cheader-import-header)
    (set! (e 'provisional) g-cheader-typedef-provisional)
    (set! (e 'next) g-cheader-typedefs)
    (set! g-cheader-typedefs (as raw:CTypedef e))))

; ---- Stage 15 W1d: a layout that has not been emitted yet ------------------
; W1d makes a circular `(import)` legal — `do-import` skips the re-entry rather
; than erroring — but a cycle member's body is emitted BEFORE the rest of the
; file it back-imports, so any `defstruct`/`defunion` after that import has not
; run yet. Signatures survive (W1a registers them graph-wide before emission),
; and so do `sizeof`/`alloca`: both lower to a GEP/alloca over the LLVM *named*
; type, which LLVM resolves from the `%Name = type {…}` line emitted later in
; the same module. The compiler's own field table and `abi-sizeof` do not — they
; are populated by emit-defstruct — so a by-value use across the cycle silently
; classifies a 0-byte aggregate and emits `i0`, which the LLVM parser rejects
; with no source location at all, and a field access reports "no field 'x'" for
; a struct that does have that field.
;
; `laid-out` is the question, and it is asked directly since Stage 15 W9 item 40
; gave it its own bit: before that this read `emitted == 0 && num-fields == 0`,
; an approximation of "has a layout" that was exact only while emission was the
; one thing that produced one, and that misdiagnosed a legitimate
; `(defstruct Empty)`. `opaque` belongs to the C-forward-declaration machinery
; above and is left to it. The `g-import-cycles` gate makes the whole check dead
; code for any unit without a skipped cycle — i.e. for every program that
; compiled before W1d, since a cycle was a hard error.
(defn sdef-layout-pending (sd:(raw StructDef)):i32
  (when (= g-import-cycles null) (return 0))
  (when (= sd null) (return 0))
  (when (!= (sd 'opaque) 0) (return 0))
  (when (!= (sd 'laid-out) 0) (return 0))
  (return 1))

; ---- Stage 16 R4: which buffer holds a type's `%Name = type {…}` line -------
; `emitted` says one was written; these say where. A latch is a claim about a
; buffer and is only correct if it names one — the REPL assembles many modules
; per process (design/stage16-ergonomics/repl-libraries.md §3.3).

; Is `sd`'s definition present in the module currently being assembled? Outside
; the REPL there is one epoch and no preamble, so this is exactly `emitted`.
(defn sdef-in-module (sd:(raw StructDef)):i32
  (when (= sd null) (return 0))
  (when (!= (sd 'in-preamble) 0) (return 1))
  (when (= (sd 'emit-epoch) g-module-epoch) (return 1))
  (return 0))

; Record that `sd`'s definition line was just written into `out`.
(defn sdef-note-emitted (sd:(raw StructDef) out:ptr):void
  (set! (sd 'emitted) 1)
  (set! (sd 'emit-epoch) g-module-epoch)
  ; Only the type buffer is carried into the REPL preamble at module close; a
  ; line in a def or compile-time buffer dies with its module.
  (set! (sd 'in-type-buf) (if (= out g-type-stream) 1 0)))

(defn cycle-pending-sdef (t:raw:Type):(raw StructDef)
  (when (= g-import-cycles null) (return null))
  (when (= t null) (return null))
  (let (tt:raw:Type t)
    (when (and (!= (tt 'kind) TY-STRUCT) (!= (tt 'kind) TY-UNION)) (return null))
    (when (= (tt 'sdef) null) (return null))
    (let (sd:(raw StructDef) (tt 'sdef))
      (when (= (sdef-layout-pending sd) 0) (return null))
      (return sd))))

; Reject a by-value use of a type whose layout the cycle has not produced yet.
; Mirrors reject-opaque-type exactly — same `what` vocabulary, same no-op-for-
; everything-else contract — so the two can sit side by side at each site.
(defn reject-cycle-pending-layout (t:raw:Type line:i32 what:CStr):void
  (let (sd:(raw StructDef) (cycle-pending-sdef t))
    (when (!= sd null)
      (die-at line (cycle-layout-message (sd 'name) what)))))

; The same rejection where the caller already holds the StructDef (field access
; and struct-literal sites, which resolve the struct before they resolve a type).
(defn reject-cycle-pending-sdef (sd:(raw StructDef) line:i32 what:CStr):void
  (when (!= (sdef-layout-pending sd) 0)
    (die-at line (cycle-layout-message (sd 'name) what))))

(defn type-to-ir (t:raw:Type):CStr
  ; W3a backstop: an opaque type has no LLVM definition, so printing `%Foo` here
  ; would produce IR the LLVM parser rejects with no source location at all.
  ; Every site that can reasonably name a by-value opaque type checks first with
  ; its own node's line (emit-sizeof / emit-alloca-form / field access / defn
  ; params + return / defstruct fields); this catches the remainder — a `let`
  ; binding, a store, a .nuch declare — using the ambient innermost-form line.
  (reject-opaque-type t g-form-line "type")
  (let (tt:raw:Type t)
    (case (tt 'kind)
      TY-VOID   (return "void")
      ; bool still lowers to i1: the Stage 16 divorce is source-level, so no
      ; emitted IR, ABI or generated header moves.
      TY-BOOL   (return "i1")
      TY-I8     (return "i8")
      TY-I16    (return "i16")
      TY-I32    (return "i32")
      TY-I64    (return "i64")
      TY-UI8    (return "i8")
      TY-UI16   (return "i16")
      TY-UI32   (return "i32")
      TY-UI64   (return "i64")
      (:or TY-PTR TY-FN TY-CSTR) (return "ptr")
      ; Char lowers to i32 (same width as ui32); distinct only at the type level.
      (:or TY-CHAR TY-ERR)       (return "i32")
      TY-F32    (return "float")
      TY-F64    (return "double")
      ; Stage 16 FL-1: the remaining C float widths. `f80` is x86's 80-bit
      ; extended format, which LLVM spells x86_fp80 and stores in 16 bytes on
      ; x86-64 (12 on i386) — the size is target-keyed, the IR name is not.
      TY-F16    (return "half")
      TY-F80    (return "x86_fp80")
      TY-F128   (return "fp128")
      (:or TY-USIZE TY-SSIZE)    (return (ptr-int-ir))
      (:or TY-STRUCT TY-UNION)   (return (fstr "%" ((tt 'sdef) 'ir-name)))
      ; Stage 15 W8 G-2: `[N x T]`. Two-step format because the widest helper
      ; taking (int, string) in that order does not exist — fmt-sd is (string,
      ; int). Composing two fixed-arity calls is the documented alternative to
      ; adding a helper shape (context/conventions.md, format-helper arity).
      TY-ARRAY  (do
                  ; A zero length is the PROVISIONAL marker the prescan leaves
                  ; behind (g-array-ok mode 2, src/nucleusc.nuc); the parser
                  ; refuses a real `(array T 0)`. Reaching IR with one would mean
                  ; a prescan type escaped into codegen — fail loudly instead of
                  ; emitting a plausible `[0 x i32]` (legal LLVM: a flexible
                  ; array member).
                  (when (= (tt 'arr-len) 0)
                    (die-at g-form-line "internal: a provisional (prescan) array type reached code generation"))
                  ; C1a: -1 is C99's flexible array member, which HAS no extent
                  ; — `[0 x T]`, distinct from the 0 above.
                  (when (< (tt 'arr-len) 0)
                    (return (fstr "[0 x " (type-to-ir (tt 'elem)) "]")))
                  (return (fstr "[" (fstr (tt 'arr-len)) " x " (type-to-ir (tt 'elem))
                                "]")))
      (return "?"))))

; ============================================================
; Stage 15 W8 G-2 — fixed-size arrays (design/global-init.md §5)
; ============================================================

; Build the `(array T N)` type. The single constructor, so `arr-len` can never
; be left at 0 by a caller that forgot it.
(defn array-type (elem:(raw Type) n:i32):ref:Type
  (let (t:ref:Type (make-type TY-ARRAY))
    (set! (t 'elem) elem)
    (set! (t 'arr-len) n)
    (return t)))

; THE decay rule, in one function that both codegen and the non-emitting type
; pass CALL (never mirror — conventions.md's node-type<->emit-node lockstep).
;
; An array is a *storage* type: it exists in a `defvar` slot and in a
; `defstruct` field, and nowhere else. Read in any value position it yields the
; ADDRESS of element 0, typed `(ref T)` — C's array-to-pointer decay. `(ref …)`
; and not `(raw …)` because the address of a global or of a field inside a live
; struct is never null, which is what lets `(defvar g:ptr:T (array T …))` (§2.7's
; `@g = global ptr @g.data`) satisfy the Phase-F non-null contract with no
; runtime code.
;
; Identity for every other kind, so callers can apply it unconditionally.
(defn array-decay (t:(raw Type)):(raw Type)
  (when (= t null) (return t))
  (let (tt:(raw Type) t)
    (when (!= (tt 'kind) TY-ARRAY) (return t))
    (let (pt:ref:Type (make-type TY-PTR))
      (set! (pt 'elem) (tt 'elem))
      (set! (pt 'pkind) PTR-REF)
      (return (as raw:Type pt)))))

; The zero-value constant text for a global initializer slot of type `ty`.
; Three buckets, exactly as context/conventions.md's TY-PTR-vs-is-ptr-like note
; sets out: pointers of any flavour (`null`), aggregates (`zeroinitializer`),
; and scalars (`0` / `0.0` / `false`). Shared by emit-defvar's no-init default
; and the G-2 constant-aggregate renderer's unspecified slots, so a zeroed
; `defvar` and a zeroed array element can never disagree.
; Stage 16 FL-2 (design/stage16-ergonomics/c-boundary-defects.md §6.2): LLVM
; refuses a decimal constant at x86_fp80 and fp128 outright, so the compiler has
; to render the bits — the f32-const-ir problem one width up, and the reason the
; wide float types looked like a bootstrap blocker. They are not: f64→f80 and
; f64→f128 are EXACT widenings, so this is integer arithmetic on the f64 pattern
; and the compiler never performs f80 arithmetic to compile an f80 program.
;
; A decimal literal is therefore exact to f64's 53 bits and no further; see
; design/future/decimal-float-literals.md for what closes that, and FL-3's
; hex-float syntax for the bit-exact spelling in the meantime.
(defn f64-bits (d:f64):i64
  (let (r:f64 d
        p:ptr:f64 (addr-of r))
    (return (deref (unsafe/cast ptr:i64 p)))))

; `0xK` is 4 hex digits of sign|exponent followed by 16 of the significand —
; which, unlike `0xL` below, is high half first.
(defn f80-const-ir (d:f64):CStr
  (let (bits:i64 (f64-bits d)
        sign:i64 (unsafe/cast i64 (bit-shr (unsafe/cast ui64 bits) 63))
        exp:i64 (bit-and (bit-shr bits 52) 2047)
        mant:i64 (bit-and bits 4503599627370495)
        se:i64 0
        sig:i64 0)
    (cond
      (= exp 2047)
        ; inf / NaN: the explicit integer bit is set in both, and a NaN keeps
        ; its payload plus the quiet bit x86 requires.
        (do (set! se 32767)
            (set! sig (bit-or (bit-shl (as i64 1) 63) (bit-shl mant 11))))
      (= exp 0)
        (if (= mant 0)
          (do (set! se 0) (set! sig 0))
          ; An f64 subnormal is a NORMAL f80 — the exponent range is far wider —
          ; so normalize rather than truncate.
          (let (m:i64 mant
                e:i64 (- 1 1023))
            (while (= (bit-and m 4503599627370496) 0)
              (set! m (bit-shl m 1))
              (set! e (- e 1)))
            (set! se (+ e 16383))
            (set! sig (bit-shl m 11))))
      true
        (do (set! se (+ (- exp 1023) 16383))
            (set! sig (bit-or (bit-shl (as i64 1) 63) (bit-shl mant 11)))))
    (return (as CStr (fstr "0xK" (fstr (hexu (bit-or (bit-shl sign 15) se) 4))
                           (fstr (hexu sig 16)))))))

; `0xL` is the LOW 64 bits first, then the high 64 — the opposite order from
; `0xK`. An f64 widens exactly: rebias the exponent and shift the significand
; from 52 bits to 112, which leaves the low half all zero for every finite f64.
(defn f128-const-ir (d:f64):CStr
  (let (bits:i64 (f64-bits d)
        sign:i64 (unsafe/cast i64 (bit-shr (unsafe/cast ui64 bits) 63))
        exp:i64 (bit-and (bit-shr bits 52) 2047)
        mant:i64 (bit-and bits 4503599627370495)
        e128:i64 0
        hi-mant:i64 0
        lo:i64 0)
    (cond
      (= exp 2047)
        (do (set! e128 32767)
            ; Keep the payload so a signalling NaN stays one; bit 111 of the
            ; f128 significand is bit 51 of the f64's, which the shift carries.
            (set! hi-mant (bit-shr mant 4))
            (set! lo (bit-shl mant 60)))
      (= exp 0)
        (if (= mant 0)
          (do (set! e128 0) (set! hi-mant 0) (set! lo 0))
          (let (m:i64 mant
                e:i64 (- 1 1023))
            (while (= (bit-and m 4503599627370496) 0)
              (set! m (bit-shl m 1))
              (set! e (- e 1)))
            ; Drop the now-explicit leading bit: fp128's is implicit.
            (set! m (bit-and m 4503599627370495))
            (set! e128 (+ e 16383))
            (set! hi-mant (bit-shr m 4))
            (set! lo (bit-shl m 60))))
      true
        (do (set! e128 (+ (- exp 1023) 16383))
            (set! hi-mant (bit-shr mant 4))
            (set! lo (bit-shl mant 60))))
    (return (as CStr (fstr "0xL" (fstr (hexu lo 16))
                           (fstr (hexu (bit-or (bit-shl sign 63) (bit-or (bit-shl e128 48) hi-mant)) 16)))))))

; f64→f16 is a NARROWING, so unlike the two above it rounds — round-to-nearest,
; ties-to-even, written out rather than delegated to a host cast because Nucleus
; has no f16 to cast through. `0xH` is the 16 bits, zero-extended.
(defn f16-const-ir (d:f64):CStr
  (let (bits:i64 (f64-bits d)
        sign:i64 (unsafe/cast i64 (bit-shr (unsafe/cast ui64 bits) 63))
        exp:i64 (bit-and (bit-shr bits 52) 2047)
        mant:i64 (bit-and bits 4503599627370495)
        out:i64 0)
    (cond
      (= exp 2047)
        ; A NaN must stay a NaN: a payload whose low bits are all that survive
        ; the shift would round to infinity.
        (if (= mant 0) (set! out 31744) (set! out 32256))
      (= exp 0)
        (set! out 0)                       ; an f64 subnormal underflows to ±0
      true
        (let (e:i64 (- exp 1023))
          (cond
            (> e 15)
              (set! out 31744)             ; overflow to inf, as C does
            (>= e (- 14))
              ; Normal: 10 stored significand bits, so 42 are dropped.
              (let (m:i64 (bit-shr mant 42)
                    rest:i64 (bit-and mant 4398046511103)
                    half:i64 2199023255552
                    ee:i64 (+ e 15))
                (when (or (> rest half) (and (= rest half) (!= (bit-and m 1) 0)))
                  (set! m (+ m 1))
                  (when (= m 1024) (set! m 0) (set! ee (+ ee 1))))
                (if (> ee 30)
                  (set! out 31744)
                  (set! out (bit-or (bit-shl ee 10) m))))
            (>= e (- 25))
              ; Subnormal: the implicit 1 becomes explicit and the whole
              ; significand shifts right by how far below the minimum it is.
              (let (full:i64 (bit-or 4503599627370496 mant)
                    sh:i64 (+ 42 (- (- 14) e))
                    m:i64 (bit-shr full sh)
                    rest:i64 (bit-and full (- (bit-shl 1 sh) 1))
                    half:i64 (bit-shl 1 (- sh 1)))
                (when (or (> rest half) (and (= rest half) (!= (bit-and m 1) 0)))
                  (set! m (+ m 1)))
                (set! out m))
            true
              (set! out 0))))
    (return (as CStr (fstr "0xH" (hexu (bit-or (bit-shl sign 15) out) 4))))))

; ---------------------------------------------------------------------------
; Stage 16 FL-3 (design/stage16-ergonomics/c-boundary-defects.md §6.3): C's
; hex-float literals. The significand travels as a 128-bit integer rather than
; through the host f64, because at f80 and f128 a round trip through 53 bits
; would discard exactly what this spelling exists to express.
; ---------------------------------------------------------------------------

; `bit-shr` on a signed i64 is arithmetic, and LLVM's shifts are poison at a
; count of 64 or more; these three are the unsigned, total forms.
(defn u64-shr (x:i64 n:i64):i64
  (when (>= n 64) (return 0))
  (when (<= n 0) (return x))
  (return (unsafe/cast i64 (bit-shr (unsafe/cast ui64 x) (unsafe/cast ui64 n)))))

(defn u64-shl (x:i64 n:i64):i64
  (when (>= n 64) (return 0))
  (when (<= n 0) (return x))
  (return (bit-shl x n)))

(defn u64-mask (n:i64):i64
  (when (>= n 64) (return -1))
  (when (<= n 0) (return 0))
  (return (- (bit-shl (as i64 1) n) 1)))

(defn u128-bit (hi:i64 lo:i64 n:i64):i64
  (when (>= n 64) (return (bit-and (u64-shr hi (- n 64)) 1)))
  (return (bit-and (u64-shr lo n) 1)))

(defn u128-low-any (hi:i64 lo:i64 n:i64):i64
  (when (<= n 0) (return 0))
  (when (<= n 64)
    (if (!= (bit-and lo (u64-mask n)) 0) (return 1) (return 0)))
  (when (!= lo 0) (return 1))
  (if (!= (bit-and hi (u64-mask (- n 64))) 0) (return 1) (return 0)))

(defn u128-set-bit (n:i64 out-hi:ptr:i64 out-lo:ptr:i64):void
  (set! (aref out-hi 0) 0)
  (set! (aref out-lo 0) 0)
  (if (>= n 64)
    (set! (aref out-hi 0) (bit-shl (as i64 1) (- n 64)))
    (set! (aref out-lo 0) (bit-shl (as i64 1) n))))

; A C hex-float lexeme -> sign, the significand normalized so bit 127 is set
; (both limbs zero for a zero), the unbiased exponent OF THAT BIT, and whether
; a nonzero digit fell off the low end. Returns 0 when `lex` is not one.
(defn hexfloat-parse (lex:CStr out-sign:ptr:i64 out-hi:ptr:i64 out-lo:ptr:i64
                      out-exp:ptr:i64 out-sticky:ptr:i64):i32
  (let (len:i64 (strlen lex)
        i:i64 0
        sign:i64 0)
    (when (< len 3) (return 0))
    (when (= (cstr-byte-at lex 0) 43) (set! i 1))
    (when (= (cstr-byte-at lex 0) 45) (do (set! sign 1) (set! i 1)))
    (when (> (+ i 3) len) (return 0))
    (when (!= (cstr-byte-at lex i) 48) (return 0))
    (when (and (!= (cstr-byte-at lex (+ i 1)) 120) (!= (cstr-byte-at lex (+ i 1)) 88))
      (return 0))
    (set! i (+ i 2))
    (let (hi:i64 0
          lo:i64 0
          drop:i64 0
          frac:i64 0
          sticky:i64 0
          seen-dot:i32 0
          any:i32 0
          done:i32 0)
      ; The digits form one integer M; the value is M * 16^(drop-frac) * 2^p.
      ; Once the accumulator is full the remaining digits only move the
      ; exponent, and whether any of them was nonzero is the sticky bit.
      (while (and (= done 0) (< i len))
        (let (c:i32 (cstr-byte-at lex i))
          (cond
            (= c 46)
              (if (!= seen-dot 0)
                (set! done 1)
                (do (set! seen-dot 1) (set! i (+ i 1))))
            true
              (let (v:i32 (hex-digit-val c))
                (if (< v 0)
                  (set! done 1)
                  (do (set! any 1)
                      (when (!= seen-dot 0) (set! frac (+ frac 1)))
                      (if (= (u64-shr hi 60) 0)
                        (do (set! hi (bit-or (bit-shl hi 4) (u64-shr lo 60)))
                            (set! lo (bit-or (bit-shl lo 4) (as i64 v))))
                        (do (set! drop (+ drop 1))
                            (when (!= v 0) (set! sticky 1))))
                      (set! i (+ i 1))))))))
      (when (= any 0) (return 0))
      ; C makes the binary exponent mandatory, which is also what keeps a hex
      ; float distinguishable from a hex integer at the lexer.
      (when (>= i len) (return 0))
      (when (and (!= (cstr-byte-at lex i) 112) (!= (cstr-byte-at lex i) 80)) (return 0))
      (set! i (+ i 1))
      (let (esign:i64 1
            pexp:i64 0
            edig:i32 0)
        (when (and (< i len) (= (cstr-byte-at lex i) 43)) (set! i (+ i 1)))
        (when (and (< i len) (= (cstr-byte-at lex i) 45))
          (do (set! esign -1) (set! i (+ i 1))))
        (while (and (< i len) (!= (isdigit (cstr-byte-at lex i)) 0))
          (set! pexp (+ (* pexp 10) (- (as i64 (cstr-byte-at lex i)) 48)))
          ; Clamp rather than overflow: past this every format saturates to
          ; infinity or zero anyway.
          (when (> pexp 1000000) (set! pexp 1000000))
          (set! i (+ i 1))
          (set! edig 1))
        (when (= edig 0) (return 0))
        (when (!= i len) (return 0))
        (set! pexp (* pexp esign))
        (set! (aref out-sign 0) sign)
        (set! (aref out-sticky 0) sticky)
        (when (and (= hi 0) (= lo 0))
          (do (set! (aref out-hi 0) 0) (set! (aref out-lo 0) 0) (set! (aref out-exp 0) 0)
              (return 1)))
        (let (n:i64 0)
          (while (= (bit-and hi (bit-shl (as i64 1) 63)) 0)
            (set! hi (bit-or (bit-shl hi 1) (u64-shr lo 63)))
            (set! lo (bit-shl lo 1))
            (set! n (+ n 1)))
          (set! (aref out-hi 0) hi)
          (set! (aref out-lo 0) lo)
          (set! (aref out-exp 0) (+ (- (+ (* 4 (- drop frac)) pexp) n) 127))
          (return 1))))))

; Round the normalized significand to `p` bits, round-to-nearest-ties-to-even,
; and return its BIASED exponent — all-ones (2*bias+1) for an overflow to
; infinity, 0 for a zero or a subnormal. out-hi/out-lo receive the p-bit
; significand with the leading bit included; every format but f80 drops it.
(defn hexfloat-fit (hi:i64 lo:i64 sticky:i64 ue:i64
                    p:i64 emin:i64 emax:i64 bias:i64
                    out-hi:ptr:i64 out-lo:ptr:i64):i64
  (set! (aref out-hi 0) 0)
  (set! (aref out-lo 0) 0)
  (when (and (= hi 0) (= lo 0)) (return 0))
  (when (> ue emax) (return (+ (* 2 bias) 1)))
  (let (keep:i64 p
        sub:i32 0)
    (when (< ue emin)
      (do (set! keep (- p (- emin ue))) (set! sub 1)))
    (when (< keep 0) (return 0))
    (when (= keep 0)
      ; The leading bit sits exactly at the guard position: a tie rounds to
      ; even, which here is zero; anything above it, to the least subnormal.
      (do (when (or (!= (u128-low-any hi lo 127) 0) (!= sticky 0))
            (set! (aref out-lo 0) 1))
          (return 0)))
    (let (s:i64 (- 128 keep)
          rhi:i64 0
          rlo:i64 0
          guard:i64 (u128-bit hi lo (- s 1))
          rest:i64 0)
      (when (or (!= (u128-low-any hi lo (- s 1)) 0) (!= sticky 0)) (set! rest 1))
      (if (>= s 64)
        (set! rlo (u64-shr hi (- s 64)))
        (do (set! rhi (u64-shr hi s))
            (set! rlo (bit-or (u64-shl hi (- 64 s)) (u64-shr lo s)))))
      (when (and (!= guard 0) (or (!= rest 0) (!= (bit-and rlo 1) 0)))
        (do (set! rlo (+ rlo 1))
            (when (= rlo 0) (set! rhi (+ rhi 1)))))
      (when (= (u128-bit rhi rlo keep) 0)
        (do (set! (aref out-hi 0) rhi) (set! (aref out-lo 0) rlo)
            (if (!= sub 0) (return 0) (return (+ ue bias)))))
      ; The rounding carried into a new leading bit.
      (when (= sub 0)
        (do (u128-set-bit (- p 1) out-hi out-lo)
            (when (> (+ ue 1) emax) (return (+ (* 2 bias) 1)))
            (return (+ (+ ue 1) bias))))
      ; A subnormal that carries all the way to 2^emin is the least NORMAL, and
      ; is the one place the two branches meet.
      (when (= keep (- p 1))
        (do (u128-set-bit (- p 1) out-hi out-lo) (return 1)))
      (u128-set-bit keep out-hi out-lo)
      (return 0))))

; An f32 (sign, biased exponent, 24-bit significand) as the bit pattern of the
; DOUBLE it widens to — LLVM spells a `float` constant that way (see
; f32-const-ir). An f32 subnormal is a normal double, so it renormalizes here.
(defn f32-parts-as-f64-bits (sign:i64 be:i64 sig:i64):i64
  (when (= be 255)
    (return (bit-or (bit-shl sign 63) (bit-shl (as i64 2047) 52))))
  (when (and (= be 0) (= sig 0)) (return (bit-shl sign 63)))
  (let (e:i64 (- be 127)
        m:i64 (bit-and sig 8388607))
    (when (= be 0)
      (let (k:i64 22)
        (while (= (bit-and sig (bit-shl (as i64 1) k)) 0) (set! k (- k 1)))
        (set! e (- k 149))
        (set! m (bit-and (bit-shl sig (- 23 k)) 8388607))))
    (return (bit-or (bit-shl sign 63)
                    (bit-or (bit-shl (+ e 1023) 52) (bit-shl m 29))))))

; The LLVM constant text for hex-float lexeme `lex` at type kind `tk`, or null
; when `lex` is not a hex float. Assembling f80 and f128 from the 128-bit
; significand directly is the whole reason this path exists.
(defn hexfloat-const-ir (lex:CStr tk:i32):CStr
  (let (sign:i64 0 hi:i64 0 lo:i64 0 ue:i64 0 sticky:i64 0
        rhi:i64 0 rlo:i64 0)
    (when (= (hexfloat-parse lex (as ptr:i64 (addr-of sign))
                                 (as ptr:i64 (addr-of hi))
                                 (as ptr:i64 (addr-of lo))
                                 (as ptr:i64 (addr-of ue))
                                 (as ptr:i64 (addr-of sticky))) 0)
      (return null))
    (let (rhp:ptr:i64 (as ptr:i64 (addr-of rhi))
          rlp:ptr:i64 (as ptr:i64 (addr-of rlo)))
      (when (= tk TY-F16)
        (let (be:i64 (hexfloat-fit hi lo sticky ue 11 -14 15 15 rhp rlp))
          (return (as CStr (fstr "0xH"
                                 (hexu (bit-or (bit-shl sign 15)
                    (bit-or (bit-shl be 10) (bit-and rlo 1023))) 4))))))
      (when (= tk TY-F32)
        (let (be:i64 (hexfloat-fit hi lo sticky ue 24 -126 127 127 rhp rlp))
          (return (as CStr (fstr "0x" (hexu (f32-parts-as-f64-bits sign be rlo) 16))))))
      (when (= tk TY-F80)
        (let (be:i64 (hexfloat-fit hi lo sticky ue 64 -16382 16383 16383 rhp rlp))
          ; x87 carries the leading bit explicitly, and an infinity has it set.
          (when (= be 32767) (set! rlo (bit-shl (as i64 1) 63)))
          (return (as CStr (fstr "0xK" (fstr (hexu (bit-or (bit-shl sign 15) be) 4))
                                 (fstr (hexu rlo 16)))))))
      (when (= tk TY-F128)
        (let (be:i64 (hexfloat-fit hi lo sticky ue 113 -16382 16383 16383 rhp rlp))
          (return (as CStr (fstr "0xL" (fstr (hexu rlo 16))
                                 (fstr (hexu (bit-or (bit-shl sign 63)
                                      (bit-or (bit-shl be 48)
                                              (bit-and rhi 281474976710655))) 16)))))))
      (let (be:i64 (hexfloat-fit hi lo sticky ue 53 -1022 1023 1023 rhp rlp))
        (return (as CStr (fstr "0x"
                               (hexu (bit-or (bit-shl sign 63)
                  (bit-or (bit-shl be 52) (bit-and rlo 4503599627370495))) 16))))))))

(defn type-zero-const-ir (ty:(raw Type)):CStr
  (let (tt:(raw Type) ty
        tk:i32 (tt 'kind))
    (when (!= (is-ptr-repr ty) 0) (return "null"))
    ; f32/f64 take the decimal spelling LLVM accepts for them; the three wide
    ; widths do not have one (FL-2), so they route through their renderers.
    (when (or (= tk TY-F32) (= tk TY-F64)) (return "0.0"))
    (when (= tk TY-F16)  (return (f16-const-ir 0.0)))
    (when (= tk TY-F80)  (return (f80-const-ir 0.0)))
    (when (= tk TY-F128) (return (f128-const-ir 0.0)))
    (when (= tk TY-BOOL) (return "false"))
    (when (or (= tk TY-STRUCT) (= tk TY-UNION) (= tk TY-ARRAY))
      (return "zeroinitializer"))
    (return "0")))

; Refuse an `(array T N)` where only a first-class value type is meaningful.
; Backstop for the positions parse-type-from-node's g-array-ok gate cannot see
; because the Type arrives already parsed (the ABI classifier, a `set!` target).
(defn reject-array-type (t:(raw Type) line:i32 what:CStr):void
  (when (= t null) (return))
  (let (tt:(raw Type) t)
  (when (= (tt 'kind) TY-ARRAY)
    (die-at line
      (fstr what
            ": an (array T N) is storage, not a value -- it decays to a pointer when read, so pass or store ptr:T (or (ref T)) instead")))))

; Stage 14 NS-2 (design/stage14/native-strings.md): is Type `t` the prelude
; `StrView` struct (`{ data:(ptr ui8), len:usize }`, promoted to the prelude in
; NS-1)? The dormant target-typed emission (emit-string), value coercion
; (coerce-int-val) and content-comparison (emit-binop-vals) paths use this to
; recognize a StrView value. The null / non-struct short-circuits keep the
; self-compile hot path cheap and mean nothing interns "StrView" unless a real
; struct value is in hand. Nothing in src/ produces a StrView value yet
; (NODE-STR types as CStr until NS-3), so this returns 0 throughout the
; compiler's own compilation → the new paths stay inert and the bootstrap is
; byte-identical. Identity is by the interned struct-name pointer, exactly how
; lookup-struct keys the registry.
(defn type-is-strview (t:raw:Type):i32
  (when (= t null) (return 0))
  (let (tt:raw:Type t)
    (when (!= (tt 'kind) TY-STRUCT) (return 0))
    (let (sd:raw:StructDef (tt 'sdef))
      (when (= sd null) (return 0))
      (when (= (sd 'name)
               ((as ptr:Node (intern-symbol "StrView")) 's))
        (return 1))
      (return 0))))

; Stage 14 NS-3 (design/stage14/native-strings.md): collapse an *unmaterialized*
; StrView string literal (emit-string's chameleon: is-lit=1, StrView type, `val` is
; the bare data GEP) to a plain CStr in place — a no-IR retype, since the literal's
; data pointer already IS `val`. Used at every site where a Val's TYPE, not a
; coercion, drives IR that references its `val`: a cond/match/if-some phi (a
; `%StrView` phi over bare-ptr operands is malformed) and the :rest fold (which
; `inttoptr`s a non-ptr-like arg). There the literal must contribute exactly as a
; CStr literal did before the flip — a plain pointer. A genuine (materialized)
; StrView value (is-lit=0), whose `val` is a real first-class struct, is left
; untouched. Returns 1 if it collapsed the Val, else 0.
(defn collapse-strlit-cstr (v:raw:Val):i32
  (let (vv:raw:Val v)
    (when (and (!= (vv 'is-lit) 0) (!= (type-is-strview (vv 'type)) 0))
      (set! (vv 'type) ty-cstr)
      (return 1))
    (return 0)))

; Map a Nucleus type to its C representation string.
; For function pointer types, returns a simplified "void*" — the full
; C function pointer syntax (with return type and params) is handled
; separately in emit-cheader-declare where we have the param names.
(defn type-to-c (t:raw:Type):CStr
  (let (tt:raw:Type t)
    (case (tt 'kind)
      TY-VOID   (return "void")
      ; `bool`, not `_Bool`: the generated preamble already includes
      ; <stdbool.h>, and it is the spelling a C23 reader expects.
      TY-BOOL   (return "bool")
      TY-I8     (return "int8_t")
      TY-I16    (return "int16_t")
      TY-I32    (return "int32_t")
      TY-I64    (return "int64_t")
      TY-UI8    (return "uint8_t")
      TY-UI16   (return "uint16_t")
      TY-UI32   (return "uint32_t")
      TY-UI64   (return "uint64_t")
      (:or TY-PTR TY-FN) (return "void*")
      TY-CSTR   (return "char*")
      ; Char is a Unicode scalar value; uint32_t at the C boundary.
      TY-CHAR   (return "uint32_t")
      TY-ERR    (return "int32_t")
      TY-F32    (return "float")
      TY-F64    (return "double")
      ; FL-1: `_Float16`/`_Float128` are the portable C spellings; `long double`
      ; is deliberately NOT used, because which of f80/f128 it names is
      ; target-dependent and a generated header must mean one thing.
      TY-F16    (return "_Float16")
      TY-F80    (return "long double")
      TY-F128   (return "_Float128")
      TY-USIZE  (return "size_t")
      TY-SSIZE  (return "ssize_t")
      TY-STRUCT (return (fstr "struct " ((tt 'sdef) 'name)))
      TY-UNION  (return (fstr "union " ((tt 'sdef) 'name)))
      ; Stage 15 W8 G-2: C's array declarator is POSTFIX (`int xs[4];`), so the
      ; element type alone belongs here and the `[N]` is appended by the
      ; declarator site (emit-cheader-defstruct). A prefix rendering would be
      ; syntactically wrong C wherever it were pasted.
      TY-ARRAY  (return (type-to-c (tt 'elem)))
      (return "/* unknown */"))))

; The IR type of a pointer-sized integer (size_t / intptr_t) for the target.
; All pointer-as-integer codegen routes through this rather than hardcoding i64.
; Ternary over the target pointer width (Stage 14 AVR-2): 2→i16 (AVR), 4→i32
; (ILP32), else i64 (LP64/LLP64 hosts). Byte-identical on every hosted target,
; where g-target-ptr-bytes is 8 → "i64", exactly as the prior binary form.
(defn ptr-int-ir ():ptr
  (if (= g-target-ptr-bytes 2) "i16"
    (if (= g-target-ptr-bytes 4) "i32" "i64")))

; The registered singleton type for a pointer-sized integer on the target.
; Same 2/4/else-8 selection as ptr-int-ir; ty-i16 is a registered singleton
; (types-init), so no new registration is needed.
(defn ptr-int-type ():ptr
  (if (= g-target-ptr-bytes 2) ty-i16
    (if (= g-target-ptr-bytes 4) ty-i32 ty-i64)))

; Size in bytes of one host pointer, as an i64 — the element size for the
; compiler's own arrays of pointers. Use instead of a literal 8 so the compiler
; allocates correctly on hosts where a pointer is not 8 bytes.
(defn ptr-bytes ():i64
  (as i64 g-host-ptr-bytes))

; Slot size/alignment in bytes. Every caller feeds an `align N` operand, so the
; answer must be a power of two (see the TY-ARRAY note below).
;
; Stage 15 W9 item 19: one `ptr` register is one target pointer wide, whichever
; type spells it — so this asks `is-ptr-repr` rather than listing TY-PTR and
; TY-CSTR as arms and (as it did) forgetting TY-FN, which fell to the default
; `(return 1)`. That made every fn-pointer slot, load and store claim `align 1`:
; free on x86-64, but on a strict-alignment target it forces byte-wise access —
; one `ldr` becomes four `ldrb` plus three `orr` on armv7, eight `lbu` plus
; shifts on rv64. `abi-alignof`/`abi-sizeof` had each been given their own
; hand-written TY-FN arm instead; both now fall through to here.
(defn type-size (t:raw:Type):i32
  (let (tt:raw:Type t)
    (when (!= (is-ptr-repr tt) 0) (return g-target-ptr-bytes))
    (case (tt 'kind)
      TY-BOOL (return 1)
      TY-I8   (return 1)
      TY-I16  (return 2)
      TY-I32  (return 4)
      TY-I64  (return 8)
      TY-UI8  (return 1)
      TY-UI16 (return 2)
      TY-UI32 (return 4)
      TY-UI64 (return 8)
      (:or TY-CHAR TY-ERR) (return 4)
      TY-F32   (return 4)
      TY-F64   (return 8)
      ; FL-1: `half` is 2; `fp128` is 16 everywhere. `x86_fp80` holds 80 bits
      ; but is PADDED to the ABI's stack slot — 16 bytes under LP64 (x86-64),
      ; 12 under ILP32 (i386). It exists on no other target, so keying on the
      ; pointer width is the whole rule.
      TY-F16   (return 2)
      TY-F80   (return (if (= g-target-ptr-bytes 4) 12 16))
      TY-F128  (return 16)
      (:or TY-USIZE TY-SSIZE) (return g-target-ptr-bytes)
      ; A struct value is laid out by LLVM; we use the pointer alignment as a
      ; conservative slot size/alignment for it (structs are handled by-reference).
      (:or TY-STRUCT TY-UNION) (return g-target-ptr-bytes)
      ; Stage 15 W8 G-2: like the struct case above, this is the conservative
      ; slot ALIGNMENT, not the aggregate's size — every caller of type-size in
      ; an `align N` operand needs a power of two, and `N * sizeof(T)` is not
      ; one (`alloca [3 x i32], align 12` is invalid IR). The real size lives in
      ; abi-sizeof, which is what `sizeof` and the layout walk read.
      TY-ARRAY  (return (type-size (tt 'elem)))
      (return 1))))

; The SEMANTIC "is this an integer" question. TY-BOOL is deliberately absent
; (design/stage16-ergonomics/bool-type-plan.md): bool has two values, no
; arithmetic and no implicit conversion. Ask `is-int-or-bool` below for the
; representation question instead.
(defn is-int-type (t:raw:Type):i32
  (let (k:i32 (t 'kind))
    (case k
      (:or TY-I8 TY-I16 TY-I32 TY-I64
           TY-UI8 TY-UI16 TY-UI32 TY-UI64) (return 1)
      ; Err is an i32-repr scalar: integer for comparison/coercion/arithmetic,
      ; distinguished from i32 only by type-eq / mangling (errors.md §8).
      TY-ERR   (return 1)
      (:or TY-USIZE TY-SSIZE) (return 1)
      ; Char is an i32-repr distinct scalar: integer for comparison/coercion/cast
      ; (a same-width `cast` Char<->ui32 is a no-IR reinterpret), distinguished from
      ; ui32 only by type-eq / mangling so `=`/`!=` dispatch and literals keep meaning.
      TY-CHAR  (return 1)
      (return 0))))

(defn is-float-type (t:raw:Type):i32
  (let (k:i32 (t 'kind))
    (case k
      (:or TY-F16 TY-F32 TY-F64 TY-F80 TY-F128) (return 1)
      (return 0))))

; FL-1: significand bits, which is what orders the float widths for a
; conversion. NOT the storage size — `x86_fp80` is wider than `fp128` in
; storage on i386 and narrower in precision everywhere, so a width comparison
; over `type-size` would pick `fptrunc` where `fpext` is meant. Zero for a
; non-float, so a caller must have asked `is-float-type` first.
(defn float-rank (t:raw:Type):i32
  (case (t 'kind)
    TY-F16  (return 11)
    TY-F32  (return 24)
    TY-F64  (return 53)
    TY-F80  (return 64)
    TY-F128 (return 113)
    (return 0)))

(defn is-bool-type (t:raw:Type):i32
  (when (= (t 'kind) TY-BOOL) (return 1))
  (return 0))

; A type whose *representation* is an integer register: the integers plus bool.
; Distinct from `is-int-type` on purpose, exactly as `is-ptr-repr` is distinct
; from `is-ptr-like` — that predicate carries meanings (arithmetic, implicit
; widening, literal adoption) bool must never acquire. Ask THIS one where the
; question is which instruction to emit: `unsafe/cast`'s selection ladder and
; the binop operand gate.
(defn is-int-or-bool (t:raw:Type):i32
  (when (!= (is-int-type t) 0) (return 1))
  (return (is-bool-type t)))

; A type whose IR representation is `ptr` and whose ABI is a plain pointer:
; TY-PTR and TY-CSTR (a C-string is a `char*`). They are interconvertible with
; no IR and zero-initialise to `null`. (TY-FN is deliberately excluded — its
; existing call-position handling is unchanged by CStr.)
(defn is-ptr-like (t:raw:Type):i32
  (let (k:i32 (t 'kind))
    (case k
      (:or TY-PTR TY-CSTR) (return 1)
      (return 0))))

; A type whose IR *representation* is one `ptr` register: `is-ptr-like` plus
; TY-FN. Distinct from `is-ptr-like` on purpose — that predicate carries two
; further meanings a function pointer must never acquire (the free ptr<->CStr
; value coercion, and the strcmp lowering of `=`), which is why TY-FN stays out
; of it. Ask THIS one for representation questions: what constant spells zero,
; which instruction compares two operands. Ask `is-ptr-like` for coercion and
; string questions. Widening either into the other silently makes
; `(= some-fn-ptr some-cstr)` a strcmp; see context/conventions.md.
;
; Stage 15 W9 item 18 gave the rule a name. It had been written out by hand at
; each of its three storage sites (`type-zero-const-ir` below, `emit-zero-store`
; and `defvar-init-ir`), and the comparison sites in `emit-binop-vals` were
; simply missing it — the shape W9 item 15 found for the GEP index width.
(defn is-ptr-repr (t:raw:Type):i32
  (when (!= (is-ptr-like t) 0) (return 1))
  (when (= (t 'kind) TY-FN) (return 1))
  (return 0))

(defn int-width (t:raw:Type):i32
  (let (k:i32 (t 'kind))
    (case k
      TY-BOOL (return 1)
      TY-I8 (return 8)
      TY-I16 (return 16)
      TY-I32 (return 32)
      TY-I64 (return 64)
      TY-UI8 (return 8)
      TY-UI16 (return 16)
      TY-UI32 (return 32)
      TY-UI64 (return 64)
      TY-ERR   (return 32)
      (:or TY-USIZE TY-SSIZE) (return (* g-target-ptr-bytes 8))
      TY-CHAR  (return 32)
      (return 0))))

; May a StrView decay to `target` by taking its `data` field? Only a *byte*
; pointer: a typed `ptr:S` target used to take the borrow too, so a `(ref
; StrView)` parameter silently received `.data` (design/stage17-native-strings/
; library-gaps.md #25).
(defn strview-borrow-target (target:raw:Type):i32
  (when (= target null) (return 0))
  (let (tt:raw:Type target)
    (when (= (tt 'kind) TY-CSTR) (return 1))
    (when (!= (tt 'kind) TY-PTR) (return 0))
    (let (e:raw:Type (tt 'elem))
      (when (= e null) (return 1))
      (when (and (!= (is-int-type e) 0) (= (int-width e) 8)) (return 1))
      (return 0))))

; bool is not an integer, but its REPRESENTATION is a 1-bit unsigned value, and
; that is what picks the instruction: `zext`/`icmp u*` so `true` widens to 1 and
; `false < true`. Reading it as signed (Stage 15 W9 item 31) made `(as i32 true)`
; -1 and `(< false true)` and `(> true false)` both false.
(defn is-unsigned (t:raw:Type):i32
  (let (k:i32 (t 'kind))
    (case k
      (:or TY-BOOL TY-UI8 TY-UI16 TY-UI32 TY-UI64 TY-USIZE) (return 1)
      ; Char is over ui32, so it is unsigned for the trunc/zext-vs-sext choice.
      TY-CHAR  (return 1)
      (return 0))))

; Stage 14 LW-4 (int-widening.md §"LW-4"): is the signed i64 literal value `v`
; representable in integer type `t`? A 64-bit-wide target holds any i64 bit
; pattern (a ui64/usize literal is stored as a signed i64 carrying the right
; bits, so no check is meaningful). A narrower target is checked against its
; exact range: signed [-2^(w-1),
; 2^(w-1)-1], unsigned [0, 2^w-1]. Bounds are built with shifts rather than
; large decimal literals so this predicate stays a bootstrap fixed point (a
; literal above i32 range in its own source would be wrapped by the old boot
; compiler before LW-4's widening lands).
(defn int-literal-fits (v:i64 t:raw:Type):i32
  (let (w:i32 (int-width t))
    (when (>= w 64) (return 1))
    (let (wi:i64 w
          one:i64 1)
      (if (!= (is-unsigned t) 0)
        ; Unsigned target — [0, 2^w - 1].
        (do
          (when (< v 0) (return 0))
          (let (hi:i64 (- (bit-shl one wi) one))
            (if (> v hi) (return 0) (return 1))))
        ; Signed target — [-2^(w-1), 2^(w-1) - 1].
        (let (half:i64 (bit-shl one (- wi one)))
          (if (or (< v (- 0 half)) (> v (- half one)))
            (return 0)
            (return 1)))))))

; Stage 15 W9 item 30: is the f64 literal value `d` exactly representable in
; float type `t`? The float counterpart of `int-literal-fits` above, and the
; predicate was already written elsewhere: `f32-const-ir` (src/nucleusc.nuc)
; renders a literal at single precision by computing
; `(as f64 (unsafe/cast f32 d))` — one round-to-nearest down, then an exact
; widening back — so "does this literal survive the trip" is that value compared
; against the original. A literal Val is always f64 (`emit-float`), so an f64
; destination is exact by construction.
;
; NaN is exactly representable and does NOT compare equal to itself (`=` on
; floats is `fcmp oeq`), so it is answered before the round trip; ±inf needs no
; arm, since it round-trips and compares equal.
;
; This evaluates target arithmetic in the COMPILER's own process, so it inherits
; W2d's standing constraint that `build/nucleusc` is never built with
; `-ffast-math`: FTZ/DAZ would flush a denormal single to zero and this would
; then call the conversion exact.
(defn float-literal-fits (d:f64 t:raw:Type):i32
  (let (k:i32 (t 'kind))
    (when (= k TY-F64) (return 1))
    ; Stage 16 FL-1: f80 and f128 carry every f64 exactly — the widening is what
    ; makes FL-2's renderers integer arithmetic — so a literal always fits.
    (when (or (= k TY-F80) (= k TY-F128)) (return 1))
    ; f16 is a narrowing with no host type to round-trip through, so the test is
    ; the renderer's own: a value that survives is one whose f16 bits widen back
    ; unchanged. Rather than duplicate the rounding, refuse every f16 literal
    ; here — `as` promises exactness and cannot promise it without the check;
    ; the implicit path at a typed slot still rounds, exactly as it does for f32.
    (when (= k TY-F16) (return 0))
    (when (!= k TY-F32) (return 0))
    (when (!= d d) (return 1))
    (if (= (as f64 (unsafe/cast f32 d)) d) (return 1) (return 0))))

; ============================================================
; Stage 15 W8 G-1 (design/global-init.md §5 "G-1"): THE int->int rule for the
; safe cast `as` — a widening (or a same-width sign reinterpret) is safe, a
; narrowing is lossy and must be spelled `unsafe/cast`. Extracted as a shared
; predicate because there are now TWO askers: `emit-as` step 5 (the value path)
; and `const-fold-int` (the global-initializer constant folder, which has no
; instruction stream to emit into and so decides the same question by hand).
; context/conventions.md's standing rule for exactly this shape: mirroring the
; *logic* in two places drifts, mirroring a *call* cannot.
;
; Stage 15 W9 item 8: "narrowing" is a property of the VALUE where the value is
; known, not of the two widths alone. `(as i8 5)` was refused as lossy while the
; implicit coercion at the identical slot — `(let (a:i8 5) …)` — accepted it and
; emitted the very same `trunc i32 5 to i8`, so the safe cast was strictly
; stricter than the machinery it exists to make explicit. `is-lit`/`lit` carry
; the caller's literal knowledge (`Val.is-lit`/`lit-i64` on the value path; the
; folded constant itself in `const-fold-int`, which is always known); a literal
; that FITS the destination is not a narrowing. `int-literal-fits` is the same
; range predicate `coerce-int-val` gates the implicit path with, so the two
; paths now accept exactly the same set. Pass `is-lit` 0 to ask about the widths
; alone.
(defn as-int-narrowing (src:raw:Type dst:raw:Type is-lit:i32 lit:i64):i32
  (when (>= (int-width dst) (int-width src)) (return 0))
  (when (and (!= is-lit 0) (!= (int-literal-fits lit dst) 0)) (return 0))
  (return 1))

; Stage 15 W9 item 30: THE float->float rule for `as`, the counterpart of
; `as-int-narrowing` above and settled the same way. `emit-as` rejected every
; f64->f32 on the two KINDS alone, so `(as f32 1.5)` died "lossy conversion"
; while the implicit coercion at the identical slot — `(let (a:f32 1.5) …)` —
; accepted it and emitted the very same `float` constant with no instruction at
; all (W2d). That left the safe cast stricter than the machinery it exists to
; make explicit, in the one position item 8 did not close.
;
; The ruling is the STRICTER of the two the item offered: `as` admits a literal
; only when it round-trips EXACTLY, so `(as f32 1.5)` compiles and
; `(as f32 3.14)` keeps its diagnostic. `as` promises no loss; the implicit
; path's silent rounding at a typed slot is Option A of the W2d design note, a
; deliberately different promise, and widening `as` to match it would delete the
; only spelling that says "this conversion is exact". A non-literal narrowing is
; unchanged — still lossy, still `unsafe/cast`.
;
; `float-width` lives in nucleusc.nuc; calling *up* into it from an imported
; module is the ordinary direction (abi.nuc's float branch does the same).
; Pass `is-flit` 0 to ask about the widths alone.
(defn as-float-narrowing (src:raw:Type dst:raw:Type is-flit:i32 lit:f64):i32
  (when (>= (float-width dst) (float-width src)) (return 0))
  (when (and (!= is-flit 0) (!= (float-literal-fits lit dst) 0)) (return 0))
  (return 1))

; Stage 10: pointer kinds (design/stage10/nullability.md)
; ============================================================

; The pointer kind of a type: the Stage 10 contract for TY-PTR, PTR-RAW for
; everything else (including non-pointers, so callers can probe freely).
(defn ptr-pkind (t:raw:Type):i32
  (when (= t null) (return PTR-RAW))
  (let (tt:raw:Type t)
    (when (!= (tt 'kind) TY-PTR) (return PTR-RAW))
    (return (tt 'pkind))))

; Clone `t` with pkind=k. Typed-pointer Types may be shared (and bare ptr is a
; singleton), so relabeling/narrowing never mutates. Identity when k matches.
(defn type-as-pkind (t:raw:Type k:i32):raw:Type
  (let (src:raw:Type t)
    (when (= (src 'pkind) k) (return t))
    (let (dst:ref:Type (alloc-type))
      (set! (dst 'kind) (src 'kind))
      (set! (dst 'ret) (src 'ret))
      (set! (dst 'params) (src 'params))
      (set! (dst 'num-params) (src 'num-params))
      (set! (dst 'variadic) (src 'variadic))
      (set! (dst 'has-rest) (src 'has-rest))
      (set! (dst 'nopt) (src 'nopt))
      (set! (dst 'opt-defaults) (src 'opt-defaults))
      (set! (dst 'elem) (src 'elem))
      (set! (dst 'sdef) (src 'sdef))
      (set! (dst 'is-volatile) (src 'is-volatile))
      (set! (dst 'pkind) k)
      (return dst))))

; The conservative meet of two pointer kinds for a control-flow join (cond /
; if-some phi): raw if either side waived the checks, else Maybe if either
; side may be null, else ref.
(defn pkind-meet (a:i32 b:i32):i32
  (when (or (= a PTR-RAW) (= b PTR-RAW)) (return PTR-RAW))
  (when (or (= a PTR-MAYBE) (= b PTR-MAYBE)) (return PTR-MAYBE))
  (return PTR-REF))

; Enforce pointer-kind flow into a declared slot (binding init, set!, field /
; element store, argument, return). Only a non-null (ref T) destination adds an
; obligation: the source must itself be ref. Widening (ref→raw, ref→Maybe,
; raw→Maybe, Maybe→raw) is always allowed; the existing kind/elem rules are
; unchanged. `unsafe/cast` does not pass through here, so
; (unsafe/cast (ref T) raw) remains the explicit, audited assertion.
;
; CStr (string-literal / C-string type) is treated as ref-compatible: string
; literals are non-null constants, the overwhelmingly common CStr source, and
; flagging "foo" into a (ref ...)/ptr param would bury the flip under thousands
; of false positives. A genuinely nullable C string is spelled `raw` (the
; audited edge), not CStr.
;
; Untyped-pointer refinement (Phase F): a non-null obligation is only meaningful
; on a *typed* destination. An elem-less bare `ptr` slot is the compiler's `void*`
; escape hatch: it names no pointee, cannot be deref'd (`aref`/field access dies
; with "operand must be typed pointer"), so a non-null contract on it protects
; nothing. Enforcing it would bury the flip under ~343 contractless flows where a
; (now-`?T`) `node-at`/`scope-lookup`/coercer result feeds an untyped local or
; param. So an elem-less destination is exempt; the flip's teeth stay on typed
; (ref T)/(ptr T) slots, where `null`/raw/Maybe into a (ref T) is still an error
; and a typed raw/Maybe source into a typed ref slot is still checked. Direct
; analogue of the CStr refinement above; deref safety is enforced separately by
; `require-derefable`.
(defn pkind-flow-check (src:raw:Type dst:raw:Type line:i32 ctx:CStr):void
  (when (or (= src null) (= dst null)) (return))
  (when (!= (ptr-pkind dst) PTR-REF) (return))
  (when (= (ptr-pkind src) PTR-REF) (return))
  ; Untyped (void*) destination carries no non-null contract: an elem-less bare
  ; `ptr` slot names no pointee and cannot be deref'd, so a non-null obligation
  ; on it protects nothing. The flip's teeth stay on typed (ref T)/(ptr T) slots.
  (when (= (dst 'elem) null) (return))
  ; Stage 15 W9 item 7: every POINTER-LIKE source, not `TY-PTR` alone. A `CStr`
  ; is `TY-CSTR`, so `ptr-pkind` answers PTR-RAW for it and it used to fall out
  ; of this check entirely — `(defvar g:ptr:T (as CStr null))`, and the identical
  ; local, compiled clean and segfaulted on first use.
  ;
  ; The exemption was recorded as "CStr is ref-compatible (a C string is a
  ; non-null constant)" and as the analogue of the elem-less-destination
  ; refinement above. Neither holds. It is true of a string LITERAL and false of
  ; the type: `getenv` returns `CStr` and returns null. And the void* refinement
  ; is sound for the opposite reason — an elem-less destination cannot be
  ; dereferenced, so a non-null obligation on it protects nothing, whereas the
  ; destination here is typed and fully dereferenceable. See design/stage10/
  ; nullability.md §9.1 and the W9 item 7 note in the stress-test progress doc.
  (let (sk:i32 (src 'kind))
    (when (!= (is-ptr-like src) 0)
      (if (= (ptr-pkind src) PTR-MAYBE)
        (die-at line (fstr ctx
                           ": value may be null where non-null (ref ...) is required — narrow with if-some/when-some, unwrap, or a null guard"))
        (die-at line (fstr ctx
                           ": raw pointer where non-null (ref ...) is required — launder with (as-ref ...) + narrowing, or assert with (unsafe/cast (ref T) ...)"))))))

; Deref/field/index gate: a (Maybe (ref T)) value cannot be accessed until
; narrowed. Raw stays unchecked (the signed waiver); ref is always safe.
(defn require-derefable (t:raw:Type line:i32 op:CStr):void
  (when (= (ptr-pkind t) PTR-MAYBE)
    (die-at line (fstr op
                       ": value may be null — narrow with if-some/when-some, unwrap, or a (when (= x null) ...) guard before use"))))

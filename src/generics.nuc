(import-use nucleus.arena)
(import-use nucleus.vector)
(import-use nucleus.intern)
(import-use nucleus.node)
(import-use nucleus.hashmap)
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use nucleus.strview-str)
(import-use nucleus.read)
(import-use nucleus.strview)
(import-use nucleus.hashset)

; Generic / polymorphism registry, bounded-generic def-time checking, Stage 11
; tyvar-from-receiver inference + structural unification, and the Valid inferred
; structural-bound checker. Source-imported by src/nucleusc.nuc before node-type
; and emit-* dispatch. Extracted from nucleusc.nuc (Stage 12 N8).
;
; Depends on: compiler-types.nuc (Generic/Method/Conformance/Protocol structs and
; the METHOD-*/MK-* constants), type-utils.nuc, scope.nuc, abi.nuc,
; union-registry.nuc (all imported earlier), and many nucleusc.nuc functions
; (node-type, emit-defn, unify-tpat, parse-type-from-node, …) which resolve via
; nucleusc.nuc's whole-unit defn-signature prescan. It calls nothing from the
; later-imported cheader.nuc / nuch.nuc / repl.nuc, so its early import is safe.

; ============================================================
; Generic (polymorphism) registry
; ============================================================

; Exact registry probe: the Generic stored under precisely this key, or null.
; The DEFINE side uses this (the caller has already computed the key it wants);
; use sites go through generic-lookup below, which first tries the current file's
; private key.
(defn generic-lookup-exact (name:Symbol):?&Generic
  (doseq (g g-generics (VecIter &Generic))
     (when (= (g 'name) name)
           (return (as ptr g))))
  (return null))

(defn generic-lookup (name:Symbol):?&Generic
  ; Stage 15 W5e: a name this file declared with `defn-` is keyed under the
  ; file's implicit namespace, and shadows a public generic of the same name.
  ; priv-key-use is the identity for every other name, so this is one extra
  ; compare — and, when the unit has no private definer at all, one null check.
  (let (k:Symbol (priv-key-use name))
    (when (!= k name)
      (let (pg:?&Generic (generic-lookup-exact k))
        (when (!= pg null) (return pg)))))
  (return (generic-lookup-exact name)))

; Does method `m` come from namespace `ns`? A `Method` with no `src-ns` is an
; intrinsic operator seed (`build-generics`), which belongs to no file; `user` is
; the unqualified space, so that is what it answers to.
(defn method-in-ns (m:&Method ns:Symbol):i32
  (let (s:Symbol (m 'src-ns))
    (when (symbol-none? s) (set! s g-ns-user))
    (when (= s ns) (return 1))
    (return 0)))

; A queued deferred `defn` emission, capturing the environment its body's names
; must resolve in. Stage 15 W9 item 43: every creator goes through this, so a job
; can never be queued without one — the four synthesized bodies (a lifted lambda,
; a closure `invoke`/`drop`, a derived forwarder) are written by the compiler in
; the file being compiled, so `here` is theirs; `generic-instantiate-in` then
; overrides all three with the template's, which is the only case where the body
; came from somewhere else.
(defn mono-job-here (form:?&Node context:StrView):&MonoJob
  (let (job:&MonoJob (new MonoJob))
    (set! (job 'form) form)
    (set! (job 'context) context)
    (set! (job 'ns) g-current-ns)
    (set! (job 'path) g-source-path)
    (set! (job 'imports) g-file-imports)
    (return job)))

; Stage 15 W9 item 43 — the namespaces this file may name WITHOUT a qualifier.
; This is `name-ref-key-at`'s candidate-key sequence stated as a predicate rather
; than as a list of keys, and it is stated that way because a generic is the one
; registry R2 keys BARE: there is no per-namespace key to withhold, so the import
; environment has to be applied to the method SET instead. The three members are
; that function's three slots — the current namespace, each namespace an
; `import-use`/`import-only` in this file flattened, and `user`.
(defn ns-reachable-bare (ns:Symbol):i32
  ; `user` is the unqualified space and the prelude's namespace, flattened into
  ; every file by construction.
  (when (= ns "user") (return 1))
  (when (= ns g-current-ns) (return 1))
  (return (file-flattens-ns-named ns)))

; Is `m` reachable through the spelling that asked for it? `ns` names the one
; namespace a QUALIFIED spelling denotes; the none-Symbol asks the bare question.
(defn method-visible-as (m:&Method ns:Symbol):i32
  (when (= (binding-visible (m 'priv) (m 'src-ns)) 0) (return 0))
  (when (= (symbol-none? ns) false) (return (method-in-ns m ns)))
  (let (s:Symbol (m 'src-ns))
    ; An intrinsic operator seed belongs to no file, so no import can put it out
    ; of reach — `+` must work in a namespaced file that imports nothing.
    (when (symbol-none? s) (return 1))
    (return (ns-reachable-bare s))))

; `g` restricted to the methods reachable through the spelling that asked for it
; — namespace `ns` for a qualified one, the unqualified set (`ns-reachable-bare`)
; when `ns` is null — or null when that leaves none. The common answers are the
; two that allocate nothing: all of them (the generic is returned as it stands)
; or none.
;
; A filtered view is a fresh `Generic` over the SAME `Method` pointers, and it is
; deliberately not registered and not memoized. Nothing downstream reads a
; Generic by identity — `generic-resolve`, `emit-generic-call` and
; `node-type-call` read `name` / `methods` / `mangled` — while a cached view
; would go stale the moment a later import adds a method to the underlying
; generic (`generic-add-method` exists precisely because that happens).
(defn generic-filter-by-ns (g:&Generic ns:Symbol):?&Generic
  (let (gg:&Generic g
        n:i32 (unsafe/cast i32 (count (gg 'methods)))
        keep:i32 0)
    (dotimes (i n)
      (when (method-reachable-as (as &Method (invoke (gg 'methods) i:usize)) ns (gg 'name))
        (inc! keep)))
    (when (= keep 0) (return null))
    (when (= keep n) (return (as ptr gg)))
    (let (f:&Generic (generic-alloc (gg 'name)))
      (set! (f 'finalized) (gg 'finalized))
      (set! (f 'mangled) (gg 'mangled))
      (set! (f 'ir-prefix) (gg 'ir-prefix))
      (dotimes (i n)
        (let (m:&Method (as &Method (invoke (gg 'methods) i:usize)))
          (when (method-reachable-as m ns (gg 'name)) (conj (f 'methods) m))))
      (return (as ptr f)))))

; A method this spelling reaches: through its namespace, or as a conformer's answer
; to a protocol method this file can name, which dispatch finds wherever it is defined.
(defn method-reachable-as (m:&Method ns:Symbol name:Symbol):bool
  (when (!= (method-visible-as m ns) 0) (return true))
  (return (method-answers-protocol-here m ns name)))

; Does `m` answer method `name` of a protocol whose methods this spelling names —
; bare, or through namespace `ns` — for a type that conforms to it?
(defn method-answers-protocol-here (m:&Method ns:Symbol name:Symbol):bool
  (when (or (!= (m 'kind) METHOD-USER) (= (m 'param-types) null)) (return false))
  (doseq (p g-protocols (VecIter &Protocol))
    (when (and (proto-declares-method? p name)
               (!= (binding-visible (p 'priv) (p 'src-ns)) 0)
               (if (symbol-none? ns)
                 (!= (ns-reachable-bare (p 'src-ns)) 0)
                 (= (p 'src-ns) ns)))
      (dotimes (i (m 'num-params))
        (let (pt:?&Type (aref (unsafe/cast &ptr (m 'param-types)) i))
          (when (conformance-exact? pt (p 'name)) (return true))
          (when (and (!= pt null) (= (pt 'kind) TY-PTR)
                     (conformance-exact? (pt 'elem) (p 'name)))
            (return true))
          ; A method on its own namespace's type implements the protocol for it,
          ; even above the file's `extend` (ambient-namespaces.md, AN-2 as built).
          (when (type-owned-by-ns? pt (m 'src-ns)) (return true))))))
  (return false))

(defn type-owned-by-ns? (t:?&Type ns:Symbol):bool
  (when (or (= t null) (symbol-none? ns)) (return false))
  (let (u:?&Type (if (and (= (t 'kind) TY-PTR) (!= (t 'elem) null)) (t 'elem) t))
    (when (and (!= u null) (or (= (u 'kind) TY-STRUCT) (= (u 'kind) TY-UNION)) (!= (u 'sdef) null))
      (return (= (key-namespace ((unsafe/cast &StructDef (u 'sdef)) 'name)) ns))))
  (return false))

(defn proto-declares-method? (p:&Protocol name:Symbol):bool
  (dotimes (i (p 'num-sigs))
    (let (hd:ptr:Node (node-first (as ptr:Node (aref (unsafe/cast &ptr (p 'sigs)) i))))
      (when (= (node-kind hd) NODE-SYM)
        (let (nm:Symbol (symbol-none) tail:Symbol (symbol-none))
          (split-typed (hd 's) (as &Symbol &nm) (as &Symbol &tail))
          (when (= nm name) (return true))))))
  (return false))

; A recorded conformance of `t`, by the key dispatch asks (`type-spelling`).
(defn conformance-exact? (t:?&Type proto:Symbol):bool
  (when (= t null) (return false))
  (let (key:Symbol (type-spelling t))
    (doseq (c g-conformances (VecIter &Conformance))
      (when (and (= (c 'type-name) key) (= (c 'proto-name) proto)) (return true))))
  (return false))

; Stage 15 B4 — resolve a generic REFERENCE (a source spelling) through the
; file's import environment (name-resolution.md §8.2's R2; defect #5, "generics
; are unqualifiable").
;
; A generic is deliberately NOT re-keyed by namespace. R2 keeps one `Generic` per
; bare name with the methods of every flattened namespace merged into it, because
; that is what an open multimethod wants and it is what lets `(import-use dp)`
; and `(import-use dq)` — each declaring a `describe` method — coexist at all.
; The qualified spelling is recovered from `Method.src-ns` instead, the
; provenance W5e already records for the duplicate-signature diagnostic: `zx/zov`
; resolves to the bare `zov` generic with its method set filtered to `zn`, the
; namespace the prefix `zx` names.
;
; `qualifier-len` is the only cost on the unqualified path, which is every head
; symbol in this compiler and in `lib/`.
;
; Stage 15 W9 item 43 — the bare path filters too, and B4 deferring that is what
; let a PREFIXED import silently overrule the importing file's own definition: a
; file defining `helper (x:i64)` and calling `(helper 3)` emitted a call to a
; library's `helper (x:i32)` reached through a prefix the call never spells,
; because the merge R2 performs is over every namespace rather than over the
; flattened ones §8.2 actually names. The two paths now ask the same question of
; the same field — one namespace for a qualified spelling, the unqualified set
; for a bare one — which is what makes a prefix bind names under the prefix and
; under nothing else, for a generic as for every other kind (R3).
(defn generic-lookup-ref (spelling:Symbol):?&Generic
  (when (<= (qualifier-len spelling) 0)
    (let (g:?&Generic (generic-lookup spelling))
      (when (= g null) (return null))
      ; No file in this unit declared a namespace ⇒ every `src-ns` is `user` and
      ; the filter is provably the identity. Every build of this compiler and
      ; every program in `lib/` takes this exit — the same hatch
      ; `globals-lookup-ref` and `name-ref-key-count` take, and what makes this
      ; byte-identical rather than merely believed to be.
      (when (= g-ns-declared 0) (return g))
      (return (generic-filter-by-ns (unsafe/cast &Generic g) (symbol-none)))))
  (let (r:ref:NameRef (resolve-spelling spelling))
    ; A qualifier this file did not bind names nothing (R3) — the same answer the
    ; global, protocol and type resolvers give, so the diagnostic tiers agree.
    (when (= (r 'status) NR-UNBOUND) (return null))
    (let (g:?&Generic (generic-lookup-exact (r 'bare)))
      (when (= g null) (return null))
      (let (reach:Symbol (priv-reach-enter spelling)
            f:?&Generic (generic-filter-by-ns (unsafe/cast &Generic g) (r 'ns)))
        (set! g-priv-reach-ns reach)
        (return f)))))

; Allocate + initialise a Generic WITHOUT registering it. Split out in Stage 15
; W8 G-5 because `build-generics` — which is `g-generics`' own initializer —
; cannot append to `g-generics` while `g-generics` is still being computed.
; `generic-new` below is this plus the registration, so the two cannot drift.
(defn generic-alloc (name:Symbol):&Generic
  ; Each Generic is individually arena-allocated (pointer-stable for the whole
  ; compilation).
  (let (g:&Generic (new Generic))
    (set! (g 'name) name)
    (set! (g 'methods) (unsafe/cast &(Vector &Method) (vector-new-in &g-arena-alloc)))
    (set! (g 'finalized) 0)
    (set! (g 'mangled) 0)
    ; Stage 12 N4: snapshot the defining namespace's ir-prefix now, so a finalize
    ; or monomorphization that runs in a later import's namespace still mangles
    ; under this generic's own namespace.
    ; Stage 15 W5e: a file-private key (`#p1/helper`) carries its own synthetic
    ; namespace, whose registered prefix is what makes the emitted symbol both
    ; legal and unique — read it from the key rather than from g-current-ns
    ; (which is `user`, the empty prefix, for exactly these definitions).
    (match (priv-qualifier-of name)
      ((some pq) (set! (g 'ir-prefix) (ns-ir-prefix pq)))
      (none      (set! (g 'ir-prefix) (ns-ir-prefix g-current-ns))))
    (return g)))

; …and its pointer appended to g-generics in registration order.
(defn generic-find-or-new (key:Symbol):&Generic
  (let (g:?&Generic (generic-lookup-exact key))
    (when g (return g))
    (return (generic-new key))))

(defn generic-new (name:Symbol):&Generic
  (let (g:ref:Generic (generic-alloc name))
    (conj g-generics g)
    (return g)))

(defn generic-add-method (g:&Generic m:&Method):void
  (conj (g 'methods) m)
    ; A generic finalized by an earlier unit's prescan (its methods given their
    ; mangling) can gain more methods when a later `import` (processed in the
    ; dispatch loop, after this unit's signature prescan already finalized the
    ; generic) registers its own overloads of the same name. Without re-running
    ; finalize, those imported methods keep null ir-names and emit under the bare
    ; `@name`, colliding (e.g. a local parametric `next` finalizes the `next`
    ; generic, then `(import nucleus.iterator)` adds concrete `next` methods that never get
    ; mangled). Clearing `finalized` lets the import's finalize-generics re-mangle
    ; every method. Safe: this runs in the prescan/import phase, before any of the
    ; affected methods' bodies are emitted, so no already-emitted reference uses a
    ; stale ir-name.

  (set! (g 'finalized) 0))

; Remove the first METHOD-USER from generic `g` whose param count and types
; match `param-types`/`nparams`. No-op if not found. Called by the REPL to
; evict the old method entry before re-prescan'ing a redefined defn, so that
; finalize-generics does not see a duplicate-signature pair.
(defn generic-remove-matching-user-method (g:&Generic param-types:ptr nparams:i32):void
  (let (gg:&Generic g)
    (dotimes (i (unsafe/cast i32 (count (gg 'methods))))
      (let (mi:&Method (as &Method (invoke (gg 'methods) i:usize)))
        (when (and (= (mi 'kind) METHOD-USER)
                   (= (mi 'num-params) nparams)
                   (!= (params-type-eq (mi 'param-types) param-types nparams) 0))
          (remove-at (gg 'methods) i:usize)
          (return))))))

; Seed the operator family as intrinsic generics. Each intrinsic method defers
; to emit-binop (which performs the numeric type selection), so operator IR is
; byte-identical to the pre-dispatch compiler.
; Stage 15 W8 G-5 (§2.12 A2): folded into `g-generics`' initializer. It is the
; one statement of the old `compiler-init` that set no global of its own — it
; expressed a RELATION between two globals (seed g-generics from g-binops), and
; a builder is exactly the shape a relation wants. `g-binops` is declared above
; `g-generics` in nucleusc.nuc, so it is initialized first; `g-current-ns` had
; to be moved above them both, because `generic-alloc` reads it through
; `ns-ir-prefix`.
(defn build-generics ():&(Vector &Generic)
  (let (v:&(Vector &Generic) (vector-new-in &g-arena-alloc))
    (doseq (bop g-binops (VecIter &BinOp))
           (let (g:&Generic (generic-alloc (bop 'name))
                 m:&Method (new Method))
      (set! (m 'param-types) null)
      (set! (m 'num-params) 2)
      (set! (m 'ret-type) null)
      (set! (m 'has-rest) 0)
      (set! (m 'variadic) 0)
      (set! (m 'kind) METHOD-INTRINSIC)
      (set! (m 'ir-name) (symbol-none))
      (set! (m 'fn-type) null)
      (set! (m 'binop) (as ptr bop))
      (set! (m 'body) null)
      (generic-add-method g m)
      (conj v g)))
    (return v)))

; MC-1 (design/stage14/macro-conditional-casts.md): join two branch types for a
; value-position control-flow merge (cond / match arm / if-some phi). Three
; sites shared this logic verbatim (emit-cond, emit-match over unions,
; emit-niche-match-arm); this is the single source of truth.
;
; Rules:
;   - Equal types (type-eq): keep the type, meeting pointer kinds when TY-PTR
;     (identity when the kinds already agree) — the pre-existing behavior.
;   - Exactly one side an elem-less bare pointer (void*) and the other a typed
;     pointer: absorb to (ptr E), E = the typed side's elem. This is the
;     join-site analogue of the void*-flows-into-T* flow-check exemption
;     (pkind-flow-check, type-utils.nuc). The pkind is PTR-RAW *unconditionally*:
;     the elem-less side's pkind is an unaudited Phase-F default (quasiquote is
;     claimed PTR-REF yet can be null), so the join must never manufacture a
;     non-null claim — the absorbed value is unchecked (PTR-RAW).
;   - Two differently-kinded int types where exactly one side is a bare
;     literal (int-widening.md LW-6 follow-up, found during the LW-5 sweep):
;     adopt the OTHER (typed, non-literal) side's type — mirrors
;     binop-coerce's "an untyped literal adopts the other operand's type".
;     A literal's emitted operand text (a bare decimal constant, no register)
;     is valid LLVM IR at any integer width, so no coercion instruction is
;     needed — only the phi's declared type changes. Two literal branches of
;     different naive widths (e.g. an in-range and an out-of-range constant)
;     adopt the wider kind, same reasoning. Two *non-literal* typed branches
;     of different kinds are NOT widened here — that stays a real type error
;     (int-widening.md §3 non-goals: no implicit narrowing/mixed-sign
;     widening of typed values).
;   - Otherwise (genuinely different types, or a void branch): collapse to void.
;
; Lives in generics.nuc (not type-utils.nuc as the design sketch suggested)
; because it calls type-eq, which is defined here and is not yet in scope at
; type-utils.nuc's earlier import point; generics is imported before both
; union-emit and the nucleusc.nuc emit-cond site, so all three callers see it.
;
; result-lit/bty-lit: whether the Val that produced each side was an integer
; literal (Val.is-lit, LW-4). Callers accumulating across more than two
; branches thread the running "is everything folded in so far a literal"
; flag as `(and (!= result-lit 0) (!= bty-lit 0))` after each call — true
; only while every branch joined so far was itself a literal.
(defn type-join (result-type:ptr:Type bty:ptr:Type result-lit:i32 bty-lit:i32):ptr:Type
  ; Equal types: meet pointer kinds (identity when they already agree).
  (when (!= (type-eq result-type bty) 0)
    (when (= (result-type 'kind) TY-PTR)
      (return (type-as-pkind result-type
                (pkind-meet (ptr-pkind result-type) (ptr-pkind bty)))))
    (return result-type))
  ; Literal-vs-typed / literal-vs-literal int widening (LW-6).
  (when (and (!= (is-int-type result-type) 0) (!= (is-int-type bty) 0))
    (when (and (!= result-lit 0) (= bty-lit 0)) (return bty))
    (when (and (= result-lit 0) (!= bty-lit 0)) (return result-type))
    (when (and (!= result-lit 0) (!= bty-lit 0))
      (if (>= (type-size result-type) (type-size bty))
        (return result-type)
        (return bty))))
  ; Absorption: an elem-less bare ptr on exactly one side meets a typed ptr at
  ; (ptr E), E = the typed side's elem.
  (when (and (= (result-type 'kind) TY-PTR)
             (= (bty 'kind) TY-PTR))
    (let (relem:ptr (result-type 'elem)
          belem:ptr (bty 'elem))
      (when (and (= relem null) (!= belem null))
        (let (jt:ref:Type (make-type TY-PTR))
          (set! (jt 'elem) belem)
          (set! (jt 'pkind) PTR-RAW)
          (return jt)))
      (when (and (!= relem null) (= belem null))
        (let (jt:ref:Type (make-type TY-PTR))
          (set! (jt 'elem) relem)
          (set! (jt 'pkind) PTR-RAW)
          (return jt)))))
  ; Genuinely different types (or a void branch): collapse to void.
  (return ty-void))

(defn params-type-eq (pa:ptr pb:ptr n:i32):i32
  (dotimes (i n)
    (when (= (type-eq (aref (unsafe/cast &ptr pa) i) (aref (unsafe/cast &ptr pb) i)) 0)
      (return 0)))
  (return 1))

; Stage 17: `params-type-eq` for a CALL's argument tuple, additionally allowing a
; by-value struct argument to reach a parameter that is a pointer to exactly that
; struct — the implicit address-of. Separate from `params-type-eq`, which also
; answers "is this the same method?" at registration, where `(f x:P)` and
; `(f x:&P)` must stay two different methods.
;
; It runs as a SECOND tier-0 pass, after the strict one finds nothing, so an
; exact overload always wins and no existing call is re-routed. Tier 0 rather
; than the widening tier because this adjustment is exact: at tier 2 every other
; argument would also be free to widen, and `from-str`'s phantom selector — the
; whole mechanism that picks its overload — stops being unique.
; design/stage17-native-strings/borrow-conventions.md §3.4.
(defn params-accept-args (pa:ptr pb:ptr n:i32):i32
  (dotimes (i n)
    (let (pt:ptr:Type (aref (unsafe/cast &ptr pa) i)
          at:?&Type (aref (unsafe/cast &ptr pb) i))
      (when (= (type-eq pt at) 0)
        (when (= at null) (return 0))
        (when (or (!= (at 'kind) TY-STRUCT)
                  (!= (pt 'kind) TY-PTR)
                  (= (pt 'elem) null)
                  (= (type-eq (pt 'elem) at) 0))
          (return 0)))))
  (return 1))

; A safe, distinct IR token for a generic name. Operators (whose source symbols
; — `=`, `<`, `_+`, … — are not valid LLVM identifier characters and would
; collide under blanket underscore-sanitizing) map to readable mnemonics; a `?`/`!`
; in the name is mapped to `_QMARK`/`_BANG` by ir-name-token before the blanket
; sanitize handles any remaining stragglers. Used when a name carrying an
; operator method is overloaded and its methods must take mangled symbols (§10.3).
(defn op-name-token (name:Symbol):StrView
  (let (mnemonic:&(HashMap StrView StrView)
        {"_+" "add"
         "_-" "sub"
         "_*" "mul"
         "_/" "div"
         "%" "rem"
         "=" "eq"
         "!=" "ne"
         "<" "lt"
         "<=" "le"
         ">" "gt"
         ">=" "ge"
         "bit-and" "band"
         "bit-or" "bor"
         "bit-xor" "bxor"
         "bit-shl" "bshl"
         "bit-shr" "bshr"})
    (match (invoke mnemonic (symbol-as-view name))
      ((some res) (return res))
      (none (return (sanitize-for-ir (ir-name-token (symbol-as-view name))))))))

; "@prefix__name.tok1.tok2..." for an overloaded method. Stage 12 N4: the base
; token is the operator mnemonic of `fname` (so `=` → `eq`); the defining
; namespace's `ir-prefix` (threaded explicitly, since a monomorphization may be
; stamped while another namespace is current) is composed *before* the
; per-parameter `.tok` mangling, giving `@foo__eq.i32.i32` in namespace `foo`. The
; prefix is applied to the *mnemonic*, not the raw operator spelling. An empty
; prefix (the `user` namespace) is the identity → byte-identical bootstrap.
(defn mangle-fn-name (ir-prefix:Symbol fname:Symbol param-types:ptr nparams:i32):Symbol
  (let (acc:StrView (fstr "@" (ns-compose ir-prefix (op-name-token fname))))
    (dotimes (i nparams)
      (set! acc (fstr acc "." (type-mangle-token (aref (unsafe/cast &ptr param-types) i)))))
    (return (symbol-intern acc))))

; Stage 15 W9 item 23: the ir-prefix `m`'s symbol must carry. `Generic.ir-prefix`
; is snapshotted when the generic is CREATED, and R2 (name-resolution.md §8.2)
; keeps one `Generic` per bare name with the methods of every namespace merged
; into it — so that field names whichever namespace got there first, and is right
; only for the methods that namespace defined. A prefix is a property of the
; DEFINING NAMESPACE, so ask the method: `Method.src-ns` has been provenance
; since B4 (§9.6), which audited its writers for exactly this reason.
;
; A file-private key (`#p1/helper`) is the one exception and keeps the generic's
; prefix: W5e puts the synthetic per-file namespace in the KEY, while `src-ns`
; records the enclosing real namespace (`user`, for precisely these). Every
; method of such a generic comes from one file by construction, so the one
; snapshot is right for all of them.
(defn method-ir-prefix (g:?&Generic m:?&Method):Symbol
  (let (gg:ptr:Generic g
        mm:ptr:Method m)
    (match (priv-qualifier-of (gg 'name))
      ((some _) (return (gg 'ir-prefix)))
      (none 0))
    (let (ns:Symbol (mm 'src-ns))
      ; No src-ns is an intrinsic operator seed, which belongs to no file — the
      ; same convention method-in-ns states. Those are never mangled here.
      (when (symbol-none? ns) (return (gg 'ir-prefix)))
      (return (ns-ir-prefix ns)))))

; How many METHOD-USER methods of `g` would emit under `prefix`? Grouping by the
; emitted PREFIX rather than by the namespace name is deliberate: two namespaces
; that `set-ir-prefix` to the same string genuinely share one symbol space, and
; that is exactly when their same-named methods must take mangled names.
(defn generic-user-methods-with-prefix (g:&Generic prefix:Symbol):i32
  (let (gg:&Generic g
        n:i32 0)
    (dotimes (i (unsafe/cast i32 (count (gg 'methods))))
      (let (m:&Method (as &Method (invoke (gg 'methods) i:usize)))
        (when (and (= (m 'kind) METHOD-USER)
                   (= (method-ir-prefix g m) prefix))
          (inc! n))))
    (return n)))

; Stage 16 SE-2: the REFERENCE side, and it must not answer with a want-stamped
; instance — `(name, param-types)` does not identify one, so the first stamp of a
; return-only-tyvar template would be handed to every later call with a different
; want. Skipping sends the caller to tier 1, which re-binds from the want and
; reaches the discriminated memo. template-ref-equality.md §5.
(defn generic-find-method-exact (g:?&Generic param-types:ptr nparams:i32):?&Method
  (let (gg:ptr:Generic g)
    (dotimes (i (unsafe/cast i32 (count (gg 'methods))))
      (let (m:&Method (as &Method (invoke (gg 'methods) i:usize)))
        (when (and (= (m 'kind) METHOD-USER)
                   (= (m 'num-params) nparams)
                   (!= (params-type-eq (m 'param-types) param-types nparams) 0)
                   (= (method-is-want-stamped m) 0))
          (return (as ptr m)))))
    (return null)))

; The CALL-side companion, and only that: a second pass that also accepts an
; lvalue struct argument at a pointer-to-that-struct parameter, mirroring
; generic-resolve's tier-0 second pass so node-type answers with the method emit
; will pick. Never used on the definition side, where `(name, param-types)` must
; stay an exact key.
(defn generic-find-method-accepting (g:?&Generic param-types:ptr nparams:i32):?&Method
  (let (gg:ptr:Generic g)
    (dotimes (i (unsafe/cast i32 (count (gg 'methods))))
      (let (m:&Method (as &Method (invoke (gg 'methods) i:usize)))
        (when (and (= (m 'kind) METHOD-USER)
                   (= (m 'num-params) nparams)
                   (!= (params-accept-args (m 'param-types) param-types nparams) 0)
                   (= (method-is-want-stamped m) 0))
          (return (as ptr m)))))
    (return null)))

; The other half of that split: the want-stamped instance whose RETURN type is
; `ret` as well. Asked by the monomorphizer's memo probe and by `defn-ir-name`,
; both of which are naming a definition and therefore hold the whole key.
(defn generic-find-want-stamp (g:?&Generic param-types:ptr nparams:i32 ret:?&Type):?&Method
  (when (= ret null) (return null))
  (let (gg:ptr:Generic g)
    (dotimes (i (unsafe/cast i32 (count (gg 'methods))))
      (let (m:&Method (as &Method (invoke (gg 'methods) i:usize)))
        (when (and (= (m 'kind) METHOD-USER)
                   (= (m 'num-params) nparams)
                   (!= (params-type-eq (m 'param-types) param-types nparams) 0)
                   (!= (method-is-want-stamped m) 0)
                   (!= (type-eq (m 'ret-type) ret) 0))
          (return (as ptr m)))))
    (return null)))

; Stage 15 W9 item 35: the exact-signature method DEFINED BY namespace `ns`.
;
; Once two namespaces may each define one name with one signature, `(name,
; param-types)` stops being a key on the DEFINITION side — `(name, param-types,
; src-ns)` is the one that is. `defn-ir-name` asked the two-part question and got
; the first-registered namespace's method for both files, so `(ns qa)` and
; `(ns qb)` each emitted `define @qa__describe` and LLVM rejected the second: a
; duplicate symbol produced by the very change that was meant to give them two.
;
; A REFERENCE is unaffected and deliberately keeps the two-part lookup: it asks
; which method to CALL, and answers with the visibility filter (item 43) plus
; ordinary overload resolution.
(defn generic-find-method-exact-in-ns (g:?&Generic param-types:ptr nparams:i32 ns:Symbol):?&Method
  (let (gg:ptr:Generic g)
    (dotimes (i (unsafe/cast i32 (count (gg 'methods))))
      (let (m:&Method (as &Method (invoke (gg 'methods) i:usize)))
        (when (and (= (m 'kind) METHOD-USER)
                   (= (m 'num-params) nparams)
                   (!= (method-in-ns m ns) 0)
                   (!= (params-type-eq (m 'param-types) param-types nparams) 0)
                   (= (method-is-want-stamped m) 0))
          (return (as ptr m)))))
    ; No method of this namespace has that signature: fall back to the unfiltered
    ; answer, which is what every caller got before. The fallback cannot
    ; reintroduce the collision above — that one needs TWO namespaces to own the
    ; signature, and then each finds its own on the first pass.
    (return (generic-find-method-exact g param-types nparams))))

; Stage 11 T4: would a *generic* (METHOD-GENERIC) method of `g` resolve for the
; concrete `param-types`? Mirrors generic-resolve's tier-1 — bind the tyvars, then
; check the :where constraints — but does NOT instantiate (no MonoJob queued, no
; emission), so it is a pure side-effect-free conformance probe. Used by
; method-satisfies-sig so a required protocol method written generically over a
; parametric struct (`get`/`count` over `(Vector T)`) counts as satisfied for a
; stamped instance, exactly as the real call would resolve. On a match writes the
; method's *bound* return Type* through `out-ret` (the body return spelling with
; the tyvars substituted) so the caller can verify it against a required return.
; arg-nodes (LW-6): the call-site argument nodes, or null when this probe has no
; real call site (method-satisfies-sig's signature-only check) — threaded to
; generic-method-bind so a literal argument defers to :where assoc-recovery here
; exactly as it does on the emit side (node-type↔emit-node lockstep; otherwise
; node-type-call's probe below dies on a widened call before emission ever runs).
(defn generic-binds-for (g:?&Generic param-types:ptr nparams:i32 out-ret:&ptr line:i32 arg-nodes:ptr):i32
  (let (gg:ptr:Generic g)
    (dotimes (j (unsafe/cast i32 (count (gg 'methods))))
      (let (m:&Method (as &Method (invoke (gg 'methods) j:usize)))
        (when (= (m 'kind) METHOD-GENERIC)
          (let (bound:ptr (arena-alloc (* (+ (m 'num-tyvars) 1) (ptr-bytes))))
            (when (and (= (m 'num-params) nparams)
                       (!= (generic-method-bind (as ptr m) param-types nparams bound null arg-nodes) 0))
              (when (!= (generic-constraints-ok (as ptr m) bound line) 0)
                ; Resolve the bound return type from the method's return spelling
                ; (mirrors abstract-call-via-generic): a bare tyvar return picks
                ; its bound Type*, otherwise parse the (already-concrete) spelling.
                ; Shared with the adapted-template path (LW-2) via method-bound-ret-type.
                (set! @out-ret (method-bound-ret-type (as ptr m) bound line))
                (return 1)))))))
    (return 0)))

; Fixed parameter count of a defn param list: the raw count, minus one if a
; :rest marker is present (the marker itself is not a parameter).
(defn defn-params-count (params-node:?&Node):i32
  (let (nraw:i32 (node-len params-node)
        n:i32 (node-len params-node))
    (dotimes (i nraw)
      ; W5f: a malformed parameter may be NULL (an empty list `()` reads as a
      ; null node). `marker-named` is null-safe; the located diagnostic for a
      ; malformed parameter is emit-defn's job, not this counter's.
      (let (sp:?&Node (as ?&Node (node-at params-node i)))
        (when (!= (marker-named sp "rest") 0) (set! n (- n 1)))
        (when (!= (marker-named sp "optional") 0) (set! n (- n 1)))))
    (return n)))

; Does a defn param list carry a `:rest` marker? The two registration sites used
; to infer this from `(< (defn-params-count …) (node-len …))`, which is equally
; true of an `:optional` list — so every `:optional` defn registered has-rest = 1
; and its Method was skipped by the widening tiers (keyword-markers.md §7).
(defn defn-params-has-rest (params-node:?&Node):i32
  (let (found:i32 0)
    (dotimes (i (node-len params-node))
      ; W5f: see defn-params-count — a NULL (empty-list) parameter is not a
      ; marker and must not be dereferenced during the prescan.
      (let (sp:?&Node (as ?&Node (node-at params-node i)))
        (when (!= (marker-named sp "rest") 0) (set! found 1))))
    (return found)))

; The `:optional` count and default-expression array of a defn param list —
; the other two fields `emit-defn` puts on the function Type. The signature
; prescan registers a Type of its own, and `finalize-generics` binds it for a
; SOLITARY name, so a call emitted before the defn is checked and filled
; against it: without these an omitted optional was rejected `expected N args,
; got N-1` from anywhere above the definition. Conservative on a malformed
; `:optional` spec — emit-defn owns that located diagnostic.
(defn defn-params-set-opt (params-node:?&Node ft:&Type):void
  (let (nraw:i32 (node-len params-node)
        opt-idx:i32 -1)
    (dotimes (si nraw)
      (let (sp:?&Node (as ?&Node (node-at params-node si)))
        (when (!= (marker-named sp "optional") 0) (set! opt-idx si))))
    (when (= opt-idx -1) (return))
    (let (nopt:i32 (- (- nraw 1) opt-idx))
      (when (<= nopt 0) (return))
      (let (defaults:ptr (arena-alloc (* nopt (ptr-bytes)))
            ok:i32 1)
        (dotimes (k nopt)
          (let (p:ptr (node-at params-node (+ (+ opt-idx 1) k)))
            (if (and (!= p null) (node-is-list (as ?&Node p)) (= (node-len p) 2))
              (set! (aref (unsafe/cast &ptr defaults) k) (node-at p 1))
              (set! ok 0))))
        (when (!= ok 0)
          (set! (ft 'nopt) nopt)
          (set! (ft 'opt-defaults) defaults))))))

; The fixed parameter types of a defn param list as a ptr-array (:rest-aware:
; the :rest marker is skipped and the rest parameter is typed ptr). Shared by
; prescan, .nuch export, and method lookup so the three stay consistent.
(defn defn-params-to-types (params-node:?&Node):ptr
  (return (defn-params-to-types-at params-node 0)))

; `line` is blamed for a colon-spelled parameter, whose interned symbol has none.
(defn defn-params-to-types-at (params-node:?&Node line:i32):ptr
  (let (nraw:i32 (node-len params-node)
        has-rest:i32 0
        rest-idx:i32 -1
        opt-idx:i32 -1)
    (dotimes (si nraw)
      ; W5f: see defn-params-count — a NULL (empty-list) parameter is not a
      ; marker and must not be dereferenced during the prescan.
      (let (sp:?&Node (as ?&Node (node-at params-node si)))
        (when (!= (marker-named sp "rest") 0) (set! has-rest 1) (set! rest-idx si))
        (when (!= (marker-named sp "optional") 0) (set! opt-idx si))))
    (let (nparams:i32 nraw)
      (when (!= has-rest 0) (set! nparams (- nparams 1)))
      (when (!= opt-idx -1) (set! nparams (- nparams 1)))
      (let (ptypes:ptr null)
        (when (> nparams 0)
          (set! ptypes (arena-alloc (* nparams (ptr-bytes)))))
        (let (di:i32 0)
          (dotimes (i nraw)
            (let (skip:i32 0)
              (when (and (!= has-rest 0) (= i rest-idx)) (set! skip 1))
              (when (= i opt-idx) (set! skip 1))
              (when (= skip 0)
                (let (p:ptr (node-at params-node i)
                      pn:Symbol (symbol-none)
                      spec:ptr (node-at params-node i))
                  ; Optional params are (name:type default) lists — type is on the head.
                  (when (and (!= opt-idx -1) (> i opt-idx))
                    (set! spec (node-at p 0)))
                  ; W5f: a NULL (empty-list) parameter gets the same `i32`
                  ; placeholder this loop already uses for an untyped one — the
                  ; prescan only registers a signature; emit-defn raises the real,
                  ; located diagnostic before any of this reaches codegen.
                  (let (pty:ptr (if (= spec null)
                                  null
                                  (extract-name-and-type spec (as &Symbol &pn)
                                                         (node-line spec line))))
                    (when (= pty null) (set! pty ty-i32))
                    (when (and (!= has-rest 0) (= di (- nparams 1)))
                      (set! pty ty-ptr))
                    (set! (aref (unsafe/cast &ptr ptypes) di) pty)
                    (inc! di))))))
        (return ptypes))))))

; Register one defn signature as a USER method of its name's generic. Called
; from prescan-defn-signatures; mangling/scope binding is decided later by
; finalize-generics once the full method set per name is known.
(defn generic-register-method (fname:Symbol ret:?&Type param-types:ptr nparams:i32
                                   has-rest:i32 variadic:i32 body:?&Node):&Method
  ; Stage 15 W5e: a private definer in the default `user` namespace registers
  ; under its file's implicit-namespace key, so two files' private `helper`s are
  ; two Generics and neither the duplicate-signature check nor dispatch ever sees
  ; the other. Identity for a public definer → the registry, and the bootstrap,
  ; are unchanged. generic-lookup-exact (not generic-lookup) because the key is
  ; already final here: a public `helper` in a file that also defines a private
  ; one must not be folded into the private generic.
  (let (key:Symbol (priv-key-define fname)
        g:&Generic (generic-find-or-new key))
    ; It would replace the intrinsic everywhere, the prelude's macros included.
    ; Pointers are exempt: ordering a type through `&T` is how it conforms to Ord.
    (when (and (!= (builtin-op-result-type g param-types nparams) null)
               (!= (-> (aref (unsafe/cast &ptr param-types) 0) (unsafe/cast &Type _) (_ 'kind)) TY-PTR))
      (die-at (node-line (as ptr body) 0)
        (fstr "'" fname "' on (" (type-display (aref (unsafe/cast &ptr param-types) 0)) ", "
              (type-display (aref (unsafe/cast &ptr param-types) 1))
              ") is built in and cannot be redefined -- define it over a type of your own")))
    (let (ft:&Type (as &Type (make-type TY-FN)))
      (set! (ft 'ret) ret)
      (type-set-params ft param-types nparams)
      (set! (ft 'variadic) variadic)
      (set! (ft 'has-rest) has-rest)
      (let (m:ref:Method (new Method))
        (set! (m 'param-types) param-types)
        (set! (m 'num-params) nparams)
        (set! (m 'ret-type) ret)
        (set! (m 'has-rest) has-rest)
        (set! (m 'variadic) variadic)
        (set! (m 'kind) METHOD-USER)
        (set! (m 'ir-name) (symbol-none))
        (set! (m 'fn-type) (as ptr ft))
        (set! (m 'binop) null)
        (set! (m 'body) body)
        ; W5e: provenance for the duplicate-signature diagnostic, which must name
        ; the OTHER definition's file — a Method.body Node carries a line but no
        ; file — and phrase the namespace rule according to whether the pair is
        ; public or private.
        (set! (m 'src-file) g-source-path)
        (set! (m 'src-ns) g-current-ns)
        (set! (m 'src-imports) g-file-imports)
        (set! (m 'priv) g-defining-private)
        (generic-add-method g m)
        (return m)))))

; Stage 15 W5e: the message for two definitions of one name with identical
; parameter types. Both definitions' FILES are named (a Method.body Node carries a
; line but no file, which is why generic-register-method records src-file), and
; the note states the rule that was actually violated:
;
;   * a private pair can only reach here from an EXPLICIT namespace — in the
;     default `user` namespace W5e keys each file's private names separately, so
;     two files' private `helper`s are two Generics and never meet. So the note
;     for a private pair is precisely "privacy is per namespace, not per file".
;   * anything else is a public collision, which stays an error by design: a
;     public name must be unique across the whole unit.
(defn duplicate-signature-message (g:&Generic later:&Method earlier:&Method):StrView
  (let (gg:?&Generic g
        a:&Method later
        b:&Method earlier
        bare:Symbol (strip-priv-qualifier (gg 'name))
        bnode:?&Node (b 'body)
        bline:i32 0
        afile:Symbol (a 'src-file)
        bfile:Symbol (b 'src-file)
        ansname:Symbol (a 'src-ns))
    (when (!= bnode null) (set! bline ((unsafe/cast &Node bnode) 'line)))
    (when (symbol-none? afile) (set! afile (symbol-intern "<unknown file>")))
    (when (symbol-none? bfile) (set! bfile (symbol-intern "<unknown file>")))
    (when (symbol-none? ansname) (set! ansname g-ns-user))
    (let (head:StrView (fstr "duplicate definition of '" bare
                          "' — the same parameter types are already defined at "
                          (fstr bfile ":" bline))
          note:StrView "")
      (if (and (!= (a 'priv) 0) (!= (b 'priv) 0))
        (set! note (fstr "`defn-` makes a name private to its NAMESPACE, not to its file, and both definitions are in namespace '"
                         ansname "'. Rename one, or give one file an (ns ...) of its own."))
        (set! note (fstr "'" bare
                         "' is public, and a public name must be unique across the whole compilation unit. Declare one with `defn-` — in the default `user` namespace a private name is scoped to its own file, so the two files may each have their own — or rename one.")))
      (return (fstr head "\n  note: " note)))))

; Stage 15 W9 item 35: would these two methods of `g` emit into the SAME symbol
; space? Two same-signature definitions are a duplicate exactly when they are,
; and the test is the emitted ir-prefix rather than the namespace NAME for the
; reason `generic-user-methods-with-prefix` already states: two namespaces that
; `set-ir-prefix` to one string genuinely share a symbol space, and a pair there
; really would emit one `define` twice — which is the concrete harm R4's rule
; existed to prevent, stated as itself instead of as a proxy for itself.
(defn methods-share-symbol-space (g:?&Generic a:&Method b:&Method):i32
  (let (ap:Symbol (method-ir-prefix g a)
        bp:Symbol (method-ir-prefix g b))
    (when (symbol-none? ap) (return 1))
    (when (symbol-none? bp) (return 1))
    (when (= ap bp) (return 1))
    (return 0)))

; Stage 15 W9 item 24: where to point a two-definition diagnostic. A method
; registered from a `.nuch` `declare`/`defmethod` has no body, so it has no Node
; and no line; report the other definition's instead. Both files are named in the
; message either way, which is the part that identifies the pair.
(defn method-pair-line (later:&Method earlier:&Method):i32
  (let (a:&Method later
        b:&Method earlier)
    (when (!= (a 'body) null)
      (return (-> a (_ 'body) (unsafe/cast &Node _) (_ 'line))))
    (when (!= (b 'body) null)
      (return (-> b (_ 'body) (unsafe/cast &Node _) (_ 'line))))
    (return 0)))

; `file:line` of the definition `m` came from, for a two-candidate diagnostic.
(defn method-def-site (m:&Method):StrView
  (let (f:Symbol (m 'src-file)
        node:?&Node (m 'body)
        line:i32 0)
    (when (symbol-none? f) (set! f (symbol-intern "<unknown file>")))
    (when (!= node null) (set! line ((unsafe/cast &Node node) 'line)))
    (return (fstr f ":" line))))

; Stage 15 W9 item 35: the message for a bare reference that two namespaces
; answer equally well — the diagnostic that replaces R4's refusal of the pair at
; its definitions, moved to the only place that can tell whether it is a problem.
;
; Each candidate is named `<ns>/<name>`, which is a spelling this file can
; actually use: a candidate only reaches here if it survived the bare-visibility
; filter (item 43), so its namespace is this file's own, one it flattened — for
; which `<ns>/name` resolves as well as the bare name does (§8.3 row 1) — or
; `user`, which `resolve-spelling` binds in every file.
(defn ambiguous-method-message (g:?&Generic a:&Method b:&Method):StrView
  (let (gg:ptr:Generic g
        bare:Symbol (strip-priv-qualifier (gg 'name))
        ans:Symbol (a 'src-ns)
        bns:Symbol (b 'src-ns))
    (when (symbol-none? ans) (set! ans g-ns-user))
    (when (symbol-none? bns) (set! bns g-ns-user))
    (let (acand:StrView (fstr "'" (fstr ans "/" bare) "' (defined at " (method-def-site a)
                           ")")
          bcand:StrView (fstr "'" (fstr bns "/" bare) "' (defined at " (method-def-site b)
                           ")"))
      (return (fstr (fstr "ambiguous call to '" bare
                          "' — two namespaces define it for these argument types")
                    "\n  note: "
                    (fstr acand " and " bcand " both match; qualify the call to choose one"))))))

; A late registration (a top-level macro expansion) re-finalizes after emission
; has begun, so a method that already has a symbol may already be called by it.
(defn late-renamable? (m:&Method):bool
  (return (or (= g-late-prescan 0) (symbol-none? (m 'ir-name)))))

; A late overload makes a solitary name registry-dispatched. Its solitary binding
; goes, so a value reference behaves as it would for hand-written overloads.
(defn generic-unbind-solitary (gg:&Generic):void
  (dotimes (k (unsafe/cast i32 (count (gg 'methods))))
    (let (m:&Method (as &Method (invoke (gg 'methods) (as usize k))))
      (when (and (= (m 'ir-fixed) 0) (not (symbol-none? (m 'ir-name))))
        (scope-unbind-ir g-globals (symbol-as-view (m 'ir-name)))))))

; Decide mangling for every not-yet-finalized user generic. A solitary concrete
; name keeps its unmangled @name and is bound in g-globals (so forward references
; and the byte-identical single-function path keep working). An overloaded set —
; or any name carrying a bounded-generic template — gets mangled per-method names
; and dispatches through the registry (templates are stamped on demand).
(defn finalize-generics ():void
  (let (gi:i32 0)
    (while (< gi (unsafe/cast i32 (count g-generics)))
      (let (gg:&Generic (as &Generic (invoke g-generics (as usize gi))))
        (when (and (= (gg 'finalized) 0) (> (unsafe/cast i32 (count (gg 'methods))) 0))
          ; Tally the method kinds. An operator name carries an intrinsic seed
          ; method (§9.2); a user overload of that operator adds METHOD-USER
          ; methods alongside it (§10.3 operators-as-functions).
          (let (has-generic:i32 0
                has-intrinsic:i32 0
                n-user:i32 0
                gk:i32 0)
            (while (< gk (unsafe/cast i32 (count (gg 'methods))))
              (let (mk:&Method (as &Method (invoke (gg 'methods) (as usize gk))))
                (case (mk 'kind)
                  METHOD-GENERIC   (set! has-generic 1)
                  METHOD-INTRINSIC (set! has-intrinsic 1)
                  (inc! n-user)))
              (inc! gk))
            ; A pure operator (only intrinsic seeds, no user/generic methods) needs
            ; no mangling and dispatches via the emit-binop peephole. Leave it
            ; unfinalized so a later user overload (possibly from an import) is
            ; picked up; everything else finalizes now.
            (when (or (> n-user 0) (!= has-generic 0))
              (if (and (= has-intrinsic 0)
                       (= has-generic 0) (= n-user 1))
                (let (m0:&Method (as &Method (invoke (gg 'methods) 0)))
                  (set! (gg 'mangled) 0)
                  ; Stage 12 N4: a solitary (unmangled, C-callable) generic keeps
                  ; `@name`, namespace-prefixed in a non-`user` namespace. The
                  ; scope key (gg name) stays the bare/qualified storage key
                  ; (qualified by scope-define); only the ir-name is prefixed.
                  ; W5e: a file-private key (`#p1/helper`) carries its namespace
                  ; in the key itself, so the ir-name base is the BARE name and
                  ; the synthetic prefix (snapshotted into gg ir-prefix by
                  ; generic-new) supplies `a_p1__`. strip-priv-qualifier is the
                  ; identity for every non-private key.
                  ; Stage 15 W9 item 24: an imported method's symbol was decided
                  ; by the unit that DEFINED it, and its `g-globals` binding was
                  ; made by the declare with flags this rebind would drop
                  ; (extern-decl, noreturn). Nothing here is ours to decide.
                  (when (and (= (m0 'ir-fixed) 0) (late-renamable? m0))
                    (set! (m0 'ir-name) (symbol-intern (fstr "@"
                                              (def-compose (method-ir-prefix gg m0)
                                                     (ir-name-token (symbol-as-view (strip-priv-qualifier (gg 'name))))))))
                    (let (fs:&Sym (scope-define g-globals (gg 'name) (m0 'fn-type) (symbol-as-view (m0 'ir-name)) 0))
                      (when (!= (m0 'priv) 0) (set! (fs 'sym-private) 1)))))
                (do
                  (when (and (!= g-late-prescan 0) (= (gg 'mangled) 0))
                    (generic-unbind-solitary gg))
                  (set! (gg 'mangled) 1)
                  (let (i:i32 0)
                    (while (< i (unsafe/cast i32 (count (gg 'methods))))
                      (let (mi:&Method (as &Method (invoke (gg 'methods) i:usize)))
                        (when (= (mi 'kind) METHOD-USER)
                          (let (j:i32 0)
                            (while (< j i)
                              (let (mj:&Method (as &Method (invoke (gg 'methods) j:usize)))
                                ; Stage 15 W9 item 24: two DEFINITIONS in this
                                ; unit is the question; an imported method is a
                                ; reference to one somewhere else. Two headers
                                ; from different namespaces declaring the same
                                ; signature name two distinct symbols and were
                                ; always legal — they only meet here because the
                                ; registry is bare-keyed (R2).
                                ;
                                ; Stage 15 W9 item 35: and so are two DEFINITIONS,
                                ; for the identical reason — `@qa__describe` and
                                ; `@qb__describe` are two symbols, and refusing
                                ; them enforced "a public name must be unique
                                ; across the whole compilation unit", which is
                                ; true of one flat namespace and is the thing
                                ; namespaces exist to stop being true. What R4
                                ; was really protecting is the BARE reference,
                                ; and that is now answered where the ambiguity
                                ; actually arises: a bare spelling sees only the
                                ; namespaces this file can name unqualified
                                ; (item 43), and `generic-resolve` reports the
                                ; pair that survives at the use. R2 §8.2's own
                                ; first recommendation, which R4 overrode.
                                (when (and (= (mj 'kind) METHOD-USER)
                                           (= (methods-share-symbol-space gg mi mj) 1)
                                           (= (mi 'ir-fixed) 0) (= (mj 'ir-fixed) 0)
                                           (= (mi 'num-params) (mj 'num-params))
                                           (!= (params-type-eq (mi 'param-types)
                                                               (mj 'param-types)
                                                               (mi 'num-params)) 0))
                                  (die-at (method-pair-line mi mj)
                                    (duplicate-signature-message gg mi mj))))
                              (inc! j)))
                          ; Stage 15 W9 item 23: the prefix is the METHOD's, and
                          ; so is the decision to suffix at all. `mangled` on the
                          ; Generic means "dispatch through the registry", not
                          ; "every method's symbol carries `.tok`s" — the same
                          ; distinction fn-force-generic-mangled (nucleusc.nuc)
                          ; already relies on. A namespace that contributes ONE
                          ; method to this bare name is not overloading anything,
                          ; so its symbol is the solitary `@ns__name` it would
                          ; have had if the other namespace did not exist. That
                          ; is what makes a namespace's exported symbols a
                          ; property of the namespace rather than of whoever
                          ; else the compilation unit happens to contain: the
                          ; `.nuch` and the C header both declare the solitary
                          ; form, and before this they declared a symbol the
                          ; object did not define. Templates and operator seeds
                          ; keep the whole-generic test (has-generic /
                          ; has-intrinsic): a stamp is always suffixed.
                          ; Stage 15 W9 item 24: an imported method keeps the
                          ; symbol its defining unit emitted. It still COUNTS
                          ; above — a local overload sharing its prefix really
                          ; does share the name and must be mangled — so only
                          ; the rename is skipped, not the tally.
                          (when (and (= (mi 'ir-fixed) 0) (late-renamable? mi))
                            (let (pfx:Symbol (method-ir-prefix gg mi))
                              (if (and (= has-intrinsic 0) (= has-generic 0)
                                       (= (generic-user-methods-with-prefix gg pfx) 1))
                                (set! (mi 'ir-name) (symbol-intern (fstr "@"
                                                          (def-compose pfx
                                                 (ir-name-token (symbol-as-view (strip-priv-qualifier (gg 'name))))))))

                                (set! (mi 'ir-name) (mangle-fn-name pfx (strip-priv-qualifier (gg 'name))
                                                  (mi 'param-types) (mi 'num-params))))))))
                      (inc! i)))))
              (set! (gg 'finalized) 1)))))
      (inc! gi))))

; Can an argument of type `at` (an untyped int literal when is-lit≠0, an untyped
; float literal when is-flit≠0) be passed to a parameter of type `pt` by exact
; match or a safe widen / literal adaptation (§10.3 resolution tiers)? Widening
; never narrows a typed value; an untyped int literal adapts to any integer (and
; to a float) since its value is known, and since Stage 15 W2d an untyped float
; literal likewise adapts to a narrower float parameter.
(defn arg-adapts (at:ptr:Type pt:ptr:Type is-lit:i32 is-flit:i32):i32
  (when (= at null) (return 0))
  (when (!= (type-eq at pt) 0) (return 1))
  ; Stage 14 NS-3 (design/stage14/native-strings.md): a StrView (notably a string
  ; literal, which borrows to a char* for free) adapts to a **CStr** parameter in
  ; multimethod dispatch — and to CStr *only*, NOT to a bare `ptr`. This exactly
  ; reproduces the pre-flip dispatch of a CStr literal, which tier-0 exact-matched a
  ; CStr param but did NOT adapt to a `ptr` param (conventions.md: "pass a literal to
  ; a plain ptr function freely, but to a ptr multimethod cast explicitly"). Adapting
  ; to *both* CStr and bare ptr would make a generic overloaded on `(x:CStr)` and
  ; `(x:ptr)` ambiguous for a literal arg, where before the flip it resolved to the
  ; CStr overload. The collection literals `#{ "a" "b" }` / `[ "x" ]` still resolve:
  ; the reader infers a CStr element type (lib/reader.nuc lit-kind-type), so conj's
  ; bound `elem` param is CStr — this rule adapts the StrView literal to it. The
  ; compiler declares no StrView-parameter overload, so this cannot be ambiguous.
  (when (and (!= (type-is-strview at) 0)
             (= (pt 'kind) TY-CSTR))
    (return 1))
  (let (a-int:i32 (is-int-type at)   a-flt:i32 (is-float-type at)
        p-int:i32 (is-int-type pt)   p-flt:i32 (is-float-type pt))
    (when (and (!= a-int 0) (!= p-int 0))
      (when (!= is-lit 0) (return 1))
      (when (and (>= (int-width pt) (int-width at)) (= (is-unsigned at) (is-unsigned pt)))
        (return 1))
      (return 0))
    (when (and (!= a-flt 0) (!= p-flt 0))
      (when (>= (float-width pt) (float-width at)) (return 1))
      ; Stage 15 W2d (design/stage15-stress-test/literal-typing.md §3.6): an
      ; untyped float literal adapts DOWN to a narrower float parameter, exactly
      ; as an untyped int literal adapts to any integer above. Without this a
      ; solitary `(defn take (x:f32) …)` accepted `(take 2.5)` while an
      ; *overloaded* one rejected it ("no matching method … (f64)") — the same
      ; wart one level over that W2b closed for `defenum` members. Strictly
      ; additive: tier 0 (generic-find-method-exact) still claims an exact f64
      ; overload first, so no existing call is re-routed; this only turns
      ; previously-unresolvable calls into resolvable ones. A typed f64 VALUE
      ; still does not adapt — dispatch never narrows a runtime value, the same
      ; rule the integer branch above enforces with its int-width test, and
      ; deliberately stricter than the silent `fptrunc` coerce-int-val performs
      ; once the callee has already been chosen.
      (if (!= is-flit 0) (return 1) (return 0)))
    (when (and (!= a-int 0) (!= p-flt 0))
      (if (!= is-lit 0) (return 1) (return 0))))
  (return 0))

; Build a comma-separated string of type spellings for a diagnostic, e.g.
; "StrView, ptr". argtypes is the parallel array of Type* used by generic-resolve.
(defn arg-type-spellings (argtypes:ptr nargs:i32):StrView
  (let ((acc String) (str-alloc (strfmt-alloc) ""))
    (dotimes (i nargs)
      (when (!= i 0) (str-into acc ", "))
      ; FP-3: a *message*, so type-display — a fn-pointer argument printed as
      ; the `__fnty_N` registry key named nothing the caller wrote.
      (str-into acc (type-display (aref (unsafe/cast &ptr argtypes) i))))
    (return (string-as-view acc))))

; Select the method of a generic for a concrete argument-type tuple.
; Tier 0: an exact concrete method (type-eq on every param) — concrete beats
; generic (§8.6). Tier 1: a bounded-generic template whose type variables bind
; consistently and whose bound types satisfy the :where protocol constraints;
; on a unique tier-1 match the template is monomorphized (stamped + cached) and
; the resulting concrete method returned. Tier 2: a concrete method reachable by
; a safe widen / untyped-int-literal adaptation on every argument (§10.3); the
; caller (emit-generic-call) coerces the args to the chosen params. arg-nodes is
; the parallel array of argument source nodes (or null) used to spot literals.
(defn generic-resolve (g:?&Generic argtypes:ptr arg-nodes:ptr nargs:i32 line:i32 want:?&Type
                       scope:?&Scope):&Method
  (let (gg:ptr:Generic g
        infer-tyvar:Symbol (symbol-none)
        constraint-fail:i32 0)
    (when-some (m (generic-resolve-tiers g argtypes arg-nodes nargs line want
                                         &infer-tyvar &constraint-fail))
      (return m))
    ; Asked only once the `&S` reading has failed, so no resolving call moves.
    (let (lt:ptr (literal-arg-types argtypes arg-nodes nargs scope)
          i2:Symbol (symbol-none)
          c2:i32 0)
      (when (!= lt null)
        (when-some (m (generic-resolve-tiers g lt arg-nodes nargs line want &i2 &c2))
          (return m))))
    (let (bsaved:BindCall (bind-call-arm (gg 'name) line))
      (refuse-unknown-where gg nargs)
      (set! g-bind-call bsaved))
    (when (= (symbol-none? infer-tyvar) false)
      (die-at line
        (fstr "cannot infer type variable '" infer-tyvar "' for '" (gg 'name)
              "': no expected type at this position — annotate the binding")))
    (when (!= constraint-fail 0)
      (die-at line
        (fstr "no matching method for '" (gg 'name)
              "': arguments do not satisfy the required protocol constraint")))
    (die-at line (fstr "no matching method for overloaded '" (gg 'name)
                       "' with argument types (" (arg-type-spellings argtypes nargs) ")"
                       (unreachable-method-note gg argtypes nargs)
                       (candidate-notes gg argtypes arg-nodes nargs line)))))

; The exact method the import environment filtered out of `gg`, named by its
; namespace, or "" — the one fix "no matching method" otherwise hides.
(defn unreachable-method-note (gg:ptr:Generic argtypes:ptr nargs:i32):StrView
  (when-some (full (generic-lookup (gg 'name)))
    (when-some (m (generic-find-method-exact full argtypes nargs))
      (let (ns:Symbol (m 'src-ns))
        (when (and (not (symbol-none? ns)) (= (ns-reachable-bare ns) 0))
          (return (fstr "\n  note: a method in namespace '" ns
                        "' takes these arguments, and this file does not import it"))))))
  (return ""))

; ============================================================
; The no-match diagnostic's notes: the overloads that take the first argument,
; and why the rest do not fit (design/stage21-cleanup/no-match-candidates.md).
; ============================================================

; `&t` for a by-value struct `t`, else null.
(defn struct-value-ref-type (t:ptr:Type):?&Type
  (when (or (= t null) (!= (t 'kind) TY-STRUCT)) (return null))
  (let (pt:&Type (make-ptr-type PTR-REF))
    (set! (pt 'elem) t)
    (return pt)))

; Does template `m`'s receiver pattern unify with `ct`? Writes only `bound`.
(defn template-receiver-binds (m:&Method ct:?&Type bound:ptr):i32
  (let (ptn:?&Node (binding-type-node (node-at (node-at (m 'body) 2) 0)))
    (when (= ptn null) (return 0))
    (dotimes (k (m 'num-tyvars)) (set! (aref (unsafe/cast &ptr bound) k) null))
    (let (here:NameEnv (method-env-enter m)
          hit:i32 (unify-tpat ptn ct (m 'tyvars) (m 'num-tyvars) bound ((m 'body) 'line)))
      (name-env-set here)
      (return hit))))

; How `m` takes the first argument: 1 as given (a concrete method's implicit
; address-of included), 2 only as `&` of it, else 0. Fills `bound` for a template.
(defn method-receiver-fit (m:&Method argtypes:ptr bound:ptr):i32
  (when (= (m 'num-params) 0) (return 0))
  (when (= (m 'kind) METHOD-USER)
    (return (params-accept-args (m 'param-types) argtypes 1)))
  (when (!= (m 'kind) METHOD-GENERIC) (return 0))
  (let (ct:ptr (aref (unsafe/cast &ptr argtypes) 0))
    (when (!= (template-receiver-binds m ct bound) 0) (return 1))
    (let (rt:?&Type (struct-value-ref-type ct))
      (when (and (!= rt null) (!= (template-receiver-binds m rt bound) 0)) (return 2))))
  (return 0))

(defn arg-node-at (arg-nodes:ptr i:i32):?&Node
  (when (= arg-nodes null) (return null))
  (return (as ?&Node (aref (unsafe/cast &ptr arg-nodes) i))))

; Only a binding has an address to take (borrow-conventions.md §3.4).
(defn address-hint (arg:?&Node):StrView
  (when (and (!= arg null) (= (arg 'kind) NODE-SYM))
    (return (fstr "pass &" (arg 's))))
  (return "bind it to a name and pass &name"))

; Why an argument of type `at` does not reach parameter type `pt`, which
; `arg-adapts` has already refused, with the fix when there is one.
(defn arg-mismatch-reason (at:ptr:Type pt:ptr:Type arg:?&Node):StrView
  (let (a:StrView (type-display at)
        p:StrView (type-display pt))
    (when (and (!= (is-int-type at) 0) (!= (is-int-type pt) 0))
      (when (< (int-width pt) (int-width at))
        (return (fstr a " is wider than " p " -- narrow it with (unsafe/cast " p " ...)")))
      (return (fstr a " does not convert to " p " implicitly ("
                    (if (!= (is-unsigned at) 0) "unsigned to signed" "signed to unsigned")
                    ") -- use (as " p " ...)")))
    (when (and (!= (is-float-type at) 0) (!= (is-float-type pt) 0))
      (return (fstr a " is wider than " p " -- narrow it with (unsafe/cast " p " ...)")))
    (when (or (and (!= (is-int-type at) 0) (!= (is-float-type pt) 0))
              (and (!= (is-float-type at) 0) (!= (is-int-type pt) 0)))
      (return (fstr a " does not convert to " p " implicitly -- use (unsafe/cast " p " ...)")))
    (when (and (= (at 'kind) TY-STRUCT) (= (pt 'kind) TY-PTR) (!= (pt 'elem) null)
               (!= (type-eq (pt 'elem) at) 0))
      (return (fstr "takes " p ", not a " a " value -- " (address-hint arg))))
    (return (fstr a " is not " p))))

(defn arg-adapts-at (at:ptr:Type pt:ptr:Type arg:?&Node):i32
  (let (is-lit:i32 (node-is-int-literal arg)
        is-flit:i32 (if (= is-lit 0) (node-is-float-literal arg) 0))
    (return (arg-adapts at pt is-lit is-flit))))

(defn arity-reason (m:&Method nargs:i32):StrView
  (when (or (!= (m 'has-rest) 0) (= (m 'num-params) nargs)) (return ""))
  (return (fstr "takes " (m 'num-params) " arguments, not " nargs)))

; A concrete method's reasons for the arguments after the first. Its implicit
; address-of is tier 0's exact pass, so it cannot combine with a widening.
(defn user-method-reasons (m:&Method argtypes:ptr arg-nodes:ptr nargs:i32):StrView
  (let (ar:StrView (arity-reason m nargs))
    (when (not (str-empty? &ar)) (return ar)))
  (let ((acc String) (str-alloc (strfmt-alloc) "")
        addr:i32 -1
        widened:ptr (arena-alloc (* (+ nargs 1) 4)))
    (dotimes (i nargs)
      (let (at:ptr (aref (unsafe/cast &ptr argtypes) i)
            pt:ptr (aref (unsafe/cast &ptr (m 'param-types)) i)
            arg:?&Node (arg-node-at arg-nodes i))
        (set! (aref (unsafe/cast &i32 widened) i) 0)
        (cond
          (!= (type-eq at pt) 0) 0
          (!= (params-accept-args (unsafe/ptr+ (unsafe/cast &ptr (m 'param-types)) i)
                                  (unsafe/ptr+ (unsafe/cast &ptr argtypes) i) 1) 0)
            (when (< addr 0) (set! addr i))
          (!= (arg-adapts-at at pt arg) 0) (set! (aref (unsafe/cast &i32 widened) i) 1)
          (> i 0)
            (str-into acc (fstr (if (str-empty? &acc) "" "; ") "argument " (+ i 1) ": "
                                (arg-mismatch-reason at pt arg))))))
    (when (and (str-empty? &acc) (>= addr 0))
      (dotimes (i nargs)
        (when (!= (aref (unsafe/cast &i32 widened) i) 0)
          (let (p:StrView (type-display (aref (unsafe/cast &ptr (m 'param-types)) i)))
            (str-into acc (fstr (if (str-empty? &acc) "" "; ") "argument " (+ i 1) ": must be exactly "
                                p " while argument " (+ addr 1) " is passed by address -- use (as "
                                p " ...), or " (address-hint (arg-node-at arg-nodes addr))))))))
    (return (string-as-view acc))))

(defn unify-or-restore (ptn:?&Node at:?&Type m:&Method bound:ptr saved:ptr line:i32):i32
  (let (ntv:i32 (m 'num-tyvars))
    (dotimes (k ntv) (set! (aref (unsafe/cast &ptr saved) k) (aref (unsafe/cast &ptr bound) k)))
    (when (!= (unify-tpat ptn at (m 'tyvars) ntv bound line) 0) (return 1))
    (dotimes (k ntv) (set! (aref (unsafe/cast &ptr bound) k) (aref (unsafe/cast &ptr saved) k)))
    (return 0)))

; A template's reasons: bind the type variables as generic-method-bind-adapt's
; pass 1 does — literals never bind — then name each argument that neither
; unifies nor adapts. A struct value may bind as its `&`, so the reason can say
; to take its address. Empty when the binding stays incomplete.
(defn template-method-reasons (m:&Method argtypes:ptr arg-nodes:ptr nargs:i32
                                         bound:ptr line:i32):StrView
  (let (ar:StrView (arity-reason m nargs))
    (when (not (str-empty? &ar)) (return ar)))
  (let ((acc String) (str-alloc (strfmt-alloc) "")
        params-node:?&Node (node-at (m 'body) 2)
        ntv:i32 (m 'num-tyvars)
        tl:i32 (method-text-line m line)
        ; 0 unmatched, 1 unified, 2 unified only as `&` of a struct value
        matched:ptr (arena-alloc (* (+ nargs 1) 4))
        saved:ptr (arena-alloc (* (+ ntv 1) (ptr-bytes)))
        here:NameEnv (method-env-enter m))
    (dotimes (i nargs)
      (let (arg:?&Node (arg-node-at arg-nodes i)
            at:ptr (aref (unsafe/cast &ptr argtypes) i)
            lit:bool (or (!= (node-is-int-literal arg) 0) (!= (node-is-float-literal arg) 0))
            ptn:?&Node (binding-type-node (node-at params-node i))
            rt:?&Type (struct-value-ref-type at))
        (set! (aref (unsafe/cast &i32 matched) i) 0)
        (cond
          ; The receiver fit already bound from it, unless it was a literal.
          (= i 0) (if lit
                    (dotimes (k ntv) (set! (aref (unsafe/cast &ptr bound) k) null))
                    (set! (aref (unsafe/cast &i32 matched) i) 1))
          lit 0
          (!= (unify-or-restore ptn at m bound saved tl) 0)
            (set! (aref (unsafe/cast &i32 matched) i) 1)
          (and (!= rt null) (!= (unify-or-restore ptn rt m bound saved tl) 0))
            (set! (aref (unsafe/cast &i32 matched) i) 2))))
    (when (= (count-bound bound ntv) ntv)
      (dotimes (i nargs)
        (when (!= (aref (unsafe/cast &i32 matched) i) 1)
          (let (at:ptr (aref (unsafe/cast &ptr argtypes) i)
                pt:?&Type (resolve-param-type-bound (binding-type-node (node-at params-node i))
                                                    (m 'tyvars) bound ntv tl)
                arg:?&Node (arg-node-at arg-nodes i))
            (when (and (!= pt null) (= (arg-adapts-at at pt arg) 0))
              (str-into acc (fstr (if (str-empty? &acc) "" "; ") "argument " (+ i 1) ": "
                                  (arg-mismatch-reason at pt arg))))))))
    (name-env-set here)
    (return (string-as-view acc))))

(defn param-name-display (pn:?&Node):StrView
  (when (and (!= pn null) (= (pn 'kind) NODE-LIST))
    (let (h:?&Node (node-at pn 0))
      (when (and (!= h null) (= (h 'kind) NODE-SYM)) (return (symbol-as-view (h 's))))))
  (return "_"))

; `(name T …):R` for a concrete method; a template's `(name p:T …):R`, with the
; types `bound` fixes when it fixes every type variable, else as written.
(defn method-signature-display (gname:Symbol m:&Method bound:ptr line:i32):StrView
  (let ((acc String) (str-alloc (strfmt-alloc) "(" gname))
    (if (= (m 'kind) METHOD-USER)
      (do
        (dotimes (i (m 'num-params))
          (str-into acc " " (type-display (aref (unsafe/cast &ptr (m 'param-types)) i))))
        (str-into acc "):" (type-display (m 'ret-type))))
      (let (params-node:?&Node (node-at (m 'body) 2)
            ntv:i32 (m 'num-tyvars)
            all:bool (= (count-bound bound ntv) ntv)
            tl:i32 (method-text-line m line)
            here:NameEnv (method-env-enter m))
        (dotimes (i (m 'num-params))
          (let (pn:?&Node (node-at params-node i)
                tn:?&Node (binding-type-node pn))
            (str-into acc " " (param-name-display pn) ":")
            (if all
              (str-into acc (type-display (resolve-param-type-bound tn (m 'tyvars) bound ntv tl)))
              (let (s:String (node-str tn)) (str-into acc (string-as-view &s))))))
        (name-env-set here)
        (if all
          (str-into acc "):" (type-display (method-bound-ret-type m bound line)))
          (let (rn:?&Node (defn-ret-node (m 'body)))
            (if (= rn null)
              (str-into acc "):void")
              (let (s:String (node-str rn)) (str-into acc "):" (string-as-view &s))))))))
    (return (string-as-view acc))))

(defn method-site (m:&Method):StrView
  (when (!= (m 'body) null) (return (method-def-site m)))
  (when (symbol-none? (m 'src-file)) (return "<unknown file>"))
  (return (symbol-as-view (m 'src-file))))

; Notes for a failed overloaded call: each method that takes the first argument
; and why the rest do not fit; failing any, one that takes it only by address.
(defn candidate-notes (g:ptr:Generic argtypes:ptr arg-nodes:ptr nargs:i32 line:i32):StrView
  (when (= nargs 0) (return ""))
  (let ((acc String) (str-alloc (strfmt-alloc) "")
        shown:i32 0
        more:i32 0
        by-ref:?&Method null
        by-ref-bound:ptr null)
    (dotimes (k (unsafe/cast i32 (count (g 'methods))))
      (let (m:&Method (as &Method (invoke (g 'methods) k:usize)))
        (when (= (m 'origin-template) null)
          (let (bound:ptr (arena-alloc (* (+ (m 'num-tyvars) 1) (ptr-bytes)))
                fit:i32 (method-receiver-fit m argtypes bound))
            (when (and (= fit 2) (= by-ref null))
              (set! by-ref m)
              (set! by-ref-bound bound))
            (when (= fit 1)
              (if (>= shown 8)
                (inc! more)
                (let (why:StrView (if (= (m 'kind) METHOD-USER)
                                    (user-method-reasons m argtypes arg-nodes nargs)
                                    (template-method-reasons m argtypes arg-nodes nargs bound line)))
                  (str-into acc "\n  note: " (method-site m) ": "
                            (method-signature-display (g 'name) m bound line))
                  (when (not (str-empty? &why)) (str-into acc " -- " why))
                  (inc! shown))))))))
    (when (> more 0) (str-into acc (fstr "\n  note: and " more " more")))
    (when (and (= shown 0) (!= by-ref null))
      (let (bm:&Method (unsafe/cast &Method by-ref))
        (str-into acc "\n  note: " (method-site bm) ": "
                  (method-signature-display (g 'name) bm by-ref-bound line)
                  " takes the first argument by reference -- "
                  (address-hint (arg-node-at arg-nodes 0)))))
    (return (string-as-view acc))))

; A `(S …)` literal argument is `(ref S)` over a stack slot, so a by-value `S`
; parameter may take it, as a plain call's does. Resolved as `emit-dispatch` resolves the head.
(defn arg-struct-literal? (n:?&Node at:?&Type scope:?&Scope):bool
  (when (or (= n null) (= at null) (!= (node-kind n) NODE-LIST) (= (node-len (as ptr n)) 0))
    (return false))
  (when (or (!= (at 'kind) TY-PTR) (= (at 'elem) null)
            (!= (-> (at 'elem) (unsafe/cast &Type _) (_ 'kind)) TY-STRUCT))
    (return false))
  (let (head:ptr:Node (node-first n)
        sd:ptr (-> (at 'elem) (unsafe/cast &Type _) (_ 'sdef)))
    (when (= (node-kind head) NODE-LIST)
      (let (hcar:ptr:Node (node-first head))
        (return (and (= (node-kind hcar) NODE-SYM)
                     (!= (as ptr (struct-template-lookup-ref (hcar 's))) null)))))
    (when (or (!= (node-kind head) NODE-SYM) (!= (find-macro (head 's)) null)) (return false))
    (if-some (hit (binding-find (head 's) scope BK-DISPATCH-FIRST BINDING-KIND-COUNT 0 NK-NONE))
      (return (and (= (hit 'kind) BK-STRUCT) (= (hit 'payload) sd)))
      (return false))))

; `argtypes` with each struct-literal argument read as its struct, or null when none is one.
(defn literal-arg-types (argtypes:ptr arg-nodes:ptr nargs:i32 scope:?&Scope):ptr
  (when (= arg-nodes null) (return null))
  (let (out:ptr null)
    (dotimes (i nargs)
      (let (at:ptr:Type (aref (unsafe/cast &ptr argtypes) i))
        (when (arg-struct-literal? (aref (unsafe/cast &ptr arg-nodes) i) at scope)
          (when (= out null)
            (set! out (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes))))
            (dotimes (k nargs) (set! (aref (unsafe/cast &ptr out) k) (aref (unsafe/cast &ptr argtypes) k))))
          (set! (aref (unsafe/cast &ptr out) i) (at 'elem)))))
    (return out)))

; generic-resolve's three tiers; null when none resolves, with the reason a
; diagnostic needs left in `out-infer` / `out-cfail`.
(defn generic-resolve-tiers (g:?&Generic argtypes:ptr arg-nodes:ptr nargs:i32 line:i32 want:?&Type
                             out-infer:&Symbol out-cfail:&i32):?&Method
  (let (gg:ptr:Generic g
        found:?&Method null)
    ; Pass 0 is strict type-eq; pass 1 additionally lets a struct value reach a
    ; pointer-to-that-struct parameter (params-accept-args). Two passes, not one
    ; loosened test, so an exact overload always beats the address adjustment.
    (dotimes (pass 2)
     (when (= found null)
      (dotimes (i (unsafe/cast i32 (count (gg 'methods))))
       (let (m:&Method (as &Method (invoke (gg 'methods) i:usize)))
        ; SE-2: tier 0 is `generic-find-method-exact` written out, and it needs
        ; that function's skip for the same reason — a want-stamped instance is
        ; not identified by the argument tuple. Falling through to tier 1 re-binds
        ; it from the want. template-ref-equality.md §5.
        (when (and (= (m 'kind) METHOD-USER)
                   (= (m 'num-params) nargs)
                   (!= (if (= pass 0)
                         (params-type-eq (m 'param-types) argtypes nargs)
                         (params-accept-args (m 'param-types) argtypes nargs)) 0)
                   (= (method-is-want-stamped m) 0))
          ; Stage 15 W9 item 35: two tier-0 matches that emit into DIFFERENT
          ; symbol spaces are two different functions, and this reference names
          ; both equally well. Reporting it here is the other half of allowing
          ; the definitions: R4 refused the pair at the definition so that this
          ; loop could keep silently taking the last one, and the honest split is
          ; R2 §8.2's — define freely, and answer at the ambiguous USE, which is
          ; the only place that knows which namespaces the asking file flattened.
          ; A pair sharing a symbol space is one function declared twice (a file
          ; importing its own `.nuch`), so it is not a choice at all.
          (when (and (!= found null)
                     (= (methods-share-symbol-space gg (unsafe/cast &Method found)
                                                    m) 0))
            (die-at line (ambiguous-method-message gg (unsafe/cast &Method found) m)))
          (set! found (as ptr m)))))))
    (when (!= found null) (return found))
    ; tier 1: bounded-generic templates.
    (let (cand:ptr null
          cand-bound:ptr null
          ncand:i32 0
          constraint-fail:i32 0
          ; TC-1: track a generic template that carries a tyvar no parameter
          ; determines (a return-only tyvar). If resolution fails and such a
          ; candidate exists, the call needed the want channel (which was null or
          ; did not unify) — report the dedicated "cannot infer" diagnostic
          ; instead of the misleading "no matching method".
          infer-tyvar:Symbol (symbol-none)
          bsaved:BindCall (bind-call-arm (gg 'name) line))
      (dotimes (j (unsafe/cast i32 (count (gg 'methods))))
        (let (m:&Method (as &Method (invoke (gg 'methods) j:usize)))
          (when (= (m 'kind) METHOD-GENERIC)
            (let (bound:ptr (arena-alloc (* (+ (m 'num-tyvars) 1) (ptr-bytes))))
              (if (!= (generic-method-bind (as ptr m) argtypes nargs bound want arg-nodes) 0)
                (if (!= (generic-constraints-ok (as ptr m) bound line) 0)
                  (do (set! cand (as ptr m)) (set! cand-bound bound) (inc! ncand))
                  (set! constraint-fail 1))
                ; Bind failed: if this template has a return-only tyvar, record
                ; its name for the cannot-infer diagnostic.
                (match (method-undetermined-tyvar (as ptr m))
                  ((some ut) (when (symbol-none? infer-tyvar) (set! infer-tyvar ut)))
                  (none 0)))))))
      (set! g-bind-call bsaved)
      (when (> ncand 1)
        (die-at line (fstr "ambiguous generic match for '" (gg 'name) "'")))
      (when (= ncand 1)
        (return (generic-instantiate g cand cand-bound argtypes nargs line)))
      ; tier 2: widen / untyped-int-literal adaptation (§10.3). Concrete
      ; (METHOD-USER) methods and parametric-struct templates (METHOD-GENERIC,
      ; LW-1) share one ambiguity pool; a unique template winner is monomorphized
      ; here against its tyvar-substituted parameter types.
      (let (wmethod:ptr null
            wbound:ptr null
            bsaved2:BindCall (bind-call-arm (gg 'name) line)
            r:i32 (generic-resolve-adapt-tier g argtypes arg-nodes nargs line
                    (as &ptr &wmethod) (as &ptr &wbound) want))
        (set! g-bind-call bsaved2)
        (when (= r 3)
          (die-at line (fstr "ambiguous overload for '" (gg 'name) "' under argument widening")))
        (when (= r 1) (return (unsafe/cast &Method wmethod)))
        (when (= r 2)
          (return (generic-instantiate g wmethod wbound
                    (subst-param-types-bound wmethod wbound line) nargs line))))
      (set! @out-infer infer-tyvar)
      (set! @out-cfail constraint-fail)
      (return null))))

; Resolve an operator call to a USER overload (exact, then a unique widen/literal
; match), or null to fall back to the built-in numeric/pointer peephole. Unlike
; generic-resolve this never dies — an unmatched operator is the common case and
; simply uses its intrinsic seed. Shared by emit (call vs inline) and node-type
; (the overload's return type vs the intrinsic's) so the two cannot drift.
(defn operator-user-resolve (g:?&Generic argtypes:ptr arg-nodes:ptr nargs:i32):?&Method
  (let (gg:ptr:Generic g)
    (dotimes (i (unsafe/cast i32 (count (gg 'methods))))
      (let (m:&Method (as &Method (invoke (gg 'methods) i:usize)))
        (when (and (= (m 'kind) METHOD-USER)
                   (= (m 'num-params) nargs)
                   (!= (params-type-eq (m 'param-types) argtypes nargs) 0))
          (return (as ptr m)))))
    ; An exact intrinsic outranks a widened user method, as in valid-resolve-type.
    (when (!= (builtin-op-result-type g argtypes nargs) null) (return null))
    (let (wcand:ptr null
          wn:i32 0)
      (dotimes (k (unsafe/cast i32 (count (gg 'methods))))
        (let (m:&Method (as &Method (invoke (gg 'methods) k:usize)))
          (when (and (= (m 'kind) METHOD-USER)
                     (= (m 'has-rest) 0) (= (m 'num-params) nargs))
            (let (ok:i32 1)
              (dotimes (a nargs)
                (let (is-lit:i32 0
                      is-flit:i32 0)
                  (when (!= arg-nodes null)
                    (set! is-lit (node-is-int-literal (aref (unsafe/cast &ptr arg-nodes) a)))
                    ; W2d: mutually exclusive, and node-is-float-literal
                    ; macroexpands a cell operand — skip the second walk when the
                    ; first already answered.
                    (when (= is-lit 0)
                      (set! is-flit (node-is-float-literal (aref (unsafe/cast &ptr arg-nodes) a)))))
                  (when (= (arg-adapts (aref (unsafe/cast &ptr argtypes) a)
                                       (aref (unsafe/cast &ptr (m 'param-types)) a) is-lit is-flit) 0)
                    (set! ok 0))))
              (when (!= ok 0) (set! wcand (as ptr m)) (inc! wn))))))
      (when (= wn 1) (return wcand)))
    (return null)))

; An operator's operands read by value when one is a struct literal: each literal
; as its struct, and a non-null `&S` operand read through to `S`. Null when none is.
(defn operator-value-types (argtypes:ptr arg-nodes:ptr nargs:i32 scope:&Scope):ptr
  (let (vt:ptr (literal-arg-types argtypes arg-nodes nargs scope))
    (when (= vt null) (return null))
    (dotimes (i nargs)
      (let (t:?&Type (aref (unsafe/cast &ptr vt) i))
        (when (and (!= t null) (= (ptr-pkind t) PTR-REF) (!= (t 'elem) null)
                   (= (-> (t 'elem) (unsafe/cast &Type _) (_ 'kind)) TY-STRUCT))
          (set! (aref (unsafe/cast &ptr vt) i) (t 'elem)))))
    (return vt)))

; operator-user-resolve, retried by value (`out-vt`) when an operand is a struct
; literal; emit then refuses rather than compare the literal's address.
(defn operator-resolve (g:?&Generic argtypes:ptr arg-nodes:ptr nargs:i32 scope:&Scope
                        out-vt:&ptr):?&Method
  (set! @out-vt null)
  (when-some (m (operator-user-resolve g argtypes arg-nodes nargs)) (return m))
  (let (vt:ptr (operator-value-types argtypes arg-nodes nargs scope))
    (when (= vt null) (return null))
    (set! @out-vt vt)
    (return (operator-user-resolve g vt arg-nodes nargs))))

; The emitted symbol for a defn being codegen'd: the mangled name for an
; overloaded method, else the unmangled @name (also the fallback when no
; generic was registered, e.g. compile-time/REPL defns).
;
; W9 item 35: the DEFINING namespace is part of the question — this names the
; definition in front of the emitter, not a same-signature one another namespace
; happens to own. `g-current-ns` is the authority and is correct for a stamped
; template body too, because `drain-mono-worklist` restores the template's
; environment (item 43).
; SE-2: `ret` is the rest of the key. A want-stamped instance shares its
; parameter types with every sibling stamp, so the definition in front of the
; emitter is the one whose return type matches too; null (a caller with no
; return type to offer) keeps the historical two-part answer.
(defn defn-ir-name (fname:Symbol param-types:ptr nparams:i32 ret:?&Type):Symbol
  (let (g:ptr (generic-lookup fname))
    (when (!= g null)
      (let (m:ptr (generic-find-method-exact-in-ns g param-types nparams g-current-ns))
        (when (= m null)
          (set! m (generic-find-want-stamp g param-types nparams ret)))
        (when (and (!= m null)
                   (not (symbol-none? (-> m (unsafe/cast &Method _) (_ 'ir-name)))))
          (return (-> m (unsafe/cast &Method _) (_ 'ir-name)))))))
  ; Stage 12 N4: a solitary (non-overloaded) defn keeps `@name` but, in a
  ; non-`user` namespace, prefixes the base with the namespace ir-prefix
  ; (`@foo__name`). ns-ir-base is the identity under `user` (empty prefix), so the
  ; bootstrap stays byte-identical. Stage 15 W5e: def-ir-base additionally applies
  ; the owning file's private prefix when a private definer is being processed, so
  ; this fallback cannot hand two files' private `helper`s the same `@helper`.
  (return (symbol-intern (fstr "@" (def-ir-base fname)))))

(defn defn-is-mangled (fname:Symbol):i32
  (let (g:ptr (generic-lookup fname))
    (when (!= g null)
      (return (-> g (unsafe/cast &Generic _) (_ 'mangled)))))
  (return 0))

; If a defn form's name is overloaded, return that method's mangled @-symbol;
; else the zero Symbol. Used by .nuch export to declare overloads under their
; real symbols.
(defn defn-form-mangled-name (form:?&Node):Symbol
  ; S1: the bare name is all this needs — the former ret extraction served only as
  ; a malformed-name guard, which defn-name-only's null return now covers. Works
  ; for both signature styles.
  (let (fname:Symbol (defn-name-only (node-at form 1)))
    (when (symbol-none? fname) (return (symbol-none)))
    (let (g:ptr (generic-lookup fname))
      (when (= g null) (return (symbol-none)))
      (when (= (-> g (unsafe/cast &Generic _) (_ 'mangled)) 0) (return (symbol-none)))
      (let (params-node:ptr (node-at form 2)
            ; W9 item 35: the exported symbol is this namespace's, for the same
            ; reason `defn-ir-name` above asks the three-part question.
            m:ptr (generic-find-method-exact-in-ns g (defn-params-to-types params-node)
                                                   (defn-params-count params-node)
                                                   g-current-ns))
        (when (= m null) (return (symbol-none)))
        (return (-> m (unsafe/cast &Method _) (_ 'ir-name)))))))

; ============================================================
; Bounded generic defn (Stage 9 rung 4)
; ============================================================
; A generic defn carries a `:where` clause in its parameter list:
;   (defn max:T (a:T b:T :where (Ord T)) ...)
; Type variables are declared-only (named in a constraint). The template body is
; retained and monomorphized — substitute concrete types, stamp, cache — at each
; call site whose argument types bind the variables and satisfy the constraints.

; Index of the `:where` marker in a (desugared) parameter list, or -1.
(defn params-where-index (params-node:?&Node):i32
  (let (nraw:i32 (node-len params-node))
    (dotimes (i nraw)
      ; W5f: an empty list `()` among the params is a NULL node — never a
      ; `:where` marker, and not to be dereferenced. `marker-named` is null-safe.
      (let (e:?&Node (as ?&Node (node-at params-node i)))
        (when (!= (marker-named e "where") 0)
          (return i))))
    (return -1)))

; The bare function name from a defn name node, without parsing its return type
; (which may mention a type variable). Handles both `name:T` and desugared
; `(name T)` forms.
; W9 item 45: a name spelled `()` is a NULL node (W5f) and answers `null` here —
; "no name I can read", which is what every caller already tests for. Reading
; `(n kind)` off it is what made `(defprotocol P ())` segfault.
(defn defn-name-only (name-node:?&Node):Symbol
  (when (= name-node null) (return (symbol-none)))
  (let (n:?&Node name-node)
    (case (n 'kind)
      NODE-SYM
        (let (nm:Symbol (symbol-none) tn:Symbol (symbol-none))
          (split-typed (n 's) (as &Symbol &nm) (as &Symbol &tn))
          (return nm))
      NODE-LIST
        (let (c:ptr:Node (node-first n))
          (when (= (node-kind (as ptr c)) NODE-SYM) (return (c 's))))
      0)
    (return (symbol-none))))

; The type node of a desugared binding `(name type)`, or null if untyped.
(defn binding-type-node (bind-node:?&Node):?&Node
  ; W5f: an empty list `()` in a binding position is a NULL node — it carries no
  ; type node, and must not be dereferenced.
  (when (= bind-node null) (return null))
  (let (n:?&Node bind-node)
    (when (= (n 'kind) NODE-LIST) (return (node-at bind-node 1)))
    (return null)))

; Does any symbol anywhere in this node name a declared type variable?
(defn node-mentions-tyvar (node:?&Node tyvars:ptr ntv:i32):i32
  (when (= node null) (return 0))
  (let (n:?&Node node)
    (case (n 'kind)
      NODE-SYM
        (do
          ; PK-4b: `?T` mentions T, and so does `ref:T`.
          (let (run:StrView "" op:?&Node (sigil-split node 0 &run))
            (when (!= op null) (return (node-mentions-tyvar op tyvars ntv))))
          (let (split:?&Node (colon-spelling-node node 0))
            (when (!= split null) (return (node-mentions-tyvar split tyvars ntv))))
          (if (>= (tyvar-index-of (n 's) tyvars ntv) 0) (return 1) (return 0)))
      NODE-LIST
        (do
          (when (!= (node-mentions-tyvar (node-first n) tyvars ntv) 0) (return 1))
          (return (node-mentions-tyvar (node-rest n) tyvars ntv)))
      0)
    (return 0)))

; The first n cells of a list as a freshly-consed list (drops the tail).
(defn take-first-n (list:?&Node n:i32 line:i32):?&Node
  (when (<= n 0) (return null))
  (when (= list null) (return null))
  (let (l:?&Node list)
    (return (node-cons (node-first l) (take-first-n (node-rest l) (- n 1) line) line))))

; ============================================================
; Stage 11 T2: tyvar-from-receiver inference + structural unification
; ============================================================
; A method written over a parametric struct — `(defn count:usize
; ((self (ref (Vector T)))) ...)` — declares its tyvars implicitly through the
; receiver instead of an explicit `:where`. The free symbol `T` appearing as an
; argument of the registered template application `(Vector T)` is the method's
; type variable, inferred from the receiver (parametric-structs.md §4). These
; helpers (a) decide whether a symbol names a concrete type (else it is a tyvar),
; (b) collect such tyvars from a parameter/return type node, and (c) structurally
; unify a type-pattern node against a concrete argument Type* to bind them — the
; exact equivalent of an `:where`-declared tyvar list, so the method is recorded
; and stamped through the unchanged rung-4 monomorphizer.

; Does `name` name a concrete (non-tyvar) type? Mirrors parse-type-name's
; name set without dying. A free symbol that is NOT resolvable here is a
; candidate type variable.
(defn tyname-resolvable (name:Symbol):i32
  ; Stage 21 PK-4a: peel `?`/`!` first, as resolve-type-name does — a sigil
  ; spelling used to be an unresolvable name, i.e. a fake tyvar (H5, §1.4).
  (let (run:usize (type-sigil-run name))
    (when (> run 0)
      (return (tyname-resolvable (symbol-intern (strview-drop-bytes (symbol-as-view name) run))))))
  ; `builtin-type-name`, not `g-primitive-type-set`: only the former was
  ; extracted from parse-type-name, the set this mirrors (context/conventions.md,
  ; "A concrete type read as a TYVAR silently drops a whole instantiation").
  (when (!= (as ptr (builtin-type-name name)) null) (return 1))
  ; A marker is a type some other file already wrote, never a variable of this one.
  (when (!= (as ptr (env-arg-of name)) null) (return 1))
  (when (!= (as ptr (struct-lookup-ref name)) null) (return 1))
  (when (!= (as ptr (struct-template-lookup-ref name)) null) (return 1))
  (when (!= (as ptr (union-template-lookup-ref name)) null) (return 1))
  (when (!= (as ptr (enumdef-lookup-ref name)) null) (return 1))
  ; A known name of ANY arity or representability: parse-type-name then reports
  ; the real problem, where a 0 here made the name a tyvar that bound anything.
  (when (!= (as ptr (type-alias-lookup-ref name)) null) (return 1))
  (when (!= (as ptr (c-typedef-find name)) null) (return 1))
  ; Stage 13 L7: a TY-FN spelling (interned "__fnty_<id>") resolves back to a
  ; concrete function-pointer Type* via fnty-resolve (mirroring parse-type-name),
  ; so a stamped generic body's template-arg spelling — e.g. (MapIter I __fnty_0) —
  ; is treated as a concrete type, not a free tyvar. Without this, collect-pattern-
  ; tyvars wrongly collects __fnty_0, defn-has-receiver-tyvars returns 1, the
  ; stamped method looks like a template, and emit-defn skips its define while the
  ; call site still references its ir-name (undefined symbol at link/parse).
  (match (fnty-resolve name)
         ((some t) (return 1))
         (none null))
  ; A pointer colon spelling ("ref:X", as type-spelling emits, or "ptr:X") is concrete
  ; iff X resolves; otherwise a stamped receiver's arg reads as a free tyvar (Stage 13 L7).
  (let (sv:StrView (symbol-as-view name))
    (when (or (strview-has-prefix sv "ptr:") (strview-has-prefix sv "ref:"))
      (when (!= (tyname-resolvable (symbol-intern (strview-drop-bytes sv 4))) 0)
        (return 1))))
  (return 0))

; The inner pattern node of a pointer wrapper `(ptr|ref X...)`, mirroring how
; parse-type-from-node consumes it: a single trailing element is that element;
; several (e.g. the colon-sugar shape `(ref Vector T)`) is the whole tail list
; `(Vector T)`. Returns null for a wrapper with no operand.
(defn wrapper-inner-pattern (node:?&Node):?&Node
  (let (n:?&Node node
        rest:?&Node (node-rest n))
    (when (= rest null) (return null))
    (if (= (node-rest rest) null)
      (return (node-first rest))
      (return rest))))

; If `node` is a list whose head names a registered struct template, return that
; StructTemplate*; else null. (Used to recognize a template application both for
; tyvar collection and unification.)
(defn node-template-of (node:?&Node):?&StructTemplate
  (when (= node null) (return null))
  (let (n:?&Node node)
    (when (!= (n 'kind) NODE-LIST) (return null))
    (let (head:?&Node (node-first n))
      (when (or (= head null) (!= (head 'kind) NODE-SYM)) (return null))
      (return (struct-template-lookup-ref (head 's))))))

; The defunion template a list applies, or null — node-template-of's twin.
(defn node-union-template-of (node:?&Node):?&UnionTemplate
  (when (= node null) (return null))
  (let (n:?&Node node)
    (when (!= (n 'kind) NODE-LIST) (return null))
    (let (head:?&Node (node-first n))
      (when (or (= head null) (!= (head 'kind) NODE-SYM)) (return null))
      (return (union-template-lookup-ref (head 's))))))

; The stamped instance of `ut` that `at` is, or null. A niche instance is a bare
; pointer, so it is found among the stamps by shape, as sigil-unwrap-type does.
(defn union-instance-of (ut:&UnionTemplate at:?&Type):?&UnionDef
  (when (= at null) (return null))
  (let (ud:?&UnionDef (uniondef-for-type at))
    (when (!= ud null)
      (return (if (= (ud 'origin-template) ut) ud null))))
  (when (!= (at 'kind) TY-PTR) (return null))
  (doseq (u g-uniondefs (VecIter &UnionDef))
    (when (and (= (u 'origin-template) ut)
               (or (= (u 'layout) LAYOUT-NICHE-MAYBE) (= (u 'layout) LAYOUT-NICHE-ERRPTR))
               (!= (type-eq (union-instance-type u) at) 0))
      (return u)))
  (return null))

; A colon spelling as the list the type parser splits it into (`ref:T` →
; `(ref T)`), or null for a colon-free symbol. A trailing colon is left to the
; parser, whose split reports it.
(defn colon-spelling-node (node:?&Node line:i32):?&Node
  (when (!= (node-kind node) NODE-SYM) (return null))
  (let (n:ptr:Node node
        s:Symbol (n 's))
    (when (or (= (symbol-contains-byte s 58) false)
              (strview-has-suffix (symbol-as-view s) ":"))
      (return null))
    (return (split-colon-segments s line))))

; PK-4b (pointer-kind-spellings.md §6): to the pattern walkers a type sigil is
; a WRAPPER under every spelling — `?X` / `?ref:T` (symbol), `(? X)` (PK-3's
; list form), `(?ref X)` (glued head) and the list spellings `(Maybe X)` /
; `(Result X Err)`. Writes the sigil run to *out-run and returns the operand
; under the whole run, or null (run "") for anything else. A colon remainder is
; split as the type parser splits it, so `?ref:T` is seen as `(ref T)`.
(defn sigil-split (node:?&Node line:i32 out-run:&StrView):?&Node
  (set! (aref out-run 0) "")
  (when (= node null) (return null))
  (let (n:?&Node node)
    (when (= (n 'kind) NODE-SYM)
      (let (s:Symbol (n 's)
            run:usize (type-sigil-run s))
        (when (or (= run 0) (= run (symbol-len s))) (return null))
        (let (sv:StrView (symbol-as-view s)
              rest:Symbol (symbol-intern (strview-drop-bytes sv run)))
          (set! (aref out-run 0) (strview-take-bytes sv run))
          (when (symbol-contains-byte rest 58)
            (return (split-colon-segments rest line)))
          (return (intern-node rest)))))
    (when (!= (n 'kind) NODE-LIST) (return null))
    (let (head:?&Node (node-first n)
          rest:?&Node (node-rest n))
      (when (or (= head null) (!= (head 'kind) NODE-SYM) (= rest null)) (return null))
      (let (hs:Symbol (head 's)
            hv:StrView (symbol-as-view hs)
            run:usize (type-sigil-run hs)
            one:i32 (if (= (node-rest rest) null) 1 0))
        ; `(? X)`: a head that is nothing but sigils takes exactly one operand.
        (when (and (> run 0) (= run (hv 'len)))
          (when (= one 0) (return null))
          (set! (aref out-run 0) hv)
          (return (node-first rest)))
        ; `(?ref X)`: the sigils are glued to a wrapper head; peel them off it.
        (when (> run 0)
          (set! (aref out-run 0) (strview-take-bytes hv run))
          (return (node-cons (intern-node (symbol-intern (strview-drop-bytes hv run))) rest line)))
        ; A several-element tail is the colon-sugar shape `(Maybe Vector T)`,
        ; read as `(Maybe (Vector T))` — the same rule wrapper-inner-pattern uses.
        (when (= hs "Maybe")
          (set! (aref out-run 0) "?")
          (return (if (!= one 0) (node-first rest) rest)))
        (when (and (= hs "Result") (= (node-len node) 3))
          (let (e:?&Node (node-at node 2))
            (when (and (!= e null) (= (e 'kind) NODE-SYM) (= (e 's) "Err"))
              (set! (aref out-run 0) "!")
              (return (node-first rest)))))
        (return null)))))

; The concrete type under one sigil of `at` (`?` = 63, `!` = 33), or null when
; `at` is not that wrapper: a niche pointer relabels to PTR-REF, a stamped
; `Maybe.X` / `Result.X.Err` unwraps to `X` through the origin the stamp
; recorded. A pointer unwraps by SHAPE, not by kind: a template stamp records
; whichever pointer kind stamped it first (`(Vector &Pt)` and `(Vector ?&Pt)`
; are one instance), and `type-eq` ignores the kind for the same reason.
(defn sigil-unwrap-type (sigil:i32 at:?&Type):?&Type
  (when (= at null) (return null))
  (let (tt:?&Type at)
    (when (= (tt 'kind) TY-PTR) (return (type-as-pkind at PTR-REF)))
    (let (ud:?&UnionDef (uniondef-for-type at))
      (when (= ud null) (return null))
      (let (udd:&UnionDef ud
            tname:StrView (if (= sigil 63) "Maybe" "Result")
            ut:?&UnionTemplate (union-template-lookup-ref (symbol-intern tname)))
        (when (or (= ut null) (!= (udd 'origin-template) ut)) (return null))
        (when (= sigil 63)
          (when (!= (udd 'origin-nargs) 1) (return null))
          (return (aref (unsafe/cast &ptr (udd 'origin-args)) 0)))
        (when (!= (udd 'origin-nargs) 2) (return null))
        (when (= (type-eq (aref (unsafe/cast &ptr (udd 'origin-args)) 1) ty-err) 0) (return null))
        (return (aref (unsafe/cast &ptr (udd 'origin-args)) 0))))))

; True if `node` is a pointer-wrapper list head: (ptr ...) / (ref ...).
(defn node-is-ptr-wrapper (node:?&Node):i32
  (when (= node null) (return 0))
  (let (n:?&Node node)
    (when (!= (n 'kind) NODE-LIST) (return 0))
    (let (head:?&Node (node-first n))
      (when (or (= head null) (!= (head 'kind) NODE-SYM)) (return 0))
      (when (or (= (head 's) "ptr") (= (head 's) "ref"))
        (return 1))
      (return 0))))

; Append `name` to the tyvar array at *io-ntv (deduplicated). The array must have
; room (it is sized to the parameter/return node count, an upper bound). io-ntv is
; a &i32 box holding the running count.
(defn tyvars-add (name:Symbol out-tyvars:ptr io-ntv:ptr):void
  (let (ntv:i32 (aref (unsafe/cast &i32 io-ntv) 0))
    (when (>= (tyvar-index-of name out-tyvars ntv) 0) (return))
    (set! (aref (unsafe/cast &Symbol out-tyvars) ntv) name)
    (set! (aref (unsafe/cast &i32 io-ntv) 0) (+ ntv 1))))

; Upper bound on the number of tyvar slots `collect-pattern-tyvars` can write for
; this type pattern. Every tyvar it emits is a distinct symbol leaf of the node,
; so the total node count is a safe (conservative, pre-dedup) bound. Used to size
; the tyvars array: a single parameter whose receiver is a struct-template
; application `(Two I F S E)` contributes one slot PER type argument — including
; phantom params that appear in no field — so the old "one tyvar per parameter"
; estimate under-allocated and corrupted the arena (Item 4a). Counting nodes can
; never under-count.
(defn count-pattern-nodes (node:?&Node):i32
  (when (= node null) (return 0))
  (let (n:?&Node node)
    (when (= (n 'kind) NODE-LIST)
      (return (+ 1 (+ (count-pattern-nodes (node-first n)) (count-pattern-nodes (node-rest n))))))
    ; A colon spelling is collected as its split list, one leaf per segment.
    (when (= (n 'kind) NODE-SYM)
      (let (k:i32 1 i:usize 0 s:Symbol (n 's))
        (while (< i (symbol-len s))
          (when (= (symbol-byte-at s i) 58) (inc! k))
          (set! i (+ i 1)))
        (return k)))
    (return 1)))

; Walk a parameter/return type pattern node, collecting the method's
; receiver-inferred tyvars: the unresolvable symbols that are ARGUMENTS of a
; struct- or union-template application. A top-level symbol is never one — a
; standalone `T` is bound only through a `:where`.
(defn collect-pattern-tyvars (node:?&Node out-tyvars:ptr io-ntv:ptr):void
  (collect-tyvars-at node (symbol-none) 0 out-tyvars io-ntv))

; 1 for an inline `(struct …)`, 2 for an inline `(union …)`, else 0.
(defn node-inline-aggregate (node:?&Node):i32
  (when (!= (node-kind node) NODE-LIST) (return 0))
  (let (head:ptr:Node (node-first node))
    (when (!= (node-kind head) NODE-SYM) (return 0))
    (when (= (head 's) "struct") (return 1))
    (when (= (head 's) "union") (return 2))
    (return 0)))

; An inline aggregate's member `a:T` or `(a T)`: its type node, name in *out-name.
; Null for any other shape (an attributed member), which no pattern walker reads.
(defn aggregate-member-split (mem:ptr:Node out-name:&Symbol line:i32):ptr:Node
  (when (= (node-kind mem) NODE-SYM)
    (let (nm:Symbol (symbol-none) tail:Symbol (symbol-none))
      (split-typed (mem 's) (as &Symbol &nm) (as &Symbol &tail))
      (when (symbol-none? tail) (return null))
      (set! (aref out-name 0) nm)
      (return (intern-node tail))))
  (when (and (= (node-kind mem) NODE-LIST) (= (node-len (as ptr mem)) 2)
             (= (node-kind (node-first mem)) NODE-SYM))
    (set! (aref out-name 0) (node-head-sym mem))
    (return (node-at (as ptr mem) 1)))
  (return null))

; `in-tmpl` names the template `node` is an argument of (none at the top level),
; and `line` is the enclosing form's. A sigil, a pointer wrapper in either
; spelling (`(ref T)`, `ref:T`) and an alias all leave their operand in that
; position, and unify-tpat and the mirrors read them identically.
(defn collect-tyvars-at (node:?&Node in-tmpl:Symbol line:i32 out-tyvars:ptr io-ntv:ptr):void
  (when (= node null) (return))
  (let (n:?&Node node
        nline:i32 (node-line (as ptr node) line))
    (let (run:StrView "" op:?&Node (sigil-split node nline &run))
      (when (!= op null)
        (collect-tyvars-at op in-tmpl nline out-tyvars io-ntv)
        (return)))
    (when (= (n 'kind) NODE-SYM)
      (when (symbol-none? in-tmpl) (return))
      (let (s:Symbol (n 's))
        ; Bare `ptr` is a type, so it reaches the arity check; bare `ref`
        ; is not, and would be collected instead.
        (when (= s "ref")
          (die-at nline
            (fstr in-tmpl
                  ": 'ref' is a pointer kind, not a type argument -- a colon chain cannot nest, so parenthesize the inner type: ref:("
                  in-tmpl " (ref X))")))
        (when (= (tyname-resolvable s) 0)
          (if (symbol-contains-byte s 58)
            (collect-tyvars-at (colon-spelling-node node nline) in-tmpl nline out-tyvars io-ntv)
            (do
              ; A lone `?` (PK-3's near-miss) is not a tyvar either.
              (reject-bare-sigil s nline)
              (tyvars-add s out-tyvars io-ntv)))))
      (return))
    (when (!= (n 'kind) NODE-LIST) (return))
    ; §3.7: expand a parametric alias FIRST. Left unexpanded, `(Table V)`
    ; matches no template and no pointer wrapper, so `V` is never collected
    ; and the method is misread as concrete — §1.2's failure in a new costume.
    (let (ex:?&Node (type-alias-apply node nline))
      (when (!= ex null)
        (when (>= g-type-alias-depth MAX-TYPE-ALIAS-DEPTH)
          (die-at nline "type alias expands into a cycle"))
        (set! g-type-alias-depth (+ g-type-alias-depth 1))
        ; An aggregate body's members are the alias's arguments, so they are
        ; template-argument positions, as `(Vector T)`'s are.
        (collect-tyvars-at ex (if (!= (node-inline-aggregate ex) 0) (node-head-sym n) in-tmpl)
                           nline out-tyvars io-ntv)
        (set! g-type-alias-depth (- g-type-alias-depth 1))
        (return)))
    (when (!= (node-inline-aggregate node) 0)
      (dotimes (mi (- (node-len (as ptr node)) 1))
        (let (mname:Symbol (symbol-none))
          (collect-tyvars-at (aggregate-member-split (node-at (as ptr node) (+ mi 1)) &mname nline)
                             in-tmpl nline out-tyvars io-ntv)))
      (return))
    (let (nargs:i32 (- (node-len (as ptr node)) 1))
      ; CT-D: a colon chain that nests (x:ref:Vector:ref:Node) lands here as an
      ; over-long argument list; without the arity guards its surplus symbols
      ; become tyvars and the defn silently vanishes as an uninstantiable
      ; template (container-type-sugar.md §1.2).
      (if-some (st (node-template-of node))
        (do
          (dotimes (ai nargs)
            (collect-tyvars-at (node-at (as ptr node) (+ ai 1)) (st 'name) nline out-tyvars io-ntv))
          (when (!= nargs (st 'ntv))
            (die-at nline
              (fstr (st 'name) ": wrong number of type arguments for defstruct template ("
                    nargs " given)")))
          (return))
        0)
      (if-some (ut (node-union-template-of node))
        (do
          (dotimes (ai nargs)
            (collect-tyvars-at (node-at (as ptr node) (+ ai 1)) (ut 'name) nline out-tyvars io-ntv))
          (when (!= nargs (ut 'ntv))
            (die-at nline
              (fstr (ut 'name) ": wrong number of type arguments for defunion template ("
                    nargs " given)")))
          (return))
        0))
    (when (!= (node-is-ptr-wrapper node) 0)
      (collect-tyvars-at (wrapper-inner-pattern node) in-tmpl nline out-tyvars io-ntv))))

; An Arg of `((Proto Arg…) V)` is a template argument, so a tyvar under a sigil,
; pointer wrapper, alias or template (`?E`, `&E`, `(Vector E)`) is collected too.
(defn collect-constraint-arg-tyvars (node:?&Node proto:Symbol out-tyvars:ptr io-ntv:ptr):void
  (collect-tyvars-at node proto (node-line (as ptr node) 0) out-tyvars io-ntv))

; Structurally unify a type-pattern node `pat` against a concrete argument Type*
; `at`, binding each tyvar (by index in `tyvars`) into out-bound. Returns 1 on a
; consistent match, 0 on any mismatch. The cases mirror parse-type-from-node:
;   - bare tyvar symbol: bind (and agree on repeats);
;   - a colon spelling that mentions a tyvar: unify its split list;
;   - any other symbol / colon-sugar symbol: parse it concretely and type-eq;
;   - (ptr|ref X): `at` must be a TY-PTR, recurse on X vs (at elem);
;   - (Template A B), struct or defunion: `at` must be a stamped instance of
;     that template, recurse positionally on A,B vs the recorded origin args;
;   - anything else: parse the whole pattern concretely and type-eq.
(defn unify-tpat (pat:?&Node at:?&Type tyvars:ptr ntv:i32 out-bound:ptr line:i32):i32
  (when (or (= pat null) (= at null)) (return 0))
  ; §3.7: match against what the alias means, not its name — the argument Type
  ; was built from the expansion, so an unexpanded pattern could never agree.
  (let (ex:?&Node (type-alias-apply pat line))
    (when (!= ex null)
      (when (>= g-type-alias-depth MAX-TYPE-ALIAS-DEPTH)
        (die-at line "type alias expands into a cycle"))
      (set! g-type-alias-depth (+ g-type-alias-depth 1))
      (let (r:i32 (unify-tpat ex at tyvars ntv out-bound line))
        (set! g-type-alias-depth (- g-type-alias-depth 1))
        (return r))))
  ; PK-4b: a sigil pattern unifies its operand against the type UNDER the
  ; sigils, peeled outermost first as the parser applies them (`?!T`: the
  ; Maybe, then the Result). A type that is not that wrapper is a mismatch.
  (let (run:StrView "" op:?&Node (sigil-split pat line &run))
    (when (!= op null)
      (let (cur:?&Type at)
        (dotimes (i (unsafe/cast i32 (run 'len)))
          (set! cur (sigil-unwrap-type (as i32 (aref (run 'data) i)) cur))
          (when (= cur null) (return 0)))
        (return (unify-tpat op cur tyvars ntv out-bound line)))))
  (let (pn:?&Node pat)
    (case (pn 'kind)
      NODE-SYM
        (do
          ; A single bare symbol that is a declared tyvar binds directly.
          (when (= (symbol-contains-byte (pn 's) 58) false)
            (let (idx:i32 (tyvar-index-of (pn 's) tyvars ntv))
              (when (>= idx 0)
                (let (cur:ptr (aref (unsafe/cast &ptr out-bound) idx))
                  (if (= cur null)
                    (do (set! (aref (unsafe/cast &ptr out-bound) idx) at) (return 1))
                    (return (type-eq cur at)))))))
          ; `ref:T` is `(ref T)`, as the collector read it.
          (when (!= (node-mentions-tyvar pat tyvars ntv) 0)
            (let (split:?&Node (colon-spelling-node pat line))
              (when (!= split null)
                (return (unify-tpat split at tyvars ntv out-bound line)))))
          ; Otherwise a concrete (possibly colon-sugared) type: parse and compare.
          (return (type-eq (parse-type-from-node pat line) at)))
      NODE-LIST
        (do
          ; Pointer wrapper vs a concrete pointer: unify element patterns.
          (when (!= (node-is-ptr-wrapper pat) 0)
            ; Stage 13 L7: a bare `fn` (function pointer, TY-FN) flowing into a
            ; `(ref G)`/`(ptr G)` position binds G to the TY-FN itself — the stamped
            ; body's `(ref G)` becomes `(ref <fn>)`, and the by-value fn pointer
            ; passed at the call site lands in the param slot as that storage. A
            ; TY-FN has no `elem`, so unify the inner pattern directly against `at`.
            (when (= (at 'kind) TY-FN)
              (return (unify-tpat (wrapper-inner-pattern pat) at tyvars ntv out-bound line)))
            (when (!= (at 'kind) TY-PTR) (return 0))
            (return (unify-tpat (wrapper-inner-pattern pat)
                                (at 'elem)
                                tyvars ntv out-bound line)))
          ; Template application vs a stamped instance of the same template.
          (let (st:?&StructTemplate (node-template-of pat))
            (when (!= st null)
              (when (!= (at 'kind) TY-STRUCT) (return 0))
              (let (sd:ptr:StructDef (at 'sdef))
                (when (!= (sd 'origin-template) st) (return 0))
                (let (nargs:i32 (- (node-len pat) 1))
                  (when (!= nargs (sd 'origin-nargs)) (return 0))
                  (dotimes (i nargs)
                    (when (= (unify-tpat (node-at pat (+ i 1))
                                         (aref (unsafe/cast &ptr (sd 'origin-args)) i)
                                         tyvars ntv out-bound line) 0)
                      (return 0)))
                  (return 1)))))
          ; A defunion template likewise, when it has a tyvar to bind; a concrete
          ; one keeps the parse below, which is also what stamps it.
          (if-some (ut (node-union-template-of pat))
            (when (!= (node-mentions-tyvar pat tyvars ntv) 0)
              (if-some (ud (union-instance-of ut at))
                (let (nargs:i32 (- (node-len pat) 1))
                  (when (!= nargs (ud 'origin-nargs)) (return 0))
                  (dotimes (i nargs)
                    (when (= (unify-tpat (node-at pat (+ i 1))
                                         (aref (unsafe/cast &ptr (ud 'origin-args)) i)
                                         tyvars ntv out-bound line) 0)
                      (return 0)))
                  (return 1))
                (return 0)))
            0)
          ; An inline aggregate over a tyvar vs the anonymous one it built: field by field.
          (let (agg:i32 (node-inline-aggregate pat))
            (when (and (!= agg 0) (!= (node-mentions-tyvar pat tyvars ntv) 0))
              (return (unify-aggregate pat agg at tyvars ntv out-bound line))))
          ; Any other compound type (anonymous struct, fn pointer): parse concretely.
          (return (type-eq (parse-type-from-node pat line) at)))
      0)
    (return 0)))

; The anonymous StructDef's own registry name says which constructor built it.
(defn unify-aggregate (pat:?&Node agg:i32 at:ptr:Type tyvars:ptr ntv:i32 out-bound:ptr line:i32):i32
  (when (!= (at 'kind) (if (= agg 1) TY-STRUCT TY-UNION)) (return 0))
  (let (sd:?&StructDef (at 'sdef)
        nmem:i32 (- (node-len (as ptr pat)) 1))
    (when (or (= sd null) (!= (sd 'num-fields) nmem)
              (not (strview-has-prefix (symbol-as-view (sd 'name))
                                       (if (= agg 1) "__anon_struct_h" "__anon_union_h"))))
      (return 0))
    (dotimes (i nmem)
      (let (mname:Symbol (symbol-none)
            mty:?&Node (aggregate-member-split (node-at (as ptr pat) (+ i 1)) &mname line)
            f:&Field (field-at (sd 'fields) i))
        (when (or (= mty null) (!= mname (f 'name))
                  (= (unify-tpat mty (f 'type) tyvars ntv out-bound line) 0))
          (return 0))))
    (return 1)))

; Does this defn signature mention a registered struct template applied to free
; (tyvar) symbols in any parameter or return type? If so it is a receiver-inferred
; generic method (parametric-structs.md §4), recorded like an `:where` template.
(defn defn-has-receiver-tyvars (form:?&Node):i32
  (let (name-node:ptr (node-at form 1)
        params-node:ptr (node-at form 2))
    (when (not (node-is-list params-node)) (return 0))
    ; Capacity must cover one tyvar per type-argument of any struct-template
    ; receiver, not just one per parameter (Item 4a) — size by the node count of
    ; each parameter/return type pattern, a safe upper bound on collectible
    ; tyvars. Add the return-type node count and 1 so the array is never empty.
    (let (np:i32 (node-len params-node)
          cap:i32 (+ (count-pattern-nodes (defn-ret-node form)) 1)
          ci:i32 0)
      (while (< ci np)
        (set! cap (+ cap (count-pattern-nodes
                           (binding-type-node (node-at params-node ci)))))
        (inc! ci))
    (let (tyvars:ptr (arena-alloc (* (as i64 cap) (ptr-bytes)))
          ntv:i32 0
          i:i32 0)
      (while (< i np)
        ; W5f: a NULL (empty-list `()`) parameter is not a marker; skip the
        ; dereference and let emit-defn diagnose it.
        (let (p:?&Node (as ?&Node (node-at params-node i)))
          ; Skip :where / :rest / :optional markers and their constraint lists.
          (when (!= (marker-any p) 0)
            (return (if (> ntv 0) 1 0)))
          (collect-pattern-tyvars (binding-type-node (node-at params-node i))
                                  tyvars (as &i32 &ntv)))
        (inc! i))
      (collect-pattern-tyvars (defn-ret-node form) tyvars (as &i32 &ntv))
      (return (if (> ntv 0) 1 0))))))

; A defn is a bounded-generic template — recorded for on-demand monomorphization
; rather than emitted concretely — if it carries an explicit `:where` clause OR
; its receiver/return mentions a parametric struct over free tyvars (§4). Both
; routing sites (prescan registration, emit-defn skip) consult this so the two
; never disagree about whether a defn is a template.
(defn defn-is-generic-template (form:?&Node):i32
  (let (params-node:ptr (node-at form 2))
    (when (>= (params-where-index params-node) 0) (return 1))
    (return (defn-has-receiver-tyvars form))))

; Can the parameter type pattern `pat` bind the type variable `tvname` under the
; structural unifier (unify-tpat)? Mirrors that traversal: a bare-symbol match, a
; tyvar under a ptr/ref wrapper (either spelling), or a tyvar as an argument
; of a registered struct- or union-template application (recursively). Used to
; confirm every declared tyvar is determined by some parameter.
(defn pattern-determines-tyvar (pat:?&Node tvname:Symbol):i32
  (when (= pat null) (return 0))
  ; PK-4b: the unifier binds through a sigil, so this mirror must too.
  (let (run:StrView "" op:?&Node (sigil-split pat (node-line (as ptr pat) 0) &run))
    (when (!= op null) (return (pattern-determines-tyvar op tvname))))
  (let (n:?&Node pat)
    (case (n 'kind)
      NODE-SYM
        (do
          (let (split:?&Node (colon-spelling-node pat (node-line (as ptr pat) 0)))
            (when (!= split null) (return (pattern-determines-tyvar split tvname))))
          (if (= (n 's) tvname) (return 1) (return 0)))
      NODE-LIST
        (do
          ; §3.7, the third copy of this expansion (collect-pattern-tyvars and
          ; unify-tpat are the other two, and this function claims to mirror the
          ; second): `(Vec T)` is an alias application, matches no template, and
          ; without expanding it `T` reads as undetermined.
          (let (ex:?&Node (type-alias-apply pat (node-line (as ptr pat) 0)))
            (when (!= ex null)
              (when (>= g-type-alias-depth MAX-TYPE-ALIAS-DEPTH)
                (die-at (node-line (as ptr pat) 0) "type alias expands into a cycle"))
              (set! g-type-alias-depth (+ g-type-alias-depth 1))
              (let (r:i32 (pattern-determines-tyvar ex tvname))
                (set! g-type-alias-depth (- g-type-alias-depth 1))
                (return r))))
          (when (!= (node-is-ptr-wrapper pat) 0)
            (return (pattern-determines-tyvar (wrapper-inner-pattern pat) tvname)))
          (when (or (!= (as ptr (node-template-of pat)) null)
                    (!= (as ptr (node-union-template-of pat)) null))
            (dotimes (ai (- (node-len (as ptr pat)) 1))
              (when (!= (pattern-determines-tyvar (node-at (as ptr pat) (+ ai 1)) tvname) 0)
                (return 1)))
            (return 0))
          (when (!= (node-inline-aggregate pat) 0)
            (dotimes (mi (- (node-len (as ptr pat)) 1))
              (let (mname:Symbol (symbol-none))
                (when (!= (pattern-determines-tyvar
                            (aggregate-member-split (node-at (as ptr pat) (+ mi 1)) &mname
                                                    (node-line (as ptr pat) 0))
                            tvname) 0)
                  (return 1))))
            (return 0)))
      0)
    (return 0)))

; Which of a template's declared tyvars the CALL determines, written into the
; i32 array `out` (assoc-types A1 §3.4). Seed: a tyvar some parameter pattern
; binds under the structural unifier. Step: for each constraint `((Proto Arg…) V)`
; whose conforming variable V is determined, every tyvar mentioned in an Arg is
; determined too — it is recovered from V's conformance at dispatch (A2). Repeat
; to a fixpoint. A plain `(Proto V)` constraint carries no Arg nodes and adds
; nothing, so a constraint-free template gets the single seed pass exactly.
;
; This lived inline in the template registration, where its result was computed
; and never read; SE-2 gave the question a consumer, and the params-only
; approximation `method-undetermined-tyvar` used to make would have called
; `reduce`'s `S` (recovered from `((Iterator S) I)`) return-only.
(defn tyvars-determined (params-node:?&Node nparams:i32 tyvars:ptr ntv:i32
                             constraints:?&ConstraintVec nc:i32 out:ptr):void
  (dotimes (ti ntv)
    (let (tvname:Symbol (aref (unsafe/cast &Symbol tyvars) ti)
          bnd:i32 0)
      (dotimes (j nparams)
        (when (!= (pattern-determines-tyvar (binding-type-node (node-at params-node j)) tvname) 0)
          (set! bnd 1)))
      (set! (aref (unsafe/cast &i32 out) ti) bnd)))
  (let (changed:i32 1)
    (while (!= changed 0)
      (set! changed 0)
      (dotimes (ck nc)
        (let (crec:ref:Constraint (constraints-at constraints ck)
              vidx:i32 (tyvar-index-of (crec 'var) tyvars ntv)
              na:i32 (crec 'nargs))
          (when (and (>= vidx 0) (!= (aref (unsafe/cast &i32 out) vidx) 0) (> na 0))
            (let (argv:ptr (crec 'args))
              (dotimes (ai na)
                (let (argn:ptr (aref (unsafe/cast &ptr argv) ai))
                  (dotimes (ti2 ntv)
                    (when (and (= (aref (unsafe/cast &i32 out) ti2) 0)
                               (!= (node-mentions-tyvar-named argn (aref (unsafe/cast &Symbol tyvars) ti2)) 0))
                      (set! (aref (unsafe/cast &i32 out) ti2) 1)
                      (set! changed 1))))))))))))

; TC-1: the interned name of the first declared tyvar the call does not
; determine (a return-only tyvar), or null when every tyvar is determined. Such a
; tyvar can only be filled by the call site's want channel; a call that cannot
; resolve and has one of these gets the dedicated "cannot infer type variable"
; diagnostic instead of the misleading "no matching method". Since SE-2 it also
; decides whether a stamped instance needs a return-type discriminator, so it
; asks the whole fixpoint rather than the parameter seed alone.
(defn method-undetermined-tyvar (m:?&Method):?Symbol
  (let (mm:ptr:Method m
        ntv:i32 (mm 'num-tyvars)
        det:ptr (arena-alloc (* (as i64 (if (> ntv 0) ntv 1)) 4))
        here:NameEnv (method-env-enter m))
    (tyvars-determined (as ?&Node (node-at (mm 'body) 2)) (mm 'num-params)
                       (mm 'tyvars) ntv (mm 'constraints) (mm 'num-constraints) det)
    (name-env-set here)
    (dotimes (ti ntv)
      (when (= (aref (unsafe/cast &i32 det) ti) 0)
        (return (some (aref (unsafe/cast &Symbol (mm 'tyvars)) ti)))))
    (return (none))))

; Stage 16 SE-2: is `m` a stamped instance that its own parameter types do not
; identify? Its template has a tyvar only the call site's want channel can fill,
; so two instances share one `(name, param-types)` key and the first stamped one
; answered for all of them. template-ref-equality.md §5.
(defn method-is-want-stamped (m:&Method):i32
  (let (mm:&Method m
        tm:ptr (mm 'origin-template))
    (when (= tm null) (return 0))
    (match (method-undetermined-tyvar (as ?&Method tm))
      ((some _) (return 1))
      (none (return 0)))))

; Does the colon-free symbol `tvname` appear anywhere as a leaf of `node`? Used
; by the assoc-types (A1) determination fixpoint to test whether a constraint
; argument pattern `((Proto Arg…) V)` references a given tyvar. Walks every cell
; and symbol leaf (unlike pattern-determines-tyvar, which restricts itself to the
; unifier-reachable positions); an Arg may be a bare `S`, a `(Maybe E)`, etc.
; tvname stays `ptr` for the same reason as pattern-determines-tyvar above
; (identity-substrate comparison against Node.s).
(defn node-mentions-tyvar-named (node:?&Node tvname:Symbol):i32
  (when (= node null) (return 0))
  (let (n:?&Node node)
    (case (n 'kind)
      NODE-SYM
        (do
          ; PK-4b: `?E` mentions E, and so does `ref:E`.
          (let (run:StrView "" op:?&Node (sigil-split node 0 &run))
            (when (!= op null) (return (node-mentions-tyvar-named op tvname))))
          (let (split:?&Node (colon-spelling-node node 0))
            (when (!= split null) (return (node-mentions-tyvar-named split tvname))))
          (if (= (n 's) tvname) (return 1) (return 0)))
      NODE-LIST
        (do
          (when (!= (node-mentions-tyvar-named (node-first n) tvname) 0) (return 1))
          (return (node-mentions-tyvar-named (node-rest n) tvname)))
      0)
    (return 0)))

; Resolved in the file that wrote it, retried at each read: a `:where` is parsed
; before an imported protocol is registered.
(defn constraint-settle (crec:ref:Constraint):void
  (when (crec 'settled) (return))
  (let (save-path:Symbol g-source-path
        save-ns:Symbol g-current-ns
        save-imports:?&ImportVec g-file-imports)
    (set! g-source-path (crec 'path))
    (set! g-current-ns (crec 'ns))
    (set! g-file-imports (crec 'imports))
    (let (p:?&Protocol (protocol-lookup (crec 'proto)))
      (set! g-source-path save-path)
      (set! g-current-ns save-ns)
      (set! g-file-imports save-imports)
      (when (!= p null)
        (set! (crec 'proto) (-> p (as &Protocol _) (_ 'name)))
        (set! (crec 'settled) true)))))

; The protocol a constraint names, as a registry key once it resolves.
(defn constraint-proto (crec:ref:Constraint):Symbol
  (constraint-settle crec)
  (return (crec 'proto)))

; Parse a `:where` constraint list into the `constraints` Vector (assoc-types A1,
; factored out for A4 so `emit-extend` can reuse it — design assoc-types-extend.md
; §5). `params-node` holds the constraint nodes starting at index `base`; there are
; `nc` of them. Appends, for each constraint i in [0,nc), one `(ref Constraint)`:
;   proto  — the protocol name;
;   var    — the conforming variable name;
;   args   — a ptr[] of the protocol-application Arg nodes (or null for a plain
;            `(Proto V)` constraint);
;   nargs  — the Arg count (0 for a plain constraint).
; Every constraint variable and every constraint-Arg tyvar is added to `tyvars`
; (size already provisioned by the caller) with `io-ntv` (a &i32 box) bumped.
; Diagnostics attribute to `line`.
(defn parse-where-constraints (params-node:?&Node base:i32 nc:i32
                                    constraints:ref:ConstraintVec
                                    tyvars:ptr io-ntv:ptr line:i32):void
  (dotimes (ci nc)
    (let (cnode:ptr (node-at params-node (+ base ci)))
      (when (or (not (node-is-list cnode)) (!= (node-len cnode) 2))
        (die-at line "defn: each :where constraint must be (Protocol Var)"))
      ; Element 0 is the protocol slot: either a bare symbol (plain
      ; protocol, unchanged path) or a list `(Proto Arg…)` (a protocol
      ; application — assoc-types A1). Element 1 is always the conforming
      ; variable symbol, in tail position, as in `(Ord T)`.
      (let (c0:&Node (unsafe/cast &Node (node-at cnode 0))
            vn:&Node (unsafe/cast &Node (node-at cnode 1))
            rec:ref:Constraint (new Constraint))
        (set! (rec 'args) null)
        (set! (rec 'nargs) 0)
        (set! (rec 'settled) false)
        (set! (rec 'ns) g-current-ns)
        (set! (rec 'path) g-source-path)
        (set! (rec 'imports) g-file-imports)
        (when (!= (vn 'kind) NODE-SYM)
          (die-at line "defn: :where constraint must name a protocol and a variable"))
        ; Element 0 may be null when written as the empty list `()` in the
        ; protocol slot; guard the kind read before classifying.
        (if (and (!= (as ptr c0) null) (= (c0 'kind) NODE-SYM))
          ; Kept as written: an imported protocol may not be registered yet, so
          ; `constraint-settle` resolves it in this file's environment.
          (set! (rec 'proto) (c0 's))
          ; Protocol application `((Proto Arg…) V)`: element 0 is a list
          ; whose head names the protocol and whose tail are the argument
          ; patterns. Each Arg is a type-spelling node; any tyvar in it is
          ; collected (recovered/constrained at dispatch — A2).
          (do
            (when (or (not (node-is-list (as ptr c0))) (< (node-len (as ptr c0)) 1))
              (die-at line "defn: :where constraint protocol application must be (Protocol Arg...)"))
            (let (hn:&Node (unsafe/cast &Node (node-at (as ptr c0) 0)))
              (when (!= (hn 'kind) NODE-SYM)
                (die-at line "defn: :where constraint protocol application head must be a protocol name"))
              (let (na:i32 (- (node-len (as ptr c0)) 1)
                    argv:ptr (if (> na 0) (arena-alloc (* na (ptr-bytes))) null))
                (dotimes (ai na)
                  (let (argn:ptr (node-at (as ptr c0) (+ ai 1)))
                    (set! (aref (unsafe/cast &ptr argv) ai) argn)
                    (collect-constraint-arg-tyvars argn (hn 's) tyvars io-ntv)))
                (set! (rec 'proto) (hn 's))
                (set! (rec 'args) argv)
                (set! (rec 'nargs) na)))))
        (constraint-settle rec)
        ; A blanket name and `Valid` are not in the registry and never will be.
        (when (and (not (rec 'settled))
                   (or (!= (blanket-lookup (rec 'proto)) 0) (= (rec 'proto) "Valid")))
          (set! (rec 'settled) true))
        (set! (rec 'var) (vn 's))
        (conj constraints rec)
        (when (< (tyvar-index-of (vn 's) tyvars (aref (unsafe/cast &i32 io-ntv) 0)) 0)
          (set! (aref (unsafe/cast &Symbol tyvars) (aref (unsafe/cast &i32 io-ntv) 0)) (vn 's))
          (set! (aref (unsafe/cast &i32 io-ntv) 0) (+ (aref (unsafe/cast &i32 io-ntv) 0) 1)))))))

; Register a bounded-generic defn as a METHOD-GENERIC template (Stage 9 rung 4).
; Tyvars come from two sources, merged (parametric-structs.md §4):
;   - explicit `:where (Protocol Var)` constraints (the variable is declared and
;     carries an extra bound);
;   - receiver inference — a free symbol appearing as an argument of a registered
;     struct-template application in a parameter/return type (`(ref (Vector T))`).
; A method may have receiver-inferred tyvars and no `:where` at all. Every
; declared tyvar must be determined by some parameter through the structural
; unifier; the body is retained and monomorphized per concrete call site.
(defn register-generic-defn (form:?&Node trusted:i32):void
  (let (ff:ptr:Node form
        name-node:ptr (node-at form 1)
        params-node:ptr (node-at form 2)
        fname:Symbol (defn-name-only name-node)
        wi:i32 (params-where-index params-node)
        has-where:i32 (if (>= (params-where-index params-node) 0) 1 0))
    (when (symbol-none? fname) (die-at (ff 'line) "defn: malformed generic name"))
    ; S4: bounded-generic templates bypass defn-parse-sig (the prescan routes them
    ; here and emit-defn returns early for templates), so hard-error a legacy
    ; `name:ret` / list-head `(name ret)` name here too, with the same diagnostic.
    (when (= (sig-name-is-bare name-node) 0)
      (die-at (ff 'line)
        (fstr "defn '" fname "': legacy 'name:ret' syntax is no longer supported — write (defn "
              fname " (params):ret …)")))
    (let (nraw:i32 (node-len params-node)
          nparams:i32 (if (>= wi 0) wi (defn-params-count params-node)))
      (dotimes (i nparams)
        (let (p:&Node (unsafe/cast &Node (node-at params-node i)))
          (when (!= (marker-named p "rest") 0)
            (die-at (node-line (as ptr p) (ff 'line)) "defn: :rest combined with a generic method is not supported yet"))))
      (let (nc:i32 (if (>= wi 0) (- nraw (+ wi 1)) 0))
        (when (and (!= has-where 0) (< nc 1))
          (die-at (ff 'line) "defn: :where requires at least one (Protocol Var) constraint"))
        ; Capacity: constraint vars + a conservative upper bound on receiver-
        ; inferred tyvars across every parameter and the return type. A single
        ; parameter applying a struct template `(Two I F S E)` contributes one
        ; tyvar per type argument (phantom params included), so sizing by node
        ; count — never less than the tyvar count — avoids the arena overrun that
        ; the old `nc + nparams + 1` estimate caused for multi-arg receivers.
        (let (slot-bound:i32 nc)
          (dotimes (sb-j nparams)
            (set! slot-bound (+ slot-bound
                                (count-pattern-nodes
                                  (binding-type-node (node-at params-node sb-j))))))
          (set! slot-bound (+ slot-bound
                              (count-pattern-nodes (defn-ret-node form))))
          ; Assoc-type tyvars (A1) appear literally as nodes inside a parametric
          ; constraint's protocol-application `(Proto Arg…)`, so size them by the
          ; same node-walk: walk element 0 of every constraint. A plain (symbol)
          ; element-0 contributes 1, which only over-allocates; a list `(Proto
          ; Arg…)` contributes one slot per Arg node, matching collect-pattern-
          ; tyvars' upper bound — no separate per-binding accounting needed.
          (dotimes (sb-c nc)
            (set! slot-bound (+ slot-bound
                                (count-pattern-nodes
                                  (node-at (node-at params-node (+ (+ wi 1) sb-c)) 0)))))
        (let (cap:i32 (if (> slot-bound 0) slot-bound 1)
              constraints:ref:ConstraintVec (vector-new-in &g-arena-alloc)
              tyvars:ptr     (arena-alloc (* cap (ptr-bytes)))
              ntv:i32 0)
          ; Parse the :where constraint list into the `constraints` Vector and
          ; collect constraint variables + Arg tyvars (assoc-types A1). Shared with
          ; emit-extend (A4) via parse-where-constraints.
          (parse-where-constraints params-node (+ wi 1) nc
                                   constraints
                                   tyvars (as &i32 &ntv) (ff 'line))
          ; Merge in receiver-inferred tyvars from each parameter and the return
          ; type. These are bound structurally by the unifier (a tyvar nested in a
          ; ptr/ref wrapper or a template application), so the old flat-only
          ; nested-position rejection no longer applies.
          (dotimes (j nparams)
            (collect-pattern-tyvars (binding-type-node (node-at params-node j))
                                    tyvars (as &i32 &ntv)))
          (collect-pattern-tyvars (defn-ret-node form)
                                  tyvars (as &i32 &ntv))
          ; TC-1: a tyvar the call does not determine (a return-only tyvar) is
          ; not a def-time error — it registers as METHOD-GENERIC and is filled
          ; from the call site's want channel. `tyvars-determined` computes the
          ; A1 fixpoint; `method-undetermined-tyvar` asks it at resolution time.
          ; An imported template was checked by its exporter.
          (when (= trusted 0)
            (generic-sig-check form wi tyvars ntv constraints nc)
            (dotimes (ci nc)
              (where-check-later (constraints-at constraints ci) (ff 'line) "defn")))
          ; Register the template.
          ; Keyed and marked as generic-register-method does a `defn-`.
          (let (key:Symbol (priv-key-define fname)
                g:&Generic (generic-find-or-new key))
            (let (m:&Method (new Method))
              (set! (m 'priv) g-defining-private)
              (set! (m 'param-types) null)
              (set! (m 'num-params) nparams)
              (set! (m 'ret-type) null)
              (set! (m 'has-rest) 0)
              (set! (m 'variadic) 0)
              (set! (m 'kind) METHOD-GENERIC)
              (set! (m 'ir-name) (symbol-none))
              (set! (m 'fn-type) null)
              (set! (m 'binop) null)
              (set! (m 'body) form)
              (set! (m 'tyvars) tyvars)
              (set! (m 'num-tyvars) ntv)
              (set! (m 'constraints) constraints)
              (set! (m 'num-constraints) nc)
              ; Imported templates were checked by the exporting unit; skip A2.
              (set! (m 'checked) trusted)
              ; Stage 15 B4: provenance, which this site never recorded because
              ; it does not go through `generic-register-method`. A generic is
              ; keyed BARE (R2), so `Method.src-ns` is the only thing that says
              ; which namespace a method came from — and without it a template
              ; reached as `p/name` filtered to nothing and the name did not
              ; resolve at all. Runs in `prescan-defn-signatures`, so
              ; `g-current-ns`/`g-source-path` are the defining file's.
              (set! (m 'src-ns) g-current-ns)
              (set! (m 'src-file) g-source-path)
              ; W9 item 43: and its import environment, because a TEMPLATE is the
              ; one method whose body is emitted somewhere else — `prescan-file-
              ; imports` has already filled this file's, which is why the value
              ; here is the defining file's and not its importer's.
              (set! (m 'src-imports) g-file-imports)
              (generic-add-method g m)))))))))

; Try to bind a generic template's type variables from a concrete argument
; tuple by structurally unifying each parameter's type pattern against the
; concrete argument Type* (unify-tpat): bare-tyvar params bind (and must agree on
; repeats); concrete params (including ptr/ref wrappers and parametric-struct
; applications like `(ref (Vector T))`) match positionally, binding any tyvars
; nested within. On success fills out-bound[tyvar-index] = Type* and returns 1; on
; any mismatch returns 0.
; Convert a retained conformance argument — a canonical type-spelling string such
; as "i32" or "ptr:Node" — back into a concrete Type*. Higher-kinded args are out
; of scope (assoc-types §5), so every stored spelling is a single (possibly
; colon-sugared) symbol, exactly what parse-type-from-node accepts from a SYM node.
(defn conf-arg-to-type (spelling:Symbol line:i32):&Type
  (let (n:&Node (as &Node (alloc-node))
        saved:i32 g-type-key-ok)
    (set! (n 'kind) NODE-SYM)
    (set! (n 'line) line)
    (set! (n 's) (spelling-as-key spelling))
    ; Stage 15 B3′: a retained conformance arg is a stored canonical spelling —
    ; a key, read back in a file that may not be the one that wrote it.
    (set! g-type-key-ok 1)
    (let (t:ref:Type (parse-type-from-node (as ptr n) line))
      (set! g-type-key-ok saved)
      (return t))))

; A retained conformance argument, spelled for a message.
(defn conf-arg-display (spelling:Symbol line:i32):StrView
  (return (type-display (conf-arg-to-type spelling line))))

; A conformance key in a message: a pointer key (`ptr:T`) is re-read and spelled,
; a stamped instance's (`Vector.pPt`) printed from its origin; any other already
; is its spelling.
(defn key-display (key:Symbol line:i32):StrView
  (when (symbol-contains-byte key 58) (return (conf-arg-display key line)))
  (when-some (sd (lookup-struct key)) (return (sdef-display sd)))
  (return (symbol-as-view key)))

; Assoc-types A2 (§3.5): after the positional unifier has bound the parameter
; tyvars in out-bound, recover or check the associated tyvars carried by each
; parametric `:where` constraint `((Proto Arg…) V)`. A fixpoint, because one
; constraint's recovered tyvar (S from `((Iterator S) I)`) can be another's input
; (`((UnaryFn S E) F)`).
;
;   For each constraint whose conforming variable V is now bound to a concrete
;   type CV (the constraint's nargs > 0; a plain protocol is skipped):
;     - look up CV's Conformance for Proto;
;     - for each Arg[j] paired with the conformance's stored args[j]:
;         · Arg[j] an as-yet-unbound declared tyvar → bind it (RECOVER);
;         · otherwise resolve Arg[j] (a bound tyvar or concrete type) to its
;           canonical spelling and require equality with args[j] (CONSTRAIN).
;
; Returns 1 once no new binding is added. Returns 0 (a *soft* no-match, mirroring
; generic-constraints-ok) when a determined V does not conform to Proto, so the
; candidate is rejected and the standard missing-conformance diagnostic fires
; downstream. Hard errors that cannot be "another candidate" — a conformance with
; no retained args (stale .nuch), or a constrain-step mismatch — die-at here.
; Recover or check one constraint's associated tyvars against the conforming
; variable's conformance record. Returns 1 to keep iterating (V unbound, or a
; binding was made — *changed via the out box), 1 with no change, or 0 for a soft
; no-match (V conforms to nothing for Proto). Hard errors (stale args, arity, or a
; constrain mismatch) die-at. `io-changed` is a &i32 box set to 1 on a RECOVER.
; Operates on an explicit constraint tuple (assoc-types A4, factored out of the
; Method* so emit-extend can reuse the same fixpoint — assoc-types-extend.md §5):
;   tyvar-names / num-tyvars — the declared tyvars and their count;
;   constraints — the parsed :where clause (Vector (ref Constraint));
;   ci — the constraint index; out-bound — the bound[tyvar-index] = Type* array;
;   io-changed — a &i32 box set to 1 on a RECOVER; line — diagnostic line for
;     the hard-error cases (stale args / arity mismatch).
; Index the (possibly-null) `constraints` Vector, asserting non-null. Every caller
; guards the access with `num-constraints` (0 ⇒ the Vector is never indexed), so the
; cast is sound — it centralizes the assertion the flow-checker demands at the
; `invoke` site (most Methods are non-generic and carry no constraints).
(defn constraints-at (cons:?&ConstraintVec i:i32):&Constraint
  (invoke (unsafe/cast &ConstraintVec cons) i:usize))

(defn count-bound (out-bound:ptr ntv:i32):i32
  (let (k:i32 0)
    (dotimes (i ntv)
      (when (!= (aref (unsafe/cast &ptr out-bound) i) null) (inc! k)))
    (return k)))

; A constraint the call's arguments contradict is the call's error, with the
; constraint as its note; outside a call (an `extend`'s stamp) the constraint is blamed.
(defn die-constraint-mismatch (at-call:bool ln:i32 msg:StrView):void
  (let (bc:BindCall g-bind-call)
    (when (or (not at-call) (symbol-none? (bc 'name))) (die-at ln msg))
    (let (full:StrView (fstr msg "\n  note: required by the :where constraint at "
                             g-source-path ":" ln))
      (set! g-bind-call (BindCall (symbol-none) (symbol-none) 0))
      (set! g-source-path (bc 'path))
      (die-at (bc 'line) full))))

(defn recover-one-constraint (tyvar-names:ptr num-tyvars:i32
                                  constraints:?&ConstraintVec
                                  ci:i32 out-bound:ptr io-changed:ptr line:i32 at-call:bool):i32
  (let (crec:ref:Constraint (constraints-at constraints ci)
        na:i32 (crec 'nargs))
    (when (= na 0) (return 1))
    (let (ntv:i32 num-tyvars
          proto:Symbol (constraint-proto crec)
          vidx:i32 (tyvar-index-of (crec 'var) tyvar-names ntv)
          cv:ptr (if (>= vidx 0) (aref (unsafe/cast &ptr out-bound) vidx) null))
      ; V not yet bound → defer to a later fixpoint iteration.
      (when (= cv null) (return 1))
      (let (cvspell:Symbol (type-spelling cv))
        ; Missing conformance is a soft reject (like generic-constraints-ok).
        ; Stage 13 L7: before rejecting, try to derive a structural conformance
        ; for a closure (the closure's invoke method satisfies the protocol's
        ; function-shaped method). derive-closure-conformance is idempotent, so
        ; a later generic-constraints-ok call that reaches the same (type, proto)
        ; sees the conformance already recorded and skips.
        (when (and (= (conformance-lookup cvspell proto) 0)
                   (= (derive-closure-conformance cv proto line) 0))
          (return 0))
        (let (cn:i32 0
              cargs:?&(Vector Symbol) (conformance-args cvspell proto (as &i32 &cn)))
          ; A recorded conformance with no retained args predates arg retention
          ; (stale .nuch) — a hard, fix-by-recompile error.
          (when (or (= cargs null) (= cn 0))
            (die-at line
              (fstr "conformance for protocol '" proto "' (type '" (key-display cvspell line)
                    "') was recorded without parameter bindings; recompile")))
          ; The constraint's arg count must match the protocol's parameter count;
          ; a mismatch would read past the stored args and is a hard error.
          (when (!= na cn)
            (die-at line
              (fstr "constraint '" proto
                    "' supplies the wrong number of arguments for the conformance of '" cvspell
                    "'")))
          (let (argv:ptr (crec 'args)
                cargsv:&(Vector Symbol) (unsafe/cast &(Vector Symbol) cargs))
            (dotimes (j na)
              (let (argn:ptr (aref (unsafe/cast &ptr argv) j)
                    conspell:Symbol (invoke cargsv j:usize)
                    an:&Node (unsafe/cast &Node argn)
                    tidx:i32 -1)
                ; A bare colon-free symbol naming a declared tyvar may be
                ; recovered or constrained; anything else is a concrete pattern.
                (when (and (= (an 'kind) NODE-SYM) (= (symbol-contains-byte (an 's) 58) false))
                  (set! tidx (tyvar-index-of (an 's) tyvar-names ntv)))
                (cond
                  (>= tidx 0)
                  (let (cur:ptr (aref (unsafe/cast &ptr out-bound) tidx))
                    (if (= cur null)
                      ; RECOVER: bind the tyvar to the stored arg type.
                      (do (set! (aref (unsafe/cast &ptr out-bound) tidx) (conf-arg-to-type conspell (node-line (as ptr an) line)))
                          (set! (aref (unsafe/cast &i32 io-changed) 0) 1))
                      ; CONSTRAIN: an already-bound tyvar must agree.
                      (when (!= (type-spelling cur) conspell)
                        (die-constraint-mismatch at-call (node-line (as ptr an) line)
                          (fstr "constraint '" proto "' parameter mismatch: expected "
                                (type-display cur) ", found "
                                (conf-arg-display conspell (node-line (as ptr an) line)))))))
                  ; A pattern over tyvars (`?E`, `&E`, `(Vector E)`) unifies against
                  ; the stored type, recovering the ones still unbound.
                  (!= (node-mentions-tyvar argn tyvar-names ntv) 0)
                  (let (nb:i32 (count-bound out-bound ntv)
                        ln:i32 (node-line (as ptr an) line))
                    (when (= (unify-tpat argn (conf-arg-to-type conspell ln) tyvar-names ntv out-bound ln) 0)
                      (let (pat:String (node-str argn))
                        (die-constraint-mismatch at-call ln
                          (fstr "constraint '" proto "' parameter mismatch: expected "
                                (string-as-view &pat) ", found "
                                (conf-arg-display conspell (node-line (as ptr an) line))))))
                    (when (!= (count-bound out-bound ntv) nb)
                      (set! (aref (unsafe/cast &i32 io-changed) 0) 1)))
                  ; CONSTRAIN: a concrete arg pattern must equal the stored arg.
                  true
                  (let (cty:ptr (parse-type-from-node argn (node-line (as ptr an) line)))
                    (when (!= (type-spelling cty) conspell)
                      (die-constraint-mismatch at-call (node-line (as ptr an) line)
                        (fstr "constraint '" proto "' parameter mismatch: expected "
                              (type-display cty) ", found "
                                (conf-arg-display conspell (node-line (as ptr an) line)))))))))
            (return 1)))))))

; Assoc-types A2 (§3.5): after the positional unifier has bound the parameter
; tyvars in out-bound, recover or check the associated tyvars carried by each
; parametric `:where` constraint `((Proto Arg…) V)`. A fixpoint, because one
; constraint's recovered tyvar (S from `((Iterator S) I)`) can be another's input
; (`((UnaryFn S E) F)`). Returns 0 (a soft no-match) when a determined V does not
; conform to Proto; 1 otherwise. A plain protocol (the constraint's nargs == 0) is skipped,
; so this is inert for every non-parametric constraint (e.g. `(Any T)`).
;
; Factored out of the Method* (assoc-types A4 §5) to operate on an explicit
; constraint tuple, so emit-extend can run the identical fixpoint at stamp time:
;   tyvar-names / num-tyvars — declared tyvars and count;
;   out-bound — mutable bound[tyvar-index] = Type* array (seeded by the caller);
;   constraints — the parsed :where clause (Vector (ref Constraint));
;   num-constraints — count; line — diagnostic line for hard errors.
(defn recover-assoc-into (tyvar-names:ptr out-bound:ptr num-tyvars:i32
                              constraints:?&ConstraintVec
                              num-constraints:i32 line:i32 at-call:bool):i32
  (let (nc:i32 num-constraints)
    (when (= nc 0) (return 1))
    (let (changed:i32 1)
      (while (!= changed 0)
        (set! changed 0)
        (let (ci:i32 0)
          (while (< ci nc)
            (when (= (recover-one-constraint tyvar-names num-tyvars
                                             constraints
                                             ci out-bound
                                             (as &i32 &changed) line at-call) 0)
              (return 0))
            (inc! ci)))))
    (return 1)))

; Record the call to `name` at `line` of this file for `diag-error`'s note, around
; a bind of its candidates. Returns what to restore.
(defn bind-call-arm (name:Symbol line:i32):BindCall
  (let (saved:BindCall g-bind-call)
    (set! g-bind-call (BindCall name g-source-path line))
    (return saved)))

; A template's signature is its file's text, read as that file, like its body
; (W9 item 43). Returns the environment to restore.
(defn method-env-enter (m:ptr:Method):NameEnv
  (return (name-env-enter (m 'src-ns) (m 'src-file) (m 'src-imports))))

; A protocol's signatures are another file's text when it was defined elsewhere;
; then they are read there, and what the reader substitutes goes in as markers.
(defn protocol-foreign? (p:ptr:Protocol):bool
  (return (and (not (symbol-none? (p 'src-file))) (!= (p 'src-file) g-source-path))))

(defn protocol-env-enter (p:ptr:Protocol):NameEnv
  (when (not (protocol-foreign? p)) (return (name-env-here)))
  (return (name-env-enter (p 'src-ns) (p 'src-file) (p 'src-imports))))

; Markers for spellings this file computed, to substitute into another file's text.
(defn env-arg-syms (spellings:ptr n:i32 line:i32):ptr
  (when (= n 0) (return spellings))
  (let (out:ptr (arena-alloc (* n (ptr-bytes))))
    (dotimes (i n)
      (set! (aref (unsafe/cast &Symbol out) i)
            (env-arg-sym (as ptr (intern-node (aref (unsafe/cast &Symbol spellings) i))) line)))
    (return out)))

; The line to blame in `m`'s text once its file is entered.
(defn method-text-line (m:ptr:Method line:i32):i32
  (when (or (symbol-none? (m 'src-ns)) (symbol-none? (m 'src-file))) (return line))
  (return (node-line (m 'body) line)))

(defn generic-method-bind (m:?&Method argtypes:ptr nargs:i32 out-bound:ptr want:?&Type arg-nodes:ptr):i32
  (let (here:NameEnv (method-env-enter m)
        r:i32 (generic-method-bind-in m argtypes nargs out-bound want arg-nodes))
    (name-env-set here)
    (return r)))

(defn generic-method-bind-in (m:?&Method argtypes:ptr nargs:i32 out-bound:ptr want:?&Type arg-nodes:ptr):i32
  (let (mm:ptr:Method m)
    (when (!= (mm 'num-params) nargs) (return 0))
    (let (params-node:ptr (node-at (mm 'body) 2)
          ntv:i32 (mm 'num-tyvars)
          ; LW-6 (int-widening.md follow-up, found while wrapping up the LW-5
          ; sweep): a literal argument whose param is a bare, still-unbound
          ; tyvar is deferred past assoc-recovery below, so a :where
          ; constraint's conformance (a real declared type) gets first claim
          ; on the tyvar instead of the literal's naive i32 — fixes `reduce`'s
          ; FoldFn Acc/T binding from a literal accumulator (e.g.
          ; `(reduce bs 0 it)` against a `(FoldFn i64 ui8)` conformance, which
          ; previously died "constraint 'FoldFn' parameter mismatch: expected
          ; i32, found i64" because Acc got bound to i32 from the literal
          ; before assoc-recovery had a chance to bind it from the
          ; conformance's real i64).
          ndeferred:i32 0
          deferred-ptn:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes)))
          deferred-at:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes))))
      (dotimes (k ntv) (set! (aref (unsafe/cast &ptr out-bound) k) null))
      (dotimes (i nargs)
        (let (ptn:ptr (binding-type-node (node-at params-node i))
              at:ptr (aref (unsafe/cast &ptr argtypes) i))
          (when (or (= ptn null) (= at null)) (return 0))
          (let (is-lit:i32 0
                tvidx:i32 -1)
            (when (!= arg-nodes null)
              (set! is-lit (node-is-int-literal (aref (unsafe/cast &ptr arg-nodes) i))))
            (when (= ((unsafe/cast &Node ptn) 'kind) NODE-SYM)
              (when (not (symbol-contains-byte ((unsafe/cast &Node ptn) 's) 58))
                (set! tvidx (tyvar-index-of ((unsafe/cast &Node ptn) 's) (mm 'tyvars) ntv))))
            ; Only defer if the tyvar is still unbound at this point in the
            ; pass — an earlier, non-deferred arg (e.g. conj's receiver
            ; binding T before the elem literal is considered) may have
            ; already bound it, in which case unify-tpat's ordinary
            ; constrain-or-fail check must still run (tier-1 correctly
            ; rejects a mismatched literal there, falling through to tier-2's
            ; arg-adapts widening — LW-1's existing, unrelated mechanism).
            (if (and (!= is-lit 0) (>= tvidx 0)
                     (= (aref (unsafe/cast &ptr out-bound) tvidx) null))
              (do
                (set! (aref (unsafe/cast &ptr deferred-ptn) ndeferred) ptn)
                (set! (aref (unsafe/cast &ptr deferred-at) ndeferred) at)
                (set! ndeferred (+ ndeferred 1)))
              (when (= (unify-tpat ptn at (mm 'tyvars) ntv out-bound
                                   (node-line ptn ((mm 'body) 'line))) 0)
                (return 0))))))
      ; Recover/check associated tyvars from the parametric :where constraints
      ; (assoc-types A2). A soft 0 here means a constraint's conforming variable
      ; does not conform — reject this candidate before the all-bound check.
      ; recover-assoc-into runs the shared fixpoint over the Method's fields.
      (when (= (recover-assoc-into (mm 'tyvars) out-bound (mm 'num-tyvars)
                                    (mm 'constraints)
                                    (mm 'num-constraints)
                                    ((mm 'body) 'line) true) 0)
        (return 0))
      ; LW-6: resolve deferred literal-arg tyvars that assoc-recovery left
      ; unbound (no conformance recovered them) — the pre-LW-6 fallback
      ; binding, unchanged for the common case with no such constraint.
      (dotimes (di ndeferred)
        (let (ptn:ptr (aref (unsafe/cast &ptr deferred-ptn) di)
              at:ptr (aref (unsafe/cast &ptr deferred-at) di)
              idx:i32 (tyvar-index-of ((unsafe/cast &Node ptn) 's) (mm 'tyvars) ntv))
          (when (= (aref (unsafe/cast &ptr out-bound) idx) null)
            (when (= (unify-tpat ptn at (mm 'tyvars) ntv out-bound
                                 (node-line ptn ((mm 'body) 'line))) 0)
              (return 0)))))
      ; TC-1: if tyvars remain unbound after args+assoc, fill them from the
      ; expected type (want) by unifying the method's return pattern against it.
      ; unify-tpat only sets a slot that is still null (it does type-eq on an
      ; already-bound slot), so want fills, never overrides an arg-derived
      ; binding. Skipped when want is null OR the binding is already complete
      ; (the common case — every existing generic binds all tyvars from args, so
      ; this branch is inert under self-compilation and never touches the return
      ; pattern).
      (when (!= want null)
        (let (incomplete:i32 0)
          (dotimes (k ntv)
            (when (= (aref (unsafe/cast &ptr out-bound) k) null) (set! incomplete 1)))
          (when (!= incomplete 0)
            (let (rnode:ptr (defn-ret-node (mm 'body)))
              (when (!= rnode null)
                (unify-tpat rnode want (mm 'tyvars) ntv out-bound
                            (node-line rnode ((mm 'body) 'line))))))))
      (dotimes (k ntv)
        (when (= (aref (unsafe/cast &ptr out-bound) k) null) (return 0)))
      (return 1))))

; Check that each :where constraint is satisfied: the type bound to its variable
; must conform (nominally, via `extend`) to the named protocol.
(defn generic-constraints-ok (m:?&Method bound:ptr line:i32):i32
  (let (mm:ptr:Method m
        nc:i32 (mm 'num-constraints))
    (dotimes (i nc)
      (let (crec:ref:Constraint (constraints-at (mm 'constraints) i)
            proto:Symbol (constraint-proto crec)
            var:Symbol   (crec 'var)
            idx:i32 (tyvar-index-of var (mm 'tyvars) (mm 'num-tyvars))
            bt:ptr (aref (unsafe/cast &ptr bound) idx))
        ; Blanket protocols (§10.1) conform automatically; Valid (§10.2) matches
        ; here and is checked structurally at the call site; otherwise require a
        ; nominal conformance recorded by `extend`. Stage 13 L7: a closure that
        ; has not hand-extended the protocol may still derive a structural
        ; conformance on demand (derive-closure-conformance is idempotent — if
        ; recover-one-constraint already fired during generic-method-bind, the
        ; conformance is already recorded and this is a no-op).
        (when (and (= (blanket-conforms bt proto) 0)
                   (and (!= proto "Valid")
                        (and (= (conformance-lookup (type-spelling bt) proto) 0)
                             (= (derive-closure-conformance bt proto line) 0))))
          (return 0))))
    (return 1)))

; ============================================================
; Stage 14 LW-1/LW-2: literal widening for the template tier
; ============================================================
; Template-tier methods (a receiver-inferred generic like `conj`/`invoke` over a
; parametric struct) are resolved by unify-tpat, which demands an *exact* match on
; every non-tyvar-binding parameter. So `(conj v 3)` on a `(Vector i64)` — which
; binds `T=i64` from the receiver and then needs the literal `3` to widen to i64 —
; failed to resolve, unlike a plain/protocol method (which reaches the tier-2
; arg-adapts loop). LW-1 extends that adaptation to the template tier; LW-2 mirrors
; the same tiers in `node-type-call` so the type model does not diverge from emit.

; Resolve a parameter type-pattern node to a concrete Type* under a tyvar binding.
; A bare tyvar symbol yields its bound Type* directly; anything else (a concrete
; type, or a parametric application still mentioning tyvars, e.g. `(Maybe T)`) is
; substituted with the bound spellings and parsed. Every tyvar in `bound` must be
; non-null (the callers guarantee this before invoking).
; Stage 15 B3′a: the shared "substitute the bound tyvars' spellings and re-parse"
; helper, and therefore a SYNTHESIS region — `type-spelling` renders a bound tyvar
; as its type's CANONICAL name, which the *calling* file usually cannot name. It is
; the chokepoint for `method-bound-ret-type` and `subst-param-types-bound`, so the
; arm belongs here rather than at either caller.
(defn resolve-param-type-bound (ptn:?&Node tyvars:ptr bound:ptr ntv:i32 line:i32):?&Type
  (when (= ptn null) (return null))
  (let (saved:i32 g-type-key-ok)
    (set! g-type-key-ok 1)
    (let (r:?&Type (resolve-param-type-bound-in ptn tyvars bound ntv line))
      (set! g-type-key-ok saved)
      (return r))))

(defn resolve-param-type-bound-in (ptn:?&Node tyvars:ptr bound:ptr ntv:i32 line:i32):?&Type
  (let (pn:ptr:Node ptn)
    (when (= (pn 'kind) NODE-SYM)
      (when (= (symbol-contains-byte (pn 's) 58) false)
        (let (idx:i32 (tyvar-index-of (pn 's) tyvars ntv))
          (when (>= idx 0) (return (aref (unsafe/cast &ptr bound) idx))))))
    (return (parse-type-from-node (subst-tyvars-node ptn tyvars (stamp-key-spellings bound ntv) ntv)
                                  line))))

; The concrete return type of a generic template method under a tyvar binding: a
; bare-tyvar return picks its bound Type*, else the (possibly parametric) return
; spelling is substituted and parsed. A method with no declared return is `void`.
; Extracted from generic-binds-for so the exact-template and adapted-template
; paths compute the return type identically (the node-type↔emit lockstep).
(defn method-bound-ret-type (m:?&Method bound:ptr line:i32):?&Type
  (let (here:NameEnv (method-env-enter m)
        r:?&Type (method-bound-ret-type-in m bound (method-text-line m line)))
    (name-env-set here)
    (return r)))

(defn method-bound-ret-type-in (m:?&Method bound:ptr line:i32):?&Type
  (let (mm:ptr:Method m
        rnode:ptr (defn-ret-node (mm 'body)))
    (when (= rnode null) (return ty-void))
    (let (rt:ptr null)
      (when (= (-> rnode (unsafe/cast &Node _) (_ 'kind)) NODE-SYM)
        (let (ridx:i32 (tyvar-index-of (-> rnode (unsafe/cast &Node _) (_ 's))
                                        (mm 'tyvars) (mm 'num-tyvars)))
          (when (>= ridx 0) (set! rt (aref (unsafe/cast &ptr bound) ridx)))))
      (when (= rt null)
        (set! rt (resolve-param-type-bound rnode (mm 'tyvars) bound (mm 'num-tyvars)
                                           (node-line (as ?&Node rnode) line))))
      (return rt))))

; The concrete parameter types of a generic template method under a tyvar binding,
; as a ptr-array. Used to key generic-instantiate's cache (generic-find-method-exact)
; on an adapted call, where the raw argument types (e.g. an i32 literal) differ from
; the stamped method's parameter types (i64) — matching what defn-params-to-types
; derives from the stamped form.
(defn subst-param-types-bound (m:?&Method bound:ptr line:i32):ptr
  (let (mm:ptr:Method m
        params-node:ptr (node-at (mm 'body) 2)
        nargs:i32 (mm 'num-params)
        ntv:i32 (mm 'num-tyvars)
        ptypes:ptr (arena-alloc (* (+ nargs 1) (ptr-bytes)))
        here:NameEnv (method-env-enter m)
        tline:i32 (method-text-line m line))
    (dotimes (i nargs)
      (let (ptn:?&Node (binding-type-node (node-at params-node i)))
        (set! (aref (unsafe/cast &ptr ptypes) i)
              (resolve-param-type-bound ptn (mm 'tyvars) bound ntv (node-line ptn tline)))))
    (name-env-set here)
    (return ptypes)))

; Like generic-method-bind, but admits widen/literal adaptation on the parameters
; the receiver-and-exact-args pass cannot match exactly (LW-1). Bind the tyvars
; from every parameter that unifies exactly (unchanged); then require every tyvar
; bound (adaptation never binds a tyvar); then require each remaining parameter's
; argument to adapt to its now-concrete (tyvar-substituted) parameter type. A
; fully-exact bind is rejected here (any-remaining==0) so tier-1 keeps sole
; ownership of exact template matches and tier-2 never double-counts one. Fills
; out-bound and returns 1 on an adapted match, else 0.
(defn generic-method-bind-adapt (m:?&Method argtypes:ptr arg-nodes:ptr nargs:i32
                                     out-bound:ptr line:i32 want:?&Type):i32
  (let (here:NameEnv (method-env-enter m)
        r:i32 (generic-method-bind-adapt-in m argtypes arg-nodes nargs out-bound
                                            (method-text-line m line) want))
    (name-env-set here)
    (return r)))

(defn generic-method-bind-adapt-in (m:?&Method argtypes:ptr arg-nodes:ptr nargs:i32
                                        out-bound:ptr line:i32 want:?&Type):i32
  (let (mm:ptr:Method m)
    (when (!= (mm 'num-params) nargs) (return 0))
    (let (params-node:ptr (node-at (mm 'body) 2)
          ntv:i32 (mm 'num-tyvars)
          matched:ptr (arena-alloc (* (+ nargs 1) 4))
          saved:ptr (arena-alloc (* (+ ntv 1) (ptr-bytes)))
          any-remaining:i32 0)
      (dotimes (k ntv) (set! (aref (unsafe/cast &ptr out-bound) k) null))
      ; Pass 1: bind tyvars from every parameter that unifies exactly. A failed
      ; unify must leave no partial binding (unify-tpat only sets, never clears),
      ; so snapshot out-bound and restore on failure; that parameter is deferred to
      ; pass 2 (its argument checked for widen/literal adaptation).
      (dotimes (i nargs)
        (let (ptn:ptr (binding-type-node (node-at params-node i))
              at:ptr (aref (unsafe/cast &ptr argtypes) i))
          (when (or (= ptn null) (= at null)) (return 0))
          (dotimes (k ntv) (set! (aref (unsafe/cast &ptr saved) k) (aref (unsafe/cast &ptr out-bound) k)))
          (if (!= (unify-tpat ptn at (mm 'tyvars) ntv out-bound (node-line ptn line)) 0)
            (set! (aref (unsafe/cast &i32 matched) i) 1)
            (do (set! (aref (unsafe/cast &i32 matched) i) 0)
                (set! any-remaining 1)
                (dotimes (k ntv)
                  (set! (aref (unsafe/cast &ptr out-bound) k) (aref (unsafe/cast &ptr saved) k)))))))
      ; A fully-exact bind is a tier-1 match — reject so tier-2 never double-counts.
      ; But only when the binding is actually COMPLETE: a method whose args all
      ; matched exactly yet still has an unbound tyvar (notably a zero-arg
      ; return-only-tyvar generic, or any return-only tyvar not reached by args)
      ; is NOT a tier-1 match, and must fall through to want-fill (TC-1) below,
      ; which may complete it. Without this guard a zero-arg generic dies here
      ; before want-fill ever runs.
      (when (= any-remaining 0)
        (let (complete:i32 1)
          (dotimes (k ntv)
            (when (= (aref (unsafe/cast &ptr out-bound) k) null) (set! complete 0)))
          (when (!= complete 0) (return 0))))
      ; Recover associated tyvars from parametric :where constraints, then require
      ; every tyvar bound by the exactly-matched parameters (adaptation never binds
      ; a tyvar, so a tyvar reachable only through a deferred parameter stays null).
      (when (= (recover-assoc-into (mm 'tyvars) out-bound ntv
                                    (mm 'constraints)
                                    (mm 'num-constraints)
                                    ((mm 'body) 'line) true) 0)
        (return 0))
      ; TC-1: fill any tyvars still unbound after exact-args+assoc from the
      ; expected type (want), BEFORE the all-bound check and before pass-2
      ; adaptation. LW's "adaptation never binds a tyvar" invariant is preserved:
      ; want-fill is a binding step distinct from the arg adaptation below.
      ; unify-tpat only sets a still-null slot, so want never overrides an
      ; arg-derived binding. Skipped when want is null OR the binding is already
      ; complete (the common case — inert under self-compilation).
      (when (!= want null)
        (let (incomplete:i32 0)
          (dotimes (k ntv)
            (when (= (aref (unsafe/cast &ptr out-bound) k) null) (set! incomplete 1)))
          (when (!= incomplete 0)
            (let (rnode:ptr (defn-ret-node (mm 'body)))
              (when (!= rnode null)
                (unify-tpat rnode want (mm 'tyvars) ntv out-bound
                            (node-line rnode line)))))))
      (dotimes (k ntv)
        (when (= (aref (unsafe/cast &ptr out-bound) k) null) (return 0)))
      ; Pass 2: every deferred parameter's argument must adapt (same rule as the
      ; plain tier-2: a literal adapts to any int, a typed value only same-sign
      ; widens) against its now-concrete parameter type.
      (dotimes (i nargs)
        (when (= (aref (unsafe/cast &i32 matched) i) 0)
          (let (ptn:ptr (binding-type-node (node-at params-node i))
                at:ptr (aref (unsafe/cast &ptr argtypes) i)
                pt:ptr (resolve-param-type-bound ptn (mm 'tyvars) out-bound ntv line)
                is-lit:i32 0
                is-flit:i32 0)
            (when (= pt null) (return 0))
            (when (!= arg-nodes null)
              (set! is-lit (node-is-int-literal (aref (unsafe/cast &ptr arg-nodes) i)))
              (when (= is-lit 0)
                (set! is-flit (node-is-float-literal (aref (unsafe/cast &ptr arg-nodes) i)))))
            (when (= (arg-adapts at pt is-lit is-flit) 0) (return 0)))))
      (return 1))))

; The shared tier-2 adaptation pool for generic resolution (LW-1/LW-2). Concrete
; (METHOD-USER) methods reachable by a widen/literal adaptation and parametric
; templates (METHOD-GENERIC) reachable by binding the receiver then adapting the
; rest compete in *one* ambiguity pool. Side-effect-free: no method is instantiated
; here (the emit caller monomorphizes a template winner; the node-type caller reads
; its bound return type), so both the dying and the null-returning caller share the
; identical resolution. Returns 0 = no tier-2 match, 1 = a unique METHOD-USER match
; (*out-method), 2 = a unique template match (*out-method + *out-bound), 3 = an
; ambiguous pool (the caller reports/ignores per its mode).
(defn generic-resolve-adapt-tier (g:?&Generic argtypes:ptr arg-nodes:ptr nargs:i32 line:i32
                                      out-method:&ptr out-bound:&ptr want:?&Type):i32
  (let (gg:ptr:Generic g
        wmethod:ptr null
        wbound:ptr null
        wn:i32 0)
    ; METHOD-USER candidates reachable by widen/literal adaptation on every arg. A
    ; stamped template instance (origin-template ≠ null) is skipped: it is a cache
    ; of its template, which competes below, so counting both would spuriously read
    ; as an ambiguous overload after the first widened call instantiates it.
    (dotimes (k (unsafe/cast i32 (count (gg 'methods))))
      (let (m:&Method (as &Method (invoke (gg 'methods) k:usize)))
        (when (and (= (m 'kind) METHOD-USER)
                   (= (m 'origin-template) null)
                   (= (m 'has-rest) 0) (= (m 'num-params) nargs))
          (let (ok:i32 1)
            (dotimes (a nargs)
              (let (is-lit:i32 0
                    is-flit:i32 0)
                (when (!= arg-nodes null)
                  (set! is-lit (node-is-int-literal (aref (unsafe/cast &ptr arg-nodes) a)))
                  (when (= is-lit 0)
                    (set! is-flit (node-is-float-literal (aref (unsafe/cast &ptr arg-nodes) a)))))
                (when (= (arg-adapts (aref (unsafe/cast &ptr argtypes) a)
                                     (aref (unsafe/cast &ptr (m 'param-types)) a) is-lit is-flit) 0)
                  (set! ok 0))))
            (when (!= ok 0)
              (set! wmethod (as ptr m)) (set! wbound null) (inc! wn))))))
    ; METHOD-GENERIC (template) candidates reachable by receiver-bind + adaptation.
    (dotimes (k (unsafe/cast i32 (count (gg 'methods))))
      (let (m:&Method (as &Method (invoke (gg 'methods) k:usize)))
        (when (= (m 'kind) METHOD-GENERIC)
          (let (bound:ptr (arena-alloc (* (+ (m 'num-tyvars) 1) (ptr-bytes))))
            (when (!= (generic-method-bind-adapt (as ptr m) argtypes arg-nodes nargs bound line want) 0)
              (when (!= (generic-constraints-ok (as ptr m) bound line) 0)
                (set! wmethod (as ptr m)) (set! wbound bound) (inc! wn)))))))
    (when (> wn 1) (return 3))
    (when (= wn 0) (return 0))
    (set! @out-method wmethod)
    (when (!= wbound null)
      (set! @out-bound wbound)
      (return 2))
    (return 1)))

; Build a concrete defn form from a generic template + a type-variable binding:
; substitute the variables throughout, then drop the :where clause.
(defn monomorphize-form (form:?&Node tyvars:ptr spellings:ptr ntv:i32 nparams:i32):?&Node
  (let (ff:ptr:Node form
        line:i32 (ff 'line)
        defn-sym:ptr (node-at form 0)
        name-node:ptr (subst-tyvars-node (node-at form 1) tyvars spellings ntv)
        params-src:ptr (subst-tyvars-node (node-at form 2) tyvars spellings ntv)
        new-params:ptr null
        body-src:ptr (subst-tyvars-node
                       (node-rest (node-rest (node-rest ff)))
                       tyvars spellings ntv))
    (set! new-params (take-first-n params-src nparams line))
    (return (node-cons defn-sym
              (node-cons name-node
                (node-cons new-params body-src line) line) line))))

; Monomorphize a generic template for a concrete argument tuple: reuse a cached
; instantiation if present, else stamp a concrete method (registered now so the
; call site can name its symbol; its body is queued for later emission).
; Stage 15 B3′a: stamping a generic instance is a SYNTHESIS region. The stamped
; form's type operands are `type-spelling` output for every bound tyvar and the
; template file's own spellings for the rest — never anything the *calling* file
; wrote — and this runs at the call site, so resolving them as references asks the
; wrong file. `drain-mono-worklist` already arms the body's emission; the signature
; is parsed here, before the job is queued, and needed the same arm.
(defn generic-instantiate (g:?&Generic m:?&Method bound:ptr argtypes:ptr nargs:i32 line:i32):&Method
  (let (saved:i32 g-type-key-ok)
    (set! g-type-key-ok 1)
    (let (r:ref:Method (generic-instantiate-in g m bound argtypes nargs line))
      (set! g-type-key-ok saved)
      (return r))))

(defn generic-instantiate-in (g:?&Generic m:?&Method bound:ptr argtypes:ptr nargs:i32 line:i32):&Method
  (let (gg:ptr:Generic g
        mm:ptr:Method m
        ; SE-2: what this instance's parameter types do not carry. Null for every
        ; template whose tyvars the parameters determine — the ordinary case, in
        ; which the memo, the symbol and the reference lookup are all unchanged.
        disc:ptr (match (method-undetermined-tyvar m)
                   ((some _) (method-bound-ret-type m bound line))
                   (none null)))
    (let (existing:?&Method (if (= disc null)
                                 (generic-find-method-exact g argtypes nargs)
                                 (generic-find-want-stamp g argtypes nargs (as ?&Type disc))))
      (when (!= existing null)
        (return existing)))
    ; Concrete spelling for each bound type variable, used to stamp the body.
    (let (spellings:ptr (stamp-key-spellings bound (mm 'num-tyvars))
          req-path:Symbol g-source-path
          req-ctx:StrView g-mono-context
          here:NameEnv (method-env-enter m)
          tline:i32 (method-text-line m line))
      (when (!= g-source-path req-path)
        (set! g-mono-context (fstr "while instantiating '" (gg 'name) "' (requested at "
                                   req-path ":" line ")")))
    (let (stamped:ptr (monomorphize-form (mm 'body) (mm 'tyvars) spellings
                                         (mm 'num-tyvars) (mm 'num-params))
          sname:Symbol (symbol-none)
          ; S1: a new-style template stamps its return type into the index-3 keyword
          ; (substituted by subst-tyvars-node's NODE-KEYWORD branch inside
          ; monomorphize-form); parse it with the fn grammar. Legacy stamped forms
          ; keep the exact extract-name-and-type parse.
          s-ret-node:ptr null
          s-params:ptr null
          s-bstart:i32 3
          s-style:i32 (defn-parse-sig stamped (as &Symbol &sname)
                        (as &ptr &s-ret-node)
                        (as &ptr &s-params)
                        (as &i32 &s-bstart))
          sret:ptr (if (!= s-style 0)
                     (fn-parse-ret-type s-ret-node (node-line (as ?&Node s-ret-node) tline))
                     (extract-name-and-type (node-at stamped 1) (as &Symbol &sname)
                                            ((unsafe/cast &Node (node-at stamped 1)) 'line))))
      (when (= sret null)
        (die-at tline (fstr "generic '" (gg 'name) "': cannot resolve instantiated return type")))
      ; Valid bound (§10.2): dry-run the concrete body before committing it, so an
      ; operation C can't support is reported at this call site, not at stamp time.
      (when (!= (method-has-valid m) 0)
        (let (tpath:Symbol g-source-path
              tctx:StrView g-mono-context)
          (set! g-source-path req-path)
          (set! g-mono-context req-ctx)
          (valid-check-instance m stamped bound line)
          (set! g-source-path tpath)
          (set! g-mono-context tctx)))
      (let (ptypes:ptr null)
        ; Stage 13 L7: parse param types from the STAMPED form (not argtypes) so
        ; the method's param-types match what emit-defn will re-parse from the
        ; same stamped form. This matters when a bare TY-FN arg flows into a
        ; (ref G) param: argtypes has bare TY-FN, but the stamped form has
        ; (ref __fnty_N) = TY-PTR. Using the stamped-form types keeps
        ; defn-ir-name, mangle-fn-name, and emit-resolved-call's TY-FN-to-
        ; (ref TY-FN) calling-convention adaptation all consistent.
        (let (stamped-params:ptr (node-at stamped 2))
          (set! ptypes (defn-params-to-types-at stamped-params tline))
          (set! nargs (defn-params-count stamped-params)))
        (name-env-set here)
        (set! g-mono-context req-ctx)
        (let (newm:ref:Method (generic-register-method (gg 'name) sret ptypes nargs 0 0 stamped)
              ; Stage 12 N4: mangle the stamped concrete method under the
              ; template's *defining* namespace, not the call site's current one.
              ; Stage 15 W9 item 23: that is the TEMPLATE method's namespace, not
              ; the generic's — `gg ir-prefix` names whichever namespace created
              ; the bare-keyed generic first, which is the template's only when
              ; no other namespace defines the same name. Same source of truth as
              ; the `(mm src-ns)` re-ownership four lines below.
              ; SE-2: … plus, when the parameter tokens do not identify the
              ; instance, the bound return type. `$` is legal in an LLVM symbol
              ; and `type-mangle-token` never emits one, so `.$r.` cannot be read
              ; as a parameter token. template-ref-equality.md §5.
              mangled:Symbol (let (base:Symbol (mangle-fn-name (method-ir-prefix gg (as ?&Method mm))
                                                         (gg 'name) ptypes nargs))
                            (if (= disc null)
                              base
                              (symbol-intern (fstr base ".$r." (type-mangle-token (as ?&Type disc))))))
              job:&MonoJob (mono-job-here stamped
                                (fstr "while instantiating " mangled " (requested at "
                                      g-source-path ":" line ")")))
          (set! (newm 'ir-name) mangled)
          ; Stage 14 LW-1: mark this as a stamped instance of the template `mm` so
          ; tier-2 widening resolution treats the two as one overload.
          (set! (newm 'origin-template) mm)
          ; SE-2: `ir-fixed` says "this symbol is already decided", which is now
          ; true of a discriminated stamp for the same reason it is true of an
          ; imported method — `finalize-generics` would re-mangle it from the
          ; parameter types alone and drop the `.$r.`, and would read its siblings
          ; as duplicate definitions of one signature.
          (when (!= disc null) (set! (newm 'ir-fixed) 1))
          ; Stage 15 B4: a stamp is owned by the TEMPLATE's namespace, not by the
          ; call site's — the same distinction `(gg ir-prefix)` above already
          ; makes for mangling. `generic-register-method` wrote `g-current-ns`,
          ; which here is the calling file's. Without this correction the second
          ; `p/tmpl` call in another namespace filters the first stamp out of the
          ; method set, `generic-find-method-exact`'s memo probe misses, and the
          ; instance is stamped (and emitted) twice under one symbol.
          (set! (newm 'src-ns) (mm 'src-ns))
          (set! (newm 'src-imports) (mm 'src-imports))
          ; Stage 15 W9 item 43: and the body resolves its names as the TEMPLATE's
          ; file, not as this one. `mono-job-here` captured the call site's
          ; environment, which is the right default for a body the compiler
          ; synthesizes here and the wrong one for a body the library wrote: a
          ; bare name in it means what the library meant by it. Before this the
          ; answer depended on how many overloads the callee happened to have —
          ; a merged bare-keyed generic (R2) resolved from any namespace, while a
          ; solitary name or a global went through the environment and reported
          ; `unknown: <name>` against the CALLER's file at the LIBRARY's line.
          (set! (job 'ns) (mm 'src-ns))
          (set! (job 'path) (mm 'src-file))
          (set! (job 'imports) (mm 'src-imports))
          (conj g-mono-worklist job)
          (return newm)))))))

; ============================================================
; A2: def-time checking of bounded-generic bodies
; ============================================================
; Type-check a generic template body ONCE at its definition against the abstract
; protocol interface: a value of type variable T (an abstract `TY-TYVAR`) admits
; only the operations its `:where` protocols declare (with Self → T) — plus calls
; to other generics whose own constraints T's constraints satisfy. A use the
; constraints don't provide errors at the `defn`, not at the first instantiation.
; This never emits and only ever manufactures TY-TYVAR types, which codegen never
; sees (templates emit only after monomorphization).

(defn make-tyvar-type (m:ptr idx:i32):&Type
  (let (t:ref:Type (make-type TY-TYVAR))
    (set! (t 'sdef) m)         ; owning template Method*
    (set! (t 'num-params) idx) ; tyvar index within that template
    (return t)))

; t is genuinely a Type* (TY-TYVAR-flavored); only its `sdef` slot is a
; deliberate type pun (holds the owning template Method*, not a StructDef*,
; and is never read except through the explicit cast below) — confined to
; this A2 checker, never reaching codegen.
(defn tyvar-type-name (t:ptr:Type):Symbol
  (let (m:&Method (unsafe/cast &Method (t 'sdef))
        idx:i32 (t 'num-params))
    (return (aref (unsafe/cast &Symbol (m 'tyvars)) idx))))

(defn is-tyvar-type (t:?&Type):i32
  (when (= t null) (return 0))
  (if (= (t 'kind) TY-TYVAR) (return 1) (return 0)))

; The type-spelling tail of a colon symbol ("a:Self" → "Self"), or the zero
; Symbol when there is none — see `split-typed`.
(defn colon-tail (s:Symbol):Symbol
  (let (nm:Symbol (symbol-none) tail:Symbol (symbol-none))
    (split-typed s (as &Symbol &nm) (as &Symbol &tail))
    (return tail)))

; Parse a concrete type from a colon spelling string (no Self/tyvars).
(defn parse-type-spelling-str (s:Symbol line:i32):ptr
  (when (not (symbol-contains-byte s 58)) (return (parse-type-name s line)))
  (return (parse-type-from-node (split-colon-segments s line) line)))

; Does a colon spelling mention "Self" as a segment other than being exactly Self?
(defn spelling-nests-self (s:Symbol):i32
  (when (= s "Self") (return 0))
  (let (segs:ptr (split-colon-segments s 0))
    (dotimes (i (node-len segs))
      (let (seg:Symbol ((unsafe/cast &Node (node-at segs i)) 's)
            run:usize (type-sigil-run seg))
        (when (or (= seg "Self")
                  (and (> run 0) (= (strview-drop-bytes (symbol-as-view seg) run) "Self")))
          (return 1)))))
  (return 0))

(defn caller-has-constraint (m:&Method tyvar-name:Symbol proto:Symbol):i32
  (let (mm:&Method m)
    (dotimes (i (mm 'num-constraints))
      (let (crec:ref:Constraint (constraints-at (mm 'constraints) i))
        (when (and (= (crec 'var) tyvar-name)
                   (= (constraint-proto crec) proto))
          (return 1)))))
  (return 0))

; Does colon spelling `s` name one of `names` in any segment, under any sigil?
(defn spelling-mentions-any (s:Symbol names:ptr n:i32):bool
  (let (segs:ptr (split-colon-segments s 0))
    (dotimes (i (node-len segs))
      (let (seg:Symbol ((unsafe/cast &Node (node-at segs i)) 's)
            run:usize (type-sigil-run seg))
        (when (> run 0) (set! seg (symbol-intern (strview-drop-bytes (symbol-as-view seg) run))))
        (when (>= (tyvar-index-of seg names n) 0) (return true)))))
  (return false))

; Is `a` the same (possibly abstract) type as `b`? Two tyvars are the same variable.
(defn abstract-type-same (a:ptr b:ptr):bool
  (when (or (!= (is-tyvar-type a) 0) (!= (is-tyvar-type b) 0))
    (return (and (!= (is-tyvar-type a) 0) (!= (is-tyvar-type b) 0)
                 (= (-> a (unsafe/cast &Type _) (_ 'sdef)) (-> b (unsafe/cast &Type _) (_ 'sdef)))
                 (= (-> a (unsafe/cast &Type _) (_ 'num-params)) (-> b (unsafe/cast &Type _) (_ 'num-params))))))
  (return (!= (type-eq a b) 0)))

; What spelling `sp` of a protocol signature means in template `m`'s body: `Self`
; is tyvar `ti`, a protocol parameter is the constraint's argument, read as `m`
; wrote it. Null with `@unmod` set for a pattern over tyvars, which A2 defers.
(defn sig-spelling-type (sp:Symbol ti:i32 m:&Method crec:ref:Constraint pp:&Protocol
                         line:i32 unmod:&bool):ptr
  (when (= sp "Self") (return (make-tyvar-type m ti)))
  (let (k:i32 (tyvar-index-of sp (pp 'params) (pp 'num-params)))
    (when (>= k 0)
      (when (>= k (crec 'nargs)) (set! @unmod true) (return null))
      (let (an:ptr:Node (aref (unsafe/cast &ptr (crec 'args)) k))
        (when (and (= (node-kind an) NODE-SYM) (not (symbol-contains-byte (an 's) 58)))
          (let (idx:i32 (tyvar-index-of (an 's) (m 'tyvars) (m 'num-tyvars)))
            (when (>= idx 0) (return (make-tyvar-type m idx)))))
        (when (!= (node-mentions-tyvar an (m 'tyvars) (m 'num-tyvars)) 0)
          (set! @unmod true) (return null))
        (let (here:NameEnv (method-env-enter m)
              t:ptr (parse-type-from-node (as ptr an) (node-line (as ptr an) line)))
          (name-env-set here)
          (return t)))))
  (when (or (spelling-mentions-any sp (pp 'params) (pp 'num-params))
            (!= (spelling-nests-self sp) 0))
    (set! @unmod true)
    (return null))
  (return (parse-type-spelling-str sp line)))

; Does protocol signature `sig` provide the call `head(argtypes)` for tyvar `ti`
; of template `m` (Self → that tyvar)? Returns the call's result type or null.
(defn sig-provides-call (sig:?&Node head:Symbol ti:i32 m:&Method crec:ref:Constraint pp:&Protocol
                         argtypes:ptr nargs:i32 line:i32):ptr
  (let (name-node:ptr (node-at sig 0)
        params:ptr (node-at sig 1)
        nm:Symbol (symbol-none)
        rettail:Symbol (symbol-none))
    (if (!= (sig-name-is-bare name-node) 0)
      ; S1 new style: bare method name at 0, return operand at 2. rettail is the
      ; return's colon-spelling ("Self", "i32", "ptr:Node"); a list-form return
      ; leaves it null (→ ty-void here), matching the legacy list-head limitation.
      (do
        (set! nm (-> name-node (unsafe/cast &Node _) (_ 's)))
        (when (>= (node-len sig) 3)
          (let (rn:&Node (unsafe/cast &Node (node-at sig 2)))
            (when (or (= (rn 'kind) NODE-KEYWORD) (= (rn 'kind) NODE-SYM))
              (set! rettail (rn 's))))))
      (split-typed (-> name-node (unsafe/cast &Node _) (_ 's))
                   (as &Symbol &nm) (as &Symbol &rettail)))
    ; A signature with its own `:where` is generic; its call is checked at the stamp.
    (when (and (= nm head) (= (node-len params) nargs) (< (params-where-index params) 0))
      (let (ok:i32 1
            unmod:bool false)
        (dotimes (i nargs)
          (let (pn:&Node (unsafe/cast &Node (node-at params i))
                pspell:Symbol (colon-tail (pn 's))
                at:ptr (aref (unsafe/cast &ptr argtypes) i))
            (if (symbol-none? pspell)
              (set! ok 0)
              (let (pt:ptr (sig-spelling-type pspell ti m crec pp line &unmod))
                (when (or unmod (not (abstract-type-same pt at)))
                  (set! ok 0))))))
        (when (!= ok 0)
          (when (symbol-none? rettail) (return ty-void))
          ; An unmodelled return is not "no such method": null defers either way.
          (return (sig-spelling-type rettail ti m crec pp line &unmod)))))
    (return null)))

; Resolve a call with at least one abstract argument against the protocol methods
; provided by the constraints on the call's tyvar arguments. Result type or null.
(defn abstract-call-via-protocol (head:Symbol argtypes:ptr nargs:i32 m:&Method line:i32):ptr
  (let (mm:&Method m)
    (dotimes (ti (mm 'num-tyvars))
      (let (tvname:Symbol (aref (unsafe/cast &Symbol (mm 'tyvars)) ti))
        (dotimes (ci (mm 'num-constraints))
          (let (crec:ref:Constraint (constraints-at (mm 'constraints) ci))
           (when (= (crec 'var) tvname)
            ; B2a: resolved in the file that WROTE it, so this is a key.
            (let (proto:ptr (protocol-lookup-ns (constraint-proto crec)))
              (when (!= proto null)
                (let (pp:&Protocol (unsafe/cast &Protocol proto))
                  (dotimes (si (pp 'num-sigs))
                    (let (sig:?&Node (aref (unsafe/cast &ptr (pp 'sigs)) si)
                          sline:i32 (if (protocol-foreign? pp)
                                      (node-line (as ptr sig) line) line)
                          ctx:StrView (foreign-read-context (pp 'src-file) "protocol" (pp 'name) line)
                          here:NameEnv (protocol-env-enter pp)
                          rt:ptr (sig-provides-call sig head ti m crec pp
                                                    argtypes nargs sline))
                      (name-env-set here)
                      (set! g-mono-context ctx)
                      (when (!= rt null) (return rt)))))))))))))
  (return null))

; Resolve an abstract-argument call against another generic template whose own
; constraints are satisfied by the caller's tyvar constraints. Result type or null.
(defn abstract-call-via-generic (head:Symbol argtypes:ptr nargs:i32 m:&Method line:i32):ptr
  (let (g:ptr (generic-lookup head))
    (when (= g null) (return null))
    (let (gg:&Generic (unsafe/cast &Generic g))
      (dotimes (gi (unsafe/cast i32 (count (gg 'methods))))
        (let (m2:&Method (as &Method (invoke (gg 'methods) gi:usize)))
          (when (= (m2 'kind) METHOD-GENERIC)
            (let (bound:ptr (arena-alloc (* (+ (m2 'num-tyvars) 1) (ptr-bytes))))
              (when (!= (generic-method-bind (as ptr m2) argtypes nargs bound null null) 0)
                (let (ok:i32 1)
                  (dotimes (ci (m2 'num-constraints))
                    (let (crec:ref:Constraint (constraints-at (m2 'constraints) ci)
                          uidx:i32 (tyvar-index-of (crec 'var)
                                                   (m2 'tyvars) (m2 'num-tyvars))
                          proto:Symbol (constraint-proto crec)
                          bt:ptr (aref (unsafe/cast &ptr bound) uidx))
                      (if (!= (is-tyvar-type bt) 0)
                        ; `Any` holds of every type, so the caller need not repeat it.
                        (when (and (= (caller-has-constraint m (tyvar-type-name bt) proto) 0)
                                   (!= proto "Any"))
                          (set! ok 0))
                        (when (= (conformance-lookup (type-spelling bt) proto) 0)
                          (set! ok 0)))))
                  (when (!= ok 0)
                    ; result = m2's return spelling, its tyvars substituted by `bound`
                    (let (rnode:ptr (defn-ret-node (m2 'body)))
                      (when (= rnode null) (return ty-void))
                      (when (= (-> rnode (unsafe/cast &Node _) (_ 'kind)) NODE-SYM)
                        (let (ridx:i32 (tyvar-index-of (-> rnode (unsafe/cast &Node _) (_ 's))
                                                       (m2 'tyvars) (m2 'num-tyvars)))
                          (when (>= ridx 0) (return (aref (unsafe/cast &ptr bound) ridx)))))
                      ; A parametric return type — e.g. (Maybe T) — is a NODE-LIST
                      ; that still mentions the method's tyvars. Substitute each
                      ; tyvar with its bound concrete spelling before parsing, so
                      ; `(Maybe T)` with T:=ptr parses as `(Maybe ptr)` rather than
                      ; failing with "unknown type: T".
                      (let (ntv:i32 (m2 'num-tyvars)
                            spellings:ptr (arena-alloc
                                            (* (+ ntv 1) (ptr-bytes))))
                        ; An abstract binding has no spelling: the result is an
                        ; unowned placeholder, "some type" (`generic-sig-satisfied`).
                        (dotimes (ai ntv)
                          (when (!= (is-tyvar-type (aref (unsafe/cast &ptr bound) ai)) 0)
                            (return (dry-parse-type))))
                        (dotimes (si ntv)
                          (set! (aref (unsafe/cast &Symbol spellings) si) (type-spelling (aref (unsafe/cast &ptr bound) si))))
                        (return (parse-type-from-node
                                  (subst-tyvars-node rnode (m2 'tyvars) spellings ntv)
                                  line))))))))))))
    (return null)))

; Is this head one of the core special forms (mirrors emit-list's dispatch)?
; Such forms are handled structurally by gcheck, never as function calls.
; hp is the head Node* itself (not its string spelling) — every symbol Node
; is `intern-symbol`-canonicalized (lib/nucleus/node.nuc), so comparing the whole
; Node* by `=` against a quoted-symbol literal ('let, 'with, ...) is a valid,
; fast identity test, matching emit-list's dispatch in nucleusc.nuc. Node is
; not a string kind, so this `=` is a plain `icmp eq ptr` regardless of hp's
; declared pointer kind — (ptr Node) here costs nothing (unlike the CStr/
; Node.s identity trap for genuine *string* params elsewhere in this file).
(defn gcheck-special-form (hp:&Node):bool
  (if-some (head (as-ref hp))
           (contains? #{'let 'with 'do 'cond 'return 'while 'set! 'inc! 'quote 'quasiquote
                        'ast-first 'ast-rest 'ast-at 'ast-len
                        'not '_and '_or 'cast 'ref 'deref 'ptr+ '_get
                        'sizeof 'source-file 'source-line 'alloca 'char 'aref 'gensym 'macro-error
                        'struct-fields 'type-name
                        'funcall 'funcall-void
                        'funcall-ptr-1 'funcall-ptr-i32 'funcall-ptr-i64 'funcall-ptr-ptr
                        'as 'unsafe/cast 'unsafe/ptr+ 'unsafe/funcall-ptr-1 
                        'unsafe/funcall-ptr-i32 'unsafe/funcall-ptr-i64
                        'unsafe/funcall-ptr-ptr 'some 'as-ref 'unwrap
                        'unwrap-or 'if-some 'when-some 'move 'defer 'err-name 'err-message
                        'match 'make 'err! 'try 'type-token 'signal}
                       head)
           false))

; Declared type of a let/with binding name in a generic body. Handles both the
; un-desugared colon symbol ("r:T") and the desugared (name type) cell. Returns
; null for an untyped binding (caller infers from the value).
; An annotation over a type variable inside a compound (`?T`, `(Vector T)`) has
; no abstract model: it is spelled-checked dry and left to the stamp's check.
(defn gbind-nested-tyvar? (tn:?&Node m:&Method line:i32):bool
  (when (= (node-mentions-tyvar tn (m 'tyvars) (m 'num-tyvars)) 0) (return false))
  (let (saved:DryParse (dry-parse-enter (m 'tyvars) (m 'num-tyvars)))
    (parse-type-from-node (as ptr tn) line)
    (dry-parse-leave saved))
  (return true))

(defn gbind-decl-type (bind-node:?&Node m:&Method line:i32):ptr
  (let (n:ptr:Node bind-node)
    (case (n 'kind)
      NODE-SYM
        (let (tail:Symbol (colon-tail (n 's)))
          (when (symbol-none? tail) (return null))
          (let (idx:i32 (tyvar-index-of tail (m 'tyvars) (m 'num-tyvars)))
            (when (>= idx 0) (return (make-tyvar-type m idx)))
            (when (gbind-nested-tyvar? (as &Node (intern-node tail)) m line) (return null))
            (return (parse-type-spelling-str tail line))))
      NODE-LIST
        (let (tnode:ptr (node-at bind-node 1))
          (when (= tnode null) (return null))
          (when (= (-> tnode (unsafe/cast &Node _) (_ 'kind)) NODE-SYM)
            (let (idx:i32 (tyvar-index-of (-> tnode (unsafe/cast &Node _) (_ 's))
                                          (m 'tyvars) (m 'num-tyvars)))
              (when (>= idx 0) (return (make-tyvar-type m idx)))))
          (when (gbind-nested-tyvar? (as ?&Node tnode) m line) (return null))
          (return (parse-type-from-node tnode line)))
      0)
    (return null)))

(defn gbind-name (bind-node:?&Node):Symbol
  (let (n:ptr:Node bind-node)
    (case (n 'kind)
      NODE-SYM
        (let (nm:Symbol (symbol-none) tail:Symbol (symbol-none))
          (split-typed (n 's) (as &Symbol &nm) (as &Symbol &tail))
          (return nm))
      NODE-LIST (return (node-head-sym n))
      0)
    (return (symbol-none))))

; Type-check one node of a generic body in `scope`, against template `m`.
; Returns the node's (possibly abstract) type, or null when not modeled. Aborts
; with a def-time diagnostic on an operation the constraints do not provide.
(defn gcheck (n:?&Node scope:ref:Scope m:&Method):ptr
  (when (= n null) (return ty-void))
  (let (nn:?&Node n)
    (case (nn 'kind)
      NODE-INT   (return ty-i32)
      NODE-FLOAT (return ty-f64)
      ; Stage 14 NS-3: string literals are StrView (was CStr). Lockstep with
      ; emit-string / node-type / valid-walk (conventions.md node-type↔emit-node).
      NODE-STR
        ; NS-4: an explicit c"…" literal (reader set Node.i=1) types as CStr, not
        ; the StrView default — lockstep with emit-string's NS-4 short-circuit.
        (if (!= (nn 'i) 0) (return ty-cstr) (return (strview-type)))
      NODE-CHAR  (return ty-char)
      NODE-SYM   (return (node-type-sym n scope))
      0)
    (when (!= (nn 'kind) NODE-LIST) (return ty-void))
    (when (= (node-len n) 0) (return null))
    (let (head:&Node (unsafe/cast &Node (node-at n 0)))
      (when (!= (head 'kind) NODE-SYM)
        ; non-symbol head: just walk compound children for nested calls.
        (gcheck-walk-children n scope m)
        (return null))
      (let (h:Symbol (head 's)
            hp:&Node head)
        ; TC-4: a cell whose head names a REGISTERED STRUCT TEMPLATE is a TYPE
        ; operand (e.g. (Box T), (Vector i32)), never a function call — struct
        ; template names and function/generic names do not collide in this
        ; codebase. Without this, gcheck would walk e.g. (Box T) as an
        ; unknown-function call (Box is a struct template, not a generic) and
        ; abort the A2 check with "in generic body: unknown function 'Box'" —
        ; blocking the TC-4 constructor body shape. Defer (null): the precise
        ; stamped type is produced at monomorphization; for the A2 walk the
        ; type is check-only (conventions.md: TY-TYVAR is check-only). This
        ; recognizes the type-application head only; a compound literal whose
        ; head is the CELL ((Vector i32) v0 ...) has a non-SYM head and never
        ; reaches here (node-template-of checks head kind == NODE-SYM).
        (when (!= (as ptr (node-template-of n)) null) (return null))
        (when (!= (as ptr (node-union-template-of n)) null) (return null))
        ; TC-4: a type-wrapper keyword head (ref/ptr, or the retired raw) is likewise a type
        ; spelling — e.g. (ref (Vector T)), (ptr Node) — never a call. Without
        ; this the heap `-in` constructor body `(cast (ref (Vector T)) …)` dies
        ; "in generic body: unknown function 'ref'". Defer (null): a check-only
        ; type pass need not model the wrapper; stamping happens at monomorphize.
        (when (or (= hp 'ref) (= hp 'raw) (= hp 'ptr)) (return null))
        ; Expand macros (if/when/-> …) so the body is core forms.
        (when (!= (find-macro h) null)
          (let (ex:ptr (macroexpand-form n 1))
            (when (!= ex n) (return (gcheck ex scope m)))))
        (when (or (= hp 'quote) (= hp 'quasiquote)) (return ty-ptr))
        (when (or (= hp 'ast-first) (= hp 'ast-rest) (= hp 'ast-at)) (return (ty-ptr-node)))
        (when (= hp 'ast-len) (return ty-i32))
        ; let / with: bind names (possibly abstract), then check the body.
        (when (or (= hp 'let) (= hp 'with))
          (let (binds:ptr (node-at n 1)
                inner:ref:Scope (scope-new scope)
                bl:i32 (node-len binds)
                i:i32 0)
            (while (< i bl)
              (let (bname:ptr (node-at binds i)
                    bval:ptr (node-at binds (+ i 1))
                    vty:ptr (gcheck bval inner m)
                    dty:ptr (gbind-decl-type bname m (nn 'line))
                    nm:Symbol (gbind-name bname))
                (when (= dty null) (set! dty vty))
                (when (and (not (symbol-none? nm)) (!= dty null))
                  (scope-define inner nm dty (symbol-as-view nm) 1)))
              (set! i (+ i 2)))
            (let (last:ptr null j:i32 2 cl:i32 (node-len n))
              (while (< j cl) (set! last (gcheck (node-at n j) inner m)) (inc! j))
              (return last))))
        ; Closure forms (vfn/fn/mfn/cfn): `(vfn (params) ret body…)`. Bind each
        ; param in an inner scope (so the param list is NOT walked as calls — the
        ; bug that blocked flat-tyvar closure-returning generics like `constantly`)
        ; and check the body forms. The ret annotation (index 2) and param types
        ; are not calls; the captured-value operations are deferred to stamp time
        ; (the concrete monomorphized closure body goes through the ordinary
        ; emit/type pass). Boot-inert: no compiler generic creates a closure.
        (when (or (= h "vfn") (= h "fn") (= h "mfn") (= h "cfn"))
          (let (cparams:ptr (node-at n 1)
                cinner:ref:Scope (scope-new scope)
                cnp:i32 (node-len cparams))
            (dotimes (cpi cnp)
              (let (cpnode:ptr (node-at cparams cpi)
                    cpty:ptr (gbind-decl-type cpnode m (nn 'line))
                    cpnm:Symbol (gbind-name cpnode))
                (when (and (not (symbol-none? cpnm)) (!= cpty null))
                  (scope-define cinner cpnm cpty (symbol-as-view cpnm) 1))))
            (let (clast:ptr null cj:i32 3 ccl:i32 (node-len n))
              (while (< cj ccl) (set! clast (gcheck (node-at n cj) cinner m)) (inc! cj))
              (return clast))))
        (when (= hp 'do)
          (let (last:ptr null j:i32 1 cl:i32 (node-len n))
            (while (< j cl) (set! last (gcheck (node-at n j) scope m)) (inc! j))
            (return last)))
        ; Stage 16 `macrolet`: defer (null). Its bindings are compiled at
        ; emission, so during the A2 walk the body's local macro calls cannot be
        ; expanded and would read as unknown functions. Checked at
        ; monomorphization instead, which is where they do expand.
        (when (= hp 'macrolet) (return null))
        ; cond / _and / _or / not / set! / inc! / return / while and the structural
        ; special forms: walk compound children; result type is not modeled.
        (when (gcheck-special-form hp)
          (gcheck-walk-children n scope m)
          (return null))
        ; A struct constructor, found as `emit-dispatch` finds it; a designated
        ; `(field v)` is not a call, so only its value is checked.
        (when-some (hit (binding-find h scope BK-DISPATCH-FIRST BINDING-KIND-COUNT 0 NK-NONE))
          (when (= (hit 'kind) BK-STRUCT)
            (let (sd:&StructDef (unsafe/cast &StructDef (hit 'payload))
                  pt:&Type (as &Type (make-type TY-PTR))
                  st:&Type (as &Type (make-type TY-STRUCT)))
              (dotimes (i (- (node-len n) 1))
                (let (arg:?&Node (node-at n (+ i 1)))
                  (if (!= (struct-lit-designated sd arg scope) 0)
                    (gcheck (node-at (as ptr arg) 1) scope m)
                    (gcheck arg scope m))))
              (set! (st 'sdef) sd)
              (set! (pt 'elem) (as ptr st))
              (set! (pt 'pkind) PTR-REF)
              (return (as ptr pt)))))
        ; A genuine call: type the arguments (catching nested abstract calls),
        ; then resolve the head. Lenient model: resolve protocol-method and
        ; generic calls precisely (good types for nested checking); for anything
        ; else, only a genuinely unknown name is an error — a known operation
        ; (operator, foreign/concrete function) on an abstract value is deferred
        ; to stamp-time (A1), since it may well be valid for the concrete type.
        (let (nargs:i32 (- (node-len n) 1)
              argtypes:ptr (arena-alloc (* (+ nargs 1) (ptr-bytes)))
              any-abstract:i32 0)
          (dotimes (i nargs)
            (let (at:ptr (gcheck (node-at n (+ i 1)) scope m))
              (set! (aref (unsafe/cast &ptr argtypes) i) at)
              (when (!= (is-tyvar-type at) 0) (set! any-abstract 1))))
          ; Protocol-method resolution (Self → tyvar) takes priority — a required
          ; method need not have a concrete impl in this unit to be a valid call.
          (when (!= any-abstract 0)
            (let (rt:ptr (abstract-call-via-protocol h argtypes nargs m (nn 'line)))
              (when (!= rt null) (return rt))
              (set! rt (abstract-call-via-generic h argtypes nargs m (nn 'line)))
              (when (!= rt null) (return rt))))
          (let (g:ptr (generic-lookup h))
            ; Intrinsic operator: best-effort type (bool for comparisons, else the
            ; first operand's type — possibly the abstract tyvar). Deferred, no error.
            (when (!= g null)
              (let (m0:&Method (as &Method (invoke (-> g (unsafe/cast &Generic _) (_ 'methods)) 0)))
                (when (= (m0 'kind) METHOD-INTRINSIC)
                  (when (!= ((m0 'binop) 'is-cmp) 0) (return ty-bool))
                  (return (gcheck (node-at n 1) scope m)))))
            ; A name that is neither a generic nor scope-bound is a typo — error
            ; whether or not an argument is abstract. A retired reserved head
            ; (`addr-of`, `.&`) keeps its exact answer here as on the emit path.
            (when (and (= g null) (= (scope-lookup scope h) null))
              (match (retired-form-message h) (none 0) ((some retired) (die-at (nn 'line) retired)))
              (die-at (nn 'line) (fstr "in generic body: unknown function '" h "'")))
            ; Known name, unresolved here: defer to stamp-time. Concrete calls get
            ; a best-effort type; abstract ones stay unknown (null).
            (when (!= any-abstract 0) (return null))
            (return (node-type-call n scope h null))))))))

; Walk only the compound (list) children of a node, checking nested calls but
; ignoring bare symbols (which may be type names, field names, or places).
(defn gcheck-walk-children (n:?&Node scope:ref:Scope m:&Method):void
  (let (cl:i32 (node-len n) i:i32 1)
    (while (< i cl)
      (let (c:?&Node (node-at n i))
        (when (and (!= c null) (= (c 'kind) NODE-LIST))
          (gcheck c scope m)))
      (inc! i))))

; Run the A2 check on one generic template: bind its parameters to their abstract
; (or concrete) types, then check each body form.
(defn check-generic-template (m:&Method):void
  (let (mm:ptr:Method m
        form:ptr:Node (mm 'body)
        params-node:ptr (node-at form 2)
        scope:ref:Scope (scope-new g-globals)
        nparams:i32 (mm 'num-params))
    (dotimes (i nparams)
      (let (pnode:ptr (node-at params-node i)
            pty:ptr (gbind-decl-type pnode m (form 'line))
            pnm:Symbol (gbind-name pnode))
        (when (and (not (symbol-none? pnm)) (!= pty null))
          (scope-define scope pnm pty (symbol-as-view pnm) 1))))
    ; S1/S3: the body starts after the return operand — index 4 for a new-style
    ; template (bare name, ret at 3), index 3 for a legacy one. Walking from 3
    ; unconditionally would gcheck a new-style CELL return (e.g. `(BoxedFn (V) V)`)
    ; as a body form, mis-reading its `(V …)` as a call to an unknown function.
    (let (cl:i32 (node-len form)
          j:i32 (if (!= (sig-name-is-bare (node-at form 1)) 0) 4 3))
      (while (< j cl)
        (gcheck (node-at form j) scope m)
        (inc! j)))))

; Does any parameter of this generic template bind a tyvar in a *nested* position
; — inside a ptr/ref wrapper or a parametric-struct application (a receiver-
; inferred method, parametric-structs.md §4)? The abstract A2 interface check
; (gbind-decl-type) only models flat tyvar parameters; a nested receiver type
; cannot be parsed against an abstract element, so such a template defers all body
; type-checking to stamp time (the concrete monomorphized body goes through the
; ordinary emit/type pass). A plain flat-tyvar `:where` template returns 0 here
; and is A2-checked exactly as before (byte-identical).
(defn method-has-nested-tyvar (m:&Method):i32
  (let (mm:&Method m
        params-node:ptr (node-at (mm 'body) 2)
        np:i32 (mm 'num-params))
    (dotimes (i np)
      (let (ptn:?&Node (binding-type-node (node-at params-node i)))
        ; PK-4b: a sigil symbol `?T` is the wrapper `(Maybe T)`, and `ref:T`
        ; the wrapper `(ref T)` — nested too.
        (when (and (!= ptn null)
                   (or (= (ptn 'kind) NODE-LIST)
                       (and (= (ptn 'kind) NODE-SYM)
                            (or (> (type-sigil-run (ptn 's)) 0) (symbol-contains-byte (ptn 's) 58))))
                   (!= (node-mentions-tyvar ptn (mm 'tyvars) (mm 'num-tyvars)) 0))
          (return 1))))
    (return 0)))

; Check every not-yet-checked bounded-generic template. Runs after the top-level
; loop (so includes/imports/protocols/conformances are all registered) and before
; the worklist drain (so a body error surfaces at the defn, before any A1
; stamp-time error from instantiation).
(defn check-generic-templates ():void
  (dotimes (gi (unsafe/cast i32 (count g-generics)))
    (let (gg:&Generic (as &Generic (invoke g-generics gi:usize)))
      (dotimes (mi (unsafe/cast i32 (count (gg 'methods))))
        (let (m:&Method (as &Method (invoke (gg 'methods) mi:usize)))
          (when (and (= (m 'kind) METHOD-GENERIC) (= (m 'checked) 0))
            (set! (m 'checked) 1)
            ; Receiver-inferred methods (nested tyvar receivers) defer body
            ; checking to stamp time; the abstract interface check only models
            ; flat tyvar parameters.
            (when (= (method-has-nested-tyvar m) 0)
              (let (here:NameEnv (method-env-enter m))
                (check-generic-template m)
                (name-env-set here)))))))))

; ============================================================
; Valid: inferred structural bounds (Stage 9 §10.2)
; ============================================================
; `:where (Valid T)` bounds T structurally: instead of naming a protocol, the
; required interface is whatever the body does to T-typed values. Per the
; designer (open Q3), this is realized as a per-call-site non-emitting stamp —
; at each instantiation (T := C known) the body is substituted and the rung-3
; type pass is run over it WITHOUT emitting, so any operation the concrete type C
; cannot support is reported at the call site (ahead of, and clearer than, the
; A1 stamp-time emit error), and derived-value chains are handled by the same
; concrete walk (no associated-type solver).

; Does this template carry a Valid constraint?
(defn method-has-valid (m:?&Method):i32
  (let (mm:ptr:Method m)
    (dotimes (i (mm 'num-constraints))
      (let (crec:ref:Constraint (constraints-at (mm 'constraints) i))
        (when (= (crec 'proto) "Valid") (return 1)))))
  (return 0))

; The concrete declared type of a binding in a stamped (substituted) body, or
; null when untyped (the caller infers it from the value).
(defn valid-decl-type (bind-node:?&Node line:i32):ptr
  (let (n:ptr:Node bind-node)
    (case (n 'kind)
      NODE-SYM
        (let (nm:Symbol (symbol-none) tail:Symbol (symbol-none))
          (split-typed (n 's) (as &Symbol &nm) (as &Symbol &tail))
          (when (symbol-none? tail) (return null))
          (return (parse-type-spelling-str tail line)))
      NODE-LIST
        (let (tnode:ptr (node-at bind-node 1))
          (when (= tnode null) (return null))
          (return (parse-type-from-node tnode line)))
      0)
    (return null)))

; The result type of a generic template `m2` for a concrete binding, or null:
; a bare-tyvar return is the bound type; anything else is parsed concretely.
(defn template-result-type (m2:?&Method bound:ptr line:i32):ptr
  (let (mm:ptr:Method m2
        rnode:ptr (defn-ret-node (mm 'body)))
    (when (= rnode null) (return ty-void))
    (when (= (-> rnode (unsafe/cast &Node _) (_ 'kind)) NODE-SYM)
      (let (ridx:i32 (tyvar-index-of (-> rnode (unsafe/cast &Node _) (_ 's))
                                     (mm 'tyvars) (mm 'num-tyvars)))
        (when (>= ridx 0) (return (aref (unsafe/cast &ptr bound) ridx)))))
    (return (parse-type-from-node rnode line))))

; Non-dying resolution of a concrete call against generic `g`: returns the call's
; result type if it resolves (exact method, built-in operator, user-operator or
; user-method widen, or a bounded-generic template), else null. The Valid walk
; turns a null here into a localized call-site error.
(defn valid-resolve-type (g:?&Generic argtypes:ptr arg-nodes:ptr nargs:i32 line:i32
                          scope:&Scope):ptr
  (let (gg:ptr:Generic g)
    (let (m:ptr (generic-find-method-exact g argtypes nargs))
      (when (!= m null) (return (-> m (unsafe/cast &Method _) (_ 'ret-type)))))
    (when (and (> (count (gg 'methods)) 0)
               (= (-> (as &Method (invoke (gg 'methods) 0)) (_ 'kind)) METHOD-INTRINSIC))
      (let (vt:ptr null
            um:?&Method (operator-resolve g argtypes arg-nodes nargs scope &vt))
        (when (!= vt null)
          (if (!= um null) (return (um 'ret-type)) (return null)))))
    (let (rt:ptr (builtin-op-result-type g argtypes nargs))
      (when (!= rt null) (return rt)))
    (let (m:ptr (operator-user-resolve g argtypes arg-nodes nargs))
      (when (!= m null) (return (-> m (unsafe/cast &Method _) (_ 'ret-type)))))
    ; widen on a concrete user method
    (let (wcand:ptr null wn:i32 0)
      (dotimes (i (unsafe/cast i32 (count (gg 'methods))))
        (let (m:&Method (as &Method (invoke (gg 'methods) i:usize)))
          (when (and (= (m 'kind) METHOD-USER)
                     (and (= (m 'has-rest) 0) (= (m 'num-params) nargs)))
            (let (ok:i32 1)
              (dotimes (a nargs)
                (let (is-lit:i32 0
                      is-flit:i32 0)
                  (when (!= arg-nodes null)
                    (set! is-lit (node-is-int-literal (aref (unsafe/cast &ptr arg-nodes) a)))
                    ; W2d: mutually exclusive, and node-is-float-literal
                    ; macroexpands a cell operand — skip the second walk when the
                    ; first already answered.
                    (when (= is-lit 0)
                      (set! is-flit (node-is-float-literal (aref (unsafe/cast &ptr arg-nodes) a)))))
                  (when (= (arg-adapts (aref (unsafe/cast &ptr argtypes) a)
                                       (aref (unsafe/cast &ptr (m 'param-types)) a) is-lit is-flit) 0)
                    (set! ok 0))))
              (when (!= ok 0) (set! wcand (as ptr m)) (inc! wn))))))
      (when (= wn 1) (return (-> wcand (unsafe/cast &Method _) (_ 'ret-type)))))
    ; bounded-generic template
    (dotimes (j (unsafe/cast i32 (count (gg 'methods))))
      (let (m:&Method (as &Method (invoke (gg 'methods) j:usize)))
        (when (= (m 'kind) METHOD-GENERIC)
          (let (bound:ptr (arena-alloc (* (+ (m 'num-tyvars) 1) (ptr-bytes))))
            (when (and (!= (generic-method-bind (as ptr m) argtypes nargs bound null arg-nodes) 0)
                       (!= (generic-constraints-ok (as ptr m) bound line) 0))
              (return (template-result-type (as ptr m) bound line)))))))
    (return null)))

(defn valid-walk-children (n:?&Node scope:ref:Scope gname:Symbol cty:Symbol line:i32):void
  (let (cl:i32 (node-len n) i:i32 1)
    (while (< i cl)
      (let (c:?&Node (node-at n i))
        (when (and (!= c null) (= (c 'kind) NODE-LIST))
          (valid-walk c scope gname cty line)))
      (inc! i))))

; Walk one node of a stamped (concrete) Valid body, returning its type and
; aborting at any direct generic/operator call the concrete type can't satisfy.
; gname is the generic being instantiated and cty its concrete spelling, used
; only in the diagnostic. line is the requesting call site.
(defn valid-walk (n:?&Node scope:ref:Scope gname:Symbol cty:Symbol line:i32):ptr
  (when (= n null) (return ty-void))
  (let (nn:?&Node n)
    (case (nn 'kind)
      NODE-INT   (return ty-i32)
      NODE-FLOAT (return ty-f64)
      ; Stage 14 NS-3: string literals are StrView (was CStr). Lockstep with
      ; emit-string / node-type / gcheck (conventions.md node-type↔emit-node).
      NODE-STR
        ; NS-4: an explicit c"…" literal (reader set Node.i=1) types as CStr, not
        ; the StrView default — lockstep with emit-string's NS-4 short-circuit.
        (if (!= (nn 'i) 0) (return ty-cstr) (return (strview-type)))
      NODE-CHAR  (return ty-char)
      NODE-SYM   (return (node-type-sym n scope))
      0)
    (when (!= (nn 'kind) NODE-LIST) (return ty-void))
    (when (= (node-len n) 0) (return null))
    (let (head:&Node (unsafe/cast &Node (node-at n 0)))
      (when (!= (head 'kind) NODE-SYM)
        (valid-walk-children n scope gname cty line)
        (return null))
      (let (h:Symbol (head 's)
            hp:&Node head)
        (when (!= (find-macro h) null)
          (let (ex:ptr (macroexpand-form n 1))
            (when (!= ex n) (return (valid-walk ex scope gname cty line)))))
        (when (or (= hp 'quote) (= hp 'quasiquote)) (return ty-ptr))
        (when (or (= hp 'ast-first) (= hp 'ast-rest) (= hp 'ast-at)) (return (ty-ptr-node)))
        (when (= hp 'ast-len) (return ty-i32))
        (when (or (= hp 'let) (= hp 'with))
          (let (binds:ptr (node-at n 1)
                inner:ref:Scope (scope-new scope)
                bl:i32 (node-len binds)
                i:i32 0)
            (while (< i bl)
              (let (bname:ptr (node-at binds i)
                    bval:ptr (node-at binds (+ i 1))
                    vty:ptr (valid-walk bval inner gname cty line)
                    dty:ptr (valid-decl-type bname (nn 'line))
                    nm:Symbol (gbind-name bname))
                (when (= dty null) (set! dty vty))
                (when (and (not (symbol-none? nm)) (!= dty null))
                  (scope-define inner nm dty (symbol-as-view nm) 1)))
              (set! i (+ i 2)))
            (let (last:ptr null j:i32 2 cl:i32 (node-len n))
              (while (< j cl) (set! last (valid-walk (node-at n j) inner gname cty line)) (inc! j))
              (return last))))
        (when (= hp 'do)
          (let (last:ptr null j:i32 1 cl:i32 (node-len n))
            (while (< j cl) (set! last (valid-walk (node-at n j) scope gname cty line)) (inc! j))
            (return last)))
        ; Stage 16 `macrolet`: defer, for the same reason gcheck does — the
        ; bindings do not exist yet, so the body's local calls are unresolvable.
        (when (= hp 'macrolet) (return null))
        (when (gcheck-special-form hp)
          (valid-walk-children n scope gname cty line)
          (return (node-type n scope)))
        ; A genuine call: type the arguments, then require it to resolve.
        (let (nargs:i32 (- (node-len n) 1)
              argtypes:ptr (arena-alloc (* (+ nargs 1) (ptr-bytes)))
              arg-nodes:ptr (arena-alloc (* (+ nargs 1) (ptr-bytes)))
              all-known:i32 1)
          (dotimes (i nargs)
            (let (anode:ptr (node-at n (+ i 1))
                  at:ptr (valid-walk anode scope gname cty line))
              (set! (aref (unsafe/cast &ptr argtypes) i) at)
              (set! (aref (unsafe/cast &ptr arg-nodes) i) anode)
              (when (= at null) (set! all-known 0))))
          (let (g:ptr (generic-lookup h))
            (when (!= g null)
              ; Only verify when every argument type is known; an unknown
              ; (e.g. a macro/cond result) defers, matching node-type's frontier.
              (when (!= all-known 0)
                (let (rt:ptr (valid-resolve-type g argtypes arg-nodes nargs line scope))
                  (when (!= rt null) (return rt))
                  (die-at line
                    (fstr "type '" (key-display cty line) "' does not satisfy the Valid bound of '" gname "'"))))
              (return null))
            ; A non-generic name: it must at least be in scope (catches a typo);
            ; its own arg typing is deferred to that function's own emission.
            (when (= (scope-lookup scope h) null)
              (die-at line
                (fstr "type '" (key-display cty line) "' does not satisfy the Valid bound of '" gname "'")))
            (return (node-type-call n scope h null))))))))

; Run the per-call-site Valid check on a stamped instantiation `stamped` whose
; type variables were bound to the concrete types in `bound`. Builds a scope from
; the (now concrete) parameters and walks the body.
(defn valid-check-instance (m:?&Method stamped:?&Node bound:ptr line:i32):void
  (let (mm:ptr:Method m
        params-node:ptr (node-at stamped 2)
        scope:ref:Scope (scope-new g-globals)
        gname:Symbol (defn-name-only (node-at stamped 1))
        cty:Symbol (symbol-intern "?")
        nparams:i32 (mm 'num-params))
    (when (> (mm 'num-tyvars) 0)
      (set! cty (type-spelling (aref (unsafe/cast &ptr bound) 0))))
    (dotimes (i nparams)
      (let (pnode:ptr (node-at params-node i)
            pty:ptr (valid-decl-type pnode line)
            pnm:Symbol (gbind-name pnode))
        (when (and (not (symbol-none? pnm)) (!= pty null))
          (scope-define scope pnm pty (symbol-as-view pnm) 1))))
    ; S1/S3: skip the return operand — index 4 for a new-style stamped form,
    ; index 3 for a legacy one (see check-generic-template).
    (let (cl:i32 (node-len stamped)
          j:i32 (if (!= (sig-name-is-bare (node-at stamped 1)) 0) 4 3))
      (while (< j cl)
        (valid-walk (node-at stamped j) scope gname cty line)
        (inc! j)))))

; Emit the bodies of every stamped generic instantiation queued so far. Runs at
; the end of the top-level loop, when no function emission is in progress. The
; persistent cursor makes recursive drains (during imports) never re-emit, and
; stamping inside a drained body simply extends the worklist this loop consumes.
(defn drain-mono-worklist ():void
; Stage 15 B3′: a monomorphized body is a SYNTHESIS region — every type spelling parsed inside it
; was written by the compiler (a `type-spelling` of a bound tyvar, a `Self`
; substitution), not by any file, so the type reference resolvers take an exact-key
; fallback here. See `g-type-key-ok` (src/nucleusc.nuc) for why this is a scoped
; permission rather than a global relaxation.
  (let (saved:i32 g-type-key-ok)
    (set! g-type-key-ok 1)
    (drain-mono-worklist-in)
    (set! g-type-key-ok saved)))

(defn drain-mono-worklist-in ():void
  (while (< g-mono-drained (count g-mono-worklist))
    (let (job:&MonoJob (as &MonoJob (invoke g-mono-worklist g-mono-drained)))
      (inc! g-mono-drained)
      ; Not `g-def-stream`: an `import-ct` in progress has that pointing at a
      ; sink, and a stamp belongs to no file — the program may be what calls it.
      (set! g-out g-def-stream-program)
      ; Attach the instantiation context to any error raised while emitting.
      (set! g-mono-context (job 'context))
      ; Stage 15 W9 item 2: a stamp belongs to no file. It is derived from the
      ; template and the concrete argument tuple, so any unit that instantiates
      ; it produces the same body under the same symbol — including two library
      ; objects that each use `(Vector u8)`. `def-linkage` reads this to emit
      ; `weak_odr`; the call site's `g-source-path` would answer the wrong
      ; question, exactly as it did for the stamp's namespace (see
      ; `generic-instantiate-in`'s `src-ns` correction).
      ; Stage 15 W9 item 43: and emit it AS the file whose text it is — the same
      ; three globals `drain-dyn-annots` restores per job, for the same reason
      ; (the drain runs long after the form was queued, and `resolve-spelling`
      ; reads exactly these). `g-source-path` is restored too, so an error in a
      ; template body names the library's file to go with the library's line;
      ; `job context` still says which call site asked for the instantiation.
      (let (saved-copy:i32 g-emitting-copy
            save-ns:Symbol g-current-ns
            save-path:Symbol g-source-path
            save-imports:?&ImportVec g-file-imports)
        (set! g-emitting-copy 1)
        (when (not (symbol-none? (job 'ns))) (set! g-current-ns (job 'ns)))
        (when (not (symbol-none? (job 'path))) (set! g-source-path (job 'path)))
        (set! g-file-imports (job 'imports))
        (emit-defn (job 'form))
        (set! g-file-imports save-imports)
        (set! g-source-path save-path)
        (set! g-current-ns save-ns)
        (set! g-emitting-copy saved-copy))
      (set! g-mono-context ""))))


; ############################################################
; Protocols & conformances (Stage 9 rung 2) — appended in N8.
; Lives here (not its own file) because of a generics<->protocols
; mutual cycle: generics.nuc calls protocol-lookup/conformance-lookup/
; blanket-conforms/emit-extend/method-satisfies-sig/builtin-op-result-type/
; constraint-proto-known/conformance-args, while these protocol fns call
; generic-lookup/generic-find-method-exact/generic-bind/generic-method-bind/
; generic-binds-for/generic-defn. Co-locating breaks the cross-file edge:
; one import-use registers both halves before either body emits.
; ############################################################
; ============================================================
; Protocols & conformances (Stage 9 rung 2)
; ============================================================
; defprotocol/extend are entirely compile-time and emit no code. A protocol is
; a named set of required signatures (types may mention Self); `extend Type P`
; verifies, after the whole-file prescan, that each required signature resolves
; to a concrete method with Self→Type substituted, and records the conformance.

; ------------------------------------------------------------
; Stage 15 W9 defect 21 — a PROTOCOL IS A NAMESPACED ENTITY
; (design/stage12/namespaces.md, decision 9 superseded 2026-08-03)
; ------------------------------------------------------------
; Stage 12 decision 9 said a qualified *type* reference must resolve to the same
; StructDef from any namespace, and the protocol registry was made bare-keyed
; along with the type registry. That was wrong for protocols: it made every
; protocol name effectively global, so two namespaces could not each declare a
; `Describe`, and — because `conformance-*` stripped while `protocol-lookup` did
; not — `(extend Cat dp/Describe)` recorded the conformance under bare
; `Describe` while `(dyn dp/Describe)` looked the protocol up qualified and
; reported "'dp/Describe' is not a declared protocol" for a protocol that was
; both declared and conformed to.
;
; A protocol is now keyed by its namespace-qualified identity, exactly like a
; global in `g-globals`: `qualify-name` produces the key at registration, and a
; reference resolves through the same function.
;
; Stage 15 B3′ made the TYPE half namespaced too (R1), so the two halves are no
; longer canonicalized by *different rules* — only by different functions, since
; each has to consult its own registry. `type-canon-name` (below) is the type
; half's canonicalizer and `protocol-canon-name` the protocol half's;
; `strip-ns-qualifier` no longer participates in either.
;
; `protocol-key` is the storage key of a reference *as written here*: identity
; under `user` for an unqualified spelling (the byte-identical hatch — no
; allocation, no intern), else `qualify-name`.
(defn protocol-key (name:Symbol):Symbol
  (when (and (not (symbol-contains-byte name 47)) (= g-current-ns "user"))
    (return name))
  (return (qualify-name name)))

; Exact registry probe: `key` must already be canonical. Registration uses this
; (never `protocol-lookup`), for the same reason `generic-register-method` uses
; `generic-lookup-exact` — a define's key is already final, and routing it
; through the fallback-bearing resolver would fold a namespace's own `Describe`
; into an unrelated `user` one it merely shadows.
(defn protocol-lookup-exact (key:Symbol):?&Protocol
  (dotimes (i (unsafe/cast i32 (count g-protocols)))
    (let (p:&Protocol (as &Protocol (invoke g-protocols i:usize)))
      (when (= (p 'name) key) (return (as ptr p)))))
  (return null))

; Resolve a protocol KEY by namespace alone — the pre-B2a `protocol-lookup`.
; Two probes, qualified first:
;   1. the current namespace's own protocol (`Describe` inside `(ns dp)` →
;      `dp/Describe`; `dp/Describe` from anywhere → itself, since qualify-name
;      is idempotent on an already-qualified spelling);
;   2. failing that, the bare spelling — so a namespaced file still sees the
;      `user`-namespace protocols it imports (`Clone`, `Eq`, `Ord`, `Allocator`),
;      which is what makes a namespaced library usable at all.
; Under `user` the two probes are the same key, so this is one scan plus one
; strcmp — and identical in behaviour to the pre-W9 bare-keyed lookup.
;
; Stage 15 B2a: this is now the lookup for an ALREADY CANONICAL key — a stored
; `Constraint.proto`, a super-protocol edge, a `.nuch` replay's protocol name,
; the `proto-name` a resolved `extend` passes down. Those are not references and
; must not be re-resolved against the importing file's environment: the file that
; *reads* a canonical key is routinely not the file that wrote it, and B2a's
; whole point is that a file cannot name a namespace it did not import. Every
; genuine source spelling goes through `protocol-lookup` instead.
(defn protocol-lookup-ns (name:Symbol):?&Protocol
  (let (key:Symbol (protocol-key name)
        hit:?&Protocol (protocol-lookup-exact key))
    (when (!= hit null) (return hit))
    (when (!= key name) (return (protocol-lookup-exact name)))
    (return null)))

; Stage 15 B5: drop a hit whose `defprotocol-` privacy this file may not see.
; Short-circuited by `g-priv-bindings` exactly as the type/macro lookups are.
(defn protocol-visible (p:?&Protocol):?&Protocol
  (when (= p null) (return null))
  (when (= g-priv-bindings 0) (return p))
  (let (pp:&Protocol (unsafe/cast &Protocol p))
    (when (= (binding-visible (pp 'priv) (pp 'src-ns)) 0) (return null)))
  (return p))

; Stage 15 B2a — resolve a protocol *reference* (a source spelling) through the
; file's import environment (name-resolution.md §8.3, the canonicaliser in
; nucleusc.nuc). This is the protocol half of the cut-over: the qualifier is
; resolved by `resolve-spelling` and nothing else, so
;   * `(import-prefixed nsdescribe dpx)` makes `dpx/Describe` resolve and
;     `dp/Describe` — the library's own namespace — NOT resolve, which is the
;     reported defect (§2.1/§3 #3);
;   * `(import-use lib)` makes both the bare name and `<lib-ns>/name` resolve
;     (§8.3 row 1, R2's escape hatch);
;   * a qualifier bound nowhere in this file resolves to nothing, even when the
;     raw spelling happens to *be* a registry key.
;
; A bare name probes the current namespace, then the flattened set, then the bare
; (`user`) key — the order every reference lookup walks (ambient-namespaces.md §8).
;
; Note an *ambiguous* bare reference is still correctly a miss under `user`: with
; `a/Describe` and `b/Describe` registered and neither namespace flattened, bare
; `Describe` resolves to neither and the caller must qualify.
(defn protocol-lookup (name:Symbol):?&Protocol
  (let (r:ref:NameRef (resolve-spelling name))
    (when (= (r 'status) NR-UNBOUND) (return null))
    ; Stage 15 B5: `defprotocol-`'s privacy is enforced HERE, in the reference
    ; resolver, and not in `protocol-lookup-exact` — that one is the KEY lookup
    ; registration itself uses, and a define must always find its own entry.
    (let (reach:Symbol (priv-reach-enter name)
          hit:?&Protocol (protocol-visible (protocol-lookup-exact (r 'canonical))))
      (set! g-priv-reach-ns reach)
      (when (!= hit null) (return hit))
      ; A qualified reference names exactly one namespace: no fallback.
      (when (= (r 'status) NR-QUALIFIED) (return null))
      (when (!= g-ns-declared 0)
        (dotimes (i (file-imports-count))
          (match (file-flattened-ns-at i)
            ((some fns)
              (let (k:Symbol (ns-qualify-in fns (r 'bare)))
                (when (and (!= k (r 'canonical)) (!= k (r 'bare)))
                  (let (h3:?&Protocol (protocol-visible (protocol-lookup-exact k)))
                    (when (!= h3 null) (return h3))))))
            (none 0))))
      ; `user` last, as for every other kind: a core library's `Drop` is not a user file's.
      (when (!= (r 'canonical) (r 'bare))
        (let (h2:?&Protocol (protocol-visible (protocol-lookup-exact (r 'bare))))
          (when (!= h2 null) (return h2))))
      (return null))))

; Stage 15 B2a — for a name that may be EITHER a live source spelling or an
; already-canonical key, in a position that is downstream of the scope gate.
; The `(dyn P)` consumers are the case: a box carries a protocol name minted from
; whatever spelling created it, and by the time a method is dispatched through
; its vtable the admission check at `emit-box-value` has already ruled on whether
; this file may name the protocol. Asking again would be a second gate, and a
; wrong one — the box may have been constructed in another file.
(defn protocol-resolve-any (name:Symbol):?&Protocol
  (let (hit:?&Protocol (protocol-lookup name))
    (when (!= hit null) (return hit))
    (return (protocol-lookup-ns name))))

(defn protocol-new (name:Symbol sigs:ptr num-sigs:i32):&Protocol
  (let (p:&Protocol (new Protocol))
    ; The registry key is the namespace-qualified identity of the *defining*
    ; namespace (identity under `user`). Everything downstream — the conformance
    ; registry, the super-protocol edges, `(dyn P)`'s box type — keys off this
    ; canonical name via `protocol-canon-name`.
    (set! (p 'name) (protocol-key name))
    (set! (p 'sigs) sigs)
    (set! (p 'num-sigs) num-sigs)
    (set! (p 'params) null)
    (set! (p 'num-params) 0)
    ; Stage 15 B5: `defprotocol-`'s privacy. `prescan-protocols` arms
    ; g-defining-private for the private spelling; before B5 the flag was set
    ; and then dropped on the floor, which is the second of §13.2's two
    ; independently-found instances of one failure mode.
    (set! (p 'priv) g-defining-private)
    (set! (p 'src-ns) g-current-ns)
    (when (!= g-defining-private 0) (set! g-priv-bindings 1))
    (conj g-protocols p)
    (return p)))

; Is `name` one of the built-in blanket protocols (§10.1)? Blanket protocols have
; automatic conformance — no `extend` is written — so they are consulted before
; the nominal conformance registry.
(defn blanket-lookup (name:Symbol):i32
  (dotimes (i (unsafe/cast i32 (count g-blanket)))
    (when (= (invoke g-blanket i:usize) name) (return 1)))
  (return 0))

; Asked by the A2 pass, once every import has registered its protocols. A mere
; registry KEY (`geom/Show` under a `gx` prefix) is not a name its file may use.
(defn constraint-proto-known (crec:ref:Constraint):bool
  (constraint-settle crec)
  (return (crec 'settled)))

; The refusal, with the qualifier note asked in the constraint's own file.
(defn constraint-unknown-message (crec:ref:Constraint who:StrView):StrView
  (let (save-path:Symbol g-source-path
        save-ns:Symbol g-current-ns
        save-imports:?&ImportVec g-file-imports)
    (set! g-source-path (crec 'path))
    (set! g-current-ns (crec 'ns))
    (set! g-file-imports (crec 'imports))
    (let (msg:StrView (protocol-ref-message
                        (fstr who ": :where names unknown protocol '" (crec 'proto) "'")
                        (crec 'proto)))
      (set! g-source-path save-path)
      (set! g-current-ns save-ns)
      (set! g-file-imports save-imports)
      (return msg))))

; Queue `crec`, written at `line` by a `who`, for `drain-where-checks`.
(defn where-check-later (crec:ref:Constraint line:i32 who:StrView):void
  (let (w:&WhereCheck (new WhereCheck))
    (set! (w 'crec) crec)
    (set! (w 'line) line)
    (set! (w 'who) who)
    (conj g-where-checks w)))

; Refuse a queued `:where` whose protocol no file defines, at its own line.
(defn drain-where-checks ():void
  (while (< g-where-checked (unsafe/cast i32 (count g-where-checks)))
    (let (w:&WhereCheck (invoke g-where-checks (as usize g-where-checked)))
      (set! g-where-checked (+ g-where-checked 1))
      (when (not (constraint-proto-known (w 'crec)))
        (set! g-source-path ((w 'crec) 'path))
        (die-at (w 'line) (constraint-unknown-message (w 'crec) (w 'who)))))))

; A call no candidate took, where one names an unknown protocol, is refused as that
; definition: the drain runs after emission, so the call would be reported first.
(defn refuse-unknown-where (g:ptr:Generic nargs:i32):void
  (doseq (m (g 'methods) (VecIter &Method))
    (when (and (= (m 'kind) METHOD-GENERIC) (= (m 'num-params) nargs))
      (dotimes (ci (m 'num-constraints))
        (let (crec:ref:Constraint (constraints-at (m 'constraints) ci))
          (when (not (constraint-proto-known crec))
            (set! g-source-path (crec 'path))
            (die-at ((m 'body) 'line) (constraint-unknown-message crec "defn"))))))))

; Stage 13 L2: does `ty` conform to the `Drop` protocol? Owning-ness in this
; compiler is recorded *nominally*: a struct (or stamped template instance) is
; Drop iff `(extend <S> Drop)` recorded the conformance — collections write that
; extend by hand on the wrapper struct, so a struct that owns a Drop field is
; itself extended to Drop and this nominal check is the transitive answer. The
; same nominal predicate `with-drop-method`/`union-drop-arm` use; reused here so
; Drop-ness has a single source of truth. A bare struct (TY-STRUCT) or untagged
; union (TY-UNION, also a StructDef) is checked on its registered name; every
; non-aggregate kind is never Drop.
(defn type-conforms-drop (ty:?&Type):i32
  (let (tt:ptr:Type ty
        k:i32 (tt 'kind))
    (when (or (= k TY-STRUCT) (= k TY-UNION))
      (let (sd:?&StructDef (tt 'sdef))
        (when (= sd null) (return 0))
        (when (!= (conformance-lookup (sd 'name) (core-proto-key "Drop")) 0) (return 1))))
    (return 0)))

; Stage 13 L2: is `ty` trivially (bitwise) copyable, hence automatically `Clone`?
; A primitive (any non-aggregate kind — scalar, pointer, CStr, Err, usize, …) is
; trivially copyable. A struct or untagged union is trivially copyable iff it does
; NOT conform to `Drop` (transitively, per `type-conforms-drop`): a Drop-free
; aggregate owns no resources, so a value copy is sound and the closure owns
; nothing. An owning (Drop) aggregate is excluded — it must hand-write `clone`
; (an `(extend <S> Clone)`), which the nominal conformance registry serves. A
; TY-TYVAR is abstract and never structurally trivial here (its Clone-ness comes
; from its own `:where` bound), so it returns 0.
(defn type-trivially-copyable (ty:?&Type):i32
  (let (tt:ptr:Type ty
        k:i32 (tt 'kind))
    (when (= k TY-TYVAR) (return 0))
    (when (or (= k TY-STRUCT) (= k TY-UNION))
      (when (!= (type-conforms-drop ty) 0) (return 0)))
    (return 1)))

; Automatic conformance for a blanket protocol (§10.1). `Any` holds for every
; type (the no-constraint constraint); `Struct` holds for any struct type or
; pointer-to-struct (its required `get` member-access method is supplied by a
; built-in once callable-values lands). `Clone` (Stage 13 L2) holds automatically
; for any trivially-copyable type — a primitive, or a Drop-free aggregate — with a
; bitwise copy as its `clone`; an owning (Drop) type is excluded here and conforms
; only by a hand-written `(extend <S> Clone)` recorded nominally. Blanket
; conformance is structural and consulted directly, so it is never recorded in
; g-conformances.
(defn blanket-conforms (ty:ptr:Type proto-name:Symbol):i32
  (when (= proto-name "Any") (return 1))
  (when (= proto-name "Struct")
    (let (k:i32 (ty 'kind))
      (when (= k TY-STRUCT) (return 1))
      (when (and (= k TY-PTR)
                 (and (!= (ty 'elem) null)
                      (= ((ty 'elem) 'kind) TY-STRUCT)))
        (return 1))
      (return 0)))
  (when (core-named? proto-name "Clone")
    (return (type-trivially-copyable ty)))
  (return 0))

; Conformance facts are global, and BOTH halves of the key are canonicalized to
; their own registry's namespaced identity. Stage 12 N4 decision 9 keyed the type
; half bare; Stage 15 W9 defect 21 namespaced the protocol half; Stage 15 B3′ (R1)
; namespaced the type half too, because two namespaces may now both define
; `Vector` and a bare key would make one conformance fact stand for both.
;
;   * the TYPE half → `type-canon-name` (src/nucleusc.nuc), which resolves a
;     source spelling through the file's import environment and passes an
;     already-canonical name (or a primitive/structural spelling) through;
;   * the PROTOCOL half → `protocol-canon-name`. Bare `Describe` inside `(ns dp)`
;     and `dp/Describe` from anywhere else are the same key `dp/Describe`, while
;     `a/Describe` and `b/Describe` are different protocols that do not collide.
;
; The two functions are different only because each consults its own registry;
; the RULE is now the same for both, which is what R1 bought.
;
; Under `user` both are the identity, so the bootstrap stays byte-identical.
; Centralizing both in conformance-add/-lookup/-args covers every caller (extend,
; imported extend, dispatch constraint check, A2 recovery) with one chokepoint.
(defn conformance-lookup (type-name:Symbol proto-name:Symbol):i32
  (set! type-name (type-canon-name type-name))
  (set! proto-name (protocol-canon-name proto-name))
  (dotimes (i (unsafe/cast i32 (count g-conformances)))
    (let (c:&Conformance (invoke g-conformances i:usize))
      (when (and (= (c 'type-name) type-name)
                 (= (c 'proto-name) proto-name))
        (return 1))))
  (return 0))

; Retrieve the retained associated-type arguments for the `(type-name, proto-name)`
; conformance (assoc-types A1; consumed by A2's dispatch-time recovery). Returns the
; `args` ptr array (of canonical type-spelling strings) and writes the count through
; `out-nargs` (a &i32 box). Returns null with *out-nargs = 0 when no such
; conformance exists or it carries no parametric args (a plain protocol, or a stale
; record predating arg retention). The two outcomes — no record vs. record-without-
; args — are distinguished by conformance-lookup, which A2 calls first.
; Length of a retained-arg Vector (0 for the null / no-args case). The cast is a
; non-null assertion, safe because it only runs on the guarded non-null branch.
(defn conf-args-count (v:?&(Vector Symbol)):i32
  (if (= v null) 0 (unsafe/cast i32 (count (unsafe/cast &(Vector Symbol) v)))))

(defn conformance-args (type-name:Symbol proto-name:Symbol out-nargs:ptr):?&(Vector Symbol)
  ; Canonicalize to the same key conformance-add records (see conformance-lookup's
  ; note): both halves namespaced since B3′.
  (set! type-name (type-canon-name type-name))
  (set! proto-name (protocol-canon-name proto-name))
  (dotimes (i (unsafe/cast i32 (count g-conformances)))
    (let (c:&Conformance (invoke g-conformances i:usize))
      (when (and (= (c 'type-name) type-name)
                 (= (c 'proto-name) proto-name))
        (set! (aref (unsafe/cast &i32 out-nargs) 0) (conf-args-count (c 'args)))
        (return (c 'args)))))
  (set! (aref (unsafe/cast &i32 out-nargs) 0) 0)
  (return null))

; Compare two retained-arg Vectors of canonical type-spellings for equality
; (§14.4): the length must match and every spelling must be equal. Interned
; `Symbol`s make `!=` an identity compare, so this is still a value comparison. A
; null Vector is treated as length 0 (a plain protocol carries no args).
(defn conformance-args-eq (a:?&(Vector Symbol) b:?&(Vector Symbol)):i32
  (let (na:i32 (conf-args-count a)
        nb:i32 (conf-args-count b))
    (when (!= na nb) (return 0))
    (when (= na 0) (return 1))
    (let (av:&(Vector Symbol) (unsafe/cast &(Vector Symbol) a)
          bv:&(Vector Symbol) (unsafe/cast &(Vector Symbol) b))
      (dotimes (i na)
        (when (!= (invoke av i:usize) (invoke bv i:usize))
          (return 0))))
    (return 1)))

; Record that `type-name` conforms to `proto-name`, retaining the parametric
; protocol's bound arguments `args` (length `nargs`, a ptr array of canonical
; type-spelling strings; null/0 for a plain protocol) for assoc-type recovery (A2).
; Coherence (one conformance per (type, proto)):
;   - a re-extend with *identical* args is a silent no-op (historical behaviour);
;   - a re-extend with *different* args is rejected (recovery would be ambiguous);
;   - a re-record with no args (the super-protocol recursion and the historical
;     plain-protocol path both pass null/0) leaves an existing arg-bearing record
;     untouched, and an existing arg-less record is *upgraded* in place if real
;     args arrive later (e.g. a stale conformance recorded before the args were
;     known). Conflict therefore fires only when both sides carry args and differ.
(defn conformance-add (type-name:Symbol proto-name:Symbol args:ptr nargs:i32 line:i32):void
  ; Record under each half's own canonical identity, so the dispatch-site lookup
  ; (canonicalized the same way) matches. Identity under `user`.
  (set! type-name (type-canon-name type-name))
  (set! proto-name (protocol-canon-name proto-name))
  ; Materialize the incoming args as a (Vector Symbol) — null when there are none
  ; — so the retained representation is value-comparable (§14.4).
  (let (av:?&(Vector Symbol) null)
    (when (> nargs 0)
      (let (v:&(Vector Symbol) (vector-new-in &g-arena-alloc))
        (dotimes (i nargs) (conj v (aref (unsafe/cast &Symbol args) i)))
        (set! av v)))
    (dotimes (i (unsafe/cast i32 (count g-conformances)))
      (let (c:&Conformance (invoke g-conformances i:usize))
        (when (and (= (c 'type-name) type-name) (= (c 'proto-name) proto-name))
          ; Incoming call supplies no args → nothing to add or check; keep as-is.
          (when (= nargs 0) (return))
          ; Existing record has no retained args → upgrade it in place.
          (when (= (c 'args) null)
            (set! (c 'args) av)
            (return))
          ; Both sides carry args: they must agree, else it is a coherence error.
          (when (= (conformance-args-eq (c 'args) av) 0)
            (die-at line
              (fstr "type '" (key-display type-name line) "' re-extends protocol '" proto-name
                    "' with different associated arguments")))
          (return))))
    (let (c:&Conformance (unsafe/cast &Conformance (arena-alloc (sizeof Conformance))))
      (set! (c 'type-name) type-name)
      (set! (c 'proto-name) proto-name)
      (set! (c 'args) av)
      (conj g-conformances c)
      (tmpl-retry-pending))))

; Has a synthesized closure-conformance forwarder with this exact ir-name
; already been registered (and thus queued for emission) in generic `gen-name`?
; Used to collapse the otherwise-colliding `apply.pfn.<ret>` thunks that several
; same-signature bare `fn` operands would each synthesize (see
; derive-closure-conformance). The freshly-registered method whose emission is
; being decided has a null ir-name at the call site, so it is never self-counted.
(defn derived-fwd-already-emitted (gen-name:Symbol mangled:Symbol):i32
  (let (g:ptr (generic-lookup gen-name))
    (when (= g null) (return 0))
    (let (gg:&Generic (unsafe/cast &Generic g))
      (dotimes (i (unsafe/cast i32 (count (gg 'methods))))
        (let (m:&Method (as &Method (invoke (gg 'methods) i:usize)))
          (when (and (not (symbol-none? (m 'ir-name)))
                     (= (m 'ir-name) mangled))
            (return 1))))
      (return 0))))

(defn derive-closure-conformance (cvtype:?&Type proto:Symbol line:i32):i32
  ; Stage 15 B3′: a synthesis region — it substitutes `Self` with the concrete
  ; type's CANONICAL spelling and re-parses the result.
  (let (saved:i32 g-type-key-ok)
    (set! g-type-key-ok 1)
    (let (r:i32 (derive-closure-conformance-in cvtype proto line))
      (set! g-type-key-ok saved)
      (return r))))

(defn derive-closure-conformance-in (cvtype:?&Type proto:Symbol line:i32):i32
  (let (cvspell:Symbol (type-spelling cvtype)
        cv:ptr:Type cvtype)
    ; Step 1: idempotent — already conforms.
    (when (!= (conformance-lookup cvspell proto) 0) (return 1))
    ; Step 2: recognized-set gate (UnaryFn / FoldFn / BinaryFn). BinaryFn is the
    ; same-typed-args comparator shape `sort` (lib/nucleus/combinators.nuc) needs; it is
    ; derived by the identical sig-scan as the other two (each protocol param is
    ; bound from a matching NODE-SYM in the single method's signature). This gate
    ; entry is inert under self-compilation — the compiler never stamps a
    ; BinaryFn — so the bootstrap stays a byte-identical fixed point.
    (when (not (or (core-named? proto "UnaryFn") (core-named? proto "FoldFn")
                  (core-named? proto "BinaryFn")))
      (return 0))
  ; Step 3: find the closure's invoke method — a METHOD-USER on the `invoke`
  ; generic whose self param (param-types[0]) is (ref Env) with Env.name == cvspell.
  ; Detection is semantic ("the type has an invoke method"), not by name, so it
  ; covers vfn/mfn/cfn closures uniformly; a hand-written struct with an `invoke`
  ; method that has NOT hand-extended the protocol would also derive (benign — if
  ; it HAD hand-extended, step 1 already returned 1).
  (let (ig:ptr (generic-lookup (symbol-intern "invoke"))
        im:?&Method null)
    ; The invoke search only fires when an `invoke` generic exists (a program
    ; with closures); a bare `fn` in a closure-free program reaches the TY-FN
    ; synthesis below with im=null.
    (when (!= ig null)
      (let (igg:&Generic (unsafe/cast &Generic ig))
        (dotimes (mi (unsafe/cast i32 (count (igg 'methods))))
          (let (mm:&Method (as &Method (invoke (igg 'methods) mi:usize)))
            (when (= (mm 'kind) METHOD-USER)
              (let (self-ty:ptr (aref (unsafe/cast &ptr (mm 'param-types)) 0))
                (when (!= self-ty null)
                  (let (st:&Type (unsafe/cast &Type self-ty))
                    (when (and (= (st 'kind) TY-PTR)
                               (and (!= (st 'elem) null)
                                    (= (st 'pkind) PTR-REF)))
                      (let (et:&Type (unsafe/cast &Type (st 'elem)))
                        (when (= (et 'kind) TY-STRUCT)
                          (let (sd:&StructDef (unsafe/cast &StructDef (et 'sdef)))
                            (when (and (!= (as ptr sd) null)
                                       (= (sd 'name) cvspell))
                              (set! im (as ptr mm)))))))))))))))
      ; Resolve the source method whose signature drives derivation. For a
      ; capturing closure that is the `invoke` method found above (call-style 0,
      ; forward by calling invoke on self). For a bare `fn` (TY-FN — no env, no
      ; invoke method) the fn's own param/return signature is the callable shape,
      ; so synthesize an imp directly from the TY-FN Type* (call-style 1, forward
      ; by dereffing self and calling the function pointer). im is null when no
      ; matching invoke method exists (the TY-FN case, or a non-callable type).
      (let (imp-src:?&Method null
            call-style:i32 0)
        (if (!= im null)
          (set! imp-src (unsafe/cast &Method im))
          (when (= (cv 'kind) TY-FN)
            (let (fn-np:i32 (cv 'num-params)
                  total:i32 (+ fn-np 1)
                  ptypes:ptr (arena-alloc (* total (ptr-bytes)))
                  self-ty:&Type (as &Type (make-type TY-PTR)))
              (set! (self-ty 'elem) cvtype)
              (set! (self-ty 'pkind) PTR-REF)
              (set! (aref (unsafe/cast &ptr ptypes) 0) (as ptr self-ty))
              (dotimes (fpi fn-np)
                (set! (aref (unsafe/cast &ptr ptypes) (+ fpi 1)) (as ptr ((field-at (cv 'params) fpi) 'type))))
              (let (syn:ref:Method (new Method))
                (set! (syn 'param-types) ptypes)
                (set! (syn 'num-params) total)
                (set! (syn 'ret-type) (cv 'ret))
                (set! (syn 'kind) METHOD-USER)
                (set! (syn 'has-rest) 0)
                (set! (syn 'variadic) 0)
                (set! imp-src (as ptr syn))
                (set! call-style 1)))))
        (when (= imp-src null) (return 0))
        ; Steps 4-5: protocol must be single-method; parse its sig.  imp is the
        ; non-null source method (cast from the nullable imp-src above).
        (let (imp:&Method (unsafe/cast &Method imp-src)
              ; B2a: `proto` arrives from a `(dyn P)` box, downstream of the
              ; box-construction scope gate — see `protocol-resolve-any`.
              pp:?&Protocol (protocol-resolve-any proto))
          (when (= pp null) (return 0))
          (when (!= (pp 'num-sigs) 1) (return 0))
        (let (sig:ptr (aref (unsafe/cast &ptr (pp 'sigs)) 0)
              ; S1: route the method name / return / params through the accessor so
              ; a new-style single-method protocol sig `(m (params) Ret)` works. For
              ; the legacy list-head `((m Ret) (params))` this reproduces the former
              ; method-name / ret-node exactly.
              method-name:Symbol (symbol-none)
              ret-node:ptr null
              params-node:ptr null
              fwd-style:i32 (proto-sig-parse sig (as &Symbol &method-name)
                              (as &ptr &ret-node)
                              (as &ptr &params-node))
              k:i32 (- (node-len params-node) 1)
              npp:i32 (pp 'num-params)
              args:ptr (arena-alloc (* (as i64 npp) (ptr-bytes)))
              j:i32 0)
            ; Step 6: arity check — non-self param count must match imp's.
            (when (!= k (- (imp 'num-params) 1)) (return 0))
          ; Step 8: bind each protocol extra-param to an invoke type spelling.
          ; For each extra-param name pj, scan the sig's ret node and non-self
          ; param type nodes for a NODE-SYM matching pj; the corresponding invoke
          ; type's spelling is the candidate. Zero candidates → unbindable;
          ; multiple differing candidates → inconsistent. (UnaryFn: Arg←invoke
          ; param[0], Ret←invoke ret. FoldFn: Acc←invoke ret/param[0], Elem←
          ; invoke param[1].)
          (while (< j npp)
            (let (pj:Symbol (aref (unsafe/cast &Symbol (pp 'params)) j)
                  cand:Symbol (symbol-none)
                  ncand:i32 0
                  pi2:i32 0)
              (when (and (!= ret-node null)
                         (and (= ((unsafe/cast &Node ret-node) 'kind) NODE-SYM)
                              (= ((unsafe/cast &Node ret-node) 's) pj)))
                (set! cand (type-spelling (imp 'ret-type)))
                (inc! ncand))
              (while (< pi2 k)
                (let (ptn:ptr (binding-type-node (node-at params-node (+ pi2 1))))
                  (when (and (!= ptn null)
                             (and (= ((unsafe/cast &Node ptn) 'kind) NODE-SYM)
                                  (= ((unsafe/cast &Node ptn) 's) pj)))
                    (let (this-cand:Symbol
                           (type-spelling (aref (unsafe/cast &ptr (imp 'param-types)) (+ pi2 1))))
                      (inc! ncand)
                      (when (symbol-none? cand) (set! cand this-cand))
                      (when (!= cand this-cand)
                        (return 0)))))
                (inc! pi2))
              (when (= ncand 0) (return 0))
              (set! (aref (unsafe/cast &Symbol args) j) cand))
            (inc! j))
            ; Step 9: synthesize the forwarding method (mirrors fn-make-invoke-method).
            ; call-style 0 (closure): (invoke self __a0…) routes to the env's invoke.
            ; call-style 1 (bare fn): ((deref self) __a0…) loads the fn pointer from
            ; the self slot and calls it directly (a TY-FN indirect call).
            (let (ret-spelling:Symbol (type-spelling (imp 'ret-type))
                  total:i32 (imp 'num-params)
                  name-sym:ptr (as ptr (intern-node method-name))
                  ret-node:ptr (as ptr (intern-node ret-spelling))
                  self-sym:ptr (as ptr (intern-node (symbol-intern "self")))
                  env-ref-node:ptr
                    (node-list2 (as ptr (intern-node (symbol-intern "ref")))
                      (as ptr (intern-node cvspell)) line)
                  self-spec:ptr
                    (node-list2 self-sym env-ref-node line)
                  params-spine:ptr null
                  pi3:i32 (- k 1))
              (while (>= pi3 0)
                (let (a-sym:ptr (as ptr (intern-node (symbol-intern (fstr "__a" pi3))))
                      ty-sym:ptr
                        (as ptr (intern-node
                                    (type-spelling
                                      (aref (unsafe/cast &ptr (imp 'param-types)) (+ pi3 1)))))
                      spec-i:ptr (node-list2 a-sym ty-sym line))
                  (set! params-spine (node-cons spec-i params-spine line))
                  (dec! pi3)))
              (set! params-spine (node-cons self-spec params-spine line))
              (let (fwd-args:ptr null
                    pi4:i32 (- k 1))
                (while (>= pi4 0)
                  (set! fwd-args
                    (node-cons (as ptr (intern-node (symbol-intern (fstr "__a" pi4))))
                      fwd-args line))
                  (dec! pi4))
                (let (call-head:ptr
                        (if (= call-style 0)
                          (node-cons (as ptr (intern-node (symbol-intern "invoke")))
                            (node-cons self-sym fwd-args line) line)
                          (let (deref-self:ptr
                                  (node-list2 (as ptr (intern-node (symbol-intern "deref")))
                                    self-sym line))
                            (node-cons deref-self fwd-args line)))
                      ; New-style: (defn <method> (params) <ret> <call-head>).
                      defn-form:ptr
                        (node-list5 (as ptr (intern-node (symbol-intern "defn")))
                          name-sym
                          params-spine
                          ret-node
                          call-head line)
                      mtypes:ptr (arena-alloc (* (as i64 total) (ptr-bytes))))
                (dotimes (ci total)
                  (set! (aref (unsafe/cast &ptr mtypes) ci) (aref (unsafe/cast &ptr (imp 'param-types)) ci)))
                (let (mangled:Symbol (mangle-fn-name (symbol-intern "") method-name mtypes total))
                  ; A bare `fn` (call-style 1) erases its signature to the lossy
                  ; "pfn" token under mangle-fn-name, so every same-signature bare
                  ; fn forwards through an IDENTICAL synthesized method named e.g.
                  ; `apply.pfn.i32` (the forwarder just derefs self and calls the
                  ; fn pointer — correct for any bare fn of that signature). The
                  ; conformance key, however, is the per-fn `__fnty_N` spelling
                  ; (fnty-intern dedups by Type* identity), so step 1's idempotent
                  ; short-circuit misses and each occurrence would re-synthesize a
                  ; colliding `define @apply.pfn.i32`. Register the method for
                  ; dispatch unconditionally, but queue its emission MonoJob only
                  ; the first time this exact ir-name is seen — a later occurrence
                  ; reuses the single shared thunk. (Capturing closures never hit
                  ; this: each has a distinct env-struct spelling, so their
                  ; forwarder names are already unique.)
                  (let (newm:ref:Method
                         (generic-register-method method-name (imp 'ret-type)
                           mtypes total 0 0 defn-form)
                        already:i32 (derived-fwd-already-emitted method-name mangled))
                    (set! (newm 'ir-name) mangled)
                    (fn-force-generic-mangled method-name)
                    (when (= already 0)
                      (conj g-mono-worklist
                            (mono-job-here defn-form
                              (fstr "while deriving closure conformance to " proto " (at "
                                    g-source-path ":" line ")"))))
                    ; Step 10: record the conformance with the recovered args.
                    (conformance-add cvspell proto args npp line)
                    ; Step 11: success.
                    (return 1))))))))))))


; Record a protocol-inheritance edge: conforming to `sub` requires `super`.
; BOTH names here are protocols (this is the `(extend Describe Show)` shape), so
; both canonicalize through `protocol-canon-name` — never `strip-ns-qualifier`,
; which is the *type* canonicalizer. Identity under `user`.
(defn proto-super-add (sub:Symbol super:Symbol):void
  (set! sub (protocol-canon-name sub))
  (set! super (protocol-canon-name super))
  (dotimes (i (unsafe/cast i32 (count g-proto-supers)))
    (let (e:&Conformance (invoke g-proto-supers i:usize))
      (when (and (= (e 'type-name) sub) (= (e 'proto-name) super))
        (return))))
  (let (e:&Conformance (unsafe/cast &Conformance (arena-alloc (sizeof Conformance))))
    (set! (e 'type-name) sub)
    (set! (e 'proto-name) super)
    (conj g-proto-supers e)))

; Substitute the type variable `Self` in a colon-typed symbol spelling: split
; on ':' and replace any segment that is exactly "Self" with the concrete type
; name, rejoining with ':'. "self:ptr:Self" with Circle → "self:ptr:Circle".
(defn subst-self-sym (s:Symbol typename:Symbol line:i32):Symbol
  (let (segs:ptr (split-colon-segments s line)
        acc:String (string-new)
        n:i32 0)
    (dotimes (i (node-len segs))
      (let (seg:Symbol ((unsafe/cast &Node (node-at segs i)) 's))
        (when (!= n 0) (str-into &acc ":"))
        (str-into &acc (if (= seg "Self") typename seg))
        (inc! n)))
    (when (= n 0) (return s))
    (return (symbol-intern (string-as-view &acc)))))

; Deep-copy a signature AST with Self→typename in every symbol, yielding a
; concrete signature parseable by the ordinary defn helpers.
(defn subst-self-node (node:?&Node typename:Symbol):?&Node
  (when (= node null) (return null))
  (let (n:?&Node node)
    (case (n 'kind)
      NODE-SYM
        (let (ns:&Node (as &Node (alloc-node)))
          (set! (ns 'kind) NODE-SYM)
          (set! (ns 'line) (n 'line))
          (set! (ns 's) (subst-self-sym (n 's) typename (n 'line)))
          (return (as ptr ns)))
      NODE-LIST
        (return (node-cons (subst-self-node (node-first n) typename)
                  (subst-self-node (node-rest n) typename) (n 'line)))
      0)
    (return node)))

; Deep-copy a (parametric) protocol signature AST, substituting `Self`→typename
; and each extra protocol parameter `params[i]`→`pspellings[i]` (T4). This is the
; element-binding generalization of subst-self-node: a `Self`-only protocol
; (nparams=0) reduces to substituting `Self` alone, identical in effect to
; subst-self-node. Reuses the structural tyvar substituter subst-tyvars-node by
; building a combined name→spelling map {Self→typename, E→…}.
(defn subst-proto-sig-node (node:?&Node typename:Symbol params:ptr pspellings:ptr nparams:i32):?&Node
  (let (n:i32 (+ nparams 1)
        names:ptr (arena-alloc (* n (ptr-bytes)))
        spellings:ptr (arena-alloc (* n (ptr-bytes))))
    (set! (aref (unsafe/cast &Symbol names) 0) (symbol-intern "Self"))
    (set! (aref (unsafe/cast &Symbol spellings) 0) typename)
    (dotimes (i nparams)
      (set! (aref (unsafe/cast &Symbol names) (+ i 1)) (aref (unsafe/cast &Symbol params) i))
      (set! (aref (unsafe/cast &Symbol spellings) (+ i 1)) (aref (unsafe/cast &Symbol pspellings) i)))
    (return (subst-tyvars-node node names spellings n))))

; Register a (defprotocol Name (sig...) ...) form, or a parametric protocol
; (defprotocol (Name E...) (sig...) ...) whose name position is a *list* (the
; same list-head rule as defstruct/defunion templates). For the parametric form
; the head symbol is the protocol name and the remaining list elements are the
; extra type parameters bound at the `extend` site (T4). Idempotent on name.
(defn protocol-register-form (form:?&Node):void
  (let (ff:ptr:Node form)
    (when (< (node-len form) 2)
      (die-at (ff 'line) "defprotocol: expected (defprotocol Name (sig...) ...)"))
    (let (name-node:&Node (unsafe/cast &Node (node-at form 1))
          pname:Symbol (symbol-none)
          params:ptr null
          nparams:i32 0)
      ; W4b sibling sweep (design/stage15-stress-test/diagnostics.md): a bare
      ; colon-typed name ("P:i32") used to sail past the plain-symbol branch
      ; below unchanged and register the Protocol under that literal,
      ; unlookupable key — the same defconst-shaped bug (an `extend Foo P`
      ; then failed as an unrelated "unknown protocol 'P'", with no
      ; diagnostic at the definition).
      (reject-colon-in-def-name name-node "defprotocol" (ff 'line))
      ; Parametric protocol: name position is a list `(Seq E ...)` — head is the
      ; protocol name, the rest are the extra parameter names (beyond Self).
      (if (= (node-kind (as ptr name-node)) NODE-LIST)
        (let (head:&Node (unsafe/cast &Node (node-at (as ptr name-node) 0)))
          ; W9 item 45: `node-kind`, so a head spelled `(())` reaches this
          ; message rather than dereferencing the NULL node `()` reads as.
          (when (!= (node-kind (as ptr head)) NODE-SYM)
            (die-at (name-node 'line) "defprotocol: protocol name must be a symbol"))
          (set! pname (head 's))
          (set! nparams (- (node-len (as ptr name-node)) 1))
          (when (< nparams 1)
            (die-at (name-node 'line)
              "defprotocol: parametric protocol needs at least one parameter — use a plain defprotocol"))
          ; W4b: a single parameter that is itself a CELL (not a bare tyvar
          ; symbol) can only be the colon-paren-fused shape ("P:(i32)" ->
          ; (P (i32))) — a genuine parametric protocol's extra parameters are
          ; always bare symbols (E, K, V, ...). Give the annotation-specific
          ; message here rather than falling into the generic, misleading
          ; "protocol parameter must be a symbol" below.
          (when (and (= nparams 1)
                     (= (node-kind (node-at (as ptr name-node) 1)) NODE-LIST))
            (die-at (name-node 'line)
              (fstr "defprotocol: takes no type annotation; write (defprotocol " (head 's)
                    " ...)")))
          (set! params (arena-alloc (* nparams (ptr-bytes))))
          (dotimes (pi nparams)
            (let (pv:&Node (unsafe/cast &Node (node-at (as ptr name-node) (+ pi 1))))
              (when (!= (node-kind (as ptr pv)) NODE-SYM)
                (die-at (node-line (as ptr pv) (name-node 'line))
                  "defprotocol: protocol parameter must be a symbol"))
              (set! (aref (unsafe/cast &Symbol params) pi) (pv 's)))))
        (do
          (when (!= (name-node 'kind) NODE-SYM)
            (die-at (name-node 'line) "defprotocol: name must be a symbol"))
          (set! pname (name-node 's))))
      ; Idempotence probe on the EXACT key this registration will use. Routing it
      ; through `protocol-lookup` would consult that resolver's bare fallback and
      ; silently treat an unrelated `user` protocol of the same bare name as
      ; "already registered", so `(ns dp) (defprotocol Clone …)` would never
      ; register `dp/Clone` — the same reason `generic-register-method` uses
      ; `generic-lookup-exact`. A define's key is already final.
      ; Stage 15 B4 (R4): the probe above stays an idempotence probe — this
      ; registrar really is re-entered for one form — but a hit at a DIFFERENT
      ; defining site is a second `defprotocol` of the name, which used to be a
      ; silent no-op keeping the first.
      (if-some (prev (protocol-lookup-exact (protocol-key pname)))
        (do
          (when (!= (same-definition-site (prev 'src-file) (prev 'src-line) (ff 'line)) 0)
            (when (= (prev 'src-imports) null) (set! (prev 'src-imports) g-file-imports))
            (return))
          (die-redefinition pname (ff 'line) BK-PROTOCOL
                            (prev 'src-file) (prev 'src-line)))
        0)
      (guard-name-kind pname (ff 'line) NK-PROTOCOL)
      (let (nsigs:i32 (- (node-len form) 2)
            sigs:ptr null)
        (when (> nsigs 0)
          (set! sigs (arena-alloc (* nsigs (ptr-bytes))))
          (dotimes (i nsigs)
            (let (sig:ptr (node-at form (+ i 2))
                  snn:ptr (node-at (node-at form (+ i 2)) 0))
              ; W9 item 45: a sig that is not a list carries no name to store and
              ; no params to parse lazily. `()` reads as NULL and `5` reads as an
              ; int; both used to reach `defn-name-only` and segfault, and a
              ; stored non-sig would have failed much later, at the `extend` that
              ; tried to satisfy it.
              (when (!= (node-kind sig) NODE-LIST)
                (die-at (node-line sig (ff 'line))
                  "defprotocol: method signature must be a list, e.g. (name (params):ret)"))
              (require-sig-name (as ?&Node snn) "defprotocol: method name"
                                (node-line sig (ff 'line)))
              ; S4: reject a legacy `name:ret` / list-head `(name ret)` method sig
              ; at registration (protocol sigs are stored verbatim and parsed
              ; lazily, so this is the one def-time chokepoint). New-style sigs put
              ; the return after the param list. The guard on defn-name-only keeps a
              ; genuinely malformed sig on its existing lazy-parse error path.
              (when (and (= (sig-name-is-bare snn) 0) (not (symbol-none? (defn-name-only snn))))
                (die-at (ff 'line)
                  (fstr "protocol method '" (defn-name-only snn)
                        "': legacy 'name:ret' syntax is no longer supported — write ("
                        (defn-name-only snn) " (params):ret)")))
              (when (or (!= (node-len sig) 3) (not (node-is-list (node-at sig 1))))
                (let (s:String (node-str (as ?&Node sig)))
                  (die-at (node-line sig (ff 'line))
                    (fstr "protocol method '" (defn-name-only snn)
                          "': expected (" (defn-name-only snn)
                          " (params) ret), found " (string-as-view &s)))))
              (set! (aref (unsafe/cast &ptr sigs) i) sig))))
        (let (p:ref:Protocol (protocol-new pname sigs nsigs))
          ; Stage 15 B4 (R4): the defining site, which is both the redefinition
          ; blame and the "same form, registered again" discriminator.
          (set! (p 'src-file) g-source-path)
          (set! (p 'src-line) (ff 'line))
          (set! (p 'src-imports) g-file-imports)
          (when (> nparams 0)
            (set! (p 'params) params)
            (set! (p 'num-params) nparams)))))))

(defn prescan-protocols (forms:?&Node):void
  (let (fc:?&Node forms)
    (while (> (node-len fc) 0)
      (let (f:?&Node (node-first fc))
        (when (and (and (!= f null) (= (f 'kind) NODE-LIST))
                   (and (>= (node-len (as ptr f)) 2)
                        (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 'kind) (= _ NODE-SYM))))
          (let (hh:Symbol (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 's)))
            ; Stage 12 N3: also handle defprotocol- (private protocol).
            ; Stage 15 B5: arm g-defining-private around the registration, the
            ; same shape prescan-defn-signatures uses for `defn-`. Registration
            ; happens here and nowhere else (the top-level dispatch arm for
            ; `defprotocol-` is a no-op), so this is the one place the private
            ; spelling can be recorded at all.
            (when (or (= hh "defprotocol") (= hh "defprotocol-"))
              (let (save-priv:i32 g-defining-private)
                (set! g-defining-private (if (= hh "defprotocol-") 1 0))
                (protocol-register-form f)
                (set! g-defining-private save-priv))))))
      (set! fc (node-rest fc)))))

; Parse every method signature of a defprotocol form now, as a defn signature
; is, rather than at the first `extend` (which may never come).
(defn proto-sigs-check-form (form:&Node):void
  (let (ff:?&Node form
        name-node:?&Node (node-at form 1)
        nparams:i32 (if (= (node-kind (as ptr name-node)) NODE-LIST) (- (node-len name-node) 1) 0)
        base:ptr (arena-alloc (* (+ nparams 1) (ptr-bytes)))
        nbase:i32 0)
    (tyvars-add (symbol-intern "Self") base (as &i32 &nbase))
    (dotimes (pi nparams)
      (let (pv:ptr:Node (node-at name-node (+ pi 1)))
        (when (= (node-kind (as ptr pv)) NODE-SYM)
          (tyvars-add (pv 's) base (as &i32 &nbase)))))
    (dotimes (si (- (node-len form) 2))
      (let (sig:?&Node (node-at form (+ si 2)))
        (when (and (= (node-kind (as ptr sig)) NODE-LIST)
                   (!= (sig-name-is-bare (node-at sig 0)) 0))
          (proto-sig-check sig base nbase (node-line sig (ff 'line))))))))

; A `:where` in a signature declares tyvars as a defn's does; the parse is dry
; (`g-dry-parse-ntv`), so a valid signature stamps and registers nothing.
(defn proto-sig-check (sig:?&Node base:ptr nbase:i32 line:i32):void
  (let (params:?&Node (node-at sig 1)
        wi:i32 (params-where-index params)
        tyvars:ptr (arena-alloc (* (+ nbase (count-pattern-nodes sig)) (ptr-bytes)))
        ntv:i32 nbase)
    (when (not (node-is-list params)) (return))
    (dotimes (bi nbase)
      (set! (aref (unsafe/cast &Symbol tyvars) bi) (aref (unsafe/cast &Symbol base) bi)))
    (when (>= wi 0)
      (let (nc:i32 (- (node-len params) (+ wi 1))
            constraints:ref:ConstraintVec (vector-new-in &g-arena-alloc))
        (parse-where-constraints params (+ wi 1) nc constraints tyvars (as &i32 &ntv) line)
        (dotimes (ci nc)
          (where-check-later (constraints-at constraints ci) line "defprotocol"))))
    (let (saved:DryParse (dry-parse-enter tyvars ntv))
      (defn-params-to-types-at (if (>= wi 0) (take-first-n params wi line) params) line)
      (fn-parse-ret-type (node-at sig 2) (node-line (node-at sig 2) line))
      (dry-parse-leave saved))))

; Arm the dry parse with `tyvars` as the type variables. Its flag is
; `g-dry-parse-ntv` > 0, so an unspellable name keeps a signature with none dry.
(defn dry-parse-enter (tyvars:ptr ntv:i32):DryParse
  (let (saved:DryParse (DryParse g-dry-parse-tyvars g-dry-parse-ntv)
        tv:ptr (arena-alloc (* (as i64 (+ ntv 1)) (ptr-bytes))))
    (dotimes (i ntv)
      (set! (aref (unsafe/cast &Symbol tv) i) (aref (unsafe/cast &Symbol tyvars) i)))
    (set! (aref (unsafe/cast &Symbol tv) ntv) (symbol-intern "#dry"))
    (set! g-dry-parse-tyvars tv)
    (set! g-dry-parse-ntv (+ ntv 1))
    (return saved)))

(defn dry-parse-leave (saved:DryParse):void
  (set! g-dry-parse-tyvars (saved 'tyvars))
  (set! g-dry-parse-ntv (saved 'ntv)))

; A generic template's signature, checked where a defn's is: its parameters,
; return and constraint arguments, dry, with its type variables.
(defn generic-sig-check (form:?&Node wi:i32 tyvars:ptr ntv:i32
                         constraints:ref:ConstraintVec nc:i32):void
  (let (ff:ptr:Node form
        line:i32 (ff 'line)
        params:?&Node (node-at form 2)
        ret:?&Node (defn-ret-node form)
        saved:DryParse (dry-parse-enter tyvars ntv))
    (defn-params-to-types-at (if (>= wi 0) (take-first-n params wi line) params) line)
    (fn-parse-ret-type ret (node-line ret line))
    (dotimes (ci nc)
      (let (crec:ref:Constraint (constraints-at constraints ci))
        (dotimes (ai (crec 'nargs))
          (let (an:?&Node (aref (unsafe/cast &ptr (crec 'args)) ai))
            (parse-type-from-node (as ptr an) (node-line (as ptr an) line))))))
    (dry-parse-leave saved)))

; A `deftype` body, checked at the definition: an alias is otherwise read only
; where it is used. Its use decides whether an array is storage.
(defn alias-body-check (form:&Node):void
  (when (!= (node-len form) 3) (return))
  (let (ff:?&Node form
        spec:?&Node (node-at form 1)
        body:?&Node (node-at form 2)
        np:i32 (if (= (node-kind spec) NODE-LIST) (- (node-len spec) 1) 0)
        tyvars:ptr (arena-alloc (* (as i64 (+ np 1)) (ptr-bytes)))
        ntv:i32 0)
    (when (= body null) (return))
    (dotimes (i np)
      (let (tv:ptr:Node (node-at spec (+ i 1)))
        (when (= (node-kind tv) NODE-SYM)
          (tyvars-add (tv 's) tyvars (as &i32 &ntv)))))
    (let (saved:DryParse (dry-parse-enter tyvars ntv)
          array-ok:i32 g-array-ok)
      (set! g-array-ok 1)
      (parse-type-from-node (as ptr body) (node-line (as ptr body) (ff 'line)))
      (set! g-array-ok array-ok)
      (dry-parse-leave saved))))

; Built-in result type of an operator generic `g` applied to a same-typed pair
; of operands, or null if the operator does not apply. Comparisons yield bool;
; arithmetic yields the operand type. This is what lets numeric/pointer built-ins
; satisfy operator protocol requirements (Num/Eq/Ord) with no user method (§10.3).
(defn builtin-op-result-type (g:?&Generic ptypes:ptr nparams:i32):ptr
  (let (gg:ptr:Generic g)
    (when (= (unsafe/cast i32 (count (gg 'methods))) 0) (return null))
    (let (m0:&Method (as &Method (invoke (gg 'methods) 0)))
      (when (!= (m0 'kind) METHOD-INTRINSIC) (return null))
      (when (!= nparams 2) (return null))
      (let (at:ptr (aref (unsafe/cast &ptr ptypes) 0)
            bt:ptr (aref (unsafe/cast &ptr ptypes) 1)
            bop:ptr:BinOp (m0 'binop))
        (when (= (type-eq at bt) 0) (return null))
        (if (!= (bop 'is-cmp) 0)
          (do
           ; bool keeps all six comparisons after the Stage 16 divorce, so it
           ; still satisfies Eq/Ord with no user method (§10.3).
           (when (or (!= (is-int-or-bool at) 0) (!= (is-float-type at) 0)
                     (= (-> at (unsafe/cast &Type _) (_ 'kind)) TY-PTR))
              (return ty-bool))
            ; CStr satisfies Eq (= / !=) only — content comparison via strcmp.
            (when (and (= (-> at (unsafe/cast &Type _) (_ 'kind)) TY-CSTR)
                       (or (= (bop 'name) "=")
                           (= (bop 'name) "!=")))
              (return ty-bool))
            (return null))
          (do
            (when (or (!= (is-int-type at) 0) (!= (is-float-type at) 0))
              (return at))
            (return null)))))))

; Does a method named `mname` satisfy a required signature (param types `ptypes`,
; return `ret`; ret=null means "any")? Either a user/concrete method at the exact
; tier, a *generic* method that binds for `ptypes` with satisfied constraints (T4:
; a method written over a parametric struct, e.g. `get`/`count` over `(Vector T)`,
; that resolves for the stamped instance), or a built-in operator whose result
; type matches. Shared by `extend` conformance and the `Valid` call-site check
; (§10.2). `line` is only used for the generic-bind probe's constraint diagnostics.
;
; `check-ret`: when nonzero the user/generic method's *return type* must also equal
; `ret`. This is required for parametric protocols whose return carries a bound
; element (`get:E`) — a `get:i32` does not satisfy `get:f64`. Plain (Self-only)
; protocols pass check-ret=0 to preserve the historical param-only match exactly
; (byte-identical), since their concrete methods already return the right type.
(defn method-satisfies-sig (mname:Symbol ptypes:ptr nparams:i32 ret:?&Type check-ret:i32 line:i32):i32
  (let (g:ptr (generic-lookup mname))
    (when (= g null) (return 0))
    (let (um:?&Method (generic-find-method-exact g ptypes nparams))
      (when (!= um null)
        (when (= check-ret 0) (return 1))
        (when (or (= ret null)
                  (and (!= (-> um (unsafe/cast &Method _) (_ 'ret-type)) null)
                       (!= (type-eq (-> um (unsafe/cast &Method _) (_ 'ret-type)) ret) 0)))
          (return 1))))
    (let (grt:ptr null)
      (when (!= (generic-binds-for g ptypes nparams (as &ptr &grt) line null) 0)
        (when (= check-ret 0) (return 1))
        (when (or (= ret null) (and (!= grt null) (!= (type-eq grt ret) 0)))
          (return 1))))
    (let (rt:ptr (builtin-op-result-type g ptypes nparams))
      (when (and (!= rt null) (or (= ret null) (!= (type-eq rt ret) 0))) (return 1)))
    (return 0)))

; Check that every required signature of `proto` resolves for `typename` with
; `Self`→typename and each extra protocol parameter substituted to `pspellings`.
; Returns 1 if all resolve, 0 (after printing each missing method) otherwise.
; The Self-only path passes nparams=0 — the substitution reduces to Self alone,
; byte-identical to the historical subst-self-node behavior.
(defn proto-sigs-resolve (proto:?&Protocol typename:Symbol pspellings:ptr line:i32 notes:&StrView):i32
; Stage 15 B3′: a protocol-signature substitution is a SYNTHESIS region — every type spelling parsed inside it
; was written by the compiler (a `type-spelling` of a bound tyvar, a `Self`
; substitution), not by any file, so the type reference resolvers take an exact-key
; fallback here. See `g-type-key-ok` (src/nucleusc.nuc) for why this is a scoped
; permission rather than a global relaxation.
  (let (saved:i32 g-type-key-ok)
    (set! g-type-key-ok 1)
    (let (r:i32 (proto-sigs-resolve-in proto typename pspellings line notes))
      (set! g-type-key-ok saved)
      (return r))))

(defn proto-sigs-resolve-in (proto:?&Protocol typename:Symbol pspellings:ptr line:i32 notes:&StrView):i32
  (let (pp:ptr:Protocol proto
        missing:i32 0
        foreign:bool (protocol-foreign? pp)
        self-s:Symbol (if foreign (env-arg-sym (as ptr (intern-node typename)) line) typename)
        param-s:ptr (if foreign (env-arg-syms pspellings (pp 'num-params) line) pspellings))
    (dotimes (i (pp 'num-sigs))
      (let (sig:ptr (aref (unsafe/cast &ptr (pp 'sigs)) i)
            csig:ptr (subst-proto-sig-node sig self-s (pp 'params) param-s (pp 'num-params))
            name-node:ptr (node-at csig 0)
            params-node:ptr (node-at csig 1)
            mname:Symbol (symbol-none)
            ret:ptr null
            sline:i32 (if foreign (node-line sig line) line)
            ctx:StrView (foreign-read-context (pp 'src-file) "protocol" (pp 'name) line)
            here:NameEnv (protocol-env-enter pp))
        (if (and (!= (sig-name-is-bare name-node) 0) (>= (params-where-index params-node) 0))
          (let (gm:&Method (proto-sig-generic-method csig sline))
            (name-env-set here)
            (set! g-mono-context ctx)
            (set! mname (-> name-node (unsafe/cast &Node _) (_ 's)))
            (when (not (generic-sig-satisfied mname gm (> (pp 'num-params) 0) line))
              (set! missing 1)
              (set! (aref notes 0)
                (fstr (aref notes 0) "\n  note: "
                      (key-display typename line) " does not implement " (pp 'name) "." mname
                      " for every type its :where admits"))))
          (do
            ; S1: a new-style sig carries the (Self-substituted) return at index 2;
            ; legacy sigs keep the exact extract-name-and-type parse (byte-identical).
            (if (!= (sig-name-is-bare name-node) 0)
              (do (set! mname (-> name-node (unsafe/cast &Node _) (_ 's)))
                  (set! ret (fn-parse-ret-type (node-at csig 2) sline)))
              (set! ret (extract-name-and-type name-node (as &Symbol &mname)
                                               ((unsafe/cast &Node name-node) 'line))))
            (let (nparams:i32 (defn-params-count params-node)
                  ptypes:ptr (if foreign (defn-params-to-types-at params-node sline)
                               (defn-params-to-types params-node))
                  ; Enforce the return type only for a parametric protocol, where the
                  ; return may carry a bound element (`get:E`). Plain protocols keep the
                  ; historical param-only match (byte-identical).
                  check-ret:i32 (if (> (pp 'num-params) 0) 1 0))
              ; The conformer's methods are the extend's to name, so match them back here.
              (name-env-set here)
              (set! g-mono-context ctx)
              (when (= (method-satisfies-sig mname ptypes nparams ret check-ret line) 0)
                (set! missing 1)
                (set! (aref notes 0)
                  (fstr (aref notes 0) "\n  note: "
                        (key-display typename line) " does not implement " (pp 'name) "." mname))))))))
    (when (!= missing 0) (return 0))
    (return 1)))

; A signature with its own `:where` as a template: its variables are abstract,
; as in a generic body's A2 check. A parameter or return that nests one is left
; null (unmodelled); only a bare variable or a concrete type is typed.
(defn proto-sig-generic-method (csig:?&Node line:i32):&Method
  (let (params:?&Node (node-at csig 1)
        wi:i32 (params-where-index params)
        nc:i32 (- (node-len params) (+ wi 1))
        cap:i32 (+ (count-pattern-nodes params) 1)
        constraints:ref:ConstraintVec (vector-new-in &g-arena-alloc)
        tyvars:ptr (arena-alloc (* (as i64 cap) (ptr-bytes)))
        ntv:i32 0
        ptypes:ptr (arena-alloc (* (as i64 (+ wi 1)) (ptr-bytes)))
        m:&Method (new Method))
    (parse-where-constraints params (+ wi 1) nc constraints tyvars (as &i32 &ntv) line)
    ; An unknown protocol would otherwise constrain nothing, and anything conform.
    (dotimes (ci nc)
      (let (crec:ref:Constraint (constraints-at constraints ci))
        (when (not (constraint-proto-known crec))
          (die-at line (constraint-unknown-message crec "defprotocol")))))
    (set! (m 'tyvars) tyvars)
    (set! (m 'num-tyvars) ntv)
    (set! (m 'constraints) constraints)
    (set! (m 'num-constraints) nc)
    (set! (m 'kind) METHOD-GENERIC)
    (set! (m 'body) csig)
    (set! (m 'num-params) wi)
    (set! (m 'ret-type) null)
    (dotimes (i wi)
      (let (pn:ptr:Node (node-at params i)
            tn:?&Node (if (= (node-kind pn) NODE-LIST) (binding-type-node pn) null))
        (set! (aref (unsafe/cast &ptr ptypes) i)
              (if (or (and (!= tn null) (!= (node-mentions-tyvar tn tyvars ntv) 0)
                           (not (and (= (node-kind tn) NODE-SYM)
                                     (>= (tyvar-index-of (tn 's) tyvars ntv) 0))))
                      (and (= (node-kind pn) NODE-SYM)
                           (not (symbol-none? (colon-tail (pn 's))))
                           (spelling-mentions-any (colon-tail (pn 's)) tyvars ntv)
                           (< (tyvar-index-of (colon-tail (pn 's)) tyvars ntv) 0)))
                null
                (gbind-decl-type pn m line)))))
    (set! (m 'param-types) ptypes)
    ; The protocol's file, so `generic-sig-satisfied` reads a nested parameter there.
    (set! (m 'src-ns) g-current-ns)
    (set! (m 'src-file) g-source-path)
    (set! (m 'src-imports) g-file-imports)
    (let (rn:?&Node (node-at csig 2))
      (when (and (!= rn null) (= (node-kind rn) NODE-SYM))
        (let (idx:i32 (tyvar-index-of (rn 's) tyvars ntv))
          (cond
            (>= idx 0) (set! (m 'ret-type) (make-tyvar-type (as ptr m) idx))
            (not (spelling-mentions-any (rn 's) tyvars ntv))
            (set! (m 'ret-type) (fn-parse-ret-type (as ptr rn) (node-line (as ptr rn) line)))
            true 0))))
    (return m)))

(defn canon-list (head:StrView items:ptr n:i32 line:i32):&Node
  (let (acc:?&Node null
        i:i32 (- n 1))
    (while (>= i 0)
      (set! acc (node-cons (aref (unsafe/cast &ptr items) i) acc line))
      (set! i (- i 1)))
    (return (node-cons (as ptr (intern-node (symbol-intern head))) acc line))))

; A pattern as one shape whatever its spelling, read in the current file; null if
; unmodelled. Shapes: design/progress.md, "a nested signature parameter matched by shape".
(defn tpat-canon (node:?&Node tyvars:ptr ntv:i32 line:i32):?&Node
  (when (= node null) (return null))
  (let (nline:i32 (node-line (as ptr node) line)
        items:ptr (arena-alloc (* (as i64 (+ (node-len (as ptr node)) 2)) (ptr-bytes))))
    (when (= (node-mentions-tyvar node tyvars ntv) 0)
      (set! (aref (unsafe/cast &ptr items) 0)
            (as ptr (intern-node (type-spelling (parse-type-from-node (as ptr node) nline)))))
      (return (canon-list "#ty" items 1 nline)))
    (let (ex:?&Node (type-alias-apply node nline))
      (when (!= ex null)
        (when (>= g-type-alias-depth MAX-TYPE-ALIAS-DEPTH)
          (die-at nline "type alias expands into a cycle"))
        (set! g-type-alias-depth (+ g-type-alias-depth 1))
        (let (r:?&Node (tpat-canon ex tyvars ntv nline))
          (set! g-type-alias-depth (- g-type-alias-depth 1))
          (return r))))
    (let (run:StrView "" op:?&Node (sigil-split node nline &run))
      (when (!= op null)
        (let (c:?&Node (tpat-canon op tyvars ntv nline))
          (when (= c null) (return null))
          (set! (aref (unsafe/cast &ptr items) 0) (as ptr (intern-node (symbol-intern run))))
          (set! (aref (unsafe/cast &ptr items) 1) (as ptr c))
          (return (canon-list "#sig" items 2 nline)))))
    (when (= (node-kind node) NODE-SYM)
      (let (split:?&Node (colon-spelling-node node nline))
        (when (!= split null) (return (tpat-canon split tyvars ntv nline))))
      (when (< (tyvar-index-of (node 's) tyvars ntv) 0) (return null))
      (set! (aref (unsafe/cast &ptr items) 0) (as ptr node))
      (return (canon-list "#tv" items 1 nline)))
    (when (!= (node-kind node) NODE-LIST) (return null))
    (when (!= (node-is-ptr-wrapper node) 0)
      (let (c:?&Node (tpat-canon (wrapper-inner-pattern node) tyvars ntv nline))
        (when (= c null) (return null))
        (set! (aref (unsafe/cast &ptr items) 0) (as ptr c))
        (return (canon-list "#ref" items 1 nline))))
    (let (nargs:i32 (- (node-len (as ptr node)) 1)
          key:Symbol (symbol-none)
          agg:i32 (node-inline-aggregate node))
      (if-some (st (node-template-of node))
        (when (= nargs (st 'ntv)) (set! key (st 'name)))
        (if-some (ut (node-union-template-of node))
          (when (= nargs (ut 'ntv)) (set! key (ut 'name)))
          0))
      (when (and (symbol-none? key) (= agg 0)) (return null))
      (when (not (symbol-none? key))
        (set! (aref (unsafe/cast &ptr items) 0) (as ptr (intern-node key))))
      (dotimes (i nargs)
        (let (arg:?&Node (node-at (as ptr node) (+ i 1))
              mname:Symbol (symbol-none)
              sub:?&Node (if (= agg 0) arg (aggregate-member-split arg &mname nline))
              c:?&Node (tpat-canon sub tyvars ntv nline))
          (when (= c null) (return null))
          (if (= agg 0)
            (set! (aref (unsafe/cast &ptr items) (+ i 1)) (as ptr c))
            (let (pair:ptr (arena-alloc (* 2 (ptr-bytes))))
              (set! (aref (unsafe/cast &ptr pair) 0) (as ptr c))
              (set! (aref (unsafe/cast &ptr items) i)
                    (as ptr (canon-list (symbol-as-view mname) pair 1 nline)))))))
      (return (if (= agg 0)
                (canon-list "#app" items (+ nargs 1) nline)
                (canon-list (if (= agg 1) "#struct" "#union") items nargs nline))))))

(defn canon-sym-at (n:?&Node i:i32):Symbol
  (return (-> (node-at (as ptr n) i) (unsafe/cast &Node _) (_ 's))))

; Does canonical pattern `p` match `s`, both from `tpat-canon`? With `bind`, a
; `(#tv U)` in `p` stands for whatever `s` has there, recorded in `pb` by U's index.
(defn tpat-match (p:?&Node s:?&Node bind:bool ptv:ptr pntv:i32 pb:ptr):bool
  (let (ph:Symbol (node-head-sym p))
    (when (and bind (= ph "#tv"))
      (let (idx:i32 (tyvar-index-of (canon-sym-at p 1) ptv pntv)
            cur:?&Node (aref (unsafe/cast &ptr pb) idx))
        (when (= cur null)
          (set! (aref (unsafe/cast &ptr pb) idx) (as ptr s))
          (return true))
        (return (tpat-match cur s false ptv pntv pb))))
    (when (or (!= ph (node-head-sym s)) (!= (node-len (as ptr p)) (node-len (as ptr s))))
      (return false))
    (dotimes (i (- (node-len (as ptr p)) 1))
      (let (pc:ptr:Node (node-at (as ptr p) (+ i 1))
            sc:ptr:Node (node-at (as ptr s) (+ i 1)))
        (when (!= (node-kind pc) (node-kind sc)) (return false))
        (if (= (node-kind pc) NODE-SYM)
          (when (!= (pc 's) (sc 's)) (return false))
          (when (not (tpat-match pc sc bind ptv pntv pb)) (return false)))))
    (return true)))

; Does generic `m2` take every argument list `scanon` (the signature's parameters,
; canonical) admits, under the constraints signature `gm` states?
(defn generic-pat-admits (m2:&Method scanon:ptr np:i32 gm:&Method line:i32):bool
  (let (ntv:i32 (m2 'num-tyvars)
        pb:ptr (arena-alloc (* (as i64 (+ ntv 1)) (ptr-bytes)))
        params:ptr (node-at (m2 'body) 2)
        here:NameEnv (method-env-enter m2)
        ok:bool true)
    (dotimes (k ntv) (set! (aref (unsafe/cast &ptr pb) k) null))
    (dotimes (i np)
      (when ok
        (let (pc:?&Node (tpat-canon (binding-type-node (node-at params i)) (m2 'tyvars) ntv line))
          ; An unmodelled conformer parameter keeps the arity-only answer.
          (when (= pc null) (name-env-set here) (return true))
          (when (not (tpat-match pc (aref (unsafe/cast &ptr scanon) i) true (m2 'tyvars) ntv pb))
            (set! ok false)))))
    (name-env-set here)
    (when (not ok) (return false))
    (dotimes (ci (m2 'num-constraints))
      (let (crec:ref:Constraint (constraints-at (m2 'constraints) ci)
            uidx:i32 (tyvar-index-of (crec 'var) (m2 'tyvars) ntv)
            proto:Symbol (constraint-proto crec)
            b:?&Node (if (>= uidx 0) (aref (unsafe/cast &ptr pb) uidx) null))
        (when (and (!= b null) (!= proto "Any"))
          (let (bh:Symbol (node-head-sym b)
                bs:Symbol (canon-sym-at b 1))
            (when (and (= bh "#tv") (= (caller-has-constraint gm bs proto) 0))
              (return false))
            (when (and (= bh "#ty") (= (conformance-lookup bs proto) 0))
              (return false))))))
    (return true)))

; Does the conformer's `mname` satisfy generic signature `gm`? Its generic method
; must bind for `gm`'s abstract parameters, under constraints `gm` implies.
(defn generic-sig-satisfied (mname:Symbol gm:&Method check-ret:bool line:i32):bool
  (let (np:i32 (gm 'num-params)
        exact:bool true)
    (dotimes (i np)
      (when (= (aref (unsafe/cast &ptr (gm 'param-types)) i) null) (set! exact false)))
    (when (not exact)
      ; A parameter nesting a variable is matched pattern against pattern.
      (let (g:ptr (generic-lookup mname)
            scanon:ptr (arena-alloc (* (as i64 (+ np 1)) (ptr-bytes)))
            modelled:bool true)
        (when (= g null) (return false))
        (let (here:NameEnv (method-env-enter gm))
          (dotimes (i np)
            (let (pn:ptr:Node (node-at (node-at (gm 'body) 1) i)
                  tn:?&Node (if (= (node-kind pn) NODE-LIST)
                                (binding-type-node pn)
                                (intern-node (colon-tail (pn 's))))
                  c:?&Node (tpat-canon tn (gm 'tyvars) (gm 'num-tyvars) line))
              (when (= c null) (set! modelled false))
              (set! (aref (unsafe/cast &ptr scanon) i) (as ptr c))))
          (name-env-set here))
        (doseq (m2 (-> g (unsafe/cast &Generic _) (_ 'methods)) (VecIter &Method))
          (when (and (= (m2 'kind) METHOD-GENERIC) (= (m2 'num-params) np)
                     (or (not modelled) (generic-pat-admits m2 scanon np gm line)))
            (return true)))
        (return false)))
    (let (rt:ptr (abstract-call-via-generic mname (gm 'param-types) np gm line))
      (when (= rt null) (return false))
      (when (or (not check-ret) (= (gm 'ret-type) null)) (return true))
      (when (and (!= (is-tyvar-type rt) 0) (= (-> rt (unsafe/cast &Type _) (_ 'sdef)) null))
        (return true))
      (return (abstract-type-same rt (gm 'ret-type))))))

; Verify (when check≠0) and record that `typename` conforms to protocol
; `proto-name`, then recurse into the protocol's super-protocols (§10.3). In
; check mode every required signature (Self→typename, extra params→`pspellings`)
; must resolve to a concrete method or a satisfying built-in operator; missing
; methods are reported and the compile aborts. The conformance-lookup guard makes
; this idempotent and safe against cyclic inheritance. Import side passes
; check=0 (trust the exporter). `pspellings` carries the concrete bindings for a
; parametric protocol (null for a plain Self-only protocol).
(defn verify-conformance-params (typename:Symbol proto-name:Symbol pspellings:ptr npspellings:i32 line:i32 check:i32):void
  ; Canonicalize the subject type (bare identity) and the protocol (namespaced
  ; identity) up front, so the protocol-lookup, the conformance record, the
  ; super-edge match, and the diagnostics are all consistent even when the
  ; `extend` (or its imported replay) names a qualified `coll/Vector`/`dp/Seq`.
  ; Identity under `user` (no slash) → byte-identical.
  (set! typename (type-canon-name typename))
  (set! proto-name (protocol-canon-name proto-name))
  ; A0: when a parametric protocol is re-extended, the coherence check (and any
  ; arg-upgrade of an arg-less record) lives in `conformance-add`, so the
  ; already-recorded case must still reach it. A plain protocol carries no args
  ; (npspellings 0), so the historical early-return is preserved exactly for it —
  ; keeping the hot, byte-identical path untouched.
  (when (!= (conformance-lookup typename proto-name) 0)
    (when (> npspellings 0)
      (conformance-add typename proto-name pspellings npspellings line))
    (return))
  ; B2a: `proto-name` is canonical by now — `emit-extend` resolved the source
  ; spelling and passed the Protocol's own name down, and the super-protocol
  ; recursion below passes an edge key. Either way this is a key lookup; the
  ; scope gate already fired at the reference. The raise stays as the backstop
  ; for the import-replay path (check=0 returns instead).
  (let (proto:ptr (protocol-lookup-ns proto-name))
    (when (= proto null)
      (when (!= check 0)
        (die-at line (fstr "extend: unknown protocol '" proto-name "'")))
      (return))
    (when (!= check 0)
      (let (notes:StrView "")
        (when (= (proto-sigs-resolve proto typename pspellings line
                                     (as &StrView &notes)) 0)
          (die-at line
            (fstr "type '" (key-display typename line) "' does not conform to protocol '" proto-name "'" notes)))))
    (conformance-add typename proto-name pspellings npspellings line)
    ; Conforming to `proto-name` requires conforming to each declared super. The
    ; supers are plain (Self-only) protocols here, so they carry no extra params.
    (dotimes (si (unsafe/cast i32 (count g-proto-supers)))
      (let (e:&Conformance (invoke g-proto-supers si:usize))
        (when (= (e 'type-name) proto-name)
          (verify-conformance-params typename (e 'proto-name) null 0 line check))))))

; Self-only conformance (the historical signature): plain protocols carry no
; extra parameters, so the bindings array is null.
(defn verify-conformance (typename:Symbol proto-name:Symbol line:i32 check:i32):void
  (verify-conformance-params typename proto-name null 0 line check))

; Stage 11 T4: record a template-level conformance `(extend (Vector T) (Seq T))`.
; `template` is the extended struct template, `proto` the (parametric) protocol,
; and `bindings` the proto-application args (`T`) positionally bound to the
; protocol's extra params (`E`). Idempotent on (template, proto). The per-instance
; check is deferred to stamp time (tmpl-conformance-check-instance).
; Stage 11 assoc-types (A4): also carries the parsed trailing `:where` clause
; (tyvars/num-tyvars + the constraints Vector + num-constraints).
; A :where-free extend passes the template's own tyvars/ntv, null constraint
; arrays, and num-constraints = 0 — identical downstream behaviour to T4.
(defn tmpl-conformance-add (template:ptr proto:?&Protocol bindings:ptr nbindings:i32
                                 tyvars:ptr num-tyvars:i32
                                 constraints:?&ConstraintVec
                                 num-constraints:i32 depth:i32):void
  (doseq (c g-tmpl-conformances (VecIter &TmplConformance))
    (when (and (= (c 'template) template) (= (c 'proto) proto) (= (c 'ptr-depth) depth)) (return)))
  (let (c:&TmplConformance (new TmplConformance))
    (set! (c 'ptr-depth) depth)
    (set! (c 'template) template)
    (set! (c 'proto) proto)
    (set! (c 'bindings) bindings)
    (set! (c 'nbindings) nbindings)
    (set! (c 'tyvars) tyvars)
    (set! (c 'num-tyvars) num-tyvars)
    (set! (c 'constraints) constraints)
    (set! (c 'num-constraints) num-constraints)
    (conj g-tmpl-conformances c)))

; Check (and record) that the concrete instance named `iname`, stamped from
; struct template `st` with concrete arg spellings `arg-spellings` (length
; `nargs`, the template's tyvars in order), satisfies the parametric protocol of
; one recorded template conformance `c`. Each protocol binding node (`T` from
; `(Seq T)`) is rewritten with the conformance's tyvars → concrete spellings, then
; parsed and canonicalized to its concrete spelling (`i32`), giving the protocol's
; extra-param bindings. verify-conformance-params then checks every required
; method resolves for `iname`, recording the concrete conformance so a Seq-bounded
; generic call over `Vector.i32` finds it through the ordinary conformance lookup.
;
; Stage 11 assoc-types (A4.2): a `:where`-bearing extend
; `(extend (MapIter I F) (Iterator E) :where ((Iterator S) I) ((UnaryFn S E) F))`
; names a protocol-application arg (`E`) that is neither a template parameter nor
; concrete — it is recovered from this instance's own conformances (`F`'s
; `(UnaryFn S E)`). For such a conformance (num-constraints > 0) the binding map is
; built in two stages: the template tyvars are seeded with the instance's stamp arg
; spellings (`I → "IntRangeIter"`, `F → "SqFn"`), then recover-assoc-into runs the
; A2 fixpoint to fill the associated tyvars (`S`, `E`). The full map is substituted
; into `(Iterator E)`, then verified and recorded as for the concrete-arg path. The
; recovery reads the conformances of the stamp args, which must already be recorded;
; if a conforming variable's conformance is not yet present (recover-assoc-into
; returns a soft 0), the check is *deferred* rather than erroring — the bottom-up
; stamping order (and the post-extend recheck, §4.5) records it on a later pass.
; Stage 15 B3′a: a per-instance template conformance check is a SYNTHESIS region —
; every type spelling it parses is a `type-spelling` of an already-parsed Type (the
; stamp's arg spellings, the recovered associated tyvars), substituted into the
; `extend`'s binding nodes. It runs at STAMP time, in whatever file first named the
; instance, which is routinely not the file that wrote the `extend`. Without the arm
; a namespaced stamp argument — `(Vector (ref gx/Pt))` — re-resolves `gg/Pt` as a
; reference in the stamping file and is refused, i.e. no namespaced type could be a
; type argument to any template carrying a parametric-protocol `extend`. See
; `g-type-key-ok` (src/nucleusc.nuc).
(defn tmpl-conformance-check-one (c:?&TmplConformance st:ptr iname:Symbol arg-spellings:ptr nargs:i32 line:i32):void
  (let (saved:i32 g-type-key-ok)
    (set! g-type-key-ok 1)
    (tmpl-conformance-check-one-in c st iname arg-spellings nargs line)
    (set! g-type-key-ok saved)))

(defn tmpl-conformance-check-one-in (c:?&TmplConformance st:ptr iname:Symbol arg-spellings:ptr nargs:i32 line:i32):void
  (let (cc:ptr:TmplConformance c
        proto:ptr:Protocol (cc 'proto)
        nb:i32 (cc 'nbindings)
        pspellings:ptr null
        ; The tyvar-name array and the concrete spellings used to substitute the
        ; protocol binding nodes. For a :where-free extend these are the template's
        ; own tyvars and the instance's stamp arg spellings (the unchanged T4 path).
        ; For a :where-bearing extend (set below) they are the conformance's full
        ; tyvar set (template + associated) and the recovered spellings.
        ; The subject's own argument names, not the template's (`(extend (Wrap X) …)`).
        subst-tyvars:ptr (cc 'tyvars)
        subst-spellings:ptr arg-spellings
        subst-ntv:i32 nargs)
    ; Stage 11 assoc-types (A4.2): recover the associated tyvars at stamp time.
    (when (> (cc 'num-constraints) 0)
      (let (ntv:i32 (cc 'num-tyvars)
            ; out-bound[tyvar-index] = Type* (or null), the same representation
            ; recover-assoc-into / generic-method-bind use at dispatch time.
            out-bound:ptr (arena-alloc (* (if (> ntv 0) ntv 1) (ptr-bytes)))
            spellings:ptr (arena-alloc (* (if (> ntv 0) ntv 1) (ptr-bytes))))
        ; Seed: every tyvar starts unbound; the first `nargs` entries of the
        ; conformance's tyvar array are the template's own tyvars (seeded by
        ; emit-extend in template order, hence aligned with `arg-spellings`).
        (dotimes (k ntv) (set! (aref (unsafe/cast &ptr out-bound) k) null))
        (dotimes (si nargs)
          (set! (aref (unsafe/cast &ptr out-bound) si) (conf-arg-to-type (aref (unsafe/cast &Symbol arg-spellings) si) line)))
        ; Run the A2 fixpoint over the conformance's :where clause. A soft 0 means
        ; a conforming variable's conformance is not yet recorded for this instance
        ; — defer (a later pass / recheck-stamped will catch it), do not error.
        (when (= (recover-assoc-into (cc 'tyvars) out-bound ntv
                                     (cc 'constraints)
                                     (cc 'num-constraints) line false) 0)
          (tmpl-check-defer c st iname arg-spellings nargs line)
          (return))
        ; recover-assoc-into fills the associated tyvars; the full map must now be
        ; total over the conformance's tyvars (the determination fixpoint in
        ; emit-extend guaranteed every protocol-app tyvar is reachable). Any still-
        ; unbound entry means a constraint never fired — also a deferral.
        (dotimes (bk ntv)
          (when (= (aref (unsafe/cast &ptr out-bound) bk) null)
            (tmpl-check-defer c st iname arg-spellings nargs line)
            (return))
          (set! (aref (unsafe/cast &Symbol spellings) bk) (type-spelling (aref (unsafe/cast &ptr out-bound) bk))))
        ; A plain constraint is the extend's condition: an instance that fails it
        ; is not a conformer, and is retried if the conformance arrives later.
        (when (not (tmpl-plain-constraints-hold? cc out-bound line))
          (tmpl-check-defer c st iname arg-spellings nargs line)
          (return))
        (set! subst-tyvars (cc 'tyvars))
        (set! subst-spellings spellings)
        (set! subst-ntv ntv)))
    (when (> nb 0)
      (set! pspellings (arena-alloc (* nb (ptr-bytes))))
      (dotimes (i nb)
        (let (bnode:ptr (aref (unsafe/cast &ptr (cc 'bindings)) i)
              ; Substitute the conformance's tyvars with the concrete spellings
              ; (template args for T4, recovered args for A4.2) in this binding
              ; node, then parse + canonicalize.
              sub:ptr (subst-tyvars-node bnode subst-tyvars subst-spellings subst-ntv)
              bt:ptr (parse-type-from-node sub line))
          (set! (aref (unsafe/cast &Symbol pspellings) i) (type-spelling bt)))))
    ; A0: `pspellings` holds the *substituted concrete* protocol args for this
    ; instance (`T` → i32, or a recovered `E` → i32), so the per-instance
    ; conformance retains them.
    (verify-conformance-params (ptr-key iname (cc 'ptr-depth)) (proto 'name)
                               pspellings nb line 1)))

(defn tmpl-plain-constraints-hold? (c:ptr:TmplConformance bound:ptr line:i32):bool
  (dotimes (i (c 'num-constraints))
    (let (crec:ref:Constraint (constraints-at (c 'constraints) i)
          proto:Symbol (constraint-proto crec)
          idx:i32 (tyvar-index-of (crec 'var) (c 'tyvars) (c 'num-tyvars)))
      (when (and (= (crec 'nargs) 0) (>= idx 0))
        (let (bt:ptr (aref (unsafe/cast &ptr bound) idx))
          (when (and (!= bt null)
                     (= (blanket-conforms bt proto) 0)
                     (!= proto "Valid")
                     (= (conformance-lookup (type-spelling bt) proto) 0)
                     (= (derive-closure-conformance bt proto line) 0))
            (return false))))))
  (return true))

(defn tmpl-check-defer (c:?&TmplConformance st:ptr iname:Symbol args:ptr nargs:i32 line:i32):void
  (let (p:&PendingTmplCheck (new PendingTmplCheck))
    (set! (p 'c) c)
    (set! (p 'st) st)
    (set! (p 'iname) iname)
    (set! (p 'args) args)
    (set! (p 'nargs) nargs)
    (set! (p 'line) line)
    (conj g-pending-tmpl-checks p)))

; A conformance just arrived: retry every instance check that waited on one. The
; queue is swapped out first, so a check that still waits re-queues itself.
(defn tmpl-retry-pending ():void
  (when (= (count g-pending-tmpl-checks) 0) (return))
  (let (todo:&(Vector &PendingTmplCheck) g-pending-tmpl-checks
        fresh:&(Vector &PendingTmplCheck) (vector-new-in &g-arena-alloc))
    (set! g-pending-tmpl-checks fresh)
    (doseq (p todo (VecIter &PendingTmplCheck))
      (tmpl-conformance-check-one (p 'c) (p 'st) (p 'iname) (p 'args) (p 'nargs) (p 'line)))))

; Every variable a :where-free template extend's protocol argument names is one
; of the subject's; any other would be read as a type only at the first stamp.
(defn extend-arg-determined (arg:?&Node proto:Symbol sargs:ptr n:i32 line:i32):void
  (let (tv:ptr (arena-alloc (* (as i64 (+ (count-pattern-nodes arg) 1)) (ptr-bytes)))
        ntv:i32 0)
    (collect-constraint-arg-tyvars arg proto tv (as &i32 &ntv))
    (dotimes (i ntv)
      (when (< (tyvar-index-of (aref (unsafe/cast &Symbol tv) i) sargs n) 0)
        (die-at line
          (fstr "extend: protocol parameter '" (aref (unsafe/cast &Symbol tv) i)
                "' is not determined by the subject or any :where constraint"))))))

; The dispatch key of `depth` pointers to `key`, as `type-spelling` writes it.
(defn ptr-key (key:Symbol depth:i32):Symbol
  (when (<= depth 0) (return key))
  (return (ptr-key (symbol-intern (fstr "ref:" key)) (- depth 1))))

; A template subject names every instance: one distinct type variable per
; template parameter (`(Wrap X)`), which the extend's other clauses then name.
(defn extend-subject-tyvar-args (app:?&Node ntv:i32 definer:StrView line:i32):ptr
  (let (out:ptr (arena-alloc (* (as i64 (if (> ntv 0) ntv 1)) (ptr-bytes)))
        head:Symbol (node-head-sym app))
    (when (!= (- (node-len app) 1) ntv)
      (die-at line (fstr head ": wrong number of type arguments for " definer " template ("
                         (- (node-len app) 1) " given)")))
    (dotimes (i ntv)
      (let (a:ptr:Node (node-at app (+ i 1)))
        (when (or (!= (node-kind a) NODE-SYM) (symbol-contains-byte (a 's) 58)
                  (!= (tyname-resolvable (a 's)) 0)
                  (>= (tyvar-index-of (a 's) out i) 0))
          (let (s:String (node-str app))
            (die-at line
              (fstr "extend: a template subject's arguments must be distinct type variables, one per parameter of '"
                    head "' -- " (string-as-view &s) " names only some of its instances"))))
        (set! (aref (unsafe/cast &Symbol out) i) (a 's))))
    (return out)))

; Stamp-time hook: a concrete instance `iname` was just stamped from template
; `st` (arg spellings `arg-spellings`, length `nargs`). Check every template-level
; conformance recorded for `st`, recording the concrete per-instance conformance
; (and erroring, naming the missing method, if a required method does not resolve).
(defn tmpl-conformance-check-instance (st:ptr iname:Symbol arg-spellings:ptr nargs:i32 line:i32):void
  (dotimes (i (unsafe/cast i32 (count g-tmpl-conformances)))
    (let (c:&TmplConformance (as &TmplConformance
                                  (invoke g-tmpl-conformances i:usize)))
      (when (= (c 'template) st)
        (tmpl-conformance-check-one c st iname arg-spellings nargs line)))))

(defn origin-arg-spellings (args:ptr n:i32):ptr
  (let (out:ptr (arena-alloc (* (as i64 (if (> n 0) n 1)) (ptr-bytes))))
    (dotimes (k n)
      (set! (aref (unsafe/cast &Symbol out) k) (type-spelling (aref (unsafe/cast &ptr args) k))))
    (return out)))

; A niche instance is a bare pointer, so its dispatch key is the pointer's own:
; a template conformance leaves it out rather than conform every `&T`.
(defn union-instance-keyed? (u:&UnionDef):bool
  (return (and (!= (u 'layout) LAYOUT-NICHE-MAYBE) (!= (u 'layout) LAYOUT-NICHE-ERRPTR))))

; The stamp-time hook's union twin, called from the union stamp.
(defn tmpl-conformance-check-union (ut:ptr ud:&UnionDef line:i32):void
  (when (not (union-instance-keyed? ud)) (return))
  (dotimes (i (unsafe/cast i32 (count g-tmpl-conformances)))
    (let (c:&TmplConformance (as &TmplConformance (invoke g-tmpl-conformances i:usize)))
      (when (= (c 'template) ut)
        (tmpl-conformance-check-one c ut (type-spelling (union-instance-type ud))
                                    (origin-arg-spellings (ud 'origin-args) (ud 'origin-nargs))
                                    (ud 'origin-nargs) line)))))

; Retroactively check a newly-recorded template conformance against every
; instance of the template already stamped before the `extend` was processed
; (a `(Vector i32)` use earlier in the file may stamp the instance before the
; `extend` form is reached). Recovers each instance's (template, args) from its
; StructDef origin fields (T2) and runs the per-instance check.
(defn tmpl-conformance-recheck-stamped (c:?&TmplConformance st:ptr line:i32):void
  (doseq (u g-uniondefs (VecIter &UnionDef))
    (when (and (= (as ptr (u 'origin-template)) st) (union-instance-keyed? u))
      (tmpl-conformance-check-one c st (type-spelling (union-instance-type u))
                                  (origin-arg-spellings (u 'origin-args) (u 'origin-nargs))
                                  (u 'origin-nargs) line)))
  (dotimes (i (unsafe/cast i32 (count g-structs)))
    (let (sd:&StructDef (as &StructDef (invoke g-structs i:usize)))
      (when (= (sd 'origin-template) st)
        (let (na:i32 (sd 'origin-nargs)
              spell:ptr null)
          (when (> na 0)
            (set! spell (arena-alloc (* na (ptr-bytes))))
            (dotimes (k na)
              (set! (aref (unsafe/cast &Symbol spell) k) (type-spelling (aref (unsafe/cast &ptr (sd 'origin-args)) k)))))
          (tmpl-conformance-check-one c st (sd 'name) spell na line))))))

; (extend Subject Protocol): post-prescan conformance check (§9.2/§10.3). When
; Subject is a *protocol*, this declares protocol inheritance (Subject requires
; Protocol). Otherwise Subject is a type whose conformance is verified and
; recorded, recursing into the protocol's supers.
; The protocol name carried by an `extend` protocol position, which is either a
; bare symbol `Seq` or a parametric application `(Seq T...)`. Returns the name and
; writes the application's arg nodes + count through `out-args`/`out-nargs`.
(defn extend-proto-name (proto-node:&Node out-args:&ptr out-nargs:&i32 line:i32):Symbol
  ; W9 item 45: `()` in the protocol position is a NULL node (W5f). It is no more
  ; a protocol than `5` is, so it gets the same message as `5` — from the
  ; caller's line, since there is no node to blame, and through the guard the
  ; header validation shares.
  (require-extend-protocol proto-node line)
  (let (pn:&Node proto-node)
    (case (pn 'kind)
      NODE-SYM
        (do
          (set! @out-args null)
          (set! (aref out-nargs 0) 0)
          (return (pn 's)))
      NODE-LIST
        (let (head:&Node (unsafe/cast &Node (node-at pn 0)))
          (when (!= (node-kind (as ptr head)) NODE-SYM)
            (die-at (pn 'line) "extend: protocol name must be a symbol"))
          (let (na:i32 (- (node-len pn) 1)
                args:ptr null)
            (when (> na 0)
              (set! args (arena-alloc (* na (ptr-bytes))))
              (dotimes (i na)
                (set! (aref (unsafe/cast &ptr args) i) (node-at pn (+ i 1)))))
            (set! @out-args args)
            (set! (aref out-nargs 0) na)
            (return (head 's))))
      0)
    (die-at (pn 'line) "extend: protocol must be a symbol or (Protocol args...)")
    (return null)))

; The struct- or union-template application under a subject's pointer wrappers and
; parametric aliases, or null; `depth` counts the pointers peeled.
(defn extend-subject-template-app (n:?&Node line:i32 depth:&i32):?&Node
  (let (cur:?&Node n
        steps:i32 0)
    (while (< steps MAX-TYPE-ALIAS-DEPTH)
      (when (or (!= (as ptr (node-template-of cur)) null)
                (!= (as ptr (node-union-template-of cur)) null))
        (return cur))
      (cond
        (!= (node-is-ptr-wrapper cur) 0)
        (do (set! cur (wrapper-inner-pattern cur))
            (set! @depth (+ @depth 1)))
        (!= (as ptr (type-alias-app-of cur)) null)
        (set! cur (type-alias-apply cur (node-line (as ptr cur) line)))
        true
        (return null))
      (inc! steps))
    (return null)))

; Does a template application under the subject's wrappers mention a tyvar?
(defn extend-subject-over-tyvars (n:&Node line:i32):bool
  (let (depth:i32 0
        app:?&Node (extend-subject-template-app n line &depth))
    (when (= app null)
      ; A parametric alias over a variable is a template subject, if an unsupported one.
      (when (!= (as ptr (type-alias-app-of n)) null)
        (dotimes (i (- (node-len n) 1))
          (let (a:ptr:Node (node-at n (+ i 1)))
            (when (and (= (node-kind a) NODE-SYM) (not (symbol-contains-byte (a 's) 58))
                       (= (tyname-resolvable (a 's)) 0))
              (return true)))))
      (return false))
    ; Argument by argument: the pattern walk reads `(Maybe X)` as the sigil `?X`.
    (let (tv:ptr (arena-alloc (* (as i64 (+ (count-pattern-nodes app) 1)) (ptr-bytes)))
          ntv:i32 0
          head:Symbol (node-head-sym app))
      (dotimes (i (- (node-len (as ptr app)) 1))
        (collect-tyvars-at (node-at (as ptr app) (+ i 1)) head line tv (as &i32 &ntv)))
      (return (> ntv 0)))))

; An alias or C typedef is not a new type, and an application over concrete types
; is one instance: each is keyed as the type it parses to (docs/generics.md).
(defn extend-subject-typed (n:&Node line:i32):bool
  (when (and (= (node-kind n) NODE-LIST) (extend-subject-over-tyvars n line)) (return false))
  (let (run:StrView "")
    (when (!= (sigil-split n line &run) null) (return true)))
  (case (node-kind n)
    NODE-SYM
      (let (s:Symbol (n 's))
        (when (symbol-contains-byte s 58) (return true))
        (when (!= (as ptr (struct-lookup-ref s)) null) (return false))
        (return (or (!= (as ptr (type-alias-lookup-ref s)) null)
                    (!= (as ptr (c-typedef-find s)) null))))
    NODE-LIST
      (let (head:?&Node (node-first n))
        (when (or (= head null) (!= (head 'kind) NODE-SYM)) (return false))
        (when (or (= (head 's) "ptr") (!= (pointer-kind-named (head 's)) 0)) (return true))
        (when (and (= (as ptr (node-template-of n)) null)
                   (= (as ptr (node-union-template-of n)) null)
                   (= (as ptr (type-alias-lookup-ref (head 's))) null))
          (return false))
        (let (tv:ptr (arena-alloc (* (as i64 (count-pattern-nodes n)) (ptr-bytes)))
              ntv:i32 0)
          (collect-pattern-tyvars n tv (as &i32 &ntv))
          (return (= ntv 0))))
    0)
  (return false))

; Dispatch keys by `type-spelling`, which erases the pointer kind and sees through
; an alias: `&T` is `ptr:T`, `Money` is `i32`, `Vector:i32` is `Vector.i32`.
(defn extend-subject-key (n:&Node line:i32):Symbol
  (return (type-spelling (parse-type-from-node (as ptr n) (node-line n line)))))

(defn emit-extend (form:?&Node):void
  (let (ff:ptr:Node form)
    (require-extend-form (as ptr form))
    (let (type-node:&Node (unsafe/cast &Node (node-at form 1))
          proto-node:&Node (unsafe/cast &Node (node-at form 2))
          proto-args:ptr null
          proto-nargs:i32 0
          ; The protocol may be written qualified (`dpx/Describe`, through an
          ; import prefix) or bare from inside its own namespace. Stage 15 B2a:
          ; resolve the REFERENCE exactly once, here, where the source spelling
          ; and the file's import environment are both in hand — and then carry
          ; the resolved record downward. Everything below wants the protocol's
          ; canonical registry identity (W9 defect 21 — a protocol is NOT
          ; stripped), and re-deriving it by looking the spelling up a second time
          ; is what would ask the scope question twice and get two answers.
          ; Identity under `user`.
          proto-spelling:Symbol (extend-proto-name proto-node
                                                 (as &ptr &proto-args)
                                                 (as &i32 &proto-nargs)
                                                 (node-line (as ptr proto-node) (ff 'line)))
          proto-rec:?&Protocol (protocol-lookup proto-spelling)
          ; Unresolved names pass through as written: a blanket protocol
          ; (`Any`/`Struct`), `Valid`, and the spelling a diagnostic must quote.
          proto-name:Symbol (if (= proto-rec null)
                            proto-spelling
                            (-> proto-rec (as &Protocol _) (_ 'name)))
          typed:bool (extend-subject-typed type-node (ff 'line)))
      ; Stage 11 T4: the subject is a struct *template* `(extend (Vector T) (Seq T))`.
      ; Record a template-level conformance; the per-instance check fires at stamp
      ; time, and any already-stamped instance is rechecked now.
      ; W9 item 45: `node-kind` — a subject spelled `()` is a NULL node, and takes
      ; the non-template path below, where `parse-type-from-node` reports that it
      ; names no type.
      (when (not typed)
        (case (node-kind (as ptr type-node))
          NODE-LIST
          (let (thead:&Node (unsafe/cast &Node (node-at (as ptr type-node) 0))
                sline:i32 (node-line (as ptr type-node) (ff 'line))
                depth:i32 0)
            (when (!= (node-kind (as ptr thead)) NODE-SYM)
              (die-at sline "extend: template subject name must be a symbol"))
            ; Stage 12 N4: a qualified template head (`coll/Vector`) resolves to the
            ; bare-keyed template registry. Identity under `user`.
            (let (app:?&Node (extend-subject-template-app (as ?&Node type-node) sline &depth)
                  st:ptr (if (= app null) null (as ptr (node-template-of app)))
                  ut:ptr (if (= app null) null (as ptr (node-union-template-of app))))
              (when (and (= st null) (= ut null))
                (die-at sline
                  (fstr "extend: '" (thead 's) "' is not a struct or union template")))
              (let (proto:?&Protocol proto-rec
                    tmpl:ptr (if (!= st null) st ut)
                    base-ntv:i32 (if (!= st null) ((unsafe/cast &StructTemplate st) 'ntv) ((unsafe/cast &UnionTemplate ut) 'ntv))
                    sargs:ptr (extend-subject-tyvar-args app base-ntv (if (!= st null) "defstruct" "defunion") sline))
                (when (= proto null)
                  (die-at (node-line (as ptr proto-node) (ff 'line))
                    (protocol-ref-message
                      (fstr "extend: unknown protocol '" proto-spelling "'")
                      proto-spelling)))
                ; The protocol application must supply exactly the protocol's extra
                ; params, each bound positionally to one of the template's tyvars.
                (when (!= proto-nargs (-> proto (unsafe/cast &Protocol _) (_ 'num-params)))
                  (die-at (node-line (as ptr proto-node) (ff 'line))
                    (fstr "extend: protocol '" proto-name
                          "' expects a different number of parameters")))
                ; Stage 11 assoc-types (A4.1): parse a trailing `:where` clause, if
                ; present, into the conformance's constraint arrays and run the
                ; determination fixpoint (assoc-types-extend.md §3). The clause is
                ; spelled identically to a defn's :where and parsed by the shared
                ; parse-where-constraints (A4.0). `form` is `(extend Subject (Proto
                ; Arg…) :where C…)`: node 0 = `extend`, 1 = subject, 2 = proto app,
                ; 3 = `:where` marker, 4… = constraints. A :where-free extend
                ; (node-len <= 3) keeps num-constraints = 0 and behaves exactly as T4.
                (let (nc:i32 0
                      where-i:i32 -1)
                  ; Detect the trailing :where marker at node 3.
                  (when (> (node-len form) 3)
                    (let (m:&Node (unsafe/cast &Node (node-at form 3)))
                      ; An extend form is not desugared — its own chokepoint.
                      (reject-legacy-marker m (ff 'line))
                      (when (!= (marker-named m "where") 0)
                        (set! where-i 3)
                        (set! nc (- (node-len form) 4)))))
                  (when (and (>= where-i 0) (< nc 1))
                    (die-at (ff 'line) "extend: :where requires at least one (Protocol Var) constraint"))
                  (if (= nc 0)
                    ; --- :where-free extend: the unchanged T4 path ---
                    (do
                      (dotimes (pci proto-nargs)
                        (extend-arg-determined (aref (unsafe/cast &ptr proto-args) pci) proto-spelling
                                               sargs base-ntv (node-line (as ptr proto-node) (ff 'line))))
                      (tmpl-conformance-add tmpl (as ptr proto) proto-args proto-nargs
                                            sargs base-ntv null 0 depth))
                    ; --- :where-bearing extend: parse + determine (A4.1) ---
                    (do
                      ; Capacity: the template's own tyvars seed the array; each
                      ; constraint may introduce more (its conforming var + arg
                      ; tyvars), and the protocol application `(Iterator E)` may name
                      ; a tyvar (E) bound only by the :where clause. Size the
                      ; additional slots by the node-walk of each constraint's
                      ; element 0 plus each protocol-application arg — never less
                      ; than the collectible tyvar count — mirroring
                      ; register-generic-defn's bound.
                      (let (slot-bound:i32 base-ntv)
                        (dotimes (sb-c nc)
                          (set! slot-bound (+ slot-bound
                                              (count-pattern-nodes
                                                (node-at (node-at form (+ 4 sb-c)) 0)))))
                        (dotimes (sb-p proto-nargs)
                          (set! slot-bound (+ slot-bound
                                              (count-pattern-nodes
                                                (aref (unsafe/cast &ptr proto-args) sb-p)))))
                        (let (cap:i32 (if (> slot-bound 0) slot-bound 1)
                              constraints:ref:ConstraintVec (vector-new-in &g-arena-alloc)
                              tyvars:ptr     (arena-alloc (* (as i64 cap) (ptr-bytes)))
                              ntv:i32 0)
                          ; Seed the tyvars array with the template's own tyvars; they
                          ; are the instance's stamp arguments, hence always determined.
                          (dotimes (si base-ntv)
                            (set! (aref (unsafe/cast &Symbol tyvars) si) (aref (unsafe/cast &Symbol sargs) si)))
                          (set! ntv base-ntv)
                          ; Parse the :where constraints (constraints start at node 4),
                          ; collecting constraint vars + Arg tyvars after the seeds.
                          (parse-where-constraints form 4 nc
                                                   constraints
                                                   tyvars (as &i32 &ntv) (ff 'line))
                          ; Collect tyvars appearing in the protocol application
                          ; `(Iterator E)` too, so the §3 determination check can see
                          ; an E that no :where constraint introduces. A concrete arg
                          ; (`i32`) or a template tyvar (already seeded) is skipped;
                          ; only a fresh bare tyvar (`E`) is added — initially
                          ; undetermined, so it must be reached by the fixpoint.
                          (dotimes (pci proto-nargs)
                            (collect-constraint-arg-tyvars (aref (unsafe/cast &ptr proto-args) pci)
                                                           proto-spelling tyvars (as &i32 &ntv)))
                          ; Determination fixpoint (§3): seed = template tyvars (the
                          ; first base-ntv entries); step = for each constraint whose
                          ; conforming var V is determined, every tyvar appearing in an
                          ; Arg position becomes determined; repeat to fixpoint.
                          (let (determined:ptr (arena-alloc (* (if (> ntv 0) ntv 1) 4)))
                            (dotimes (di ntv)
                              (set! (aref (unsafe/cast &i32 determined) di) (if (< di base-ntv) 1 0)))
                            (let (changed:i32 1)
                              (while (!= changed 0)
                                (set! changed 0)
                                (let (ck:i32 0)
                                  (while (< ck nc)
                                    (let (crec:ref:Constraint (invoke constraints ck:usize)
                                          vidx:i32 (tyvar-index-of (crec 'var) tyvars ntv)
                                          na:i32 (crec 'nargs))
                                      (when (and (>= vidx 0)
                                                 (and (!= (aref (unsafe/cast &i32 determined) vidx) 0) (> na 0)))
                                        (let (argv:ptr (crec 'args)
                                              ai:i32 0)
                                          (while (< ai na)
                                            (let (argn:ptr (aref (unsafe/cast &ptr argv) ai)
                                                  ti2:i32 0)
                                              (while (< ti2 ntv)
                                                (when (and (= (aref (unsafe/cast &i32 determined) ti2) 0)
                                                           (!= (node-mentions-tyvar-named argn (aref (unsafe/cast &Symbol tyvars) ti2)) 0))
                                                  (set! (aref (unsafe/cast &i32 determined) ti2) 1)
                                                  (set! changed 1))
                                                (inc! ti2)))
                                            (inc! ai)))))
                                    (inc! ck)))))
                            ; Every tyvar mentioned in the protocol application
                            ; `(Iterator E)` must be determined after convergence.
                            (dotimes (pai proto-nargs)
                              (let (argn:ptr (aref (unsafe/cast &ptr proto-args) pai))
                                (dotimes (ti ntv)
                                  (when (and (= (aref (unsafe/cast &i32 determined) ti) 0)
                                             (!= (node-mentions-tyvar-named argn (aref (unsafe/cast &Symbol tyvars) ti)) 0))
                                    (die-at (node-line (as ptr proto-node) (ff 'line))
                                      (fstr "extend: protocol parameter '"
                                            (aref (unsafe/cast &Symbol tyvars) ti)
                                            "' is not determined by the subject or any :where constraint")))))))
                          (tmpl-conformance-add tmpl (as ptr proto) proto-args proto-nargs
                                                tyvars ntv constraints nc depth))))))
                ; Retroactively check instances stamped before this extend was seen.
                ; The just-added conformance is the last element of g-tmpl-conformances.
                (let (ntc:i32 (unsafe/cast i32 (count g-tmpl-conformances))
                      c:&TmplConformance (as &TmplConformance
                                              (invoke g-tmpl-conformances (as usize (- ntc 1)))))
                  (tmpl-conformance-recheck-stamped (as ptr c) tmpl (ff 'line)))
                (return))))
        0)
        ; --- subject is a concrete type (symbol) ---
        (require-extend-subject type-node (ff 'line)))
      ; The subject may be written qualified (`coll/Vector`) from another
      ; namespace; canonicalize it to the bare TYPE identity so every lookup
      ; below — and the recorded conformance — matches the dispatch site.
      ; `proto-name` was already canonicalized as a PROTOCOL above; the two
      ; canonicalizers are deliberately different (Stage 15 W9 defect 21).
      ; Identity under `user` (no slash).
      (let (typename:Symbol (if typed (symbol-none) (type-canon-name (type-node 's)))
            ; The subject of a protocol-INHERITANCE extend is itself a protocol
            ; name, so it resolves through the protocol registry (namespaced),
            ; not through `typename` (the type canonicalization). Resolving the
            ; raw spelling is what makes `(extend dp/Describe dp/Show)` — and
            ; the bare-inside-`(ns dp)` spelling of the same edge — work.
            subj-proto:?&Protocol (if typed null (protocol-lookup (type-node 's))))
        ; Protocol-on-protocol: declare inheritance, no per-type check. Only the
        ; bare-symbol protocol form participates in inheritance.
        (when (and (!= subj-proto null) (= proto-nargs 0))
          (when (= proto-rec null)
            (die-at (node-line (as ptr proto-node) (ff 'line))
              (protocol-ref-message
                (fstr "extend: '" (display-key (-> subj-proto (as &Protocol _) (_ 'name)))
                      "' is a protocol, so its supertype '" proto-spelling
                      "' must be a protocol too")
                proto-spelling)))
          (proto-super-add (-> subj-proto (as &Protocol _) (_ 'name)) proto-name)
          (return))
        ; Extending to a blanket protocol (Any/Struct) is redundant — conformance
        ; is automatic and structural — so accept it as a no-op.
        (when (and (!= (blanket-lookup proto-name) 0) (= proto-nargs 0)) (return))
        (let (proto:?&Protocol proto-rec)
          (when (= proto null)
            (die-at (node-line (as ptr proto-node) (ff 'line))
              (protocol-ref-message
                (fstr "extend: unknown protocol '" proto-spelling "'")
                proto-spelling)))
          ; Validate single-token subject types eagerly for a clean diagnostic.
          ; Stage 15 B3′a: on the SPELLING the author wrote, never on `typename` —
          ; `type-canon-name` has already resolved the reference, and re-parsing its
          ; canonical output asks the scope question a second time in a file that
          ; usually cannot name the defining namespace (§9.2's "resolve once, at the
          ; reference, then carry the record"). `(extend gx/Pt P)` canonicalizes to
          ; `gg/Pt` and was then refused as an unknown type.
          (if typed
            (set! typename (extend-subject-key type-node (ff 'line)))
            (when (= (symbol-contains-byte (type-node 's) 58) false)
              (parse-type-name (type-node 's) (node-line (as ptr type-node) (ff 'line)))))
          (when (!= proto-nargs (-> proto (unsafe/cast &Protocol _) (_ 'num-params)))
            (die-at (node-line (as ptr proto-node) (ff 'line))
              (fstr "extend: protocol '" proto-name "' expects a different number of parameters")))
          ; Concrete protocol params (`(Seq i32)`): canonicalize each arg's spelling.
          (let (pspellings:ptr null)
            (when (> proto-nargs 0)
              (set! pspellings (arena-alloc (* proto-nargs (ptr-bytes))))
              (dotimes (i proto-nargs)
                (set! (aref (unsafe/cast &Symbol pspellings) i) (type-spelling (parse-type-from-node
                                        (aref (unsafe/cast &ptr proto-args) i)
                                        (node-line (as ptr proto-node) (ff 'line)))))))
            (verify-conformance-params typename proto-name pspellings proto-nargs (ff 'line) 1)))))))

; Import side: trust the exporting unit's check; record the fact (and recurse
; supers), or re-register a protocol-inheritance edge.
; A0: an imported `extend` may name a *parametric* protocol application
; `(extend IntRangeIter (Iterator i32))`. The historical guard required both
; positions to be bare symbols, silently dropping every parametric conformance on
; import. Now the protocol position is parsed with `extend-proto-name` and its
; concrete args are canonicalized and retained (rule (a), §4.5) so an
; associated-type bound (A2) on an imported type recovers them. The exporter
; already verified the methods, so we pass check=0 (trust) and only record.
; A template-subject extend (`(extend (Vector T) (Seq T))`, or A4.3's
; `:where`-bearing `(extend (MapIter I F) (Iterator E) :where …)`) re-registers
; the `TmplConformance` in the importing unit by replaying the *same*
; `emit-extend` template branch the defining unit ran (assoc-types-extend.md §10).
; That branch parses any trailing `:where`, runs the determination fixpoint, and
; records the `TmplConformance` (with its constraint clause); the per-instance
; `Conformance` — with the recovered associated args — is then produced at stamp
; time when the importing unit stamps a concrete instance (A4.2's stamp-time
; recovery). It emits no IR (template subjects define no type), so it is safe on
; the import path. The exporter cannot serialize per-instance recovered args for
; instances it never stamped; re-running recovery in the importer closes that gap.
(defn register-imported-conformance (form:ptr:Node):void
  (when (>= (node-len form) 3)
    (let (type-node:&Node (unsafe/cast &Node (node-at form 1))
          proto-node:&Node (unsafe/cast &Node (node-at form 2))
          typed:bool (extend-subject-typed type-node (form 'line)))
      ; Template subject: delegate to emit-extend (registers the
      ; TmplConformance + :where clause; recovery fires at stamp time here).
      (when (and (not typed) (= (type-node 'kind) NODE-LIST))
        (emit-extend form)
        (return))
      (when (or typed (= (type-node 'kind) NODE-SYM))
        (let (proto-args:ptr null
              proto-nargs:i32 0
              proto-name:Symbol (extend-proto-name proto-node
                                                (as &ptr &proto-args)
                                                (as &i32 &proto-nargs)
                                                (form 'line)))
          ; A protocol-on-protocol inheritance edge keeps its plain-symbol shape.
          ; B2a: a `.nuch` replay carries canonical names written by the
          ; exporting unit, not spellings this file could name — key lookup.
          (if (and (not typed) (!= (protocol-lookup-ns (type-node 's)) null) (= proto-nargs 0))
            (proto-super-add (type-node 's) proto-name)
            (let (pspellings:ptr null)
              (when (> proto-nargs 0)
                (set! pspellings (arena-alloc (* proto-nargs (ptr-bytes))))
                (dotimes (i proto-nargs)
                  (set! (aref (unsafe/cast &Symbol pspellings) i) (type-spelling (parse-type-from-node
                                          (aref (unsafe/cast &ptr proto-args) i)
                                          (form 'line))))))
              (verify-conformance-params (if typed
                                           (extend-subject-key type-node (form 'line))
                                           (type-node 's))
                                         proto-name pspellings proto-nargs
                                         (form 'line) 0))))))))

; ############################################################
; node-type: non-emitting expression typing (Stage 9 rung 3) —
; appended in N8. Co-located here (not its own file) because node-type and
; the generics machinery are mutually recursive: node-type resolves generic-
; lookup/generic-find-method-exact/generic-has-receiver-method, while the
; generic-body checkers (gcheck, valid-walk) call node-type/node-type-call/
; node-type-sym to type concrete subexpressions. A single import-use registers
; both halves before either body emits, breaking the cross-file edge.
; ############################################################
; ============================================================
; node-type: non-emitting expression typing (Stage 9 rung 3)
; ============================================================
; node-type(n, scope) computes the Type an expression contributes to its parent
; WITHOUT emitting IR. emit-node sets the type it propagates from this function,
; so the type pass and codegen share one rule per node kind and cannot drift —
; any divergence corrupts the self-hosting bootstrap and is caught immediately.
;
; It is total over the language's value forms. The few forms whose emit-time
; type depends on control-flow/expansion that can't be reproduced purely (`cond`
; phi typing, `quasiquote` of a bare unquote, macro calls) return null, meaning
; "not modeled — keep the emit-computed type"; callers treat null as unknown.
; node-type never emits and never aborts: ambiguous lookups yield null.

; Stage 16: the destination type of a value-position annotation (`x:CStr`), or
; null when there is none. Both halves of the annotation-cast lockstep pair call
; it — emit-symbol-ref to pick the `as-convert` target, node-type-sym to report
; the type that conversion yields — so neither re-derives the other's answer.
;
; The resolvability probe is what lets node-type keep its "never aborts" contract
; (parse-type-name dies on an unknown spelling): an unresolvable annotation
; yields null here, node-type reports "not modelled", and emit-symbol-ref raises
; the located `unknown type` itself.
(defn value-annot-type (annot:Symbol line:i32):?&Type
  (when (symbol-none? annot) (return null))
  (when (= (tyname-resolvable annot) 0) (return null))
  (return (as ptr (parse-type-name annot line))))

(defn node-type-sym (n:ptr:Node scope:ref:Scope):?&Type
  ; The `null` literal is bare `ptr`: it flows into any nullable slot but not
  ; into a non-null `ref` slot.
  (when (= n 'null)  (return ty-ptr))
  (when (= n 'true)  (return ty-bool))
  (when (= n 'false) (return ty-bool))
  (when (= n 'none)  (return ty-maybe-ptr))
  (if-some (r (legacy-marker-ref (as ?&Node n))) (return (node-type r scope)) 0)
  (let (lookup-name:Symbol (symbol-none)
        annot:Symbol (symbol-none))
    (split-typed (n 's)
                 (as &Symbol &lookup-name) (as &Symbol &annot))
    (let (sym:?&Sym (scope-lookup scope lookup-name))
      (when (= sym null) (return null))
      ; Stage 16 annotation cast: `x:T` in value position converts, so the type
      ; it contributes is the annotation's, not the binding's. Kept after the
      ; lookup so an unbound name still reports "unknown" from emit rather than
      ; typing successfully here.
      (when (not (symbol-none? annot))
        (return (value-annot-type annot (node-line (as ptr n) 0))))
      ; Stage 15 W8 G-2 lockstep with emit-symbol-ref (conventions.md
      ; node-type<->emit-node): reading an `(array T N)` binding yields the
      ; decayed `(ref T)`, never the aggregate. One shared rule, called from
      ; both sides — array-decay is identity for every other kind.
      (return (array-decay (sym-effective-type sym))))))

; Stage 15 W5d (design/stage15-stress-test/ergonomics.md §3.10): the type a
; let/with binding actually takes when its declared type is an elem-LESS pointer
; and its initializer is literally an `(array T …)` compound literal. The
; literal yields `ptr:T`, but a bare `ptr` annotation erased the element type,
; so `(aref a i)` / `(deref a)` / `(a field)` on the local all died "operand
; must be typed pointer" and the workable spellings were the fully-annotated
; `a:ptr:T` or a bare (untyped) binding name — both of which already worked, so
; the wart was the *annotated-but-imprecise* middle case alone. The binding now
; adopts the literal's element type while keeping the DECLARED pointer kind and
; volatility: the annotation still says everything it said, plus the element it
; had no way to say.
;
; Deliberately SYNTACTIC — an `(array …)` init specifically, not a general
; "adopt the init's element type whenever the declaration is elem-less" rule.
; A bare `:ptr` is this language's void*-style erasure hatch and it erases the
; *nullability claim* as well as the element type (pkind-flow-check exempts an
; elem-less target). Adopting elem in general would (a) re-route multimethod
; dispatch — `type-eq` compares pointer elements, so a `ptr:Node` argument does
; NOT match a `ptr` parameter — across the ~1550 bare `:ptr` bindings in this
; compiler alone, and (b) either keep a non-null claim over a nullable source or
; silently downgrade what the author declared. An `(array …)` literal has
; neither problem: it is an alloca, so always non-null, and its element type is
; spelled by the author *in the initializer*, so nothing is inferred that a
; reader of the binding cannot see.
;
; IR-inert by construction: every pointer lowers to `ptr` with size 8, so the
; binding's alloca, its store and its coercion are identical either way — only
; the type recorded in the SCOPE changes. Returns `ty` unchanged in every other
; case, including a null `ty` (the CE-1 bare-name path fills that in from the
; emitted value, and that path already carries the element type).
;
; Called from emit-let/emit-with (nucleusc.nuc) and mirrored in node-type-block
; below, so the two passes agree on the binding type (the node-type<->emit-node
; lockstep, conventions.md): one rule function both sides call, never two copies.
(defn array-lit-binding-type (ty:?&Type init:?&Node):?&Type
  (when (or (= ty null) (= init null)) (return ty))
  (let (tt:?&Type ty)
    (when (or (!= (tt 'kind) TY-PTR) (!= (tt 'elem) null)) (return ty))
    (let (n:?&Node init)
      (when (!= (n 'kind) NODE-LIST) (return ty))
      ; `(array T …)` is at least a head and an element type.
      (when (< (node-len (as ptr n)) 2) (return ty))
      (let (head:ptr (node-at (as ptr n) 0))
        (when (= head null) (return ty))
        ; Symbol Nodes are interned singletons, so the head identity test is a
        ; pointer compare against the quoted symbol (see gcheck-special-form).
        (when (!= head (as ptr 'array)) (return ty))
        (let (etype-node:ptr (node-at (as ptr n) 1))
          (when (= etype-node null) (return ty))
          (let (etype:ptr (as ptr (parse-type-from-node etype-node
                                    (node-line etype-node
                                      (node-line (as ptr n) 0)))))
            (when (= etype null) (return ty))
            (let (rt:&Type (as &Type (make-type TY-PTR)))
              (set! (rt 'elem) etype)
              (set! (rt 'pkind) (tt 'pkind))
              (set! (rt 'is-volatile) (tt 'is-volatile))
              (return (as ptr rt)))))))))

; let / with: the type of the last body expression, evaluated in a child scope
; carrying the binding types (values are irrelevant to typing).
(defn node-type-block (n:?&Node scope:ref:Scope):?&Type
  ; AT-1 lockstep with emit-let/emit-with (conventions.md node-type<->emit-node):
  ; normalize a leading `:volatile` (etc.) into a wrapped binding name so the
  ; (name value) pairing survives and the binding types register at the right
  ; slots. Attribute-free lists pass through unchanged.
  (let (binds:?&Node (attrs-normalize-bindings (as ptr (node-at n 1))
                        ((unsafe/cast &Node n) 'line)))
    (when (or (= binds null)
              (!= (binds 'kind) NODE-LIST))
      (return null))
    (let (inner:ref:Scope (scope-new scope)
          i:i32 0
          bl:i32 (node-len (as ptr binds)))
      (while (< i bl)
        (let (bname:ptr (node-at (as ptr binds) i)
              name:Symbol (symbol-none)
              ty:ptr (extract-name-and-type bname
                                            (as &Symbol &name)
                                            ((unsafe/cast &Node bname) 'line)))
          ; W5d (§3.10) lockstep with emit-let/emit-with: an `(array T …)` init
          ; refines an elem-less declared pointer to `ptr:T`, so a probe over the
          ; body types `(aref a i)` exactly as emission does.
          (set! ty (array-lit-binding-type ty (node-at (as ptr binds) (+ i 1))))
          (when (!= ty null) (scope-define inner name ty (symbol-as-view name) 1)))
        (set! i (+ i 2)))
      (let (last:ptr null
            j:i32 2
            cl:i32 (node-len n))
        (while (< j cl)
          (set! last (node-at n j))
          (inc! j))
        (when (= last null) (return ty-void))
        (return (node-type last inner))))))

(defn node-type-cast (n:ptr:Node):&Type
  (let (tn:&Node (unsafe/cast &Node (node-at n 1)))
    (return (parse-type-from-node (as ptr tn) (node-line (as ptr tn) (n 'line))))))

; Stage 14 UN-1: `(as TYPE expr)` type mirror (node-type<->emit-node lockstep,
; conventions.md). emit-as (src/nucleusc.nuc) returns a Val typed EXACTLY the
; parsed target type on every accepted input — same as emit-cast — so the
; non-emitting type is the parsed target type, identical to node-type-cast. A
; rejected `as` dies in emit-as before propagating a type, exactly as an
; unsupported `cast` dies in emit-cast, so the two passes never disagree on any
; type that actually flows to a parent.
(defn node-type-as (n:ptr:Node):&Type
  (let (tn:&Node (unsafe/cast &Node (node-at n 1)))
    (return (parse-type-from-node (as ptr tn) (node-line (as ptr tn) (n 'line))))))

(defn node-type-alloca (n:ptr:Node):&Type
  (let (tn:&Node (unsafe/cast &Node (node-at n 1)))
    ; Stage 15 W8 G-2 lockstep with emit-alloca-form (conventions.md
    ; node-type<->emit-node): it arms the one-shot `(array T N)` permission and
    ; decays the result to `ptr:T`, so this must do both — otherwise
    ; `(alloca (array i32 4))` types as an error in the non-emitting pass while
    ; codegen accepts it, which is the divergence the lockstep exists to stop.
    (set! g-array-ok 1)
    (let (ty:ptr (parse-type-from-node (as ptr tn) (node-line (as ptr tn) (n 'line)))
          pt:ref:Type (make-type TY-PTR))
      (if (= ((unsafe/cast &Type ty) 'kind) TY-ARRAY)
        (set! (pt 'elem) ((unsafe/cast &Type ty) 'elem))
        (set! (pt 'elem) ty))
      ; alloca always yields a valid, non-null stack address (ref T).
      (set! (pt 'pkind) PTR-REF)
      (return pt))))

; Lockstep with emit-ref's arity overload. Without this the 2-arg form would
; fall into the 1-arg path and type `(ref p 'f)` as `ptr:ptr:Point` -- the
; address of the BINDING, not of the field (dot-forms.md §3).
(defn node-type-field-addr (n:?&Node scope:ref:Scope):?&Type
  (let (t:ptr (node-type (node-at n 1) scope))
    (when (= t null) (return null))
    (let (sd:?&StructDef (access-receiver-sdef (as ?&Type t)))
      (when (= sd null) (return null))
      (let (fn-node:?&Node (selector-literal-sym (node-at n 2)))
        (when (= fn-node null) (return null))
        (let (fr:?&FieldRef (struct-field-ref (as ptr sd) (fn-node 's)))
          (when (= fr null) (return null))
          (let (ftype:ptr (fr 'type))
            ; G-2 lockstep with emit-field-addr: an array field's address is the
            ; DECAYED `ptr:elem`, so wrapping node-type-field's already-decayed
            ; answer would give `ptr:ptr:elem`.
            (when (= ((unsafe/cast &Type ftype) 'kind) TY-ARRAY)
              (set! ftype (as ptr ((array-decay ftype) 'elem))))
            (let (pt:&Type (as &Type (make-type TY-PTR)))
              (set! (pt 'elem) ftype)
              ; A field's address inside a non-null struct is non-null (ref T).
              (set! (pt 'pkind) PTR-REF)
              (return (as ptr pt)))))))))

(defn node-type-ref (n:?&Node scope:ref:Scope):?&Type
  (when (= (node-len n) 3) (return (node-type-field-addr n scope)))
  (let (target:&Node (unsafe/cast &Node (node-at n 1)))
    (when (!= (target 'kind) NODE-SYM) (return null))
    (let (sym:?&Sym (scope-lookup scope (target 's)))
      (when (= sym null) (return null))
      (let (pt:&Type (as &Type (make-type TY-PTR)))
        (set! (pt 'elem) (sym 'type))
        ; Mirror emit-ref: a binding's address is non-null (ref T).
        (set! (pt 'pkind) PTR-REF)
        (return (as ptr pt))))))

(defn node-type-funcall (n:?&Node scope:ref:Scope):?&Type
  (let (t:ptr (node-type (node-at n 1) scope))
    (when (= t null) (return null))
    (let (tt:&Type (unsafe/cast &Type t))
      (when (!= (tt 'kind) TY-FN) (return null))
      (return (tt 'ret)))))

; deref / aref: the pointee type of the first operand's pointer.
(defn node-type-deref-elem (n:?&Node scope:ref:Scope):?&Type
  (let (t:ptr (node-type (node-at n 1) scope))
    (when (= t null) (return null))
    (let (tt:&Type (unsafe/cast &Type t))
      (when (or (!= (tt 'kind) TY-PTR) (= (tt 'elem) null)) (return null))
      (return (tt 'elem)))))

; Stage 16 SV-1 lockstep (design/stage16-ergonomics/c-boundary-defects.md §3):
; the struct a member access reads through, whether the receiver is a POINTER to
; one or a struct VALUE. The emitter materializes the value
; (materialize-struct-value); the type pass has to unwrap it in exactly the same
; places, or the two disagree about what has fields.
(defn access-receiver-sdef (t:?&Type):?&StructDef
  (when (= t null) (return null))
  (let (tt:&Type (unsafe/cast &Type t))
    (when (= (tt 'kind) TY-STRUCT) (return (as ptr (tt 'sdef))))
    (when (and (= (tt 'kind) TY-PTR)
               (!= (tt 'elem) null)
               (-> tt (_ 'elem) (unsafe/cast &Type _) (_ 'kind) (= _ TY-STRUCT)))
      (return (as ptr (-> tt (_ 'elem) (unsafe/cast &Type _) (_ 'sdef)))))
    (return null)))

; Would emit-get-intrinsic accept this callee? Its own unwrap: a struct or union
; VALUE (SV-1 materializes it), or a pointer to one. Distinct from
; access-receiver-sdef because that answers with a StructDef and so cannot speak
; for a TY-UNION -- which is exactly the case a receiver-shaped routing gate must
; not drop on the floor (dot-forms.md §5 step 3).
(defn is-member-access-receiver (t:?&Type):i32
  (when (= t null) (return 0))
  (let (tt:&Type (unsafe/cast &Type t))
    (when (or (= (tt 'kind) TY-STRUCT) (= (tt 'kind) TY-UNION)) (return 1))
    (when (and (= (tt 'kind) TY-PTR) (!= (tt 'elem) null))
      (let (ek:i32 (-> tt (_ 'elem) (unsafe/cast &Type _) (_ 'kind)))
        (when (or (= ek TY-STRUCT) (= ek TY-UNION)) (return 1))))
    (return 0)))

(defn node-type-field (n:?&Node scope:ref:Scope):?&Type
  (let (t:ptr (node-type (node-at n 1) scope))
    (when (= t null) (return null))
    (let (sd:?&StructDef (access-receiver-sdef (as ?&Type t)))
      (when (= sd null) (return null))
      ; Lockstep with emit-field-load / emit-field-set / emit-field-addr, which
      ; all take the selector through selector-literal-sym (dot-forms.md §5).
      (let (fn-node:?&Node (selector-literal-sym (node-at n 2)))
        (when (= fn-node null) (return null))
        ; FR-1: the same resolver the emit side uses, so a path that reaches
        ; through an anonymous member cannot answer differently in the two.
        (let (fr:?&FieldRef (struct-field-ref (as ptr sd) (fn-node 's)))
          (when (= fr null) (return null))
          ; G-2 lockstep with emit-field-load: an array field decays.
          (return (array-decay (fr 'type))))))))

; Result type of `(get callee selector)` for callee type `ct` — mirrors
; emit-get-with-callee / emit-get-intrinsic so the type pass cannot drift from
; codegen. A tier-0 user `get` method → its return; a literal selector → the
; named field's type; a computed selector → null (emit keeps its own type).
(defn callable-get-type (ct:?&Type sel-node:?&Node scope:ref:Scope):?&Type
  (let (ctt:?&Type ct
        g:?&Generic (generic-lookup (symbol-intern "get")))
    (when (!= g null)
      (let (argtypes:ptr (arena-alloc (* 2 (ptr-bytes))))
        (set! (aref (unsafe/cast &ptr argtypes) 0) ct)
        (set! (aref (unsafe/cast &ptr argtypes) 1) ty-ptr)
        (let (m:?&Method (generic-find-method-exact g argtypes 2))
          (when (!= m null) (return (m 'ret-type))))))
    ; SV-1: same unwrap as node-type-field — a struct VALUE in head position is
    ; a member access too.
    (let (sd:?&StructDef (access-receiver-sdef ct))
      (when (= sd null) (return null))
      (let (lit:ptr (selector-literal-sym sel-node))
        (when (= lit null) (return null))
        (let (fr:?&FieldRef (struct-field-ref (as ptr sd)
                                 (-> lit (unsafe/cast &Node _) (_ 's))))
          (when (= fr null) (return null))
          ; G-2 lockstep with emit-get-intrinsic -> emit-field-load: array decay.
          (return (array-decay (fr 'type))))))))

; Result type of `(invoke callee arg…)` for callee type `ct` — the tier-0 `invoke`
; method's return, else null (mirrors emit-invoke-with-callee at the exact tier).
(defn callable-invoke-type (ct:?&Type n:?&Node arg-start:i32 nargs:i32 scope:ref:Scope):?&Type
  (let (g:?&Generic (generic-lookup (symbol-intern "invoke")))
    (when (= g null) (return null))
    (let (total:i32 (+ nargs 1)
          argtypes:ptr (arena-alloc (* (+ total 1) (ptr-bytes)))
          ok:i32 1)
      (set! (aref (unsafe/cast &ptr argtypes) 0) ct)
      (dotimes (i nargs)
        (let (at:ptr (node-type (node-at n (+ arg-start i)) scope))
          (when (= at null) (set! ok 0))
          (set! (aref (unsafe/cast &ptr argtypes) (+ i 1)) at)))
      (when (= ok 0) (return null))
      (let (m:?&Method (generic-find-method-exact g argtypes total))
        (when (= m null) (return null))
        (return (m 'ret-type))))))

; Type of a non-function head value `ct` applied in `(callee arg…)` — mirrors
; emit-callable-value's `invoke → get → _get` routing so the type pass cannot
; drift from codegen: a callee whose type has an `invoke` method → invoke result;
; else a single arg with a custom/intrinsic `get` → get result.
(defn callable-value-type (ct:&Type n:?&Node scope:ref:Scope):?&Type
  (let (nargs:i32 (- (node-len n) 1))
    (when (!= (generic-has-receiver-method (generic-lookup (symbol-intern "invoke")) ct) 0)
      (return (callable-invoke-type ct n 1 nargs scope)))
    (when (and (= nargs 1)
               (!= (generic-has-receiver-method (generic-lookup (symbol-intern "get")) ct) 0))
      (return (callable-get-type ct (node-at n 1) scope)))
    ; Lockstep with emit-callable-value: routes on the receiver, not the
    ; argument's shape (dot-forms.md §5 step 3).
    (when (and (= nargs 1) (!= (is-member-access-receiver ct) 0))
      (return (callable-get-type ct (node-at n 1) scope)))
    (return (callable-invoke-type ct n 1 nargs scope))))

(defn node-type-get (n:?&Node scope:ref:Scope):?&Type
  (when (!= (node-len n) 3) (return null))
  (let (ct:ptr (node-type (node-at n 1) scope))
    (when (= ct null) (return null))
    (return (callable-get-type ct (node-at n 2) scope))))

(defn node-type-invoke (n:?&Node scope:ref:Scope):?&Type
  (when (< (node-len n) 2) (return null))
  (let (ct:ptr (node-type (node-at n 1) scope))
    (when (= ct null) (return null))
    (return (callable-invoke-type ct n 2 (- (node-len n) 2) scope))))

; The typing rule for one binding-table row that produces a value. Only
; BK-GLOBAL does — a generic is handled by the resolver in `node-type-call`, and
; every other row is a name emit REFUSES in head position, for which returning
; null is the standing escape hatch (emit's own diagnostic stands).
(defn node-type-binding (hit:ref:BindingHit n:?&Node scope:ref:Scope):?&Type
  (when (!= (hit 'kind) BK-GLOBAL) (return null))
  (let (sym:&Sym (unsafe/cast &Sym (hit 'payload))
        ft:&Type (unsafe/cast &Type (sym 'type)))
    ; A non-function value head is a callable value: mirror the get/invoke desugar.
    (when (!= (ft 'kind) TY-FN) (return (callable-value-type ft n scope)))
    (return (ft 'ret))))

; A call head (not a special form): mirror emit-dispatch. Operator → a matching
; user overload's return type, else bool for comparisons / the first operand's type
; (the intrinsic peephole result); overloaded set → the exactly matched method's
; return type; solitary/extern → the bound function's return.
;
; Stage 15 B5: the WHICH-registry-answers question is now asked once, from the
; shared binding table (`build-binding-kinds`, src/nucleusc.nuc), by
; `emit-dispatch` and by this function — the node-type↔emit-node lockstep
; applied to resolution order rather than to a typing rule (conventions.md:
; mirroring the logic drifts, mirroring a call cannot). The window stops at
; BK-GLOBAL because those are the rows that yield a type; beyond it emit only
; produces a diagnostic.
; The result type of a call to overloaded `g` over `argtypes`, as emit's tiers
; would resolve it, or null.
(defn node-type-mangled-call (g:?&Generic h:Symbol n:?&Node argtypes:ptr arg-nodes:ptr
                              nargs:i32 want:?&Type):?&Type
    ; First try METHOD-USER (exact match), then the same tier-0 second
    ; pass generic-resolve runs — without it a call whose receiver is a
    ; struct VALUE meeting a `(ref T)` parameter types as unknown here
    ; while emit resolves it, which mis-sized `try`'s ok arm.
    (let (m:?&Method (generic-find-method-exact g argtypes nargs))
      (when (!= m null) (return (m 'ret-type))))
    (let (m:?&Method (generic-find-method-accepting g argtypes nargs))
      (when (!= m null) (return (m 'ret-type))))
    ; Then try METHOD-GENERIC (parametric match with tyvar substitution).
    (let (out-ret:ptr (arena-alloc (ptr-bytes))
          bsaved:BindCall (bind-call-arm h (node-line n 0))
          bound:i32 (generic-binds-for g argtypes nargs (unsafe/cast &ptr out-ret) 0 arg-nodes))
      (set! g-bind-call bsaved)
      (when (!= bound 0)
        (return (aref (unsafe/cast &ptr out-ret) 0))))
    ; Stage 14 LW-2: mirror emit's generic-resolve tier-2 so a widened
    ; template/plain call types correctly (the node-type↔emit lockstep).
    ; Return null (the escape hatch) on ambiguity/no-match — node-type is
    ; allowed to not-know a type, and must never die here.
    ; TC-3: when no explicit want was passed (the normal node-type entry
    ; points hand null here), fall back to the downward want channel
    ; g-want-type so a non-emitting probe run from a let/with binding
    ; init (tc3-emit-binding-init) can fill a return-only tyvar exactly
    ; as emit would. Safe under the consume-once discipline: g-want-type
    ; is armed only around a binding-init probe/emit and is null in every
    ; other node-type context (gcheck/valid-walk run def-time; the Rung-3
    ; cross-check runs after emit-generic-call already consumed it), so
    ; self-compilation — which has no return-only generics — is unaffected.
    (let (wmethod:ptr null
          wbound:ptr null
          bsaved2:BindCall (bind-call-arm h (node-line n 0))
          r:i32 (generic-resolve-adapt-tier g argtypes arg-nodes nargs 0
                  (as &ptr &wmethod) (as &ptr &wbound)
                  (if (!= want null) want g-want-type)))
      (set! g-bind-call bsaved2)
      (when (= r 1) (return (-> wmethod (unsafe/cast &Method _) (_ 'ret-type))))
      (when (= r 2) (return (method-bound-ret-type wmethod wbound 0)))
    (return null)))

(defn node-type-call (n:?&Node scope:ref:Scope h:Symbol want:?&Type):?&Type
  (let (ghit:?ref:BindingHit (binding-find h scope BK-DISPATCH-FIRST (+ BK-GLOBAL 1) 0 NK-NONE))
    (when (= ghit null) (return null))
    (when (!= ((unsafe/cast &BindingHit ghit) 'kind) BK-GENERIC)
      (return (node-type-binding (unsafe/cast &BindingHit ghit) n scope)))
  (let (g:?&Generic (as ?&Generic ((unsafe/cast &BindingHit ghit) 'payload)))
    (when (!= g null)
      (let (m0:&Method (as &Method (invoke (g 'methods) 0)))
        (when (= (m0 'kind) METHOD-INTRINSIC)
          ; A user overload of this operator, if any, wins (mirror emit).
          (when (!= (g 'mangled) 0)
            (let (nargs:i32 (- (node-len n) 1)
                  argtypes:ptr (arena-alloc (* (+ nargs 1) (ptr-bytes)))
                  arg-nodes:ptr (arena-alloc (* (+ nargs 1) (ptr-bytes)))
                  ok:i32 1)
              (dotimes (i nargs)
                (let (anode:ptr (node-at n (+ i 1))
                      at:ptr (node-type anode scope))
                  (when (= at null) (set! ok 0))
                  (set! (aref (unsafe/cast &ptr argtypes) i) at)
                  (set! (aref (unsafe/cast &ptr arg-nodes) i) anode)))
              (when (!= ok 0)
                (let (vt:ptr null
                      um:?&Method (operator-resolve g argtypes arg-nodes nargs scope &vt))
                  (when (!= um null) (return (um 'ret-type)))))))
          (let (bop:&BinOp (unsafe/cast &BinOp (m0 'binop)))
            (when (!= (bop 'is-cmp) 0) (return ty-bool))
            ; Stage 15 W2a: a binop's result type is the type its operands
            ; *unify* to, from the one shared rule emit's binop-coerce uses
            ; (binop-result-type, src/nucleusc.nuc) — not operand 1's type
            ; alone. Returning operand 1's type made `(* 4096 (as i64 X))` type
            ; i32 while emit produced i64 (the argument coercer then inserted a
            ; bogus `sext i32 <i64 value>`) and made `(> t:ui32 (* 2 cl:ui32))`
            ; fail the mixed-sign check that `(* cl 2)` passed. Null (an operand
            ; node-type does not model, or a pair this rule cannot reconcile) is
            ; the usual escape hatch: emit's own unified type then stands.
            (when (!= (node-len n) 3) (return null))
            (let (a-node:?&Node (node-at n 1)
                  b-node:?&Node (node-at n 2))
              ; W2b: `scope` goes in too, so a `defconst`/`defenum` operand is
              ; classified as the literal it names on this side exactly as it is
              ; on emit's (binop-coerce) — the lockstep, again, by shared call.
              (return (binop-result-type (node-type a-node scope)
                                         (node-type b-node scope)
                                         a-node b-node scope)))))
        (when (!= (g 'mangled) 0)
          (let (untyped:bool false)
            (when-some (t (node-type-registry-call g h n scope want &untyped))
              (return t))
            ; An argument this pass cannot type leaves the call unknown, not a global's.
            (when untyped (return null)))))))
    ; A solitary (unmangled, non-intrinsic) generic — or a mangled one whose
    ; resolution did not settle — falls through to the next table row, exactly
    ; as emit-dispatch's own fall-through does, and to the registry when none.
    (if-some (h2 (binding-find h scope (+ BK-GENERIC 1) (+ BK-GLOBAL 1) 0 NK-NONE))
      (return (node-type-binding h2 n scope))
      (let (g:?&Generic (as ?&Generic ((unsafe/cast &BindingHit ghit) 'payload)))
        (when (and (!= g null) (= (g 'mangled) 0))
          (let (untyped:bool false)
            (return (node-type-registry-call g h n scope want &untyped))))
        (return null)))))

(defn node-type-registry-call (g:&Generic h:Symbol n:?&Node scope:ref:Scope want:?&Type
                               out-untyped:&bool):?&Type
  (let (nargs:i32 (- (node-len n) 1)
        argtypes:ptr (arena-alloc (* (+ nargs 1) (ptr-bytes)))
        arg-nodes:ptr (arena-alloc (* (+ nargs 1) (ptr-bytes)))
        ok:i32 1)
    (dotimes (i nargs)
      (let (anode:ptr (node-at n (+ i 1))
            at:ptr (node-type anode scope))
        (when (= at null) (set! ok 0))
        (set! (aref (unsafe/cast &ptr argtypes) i) at)
        (set! (aref (unsafe/cast &ptr arg-nodes) i) anode)))
    (when (= ok 0)
      (set! @out-untyped true)
      (return null))
    (when-some (t (node-type-mangled-call g h n argtypes arg-nodes nargs want))
      (return t))
    ; generic-resolve's struct-literal retry, in lockstep.
    (let (lt:ptr (literal-arg-types argtypes arg-nodes nargs scope))
      (when (!= lt null)
        (when-some (t (node-type-mangled-call g h n lt arg-nodes nargs want))
          (return t))))
    (return null)))

(defn node-type (n:?&Node scope:ref:Scope):?&Type
  (when (= n null) (return ty-void))
  (let (nn:?&Node n)
    (case (nn 'kind)
      ; LW-4 lockstep with emit-int: an out-of-i32-range literal types (and emits)
      ; as i64, everything else as i32. Keeps codegen and the type pass in sync so
      ; the widened width is not clobbered by emit-node's Rung-3 cross-check.
      ; W2b turned that shared width choice into one function (int-literal-type,
      ; src/nucleusc.nuc) rather than a copy here and a copy in emit-int.
      NODE-INT   (return (int-literal-type (nn 'i)))
      NODE-FLOAT (return ty-f64)
      ; Stage 14 NS-3: a string literal now types as StrView (was CStr) — the flip.
      ; Lockstep with emit-string (nucleusc.nuc) and the gcheck / valid-walk mirrors
      ; (conventions.md node-type↔emit-node). emit-string emits only the bare GEP and
      ; returns an *unmaterialized* StrView Val (is-lit=1, val=the data ptr); the
      ; coercion chokepoints collapse it back to ptr/CStr with no IR (byte-identical)
      ; or materialize {ptr,len} for a genuine StrView target.
      NODE-STR
        ; NS-4: an explicit c"…" literal (reader set Node.i=1) types as CStr, not
        ; the StrView default — lockstep with emit-string's NS-4 short-circuit.
        (if (!= (nn 'i) 0) (return ty-cstr) (return (strview-type)))
      NODE-CHAR  (return ty-char)
      NODE-SYM   (return (node-type-sym n scope))
      ; Keyword literal (Stage 11 cleanup §2): its static type is the `Keyword`
      ; struct, available only when the program has (import nucleus.keyword). If the struct
      ; is registered, report it so the Rung-3 cross-check at the emit site agrees
      ; with the keyword-intern call's return type; otherwise return null and let
      ; emit's own type stand (emit-keyword's synthetic call dies with a clear
      ; "undefined: keyword-intern" if the lib was not imported).
      NODE-KEYWORD
        (let (sd:?&StructDef (core-struct "Keyword"))
          (when (!= sd null) (return (type-for-sdef sd)))
          (return null))
      0)
    (when (!= (nn 'kind) NODE-LIST) (return ty-void))
    (when (= (node-len n) 0) (return null))
    (let (head:&Node (unsafe/cast &Node (node-at n 0)))
      (when (!= (head 'kind) NODE-SYM) (return null))
      (let (h:Symbol (head 's)
            hp:&Node head)
        (when (!= (find-macro h) null) (return null))
        ; Stage 14 MC-2: gensym yields a fresh Node — type it &Node so it stays
        ; in lockstep with emit-list's gensym path (ty-ref-node).
        (when (= hp 'gensym) (return (ty-ref-node)))
        ; Stage 20 M3: `macro-error` aborts the expansion, so nothing consumes
        ; its value; void keeps it in lockstep with emit-macro-error.
        (when (= hp 'macro-error) (return ty-void))
        (when (or (= hp 'struct-fields) (= hp 'type-name)) (return (ty-ref-node)))
        ; Stage 14 UN-5 / Stage 15 B2b: the bare `funcall-ptr-*` spellings do not
        ; resolve (the `unsafe` namespace is bound prefixed, never flattened), so
        ; there is nothing to refuse here either. Mirrors emit-list's routing in
        ; nucleusc.nuc — this pair is the node-type↔emit-node lockstep, and the
        ; refusals had to leave both files together or the non-emitting pass
        ; would die where codegen no longer does.
        (when (= hp 'unsafe/funcall-ptr-1) (return ty-ptr))
        (when (= hp 'unsafe/funcall-ptr-i32) (return ty-i32))
        (when (= hp 'unsafe/funcall-ptr-i64) (return ty-i64))
        (when (= hp 'unsafe/funcall-ptr-ptr) (return ty-ptr))
        (when (= hp 'return) (return ty-void))
        (when (= hp 'do)
          (if (> (node-len n) 1)
            (return (node-type (node-at n (- (node-len n) 1)) scope))
            (return ty-void)))
        ; Stage 16 `macrolet`: expansion-dependent, so unmodelled — the same
        ; escape hatch `cond`, macros and `quasiquote` take. Codegen keeps its
        ; own type. (node-type↔emit-node lockstep: emit-macrolet, nucleusc.nuc.)
        (when (= hp 'macrolet) (return null))
        ; Stage 16 collection literals: the type is the `let` the expansion
        ; builds, and that expansion depends on the want channel, which is
        ; armed at emit and consumed by the time the Rung-3 cross-check runs
        ; here. Recomputing it would answer for a DIFFERENT element type and
        ; Rung 3 overwrites rather than asserts — so take the unmodelled
        ; escape hatch `cond`/`macrolet`/`quasiquote` take and let emit's own
        ; type stand. (lockstep: emit-collection-lit, nucleusc.nuc.)
        (when (= hp 'vector-lit) (return null))
        (when (= hp 'hashset-lit) (return null))
        (when (= hp 'hashmap-lit) (return null))
        (when (= hp 'tagged-lit) (return null))
        (when (= hp 'let) (return (node-type-block n scope)))
        (when (= hp 'with) (return (node-type-block n scope)))
        (when (= hp 'cond) (return null))
        ; Stage 14 MC-2: plain `quote` yields a Node* — type it (ptr Node), in
        ; lockstep with emit-quote. Stage 16: a quoted SYMBOL is an intern-symbol
        ; result, so it types (ref Node); `quoted-datum-type` is the shared rule
        ; and both sites must call it. `quasiquote` stays unmodelled (null): its
        ; result type is expansion-dependent (an unquote can inject any type), so
        ; emit-qq-form's own (ptr Node) type propagates.
        (when (= hp 'quote) (return (quoted-datum-type (node-at n 1))))
        (when (= hp 'quasiquote) (return null))
        ; lockstep: emit-ast-read, nucleusc.nuc.
        (when (or (= hp 'ast-first) (= hp 'ast-rest) (= hp 'ast-at)) (return (ty-ptr-node)))
        (when (= hp 'ast-len) (return ty-i32))
        (when (= hp 'while) (return ty-void))
        (when (= hp 'set!)
          (let (tgt:&Node (unsafe/cast &Node (node-at n 1))
                nm:Symbol (symbol-none)  ti:Symbol (symbol-none))
            ; A PLACE assigns through a storage writer, every one of which is void
            ; here; only the name place yields the assigned value. Guarding on the
            ; kind is also what keeps `split-typed` off a cell's null `s`.
            (when (= (as ptr tgt) null) (return ty-void))
            (when (!= (tgt 'kind) NODE-SYM)
              ; Lockstep with emit-set-place: a member place on a receiver with a
              ; user `set` method is that call, so it is that call's type.
              (let (sc:ptr (set-place-call tgt (node-at n 2) (n 'line) scope))
                (when (!= sc null) (return (node-type sc scope))))
              (return ty-void))
            (split-typed (tgt 's) (as &Symbol &nm) (as &Symbol &ti))
            (let (sym:?&Sym (scope-lookup scope nm))
              (when (= sym null) (return ty-void))
              (return (sym 'type)))))
        (when (= hp 'inc!) (return ty-void))
        (when (= hp 'not) (return ty-bool))
        (when (= hp '_and) (return ty-bool))
        (when (= hp '_or) (return ty-bool))
        ; `unsafe/cast` types exactly as the retired bare `cast` used to.
        (when (= hp 'unsafe/cast) (return (node-type-cast n)))
        (when (= hp 'as) (return (node-type-as n)))
        ; Lockstep with emit-list: `ref` is the value-world address-of head too.
        (when (= hp 'ref) (return (node-type-ref n scope)))
        (when (= hp 'funcall-void) (return ty-void))
        (when (= hp 'funcall) (return (node-type-funcall n scope)))
        (when (= hp 'deref) (return (node-type-deref-elem n scope)))
        ; Stage 14 UN-5: bare `ptr+` is retired (D6); `unsafe/ptr+` mirrors what
        ; bare `ptr+` used to (lockstep).
        (when (= hp 'unsafe/ptr+) (return (node-type (node-at n 1) scope)))
        (when (= hp '_get) (return (node-type-field n scope)))
        (when (= hp 'get) (return (node-type-get n scope)))
        (when (= hp 'invoke) (return (node-type-invoke n scope)))
        ; sizeof yields a pointer-sized integer (size_t) — mirror emit-sizeof,
        ; which returns (ptr-int-type). On hosted targets ptr-int-type is ty-i64
        ; so this is byte-identical; on a 16-bit target (AVR, Stage 14 AVR-2) it
        ; is i16, keeping the node-type<->emit-node lockstep intact.
        (when (= hp 'sizeof) (return (ptr-int-type)))
        ; Lockstep with emit-source-file, which emits a plain string literal.
        (when (= hp 'source-file) (return (strview-type)))
        (when (= hp 'source-line) (return (int-literal-type (as i64 (n 'line)))))
        (when (= hp 'alloca) (return (node-type-alloca n)))
        ; (char "x") is sugar for the \x char literal — a Char value (S0). Must
        ; match emit-char's result type so the Rung-3 cross-check agrees.
        (when (= hp 'char) (return ty-char))
        (when (= hp 'aref) (return (node-type-deref-elem n scope)))
        ; Stage 10: Maybe transition forms — relabelings mirror their emitters
        ; exactly; if-some/when-some are phi-shaped like cond (null = unmodeled).
        (when (or (= hp 'some) (= hp 'as-ref))
          (let (t:ptr (node-type (node-at n 1) scope))
            (when (= t null) (return null))
            (when (!= ((unsafe/cast &Type t) 'kind) TY-PTR) (return null))
            (return (type-as-pkind t PTR-MAYBE))))
        (when (or (= hp 'unwrap) (= hp 'unwrap-or))
          (let (t:ptr (node-type (node-at n 1) scope))
            (when (= t null) (return null))
            ; Result operand: the ok-arm payload type (errors.md §9).
            (let (okt:?&Type (result-ok-type t))
              (when (!= okt null) (return okt)))
            (when (!= (ptr-pkind t) PTR-MAYBE) (return null))
            (return (type-as-pkind t PTR-REF))))
        ; Stage 17 A1: `(try R)` yields what `unwrap` would — the ok-arm payload,
        ; or void when that arm is payload-less (`!void`). Lockstep partner of
        ; emit-try (src/union-emit.nuc), which lowers to a match on the same arm.
        (when (= hp 'try)
          (let (t:ptr (node-type (node-at n 1) scope))
            (when (= t null) (return null))
            (let (okt:?&Type (result-ok-type t))
              (when (!= okt null) (return okt)))
            (when (!= (as ptr (result-union-of (as ?&Type t))) null) (return ty-void))
            (return null)))
        (when (or (= hp 'if-some) (= hp 'when-some)) (return null))
        (when (or (= hp 'err-name) (= hp 'err-message)) (return ty-cstr))
        (when (= hp 'type-token) (return ty-cstr))
        ; (signal E RepairType [detail]) yields (Maybe RepairType). stamp-maybe-type
        ; lives in union-emit.nuc (imported after generics.nuc), so this typing path
        ; calls through the g-stamp-maybe-type-hook function pointer (installed in
        ; init-blanket). N8 cross-file back-edge bridge.
        (when (= hp 'signal)
          (when (< (node-len n) 3) (return null))
          (return (funcall (unsafe/cast ((fn &Type) (ptr i32)) g-stamp-maybe-type-hook)
                           (parse-type-from-node (node-at n 2) (n 'line))
                           (n 'line))))
        (when (= hp 'defer) (return ty-void))
        (when (= hp 'move) (return (node-type (node-at n 1) scope)))
        ; TC-2/TC-3: node-type-call is passed a null explicit want here, but its
        ; tier-2 fallback reads the downward want channel (g-want-type) when one
        ; is armed — i.e. during a non-emitting probe run from a let/with binding
        ; init (tc3-emit-binding-init). In every other node-type context the
        ; channel is null, so a want-dependent generic call types as null (the
        ; documented escape hatch: unknown, not divergent), same as pre-LW-2
        ; widened calls. TC-5 will distribute the want through control forms.
        (return (node-type-call n scope h null))))))

(import-use arena)
(import-use vector)

; Generic / polymorphism registry, bounded-generic def-time checking, Stage 11
; tyvar-from-receiver inference + structural unification, and the Valid inferred
; structural-bound checker. Source-imported by src/nucleusc.nuc before node-type
; and emit-* dispatch. Extracted from nucleusc.nuc (Stage 12 N8).
;
; Depends on: compiler-types.nuc (Generic/Method/Conformance/Protocol structs and
; the METHOD-*/MK-* constants), type-utils.nuc, scope.nuc, abi.nuc,
; union-registry.nuc (all imported earlier), and many nucleusc.nuc functions
; (node-type, emit-defn, unify-tpat, parse-type-from-node, …) which resolve via
; nucleusc.nuc's whole-unit defn-signature prescan. It calls nothing from the
; later-imported cheader.nuc / nuch.nuc / repl.nuc, so its early import is safe.

; ============================================================
; Generic (polymorphism) registry
; ============================================================

; Exact registry probe: the Generic stored under precisely this key, or null.
; The DEFINE side uses this (the caller has already computed the key it wants);
; use sites go through generic-lookup below, which first tries the current file's
; private key.
(defn generic-lookup-exact (name:CStr):?ptr:Generic
  (doseq (g g-generics (VecIter (ref Generic)))
     (when (= (g name) name)
           (return (as ptr g))))
  (return null))

(defn generic-lookup (name:CStr):?ptr:Generic
  ; Stage 15 W5e: a name this file declared with `defn-` is keyed under the
  ; file's implicit namespace, and shadows a public generic of the same name.
  ; priv-key-use is the identity for every other name, so this is one extra
  ; compare — and, when the unit has no private definer at all, one null check.
  (let (k:CStr (priv-key-use name))
    (when (!= k name)
      (let (pg:?ptr:Generic (generic-lookup-exact k))
        (when (!= pg null) (return pg)))))
  (return (generic-lookup-exact name)))

; Does method `m` come from namespace `ns`? A `Method` with no `src-ns` is an
; intrinsic operator seed (`build-generics`), which belongs to no file; `user` is
; the unqualified space, so that is what it answers to.
(defn method-in-ns (m:ptr:Method ns:CStr):i32
  (let (s:CStr (m src-ns))
    (when (= (as ptr s) null) (set! s "user"))
    (when (= (strcmp s ns) 0) (return 1))
    (return 0)))

; `g` restricted to the methods namespace `ns` defined, or null when it defined
; none. The common answers are the two that allocate nothing: all of them (the
; generic is returned as it stands) or none.
;
; A filtered view is a fresh `Generic` over the SAME `Method` pointers, and it is
; deliberately not registered and not memoized. Nothing downstream reads a
; Generic by identity — `generic-resolve`, `emit-generic-call` and
; `node-type-call` read `name` / `methods` / `mangled` — while a cached view
; would go stale the moment a later import adds a method to the underlying
; generic (`generic-add-method` exists precisely because that happens).
(defn generic-filter-by-ns (g:ptr:Generic ns:CStr):?ptr:Generic
  (let (gg:ptr:Generic g
        n:i32 (unsafe/cast i32 (count (gg methods)))
        keep:i32 0)
    (dotimes (i n)
      (when (!= (method-in-ns (as ptr:Method (invoke (gg methods) (as usize i))) ns) 0)
        (inc! keep)))
    (when (= keep 0) (return null))
    (when (= keep n) (return (as ptr gg)))
    (let (f:ref:Generic (generic-alloc (gg name)))
      (.set! f finalized (gg finalized))
      (.set! f mangled (gg mangled))
      (.set! f ir-prefix (gg ir-prefix))
      (dotimes (i n)
        (let (m:ptr:Method (as ptr:Method (invoke (gg methods) (as usize i))))
          (when (!= (method-in-ns m ns) 0) (conj (f methods) (as ref:Method m)))))
      (return (as ptr f)))))

; Stage 15 B4 — resolve a generic REFERENCE (a source spelling) through the
; file's import environment (name-resolution.md §8.2's R2; defect #5, "generics
; are unqualifiable").
;
; A generic is deliberately NOT re-keyed by namespace. R2 keeps one `Generic` per
; bare name with the methods of every flattened namespace merged into it, because
; that is what an open multimethod wants and it is what lets `(import-use dp)`
; and `(import-use dq)` — each declaring a `describe` method — coexist at all.
; The qualified spelling is recovered from `Method.src-ns` instead, the
; provenance W5e already records for the duplicate-signature diagnostic: `zx/zov`
; resolves to the bare `zov` generic with its method set filtered to `zn`, the
; namespace the prefix `zx` names.
;
; `qualifier-len` is the only cost on the unqualified path, which is every head
; symbol in this compiler and in `lib/`.
(defn generic-lookup-ref (spelling:CStr):?ptr:Generic
  (when (<= (qualifier-len (as ptr spelling)) 0) (return (generic-lookup spelling)))
  (let (r:ref:NameRef (resolve-spelling (as ptr spelling)))
    ; A qualifier this file did not bind names nothing (R3) — the same answer the
    ; global, protocol and type resolvers give, so the diagnostic tiers agree.
    (when (= (r status) NR-UNBOUND) (return null))
    (let (g:?ptr:Generic (generic-lookup-exact (as CStr (r bare))))
      (when (= g null) (return null))
      (return (generic-filter-by-ns (unsafe/cast ptr:Generic g) (as CStr (r ns)))))))

; Allocate + initialise a Generic WITHOUT registering it. Split out in Stage 15
; W8 G-5 because `build-generics` — which is `g-generics`' own initializer —
; cannot append to `g-generics` while `g-generics` is still being computed.
; `generic-new` below is this plus the registration, so the two cannot drift.
(defn generic-alloc (name:CStr):ref:Generic
  ; Each Generic is individually arena-allocated (pointer-stable for the whole
  ; compilation).
  (let (g:ptr:Generic (new Generic))
    (.set! g name name)
    (.set! g methods (unsafe/cast (ref (Vector (ref Method))) (vector-new-in (addr-of g-arena-alloc))))
    (.set! g finalized 0)
    (.set! g mangled 0)
    ; Stage 12 N4: snapshot the defining namespace's ir-prefix now, so a finalize
    ; or monomorphization that runs in a later import's namespace still mangles
    ; under this generic's own namespace.
    ; Stage 15 W5e: a file-private key (`#p1/helper`) carries its own synthetic
    ; namespace, whose registered prefix is what makes the emitted symbol both
    ; legal and unique — read it from the key rather than from g-current-ns
    ; (which is `user`, the empty prefix, for exactly these definitions).
    (let (pq:CStr (priv-qualifier-of name))
      (if (= (as ptr pq) null)
        (.set! g ir-prefix (ns-ir-prefix g-current-ns))
        (.set! g ir-prefix (ns-ir-prefix pq))))
    (return (as ref:Generic g))))

; …and its pointer appended to g-generics in registration order.
(defn generic-new (name:CStr):ref:Generic
  (let (g:ref:Generic (generic-alloc name))
    (conj g-generics g)
    (return g)))

(defn generic-add-method (g:ptr:Generic m:ptr:Method):void
  (conj (g methods) (as ref:Method m))
    ; A generic finalized by an earlier unit's prescan (its methods given their
    ; mangling) can gain more methods when a later `import` (processed in the
    ; dispatch loop, after this unit's signature prescan already finalized the
    ; generic) registers its own overloads of the same name. Without re-running
    ; finalize, those imported methods keep null ir-names and emit under the bare
    ; `@name`, colliding (e.g. a local parametric `next` finalizes the `next`
    ; generic, then `(import iterator)` adds concrete `next` methods that never get
    ; mangled). Clearing `finalized` lets the import's finalize-generics re-mangle
    ; every method. Safe: this runs in the prescan/import phase, before any of the
    ; affected methods' bodies are emitted, so no already-emitted reference uses a
    ; stale ir-name.

  (.set! g finalized 0))

; Remove the first METHOD-USER from generic `g` whose param count and types
; match `param-types`/`nparams`. No-op if not found. Called by the REPL to
; evict the old method entry before re-prescan'ing a redefined defn, so that
; finalize-generics does not see a duplicate-signature pair.
(defn generic-remove-matching-user-method (g:raw:Generic param-types:ptr nparams:i32):void
  (let (gg:raw:Generic g)
    (dotimes (i (unsafe/cast i32 (count (gg methods))))
      (let (mi:ptr:Method (as ptr:Method (invoke (gg methods) (as usize i))))
        (when (and (= (mi kind) METHOD-USER)
                   (= (mi num-params) nparams)
                   (!= (params-type-eq (mi param-types) param-types nparams) 0))
          (remove-at (gg methods) (as usize i))
          (return))))))

; Seed the operator family as intrinsic generics. Each intrinsic method defers
; to emit-binop (which performs the numeric type selection), so operator IR is
; byte-identical to the pre-dispatch compiler.
; Stage 15 W8 G-5 (§2.12 A2): folded into `g-generics`' initializer. It is the
; one statement of the old `compiler-init` that set no global of its own — it
; expressed a RELATION between two globals (seed g-generics from g-binops), and
; a builder is exactly the shape a relation wants. `g-binops` is declared above
; `g-generics` in nucleusc.nuc, so it is initialized first; `g-current-ns` had
; to be moved above them both, because `generic-alloc` reads it through
; `ns-ir-prefix`.
(defn build-generics ():(ref (Vector (ref Generic)))
  (let (v:(ref (Vector (ref Generic))) (vector-new-in (addr-of g-arena-alloc)))
    (doseq (bop g-binops (VecIter ref:BinOp))
           (let (g:ptr (generic-alloc (bop name))
                 m:ptr:Method (new Method))
      (.set! m param-types null)
      (.set! m num-params 2)
      (.set! m ret-type null)
      (.set! m has-rest 0)
      (.set! m variadic 0)
      (.set! m kind METHOD-INTRINSIC)
      (.set! m ir-name null)
      (.set! m fn-type null)
      (.set! m binop (as ptr bop))
      (.set! m body null)
      (generic-add-method g m)
      (conj v (as ref:Generic g))))
    (return v)))

; Structural type equality. Primitive types are singletons, so pointer equality
; handles them; structs are equal iff they share a StructDef; pointers compare
; their pointee (untyped ptr has elem=null, distinct from typed ptr).
(defn type-eq (a:raw:Type b:raw:Type):i32
  (when (= a b) (return 1))
  (when (or (= a null) (= b null)) (return 0))
  (let (aa:raw:Type a
        bb:raw:Type b)
    ; Stage 13 L7: a bare TY-FN (function pointer, as passed at a call site)
    ; and a (ref TY-FN) (as written in a generic param list after stamping)
    ; are compatible under the unify-tpat TY-FN-into-(ref G) rule. Treat them
    ; as type-eq so defn-ir-name finds the method registered with the bare
    ; argtype when emit-defn re-parses the stamped (ref __fnty_N) param.
    ; Consistent with type-eq's existing TY-FN imprecision (any two TY-FN are eq).
    (when (and (= (aa kind) TY-FN)
               (= (bb kind) TY-PTR) (= (bb pkind) PTR-REF))
      (return (type-eq a (bb elem))))
    (when (and (= (bb kind) TY-FN)
               (= (aa kind) TY-PTR) (= (aa pkind) PTR-REF))
      (return (type-eq (aa elem) b)))
    (when (!= (aa kind) (bb kind)) (return 0))
    (case (aa kind)
      TY-STRUCT (if (= (aa sdef) (bb sdef)) (return 1) (return 0))
      TY-UNION (if (= (aa sdef) (bb sdef)) (return 1) (return 0))
      TY-PTR (return (type-eq (aa elem) (bb elem)))
      ; Stage 15 W8 G-2: same element type AND same length. Reached from the
      ; constant-aggregate renderer, which checks the element type an
      ; `(array T …)` literal declares against the one its destination slot
      ; declares.
      TY-ARRAY (if (and (= (aa arr-len) (bb arr-len))
                        (!= (type-eq (aa elem) (bb elem)) 0))
                 (return 1) (return 0))
      ; Abstract type variables (A2 check only): equal iff the same variable of
      ; the same template (sdef = owning Method*, num-params = tyvar index).
      TY-TYVAR (if (and (= (aa sdef) (bb sdef)) (= (aa num-params) (bb num-params)))
                 (return 1) (return 0))
      (return 1))))

; MC-1 (design/stage14/macro-conditional-casts.md): join two branch types for a
; value-position control-flow merge (cond / match arm / if-some phi). Three
; sites shared this logic verbatim (emit-cond, emit-match over unions,
; emit-niche-match-arm); this is the single source of truth.
;
; Rules:
;   - Equal types (type-eq): keep the type, meeting pointer kinds when TY-PTR
;     (identity when the kinds already agree) — the pre-existing behavior.
;   - Exactly one side an elem-less bare pointer (void*) and the other a typed
;     pointer: absorb to (raw E), E = the typed side's elem. This is the
;     join-site analogue of the void*-flows-into-T* flow-check exemption
;     (pkind-flow-check, type-utils.nuc). The pkind is PTR-RAW *unconditionally*:
;     the elem-less side's pkind is an unaudited Phase-F default (quasiquote is
;     claimed PTR-REF yet can be null), so the join must never manufacture a
;     non-null claim — the absorbed value is nullable-unchecked raw.
;   - Two differently-kinded int types where exactly one side is a bare
;     literal (int-widening.md LW-6 follow-up, found during the LW-5 sweep):
;     adopt the OTHER (typed, non-literal) side's type — mirrors
;     binop-coerce's "an untyped literal adopts the other operand's type".
;     A literal's emitted operand text (a bare decimal constant, no register)
;     is valid LLVM IR at any integer width, so no coercion instruction is
;     needed — only the phi's declared type changes. Two literal branches of
;     different naive widths (e.g. an in-range and an out-of-range constant)
;     adopt the wider kind, same reasoning. Two *non-literal* typed branches
;     of different kinds are NOT widened here — that stays a real type error
;     (int-widening.md §3 non-goals: no implicit narrowing/mixed-sign
;     widening of typed values).
;   - Otherwise (genuinely different types, or a void branch): collapse to void.
;
; Lives in generics.nuc (not type-utils.nuc as the design sketch suggested)
; because it calls type-eq, which is defined here and is not yet in scope at
; type-utils.nuc's earlier import point; generics is imported before both
; union-emit and the nucleusc.nuc emit-cond site, so all three callers see it.
;
; result-lit/bty-lit: whether the Val that produced each side was an integer
; literal (Val.is-lit, LW-4). Callers accumulating across more than two
; branches thread the running "is everything folded in so far a literal"
; flag as `(and (!= result-lit 0) (!= bty-lit 0))` after each call — true
; only while every branch joined so far was itself a literal.
(defn type-join (result-type:raw:Type bty:raw:Type result-lit:i32 bty-lit:i32):raw:Type
  ; Equal types: meet pointer kinds (identity when they already agree).
  (when (!= (type-eq result-type bty) 0)
    (when (= (result-type kind) TY-PTR)
      (return (type-as-pkind result-type
                (pkind-meet (ptr-pkind result-type) (ptr-pkind bty)))))
    (return result-type))
  ; Literal-vs-typed / literal-vs-literal int widening (LW-6).
  (when (and (!= (is-int-type result-type) 0) (!= (is-int-type bty) 0))
    (when (and (!= result-lit 0) (= bty-lit 0)) (return bty))
    (when (and (= result-lit 0) (!= bty-lit 0)) (return result-type))
    (when (and (!= result-lit 0) (!= bty-lit 0))
      (if (>= (type-size result-type) (type-size bty))
        (return result-type)
        (return bty))))
  ; Absorption: an elem-less bare ptr on exactly one side meets a typed ptr at
  ; (raw E), E = the typed side's elem.
  (when (and (= (result-type kind) TY-PTR)
             (= (bty kind) TY-PTR))
    (let (relem:ptr (result-type elem)
          belem:ptr (bty elem))
      (when (and (= relem null) (!= belem null))
        (let (jt:ref:Type (make-type TY-PTR))
          (.set! jt elem belem)
          (.set! jt pkind PTR-RAW)
          (return jt)))
      (when (and (!= relem null) (= belem null))
        (let (jt:ref:Type (make-type TY-PTR))
          (.set! jt elem relem)
          (.set! jt pkind PTR-RAW)
          (return jt)))))
  ; Genuinely different types (or a void branch): collapse to void.
  (return ty-void))

(defn params-type-eq (pa:ptr pb:ptr n:i32):i32
  (dotimes (i n)
    (when (= (type-eq (aref (as ptr:ptr pa) i) (aref (as ptr:ptr pb) i)) 0)
      (return 0)))
  (return 1))

; A safe, distinct IR token for a generic name. Operators (whose source symbols
; — `=`, `<`, `_+`, … — are not valid LLVM identifier characters and would
; collide under blanket underscore-sanitizing) map to readable mnemonics; a `?`/`!`
; in the name is mapped to `_QMARK`/`_BANG` by ir-name-token before the blanket
; sanitize handles any remaining stragglers. Used when a name carrying an
; operator method is overloaded and its methods must take mangled symbols (§10.3).
(defn op-name-token (name:CStr):CStr
  (when (= name "_+") (return "add"))
  (when (= name "_-") (return "sub"))
  (when (= name "_*") (return "mul"))
  (when (= name "_/") (return "div"))
  (when (= name "%")  (return "rem"))
  (when (= name "=")  (return "eq"))
  (when (= name "!=") (return "ne"))
  (when (= name "<")  (return "lt"))
  (when (= name "<=") (return "le"))
  (when (= name ">")  (return "gt"))
  (when (= name ">=") (return "ge"))
  (when (= name "bit-and") (return "band"))
  (when (= name "bit-or")  (return "bor"))
  (when (= name "bit-xor") (return "bxor"))
  (when (= name "bit-shl") (return "bshl"))
  (when (= name "bit-shr") (return "bshr"))
  (return (sanitize-for-ir (ir-name-token name))))

; "@prefix__name.tok1.tok2..." for an overloaded method. Stage 12 N4: the base
; token is the operator mnemonic of `fname` (so `=` → `eq`); the defining
; namespace's `ir-prefix` (threaded explicitly, since a monomorphization may be
; stamped while another namespace is current) is composed *before* the
; per-parameter `.tok` mangling, giving `@foo__eq.i32.i32` in namespace `foo`. The
; prefix is applied to the *mnemonic*, not the raw operator spelling. An empty
; prefix (the `user` namespace) is the identity → byte-identical bootstrap.
(defn mangle-fn-name (ir-prefix:CStr fname:CStr param-types:ptr nparams:i32):CStr
  (let (acc:ptr (fmt-s "@%s" (ns-compose ir-prefix (op-name-token fname))))
    (dotimes (i nparams)
      (set! acc (fmt-2s "%s.%s" acc (type-mangle-token (aref (as ptr:ptr param-types) i)))))
    (return acc)))

(defn generic-find-method-exact (g:raw:Generic param-types:ptr nparams:i32):?ptr:Method
  (let (gg:raw:Generic g)
    (dotimes (i (unsafe/cast i32 (count (gg methods))))
      (let (m:ptr:Method (as ptr:Method (invoke (gg methods) (as usize i))))
        (when (and (= (m kind) METHOD-USER)
                   (= (m num-params) nparams)
                   (!= (params-type-eq (m param-types) param-types nparams) 0))
          (return (as ptr m)))))
    (return null)))

; Stage 11 T4: would a *generic* (METHOD-GENERIC) method of `g` resolve for the
; concrete `param-types`? Mirrors generic-resolve's tier-1 — bind the tyvars, then
; check the &where constraints — but does NOT instantiate (no MonoJob queued, no
; emission), so it is a pure side-effect-free conformance probe. Used by
; method-satisfies-sig so a required protocol method written generically over a
; parametric struct (`get`/`count` over `(Vector T)`) counts as satisfied for a
; stamped instance, exactly as the real call would resolve. On a match writes the
; method's *bound* return Type* through `out-ret` (the body return spelling with
; the tyvars substituted) so the caller can verify it against a required return.
; arg-nodes (LW-6): the call-site argument nodes, or null when this probe has no
; real call site (method-satisfies-sig's signature-only check) — threaded to
; generic-method-bind so a literal argument defers to &where assoc-recovery here
; exactly as it does on the emit side (node-type↔emit-node lockstep; otherwise
; node-type-call's probe below dies on a widened call before emission ever runs).
(defn generic-binds-for (g:raw:Generic param-types:ptr nparams:i32 out-ret:ptr:ptr line:i32 arg-nodes:ptr):i32
  (let (gg:raw:Generic g)
    (dotimes (j (unsafe/cast i32 (count (gg methods))))
      (let (m:ptr:Method (as ptr:Method (invoke (gg methods) (as usize j))))
        (when (= (m kind) METHOD-GENERIC)
          (let (bound:ptr (arena-alloc (* (as i64 (+ (m num-tyvars) 1)) (ptr-bytes))))
            (when (and (= (m num-params) nparams)
                       (!= (generic-method-bind (as ptr m) param-types nparams bound null arg-nodes) 0))
              (when (!= (generic-constraints-ok (as ptr m) bound line) 0)
                ; Resolve the bound return type from the method's return spelling
                ; (mirrors abstract-call-via-generic): a bare tyvar return picks
                ; its bound Type*, otherwise parse the (already-concrete) spelling.
                ; Shared with the adapted-template path (LW-2) via method-bound-ret-type.
                (when (!= out-ret null)
                  (ptr-set! out-ret (method-bound-ret-type (as ptr m) bound line)))
                (return 1)))))))
    (return 0)))

; Fixed parameter count of a defn param list: the raw count, minus one if a
; &rest marker is present (the marker itself is not a parameter).
(defn defn-params-count (params-node:raw:Node):i32
  (let (raw:i32 (node-len params-node)
        n:i32 (node-len params-node))
    (dotimes (i raw)
      ; W5f: a malformed parameter may be NULL (an empty list `()` reads as a
      ; null node). It is certainly not an &rest/&optional marker; the located
      ; diagnostic is emit-defn's job, so just don't dereference it here.
      (let (sp:(raw Node) (as raw:Node (node-at params-node i)))
        (when (and (!= sp null) (= (sp kind) NODE-SYM))
          (when (= (sp s) "&rest") (set! n (- n 1)))
          (when (= (sp s) "&optional") (set! n (- n 1))))))
    (return n)))

; The fixed parameter types of a defn param list as a ptr-array (&rest-aware:
; the &rest marker is skipped and the rest parameter is typed ptr). Shared by
; prescan, .nuch export, and method lookup so the three stay consistent.
(defn defn-params-to-types (params-node:raw:Node):ptr
  (let (raw:i32 (node-len params-node)
        has-rest:i32 0
        rest-idx:i32 -1
        opt-idx:i32 -1)
    (dotimes (si raw)
      ; W5f: see defn-params-count — a NULL (empty-list) parameter is not a
      ; marker and must not be dereferenced during the prescan.
      (let (sp:(raw Node) (as raw:Node (node-at params-node si)))
        (when (and (!= sp null) (= (sp kind) NODE-SYM))
          (when (= (sp s) "&rest") (set! has-rest 1) (set! rest-idx si))
          (when (= (sp s) "&optional") (set! opt-idx si)))))
    (let (nparams:i32 raw)
      (when (!= has-rest 0) (set! nparams (- nparams 1)))
      (when (!= opt-idx -1) (set! nparams (- nparams 1)))
      (let (ptypes:ptr null)
        (when (> nparams 0)
          (set! ptypes (arena-alloc (* (as i64 nparams) (ptr-bytes)))))
        (let (di:i32 0)
          (dotimes (i raw)
            (let (skip:i32 0)
              (when (and (!= has-rest 0) (= i rest-idx)) (set! skip 1))
              (when (= i opt-idx) (set! skip 1))
              (when (= skip 0)
                (let (p:ptr (node-at params-node i)
                      pn:ptr null
                      spec:ptr (node-at params-node i))
                  ; Optional params are (name:type default) lists — type is on the head.
                  (when (and (!= opt-idx -1) (> i opt-idx))
                    (set! spec (node-at p 0)))
                  ; W5f: a NULL (empty-list) parameter gets the same `i32`
                  ; placeholder this loop already uses for an untyped one — the
                  ; prescan only registers a signature; emit-defn raises the real,
                  ; located diagnostic before any of this reaches codegen.
                  (let (pty:ptr (if (= spec null)
                                  (as ptr null)
                                  (extract-name-and-type spec (as ptr:ptr (addr-of pn))
                                                         (node-line spec 0))))
                    (when (= pty null) (set! pty ty-i32))
                    (when (and (!= has-rest 0) (= di (- nparams 1)))
                      (set! pty ty-ptr))
                    (aset! (as ptr:ptr ptypes) di pty)
                    (inc! di))))))
        (return ptypes))))))

; Register one defn signature as a USER method of its name's generic. Called
; from prescan-defn-signatures; mangling/scope binding is decided later by
; finalize-generics once the full method set per name is known.
(defn generic-register-method (fname:CStr ret:raw:Type param-types:ptr nparams:i32
                                   has-rest:i32 variadic:i32 body:raw:Node):ref:Method
  ; Stage 15 W5e: a private definer in the default `user` namespace registers
  ; under its file's implicit-namespace key, so two files' private `helper`s are
  ; two Generics and neither the duplicate-signature check nor dispatch ever sees
  ; the other. Identity for a public definer → the registry, and the bootstrap,
  ; are unchanged. generic-lookup-exact (not generic-lookup) because the key is
  ; already final here: a public `helper` in a file that also defines a private
  ; one must not be folded into the private generic.
  (let (key:CStr (priv-key-define fname)
        g:ptr (generic-lookup-exact key))
    (when (= g null) (set! g (generic-new key)))
    (let (ft:ptr:Type (as ptr:Type (make-type TY-FN)))
      (.set! ft ret ret)
      (type-set-params ft param-types nparams)
      (.set! ft variadic variadic)
      (.set! ft has-rest has-rest)
      (let (m:ref:Method (new Method))
        (.set! m param-types param-types)
        (.set! m num-params nparams)
        (.set! m ret-type ret)
        (.set! m has-rest has-rest)
        (.set! m variadic variadic)
        (.set! m kind METHOD-USER)
        (.set! m ir-name null)
        (.set! m fn-type (as ptr ft))
        (.set! m binop null)
        (.set! m body body)
        ; W5e: provenance for the duplicate-signature diagnostic, which must name
        ; the OTHER definition's file — a Method.body Node carries a line but no
        ; file — and phrase the namespace rule according to whether the pair is
        ; public or private.
        (.set! m src-file g-source-path)
        (.set! m src-ns g-current-ns)
        (.set! m priv g-defining-private)
        (generic-add-method g m)
        (return m)))))

; Stage 15 W5e: the message for two definitions of one name with identical
; parameter types. Both definitions' FILES are named (a Method.body Node carries a
; line but no file, which is why generic-register-method records src-file), and
; the note states the rule that was actually violated:
;
;   * a private pair can only reach here from an EXPLICIT namespace — in the
;     default `user` namespace W5e keys each file's private names separately, so
;     two files' private `helper`s are two Generics and never meet. So the note
;     for a private pair is precisely "privacy is per namespace, not per file".
;   * anything else is a public collision, which stays an error by design: a
;     public name must be unique across the whole unit.
(defn duplicate-signature-message (g:raw:Generic later:raw:Method earlier:raw:Method):CStr
  (let (gg:raw:Generic g
        a:raw:Method later
        b:raw:Method earlier
        bare:CStr (strip-priv-qualifier (gg name))
        bnode:(raw Node) (b body)
        bline:i32 0
        afile:CStr (a src-file)
        bfile:CStr (b src-file)
        ansname:CStr (a src-ns))
    (when (!= bnode null) (set! bline ((unsafe/cast ptr:Node bnode) line)))
    (when (= afile null) (set! afile "<unknown file>"))
    (when (= bfile null) (set! bfile "<unknown file>"))
    (when (= ansname null) (set! ansname "user"))
    (let (head:CStr (fmt-2s "duplicate definition of '%s' — the same parameter types are already defined at %s"
                            bare (fmt-sd "%s:%d" bfile bline))
          note:CStr null)
      (if (and (!= (a priv) 0) (!= (b priv) 0))
        (set! note (fmt-s "`defn-` makes a name private to its NAMESPACE, not to its file, and both definitions are in namespace '%s'. Rename one, or give one file an (ns ...) of its own."
                          ansname))
        (set! note (fmt-s "'%s' is public, and a public name must be unique across the whole compilation unit. Declare one with `defn-` — in the default `user` namespace a private name is scoped to its own file, so the two files may each have their own — or rename one."
                          bare)))
      (return (fmt-2s "%s\n  note: %s" head note)))))

; Decide mangling for every not-yet-finalized user generic. A solitary concrete
; name keeps its unmangled @name and is bound in g-globals (so forward references
; and the byte-identical single-function path keep working). An overloaded set —
; or any name carrying a bounded-generic template — gets mangled per-method names
; and dispatches through the registry (templates are stamped on demand).
(defn finalize-generics ():void
  (let (gi:i32 0)
    (while (< gi (unsafe/cast i32 (count g-generics)))
      (let (gg:ptr:Generic (as ptr:Generic (invoke g-generics (as usize gi))))
        (when (and (= (gg finalized) 0) (> (unsafe/cast i32 (count (gg methods))) 0))
          ; Tally the method kinds. An operator name carries an intrinsic seed
          ; method (§9.2); a user overload of that operator adds METHOD-USER
          ; methods alongside it (§10.3 operators-as-functions).
          (let (has-generic:i32 0
                has-intrinsic:i32 0
                n-user:i32 0
                gk:i32 0)
            (while (< gk (unsafe/cast i32 (count (gg methods))))
              (let (mk:ptr:Method (as ptr:Method (invoke (gg methods) (as usize gk))))
                (case (mk kind)
                  METHOD-GENERIC   (set! has-generic 1)
                  METHOD-INTRINSIC (set! has-intrinsic 1)
                  (inc! n-user)))
              (inc! gk))
            ; A pure operator (only intrinsic seeds, no user/generic methods) needs
            ; no mangling and dispatches via the emit-binop peephole. Leave it
            ; unfinalized so a later user overload (possibly from an import) is
            ; picked up; everything else finalizes now.
            (when (or (> n-user 0) (!= has-generic 0))
              (if (and (= has-intrinsic 0)
                       (= has-generic 0) (= n-user 1))
                (let (m0:ptr:Method (as ptr:Method (invoke (gg methods) 0)))
                  (.set! gg mangled 0)
                  ; Stage 12 N4: a solitary (unmangled, C-callable) generic keeps
                  ; `@name`, namespace-prefixed in a non-`user` namespace. The
                  ; scope key (gg name) stays the bare/qualified storage key
                  ; (qualified by scope-define); only the ir-name is prefixed.
                  ; W5e: a file-private key (`#p1/helper`) carries its namespace
                  ; in the key itself, so the ir-name base is the BARE name and
                  ; the synthetic prefix (snapshotted into gg ir-prefix by
                  ; generic-new) supplies `a_p1__`. strip-priv-qualifier is the
                  ; identity for every non-private key.
                  (.set! m0 ir-name (fmt-s "@%s" (ns-compose (gg ir-prefix)
                                                   (ir-name-token (strip-priv-qualifier (gg name))))))
                  (scope-define g-globals (gg name) (m0 fn-type) (m0 ir-name) 0))
                (do
                  (.set! gg mangled 1)
                  (let (i:i32 0)
                    (while (< i (unsafe/cast i32 (count (gg methods))))
                      (let (mi:ptr:Method (as ptr:Method (invoke (gg methods) (as usize i))))
                        (when (= (mi kind) METHOD-USER)
                          (let (j:i32 0)
                            (while (< j i)
                              (let (mj:ptr:Method (as ptr:Method (invoke (gg methods) (as usize j))))
                                (when (and (= (mj kind) METHOD-USER)
                                           (= (mi num-params) (mj num-params))
                                           (!= (params-type-eq (mi param-types)
                                                               (mj param-types)
                                                               (mi num-params)) 0))
                                  (die-at (-> mi (_ body) (unsafe/cast ptr:Node _) (_ line))
                                    (duplicate-signature-message gg mi mj))))
                              (inc! j)))
                          (.set! mi ir-name
                            (mangle-fn-name (gg ir-prefix) (strip-priv-qualifier (gg name))
                                            (mi param-types) (mi num-params)))))
                      (inc! i)))))
              (.set! gg finalized 1)))))
      (inc! gi))))

; Can an argument of type `at` (an untyped int literal when is-lit≠0, an untyped
; float literal when is-flit≠0) be passed to a parameter of type `pt` by exact
; match or a safe widen / literal adaptation (§10.3 resolution tiers)? Widening
; never narrows a typed value; an untyped int literal adapts to any integer (and
; to a float) since its value is known, and since Stage 15 W2d an untyped float
; literal likewise adapts to a narrower float parameter.
(defn arg-adapts (at:raw:Type pt:raw:Type is-lit:i32 is-flit:i32):i32
  (when (= at null) (return 0))
  (when (!= (type-eq at pt) 0) (return 1))
  ; Stage 14 NS-3 (design/stage14/native-strings.md): a StrView (notably a string
  ; literal, which borrows to a char* for free) adapts to a **CStr** parameter in
  ; multimethod dispatch — and to CStr *only*, NOT to a bare `ptr`. This exactly
  ; reproduces the pre-flip dispatch of a CStr literal, which tier-0 exact-matched a
  ; CStr param but did NOT adapt to a `ptr` param (conventions.md: "pass a literal to
  ; a plain ptr function freely, but to a ptr multimethod cast explicitly"). Adapting
  ; to *both* CStr and bare ptr would make a generic overloaded on `(x:CStr)` and
  ; `(x:ptr)` ambiguous for a literal arg, where before the flip it resolved to the
  ; CStr overload. The collection literals `#{ "a" "b" }` / `[ "x" ]` still resolve:
  ; the reader infers a CStr element type (lib/reader.nuc lit-kind-type), so conj's
  ; bound `elem` param is CStr — this rule adapts the StrView literal to it. The
  ; compiler declares no StrView-parameter overload, so this cannot be ambiguous.
  (when (and (!= (type-is-strview at) 0)
             (= (pt kind) TY-CSTR))
    (return 1))
  (let (a-int:i32 (is-int-type at)   a-flt:i32 (is-float-type at)
        p-int:i32 (is-int-type pt)   p-flt:i32 (is-float-type pt))
    (when (and (!= a-int 0) (!= p-int 0))
      (when (!= is-lit 0) (return 1))
      (when (and (>= (int-width pt) (int-width at)) (= (is-unsigned at) (is-unsigned pt)))
        (return 1))
      (return 0))
    (when (and (!= a-flt 0) (!= p-flt 0))
      (when (>= (float-width pt) (float-width at)) (return 1))
      ; Stage 15 W2d (design/stage15-stress-test/literal-typing.md §3.6): an
      ; untyped float literal adapts DOWN to a narrower float parameter, exactly
      ; as an untyped int literal adapts to any integer above. Without this a
      ; solitary `(defn take (x:f32) …)` accepted `(take 2.5)` while an
      ; *overloaded* one rejected it ("no matching method … (f64)") — the same
      ; wart one level over that W2b closed for `defenum` members. Strictly
      ; additive: tier 0 (generic-find-method-exact) still claims an exact f64
      ; overload first, so no existing call is re-routed; this only turns
      ; previously-unresolvable calls into resolvable ones. A typed f64 VALUE
      ; still does not adapt — dispatch never narrows a runtime value, the same
      ; rule the integer branch above enforces with its int-width test, and
      ; deliberately stricter than the silent `fptrunc` coerce-int-val performs
      ; once the callee has already been chosen.
      (if (!= is-flit 0) (return 1) (return 0)))
    (when (and (!= a-int 0) (!= p-flt 0))
      (if (!= is-lit 0) (return 1) (return 0))))
  (return 0))

; Build a comma-separated string of type spellings for a diagnostic, e.g.
; "StrView, ptr". argtypes is the parallel array of Type* used by generic-resolve.
(defn arg-type-spellings (argtypes:ptr nargs:i32):CStr
  (let (buf:ptr (alloca i8 512)
        pos:i32 0)
    (dotimes (i nargs)
      (when (!= i 0)
        (set! pos (+ pos (snprintf (unsafe/ptr+ (as ptr:i8 buf) (as i64 pos))
                                   (as i64 (- 512 pos)) ", "))))
      (let (ts:ptr (type-spelling (aref (as ptr:ptr argtypes) i)))
        (set! pos (+ pos (snprintf (unsafe/ptr+ (as ptr:i8 buf) (as i64 pos))
                                   (as i64 (- 512 pos)) "%s" ts)))))
    (return (arena-strndup buf (as i64 pos)))))

; Select the method of a generic for a concrete argument-type tuple.
; Tier 0: an exact concrete method (type-eq on every param) — concrete beats
; generic (§8.6). Tier 1: a bounded-generic template whose type variables bind
; consistently and whose bound types satisfy the &where protocol constraints;
; on a unique tier-1 match the template is monomorphized (stamped + cached) and
; the resulting concrete method returned. Tier 2: a concrete method reachable by
; a safe widen / untyped-int-literal adaptation on every argument (§10.3); the
; caller (emit-generic-call) coerces the args to the chosen params. arg-nodes is
; the parallel array of argument source nodes (or null) used to spot literals.
(defn generic-resolve (g:raw:Generic argtypes:ptr arg-nodes:ptr nargs:i32 line:i32 want:raw:Type):ref:Method
  (let (gg:raw:Generic g
        found:?ptr:Method null)
    (dotimes (i (unsafe/cast i32 (count (gg methods))))
      (let (m:ptr:Method (as ptr:Method (invoke (gg methods) (as usize i))))
        (when (and (= (m kind) METHOD-USER)
                   (= (m num-params) nargs)
                   (!= (params-type-eq (m param-types) argtypes nargs) 0))
          (set! found (as ptr m)))))
    (when (!= found null) (return found))
    ; tier 1: bounded-generic templates.
    (let (cand:ptr null
          cand-bound:ptr null
          ncand:i32 0
          constraint-fail:i32 0
          ; TC-1: track a generic template that carries a tyvar no parameter
          ; determines (a return-only tyvar). If resolution fails and such a
          ; candidate exists, the call needed the want channel (which was null or
          ; did not unify) — report the dedicated "cannot infer" diagnostic
          ; instead of the misleading "no matching method".
          infer-tyvar:ptr null)
      (dotimes (j (unsafe/cast i32 (count (gg methods))))
        (let (m:ptr:Method (as ptr:Method (invoke (gg methods) (as usize j))))
          (when (= (m kind) METHOD-GENERIC)
            (let (bound:ptr (arena-alloc (* (as i64 (+ (m num-tyvars) 1)) (ptr-bytes))))
              (if (!= (generic-method-bind (as ptr m) argtypes nargs bound want arg-nodes) 0)
                (if (!= (generic-constraints-ok (as ptr m) bound line) 0)
                  (do (set! cand (as ptr m)) (set! cand-bound bound) (inc! ncand))
                  (set! constraint-fail 1))
                ; Bind failed: if this template has a return-only tyvar, record
                ; its name for the cannot-infer diagnostic.
                (let (ut:ptr (method-undetermined-tyvar (as ptr m)))
                  (when (and (!= ut null) (= infer-tyvar null))
                    (set! infer-tyvar ut))))))))
      (when (> ncand 1)
        (die-at line (fmt-s "ambiguous generic match for '%s'" (gg name))))
      (when (= ncand 1)
        (return (generic-instantiate g cand cand-bound argtypes nargs line)))
      ; tier 2: widen / untyped-int-literal adaptation (§10.3). Concrete
      ; (METHOD-USER) methods and parametric-struct templates (METHOD-GENERIC,
      ; LW-1) share one ambiguity pool; a unique template winner is monomorphized
      ; here against its tyvar-substituted parameter types.
      (let (wmethod:ptr null
            wbound:ptr null
            r:i32 (generic-resolve-adapt-tier g argtypes arg-nodes nargs line
                    (as ptr:ptr (addr-of wmethod)) (as ptr:ptr (addr-of wbound)) want))
        (when (= r 3)
          (die-at line (fmt-s "ambiguous overload for '%s' under argument widening" (gg name))))
        (when (= r 1) (return (as ref:Method wmethod)))
        (when (= r 2)
          (return (generic-instantiate g wmethod wbound
                    (subst-param-types-bound wmethod wbound line) nargs line))))
      (when (!= infer-tyvar null)
        (die-at line
          (fmt-2s "cannot infer type variable '%s' for '%s': no expected type at this position — annotate the binding"
                  infer-tyvar (gg name))))
      (when (!= constraint-fail 0)
        (die-at line
          (fmt-s "no matching method for '%s': arguments do not satisfy the required protocol constraint"
                 (gg name))))
      (die-at line (fmt-2s "no matching method for overloaded '%s' with argument types (%s)"
                           (gg name)
                           (arg-type-spellings argtypes nargs))))))

; Resolve an operator call to a USER overload (exact, then a unique widen/literal
; match), or null to fall back to the built-in numeric/pointer peephole. Unlike
; generic-resolve this never dies — an unmatched operator is the common case and
; simply uses its intrinsic seed. Shared by emit (call vs inline) and node-type
; (the overload's return type vs the intrinsic's) so the two cannot drift.
(defn operator-user-resolve (g:raw:Generic argtypes:ptr arg-nodes:ptr nargs:i32):?ptr:Method
  (let (gg:raw:Generic g)
    (dotimes (i (unsafe/cast i32 (count (gg methods))))
      (let (m:ptr:Method (as ptr:Method (invoke (gg methods) (as usize i))))
        (when (and (= (m kind) METHOD-USER)
                   (= (m num-params) nargs)
                   (!= (params-type-eq (m param-types) argtypes nargs) 0))
          (return (as ptr m)))))
    (let (wcand:ptr null
          wn:i32 0)
      (dotimes (k (unsafe/cast i32 (count (gg methods))))
        (let (m:ptr:Method (as ptr:Method (invoke (gg methods) (as usize k))))
          (when (and (= (m kind) METHOD-USER)
                     (= (m has-rest) 0) (= (m num-params) nargs))
            (let (ok:i32 1)
              (dotimes (a nargs)
                (let (is-lit:i32 0
                      is-flit:i32 0)
                  (when (!= arg-nodes null)
                    (set! is-lit (node-is-int-literal (aref (as ptr:ptr arg-nodes) a)))
                    ; W2d: mutually exclusive, and node-is-float-literal
                    ; macroexpands a cell operand — skip the second walk when the
                    ; first already answered.
                    (when (= is-lit 0)
                      (set! is-flit (node-is-float-literal (aref (as ptr:ptr arg-nodes) a)))))
                  (when (= (arg-adapts (aref (as ptr:ptr argtypes) a)
                                       (aref (as ptr:ptr (m param-types)) a) is-lit is-flit) 0)
                    (set! ok 0))))
              (when (!= ok 0) (set! wcand (as ptr m)) (inc! wn))))))
      (when (= wn 1) (return wcand)))
    (return null)))

; The emitted symbol for a defn being codegen'd: the mangled name for an
; overloaded method, else the unmangled @name (also the fallback when no
; generic was registered, e.g. compile-time/REPL defns).
(defn defn-ir-name (fname:CStr param-types:ptr nparams:i32):ptr
  (let (g:ptr (generic-lookup fname))
    (when (!= g null)
      (let (m:ptr (generic-find-method-exact g param-types nparams))
        (when (and (!= m null) (!= (-> m (unsafe/cast ptr:Method _) (_ ir-name)) null))
          (return (-> m (unsafe/cast ptr:Method _) (_ ir-name)))))))
  ; Stage 12 N4: a solitary (non-overloaded) defn keeps `@name` but, in a
  ; non-`user` namespace, prefixes the base with the namespace ir-prefix
  ; (`@foo__name`). ns-ir-base is the identity under `user` (empty prefix), so the
  ; bootstrap stays byte-identical. Stage 15 W5e: def-ir-base additionally applies
  ; the owning file's private prefix when a private definer is being processed, so
  ; this fallback cannot hand two files' private `helper`s the same `@helper`.
  (return (fmt-s "@%s" (def-ir-base fname))))

(defn defn-is-mangled (fname:CStr):i32
  (let (g:ptr (generic-lookup fname))
    (when (!= g null)
      (return (-> g (as ptr:Generic _) (_ mangled)))))
  (return 0))

; If a defn form's name is overloaded, return that method's mangled @-symbol;
; else null. Used by .nuch export to declare overloads under their real symbols.
(defn defn-form-mangled-name (form:raw:Node):ptr
  ; S1: the bare name is all this needs — the former ret extraction served only as
  ; a malformed-name guard, which defn-name-only's null return now covers. Works
  ; for both signature styles.
  (let (fname:ptr (defn-name-only (node-at form 1)))
    (when (= fname null) (return null))
    (let (g:ptr (generic-lookup fname))
      (when (= g null) (return null))
      (when (= (-> g (as ptr:Generic _) (_ mangled)) 0) (return null))
      (let (params-node:ptr (node-at form 2)
            m:ptr (generic-find-method-exact g (defn-params-to-types params-node)
                                             (defn-params-count params-node)))
        (when (= m null) (return null))
        (return (-> m (unsafe/cast ptr:Method _) (_ ir-name)))))))

; ============================================================
; Bounded generic defn (Stage 9 rung 4)
; ============================================================
; A generic defn carries a `&where` clause in its parameter list:
;   (defn max:T (a:T b:T &where (Ord T)) ...)
; Type variables are declared-only (named in a constraint). The template body is
; retained and monomorphized — substitute concrete types, stamp, cache — at each
; call site whose argument types bind the variables and satisfy the constraints.

; Index of the `&where` marker in a (desugared) parameter list, or -1.
(defn params-where-index (params-node:raw:Node):i32
  (let (raw:i32 (node-len params-node))
    (dotimes (i raw)
      ; W5f: an empty list `()` among the params is a NULL node — never a
      ; `&where` marker, and not to be dereferenced.
      (let (e:(raw Node) (as raw:Node (node-at params-node i)))
        (when (and (!= e null) (= (e kind) NODE-SYM) (= (e s) "&where"))
          (return i))))
    (return -1)))

; The bare function name from a defn name node, without parsing its return type
; (which may mention a type variable). Handles both `name:T` and desugared
; `(name T)` forms.
(defn defn-name-only (name-node:raw:Node):ptr
  (let (n:raw:Node name-node)
    (case (n kind)
      NODE-SYM
        (let (nm:ptr null tn:ptr null)
          (split-typed (n s) (as ptr:ptr (addr-of nm)) (as ptr:ptr (addr-of tn)))
          (return nm))
      NODE-CELL
        (let (c:raw:Node (n car))
          (when (= (c kind) NODE-SYM) (return (c s))))
      0)
    (return null)))

; The type node of a desugared binding `(name type)`, or null if untyped.
(defn binding-type-node (bind-node:raw:Node):raw:Node
  ; W5f: an empty list `()` in a binding position is a NULL node — it carries no
  ; type node, and must not be dereferenced.
  (when (= bind-node null) (return null))
  (let (n:raw:Node bind-node)
    (when (= (n kind) NODE-CELL) (return (node-at bind-node 1)))
    (return null)))

; Does any symbol anywhere in this node name a declared type variable?
(defn node-mentions-tyvar (node:raw:Node tyvars:ptr ntv:i32):i32
  (when (= node null) (return 0))
  (let (n:raw:Node node)
    (case (n kind)
      NODE-SYM
        (if (>= (tyvar-index-of (n s) tyvars ntv) 0) (return 1) (return 0))
      NODE-CELL
        (do
          (when (!= (node-mentions-tyvar (n car) tyvars ntv) 0) (return 1))
          (return (node-mentions-tyvar (n cdr) tyvars ntv)))
      0)
    (return 0)))

; The first n cells of a list as a freshly-consed list (drops the tail).
(defn take-first-n (list:raw:Node n:i32 line:i32):raw:Node
  (when (<= n 0) (return null))
  (when (= list null) (return null))
  (let (l:raw:Node list)
    (return (make-cell (l car) (take-first-n (l cdr) (- n 1) line) line))))

; ============================================================
; Stage 11 T2: tyvar-from-receiver inference + structural unification
; ============================================================
; A method written over a parametric struct — `(defn count:usize
; ((self (ref (Vector T)))) ...)` — declares its tyvars implicitly through the
; receiver instead of an explicit `&where`. The free symbol `T` appearing as an
; argument of the registered template application `(Vector T)` is the method's
; type variable, inferred from the receiver (parametric-structs.md §4). These
; helpers (a) decide whether a symbol names a concrete type (else it is a tyvar),
; (b) collect such tyvars from a parameter/return type node, and (c) structurally
; unify a type-pattern node against a concrete argument Type* to bind them — the
; exact equivalent of an `&where`-declared tyvar list, so the method is recorded
; and stamped through the unchanged rung-4 monomorphizer.

; Does `name` name a concrete (non-tyvar) type? Mirrors parse-type-name's
; acceptance set without dying. A free symbol that is NOT resolvable here is a
; candidate type variable.
(defn tyname-resolvable (name:CStr):i32
  (when (!= (primitive-type-named name) 0) (return 1))
  (when (or (= name "usize") (= name "ssize") (= name "raw")) (return 1))
  (when (!= (as ptr (struct-lookup-ref name)) null) (return 1))
  (when (!= (as ptr (struct-template-lookup-ref name)) null) (return 1))
  (when (!= (as ptr (union-template-lookup-ref name)) null) (return 1))
  (when (!= (as ptr (enumdef-lookup-ref name)) null) (return 1))
  ; Stage 13 L7: a TY-FN spelling (interned "__fnty_<id>") resolves back to a
  ; concrete function-pointer Type* via fnty-resolve (mirroring parse-type-name),
  ; so a stamped generic body's template-arg spelling — e.g. (MapIter I __fnty_0) —
  ; is treated as a concrete type, not a free tyvar. Without this, collect-pattern-
  ; tyvars wrongly collects __fnty_0, defn-has-receiver-tyvars returns 1, the
  ; stamped method looks like a template, and emit-defn skips its define while the
  ; call site still references its ir-name (undefined symbol at link/parse).
  (match (fnty-resolve name)
         ((some t) (return 1))
         (none null))
  ; A pointer-kind colon spelling — "ptr:X" / "ref:X" / "raw:X" (the form
  ; type-spelling emits for a TY-PTR with a concrete element type) — is a
  ; concrete type iff its element spelling X is resolvable. Without this, a
  ; stamped generic whose receiver is (Vector (ref Foo)) has its
  ; tyvar-substituted arg spelling "ptr:Foo" wrongly collected as a free
  ; tyvar by collect-pattern-tyvars, so defn-has-receiver-tyvars returns 1,
  ; the stamped method is mistaken for an unmonomorphized template, and
  ; emit-defn skips its define while the call site still references its
  ; ir-name (undefined symbol at parse). Same failure mode as the __fnty_N
  ; case above (Stage 13 L7); recurses so ptr:ptr:Foo resolves.
  (when (and (= (strncmp name "ptr:" 4) 0)
             (!= (tyname-resolvable (unsafe/ptr+ (as raw:i8 name) 4)) 0))
    (return 1))
  (when (and (or (= (strncmp name "ref:" 4) 0)
                 (= (strncmp name "raw:" 4) 0))
             (!= (tyname-resolvable (unsafe/ptr+ (as raw:i8 name) 4)) 0))
    (return 1))
  (return 0))

; The inner pattern node of a pointer wrapper `(ptr|raw|ref X...)`, mirroring how
; parse-type-from-node consumes it: a single trailing element is that element;
; several (e.g. the colon-sugar shape `(ref Vector T)`) is the whole tail list
; `(Vector T)`. Returns null for a wrapper with no operand.
(defn wrapper-inner-pattern (node:raw:Node):raw:Node
  (let (n:raw:Node node
        rest:raw:Node (n cdr))
    (when (= rest null) (return null))
    (if (= (rest cdr) null)
      (return (rest car))
      (return rest))))

; If `node` is a list whose head names a registered struct template, return that
; StructTemplate*; else null. (Used to recognize a template application both for
; tyvar collection and unification.)
(defn node-template-of (node:raw:Node):?ptr:StructTemplate
  (when (= node null) (return null))
  (let (n:raw:Node node)
    (when (!= (n kind) NODE-CELL) (return null))
    (let (head:raw:Node (n car))
      (when (or (= head null) (!= (head kind) NODE-SYM)) (return null))
      (return (struct-template-lookup-ref (head s))))))

; True if `node` is a pointer-wrapper list head: (ptr ...) / (raw ...) / (ref ...).
(defn node-is-ptr-wrapper (node:raw:Node):i32
  (when (= node null) (return 0))
  (let (n:raw:Node node)
    (when (!= (n kind) NODE-CELL) (return 0))
    (let (head:raw:Node (n car))
      (when (or (= head null) (!= (head kind) NODE-SYM)) (return 0))
      (when (or (= (head s) "ptr") (= (head s) "raw") (= (head s) "ref"))
        (return 1))
      (return 0))))

; Append `name` to the tyvar array at *io-ntv (deduplicated). The array must have
; room (it is sized to the parameter/return node count, an upper bound). io-ntv is
; a ptr:i32 box holding the running count.
(defn tyvars-add (name:CStr out-tyvars:ptr io-ntv:ptr):void
  (let (ntv:i32 (aref (as ptr:i32 io-ntv) 0))
    (when (>= (tyvar-index-of name out-tyvars ntv) 0) (return))
    (aset! (as ptr:ptr out-tyvars) ntv name)
    (aset! (as ptr:i32 io-ntv) 0 (+ ntv 1))))

; Upper bound on the number of tyvar slots `collect-pattern-tyvars` can write for
; this type pattern. Every tyvar it emits is a distinct symbol leaf of the node,
; so the total node count is a safe (conservative, pre-dedup) bound. Used to size
; the tyvars array: a single parameter whose receiver is a struct-template
; application `(Two I F S E)` contributes one slot PER type argument — including
; phantom params that appear in no field — so the old "one tyvar per parameter"
; estimate under-allocated and corrupted the arena (Item 4a). Counting nodes can
; never under-count.
(defn count-pattern-nodes (node:raw:Node):i32
  (when (= node null) (return 0))
  (let (n:raw:Node node)
    (when (= (n kind) NODE-CELL)
      (return (+ 1 (+ (count-pattern-nodes (n car)) (count-pattern-nodes (n cdr))))))
    (return 1)))

; Walk a parameter/return type pattern node, collecting free symbols that appear
; as arguments of a registered struct-template application and are not resolvable
; as concrete types — these are the method's receiver-inferred tyvars. Recurses
; through pointer wrappers and nested template applications.
(defn collect-pattern-tyvars (node:raw:Node out-tyvars:ptr io-ntv:ptr):void
  (when (= node null) (return))
  (let (n:raw:Node node)
    (case (n kind)
      ; A bare symbol in receiver position is collected only via a template-arg
      ; below; a top-level bare symbol that is a concrete type or a known name is
      ; not a tyvar here (return-only/standalone `T` is out of scope — bound only
      ; through the receiver application).
      NODE-SYM (return)
      NODE-CELL
        ; Template application: each unresolvable symbol arg is a tyvar; recurse
        ; into list args (e.g. (HashMap K (Vector V))).
        (let (st:?ptr:StructTemplate (node-template-of node))
          (when (!= st null)
            (let (it:ListIter (list-iter (n cdr)))
              (doseq-iter (cur (addr-of it))
                (let (arg:ptr cur
                      an:ptr:Node (unsafe/cast ptr:Node arg))
                  (if (= (an kind) NODE-SYM)
                    (when (= (tyname-resolvable (an s)) 0)
                      (tyvars-add (an s) out-tyvars io-ntv))
                    (collect-pattern-tyvars arg out-tyvars io-ntv)))))
            (return))
          ; Pointer wrapper: descend into the inner pattern.
          (when (!= (node-is-ptr-wrapper node) 0)
            (collect-pattern-tyvars (wrapper-inner-pattern node) out-tyvars io-ntv)
            (return)))
      0)))

; Collect the type variables appearing in a parametric-constraint argument node
; `((Proto Arg…) V)` (assoc-types A1). Unlike a receiver pattern — where a bare
; top-level symbol is a concrete type, never a tyvar (collect-pattern-tyvars
; returns on NODE-SYM) — a constraint Arg that is a bare *unresolvable* symbol IS
; an associated type variable to recover (`S` in `((Iterator S) I)`). A resolvable
; bare symbol (`i32` in `((Iterator i32) I)`) is a concrete constrain target, not a
; tyvar. Compound args (template applications, ptr/ref wrappers, e.g. `(Maybe E)`)
; delegate to collect-pattern-tyvars, which already finds their nested tyvars.
(defn collect-constraint-arg-tyvars (node:raw:Node out-tyvars:ptr io-ntv:ptr):void
  (when (= node null) (return))
  (let (n:raw:Node node)
    (when (= (n kind) NODE-SYM)
      ; A colon-sugared symbol (`ptr:Foo`) is a concrete type, never a tyvar.
      (when (= (strchr (n s) 58) null)
        (when (= (tyname-resolvable (n s)) 0)
          (tyvars-add (n s) out-tyvars io-ntv)))
      (return))
    (collect-pattern-tyvars node out-tyvars io-ntv)))

; Structurally unify a type-pattern node `pat` against a concrete argument Type*
; `at`, binding each tyvar (by index in `tyvars`) into out-bound. Returns 1 on a
; consistent match, 0 on any mismatch. The cases mirror parse-type-from-node:
;   - bare tyvar symbol: bind (and agree on repeats);
;   - any other symbol / colon-sugar symbol: parse it concretely and type-eq;
;   - (ptr|raw|ref X): `at` must be a TY-PTR, recurse on X vs (at elem);
;   - (Template A B): `at` must be a stamped instance of that template, recurse
;     positionally on A,B vs the recorded origin args;
;   - anything else: parse the whole pattern concretely and type-eq.
(defn unify-tpat (pat:raw:Node at:raw:Type tyvars:ptr ntv:i32 out-bound:ptr line:i32):i32
  (when (or (= pat null) (= at null)) (return 0))
  (let (pn:raw:Node pat)
    (case (pn kind)
      NODE-SYM
        (do
          ; A single bare symbol that is a declared tyvar binds directly.
          (when (= (strchr (pn s) 58) null)
            (let (idx:i32 (tyvar-index-of (pn s) tyvars ntv))
              (when (>= idx 0)
                (let (cur:ptr (aref (as ptr:ptr out-bound) idx))
                  (if (= cur null)
                    (do (aset! (as ptr:ptr out-bound) idx at) (return 1))
                    (return (type-eq cur at)))))))
          ; Otherwise a concrete (possibly colon-sugared) type: parse and compare.
          (return (type-eq (parse-type-from-node pat line) at)))
      NODE-CELL
        (do
          ; Pointer wrapper vs a concrete pointer: unify element patterns.
          (when (!= (node-is-ptr-wrapper pat) 0)
            ; Stage 13 L7: a bare `fn` (function pointer, TY-FN) flowing into a
            ; `(ref G)`/`(ptr G)` position binds G to the TY-FN itself — the stamped
            ; body's `(ref G)` becomes `(ref <fn>)`, and the by-value fn pointer
            ; passed at the call site lands in the param slot as that storage. A
            ; TY-FN has no `elem`, so unify the inner pattern directly against `at`.
            (when (= (at kind) TY-FN)
              (return (unify-tpat (wrapper-inner-pattern pat) at tyvars ntv out-bound line)))
            (when (!= (at kind) TY-PTR) (return 0))
            (return (unify-tpat (wrapper-inner-pattern pat)
                                (at elem)
                                tyvars ntv out-bound line)))
          ; Template application vs a stamped instance of the same template.
          (let (st:?ptr:StructTemplate (node-template-of pat))
            (when (!= st null)
              (when (!= (at kind) TY-STRUCT) (return 0))
              (let (sd:raw:StructDef (at sdef))
                (when (!= (sd origin-template) st) (return 0))
                (let (nargs:i32 (- (node-len pat) 1))
                  (when (!= nargs (sd origin-nargs)) (return 0))
                  (dotimes (i nargs)
                    (when (= (unify-tpat (node-at pat (+ i 1))
                                         (aref (as ptr:ptr (sd origin-args)) i)
                                         tyvars ntv out-bound line) 0)
                      (return 0)))
                  (return 1)))))
          ; Any other compound type (anonymous struct, fn pointer): parse concretely.
          (return (type-eq (parse-type-from-node pat line) at)))
      0)
    (return 0)))

; Does this defn signature mention a registered struct template applied to free
; (tyvar) symbols in any parameter or return type? If so it is a receiver-inferred
; generic method (parametric-structs.md §4), recorded like an `&where` template.
(defn defn-has-receiver-tyvars (form:raw:Node):i32
  (let (name-node:ptr (node-at form 1)
        params-node:ptr (node-at form 2))
    (when (= (node-is-list params-node) 0) (return 0))
    ; Capacity must cover one tyvar per type-argument of any struct-template
    ; receiver, not just one per parameter (Item 4a) — size by the node count of
    ; each parameter/return type pattern, a safe upper bound on collectible
    ; tyvars. Add the return-type node count and 1 so the array is never empty.
    (let (np:i32 (node-len params-node)
          cap:i32 (+ (count-pattern-nodes (defn-ret-node form)) 1)
          ci:i32 0)
      (while (< ci np)
        (set! cap (+ cap (count-pattern-nodes
                           (binding-type-node (node-at params-node ci)))))
        (inc! ci))
    (let (tyvars:ptr (arena-alloc (* (as i64 cap) (ptr-bytes)))
          ntv:i32 0
          i:i32 0)
      (while (< i np)
        ; W5f: a NULL (empty-list `()`) parameter is not a marker; skip the
        ; dereference and let emit-defn diagnose it.
        (let (p:(raw Node) (as raw:Node (node-at params-node i)))
          ; Skip &where / &rest / &optional markers and their constraint lists.
          (when (and (!= p null) (= (p kind) NODE-SYM)
                     (or (= (p s) "&where") (= (p s) "&rest") (= (p s) "&optional")))
            (return (if (> ntv 0) 1 0)))
          (collect-pattern-tyvars (binding-type-node (node-at params-node i))
                                  tyvars (as ptr:i32 (addr-of ntv))))
        (inc! i))
      (collect-pattern-tyvars (defn-ret-node form) tyvars (as ptr:i32 (addr-of ntv)))
      (return (if (> ntv 0) 1 0))))))

; A defn is a bounded-generic template — recorded for on-demand monomorphization
; rather than emitted concretely — if it carries an explicit `&where` clause OR
; its receiver/return mentions a parametric struct over free tyvars (§4). Both
; routing sites (prescan registration, emit-defn skip) consult this so the two
; never disagree about whether a defn is a template.
(defn defn-is-generic-template (form:raw:Node):i32
  (let (params-node:ptr (node-at form 2))
    (when (>= (params-where-index params-node) 0) (return 1))
    (return (defn-has-receiver-tyvars form))))

; Can the parameter type pattern `pat` bind the type variable `tvname` under the
; structural unifier (unify-tpat)? Mirrors that traversal: a bare-symbol match, a
; tyvar under a ptr/ref/raw wrapper, or a tyvar as an argument of a registered
; struct-template application (recursively). Used to confirm every declared tyvar
; is determined by some parameter.
; tvname stays a bare `ptr` (NOT CStr): it is compared with `=` directly
; against `(n s)` (Node.s, the interned-symbol identity substrate — NS-5).
; Both sides are already pointer-identity comparable since tyvar-name spellings
; are always interned; retyping tvname to CStr would flip this specific `=`
; from an `icmp eq ptr` to a `strcmp` call where neither operand was
; previously CStr/StrView — a new, non-inert IR change (conventions.md's
; identity-comparison trap; generalizes the batch-2 identity-keyed-memo
; finding to a direct Node.s comparison rather than a memo table).
(defn pattern-determines-tyvar (pat:raw:Node tvname:ptr):i32
  (when (= pat null) (return 0))
  (let (n:raw:Node pat)
    (case (n kind)
      NODE-SYM
        (if (and (= (strchr (n s) 58) null) (= (n s) tvname)) (return 1) (return 0))
      NODE-CELL
        (do
          (when (!= (node-is-ptr-wrapper pat) 0)
            (return (pattern-determines-tyvar (wrapper-inner-pattern pat) tvname)))
          (let (st:?ptr:StructTemplate (node-template-of pat))
            (when (!= st null)
              (let (it:ListIter (list-iter (n cdr)))
                (doseq-iter (cur (addr-of it))
                  (when (!= (pattern-determines-tyvar cur tvname) 0)
                    (return 1))))
              (return 0))))
      0)
    (return 0)))

; TC-1: the interned name of the first declared tyvar that NO parameter pattern
; determines (a return-only / otherwise under-determined tyvar), or null when
; every tyvar is parameter-determined. Such a tyvar can only be filled by the
; call site's want channel; a call that cannot resolve and has one of these gets
; the dedicated "cannot infer type variable" diagnostic instead of the misleading
; "no matching method". Re-derives the registration-time determination signal at
; resolution time (the `determined` array is not retained on the Method).
(defn method-undetermined-tyvar (m:raw:Method):ptr
  (let (mm:raw:Method m
        nparams:i32 (mm num-params)
        ntv:i32 (mm num-tyvars)
        params-node:ptr (node-at (mm body) 2))
    (dotimes (ti ntv)
      (let (tvname:ptr (aref (as ptr:ptr (mm tyvars)) ti)
            bnd:i32 0)
        (dotimes (j nparams)
          (when (!= (pattern-determines-tyvar (binding-type-node (node-at params-node j)) tvname) 0)
            (set! bnd 1)))
        (when (= bnd 0) (return tvname))))
    (return null)))

; Does the colon-free symbol `tvname` appear anywhere as a leaf of `node`? Used
; by the assoc-types (A1) determination fixpoint to test whether a constraint
; argument pattern `((Proto Arg…) V)` references a given tyvar. Walks every cell
; and symbol leaf (unlike pattern-determines-tyvar, which restricts itself to the
; unifier-reachable positions); an Arg may be a bare `S`, a `(Maybe E)`, etc.
; tvname stays `ptr` for the same reason as pattern-determines-tyvar above
; (identity-substrate comparison against Node.s).
(defn node-mentions-tyvar-named (node:raw:Node tvname:ptr):i32
  (when (= node null) (return 0))
  (let (n:raw:Node node)
    (case (n kind)
      NODE-SYM
        (if (and (= (strchr (n s) 58) null) (= (n s) tvname)) (return 1) (return 0))
      NODE-CELL
        (do
          (when (!= (node-mentions-tyvar-named (n car) tvname) 0) (return 1))
          (return (node-mentions-tyvar-named (n cdr) tvname)))
      0)
    (return 0)))

; Parse a `&where` constraint list into the `constraints` Vector (assoc-types A1,
; factored out for A4 so `emit-extend` can reuse it — design assoc-types-extend.md
; §5). `params-node` holds the constraint nodes starting at index `base`; there are
; `nc` of them. Appends, for each constraint i in [0,nc), one `(ref Constraint)`:
;   proto  — the protocol name;
;   var    — the conforming variable name;
;   args   — a ptr[] of the protocol-application Arg nodes (or null for a plain
;            `(Proto V)` constraint);
;   nargs  — the Arg count (0 for a plain constraint).
; Every constraint variable and every constraint-Arg tyvar is added to `tyvars`
; (size already provisioned by the caller) with `io-ntv` (a ptr:i32 box) bumped.
; Diagnostics attribute to `line`.
(defn parse-where-constraints (params-node:raw:Node base:i32 nc:i32
                                    (constraints (ref (Vector (ref Constraint))))
                                    tyvars:ptr io-ntv:ptr line:i32):void
  (dotimes (ci nc)
    (let (cnode:ptr (node-at params-node (+ base ci)))
      (when (or (= (node-is-list cnode) 0) (!= (node-len cnode) 2))
        (die-at line "defn: each &where constraint must be (Protocol Var)"))
      ; Element 0 is the protocol slot: either a bare symbol (plain
      ; protocol, unchanged path) or a list `(Proto Arg…)` (a protocol
      ; application — assoc-types A1). Element 1 is always the conforming
      ; variable symbol, in tail position, as in `(Ord T)`.
      (let (c0:ptr:Node (unsafe/cast ptr:Node (node-at cnode 0))
            vn:ptr:Node (unsafe/cast ptr:Node (node-at cnode 1))
            rec:ref:Constraint (new Constraint))
        (.set! rec args null)
        (.set! rec nargs 0)
        (when (!= (vn kind) NODE-SYM)
          (die-at line "defn: &where constraint must name a protocol and a variable"))
        ; Element 0 may be null when written as the empty list `()` in the
        ; protocol slot; guard the kind read before classifying.
        (if (and (!= (as ptr c0) null) (= (c0 kind) NODE-SYM))
          ; Plain protocol `(Proto V)`: no associated args.
          ; Stage 15 W9 defect 21: canonicalize the protocol reference HERE, where
          ; it is written, not at each later lookup. A constraint is checked
          ; (`generic-constraints-ok`, `constraint-proto-known`) long after
          ; registration and often while a *different* namespace is current, so a
          ; bare `Describe` written inside `(ns dp)` must be resolved to
          ; `dp/Describe` now — `prescan-protocols` runs immediately before this
          ; file's signature prescan, so its own protocols are registered. A
          ; blanket name (`Any`/`Struct`/`Clone`), `Valid`, or a protocol not yet
          ; registered passes through unchanged and re-canonicalizes at lookup.
          (.set! rec proto (protocol-canon-name (as CStr (c0 s))))
          ; Protocol application `((Proto Arg…) V)`: element 0 is a list
          ; whose head names the protocol and whose tail are the argument
          ; patterns. Each Arg is a type-spelling node; any tyvar in it is
          ; collected (recovered/constrained at dispatch — A2).
          (do
            (when (or (= (node-is-list (as ptr c0)) 0) (< (node-len (as ptr c0)) 1))
              (die-at line "defn: &where constraint protocol application must be (Protocol Arg...)"))
            (let (hn:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr c0) 0)))
              (when (!= (hn kind) NODE-SYM)
                (die-at line "defn: &where constraint protocol application head must be a protocol name"))
              (let (na:i32 (- (node-len (as ptr c0)) 1)
                    argv:ptr (if (> na 0) (arena-alloc (* (as i64 na) (ptr-bytes))) null))
                (dotimes (ai na)
                  (let (argn:ptr (node-at (as ptr c0) (+ ai 1)))
                    (aset! (as ptr:ptr argv) ai argn)
                    (collect-constraint-arg-tyvars argn tyvars io-ntv)))
                (.set! rec proto (protocol-canon-name (as CStr (hn s))))
                (.set! rec args argv)
                (.set! rec nargs na)))))
        (.set! rec var (as CStr (vn s)))
        (conj constraints rec)
        (when (< (tyvar-index-of (vn s) tyvars (aref (as ptr:i32 io-ntv) 0)) 0)
          (aset! (as ptr:ptr tyvars) (aref (as ptr:i32 io-ntv) 0) (vn s))
          (aset! (as ptr:i32 io-ntv) 0 (+ (aref (as ptr:i32 io-ntv) 0) 1)))))))

; Register a bounded-generic defn as a METHOD-GENERIC template (Stage 9 rung 4).
; Tyvars come from two sources, merged (parametric-structs.md §4):
;   - explicit `&where (Protocol Var)` constraints (the variable is declared and
;     carries an extra bound);
;   - receiver inference — a free symbol appearing as an argument of a registered
;     struct-template application in a parameter/return type (`(ref (Vector T))`).
; A method may have receiver-inferred tyvars and no `&where` at all. Every
; declared tyvar must be determined by some parameter through the structural
; unifier; the body is retained and monomorphized per concrete call site.
(defn register-generic-defn (form:raw:Node trusted:i32):void
  (let (ff:raw:Node form
        name-node:ptr (node-at form 1)
        params-node:ptr (node-at form 2)
        fname:ptr (defn-name-only name-node)
        wi:i32 (params-where-index params-node)
        has-where:i32 (if (>= (params-where-index params-node) 0) 1 0))
    (when (= fname null) (die-at (ff line) "defn: malformed generic name"))
    ; S4: bounded-generic templates bypass defn-parse-sig (the prescan routes them
    ; here and emit-defn returns early for templates), so hard-error a legacy
    ; `name:ret` / list-head `(name ret)` name here too, with the same diagnostic.
    (when (= (sig-name-is-bare name-node) 0)
      (die-at (ff line)
        (fmt-2s "defn '%s': legacy 'name:ret' syntax is no longer supported — write (defn %s (params):ret …)"
                fname fname)))
    (let (raw:i32 (node-len params-node)
          nparams:i32 (if (>= wi 0) wi (defn-params-count params-node)))
      (dotimes (i nparams)
        (let (p:ptr:Node (unsafe/cast ptr:Node (node-at params-node i)))
          (when (and (= (p kind) NODE-SYM) (= (p s) "&rest"))
            (die-at (node-line (as ptr p) (ff line)) "defn: &rest combined with a generic method is not supported yet"))))
      (let (nc:i32 (if (>= wi 0) (- raw (+ wi 1)) 0))
        (when (and (!= has-where 0) (< nc 1))
          (die-at (ff line) "defn: &where requires at least one (Protocol Var) constraint"))
        ; Capacity: constraint vars + a conservative upper bound on receiver-
        ; inferred tyvars across every parameter and the return type. A single
        ; parameter applying a struct template `(Two I F S E)` contributes one
        ; tyvar per type argument (phantom params included), so sizing by node
        ; count — never less than the tyvar count — avoids the arena overrun that
        ; the old `nc + nparams + 1` estimate caused for multi-arg receivers.
        (let (slot-bound:i32 nc)
          (dotimes (sb-j nparams)
            (set! slot-bound (+ slot-bound
                                (count-pattern-nodes
                                  (binding-type-node (node-at params-node sb-j))))))
          (set! slot-bound (+ slot-bound
                              (count-pattern-nodes (defn-ret-node form))))
          ; Assoc-type tyvars (A1) appear literally as nodes inside a parametric
          ; constraint's protocol-application `(Proto Arg…)`, so size them by the
          ; same node-walk: walk element 0 of every constraint. A plain (symbol)
          ; element-0 contributes 1, which only over-allocates; a list `(Proto
          ; Arg…)` contributes one slot per Arg node, matching collect-pattern-
          ; tyvars' upper bound — no separate per-binding accounting needed.
          (dotimes (sb-c nc)
            (set! slot-bound (+ slot-bound
                                (count-pattern-nodes
                                  (node-at (node-at params-node (+ (+ wi 1) sb-c)) 0)))))
        (let (cap:i32 (if (> slot-bound 0) slot-bound 1)
              (constraints (ref (Vector (ref Constraint)))) (vector-new-in (addr-of g-arena-alloc))
              tyvars:ptr     (arena-alloc (* (as i64 cap) (ptr-bytes)))
              ntv:i32 0)
          ; Parse the &where constraint list into the `constraints` Vector and
          ; collect constraint variables + Arg tyvars (assoc-types A1). Shared with
          ; emit-extend (A4) via parse-where-constraints.
          (parse-where-constraints params-node (+ wi 1) nc
                                   constraints
                                   tyvars (as ptr:i32 (addr-of ntv)) (ff line))
          ; Merge in receiver-inferred tyvars from each parameter and the return
          ; type. These are bound structurally by the unifier (a tyvar nested in a
          ; ptr/ref wrapper or a template application), so the old flat-only
          ; nested-position rejection no longer applies.
          (dotimes (j nparams)
            (collect-pattern-tyvars (binding-type-node (node-at params-node j))
                                    tyvars (as ptr:i32 (addr-of ntv))))
          (collect-pattern-tyvars (defn-ret-node form)
                                  tyvars (as ptr:i32 (addr-of ntv)))
          ; Every declared tyvar must be determined (return-only tyvars need dyn,
          ; deferred). Determination is a fixpoint (assoc-types A1 §3.4):
          ;   seed: a tyvar bound by some parameter pattern under the structural
          ;         unifier is determined;
          ;   step: for each constraint `((Proto Arg…) V)` whose conforming
          ;         variable V is already determined, every tyvar that appears in
          ;         an Arg position becomes determined (it is recovered from V's
          ;         conformance at dispatch — A2);
          ;   repeat until no change.
          ; A plain `(Proto V)` constraint has no Arg nodes, so it adds nothing —
          ; identical to the pre-A1 single-pass behaviour.
          (let (determined:ptr (arena-alloc (* (as i64 (if (> ntv 0) ntv 1)) 4)))
            (dotimes (ti ntv)
              (let (tvname:CStr (aref (as ptr:ptr tyvars) ti)
                    bnd:i32 0)
                (dotimes (j nparams)
                  (when (!= (pattern-determines-tyvar (binding-type-node (node-at params-node j))
                                                      tvname) 0)
                    (set! bnd 1)))
                (aset! (as ptr:i32 determined) ti bnd)))
            ; Propagate through constraints to a fixpoint.
            (let (changed:i32 1)
              (while (!= changed 0)
                (set! changed 0)
                (let (ck:i32 0)
                  (while (< ck nc)
                    (let (crec:ref:Constraint (invoke constraints (as usize ck))
                          vidx:i32 (tyvar-index-of (crec var) tyvars ntv)
                          na:i32 (crec nargs))
                      ; Constraint's conforming variable determined and it carries
                      ; recoverable args → each arg-mentioned tyvar is determined.
                      (when (and (>= vidx 0)
                                 (and (!= (aref (as ptr:i32 determined) vidx) 0) (> na 0)))
                        (let (argv:ptr (crec args)
                              ai:i32 0)
                          (while (< ai na)
                            (let (argn:ptr (aref (as ptr:ptr argv) ai)
                                  ti2:i32 0)
                              (while (< ti2 ntv)
                                (when (and (= (aref (as ptr:i32 determined) ti2) 0)
                                           (!= (node-mentions-tyvar-named argn (aref (as ptr:ptr tyvars) ti2)) 0))
                                  (aset! (as ptr:i32 determined) ti2 1)
                                  (set! changed 1))
                                (inc! ti2)))
                            (inc! ai)))))
                    (inc! ck)))))
            ; TC-1: a tyvar not determined by any parameter (a return-only tyvar)
            ; is no longer a def-time error — it registers as METHOD-GENERIC and
            ; its determination is deferred to the call site's want channel
            ; (generic-resolve / generic-method-bind unify the return pattern
            ; against the expected type). `determined` is retained as advisory
            ; detection; resolution re-derives the signal via
            ; method-undetermined-tyvar for the dedicated diagnostic.
            )
          ; Constraint protocols are validated in the A2 pass (check-generic-
          ; template), which runs after all imports — so a &where may name a
          ; protocol that an `import` provides, while a genuine typo is still
          ; caught (just at the outermost top-level rather than at the prescan).
          ; Register the template.
          (let (g:ptr (generic-lookup fname))
            (when (= g null) (set! g (generic-new fname)))
            (let (m:ptr:Method (new Method))
              (.set! m param-types null)
              (.set! m num-params nparams)
              (.set! m ret-type null)
              (.set! m has-rest 0)
              (.set! m variadic 0)
              (.set! m kind METHOD-GENERIC)
              (.set! m ir-name null)
              (.set! m fn-type null)
              (.set! m binop null)
              (.set! m body form)
              (.set! m tyvars tyvars)
              (.set! m num-tyvars ntv)
              (.set! m constraints constraints)
              (.set! m num-constraints nc)
              ; Imported templates were checked by the exporting unit; skip A2.
              (.set! m checked trusted)
              ; Stage 15 B4: provenance, which this site never recorded because
              ; it does not go through `generic-register-method`. A generic is
              ; keyed BARE (R2), so `Method.src-ns` is the only thing that says
              ; which namespace a method came from — and without it a template
              ; reached as `p/name` filtered to nothing and the name did not
              ; resolve at all. Runs in `prescan-defn-signatures`, so
              ; `g-current-ns`/`g-source-path` are the defining file's.
              (.set! m src-ns g-current-ns)
              (.set! m src-file g-source-path)
              (generic-add-method g m)))))))))

; Try to bind a generic template's type variables from a concrete argument
; tuple by structurally unifying each parameter's type pattern against the
; concrete argument Type* (unify-tpat): bare-tyvar params bind (and must agree on
; repeats); concrete params (including ptr/ref wrappers and parametric-struct
; applications like `(ref (Vector T))`) match positionally, binding any tyvars
; nested within. On success fills out-bound[tyvar-index] = Type* and returns 1; on
; any mismatch returns 0.
; Convert a retained conformance argument — a canonical type-spelling string such
; as "i32" or "ptr:Node" — back into a concrete Type*. Higher-kinded args are out
; of scope (assoc-types §5), so every stored spelling is a single (possibly
; colon-sugared) symbol, exactly what parse-type-from-node accepts from a SYM node.
(defn conf-arg-to-type (spelling:CStr line:i32):ref:Type
  (let (n:ptr:Node (as ptr:Node (alloc-node))
        saved:i32 g-type-key-ok)
    (.set! n kind NODE-SYM)
    (.set! n line line)
    (.set! n s spelling)
    ; Stage 15 B3′: a retained conformance arg is a stored canonical spelling —
    ; a key, read back in a file that may not be the one that wrote it.
    (set! g-type-key-ok 1)
    (let (t:ref:Type (parse-type-from-node (as ptr n) line))
      (set! g-type-key-ok saved)
      (return t))))

; Assoc-types A2 (§3.5): after the positional unifier has bound the parameter
; tyvars in out-bound, recover or check the associated tyvars carried by each
; parametric `&where` constraint `((Proto Arg…) V)`. A fixpoint, because one
; constraint's recovered tyvar (S from `((Iterator S) I)`) can be another's input
; (`((UnaryFn S E) F)`).
;
;   For each constraint whose conforming variable V is now bound to a concrete
;   type CV (the constraint's nargs > 0; a plain protocol is skipped):
;     - look up CV's Conformance for Proto;
;     - for each Arg[j] paired with the conformance's stored args[j]:
;         · Arg[j] an as-yet-unbound declared tyvar → bind it (RECOVER);
;         · otherwise resolve Arg[j] (a bound tyvar or concrete type) to its
;           canonical spelling and require equality with args[j] (CONSTRAIN).
;
; Returns 1 once no new binding is added. Returns 0 (a *soft* no-match, mirroring
; generic-constraints-ok) when a determined V does not conform to Proto, so the
; candidate is rejected and the standard missing-conformance diagnostic fires
; downstream. Hard errors that cannot be "another candidate" — a conformance with
; no retained args (stale .nuch), or a constrain-step mismatch — die-at here.
; Recover or check one constraint's associated tyvars against the conforming
; variable's conformance record. Returns 1 to keep iterating (V unbound, or a
; binding was made — *changed via the out box), 1 with no change, or 0 for a soft
; no-match (V conforms to nothing for Proto). Hard errors (stale args, arity, or a
; constrain mismatch) die-at. `io-changed` is a ptr:i32 box set to 1 on a RECOVER.
; Operates on an explicit constraint tuple (assoc-types A4, factored out of the
; Method* so emit-extend can reuse the same fixpoint — assoc-types-extend.md §5):
;   tyvar-names / num-tyvars — the declared tyvars and their count;
;   constraints — the parsed &where clause (Vector (ref Constraint));
;   ci — the constraint index; out-bound — the bound[tyvar-index] = Type* array;
;   io-changed — a ptr:i32 box set to 1 on a RECOVER; line — diagnostic line for
;     the hard-error cases (stale args / arity mismatch).
; Index the (possibly-null) `constraints` Vector, asserting non-null. Every caller
; guards the access with `num-constraints` (0 ⇒ the Vector is never indexed), so the
; raw→ref cast is sound — it centralizes the assertion the flow-checker demands at
; the `invoke` site (the field is honestly `(raw …)`: most Methods are non-generic
; and carry no constraints).
(defn constraints-at ((cons (raw (Vector (ref Constraint)))) i:i32):ref:Constraint
  (invoke (unsafe/cast (ref (Vector (ref Constraint))) cons) (as usize i)))

(defn recover-one-constraint (tyvar-names:ptr num-tyvars:i32
                                  (constraints (raw (Vector (ref Constraint))))
                                  ci:i32 out-bound:ptr io-changed:ptr line:i32):i32
  (let (crec:ref:Constraint (constraints-at constraints ci)
        na:i32 (crec nargs))
    (when (= na 0) (return 1))
    (let (ntv:i32 num-tyvars
          proto:CStr (crec proto)
          vidx:i32 (tyvar-index-of (crec var) tyvar-names ntv)
          cv:ptr (if (>= vidx 0) (aref (as ptr:ptr out-bound) vidx) null))
      ; V not yet bound → defer to a later fixpoint iteration.
      (when (= cv null) (return 1))
      (let (cvspell:ptr (type-spelling cv))
        ; Missing conformance is a soft reject (like generic-constraints-ok).
        ; Stage 13 L7: before rejecting, try to derive a structural conformance
        ; for a closure (the closure's invoke method satisfies the protocol's
        ; function-shaped method). derive-closure-conformance is idempotent, so
        ; a later generic-constraints-ok call that reaches the same (type, proto)
        ; sees the conformance already recorded and skips.
        (when (and (= (conformance-lookup cvspell proto) 0)
                   (= (derive-closure-conformance cv proto line) 0))
          (return 0))
        (let (cn:i32 0
              cargs:(raw (Vector CStr)) (conformance-args cvspell proto (as ptr:i32 (addr-of cn))))
          ; A recorded conformance with no retained args predates arg retention
          ; (stale .nuch) — a hard, fix-by-recompile error.
          (when (or (= cargs null) (= cn 0))
            (die-at line
              (fmt-2s "conformance for protocol '%s' (type '%s') was recorded without parameter bindings; recompile"
                      proto cvspell)))
          ; The constraint's arg count must match the protocol's parameter count;
          ; a mismatch would read past the stored args and is a hard error.
          (when (!= na cn)
            (die-at line
              (fmt-2s "constraint '%s' supplies the wrong number of arguments for the conformance of '%s'"
                      proto cvspell)))
          (let (argv:ptr (crec args)
                cargsv:(ref (Vector CStr)) (unsafe/cast (ref (Vector CStr)) cargs))
            (dotimes (j na)
              (let (argn:ptr (aref (as ptr:ptr argv) j)
                    conspell:CStr (invoke cargsv (as usize j))
                    an:ptr:Node (unsafe/cast ptr:Node argn)
                    tidx:i32 -1)
                ; A bare colon-free symbol naming a declared tyvar may be
                ; recovered or constrained; anything else is a concrete pattern.
                (when (and (= (an kind) NODE-SYM) (= (strchr (an s) 58) null))
                  (set! tidx (tyvar-index-of (an s) tyvar-names ntv)))
                (if (>= tidx 0)
                  (let (cur:ptr (aref (as ptr:ptr out-bound) tidx))
                    (if (= cur null)
                      ; RECOVER: bind the tyvar to the stored arg type.
                      (do (aset! (as ptr:ptr out-bound) tidx
                                 (conf-arg-to-type conspell (node-line (as ptr an) line)))
                          (aset! (as ptr:i32 io-changed) 0 1))
                      ; CONSTRAIN: an already-bound tyvar must agree.
                      (when (!= (strcmp (type-spelling cur) conspell) 0)
                        (die-at (node-line (as ptr an) line)
                          (fmt-3s "constraint '%s' parameter mismatch: expected %s, found %s"
                                  proto (type-spelling cur) conspell)))))
                  ; CONSTRAIN: a concrete arg pattern must equal the stored arg.
                  (let (cty:ptr (parse-type-from-node argn (node-line (as ptr an) line)))
                    (when (!= (strcmp (type-spelling cty) conspell) 0)
                      (die-at (node-line (as ptr an) line)
                        (fmt-3s "constraint '%s' parameter mismatch: expected %s, found %s"
                                proto (type-spelling cty) conspell)))))))
            (return 1)))))))

; Assoc-types A2 (§3.5): after the positional unifier has bound the parameter
; tyvars in out-bound, recover or check the associated tyvars carried by each
; parametric `&where` constraint `((Proto Arg…) V)`. A fixpoint, because one
; constraint's recovered tyvar (S from `((Iterator S) I)`) can be another's input
; (`((UnaryFn S E) F)`). Returns 0 (a soft no-match) when a determined V does not
; conform to Proto; 1 otherwise. A plain protocol (the constraint's nargs == 0) is skipped,
; so this is inert for every non-parametric constraint (e.g. `(Any T)`).
;
; Factored out of the Method* (assoc-types A4 §5) to operate on an explicit
; constraint tuple, so emit-extend can run the identical fixpoint at stamp time:
;   tyvar-names / num-tyvars — declared tyvars and count;
;   out-bound — mutable bound[tyvar-index] = Type* array (seeded by the caller);
;   constraints — the parsed &where clause (Vector (ref Constraint));
;   num-constraints — count; line — diagnostic line for hard errors.
(defn recover-assoc-into (tyvar-names:ptr out-bound:ptr num-tyvars:i32
                              (constraints (raw (Vector (ref Constraint))))
                              num-constraints:i32 line:i32):i32
  (let (nc:i32 num-constraints)
    (when (= nc 0) (return 1))
    (let (changed:i32 1)
      (while (!= changed 0)
        (set! changed 0)
        (let (ci:i32 0)
          (while (< ci nc)
            (when (= (recover-one-constraint tyvar-names num-tyvars
                                             constraints
                                             ci out-bound
                                             (as ptr:i32 (addr-of changed)) line) 0)
              (return 0))
            (inc! ci)))))
    (return 1)))

(defn generic-method-bind (m:raw:Method argtypes:ptr nargs:i32 out-bound:ptr want:raw:Type arg-nodes:ptr):i32
  (let (mm:raw:Method m)
    (when (!= (mm num-params) nargs) (return 0))
    (let (params-node:ptr (node-at (mm body) 2)
          ntv:i32 (mm num-tyvars)
          ; LW-6 (int-widening.md follow-up, found while wrapping up the LW-5
          ; sweep): a literal argument whose param is a bare, still-unbound
          ; tyvar is deferred past assoc-recovery below, so a &where
          ; constraint's conformance (a real declared type) gets first claim
          ; on the tyvar instead of the literal's naive i32 — fixes `reduce`'s
          ; FoldFn Acc/T binding from a literal accumulator (e.g.
          ; `(reduce bs 0 it)` against a `(FoldFn i64 ui8)` conformance, which
          ; previously died "constraint 'FoldFn' parameter mismatch: expected
          ; i32, found i64" because Acc got bound to i32 from the literal
          ; before assoc-recovery had a chance to bind it from the
          ; conformance's real i64).
          ndeferred:i32 0
          deferred-ptn:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes)))
          deferred-at:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes))))
      (dotimes (k ntv) (aset! (as ptr:ptr out-bound) k null))
      (dotimes (i nargs)
        (let (ptn:ptr (binding-type-node (node-at params-node i))
              at:ptr (aref (as ptr:ptr argtypes) i))
          (when (or (= ptn null) (= at null)) (return 0))
          (let (is-lit:i32 0
                tvidx:i32 -1)
            (when (!= arg-nodes null)
              (set! is-lit (node-is-int-literal (aref (as ptr:ptr arg-nodes) i))))
            (when (= ((unsafe/cast ptr:Node ptn) kind) NODE-SYM)
              (when (= (strchr ((unsafe/cast ptr:Node ptn) s) 58) null)
                (set! tvidx (tyvar-index-of ((unsafe/cast ptr:Node ptn) s) (mm tyvars) ntv))))
            ; Only defer if the tyvar is still unbound at this point in the
            ; pass — an earlier, non-deferred arg (e.g. conj's receiver
            ; binding T before the elem literal is considered) may have
            ; already bound it, in which case unify-tpat's ordinary
            ; constrain-or-fail check must still run (tier-1 correctly
            ; rejects a mismatched literal there, falling through to tier-2's
            ; arg-adapts widening — LW-1's existing, unrelated mechanism).
            (if (and (!= is-lit 0) (>= tvidx 0)
                     (= (aref (as ptr:ptr out-bound) tvidx) null))
              (do
                (aset! (as ptr:ptr deferred-ptn) ndeferred ptn)
                (aset! (as ptr:ptr deferred-at) ndeferred at)
                (set! ndeferred (+ ndeferred 1)))
              (when (= (unify-tpat ptn at (mm tyvars) ntv out-bound
                                   ((unsafe/cast ptr:Node ptn) line)) 0)
                (return 0))))))
      ; Recover/check associated tyvars from the parametric &where constraints
      ; (assoc-types A2). A soft 0 here means a constraint's conforming variable
      ; does not conform — reject this candidate before the all-bound check.
      ; recover-assoc-into runs the shared fixpoint over the Method's fields.
      (when (= (recover-assoc-into (mm tyvars) out-bound (mm num-tyvars)
                                    (mm constraints)
                                    (mm num-constraints)
                                    ((mm body) line)) 0)
        (return 0))
      ; LW-6: resolve deferred literal-arg tyvars that assoc-recovery left
      ; unbound (no conformance recovered them) — the pre-LW-6 fallback
      ; binding, unchanged for the common case with no such constraint.
      (dotimes (di ndeferred)
        (let (ptn:ptr (aref (as ptr:ptr deferred-ptn) di)
              at:ptr (aref (as ptr:ptr deferred-at) di)
              idx:i32 (tyvar-index-of ((unsafe/cast ptr:Node ptn) s) (mm tyvars) ntv))
          (when (= (aref (as ptr:ptr out-bound) idx) null)
            (when (= (unify-tpat ptn at (mm tyvars) ntv out-bound
                                 ((unsafe/cast ptr:Node ptn) line)) 0)
              (return 0)))))
      ; TC-1: if tyvars remain unbound after args+assoc, fill them from the
      ; expected type (want) by unifying the method's return pattern against it.
      ; unify-tpat only sets a slot that is still null (it does type-eq on an
      ; already-bound slot), so want fills, never overrides an arg-derived
      ; binding. Skipped when want is null OR the binding is already complete
      ; (the common case — every existing generic binds all tyvars from args, so
      ; this branch is inert under self-compilation and never touches the return
      ; pattern).
      (when (!= want null)
        (let (incomplete:i32 0)
          (dotimes (k ntv)
            (when (= (aref (as ptr:ptr out-bound) k) null) (set! incomplete 1)))
          (when (!= incomplete 0)
            (let (rnode:ptr (defn-ret-node (mm body)))
              (when (!= rnode null)
                (unify-tpat rnode want (mm tyvars) ntv out-bound
                            ((unsafe/cast ptr:Node rnode) line)))))))
      (dotimes (k ntv)
        (when (= (aref (as ptr:ptr out-bound) k) null) (return 0)))
      (return 1))))

; Check that each &where constraint is satisfied: the type bound to its variable
; must conform (nominally, via `extend`) to the named protocol.
(defn generic-constraints-ok (m:raw:Method bound:ptr line:i32):i32
  (let (mm:raw:Method m
        nc:i32 (mm num-constraints))
    (dotimes (i nc)
      (let (crec:ref:Constraint (constraints-at (mm constraints) i)
            proto:CStr (crec proto)
            var:CStr   (crec var)
            idx:i32 (tyvar-index-of var (mm tyvars) (mm num-tyvars))
            bt:ptr (aref (as ptr:ptr bound) idx))
        ; Blanket protocols (§10.1) conform automatically; Valid (§10.2) matches
        ; here and is checked structurally at the call site; otherwise require a
        ; nominal conformance recorded by `extend`. Stage 13 L7: a closure that
        ; has not hand-extended the protocol may still derive a structural
        ; conformance on demand (derive-closure-conformance is idempotent — if
        ; recover-one-constraint already fired during generic-method-bind, the
        ; conformance is already recorded and this is a no-op).
        (when (and (= (blanket-conforms bt proto) 0)
                   (and (!= proto "Valid")
                        (and (= (conformance-lookup (type-spelling bt) proto) 0)
                             (= (derive-closure-conformance bt proto line) 0))))
          (return 0))))
    (return 1)))

; ============================================================
; Stage 14 LW-1/LW-2: literal widening for the template tier
; ============================================================
; Template-tier methods (a receiver-inferred generic like `conj`/`invoke` over a
; parametric struct) are resolved by unify-tpat, which demands an *exact* match on
; every non-tyvar-binding parameter. So `(conj v 3)` on a `(Vector i64)` — which
; binds `T=i64` from the receiver and then needs the literal `3` to widen to i64 —
; failed to resolve, unlike a plain/protocol method (which reaches the tier-2
; arg-adapts loop). LW-1 extends that adaptation to the template tier; LW-2 mirrors
; the same tiers in `node-type-call` so the type model does not diverge from emit.

; Resolve a parameter type-pattern node to a concrete Type* under a tyvar binding.
; A bare tyvar symbol yields its bound Type* directly; anything else (a concrete
; type, or a parametric application still mentioning tyvars, e.g. `(Maybe T)`) is
; substituted with the bound spellings and parsed. Every tyvar in `bound` must be
; non-null (the callers guarantee this before invoking).
; Stage 15 B3′a: the shared "substitute the bound tyvars' spellings and re-parse"
; helper, and therefore a SYNTHESIS region — `type-spelling` renders a bound tyvar
; as its type's CANONICAL name, which the *calling* file usually cannot name. It is
; the chokepoint for `method-bound-ret-type` and `subst-param-types-bound`, so the
; arm belongs here rather than at either caller.
(defn resolve-param-type-bound (ptn:raw:Node tyvars:ptr bound:ptr ntv:i32 line:i32):?ptr:Type
  (when (= ptn null) (return null))
  (let (saved:i32 g-type-key-ok)
    (set! g-type-key-ok 1)
    (let (r:?ptr:Type (resolve-param-type-bound-in ptn tyvars bound ntv line))
      (set! g-type-key-ok saved)
      (return r))))

(defn resolve-param-type-bound-in (ptn:raw:Node tyvars:ptr bound:ptr ntv:i32 line:i32):?ptr:Type
  (let (pn:raw:Node ptn)
    (when (= (pn kind) NODE-SYM)
      (when (= (strchr (pn s) 58) null)
        (let (idx:i32 (tyvar-index-of (pn s) tyvars ntv))
          (when (>= idx 0) (return (aref (as ptr:ptr bound) idx))))))
    (let (spellings:ptr (arena-alloc (* (as i64 (+ ntv 1)) (ptr-bytes))))
      (dotimes (si ntv)
        (aset! (as ptr:ptr spellings) si (type-spelling (aref (as ptr:ptr bound) si))))
      (return (parse-type-from-node (subst-tyvars-node ptn tyvars spellings ntv) line)))))

; The concrete return type of a generic template method under a tyvar binding: a
; bare-tyvar return picks its bound Type*, else the (possibly parametric) return
; spelling is substituted and parsed. A method with no declared return is `void`.
; Extracted from generic-binds-for so the exact-template and adapted-template
; paths compute the return type identically (the node-type↔emit lockstep).
(defn method-bound-ret-type (m:raw:Method bound:ptr line:i32):?ptr:Type
  (let (mm:raw:Method m
        rnode:ptr (defn-ret-node (mm body)))
    (when (= rnode null) (return ty-void))
    (let (rt:ptr null)
      (when (= (-> rnode (unsafe/cast ptr:Node _) (_ kind)) NODE-SYM)
        (let (ridx:i32 (tyvar-index-of (-> rnode (unsafe/cast ptr:Node _) (_ s))
                                        (mm tyvars) (mm num-tyvars)))
          (when (>= ridx 0) (set! rt (aref (as ptr:ptr bound) ridx)))))
      (when (= rt null)
        (set! rt (resolve-param-type-bound rnode (mm tyvars) bound (mm num-tyvars) line)))
      (return rt))))

; The concrete parameter types of a generic template method under a tyvar binding,
; as a ptr-array. Used to key generic-instantiate's cache (generic-find-method-exact)
; on an adapted call, where the raw argument types (e.g. an i32 literal) differ from
; the stamped method's parameter types (i64) — matching what defn-params-to-types
; derives from the stamped form.
(defn subst-param-types-bound (m:raw:Method bound:ptr line:i32):ptr
  (let (mm:raw:Method m
        params-node:ptr (node-at (mm body) 2)
        nargs:i32 (mm num-params)
        ntv:i32 (mm num-tyvars)
        ptypes:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes))))
    (dotimes (i nargs)
      (aset! (as ptr:ptr ptypes) i
             (resolve-param-type-bound (binding-type-node (node-at params-node i))
                                       (mm tyvars) bound ntv line)))
    (return ptypes)))

; Like generic-method-bind, but admits widen/literal adaptation on the parameters
; the receiver-and-exact-args pass cannot match exactly (LW-1). Bind the tyvars
; from every parameter that unifies exactly (unchanged); then require every tyvar
; bound (adaptation never binds a tyvar); then require each remaining parameter's
; argument to adapt to its now-concrete (tyvar-substituted) parameter type. A
; fully-exact bind is rejected here (any-remaining==0) so tier-1 keeps sole
; ownership of exact template matches and tier-2 never double-counts one. Fills
; out-bound and returns 1 on an adapted match, else 0.
(defn generic-method-bind-adapt (m:raw:Method argtypes:ptr arg-nodes:ptr nargs:i32
                                     out-bound:ptr line:i32 want:raw:Type):i32
  (let (mm:raw:Method m)
    (when (!= (mm num-params) nargs) (return 0))
    (let (params-node:ptr (node-at (mm body) 2)
          ntv:i32 (mm num-tyvars)
          matched:ptr (arena-alloc (* (as i64 (+ nargs 1)) 4))
          saved:ptr (arena-alloc (* (as i64 (+ ntv 1)) (ptr-bytes)))
          any-remaining:i32 0)
      (dotimes (k ntv) (aset! (as ptr:ptr out-bound) k null))
      ; Pass 1: bind tyvars from every parameter that unifies exactly. A failed
      ; unify must leave no partial binding (unify-tpat only sets, never clears),
      ; so snapshot out-bound and restore on failure; that parameter is deferred to
      ; pass 2 (its argument checked for widen/literal adaptation).
      (dotimes (i nargs)
        (let (ptn:ptr (binding-type-node (node-at params-node i))
              at:ptr (aref (as ptr:ptr argtypes) i))
          (when (or (= ptn null) (= at null)) (return 0))
          (dotimes (k ntv) (aset! (as ptr:ptr saved) k (aref (as ptr:ptr out-bound) k)))
          (if (!= (unify-tpat ptn at (mm tyvars) ntv out-bound ((unsafe/cast ptr:Node ptn) line)) 0)
            (aset! (as ptr:i32 matched) i 1)
            (do (aset! (as ptr:i32 matched) i 0)
                (set! any-remaining 1)
                (dotimes (k ntv)
                  (aset! (as ptr:ptr out-bound) k (aref (as ptr:ptr saved) k)))))))
      ; A fully-exact bind is a tier-1 match — reject so tier-2 never double-counts.
      ; But only when the binding is actually COMPLETE: a method whose args all
      ; matched exactly yet still has an unbound tyvar (notably a zero-arg
      ; return-only-tyvar generic, or any return-only tyvar not reached by args)
      ; is NOT a tier-1 match, and must fall through to want-fill (TC-1) below,
      ; which may complete it. Without this guard a zero-arg generic dies here
      ; before want-fill ever runs.
      (when (= any-remaining 0)
        (let (complete:i32 1)
          (dotimes (k ntv)
            (when (= (aref (as ptr:ptr out-bound) k) null) (set! complete 0)))
          (when (!= complete 0) (return 0))))
      ; Recover associated tyvars from parametric &where constraints, then require
      ; every tyvar bound by the exactly-matched parameters (adaptation never binds
      ; a tyvar, so a tyvar reachable only through a deferred parameter stays null).
      (when (= (recover-assoc-into (mm tyvars) out-bound ntv
                                    (mm constraints)
                                    (mm num-constraints)
                                    ((mm body) line)) 0)
        (return 0))
      ; TC-1: fill any tyvars still unbound after exact-args+assoc from the
      ; expected type (want), BEFORE the all-bound check and before pass-2
      ; adaptation. LW's "adaptation never binds a tyvar" invariant is preserved:
      ; want-fill is a binding step distinct from the arg adaptation below.
      ; unify-tpat only sets a still-null slot, so want never overrides an
      ; arg-derived binding. Skipped when want is null OR the binding is already
      ; complete (the common case — inert under self-compilation).
      (when (!= want null)
        (let (incomplete:i32 0)
          (dotimes (k ntv)
            (when (= (aref (as ptr:ptr out-bound) k) null) (set! incomplete 1)))
          (when (!= incomplete 0)
            (let (rnode:ptr (defn-ret-node (mm body)))
              (when (!= rnode null)
                (unify-tpat rnode want (mm tyvars) ntv out-bound
                            ((unsafe/cast ptr:Node rnode) line)))))))
      (dotimes (k ntv)
        (when (= (aref (as ptr:ptr out-bound) k) null) (return 0)))
      ; Pass 2: every deferred parameter's argument must adapt (same rule as the
      ; plain tier-2: a literal adapts to any int, a typed value only same-sign
      ; widens) against its now-concrete parameter type.
      (dotimes (i nargs)
        (when (= (aref (as ptr:i32 matched) i) 0)
          (let (ptn:ptr (binding-type-node (node-at params-node i))
                at:ptr (aref (as ptr:ptr argtypes) i)
                pt:ptr (resolve-param-type-bound ptn (mm tyvars) out-bound ntv line)
                is-lit:i32 0
                is-flit:i32 0)
            (when (= pt null) (return 0))
            (when (!= arg-nodes null)
              (set! is-lit (node-is-int-literal (aref (as ptr:ptr arg-nodes) i)))
              (when (= is-lit 0)
                (set! is-flit (node-is-float-literal (aref (as ptr:ptr arg-nodes) i)))))
            (when (= (arg-adapts at pt is-lit is-flit) 0) (return 0)))))
      (return 1))))

; The shared tier-2 adaptation pool for generic resolution (LW-1/LW-2). Concrete
; (METHOD-USER) methods reachable by a widen/literal adaptation and parametric
; templates (METHOD-GENERIC) reachable by binding the receiver then adapting the
; rest compete in *one* ambiguity pool. Side-effect-free: no method is instantiated
; here (the emit caller monomorphizes a template winner; the node-type caller reads
; its bound return type), so both the dying and the null-returning caller share the
; identical resolution. Returns 0 = no tier-2 match, 1 = a unique METHOD-USER match
; (*out-method), 2 = a unique template match (*out-method + *out-bound), 3 = an
; ambiguous pool (the caller reports/ignores per its mode).
(defn generic-resolve-adapt-tier (g:raw:Generic argtypes:ptr arg-nodes:ptr nargs:i32 line:i32
                                      out-method:ptr:ptr out-bound:ptr:ptr want:raw:Type):i32
  (let (gg:raw:Generic g
        wmethod:ptr null
        wbound:ptr null
        wn:i32 0)
    ; METHOD-USER candidates reachable by widen/literal adaptation on every arg. A
    ; stamped template instance (origin-template ≠ null) is skipped: it is a cache
    ; of its template, which competes below, so counting both would spuriously read
    ; as an ambiguous overload after the first widened call instantiates it.
    (dotimes (k (unsafe/cast i32 (count (gg methods))))
      (let (m:ptr:Method (as ptr:Method (invoke (gg methods) (as usize k))))
        (when (and (= (m kind) METHOD-USER)
                   (= (m origin-template) null)
                   (= (m has-rest) 0) (= (m num-params) nargs))
          (let (ok:i32 1)
            (dotimes (a nargs)
              (let (is-lit:i32 0
                    is-flit:i32 0)
                (when (!= arg-nodes null)
                  (set! is-lit (node-is-int-literal (aref (as ptr:ptr arg-nodes) a)))
                  (when (= is-lit 0)
                    (set! is-flit (node-is-float-literal (aref (as ptr:ptr arg-nodes) a)))))
                (when (= (arg-adapts (aref (as ptr:ptr argtypes) a)
                                     (aref (as ptr:ptr (m param-types)) a) is-lit is-flit) 0)
                  (set! ok 0))))
            (when (!= ok 0)
              (set! wmethod (as ptr m)) (set! wbound null) (inc! wn))))))
    ; METHOD-GENERIC (template) candidates reachable by receiver-bind + adaptation.
    (dotimes (k (unsafe/cast i32 (count (gg methods))))
      (let (m:ptr:Method (as ptr:Method (invoke (gg methods) (as usize k))))
        (when (= (m kind) METHOD-GENERIC)
          (let (bound:ptr (arena-alloc (* (as i64 (+ (m num-tyvars) 1)) (ptr-bytes))))
            (when (!= (generic-method-bind-adapt (as ptr m) argtypes arg-nodes nargs bound line want) 0)
              (when (!= (generic-constraints-ok (as ptr m) bound line) 0)
                (set! wmethod (as ptr m)) (set! wbound bound) (inc! wn)))))))
    (when (> wn 1) (return 3))
    (when (= wn 0) (return 0))
    (ptr-set! out-method wmethod)
    (when (!= wbound null)
      (ptr-set! out-bound wbound)
      (return 2))
    (return 1)))

; Build a concrete defn form from a generic template + a type-variable binding:
; substitute the variables throughout, then drop the &where clause.
(defn monomorphize-form (form:raw:Node tyvars:ptr spellings:ptr ntv:i32 nparams:i32):raw:Node
  (let (ff:raw:Node form
        line:i32 (ff line)
        defn-sym:ptr (node-at form 0)
        name-node:ptr (subst-tyvars-node (node-at form 1) tyvars spellings ntv)
        params-src:ptr (subst-tyvars-node (node-at form 2) tyvars spellings ntv)
        new-params:ptr null
        body-src:ptr (subst-tyvars-node
                       (((ff cdr) cdr) cdr)
                       tyvars spellings ntv))
    (set! new-params (take-first-n params-src nparams line))
    (return (make-cell defn-sym
              (make-cell name-node
                (make-cell new-params body-src line)
                line)
              line))))

; Monomorphize a generic template for a concrete argument tuple: reuse a cached
; instantiation if present, else stamp a concrete method (registered now so the
; call site can name its symbol; its body is queued for later emission).
; Stage 15 B3′a: stamping a generic instance is a SYNTHESIS region. The stamped
; form's type operands are `type-spelling` output for every bound tyvar and the
; template file's own spellings for the rest — never anything the *calling* file
; wrote — and this runs at the call site, so resolving them as references asks the
; wrong file. `drain-mono-worklist` already arms the body's emission; the signature
; is parsed here, before the job is queued, and needed the same arm.
(defn generic-instantiate (g:raw:Generic m:raw:Method bound:ptr argtypes:ptr nargs:i32 line:i32):ref:Method
  (let (saved:i32 g-type-key-ok)
    (set! g-type-key-ok 1)
    (let (r:ref:Method (generic-instantiate-in g m bound argtypes nargs line))
      (set! g-type-key-ok saved)
      (return r))))

(defn generic-instantiate-in (g:raw:Generic m:raw:Method bound:ptr argtypes:ptr nargs:i32 line:i32):ref:Method
  (let (gg:raw:Generic g
        mm:raw:Method m)
    (let (existing:?ptr:Method (generic-find-method-exact g argtypes nargs))
      (when (!= existing null)
        (return existing)))
    ; Concrete spelling for each bound type variable, used to stamp the body.
    (let (ntv:i32 (mm num-tyvars)
          spellings:ptr (arena-alloc (* (as i64 (+ ntv 1)) (ptr-bytes))))
      (dotimes (si ntv)
        (aset! (as ptr:ptr spellings) si (type-spelling (aref (as ptr:ptr bound) si))))
    (let (stamped:ptr (monomorphize-form (mm body) (mm tyvars) spellings
                                         (mm num-tyvars) (mm num-params))
          sname:ptr null
          ; S1: a new-style template stamps its return type into the index-3 keyword
          ; (substituted by subst-tyvars-node's NODE-KEYWORD branch inside
          ; monomorphize-form); parse it with the fn grammar. Legacy stamped forms
          ; keep the exact extract-name-and-type parse.
          s-ret-node:ptr null
          s-params:ptr null
          s-bstart:i32 3
          s-style:i32 (defn-parse-sig stamped (as ptr:ptr (addr-of sname))
                        (as ptr:ptr (addr-of s-ret-node))
                        (as ptr:ptr (addr-of s-params))
                        (as ptr:i32 (addr-of s-bstart)))
          sret:ptr (if (!= s-style 0)
                     (fn-parse-ret-type s-ret-node line)
                     (extract-name-and-type (node-at stamped 1) (as ptr:ptr (addr-of sname))
                                            ((unsafe/cast ptr:Node (node-at stamped 1)) line))))
      (when (= sret null)
        (die-at line (fmt-s "generic '%s': cannot resolve instantiated return type" (gg name))))
      ; Valid bound (§10.2): dry-run the concrete body before committing it, so an
      ; operation C can't support is reported at this call site, not at stamp time.
      (when (!= (method-has-valid m) 0)
        (valid-check-instance m stamped bound line))
      (let (ptypes:ptr null)
        ; Stage 13 L7: parse param types from the STAMPED form (not argtypes) so
        ; the method's param-types match what emit-defn will re-parse from the
        ; same stamped form. This matters when a bare TY-FN arg flows into a
        ; (ref G) param: argtypes has bare TY-FN, but the stamped form has
        ; (ref __fnty_N) = TY-PTR. Using the stamped-form types keeps
        ; defn-ir-name, mangle-fn-name, and emit-resolved-call's TY-FN-to-
        ; (ref TY-FN) calling-convention adaptation all consistent.
        (let (stamped-params:ptr (node-at stamped 2))
          (set! ptypes (defn-params-to-types stamped-params))
          (set! nargs (defn-params-count stamped-params)))
        (let (newm:ref:Method (generic-register-method (gg name) sret ptypes nargs 0 0 stamped)
              ; Stage 12 N4: mangle the stamped concrete method under the
              ; template's *defining* namespace (gg ir-prefix), not the call
              ; site's current namespace.
              mangled:ptr (mangle-fn-name (gg ir-prefix) (gg name) ptypes nargs)
              job:ptr:MonoJob (new MonoJob))
          (.set! newm ir-name mangled)
          ; Stage 14 LW-1: mark this as a stamped instance of the template `mm` so
          ; tier-2 widening resolution treats the two as one overload.
          (.set! newm origin-template mm)
          ; Stage 15 B4: a stamp is owned by the TEMPLATE's namespace, not by the
          ; call site's — the same distinction `(gg ir-prefix)` above already
          ; makes for mangling. `generic-register-method` wrote `g-current-ns`,
          ; which here is the calling file's. Without this correction the second
          ; `p/tmpl` call in another namespace filters the first stamp out of the
          ; method set, `generic-find-method-exact`'s memo probe misses, and the
          ; instance is stamped (and emitted) twice under one symbol.
          (.set! newm src-ns (mm src-ns))
          ; Record where this instantiation was requested, so a stamp-time emit
          ; error in the body points back here (g-source-path is the call site's).
          (.set! job form stamped)
          (.set! job context
                 (fmt-2s-i "while instantiating %s (requested at %s:%d)"
                           mangled g-source-path line))
          (conj g-mono-worklist job)
          (return newm)))))))

; ============================================================
; A2: def-time checking of bounded-generic bodies
; ============================================================
; Type-check a generic template body ONCE at its definition against the abstract
; protocol interface: a value of type variable T (an abstract `TY-TYVAR`) admits
; only the operations its `&where` protocols declare (with Self → T) — plus calls
; to other generics whose own constraints T's constraints satisfy. A use the
; constraints don't provide errors at the `defn`, not at the first instantiation.
; This never emits and only ever manufactures TY-TYVAR types, which codegen never
; sees (templates emit only after monomorphization).

(defn make-tyvar-type (m:ptr idx:i32):ref:Type
  (let (t:ref:Type (make-type TY-TYVAR))
    (.set! t sdef m)         ; owning template Method*
    (.set! t num-params idx) ; tyvar index within that template
    (return t)))

; t is genuinely a Type* (TY-TYVAR-flavored); only its `sdef` slot is a
; deliberate type pun (holds the owning template Method*, not a StructDef*,
; and is never read except through the explicit cast below) — confined to
; this A2 checker, never reaching codegen.
(defn tyvar-type-name (t:raw:Type):ptr
  (let (m:ptr:Method (unsafe/cast ptr:Method (t sdef))
        idx:i32 (t num-params))
    (return (aref (as ptr:ptr (m tyvars)) idx))))

(defn is-tyvar-type (t:raw:Type):i32
  (when (= t null) (return 0))
  (if (= (t kind) TY-TYVAR) (return 1) (return 0)))

; The type-spelling tail of a colon symbol ("a:Self" → "Self"), or null.
(defn colon-tail (s:CStr):CStr
  (let (nm:ptr null tail:ptr null)
    (split-typed s (as ptr:ptr (addr-of nm)) (as ptr:ptr (addr-of tail)))
    (return tail)))

; Parse a concrete type from a colon spelling string (no Self/tyvars).
(defn parse-type-spelling-str (s:CStr line:i32):ptr
  (when (= (strchr s 58) null) (return (parse-type-name s line)))
  (return (parse-type-from-node (split-colon-segments s line) line)))

; Does a colon spelling mention "Self" as a segment other than being exactly Self?
(defn spelling-nests-self (s:CStr):i32
  (when (= s "Self") (return 0))
  (let (segs:ptr (split-colon-segments s 0))
    (let (it:ListIter (list-iter segs))
      (doseq-iter (cur (addr-of it))
        (when (= ((unsafe/cast ptr:Node cur) s) "Self")
          (return 1)))))
  (return 0))

(defn caller-has-constraint (m:raw:Method tyvar-name:CStr proto:CStr):i32
  (let (mm:raw:Method m)
    (dotimes (i (mm num-constraints))
      (let (crec:ref:Constraint (constraints-at (mm constraints) i))
        (when (and (= (crec var) tyvar-name)
                   (= (crec proto) proto))
          (return 1)))))
  (return 0))

; Does protocol signature `sig` provide the call `head(argtypes)` for tyvar `ti`
; of template `m` (Self → that tyvar)? Returns the call's result type or null.
(defn sig-provides-call (sig:raw:Node head:CStr ti:i32 m:raw:Method argtypes:ptr nargs:i32 line:i32):ptr
  (let (name-node:ptr (node-at sig 0)
        params:ptr (node-at sig 1)
        nm:ptr null
        rettail:ptr null)
    (if (!= (sig-name-is-bare name-node) 0)
      ; S1 new style: bare method name at 0, return operand at 2. rettail is the
      ; return's colon-spelling ("Self", "i32", "ptr:Node"); a list-form return
      ; leaves it null (→ ty-void here), matching the legacy list-head limitation.
      (do
        (set! nm (-> name-node (unsafe/cast ptr:Node _) (_ s)))
        (when (>= (node-len sig) 3)
          (let (rn:ptr:Node (unsafe/cast ptr:Node (node-at sig 2)))
            (when (or (= (rn kind) NODE-KEYWORD) (= (rn kind) NODE-SYM))
              (set! rettail (rn s))))))
      (split-typed (-> name-node (unsafe/cast ptr:Node _) (_ s))
                   (as ptr:ptr (addr-of nm)) (as ptr:ptr (addr-of rettail))))
    (when (= nm head)
      (when (= (node-len params) nargs)
        (let (ok:i32 1)
          (dotimes (i nargs)
            (let (pn:ptr:Node (unsafe/cast ptr:Node (node-at params i))
                  pspell:ptr (colon-tail (pn s))
                  at:ptr (aref (as ptr:ptr argtypes) i))
              (if (and (!= pspell null) (= pspell "Self"))
                (when (or (= (is-tyvar-type at) 0)
                          (!= (-> at (unsafe/cast ptr:Type _) (_ num-params)) ti)
                          (!= (-> at (unsafe/cast ptr:Type _) (_ sdef)) m))
                  (set! ok 0))
                (if (or (= pspell null) (!= (spelling-nests-self pspell) 0))
                  (set! ok 0)
                  (when (= (type-eq (parse-type-spelling-str pspell line) at) 0)
                    (set! ok 0))))))
          (when (!= ok 0)
            (when (and (!= rettail null) (= rettail "Self"))
              (return (make-tyvar-type m ti)))
            (when (= rettail null) (return ty-void))
            (return (parse-type-spelling-str rettail line))))))
    (return null)))

; Resolve a call with at least one abstract argument against the protocol methods
; provided by the constraints on the call's tyvar arguments. Result type or null.
(defn abstract-call-via-protocol (head:CStr argtypes:ptr nargs:i32 m:raw:Method line:i32):ptr
  (let (mm:raw:Method m)
    (dotimes (ti (mm num-tyvars))
      (let (tvname:CStr (aref (as ptr:ptr (mm tyvars)) ti))
        (dotimes (ci (mm num-constraints))
          (let (crec:ref:Constraint (constraints-at (mm constraints) ci))
           (when (= (crec var) tvname)
            ; B2a: `Constraint.proto` was canonicalized where it was WRITTEN
            ; (parse-where-constraints), so this is a key, not a reference.
            (let (proto:ptr (protocol-lookup-ns (crec proto)))
              (when (!= proto null)
                (let (pp:ptr:Protocol (as ptr:Protocol proto))
                  (dotimes (si (pp num-sigs))
                    (let (rt:ptr (sig-provides-call (aref (as ptr:ptr (pp sigs)) si)
                                                    head ti m argtypes nargs line))
                      (when (!= rt null) (return rt)))))))))))))
  (return null))

; Resolve an abstract-argument call against another generic template whose own
; constraints are satisfied by the caller's tyvar constraints. Result type or null.
(defn abstract-call-via-generic (head:CStr argtypes:ptr nargs:i32 m:raw:Method line:i32):ptr
  (let (g:ptr (generic-lookup head))
    (when (= g null) (return null))
    (let (gg:ptr:Generic (as ptr:Generic g))
      (dotimes (gi (unsafe/cast i32 (count (gg methods))))
        (let (m2:ptr:Method (as ptr:Method (invoke (gg methods) (as usize gi))))
          (when (= (m2 kind) METHOD-GENERIC)
            (let (bound:ptr (arena-alloc (* (as i64 (+ (m2 num-tyvars) 1)) (ptr-bytes))))
              (when (!= (generic-method-bind (as ptr m2) argtypes nargs bound null null) 0)
                (let (ok:i32 1)
                  (dotimes (ci (m2 num-constraints))
                    (let (crec:ref:Constraint (constraints-at (m2 constraints) ci)
                          uidx:i32 (tyvar-index-of (crec var)
                                                   (m2 tyvars) (m2 num-tyvars))
                          proto:CStr (crec proto)
                          bt:ptr (aref (as ptr:ptr bound) uidx))
                      (if (!= (is-tyvar-type bt) 0)
                        (when (= (caller-has-constraint m (tyvar-type-name bt) proto) 0)
                          (set! ok 0))
                        (when (= (conformance-lookup (type-spelling bt) proto) 0)
                          (set! ok 0)))))
                  (when (!= ok 0)
                    ; result = m2's return spelling, its tyvars substituted by `bound`
                    (let (rnode:ptr (defn-ret-node (m2 body)))
                      (when (= rnode null) (return ty-void))
                      (when (= (-> rnode (unsafe/cast ptr:Node _) (_ kind)) NODE-SYM)
                        (let (ridx:i32 (tyvar-index-of (-> rnode (unsafe/cast ptr:Node _) (_ s))
                                                       (m2 tyvars) (m2 num-tyvars)))
                          (when (>= ridx 0) (return (aref (as ptr:ptr bound) ridx)))))
                      ; A parametric return type — e.g. (Maybe T) — is a NODE-CELL
                      ; that still mentions the method's tyvars. Substitute each
                      ; tyvar with its bound concrete spelling before parsing, so
                      ; `(Maybe T)` with T:=ptr parses as `(Maybe ptr)` rather than
                      ; failing with "unknown type: T".
                      (let (ntv:i32 (m2 num-tyvars)
                            spellings:ptr (arena-alloc
                                            (* (as i64 (+ ntv 1)) (ptr-bytes))))
                        (dotimes (si ntv)
                          (aset! (as ptr:ptr spellings) si
                                 (type-spelling (aref (as ptr:ptr bound) si))))
                        (return (parse-type-from-node
                                  (subst-tyvars-node rnode (m2 tyvars) spellings ntv)
                                  line))))))))))))
    (return null)))

; Is this head one of the core special forms (mirrors emit-list's dispatch)?
; Such forms are handled structurally by gcheck, never as function calls.
; hp is the head Node* itself (not its string spelling) — every symbol Node
; is `intern-symbol`-canonicalized (lib/node.nuc), so comparing the whole
; Node* by `=` against a quoted-symbol literal ('let, 'with, ...) is a valid,
; fast identity test, matching emit-list's dispatch in nucleusc.nuc. Node is
; not a string kind, so this `=` is a plain `icmp eq ptr` regardless of hp's
; declared pointer kind — (raw Node) here costs nothing (unlike the CStr/
; Node.s identity trap for genuine *string* params elsewhere in this file).
(defn gcheck-special-form (hp:raw:Node):i32
  (when (or (= hp 'let) (= hp 'with)) (return 1))
  (when (or (= hp 'do) (= hp 'cond)) (return 1))
  (when (or (= hp 'return) (= hp 'while)) (return 1))
  (when (or (= hp 'set!) (= hp 'inc!)) (return 1))
  (when (or (= hp 'quote) (= hp 'quasiquote)) (return 1))
  (when (or (= hp 'not)  (= hp '_and) (= hp '_or)) (return 1))
  (when (or (= hp 'cast) (= hp 'addr-of)) (return 1))
  (when (or (= hp 'deref) (= hp 'ptr-set!) (= hp 'ptr+)) (return 1))
  (when (or (= hp '_get) (= hp '.set!)) (return 1))
  (when (or (= hp 'sizeof) (= hp 'alloca) (= hp 'char)) (return 1))
  (when (or (= hp 'aref) (= hp 'aset!) (= hp 'gensym)) (return 1))
  (when (or (= hp 'funcall) (= hp 'funcall-void)) (return 1))
  (when (or (= hp 'funcall-ptr-1) (= hp 'funcall-ptr-i32)) (return 1))
  (when (or (= hp 'funcall-ptr-i64) (= hp 'funcall-ptr-ptr)) (return 1))
  ; Stage 14 UN-4: the unsafe namespace's roster is reachable from generic
  ; template bodies too (e.g. vector-new-in's heap-placement cast) — without
  ; these, the A2 walk below misreads `(unsafe/cast T x)`/`(as T x)` as an
  ; unresolved function call ("in generic body: unknown function 'unsafe/cast'").
  (when (or (= hp 'as) (= hp 'unsafe/cast)) (return 1))
  (when (or (= hp 'unsafe/ptr+) (= hp 'unsafe/funcall-ptr-1)) (return 1))
  (when (or (= hp 'unsafe/funcall-ptr-i32) (= hp 'unsafe/funcall-ptr-i64)) (return 1))
  (when (= hp 'unsafe/funcall-ptr-ptr) (return 1))
  (when (or (= hp 'some) (= hp 'as-ref) (= hp 'unwrap)) (return 1))
  (when (or (= hp 'unwrap-or) (= hp 'if-some) (= hp 'when-some)) (return 1))
  (when (or (= hp 'move) (= hp 'defer)) (return 1))
  (when (or (= hp 'err-name) (= hp 'err-message) (= hp 'match)) (return 1))
  (when (or (= hp 'make) (= hp 'err!) (= hp 'type-token)) (return 1))
  (when (= hp 'signal) (return 1))
  (return 0))

; Declared type of a let/with binding name in a generic body. Handles both the
; un-desugared colon symbol ("r:T") and the desugared (name type) cell. Returns
; null for an untyped binding (caller infers from the value).
(defn gbind-decl-type (bind-node:raw:Node m:raw:Method line:i32):ptr
  (let (n:raw:Node bind-node)
    (case (n kind)
      NODE-SYM
        (let (tail:ptr (colon-tail (n s)))
          (when (= tail null) (return null))
          (let (idx:i32 (tyvar-index-of tail (m tyvars) (m num-tyvars)))
            (when (>= idx 0) (return (make-tyvar-type m idx)))
            (return (parse-type-spelling-str tail line))))
      NODE-CELL
        (let (tnode:ptr (node-at bind-node 1))
          (when (= tnode null) (return null))
          (when (= (-> tnode (unsafe/cast ptr:Node _) (_ kind)) NODE-SYM)
            (let (idx:i32 (tyvar-index-of (-> tnode (unsafe/cast ptr:Node _) (_ s))
                                          (m tyvars) (m num-tyvars)))
              (when (>= idx 0) (return (make-tyvar-type m idx)))))
          (return (parse-type-from-node tnode line)))
      0)
    (return null)))

(defn gbind-name (bind-node:raw:Node):ptr
  (let (n:raw:Node bind-node)
    (case (n kind)
      NODE-SYM
        (let (nm:ptr null tail:ptr null)
          (split-typed (n s) (as ptr:ptr (addr-of nm)) (as ptr:ptr (addr-of tail)))
          (return nm))
      NODE-CELL (return ((n car) s))
      0)
    (return null)))

; Type-check one node of a generic body in `scope`, against template `m`.
; Returns the node's (possibly abstract) type, or null when not modeled. Aborts
; with a def-time diagnostic on an operation the constraints do not provide.
(defn gcheck (n:raw:Node scope:ref:Scope m:raw:Method):ptr
  (when (= n null) (return ty-void))
  (let (nn:raw:Node n)
    (case (nn kind)
      NODE-INT   (return ty-i32)
      NODE-FLOAT (return ty-f64)
      ; Stage 14 NS-3: string literals are StrView (was CStr). Lockstep with
      ; emit-string / node-type / valid-walk (conventions.md node-type↔emit-node).
      NODE-STR
        ; NS-4: an explicit c"…" literal (reader set Node.i=1) types as CStr, not
        ; the StrView default — lockstep with emit-string's NS-4 short-circuit.
        (if (!= (nn i) 0) (return ty-cstr) (return (strview-type)))
      NODE-CHAR  (return ty-char)
      NODE-SYM   (return (node-type-sym n scope))
      0)
    (when (!= (nn kind) NODE-CELL) (return ty-void))
    (when (= (node-len n) 0) (return null))
    (let (head:ptr:Node (unsafe/cast ptr:Node (node-at n 0)))
      (when (!= (head kind) NODE-SYM)
        ; non-symbol head: just walk compound children for nested calls.
        (gcheck-walk-children n scope m)
        (return null))
      (let (h:CStr (head s)
            hp:raw:Node head)
        ; TC-4: a cell whose head names a REGISTERED STRUCT TEMPLATE is a TYPE
        ; operand (e.g. (Box T), (Vector i32)), never a function call — struct
        ; template names and function/generic names do not collide in this
        ; codebase. Without this, gcheck would walk e.g. (Box T) as an
        ; unknown-function call (Box is a struct template, not a generic) and
        ; abort the A2 check with "in generic body: unknown function 'Box'" —
        ; blocking the TC-4 constructor body shape. Defer (null): the precise
        ; stamped type is produced at monomorphization; for the A2 walk the
        ; type is check-only (conventions.md: TY-TYVAR is check-only). This
        ; recognizes the type-application head only; a compound literal whose
        ; head is the CELL ((Vector i32) v0 ...) has a non-SYM head and never
        ; reaches here (node-template-of checks head kind == NODE-SYM).
        (when (!= (as ptr (node-template-of n)) null) (return null))
        ; TC-4: a type-wrapper keyword head (ref/raw/ptr) is likewise a type
        ; spelling — e.g. (ref (Vector T)), (raw Node) — never a call. Without
        ; this the heap `-in` constructor body `(cast (ref (Vector T)) …)` dies
        ; "in generic body: unknown function 'ref'". Defer (null): a check-only
        ; type pass need not model the wrapper; stamping happens at monomorphize.
        (when (or (= hp 'ref) (= hp 'raw) (= hp 'ptr)) (return null))
        ; Expand macros (if/when/-> …) so the body is core forms.
        (when (!= (find-macro h) null)
          (let (ex:ptr (macroexpand-form n 1))
            (when (!= ex n) (return (gcheck ex scope m)))))
        (when (or (= hp 'quote) (= hp 'quasiquote)) (return ty-ptr))
        ; let / with: bind names (possibly abstract), then check the body.
        (when (or (= hp 'let) (= hp 'with))
          (let (binds:ptr (node-at n 1)
                inner:ref:Scope (scope-new scope)
                bl:i32 (node-len binds)
                i:i32 0)
            (while (< i bl)
              (let (bname:ptr (node-at binds i)
                    bval:ptr (node-at binds (+ i 1))
                    vty:ptr (gcheck bval inner m)
                    dty:ptr (gbind-decl-type bname m (nn line))
                    nm:ptr (gbind-name bname))
                (when (= dty null) (set! dty vty))
                (when (and (!= nm null) (!= dty null))
                  (scope-define inner nm dty nm 1)))
              (set! i (+ i 2)))
            (let (last:ptr null j:i32 2 cl:i32 (node-len n))
              (while (< j cl) (set! last (gcheck (node-at n j) inner m)) (inc! j))
              (return last))))
        ; Closure forms (vfn/fn/mfn/cfn): `(vfn (params) ret body…)`. Bind each
        ; param in an inner scope (so the param list is NOT walked as calls — the
        ; bug that blocked flat-tyvar closure-returning generics like `constantly`)
        ; and check the body forms. The ret annotation (index 2) and param types
        ; are not calls; the captured-value operations are deferred to stamp time
        ; (the concrete monomorphized closure body goes through the ordinary
        ; emit/type pass). Boot-inert: no compiler generic creates a closure.
        (when (or (= h "vfn") (= h "fn") (= h "mfn") (= h "cfn"))
          (let (cparams:ptr (node-at n 1)
                cinner:ref:Scope (scope-new scope)
                cnp:i32 (node-len cparams))
            (dotimes (cpi cnp)
              (let (cpnode:ptr (node-at cparams cpi)
                    cpty:ptr (gbind-decl-type cpnode m (nn line))
                    cpnm:ptr (gbind-name cpnode))
                (when (and (!= cpnm null) (!= cpty null))
                  (scope-define cinner cpnm cpty cpnm 1))))
            (let (clast:ptr null cj:i32 3 ccl:i32 (node-len n))
              (while (< cj ccl) (set! clast (gcheck (node-at n cj) cinner m)) (inc! cj))
              (return clast))))
        (when (= hp 'do)
          (let (last:ptr null j:i32 1 cl:i32 (node-len n))
            (while (< j cl) (set! last (gcheck (node-at n j) scope m)) (inc! j))
            (return last)))
        ; cond / _and / _or / not / set! / inc! / return / while and the structural
        ; special forms: walk compound children; result type is not modeled.
        (when (!= (gcheck-special-form hp) 0)
          (gcheck-walk-children n scope m)
          (return null))
        ; A genuine call: type the arguments (catching nested abstract calls),
        ; then resolve the head. Lenient model: resolve protocol-method and
        ; generic calls precisely (good types for nested checking); for anything
        ; else, only a genuinely unknown name is an error — a known operation
        ; (operator, foreign/concrete function) on an abstract value is deferred
        ; to stamp-time (A1), since it may well be valid for the concrete type.
        (let (nargs:i32 (- (node-len n) 1)
              argtypes:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes)))
              any-abstract:i32 0)
          (dotimes (i nargs)
            (let (at:ptr (gcheck (node-at n (+ i 1)) scope m))
              (aset! (as ptr:ptr argtypes) i at)
              (when (!= (is-tyvar-type at) 0) (set! any-abstract 1))))
          ; Protocol-method resolution (Self → tyvar) takes priority — a required
          ; method need not have a concrete impl in this unit to be a valid call.
          (when (!= any-abstract 0)
            (let (rt:ptr (abstract-call-via-protocol h argtypes nargs m (nn line)))
              (when (!= rt null) (return rt))
              (set! rt (abstract-call-via-generic h argtypes nargs m (nn line)))
              (when (!= rt null) (return rt))))
          (let (g:ptr (generic-lookup h))
            ; Intrinsic operator: best-effort type (i1 for comparisons, else the
            ; first operand's type — possibly the abstract tyvar). Deferred, no error.
            (when (!= g null)
              (let (m0:ptr:Method (as ptr:Method (invoke (-> g (as ptr:Generic _) (_ methods)) 0)))
                (when (= (m0 kind) METHOD-INTRINSIC)
                  (when (!= ((m0 binop) is-cmp) 0) (return ty-i1))
                  (return (gcheck (node-at n 1) scope m)))))
            ; A name that is neither a generic nor scope-bound is a typo — error
            ; whether or not an argument is abstract.
            (when (and (= g null) (= (scope-lookup scope h) null))
              (die-at (nn line) (fmt-s "in generic body: unknown function '%s'" h)))
            ; Known name, unresolved here: defer to stamp-time. Concrete calls get
            ; a best-effort type; abstract ones stay unknown (null).
            (when (!= any-abstract 0) (return null))
            (return (node-type-call n scope h null))))))))

; Walk only the compound (list) children of a node, checking nested calls but
; ignoring bare symbols (which may be type names, field names, or places).
(defn gcheck-walk-children (n:raw:Node scope:ref:Scope m:raw:Method):void
  (let (cl:i32 (node-len n) i:i32 1)
    (while (< i cl)
      (let (c:raw:Node (node-at n i))
        (when (and (!= c null) (= (c kind) NODE-CELL))
          (gcheck c scope m)))
      (inc! i))))

; Run the A2 check on one generic template: bind its parameters to their abstract
; (or concrete) types, then check each body form.
(defn check-generic-template (m:raw:Method):void
  (let (mm:raw:Method m
        form:raw:Node (mm body)
        params-node:ptr (node-at form 2)
        scope:ref:Scope (scope-new g-globals)
        nparams:i32 (mm num-params))
    ; Every &where constraint must name a known protocol/blanket/Valid — checked
    ; here (not at prescan) so an imported protocol is already registered.
    (dotimes (ci (mm num-constraints))
      (let (crec:ref:Constraint (constraints-at (mm constraints) ci)
            pnm:CStr (crec proto))
        (when (= (constraint-proto-known pnm) 0)
          (die-at (form line)
            (fmt-s "defn: &where names unknown protocol '%s'" pnm)))))
    (dotimes (i nparams)
      (let (pnode:ptr (node-at params-node i)
            pty:ptr (gbind-decl-type pnode m (form line))
            pnm:ptr (gbind-name pnode))
        (when (and (!= pnm null) (!= pty null))
          (scope-define scope pnm pty pnm 1))))
    ; S1/S3: the body starts after the return operand — index 4 for a new-style
    ; template (bare name, ret at 3), index 3 for a legacy one. Walking from 3
    ; unconditionally would gcheck a new-style CELL return (e.g. `(BoxedFn (V) V)`)
    ; as a body form, mis-reading its `(V …)` as a call to an unknown function.
    (let (cl:i32 (node-len form)
          j:i32 (if (!= (sig-name-is-bare (node-at form 1)) 0) 4 3))
      (while (< j cl)
        (gcheck (node-at form j) scope m)
        (inc! j)))))

; Does any parameter of this generic template bind a tyvar in a *nested* position
; — inside a ptr/ref wrapper or a parametric-struct application (a receiver-
; inferred method, parametric-structs.md §4)? The abstract A2 interface check
; (gbind-decl-type) only models flat tyvar parameters; a nested receiver type
; cannot be parsed against an abstract element, so such a template defers all body
; type-checking to stamp time (the concrete monomorphized body goes through the
; ordinary emit/type pass). A plain flat-tyvar `&where` template returns 0 here
; and is A2-checked exactly as before (byte-identical).
(defn method-has-nested-tyvar (m:raw:Method):i32
  (let (mm:raw:Method m
        params-node:ptr (node-at (mm body) 2)
        np:i32 (mm num-params))
    (dotimes (i np)
      (let (ptn:raw:Node (binding-type-node (node-at params-node i)))
        (when (and (!= ptn null)
                   (and (= (ptn kind) NODE-CELL)
                        (!= (node-mentions-tyvar ptn (mm tyvars) (mm num-tyvars)) 0)))
          (return 1))))
    (return 0)))

; Check every not-yet-checked bounded-generic template. Runs after the top-level
; loop (so includes/imports/protocols/conformances are all registered) and before
; the worklist drain (so a body error surfaces at the defn, before any A1
; stamp-time error from instantiation).
(defn check-generic-templates ():void
  (dotimes (gi (unsafe/cast i32 (count g-generics)))
    (let (gg:ptr:Generic (as ptr:Generic (invoke g-generics (as usize gi))))
      (dotimes (mi (unsafe/cast i32 (count (gg methods))))
        (let (m:ptr:Method (as ptr:Method (invoke (gg methods) (as usize mi))))
          (when (and (= (m kind) METHOD-GENERIC) (= (m checked) 0))
            (.set! m checked 1)
            ; Receiver-inferred methods (nested tyvar receivers) defer body
            ; checking to stamp time; the abstract interface check only models
            ; flat tyvar parameters.
            (when (= (method-has-nested-tyvar m) 0)
              (check-generic-template m))))))))

; ============================================================
; Valid: inferred structural bounds (Stage 9 §10.2)
; ============================================================
; `&where (Valid T)` bounds T structurally: instead of naming a protocol, the
; required interface is whatever the body does to T-typed values. Per the
; designer (open Q3), this is realized as a per-call-site non-emitting stamp —
; at each instantiation (T := C known) the body is substituted and the rung-3
; type pass is run over it WITHOUT emitting, so any operation the concrete type C
; cannot support is reported at the call site (ahead of, and clearer than, the
; A1 stamp-time emit error), and derived-value chains are handled by the same
; concrete walk (no associated-type solver).

; Does this template carry a Valid constraint?
(defn method-has-valid (m:raw:Method):i32
  (let (mm:raw:Method m)
    (dotimes (i (mm num-constraints))
      (let (crec:ref:Constraint (constraints-at (mm constraints) i))
        (when (= (crec proto) "Valid") (return 1)))))
  (return 0))

; The concrete declared type of a binding in a stamped (substituted) body, or
; null when untyped (the caller infers it from the value).
(defn valid-decl-type (bind-node:raw:Node line:i32):ptr
  (let (n:raw:Node bind-node)
    (case (n kind)
      NODE-SYM
        (let (nm:ptr null tail:ptr null)
          (split-typed (n s) (as ptr:ptr (addr-of nm)) (as ptr:ptr (addr-of tail)))
          (when (= tail null) (return null))
          (return (parse-type-spelling-str tail line)))
      NODE-CELL
        (let (tnode:ptr (node-at bind-node 1))
          (when (= tnode null) (return null))
          (return (parse-type-from-node tnode line)))
      0)
    (return null)))

; The result type of a generic template `m2` for a concrete binding, or null:
; a bare-tyvar return is the bound type; anything else is parsed concretely.
(defn template-result-type (m2:raw:Method bound:ptr line:i32):ptr
  (let (mm:raw:Method m2
        rnode:ptr (defn-ret-node (mm body)))
    (when (= rnode null) (return ty-void))
    (when (= (-> rnode (unsafe/cast ptr:Node _) (_ kind)) NODE-SYM)
      (let (ridx:i32 (tyvar-index-of (-> rnode (unsafe/cast ptr:Node _) (_ s))
                                     (mm tyvars) (mm num-tyvars)))
        (when (>= ridx 0) (return (aref (as ptr:ptr bound) ridx)))))
    (return (parse-type-from-node rnode line))))

; Non-dying resolution of a concrete call against generic `g`: returns the call's
; result type if it resolves (exact method, built-in operator, user-operator or
; user-method widen, or a bounded-generic template), else null. The Valid walk
; turns a null here into a localized call-site error.
(defn valid-resolve-type (g:raw:Generic argtypes:ptr arg-nodes:ptr nargs:i32 line:i32):ptr
  (let (gg:raw:Generic g)
    (let (m:ptr (generic-find-method-exact g argtypes nargs))
      (when (!= m null) (return (-> m (unsafe/cast ptr:Method _) (_ ret-type)))))
    (let (rt:ptr (builtin-op-result-type g argtypes nargs))
      (when (!= rt null) (return rt)))
    (let (m:ptr (operator-user-resolve g argtypes arg-nodes nargs))
      (when (!= m null) (return (-> m (unsafe/cast ptr:Method _) (_ ret-type)))))
    ; widen on a concrete user method
    (let (wcand:ptr null wn:i32 0)
      (dotimes (i (unsafe/cast i32 (count (gg methods))))
        (let (m:ptr:Method (as ptr:Method (invoke (gg methods) (as usize i))))
          (when (and (= (m kind) METHOD-USER)
                     (and (= (m has-rest) 0) (= (m num-params) nargs)))
            (let (ok:i32 1)
              (dotimes (a nargs)
                (let (is-lit:i32 0
                      is-flit:i32 0)
                  (when (!= arg-nodes null)
                    (set! is-lit (node-is-int-literal (aref (as ptr:ptr arg-nodes) a)))
                    ; W2d: mutually exclusive, and node-is-float-literal
                    ; macroexpands a cell operand — skip the second walk when the
                    ; first already answered.
                    (when (= is-lit 0)
                      (set! is-flit (node-is-float-literal (aref (as ptr:ptr arg-nodes) a)))))
                  (when (= (arg-adapts (aref (as ptr:ptr argtypes) a)
                                       (aref (as ptr:ptr (m param-types)) a) is-lit is-flit) 0)
                    (set! ok 0))))
              (when (!= ok 0) (set! wcand (as ptr m)) (inc! wn))))))
      (when (= wn 1) (return (-> wcand (unsafe/cast ptr:Method _) (_ ret-type)))))
    ; bounded-generic template
    (dotimes (j (unsafe/cast i32 (count (gg methods))))
      (let (m:ptr:Method (as ptr:Method (invoke (gg methods) (as usize j))))
        (when (= (m kind) METHOD-GENERIC)
          (let (bound:ptr (arena-alloc (* (as i64 (+ (m num-tyvars) 1)) (ptr-bytes))))
            (when (and (!= (generic-method-bind (as ptr m) argtypes nargs bound null arg-nodes) 0)
                       (!= (generic-constraints-ok (as ptr m) bound line) 0))
              (return (template-result-type (as ptr m) bound line)))))))
    (return null)))

(defn valid-walk-children (n:raw:Node scope:ref:Scope gname:CStr cty:CStr line:i32):void
  (let (cl:i32 (node-len n) i:i32 1)
    (while (< i cl)
      (let (c:raw:Node (node-at n i))
        (when (and (!= c null) (= (c kind) NODE-CELL))
          (valid-walk c scope gname cty line)))
      (inc! i))))

; Walk one node of a stamped (concrete) Valid body, returning its type and
; aborting at any direct generic/operator call the concrete type can't satisfy.
; gname is the generic being instantiated and cty its concrete spelling, used
; only in the diagnostic. line is the requesting call site.
(defn valid-walk (n:raw:Node scope:ref:Scope gname:CStr cty:CStr line:i32):ptr
  (when (= n null) (return ty-void))
  (let (nn:raw:Node n)
    (case (nn kind)
      NODE-INT   (return ty-i32)
      NODE-FLOAT (return ty-f64)
      ; Stage 14 NS-3: string literals are StrView (was CStr). Lockstep with
      ; emit-string / node-type / gcheck (conventions.md node-type↔emit-node).
      NODE-STR
        ; NS-4: an explicit c"…" literal (reader set Node.i=1) types as CStr, not
        ; the StrView default — lockstep with emit-string's NS-4 short-circuit.
        (if (!= (nn i) 0) (return ty-cstr) (return (strview-type)))
      NODE-CHAR  (return ty-char)
      NODE-SYM   (return (node-type-sym n scope))
      0)
    (when (!= (nn kind) NODE-CELL) (return ty-void))
    (when (= (node-len n) 0) (return null))
    (let (head:ptr:Node (unsafe/cast ptr:Node (node-at n 0)))
      (when (!= (head kind) NODE-SYM)
        (valid-walk-children n scope gname cty line)
        (return null))
      (let (h:CStr (head s)
            hp:raw:Node head)
        (when (!= (find-macro h) null)
          (let (ex:ptr (macroexpand-form n 1))
            (when (!= ex n) (return (valid-walk ex scope gname cty line)))))
        (when (or (= hp 'quote) (= hp 'quasiquote)) (return ty-ptr))
        (when (or (= hp 'let) (= hp 'with))
          (let (binds:ptr (node-at n 1)
                inner:ref:Scope (scope-new scope)
                bl:i32 (node-len binds)
                i:i32 0)
            (while (< i bl)
              (let (bname:ptr (node-at binds i)
                    bval:ptr (node-at binds (+ i 1))
                    vty:ptr (valid-walk bval inner gname cty line)
                    dty:ptr (valid-decl-type bname (nn line))
                    nm:ptr (gbind-name bname))
                (when (= dty null) (set! dty vty))
                (when (and (!= nm null) (!= dty null))
                  (scope-define inner nm dty nm 1)))
              (set! i (+ i 2)))
            (let (last:ptr null j:i32 2 cl:i32 (node-len n))
              (while (< j cl) (set! last (valid-walk (node-at n j) inner gname cty line)) (inc! j))
              (return last))))
        (when (= hp 'do)
          (let (last:ptr null j:i32 1 cl:i32 (node-len n))
            (while (< j cl) (set! last (valid-walk (node-at n j) scope gname cty line)) (inc! j))
            (return last)))
        (when (!= (gcheck-special-form hp) 0)
          (valid-walk-children n scope gname cty line)
          (return (node-type n scope)))
        ; A genuine call: type the arguments, then require it to resolve.
        (let (nargs:i32 (- (node-len n) 1)
              argtypes:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes)))
              arg-nodes:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes)))
              all-known:i32 1)
          (dotimes (i nargs)
            (let (anode:ptr (node-at n (+ i 1))
                  at:ptr (valid-walk anode scope gname cty line))
              (aset! (as ptr:ptr argtypes) i at)
              (aset! (as ptr:ptr arg-nodes) i anode)
              (when (= at null) (set! all-known 0))))
          (let (g:ptr (generic-lookup h))
            (when (!= g null)
              ; Only verify when every argument type is known; an unknown
              ; (e.g. a macro/cond result) defers, matching node-type's frontier.
              (when (!= all-known 0)
                (let (rt:ptr (valid-resolve-type g argtypes arg-nodes nargs line))
                  (when (!= rt null) (return rt))
                  (die-at line
                    (fmt-2s "type '%s' does not satisfy the Valid bound of '%s'"
                            cty gname))))
              (return null))
            ; A non-generic name: it must at least be in scope (catches a typo);
            ; its own arg typing is deferred to that function's own emission.
            (when (= (scope-lookup scope h) null)
              (die-at line
                (fmt-2s "type '%s' does not satisfy the Valid bound of '%s'" cty gname)))
            (return (node-type-call n scope h null))))))))

; Run the per-call-site Valid check on a stamped instantiation `stamped` whose
; type variables were bound to the concrete types in `bound`. Builds a scope from
; the (now concrete) parameters and walks the body.
(defn valid-check-instance (m:raw:Method stamped:raw:Node bound:ptr line:i32):void
  (let (mm:raw:Method m
        params-node:ptr (node-at stamped 2)
        scope:ref:Scope (scope-new g-globals)
        gname:CStr (defn-name-only (node-at stamped 1))
        cty:CStr "?"
        nparams:i32 (mm num-params))
    (when (> (mm num-tyvars) 0)
      (set! cty (type-spelling (aref (as ptr:ptr bound) 0))))
    (dotimes (i nparams)
      (let (pnode:ptr (node-at params-node i)
            pty:ptr (valid-decl-type pnode line)
            pnm:ptr (gbind-name pnode))
        (when (and (!= pnm null) (!= pty null))
          (scope-define scope pnm pty pnm 1))))
    ; S1/S3: skip the return operand — index 4 for a new-style stamped form,
    ; index 3 for a legacy one (see check-generic-template).
    (let (cl:i32 (node-len stamped)
          j:i32 (if (!= (sig-name-is-bare (node-at stamped 1)) 0) 4 3))
      (while (< j cl)
        (valid-walk (node-at stamped j) scope gname cty line)
        (inc! j)))))

; Emit the bodies of every stamped generic instantiation queued so far. Runs at
; the end of the top-level loop, when no function emission is in progress. The
; persistent cursor makes recursive drains (during imports) never re-emit, and
; stamping inside a drained body simply extends the worklist this loop consumes.
(defn drain-mono-worklist ():void
; Stage 15 B3′: a monomorphized body is a SYNTHESIS region — every type spelling parsed inside it
; was written by the compiler (a `type-spelling` of a bound tyvar, a `Self`
; substitution), not by any file, so the type reference resolvers take an exact-key
; fallback here. See `g-type-key-ok` (src/nucleusc.nuc) for why this is a scoped
; permission rather than a global relaxation.
  (let (saved:i32 g-type-key-ok)
    (set! g-type-key-ok 1)
    (drain-mono-worklist-in)
    (set! g-type-key-ok saved)))

(defn drain-mono-worklist-in ():void
  (while (< g-mono-drained (count g-mono-worklist))
    (let (job:ptr:MonoJob (as ptr:MonoJob (invoke g-mono-worklist g-mono-drained)))
      (inc! g-mono-drained)
      (set! g-out g-def-stream)
      ; Attach the instantiation context to any error raised while emitting.
      (set! g-mono-context (job context))
      ; Stage 15 W9 item 2: a stamp belongs to no file. It is derived from the
      ; template and the concrete argument tuple, so any unit that instantiates
      ; it produces the same body under the same symbol — including two library
      ; objects that each use `(Vector u8)`. `def-linkage` reads this to emit
      ; `weak_odr`; the call site's `g-source-path` would answer the wrong
      ; question, exactly as it did for the stamp's namespace (see
      ; `generic-instantiate-in`'s `src-ns` correction).
      (let (saved-copy:i32 g-emitting-copy)
        (set! g-emitting-copy 1)
        (emit-defn (job form))
        (set! g-emitting-copy saved-copy))
      (set! g-mono-context null))))


; ############################################################
; Protocols & conformances (Stage 9 rung 2) — appended in N8.
; Lives here (not its own file) because of a generics<->protocols
; mutual cycle: generics.nuc calls protocol-lookup/conformance-lookup/
; blanket-conforms/emit-extend/method-satisfies-sig/builtin-op-result-type/
; constraint-proto-known/conformance-args, while these protocol fns call
; generic-lookup/generic-find-method-exact/generic-bind/generic-method-bind/
; generic-binds-for/generic-defn. Co-locating breaks the cross-file edge:
; one import-use registers both halves before either body emits.
; ############################################################
; ============================================================
; Protocols & conformances (Stage 9 rung 2)
; ============================================================
; defprotocol/extend are entirely compile-time and emit no code. A protocol is
; a named set of required signatures (types may mention Self); `extend Type P`
; verifies, after the whole-file prescan, that each required signature resolves
; to a concrete method with Self→Type substituted, and records the conformance.

; ------------------------------------------------------------
; Stage 15 W9 defect 21 — a PROTOCOL IS A NAMESPACED ENTITY
; (design/stage12/namespaces.md, decision 9 superseded 2026-08-03)
; ------------------------------------------------------------
; Stage 12 decision 9 said a qualified *type* reference must resolve to the same
; StructDef from any namespace, and the protocol registry was made bare-keyed
; along with the type registry. That was wrong for protocols: it made every
; protocol name effectively global, so two namespaces could not each declare a
; `Describe`, and — because `conformance-*` stripped while `protocol-lookup` did
; not — `(extend Cat dp/Describe)` recorded the conformance under bare
; `Describe` while `(dyn dp/Describe)` looked the protocol up qualified and
; reported "'dp/Describe' is not a declared protocol" for a protocol that was
; both declared and conformed to.
;
; A protocol is now keyed by its namespace-qualified identity, exactly like a
; global in `g-globals`: `qualify-name` produces the key at registration, and a
; reference resolves through the same function.
;
; Stage 15 B3′ made the TYPE half namespaced too (R1), so the two halves are no
; longer canonicalized by *different rules* — only by different functions, since
; each has to consult its own registry. `type-canon-name` (below) is the type
; half's canonicalizer and `protocol-canon-name` the protocol half's;
; `strip-ns-qualifier` no longer participates in either.
;
; `protocol-key` is the storage key of a reference *as written here*: identity
; under `user` for an unqualified spelling (the byte-identical hatch — no
; allocation, no intern), else `qualify-name`.
(defn protocol-key (name:CStr):CStr
  (when (and (= (strchr (as ptr name) 47) null)
             (= (strcmp (as ptr g-current-ns) (as ptr "user")) 0))
    (return name))
  (return (as CStr (qualify-name (as ptr name)))))

; Exact registry probe: `key` must already be canonical. Registration uses this
; (never `protocol-lookup`), for the same reason `generic-register-method` uses
; `generic-lookup-exact` — a define's key is already final, and routing it
; through the fallback-bearing resolver would fold a namespace's own `Describe`
; into an unrelated `user` one it merely shadows.
(defn protocol-lookup-exact (key:CStr):?ptr:Protocol
  (dotimes (i (unsafe/cast i32 (count g-protocols)))
    (let (p:ptr:Protocol (as ptr:Protocol (invoke g-protocols (as usize i))))
      (when (= (p name) key) (return (as ptr p)))))
  (return null))

; Resolve a protocol KEY by namespace alone — the pre-B2a `protocol-lookup`.
; Two probes, qualified first:
;   1. the current namespace's own protocol (`Describe` inside `(ns dp)` →
;      `dp/Describe`; `dp/Describe` from anywhere → itself, since qualify-name
;      is idempotent on an already-qualified spelling);
;   2. failing that, the bare spelling — so a namespaced file still sees the
;      `user`-namespace protocols it imports (`Clone`, `Eq`, `Ord`, `Allocator`),
;      which is what makes a namespaced library usable at all.
; Under `user` the two probes are the same key, so this is one scan plus one
; strcmp — and identical in behaviour to the pre-W9 bare-keyed lookup.
;
; Stage 15 B2a: this is now the lookup for an ALREADY CANONICAL key — a stored
; `Constraint.proto`, a super-protocol edge, a `.nuch` replay's protocol name,
; the `proto-name` a resolved `extend` passes down. Those are not references and
; must not be re-resolved against the importing file's environment: the file that
; *reads* a canonical key is routinely not the file that wrote it, and B2a's
; whole point is that a file cannot name a namespace it did not import. Every
; genuine source spelling goes through `protocol-lookup` instead.
(defn protocol-lookup-ns (name:CStr):?ptr:Protocol
  (let (key:CStr (protocol-key name)
        hit:?ptr:Protocol (protocol-lookup-exact key))
    (when (!= hit null) (return hit))
    (when (!= key name) (return (protocol-lookup-exact name)))
    (return null)))

; Stage 15 B5: drop a hit whose `defprotocol-` privacy this file may not see.
; Short-circuited by `g-priv-bindings` exactly as the type/macro lookups are.
(defn protocol-visible (p:?ptr:Protocol):?ptr:Protocol
  (when (= p null) (return null))
  (when (= g-priv-bindings 0) (return p))
  (let (pp:ptr:Protocol (unsafe/cast ptr:Protocol p))
    (when (= (binding-visible (pp priv) (pp src-ns)) 0) (return null)))
  (return p))

; Stage 15 B2a — resolve a protocol *reference* (a source spelling) through the
; file's import environment (name-resolution.md §8.3, the canonicaliser in
; nucleusc.nuc). This is the protocol half of the cut-over: the qualifier is
; resolved by `resolve-spelling` and nothing else, so
;   * `(import-prefixed nsdescribe dpx)` makes `dpx/Describe` resolve and
;     `dp/Describe` — the library's own namespace — NOT resolve, which is the
;     reported defect (§2.1/§3 #3);
;   * `(import-use lib)` makes both the bare name and `<lib-ns>/name` resolve
;     (§8.3 row 1, R2's escape hatch);
;   * a qualifier bound nowhere in this file resolves to nothing, even when the
;     raw spelling happens to *be* a registry key.
;
; A bare name probes the current namespace, then the bare (`user`) key, then the
; flattened set. The `user` probe is not a special case: the prelude is flattened
; into every file, so `user` is always in the flattened set, and probing it
; explicitly keeps a unit with no namespaces on exactly one registry scan — which
; is why `g-ns-declared` gates the loop.
;
; Note an *ambiguous* bare reference is still correctly a miss under `user`: with
; `a/Describe` and `b/Describe` registered and neither namespace flattened, bare
; `Describe` resolves to neither and the caller must qualify.
(defn protocol-lookup (name:CStr):?ptr:Protocol
  (let (r:ref:NameRef (resolve-spelling (as ptr name)))
    (when (= (r status) NR-UNBOUND) (return null))
    ; Stage 15 B5: `defprotocol-`'s privacy is enforced HERE, in the reference
    ; resolver, and not in `protocol-lookup-exact` — that one is the KEY lookup
    ; registration itself uses, and a define must always find its own entry.
    (let (hit:?ptr:Protocol (protocol-visible (protocol-lookup-exact (as CStr (r canonical)))))
      (when (!= hit null) (return hit))
      ; A qualified reference names exactly one namespace: no fallback.
      (when (= (r status) NR-QUALIFIED) (return null))
      (when (!= (r canonical) (r bare))
        (let (h2:?ptr:Protocol (protocol-visible (protocol-lookup-exact (as CStr (r bare)))))
          (when (!= h2 null) (return h2))))
      (when (!= g-ns-declared 0)
        (dotimes (i (file-imports-count))
          (let (fns:ptr (file-flattened-ns-at i))
            (when (!= fns null)
              (let (k:ptr (ns-qualify-in fns (r bare)))
                (when (and (!= k (r canonical)) (!= k (r bare)))
                  (let (h3:?ptr:Protocol (protocol-visible (protocol-lookup-exact (as CStr k))))
                    (when (!= h3 null) (return h3)))))))))
      (return null))))

; Stage 15 B2a — for a name that may be EITHER a live source spelling or an
; already-canonical key, in a position that is downstream of the scope gate.
; The `(dyn P)` consumers are the case: a box carries a protocol name minted from
; whatever spelling created it, and by the time a method is dispatched through
; its vtable the admission check at `emit-box-value` has already ruled on whether
; this file may name the protocol. Asking again would be a second gate, and a
; wrong one — the box may have been constructed in another file.
(defn protocol-resolve-any (name:CStr):?ptr:Protocol
  (let (hit:?ptr:Protocol (protocol-lookup name))
    (when (!= hit null) (return hit))
    (return (protocol-lookup-ns name))))

(defn protocol-new (name:CStr sigs:ptr num-sigs:i32):ref:Protocol
  (let (p:ptr:Protocol (new Protocol))
    ; The registry key is the namespace-qualified identity of the *defining*
    ; namespace (identity under `user`). Everything downstream — the conformance
    ; registry, the super-protocol edges, `(dyn P)`'s box type — keys off this
    ; canonical name via `protocol-canon-name`.
    (.set! p name (protocol-key name))
    (.set! p sigs sigs)
    (.set! p num-sigs num-sigs)
    (.set! p params null)
    (.set! p num-params 0)
    ; Stage 15 B5: `defprotocol-`'s privacy. `prescan-protocols` arms
    ; g-defining-private for the private spelling; before B5 the flag was set
    ; and then dropped on the floor, which is the second of §13.2's two
    ; independently-found instances of one failure mode.
    (.set! p priv g-defining-private)
    (.set! p src-ns g-current-ns)
    (when (!= g-defining-private 0) (set! g-priv-bindings 1))
    (conj g-protocols p)
    (return p)))

; Is `name` one of the built-in blanket protocols (§10.1)? Blanket protocols have
; automatic conformance — no `extend` is written — so they are consulted before
; the nominal conformance registry.
(defn blanket-lookup (name:CStr):i32
  (dotimes (i (unsafe/cast i32 (count g-blanket)))
    (when (= (invoke g-blanket (as usize i)) name) (return 1)))
  (return 0))

; A name usable as a `&where` constraint: a declared protocol, a blanket protocol
; (Any/Struct, §10.1), or the structural bound Valid (§10.2). Used to reject typos
; once all imports have registered their protocols (the A2 pass).
; B2a: `name` is a stored `Constraint.proto` — canonical, or the raw spelling it
; degraded to when the constraint was parsed before its protocol registered. Both
; are keys by the time the A2 pass runs, so this is `-ns`, not the resolver.
(defn constraint-proto-known (name:CStr):i32
  (when (!= (protocol-lookup-ns name) null) (return 1))
  (when (!= (blanket-lookup name) 0) (return 1))
  (when (= name "Valid") (return 1))
  (return 0))

; Stage 13 L2: does `ty` conform to the `Drop` protocol? Owning-ness in this
; compiler is recorded *nominally*: a struct (or stamped template instance) is
; Drop iff `(extend <S> Drop)` recorded the conformance — collections write that
; extend by hand on the wrapper struct, so a struct that owns a Drop field is
; itself extended to Drop and this nominal check is the transitive answer. The
; same nominal predicate `with-drop-method`/`union-drop-arm` use; reused here so
; Drop-ness has a single source of truth. A bare struct (TY-STRUCT) or untagged
; union (TY-UNION, also a StructDef) is checked on its registered name; every
; non-aggregate kind is never Drop.
(defn type-conforms-drop (ty:raw:Type):i32
  (let (tt:raw:Type ty
        k:i32 (tt kind))
    (when (or (= k TY-STRUCT) (= k TY-UNION))
      (let (sd:raw:StructDef (tt sdef))
        (when (= sd null) (return 0))
        (when (!= (conformance-lookup (sd name) "Drop") 0) (return 1))))
    (return 0)))

; Stage 13 L2: is `ty` trivially (bitwise) copyable, hence automatically `Clone`?
; A primitive (any non-aggregate kind — scalar, pointer, CStr, Err, usize, …) is
; trivially copyable. A struct or untagged union is trivially copyable iff it does
; NOT conform to `Drop` (transitively, per `type-conforms-drop`): a Drop-free
; aggregate owns no resources, so a value copy is sound and the closure owns
; nothing. An owning (Drop) aggregate is excluded — it must hand-write `clone`
; (an `(extend <S> Clone)`), which the nominal conformance registry serves. A
; TY-TYVAR is abstract and never structurally trivial here (its Clone-ness comes
; from its own `&where` bound), so it returns 0.
(defn type-trivially-copyable (ty:raw:Type):i32
  (let (tt:raw:Type ty
        k:i32 (tt kind))
    (when (= k TY-TYVAR) (return 0))
    (when (or (= k TY-STRUCT) (= k TY-UNION))
      (when (!= (type-conforms-drop ty) 0) (return 0)))
    (return 1)))

; Automatic conformance for a blanket protocol (§10.1). `Any` holds for every
; type (the no-constraint constraint); `Struct` holds for any struct type or
; pointer-to-struct (its required `get` member-access method is supplied by a
; built-in once callable-values lands). `Clone` (Stage 13 L2) holds automatically
; for any trivially-copyable type — a primitive, or a Drop-free aggregate — with a
; bitwise copy as its `clone`; an owning (Drop) type is excluded here and conforms
; only by a hand-written `(extend <S> Clone)` recorded nominally. Blanket
; conformance is structural and consulted directly, so it is never recorded in
; g-conformances.
(defn blanket-conforms (ty:raw:Type proto-name:CStr):i32
  (when (= proto-name "Any") (return 1))
  (when (= proto-name "Struct")
    (let (k:i32 (ty kind))
      (when (= k TY-STRUCT) (return 1))
      (when (and (= k TY-PTR)
                 (and (!= (ty elem) null)
                      (= ((ty elem) kind) TY-STRUCT)))
        (return 1))
      (return 0)))
  (when (= proto-name "Clone")
    (return (type-trivially-copyable ty)))
  (return 0))

; Conformance facts are global, and BOTH halves of the key are canonicalized to
; their own registry's namespaced identity. Stage 12 N4 decision 9 keyed the type
; half bare; Stage 15 W9 defect 21 namespaced the protocol half; Stage 15 B3′ (R1)
; namespaced the type half too, because two namespaces may now both define
; `Vector` and a bare key would make one conformance fact stand for both.
;
;   * the TYPE half → `type-canon-name` (src/nucleusc.nuc), which resolves a
;     source spelling through the file's import environment and passes an
;     already-canonical name (or a primitive/structural spelling) through;
;   * the PROTOCOL half → `protocol-canon-name`. Bare `Describe` inside `(ns dp)`
;     and `dp/Describe` from anywhere else are the same key `dp/Describe`, while
;     `a/Describe` and `b/Describe` are different protocols that do not collide.
;
; The two functions are different only because each consults its own registry;
; the RULE is now the same for both, which is what R1 bought.
;
; Under `user` both are the identity, so the bootstrap stays byte-identical.
; Centralizing both in conformance-add/-lookup/-args covers every caller (extend,
; imported extend, dispatch constraint check, A2 recovery) with one chokepoint.
(defn conformance-lookup (type-name:CStr proto-name:CStr):i32
  (set! type-name (type-canon-name type-name))
  (set! proto-name (protocol-canon-name proto-name))
  (dotimes (i (unsafe/cast i32 (count g-conformances)))
    (let (c:ptr:Conformance (invoke g-conformances (as usize i)))
      (when (and (= (c type-name) type-name)
                 (= (c proto-name) proto-name))
        (return 1))))
  (return 0))

; Retrieve the retained associated-type arguments for the `(type-name, proto-name)`
; conformance (assoc-types A1; consumed by A2's dispatch-time recovery). Returns the
; `args` ptr array (of canonical type-spelling strings) and writes the count through
; `out-nargs` (a ptr:i32 box). Returns null with *out-nargs = 0 when no such
; conformance exists or it carries no parametric args (a plain protocol, or a stale
; record predating arg retention). The two outcomes — no record vs. record-without-
; args — are distinguished by conformance-lookup, which A2 calls first.
; Length of a retained-arg Vector (0 for the null / no-args case). The cast is a
; non-null assertion, safe because it only runs on the guarded non-null branch.
(defn conf-args-count (v:(raw (Vector CStr))):i32
  (if (= v null) 0 (unsafe/cast i32 (count (unsafe/cast (ref (Vector CStr)) v)))))

(defn conformance-args (type-name:CStr proto-name:CStr out-nargs:ptr):(raw (Vector CStr))
  ; Canonicalize to the same key conformance-add records (see conformance-lookup's
  ; note): both halves namespaced since B3′.
  (set! type-name (type-canon-name type-name))
  (set! proto-name (protocol-canon-name proto-name))
  (dotimes (i (unsafe/cast i32 (count g-conformances)))
    (let (c:ptr:Conformance (invoke g-conformances (as usize i)))
      (when (and (= (c type-name) type-name)
                 (= (c proto-name) proto-name))
        (aset! (as ptr:i32 out-nargs) 0 (conf-args-count (c args)))
        (return (c args)))))
  (aset! (as ptr:i32 out-nargs) 0 0)
  (return null))

; Compare two retained-arg Vectors of canonical type-spelling strings for equality
; (§14.4): the length must match and every spelling must be string-equal. The
; element type CStr makes `!=` a strcmp, so this is a value comparison. A null
; Vector is treated as length 0 (a plain protocol carries no args).
(defn conformance-args-eq (a:(raw (Vector CStr)) b:(raw (Vector CStr))):i32
  (let (na:i32 (conf-args-count a)
        nb:i32 (conf-args-count b))
    (when (!= na nb) (return 0))
    (when (= na 0) (return 1))
    (let (av:(ref (Vector CStr)) (unsafe/cast (ref (Vector CStr)) a)
          bv:(ref (Vector CStr)) (unsafe/cast (ref (Vector CStr)) b))
      (dotimes (i na)
        (when (!= (invoke av (as usize i)) (invoke bv (as usize i)))
          (return 0))))
    (return 1)))

; Record that `type-name` conforms to `proto-name`, retaining the parametric
; protocol's bound arguments `args` (length `nargs`, a ptr array of canonical
; type-spelling strings; null/0 for a plain protocol) for assoc-type recovery (A2).
; Coherence (one conformance per (type, proto)):
;   - a re-extend with *identical* args is a silent no-op (historical behaviour);
;   - a re-extend with *different* args is rejected (recovery would be ambiguous);
;   - a re-record with no args (the super-protocol recursion and the historical
;     plain-protocol path both pass null/0) leaves an existing arg-bearing record
;     untouched, and an existing arg-less record is *upgraded* in place if real
;     args arrive later (e.g. a stale conformance recorded before the args were
;     known). Conflict therefore fires only when both sides carry args and differ.
(defn conformance-add (type-name:CStr proto-name:CStr args:ptr nargs:i32 line:i32):void
  ; Record under each half's own canonical identity, so the dispatch-site lookup
  ; (canonicalized the same way) matches. Identity under `user`.
  (set! type-name (type-canon-name type-name))
  (set! proto-name (protocol-canon-name proto-name))
  ; Materialize the incoming args as a (Vector CStr) — null when there are none —
  ; so the retained representation is value-comparable (§14.4).
  (let (av:(raw (Vector CStr)) null)
    (when (> nargs 0)
      (let ((v (ref (Vector CStr))) (vector-new-in (addr-of g-arena-alloc)))
        (dotimes (i nargs) (conj v (as CStr (aref (as ptr:ptr args) i))))
        (set! av (as (raw (Vector CStr)) v))))
    (dotimes (i (unsafe/cast i32 (count g-conformances)))
      (let (c:ptr:Conformance (invoke g-conformances (as usize i)))
        (when (and (= (c type-name) type-name) (= (c proto-name) proto-name))
          ; Incoming call supplies no args → nothing to add or check; keep as-is.
          (when (= nargs 0) (return))
          ; Existing record has no retained args → upgrade it in place.
          (when (= (c args) null)
            (.set! c args av)
            (return))
          ; Both sides carry args: they must agree, else it is a coherence error.
          (when (= (conformance-args-eq (c args) av) 0)
            (die-at line
              (fmt-2s "type '%s' re-extends protocol '%s' with different associated arguments"
                      type-name proto-name)))
          (return))))
    (let (c:ptr:Conformance (as ptr:Conformance (arena-alloc (sizeof Conformance))))
      (.set! c type-name type-name)
      (.set! c proto-name proto-name)
      (.set! c args av)
      (conj g-conformances c))))

; Has a synthesized closure-conformance forwarder with this exact ir-name
; already been registered (and thus queued for emission) in generic `gen-name`?
; Used to collapse the otherwise-colliding `apply.pfn.<ret>` thunks that several
; same-signature bare `fn` operands would each synthesize (see
; derive-closure-conformance). The freshly-registered method whose emission is
; being decided has a null ir-name at the call site, so it is never self-counted.
(defn derived-fwd-already-emitted (gen-name:CStr mangled:CStr):i32
  (let (g:ptr (generic-lookup gen-name))
    (when (= g null) (return 0))
    (let (gg:ptr:Generic (as ptr:Generic g))
      (dotimes (i (unsafe/cast i32 (count (gg methods))))
        (let (m:ptr:Method (as ptr:Method (invoke (gg methods) (as usize i))))
          (when (and (!= (m ir-name) null)
                     (= (strcmp (m ir-name) mangled) 0))
            (return 1))))
      (return 0))))

(defn derive-closure-conformance (cvtype:raw:Type proto:CStr line:i32):i32
  ; Stage 15 B3′: a synthesis region — it substitutes `Self` with the concrete
  ; type's CANONICAL spelling and re-parses the result.
  (let (saved:i32 g-type-key-ok)
    (set! g-type-key-ok 1)
    (let (r:i32 (derive-closure-conformance-in cvtype proto line))
      (set! g-type-key-ok saved)
      (return r))))

(defn derive-closure-conformance-in (cvtype:raw:Type proto:CStr line:i32):i32
  (let (cvspell:ptr (type-spelling cvtype)
        cv:raw:Type cvtype)
    ; Step 1: idempotent — already conforms.
    (when (!= (conformance-lookup cvspell proto) 0) (return 1))
    ; Step 2: recognized-set gate (UnaryFn / FoldFn / BinaryFn). BinaryFn is the
    ; same-typed-args comparator shape `sort` (lib/combinators.nuc) needs; it is
    ; derived by the identical sig-scan as the other two (each protocol param is
    ; bound from a matching NODE-SYM in the single method's signature). This gate
    ; entry is inert under self-compilation — the compiler never stamps a
    ; BinaryFn — so the bootstrap stays a byte-identical fixed point.
    (when (and (!= proto "UnaryFn") (!= proto "FoldFn") (!= proto "BinaryFn")) (return 0))
  ; Step 3: find the closure's invoke method — a METHOD-USER on the `invoke`
  ; generic whose self param (param-types[0]) is (ref Env) with Env.name == cvspell.
  ; Detection is semantic ("the type has an invoke method"), not by name, so it
  ; covers vfn/mfn/cfn closures uniformly; a hand-written struct with an `invoke`
  ; method that has NOT hand-extended the protocol would also derive (benign — if
  ; it HAD hand-extended, step 1 already returned 1).
  (let (ig:ptr (generic-lookup "invoke")
        im:?ptr:Method null)
    ; The invoke search only fires when an `invoke` generic exists (a program
    ; with closures); a bare `fn` in a closure-free program reaches the TY-FN
    ; synthesis below with im=null.
    (when (!= ig null)
      (let (igg:ptr:Generic (as ptr:Generic ig))
        (dotimes (mi (unsafe/cast i32 (count (igg methods))))
          (let (mm:ptr:Method (as ptr:Method (invoke (igg methods) (as usize mi))))
            (when (= (mm kind) METHOD-USER)
              (let (self-ty:ptr (aref (as ptr:ptr (mm param-types)) 0))
                (when (!= self-ty null)
                  (let (st:ptr:Type (as ptr:Type self-ty))
                    (when (and (= (st kind) TY-PTR)
                               (and (!= (st elem) null)
                                    (= (st pkind) PTR-REF)))
                      (let (et:ptr:Type (unsafe/cast ptr:Type (st elem)))
                        (when (= (et kind) TY-STRUCT)
                          (let (sd:ptr:StructDef (unsafe/cast ptr:StructDef (et sdef)))
                            (when (and (!= (as ptr sd) null)
                                       (= (sd name) cvspell))
                              (set! im (as ptr mm)))))))))))))))
      ; Resolve the source method whose signature drives derivation. For a
      ; capturing closure that is the `invoke` method found above (call-style 0,
      ; forward by calling invoke on self). For a bare `fn` (TY-FN — no env, no
      ; invoke method) the fn's own param/return signature is the callable shape,
      ; so synthesize an imp directly from the TY-FN Type* (call-style 1, forward
      ; by dereffing self and calling the function pointer). im is null when no
      ; matching invoke method exists (the TY-FN case, or a non-callable type).
      (let (imp-src:?ptr:Method null
            call-style:i32 0)
        (if (!= (as ptr im) null)
          (set! imp-src (unsafe/cast ptr:Method im))
          (when (= (cv kind) TY-FN)
            (let (fn-np:i32 (cv num-params)
                  total:i32 (+ fn-np 1)
                  ptypes:ptr (arena-alloc (* (as i64 total) (ptr-bytes)))
                  self-ty:ptr:Type (as ptr:Type (make-type TY-PTR)))
              (.set! self-ty elem cvtype)
              (.set! self-ty pkind PTR-REF)
              (aset! (as ptr:ptr ptypes) 0 (as ptr self-ty))
              (dotimes (fpi fn-np)
                (aset! (as ptr:ptr ptypes) (+ fpi 1)
                       (as ptr ((field-at (cv params) fpi) type))))
              (let (syn:ref:Method (new Method))
                (.set! syn param-types ptypes)
                (.set! syn num-params total)
                (.set! syn ret-type (cv ret))
                (.set! syn kind METHOD-USER)
                (.set! syn has-rest 0)
                (.set! syn variadic 0)
                (set! imp-src (as ptr syn))
                (set! call-style 1)))))
        (when (= (as ptr imp-src) null) (return 0))
        ; Steps 4-5: protocol must be single-method; parse its sig.  imp is the
        ; non-null source method (cast from the nullable imp-src above).
        (let (imp:ptr:Method (unsafe/cast ptr:Method imp-src)
              ; B2a: `proto` arrives from a `(dyn P)` box, downstream of the
              ; box-construction scope gate — see `protocol-resolve-any`.
              pp:ptr:Protocol (unsafe/cast ptr:Protocol (protocol-resolve-any proto)))
          (when (= (as ptr pp) null) (return 0))
          (when (!= (pp num-sigs) 1) (return 0))
        (let (sig:ptr (aref (as ptr:ptr (pp sigs)) 0)
              ; S1: route the method name / return / params through the accessor so
              ; a new-style single-method protocol sig `(m (params) Ret)` works. For
              ; the legacy list-head `((m Ret) (params))` this reproduces the former
              ; method-name / ret-node exactly.
              method-name:ptr null
              ret-node:ptr null
              params-node:ptr null
              fwd-style:i32 (proto-sig-parse sig (as ptr:ptr (addr-of method-name))
                              (as ptr:ptr (addr-of ret-node))
                              (as ptr:ptr (addr-of params-node)))
              k:i32 (- (node-len params-node) 1)
              npp:i32 (pp num-params)
              args:ptr (arena-alloc (* (as i64 npp) (ptr-bytes)))
              j:i32 0)
            ; Step 6: arity check — non-self param count must match imp's.
            (when (!= k (- (imp num-params) 1)) (return 0))
          ; Step 8: bind each protocol extra-param to an invoke type spelling.
          ; For each extra-param name pj, scan the sig's ret node and non-self
          ; param type nodes for a NODE-SYM matching pj; the corresponding invoke
          ; type's spelling is the candidate. Zero candidates → unbindable;
          ; multiple differing candidates → inconsistent. (UnaryFn: Arg←invoke
          ; param[0], Ret←invoke ret. FoldFn: Acc←invoke ret/param[0], Elem←
          ; invoke param[1].)
          (while (< j npp)
            (let (pj:ptr (aref (as ptr:ptr (pp params)) j)
                  cand:ptr null
                  ncand:i32 0
                  pi2:i32 0)
              (when (and (!= ret-node null)
                         (and (= ((as ptr:Node ret-node) kind) NODE-SYM)
                              (= ((as ptr:Node ret-node) s) pj)))
                (set! cand (type-spelling (imp ret-type)))
                (inc! ncand))
              (while (< pi2 k)
                (let (ptn:ptr (binding-type-node (node-at params-node (+ pi2 1))))
                  (when (and (!= ptn null)
                             (and (= ((unsafe/cast ptr:Node ptn) kind) NODE-SYM)
                                  (= ((unsafe/cast ptr:Node ptn) s) pj)))
                    (let (this-cand:ptr
                           (type-spelling (aref (as ptr:ptr (imp param-types)) (+ pi2 1))))
                      (inc! ncand)
                      (when (= cand null) (set! cand this-cand))
                      (when (!= (strcmp cand this-cand) 0)
                        (return 0)))))
                (inc! pi2))
              (when (= ncand 0) (return 0))
              (aset! (as ptr:ptr args) j cand))
            (inc! j))
            ; Step 9: synthesize the forwarding method (mirrors fn-make-invoke-method).
            ; call-style 0 (closure): (invoke self __a0…) routes to the env's invoke.
            ; call-style 1 (bare fn): ((deref self) __a0…) loads the fn pointer from
            ; the self slot and calls it directly (a TY-FN indirect call).
            (let (ret-spelling:ptr (type-spelling (imp ret-type))
                  total:i32 (imp num-params)
                  name-sym:ptr (as ptr (intern-symbol method-name))
                  ret-node:ptr (as ptr (intern-symbol ret-spelling))
                  self-sym:ptr (as ptr (intern-symbol "self"))
                  env-ref-node:ptr
                    (make-cell (as ptr (intern-symbol "ref"))
                      (make-cell (as ptr (intern-symbol cvspell)) null line)
                      line)
                  self-spec:ptr
                    (make-cell self-sym (make-cell env-ref-node null line) line)
                  params-spine:ptr null
                  pi3:i32 (- k 1))
              (while (>= pi3 0)
                (let (a-sym:ptr (as ptr (intern-symbol (fmt-i32 "__a%d" pi3)))
                      ty-sym:ptr
                        (as ptr (intern-symbol
                                    (type-spelling
                                      (aref (as ptr:ptr (imp param-types)) (+ pi3 1)))))
                      spec-i:ptr (make-cell a-sym (make-cell ty-sym null line) line))
                  (set! params-spine (make-cell spec-i params-spine line))
                  (dec! pi3)))
              (set! params-spine (make-cell self-spec params-spine line))
              (let (fwd-args:ptr null
                    pi4:i32 (- k 1))
                (while (>= pi4 0)
                  (set! fwd-args
                    (make-cell (as ptr (intern-symbol (fmt-i32 "__a%d" pi4)))
                      fwd-args line))
                  (dec! pi4))
                (let (call-head:ptr
                        (if (= call-style 0)
                          (make-cell (as ptr (intern-symbol "invoke"))
                            (make-cell self-sym fwd-args line) line)
                          (let (deref-self:ptr
                                  (make-cell (as ptr (intern-symbol "deref"))
                                    (make-cell self-sym null line) line))
                            (make-cell deref-self fwd-args line)))
                      ; New-style: (defn <method> (params) <ret> <call-head>).
                      defn-form:ptr
                        (make-cell (as ptr (intern-symbol "defn"))
                          (make-cell name-sym
                            (make-cell params-spine
                              (make-cell ret-node
                                (make-cell call-head null line)
                                line)
                              line)
                            line)
                          line)
                      mtypes:ptr (arena-alloc (* (as i64 total) (ptr-bytes))))
                (dotimes (ci total)
                  (aset! (as ptr:ptr mtypes) ci
                    (aref (as ptr:ptr (imp param-types)) ci)))
                (let (mangled:ptr (mangle-fn-name "" method-name mtypes total))
                  ; A bare `fn` (call-style 1) erases its signature to the lossy
                  ; "pfn" token under mangle-fn-name, so every same-signature bare
                  ; fn forwards through an IDENTICAL synthesized method named e.g.
                  ; `apply.pfn.i32` (the forwarder just derefs self and calls the
                  ; fn pointer — correct for any bare fn of that signature). The
                  ; conformance key, however, is the per-fn `__fnty_N` spelling
                  ; (fnty-intern dedups by Type* identity), so step 1's idempotent
                  ; short-circuit misses and each occurrence would re-synthesize a
                  ; colliding `define @apply.pfn.i32`. Register the method for
                  ; dispatch unconditionally, but queue its emission MonoJob only
                  ; the first time this exact ir-name is seen — a later occurrence
                  ; reuses the single shared thunk. (Capturing closures never hit
                  ; this: each has a distinct env-struct spelling, so their
                  ; forwarder names are already unique.)
                  (let (newm:ref:Method
                         (generic-register-method method-name (imp ret-type)
                           mtypes total 0 0 defn-form)
                        already:i32 (derived-fwd-already-emitted method-name mangled))
                    (.set! newm ir-name mangled)
                    (fn-force-generic-mangled method-name)
                    (when (= already 0)
                      (let (job:ptr:MonoJob (new MonoJob))
                        (.set! job form defn-form)
                        (.set! job context
                               (fmt-2s-i "while deriving closure conformance to %s (at %s:%d)"
                                         proto g-source-path line))
                        (conj g-mono-worklist job)))
                    ; Step 10: record the conformance with the recovered args.
                    (conformance-add cvspell proto args npp line)
                    ; Step 11: success.
                    (return 1))))))))))))


; Record a protocol-inheritance edge: conforming to `sub` requires `super`.
; BOTH names here are protocols (this is the `(extend Describe Show)` shape), so
; both canonicalize through `protocol-canon-name` — never `strip-ns-qualifier`,
; which is the *type* canonicalizer. Identity under `user`.
(defn proto-super-add (sub:CStr super:CStr):void
  (set! sub (protocol-canon-name sub))
  (set! super (protocol-canon-name super))
  (dotimes (i (unsafe/cast i32 (count g-proto-supers)))
    (let (e:ptr:Conformance (invoke g-proto-supers (as usize i)))
      (when (and (= (e type-name) sub) (= (e proto-name) super))
        (return))))
  (let (e:ptr:Conformance (as ptr:Conformance (arena-alloc (sizeof Conformance))))
    (.set! e type-name sub)
    (.set! e proto-name super)
    (conj g-proto-supers e)))

; Substitute the type variable `Self` in a colon-typed symbol spelling: split
; on ':' and replace any segment that is exactly "Self" with the concrete type
; name, rejoining with ':'. "self:ptr:Self" with Circle → "self:ptr:Circle".
(defn subst-self-sym (s:CStr typename:CStr line:i32):CStr
  (let (segs:ptr (split-colon-segments s line)
        acc:ptr null)
    (let (it:ListIter (list-iter segs))
      (doseq-iter (cur (addr-of it))
        (let (seg:ptr ((unsafe/cast ptr:Node cur) s)
              piece:ptr seg)
          (when (= seg "Self") (set! piece typename))
          (if (= acc null)
            (set! acc piece)
            (set! acc (fmt-2s "%s:%s" acc piece))))))
    (when (= acc null) (return s))
    (return acc)))

; Deep-copy a signature AST with Self→typename in every symbol, yielding a
; concrete signature parseable by the ordinary defn helpers.
(defn subst-self-node (node:raw:Node typename:CStr):raw:Node
  (when (= node null) (return null))
  (let (n:raw:Node node)
    (case (n kind)
      NODE-SYM
        (let (ns:ptr:Node (as ptr:Node (alloc-node)))
          (.set! ns kind NODE-SYM)
          (.set! ns line (n line))
          (.set! ns s (subst-self-sym (n s) typename (n line)))
          (return (as ptr ns)))
      NODE-CELL
        (return (make-cell (subst-self-node (n car) typename)
                           (subst-self-node (n cdr) typename)
                           (n line)))
      0)
    (return node)))

; Deep-copy a (parametric) protocol signature AST, substituting `Self`→typename
; and each extra protocol parameter `params[i]`→`pspellings[i]` (T4). This is the
; element-binding generalization of subst-self-node: a `Self`-only protocol
; (nparams=0) reduces to substituting `Self` alone, identical in effect to
; subst-self-node. Reuses the structural tyvar substituter subst-tyvars-node by
; building a combined name→spelling map {Self→typename, E→…}.
(defn subst-proto-sig-node (node:raw:Node typename:CStr params:ptr pspellings:ptr nparams:i32):raw:Node
  (let (n:i32 (+ nparams 1)
        names:ptr (arena-alloc (* (as i64 n) (ptr-bytes)))
        spellings:ptr (arena-alloc (* (as i64 n) (ptr-bytes))))
    (aset! (as ptr:ptr names) 0 "Self")
    (aset! (as ptr:ptr spellings) 0 typename)
    (dotimes (i nparams)
      (aset! (as ptr:ptr names) (+ i 1) (aref (as ptr:ptr params) i))
      (aset! (as ptr:ptr spellings) (+ i 1) (aref (as ptr:ptr pspellings) i)))
    (return (subst-tyvars-node node names spellings n))))

; Register a (defprotocol Name (sig...) ...) form, or a parametric protocol
; (defprotocol (Name E...) (sig...) ...) whose name position is a *list* (the
; same list-head rule as defstruct/defunion templates). For the parametric form
; the head symbol is the protocol name and the remaining list elements are the
; extra type parameters bound at the `extend` site (T4). Idempotent on name.
(defn protocol-register-form (form:raw:Node):void
  (let (ff:raw:Node form)
    (when (< (node-len form) 2)
      (die-at (ff line) "defprotocol: expected (defprotocol Name (sig...) ...)"))
    (let (name-node:ptr:Node (unsafe/cast ptr:Node (node-at form 1))
          pname:ptr null
          params:ptr null
          nparams:i32 0)
      ; W4b sibling sweep (design/stage15-stress-test/diagnostics.md): a bare
      ; colon-typed name ("P:i32") used to sail past the plain-symbol branch
      ; below unchanged and register the Protocol under that literal,
      ; unlookupable key — the same defconst-shaped bug (an `extend Foo P`
      ; then failed as an unrelated "unknown protocol 'P'", with no
      ; diagnostic at the definition).
      (reject-colon-in-def-name (as raw:Node name-node) "defprotocol" (ff line))
      ; Parametric protocol: name position is a list `(Seq E ...)` — head is the
      ; protocol name, the rest are the extra parameter names (beyond Self).
      (if (= (name-node kind) NODE-CELL)
        (let (head:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr name-node) 0)))
          (when (!= (head kind) NODE-SYM)
            (die-at (name-node line) "defprotocol: protocol name must be a symbol"))
          (set! pname (head s))
          (set! nparams (- (node-len (as ptr name-node)) 1))
          (when (< nparams 1)
            (die-at (name-node line)
              "defprotocol: parametric protocol needs at least one parameter — use a plain defprotocol"))
          ; W4b: a single parameter that is itself a CELL (not a bare tyvar
          ; symbol) can only be the colon-paren-fused shape ("P:(i32)" ->
          ; (P (i32))) — a genuine parametric protocol's extra parameters are
          ; always bare symbols (E, K, V, ...). Give the annotation-specific
          ; message here rather than falling into the generic, misleading
          ; "protocol parameter must be a symbol" below.
          (when (and (= nparams 1)
                     (= (-> name-node (node-at _ 1) (unsafe/cast ptr:Node _) (_ kind)) NODE-CELL))
            (die-at (name-node line)
              (fmt-s "defprotocol: takes no type annotation; write (defprotocol %s ...)" (head s))))
          (set! params (arena-alloc (* (as i64 nparams) (ptr-bytes))))
          (dotimes (pi nparams)
            (let (pv:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr name-node) (+ pi 1))))
              (when (!= (pv kind) NODE-SYM)
                (die-at (pv line) "defprotocol: protocol parameter must be a symbol"))
              (aset! (as ptr:ptr params) pi (pv s)))))
        (do
          (when (!= (name-node kind) NODE-SYM)
            (die-at (name-node line) "defprotocol: name must be a symbol"))
          (set! pname (name-node s))))
      ; Idempotence probe on the EXACT key this registration will use. Routing it
      ; through `protocol-lookup` would consult that resolver's bare fallback and
      ; silently treat an unrelated `user` protocol of the same bare name as
      ; "already registered", so `(ns dp) (defprotocol Clone …)` would never
      ; register `dp/Clone` — the same reason `generic-register-method` uses
      ; `generic-lookup-exact`. A define's key is already final.
      ; Stage 15 B4 (R4): the probe above stays an idempotence probe — this
      ; registrar really is re-entered for one form — but a hit at a DIFFERENT
      ; defining site is a second `defprotocol` of the name, which used to be a
      ; silent no-op keeping the first.
      (if-some (prev (protocol-lookup-exact (protocol-key pname)))
        (do
          (when (!= (same-definition-site (prev src-file) (prev src-line) (ff line)) 0)
            (return))
          (die-redefinition (as CStr pname) (ff line) BK-PROTOCOL
                            (prev src-file) (prev src-line)))
        0)
      (guard-name-kind pname (ff line) NK-PROTOCOL)
      (let (nsigs:i32 (- (node-len form) 2)
            sigs:ptr null)
        (when (> nsigs 0)
          (set! sigs (arena-alloc (* (as i64 nsigs) (ptr-bytes))))
          (dotimes (i nsigs)
            (let (sig:ptr (node-at form (+ i 2))
                  snn:ptr (node-at (node-at form (+ i 2)) 0))
              ; S4: reject a legacy `name:ret` / list-head `(name ret)` method sig
              ; at registration (protocol sigs are stored verbatim and parsed
              ; lazily, so this is the one def-time chokepoint). New-style sigs put
              ; the return after the param list. The guard on defn-name-only keeps a
              ; genuinely malformed sig on its existing lazy-parse error path.
              (when (and (= (sig-name-is-bare snn) 0) (!= (defn-name-only snn) null))
                (die-at (ff line)
                  (fmt-2s "protocol method '%s': legacy 'name:ret' syntax is no longer supported — write (%s (params):ret)"
                          (defn-name-only snn) (defn-name-only snn))))
              (aset! (as ptr:ptr sigs) i sig))))
        (let (p:ref:Protocol (protocol-new pname sigs nsigs))
          ; Stage 15 B4 (R4): the defining site, which is both the redefinition
          ; blame and the "same form, registered again" discriminator.
          (.set! p src-file g-source-path)
          (.set! p src-line (ff line))
          (when (> nparams 0)
            (.set! p params params)
            (.set! p num-params nparams)))))))

(defn prescan-protocols (forms:raw:Node):void
  (let (fc:raw:Node forms)
    (while (!= fc null)
      (let (f:raw:Node (fc car))
        (when (and (and (!= f null) (= (f kind) NODE-CELL))
                   (and (>= (node-len (as ptr f)) 2)
                        (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind) (= _ NODE-SYM))))
          (let (hh:ptr (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ s)))
            ; Stage 12 N3: also handle defprotocol- (private protocol).
            ; Stage 15 B5: arm g-defining-private around the registration, the
            ; same shape prescan-defn-signatures uses for `defn-`. Registration
            ; happens here and nowhere else (the top-level dispatch arm for
            ; `defprotocol-` is a no-op), so this is the one place the private
            ; spelling can be recorded at all.
            (when (or (= hh "defprotocol") (= hh "defprotocol-"))
              (let (save-priv:i32 g-defining-private)
                (set! g-defining-private (if (= hh "defprotocol-") 1 0))
                (protocol-register-form f)
                (set! g-defining-private save-priv))))))
      (set! fc (fc cdr)))))

; Built-in result type of an operator generic `g` applied to a same-typed pair
; of operands, or null if the operator does not apply. Comparisons yield i1;
; arithmetic yields the operand type. This is what lets numeric/pointer built-ins
; satisfy operator protocol requirements (Num/Eq/Ord) with no user method (§10.3).
(defn builtin-op-result-type (g:raw:Generic ptypes:ptr nparams:i32):ptr
  (let (gg:raw:Generic g)
    (when (= (unsafe/cast i32 (count (gg methods))) 0) (return null))
    (let (m0:ptr:Method (as ptr:Method (invoke (gg methods) 0)))
      (when (!= (m0 kind) METHOD-INTRINSIC) (return null))
      (when (!= nparams 2) (return null))
      (let (at:ptr (aref (as ptr:ptr ptypes) 0)
            bt:ptr (aref (as ptr:ptr ptypes) 1)
            bop:raw:BinOp (m0 binop))
        (when (= (type-eq at bt) 0) (return null))
        (if (!= (bop is-cmp) 0)
          (do
           (when (or (!= (is-int-type at) 0) (!= (is-float-type at) 0)
                     (= (-> at (unsafe/cast ptr:Type _) (_ kind)) TY-PTR))
              (return ty-i1))
            ; CStr satisfies Eq (= / !=) only — content comparison via strcmp.
            (when (and (= (-> at (unsafe/cast ptr:Type _) (_ kind)) TY-CSTR)
                       (or (= (bop name) "=")
                           (= (bop name) "!=")))
              (return ty-i1))
            (return null))
          (do
            (when (or (!= (is-int-type at) 0) (!= (is-float-type at) 0))
              (return at))
            (return null)))))))

; Does a method named `mname` satisfy a required signature (param types `ptypes`,
; return `ret`; ret=null means "any")? Either a user/concrete method at the exact
; tier, a *generic* method that binds for `ptypes` with satisfied constraints (T4:
; a method written over a parametric struct, e.g. `get`/`count` over `(Vector T)`,
; that resolves for the stamped instance), or a built-in operator whose result
; type matches. Shared by `extend` conformance and the `Valid` call-site check
; (§10.2). `line` is only used for the generic-bind probe's constraint diagnostics.
;
; `check-ret`: when nonzero the user/generic method's *return type* must also equal
; `ret`. This is required for parametric protocols whose return carries a bound
; element (`get:E`) — a `get:i32` does not satisfy `get:f64`. Plain (Self-only)
; protocols pass check-ret=0 to preserve the historical param-only match exactly
; (byte-identical), since their concrete methods already return the right type.
(defn method-satisfies-sig (mname:CStr ptypes:ptr nparams:i32 ret:raw:Type check-ret:i32 line:i32):i32
  (let (g:ptr (generic-lookup mname))
    (when (= g null) (return 0))
    (let (um:?ptr:Method (generic-find-method-exact g ptypes nparams))
      (when (!= (as ptr um) null)
        (when (= check-ret 0) (return 1))
        (when (or (= ret null)
                  (and (!= (-> um (unsafe/cast ptr:Method _) (_ ret-type)) null)
                       (!= (type-eq (-> um (unsafe/cast ptr:Method _) (_ ret-type)) ret) 0)))
          (return 1))))
    (let (grt:ptr null)
      (when (!= (generic-binds-for g ptypes nparams (as ptr:ptr (addr-of grt)) line null) 0)
        (when (= check-ret 0) (return 1))
        (when (or (= ret null) (and (!= grt null) (!= (type-eq grt ret) 0)))
          (return 1))))
    (let (rt:ptr (builtin-op-result-type g ptypes nparams))
      (when (and (!= rt null) (or (= ret null) (!= (type-eq rt ret) 0))) (return 1)))
    (return 0)))

; Check that every required signature of `proto` resolves for `typename` with
; `Self`→typename and each extra protocol parameter substituted to `pspellings`.
; Returns 1 if all resolve, 0 (after printing each missing method) otherwise.
; The Self-only path passes nparams=0 — the substitution reduces to Self alone,
; byte-identical to the historical subst-self-node behavior.
(defn proto-sigs-resolve (proto:raw:Protocol typename:CStr pspellings:ptr line:i32):i32
; Stage 15 B3′: a protocol-signature substitution is a SYNTHESIS region — every type spelling parsed inside it
; was written by the compiler (a `type-spelling` of a bound tyvar, a `Self`
; substitution), not by any file, so the type reference resolvers take an exact-key
; fallback here. See `g-type-key-ok` (src/nucleusc.nuc) for why this is a scoped
; permission rather than a global relaxation.
  (let (saved:i32 g-type-key-ok)
    (set! g-type-key-ok 1)
    (let (r:i32 (proto-sigs-resolve-in proto typename pspellings line))
      (set! g-type-key-ok saved)
      (return r))))

(defn proto-sigs-resolve-in (proto:raw:Protocol typename:CStr pspellings:ptr line:i32):i32
  (let (pp:raw:Protocol proto
        missing:i32 0)
    (dotimes (i (pp num-sigs))
      (let (sig:ptr (aref (as ptr:ptr (pp sigs)) i)
            csig:ptr (subst-proto-sig-node sig typename (pp params) pspellings (pp num-params))
            name-node:ptr (node-at csig 0)
            params-node:ptr (node-at csig 1)
            mname:ptr null
            ret:ptr null)
        ; S1: a new-style sig carries the (Self-substituted) return at index 2;
        ; legacy sigs keep the exact extract-name-and-type parse (byte-identical).
        (if (!= (sig-name-is-bare name-node) 0)
          (do (set! mname (-> name-node (unsafe/cast ptr:Node _) (_ s)))
              (set! ret (fn-parse-ret-type (node-at csig 2) line)))
          (set! ret (extract-name-and-type name-node (as ptr:ptr (addr-of mname))
                                           ((as ptr:Node name-node) line))))
        (let (nparams:i32 (defn-params-count params-node)
              ptypes:ptr (defn-params-to-types params-node)
              ; Enforce the return type only for a parametric protocol, where the
              ; return may carry a bound element (`get:E`). Plain protocols keep the
              ; historical param-only match (byte-identical).
              check-ret:i32 (if (> (pp num-params) 0) 1 0))
          (when (= (method-satisfies-sig mname ptypes nparams ret check-ret line) 0)
            (set! missing 1)
            (fprintf (as ptr stderr)
              "  %s does not implement %s.%s\n" typename (pp name) mname)))))
    (when (!= missing 0) (return 0))
    (return 1)))

; Verify (when check≠0) and record that `typename` conforms to protocol
; `proto-name`, then recurse into the protocol's super-protocols (§10.3). In
; check mode every required signature (Self→typename, extra params→`pspellings`)
; must resolve to a concrete method or a satisfying built-in operator; missing
; methods are reported and the compile aborts. The conformance-lookup guard makes
; this idempotent and safe against cyclic inheritance. Import side passes
; check=0 (trust the exporter). `pspellings` carries the concrete bindings for a
; parametric protocol (null for a plain Self-only protocol).
(defn verify-conformance-params (typename:CStr proto-name:CStr pspellings:ptr npspellings:i32 line:i32 check:i32):void
  ; Canonicalize the subject type (bare identity) and the protocol (namespaced
  ; identity) up front, so the protocol-lookup, the conformance record, the
  ; super-edge match, and the diagnostics are all consistent even when the
  ; `extend` (or its imported replay) names a qualified `coll/Vector`/`dp/Seq`.
  ; Identity under `user` (no slash) → byte-identical.
  (set! typename (type-canon-name typename))
  (set! proto-name (protocol-canon-name proto-name))
  ; A0: when a parametric protocol is re-extended, the coherence check (and any
  ; arg-upgrade of an arg-less record) lives in `conformance-add`, so the
  ; already-recorded case must still reach it. A plain protocol carries no args
  ; (npspellings 0), so the historical early-return is preserved exactly for it —
  ; keeping the hot, byte-identical path untouched.
  (when (!= (conformance-lookup typename proto-name) 0)
    (when (> npspellings 0)
      (conformance-add typename proto-name pspellings npspellings line))
    (return))
  ; B2a: `proto-name` is canonical by now — `emit-extend` resolved the source
  ; spelling and passed the Protocol's own name down, and the super-protocol
  ; recursion below passes an edge key. Either way this is a key lookup; the
  ; scope gate already fired at the reference. The raise stays as the backstop
  ; for the import-replay path (check=0 returns instead).
  (let (proto:ptr (protocol-lookup-ns proto-name))
    (when (= proto null)
      (when (!= check 0)
        (die-at line (fmt-s "extend: unknown protocol '%s'" proto-name)))
      (return))
    (when (!= check 0)
      (when (= (proto-sigs-resolve proto typename pspellings line) 0)
        (die-at line
          (fmt-2s "type '%s' does not conform to protocol '%s'" typename proto-name))))
    (conformance-add typename proto-name pspellings npspellings line)
    ; Conforming to `proto-name` requires conforming to each declared super. The
    ; supers are plain (Self-only) protocols here, so they carry no extra params.
    (dotimes (si (unsafe/cast i32 (count g-proto-supers)))
      (let (e:ptr:Conformance (invoke g-proto-supers (as usize si)))
        (when (= (e type-name) proto-name)
          (verify-conformance-params typename (e proto-name) null 0 line check))))))

; Self-only conformance (the historical signature): plain protocols carry no
; extra parameters, so the bindings array is null.
(defn verify-conformance (typename:CStr proto-name:CStr line:i32 check:i32):void
  (verify-conformance-params typename proto-name null 0 line check))

; Stage 11 T4: record a template-level conformance `(extend (Vector T) (Seq T))`.
; `template` is the extended struct template, `proto` the (parametric) protocol,
; and `bindings` the proto-application args (`T`) positionally bound to the
; protocol's extra params (`E`). Idempotent on (template, proto). The per-instance
; check is deferred to stamp time (tmpl-conformance-check-instance).
; Stage 11 assoc-types (A4): also carries the parsed trailing `&where` clause
; (tyvars/num-tyvars + the constraints Vector + num-constraints).
; A &where-free extend passes the template's own tyvars/ntv, null constraint
; arrays, and num-constraints = 0 — identical downstream behaviour to T4.
(defn tmpl-conformance-add (template:raw:StructTemplate proto:raw:Protocol bindings:ptr nbindings:i32
                                 tyvars:ptr num-tyvars:i32
                                 (constraints (raw (Vector (ref Constraint))))
                                 num-constraints:i32):void
  (doseq (c g-tmpl-conformances (VecIter ref:TmplConformance))
    (when (and (= (c template) template) (= (c proto) proto)) (return)))
  (let (c:ptr:TmplConformance (new TmplConformance))
    (.set! c template template)
    (.set! c proto proto)
    (.set! c bindings bindings)
    (.set! c nbindings nbindings)
    (.set! c tyvars tyvars)
    (.set! c num-tyvars num-tyvars)
    (.set! c constraints constraints)
    (.set! c num-constraints num-constraints)
    (conj g-tmpl-conformances c)))

; Check (and record) that the concrete instance named `iname`, stamped from
; struct template `st` with concrete arg spellings `arg-spellings` (length
; `nargs`, the template's tyvars in order), satisfies the parametric protocol of
; one recorded template conformance `c`. Each protocol binding node (`T` from
; `(Seq T)`) is rewritten with the conformance's tyvars → concrete spellings, then
; parsed and canonicalized to its concrete spelling (`i32`), giving the protocol's
; extra-param bindings. verify-conformance-params then checks every required
; method resolves for `iname`, recording the concrete conformance so a Seq-bounded
; generic call over `Vector.i32` finds it through the ordinary conformance lookup.
;
; Stage 11 assoc-types (A4.2): a `&where`-bearing extend
; `(extend (MapIter I F) (Iterator E) &where ((Iterator S) I) ((UnaryFn S E) F))`
; names a protocol-application arg (`E`) that is neither a template parameter nor
; concrete — it is recovered from this instance's own conformances (`F`'s
; `(UnaryFn S E)`). For such a conformance (num-constraints > 0) the binding map is
; built in two stages: the template tyvars are seeded with the instance's stamp arg
; spellings (`I → "IntRangeIter"`, `F → "SqFn"`), then recover-assoc-into runs the
; A2 fixpoint to fill the associated tyvars (`S`, `E`). The full map is substituted
; into `(Iterator E)`, then verified and recorded as for the concrete-arg path. The
; recovery reads the conformances of the stamp args, which must already be recorded;
; if a conforming variable's conformance is not yet present (recover-assoc-into
; returns a soft 0), the check is *deferred* rather than erroring — the bottom-up
; stamping order (and the post-extend recheck, §4.5) records it on a later pass.
; Stage 15 B3′a: a per-instance template conformance check is a SYNTHESIS region —
; every type spelling it parses is a `type-spelling` of an already-parsed Type (the
; stamp's arg spellings, the recovered associated tyvars), substituted into the
; `extend`'s binding nodes. It runs at STAMP time, in whatever file first named the
; instance, which is routinely not the file that wrote the `extend`. Without the arm
; a namespaced stamp argument — `(Vector (ref gx/Pt))` — re-resolves `gg/Pt` as a
; reference in the stamping file and is refused, i.e. no namespaced type could be a
; type argument to any template carrying a parametric-protocol `extend`. See
; `g-type-key-ok` (src/nucleusc.nuc).
(defn tmpl-conformance-check-one (c:raw:TmplConformance st:raw:StructTemplate iname:CStr arg-spellings:ptr nargs:i32 line:i32):void
  (let (saved:i32 g-type-key-ok)
    (set! g-type-key-ok 1)
    (tmpl-conformance-check-one-in c st iname arg-spellings nargs line)
    (set! g-type-key-ok saved)))

(defn tmpl-conformance-check-one-in (c:raw:TmplConformance st:raw:StructTemplate iname:CStr arg-spellings:ptr nargs:i32 line:i32):void
  (let (cc:raw:TmplConformance c
        stt:raw:StructTemplate st
        proto:raw:Protocol (cc proto)
        nb:i32 (cc nbindings)
        pspellings:ptr null
        ; The tyvar-name array and the concrete spellings used to substitute the
        ; protocol binding nodes. For a &where-free extend these are the template's
        ; own tyvars and the instance's stamp arg spellings (the unchanged T4 path).
        ; For a &where-bearing extend (set below) they are the conformance's full
        ; tyvar set (template + associated) and the recovered spellings.
        subst-tyvars:ptr (stt tyvars)
        subst-spellings:ptr arg-spellings
        subst-ntv:i32 nargs)
    ; Stage 11 assoc-types (A4.2): recover the associated tyvars at stamp time.
    (when (> (cc num-constraints) 0)
      (let (ntv:i32 (cc num-tyvars)
            ; out-bound[tyvar-index] = Type* (or null), the same representation
            ; recover-assoc-into / generic-method-bind use at dispatch time.
            out-bound:ptr (arena-alloc (* (as i64 (if (> ntv 0) ntv 1)) (ptr-bytes)))
            spellings:ptr (arena-alloc (* (as i64 (if (> ntv 0) ntv 1)) (ptr-bytes))))
        ; Seed: every tyvar starts unbound; the first `nargs` entries of the
        ; conformance's tyvar array are the template's own tyvars (seeded by
        ; emit-extend in template order, hence aligned with `arg-spellings`).
        (dotimes (k ntv) (aset! (as ptr:ptr out-bound) k null))
        (dotimes (si nargs)
          (aset! (as ptr:ptr out-bound) si
                 (conf-arg-to-type (aref (as ptr:ptr arg-spellings) si) line)))
        ; Run the A2 fixpoint over the conformance's &where clause. A soft 0 means
        ; a conforming variable's conformance is not yet recorded for this instance
        ; — defer (a later pass / recheck-stamped will catch it), do not error.
        (when (= (recover-assoc-into (cc tyvars) out-bound ntv
                                     (cc constraints)
                                     (cc num-constraints) line) 0)
          (return))
        ; recover-assoc-into fills the associated tyvars; the full map must now be
        ; total over the conformance's tyvars (the determination fixpoint in
        ; emit-extend guaranteed every protocol-app tyvar is reachable). Any still-
        ; unbound entry means a constraint never fired — also a deferral.
        (dotimes (bk ntv)
          (when (= (aref (as ptr:ptr out-bound) bk) null) (return))
          (aset! (as ptr:ptr spellings) bk (type-spelling (aref (as ptr:ptr out-bound) bk))))
        (set! subst-tyvars (cc tyvars))
        (set! subst-spellings spellings)
        (set! subst-ntv ntv)))
    (when (> nb 0)
      (set! pspellings (arena-alloc (* (as i64 nb) (ptr-bytes))))
      (dotimes (i nb)
        (let (bnode:ptr (aref (as ptr:ptr (cc bindings)) i)
              ; Substitute the conformance's tyvars with the concrete spellings
              ; (template args for T4, recovered args for A4.2) in this binding
              ; node, then parse + canonicalize.
              sub:ptr (subst-tyvars-node bnode subst-tyvars subst-spellings subst-ntv)
              bt:ptr (parse-type-from-node sub line))
          (aset! (as ptr:ptr pspellings) i (type-spelling bt)))))
    ; A0: `pspellings` holds the *substituted concrete* protocol args for this
    ; instance (`T` → i32, or a recovered `E` → i32), so the per-instance
    ; conformance retains them.
    (verify-conformance-params iname (proto name)
                               pspellings nb line 1)))

; Stamp-time hook: a concrete instance `iname` was just stamped from template
; `st` (arg spellings `arg-spellings`, length `nargs`). Check every template-level
; conformance recorded for `st`, recording the concrete per-instance conformance
; (and erroring, naming the missing method, if a required method does not resolve).
(defn tmpl-conformance-check-instance (st:raw:StructTemplate iname:CStr arg-spellings:ptr nargs:i32 line:i32):void
  (dotimes (i (unsafe/cast i32 (count g-tmpl-conformances)))
    (let (c:ptr:TmplConformance (as ptr:TmplConformance
                                  (invoke g-tmpl-conformances (as usize i))))
      (when (= (c template) st)
        (tmpl-conformance-check-one c st iname arg-spellings nargs line)))))

; Retroactively check a newly-recorded template conformance against every
; instance of the template already stamped before the `extend` was processed
; (a `(Vector i32)` use earlier in the file may stamp the instance before the
; `extend` form is reached). Recovers each instance's (template, args) from its
; StructDef origin fields (T2) and runs the per-instance check.
(defn tmpl-conformance-recheck-stamped (c:raw:TmplConformance st:raw:StructTemplate line:i32):void
  (dotimes (i (unsafe/cast i32 (count g-structs)))
    (let (sd:ptr:StructDef (as ptr:StructDef (invoke g-structs (as usize i))))
      (when (= (sd origin-template) st)
        (let (na:i32 (sd origin-nargs)
              spell:ptr null)
          (when (> na 0)
            (set! spell (arena-alloc (* (as i64 na) (ptr-bytes))))
            (dotimes (k na)
              (aset! (as ptr:ptr spell) k
                     (type-spelling (aref (as ptr:ptr (sd origin-args)) k)))))
          (tmpl-conformance-check-one c st (sd name) spell na line))))))

; (extend Subject Protocol): post-prescan conformance check (§9.2/§10.3). When
; Subject is a *protocol*, this declares protocol inheritance (Subject requires
; Protocol). Otherwise Subject is a type whose conformance is verified and
; recorded, recursing into the protocol's supers.
; The protocol name carried by an `extend` protocol position, which is either a
; bare symbol `Seq` or a parametric application `(Seq T...)`. Returns the name and
; writes the application's arg nodes + count through `out-args`/`out-nargs`.
(defn extend-proto-name (proto-node:raw:Node out-args:ptr:ptr out-nargs:ptr:i32 line:i32):ptr
  (let (pn:raw:Node proto-node)
    (case (pn kind)
      NODE-SYM
        (do
          (ptr-set! out-args null)
          (aset! (as ptr:i32 out-nargs) 0 0)
          (return (pn s)))
      NODE-CELL
        (let (head:ptr:Node (unsafe/cast ptr:Node (node-at pn 0)))
          (when (!= (head kind) NODE-SYM)
            (die-at (pn line) "extend: protocol name must be a symbol"))
          (let (na:i32 (- (node-len pn) 1)
                args:ptr null)
            (when (> na 0)
              (set! args (arena-alloc (* (as i64 na) (ptr-bytes))))
              (dotimes (i na)
                (aset! (as ptr:ptr args) i (node-at pn (+ i 1)))))
            (ptr-set! out-args args)
            (aset! (as ptr:i32 out-nargs) 0 na)
            (return (head s))))
      0)
    (die-at (pn line) "extend: protocol must be a symbol or (Protocol args...)")
    (return null)))

(defn emit-extend (form:raw:Node):void
  (let (ff:raw:Node form)
    (when (< (node-len form) 3)
      (die-at (ff line) "extend: expected (extend Subject Protocol)"))
    (let (type-node:ptr:Node (unsafe/cast ptr:Node (node-at form 1))
          proto-node:ptr:Node (unsafe/cast ptr:Node (node-at form 2))
          proto-args:ptr null
          proto-nargs:i32 0
          ; The protocol may be written qualified (`dpx/Describe`, through an
          ; import prefix) or bare from inside its own namespace. Stage 15 B2a:
          ; resolve the REFERENCE exactly once, here, where the source spelling
          ; and the file's import environment are both in hand — and then carry
          ; the resolved record downward. Everything below wants the protocol's
          ; canonical registry identity (W9 defect 21 — a protocol is NOT
          ; stripped), and re-deriving it by looking the spelling up a second time
          ; is what would ask the scope question twice and get two answers.
          ; Identity under `user`.
          proto-spelling:CStr (extend-proto-name proto-node
                                                 (as ptr:ptr (addr-of proto-args))
                                                 (as ptr:i32 (addr-of proto-nargs))
                                                 (node-line (as ptr proto-node) (ff line)))
          proto-rec:?ptr:Protocol (protocol-lookup proto-spelling)
          ; Unresolved names pass through as written: a blanket protocol
          ; (`Any`/`Struct`), `Valid`, and the spelling a diagnostic must quote.
          proto-name:CStr (if (= proto-rec null)
                            proto-spelling
                            (-> proto-rec (as ptr:Protocol _) (_ name))))
      ; Stage 11 T4: the subject is a struct *template* `(extend (Vector T) (Seq T))`.
      ; Record a template-level conformance; the per-instance check fires at stamp
      ; time, and any already-stamped instance is rechecked now.
      (case (type-node kind)
        NODE-CELL
        (let (thead:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr type-node) 0)))
          (when (!= (thead kind) NODE-SYM)
            (die-at (node-line (as ptr type-node) (ff line)) "extend: template subject name must be a symbol"))
          ; Stage 12 N4: a qualified template head (`coll/Vector`) resolves to the
          ; bare-keyed template registry. Identity under `user`.
          (let (st:?ptr:StructTemplate (struct-template-lookup-ref (thead s)))
            (when (= (as ptr st) null)
              (die-at (node-line (as ptr type-node) (ff line))
                (fmt-s "extend: '%s' is not a struct template" (thead s))))
            (let (proto:?ptr:Protocol proto-rec)
              (when (= (as ptr proto) null)
                (die-at (node-line (as ptr proto-node) (ff line))
                  (with-qualifier-note
                    (fmt-s "extend: unknown protocol '%s'" proto-spelling)
                    (as ptr proto-spelling))))
              ; The protocol application must supply exactly the protocol's extra
              ; params, each bound positionally to one of the template's tyvars.
              (when (!= proto-nargs (-> proto (unsafe/cast ptr:Protocol _) (_ num-params)))
                (die-at (node-line (as ptr proto-node) (ff line))
                  (fmt-s "extend: protocol '%s' expects a different number of parameters" proto-name)))
              ; Stage 11 assoc-types (A4.1): parse a trailing `&where` clause, if
              ; present, into the conformance's constraint arrays and run the
              ; determination fixpoint (assoc-types-extend.md §3). The clause is
              ; spelled identically to a defn's &where and parsed by the shared
              ; parse-where-constraints (A4.0). `form` is `(extend Subject (Proto
              ; Arg…) &where C…)`: node 0 = `extend`, 1 = subject, 2 = proto app,
              ; 3 = `&where` marker, 4… = constraints. A &where-free extend
              ; (node-len <= 3) keeps num-constraints = 0 and behaves exactly as T4.
              (let (stt:ptr:StructTemplate (unsafe/cast ptr:StructTemplate st)
                    base-ntv:i32 (stt ntv)
                    nc:i32 0
                    where-i:i32 -1)
                ; Detect the trailing &where marker at node 3.
                (when (> (node-len form) 3)
                  (let (m:ptr:Node (unsafe/cast ptr:Node (node-at form 3)))
                    (when (and (= (m kind) NODE-SYM) (= (m s) "&where"))
                      (set! where-i 3)
                      (set! nc (- (node-len form) 4)))))
                (when (and (>= where-i 0) (< nc 1))
                  (die-at (ff line) "extend: &where requires at least one (Protocol Var) constraint"))
                (if (= nc 0)
                  ; --- &where-free extend: the unchanged T4 path ---
                  (tmpl-conformance-add (as ptr st) (as ptr proto) proto-args proto-nargs
                                        (stt tyvars) base-ntv null 0)
                  ; --- &where-bearing extend: parse + determine (A4.1) ---
                  (do
                    ; Capacity: the template's own tyvars seed the array; each
                    ; constraint may introduce more (its conforming var + arg
                    ; tyvars), and the protocol application `(Iterator E)` may name
                    ; a tyvar (E) bound only by the &where clause. Size the
                    ; additional slots by the node-walk of each constraint's
                    ; element 0 plus each protocol-application arg — never less
                    ; than the collectible tyvar count — mirroring
                    ; register-generic-defn's bound.
                    (let (slot-bound:i32 base-ntv)
                      (dotimes (sb-c nc)
                        (set! slot-bound (+ slot-bound
                                            (count-pattern-nodes
                                              (node-at (node-at form (+ 4 sb-c)) 0)))))
                      (dotimes (sb-p proto-nargs)
                        (set! slot-bound (+ slot-bound
                                            (count-pattern-nodes
                                              (aref (as ptr:ptr proto-args) sb-p)))))
                      (let (cap:i32 (if (> slot-bound 0) slot-bound 1)
                            (constraints (ref (Vector (ref Constraint)))) (vector-new-in (addr-of g-arena-alloc))
                            tyvars:ptr     (arena-alloc (* (as i64 cap) (ptr-bytes)))
                            ntv:i32 0)
                        ; Seed the tyvars array with the template's own tyvars; they
                        ; are the instance's stamp arguments, hence always determined.
                        (dotimes (si base-ntv)
                          (aset! (as ptr:ptr tyvars) si (aref (as ptr:ptr (stt tyvars)) si)))
                        (set! ntv base-ntv)
                        ; Parse the &where constraints (constraints start at node 4),
                        ; collecting constraint vars + Arg tyvars after the seeds.
                        (parse-where-constraints form 4 nc
                                                 constraints
                                                 tyvars (as ptr:i32 (addr-of ntv)) (ff line))
                        ; Collect tyvars appearing in the protocol application
                        ; `(Iterator E)` too, so the §3 determination check can see
                        ; an E that no &where constraint introduces. A concrete arg
                        ; (`i32`) or a template tyvar (already seeded) is skipped;
                        ; only a fresh bare tyvar (`E`) is added — initially
                        ; undetermined, so it must be reached by the fixpoint.
                        (dotimes (pci proto-nargs)
                          (collect-constraint-arg-tyvars (aref (as ptr:ptr proto-args) pci)
                                                         tyvars (as ptr:i32 (addr-of ntv))))
                        ; Determination fixpoint (§3): seed = template tyvars (the
                        ; first base-ntv entries); step = for each constraint whose
                        ; conforming var V is determined, every tyvar appearing in an
                        ; Arg position becomes determined; repeat to fixpoint.
                        (let (determined:ptr (arena-alloc (* (as i64 (if (> ntv 0) ntv 1)) 4)))
                          (dotimes (di ntv)
                            (aset! (as ptr:i32 determined) di (if (< di base-ntv) 1 0)))
                          (let (changed:i32 1)
                            (while (!= changed 0)
                              (set! changed 0)
                              (let (ck:i32 0)
                                (while (< ck nc)
                                  (let (crec:ref:Constraint (invoke constraints (as usize ck))
                                        vidx:i32 (tyvar-index-of (crec var) tyvars ntv)
                                        na:i32 (crec nargs))
                                    (when (and (>= vidx 0)
                                               (and (!= (aref (as ptr:i32 determined) vidx) 0) (> na 0)))
                                      (let (argv:ptr (crec args)
                                            ai:i32 0)
                                        (while (< ai na)
                                          (let (argn:ptr (aref (as ptr:ptr argv) ai)
                                                ti2:i32 0)
                                            (while (< ti2 ntv)
                                              (when (and (= (aref (as ptr:i32 determined) ti2) 0)
                                                         (!= (node-mentions-tyvar-named argn (aref (as ptr:ptr tyvars) ti2)) 0))
                                                (aset! (as ptr:i32 determined) ti2 1)
                                                (set! changed 1))
                                              (inc! ti2)))
                                          (inc! ai)))))
                                  (inc! ck)))))
                          ; Every tyvar mentioned in the protocol application
                          ; `(Iterator E)` must be determined after convergence.
                          (dotimes (pai proto-nargs)
                            (let (argn:ptr (aref (as ptr:ptr proto-args) pai))
                              (dotimes (ti ntv)
                                (when (and (= (aref (as ptr:i32 determined) ti) 0)
                                           (!= (node-mentions-tyvar-named argn (aref (as ptr:ptr tyvars) ti)) 0))
                                  (die-at (node-line (as ptr proto-node) (ff line))
                                    (fmt-s "extend: protocol parameter '%s' is not determined by the subject or any &where constraint"
                                           (aref (as ptr:ptr tyvars) ti))))))))
                        (tmpl-conformance-add (as ptr st) (as ptr proto) proto-args proto-nargs
                                              tyvars ntv constraints nc))))))
              ; Retroactively check instances stamped before this extend was seen.
              ; The just-added conformance is the last element of g-tmpl-conformances.
              (let (ntc:i32 (unsafe/cast i32 (count g-tmpl-conformances))
                    c:ptr:TmplConformance (as ptr:TmplConformance
                                            (invoke g-tmpl-conformances (as usize (- ntc 1)))))
                (tmpl-conformance-recheck-stamped (as ptr c) (as ptr st) (ff line)))
              (return))))
      0)
      ; --- subject is a concrete type (symbol) ---
      (when (!= (type-node kind) NODE-SYM)
        (die-at (node-line (as ptr type-node) (ff line)) "extend: subject must be a symbol or struct template"))
      ; The subject may be written qualified (`coll/Vector`) from another
      ; namespace; canonicalize it to the bare TYPE identity so every lookup
      ; below — and the recorded conformance — matches the dispatch site.
      ; `proto-name` was already canonicalized as a PROTOCOL above; the two
      ; canonicalizers are deliberately different (Stage 15 W9 defect 21).
      ; Identity under `user` (no slash).
      (let (typename:CStr (type-canon-name (type-node s))
            ; The subject of a protocol-INHERITANCE extend is itself a protocol
            ; name, so it resolves through the protocol registry (namespaced),
            ; not through `typename` (the type canonicalization). Resolving the
            ; raw spelling is what makes `(extend dp/Describe dp/Show)` — and
            ; the bare-inside-`(ns dp)` spelling of the same edge — work.
            subj-proto:?ptr:Protocol (protocol-lookup (type-node s)))
        ; Protocol-on-protocol: declare inheritance, no per-type check. Only the
        ; bare-symbol protocol form participates in inheritance.
        (when (and (!= subj-proto null) (= proto-nargs 0))
          (when (= proto-rec null)
            (die-at (node-line (as ptr proto-node) (ff line))
              (with-qualifier-note
                (fmt-2s "extend: '%s' is a protocol, so its supertype '%s' must be a protocol too"
                        (-> subj-proto (as ptr:Protocol _) (_ name)) proto-spelling)
                (as ptr proto-spelling))))
          (proto-super-add (-> subj-proto (as ptr:Protocol _) (_ name)) proto-name)
          (return))
        ; Extending to a blanket protocol (Any/Struct) is redundant — conformance
        ; is automatic and structural — so accept it as a no-op.
        (when (and (!= (blanket-lookup proto-name) 0) (= proto-nargs 0)) (return))
        (let (proto:?ptr:Protocol proto-rec)
          (when (= (as ptr proto) null)
            (die-at (node-line (as ptr proto-node) (ff line))
              (with-qualifier-note
                (fmt-s "extend: unknown protocol '%s'" proto-spelling)
                (as ptr proto-spelling))))
          ; Validate single-token subject types eagerly for a clean diagnostic.
          ; Stage 15 B3′a: on the SPELLING the author wrote, never on `typename` —
          ; `type-canon-name` has already resolved the reference, and re-parsing its
          ; canonical output asks the scope question a second time in a file that
          ; usually cannot name the defining namespace (§9.2's "resolve once, at the
          ; reference, then carry the record"). `(extend gx/Pt P)` canonicalizes to
          ; `gg/Pt` and was then refused as an unknown type.
          (when (= (strchr (type-node s) 58) null)
            (parse-type-name (type-node s) (node-line (as ptr type-node) (ff line))))
          (when (!= proto-nargs (-> proto (unsafe/cast ptr:Protocol _) (_ num-params)))
            (die-at (node-line (as ptr proto-node) (ff line))
              (fmt-s "extend: protocol '%s' expects a different number of parameters" proto-name)))
          ; Concrete protocol params (`(Seq i32)`): canonicalize each arg's spelling.
          (let (pspellings:ptr null)
            (when (> proto-nargs 0)
              (set! pspellings (arena-alloc (* (as i64 proto-nargs) (ptr-bytes))))
              (dotimes (i proto-nargs)
                (aset! (as ptr:ptr pspellings) i
                       (type-spelling (parse-type-from-node
                                        (aref (as ptr:ptr proto-args) i) (node-line (as ptr proto-node) (ff line)))))))
            (verify-conformance-params typename proto-name pspellings proto-nargs (ff line) 1)))))))

; Import side: trust the exporting unit's check; record the fact (and recurse
; supers), or re-register a protocol-inheritance edge.
; A0: an imported `extend` may name a *parametric* protocol application
; `(extend IntRangeIter (Iterator i32))`. The historical guard required both
; positions to be bare symbols, silently dropping every parametric conformance on
; import. Now the protocol position is parsed with `extend-proto-name` and its
; concrete args are canonicalized and retained (rule (a), §4.5) so an
; associated-type bound (A2) on an imported type recovers them. The exporter
; already verified the methods, so we pass check=0 (trust) and only record.
; A template-subject extend (`(extend (Vector T) (Seq T))`, or A4.3's
; `&where`-bearing `(extend (MapIter I F) (Iterator E) &where …)`) re-registers
; the `TmplConformance` in the importing unit by replaying the *same*
; `emit-extend` template branch the defining unit ran (assoc-types-extend.md §10).
; That branch parses any trailing `&where`, runs the determination fixpoint, and
; records the `TmplConformance` (with its constraint clause); the per-instance
; `Conformance` — with the recovered associated args — is then produced at stamp
; time when the importing unit stamps a concrete instance (A4.2's stamp-time
; recovery). It emits no IR (template subjects define no type), so it is safe on
; the import path. The exporter cannot serialize per-instance recovered args for
; instances it never stamped; re-running recovery in the importer closes that gap.
(defn register-imported-conformance (form:raw:Node):void
  (when (>= (node-len form) 3)
    (let (type-node:ptr:Node (unsafe/cast ptr:Node (node-at form 1))
          proto-node:ptr:Node (unsafe/cast ptr:Node (node-at form 2)))
      ; Template subject: delegate to emit-extend (registers the
      ; TmplConformance + &where clause; recovery fires at stamp time here).
      (case (type-node kind)
        NODE-CELL
          (do (emit-extend form) (return))
        NODE-SYM
          (let (proto-args:ptr null
                proto-nargs:i32 0
                proto-name:CStr (extend-proto-name proto-node
                                                  (as ptr:ptr (addr-of proto-args))
                                                  (as ptr:i32 (addr-of proto-nargs))
                                                  (form line)))
            ; A protocol-on-protocol inheritance edge keeps its plain-symbol shape.
            ; B2a: a `.nuch` replay carries canonical names written by the
            ; exporting unit, not spellings this file could name — key lookup.
            (if (and (!= (protocol-lookup-ns (type-node s)) null) (= proto-nargs 0))
              (proto-super-add (type-node s) proto-name)
              (let (pspellings:ptr null)
                (when (> proto-nargs 0)
                  (set! pspellings (arena-alloc (* (as i64 proto-nargs) (ptr-bytes))))
                  (dotimes (i proto-nargs)
                    (aset! (as ptr:ptr pspellings) i
                           (type-spelling (parse-type-from-node
                                            (aref (as ptr:ptr proto-args) i)
                                            (form line))))))
                (verify-conformance-params (type-node s) proto-name pspellings proto-nargs
                                           (form line) 0))))
        0))))

; ############################################################
; node-type: non-emitting expression typing (Stage 9 rung 3) —
; appended in N8. Co-located here (not its own file) because node-type and
; the generics machinery are mutually recursive: node-type resolves generic-
; lookup/generic-find-method-exact/generic-has-receiver-method, while the
; generic-body checkers (gcheck, valid-walk) call node-type/node-type-call/
; node-type-sym to type concrete subexpressions. A single import-use registers
; both halves before either body emits, breaking the cross-file edge.
; ############################################################
; ============================================================
; node-type: non-emitting expression typing (Stage 9 rung 3)
; ============================================================
; node-type(n, scope) computes the Type an expression contributes to its parent
; WITHOUT emitting IR. emit-node sets the type it propagates from this function,
; so the type pass and codegen share one rule per node kind and cannot drift —
; any divergence corrupts the self-hosting bootstrap and is caught immediately.
;
; It is total over the language's value forms. The few forms whose emit-time
; type depends on control-flow/expansion that can't be reproduced purely (`cond`
; phi typing, `quasiquote` of a bare unquote, macro calls) return null, meaning
; "not modeled — keep the emit-computed type"; callers treat null as unknown.
; node-type never emits and never aborts: ambiguous lookups yield null.

(defn node-type-sym (n:raw:Node scope:ref:Scope):?ptr:Type
  ; Phase F flip: the `null` literal is raw, so it flows into raw/? slots but
  ; not into a non-null `ref`/`ptr` slot without an explicit guard or cast.
  (when (= n 'null)  (return ty-raw))
  (when (= n 'true)  (return ty-i1))
  (when (= n 'false) (return ty-i1))
  (when (= n 'none)  (return ty-maybe-ptr))
  (let (lookup-name:ptr null
        ignored:ptr null)
    (split-typed (n s)
                 (as ptr:ptr (addr-of lookup-name)) (as ptr:ptr (addr-of ignored)))
    (let (sym:?ptr:Sym (scope-lookup scope lookup-name))
      (when (= sym null) (return null))
      ; Stage 15 W8 G-2 lockstep with emit-symbol-ref (conventions.md
      ; node-type<->emit-node): reading an `(array T N)` binding yields the
      ; decayed `(ref T)`, never the aggregate. One shared rule, called from
      ; both sides — array-decay is identity for every other kind.
      (return (array-decay (sym-effective-type sym))))))

; Stage 15 W5d (design/stage15-stress-test/ergonomics.md §3.10): the type a
; let/with binding actually takes when its declared type is an elem-LESS pointer
; and its initializer is literally an `(array T …)` compound literal. The
; literal yields `ptr:T`, but a bare `ptr` annotation erased the element type,
; so `(aref a i)` / `(deref a)` / `(a field)` on the local all died "operand
; must be typed pointer" and the workable spellings were the fully-annotated
; `a:ptr:T` or a bare (untyped) binding name — both of which already worked, so
; the wart was the *annotated-but-imprecise* middle case alone. The binding now
; adopts the literal's element type while keeping the DECLARED pointer kind and
; volatility: the annotation still says everything it said, plus the element it
; had no way to say.
;
; Deliberately SYNTACTIC — an `(array …)` init specifically, not a general
; "adopt the init's element type whenever the declaration is elem-less" rule.
; A bare `:ptr` is this language's void*-style erasure hatch and it erases the
; *nullability claim* as well as the element type (pkind-flow-check exempts an
; elem-less target). Adopting elem in general would (a) re-route multimethod
; dispatch — `type-eq` compares pointer elements, so a `ptr:Node` argument does
; NOT match a `ptr` parameter — across the ~1550 bare `:ptr` bindings in this
; compiler alone, and (b) either keep a non-null claim over a nullable source or
; silently downgrade what the author declared. An `(array …)` literal has
; neither problem: it is an alloca, so always non-null, and its element type is
; spelled by the author *in the initializer*, so nothing is inferred that a
; reader of the binding cannot see.
;
; IR-inert by construction: every pointer lowers to `ptr` with size 8, so the
; binding's alloca, its store and its coercion are identical either way — only
; the type recorded in the SCOPE changes. Returns `ty` unchanged in every other
; case, including a null `ty` (the CE-1 bare-name path fills that in from the
; emitted value, and that path already carries the element type).
;
; Called from emit-let/emit-with (nucleusc.nuc) and mirrored in node-type-block
; below, so the two passes agree on the binding type (the node-type<->emit-node
; lockstep, conventions.md): one rule function both sides call, never two copies.
(defn array-lit-binding-type (ty:(raw Type) init:(raw Node)):?ptr:Type
  (when (or (= ty null) (= init null)) (return ty))
  (let (tt:(raw Type) ty)
    (when (or (!= (tt kind) TY-PTR) (!= (tt elem) null)) (return ty))
    (let (n:(raw Node) init)
      (when (!= (n kind) NODE-CELL) (return ty))
      ; `(array T …)` is at least a head and an element type.
      (when (< (node-len (as ptr n)) 2) (return ty))
      (let (head:ptr (node-at (as ptr n) 0))
        (when (= head null) (return ty))
        ; Symbol Nodes are interned singletons, so the head identity test is a
        ; pointer compare against the quoted symbol (see gcheck-special-form).
        (when (!= head (as ptr 'array)) (return ty))
        (let (etype-node:ptr (node-at (as ptr n) 1))
          (when (= etype-node null) (return ty))
          (let (etype:ptr (as ptr (parse-type-from-node etype-node
                                    (node-line etype-node
                                      (node-line (as ptr n) 0)))))
            (when (= etype null) (return ty))
            (let (rt:ptr:Type (as ptr:Type (make-type TY-PTR)))
              (.set! rt elem etype)
              (.set! rt pkind (tt pkind))
              (.set! rt is-volatile (tt is-volatile))
              (return (as ptr rt)))))))))

; let / with: the type of the last body expression, evaluated in a child scope
; carrying the binding types (values are irrelevant to typing).
(defn node-type-block (n:raw:Node scope:ref:Scope):?ptr:Type
  ; AT-1 lockstep with emit-let/emit-with (conventions.md node-type<->emit-node):
  ; normalize a leading `:volatile` (etc.) into a wrapped binding name so the
  ; (name value) pairing survives and the binding types register at the right
  ; slots. Attribute-free lists pass through unchanged.
  (let (binds:ptr:Node (unsafe/cast ptr:Node
                         (attrs-normalize-bindings (as ptr (node-at n 1))
                           ((unsafe/cast ptr:Node n) line))))
    (when (or (= (as ptr binds) null) (!= (binds kind) NODE-CELL)) (return null))
    (let (inner:ref:Scope (scope-new scope)
          i:i32 0
          bl:i32 (node-len (as ptr binds)))
      (while (< i bl)
        (let (bname:ptr (node-at (as ptr binds) i)
              name:ptr null
              ty:ptr (extract-name-and-type bname (as ptr:ptr (addr-of name))
                                            ((unsafe/cast ptr:Node bname) line)))
          ; W5d (§3.10) lockstep with emit-let/emit-with: an `(array T …)` init
          ; refines an elem-less declared pointer to `ptr:T`, so a probe over the
          ; body types `(aref a i)` exactly as emission does.
          (set! ty (array-lit-binding-type ty (node-at (as ptr binds) (+ i 1))))
          (when (!= ty null) (scope-define inner name ty name 1)))
        (set! i (+ i 2)))
      (let (last:ptr null
            j:i32 2
            cl:i32 (node-len n))
        (while (< j cl)
          (set! last (node-at n j))
          (inc! j))
        (when (= last null) (return ty-void))
        (return (node-type last inner))))))

(defn node-type-cast (n:raw:Node):ref:Type
  (let (tn:ptr:Node (unsafe/cast ptr:Node (node-at n 1)))
    (return (parse-type-from-node (as ptr tn) (tn line)))))

; Stage 14 UN-1: `(as TYPE expr)` type mirror (node-type<->emit-node lockstep,
; conventions.md). emit-as (src/nucleusc.nuc) returns a Val typed EXACTLY the
; parsed target type on every accepted input — same as emit-cast — so the
; non-emitting type is the parsed target type, identical to node-type-cast. A
; rejected `as` dies in emit-as before propagating a type, exactly as an
; unsupported `cast` dies in emit-cast, so the two passes never disagree on any
; type that actually flows to a parent.
(defn node-type-as (n:raw:Node):ref:Type
  (let (tn:ptr:Node (unsafe/cast ptr:Node (node-at n 1)))
    (return (parse-type-from-node (as ptr tn) (tn line)))))

(defn node-type-alloca (n:raw:Node):ref:Type
  (let (tn:ptr:Node (unsafe/cast ptr:Node (node-at n 1)))
    ; Stage 15 W8 G-2 lockstep with emit-alloca-form (conventions.md
    ; node-type<->emit-node): it arms the one-shot `(array T N)` permission and
    ; decays the result to `ptr:T`, so this must do both — otherwise
    ; `(alloca (array i32 4))` types as an error in the non-emitting pass while
    ; codegen accepts it, which is the divergence the lockstep exists to stop.
    (set! g-array-ok 1)
    (let (ty:ptr (parse-type-from-node (as ptr tn) (tn line))
          pt:ref:Type (make-type TY-PTR))
      (if (= ((unsafe/cast ptr:Type ty) kind) TY-ARRAY)
        (.set! pt elem ((unsafe/cast ptr:Type ty) elem))
        (.set! pt elem ty))
      ; alloca always yields a valid, non-null stack address (ref T).
      (.set! pt pkind PTR-REF)
      (return pt))))

(defn node-type-addr-of (n:raw:Node scope:ref:Scope):?ptr:Type
  (let (target:ptr:Node (unsafe/cast ptr:Node (node-at n 1)))
    (when (!= (target kind) NODE-SYM) (return null))
    (let (sym:?ptr:Sym (scope-lookup scope (target s)))
      (when (= sym null) (return null))
      (let (pt:ptr:Type (as ptr:Type (make-type TY-PTR)))
        (.set! pt elem (sym type))
        ; Mirror emit-addr-of: a binding's address is non-null (ref T).
        (.set! pt pkind PTR-REF)
        (return (as ptr pt))))))

(defn node-type-funcall (n:raw:Node scope:ref:Scope):?ptr:Type
  (let (t:ptr (node-type (node-at n 1) scope))
    (when (= t null) (return null))
    (let (tt:ptr:Type (as ptr:Type t))
      (when (!= (tt kind) TY-FN) (return null))
      (return (tt ret)))))

; deref / aref: the pointee type of the first operand's pointer.
(defn node-type-deref-elem (n:raw:Node scope:ref:Scope):?ptr:Type
  (let (t:ptr (node-type (node-at n 1) scope))
    (when (= t null) (return null))
    (let (tt:ptr:Type (as ptr:Type t))
      (when (or (!= (tt kind) TY-PTR) (= (tt elem) null)) (return null))
      (return (tt elem)))))

(defn node-type-field (n:raw:Node scope:ref:Scope):?ptr:Type
  (let (t:ptr (node-type (node-at n 1) scope))
    (when (= t null) (return null))
    (let (tt:ptr:Type (as ptr:Type t))
      (when (or (!= (tt kind) TY-PTR)
                (= (tt elem) null)
                (-> tt (_ elem)
                    (unsafe/cast ptr:Type _)
                    (_ kind)
                    (!= _ TY-STRUCT)))
        (return null))
      (let (fn-node:ptr:Node (unsafe/cast ptr:Node (node-at n 2)))
        (when (!= (fn-node kind) NODE-SYM) (return null))
        (let (sd:ptr:StructDef (unsafe/cast ptr:StructDef (-> tt (_ elem) (unsafe/cast ptr:Type _) (_ sdef)))
              idx:i32 (struct-field-index (as ptr sd) (fn-node s)))
          (when (< idx 0) (return null))
          ; G-2 lockstep with emit-field-load: an array field decays.
          (return (array-decay ((field-at (sd fields) idx) type))))))))

; Result type of `(get callee selector)` for callee type `ct` — mirrors
; emit-get-with-callee / emit-get-intrinsic so the type pass cannot drift from
; codegen. A tier-0 user `get` method → its return; a literal selector → the
; named field's type; a computed selector → null (emit keeps its own type).
(defn callable-get-type (ct:raw:Type sel-node:raw:Node scope:ref:Scope):?ptr:Type
  (let (ctt:raw:Type ct
        g:?ptr:Generic (generic-lookup "get"))
    (when (!= g null)
      (let (argtypes:ptr (arena-alloc (* (as i64 2) (ptr-bytes))))
        (aset! (as ptr:ptr argtypes) 0 ct)
        (aset! (as ptr:ptr argtypes) 1 ty-ptr)
        (let (m:?ptr:Method (generic-find-method-exact g argtypes 2))
          (when (!= m null) (return (m ret-type))))))
    (when (or (!= (ctt kind) TY-PTR) (= (ctt elem) null)
              (!= ((ctt elem) kind) TY-STRUCT))
      (return null))
    (let (lit:ptr (selector-literal-sym sel-node))
      (when (= lit null) (return null))
      (let (sd:raw:StructDef ((ctt elem) sdef)
            idx:i32 (struct-field-index ((ctt elem) sdef)
                                        (-> lit (unsafe/cast ptr:Node _) (_ s))))
        (when (< idx 0) (return null))
        ; G-2 lockstep with emit-get-intrinsic -> emit-field-load: array decay.
        (return (array-decay ((field-at (sd fields) idx) type)))))))

; Result type of `(invoke callee arg…)` for callee type `ct` — the tier-0 `invoke`
; method's return, else null (mirrors emit-invoke-with-callee at the exact tier).
(defn callable-invoke-type (ct:raw:Type n:raw:Node arg-start:i32 nargs:i32 scope:ref:Scope):?ptr:Type
  (let (g:?ptr:Generic (generic-lookup "invoke"))
    (when (= g null) (return null))
    (let (total:i32 (+ nargs 1)
          argtypes:ptr (arena-alloc (* (as i64 (+ total 1)) (ptr-bytes)))
          ok:i32 1)
      (aset! (as ptr:ptr argtypes) 0 ct)
      (dotimes (i nargs)
        (let (at:ptr (node-type (node-at n (+ arg-start i)) scope))
          (when (= at null) (set! ok 0))
          (aset! (as ptr:ptr argtypes) (+ i 1) at)))
      (when (= ok 0) (return null))
      (let (m:?ptr:Method (generic-find-method-exact g argtypes total))
        (when (= m null) (return null))
        (return (m ret-type))))))

; Type of a non-function head value `ct` applied in `(callee arg…)` — mirrors
; emit-callable-value's `invoke → get → _get` routing so the type pass cannot
; drift from codegen: a callee whose type has an `invoke` method → invoke result;
; else a single arg with a custom/intrinsic `get` → get result.
(defn callable-value-type (ct:raw:Type n:raw:Node scope:ref:Scope):?ptr:Type
  (let (nargs:i32 (- (node-len n) 1))
    (when (!= (generic-has-receiver-method (generic-lookup "invoke") ct) 0)
      (return (callable-invoke-type ct n 1 nargs scope)))
    (when (and (= nargs 1)
               (!= (generic-has-receiver-method (generic-lookup "get") ct) 0))
      (return (callable-get-type ct (node-at n 1) scope)))
    (when (and (= nargs 1) (!= (selector-literal-sym (node-at n 1)) null))
      (return (callable-get-type ct (node-at n 1) scope)))
    (return (callable-invoke-type ct n 1 nargs scope))))

(defn node-type-get (n:raw:Node scope:ref:Scope):?ptr:Type
  (when (!= (node-len n) 3) (return null))
  (let (ct:ptr (node-type (node-at n 1) scope))
    (when (= ct null) (return null))
    (return (callable-get-type ct (node-at n 2) scope))))

(defn node-type-invoke (n:raw:Node scope:ref:Scope):?ptr:Type
  (when (< (node-len n) 2) (return null))
  (let (ct:ptr (node-type (node-at n 1) scope))
    (when (= ct null) (return null))
    (return (callable-invoke-type ct n 2 (- (node-len n) 2) scope))))

; The typing rule for one binding-table row that produces a value. Only
; BK-GLOBAL does — a generic is handled by the resolver in `node-type-call`, and
; every other row is a name emit REFUSES in head position, for which returning
; null is the standing escape hatch (emit's own diagnostic stands).
(defn node-type-binding (hit:ref:BindingHit n:raw:Node scope:ref:Scope):?ptr:Type
  (when (!= (hit kind) BK-GLOBAL) (return null))
  (let (sym:ptr:Sym (as ptr:Sym (hit payload))
        ft:ptr:Type (unsafe/cast ptr:Type (sym type)))
    ; A non-function value head is a callable value: mirror the get/invoke desugar.
    (when (!= (ft kind) TY-FN) (return (callable-value-type ft n scope)))
    (return (ft ret))))

; A call head (not a special form): mirror emit-dispatch. Operator → a matching
; user overload's return type, else i1 for comparisons / the first operand's type
; (the intrinsic peephole result); overloaded set → the exactly matched method's
; return type; solitary/extern → the bound function's return.
;
; Stage 15 B5: the WHICH-registry-answers question is now asked once, from the
; shared binding table (`build-binding-kinds`, src/nucleusc.nuc), by
; `emit-dispatch` and by this function — the node-type↔emit-node lockstep
; applied to resolution order rather than to a typing rule (conventions.md:
; mirroring the logic drifts, mirroring a call cannot). The window stops at
; BK-GLOBAL because those are the rows that yield a type; beyond it emit only
; produces a diagnostic.
(defn node-type-call (n:raw:Node scope:ref:Scope h:CStr want:raw:Type):?ptr:Type
  (let (ghit:?ref:BindingHit (binding-find h scope BK-DISPATCH-FIRST (+ BK-GLOBAL 1) 0 NK-NONE))
    (when (= (as ptr ghit) null) (return null))
    (when (!= ((unsafe/cast ptr:BindingHit ghit) kind) BK-GENERIC)
      (return (node-type-binding (unsafe/cast ref:BindingHit ghit) n scope)))
  (let (g:?ptr:Generic (as ptr:Generic ((unsafe/cast ptr:BindingHit ghit) payload)))
    (when (!= g null)
      (let (m0:ptr:Method (as ptr:Method (invoke (g methods) 0)))
        (when (= (m0 kind) METHOD-INTRINSIC)
          ; A user overload of this operator, if any, wins (mirror emit).
          (when (!= (g mangled) 0)
            (let (nargs:i32 (- (node-len n) 1)
                  argtypes:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes)))
                  arg-nodes:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes)))
                  ok:i32 1)
              (dotimes (i nargs)
                (let (anode:ptr (node-at n (+ i 1))
                      at:ptr (node-type anode scope))
                  (when (= at null) (set! ok 0))
                  (aset! (as ptr:ptr argtypes) i at)
                  (aset! (as ptr:ptr arg-nodes) i anode)))
              (when (!= ok 0)
                (let (um:?ptr:Method (operator-user-resolve g argtypes arg-nodes nargs))
                  (when (!= um null) (return (um ret-type)))))))
          (let (bop:ptr:BinOp (unsafe/cast ptr:BinOp (m0 binop)))
            (when (!= (bop is-cmp) 0) (return ty-i1))
            ; Stage 15 W2a: a binop's result type is the type its operands
            ; *unify* to, from the one shared rule emit's binop-coerce uses
            ; (binop-result-type, src/nucleusc.nuc) — not operand 1's type
            ; alone. Returning operand 1's type made `(* 4096 (as i64 X))` type
            ; i32 while emit produced i64 (the argument coercer then inserted a
            ; bogus `sext i32 <i64 value>`) and made `(> t:ui32 (* 2 cl:ui32))`
            ; fail the mixed-sign check that `(* cl 2)` passed. Null (an operand
            ; node-type does not model, or a pair this rule cannot reconcile) is
            ; the usual escape hatch: emit's own unified type then stands.
            (when (!= (node-len n) 3) (return null))
            (let (a-node:raw:Node (node-at n 1)
                  b-node:raw:Node (node-at n 2))
              ; W2b: `scope` goes in too, so a `defconst`/`defenum` operand is
              ; classified as the literal it names on this side exactly as it is
              ; on emit's (binop-coerce) — the lockstep, again, by shared call.
              (return (binop-result-type (node-type a-node scope)
                                         (node-type b-node scope)
                                         a-node b-node scope)))))
        (when (!= (g mangled) 0)
          (let (nargs:i32 (- (node-len n) 1)
                argtypes:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes)))
                arg-nodes:ptr (arena-alloc (* (as i64 (+ nargs 1)) (ptr-bytes)))
                ok:i32 1)
            (dotimes (i nargs)
              (let (anode:ptr (node-at n (+ i 1))
                    at:ptr (node-type anode scope))
                (when (= at null) (set! ok 0))
                (aset! (as ptr:ptr argtypes) i at)
                (aset! (as ptr:ptr arg-nodes) i anode)))
            (when (= ok 0) (return null))
            ; First try METHOD-USER (exact match).
            (let (m:?ptr:Method (generic-find-method-exact g argtypes nargs))
              (when (!= m null) (return (m ret-type))))
            ; Then try METHOD-GENERIC (parametric match with tyvar substitution).
            (let (out-ret:ptr (arena-alloc (ptr-bytes)))
              (when (!= (generic-binds-for g argtypes nargs (as ptr:ptr out-ret) 0 arg-nodes) 0)
                (return (aref (as ptr:ptr out-ret) 0))))
            ; Stage 14 LW-2: mirror emit's generic-resolve tier-2 so a widened
            ; template/plain call types correctly (the node-type↔emit lockstep).
            ; Return null (the escape hatch) on ambiguity/no-match — node-type is
            ; allowed to not-know a type, and must never die here.
            ; TC-3: when no explicit want was passed (the normal node-type entry
            ; points hand null here), fall back to the downward want channel
            ; g-want-type so a non-emitting probe run from a let/with binding
            ; init (tc3-emit-binding-init) can fill a return-only tyvar exactly
            ; as emit would. Safe under the consume-once discipline: g-want-type
            ; is armed only around a binding-init probe/emit and is null in every
            ; other node-type context (gcheck/valid-walk run def-time; the Rung-3
            ; cross-check runs after emit-generic-call already consumed it), so
            ; self-compilation — which has no return-only generics — is unaffected.
            (let (wmethod:ptr null
                  wbound:ptr null
                  r:i32 (generic-resolve-adapt-tier g argtypes arg-nodes nargs 0
                          (as ptr:ptr (addr-of wmethod)) (as ptr:ptr (addr-of wbound))
                          (if (!= want null) want g-want-type)))
              (when (= r 1) (return (-> wmethod (unsafe/cast ptr:Method _) (_ ret-type))))
              (when (= r 2) (return (method-bound-ret-type wmethod wbound 0)))))))))
    ; A solitary (unmangled, non-intrinsic) generic — or a mangled one whose
    ; resolution did not settle — falls through to the next table row, exactly
    ; as emit-dispatch's own fall-through does.
    (if-some (h2 (binding-find h scope (+ BK-GENERIC 1) (+ BK-GLOBAL 1) 0 NK-NONE))
      (return (node-type-binding h2 n scope))
      (return null))))

(defn node-type (n:raw:Node scope:ref:Scope):?ptr:Type
  (when (= n null) (return ty-void))
  (let (nn:raw:Node n)
    (case (nn kind)
      ; LW-4 lockstep with emit-int: an out-of-i32-range literal types (and emits)
      ; as i64, everything else as i32. Keeps codegen and the type pass in sync so
      ; the widened width is not clobbered by emit-node's Rung-3 cross-check.
      ; W2b turned that shared width choice into one function (int-literal-type,
      ; src/nucleusc.nuc) rather than a copy here and a copy in emit-int.
      NODE-INT   (return (int-literal-type (nn i)))
      NODE-FLOAT (return ty-f64)
      ; Stage 14 NS-3: a string literal now types as StrView (was CStr) — the flip.
      ; Lockstep with emit-string (nucleusc.nuc) and the gcheck / valid-walk mirrors
      ; (conventions.md node-type↔emit-node). emit-string emits only the bare GEP and
      ; returns an *unmaterialized* StrView Val (is-lit=1, val=the data ptr); the
      ; coercion chokepoints collapse it back to ptr/CStr with no IR (byte-identical)
      ; or materialize {ptr,len} for a genuine StrView target.
      NODE-STR
        ; NS-4: an explicit c"…" literal (reader set Node.i=1) types as CStr, not
        ; the StrView default — lockstep with emit-string's NS-4 short-circuit.
        (if (!= (nn i) 0) (return ty-cstr) (return (strview-type)))
      NODE-CHAR  (return ty-char)
      NODE-SYM   (return (node-type-sym n scope))
      ; Keyword literal (Stage 11 cleanup §2): its static type is the `Keyword`
      ; struct, available only when the program has (import keyword). If the struct
      ; is registered, report it so the Rung-3 cross-check at the emit site agrees
      ; with the keyword-intern call's return type; otherwise return null and let
      ; emit's own type stand (emit-keyword's synthetic call dies with a clear
      ; "undefined: keyword-intern" if the lib was not imported).
      NODE-KEYWORD
        (let (sd:?ptr:StructDef (struct-lookup-ref "Keyword"))
          (when (!= sd null) (return (type-for-sdef sd)))
          (return null))
      0)
    (when (!= (nn kind) NODE-CELL) (return ty-void))
    (when (= (node-len n) 0) (return null))
    (let (head:ptr:Node (unsafe/cast ptr:Node (node-at n 0)))
      (when (!= (head kind) NODE-SYM) (return null))
      (let (h:CStr (head s)
            hp:raw:Node head)
        (when (!= (find-macro h) null) (return null))
        ; Stage 14 MC-2: gensym yields a Node* — type it (raw Node) so it stays
        ; in lockstep with emit-list's gensym path (ty-raw-node).
        (when (= hp 'gensym) (return (ty-raw-node)))
        ; Stage 14 UN-5 / Stage 15 B2b: the bare `funcall-ptr-*` spellings do not
        ; resolve (the `unsafe` namespace is bound prefixed, never flattened), so
        ; there is nothing to refuse here either. Mirrors emit-list's routing in
        ; nucleusc.nuc — this pair is the node-type↔emit-node lockstep, and the
        ; refusals had to leave both files together or the non-emitting pass
        ; would die where codegen no longer does.
        (when (= hp 'unsafe/funcall-ptr-1) (return ty-ptr))
        (when (= hp 'unsafe/funcall-ptr-i32) (return ty-i32))
        (when (= hp 'unsafe/funcall-ptr-i64) (return ty-i64))
        (when (= hp 'unsafe/funcall-ptr-ptr) (return ty-ptr))
        (when (= hp 'return) (return ty-void))
        (when (= hp 'do)
          (if (> (node-len n) 1)
            (return (node-type (node-at n (- (node-len n) 1)) scope))
            (return ty-void)))
        (when (= hp 'let) (return (node-type-block n scope)))
        (when (= hp 'with) (return (node-type-block n scope)))
        (when (= hp 'cond) (return null))
        ; Stage 14 MC-2: plain `quote` yields a Node* — type it (raw Node), in
        ; lockstep with emit-quote (ty-raw-node). `quasiquote` stays unmodelled
        ; (null): its result type is expansion-dependent (an unquote can inject
        ; any type), so emit-qq-form's own (raw Node) type propagates.
        (when (= hp 'quote) (return (ty-raw-node)))
        (when (= hp 'quasiquote) (return null))
        (when (= hp 'while) (return ty-void))
        (when (= hp 'set!)
          (let (tgt:ptr:Node (unsafe/cast ptr:Node (node-at n 1))
                nm:ptr null  ti:ptr null)
            (split-typed (tgt s) (as ptr:ptr (addr-of nm)) (as ptr:ptr (addr-of ti)))
            (let (sym:?ptr:Sym (scope-lookup scope nm))
              (when (= sym null) (return ty-void))
              (return (sym type)))))
        (when (= hp 'inc!) (return ty-void))
        (when (= hp 'not) (return ty-i1))
        (when (= hp '_and) (return ty-i1))
        (when (= hp '_or) (return ty-i1))
        ; `unsafe/cast` types exactly as the retired bare `cast` used to.
        (when (= hp 'unsafe/cast) (return (node-type-cast n)))
        (when (= hp 'as) (return (node-type-as n)))
        (when (= hp 'addr-of) (return (node-type-addr-of n scope)))
        (when (= hp 'funcall-void) (return ty-void))
        (when (= hp 'funcall) (return (node-type-funcall n scope)))
        (when (= hp 'deref) (return (node-type-deref-elem n scope)))
        (when (= hp 'ptr-set!) (return ty-void))
        ; Stage 14 UN-5: bare `ptr+` is retired (D6); `unsafe/ptr+` mirrors what
        ; bare `ptr+` used to (lockstep).
        (when (= hp 'unsafe/ptr+) (return (node-type (node-at n 1) scope)))
        (when (= hp '_get) (return (node-type-field n scope)))
        (when (= hp '.set!) (return ty-void))
        (when (= hp 'get) (return (node-type-get n scope)))
        (when (= hp 'invoke) (return (node-type-invoke n scope)))
        ; sizeof yields a pointer-sized integer (size_t) — mirror emit-sizeof,
        ; which returns (ptr-int-type). On hosted targets ptr-int-type is ty-i64
        ; so this is byte-identical; on a 16-bit target (AVR, Stage 14 AVR-2) it
        ; is i16, keeping the node-type<->emit-node lockstep intact.
        (when (= hp 'sizeof) (return (ptr-int-type)))
        (when (= hp 'alloca) (return (node-type-alloca n)))
        ; (char "x") is sugar for the \x char literal — a Char value (S0). Must
        ; match emit-char's result type so the Rung-3 cross-check agrees.
        (when (= hp 'char) (return ty-char))
        (when (= hp 'aref) (return (node-type-deref-elem n scope)))
        (when (= hp 'aset!) (return ty-void))
        ; Stage 10: Maybe transition forms — relabelings mirror their emitters
        ; exactly; if-some/when-some are phi-shaped like cond (null = unmodeled).
        (when (or (= hp 'some) (= hp 'as-ref))
          (let (t:ptr (node-type (node-at n 1) scope))
            (when (= t null) (return null))
            (when (!= ((as ptr:Type t) kind) TY-PTR) (return null))
            (return (type-as-pkind t PTR-MAYBE))))
        (when (or (= hp 'unwrap) (= hp 'unwrap-or))
          (let (t:ptr (node-type (node-at n 1) scope))
            (when (= t null) (return null))
            ; Result operand: the ok-arm payload type (errors.md §9).
            (let (okt:?ptr:Type (result-ok-type t))
              (when (!= okt null) (return okt)))
            (when (!= (ptr-pkind t) PTR-MAYBE) (return null))
            (return (type-as-pkind t PTR-REF))))
        (when (or (= hp 'if-some) (= hp 'when-some)) (return null))
        (when (or (= hp 'err-name) (= hp 'err-message)) (return ty-cstr))
        (when (= hp 'type-token) (return ty-cstr))
        ; (signal E RepairType [detail]) yields (Maybe RepairType). stamp-maybe-type
        ; lives in union-emit.nuc (imported after generics.nuc), so this typing path
        ; calls through the g-stamp-maybe-type-hook function pointer (installed in
        ; init-blanket). N8 cross-file back-edge bridge.
        (when (= hp 'signal)
          (when (< (node-len n) 3) (return null))
          (return (funcall (unsafe/cast ((fn (ref Type)) (ptr i32)) g-stamp-maybe-type-hook)
                           (parse-type-from-node (node-at n 2) (n line))
                           (n line))))
        (when (= hp 'defer) (return ty-void))
        (when (= hp 'move) (return (node-type (node-at n 1) scope)))
        ; TC-2/TC-3: node-type-call is passed a null explicit want here, but its
        ; tier-2 fallback reads the downward want channel (g-want-type) when one
        ; is armed — i.e. during a non-emitting probe run from a let/with binding
        ; init (tc3-emit-binding-init). In every other node-type context the
        ; channel is null, so a want-dependent generic call types as null (the
        ; documented escape hatch: unknown, not divergent), same as pre-LW-2
        ; widened calls. TC-5 will distribute the want through control forms.
        (return (node-type-call n scope h null))))))

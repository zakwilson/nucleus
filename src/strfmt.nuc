; Stage 17 C1 — `fstr`, the replacement for src/format.nuc's fixed-arity
; `fmt-*` helpers.
;
;   (fstr "macro '" name "': expects " want " args, got " got)
;
; Design: design/stage17-native-strings/overview.md §2.5, phase C1.
;
; What this deletes is not typing effort but a hazard. Each `fmt-*` helper took
; exactly as many conversions as its name said, and a format string with one
; more made `snprintf` read a garbage vararg and typically segfaulted the
; compiler (context/conventions.md, "format-helper arity"). Here arity is a
; macro-expansion fact: an argument that does not conform to `ToStr` is a
; compile error at the call site, and there is no format string to miscount, no
; `%` to drop, and no fixed buffer to overrun.
;
; IT RETURNS A BARE `ptr`, deliberately and temporarily. That is the type the
; compiler's own strings still have, so the bridge is invisible to every
; consumer — `die-at`, `report-at`, `intern-str`, the emission streams — and the
; ~640 producer sites convert without moving the consumers in the same batch.
; `CStr` would be the honest type and is the wrong one here: a branch join of a
; `CStr` arm and a `ptr` arm collapses to void, so `(if c base (fstr …))` — a
; shape that occurs — would stop compiling for a reason unrelated to the change.
; When the consumers take `StrView` the cast and the `string-as-cstr` both come
; off and this becomes a plain `str-alloc`.
;
; The bytes live in the compiler's arena, so nothing is freed and the returned
; `CStr` is valid for the process. That is the same lifetime `fmt-*` had
; (`arena-strndup`), which is why no call site needs to change how it stores the
; result.

(import-use "stdio.h")
(import-use arena)
(import-use allocator)
(import-use vector)
(import-use string)
(import-use strview)
(import-use fmt)
(import-use io)
(import-use file)
(import-use intern-str)   ; Symbol's ToStr, so a name can flow into `fstr`/`emit`

; A compiler-minted name, still a bare `ptr` until C7-5 converts the producers,
; as the `Symbol` a `Node.s` (or a registry key) now wants. Every call is a site
; C7-5 deletes, so keep them greppable rather than inlining `symbol-from-cstr`.
(defn sym-of (name:ptr):Symbol
  (return (symbol-from-cstr (as CStr name))))

; The other direction, at a seam that still wants the bare `ptr` the compiler's
; names are until C7-4/C7-5 retype the registries. Same bytes and no copy — the
; interner NUL-terminates — so pointer identity survives the bridge.
(defn sym-ptr (s:Symbol):ptr
  (return (as ptr (symbol-as-cstr s))))

; The arena's own handle. A separate `defvar` from nucleusc.nuc's
; `g-arena-alloc` only because a module cannot see its importer's globals; the
; arena itself is `lib/arena.nuc`'s single process-wide one, so both handles
; allocate from the same bump pointer and neither ever frees.
(defvar g-strfmt-alloc:AllocHandle (AllocHandle ALLOC-ARENA null))

(defn strfmt-alloc ():ref:AllocHandle
  (return (addr-of g-strfmt-alloc)))

; The honest form: the length the formatting already knew, carried out with the
; bytes instead of thrown away and re-derived by a `strlen`.
(defmacro fstr (:rest parts)
  (let (s:ptr (gensym))
    `(let ((~s String) (str-alloc (strfmt-alloc) ~@parts))
       (string-as-view ~s))))

; …and the bridge, for a consumer that still wants a NUL-terminated `ptr`. Its
; call count is the C6/C7 progress number (`make strict-cstr` counts the
; `string-as-cstr` this expands to); it is deleted when that reaches zero.
(defmacro fcstr (:rest parts)
  (let (s:ptr (gensym))
    `(let ((~s String) (str-alloc (strfmt-alloc) ~@parts))
       (as ptr (string-as-cstr ~s)))))

; ---------------------------------------------------------------------------
; `emit` — Stage 17 C2's replacement for `fprintf`/`fputs`/`fputc` on the
; emission streams.
;
;   (emit g-out "  %v" n " = load " ty ", ptr %p" n ", align " al "\n")
;
; Formats into ONE process-wide buffer and issues ONE `fwrite`, so a converted
; site costs no allocation — the shape migration-tooling.md §2 sketched as
; `(write S (str …))` would have allocated and dropped a `String` at every one
; of ~945 sites on the compiler's hottest output path.
;
; The sink is still a `FILE*`: converting the call sites and flipping the stream
; globals to `(dyn Writer)` are separate steps, and this way the flip is a change
; to `emit-flush` alone rather than to every site a second time.

(defvar g-emit-buf:String)
(defvar g-emit-buf-ready:i32 0)

(defn emit-buf ():ref:String
  (when (= g-emit-buf-ready 0)
    (set! g-emit-buf (string-with-capacity 1024))
    (set! g-emit-buf-ready 1))
  (return (addr-of g-emit-buf)))

; Writes the bytes appended since `mark` and rewinds to it. The mark is what
; makes one shared buffer safe when an argument's own side effect emits: the
; inner text goes out first and the buffer is left as it was found, which is the
; order `fprintf` gave when an argument emitted.
(defn emit-flush (f:ptr (b (ref String)) mark:usize):void
  (let (v:StrView (string-as-view b)
        n:usize (v 'len))
    (when (> n mark)
      (fwrite (as ptr (unsafe/ptr+ (v 'data) (as i64 mark))) 1
              (as i64 (- n mark)) f))
    (string-truncate-unchecked b mark)))

; The same `emit` against an in-memory sink, which is what retires
; `open_memstream` (overview.md phase C3 — and with it a glibc-only function).
; An overload rather than a `(dyn Writer)` sink: the sink type is always known
; at the call site, so this dispatches statically and boxes nothing.
;
; `(raw String)` and not `(ref String)` because the emission aliases — `g-out`,
; `g-decl-out`, `g-def-stream` — are null before a module opens, exactly as the
; `FILE*`s they replace were. An owning buffer reaches it by the non-null-to-
; nullable coercion, so a call site never spells the difference.
(defn emit-flush ((f (raw String)) (b (ref String)) mark:usize):void
  (when (= f null) (return))
  (let (v:StrView (string-as-view b)
        n:usize (v 'len))
    (when (> n mark)
      (string-push-bytes-raw (unsafe/cast ref:String f)
                             (unsafe/ptr+ (v 'data) (as i64 mark)) (- n mark)))
    (string-truncate-unchecked b mark)))

; Append a whole buffer, bypassing `emit`'s staging. The function-body buffers
; are appended wholesale once per emitted function, so staging them would copy
; every byte of the module a second time.
(defn emit-all (f:ptr (src (ref String))):void
  (let (v:StrView (string-as-view src))
    (when (> (v 'len) 0)
      (fwrite (as ptr (v 'data)) 1 (as i64 (v 'len)) f))))

(defn emit-all ((f (raw String)) (src (ref String))):void
  (when (= f null) (return))
  (let (v:StrView (string-as-view src))
    (when (> (v 'len) 0)
      (string-push-bytes-raw (unsafe/cast ref:String f) (v 'data) (v 'len)))))

(defmacro emit (sink :rest parts)
  (let (b:ptr (gensym) m:ptr (gensym))
    `(let ((~b (ref String)) (emit-buf))
       (let (~m (byte-len ~b))
         (str-into ~b ~@parts)
         (emit-flush ~sink ~b ~m)))))

; ---------------------------------------------------------------------------
; The two conformances that exist only for the duration of the conversion.
; ---------------------------------------------------------------------------

; The compiler's own strings are still bare `ptr` (881 `CStr` mentions and a
; ~237-reference interned `ptr` substrate, overview.md §1.1), so a `%s` argument
; reaching `fstr` is a `ptr` far more often than a `CStr`. This conformance reads
; one as NUL-terminated, exactly as the `snprintf` it replaces did.
;
; It is deliberately in `src/`, not `lib/`: a bare `ptr` is not a string, and
; shipping "every pointer prints as text" in the standard library would turn a
; type error into silent garbage. Here the only producers are the converted
; `fmt-*` sites, whose `%s` arguments were C strings by construction — the
; specifier census over all 636 sites found no `%p` at all. **Delete this when
; the substrate becomes `StrView`/`Symbol` (phases C6–C7).**
(extend ptr ToStr)
(defn to-str (self:ptr (out (ref String))):!void
  (let (v:StrView (strview-from-cstr (as CStr self)))
    (string-push-str-unchecked out &v))
  (return (ok)))

; Zero-padded hex, the one numeric shape `%d`/`%ld` do not cover: the compiler
; prints float bit patterns as `%016lX` / `%04lX` / `%016lx` so LLVM reads them
; back exactly. A value type rather than a formatting adverb on `to-str`, since
; `ToStr` takes no options by design.
(defstruct Hex v:i64 width:i32 upper:i32)

(defn hex (v:i64 width:i32):Hex
  (let (h:&Hex (alloca Hex))
    (set! (h 'v) v) (set! (h 'width) width) (set! (h 'upper) 0)
    (return (deref h))))

(defn hexu (v:i64 width:i32):Hex
  (let (h:&Hex (alloca Hex))
    (set! (h 'v) v) (set! (h 'width) width) (set! (h 'upper) 1)
    (return (deref h))))

(extend Hex ToStr)
(defn to-str (self:Hex (out (ref String))):!void
  (let (buf:ptr:ui8 (as ptr:ui8 (alloca ui8 16))
        x:ui64 (as ui64 (self 'v))
        n:usize 0
        w:usize (as usize (self 'width)))
    ; Digits LSB-first, then the zero padding, then the digits reversed — the
    ; padding has to be emitted before them, which is why it is not one loop.
    (while (or (> x 0) (= n 0))
      (let (d:ui64 (bit-and x 15))
        (set! (aref buf (as i64 n))
          (unsafe/cast ui8 (if (< d 10) (+ (as ui64 48) d)
                             (+ (as ui64 (if (!= (self 'upper) 0) 55 87)) d))))
        (set! x (bit-shr x 4))
        (set! n (+ n 1))))
    (let (pad:usize (if (> w n) (- w n) 0))
      (while (> pad 0)
        (string-push-char out \0)
        (set! pad (- pad 1))))
    (while (> n 0)
      (set! n (- n 1))
      (string-push-char out (as Char (as ui32 (aref buf (as i64 n)))))))
  (return (ok)))

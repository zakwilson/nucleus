; Stage 17 C1 — `fstr`, the replacement for src/format.nuc's fixed-arity
; `fmt-*` helpers.
;
;   (fstr "macro '" name "': expects " want " args, got " got)
;
; Design: design/stage17-native-strings/overview.md §2.5, phase C1.
;
; What this deletes is not typing effort but a hazard. Each `fmt-*` helper took
; exactly as many conversions as its name said, and a format string with one
; more made `snprintf` read a garbage vararg and typically segfaulted the
; compiler (context/conventions.md, "format-helper arity"). Here arity is a
; macro-expansion fact: an argument that does not conform to `ToStr` is a
; compile error at the call site, and there is no format string to miscount, no
; `%` to drop, and no fixed buffer to overrun.
;
; IT RETURNS A `StrView`, AND THAT VIEW IS NOT NUL-TERMINATED. A consumer that
; needs a C string must intern it (`symbol-intern`, then `symbol-as-cstr`) —
; borrowing the view's `data` reads past the end.
;
; The bytes live in the compiler's arena, so nothing is freed and the view is
; valid for the process. That is the same lifetime `fmt-*` had (`arena-strndup`),
; which is why no call site needed to change how it stores the result.

(import-use "stdio.h")
(import-use nucleus.arena)
(import-use nucleus.create)
(import-use nucleus.allocator)
(import-use nucleus.vector)
(import-use nucleus.string)
(import-use nucleus.strview)
(import-use nucleus.fmt)
(import-use nucleus.io)
(import-use nucleus.file)
(import-use nucleus.intern-str)   ; Symbol's ToStr, so a name can flow into `fstr`/`emit`

; The honest form: the length the formatting already knew, carried out with the
; bytes instead of thrown away and re-derived by a `strlen`.
(defmacro fstr (:rest parts)
  (let (s:ptr (gensym))
    `(let ((~s String) (str-alloc g-arena ~@parts))
       (string-as-view ~s))))

; ---------------------------------------------------------------------------
; `emit` — Stage 17 C2's replacement for `fprintf`/`fputs`/`fputc` on the
; emission streams.
;
;   (emit g-out "  %v" n " = load " ty ", ptr %p" n ", align " al "\n")
;
; Formats into ONE process-wide buffer and issues ONE `fwrite`, so a converted
; site costs no allocation — the shape migration-tooling.md §2 sketched as
; `(write S (str …))` would have allocated and dropped a `String` at every one
; of ~945 sites on the compiler's hottest output path.
;
; The sink is still a `FILE*`: converting the call sites and flipping the stream
; globals to `(dyn Writer)` are separate steps, and this way the flip is a change
; to `emit-flush` alone rather than to every site a second time.

(defvar g-emit-buf:String)
(defvar g-emit-buf-ready:i32 0)

(defn emit-buf ():&String
  (when (= g-emit-buf-ready 0)
    (set! g-emit-buf (make String))
    (string-reserve &g-emit-buf 1024)
    (set! g-emit-buf-ready 1))
  (return &g-emit-buf))

; Writes the bytes appended since `mark` and rewinds to it. The mark is what
; makes one shared buffer safe when an argument's own side effect emits: the
; inner text goes out first and the buffer is left as it was found, which is the
; order `fprintf` gave when an argument emitted.
(defn emit-flush (f:ptr b:&String mark:usize):void
  (let (v:StrView (string-as-view b)
        n:usize (v 'len))
    (when (> n mark)
      (fwrite (as ptr (unsafe/ptr+ (v 'data) (as i64 mark))) 1
              (as i64 (- n mark)) f))
    (string-truncate-unchecked b mark)))

; The same `emit` against an in-memory sink, which is what retires
; `open_memstream` (overview.md phase C3 — and with it a glibc-only function).
; An overload rather than a `(dyn Writer)` sink: the sink type is always known
; at the call site, so this dispatches statically and boxes nothing.
;
; `(ptr String)` and not `(ref String)` because the emission aliases — `g-out`,
; `g-decl-out`, `g-def-stream` — are null before a module opens, exactly as the
; `FILE*`s they replace were. An owning buffer reaches it by the non-null-to-
; nullable coercion, so a call site never spells the difference.
(defn emit-flush ((f ?&String) b:&String mark:usize):void
  (when (= f null) (return))
  (let (v:StrView (string-as-view b)
        n:usize (v 'len))
    (when (> n mark)
      (string-push-bytes-raw (unsafe/cast &String f)
                             (unsafe/ptr+ (v 'data) (as i64 mark)) (- n mark)))
    (string-truncate-unchecked b mark)))

; Append a whole buffer, bypassing `emit`'s staging. The function-body buffers
; are appended wholesale once per emitted function, so staging them would copy
; every byte of the module a second time.
(defn emit-all (f:ptr src:&String):void
  (let (v:StrView (string-as-view src))
    (when (> (v 'len) 0)
      (fwrite (as ptr (v 'data)) 1 (as i64 (v 'len)) f))))

(defn emit-all (f:?&String src:&String):void
  (when (= f null) (return))
  (let (v:StrView (string-as-view src))
    (when (> (v 'len) 0)
      (string-push-bytes-raw (unsafe/cast &String f) (v 'data) (v 'len)))))

(defmacro emit (sink :rest parts)
  (let (b:ptr (gensym) m:ptr (gensym))
    `(let ((~b &String) (emit-buf))
       (let (~m (byte-len ~b))
         (str-into ~b ~@parts)
         (emit-flush ~sink ~b ~m)))))

; Zero-padded hex, the one numeric shape `%d`/`%ld` do not cover: the compiler
; prints float bit patterns as `%016lX` / `%04lX` / `%016lx` so LLVM reads them
; back exactly. A value type rather than a formatting adverb on `to-str`, since
; `ToStr` takes no options by design.
(defstruct Hex v:i64 width:i32 upper:i32)

(defn hex (v:i64 width:i32):Hex
  (let (h:&Hex (alloca Hex))
    (set! (h 'v) v) (set! (h 'width) width) (set! (h 'upper) 0)
    (return (deref h))))

(defn hexu (v:i64 width:i32):Hex
  (let (h:&Hex (alloca Hex))
    (set! (h 'v) v) (set! (h 'width) width) (set! (h 'upper) 1)
    (return (deref h))))

(extend Hex ToStr)
(defn to-str (self:Hex out:&String):!void
  (let (buf:&ui8 (as &ui8 (alloca ui8 16))
        x:ui64 (as ui64 (self 'v))
        n:usize 0
        w:usize (as usize (self 'width)))
    ; Digits LSB-first, then the zero padding, then the digits reversed — the
    ; padding has to be emitted before them, which is why it is not one loop.
    (while (or (> x 0) (= n 0))
      (let (d:ui64 (bit-and x 15))
        (set! (aref buf (as i64 n))
          (unsafe/cast ui8 (if (< d 10) (+ (as ui64 48) d)
                             (+ (as ui64 (if (!= (self 'upper) 0) 55 87)) d))))
        (set! x (bit-shr x 4))
        (set! n (+ n 1))))
    (let (pad:usize (if (> w n) (- w n) 0))
      (while (> pad 0)
        (string-push-char out \0)
        (set! pad (- pad 1))))
    (while (> n 0)
      (set! n (- n 1))
      (string-push-char out (as Char (as ui32 (aref buf (as i64 n)))))))
  (return (ok)))

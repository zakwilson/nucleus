; Type-mangling and tyvar-substitution helpers, source-imported by
; src/nucleusc.nuc BEFORE union-registry.nuc and generics.nuc. These five
; functions sit on the cross-edge of an otherwise-mutual import cycle:
; union-registry.nuc calls type-spelling/type-mangle-token/subst-tyvars-node,
; while generics.nuc calls union-registry's lookup-struct/parse-type-from-node;
; pulling these out (they need only split-colon-segments from nucleusc.nuc, via
; the whole-unit prescan) lets union-registry import before generics cleanly.
; Extracted from nucleusc.nuc → generics.nuc → here (Stage 12 N8).

(import-use hashmap)

; A short, dot-free token naming a type for use in mangled symbols. Pointers
; get a "p" prefix on their pointee so ptr:Circle and Circle stay distinct.
;
; A `StrView`: a mangled symbol is composed from several of these and interned
; once, at the end — interning each fragment would pay a hash per token for an
; identity nothing asks about.
(defn type-mangle-token (t:raw:Type):StrView
  (let (tt:raw:Type t
        k:i32 (tt 'kind))
    (case k
      TY-VOID (return "void")
      TY-BOOL (return "bool")
      TY-I8   (return "i8")
      TY-I16  (return "i16")
      TY-I32  (return "i32")
      TY-I64  (return "i64")
      TY-UI8  (return "u8")
      TY-UI16 (return "u16")
      TY-UI32 (return "u32")
      TY-UI64 (return "u64")
      TY-F32  (return "f32")
      TY-F64  (return "f64")
      TY-F16  (return "f16")
      TY-F80  (return "f80")
      TY-F128 (return "f128")
      TY-PTR
        (if (= (tt 'elem) null)
          (return "ptr")
          (return (fstr "p" (type-mangle-token (tt 'elem)))))
      ; Stage 15 B3′ (name-resolution.md §8.1 step 2): the type's `ir-name`, not
      ; its `name`. Since B3′ a namespaced type's registry key carries a `/`
      ; (`dp/Fox`), which is illegal in an LLVM symbol; `ir-name` is the same
      ; string composed through the defining namespace's ir-prefix (`dp__Fox`),
      ; computed once at registration. `ir-name == name` for every `user` type,
      ; so every mangled symbol in this compiler and in `lib/` is unchanged.
      (:or TY-STRUCT TY-UNION)
        (return (symbol-as-view (-> tt (_ 'sdef) (unsafe/cast &StructDef _) (_ 'ir-name))))
      TY-FN (return "fn")
      TY-CSTR (return "cstr")
      TY-CHAR (return "Char")
      TY-ERR   (return "Err")
      TY-USIZE (return "usize")
      TY-SSIZE (return "ssize")
      ; Stage 15 W8 G-2: `a<N>_<elem>` — a token legal in an LLVM symbol name and
      ; distinct per length, so two array shapes can never collide. Unreachable
      ; today (an array cannot be a parameter or a generic argument), but the
      ; fall-through "x" would have collided with every other unmodelled kind.
      TY-ARRAY (return (fstr "a" (tt 'arr-len) "_" (type-mangle-token (tt 'elem))))
      (return "x"))))

; ============================================================
; Stage 13 L7 — distinct, round-trippable spelling for TY-FN.
; ============================================================
; type-spelling previously collapsed every function-pointer (TY-FN) to "ptr" —
; colliding with raw pointers and indistinguishable across signatures — which is
; lossy under the colon-based spelling/substitution system (it cannot encode a
; function signature). That blocks a bare `fn` from flowing through a generic
; combinator: the combinator's `(ref G)` binds G to the fn's type, the stamped
; body substitutes G's spelling into `(ref <spelling>)`, and "ptr" re-parses to
; a raw pointer, losing the fn-ness so the forwarding call can't be rebuilt.
;
; Each distinct TY-FN Type* object is assigned a stable name "__fnty_<id>",
; resolved back to the original Type* by parse-type-name (union-registry.nuc).
; Pointer-identity keying suffices: the fn value and the combinator's bound
; tyvar carry the SAME Type* object, so both spell to one name and round-trip.
; IR mangling (type-mangle-token -> "fn") and aggregate-ABI/cheader emission
; (type-to-ir -> "ptr") are untouched, so the bootstrap stays byte-identical
; (no TY-FN flows through a generic in the compiler's own source: `make
; bootstrap` re-converges with this change).
(defvar g-fnty-id:i32 0)
(defvar g-fnty:&(HashMap Symbol &Type) (hashmap-new-in &g-arena-alloc))

(defn fnty-intern (t:&Type):Symbol
  (doseq (entry g-fnty (HashMapEntryIter Symbol &Type))
         (when (= (&entry 'val)
                  t)
               (return (&entry 'key))))
  (let (name:Symbol (symbol-intern (fstr "__fnty_" g-fnty-id)))
    (inc! g-fnty-id)
    (assoc g-fnty name t)
    (return name)))

; Resolve a "__fnty_<id>" name back to its Type*, so a stamped generic body's
; `(ref __fnty_3)` re-parses to the original TY-FN. Identity, not a string
; compare: the name reaching here is interned, as every registry key now is.
(defn fnty-resolve (name:Symbol):?&Type
  (get g-fnty name))

; A type's source spelling as a colon-joined string: the inverse of the type
; parser. Serves two roles — the key into the conformance registry (matching the
; subject spelling of `extend`), and the replacement text when substituting a
; concrete type for a type variable's occurrences in a retained generic body.
; Pointers nest as ptr:elem; structs/primitives are their bare names. A TY-FN
; spells to its interned "__fnty_N" name (above), not "ptr".
(defn type-spelling (t:raw:Type):Symbol
  (let (tt:raw:Type t
        k:i32 (tt 'kind))
    (case k
      TY-VOID (return (symbol-intern "void"))
      TY-BOOL (return (symbol-intern "bool"))
      TY-I8   (return (symbol-intern "i8"))
      TY-I16  (return (symbol-intern "i16"))
      TY-I32  (return (symbol-intern "i32"))
      TY-I64  (return (symbol-intern "i64"))
      TY-UI8  (return (symbol-intern "ui8"))
      TY-UI16 (return (symbol-intern "ui16"))
      TY-UI32 (return (symbol-intern "ui32"))
      TY-UI64 (return (symbol-intern "ui64"))
      TY-F32  (return (symbol-intern "f32"))
      TY-F64  (return (symbol-intern "f64"))
      TY-F16  (return (symbol-intern "f16"))
      TY-F80  (return (symbol-intern "f80"))
      TY-F128 (return (symbol-intern "f128"))
      (:or TY-STRUCT TY-UNION)
                (return (-> tt (_ 'sdef) (unsafe/cast &StructDef _) (_ 'name)))
      TY-CSTR  (return (symbol-intern "CStr"))
      TY-CHAR  (return (symbol-intern "Char"))
      TY-ERR   (return (symbol-intern "Err"))
      TY-USIZE (return (symbol-intern "usize"))
      TY-SSIZE (return (symbol-intern "ssize"))
      ; t is provably non-null here (its `kind` was already read above), so
      ; asserting ref is sound — fnty-intern keys its HashMap by Type* identity.
      TY-FN
        (return (fnty-intern (unsafe/cast &Type t)))
      TY-PTR
        (if (= (tt 'elem) null)
          (return (symbol-intern "ptr"))
          (return (symbol-intern (fstr "ptr:" (type-spelling (tt 'elem))))))
      ; Stage 15 W8 G-2. This spelling is DIAGNOSTIC-ONLY and deliberately not
      ; round-trippable through parse-type-name: type-spelling's round-trip
      ; contract exists for conformance keys and generic substitution, and an
      ; array can be neither (it is refused in every position a tyvar or an
      ; `extend` subject can occupy). Rendering the honest source spelling beats
      ; the old fall-through, which called every array "ptr".
      TY-ARRAY
        (return (symbol-intern (fstr "(array " (type-spelling (tt 'elem)) " " (tt 'arr-len) ")")))
      (return (symbol-intern "ptr")))))

(defn tyvar-index-of (name:Symbol tyvars:ptr ntv:i32):i32
  (dotimes (i ntv)
    (when (= (aref (as &Symbol tyvars) i) name) (return i)))
  (return -1))

; Substitute type variables inside one symbol's colon spelling: split on ':',
; replace any segment that names a tyvar with that tyvar's concrete spelling,
; rejoin. Handles both desugared standalone type symbols ("T" → "i32") and the
; colon-typed symbols left in un-desugared bodies ("r:T" → "r:i32",
; "x:ptr:T" → "x:ptr:Circle").
(defn subst-tyvars-sym (s:Symbol tyvars:ptr spellings:ptr ntv:i32 line:i32):Symbol
  (when (= (symbol-contains-byte s 58) false)
    (return (subst-tyvar-segment s tyvars spellings ntv)))
  (let (segs:ptr (split-colon-segments s line)
        acc:String (string-new)
        any:i32 0)
    (dotimes (i (node-len segs))
      (let (e:raw:Node (as raw:Node (node-at segs i))
            seg:Symbol ((unsafe/cast &Node e) 's)
            piece:Symbol (subst-tyvar-segment seg tyvars spellings ntv))
        (when (!= any 0) (str-into &acc ":"))
        (str-into &acc piece)
        (set! any 1)))
    (when (= any 0) (return s))
    (return (symbol-intern (string-as-view &acc)))))

; One colon segment. PK-4b: a leading `?`/`!` run is a wrapper over the name,
; so `?E` substitutes as `?` + E's spelling — the tyvar table holds no sigils.
(defn subst-tyvar-segment (seg:Symbol tyvars:ptr spellings:ptr ntv:i32):Symbol
  (let (idx:i32 (tyvar-index-of seg tyvars ntv))
    (when (>= idx 0) (return (aref (as &Symbol spellings) idx)))
    (let (run:usize (type-sigil-run seg))
      (when (or (= run 0) (= run (symbol-len seg))) (return seg))
      (let (sv:StrView (symbol-as-view seg)
            inner:i32 (tyvar-index-of (symbol-intern (strview-drop-bytes sv run)) tyvars ntv))
        (when (< inner 0) (return seg))
        (return (symbol-intern (fstr (strview-take-bytes sv run)
                                     (aref (as &Symbol spellings) inner))))))))

; Deep-copy a node, substituting type variables (by colon-spelling) in every
; symbol. Used to stamp a concrete instance from a generic template.
(defn subst-tyvars-node (node:raw:Node tyvars:ptr spellings:ptr ntv:i32):raw:Node
  (when (= node null) (return null))
  (let (n:raw:Node node)
    (case (n 'kind)
      NODE-SYM
        (let (ns:Symbol (subst-tyvars-sym (n 's) tyvars spellings ntv (n 'line)))
          (when (= ns (n 's)) (return node))
          (let (new:ptr:Node (as &Node (alloc-node)))
            (set! (new 'kind) NODE-SYM)
            (set! (new 'line) (n 'line))
            (set! (new 's) ns)
            (return new)))
      ; Stage 14 defn-signature.md S1: a new-style return type rides in a
      ; NODE-KEYWORD (`:T`, `:ptr:T`) at the head of the stamped body tail. Substitute
      ; its colon-spelling like a symbol but keep it a keyword so fn-parse-ret-type
      ; re-reads the stamped return correctly. A value keyword whose spelling names no
      ; tyvar is returned unchanged (subst-tyvars-sym is identity), so legacy bodies
      ; are unaffected.
      NODE-KEYWORD
        (let (ns:Symbol (subst-tyvars-sym (n 's) tyvars spellings ntv (n 'line)))
          (when (= ns (n 's)) (return node))
          (let (new:ptr:Node (as &Node (alloc-node)))
            (set! (new 'kind) NODE-KEYWORD)
            (set! (new 'line) (n 'line))
            (set! (new 's) ns)
            (return new)))
      NODE-LIST
        (return (node-cons (subst-tyvars-node (node-first n) tyvars spellings ntv)
                  (subst-tyvars-node (node-rest n) tyvars spellings ntv) (n 'line)))
      (return node))))

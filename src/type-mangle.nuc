; Type-mangling and tyvar-substitution helpers, source-imported by
; src/nucleusc.nuc BEFORE union-registry.nuc and generics.nuc. These five
; functions sit on the cross-edge of an otherwise-mutual import cycle:
; union-registry.nuc calls type-spelling/type-mangle-token/subst-tyvars-node,
; while generics.nuc calls union-registry's lookup-struct/parse-type-from-node;
; pulling these out (they need only split-colon-segments from nucleusc.nuc, via
; the whole-unit prescan) lets union-registry import before generics cleanly.
; Extracted from nucleusc.nuc → generics.nuc → here (Stage 12 N8).

(import-use list)
(import-use hashmap)

; A short, dot-free token naming a type for use in mangled symbols. Pointers
; get a "p" prefix on their pointee so ptr:Circle and Circle stay distinct.
(defn type-mangle-token (t:raw:Type):CStr
  (let (tt:raw:Type t
        k:i32 (tt kind))
    (case k
      TY-VOID (return "void")
      TY-I1   (return "i1")
      TY-I8   (return "i8")
      TY-I16  (return "i16")
      TY-I32  (return "i32")
      TY-I64  (return "i64")
      TY-UI8  (return "u8")
      TY-UI16 (return "u16")
      TY-UI32 (return "u32")
      TY-UI64 (return "u64")
      TY-F32  (return "f32")
      TY-F64  (return "f64")
      TY-PTR
        (if (= (tt elem) null)
          (return "ptr")
          (return (fmt-s "p%s" (type-mangle-token (tt elem)))))
      TY-STRUCT
        (return (-> tt (_ sdef) (cast ptr:StructDef _) (_ name)))
      TY-UNION
        (return (-> tt (_ sdef) (cast ptr:StructDef _) (_ name)))
      TY-FN (return "fn")
      TY-CSTR (return "cstr")
      TY-CHAR (return "Char")
      TY-ERR   (return "Err")
      TY-USIZE (return "usize")
      TY-SSIZE (return "ssize")
      (return "x"))))

; ============================================================
; Stage 13 L7 — distinct, round-trippable spelling for TY-FN.
; ============================================================
; type-spelling previously collapsed every function-pointer (TY-FN) to "ptr" —
; colliding with raw pointers and indistinguishable across signatures — which is
; lossy under the colon-based spelling/substitution system (it cannot encode a
; function signature). That blocks a bare `fn` from flowing through a generic
; combinator: the combinator's `(ref G)` binds G to the fn's type, the stamped
; body substitutes G's spelling into `(ref <spelling>)`, and "ptr" re-parses to
; a raw pointer, losing the fn-ness so the forwarding call can't be rebuilt.
;
; Each distinct TY-FN Type* object is assigned a stable name "__fnty_<id>",
; resolved back to the original Type* by parse-type-name (union-registry.nuc).
; Pointer-identity keying suffices: the fn value and the combinator's bound
; tyvar carry the SAME Type* object, so both spell to one name and round-trip.
; IR mangling (type-mangle-token -> "fn") and aggregate-ABI/cheader emission
; (type-to-ir -> "ptr") are untouched, so the bootstrap stays byte-identical
; (no TY-FN flows through a generic in the compiler's own source: `make
; bootstrap` re-converges with this change).
(defvar g-fnty-id:i32 0)
(defvar (g-fnty (ref (HashMap CStr ref:Type))))

(defn fnty-intern (t:ref:Type):CStr
  (doseq (entry g-fnty (HashMapEntryIter CStr ref:Type))
         (when (= ((addr-of entry) val)
                  t)
               (return ((addr-of entry) key))))
  (let (name:CStr (intern-str (fmt-i32 "__fnty_%d" g-fnty-id)))
    (inc! g-fnty-id)
    (assoc g-fnty name t)
    (return name)))

; Resolve a "__fnty_<id>" name back to its Type*, so a stamped generic body's
; `(ref __fnty_3)` re-parses to the original TY-FN. String compare (the name
; reaching here may be a fresh fmt copy, not the cached interned pointer).
(defn fnty-resolve (name:CStr):?ref:Type
  (get g-fnty (cast CStr name)))

; A type's source spelling as a colon-joined string: the inverse of the type
; parser. Serves two roles — the key into the conformance registry (matching the
; subject spelling of `extend`), and the replacement text when substituting a
; concrete type for a type variable's occurrences in a retained generic body.
; Pointers nest as ptr:elem; structs/primitives are their bare names. A TY-FN
; spells to its interned "__fnty_N" name (above), not "ptr".
(defn type-spelling (t:raw:Type):CStr
  (let (tt:raw:Type t
        k:i32 (tt kind))
    (case k
      TY-VOID (return "void")
      TY-I1   (return "i1")
      TY-I8   (return "i8")
      TY-I16  (return "i16")
      TY-I32  (return "i32")
      TY-I64  (return "i64")
      TY-UI8  (return "ui8")
      TY-UI16 (return "ui16")
      TY-UI32 (return "ui32")
      TY-UI64 (return "ui64")
      TY-F32  (return "f32")
      TY-F64  (return "f64")
      TY-STRUCT (return (-> tt (_ sdef) (cast ptr:StructDef _) (_ name)))
      TY-UNION  (return (-> tt (_ sdef) (cast ptr:StructDef _) (_ name)))
      TY-CSTR  (return "CStr")
      TY-CHAR  (return "Char")
      TY-ERR   (return "Err")
      TY-USIZE (return "usize")
      TY-SSIZE (return "ssize")
      ; t is provably non-null here (its `kind` was already read above), so
      ; asserting ref is sound — fnty-intern keys its HashMap by Type* identity.
      TY-FN
        (return (fnty-intern (cast ref:Type t)))
      TY-PTR
        (if (= (tt elem) null)
          (return "ptr")
          (return (fmt-s "ptr:%s" (type-spelling (tt elem)))))
      (return "ptr"))))

(defn tyvar-index-of (name:CStr tyvars:ptr ntv:i32):i32
  (dotimes (i ntv)
    (when (= (aref (cast ptr:ptr tyvars) i) name) (return i)))
  (return -1))

; Substitute type variables inside one symbol's colon spelling: split on ':',
; replace any segment that names a tyvar with that tyvar's concrete spelling,
; rejoin. Handles both desugared standalone type symbols ("T" → "i32") and the
; colon-typed symbols left in un-desugared bodies ("r:T" → "r:i32",
; "x:ptr:T" → "x:ptr:Circle").
(defn subst-tyvars-sym (s:CStr tyvars:ptr spellings:ptr ntv:i32 line:i32):CStr
  (when (= (strchr s 58) null)
    (let (idx:i32 (tyvar-index-of s tyvars ntv))
      (when (>= idx 0) (return (aref (cast ptr:ptr spellings) idx)))
      (return s)))
  (let (segs:ptr (split-colon-segments s line)
        acc:ptr null)
    (let (it:ListIter (list-iter segs))
      (doseq-iter (e (addr-of it))
        (let (seg:ptr ((cast ptr:Node e) s)
              idx:i32 (tyvar-index-of seg tyvars ntv)
              piece:ptr (if (>= idx 0) (aref (cast ptr:ptr spellings) idx) seg))
          (if (= acc null) (set! acc piece) (set! acc (fmt-2s "%s:%s" acc piece))))))
    (when (= acc null) (return s))
    (return acc)))

; Deep-copy a node, substituting type variables (by colon-spelling) in every
; symbol. Used to stamp a concrete instance from a generic template.
(defn subst-tyvars-node (node:raw:Node tyvars:ptr spellings:ptr ntv:i32):raw:Node
  (when (= node null) (return null))
  (let (n:raw:Node node)
    (case (n kind)
      NODE-SYM
        (let (ns:ptr (subst-tyvars-sym (n s) tyvars spellings ntv (n line)))
          (when (= ns (n s)) (return node))
          (let (new:ptr:Node (cast ptr:Node (alloc-node)))
            (.set! new kind NODE-SYM)
            (.set! new line (n line))
            (.set! new s ns)
            (return new)))
      ; Stage 14 defn-signature.md S1: a new-style return type rides in a
      ; NODE-KEYWORD (`:T`, `:ptr:T`) at the head of the stamped body tail. Substitute
      ; its colon-spelling like a symbol but keep it a keyword so fn-parse-ret-type
      ; re-reads the stamped return correctly. A value keyword whose spelling names no
      ; tyvar is returned unchanged (subst-tyvars-sym is identity), so legacy bodies
      ; are unaffected.
      NODE-KEYWORD
        (let (ns:ptr (subst-tyvars-sym (n s) tyvars spellings ntv (n line)))
          (when (= ns (n s)) (return node))
          (let (new:ptr:Node (cast ptr:Node (alloc-node)))
            (.set! new kind NODE-KEYWORD)
            (.set! new line (n line))
            (.set! new s ns)
            (return new)))
      NODE-CELL
        (return (make-cell (subst-tyvars-node (n car) tyvars spellings ntv)
                           (subst-tyvars-node (n cdr) tyvars spellings ntv)
                           (n line)))
      (return node))))

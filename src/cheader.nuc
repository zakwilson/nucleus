; C header handling — extracted from src/nucleusc.nuc.
;
; Provides:
;   * (import-use "foo.h") / (import "foo.h" prefix) — preprocess a C header
;     via clang -E and register its extern function declarations with the compiler.
;   * --emit-cheader output — write a C header (.h) describing the current
;     translation unit's defstruct/defn/defconst/defenum forms.
;
; Source-imported by src/nucleusc.nuc.

; ============================================================
; popen/pclose FFI (used by read-pipe-output)
; ============================================================

(declare popen (cmd:ptr mode:ptr):ptr)
(declare pclose (stream:ptr):i32)

; Stage 10 Phase F1: well-known libc functions that never return. A C header
; carries no nullability/noreturn metadata we trust (the parser even discards
; __attribute__((noreturn))), so recognize the standard noreturn libc functions
; by name. A statement-position call to one terminates its block, so a
; (when (= x null) (exit 1)) / (abort) guard narrows the tested binding past it.
(defn c-fn-noreturn (fname:CStr):i32
  (when (or (= fname "exit") (= fname "abort")) (return 1))
  (when (or (= fname "_exit") (= fname "_Exit")) (return 1))
  (when (or (= fname "quick_exit") (= fname "abort_handler_s")) (return 1))
  (when (or (= fname "longjmp") (= fname "siglongjmp")) (return 1))
  (return 0))

; ============================================================
; C header parsing (clang -E)
; ============================================================

; Stage 15 W3a: provenance of the declaration currently being parsed, so a
; diagnostic about an opaque type can name the *header* and line it was declared
; on rather than the .nuc file that imported it (g-source-path). clang -E keeps
; `# <line> "<file>"` linemarkers in its output; emit-c-include records the most
; recent one and the buffer offset just past it, and cheader-line-at recovers a
; line by counting the newlines in between. Best effort by construction (a
; linemarker inside a struct body is not re-read), which is the right bar for a
; provenance note — it is never used to make a decision.
; (Set at the top of emit-c-include, before any declaration is parsed; a global
; string *initializer* would have to be an LLVM constant, so it is assigned
; there rather than here.)
(defvar g-cheader-file:CStr)
(defvar g-cheader-dline:i32 1)
(defvar g-cheader-dpos:i64 0)

; Stage 15 W3b: set by c-parse-type when it meets a by-value aggregate it has no
; layout for, cleared per declaration by c-parse-func-decl (which is what makes
; it declaration-scoped). A global rather than an out parameter because
; c-parse-type has six call sites across three parse paths and only the
; function-declaration path acts on it. Declared here, above c-parse-type, since
; a global must be defined before the first form that references it.
(defvar g-cheader-unrep:i32 0)

; Stage 15 W3c: *why* the flag above is set, so the skip warning names the
; offending type rather than a single catch-all sentence. Only meaningful while
; g-cheader-unrep is non-zero; every site that raises the flag sets this in the
; same breath (cheader-mark-unrep), and the accumulating caller
; (c-parse-func-decl) copies the FIRST reason it sees into a local, so a later
; parameter whose flag is subsequently cleared cannot rewrite the message.
(defvar g-cheader-unrep-why:ptr)
; W3c: 1 when the reason is "Nucleus has no type this wide/shaped" rather than
; "the importer could not read the header" — see cheader-record-skip for why the
; two are reported differently.
(defvar g-cheader-unrep-quiet:i32 0)

(defn cheader-mark-unrep (why:ptr quiet:i32):void
  (set! g-cheader-unrep 1)
  (set! g-cheader-unrep-why why)
  (set! g-cheader-unrep-quiet quiet))

; ============================================================
; Stage 15 W3c: the C typedef table (cheader.md §1.4)
;
; Before this, `c-parse-type` resolved every name it did not recognize as a
; builtin to `ptr`, so EVERY scalar typedef degraded — `off_t f(int)` imported as
; `declare ptr @f(i32)`, and so did SDL's `Uint8`/`Uint32` and even a one-level
; `typedef int myint;`. Only `size_t`/`ssize_t` resolved, and only because
; c-type-to-nucleus hardcodes those two names.
;
; A typedef is resolved ONCE, at the point its `typedef` declaration is parsed,
; and the table stores the *resolved* Type. Two consequences are worth keeping:
;
;   * A chain (`off_t` → `__off_t` → `long int`) costs one lookup at each use,
;     not a walk — the intermediate entry was already collapsed.
;   * A cycle is impossible by construction. A name can only ever resolve against
;     entries recorded strictly before it, so a malformed `typedef foo foo;`
;     records `foo` as unrepresentable instead of looping forever.
;
; A record whose `car` is null means "this is a real C type name and we cannot
; represent it" (an array typedef, a typedef of an unparsable aggregate). That is
; deliberately distinct from an *absent* record: a by-value use of either is
; refused, but the messages differ, and only the recorded form proves the name
; was declared rather than merely unknown.
;
; The record reuses a Node cell, exactly as the import lists and the
; preprocessed-text cache do: `s` = the typedef name, `car` = the resolved Type*
; (or null), `cdr` = the next entry.
; ============================================================
(defvar (g-cheader-typedefs (raw Node)))

(defn c-typedef-find (name:CStr):(raw Node)
  (let (cur:ptr g-cheader-typedefs)
    (while (!= cur null)
      (let (e:ptr:Node (unsafe/cast ptr:Node cur))
        (when (= (as CStr (e s)) name) (return (as raw:Node e)))
        (set! cur (e cdr)))))
  (return null))

; Record `name` as resolving to `ty` (null = known but not representable).
; Idempotent: a header imported twice, or included transitively by two headers,
; re-declares the same typedef and must not grow the table without bound.
(defn c-typedef-record (name:ptr ty:ptr):void
  (when (!= (c-typedef-find (as CStr name)) null) (return))
  (let (n:ref:Node (new Node))
    (.set! n kind NODE-STR)
    (.set! n line 0)
    (.set! n s (intern-str name))
    (.set! n car ty)
    (.set! n cdr g-cheader-typedefs)
    (set! g-cheader-typedefs (as raw:Node n))))

; ============================================================
; Stage 15 W3c: declaration precedence (cheader.md §1.4)
;
; **An explicit `(declare …)` wins over a header-derived declaration of the same
; function, regardless of which comes first in the file, and a signature
; mismatch warns naming both sources.**
;
; Measured before the rule existed, both orders were silent and they disagreed
; with each other:
;
;   (declare lseek (fd:i32 off:i64 whence:i32):i64)   ; -> declare i64 @lseek(i32, i64, i32)
;   (import-use "unistd.h")                           ;    the header's copy is dropped
;
;   (import-use "unistd.h")                           ; -> declare ptr @lseek(i32, ptr, i32)
;   (declare lseek (fd:i32 off:i64 whence:i32):i64)   ;    the USER's copy is dropped
;
; i.e. *first* wins, not "last wins" as the spec supposed — but the second
; ordering is the dangerous one either way: the user wrote an explicit, correct
; declaration and the header quietly replaced it, which is precisely how §1.4
; cost a debugging session.
;
; Order-independence needs the explicit names known *before* any import runs, so
; `prescan-explicit-declares` collects them from the unit's top-level forms in
; `emit-toplevel-forms`, beside the other prescans. A header declaration whose
; name is on that list is then never registered and never emitted: exactly one
; `declare` reaches the IR (LLVM rejects a second one for the same symbol even
; when the two agree), and it is the user's.
;
; Scope: the list is per-compilation and is fed by every `.nuc` unit's own
; prescan, so a source-imported library's declares also outrank a header import
; that follows them. A `declare` arriving from a `.nuch` header is not on the
; list (its forms are read during emission, too late to precede a C import) and
; keeps the previous first-wins behaviour.
; ============================================================

; One declaration site — either the unit's explicit `declare` (file/line in the
; .nuc source, `sig` filled in when it is emitted) or a suppressed header-derived
; one (file/line in the C header, `sig` known immediately).
;
; `name`/`file`/`sig` are `ptr`, not `CStr`: `sig` is null-checked (an explicit
; declare's signature is unknown until it is emitted) and a `CStr` operand would
; lower that guard to `strcmp(sig, null)` — the crash conventions.md records.
(defstruct CDeclSite
  name:ptr
  file:ptr
  line:i32
  sig:ptr
  warned:i32
  ; The explicit `(declare …)` form itself, so a header import that stands down
  ; for this name can emit it *there* rather than leaving the name undefined
  ; between the import and the declare's own position (see
  ; cheader-yield-to-explicit-declare). Null on a shadow entry.
  (form (raw Node))
  (next (raw CDeclSite)))

(defvar (g-explicit-declares (raw CDeclSite)))
(defvar (g-cheader-shadowed (raw CDeclSite)))

(defn cdecl-site-find (list:(raw CDeclSite) fname:CStr):(raw CDeclSite)
  (let (cur:ptr list)
    (while (!= cur null)
      (let (e:ptr:CDeclSite (as ptr:CDeclSite cur))
        (when (= (as CStr (e name)) fname) (return (as raw:CDeclSite e)))
        (set! cur (e next)))))
  (return null))

(defn cheader-explicit-declare-site (fname:CStr):(raw CDeclSite)
  (return (cdecl-site-find g-explicit-declares fname)))

; Render a function signature the way its `declare` line reads — `i64 (i32, i64,
; i32)`, `void (ptr, ...)`. Two declarations that render identically are
; ABI-identical, which is exactly the equivalence the precedence rule needs; and
; the rendering is what the conflict warning shows, so the user sees the two
; signatures side by side rather than being told only that they differ.
(defn c-fn-sig-render (ret:raw:Type ptypes:ptr np:i32 variadic:i32):ptr
  (let (acc:ptr (fmt-s "%s (" (type-to-ir (as ptr ret))))
    (dotimes (i:i32 np)
      (when (!= i 0) (set! acc (fmt-s "%s, " acc)))
      (set! acc (fmt-2s "%s%s" acc (type-to-ir (aref (as ptr:ptr ptypes) i)))))
    (when (!= variadic 0)
      (if (= np 0)
        (set! acc (fmt-s "%s..." acc))
        (set! acc (fmt-s "%s, ..." acc))))
    (return (fmt-s "%s)" acc))))

(defn cdecl-site-push (list:(raw CDeclSite) fname:ptr file:ptr line:i32
                       sig:ptr form:(raw Node)):(raw CDeclSite)
  (let (e:ptr:CDeclSite (new CDeclSite))
    (.set! e name (intern-str fname))
    (.set! e file file)
    (.set! e line line)
    (.set! e sig sig)
    (.set! e warned 0)
    (.set! e form form)
    (.set! e next list)
    (return (as raw:CDeclSite e))))

; `<nuc file>:<line>: warning: …` — blamed on the *explicit* declaration, which
; is the one the author can act on, and naming the header declaration it
; overrides. Deduplicated on the site: a C header import is deliberately not
; deduplicated, so without this a conflict warns once per import of the header.
(defn cheader-warn-decl-conflict (site:(raw CDeclSite) hdr:(raw CDeclSite)):void
  (when (or (= (as ptr site) null) (= (as ptr hdr) null)) (return))
  (let (s:ptr:CDeclSite (unsafe/cast ptr:CDeclSite site)
        h:ptr:CDeclSite (unsafe/cast ptr:CDeclSite hdr))
    (when (!= (s warned) 0) (return))
    (.set! s warned 1)
    (let (hloc:ptr (fmt-sd "%s:%d" (h file) (h line))
          lead:ptr (fmt-3s "declaration of '%s' as %s conflicts with %s"
                           (s name) (s sig) hloc)
          full:ptr (fmt-2s "%s, which declares it as %s; the explicit declaration wins"
                           lead (h sig)))
      (fprintf stderr "%s:%d: warning: %s\n" (s file) (s line) full))))

; Collect every top-level `(declare NAME …)` in this unit. Runs with the other
; prescans in emit-toplevel-forms — i.e. before ANY import of this unit is
; processed — which is what makes the precedence rule order-independent.
(defn prescan-explicit-declares (forms:(raw Node)):void
  (let (fc:ptr forms)
    (while (!= fc null)
      (let (f:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node fc) car)))
        (when (and (!= (as ptr f) null)
                   (= (f kind) NODE-CELL)
                   (>= (node-len (as ptr f)) 2)
                   (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind) (= _ NODE-SYM))
                   (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ s) (= _ "declare")))
          (let (nn:ptr:Node (unsafe/cast ptr:Node (node-at (as ptr f) 1)))
            (when (and (= (nn kind) NODE-SYM)
                       (= (as ptr (cheader-explicit-declare-site (as CStr (nn s)))) null))
              (set! g-explicit-declares
                    (cdecl-site-push g-explicit-declares (nn s)
                                     g-source-path (f line) null
                                     (as raw:Node f)))))))
      (set! fc ((unsafe/cast ptr:Node fc) cdr)))))

; The source line of buffer offset `pos`, per the last recorded linemarker.
(defn cheader-line-at (buf:ptr pos:i64):i32
  (let (n:i32 g-cheader-dline
        i:i64 g-cheader-dpos)
    (while (< i pos)
      (when (= (char-at buf i) 10) (inc! n))
      (set! i (+ i 1)))
    (return n)))

; Record a `# <line> "<file>"` linemarker occupying [pos, nl-end). `nl-end` is
; the offset of the first character of the following line.
(defn cheader-note-linemarker (buf:ptr pos:i64 nl-end:i64 len:i64):void
  (let (p:i64 (+ pos 1))
    ; digits (the line number of the NEXT line)
    (set! p (c-skip-ws buf p len))
    (let (start:i64 p
          v:i32 0)
      (while (and (< p nl-end) (!= (isdigit (as i32 (char-at buf p))) 0))
        (set! v (+ (* v 10) (- (as i32 (char-at buf p)) 48)))
        (set! p (+ p 1)))
      ; A `#pragma`/`#ident` line (no digits) carries no position information.
      (when (= p start) (return))
      (set! g-cheader-dline v)
      (set! g-cheader-dpos nl-end)
      ; optional "file"
      (set! p (c-skip-ws buf p len))
      (when (and (< p nl-end) (= (char-at buf p) 34))
        (set! p (+ p 1))
        (let (fstart:i64 p)
          (while (and (< p nl-end) (!= (char-at buf p) 34))
            (set! p (+ p 1)))
          (set! g-cheader-file (arena-strndup (unsafe/ptr+ (as ptr:i8 buf) fstart)
                                              (- p fstart))))))))

; Skip whitespace in buffer, returning new position.
(defn c-skip-ws (buf:ptr pos:i64 len:i64):i64
  (while (and (< pos len) (!= (isspace (as i32 (char-at buf pos))) 0))
    (set! pos (+ pos 1)))
  (return pos))

; Read a C identifier or keyword from buffer. Returns the token as a string.
; Sets out-end to the position after the token.
(defn c-read-ident (buf:ptr pos:i64 len:i64 out-end:ptr:i64):ptr
  (let (start:i64 pos)
    (while (and (< pos len)
                (or (!= (isdigit (as i32 (char-at buf pos))) 0)
                    (or (and (>= (as i32 (char-at buf pos)) 65)
                             (<= (as i32 (char-at buf pos)) 90))
                        (or (and (>= (as i32 (char-at buf pos)) 97)
                                 (<= (as i32 (char-at buf pos)) 122))
                            (= (as i32 (char-at buf pos)) 95)))))
      (set! pos (+ pos 1)))
    (ptr-set! out-end pos)
    (return (arena-strndup (unsafe/ptr+ (as ptr:i8 buf) start) (- pos start)))))

; Map a C type name to a Nucleus type.
; Returns the Type* or null if unknown/skipped.
(defn c-type-to-nucleus (name:CStr is-unsigned:i32 is-long:i32 is-short:i32):(raw Type)
  ; Handle base types
  (when (= name "void")  (return ty-void))
  (when (= name "_Bool") (return ty-i1))
  (when (= name "char")
    (if (!= is-unsigned 0) (return ty-ui8) (return ty-i8)))
  (when (= name "short")
    (if (!= is-unsigned 0) (return ty-ui16) (return ty-i16)))
  (when (or (= name "int") (= name "long"))
    (when (!= is-short 0)
      (if (!= is-unsigned 0) (return ty-ui16) (return ty-i16)))
    ; A "long" base implies at least one `long` specifier.
    (let (lc:i32 is-long)
      (when (and (= name "long") (< lc 1)) (set! lc 1))
      (when (>= lc 2)   ; long long — always 64-bit
        (if (!= is-unsigned 0) (return ty-ui64) (return ty-i64)))
      (when (= lc 1)    ; long — depends on the target's data model
        (if (= (target-long-size) 8)
          (if (!= is-unsigned 0) (return ty-ui64) (return ty-i64))
          (if (!= is-unsigned 0) (return ty-ui32) (return ty-i32)))))
    (if (!= is-unsigned 0) (return ty-ui32) (return ty-i32)))
  (when (= name "float")  (return ty-f32))
  (when (= name "double")
    ; `long double` is platform-specific (80-bit on x86-64) — skip.
    (when (!= is-long 0) (return null))
    (return ty-f64))
  ; size_t, ssize_t
  (when (= name "size_t") (return ty-ui64))
  (when (= name "ssize_t") (return ty-i64))
  ; __gnuc_va_list / va_list — treat as ptr
  (when (= name "__gnuc_va_list") (return ty-ptr))
  (when (= name "va_list") (return ty-ptr))
  ; FILE* — opaque struct, treated as ptr
  (when (= name "FILE") (return ty-ptr))
  ; Fallback: if unknown, return ptr
  (return null))

; Skip balanced parentheses in __attribute__((...)) or similar.
; pos should point to the opening '('. Returns position after the matching ')'.
(defn c-skip-parens (buf:ptr pos:i64 len:i64):i64
  (let (depth:i32 0)
    (while (< pos len)
      (when (= (char-at buf pos) 40) (inc! depth))
      (when (= (char-at buf pos) 41)
        (set! depth (- depth 1))
        (when (= depth 0)
          (return (+ pos 1))))
      (set! pos (+ pos 1)))
    (return pos)))

; Stage 15 W3b: consume a run of C type qualifiers at `pos`, returning the
; position after the last one (leading whitespace is skipped either way).
;
; C permits a qualifier *anywhere* in a declaration-specifier sequence and after
; every `*`, so `int const *p` ("east const") denotes exactly the same type as
; `const int *p`. Nucleus models neither, and the emitted LLVM type is identical
; with or without them, so the parser consumes and discards a qualifier in every
; legal position rather than representing it. Before this existed the parser
; handled only the *leading* position: an east qualifier terminated the type, and
; the qualifier token was then consumed as the parameter's *name*, leaving the
; following `*p` to start a phantom SECOND parameter that defaulted to `ptr`
; (cheader.md §1.5 — `void _mm_clflush(void const *__p)` became
; `declare void @_mm_clflush(void, ptr)`, and `int const *p` the silently
; representable-but-wrong `(i32, ptr)`).
(defn c-skip-type-quals (buf:ptr pos:i64 len:i64):i64
  (let (p:i64 (c-skip-ws buf pos len)
        more:i32 1)
    (while (!= more 0)
      (set! more 0)
      (let (te:i64 0
            t:ptr (c-read-ident buf p len (as ptr:i64 (addr-of te))))
        (when (or (= t "const") (= t "volatile") (= t "restrict")
                  (= t "__restrict") (= t "__restrict__") (= t "_Atomic"))
          (set! p (c-skip-ws buf te len))
          (set! more 1))))
    (return p)))

; Parse a C type from the buffer. Handles qualifiers (const, restrict, volatile,
; unsigned, signed, long, short, struct), pointer stars.
; Returns the Nucleus Type*. Sets out-end to position after the type.
(defn c-parse-type (buf:ptr pos:i64 len:i64 out-end:ptr:i64):ptr
  (let (is-unsigned:i32 0
        is-long:i32 0
        is-short:i32 0
        base-name:ptr null
        ptr-depth:i32 0
        is-struct:i32 0
        is-union:i32 0
        is-enum:i32 0)
    ; Parse type qualifiers and specifiers
    (let (done:i32 0)
      (while (= done 0)
        (set! pos (c-skip-ws buf pos len))
        (when (>= pos len) (set! done 1) (set! pos len))
        (when (= done 0)
          (let (tok-end:i64 0
                tok:ptr (c-read-ident buf pos len (as ptr:i64 (addr-of tok-end))))
            (when (= (as i64 (strlen tok)) 0) (set! done 1))
            (when (= done 0)
              (cond
                (= tok "const")      (set! pos tok-end)
                (= tok "volatile")   (set! pos tok-end)
                (= tok "restrict")   (set! pos tok-end)
                (= tok "__restrict") (set! pos tok-end)
                (= tok "_Atomic")    (set! pos tok-end)
                (= tok "extern")     (set! pos tok-end)
                (= tok "static")     (set! pos tok-end)
                (= tok "inline")     (set! pos tok-end)
                (= tok "__inline")   (set! pos tok-end)
                (= tok "__inline__") (set! pos tok-end)
                (= tok "__extension__") (set! pos tok-end)
                (= tok "_Noreturn")  (set! pos tok-end)
                (= tok "unsigned")
                  (do (set! is-unsigned 1) (set! pos tok-end))
                (= tok "signed")     (set! pos tok-end)
                (= tok "long")
                  (do (set! is-long (+ is-long 1))
                      (set! pos tok-end)
                      ; Peek to distinguish `long`, `long long`, `long int`,
                      ; `long double`, and `long` as a base type.
                      (let (peek-pos:i64 (c-skip-ws buf tok-end len)
                            peek-end:i64 0
                            peek-tok:ptr (c-read-ident buf peek-pos len (as ptr:i64 (addr-of peek-end))))
                        ; Consume a second "long" (long long) and re-peek.
                        (when (= peek-tok "long")
                          (set! is-long (+ is-long 1))
                          (set! pos peek-end)
                          (set! peek-pos (c-skip-ws buf peek-end len))
                          (set! peek-tok (c-read-ident buf peek-pos len (as ptr:i64 (addr-of peek-end)))))
                        ; "int"/"double" follow as the base; otherwise the base is
                        ; an implicit int and "long" is the (long-counted) base.
                        (when (and (!= peek-tok "int")
                                   (!= peek-tok "double"))
                          (set! base-name "long") (set! done 1))))
                (= tok "short")
                  (do (set! is-short 1) (set! pos tok-end)
                      ; `short` alone (or `unsigned short`) is an implicit
                      ; `short int`: if `int` doesn't follow, the next token is
                      ; the declarator, so `short` itself is the base type.
                      (let (peek-pos:i64 (c-skip-ws buf tok-end len)
                            peek-end:i64 0
                            peek-tok:ptr (c-read-ident buf peek-pos len (as ptr:i64 (addr-of peek-end))))
                        (when (!= peek-tok "int")
                          (set! base-name "short") (set! done 1))))
                (= tok "struct")
                  (do (set! is-struct 1) (set! pos tok-end))
                (= tok "union")
                  (do (set! is-struct 1) (set! is-union 1) (set! pos tok-end))
                ; W3c: `enum` was not a specifier at all, so `enum Tag e` read
                ; `enum` as the base type (unresolved → `ptr`) and `Tag` as the
                ; declarator name — the parameter's real name then began a
                ; phantom next one, the same shape W3b found for east
                ; qualifiers. A C enum's underlying type is implementation-
                ; defined but is `int` on every target this compiler emits for,
                ; and that is what clang lowers an enum parameter to. The
                ; optional tag is read by the next loop iteration (as base-name,
                ; exactly like `struct Tag`); an optional `{…}` body is consumed
                ; in the is-enum block below.
                (= tok "enum")
                  (do (set! is-enum 1) (set! pos tok-end))
                (= tok "__attribute__")
                  (do (set! pos (c-skip-ws buf tok-end len))
                      (when (and (< pos len) (= (char-at buf pos) 40))
                        (set! pos (c-skip-parens buf pos len))))
                true
                  (do (set! base-name tok) (set! pos tok-end) (set! done 1))))))))
    ; W3b: qualifiers that trail the base type (`int const *p`) belong to the
    ; declaration specifiers, not to the declarator — consume them here, before
    ; the declarator is looked for. Runs for every base kind (builtin, typedef
    ; name, `struct Tag`), since the specifier loop above exits through this
    ; point in all of them.
    (set! pos (c-skip-type-quals buf pos len))
    ; Count pointer stars, each optionally followed by its own qualifiers
    ; (`char * const p`, `int * restrict p`).
    (while (and (< pos len) (= (char-at buf pos) 42))
      (inc! ptr-depth)
      (set! pos (c-skip-type-quals buf (+ pos 1) len)))
    (ptr-set! out-end pos)
    ; W3c: enum base. The specifier loop has already taken an optional tag into
    ; `base-name`; what may remain is an inline `{ … }` enumerator list (for
    ; `enum { A, B } x` the loop stopped at the `{` without consuming anything,
    ; so the qualifier/`*` runs below have to be redone after it).
    (when (!= is-enum 0)
      (let (look:i64 (c-skip-ws buf pos len))
        (when (and (< look len) (= (char-at buf look) 123))
          (set! look (cheader-skip-braces buf look len))
          (set! look (c-skip-type-quals buf look len))
          (while (and (< look len) (= (char-at buf look) 42))
            (inc! ptr-depth)
            (set! look (c-skip-type-quals buf (+ look 1) len)))
          (ptr-set! out-end look)))
      (when (> ptr-depth 0) (return ty-ptr))
      (return ty-i32))
    ; Struct/union base. struct {...} / struct Tag {...} parse the body to a
    ; TY-STRUCT (TY-UNION for unions); Tag references look up by tag;
    ; pointer-to-aggregate collapses to ptr.
    (when (!= is-struct 0)
      (when (> ptr-depth 0) (return ty-ptr))
      (let (look:i64 (c-skip-ws buf pos len)
            tag:ptr base-name)
        (when (and (< look len) (= (char-at buf look) 123))
          (let (sd-end:i64 0
                sd:ptr (c-parse-struct-body buf look len (as ptr:i64 (addr-of sd-end)) tag is-union))
            (ptr-set! out-end sd-end)
            (when (!= sd null)
              (return (as ptr (type-for-sdef sd))))
            ; W3b: a BY-VALUE aggregate whose body we could not parse. `ptr` is
            ; kept (a TY-STRUCT with no layout would put an undefined `%Tag` in
            ; the IR), but the enclosing declaration is now recorded as one the
            ; importer cannot describe — c-decl-skip-reason turns it into a
            ; located skip-with-warning instead of a wrong-ABI declaration.
            (cheader-mark-unrep
              "a by-value struct/union whose body the parser could not read" 0)
            (return ty-ptr)))
        (when (!= tag null)
          (let (sd:ptr (lookup-struct tag))
            ; W3a: an OPAQUE tag must keep resolving to bare `ptr` here, exactly
            ; as an unregistered tag did before opaque registration existed. This
            ; branch is reached only for a BY-VALUE `struct Tag` in a parameter,
            ; return, or field position — a shape the parser cannot lower at all
            ; without a layout — and turning it into a TY-STRUCT would put an
            ; undefined `%Tag` into a `declare`, i.e. trade today's wrong-ABI
            ; pointer for invalid IR. Converting these into a skip-with-warning
            ; is W3b's validity gate (cheader.md §1.5), not this phase.
            (when (and (!= sd null)
                       (= (-> sd (unsafe/cast ptr:StructDef _) (_ opaque)) 0))
              (return (as ptr (type-for-sdef sd))))))
        ; W3b: fell through — a by-value `struct Tag` whose tag is opaque or
        ; unknown. Same reasoning as the unparsable-body case above: keep `ptr`,
        ; but mark the declaration unrepresentable so it is skipped rather than
        ; silently given the wrong ABI.
        ; (`tag` and the fallback spelling are bound through a `ptr` local: a
        ; value-position `if` joining a bare `ptr` with a `StrView` literal
        ; collapses to void — conventions.md, the mixed cond/if join rule.)
        (let (tn:ptr tag)
          (when (= tn null) (set! tn "struct"))
          (cheader-mark-unrep
            (fmt-s "a by-value '%s' with no known layout" tn) 0))
        (return ty-ptr)))
    ; Resolve base type
    (when (= base-name null)
        ; bare "unsigned" or "signed" with no base → int
        (when (or (!= is-unsigned 0) (or (!= is-short 0) (!= is-long 0)))
          (set! base-name "int"))
        (when (= base-name null) (return ty-ptr)))
    (let (base-type:ptr (c-type-to-nucleus base-name is-unsigned is-long is-short)
          td:ptr (as ptr (c-typedef-find (as CStr base-name))))
      ; W3c: not a builtin — consult the typedef table (cheader.md §1.4). The
      ; entry already holds the fully-resolved type, so a chain costs one lookup.
      (when (and (= base-type null) (!= td null))
        (set! base-type (as ptr ((unsafe/cast ptr:Node td) car))))
      ; W3c: a typedef NAME for a C aggregate is registered as a StructDef, not
      ; in the typedef table (c-parse-struct-decl owns that path), so resolve it
      ; the same way the `struct Tag` branch above does — a known layout gives
      ; the real TY-STRUCT, an opaque one stays `ptr` and marks the declaration.
      (when (= base-type null)
        (let (sd:ptr (lookup-struct base-name))
          (when (and (!= sd null)
                     (= (-> sd (unsafe/cast ptr:StructDef _) (_ opaque)) 0))
            (set! base-type (as ptr (type-for-sdef (as ptr:StructDef sd)))))))
      ; Apply pointer depth. A pointer to anything is `ptr` in Nucleus, so an
      ; unresolvable POINTEE is harmless and must not mark the declaration —
      ; `struct _IO_FILE *` and `void (*)(int)` are perfectly describable.
      (when (> ptr-depth 0) (return ty-ptr))
      (when (= base-type null)
        ; W3c: a BY-VALUE type we could not resolve. The spec's rule for §1.4 is
        ; that a typedef the parser cannot follow must be an error or a skip,
        ; never a silent `ptr` — so keep `ptr` in the Type (a TY-STRUCT with no
        ; layout would put an undefined `%X` in the IR) but mark the enclosing
        ; declaration, which turns it into a located skip-with-warning naming the
        ; type. This is the "no unresolved type names" gate arm the W3b spec
        ; asked for and W3b correctly refused to implement while every unfollowed
        ; typedef still resolved to `ptr`.
        ; `long double` is the one BUILTIN spelling c-type-to-nucleus refuses
        ; (x86-64 lowers it to the 80-bit x87 type, which Nucleus has no
        ; spelling for), so name it accurately rather than blaming `double`.
        (cond
          (and (!= is-long 0) (= base-name "double"))
            (cheader-mark-unrep
              "a by-value 'long double' (no Nucleus type is that wide)" 1)
          (!= td null)
            (cheader-mark-unrep
              (fmt-s "a by-value '%s' (a typedef of a type with no Nucleus representation)" base-name) 1)
          true
            (cheader-mark-unrep
              (fmt-s "a by-value parameter or return of unknown type '%s'" base-name) 1))
        (return ty-ptr))
      (return base-type))))

; ============================================================
; Stage 15 W3b: the validity gate on a synthesized `declare` (cheader.md §1.5)
;
; A declaration the parser recognized as a function but cannot faithfully
; describe must be SKIPPED with a located warning, not emitted. The alternative
; is what §1.5 documented: `declare void @_mm_clflush(void, ptr)` reaching the
; LLVM parser thousands of lines later as `failed to parse generated IR`, with no
; indication of which header or which function caused it.
;
; The gate sits *after* successful recognition, deliberately. The "this is not a
; function declaration at all" path (c-parse-func-decl returning 0) stays silent:
; every typedef, variable, `static inline` body and macro remnant in a
; preprocessed header goes through it legitimately, so warning there would bury
; the real signal.
;
; W3b noted that the spec's suggested "no unresolved type names" arm was not
; implementable *at the time*, because an unfollowed typedef resolved to `ptr` —
; which is representable, so the arm would have skipped a large fraction of every
; real header. W3c removed that objection by resolving the chain at the source
; (the typedef table above): an unresolved BY-VALUE base type is now genuinely
; rare, so `c-parse-type` marks it through the same g-cheader-unrep channel and
; the arm exists after all. A pointer to an unresolvable type is still fine and
; is deliberately not marked — every C pointer is `ptr`.
; ============================================================

; Parameter-array capacity. Both a real bound (the array is a fixed arena block)
; and the gate's cap: a declaration with more parameters than this is skipped
; rather than silently truncated. Before W3b the array was 16 entries and
; `num-params` was incremented past it, so `type-set-params` read off the end.
(defconst C-MAX-PARAMS 32)

; Record that `fname`'s declaration was skipped, and — when `loud` — say so on
; stderr immediately. `g-cheader-skipped` (declared in nucleusc.nuc, above
; `unresolved-name-message`, so the *use*-site diagnostic can read it) is keyed
; by function name and deduplicated: a C header import is deliberately not
; deduplicated (each import may alias under a different prefix) and umbrella
; headers include each other transitively, so one skipped function would
; otherwise be recorded and warned about many times per build.
;
; **Two tiers, and the split is deliberate (W3c).** W3b made every skip an
; always-on stderr warning and measured the volume at zero, which made "always
; on" free. W3c's typedef resolution changed that measurement: with the chain
; followed, an unresolvable *by-value* type is detectable, and the standard
; headers contain ~45 of them — `long double` throughout <math.h>/<stdlib.h>,
; `_Float128`/`_Float16` in the glibc and clang intrinsics headers,
; `SDL_JoystickGUID` in SDL2. Every one is a true positive, and every one is
; irrelevant to a build that never calls the function; six of them landed in the
; REPL's startup banner. So:
;
;   * **loud** — the importer could not *parse* what the header said (an
;     unreadable aggregate body, a `void` parameter, an opaque type, an
;     over-long parameter list). These are compiler-side limitations worth
;     surfacing on sight, and they still measure zero across the standard
;     headers, so W3b's always-on policy is kept verbatim for them.
;   * **quiet** — the declaration was parsed correctly and names a type Nucleus
;     has no equivalent for. Recorded only; `unresolved-name-message` delivers
;     it, with this same header:line and reason, at the point someone actually
;     calls the function.
;
; Neither tier is silent: a quiet skip that matters always becomes a located
; error, which is strictly more precise than a warning thousands of lines
; earlier that nothing connects to the call.
(defn cheader-record-skip (fname:CStr why:ptr dline:i32 loud:i32):void
  (when (!= (cheader-skip-note fname) null) (return))
  (let (note:ptr (fmt-2s "%s: %s" (fmt-sd "%s:%d" g-cheader-file dline) why)
        n:ref:Node (new Node))
    (.set! n kind NODE-STR)
    (.set! n line 0)
    (.set! n s (intern-str (as ptr fname)))
    (.set! n car note)
    (.set! n cdr g-cheader-skipped)
    (set! g-cheader-skipped (as raw:Node n))
    (when (!= loud 0)
      (fprintf stderr "%s:%d: warning: skipping C declaration '%s': %s\n"
               g-cheader-file dline fname why))))

; The reason this declaration cannot be emitted, or null if it can.
;
; The result is `ptr`, deliberately NOT `CStr`: the caller null-checks it, and a
; `CStr`-typed operand makes `=`/`!=` lower to `strcmp` — `strcmp(why, NULL)`
; segfaults the compiler with empty output (conventions.md, the string-type
; lattice). Only the message *content* matters here, never its identity.
; W3c: `unrep-why` replaces W3b's boolean — the accumulated first reason
; c-parse-type could not describe some type in this declaration, or null when it
; described them all. Carrying the message instead of a flag is what lets one arm
; cover both W3b's layout-less aggregates and W3c's unresolvable type names while
; still naming the offending type in the warning.
(defn c-decl-skip-reason (unrep-why:ptr ret-type:raw:Type ptypes:ptr np:i32):ptr
  (when (!= unrep-why null) (return unrep-why))
  (when (> np C-MAX-PARAMS)
    (return (fmt-i32 "more than %d parameters" C-MAX-PARAMS)))
  (when (= ret-type null) (return "an unparsed return type"))
  (when (!= (opaque-sdef-of ret-type) null) (return "an opaque return type"))
  (dotimes (i:i32 np)
    (let (pt:(raw Type) (as raw:Type (aref (as ptr:ptr ptypes) i)))
      (when (= pt null) (return "an unparsed parameter type"))
      ; `void` is legal only as a whole (empty) parameter list, which is consumed
      ; before any parameter is recorded — so a recorded void parameter is always
      ; a mis-parse, and `declare void @f(void, ptr)` is the IR LLVM rejects.
      (when (= (pt kind) TY-VOID) (return "a 'void' parameter"))
      (when (!= (opaque-sdef-of pt) null) (return "an opaque parameter type"))))
  (return null))

; Parse one C function declaration from the buffer.
; Expects pos to be at the start of a declaration (after leading whitespace).
; Returns 1 if a function declaration was parsed, 0 otherwise.
; On success, registers the function in g-globals and emits LLVM declare.
(defn c-parse-func-decl (buf:ptr pos:i64 len:i64 out-end:ptr:i64 line:i32):i32
  ; W3b: the gate's per-declaration state. Cleared here rather than at the
  ; c-parse-type call sites so a nested struct-body parse cannot leak a flag set
  ; by an earlier top-level declaration into this one.
  (set! g-cheader-unrep 0)
  ; Parse the return type
  (let (ret-end:i64 0
        decl-start:i64 pos
        ret-type:ptr (c-parse-type buf pos len (as ptr:i64 (addr-of ret-end))))
    (set! pos ret-end)
    (set! pos (c-skip-ws buf pos len))
    ; Read the function name
    (let (name-end:i64 0
          fname:ptr (c-read-ident buf pos len (as ptr:i64 (addr-of name-end))))
      (when (= (as i64 (strlen fname)) 0)
         (ptr-set! out-end pos) (return 0))
      (set! pos name-end)
      (set! pos (c-skip-ws buf pos len))
      ; Expect '('
      (when (or (>= pos len) (!= (char-at buf pos) 40))
         (ptr-set! out-end pos) (return 0))
      (set! pos (+ pos 1))
      ; Parse parameters
      (let (param-types:ptr (arena-alloc (* (as i64 C-MAX-PARAMS) (as i64 8)))
            num-params:i32 0
            is-variadic:i32 0
            pdone:i32 0
            ; W3b: the declaration-level accumulator for "contains a type this
            ; parser cannot describe". Seeded with the return type's verdict
            ; (g-cheader-unrep was cleared at function entry, immediately before
            ; the return type was parsed); each parameter contributes below,
            ; *after* the post-parse type overrides have had their say. W3c holds
            ; the *reason* rather than a flag, and keeps the FIRST one: a later
            ; parameter can raise the global and then have it cleared by the
            ; function-pointer / array override, which would otherwise leave a
            ; stale message attached to an earlier parameter's verdict.
            unrep-why:ptr (if (!= g-cheader-unrep 0) g-cheader-unrep-why null)
            unrep-quiet:i32 (if (!= g-cheader-unrep 0) g-cheader-unrep-quiet 0))
        (while (= pdone 0)
          (set! pos (c-skip-ws buf pos len))
          (when (>= pos len) (set! pdone 1))
          (when (= pdone 0)
            ; Check for ')'
            (when (= (char-at buf pos) 41)
               (set! pos (+ pos 1)) (set! pdone 1))
            (when (= pdone 0)
              ; Check for '...'
              (when (and (< (+ pos 2) len)
                         (= (char-at buf pos) 46)
                         (= (char-at buf (+ pos 1)) 46)
                         (= (char-at buf (+ pos 2)) 46))
                 (set! is-variadic 1)
                 (set! pos (+ pos 3))
                 (set! pos (c-skip-ws buf pos len))
                 (when (and (< pos len) (= (char-at buf pos) 41))
                   (set! pos (+ pos 1)))
                 (set! pdone 1))
              (when (= pdone 0)
                ; Check for void param (no-arg function)
                (let (void-check-end:i64 0
                      void-check:ptr (c-read-ident buf pos len (as ptr:i64 (addr-of void-check-end))))
                  (when (= void-check "void")
                    (let (after-void:i64 (c-skip-ws buf void-check-end len))
                      (when (and (< after-void len) (= (char-at buf after-void) 41))
                         (set! pos (+ after-void 1))
                         (set! pdone 1)))))
                (when (= pdone 0)
                  ; Parse parameter type. W3b: clear the by-value-aggregate flag
                  ; first so it reports on THIS parameter only.
                  (set! g-cheader-unrep 0)
                  (let (ptype-end:i64 0
                        ptype:ptr (c-parse-type buf pos len (as ptr:i64 (addr-of ptype-end))))
                    (set! pos ptype-end)
                    (set! pos (c-skip-ws buf pos len))
                    ; Handle function pointer params: void (*name)(args)
                    (when (and (< pos len) (= (char-at buf pos) 40))
                      (set! pos (c-skip-parens buf pos len))
                      (set! pos (c-skip-ws buf pos len))
                      ; Skip second paren group (arg types)
                      (when (and (< pos len) (= (char-at buf pos) 40))
                        (set! pos (c-skip-parens buf pos len)))
                      ; A pointer-to-function parameter is a pointer whatever its
                      ; return/argument types were, so an aggregate met while
                      ; parsing them says nothing about this parameter.
                      (set! g-cheader-unrep 0)
                      (set! ptype ty-ptr))
                    ; Skip parameter name (if present)
                    (when (and (< pos len)
                               (or (and (>= (as i32 (char-at buf pos)) 65)
                                        (<= (as i32 (char-at buf pos)) 90))
                                   (or (and (>= (as i32 (char-at buf pos)) 97)
                                            (<= (as i32 (char-at buf pos)) 122))
                                       (= (as i32 (char-at buf pos)) 95))))
                      (let (skip-end:i64 0
                            skip:ptr (c-read-ident buf pos len (as ptr:i64 (addr-of skip-end))))
                        (set! pos skip-end)))
                    ; Skip array brackets if present: [N]
                    (set! pos (c-skip-ws buf pos len))
                    (while (and (< pos len) (= (char-at buf pos) 91))
                      (while (and (< pos len) (!= (char-at buf pos) 93))
                        (set! pos (+ pos 1)))
                      (when (< pos len) (set! pos (+ pos 1)))
                      (set! pos (c-skip-ws buf pos len))
                      ; An array parameter decays to a pointer in C, so an
                      ; element type with no layout is not passed by value and
                      ; the declaration stays representable — glibc's
                      ; `utimensat(int, const char *, const struct timespec [2],
                      ; int)` is the case that proved this must clear the flag.
                      (set! g-cheader-unrep 0)
                      (set! ptype ty-ptr))
                    ; W3b: this parameter's contribution to the gate, taken after
                    ; every override above.
                    (when (and (!= g-cheader-unrep 0) (= unrep-why null))
                      (set! unrep-why g-cheader-unrep-why)
                      (set! unrep-quiet g-cheader-unrep-quiet))
                    ; Store parameter type. Over capacity the count still grows,
                    ; so the gate below sees the real arity and skips the
                    ; declaration instead of emitting a truncated one.
                    (when (< num-params C-MAX-PARAMS)
                      (aset! (as ptr:ptr param-types) num-params ptype))
                    (inc! num-params)
                    (set! pos (c-skip-ws buf pos len))
                    ; Expect ',' or ')'
                    (when (and (< pos len) (= (char-at buf pos) 44))
                      (set! pos (+ pos 1)))))))))
        ; Skip any __attribute__ after closing paren
        (set! pos (c-skip-ws buf pos len))
        (let (attr-check:i32 1)
          (while (!= attr-check 0)
            (set! attr-check 0)
            (let (ae:i64 0
                  at:ptr (c-read-ident buf pos len (as ptr:i64 (addr-of ae))))
              (when (= at "__attribute__")
                 (set! pos (c-skip-ws buf ae len))
                 (when (and (< pos len) (= (char-at buf pos) 40))
                   (set! pos (c-skip-parens buf pos len)))
                 (set! pos (c-skip-ws buf pos len))
                 (set! attr-check 1))
              (when (= at "__asm__")
                 (set! pos (c-skip-ws buf ae len))
                 (when (and (< pos len) (= (char-at buf pos) 40))
                   (set! pos (c-skip-parens buf pos len)))
                 (set! pos (c-skip-ws buf pos len))
                 (set! attr-check 1)))))
        ; Skip semicolon
        (when (and (< pos len) (= (char-at buf pos) 59))
          (set! pos (+ pos 1)))
        (ptr-set! out-end pos)
        ; W3b validity gate (cheader.md §1.5). The declaration is consumed either
        ; way — `out-end` is already past its semicolon, so returning 1 keeps the
        ; caller from rescanning it — but a declaration the importer cannot
        ; describe is dropped with a located warning instead of registered. Before
        ; the collect-mode push: aliasing a name that was never registered would
        ; produce a dangling `prefix/name`.
        (let (why:ptr (c-decl-skip-reason unrep-why (as raw:Type ret-type)
                                          param-types num-params))
          (when (!= why null)
            ; W3c: only a reason that came through the unrep channel can be
            ; quiet; every other arm (void parameter, opaque type, arity cap,
            ; unparsed type) is a parse-side limitation and stays loud, exactly
            ; as W3b left it.
            (let (loud:i32 1)
              (when (and (= why unrep-why) (!= unrep-quiet 0)) (set! loud 0))
              (cheader-record-skip (as CStr fname) why
                                   (cheader-line-at buf decl-start) loud))
            (return 1)))
        ; W3c precedence (cheader.md §1.4): an explicit `(declare …)` anywhere in
        ; this unit outranks the header's copy, whichever comes first. Record the
        ; header-derived signature for the conflict message and drop this
        ; declaration — registering it would make the *header* win when it
        ; precedes the declare, and emitting a second `declare` for the same
        ; symbol is invalid IR even when the two agree.
        (when (!= (as ptr (cheader-explicit-declare-site (as CStr fname))) null)
          (cheader-yield-to-explicit-declare
            (as CStr fname)
            (c-fn-sig-render (as raw:Type ret-type) param-types num-params
                             is-variadic)
            (cheader-line-at buf decl-start))
          (return 1))
        ; Register the function
        (let (ft:ptr:Type (as ptr:Type (make-type TY-FN)))
          (.set! ft ret ret-type)
          (type-set-params ft param-types num-params)
          (.set! ft variadic is-variadic)
          ; Only register if not already defined. B2b: a KEY question, paired
          ; with the `scope-define` it guards.
          (when (= (scope-lookup-key g-globals fname) null)
              (let (csym:ref:Sym (scope-define g-globals fname (as ptr ft)
                                  (fmt-s "@%s" fname) 0))
                ; Stage 10 Phase F1: mark known-noreturn libc functions.
                (when (!= (c-fn-noreturn fname) 0)
                  (.set! (as ptr:Sym csym) noreturn 1)))
              (when (= fname "malloc")
                (set! g-malloc-decl-done 1))
              ; Emit LLVM declare, lowering a struct-by-value parameter or return
              ; to the platform C ABI (sret / byval / register coercion) exactly
              ; as `emit-nuch-declare-import` and `emit-defn` do.
              ;
              ; W3c: this path used to print the raw `type-to-ir` of every
              ; parameter and the return. That was invisible until typedef
              ; resolution landed, because glibc names every by-value aggregate
              ; through a typedef and an unfollowed typedef was `ptr` — so the
              ; C-header path had literally never emitted a struct by value.
              ; With the chain followed, `div`/`ldiv`/`lldiv`/`fopencookie`
              ; appear, and printing `%div_t` there would disagree with the ABI
              ; the *call site* already lowers through abi-classify. For every
              ; scalar and pointer declaration abi-classify is ABI-DIRECT and
              ; both helpers reduce to `type-to-ir`, so the emitted text is
              ; byte-identical to the former loop.
              (let (ret-info:ptr:AbiInfo
                      (unsafe/cast ptr:AbiInfo (abi-classify (as raw:Type ret-type))))
                (fprintf g-out "declare %s @%s("
                         (abi-ret-ir (as raw:AbiInfo ret-info) (as raw:Type ret-type))
                         fname)
                (let (need-comma:i32 0)
                  (when (= ((as ptr:AbiInfo ret-info) kind) ABI-MEMORY)
                    (fprintf g-out "ptr sret(%s) align %d"
                             (type-to-ir ret-type)
                             ((as ptr:AbiInfo ret-info) align))
                    (set! need-comma 1))
                  ; RV-6c: one walk over this declare's parameters — reset the
                  ; riscv64 register budget (design/stage14/riscv-fp-abi.md §4).
                  (abi-args-begin (as raw:AbiInfo ret-info))
                  (let (j:i32 0)
                    (while (< j num-params)
                      (when (!= need-comma 0) (fprintf g-out ", "))
                      (abi-print-param
                        (abi-classify-arg (as raw:Type ((field-at (ft params) j) type)))
                        (as raw:Type ((field-at (ft params) j) type))
                        null)
                      (set! need-comma 1)
                      (inc! j)))
                  (when (!= is-variadic 0)
                    (let (sep:ptr "")
                      (when (!= need-comma 0) (set! sep ", "))
                      (fprintf g-out "%s..." sep)))))
              ; Stage 10 Phase F1: trailing LLVM `noreturn` function attribute.
              (if (!= (c-fn-noreturn fname) 0)
                (fprintf g-out ") noreturn\n")
                (fprintf g-out ")\n"))))
        (return 1)))))

; ============================================================
; Preprocessed-header cache (Stage 15 W3a)
;
; `clang -E -x c -include <path> /dev/null` takes no other input, so its output is
; a pure function of the header path. The same header is preprocessed several
; times per compilation — once per `(import-use "<path>")` that names it (a C
; header import is deliberately NOT deduplicated, since each import may alias
; under a different prefix), plus once for the W3a opaque name pre-scan. Caching
; the text by path collapses that to one clang run per distinct header: a
; `hello.nuc` build went from 5 preprocessor invocations to 3 even after W3a added
; its pre-scan pass. The buffers were never freed before either (they outlive the
; parse via the Types built from them), so this strictly reduces allocation.
;
; The cache reuses a Node cell as its record, exactly as the import lists do:
; `s` = header path, `car` = the buffer, `i` = its length.
; ============================================================
(defvar (g-cheader-cache (raw Node)))

(defn cheader-preprocess (header-path:ptr out-len:ptr:i64):ptr
  (let (cur:ptr g-cheader-cache)
    (while (!= cur null)
      (let (e:ptr:Node (unsafe/cast ptr:Node cur))
        (when (= (as CStr (e s)) (as CStr header-path))
          (ptr-set! out-len (e i))
          (return (as ptr (e car))))
        (set! cur (e cdr)))))
  (let (cmd:ptr (alloca i8 512))
    (snprintf cmd (as i64 512) "clang -E -x c -include %s /dev/null 2>/dev/null" header-path)
    (let (buf-len:i64 0
          buf:ptr (read-pipe-output cmd (as ptr:i64 (addr-of buf-len))))
      (when (= buf null) (ptr-set! out-len 0) (return null))
      (let (n:ref:Node (new Node))
        (.set! n kind NODE-STR)
        (.set! n line 0)
        (.set! n i buf-len)
        (.set! n s (intern-str header-path))
        (.set! n car buf)
        (.set! n cdr g-cheader-cache)
        (set! g-cheader-cache (as raw:Node n)))
      (ptr-set! out-len buf-len)
      (return buf))))

; Read all output from a popen'd command into a malloc'd buffer.
; Returns the buffer (null-terminated). Sets out-len to the length.
(defn read-pipe-output (cmd:ptr out-len:ptr:i64):ptr
  (let (fp:ptr (popen cmd "r"))
    (when (= fp null) (ptr-set! out-len 0) (return null))
    (let (bufsz:i64 65536
          buf:ptr (malloc bufsz)
          total:i64 0)
      (let (chunk:i64 (fread (unsafe/ptr+ (as ptr:i8 buf) total) (as i64 1) (- (- bufsz total) 1) fp))
        (set! total (+ total chunk))
        (while (> chunk 0)
          (when (>= (+ total 1) bufsz)
             (set! bufsz (* bufsz 2))
             (set! buf (realloc buf bufsz)))
          (set! chunk (fread (unsafe/ptr+ (as ptr:i8 buf) total) (as i64 1) (- (- bufsz total) 1) fp))
          (set! total (+ total chunk))))
      (ptr-set! (as ptr:i8 (unsafe/ptr+ (as ptr:i8 buf) total)) 0)
      (pclose fp)
      (ptr-set! out-len total)
      (return buf))))

; Process a C header file: run clang -E, parse function declarations.
; header-path is e.g. "stdio.h" or "/usr/include/mylib.h".
; Size in bytes of C `long` for the configured target's data model (Stage 8):
; LP64 -> 8, ILP32 -> 4, LLP64 (Windows) -> 4. `long long` is always 8.
(defn target-long-size ():i32
  (when (= ((as ptr:Target g-target) ptr-size) 4) (return 4))
  (when (!= (strstr ((as ptr:Target g-target) triple) "windows") null) (return 4))
  (return 8))

; Stage 15 W3a: give a header-derived StructDef its fields and write its LLVM
; type definition. Factored out of c-parse-struct-body so the fresh-registration
; path and the opaque-upgrade path emit *exactly* the same definition — a tag
; that was forward-declared first must end up indistinguishable from one whose
; body came first.
(defn cheader-struct-define (sd:ptr:StructDef fnames:ptr ftypes:ptr
                             nfields:i32 is-union:i32):void
  ; struct-set-fields also clears `opaque` (abi.nuc) — the layout is now known.
  (struct-set-fields sd fnames ftypes nfields)
  (if (!= is-union 0)
    ; Named union: members at offset 0; the IR type definition is deferred
    ; until member layouts are final (drain-pending-union-irs).
    (do
      (.set! sd is-union 1)
      (conj g-pending-unions sd))
    (do
      (fprintf g-type-stream "%%%s = type { " (sd ir-name))
      (let (i:i32 0)
        (while (< i nfields)
          (when (!= i 0) (fprintf g-type-stream ", "))
          (fprintf g-type-stream "%s" (type-to-ir (aref (as ptr:ptr ftypes) i)))
          (inc! i)))
      (fprintf g-type-stream " }\n\n")
      ; W3c: `emitted` means exactly "this type's definition is already in the
      ; shared type buffer", and it is what pending-union-deps-ready consults
      ; before writing a queued union whose field names this struct. The cheader
      ; path writes its `%X = type {…}` line directly rather than through
      ; emit-struct-ir-type, so it has to set the flag itself — without it, a C
      ; union with a struct member (SDL's `SDL_WindowShapeParams`, whose
      ; `SDL_Color` member only became a real TY-STRUCT once W3c resolved the
      ; typedef) was deferred on every drain and its `%…` type never appeared,
      ; while the struct that *contained* the union referenced it.
      (.set! sd emitted 1))))

; Stage 15 W3a: make `dst` share `src`'s layout and write `dst`'s own LLVM type
; definition. Used for a `typedef struct Tag Name;` alias entry (which is a
; separate registry entry because lookup-struct is keyed by name) and to upgrade
; an entry that was registered opaque before its definition was reached. The
; `fields` Vector is immutable after build, so sharing the handle is sound.
(defn cheader-adopt-shape (dst:ptr:StructDef src:ptr:StructDef):void
  (.set! dst fields (src fields))
  (.set! dst num-fields (src num-fields))
  (.set! dst opaque 0)
  (if (!= (src is-union) 0)
    ; Union: same deferred-definition path as the tag (drain-pending-union-irs).
    (do
      (.set! dst is-union 1)
      (conj g-pending-unions dst))
    (do
      (fprintf g-type-stream "%%%s = type { " (dst ir-name))
      (let (k:i32 0
            nf:i32 (src num-fields))
        (while (< k nf)
          (when (!= k 0) (fprintf g-type-stream ", "))
          (fprintf g-type-stream "%s"
            (type-to-ir ((field-at (src fields) k) type)))
          (inc! k)))
      (fprintf g-type-stream " }\n\n")
      ; W3c: see cheader-struct-define — the alias's definition is now in the
      ; shared type buffer, so a queued union naming it must count it as ready.
      (.set! dst emitted 1))))

; Stage 15 W3a: propagate a just-upgraded tag's layout to every
; `typedef struct Tag Name;` alias that was registered while Tag was still
; opaque. `alias-of` is the only link between the two registry entries.
(defn struct-upgrade-aliases (tag:ptr:StructDef):void
  (dotimes (i (unsafe/cast i32 (count g-structs)))
    (let (a:ptr:StructDef (as ptr:StructDef (invoke g-structs (as usize i))))
      (when (and (= (as ptr (a alias-of)) (as ptr tag)) (!= (a opaque) 0))
        (cheader-adopt-shape a tag)))))

; Stage 15 W3a: register a C type whose name is known but whose layout is not —
; `struct Foo;` (a forward declaration) or the `Foo` of
; `typedef struct Bar Foo;`. `ptr:Foo` then resolves; any by-value use is
; rejected with this declaration's header:line (reject-opaque-type). Returns the
; entry (existing or new); never overwrites an already-known layout, so a
; repeated forward declaration — glibc's stdio.h carries `struct _IO_FILE;`
; three times — and a forward declaration *after* the definition are both no-ops.
(defn cheader-register-opaque (name:ptr line:i32 is-union:i32
                               alias-of-sd:raw):ptr
  (let (existing:ptr (lookup-struct name))
    (when (!= existing null) (return existing)))
  (let (sd:ptr:StructDef (register-struct (intern-str name)))
    (.set! sd opaque 1)
    (.set! sd is-union is-union)
    (.set! sd alias-of (as raw:StructDef alias-of-sd))
    (.set! sd src-file g-cheader-file)
    (.set! sd src-line line)
    (return (as ptr sd))))

; Parse a C struct/union body `{ field; field; ... }` into a StructDef.
; tag-name null means anonymous (memoized by shape); is-union selects the
; union registration path (members at offset 0, deferred IR type definition).
; Returns the StructDef* or null on skip.
(defn c-parse-struct-body (buf:ptr pos:i64 len:i64 out-end:ptr:i64 tag-name:ptr is-union:i32):ptr
  ; W3a: the declaration's own header:line, captured before `pos` advances, so a
  ; later diagnostic about this type points at the C declaration.
  (let (decl-line:i32 (cheader-line-at buf pos))
  ; Expect '{' at pos.
  (when (or (>= pos len) (!= (char-at buf pos) 123))
    (ptr-set! out-end pos) (return null))
  ; Pre-scan: locate the matching '}' so out-end is set ONCE here.
  ; All failure paths can simply `return null` and the caller's pos is
  ; correctly positioned past the body.
  (let (body-end:i64 (+ pos 1)
        depth:i32 1)
    (while (and (< body-end len) (> depth 0))
      (when (= (char-at buf body-end) 123) (inc! depth))
      (when (= (char-at buf body-end) 125) (set! depth (- depth 1)))
      (when (> depth 0)
        (set! body-end (+ body-end 1))))
    (when (< body-end len) (set! body-end (+ body-end 1)))
    (ptr-set! out-end body-end))
  (set! pos (+ pos 1))
  (let (max-fields:i32 64
        fnames:ptr (arena-alloc (* (as i64 64) (as i64 8)))
        ftypes:ptr (arena-alloc (* (as i64 64) (as i64 8)))
        nfields:i32 0
        bad:i32 0
        done:i32 0
        ; Field-loop state, kept at this scope so the loop body can be
        ; flat and use `when` guards rather than deep nesting.
        fty:ptr null
        fname:ptr null
        te:i64 0
        ne:i64 0)
    ; Per-field loop. On any anomaly we set bad=1 done=1 and abandon
    ; the struct (out-end is already past `}`, so the caller is fine).
    (while (= done 0)
      (set! pos (c-skip-ws buf pos len))
      (when (>= pos len) (set! bad 1) (set! done 1))
      (when (and (= done 0) (= (char-at buf pos) 125))
        (set! pos (+ pos 1)) (set! done 1))
      (when (= done 0)
        (set! fty (c-parse-type buf pos len (as ptr:i64 (addr-of te))))
        (when (= fty null) (set! bad 1) (set! done 1)))
      (when (= done 0)
        (set! pos te)
        (set! pos (c-skip-ws buf pos len))
        ; Function-pointer field: type (*name)(args...). Collapse to ptr.
        (when (and (< pos len) (= (char-at buf pos) 40))
          (set! pos (c-skip-parens buf pos len))
          (set! pos (c-skip-ws buf pos len))
          (when (and (< pos len) (= (char-at buf pos) 40))
            (set! pos (c-skip-parens buf pos len)))
          (set! fty ty-ptr)
          (set! pos (c-skip-ws buf pos len))))
      (when (= done 0)
        (set! fname (c-read-ident buf pos len (as ptr:i64 (addr-of ne))))
        (when (= (as i64 (strlen fname)) 0)
          (set! bad 1) (set! done 1)))
      (when (= done 0)
        (set! pos ne)
        (set! pos (c-skip-ws buf pos len))
        ; Reject array `[`, bitfield `:`, and multi-decl `,` — abandon
        ; the whole struct on any of them. Anything but `;` is bad.
        (when (>= pos len) (set! bad 1) (set! done 1))
        (when (and (= done 0) (!= (char-at buf pos) 59))
          (set! bad 1) (set! done 1)))
      (when (= done 0)
        (when (>= nfields max-fields) (set! bad 1) (set! done 1)))
      (when (= done 0)
        (aset! (as ptr:ptr fnames) nfields (intern-str fname))
        (aset! (as ptr:ptr ftypes) nfields fty)
        (inc! nfields)
        (set! pos (+ pos 1))))
    (when (!= bad 0) (return null))
    ; A union with no members would have no IR representation.
    (when (and (!= is-union 0) (= nfields 0)) (return null))
    ; Build StructDef. Anonymous → memoize via content hash; tagged
    ; → register by tag (if not already present).
    (when (= tag-name null)
      (if (!= is-union 0)
        (return (lookup-or-make-anon-union fnames ftypes nfields))
        (return (lookup-or-make-anon-struct fnames ftypes nfields))))
    ; W3a: an entry may already exist under this tag. A *defined* one is returned
    ; unchanged (a header included twice, or the tag also declared in Nucleus
    ; source). An *opaque* one — a `struct Tag;` forward declaration seen earlier,
    ; which is the order real C headers use — is upgraded IN PLACE: the same
    ; StructDef*, so every `ptr:Tag` Type already handed out gains the layout too.
    (let (existing:ptr (lookup-struct tag-name))
      (when (!= existing null)
        (let (esd:ptr:StructDef (as ptr:StructDef existing))
          (when (= (esd opaque) 0) (return existing))
          (cheader-struct-define esd fnames ftypes nfields is-union)
          (struct-upgrade-aliases esd)
          (return existing))))
    (let (sd:ptr:StructDef (register-struct (arena-strdup tag-name)))
      (.set! sd src-file g-cheader-file)
      (.set! sd src-line decl-line)
      (cheader-struct-define sd fnames ftypes nfields is-union)
      (return sd)))))

; Parse a top-level `struct Tag {...};`, `union Tag {...};`, or
; `typedef struct|union [Tag] {...} Name;`.
; Returns 1 if a definition was consumed, 0 if the caller should fall back.
(defn c-parse-struct-decl (buf:ptr pos:i64 len:i64 out-end:ptr:i64 line:i32):i32
  (let (is-typedef:i32 0
        is-union:i32 0
        te:i64 0
        tok:ptr (c-read-ident buf pos len (as ptr:i64 (addr-of te))))
    (cond
      (= (strcmp tok "typedef") 0)
        (do (set! is-typedef 1) (set! pos te))
      (= (strcmp tok "struct") 0)
        (set! pos te)
      (= (strcmp tok "union") 0)
        (do (set! is-union 1) (set! pos te))
      true
        (do (ptr-set! out-end pos) (return 0)))
    (when (!= is-typedef 0)
      (set! pos (c-skip-ws buf pos len))
      (let (te2:i64 0
            t2:ptr (c-read-ident buf pos len (as ptr:i64 (addr-of te2))))
        (cond
          (= (strcmp t2 "struct") 0) 0
          (= (strcmp t2 "union") 0) (set! is-union 1)
          true (do (ptr-set! out-end pos) (return 0)))
        (set! pos te2)))
    ; After 'struct': optional tag, then optional body.
    (set! pos (c-skip-ws buf pos len))
    (let (tag:ptr null
          tag-end:i64 0
          tag-line:i32 (cheader-line-at buf pos)
          maybe-tag:ptr (c-read-ident buf pos len (as ptr:i64 (addr-of tag-end))))
      (when (!= (as i64 (strlen maybe-tag)) 0)
        (set! tag maybe-tag)
        (set! pos tag-end)
        (set! pos (c-skip-ws buf pos len)))
      ; W3a (cheader.md §1.6): no '{' means no body here. `struct Foo;` /
      ; `typedef struct Foo Bar;` is C's opaque-handle idiom — the type NAME is
      ; real even though its layout is not, and skipping the declaration outright
      ; (the pre-W3a behavior) is what made every SDL handle type and `FILE`
      ; unusable. Register the tag (and, for a typedef, the alias) as opaque so
      ; `ptr:Foo` resolves; a by-value use is refused later with this header:line.
      (when (or (>= pos len) (!= (char-at buf pos) 123))
        (when (= tag null)
          (ptr-set! out-end pos) (return 0))
        (let (tag-sd:ptr (cheader-register-opaque tag tag-line is-union null))
          (when (>= pos len)
            (ptr-set! out-end pos) (return 0))
          (if (!= is-typedef 0)
            ; `typedef struct Foo Bar;` — Bar is a second opaque entry sharing
            ; Foo's (future) layout through alias-of. When Bar spells the same
            ; name as Foo (`typedef struct Mix_Music Mix_Music;`, the common
            ; idiom) cheader-register-opaque finds the tag entry and returns it
            ; untouched.
            (let (ne:i64 0
                  tname:ptr (c-read-ident buf pos len (as ptr:i64 (addr-of ne))))
              (when (= (as i64 (strlen tname)) 0)
                ; Not a plain identifier — `*Bar`, `(*fp)(…)`, an array
                ; declarator. The tag is registered; the declaration itself is
                ; a shape we do not model, so fall back to the caller's skip.
                (ptr-set! out-end pos) (return 0))
              (cheader-register-opaque tname tag-line is-union (as raw:StructDef tag-sd))
              (set! pos ne))
            ; Plain `struct Foo;`. Anything else after the tag (a `*` declarator,
            ; a variable name, a function declarator) is not a forward declaration.
            (when (!= (char-at buf pos) 59)
              (ptr-set! out-end pos) (return 0)))
          (set! pos (c-skip-ws buf pos len))
          (when (and (< pos len) (= (char-at buf pos) 59))
            (set! pos (+ pos 1)))
          (ptr-set! out-end pos)
          (return 1)))
      (let (body-end:i64 0
            sd:ptr (c-parse-struct-body buf pos len
                                        (as ptr:i64 (addr-of body-end))
                                        (if (!= is-typedef 0) null tag) is-union))
        (set! pos body-end)
        ; W3a: a `typedef struct Tag { … } Name;` parses its body ANONYMOUSLY
        ; (memoized by shape) and never registers `Tag` itself — so when `Tag`
        ; was forward-declared earlier in the header it would stay opaque
        ; forever. Adopt the shape into it (and into its own aliases) here.
        (when (and (!= sd null) (!= is-typedef 0) (!= tag null))
          (let (tsd:ptr (lookup-struct tag))
            (when (!= tsd null)
              (let (tsd2:ptr:StructDef (as ptr:StructDef tsd))
                (when (!= (tsd2 opaque) 0)
                  (cheader-adopt-shape tsd2 (as ptr:StructDef sd))
                  (struct-upgrade-aliases tsd2))))))
        ; For typedef, the typedef name comes after the body and may
        ; differ from the inner tag. Register a separate StructDef
        ; under the typedef name pointing at the same shape — but if
        ; sd is null (skipped body) we just consume to ';'.
        (set! pos (c-skip-ws buf pos len))
        (when (!= is-typedef 0)
          (let (ne:i64 0
                tname:ptr (c-read-ident buf pos len (as ptr:i64 (addr-of ne))))
            (when (and (!= sd null)
                       (!= (as i64 (strlen tname)) 0))
              ; Register as a second alias if not already known. W3a: an entry
              ; that already exists because the alias name was forward-declared
              ; opaque is upgraded in place instead of being skipped.
              (let (prior:ptr (lookup-struct tname))
                (if (= prior null)
                  (let (alias:ptr:StructDef (register-struct (arena-strdup tname)))
                    (.set! alias alias-of (as raw:StructDef sd))
                    (.set! alias src-file g-cheader-file)
                    (.set! alias src-line tag-line)
                    (cheader-adopt-shape alias (as ptr:StructDef sd)))
                  (let (psd:ptr:StructDef (as ptr:StructDef prior))
                    (when (!= (psd opaque) 0)
                      (cheader-adopt-shape psd (as ptr:StructDef sd)))))))
            (when (!= (as i64 (strlen tname)) 0)
              (set! pos ne))))
        ; Skip trailing __attribute__ if any.
        (set! pos (c-skip-ws buf pos len))
        (let (attr-check:i32 1)
          (while (!= attr-check 0)
            (set! attr-check 0)
            (let (ae:i64 0
                  at:ptr (c-read-ident buf pos len (as ptr:i64 (addr-of ae))))
              (when (= (strcmp at "__attribute__") 0)
                (set! pos (c-skip-ws buf ae len))
                (when (and (< pos len) (= (char-at buf pos) 40))
                  (set! pos (c-skip-parens buf pos len)))
                (set! pos (c-skip-ws buf pos len))
                (set! attr-check 1)))))
        ; Consume trailing semicolon.
        (when (and (< pos len) (= (char-at buf pos) 59))
          (set! pos (+ pos 1)))
        (ptr-set! out-end pos)
        (return 1)))))

; Stage 15 W3c (cheader.md §1.4): record a NON-aggregate top-level typedef —
; `typedef long int __off_t;`, `typedef __off_t off_t;`,
; `typedef unsigned char Uint8;`, `typedef char *string_t;`,
; `typedef int (*handler)(int);`, `typedef enum { … } E;`,
; `typedef struct Foo *FooPtr;`.
;
; Called only after `c-parse-struct-decl` has DECLINED the declaration, so every
; `typedef struct|union …` shape that introduces a named aggregate is handled
; there and cannot reach here — which is what keeps W3a's opaque-registration and
; in-place-upgrade paths untouched by this function.
;
; Returns 1 when the declaration was consumed. A name is recorded even when its
; type is not representable (recording null): that is how a later by-value use
; gets a located skip naming the type, instead of the pre-W3c silent `ptr`.
(defn c-parse-typedef-decl (buf:ptr pos:i64 len:i64 out-end:ptr:i64):i32
  (let (te:i64 0
        tok:ptr (c-read-ident buf pos len (as ptr:i64 (addr-of te))))
    (when (!= tok "typedef") (ptr-set! out-end pos) (return 0))
    (let (save-unrep:i32 g-cheader-unrep
          save-why:ptr g-cheader-unrep-why
          save-quiet:i32 g-cheader-unrep-quiet
          tend:i64 0
          bad:i32 0
          name:ptr null
          base:ptr null)
      ; c-parse-type's unrep channel is scoped to a FUNCTION declaration
      ; (c-parse-func-decl clears it at entry). A typedef is parsed outside one,
      ; so save/restore rather than let this parse leak a verdict sideways.
      (set! g-cheader-unrep 0)
      (set! base (c-parse-type buf (c-skip-ws buf te len) len
                               (as ptr:i64 (addr-of tend))))
      (when (!= g-cheader-unrep 0) (set! bad 1))
      (set! g-cheader-unrep save-unrep)
      (set! g-cheader-unrep-why save-why)
      (set! g-cheader-unrep-quiet save-quiet)
      (let (p:i64 (c-skip-ws buf tend len))
        ; `(*name)(args)` — a function-pointer typedef, which is a pointer
        ; whatever its return and argument types are. It has to be recognized
        ; HERE: the naive fallback would take `int` for the declarator of
        ; `typedef int (*handler)(int);` and the declaration would look like a
        ; function literally named `int` (the trap W3b recorded when it declined
        ; to extend the struct fallback to `typedef`).
        (when (and (< p len) (= (char-at buf p) 40))
          (let (q:i64 (c-skip-ws buf (+ p 1) len)
                stars:i32 0)
            (while (and (< q len) (= (char-at buf q) 42))
              (inc! stars)
              (set! q (c-skip-type-quals buf (+ q 1) len)))
            (let (ne:i64 0
                  fpn:ptr (c-read-ident buf q len (as ptr:i64 (addr-of ne))))
              (when (and (> stars 0) (!= (as i64 (strlen fpn)) 0))
                (set! name fpn)
                (set! base ty-ptr)
                (set! bad 0))))
          (set! p (c-skip-parens buf p len))
          (set! p (c-skip-ws buf p len))
          (when (and (< p len) (= (char-at buf p) 40))
            (set! p (c-skip-parens buf p len))))
        (when (= name null)
          (let (ne:i64 0
                dn:ptr (c-read-ident buf p len (as ptr:i64 (addr-of ne))))
            ; No declarator identifier — a shape not modelled at all. Decline, so
            ; nothing is recorded under a name that is not the declarator's.
            (when (= (as i64 (strlen dn)) 0)
              (ptr-set! out-end pos) (return 0))
            (set! name dn)
            (set! p ne)))
        (set! p (c-skip-ws buf p len))
        ; An array declarator (`typedef int v4[4];`). The element type is known,
        ; but this parser has no C array type and a by-value use would silently
        ; take the ELEMENT's ABI — record the name as known-but-unrepresentable.
        (when (and (< p len) (= (char-at buf p) 91)) (set! bad 1))
        ; A comma-separated declarator list (`typedef int a, *b;`) gives each
        ; declarator its own pointer depth, which a single-declarator parse
        ; cannot recover. Only the first is recorded; the rest stay unknown,
        ; which the by-value gate reports rather than mis-typing.
        (c-typedef-record name (if (!= bad 0) null base))
        (ptr-set! out-end (cheader-skip-to-semi buf p len))
        (return 1)))))

; ============================================================
; Stage 15 W3a: opaque-name pre-scan for the signature prescan
;
; prescan-defn-signatures resolves every defn signature in a unit BEFORE any
; import is processed, and prescan-imported-types deliberately skips C-string
; imports (running clang for every header would double the preprocessing cost of
; a build). That is exactly why `(defn play (m:ptr:Mix_Music):i32 …)` reported
; `unknown type: Mix_Music` — and it is unaffected by registering opaque types at
; import time, because the signature is resolved first. An opaque handle type in
; a signature is *the* thing a C library API wants, so this recovers the
; forward-declaration shapes ahead of the signature prescan.
;
; It is deliberately a NAME scan, not a second parse: only `struct X;` /
; `union X;` / `typedef struct X Y;` (no `{`) register anything. A declaration
; with a body is left entirely to the real import — which then upgrades these
; entries in place (cheader-adopt-shape / the opaque branch of
; c-parse-struct-body), so this pass emits no IR of its own and cannot change
; what a body-bearing declaration produces.
; ============================================================

; Advance past the end of the current declaration: the next `;` at brace depth 0,
; consuming balanced `{}` bodies whole. Linemarkers encountered on the way are
; recorded so provenance stays accurate across a multi-line declaration.
(defn cheader-skip-to-semi (buf:ptr pos:i64 len:i64):i64
  (let (p:i64 pos
        depth:i32 0
        done:i32 0)
    (while (and (= done 0) (< p len))
      (let (c:i32 (as i32 (char-at buf p)))
        (cond
          (= c 123) (do (inc! depth) (set! p (+ p 1)))
          (= c 125) (do (when (> depth 0) (set! depth (- depth 1)))
                        (set! p (+ p 1)))
          (= c 59)  (do (set! p (+ p 1)) (when (= depth 0) (set! done 1)))
          (= c 35)  (let (dstart:i64 p)
                      (while (and (< p len) (!= (char-at buf p) 10))
                        (set! p (+ p 1)))
                      (when (< p len) (set! p (+ p 1)))
                      (cheader-note-linemarker buf dstart p len))
          true      (set! p (+ p 1)))))
    (return p)))

; Skip a balanced `{ … }` starting at `pos` (which must be at `{`). Returns the
; position just past the matching `}`.
(defn cheader-skip-braces (buf:ptr pos:i64 len:i64):i64
  (let (p:i64 (+ pos 1)
        depth:i32 1)
    (while (and (< p len) (> depth 0))
      (let (c:i32 (as i32 (char-at buf p)))
        (when (= c 123) (inc! depth))
        (when (= c 125) (set! depth (- depth 1))))
      (set! p (+ p 1)))
    (return p)))

; Scan one top-level construct at `pos`, registering the type NAME it introduces.
; Returns the position to resume from.
;
; Which name is registered mirrors the real import exactly: the TAG of
; `struct Tag …` and the DECLARATOR of `typedef struct [Tag] {…} Name;`. That
; equality is what keeps this pass free of IR consequences — the real import then
; upgrades the same entry in place and writes the same single `%X = type {…}` it
; always did, rather than defining a second name.
(defn cheader-scan-opaque-decl (buf:ptr pos:i64 len:i64):i64
  (let (te:i64 0
        tok:ptr (c-read-ident buf pos len (as ptr:i64 (addr-of te)))
        is-typedef:i32 0
        is-union:i32 0
        p:i64 pos)
    ; Punctuation (not an identifier): step one character so the caller's loop
    ; always makes progress.
    (when (= (as i64 (strlen tok)) 0) (return (+ pos 1)))
    (set! p te)
    (when (= tok "typedef")
      (set! is-typedef 1)
      (set! p (c-skip-ws buf p len))
      (let (te2:i64 0
            t2:ptr (c-read-ident buf p len (as ptr:i64 (addr-of te2))))
        (when (and (!= t2 "struct") (!= t2 "union"))
          (return (cheader-skip-to-semi buf p len)))
        (when (= t2 "union") (set! is-union 1))
        (set! p te2)))
    (when (= is-typedef 0)
      (cond
        (= tok "struct") 0
        (= tok "union")  (set! is-union 1)
        true             (return (cheader-skip-to-semi buf p len))))
    ; Optional tag, then optional body.
    (set! p (c-skip-ws buf p len))
    (let (decl-line:i32 (cheader-line-at buf p)
          tend:i64 0
          tag:ptr (c-read-ident buf p len (as ptr:i64 (addr-of tend)))
          has-tag:i32 0)
      (when (!= (as i64 (strlen tag)) 0)
        (set! has-tag 1)
        (set! p (c-skip-ws buf tend len)))
      (when (>= p len) (return (cheader-skip-to-semi buf p len)))
      (if (= (char-at buf p) 123)
        ; Body present. Register the name the real import will define, so a defn
        ; signature may name a fully-defined C struct too (`ptr:Mix_Chunk`), not
        ; only an opaque handle.
        (do
          (set! p (cheader-skip-braces buf p len))
          (if (!= is-typedef 0)
            (let (ne:i64 0
                  dname:ptr (c-read-ident buf (c-skip-ws buf p len) len
                                          (as ptr:i64 (addr-of ne))))
              (when (!= (as i64 (strlen dname)) 0)
                (cheader-register-opaque dname decl-line is-union null)))
            (when (!= has-tag 0)
              (cheader-register-opaque tag decl-line is-union null))))
        ; No body.
        (when (!= has-tag 0)
          (if (!= is-typedef 0)
            ; `typedef struct X Y;` — register the tag, then Y as its alias. A
            ; non-identifier here (`*Y`, `(*fp)(…)`) is a pointer/function typedef
            ; we do not model, so only the tag is worth recording.
            (let (ne:i64 0
                  tname:ptr (c-read-ident buf p len (as ptr:i64 (addr-of ne)))
                  tag-sd:ptr (cheader-register-opaque tag decl-line is-union null))
              (when (!= (as i64 (strlen tname)) 0)
                (cheader-register-opaque tname decl-line is-union
                                         (as raw:StructDef tag-sd))))
            ; `struct X;` (a forward declaration) or a `struct X *…` use — the tag
            ; names a real type either way.
            (cheader-register-opaque tag decl-line is-union null))))
      (return (cheader-skip-to-semi buf p len)))))

; Pre-register a C header's opaque type names. Never emits IR, never registers a
; function, and never reports an error: a header that fails to preprocess here
; fails again (with a diagnostic) at the real import.
(defn cheader-prescan-opaque (header-path:ptr):void
  (let (buf-len:i64 0
        buf:ptr (cheader-preprocess header-path (as ptr:i64 (addr-of buf-len))))
    (when (= buf null) (return))
    (set! g-cheader-file (as CStr header-path))
    (set! g-cheader-dline 1)
    (set! g-cheader-dpos 0)
    (let (pos:i64 0
          prev:i64 -1)
      (while (< pos buf-len)
        (set! prev pos)
        (set! pos (c-skip-ws buf pos buf-len))
        (when (< pos buf-len)
          (if (= (char-at buf pos) 35)
            (let (dstart:i64 pos)
              (while (and (< pos buf-len) (!= (char-at buf pos) 10))
                (set! pos (+ pos 1)))
              (when (< pos buf-len) (set! pos (+ pos 1)))
              (cheader-note-linemarker buf dstart pos buf-len))
            (set! pos (cheader-scan-opaque-decl buf pos buf-len))))
        ; Progress guard (mirrors emit-c-include's): never spin.
        (when (<= pos prev) (set! pos (+ prev 1)))))))

(defn emit-c-include (header-path:ptr line:i32):void
  ; W3a: reset the linemarker provenance for this header. Until the first
  ; `# N "file"` marker is seen, attribute declarations to the header we were
  ; asked to import (never to line 0 — a `:0:` in a diagnostic is exactly what
  ; W4a's guard forbids).
  (set! g-cheader-file (as CStr header-path))
  (set! g-cheader-dline 1)
  (set! g-cheader-dpos 0)
  ; The preprocessed text is cached by path (cheader-preprocess) — the same header
  ; is imported by many library files, and the W3a name pre-scan reads it too.
  (let (buf-len:i64 0)
    (let (buf:ptr (cheader-preprocess header-path (as ptr:i64 (addr-of buf-len))))
      (when (= buf null)
        (die-at line (fmt-s "c-include: failed to preprocess '%s'" header-path)))
      ; Parse declarations
      (let (pos:i64 0
            prev-pos:i64 -1)
        (while (< pos buf-len)
          (set! prev-pos pos)
          ; Skip whitespace
          (set! pos (c-skip-ws buf pos buf-len))
          (when (< pos buf-len)
            (if (= (char-at buf pos) 35)
              ; Skip # line directives. W3a: record the linemarker first, so a
              ; declaration parsed below can be attributed to the real header and
              ; line rather than to the .nuc file that imported it.
              (let (dstart:i64 pos)
                  (while (and (< pos buf-len) (!= (char-at buf pos) 10))
                    (set! pos (+ pos 1)))
                  (when (< pos buf-len)
                    (set! pos (+ pos 1)))
                  (cheader-note-linemarker buf dstart pos buf-len))
              ; Try to read an identifier to check what kind of declaration
              (let (tok-end:i64 0
                    tok:ptr (c-read-ident buf pos buf-len (as ptr:i64 (addr-of tok-end))))
                ; Skip typedefs, static inline functions, etc.
                ; Process extern/implicit function declarations and top-level type declarations.
                ; musl (Alpine ARM64) omits `extern` on function declarations, so we try
                ; c-parse-func-decl for any non-struct/union/typedef token.
                ;
                ; Stage 15 W3b: the `true` clause used to sit OUTSIDE this cond — a
                ; stray `)` (introduced with union support) closed the cond after the
                ; struct branch, leaving `true` as a no-op statement and running the
                ; function-declaration parse *unconditionally*. So every top-level
                ; struct/union/typedef was followed, in the same iteration, by a
                ; function parse starting at whatever whitespace the struct parse
                ; stopped on. Two consequences: the declaration after a type
                ; declaration was attributed to the type declaration's line (the W3b
                ; skip warning's `header:line` was short by the intervening blank
                ; lines), and a second forward declaration immediately after a first
                ; (`struct Foo;` / `struct Bar;`) was consumed by the function parse's
                ; not-a-function fallback without ever being registered.
                (cond
                  ; W3c: glibc writes `__extension__ typedef long long int
                  ; __quad_t;` for every type it defines with a `long long`, so
                  ; without this the whole `__quad_t`/`__u_quad_t` family (and
                  ; anything typedef'd from them) stayed unresolved. Consume the
                  ; keyword and re-dispatch on the token that follows; the loop's
                  ; progress guard covers the no-advance case.
                  (= tok "__extension__")
                    (set! pos tok-end)
                  (or (= tok "union") (or (= tok "struct") (= tok "typedef")))
                    ; struct/union/typedef -> layout.
                    (let (decl-end:i64 0
                          ok:i32 (c-parse-struct-decl buf pos buf-len
                                                      (as ptr:i64 (addr-of decl-end)) line))
                      (if (!= ok 0)
                        (set! pos decl-end)
                        ; W3c: not an aggregate declaration. A scalar / pointer /
                        ; function-pointer / enum typedef is recorded here
                        ; (cheader.md §1.4); anything else falls through to the
                        ; function parser and then to the original
                        ; skip-to-semicolon.
                        (let (td-end:i64 0
                              tdok:i32 (c-parse-typedef-decl buf pos buf-len
                                                             (as ptr:i64 (addr-of td-end))))
                          (if (!= tdok 0)
                            (set! pos td-end)
                            ; W3c: a declaration whose first token is
                            ; `struct`/`union` but which is a FUNCTION —
                            ; `struct Tag *f(int);` written without `extern`.
                            ; The type parser registers the tag and declines, and
                            ; before this the declaration was then silently
                            ; dropped: nothing is synthesized, so W3b's gate
                            ; cannot see it either. Invisible on glibc, which
                            ; always writes `extern`; musl deliberately omits it
                            ; (context/build.md), so on Alpine this dropped every
                            ; function returning a `struct X *`.
                            ;
                            ; Restricted to the `struct`/`union` tokens, per
                            ; W3b's note: running the function parser for
                            ; `typedef` too would read `typedef int (*h)(int);`
                            ; as a function literally named `int`. `typedef` has
                            ; already had its own parser above.
                            (let (fn-end:i64 0
                                  fnok:i32 (if (= tok "typedef") 0
                                             (c-parse-func-decl buf pos buf-len
                                               (as ptr:i64 (addr-of fn-end)) line)))
                              (if (!= fnok 0)
                                (set! pos fn-end)
                                (do ; Neither a type nor a function — skip to `;`
                                 (while (and (< pos buf-len) (!= (char-at buf pos) 59))
                                   (set! pos (+ pos 1)))
                                 (when (< pos buf-len)
                                      (set! pos (+ pos 1))))))))))
                  true
                    ; Try function declaration (handles both `extern int foo(...)` and
                    ; bare `int foo(...)` — c-parse-type skips `extern` internally).
                    (let (decl-end:i64 0
                          ok:i32 (c-parse-func-decl buf pos buf-len
                                                    (as ptr:i64 (addr-of decl-end)) line))
                      (if (!= ok 0)
                        (set! pos decl-end)
                        ; Not a function — skip to semicolon or next line
                        (do (while (and (< pos buf-len)
                                        (and (!= (char-at buf pos) 59)
                                             (!= (char-at buf pos) 10)))
                              ; Skip balanced braces (struct/enum bodies)
                              (when (= (char-at buf pos) 123)
                                (let (brace-depth:i32 1)
                                  (set! pos (+ pos 1))
                                  (while (and (< pos buf-len) (> brace-depth 0))
                                    (when (= (char-at buf pos) 123) (inc! brace-depth))
                                    (when (= (char-at buf pos) 125)
                                      (set! brace-depth (- brace-depth 1)))
                                    (set! pos (+ pos 1)))))
                              (when (and (< pos buf-len)
                                         (and (!= (char-at buf pos) 123)
                                              (and (!= (char-at buf pos) 59)
                                                   (!= (char-at buf pos) 10))))
                                (set! pos (+ pos 1))))
                            (when (< pos buf-len)
                              (set! pos (+ pos 1))))))))))          ; Safety: if pos didn't advance, force it forward to avoid infinite loop
          (when (= pos prev-pos)
            (set! pos (+ pos 1)))))  ; closes when, while
      ; W3a: `buf` belongs to the cheader-preprocess cache now — it is shared with
      ; every other import of this header and with the opaque name pre-scan, so it
      ; must NOT be freed here (the former `(free buf)` left every later reader
      ; walking freed memory).
      )                                         ; let(pos) close, in let(buf)
    (fprintf g-out "\n")))                      ; let(buf-len), defn

; ============================================================
; C header emission (--emit-cheader)
; ============================================================

; Non-zero when `s` is a word C or C++ reserves, so it cannot be spelled as an
; identifier. Stage 15 W9 item 28: `sanitize-for-c` maps illegal *characters* and
; has no notion of a reserved word, so `union`, `int` and `default` — all ordinary
; Nucleus names — passed through intact and the header did not parse.
;
; C++ is included, not only C. A generated header is routinely consumed through
; `extern "C"` from C++, and `new`, `delete`, `try`, `class`, `template`,
; `operator` and `namespace` are all names a Nucleus library plausibly defines;
; `try` is a Nucleus form. The iso646 spellings (`and`, `or`, `not`, `xor`, …) are
; here for the same reason — they are C++ keywords, and macros in C once
; <iso646.h> is included.
;
; One space-delimited string per family searched with `strstr`, rather than an
; array of literals: the padded needle makes the membership test exact, and each
; family stays one greppable line.
(defn cheader-reserved-word (s:ptr):i32
  (when (= s null) (return 0))
  (when (= (strlen s) 0) (return 0))
  (let (needle:ptr (fmt-s " %s " s))
    (when (!= (strstr " alignas alignof auto bool break case char const constexpr continue default do double else enum extern false float for goto if inline int long nullptr register restrict return short signed sizeof static static_assert struct switch thread_local true typedef typeof typeof_unqual union unsigned void volatile while _Alignas _Alignof _Atomic _BitInt _Bool _Complex _Generic _Imaginary _Noreturn _Static_assert _Thread_local " needle) null)
      (return 1))
    (when (!= (strstr " and and_eq asm bitand bitor catch char8_t char16_t char32_t class compl concept consteval constinit const_cast co_await co_return co_yield decltype delete dynamic_cast explicit export friend mutable namespace new noexcept not not_eq operator or or_eq private protected public reinterpret_cast requires static_cast template this throw try typeid typename using virtual wchar_t xor xor_eq " needle) null)
      (return 1))
    (return 0)))

; `s` with a trailing `_` when it is reserved, `s` unchanged otherwise. No
; reserved word ends in `_`, so one suffix always suffices — no loop. A
; collision with a real `union_` in the same header is possible in principle and
; would be a duplicate declaration, which the C compiler reports; silently
; emitting the keyword is the failure this avoids.
(defn cheader-escape-reserved (s:ptr):ptr
  (when (= (cheader-reserved-word s) 0) (return s))
  (return (fmt-s "%s_" s)))

; Stage 15 W9 item 4: the C spelling of a Nucleus name. `sanitize-for-c` maps
; every character C does not allow in an identifier to `_`, so `a-field` becomes
; `a_field`. Null-safe because several callers read a name out of a malformed
; form and print whatever they got.
;
; W9 item 28: and then escapes a reserved word, because a legal identifier is
; more than a legal character sequence. Every complete C identifier this emitter
; prints goes through here — including a struct/union tag, via the `ns-ir-base`
; callers — so the rule holds in one place instead of per call site.
;
; This is the spelling for names the LINKER NEVER SEES — struct fields, function
; parameters, `defunion` arm names, enum tags, `#define` constants. For a name the
; linker does resolve, sanitizing alone silently breaks the binding; use
; `cheader-asm-label` with it, which then picks up the `_` escape for free (the
; escaped spelling differs from the symbol, so the label appears exactly when it
; must). See the W9 item 4 and 28 notes in
; design/stage15-stress-test/progress.md.
(defn cheader-c-ident (name:(raw i8)):ptr
  (when (= name null) (return (as ptr name)))
  (return (cheader-escape-reserved (sanitize-for-c (as ptr name)))))

; The C spelling of a name that is emitted as one identifier JOINED from two
; parts — `enum Color { Color_red }`, and a defunion's `Foo_arm` tag constants.
; The escape belongs on the join, not on either part: `Color_default` is a
; perfectly good identifier, and escaping the fragment would rename it for no
; reason. The join can still land on a keyword (`and` + `eq`), so it is tested.
(defn cheader-c-ident-join (prefix:ptr member:(raw i8)):ptr
  (when (= member null) (return prefix))
  (return (cheader-escape-reserved
            (fmt-2s "%s_%s" prefix (sanitize-for-c (as ptr member))))))

; The `asm("…")` suffix that re-binds a sanitized C declaration to the symbol the
; object actually defines, or "" when the sanitized spelling IS the symbol.
;
; A Nucleus link name keeps its hyphens (`(defn ch-get …)` emits `@ch-get`, and
; `nm` shows `T ch-get`), so a C declaration must both spell an identifier and
; name that symbol — two requirements one token cannot meet. Sanitizing alone
; yields a header that parses and then fails to LINK, which is strictly worse than
; one that fails to parse: the error moves away from its cause. The GCC/Clang
; asm-label extension is the only way C can name a hyphenated symbol.
;
; Deliberately empty when no mangling was needed, so a library whose names are
; already C-legal gets a fully portable header and the extension appears exactly
; where it is load-bearing.
(defn cheader-asm-label (link:ptr cname:ptr):ptr
  (when (= (strcmp cname link) 0) (return ""))
  (return (fmt-s " asm(\"%s\")" link)))

; The linker symbol behind an ir-name: the same string without its leading `@`
; sigil. Stage 15 W9 item 26 — the generic registry stores ir-names (`@eq.String
; .String`), the C `asm` label wants the bare symbol, and no caller may hand a
; sigil through to a declaration.
(defn cheader-strip-sigil (irname:ptr):ptr
  (when (= irname null) (return null))
  (let (n:i64 (strlen irname))
    (when (or (= n 0) (!= (bit-and (as i32 (aref (as ptr:i8 irname) 0)) 255) 64))
      (return irname))
    (let (s:ptr (arena-alloc n)
          i:i64 1)
      (while (< i n)
        (aset! (as ptr:i8 s) (- i 1) (aref (as ptr:i8 irname) i))
        (set! i (+ i 1)))
      (aset! (as ptr:i8 s) (- n 1) 0)
      (return s))))

(defn type-name-to-c (name:ptr):ptr
  (when (= name "void")  (return "void"))
  (when (= name "i1")    (return "_Bool"))
  (when (= name "i8")    (return "int8_t"))
  (when (= name "i16")   (return "int16_t"))
  (when (= name "i32")   (return "int32_t"))
  (when (= name "int")   (return "int32_t"))
  (when (= name "i64")   (return "int64_t"))
  (when (= name "ui8")   (return "uint8_t"))
  (when (= name "ui16")  (return "uint16_t"))
  (when (= name "ui32")  (return "uint32_t"))
  (when (= name "ui64")  (return "uint64_t"))
  (when (= name "f32")   (return "float"))
  (when (= name "f64")   (return "double"))
  (when (= name "bool")  (return "_Bool"))
  ; Stage 11 T0's pointer-sized integers. Without these the fallthrough below
  ; assumed "struct", so every signature naming one emitted `struct usize` — a
  ; type that does not exist, silently unparseable, and recorded as a known
  ; `--emit-cheader` defect in design/stage15-stress-test/cheader.md (14 of the
  ; committed lib/*.h carried it). W9 item 3 made it load-bearing rather than
  ; merely latent: `lib/keyword.nuc`'s `g-keyword-count` is a `usize` GLOBAL, and
  ; a broken `extern` line is exactly what that item exists to stop emitting.
  ; `size_t`/`ptrdiff_t` rather than `uintptr_t`/`intptr_t` — these are the types
  ; of counts and indices, which is what usize/ssize are used for; both are
  ; pointer-sized on every target the compiler supports.
  (when (= name "usize") (return "size_t"))
  (when (= name "ssize") (return "ptrdiff_t"))
  ; Stage 15 W9 item 25 (measured, a SECOND cause of the same broken headers):
  ; `Char` and `Err` are builtin scalars — `union-registry.nuc` resolves both by
  ; name and they lower to `i32` (verified: `define i64 @char-utf8-len(i32 %c.arg)`).
  ; The Type-keyed renderer `type-to-c` has always answered `uint32_t`/`int32_t`
  ; for them; this name-keyed one did not, so the fallthrough assumed "struct" and
  ; every signature mentioning one emitted `struct Char` / `struct Err` — a tag no
  ; header defines, which is why tagging the typedef does not rescue `char.h` or
  ; `error.h`. Same trap as usize/ssize above; the two renderers must agree.
  (when (= name "Char")  (return "uint32_t"))
  (when (= name "Err")   (return "int32_t"))
  (when (= name "CStr")  (return "const char*"))
  (when (= name "ptr")   (return "void*"))
  ; Assume struct type — sanitize the name for C. `ir-name-token` first maps the
  ; two LLVM/C-illegal-but-Nucleus-legal symbol chars (`?`→_QMARK, `!`→_BANG) so a
  ; `?`/`!`-named struct references its real linkable symbol; `sanitize-for-c` then
  ; blanket-maps the remaining C-illegal chars (dots from stamped parametric
  ; instances like Vector.i32 become underscores: Vector_i32). Order matters:
  ; ir-name-token must run before the blanket map, or `?` would collapse to `_`
  ; and collide (SM-3). For a name with no `?`/`!` ir-name-token is a pointer-
  ; identity no-op, so existing headers stay byte-identical.
  ; Stage 15 B3′: `ns-ir-base` (not bare `ir-name-token`) so a reference to a
  ; namespaced type spells the same C identifier its typedef does — see
  ; emit-cheader-defstruct. Identity under `user`.
  ; W9 item 28: through `cheader-c-ident`, so a type named `union` or `class` is
  ; escaped here exactly as at its definition. A tag is an identifier too, and
  ; `struct union {…}` does not parse.
  (return (fmt-s "struct %s" (cheader-c-ident (as raw:i8 (ns-ir-base name))))))

; Convert a type AST node to a C type string. Handles SYM types and
; (ptr T) / (ptr ptr T) ... lists.
; A niche `!ptr:T` / `?ptr:T` (design/stage10/unions.md §6 rules 2/3) is a bare
; pointer to T — to C it IS a `T*`, with the reserved top page used for error /
; none sentinels (errors.md §2/§8). Render it as `T*` with a documented comment
; rather than the generic `void*`, so the C header is legible. `s` is the type
; spelling; returns the C rendering, or null if it is not a niche sugar symbol.
(defn niche-sym-to-c (s:ptr):ptr
  (let (c0:i32 (char-at s 0))
    (when (and (!= c0 33) (!= c0 63)) (return null))   ; not ! or ?
    ; The payload must be a pointer spelling: !ptr:T / ?ptr:T / !ref:T / ?ref:T.
    (let (rest:ptr (unsafe/ptr+ (as ptr:i8 s) 1))
      (when (= (strncmp rest "ptr:" 4) 0)
        (let (elem:ptr (type-name-to-c (unsafe/ptr+ (as ptr:i8 rest) 4)))
          (return (fmt-s "%s* /* niche: reserved top page = error/none */" elem))))
      (when (= (strncmp rest "ref:" 4) 0)
        (let (elem:ptr (type-name-to-c (unsafe/ptr+ (as ptr:i8 rest) 4)))
          (return (fmt-s "%s* /* niche: reserved top page = error/none */" elem))))
      (return null))))

(defn type-node-to-c (tn:ptr):ptr
  (when (= tn null) (return "void"))
  (let (n:ptr:Node (unsafe/cast ptr:Node tn))
    (case (n kind)
      NODE-SYM
        (let (nc:ptr (niche-sym-to-c (n s)))
          (when (!= nc null) (return nc))
          (return (type-name-to-c (n s))))
      NODE-CELL
        (let (head:ptr (n car)
              rest:ptr (n cdr))
          (when (and (!= head null)
                     (and (= ((unsafe/cast ptr:Node head) kind) NODE-SYM)
                          (= ((unsafe/cast ptr:Node head) s) "ptr")))
            (when (= rest null) (return "void*"))
            (let (inner:ptr null)
              (if (= ((unsafe/cast ptr:Node rest) cdr) null)
                (set! inner (type-node-to-c ((unsafe/cast ptr:Node rest) car)))
                (set! inner (type-node-to-c rest)))
              (return (fmt-s "%s*" inner))))
          ; Anonymous union: (union member:type ...) → inline `union { ... }`.
          (when (and (!= head null)
                     (and (= ((unsafe/cast ptr:Node head) kind) NODE-SYM)
                          (= ((unsafe/cast ptr:Node head) s) "union")))
            (let (acc:ptr "union { "
                  cur:ptr rest)
              (while (!= cur null)
                (let (member:ptr ((unsafe/cast ptr:Node cur) car)
                      mname:ptr null
                      mtname:ptr null)
                  (extract-name-type member (as ptr:ptr (addr-of mname)) (as ptr:ptr (addr-of mtname)))
                  (let (mtnode:ptr (extract-type-node member ((unsafe/cast ptr:Node member) line)))
                    ; W9 item 4: an inline union's member names are emitted here
                    ; rather than by emit-cheader-defstruct, so they need the same
                    ; sanitize its named fields get.
                    (set! acc (fmt-2s "%s%s" acc
                                (fmt-2s "%s %s; " (type-node-to-c mtnode)
                                  (cheader-c-ident (as raw:i8 mname)))))))
                (set! cur ((unsafe/cast ptr:Node cur) cdr)))
              (return (fmt-s "%s}" acc)))))
      0)
    (return "void*")))

; Extract the type AST node from a binding form.  Returns:
;   - for (name (ptr T)): the (ptr T) cell
;   - for (name T): the T sym
;   - for sym "name:T": a freshly-allocated sym node holding "T"
;   - null if no type
(defn extract-type-node (binding:(raw Node) line:i32):ptr
  (when (= binding null) (return null))
  (let (n:ptr:Node (unsafe/cast ptr:Node binding))
    (case (n kind)
      NODE-SYM
        (let (tname:ptr null  bname:ptr null)
          (split-typed (n s) (as ptr:ptr (addr-of bname)) (as ptr:ptr (addr-of tname)))
          (when (= tname null) (return null))
          (let (tn:ptr:Node (as ptr:Node (alloc-node)))
            (.set! tn kind NODE-SYM)
            (.set! tn line line)
            (.set! tn s tname)
            (return (as ptr tn))))
      NODE-CELL
        (let (rest:ptr (n cdr))
          (when (= rest null) (return null))
          (return ((unsafe/cast ptr:Node rest) car)))
      (return null))))

; Stage 15 W8 G-2: is this type node an `(array T N)`? Returns the node itself
; (so the caller can read the element type and the extent) or null.
(defn cheader-array-field-node (tn:(raw Node)):ptr
  (when (= tn null) (return null))
  (let (n:ptr:Node (unsafe/cast ptr:Node tn))
    (when (!= (n kind) NODE-CELL) (return null))
    (when (!= (node-len (as ptr n)) 3) (return null))
    (let (hd:(raw Node) (node-at (as ptr n) 0))
      (when (or (= hd null) (!= (hd kind) NODE-SYM)) (return null))
      (when (!= (as ptr hd) (as ptr 'array)) (return null))
      (return (as ptr n)))))

; The extent text of an `(array T N)` node, for the C declarator's `[...]`.
;
; Tries the SAME constant folder the type parser uses, so a literal (and any
; constant that is registered by the time the header is emitted) exports as a
; number. A bare NAME that does not fold is exported VERBATIM rather than
; refused: this file's own `defconst`s are deliberately not prescanned into the
; value scope (see emit-cheader-header), and each IS exported as a `#define` by
; emit-cheader-defconst, so `int32_t names[N];` is correct C and keeps the
; symbolic size the source wrote. An imported constant does fold, which is the
; right answer for one this header cannot `#define`. Anything else (a computed
; length whose constants this pass cannot see) is a located error, never a guess.
(defn cheader-array-extent (an:ptr encl:i32):CStr
  (let (len:i64 0
        lnn:ptr (node-at an 2)
        lline:i32 (node-line lnn encl))
    (when (!= (const-fold-int (as raw:Node lnn)
                              (as ptr:i64 (addr-of len))
                              lline) 0)
      (return (as CStr (fmt-i64 "%ld" len))))
    ; W9 item 4: sanitized, because this extent must name the `#define`
    ; emit-cheader-defconst emits — and that one is sanitized too. A hyphenated
    ; constant would otherwise give `int32_t xs[MY-LEN];` against `#define MY_LEN`.
    (let (ln:ptr:Node (unsafe/cast ptr:Node lnn))
      (when (= (ln kind) NODE-SYM) (return (as CStr (cheader-c-ident (as raw:i8 (ln s)))))))
    (die-at lline "--emit-cheader: (array T N): length must be a literal, a named constant, or a constant expression over them")
    (return c"")))

(defn emit-cheader-defstruct (form:ptr):void
  ; Skip parametric templates: (defstruct (Name T...) ...) has a list at
  ; position 1, not a sym. Templates define no concrete C type.
  (when (!= ((unsafe/cast ptr:Node (node-at form 1)) kind) NODE-SYM) (return))
  ; ir-name-token first (`?`→_QMARK / `!`→_BANG), then the blanket C sanitize; see
  ; type-name-to-c. A no-op for names without `?`/`!`, so headers stay byte-identical.
  ;
  ; Stage 15 B3′: `ns-ir-base` composes the library's namespace ir-prefix, exactly
  ; as `emit-cheader-declare` already does for a function name. R1 makes it
  ; necessary: two namespaces may now both define `Pt`, and without the prefix
  ; their generated headers would both declare `typedef struct {…} Pt;` — a C
  ; collision the moment a program includes both. Identity under `user`, so every
  ; existing header is byte-identical.
  ; W9 item 28: `cheader-c-ident` — the tag and typedef of a struct named `union`
  ; must be escaped, in lockstep with every reference to it (type-name-to-c).
  (let (name:ptr (cheader-c-ident (as raw:i8 (ns-ir-base ((unsafe/cast ptr:Node (node-at form 1)) s))))
        nfields:i32 (- (node-len form) 2))
    (check-ir-name-legal ((unsafe/cast ptr:Node (node-at form 1)) line) ((unsafe/cast ptr:Node (node-at form 1)) s) name)
    ; Stage 15 W9 item 25: TAG the struct. `type-name-to-c` spells every reference
    ; to a user type `struct NAME`, so an anonymous typedef leaves `struct NAME` a
    ; never-completed tag and every BY-VALUE use of the type fails — a field
    ; (`struct Rec r;` — "field has incomplete type") and a parameter alike, in a
    ; header the compiler emitted for exactly that purpose. Tag and typedef may
    ; share a spelling (separate C namespaces), so both work afterwards and the
    ; reference spelling needs no special case.
    (printf "typedef struct %s {\n" name)
    (dotimes (i nfields)
      (let (field:ptr (node-at form (+ i 2))
            fname:ptr null
            tname:ptr null)
        (extract-name-type field (as ptr:ptr (addr-of fname)) (as ptr:ptr (addr-of tname)))
        (let (tnode:ptr (extract-type-node field ((unsafe/cast ptr:Node field) line)))
          (when (!= tnode null)
            ; Stage 15 W8 G-2: C's array declarator is postfix, so an
            ; `(array T N)` field is `T name[N];` — the element type before the
            ; name and the extent after it.
            (let (an:ptr (cheader-array-field-node tnode)
                  fc:ptr (cheader-c-ident (as raw:i8 fname)))
              (if (!= an null)
                (printf "    %s %s[%s];\n"
                  (type-node-to-c (node-at an 1)) fc
                  (cheader-array-extent an ((unsafe/cast ptr:Node field) line)))
                (printf "    %s %s;\n" (type-node-to-c tnode) fc)))))))
    (printf "} %s;\n\n" name)))

; A defunion-template instance type ((Result i64 i32)) has no C spelling yet —
; the instance struct is not exported, and mapping it to void* would emit an
; ABI-wrong signature (the value is really a by-value tagged struct). Detect it
; so the declare can be skipped honestly.
(defn cheader-template-instance (tn:(raw Node)):i32
  (when (= tn null) (return 0))
  (let (n:ptr:Node (unsafe/cast ptr:Node tn))
    (when (!= (n kind) NODE-CELL) (return 0))
    (let (head:ptr:Node (unsafe/cast ptr:Node (n car)))
      (when (= (as ptr head) null) (return 0))
      (when (!= (head kind) NODE-SYM) (return 0))
      (when (!= (union-template-lookup-ref (head s)) null) (return 1))
      (return 0))))

; L8: detect a capturing-closure environment type OR a type-erased box type in a
; signature's type AST. Closure env structs are compiler-generated __vfn_env_N
; (fn-make-env-struct). Type-erased box types are (BoxedFn …) and (dyn P) — fat
; pointers carrying Nucleus-side Drop/vtable semantics with no faithful C spelling.
; None of these is C-callable, so a public defn exposing one — by value, or via a
; (ref ...)/(ptr ...) indirection — is excluded from --emit-cheader and warned at
; its definition. A plain `fn`/function-pointer type is NOT a closure type (it
; is C-ABI). Returns 1 if `tn` mentions such a type, else 0. Unwraps arbitrary
; (ref T)/(ptr T) nesting down to the base type symbol.
(defn cheader-mentions-closure (tn:(raw Node)):i32
  (let (cur:ptr tn)
    (while (!= cur null)
      (let (n:ptr:Node (unsafe/cast ptr:Node cur))
        (case (n kind)
          NODE-SYM
            (do
              (when (= (strncmp (n s) "__vfn_env_" 10) 0) (return 1))
              (return 0))
          NODE-CELL
            (let (head:ptr:Node (unsafe/cast ptr:Node (n car)))
              (when (or (= (as ptr head) null) (!= (head kind) NODE-SYM)) (return 0))
              (let (hs:ptr (head s))
                ; Type-erased box types: (BoxedFn …) and (dyn P) carry fat-pointer
                ; Nucleus semantics with no faithful C spelling.
                (when (or (= hs "BoxedFn") (= hs "dyn")) (return 1))
                (when (and (!= hs "ptr") (!= hs "ref")) (return 0))
                (let (rest:ptr (n cdr))
                  (when (= rest null) (return 0))
                  (if (= ((unsafe/cast ptr:Node rest) cdr) null)
                    (set! cur ((unsafe/cast ptr:Node rest) car))
                    (set! cur rest)))))
          (return 0))))
    (return 0)))

; The C-header return-type node of a defn form, honoring both signature styles:
; legacy (`name:ret` / `(name ret)`) recovers it from the name node; new style
; (S1) takes the index-3 operand, normalized so a keyword ret reads as a symbol
; type node for type-node-to-c.
(defn cheader-defn-ret-node (form:(raw Node)):ptr
  (let (name-node:ptr (node-at form 1))
    (when (= (sig-name-is-bare name-node) 0)
      (return (extract-type-node name-node ((unsafe/cast ptr:Node name-node) line))))
    ; New style: the return operand is at index 3. type-node-to-c needs the nested
    ; type-node form, so a colon-chain spelling (`ptr:Pt`) is split into `(ptr Pt)`
    ; exactly as the legacy desugar path yields it; a plain spelling stays a symbol
    ; node; a parenthesized list-form return is used verbatim.
    (let (rn:ptr:Node (unsafe/cast ptr:Node (node-at form 3)))
      (when (or (= (rn kind) NODE-KEYWORD) (= (rn kind) NODE-SYM))
        (when (!= (strchr (rn s) 58) null)
          (return (split-colon-segments (rn s) (rn line))))
        (return (normalize-ret-node (as ptr rn))))
      (return (as ptr rn)))))

(defn emit-cheader-declare (form:ptr):void
  ; (defn name:rettype (params...) ...)  /  (defn name (params...) rettype ...)
  (let (name-node:ptr (node-at form 1)
        fname:ptr null
        ret-name:ptr null)
    (extract-name-type name-node (as ptr:ptr (addr-of fname)) (as ptr:ptr (addr-of ret-name)))
    ; Skip generic templates (the same predicate the prescan/emit-defn skip
    ; already use — src/generics.nuc): a bare tyvar has no C spelling, so
    ; emitting one here previously produced garbage C in both defn-signature
    ; styles (defn-signature.md follow-up).
    (when (!= (defn-is-generic-template form) 0)
      (printf "/* %s: generic template; not exported */\n" fname)
      (return))
    ; Skip signatures mentioning template-instance types (no C spelling yet).
    (let (skip:i32 (cheader-template-instance
                     (cheader-defn-ret-node form))
          params0:ptr (node-at form 2)
          np:i32 (node-len (node-at form 2)))
      (dotimes (pi np)
        (when (!= (cheader-template-instance
                    (extract-type-node (node-at params0 pi)
                                       ((unsafe/cast ptr:Node (node-at params0 pi)) line))) 0)
          (set! skip 1)))
      (when (!= skip 0)
        (printf "/* %s: uses a defunion-template instance type; not exported */\n" fname)
        (return)))
    ; L8: exclude public defns whose signature exposes a capturing-closure env
    ; type (__vfn_env_N) or a type-erased box type (BoxedFn/dyn) — not C-callable.
    ; A plain fn pointer is fine.
    (let (skip-cl:i32 (cheader-mentions-closure
                        (cheader-defn-ret-node form))
          clparams:ptr (node-at form 2)
          clnp:i32 (node-len (node-at form 2)))
      (dotimes (clpi clnp)
        (when (!= (cheader-mentions-closure
                    (extract-type-node (node-at clparams clpi)
                                       ((unsafe/cast ptr:Node (node-at clparams clpi)) line))) 0)
          (set! skip-cl 1)))
      (when (!= skip-cl 0)
        (printf "/* %s: exposes a closure or type-erased box type; not C-callable, omitted */\n" fname)
        (return)))
    ; Stage 12 N6: emit the C-legal mangled link name (`geom__area`) for a
    ; namespaced library. ns-ir-base composes g-current-ns's ir-prefix onto the
    ; bare name; identity under `user`, so existing headers are byte-identical.
    ;
    ; W9 item 4: the declaration's two halves — the opening `ret name(` and the
    ; closing `) asm("link");` — are emitted many lines apart with the parameters
    ; streamed between them, so both spellings are computed HERE, once. Deriving
    ; the label's copy separately is exactly how the two would drift.
    ;
    ; W9 item 26: ASK the registry, do not re-derive. `ns-ir-base` is the symbol
    ; only for a solitary non-operator `defn`; an overload takes a per-signature
    ; mangled name and an operator goes through `op-name-token` even when it is
    ; the sole user method (its generic always carries an intrinsic seed), so
    ; `lib/string.nuc`'s `=` links as `eq.String.String`. The registry decided
    ; that in `finalize-generics` and is the only thing that knows it; deriving a
    ; second answer here is how the header came to declare symbols no object
    ; defines. `defn-form-mangled-name` answers null for a solitary name, which is
    ; exactly when `ns-ir-base` is right.
    (let (link:ptr (cheader-strip-sigil (defn-form-mangled-name (as raw:Node form)))
          cname:ptr null)
      (when (= link null) (set! link (ns-ir-base fname)))
      (set! cname (cheader-c-ident (as raw:i8 link)))
      (let (rtnode:ptr (cheader-defn-ret-node form)
            ret-c:ptr "void")
        (when (!= rtnode null) (set! ret-c (type-node-to-c rtnode)))
        (printf "%s %s(" ret-c cname))
      (let (params:ptr (node-at form 2)
            n:i32 (node-len params))
        (when (= n 0) (printf "void"))
        (dotimes (i n)
          (when (!= i 0) (printf ", "))
          (let (p:ptr (node-at params i)
                pname:ptr null
                ptname:ptr null)
            (extract-name-type p (as ptr:ptr (addr-of pname)) (as ptr:ptr (addr-of ptname)))
            (let (ptnode:ptr (extract-type-node p ((unsafe/cast ptr:Node p) line))
                  pc:ptr (cheader-c-ident (as raw:i8 pname)))
              (if (!= ptnode null)
                (printf "%s %s" (type-node-to-c ptnode) pc)
                ; Complex type (e.g. function pointer) — emit as void*
                (when (!= pname null)
                  (printf "void* %s" pc)))))))
      (printf ")%s;\n" (cheader-asm-label link cname)))))

; Non-zero when this type node is one `type-node-to-c` would answer for by
; falling through to its `void*` default — i.e. a cell head it does not handle.
; A NODE-SYM is always fine (scalar, or a struct typedef name); a pointer cell is
; fine under all three spellings (`ptr` is spelled exactly, `raw`/`ref` land on
; `void*`, which is the right size and ABI). Every other cell — `(array T N)`, a
; struct/union template instance, a bare `(fn …)` — is refused.
(defn cheader-defvar-type-ok (tn:ptr):i32
  (let (n:ptr:Node (unsafe/cast ptr:Node tn))
    (when (= (n kind) NODE-SYM) (return 0))
    (when (!= (n kind) NODE-CELL) (return 1))
    (let (head:ptr (n car))
      (when (= head null) (return 1))
      (when (!= ((unsafe/cast ptr:Node head) kind) NODE-SYM) (return 1))
      (let (h:ptr ((unsafe/cast ptr:Node head) s))
        (when (= h "ptr") (return 0))
        (when (= h "raw") (return 0))
        (when (= h "ref") (return 0))
        (when (= h "union") (return 0))
        (return 1)))))

; Item 3 needed a BY-VALUE spelling here (`cheader-by-value-c`, which stripped the
; `struct ` prefix) because the typedef was anonymous, so `struct NAME` was an
; incomplete tag and `extern struct SR s;` failed the moment a field was touched.
; Item 25 tagged the typedef, so `type-node-to-c`'s one answer is now correct in
; both positions and the second spelling is gone.

; Stage 15 W9 item 3: export a public `defvar` as `extern T name;`, which is what
; docs/toplevel.md has always CLAIMED a global does ("visible to C consumers
; (`extern T name;`)") and what `--emit-nuch` has always done for the Nucleus side
; (`(extern (g i32))`). The dispatch had no `defvar` arm at all, so a C consumer
; could reach a library's functions and none of its state.
;
; **The C name is not simply the sanitized name, and this is the whole design.**
; A global's link symbol keeps its hyphens — `(defvar ch-count:i32 7)` emits
; `@ch-count`, and `nm` shows `D ch-count` — while `ch-count` is not a C
; identifier. Sanitizing it to `ch_count` produces a header that PARSES and then
; fails to link (`undefined reference to 'ch_count'`, measured), which is strictly
; worse than one that fails to parse: the error moves away from its cause. So a
; name that needs sanitizing carries an `asm("…")` label, which is what makes the
; C spelling reach the real symbol (measured: the C consumer reads 7).
;
; The label is emitted ONLY when the sanitized name differs from the link name, so
; a library whose names are already C-legal gets a fully portable header and the
; GCC/Clang extension appears exactly where it is load-bearing. Note this is the
; opposite conclusion from W9 item 4's recorded one ("the fix is a missed call
; site") — which holds for type/field/arm/enum names, since those have no linkage,
; and does not hold for anything the linker resolves.
(defn emit-cheader-defvar (form:ptr):void
  (let (fc:ptr:Node (unsafe/cast ptr:Node form)
        attr-flags:i32 0)
    ; The name may be preceded by declaration attributes (`(defvar :const g:i32 1)`),
    ; so the name node comes off the advanced cursor rather than a fixed index —
    ; the same chokepoint `emit-defvar` uses, not a second reading of the grammar.
    (let (decl:ptr (parse-decl-attrs (as ptr (fc cdr))
                     (as ptr:i32 (addr-of attr-flags)) (fc line)))
      (when (= decl null) (return))
      (let (name-node:ptr ((unsafe/cast ptr:Node decl) car)
            vname:ptr null
            vtname:ptr null)
        (extract-name-type name-node (as ptr:ptr (addr-of vname))
                                     (as ptr:ptr (addr-of vtname)))
        (when (= vname null) (return))
        (let (tnode:ptr (extract-type-node name-node
                          ((unsafe/cast ptr:Node name-node) line)))
          (when (= tnode null)
            (printf "/* %s: no type annotation; not exported */\n" vname)
            (return))
          ; The same two un-C-representable classes `emit-cheader-declare` skips,
          ; for the same reasons: a defunion-template instance has no C spelling,
          ; and a closure env / erased box is not C-constructible.
          (when (!= (cheader-template-instance tnode) 0)
            (printf "/* %s: uses a defunion-template instance type; not exported */\n" vname)
            (return))
          (when (!= (cheader-mentions-closure tnode) 0)
            (printf "/* %s: exposes a closure or type-erased box type; not C-callable, omitted */\n" vname)
            (return))
          ; `type-node-to-c` answers `void*` for every cell head it does not
          ; recognize, which is SIZE-CORRECT for a pointer and silently wrong for
          ; anything else — `(defvar m:(Maybe i32) …)` would declare a
          ; pointer-sized object over a struct. (The two skips above catch a
          ; template instance only where the registry knows the template; this
          ; arm does not depend on that.) A *declaration* the C
          ; compiler trusts and gets wrong is worse than an omission, so this arm
          ; emits only what that function genuinely spells: a plain type name, or
          ; a pointer under any of its three spellings.
          (when (!= (cheader-defvar-type-ok tnode) 0)
            (printf "/* %s: type has no C spelling here; not exported */\n" vname)
            (return))
          ; AVR-6: `:const` selects LLVM `constant` storage, which is C's `const`.
          (let (cst:ptr (if (!= (bit-and attr-flags DECL-ATTR-CONST) 0) "const " "")
                link:ptr (ns-ir-base vname)
                ctype:ptr (type-node-to-c tnode))
            (let (cname:ptr (cheader-c-ident (as raw:i8 link)))
              (printf "extern %s%s %s%s;\n" cst ctype cname
                (cheader-asm-label link cname)))))))))

; W9 item 4: a `#define` is a preprocessor token with no link name, so the plain
; sanitized spelling is the whole answer. `cheader-array-extent` emits the same
; spelling for a symbolic `(array T N)` length, which is what keeps the two agreeing.
(defn emit-cheader-defconst (form:ptr):void
  (let (name:ptr (cheader-c-ident (as raw:i8 ((unsafe/cast ptr:Node (node-at form 1)) s)))
        val-node:ptr:Node (unsafe/cast ptr:Node (node-at form 2)))
    (case (val-node kind)
      NODE-INT (printf "#define %s %ld\n" name (val-node i))
      NODE-STR (printf "#define %s \"%s\"\n" name (val-node s))
      0)))

; W9 item 4: both the enum tag name and each member constant are sanitized —
; neither is a link name (a `defenum` member is a compile-time integer, not a
; symbol), so no asm label applies to either.
(defn emit-cheader-defenum (form:ptr):void
  (let (name:ptr (cheader-c-ident (as raw:i8 ((unsafe/cast ptr:Node (node-at form 1)) s)))
        n:i32 (- (node-len form) 2))
    (printf "enum %s {\n" name)
    (dotimes (i n)
      (let (variant:ptr (cheader-c-ident-join name (as raw:i8 ((unsafe/cast ptr:Node (node-at form (+ i 2))) s))))
        (printf "    %s = %d" variant i)
        (when (< i (- n 1)) (printf ","))
        (printf "\n")))
    (printf "};\n\n")))

; Export a defunion as its C view (unions.md §3): the tagged struct plus an
; enum of tag constants, fully legible and constructible from C. Templates
; define no type and are skipped.
(defn emit-cheader-defunion (form:ptr):void
  (let (name-node:ptr:Node (unsafe/cast ptr:Node (node-at form 1)))
    (when (!= (name-node kind) NODE-SYM) (return))
    ; ir-name-token first (`?`→_QMARK / `!`→_BANG), then the blanket C sanitize; see
    ; type-name-to-c. A no-op for names without `?`/`!`, so headers stay byte-identical.
    ; Stage 15 W9 item 25: `ns-ir-base`, not bare `ir-name-token` — B3′ applied
    ; that to `emit-cheader-defstruct` and `type-name-to-c` but not here, so a
    ; namespaced union's definition and every reference to it spelled different C
    ; identifiers. Identity under `user`.
    ; W9 item 28: `cheader-c-ident`, as emit-cheader-defstruct — see there.
    (let (name:ptr (cheader-c-ident (as raw:i8 (ns-ir-base (name-node s))))
          narms:i32 (- (node-len form) 2)
          npay:i32 0)
      (check-ir-name-legal (name-node line) (name-node s) name)
      ; Any payload-bearing arm?
      (dotimes (i narms)
        (when (= ((unsafe/cast ptr:Node (node-at form (+ i 2))) kind) NODE-CELL)
          (inc! npay)))
      ; Tagged for the same reason a defstruct is (item 25): `type-name-to-c`
      ; spells a reference to a union type `struct NAME` too.
      (printf "typedef struct %s {\n    int32_t tag;\n" name)
      (when (> npay 0)
        (printf "    union {\n")
        (dotimes (i narms)
          (let (arm:ptr:Node (unsafe/cast ptr:Node (node-at form (+ i 2))))
            (when (= (arm kind) NODE-CELL)
              (let (aname:ptr (cheader-c-ident (as raw:i8 ((unsafe/cast ptr:Node (node-at (as ptr arm) 0)) s)))
                    nf:i32 (- (node-len (as ptr arm)) 1))
                (if (= nf 1)
                  ; One field → the payload is just that field, named by the arm.
                  (let (field:ptr (node-at (as ptr arm) 1)
                        tnode:ptr (extract-type-node field ((unsafe/cast ptr:Node field) line)))
                    (printf "        %s %s;\n" (type-node-to-c tnode) aname))
                  (do
                    (printf "        struct { ")
                    (dotimes (fi nf)
                      (let (field:ptr (node-at (as ptr arm) (+ fi 1))
                            fname:ptr null
                            ftname:ptr null)
                        (extract-name-type field (as ptr:ptr (addr-of fname))
                                                  (as ptr:ptr (addr-of ftname)))
                        (let (tnode:ptr (extract-type-node field ((unsafe/cast ptr:Node field) line)))
                          (printf "%s %s; " (type-node-to-c tnode)
                            (cheader-c-ident (as raw:i8 fname))))))
                    (printf "} %s;\n" aname)))))))
        (printf "    } payload;\n"))
      (printf "} %s;\n\n" name)
      ; Tag constants: declaration order from 0 — part of the C contract.
      (printf "enum %s_tag {\n" name)
      (dotimes (i narms)
        (let (arm:ptr:Node (unsafe/cast ptr:Node (node-at form (+ i 2)))
              aname:ptr (cheader-c-ident-join name (as raw:i8
                          (if (= (arm kind) NODE-SYM) (arm s)
                            ((unsafe/cast ptr:Node (node-at (as ptr arm) 0)) s)))))
          (printf "    %s = %d" aname i)
          (when (< i (- narms 1)) (printf ","))
          (printf "\n")))
      (printf "};\n\n"))))

(defn emit-cheader-header (forms:ptr source-file:ptr):void
  ; Stage 12 N6: a namespaced library's public symbols carry a mangled link name
  ; (`@geom__area`), so the C declarations must use that C-legal spelling — never
  ; the Nucleus source name `geom/area` (not a C identifier). Apply a leading
  ; `(ns NAME)` / `set-ir-prefix` so g-current-ns is set; emit-cheader-declare
  ; then composes the namespace ir-prefix onto each function name via ns-ir-base.
  ; Identity under `user`, so an un-namespaced library's header is byte-identical.
  (set! forms (apply-leading-ns forms))
  (apply-early-set-ir-prefix forms)
  ; Stage 15 W9 item 26: the same prescan sequence `emit-nuch-header` runs, and
  ; for the same reason — the symbol a `defn` links as is decided by
  ; `finalize-generics` (at the end of prescan-defn-signatures), not by its
  ; spelling. Without this the header could only guess, and it guessed the
  ; solitary non-operator form for every function: an operator or an overload was
  ; declared under a symbol no object defines. Emission still walks THIS file's
  ; forms only, so nothing an import contributes is exported.
  ; Protocols before struct names, per B5 — the reverse order reports a
  ; `defprotocol`/`defstruct` name clash at the wrong line.
  ;
  ; `prescan-imported-signatures` is not optional here: whether a name is
  ; overloaded is a property of the whole compilation unit, and a library's own
  ; file usually contributes ONE method to a name the prelude also defines
  ; (`hash`, `drop`, `next`). Prescanning this file alone makes every such name
  ; look solitary, and the header would declare `@hash` where the object defines
  ; `hash.pString`. This file's own path goes on `g-prescan-sigs` first — the list
  ; that walk guards on — so an import cycle back to it is skipped rather than
  ; re-read.
  (prescan-file-imports forms)
  (prescan-imported-types forms)
  (prescan-protocols forms)
  (prescan-struct-names forms)
  (prescan-defn-signatures forms)
  ; NOT `prescan-value-names` for this file. Nothing here emits a body, so the
  ; only thing it would change is `cheader-array-extent`'s constant fold: a local
  ; `(array i32 BUF-LEN)` would export as `xs[4]` instead of `xs[BUF_LEN]`, losing
  ; the symbolic size against the `#define BUF_LEN` this same header emits beside
  ; it. An IMPORTED constant still folds — `prescan-imported-signatures` registers
  ; those — which is right, since the header cannot `#define` a name it does not
  ; export.
  (when (!= g-source-path null)
    (set! g-prescan-sigs (import-list-push g-prescan-sigs (as CStr g-source-path))))
  (prescan-imported-signatures forms)
  (printf "#pragma once\n")
  (printf "#include <stdint.h>\n")
  (printf "#include <stdbool.h>\n")
  ; size_t / ptrdiff_t, for usize / ssize (type-name-to-c).
  (printf "#include <stddef.h>\n\n")
  (printf "/* Generated from %s by nucleusc --emit-cheader */\n\n" source-file)
  ; Register defunion templates first so declares can recognize (and skip)
  ; signatures that mention template-instance types.
  (let (fc0:ptr forms)
    (while (!= fc0 null)
      (let (f:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node fc0) car)))
        (when (and (and (!= (as ptr f) null) (= (f kind) NODE-CELL))
                   (and (> (node-len (as ptr f)) 1)
                        (and (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind) (= _ NODE-SYM))
                             (and (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ s) (= _ "defunion"))
                                  (-> f (node-at _ 1) (unsafe/cast ptr:Node _) (_ kind) (= _ NODE-CELL))))))
          (register-union-template (as ptr f))))
      (set! fc0 ((unsafe/cast ptr:Node fc0) cdr))))
  (let (fc:ptr forms)
    (while (!= fc null)
      (let (f:ptr:Node (unsafe/cast ptr:Node ((unsafe/cast ptr:Node fc) car)))
        (when (and (and (!= (as ptr f) null) (= (f kind) NODE-CELL))
                   (and (> (node-len (as ptr f)) 0)
                        (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ kind) (= _ NODE-SYM))))
          (let (h:ptr (-> f (node-at _ 0) (unsafe/cast ptr:Node _) (_ s)))
            (cond (= h "defstruct") (emit-cheader-defstruct (as ptr f))
                  (= h "defunion")  (emit-cheader-defunion (as ptr f))
                  (= h "defn")      (emit-cheader-declare (as ptr f))
                  ; W9 item 3. `defvar-` is a different head, so privacy needs no
                  ; test here — the same way every other arm gets it.
                  (= h "defvar")    (emit-cheader-defvar (as ptr f))
                  (= h "defconst")  (emit-cheader-defconst (as ptr f))
                  (= h "defenum")   (emit-cheader-defenum (as ptr f))
                  true                         0))))
      (set! fc ((unsafe/cast ptr:Node fc) cdr)))))

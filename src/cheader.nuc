; C header handling — extracted from src/nucleusc.nuc.
;
; Provides:
;   * (import-use "foo.h") / (import "foo.h" prefix) — preprocess a C header
;     via clang -E and register its extern function declarations with the compiler.
;   * --emit-cheader output — write a C header (.h) describing the current
;     translation unit's defstruct/defn/defconst/defenum forms.
;
; Source-imported by src/nucleusc.nuc.

; Stage 10 Phase F1: well-known libc functions that never return. A C header
; carries no nullability/noreturn metadata we trust (the parser even discards
; __attribute__((noreturn))), so recognize the standard noreturn libc functions
; by name. A statement-position call to one terminates its block, so a
; (when (= x null) (exit 1)) / (abort) guard narrows the tested binding past it.
(defn c-fn-noreturn (fname:Symbol):bool
  (let (names:&(HashSet StrView)
        #{"exit" "abort" "_exit" "_Exit" "quick_exit"
          "abort_handler_s" "longjmp" "siglongjmp"})
    (return (contains? names (symbol-as-view fname)))))

; Likewise by name: the setjmp family. clang treats these as builtins and adds
; `returns_twice` itself, so `clang -E` leaves no attribute here to parse.
(defn c-fn-returns-twice (fname:Symbol):bool
  (let (names:&(HashSet StrView)
        #{"setjmp" "_setjmp" "__sigsetjmp" "sigsetjmp"
          "savectx" "vfork" "getcontext"})
    (return (contains? names (symbol-as-view fname)))))

; ============================================================
; C header parsing (clang -E)
; ============================================================

; Stage 15 W3a: provenance of the declaration currently being parsed, so a
; diagnostic about an opaque type can name the *header* and line it was declared
; on rather than the .nuc file that imported it (g-source-path). clang -E keeps
; `# <line> "<file>"` linemarkers in its output; emit-c-include records the most
; recent one and the buffer offset just past it, and cheader-line-at recovers a
; line by counting the newlines in between. Best effort by construction (a
; linemarker inside a struct body is not re-read), which is the right bar for a
; provenance note — it is never used to make a decision.
; (Set at the top of emit-c-include, before any declaration is parsed; a global
; string *initializer* would have to be an LLVM constant, so it is assigned
; there rather than here.)
(defvar g-cheader-file:Symbol)
(defvar g-cheader-dline:i32 1)
(defvar g-cheader-dpos:i64 0)

; Stage 15 W3b: set by c-parse-type when it meets a by-value aggregate it has no
; layout for, cleared per declaration by c-parse-func-decl (which is what makes
; it declaration-scoped). A global rather than an out parameter because
; c-parse-type has six call sites across three parse paths and only the
; function-declaration path acts on it. Declared here, above c-parse-type, since
; a global must be defined before the first form that references it.
(defvar g-cheader-unrep:i32 0)

; Stage 15 W3c: *why* the flag above is set, so the skip warning names the
; offending type rather than a single catch-all sentence. Only meaningful while
; g-cheader-unrep is non-zero; every site that raises the flag sets this in the
; same breath (cheader-mark-unrep), and the accumulating caller
; (c-parse-func-decl) copies the FIRST reason it sees into a local, so a later
; parameter whose flag is subsequently cleared cannot rewrite the message.
(defvar g-cheader-unrep-why:StrView)
; W3c: 1 when the reason is "Nucleus has no type this wide/shaped" rather than
; "the importer could not read the header" — see cheader-record-skip for why the
; two are reported differently.
(defvar g-cheader-unrep-quiet:i32 0)

; Stage 15 W9 item 37: the source files whose type definitions this header
; REFERENCES but does not contain, as a Node string list (import-list-push /
; -has, the same shape every other path list in the compiler uses). Recorded by
; `type-name-to-c` — the single place a `struct NAME` reference is spelled — and
; emitted as `#include` lines in the preamble. Reset at the top of
; emit-cheader-header rather than initialized here, per g-cheader-file above.
(defvar g-cheader-includes:ptr)

; Stage 16: the same list for the C headers a rendered **C typedef** name came
; from (`off_t` → `<unistd.h>`). Separate from the list above because the
; spelling rule differs — a C header is included by the spelling the source
; imported, in angle brackets, with no `.h` derivation.
(defvar g-cheader-c-includes:ptr)

(defn cheader-mark-unrep (why:StrView quiet:i32):void
  (set! g-cheader-unrep 1)
  (set! g-cheader-unrep-why why)
  (set! g-cheader-unrep-quiet quiet))

; ============================================================
; Stage 15 W3c: declaration precedence (cheader.md §1.4)
;
; **An explicit `(declare …)` wins over a header-derived declaration of the same
; function, regardless of which comes first in the file, and a signature
; mismatch warns naming both sources.**
;
; Measured before the rule existed, both orders were silent and they disagreed
; with each other:
;
;   (declare lseek (fd:i32 off:i64 whence:i32):i64)   ; -> declare i64 @lseek(i32, i64, i32)
;   (import-use "unistd.h")                           ;    the header's copy is dropped
;
;   (import-use "unistd.h")                           ; -> declare ptr @lseek(i32, ptr, i32)
;   (declare lseek (fd:i32 off:i64 whence:i32):i64)   ;    the USER's copy is dropped
;
; i.e. *first* wins, not "last wins" as the spec supposed — but the second
; ordering is the dangerous one either way: the user wrote an explicit, correct
; declaration and the header quietly replaced it, which is precisely how §1.4
; cost a debugging session.
;
; Order-independence needs the explicit names known *before* any import runs, so
; `prescan-explicit-declares` collects them from the unit's top-level forms in
; `emit-toplevel-forms`, beside the other prescans. A header declaration whose
; name is on that list is then never registered and never emitted: exactly one
; `declare` reaches the IR (LLVM rejects a second one for the same symbol even
; when the two agree), and it is the user's.
;
; Scope: the list is per-compilation and is fed by every `.nuc` unit's own
; prescan, so a source-imported library's declares also outrank a header import
; that follows them. A `declare` arriving from a `.nuch` header is not on the
; list (its forms are read during emission, too late to precede a C import) and
; keeps the previous first-wins behaviour.
; ============================================================

; One declaration site — either the unit's explicit `declare` (file/line in the
; .nuc source, `sig` filled in when it is emitted) or a suppressed header-derived
; one (file/line in the C header, `sig` known immediately).
;
; `name`/`file`/`sig` are `ptr`, not `CStr`: `sig` is null-checked (an explicit
; declare's signature is unknown until it is emitted) and a `CStr` operand would
; lower that guard to `strcmp(sig, null)` — the crash conventions.md records.
(defstruct CDeclSite
  name:Symbol
  file:Symbol
  line:i32
  sig:StrView
  warned:i32
  ; The explicit `(declare …)` form itself, so a header import that stands down
  ; for this name can emit it *there* rather than leaving the name undefined
  ; between the import and the declare's own position (see
  ; cheader-yield-to-explicit-declare). Null on a shadow entry.
  (form (raw Node))
  (next (raw CDeclSite)))

(defvar (g-explicit-declares (raw CDeclSite)))
(defvar (g-cheader-shadowed (raw CDeclSite)))

(defn cdecl-site-find (list:(raw CDeclSite) fname:Symbol):(raw CDeclSite)
  (let (cur:ptr list)
    (while (!= cur null)
      (let (e:ptr:CDeclSite (as &CDeclSite cur))
        (when (= (e 'name) fname) (return (as raw:CDeclSite e)))
        (set! cur (e 'next)))))
  (return null))

(defn cheader-explicit-declare-site (fname:Symbol):(raw CDeclSite)
  (return (cdecl-site-find g-explicit-declares fname)))

; Render a function signature the way its `declare` line reads — `i64 (i32, i64,
; i32)`, `void (ptr, ...)`. Two declarations that render identically are
; ABI-identical, which is exactly the equivalence the precedence rule needs; and
; the rendering is what the conflict warning shows, so the user sees the two
; signatures side by side rather than being told only that they differ.
(defn c-fn-sig-render (ret:raw:Type ptypes:ptr np:i32 variadic:i32):StrView
  (let ((acc String) (str-alloc (strfmt-alloc) (type-to-ir (as ptr ret)) " ("))
    (dotimes (i:i32 np)
      (when (!= i 0) (str-into acc ", "))
      (str-into acc (type-to-ir (aref (as &ptr ptypes) i))))
    (when (!= variadic 0)
      (if (= np 0)
        (str-into acc "...")
        (str-into acc ", ...")))
    (str-into acc ")")
    (return (string-as-view acc))))

(defn cdecl-site-push (list:(raw CDeclSite) fname:Symbol file:Symbol line:i32
                       sig:StrView form:(raw Node)):(raw CDeclSite)
  (let (e:ptr:CDeclSite (new CDeclSite))
    (set! (e 'name) fname)
    (set! (e 'file) file)
    (set! (e 'line) line)
    (set! (e 'sig) sig)
    (set! (e 'warned) 0)
    (set! (e 'form) form)
    (set! (e 'next) list)
    (return (as raw:CDeclSite e))))

; `<nuc file>:<line>: warning: …` — blamed on the *explicit* declaration, which
; is the one the author can act on, and naming the header declaration it
; overrides. Deduplicated on the site: a C header import is deliberately not
; deduplicated, so without this a conflict warns once per import of the header.
(defn cheader-warn-decl-conflict (site:(raw CDeclSite) hdr:(raw CDeclSite)):void
  (when (or (= (as ptr site) null) (= (as ptr hdr) null)) (return))
  (let (s:ptr:CDeclSite (unsafe/cast &CDeclSite site)
        h:ptr:CDeclSite (unsafe/cast &CDeclSite hdr))
    (when (!= (s 'warned) 0) (return))
    (set! (s 'warned) 1)
    (diag-emit "warning" (s 'file) (s 'line)
        (fstr "declaration of '" (s 'name)
              "' as " (s 'sig) " conflicts with " (h 'file) ":" (h 'line)
              ", which declares it as " (h 'sig) "; the explicit declaration wins"))))

; Collect every top-level `(declare NAME …)` in this unit. Runs with the other
; prescans in emit-toplevel-forms — i.e. before ANY import of this unit is
; processed — which is what makes the precedence rule order-independent.
(defn prescan-explicit-declares (forms:(raw Node)):void
  (let (fc:ptr forms)
    (while (> (node-len fc) 0)
      (let (f:ptr:Node (unsafe/cast &Node (node-first (unsafe/cast &Node fc))))
        (when (and (!= (as ptr f) null)
                   (= (f 'kind) NODE-LIST)
                   (>= (node-len (as ptr f)) 2)
                   (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 'kind) (= _ NODE-SYM))
                   (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 's) (= _ "declare")))
          (let (nn:ptr:Node (unsafe/cast &Node (node-at (as ptr f) 1)))
            ; W9 item 45: `node-kind` — `(declare ())` names nothing to record,
            ; and this prescan skips it exactly as it skips any other name kind
            ; it cannot use. `emit-declare` diagnoses the form.
            (when (and (= (node-kind (as ptr nn)) NODE-SYM)
                       (= (as ptr (cheader-explicit-declare-site (nn 's))) null))
              (set! g-explicit-declares
                    (cdecl-site-push g-explicit-declares (nn 's)
                                     g-source-path (f 'line) ""
                                     (as raw:Node f)))))))
      (set! fc (node-rest (unsafe/cast &Node fc))))))

; The source line of buffer offset `pos`, per the last recorded linemarker.
(defn cheader-line-at (buf:ptr pos:i64):i32
  (let (n:i32 g-cheader-dline
        i:i64 g-cheader-dpos)
    (while (< i pos)
      (when (= (cstr-byte-at buf i) 10) (inc! n))
      (set! i (+ i 1)))
    (return n)))

; Record a `# <line> "<file>"` linemarker occupying [pos, nl-end). `nl-end` is
; the offset of the first character of the following line.
(defn cheader-note-linemarker (buf:ptr pos:i64 nl-end:i64 len:i64):void
  (let (p:i64 (+ pos 1))
    ; digits (the line number of the NEXT line)
    (set! p (c-skip-ws buf p len))
    (let (start:i64 p
          v:i32 0)
      (while (and (< p nl-end) (!= (isdigit (as i32 (cstr-byte-at buf p))) 0))
        (set! v (+ (* v 10) (- (as i32 (cstr-byte-at buf p)) 48)))
        (set! p (+ p 1)))
      ; A `#pragma`/`#ident` line (no digits) carries no position information.
      (when (= p start) (return))
      (set! g-cheader-dline v)
      (set! g-cheader-dpos nl-end)
      ; optional "file"
      (set! p (c-skip-ws buf p len))
      (when (and (< p nl-end) (= (cstr-byte-at buf p) 34))
        (set! p (+ p 1))
        (let (fstart:i64 p)
          (while (and (< p nl-end) (!= (cstr-byte-at buf p) 34))
            (set! p (+ p 1)))
          (set! g-cheader-file
                (symbol-intern (strview (unsafe/cast &ui8 (unsafe/ptr+ (as &i8 buf) fstart))
                                        (as usize (- p fstart))))))))))

; Skip whitespace in buffer, returning new position.
(defn c-skip-ws (buf:ptr pos:i64 len:i64):i64
  (while (and (< pos len) (!= (isspace (as i32 (cstr-byte-at buf pos))) 0))
    (set! pos (+ pos 1)))
  (return pos))

; Read a C identifier or keyword from buffer. Returns the token as a string.
; Sets out-end to the position after the token.
(defn c-read-ident (buf:ptr pos:i64 len:i64 out-end:ptr:i64):Symbol
  (let (start:i64 pos)
    (while (and (< pos len)
                (or (!= (isdigit (as i32 (cstr-byte-at buf pos))) 0)
                    (or (and (>= (as i32 (cstr-byte-at buf pos)) 65)
                             (<= (as i32 (cstr-byte-at buf pos)) 90))
                        (or (and (>= (as i32 (cstr-byte-at buf pos)) 97)
                                 (<= (as i32 (cstr-byte-at buf pos)) 122))
                            (= (as i32 (cstr-byte-at buf pos)) 95)))))
      (set! pos (+ pos 1)))
    (set! @out-end pos)
    (return (symbol-intern (strview (unsafe/cast &ui8 (unsafe/ptr+ (as &i8 buf) start))
                                    (as usize (- pos start)))))))

; Map a C type name to a Nucleus type.
; Returns the Type* or null if unknown/skipped.
; Stage 16 FL-7: which representation C's `long double` names on the emission
; target. x86 uses the 80-bit x87 format; aarch64 and riscv64 use IEEE
; binary128; everything else (AVR, ARM32, MSVC) makes it a plain double. Null
; only where none of the three exists, which keeps the skip path alive.
(defn c-long-double-type ():(raw Type)
  (when (!= (abi-is-avr) 0) (return ty-f64))
  (when (!= (abi-is-riscv) 0) (return ty-f128))
  ; Measured: MSVC makes it `double` even on x86_64, so this must precede x86.
  (let (tv:StrView (symbol-as-view ((as &Target g-target) 'triple)))
    (when (strview-contains tv "msvc")    (return ty-f64))
    (when (strview-contains tv "aarch64") (return ty-f128))
    (when (strview-contains tv "x86_64")  (return ty-f80))
    (when (strview-contains tv "i386")    (return ty-f80)))
  (return ty-f64))

(defn c-type-to-nucleus (name:Symbol is-unsigned:i32 is-long:i32 is-short:i32):(raw Type)
  ; Handle base types
  (when (= name "void")  (return ty-void))
  (when (= name "_Bool") (return ty-bool))
  (when (= name "char")
    (if (!= is-unsigned 0) (return ty-ui8) (return ty-i8)))
  (when (= name "short")
    (if (!= is-unsigned 0) (return ty-ui16) (return ty-i16)))
  (when (or (= name "int") (= name "long"))
    (when (!= is-short 0)
      (if (!= is-unsigned 0) (return ty-ui16) (return ty-i16)))
    ; A "long" base implies at least one `long` specifier.
    (let (lc:i32 is-long)
      (when (and (= name "long") (< lc 1)) (set! lc 1))
      (when (>= lc 2)   ; long long — always 64-bit
        (if (!= is-unsigned 0) (return ty-ui64) (return ty-i64)))
      (when (= lc 1)    ; long — depends on the target's data model
        (if (= (target-long-size) 8)
          (if (!= is-unsigned 0) (return ty-ui64) (return ty-i64))
          (if (!= is-unsigned 0) (return ty-ui32) (return ty-i32)))))
    (return (c-int-type is-unsigned)))
  (when (= name "float")  (return ty-f32))
  (when (= name "double")
    ; Stage 16 FL-7: `long double` is target-dependent — x86_fp80 on x86-64 and
    ; i386, fp128 on aarch64 and riscv64, plain double on AVR/ARM32 — so it maps
    ; to whichever representation the TARGET uses. The Nucleus types are named
    ; for the representation for exactly this reason.
    (when (!= is-long 0) (return (c-long-double-type)))
    (return ty-f64))
  ; FL-7: the two fixed-width C spellings, which name one format on every target.
  (when (= name "_Float16")  (return ty-f16))
  (when (= name "__fp16")    (return ty-f16))
  (when (= name "_Float128") (return ty-f128))
  (when (= name "__float128") (return ty-f128))
  ; size_t / ssize_t stay intercepted by NAME rather than followed through the
  ; typedef table (which would make the width follow whatever machine the
  ; preprocessor read headers for), but the width is the EMISSION target's:
  ; pointer-sized on every target the compiler registers a backend for. Stage 16
  ; C4 — 16-bit on AVR, 32-bit on i386; it was a hardcoded 64 before.
  (when (= name "size_t")
    (when (= ((as &Target g-target) 'ptr-size) 2) (return ty-ui16))
    (when (= ((as &Target g-target) 'ptr-size) 4) (return ty-ui32))
    (return ty-ui64))
  (when (= name "ssize_t") (return (as raw:Type (ptr-int-type))))
  ; __gnuc_va_list / va_list — treat as ptr
  (when (= name "__gnuc_va_list") (return ty-ptr))
  (when (= name "va_list") (return ty-ptr))
  ; FILE* — opaque struct, treated as ptr
  (when (= name "FILE") (return ty-ptr))
  ; Fallback: if unknown, return ptr
  (return null))

; Skip balanced parentheses in __attribute__((...)) or similar.
; pos should point to the opening '('. Returns position after the matching ')'.
(defn c-skip-parens (buf:ptr pos:i64 len:i64):i64
  (let (depth:i32 0)
    (while (< pos len)
      (when (= (cstr-byte-at buf pos) 40) (inc! depth))
      (when (= (cstr-byte-at buf pos) 41)
        (set! depth (- depth 1))
        (when (= depth 0)
          (return (+ pos 1))))
      (set! pos (+ pos 1)))
    (return pos)))

; Stage 15 W3b: consume a run of C type qualifiers at `pos`, returning the
; position after the last one (leading whitespace is skipped either way).
;
; C permits a qualifier *anywhere* in a declaration-specifier sequence and after
; every `*`, so `int const *p` ("east const") denotes exactly the same type as
; `const int *p`. Nucleus models neither, and the emitted LLVM type is identical
; with or without them, so the parser consumes and discards a qualifier in every
; legal position rather than representing it. Before this existed the parser
; handled only the *leading* position: an east qualifier terminated the type, and
; the qualifier token was then consumed as the parameter's *name*, leaving the
; following `*p` to start a phantom SECOND parameter that defaulted to `ptr`
; (cheader.md §1.5 — `void _mm_clflush(void const *__p)` became
; `declare void @_mm_clflush(void, ptr)`, and `int const *p` the silently
; representable-but-wrong `(i32, ptr)`).
(defn c-skip-type-quals (buf:ptr pos:i64 len:i64):i64
  (let (p:i64 (c-skip-ws buf pos len)
        more:i32 1)
    (while (!= more 0)
      (set! more 0)
      (let (te:i64 0
            t:Symbol (c-read-ident buf p len (as &i64 &te)))
        (when (or (= t "const") (= t "volatile") (= t "restrict")
                  (= t "__restrict") (= t "__restrict__") (= t "_Atomic"))
          (set! p (c-skip-ws buf te len))
          (set! more 1))))
    (return p)))

; Consume a run of `__attribute__ ((…))`, returning the position after the last
; one. C admits one between `struct`/`union` and the tag, where a scanner that
; reads the next identifier as the tag registers a phantom type named
; `__attribute__` (glibc's `struct __attribute__ ((__may_alias__)) sockaddr`).
; Is the identifier `a` (or its `__a__` spelling `b`) anywhere in [start, stop)?
; Attribute arguments are identifiers and integers, so token-by-token is enough.
(defn c-span-has-ident (buf:ptr start:i64 stop:i64 a:StrView b:StrView):i32
  (let (p:i64 start)
    (while (< p stop)
      (let (e:i64 0
            t:Symbol (c-read-ident buf p stop (as &i64 &e)))
        (if (= (symbol-len t) 0)
          (set! p (+ p 1))
          (do (when (or (= (symbol-as-view t) a) (= (symbol-as-view t) b)) (return 1))
              (set! p e)))))
    (return 0)))

; A `*` in the span c-parse-type consumed belongs to the FIRST declarator and was
; already collapsed into `ptr`, so a later one on the same line has no base left
; (c-header-layout.md §8.2).
(defn c-span-has-star (buf:ptr start:i64 stop:i64):i32
  (let (p:i64 start)
    (while (< p stop)
      (when (= (cstr-byte-at buf p) 42) (return 1))
      (set! p (+ p 1))))
  (return 0))

; Stage 16 PK-3: the argument of `aligned(…)`, which C admits as any integer
; constant expression. Two forms carry every occurrence in the headers surveyed:
; a decimal literal, and `__alignof__(T)` / `sizeof(T)` — the idiom that PINS a
; member to its natural alignment (`max_align_t`) rather than raising it.
; 0 = the span held no argument we could read, which the caller turns into an
; unrepresentable type rather than a guessed layout.
(defn c-align-arg-value (buf:ptr pos:i64 stop:i64):i32
  (let (p:i64 (c-skip-ws buf pos stop))
    (when (>= p stop) (return 0))
    (let (c:i32 (cstr-byte-at buf p))
      (when (and (>= c 48) (<= c 57))
        (let (v:i32 0)
          (while (and (< p stop) (>= (cstr-byte-at buf p) 48) (<= (cstr-byte-at buf p) 57))
            (set! v (+ (* v 10) (- (cstr-byte-at buf p) 48)))
            (set! p (+ p 1)))
          (return v))))
    (let (e:i64 0
          t:Symbol (c-read-ident buf p stop (as &i64 &e)))
      (when (or (= t "__alignof__") (or (= t "__alignof") (= t "_Alignof"))
                (= t "sizeof"))
        (let (q:i64 (c-skip-ws buf e stop))
          (when (and (< q stop) (= (cstr-byte-at buf q) 40))
            (let (close:i64 (c-skip-parens buf q stop)
                  te:i64 0
                  ; c-parse-type owns the unrep channel; an unreadable type name
                  ; here must answer 0, not condemn the enclosing declaration.
                  save-unrep:i32 g-cheader-unrep
                  save-why:StrView g-cheader-unrep-why
                  save-quiet:i32 g-cheader-unrep-quiet
                  ty:ptr null)
              (set! g-cheader-unrep 0)
              (set! ty (c-parse-type buf (+ q 1) (- close 1) (as &i64 &te)))
              (let (bad:i32 g-cheader-unrep)
                (set! g-cheader-unrep save-unrep)
                (set! g-cheader-unrep-why save-why)
                (set! g-cheader-unrep-quiet save-quiet)
                (when (or (= ty null) (!= bad 0)) (return 0))
                (when (= t "sizeof") (return (abi-sizeof (as raw:Type ty))))
                (return (abi-alignof (as raw:Type ty))))))))
      (return 0))))

; The value of the first `aligned(…)` in [start, stop): 0 = absent, -1 = present
; with an argument we could not evaluate.
(defn c-span-aligned-value (buf:ptr start:i64 stop:i64):i32
  (let (p:i64 start)
    (while (< p stop)
      (let (e:i64 0
            t:Symbol (c-read-ident buf p stop (as &i64 &e)))
        (if (= (symbol-len t) 0)
          (set! p (+ p 1))
          (do
            (if (or (= t "aligned") (= t "__aligned__"))
              (let (q:i64 (c-skip-ws buf e stop))
                (when (or (>= q stop) (!= (cstr-byte-at buf q) 40)) (return -1))
                (let (close:i64 (c-skip-parens buf q stop)
                      v:i32 (c-align-arg-value buf (+ q 1) (- close 1)))
                  (when (= (align-attr-valid v) 0) (return -1))
                  (return v)))
              (set! p e))))))
    (return 0)))

; Stage 16 PK-2: the same run c-skip-attributes consumed blind, but reporting
; whether it carried `packed`. `out-end` is always the position after the run, so
; a caller that only wants to skip ignores the answer — which is what
; c-skip-attributes now is. PK-3 adds `aligned(N)` through `out-align`, which is
; -1 when the attribute is there but its argument is not one we can evaluate.
(defn c-read-attributes (buf:ptr pos:i64 len:i64 out-end:ptr:i64
                         out-align:ptr:i32):i32
  (let (p:i64 (c-skip-ws buf pos len)
        more:i32 1
        found:i32 0
        align:i32 0)
    (while (!= more 0)
      (set! more 0)
      (let (ae:i64 0
            at:Symbol (c-read-ident buf p len (as &i64 &ae)))
        (when (= at "__attribute__")
          (set! p (c-skip-ws buf ae len))
          (when (and (< p len) (= (cstr-byte-at buf p) 40))
            (let (close:i64 (c-skip-parens buf p len))
              (when (!= (c-span-has-ident buf p close "packed" "__packed__") 0)
                (set! found 1))
              (let (a:i32 (c-span-aligned-value buf p close))
                (when (!= a 0) (set! align a)))
              (set! p close)))
          (set! p (c-skip-ws buf p len))
          (set! more 1))))
    (set! @out-end p)
    (set! (aref out-align 0) align)
    (return found)))

(defn c-skip-attributes (buf:ptr pos:i64 len:i64):i64
  (let (e:i64 0
        a:i32 0)
    (c-read-attributes buf pos len (as &i64 &e) (as &i32 &a))
    (return e)))

; Position after the `}` matching the `{` at `pos`. A struct body holds no
; string or character literal, so a plain depth count is sufficient.
(defn c-skip-braces (buf:ptr pos:i64 len:i64):i64
  (let (depth:i32 0)
    (while (< pos len)
      (when (= (cstr-byte-at buf pos) 123) (inc! depth))
      (when (= (cstr-byte-at buf pos) 125)
        (set! depth (- depth 1))
        (when (= depth 0) (return (+ pos 1))))
      (set! pos (+ pos 1)))
    (return pos)))

; PK-2: C admits `__attribute__((packed))` on a definition in two places — before
; the tag, and after the closing brace — and the layout must be settled BEFORE the
; body is parsed, since that is where the LLVM type line is written. So the
; trailing one is read by looking ahead over the body rather than in declaration
; order. Deliberately NOT after the declared name of a typedef: clang and gcc both
; ignore `packed` there (-Wignored-attributes / -Wattributes), so honouring it
; would make a `sizeof` that disagrees with every C compiler on the platform.
(defn c-trailing-packed (buf:ptr brace-pos:i64 len:i64 out-align:ptr:i32):i32
  (let (e:i64 0)
    (return (c-read-attributes buf (c-skip-braces buf brace-pos len) len
                               (as &i64 &e) out-align))))

; Whitespace plus `#`-led lines — clang -E emits linemarkers inside struct bodies.
; Not recorded: that moves g-cheader-dpos past a declaration still being parsed.
(defn c-skip-body-ws (buf:ptr pos:i64 len:i64):i64
  (let (p:i64 (c-skip-ws buf pos len))
    (while (and (< p len) (= (cstr-byte-at buf p) 35))
      (while (and (< p len) (!= (cstr-byte-at buf p) 10))
        (set! p (+ p 1)))
      (set! p (c-skip-ws buf p len)))
    (return p)))

; Parse a C type from the buffer. Handles qualifiers (const, restrict, volatile,
; unsigned, signed, long, short, struct), pointer stars.
; Returns the Nucleus Type*. Sets out-end to position after the type.
(defn c-parse-type (buf:ptr pos:i64 len:i64 out-end:ptr:i64):ptr
  (let (is-unsigned:i32 0
        is-long:i32 0
        is-short:i32 0
        base-name:Symbol (symbol-none)
        ptr-depth:i32 0
        is-struct:i32 0
        is-union:i32 0
        is-enum:i32 0
        ; PK-2: `__attribute__((packed))` seen in the declaration-specifier run.
        spec-packed:i32 0
        ; PK-3: and its `aligned(N)`, -1 when the argument was unreadable.
        spec-align:i32 0)
    ; Parse type qualifiers and specifiers
    (let (done:i32 0)
      (while (= done 0)
        (set! pos (c-skip-ws buf pos len))
        (when (>= pos len) (set! done 1) (set! pos len))
        (when (= done 0)
          (let (tok-end:i64 0
                tok:Symbol (c-read-ident buf pos len (as &i64 &tok-end)))
            (when (= (symbol-len tok) 0) (set! done 1))
            (when (= done 0)
              (cond
                (let (quals:&(HashSet StrView)
                      #{"const" "volatile" "restrict" "__restrict" "_Atomic"
                        "extern" "static" "inline" "__inline" "__inline__"
                        "__extension__" "_Noreturn"})
                  (contains? quals (symbol-as-view tok)))
                  (set! pos tok-end)
                ; Stage 16 C1 (design/stage16-ergonomics/c-boundary-defects.md
                ; §3): a bare `unsigned`/`signed` IS a type — implicitly
                ; `unsigned int`/`signed int`. Neither used to end the specifier
                ; run, so the DECLARATOR name became the base type: `unsigned a;`
                ; read `a` as the type and abandoned the enclosing struct. Same
                ; peek `short` and `long` already do; a base this parser cannot
                ; describe (`__int128`, `_BitInt`) deliberately stays in the run
                ; so it reaches the unresolved-base path rather than being
                ; silently narrowed to `int`.
                (or (= tok "unsigned") (= tok "signed"))
                  (do (when (= tok "unsigned") (set! is-unsigned 1))
                      (set! pos tok-end)
                      (let (peek-pos:i64 (c-skip-ws buf tok-end len)
                            peek-end:i64 0
                            peek-tok:Symbol (c-read-ident buf peek-pos len (as &i64 &peek-end)))
                        (when (not (let (ints:&(HashSet StrView)
                                          #{"int" "char" "short" "long"
                                            "__int128" "_BitInt"})
                                      (contains? ints (symbol-as-view peek-tok))))
                          (set! base-name (symbol-intern "int")) (set! done 1))))
                (= tok "long")
                  (do (set! is-long (+ is-long 1))
                      (set! pos tok-end)
                      ; Peek to distinguish `long`, `long long`, `long int`,
                      ; `long double`, and `long` as a base type.
                      (let (peek-pos:i64 (c-skip-ws buf tok-end len)
                            peek-end:i64 0
                            peek-tok:Symbol (c-read-ident buf peek-pos len (as &i64 &peek-end)))
                        ; Consume a second "long" (long long) and re-peek.
                        (when (= peek-tok "long")
                          (set! is-long (+ is-long 1))
                          (set! pos peek-end)
                          (set! peek-pos (c-skip-ws buf peek-end len))
                          (set! peek-tok (c-read-ident buf peek-pos len (as &i64 &peek-end))))
                        ; "int"/"double" follow as the base; otherwise the base is
                        ; an implicit int and "long" is the (long-counted) base.
                        ; C1: declaration specifiers are order-independent, so
                        ; `long unsigned a;` is legal C — stopping the run at
                        ; `unsigned` read it as the declarator name and abandoned
                        ; the enclosing struct.
                        (when (and (!= peek-tok "int")
                                   (and (!= peek-tok "double")
                                        (and (!= peek-tok "unsigned")
                                             (!= peek-tok "signed"))))
                          (set! base-name (symbol-intern "long")) (set! done 1))))
                (= tok "short")
                  (do (set! is-short 1) (set! pos tok-end)
                      ; `short` alone (or `unsigned short`) is an implicit
                      ; `short int`: if `int` doesn't follow, the next token is
                      ; the declarator, so `short` itself is the base type.
                      (let (peek-pos:i64 (c-skip-ws buf tok-end len)
                            peek-end:i64 0
                            peek-tok:Symbol (c-read-ident buf peek-pos len (as &i64 &peek-end)))
                        ; C1: `short unsigned a;` is the same order-independence
                        ; case as `long unsigned` above.
                        (when (and (!= peek-tok "int")
                                   (and (!= peek-tok "unsigned")
                                        (!= peek-tok "signed")))
                          (set! base-name (symbol-intern "short")) (set! done 1))))
                (= tok "struct")
                  (do (set! is-struct 1) (set! pos tok-end))
                (= tok "union")
                  (do (set! is-struct 1) (set! is-union 1) (set! pos tok-end))
                ; W3c: `enum` was not a specifier at all, so `enum Tag e` read
                ; `enum` as the base type (unresolved → `ptr`) and `Tag` as the
                ; declarator name — the parameter's real name then began a
                ; phantom next one, the same shape W3b found for east
                ; qualifiers. A C enum's underlying type is implementation-
                ; defined but is `int` on every target this compiler emits for,
                ; and that is what clang lowers an enum parameter to. The
                ; optional tag is read by the next loop iteration (as base-name,
                ; exactly like `struct Tag`); an optional `{…}` body is consumed
                ; in the is-enum block below.
                (= tok "enum")
                  (do (set! is-enum 1) (set! pos tok-end))
                (= tok "__attribute__")
                  ; PK-2: this is the `struct __attribute__((packed)) { … }`
                  ; position, so the run is read rather than discarded.
                  (do (set! pos (c-skip-ws buf tok-end len))
                      (when (and (< pos len) (= (cstr-byte-at buf pos) 40))
                        (let (close:i64 (c-skip-parens buf pos len))
                          (when (!= (c-span-has-ident buf pos close
                                                      "packed" "__packed__") 0)
                            (set! spec-packed 1))
                          (let (a:i32 (c-span-aligned-value buf pos close))
                            (when (!= a 0) (set! spec-align a)))
                          (set! pos close))))
                true
                  (do (set! base-name tok) (set! pos tok-end) (set! done 1))))))))
    ; W3b: qualifiers that trail the base type (`int const *p`) belong to the
    ; declaration specifiers, not to the declarator — consume them here, before
    ; the declarator is looked for. Runs for every base kind (builtin, typedef
    ; name, `struct Tag`), since the specifier loop above exits through this
    ; point in all of them.
    (set! pos (c-skip-type-quals buf pos len))
    ; Count pointer stars, each optionally followed by its own qualifiers
    ; (`char * const p`, `int * restrict p`).
    (while (and (< pos len) (= (cstr-byte-at buf pos) 42))
      (inc! ptr-depth)
      (set! pos (c-skip-type-quals buf (+ pos 1) len)))
    (set! @out-end pos)
    ; W3c: enum base. The specifier loop has already taken an optional tag into
    ; `base-name`; what may remain is an inline `{ … }` enumerator list (for
    ; `enum { A, B } x` the loop stopped at the `{` without consuming anything,
    ; so the qualifier/`*` runs below have to be redone after it).
    (when (!= is-enum 0)
      (let (look:i64 (c-skip-ws buf pos len))
        (when (and (< look len) (= (cstr-byte-at buf look) 123))
          (set! look (c-parse-enum-body buf look len))
          ; `} __attribute__((flag_enum)) GApplicationFlags;` — GLib ≥ 2.86
          ; under clang; read as the declarator, it recorded a typedef named
          ; `__attribute__` and lost the real one.
          (set! look (c-skip-attributes buf look len))
          (set! look (c-skip-type-quals buf look len))
          (while (and (< look len) (= (cstr-byte-at buf look) 42))
            (inc! ptr-depth)
            (set! look (c-skip-type-quals buf (+ look 1) len)))
          (set! @out-end look)))
      (when (> ptr-depth 0) (return ty-ptr))
      (return (as ptr (c-int-type 0))))
    ; Struct/union base. struct {...} / struct Tag {...} parse the body to a
    ; TY-STRUCT (TY-UNION for unions); Tag references look up by tag;
    ; pointer-to-aggregate collapses to ptr.
    (when (!= is-struct 0)
      (when (> ptr-depth 0) (return ty-ptr))
      (let (look:i64 (c-skip-ws buf pos len)
            tag:Symbol base-name)
        (when (and (< look len) (= (cstr-byte-at buf look) 123))
          (let (sd-end:i64 0
                tail-align:i32 0
                tail-packed:i32 (c-trailing-packed buf look len
                                                   (as &i32 &tail-align))
                sd:ptr (c-parse-struct-body buf look len (as &i64 &sd-end)
                                        tag is-union
                                        (if (!= spec-packed 0) 1 tail-packed)
                                        (if (!= spec-align 0) spec-align tail-align)))
            (set! @out-end sd-end)
            (when (!= sd null)
              (return (as ptr (type-for-sdef sd))))
            ; W3b: a BY-VALUE aggregate whose body we could not parse. `ptr` is
            ; kept (a TY-STRUCT with no layout would put an undefined `%Tag` in
            ; the IR), but the enclosing declaration is now recorded as one the
            ; importer cannot describe — c-decl-skip-reason turns it into a
            ; located skip-with-warning instead of a wrong-ABI declaration.
            (cheader-mark-unrep
              "a by-value struct/union whose body the parser could not read" 0)
            (return ty-ptr)))
        (when (not (symbol-none? tag))
          (let (sd:ptr (lookup-struct tag))
            ; W3a: an OPAQUE tag must keep resolving to bare `ptr` here, exactly
            ; as an unregistered tag did before opaque registration existed. This
            ; branch is reached only for a BY-VALUE `struct Tag` in a parameter,
            ; return, or field position — a shape the parser cannot lower at all
            ; without a layout — and turning it into a TY-STRUCT would put an
            ; undefined `%Tag` into a `declare`, i.e. trade today's wrong-ABI
            ; pointer for invalid IR. Converting these into a skip-with-warning
            ; is W3b's validity gate (cheader.md §1.5), not this phase.
            (when (and (!= sd null)
                       (= (-> sd (unsafe/cast &StructDef _) (_ 'opaque)) 0))
              (return (as ptr (type-for-sdef sd))))))
        ; W3b: fell through — a by-value `struct Tag` whose tag is opaque or
        ; unknown. Same reasoning as the unparsable-body case above: keep `ptr`,
        ; but mark the declaration unrepresentable so it is skipped rather than
        ; silently given the wrong ABI.
        ; (`tag` and the fallback spelling are bound through a `ptr` local: a
        ; value-position `if` joining a bare `ptr` with a `StrView` literal
        ; collapses to void — conventions.md, the mixed cond/if join rule.)
        (let (tn:Symbol tag)
          (when (symbol-none? tn) (set! tn (symbol-intern "struct")))
          (cheader-mark-unrep
            (fstr "a by-value '" tn "' with no known layout") 0))
        (return ty-ptr)))
    ; Resolve base type
    (when (symbol-none? base-name)
        ; bare "unsigned" or "signed" with no base → int
        (when (or (!= is-unsigned 0) (or (!= is-short 0) (!= is-long 0)))
          (set! base-name (symbol-intern "int")))
        (when (symbol-none? base-name) (return ty-ptr)))
    (let (base-sym:Symbol base-name
          base-type:ptr (c-type-to-nucleus base-sym is-unsigned is-long is-short)
          td:?ptr:CTypedef (c-typedef-find base-sym))
      ; W3c: not a builtin — consult the typedef table (cheader.md §1.4). The
      ; entry already holds the fully-resolved type, so a chain costs one lookup.
      (when (= base-type null)
        (if-some (e td) (set! base-type (as ptr (e 'ty))) 0))
      ; W3c: a typedef NAME for a C aggregate is registered as a StructDef, not
      ; in the typedef table (c-parse-struct-decl owns that path), so resolve it
      ; the same way the `struct Tag` branch above does — a known layout gives
      ; the real TY-STRUCT, an opaque one stays `ptr` and marks the declaration.
      (when (= base-type null)
        (let (sd:ptr (lookup-struct base-sym))
          (when (and (!= sd null)
                     (= (-> sd (unsafe/cast &StructDef _) (_ 'opaque)) 0))
            (set! base-type (as ptr (type-for-sdef (as &StructDef sd)))))))
      ; Apply pointer depth. A pointer to anything is `ptr` in Nucleus, so an
      ; unresolvable POINTEE is harmless and must not mark the declaration —
      ; `struct _IO_FILE *` and `void (*)(int)` are perfectly describable.
      (when (> ptr-depth 0) (return ty-ptr))
      (when (= base-type null)
        ; W3c: a BY-VALUE type we could not resolve. The spec's rule for §1.4 is
        ; that a typedef the parser cannot follow must be an error or a skip,
        ; never a silent `ptr` — so keep `ptr` in the Type (a TY-STRUCT with no
        ; layout would put an undefined `%X` in the IR) but mark the enclosing
        ; declaration, which turns it into a located skip-with-warning naming the
        ; type. This is the "no unresolved type names" gate arm the W3b spec
        ; asked for and W3b correctly refused to implement while every unfollowed
        ; typedef still resolved to `ptr`.
        ; `long double` is the one BUILTIN spelling c-type-to-nucleus refuses
        ; (x86-64 lowers it to the 80-bit x87 type, which Nucleus has no
        ; spelling for), so name it accurately rather than blaming `double`.
        (cond
          (and (!= is-long 0) (= base-name "double"))
            (cheader-mark-unrep
              "a by-value 'long double' with no representation on this target" 1)
          (!= td null)
            (cheader-mark-unrep
              (fstr "a by-value '" base-name
                    "' (a typedef of a type with no Nucleus representation)") 1)
          true
            (cheader-mark-unrep
              (fstr "a by-value parameter or return of unknown type '" base-name "'") 1))
        (return ty-ptr))
      (return base-type))))

; ============================================================
; Stage 15 W3b: the validity gate on a synthesized `declare` (cheader.md §1.5)
;
; A declaration the parser recognized as a function but cannot faithfully
; describe must be SKIPPED with a located warning, not emitted. The alternative
; is what §1.5 documented: `declare void @_mm_clflush(void, ptr)` reaching the
; LLVM parser thousands of lines later as `failed to parse generated IR`, with no
; indication of which header or which function caused it.
;
; The gate sits *after* successful recognition, deliberately. The "this is not a
; function declaration at all" path (c-parse-func-decl returning 0) stays silent:
; every typedef, variable, `static inline` body and macro remnant in a
; preprocessed header goes through it legitimately, so warning there would bury
; the real signal.
;
; W3b noted that the spec's suggested "no unresolved type names" arm was not
; implementable *at the time*, because an unfollowed typedef resolved to `ptr` —
; which is representable, so the arm would have skipped a large fraction of every
; real header. W3c removed that objection by resolving the chain at the source
; (the typedef table above): an unresolved BY-VALUE base type is now genuinely
; rare, so `c-parse-type` marks it through the same g-cheader-unrep channel and
; the arm exists after all. A pointer to an unresolvable type is still fine and
; is deliberately not marked — every C pointer is `ptr`.
; ============================================================

; Parameter-array capacity. Both a real bound (the array is a fixed arena block)
; and the gate's cap: a declaration with more parameters than this is skipped
; rather than silently truncated. Before W3b the array was 16 entries and
; `num-params` was incremented past it, so `type-set-params` read off the end.
(defconst C-MAX-PARAMS 32)

; Record that `fname`'s declaration was skipped, and — when `loud` — say so on
; stderr immediately. `g-cheader-skipped` (declared in nucleusc.nuc, above
; `unresolved-name-message`, so the *use*-site diagnostic can read it) is keyed
; by function name and deduplicated: a C header import is deliberately not
; deduplicated (each import may alias under a different prefix) and umbrella
; headers include each other transitively, so one skipped function would
; otherwise be recorded and warned about many times per build.
;
; **Two tiers, and the split is deliberate (W3c).** W3b made every skip an
; always-on stderr warning and measured the volume at zero, which made "always
; on" free. W3c's typedef resolution changed that measurement: with the chain
; followed, an unresolvable *by-value* type is detectable, and the standard
; headers contain ~45 of them — `long double` throughout <math.h>/<stdlib.h>,
; `_Float128`/`_Float16` in the glibc and clang intrinsics headers,
; `SDL_JoystickGUID` in SDL2. Every one is a true positive, and every one is
; irrelevant to a build that never calls the function; six of them landed in the
; REPL's startup banner. So:
;
;   * **loud** — the importer could not *parse* what the header said (an
;     unreadable aggregate body, a `void` parameter, an opaque type, an
;     over-long parameter list). These are compiler-side limitations worth
;     surfacing on sight, and they still measure zero across the standard
;     headers, so W3b's always-on policy is kept verbatim for them.
;   * **quiet** — the declaration was parsed correctly and names a type Nucleus
;     has no equivalent for. Recorded only; `unresolved-name-message` delivers
;     it, with this same header:line and reason, at the point someone actually
;     calls the function.
;
; Neither tier is silent: a quiet skip that matters always becomes a located
; error, which is strictly more precise than a warning thousands of lines
; earlier that nothing connects to the call.
(defn cheader-record-skip (fname:Symbol why:StrView dline:i32 loud:i32):void
  (match (cheader-skip-note fname) (none 0) ((some _seen) (return)))
  (when (= g-cheader-skipped null)
    (set! g-cheader-skipped (vector-new-in &g-arena-alloc)))
  (let (tbl:&(Vector &CheaderSkip) (unsafe/cast &(Vector &CheaderSkip) g-cheader-skipped)
        e:&CheaderSkip (new CheaderSkip))
    (set! (e 'name) fname)
    (set! (e 'note) (symbol-intern (fstr g-cheader-file ":" dline ": " why)))
    (conj tbl e)
    (when (!= loud 0)
      (diag-emit "warning" g-cheader-file dline
          (fstr "skipping C declaration '" fname "': " why)))))

; The reason this declaration cannot be emitted, or null if it can.
;
; W3c: `unrep-why` replaces W3b's boolean — the accumulated first reason
; c-parse-type could not describe some type in this declaration, or the empty
; view when it described them all. Carrying the message instead of a flag is what
; lets one arm cover both W3b's layout-less aggregates and W3c's unresolvable
; type names while still naming the offending type in the warning.
(defn c-decl-skip-reason (unrep-why:StrView ret-type:raw:Type ptypes:ptr np:i32):StrView
  (when (not (str-empty? &unrep-why)) (return unrep-why))
  (when (> np C-MAX-PARAMS)
    (return (fstr "more than " C-MAX-PARAMS " parameters")))
  (when (= ret-type null) (return "an unparsed return type"))
  (when (!= (opaque-sdef-of ret-type) null) (return "an opaque return type"))
  (dotimes (i:i32 np)
    (let (pt:(raw Type) (as raw:Type (aref (as &ptr ptypes) i)))
      (when (= pt null) (return "an unparsed parameter type"))
      ; `void` is legal only as a whole (empty) parameter list, which is consumed
      ; before any parameter is recorded — so a recorded void parameter is always
      ; a mis-parse, and `declare void @f(void, ptr)` is the IR LLVM rejects.
      (when (= (pt 'kind) TY-VOID) (return "a 'void' parameter"))
      (when (!= (opaque-sdef-of pt) null) (return "an opaque parameter type"))))
  (return ""))

; Stage 16 FP-4 (design/stage16-ergonomics/c-boundary-defects.md §3): build a
; real TY-FN for a C function-pointer declarator instead of collapsing it to
; `ptr`. `pos` is just past the `(` of the parameter list; `rett` is the return
; type already parsed. Returns null when any inner type is one this parser
; cannot describe — a `ptr` there narrows a legal type rather than mis-stating
; a layout, so the caller's collapse stays the right fallback.
(defn c-parse-fn-type (buf:ptr pos:i64 len:i64 rett:ptr):ptr
  (when (= rett null) (return null))
  (let (ptypes:ptr (arena-alloc (* C-MAX-PARAMS 8))
        np:i32 0
        variadic:i32 0
        bad:i32 0
        done:i32 0
        te:i64 0
        pt:ptr null
        ; The unrep channel is scoped to the enclosing declaration; this parse
        ; happens inside one, so save the caller's verdict and answer for the
        ; inner types through `bad` instead.
        save-unrep:i32 g-cheader-unrep
        save-why:StrView g-cheader-unrep-why
        save-quiet:i32 g-cheader-unrep-quiet)
    (while (= done 0)
      (set! pos (c-skip-ws buf pos len))
      (when (>= pos len) (set! bad 1) (set! done 1))
      (when (and (= done 0) (= (cstr-byte-at buf pos) 41)) (set! done 1))
      (when (and (= done 0) (< (+ pos 2) len)
                 (= (cstr-byte-at buf pos) 46) (= (cstr-byte-at buf (+ pos 1)) 46)
                 (= (cstr-byte-at buf (+ pos 2)) 46))
        (set! variadic 1) (set! done 1))
      (when (= done 0)
        ; `(void)` is C's spelling for "no parameters", not a void parameter.
        (let (ve:i64 0
              vt:Symbol (c-read-ident buf pos len (as &i64 &ve)))
          (when (= vt "void")
            (let (after:i64 (c-skip-ws buf ve len))
              (when (and (< after len) (= (cstr-byte-at buf after) 41))
                (set! done 1))))))
      (when (= done 0)
        (set! g-cheader-unrep 0)
        (set! pt (c-parse-type buf pos len (as &i64 &te)))
        (when (= pt null) (set! bad 1) (set! done 1)))
      (when (= done 0)
        (set! pos (c-skip-ws buf te len))
        ; A function-pointer parameter of a function-pointer type: same
        ; declarator, one level in.
        (when (and (< pos len) (= (cstr-byte-at buf pos) 40))
          (let (fe:i64 0
                fpn:Symbol (symbol-none)
                ft:ptr (c-parse-fnptr-decl buf pos len pt
                                           (as &i64 &fe)
                                           (as &Symbol &fpn)))
            (set! pos fe)
            (set! g-cheader-unrep 0)
            (set! pt (if (!= ft null) ft ty-ptr))))
        (set! pos (c-skip-ws buf pos len))
        (let (ne:i64 0
              pn:Symbol (c-read-ident buf pos len (as &i64 &ne)))
          (when (!= (symbol-len pn) 0) (set! pos ne)))
        (set! pos (c-skip-ws buf pos len))
        (while (and (< pos len) (= (cstr-byte-at buf pos) 91))
          (while (and (< pos len) (!= (cstr-byte-at buf pos) 93)) (set! pos (+ pos 1)))
          (when (< pos len) (set! pos (+ pos 1)))
          (set! pos (c-skip-ws buf pos len))
          (set! g-cheader-unrep 0)
          (set! pt ty-ptr))
        (set! pt (as ptr (array-decay pt)))
        (when (!= g-cheader-unrep 0) (set! bad 1) (set! done 1)))
      (when (and (= done 0) (>= np C-MAX-PARAMS)) (set! bad 1) (set! done 1))
      (when (= done 0)
        (set! (aref (as &ptr ptypes) np) pt)
        (inc! np)
        (set! pos (c-skip-ws buf pos len))
        (if (and (< pos len) (= (cstr-byte-at buf pos) 44))
          (set! pos (+ pos 1))
          (set! done 1))))
    (set! g-cheader-unrep save-unrep)
    (set! g-cheader-unrep-why save-why)
    (set! g-cheader-unrep-quiet save-quiet)
    (when (!= bad 0) (return null))
    ; The same four lines the function's own signature is built from, below.
    (let (ft:ptr:Type (as &Type (make-type TY-FN)))
      (set! (ft 'ret) rett)
      (type-set-params ft ptypes np)
      (set! (ft 'variadic) variadic)
      (return (as ptr ft)))))

; The `(*name)(args)` half of the same declarator, with `pos` at the first `(`.
; `out-end` is set past BOTH paren groups on every path, so a caller that gets
; null is still positioned exactly where the old c-skip-parens pair left it.
; `out-name` receives the declarator identifier (the zero Symbol if abstract) —
; the field name the struct-member site used to drop.
(defn c-parse-fnptr-decl (buf:ptr pos:i64 len:i64 rett:ptr
                          out-end:ptr:i64 out-name:ptr:Symbol):ptr
  (set! @out-name (symbol-none))
  (let (q:i64 (c-skip-ws buf (+ pos 1) len)
        stars:i32 0
        dname:Symbol (symbol-none))
    (while (and (< q len) (= (cstr-byte-at buf q) 42))
      (inc! stars)
      (set! q (c-skip-type-quals buf (+ q 1) len)))
    (let (ne:i64 0
          fpn:Symbol (c-read-ident buf q len (as &i64 &ne)))
      (when (!= (symbol-len fpn) 0) (set! dname fpn)))
    (let (after1:i64 (c-skip-ws buf (c-skip-parens buf pos len) len)
          has2:i32 0
          after2:i64 0)
      (when (and (< after1 len) (= (cstr-byte-at buf after1) 40))
        (set! has2 1)
        (set! after2 (c-skip-parens buf after1 len)))
      (set! @out-end (if (!= has2 0) after2 after1))
      (set! @out-name dname)
      ; No `*`, or no argument list: a parenthesized declarator, not a function
      ; pointer.
      (when (or (= stars 0) (= has2 0)) (return null))
      (return (c-parse-fn-type buf (+ after1 1) len rett)))))

; FP-4: the tail shared by the ordinary `RET name(args);` parse and the
; function-returning-function-pointer one below — attributes, the validity gate,
; explicit-declare precedence, registration, and the ABI-lowered `declare`.
; `pos` is just past the parameter list's `)`.
(defn c-finish-fn-decl (buf:ptr pos:i64 len:i64 out-end:ptr:i64
                        fname:Symbol ret-type:ptr param-types:ptr num-params:i32
                        is-variadic:i32 unrep-why:StrView unrep-quiet:i32
                        decl-start:i64):i32
; Skip any __attribute__ after closing paren
(set! pos (c-skip-ws buf pos len))
(let (attr-check:i32 1)
  (while (!= attr-check 0)
    (set! attr-check 0)
    (let (ae:i64 0
          at:Symbol (c-read-ident buf pos len (as &i64 &ae)))
      (when (= at "__attribute__")
         (set! pos (c-skip-ws buf ae len))
         (when (and (< pos len) (= (cstr-byte-at buf pos) 40))
           (set! pos (c-skip-parens buf pos len)))
         (set! pos (c-skip-ws buf pos len))
         (set! attr-check 1))
      (when (= at "__asm__")
         (set! pos (c-skip-ws buf ae len))
         (when (and (< pos len) (= (cstr-byte-at buf pos) 40))
           (set! pos (c-skip-parens buf pos len)))
         (set! pos (c-skip-ws buf pos len))
         (set! attr-check 1)))))
; Skip semicolon
(when (and (< pos len) (= (cstr-byte-at buf pos) 59))
  (set! pos (+ pos 1)))
(set! @out-end pos)
; W3b validity gate (cheader.md §1.5). The declaration is consumed either
; way — `out-end` is already past its semicolon, so returning 1 keeps the
; caller from rescanning it — but a declaration the importer cannot
; describe is dropped with a located warning instead of registered. Before
; the collect-mode push: aliasing a name that was never registered would
; produce a dangling `prefix/name`.
(let (why:StrView (c-decl-skip-reason unrep-why (as raw:Type ret-type)
                                      param-types num-params))
  (when (not (str-empty? &why))
    ; W3c: only a reason that came through the unrep channel can be
    ; quiet; every other arm (void parameter, opaque type, arity cap,
    ; unparsed type) is a parse-side limitation and stays loud, exactly
    ; as W3b left it.
    (let (loud:i32 1)
      (when (and (= why unrep-why) (!= unrep-quiet 0)) (set! loud 0))
      (cheader-record-skip fname why
                           (cheader-line-at buf decl-start) loud))
    (return 1)))
; W3c precedence (cheader.md §1.4): an explicit `(declare …)` anywhere in
; this unit outranks the header's copy, whichever comes first. Record the
; header-derived signature for the conflict message and drop this
; declaration — registering it would make the *header* win when it
; precedes the declare, and emitting a second `declare` for the same
; symbol is invalid IR even when the two agree.
(when (!= (as ptr (cheader-explicit-declare-site fname)) null)
  (cheader-yield-to-explicit-declare
    fname
    (c-fn-sig-render (as raw:Type ret-type) param-types num-params
                     is-variadic)
    (cheader-line-at buf decl-start))
  (return 1))
; Register the function
(let (ft:ptr:Type (as &Type (make-type TY-FN)))
  (set! (ft 'ret) ret-type)
  (type-set-params ft param-types num-params)
  (set! (ft 'variadic) is-variadic)
  ; Only register if not already defined. B2b: a KEY question, paired
  ; with the `scope-define` it guards.
  (when (= (scope-lookup-key g-globals fname) null)
      (let (csym:ref:Sym (scope-define g-globals fname (as ptr ft)
                          (fstr "@" fname) 0))
        ; Stage 10 Phase F1: mark known-noreturn libc functions.
        (when (c-fn-noreturn fname)
          (set! ((as &Sym csym) 'noreturn) 1))
        (when (c-fn-returns-twice fname)
          (set! ((as &Sym csym) 'returns-twice) 1)))
      (when (= fname "malloc")
        (set! g-malloc-decl-done 1))
      ; Emit LLVM declare, lowering a struct-by-value parameter or return
      ; to the platform C ABI (sret / byval / register coercion) exactly
      ; as `emit-nuch-declare-import` and `emit-defn` do.
      ;
      ; W3c: this path used to print the raw `type-to-ir` of every
      ; parameter and the return. That was invisible until typedef
      ; resolution landed, because glibc names every by-value aggregate
      ; through a typedef and an unfollowed typedef was `ptr` — so the
      ; C-header path had literally never emitted a struct by value.
      ; With the chain followed, `div`/`ldiv`/`lldiv`/`fopencookie`
      ; appear, and printing `%div_t` there would disagree with the ABI
      ; the *call site* already lowers through abi-classify. For every
      ; scalar and pointer declaration abi-classify is ABI-DIRECT and
      ; both helpers reduce to `type-to-ir`, so the emitted text is
      ; byte-identical to the former loop.
      (let (ret-info:ptr:AbiInfo
              (unsafe/cast &AbiInfo (abi-classify (as raw:Type ret-type))))
        (emit g-out "declare " (abi-ret-ir (as raw:AbiInfo ret-info) (as raw:Type ret-type))
              " @" fname "(")
        (let (need-comma:i32 0)
          (when (= ((as &AbiInfo ret-info) 'kind) ABI-MEMORY)
            (emit g-out "ptr sret(" (type-to-ir ret-type) ") align "
                  ((as &AbiInfo ret-info) 'align))
            (set! need-comma 1))
          ; RV-6c: one walk over this declare's parameters — reset the
          ; riscv64 register budget (design/stage14/riscv-fp-abi.md §4).
          (abi-args-begin (as raw:AbiInfo ret-info))
          (let (j:i32 0)
            (while (< j num-params)
              (when (!= need-comma 0) (emit g-out ", "))
              (abi-print-param
                (abi-classify-arg (as raw:Type ((field-at (ft 'params) j) 'type)))
                (as raw:Type ((field-at (ft 'params) j) 'type))
                (symbol-none))
              (set! need-comma 1)
              (inc! j)))
          (when (!= is-variadic 0)
            (let (sep:StrView "")
              (when (!= need-comma 0) (set! sep ", "))
              (emit g-out sep "...")))))
      ; Stage 10 Phase F1: trailing LLVM `noreturn` function attribute.
      (cond
        (c-fn-noreturn fname)      (emit g-out ") noreturn\n")
        (c-fn-returns-twice fname) (emit g-out ") returns_twice\n")
        true                       (emit g-out ")\n"))))
  (return 1))

; FP-4: `RET (*name(params))(rparams);` — a function RETURNING a function
; pointer, which is C's `signal` shape. The declarator nests the other way round
; from everything else here, so the ordinary parse finds no identifier where it
; expects one and declines; this runs first and answers -1 when the shape does
; not match, leaving that path untouched.
(defn c-parse-fnret-decl (buf:ptr pos:i64 len:i64 rett:ptr
                          out-end:ptr:i64 decl-start:i64):i32
  (let (q:i64 (c-skip-ws buf (+ pos 1) len)
        stars:i32 0)
    (while (and (< q len) (= (cstr-byte-at buf q) 42))
      (inc! stars)
      (set! q (c-skip-type-quals buf (+ q 1) len)))
    (when (= stars 0) (return -1))
    (let (ne:i64 0
          fname:Symbol (c-read-ident buf q len (as &i64 &ne)))
      (when (= (symbol-len fname) 0) (return -1))
      (let (ip:i64 (c-skip-ws buf ne len))
        ; `(*name)` with no argument list after the identifier is a plain
        ; function-pointer declarator, not this shape.
        (when (or (>= ip len) (!= (cstr-byte-at buf ip) 40)) (return -1))
        (let (after1:i64 (c-skip-ws buf (c-skip-parens buf pos len) len))
          (when (or (>= after1 len) (!= (cstr-byte-at buf after1) 40)) (return -1))
          (let (after2:i64 (c-skip-parens buf after1 len)
                retfn:ptr (c-parse-fn-type buf (+ after1 1) len rett)
                sigt:ptr null)
            (when (= retfn null) (set! retfn ty-ptr))
            (set! sigt (c-parse-fn-type buf (+ ip 1) len retfn))
            ; No parameter list for the function ITSELF is not something the
            ; ptr fallback can paper over; decline and let the skip machinery
            ; report it as before.
            (when (= sigt null) (return -1))
            (let (st:ptr:Type (as &Type sigt)
                  ptypes:ptr (arena-alloc (* C-MAX-PARAMS 8)))
              (dotimes (j (st 'num-params))
                (set! (aref (as &ptr ptypes) j) (as ptr ((field-at (st 'params) j) 'type))))
              (return (c-finish-fn-decl buf after2 len out-end fname retfn
                                        ptypes (st 'num-params) (st 'variadic)
                                        "" 0 decl-start)))))))))

; Stage 16 C2 (design/stage16-ergonomics/cheader-parser-vs-libclang.md §3): a
; declaration the parser DECLINED to read as a function is dropped, and the use
; site then says only `unknown: f — not defined anywhere in this compilation
; unit`, which gives the user no thread to pull. Most declines are legitimate —
; a variable, a macro remnant, an `__asm__` fragment — so this records only the
; shape that is unambiguously a prototype: an identifier immediately followed by
; `(`, with no `{` body in the span. Recorded QUIETLY: the two-tier policy
; (cheader-record-skip) puts a parse-side limitation on stderr, and this one is
; reached by shapes the parser was never going to read, so the use-site message
; is where it belongs.
(defn cheader-note-unparsed-decl (buf:ptr start:i64 stop:i64):void
  (let (p:i64 start
        name:Symbol (symbol-none)
        name-end:i64 0
        saw-paren:i32 0
        why:StrView "a declaration shape the C header parser does not recognize")
    (while (< p stop)
      (when (= (cstr-byte-at buf p) 123) (return))
      (let (c:i32 (as i32 (cstr-byte-at buf p)))
        (if (or (and (>= c 65) (<= c 90))
                (or (and (>= c 97) (<= c 122)) (= c 95)))
          (let (e:i64 0
                id:Symbol (c-read-ident buf p stop (as &i64 &e)))
            ; A keyword is a specifier, never the declared name.
            (when (= (cheader-reserved-word (symbol-as-view id)) 0)
              (set! name id)
              (set! name-end e))
            (set! p e))
          (do
            (when (= c 40)
              (set! saw-paren 1)
              ; A `(` immediately after a non-keyword identifier is that name's
              ; parameter list — the common shape, and unambiguous.
              (when (and (not (symbol-none? name)) (= (c-skip-ws buf name-end stop) p))
                (cheader-record-skip name why (cheader-line-at buf start) 0)
                (return)))
            (set! p (+ p 1))))))
    ; Otherwise the declarator was parenthesised (`int (f)(int);`) and the name
    ; is simply the last non-keyword identifier in a declaration that has a
    ; parameter list somewhere.
    (when (and (!= saw-paren 0) (not (symbol-none? name)))
      (cheader-record-skip name why (cheader-line-at buf start) 0))))

; Parse one C function declaration from the buffer.
; Expects pos to be at the start of a declaration (after leading whitespace).
; Returns 1 if a function declaration was parsed, 0 otherwise.
; On success, registers the function in g-globals and emits LLVM declare.
(defn c-parse-func-decl (buf:ptr pos:i64 len:i64 out-end:ptr:i64 line:i32):i32
  ; W3b: the gate's per-declaration state. Cleared here rather than at the
  ; c-parse-type call sites so a nested struct-body parse cannot leak a flag set
  ; by an earlier top-level declaration into this one.
  (set! g-cheader-unrep 0)
  ; Parse the return type
  (let (ret-end:i64 0
        decl-start:i64 pos
        ret-type:ptr (c-parse-type buf pos len (as &i64 &ret-end)))
    (set! pos ret-end)
    ; C decays an array in a parameter or return position; a struct MEMBER keeps
    ; its extent, which is why the call is here and not in c-parse-type.
    (set! ret-type (as ptr (array-decay ret-type)))
    (set! pos (c-skip-ws buf pos len))
    (when (and (< pos len) (= (cstr-byte-at buf pos) 40))
      (let (fr:i32 (c-parse-fnret-decl buf pos len ret-type out-end decl-start))
        (when (>= fr 0) (return fr))))
    ; Read the function name
    (let (name-end:i64 0
          fname:Symbol (c-read-ident buf pos len (as &i64 &name-end)))
      (when (= (symbol-len fname) 0)
         (set! @out-end pos) (return 0))
      (set! pos name-end)
      (set! pos (c-skip-ws buf pos len))
      ; Expect '('
      (when (or (>= pos len) (!= (cstr-byte-at buf pos) 40))
         (set! @out-end pos) (return 0))
      (set! pos (+ pos 1))
      ; Parse parameters
      (let (param-types:ptr (arena-alloc (* C-MAX-PARAMS 8))
            num-params:i32 0
            is-variadic:i32 0
            pdone:i32 0
            ; W3b: the declaration-level accumulator for "contains a type this
            ; parser cannot describe". Seeded with the return type's verdict
            ; (g-cheader-unrep was cleared at function entry, immediately before
            ; the return type was parsed); each parameter contributes below,
            ; *after* the post-parse type overrides have had their say. W3c holds
            ; the *reason* rather than a flag, and keeps the FIRST one: a later
            ; parameter can raise the global and then have it cleared by the
            ; function-pointer / array override, which would otherwise leave a
            ; stale message attached to an earlier parameter's verdict.
            unrep-why:StrView (if (!= g-cheader-unrep 0) g-cheader-unrep-why "")
            unrep-quiet:i32 (if (!= g-cheader-unrep 0) g-cheader-unrep-quiet 0))
        (while (= pdone 0)
          (set! pos (c-skip-ws buf pos len))
          (when (>= pos len) (set! pdone 1))
          (when (= pdone 0)
            ; Check for ')'
            (when (= (cstr-byte-at buf pos) 41)
               (set! pos (+ pos 1)) (set! pdone 1))
            (when (= pdone 0)
              ; Check for '...'
              (when (and (< (+ pos 2) len)
                         (= (cstr-byte-at buf pos) 46)
                         (= (cstr-byte-at buf (+ pos 1)) 46)
                         (= (cstr-byte-at buf (+ pos 2)) 46))
                 (set! is-variadic 1)
                 (set! pos (+ pos 3))
                 (set! pos (c-skip-ws buf pos len))
                 (when (and (< pos len) (= (cstr-byte-at buf pos) 41))
                   (set! pos (+ pos 1)))
                 (set! pdone 1))
              (when (= pdone 0)
                ; Check for void param (no-arg function)
                (let (void-check-end:i64 0
                      void-check:Symbol (c-read-ident buf pos len (as &i64 &void-check-end)))
                  (when (= void-check "void")
                    (let (after-void:i64 (c-skip-ws buf void-check-end len))
                      (when (and (< after-void len) (= (cstr-byte-at buf after-void) 41))
                         (set! pos (+ after-void 1))
                         (set! pdone 1)))))
                (when (= pdone 0)
                  ; Parse parameter type. W3b: clear the by-value-aggregate flag
                  ; first so it reports on THIS parameter only.
                  (set! g-cheader-unrep 0)
                  (let (ptype-end:i64 0
                        ptype:ptr (c-parse-type buf pos len (as &i64 &ptype-end)))
                    (set! pos ptype-end)
                    (set! pos (c-skip-ws buf pos len))
                    ; Handle function pointer params: void (*name)(args)
                    (when (and (< pos len) (= (cstr-byte-at buf pos) 40))
                      (let (fe:i64 0
                            fpn:Symbol (symbol-none)
                            ft:ptr (c-parse-fnptr-decl buf pos len ptype
                                                       (as &i64 &fe)
                                                       (as &Symbol &fpn)))
                        (set! pos fe)
                        ; A pointer-to-function parameter is a pointer whatever
                        ; its return/argument types were, so an aggregate met
                        ; while parsing them says nothing about this parameter.
                        (set! g-cheader-unrep 0)
                        (set! ptype (if (!= ft null) ft ty-ptr))))
                    ; Skip parameter name (if present)
                    (when (and (< pos len)
                               (or (and (>= (as i32 (cstr-byte-at buf pos)) 65)
                                        (<= (as i32 (cstr-byte-at buf pos)) 90))
                                   (or (and (>= (as i32 (cstr-byte-at buf pos)) 97)
                                            (<= (as i32 (cstr-byte-at buf pos)) 122))
                                       (= (as i32 (cstr-byte-at buf pos)) 95))))
                      (let (skip-end:i64 0
                            skip:Symbol (c-read-ident buf pos len (as &i64 &skip-end)))
                        (set! pos skip-end)))
                    ; Skip array brackets if present: [N]
                    (set! pos (c-skip-ws buf pos len))
                    (while (and (< pos len) (= (cstr-byte-at buf pos) 91))
                      (while (and (< pos len) (!= (cstr-byte-at buf pos) 93))
                        (set! pos (+ pos 1)))
                      (when (< pos len) (set! pos (+ pos 1)))
                      (set! pos (c-skip-ws buf pos len))
                      ; An array parameter decays to a pointer in C, so an
                      ; element type with no layout is not passed by value and
                      ; the declaration stays representable — glibc's
                      ; `utimensat(int, const char *, const struct timespec [2],
                      ; int)` is the case that proved this must clear the flag.
                      (set! g-cheader-unrep 0)
                      (set! ptype ty-ptr))
                    ; The syntactic `[N]` above cannot see an array reached
                    ; through a typedef; array-decay covers both spellings.
                    (set! ptype (as ptr (array-decay ptype)))
                    ; W3b: this parameter's contribution to the gate, taken after
                    ; every override above.
                    (when (and (!= g-cheader-unrep 0) (str-empty? &unrep-why))
                      (set! unrep-why g-cheader-unrep-why)
                      (set! unrep-quiet g-cheader-unrep-quiet))
                    ; Store parameter type. Over capacity the count still grows,
                    ; so the gate below sees the real arity and skips the
                    ; declaration instead of emitting a truncated one.
                    (when (< num-params C-MAX-PARAMS)
                      (set! (aref (as &ptr param-types) num-params) ptype))
                    (inc! num-params)
                    (set! pos (c-skip-ws buf pos len))
                    ; Expect ',' or ')'
                    (when (and (< pos len) (= (cstr-byte-at buf pos) 44))
                      (set! pos (+ pos 1)))))))))
        (return (c-finish-fn-decl buf pos len out-end fname ret-type
                                 param-types num-params is-variadic
                                 unrep-why unrep-quiet decl-start))))))

; ============================================================
; Preprocessed-header cache (Stage 15 W3a)
;
; `clang -E -x c -include <path> /dev/null` takes no other input, so its output is
; a pure function of the header path. The same header is preprocessed several
; times per compilation — once per `(import-use "<path>")` that names it (a C
; header import is deliberately NOT deduplicated, since each import may alias
; under a different prefix), plus once for the W3a opaque name pre-scan. Caching
; the text by path collapses that to one clang run per distinct header: a
; `hello.nuc` build went from 5 preprocessor invocations to 3 even after W3a added
; its pre-scan pass. The buffers were never freed before either (they outlive the
; parse via the Types built from them), so this strictly reduces allocation.
;
; The cache reuses a Node cell as its record, exactly as the import lists do:
; `s` = header path, `car` = the buffer, `i` = its length.
; ============================================================
; One preprocessed header text. A record, not a Node: it carries four fields and
; a link, which is one more than a Node has room for now that `car`/`cdr` are on
; their way out (design/stage21-cleanup/ast-as-collection.md §8).
(defstruct CHeaderCache
  path:Symbol
  dump-macros:i32
  len:i64
  buf:ptr
  (next (raw CHeaderCache)))

(defvar (g-cheader-cache (raw CHeaderCache)))

; Stage 16 C4 (cheader-parser-vs-libclang.md §6): the flags that make `clang -E`
; read the EMISSION target's headers rather than the host's. Empty unless
; `--target=` names a triple the host is not, so a host build's command line —
; and every byte of IR downstream of it — is unchanged.
; Does this compile need clang pointed at a target other than the host? Two
; flags at most, which is why they go on an argv rather than into a string.
(defn cheader-cc-target? ():bool
  (return (or (and (not (symbol-none? g-target-triple-override))
                   (!= g-target-triple ((as &Target g-host-target) 'triple)))
              (not (symbol-none? g-sysroot-override)))))

; The `clang -E` invocation, as an argv. A `--sysroot` naming a directory with a
; space in it was a quoting bug in the command-string version; here it is one
; argument.
(defn cheader-cpp-command (header-path:Symbol with-target:bool dump-macros:i32):Command
  (let (c:Command (command "clang"))
    (command-arg &c "-E")
    (when (!= dump-macros 0) (command-arg &c "-dM"))
    (when with-target
      (when (and (not (symbol-none? g-target-triple-override))
                 (!= g-target-triple ((as &Target g-host-target) 'triple)))
        (command-arg &c (fstr "--target=" g-target-triple)))
      (when (not (symbol-none? g-sysroot-override))
        (command-arg &c (fstr "--sysroot=" g-sysroot-override))))
    ; The user's `--cflag=`s ride every run, the host fallback included: they
    ; name the user's directories, not the target's.
    (dotimes (j (unsafe/cast i32 (count g-cflags)))
      (command-arg &c (symbol-as-view (invoke g-cflags j:usize))))
    (command-arg &c "-x")
    (command-arg &c "c")
    (when (not (symbol-none? header-path))
      (command-arg &c "-include")
      (command-arg &c (symbol-as-view header-path)))
    (command-arg &c "/dev/null")
    (return c)))

; The same invocation as text, for a diagnostic that has to show the user what
; was run. Display only — nothing executes this spelling.
(defn cheader-cpp-display (header-path:Symbol with-target:bool dump-macros:i32):StrView
  (let (out:StrView "clang -E")
    (when (!= dump-macros 0) (set! out (fstr out " -dM")))
    (when with-target
      (when (and (not (symbol-none? g-target-triple-override))
                 (!= g-target-triple ((as &Target g-host-target) 'triple)))
        (set! out (fstr out " --target=" g-target-triple)))
      (when (not (symbol-none? g-sysroot-override))
        (set! out (fstr out " --sysroot=" g-sysroot-override))))
    (dotimes (j (unsafe/cast i32 (count g-cflags)))
      (set! out (fstr out " " (invoke g-cflags j:usize))))
    (set! out (fstr out " -x c"))
    (when (not (symbol-none? header-path))
      (set! out (fstr out " -include " header-path)))
    (return (fstr out " /dev/null"))))

; Run it and hand back stdout as a NUL-terminated buffer. The `String` is parked
; in a process-lifetime vector: the cheader cache hands these bytes out as a bare
; pointer and nothing ever frees them, so the owner has to outlive every reader.
; The child's stderr is captured and dropped, which is what the old command
; string's `2>/dev/null` did.
(defn cheader-capture (c:&Command out-len:ptr:i64 out-status:ptr:i32):ptr
  (command-capture c true)
  (set! @out-len 0)
  (set! @out-status -1)
  (let (out:String (string-new)
        errs:String (string-new))
    (match (spawn c)
      ((ok p)
       (match (process-capture &p &out &errs)
         (ok
          (match (process-wait &p)
            ((ok st) (set! @out-status (exit-code &st)))
            ((err e) (set! @out-status -1))))
         ((err e) (set! @out-status -1))))
      ((err e)
       (drop &out)
       (drop &errs)
       (return null)))
    (drop &errs)
    (when (!= @out-status 0)
      (drop &out)
      (return null))
    ; `string-as-cstr` before the length: it reserves one byte for the NUL and
    ; may reallocate, so the pointer has to be taken after it, not before.
    (let (p:ptr (as ptr (string-as-cstr &out)))
      (set! @out-len (as i64 (byte-len &out)))
      (conj g-cheader-bufs out)
      (return p))))

; C4: one `clang -E` run. `with-target` is false for a host read.
(defn cheader-run-cpp (header-path:Symbol with-target:bool dump-macros:i32
                       out-len:ptr:i64 out-status:ptr:i32):ptr
  (let (c:Command (cheader-cpp-command header-path with-target dump-macros)
        buf:ptr (cheader-capture &c out-len out-status))
    (drop &c)
    (return buf)))

; C4: clang could not read the header at all. Re-run the failing command with
; stderr attached — clang's own "'x.h' file not found" is the whole diagnosis,
; and this path is already fatal.
(defn cheader-preprocess-failed (header-path:Symbol with-target:bool):void
  (eprint "  note: " (cheader-cpp-display header-path with-target 0) "\n")
  (let (c:Command (cheader-cpp-command header-path with-target 0))
    ; stdout would be the preprocessed text; only the diagnosis is wanted.
    (command-arg &c "-o")
    (command-arg &c "/dev/null")
    (match (spawn &c)
      ((ok p) (process-wait &p) 0)
      ((err e) 0))
    (drop &c)))

(defn cheader-preprocess (header-path:Symbol out-len:ptr:i64):ptr
  (return (cheader-preprocess-mode header-path 0 out-len)))

; Stage 17 (platform-constants.md §4): `dump-macros` adds `-dM`, which replaces
; the preprocessed text with the macro table. Two different answers for one
; header path, so the cache record's otherwise-unused `line` field keeps them
; apart.
(defn cheader-preprocess-mode (header-path:Symbol dump-macros:i32 out-len:ptr:i64):ptr
  (let (cur:(raw CHeaderCache) g-cheader-cache)
    (while (!= cur null)
      (let (e:&CHeaderCache (unsafe/cast &CHeaderCache cur))
        ; `--cflag=`s are not in the key: fixed for a batch process, and at the
        ; prompt `(cflag …)` empties the cache instead of joining the key.
        (when (and (= (e 'path) header-path) (= (e 'dump-macros) dump-macros))
          (set! @out-len (e 'len))
          (return (e 'buf)))
        (set! cur (e 'next)))))
  (let (with-target:bool (cheader-cc-target?)
        buf-len:i64 0
        status:i32 0
        buf:ptr null)
    (set! buf (cheader-run-cpp header-path with-target dump-macros
                               (as &i64 &buf-len)
                               (as &i32 &status)))
    ; C4: a non-zero exit means clang produced only its built-in preamble, so
    ; every name the header declares would go missing with no explanation.
    ; Off-host that is usually "no sysroot for this target on this machine", and
    ; refusing outright would retire cross-compiling for every triple whose libc
    ; headers are not installed — which is how every target lane in the suite
    ; runs. Fall back to the host text, which is exactly the pre-C4 behaviour,
    ; but say so: the widths in it are the host's.
    (when (and (!= status 0) with-target)
      (set! buf (cheader-run-cpp header-path false dump-macros
                                 (as &i64 &buf-len)
                                 (as &i32 &status)))
      ; The macro run follows the declaration run for the same header, which has
      ; already said this.
      (when (and (= status 0) (= dump-macros 0))
        ; No source location: this is about the toolchain, not the user's file.
        (diag-stage-note "pass --sysroot=<path> naming a sysroot that carries the target's own headers")
        (diag-emit "warning" (symbol-none) -1
            (fstr "C header '" header-path "' could not be preprocessed for target '"
                  g-target-triple "'; using the HOST's headers, whose type widths may differ")))
      (set! with-target false))
    ; Cached as a null buffer like any other answer — the pre-scan and the real
    ; import both ask, and the diagnosis should be printed once.
    (when (!= status 0)
      (when (= dump-macros 0) (cheader-preprocess-failed header-path with-target))
      (set! buf null)
      (set! buf-len 0))
    (when (= buf null) (set! @out-len 0))
    (let (n:&CHeaderCache (new CHeaderCache))
      (set! (n 'path) header-path)
      (set! (n 'dump-macros) dump-macros)
      (set! (n 'len) buf-len)
      (set! (n 'buf) buf)
      (set! (n 'next) g-cheader-cache)
      (set! g-cheader-cache (as raw:CHeaderCache n)))
    (set! @out-len buf-len)
    (return buf)))

; Process a C header file: run clang -E, parse function declarations.
; header-path is e.g. "stdio.h" or "/usr/include/mylib.h".
; Size in bytes of C `long` for the configured target's data model (Stage 8):
; LP64 -> 8, ILP32 -> 4, LLP64 (Windows) -> 4. `long long` is always 8.
; C4: `<= 4`, not `= 4` — AVR is a 2-byte-pointer target whose `long` is 4.
(defn target-long-size ():i32
  (when (<= ((as &Target g-target) 'ptr-size) 4) (return 4))
  (when (strview-contains (symbol-as-view ((as &Target g-target) 'triple))
                          "windows")
    (return 4))
  (return 8))

; Stage 16 C4: the target's C `int`. 16-bit on AVR, 32-bit on every other
; target the compiler registers a backend for; also the width clang gives a C
; enum (verified against `clang --target=avr`, which does NOT short-enum).
(defn c-int-type (is-unsigned:i32):(raw Type)
  (when (= ((as &Target g-target) 'ptr-size) 2)
    (if (!= is-unsigned 0) (return ty-ui16) (return ty-i16)))
  (if (!= is-unsigned 0) (return ty-ui32) (return ty-i32)))

; Stage 15 W3a: give a header-derived StructDef its fields and write its LLVM
; type definition. Factored out of c-parse-struct-body so the fresh-registration
; path and the opaque-upgrade path emit *exactly* the same definition — a tag
; that was forward-declared first must end up indistinguishable from one whose
; body came first.
(defn cheader-struct-define (sd:ptr:StructDef fnames:ptr ftypes:ptr faligns:ptr
                             fbits:ptr nfields:i32 is-union:i32 packed:i32
                             align:i32):void
  ; PK-2: before struct-set-fields, because that is what makes the layout final
  ; and the type line below already spells `<{ … }>` from this bit.
  (set! (sd 'packed) packed)
  (set! (sd 'align-attr) align)
  ; struct-set-fields also clears `opaque` (abi.nuc) — the layout is now known.
  (struct-set-fields sd fnames ftypes nfields)
  (struct-set-field-aligns (as raw:StructDef sd) faligns nfields)
  (struct-set-field-bits (as raw:StructDef sd) fbits nfields)
  (if (!= is-union 0)
    ; Named union: members at offset 0; the IR type definition is deferred
    ; until member layouts are final (drain-pending-union-irs).
    (do
      (set! (sd 'is-union) 1)
      (queue-type-line sd))
    (do
      (emit-struct-type-line &g-type-stream (as raw:StructDef sd))
      ; W3c: pending-union-deps-ready consults this before writing a queued union
      ; whose field names this struct, and the cheader path writes its
      ; `%X = type {…}` line directly rather than through emit-struct-ir-type —
      ; so it has to record the write itself. Without it a C union with a struct
      ; member (SDL's `SDL_WindowShapeParams`) deferred on every drain.
      (sdef-note-emitted (as raw:StructDef sd) &g-type-stream))))

; Stage 15 W3a: make `dst` share `src`'s layout and write `dst`'s own LLVM type
; definition. Used for a `typedef struct Tag Name;` alias entry (which is a
; separate registry entry because lookup-struct is keyed by name) and to upgrade
; an entry that was registered opaque before its definition was reached. The
; `fields` Vector is immutable after build, so sharing the handle is sound.
(defn cheader-adopt-shape (dst:ptr:StructDef src:ptr:StructDef):void
  (set! (dst 'fields) (src 'fields))
  (set! (dst 'num-fields) (src 'num-fields))
  ; PK-2: sharing the field table is not sharing the LAYOUT — an alias that
  ; dropped this printed `{ … }` for a `<{ … }>` type and sized it as unpacked.
  (set! (dst 'packed) (src 'packed))
  (set! (dst 'align-attr) (src 'align-attr))
  (set! (dst 'opaque) 0)
  (if (!= (src 'is-union) 0)
    ; Union: same deferred-definition path as the tag (drain-pending-union-irs).
    (do
      (set! (dst 'is-union) 1)
      (queue-type-line dst))
    (do
      (emit-struct-type-line &g-type-stream (as raw:StructDef dst))
      ; W3c: see cheader-struct-define — the alias's definition is now in this
      ; module's type buffer, so a queued union naming it must count it as ready.
      (sdef-note-emitted (as raw:StructDef dst) &g-type-stream))))

; Stage 15 W3a: propagate a just-upgraded tag's layout to every
; `typedef struct Tag Name;` alias that was registered while Tag was still
; opaque. `alias-of` is the only link between the two registry entries.
(defn struct-upgrade-aliases (tag:ptr:StructDef):void
  (dotimes (i (unsafe/cast i32 (count g-structs)))
    (let (a:ptr:StructDef (as &StructDef (invoke g-structs i:usize)))
      (when (and (= (as ptr (a 'alias-of)) (as ptr tag)) (!= (a 'opaque) 0))
        (cheader-adopt-shape a tag)))))

; Stage 15 W3a: register a C type whose name is known but whose layout is not —
; `struct Foo;` (a forward declaration) or the `Foo` of
; `typedef struct Bar Foo;`. `ptr:Foo` then resolves; any by-value use is
; rejected with this declaration's header:line (reject-opaque-type). Returns the
; entry (existing or new); never overwrites an already-known layout, so a
; repeated forward declaration — glibc's stdio.h carries `struct _IO_FILE;`
; three times — and a forward declaration *after* the definition are both no-ops.
(defn cheader-register-opaque (name:Symbol line:i32 is-union:i32
                               alias-of-sd:raw):ptr
  (let (existing:ptr (lookup-struct name))
    (when (!= existing null) (return existing)))
  (let (sd:ptr:StructDef (register-struct name))
    (set! (sd 'opaque) 1)
    (set! (sd 'is-union) is-union)
    (set! (sd 'alias-of) (as raw:StructDef alias-of-sd))
    (set! (sd 'src-file) g-cheader-file)
    (set! (sd 'src-line) line)
    (set! (sd 'from-c) 1)
    (return (as ptr sd))))

; ============================================================
; Stage 16 L2: a C array extent
; (design/stage16-ergonomics/c-header-layout.md §3.2)
;
; The preprocessor has already expanded every macro, so what is left in a `[…]`
; is a C constant expression over literals and `sizeof`. It is evaluated for the
; EMISSION target — `clang -E` preprocesses for the host even under `--target=`,
; so a host `sizeof` would silently size an array for the wrong machine, the
; same trap that keeps `size_t`/`ssize_t` hardcoded in c-type-to-nucleus.
;
; Anything the evaluator cannot fold clears `ok`, which abandons the struct and
; leaves the name opaque (L1) rather than guessing an extent.
; ============================================================

; Is a C type name next? Separates `( type )` — a cast, or a sizeof operand —
; from `( expr )`; an identifier that is neither a specifier keyword nor a
; recorded typedef or tag is not one.
(defn c-cexpr-type-ahead (buf:ptr pos:i64 len:i64):i32
  (let (p:i64 (c-skip-ws buf pos len)
        e:i64 0
        tok:Symbol (c-read-ident buf p len (as &i64 &e)))
    (when (= (symbol-len tok) 0) (return 0))
    (let (specs:&(HashSet StrView)
          #{"void" "char" "short" "int" "long" "float" "double"
            "signed" "unsigned" "_Bool" "const" "volatile"
            "restrict" "__restrict" "_Atomic" "struct" "union"
            "enum" "__extension__"})
      (when (contains? specs (symbol-as-view tok)) (return 1)))
    (if-some (td (c-typedef-find tok)) (return 1) 0)
    (let (sd:ptr (lookup-struct tok))
      (when (!= sd null) (return 1)))
    (return 0)))

; An integer literal: `0x…` hex, `0…` octal, decimal, with C's u/U/l/L suffixes.
(defn c-cexpr-number (buf:ptr pos:i64 len:i64 out-end:ptr:i64 ok:ptr:i32):i64
  (let (p:i64 pos
        v:i64 0
        base:i64 10)
    (when (and (< (+ p 1) len) (= (cstr-byte-at buf p) 48))
      (let (c1:i32 (cstr-byte-at buf (+ p 1)))
        (when (or (= c1 120) (= c1 88)) (set! base 16) (set! p (+ p 2)))
        (when (and (= base 10) (!= (isdigit c1) 0)) (set! base 8) (set! p (+ p 1)))))
    (let (start:i64 p
          more:i32 1
          over:i32 0)
      (while (!= more 0)
        (set! more 0)
        (when (< p len)
          (let (c:i32 (cstr-byte-at buf p)
                d:i32 -1)
            (when (!= (isdigit c) 0) (set! d (- c 48)))
            (when (and (= base 16) (and (>= c 97) (<= c 102))) (set! d (- c 87)))
            (when (and (= base 16) (and (>= c 65) (<= c 70))) (set! d (- c 55)))
            (when (and (>= d 0) (< (as i64 d) base))
              (when (c-u64-digit-over? v base (as i64 d)) (set! over 1))
              (set! v (+ (* v base) (as i64 d)))
              (set! p (+ p 1))
              (set! more 1)))))
      (when (= p start) (set! @ok 0))
      ; Past UINT64_MAX a literal has no C type in any base; clang refuses it.
      (when (!= over 0) (set! @ok 0))
      (let (more:i32 1
            has-u:i32 0
            nl:i32 0)
        (while (!= more 0)
          (set! more 0)
          (when (< p len)
            (let (c:i32 (cstr-byte-at buf p))
              (when (or (= c 117) (= c 85)) (set! has-u 1) (set! p (+ p 1)) (set! more 1))
              (when (or (= c 108) (= c 76)) (inc! nl) (set! p (+ p 1)) (set! more 1)))))
        (set! g-cexpr-rank (c-literal-rank v (< v 0) (= base 10) has-u nl))))
    (set! @out-end p)
    (return v)))

; Would `v * base + d` pass UINT64_MAX, each read unsigned?
(defn c-u64-digit-over? (v:i64 base:i64 d:i64):bool
  (let (lim:ui64 (/ (- (unsafe/cast ui64 (as i64 -1)) (unsafe/cast ui64 d))
                    (unsafe/cast ui64 base)))
    (return (> (unsafe/cast ui64 v) lim))))

; `sizeof (<type>)`, with `pos` just past the `(`.
(defn c-cexpr-sizeof (buf:ptr pos:i64 len:i64 out-end:ptr:i64 ok:ptr:i32):i64
  (let (save-unrep:i32 g-cheader-unrep
        save-why:StrView g-cheader-unrep-why
        save-quiet:i32 g-cheader-unrep-quiet
        te:i64 0
        ty:ptr null
        n:i64 0)
    (set! g-cheader-unrep 0)
    (set! ty (c-parse-type buf pos len (as &i64 &te)))
    ; An unresolvable name comes back as `ptr` with the flag raised, so folding
    ; its size here would be exactly the silent wrong answer L1/L2 remove.
    (when (or (= ty null) (!= g-cheader-unrep 0)) (set! @ok 0) (set! ty null))
    (set! g-cheader-unrep save-unrep)
    (set! g-cheader-unrep-why save-why)
    (set! g-cheader-unrep-quiet save-quiet)
    (set! te (c-skip-body-ws buf te len))
    (if (and (< te len) (= (cstr-byte-at buf te) 41))
      (set! te (+ te 1))
      (set! @ok 0))
    (set! @out-end te)
    (when (!= ty null) (set! n (as i64 (abi-sizeof ty))))
    ; size_t: unsigned, pointer-wide.
    (set! g-cexpr-rank (c-rank (as i64 (* ((as &Target g-target) 'ptr-size) 8)) 1))
    (return n)))

; A one-character constant, `'x'` or a simple escape. Refused past 0x7f, where
; the value depends on the target's `char` signedness, and when multi-character.
(defn c-cexpr-char (buf:ptr pos:i64 len:i64 out-end:ptr:i64 ok:ptr:i32):i64
  (let (p:i64 (+ pos 1)
        v:i64 -1)
    (when (< p len)
      (let (c:i32 (cstr-byte-at buf p))
        (if (!= c 92)
          (when (!= c 39) (set! v (as i64 c)) (set! p (+ p 1)))
          (when (< (+ p 1) len)
            (let (d:i32 (cstr-byte-at buf (+ p 1)))
              (set! p (+ p 2))
              (case d
                110 (set! v 10)
                116 (set! v 9)
                114 (set! v 13)
                97  (set! v 7)
                98  (set! v 8)
                102 (set! v 12)
                118 (set! v 11)
                (:or 92 39 34 63) (set! v (as i64 d))
                120 (let (more:i32 1)
                      (set! v 0)
                      (while (and (!= more 0) (< p len) (<= v 255))
                        (let (h:i32 (cstr-byte-at buf p)
                              hv:i32 -1)
                          (when (and (>= h 48) (<= h 57)) (set! hv (- h 48)))
                          (when (and (>= h 97) (<= h 102)) (set! hv (- h 87)))
                          (when (and (>= h 65) (<= h 70)) (set! hv (- h 55)))
                          (if (< hv 0)
                            (set! more 0)
                            (do (set! v (+ (* v 16) (as i64 hv)))
                                (set! p (+ p 1)))))))
                (when (and (>= d 48) (<= d 55))
                  (set! v (as i64 (- d 48)))
                  (dotimes (k 2)
                    (when (and (< p len) (and (>= (cstr-byte-at buf p) 48)
                                              (<= (cstr-byte-at buf p) 55)))
                      (set! v (+ (* v 8) (as i64 (- (cstr-byte-at buf p) 48))))
                      (set! p (+ p 1)))))))))))
    (if (and (< p len) (= (cstr-byte-at buf p) 39))
      (set! p (+ p 1))
      (set! @ok 0))
    (when (or (< v 0) (> v 127)) (set! @ok 0))
    (set! g-cexpr-rank (c-rank-int))
    (set! @out-end p)
    (return v)))

; The type a cast names, or null when it does not resolve.
(defn c-cexpr-cast-type (buf:ptr pos:i64 stop:i64):ptr
  (let (save-unrep:i32 g-cheader-unrep
        save-why:StrView g-cheader-unrep-why
        save-quiet:i32 g-cheader-unrep-quiet
        te:i64 0
        ty:ptr null)
    (set! g-cheader-unrep 0)
    (set! ty (c-parse-type buf pos stop (as &i64 &te)))
    (when (!= g-cheader-unrep 0) (set! ty null))
    (set! g-cheader-unrep save-unrep)
    (set! g-cheader-unrep-why save-why)
    (set! g-cheader-unrep-quiet save-quiet)
    (return ty)))

; C's conversion of `v` to the integer type a cast names: `(gint)(1u << 31)` is
; INT_MIN. A pointer or unresolved type leaves the value alone.
(defn c-cexpr-convert (v:i64 ty:ptr):i64
  (set! g-cexpr-rank (c-rank-int))
  (when (= ty null) (set! g-cexpr-rank (c-rank 64 0)) (return v))
  (let (t:raw:Type (as raw:Type ty))
    (when (= (t 'kind) TY-BOOL)
      (when (!= v 0) (return 1))
      (return 0))
    (when (= (is-int-type t) 0) (set! g-cexpr-rank (c-rank 64 0)) (return v))
    (let (w:i64 (as i64 (int-width t))
          r:i32 (c-rank w (if (!= (is-unsigned t) 0) 1 0)))
      ; Narrower than `int` promotes to `int`.
      (when (>= w (c-int-bits)) (set! g-cexpr-rank r))
      (return (c-norm v r)))))

(defn c-cexpr-primary (buf:ptr pos:i64 len:i64 out-end:ptr:i64 ok:ptr:i32):i64
  (let (p:i64 (c-skip-body-ws buf pos len))
    (when (>= p len) (set! @ok 0) (set! @out-end p) (return 0))
    (let (c:i32 (cstr-byte-at buf p))
      (when (!= (isdigit c) 0)
        (return (c-cexpr-number buf p len out-end ok)))
      (when (and (= c 39) (or (!= g-cmacro-folding 0) (!= g-cenum-folding 0)))
        (return (c-cexpr-char buf p len out-end ok)))
      (when (= c 40)
        (when (!= (c-cexpr-type-ahead buf (+ p 1) len) 0)
          (let (close:i64 (c-skip-parens buf p len)
                cty:ptr (c-cexpr-cast-type buf (+ p 1) (- close 1))
                v:i64 (c-cexpr-unary buf close len out-end ok))
            (return (c-cexpr-convert v cty))))
        (let (e:i64 0
              v:i64 (c-cexpr-top buf (+ p 1) len (as &i64 &e) ok))
          (set! e (c-skip-body-ws buf e len))
          (if (and (< e len) (= (cstr-byte-at buf e) 41))
            (set! e (+ e 1))
            (set! @ok 0))
          (set! @out-end e)
          (return v)))
      (let (e:i64 0
            tok:Symbol (c-read-ident buf p len (as &i64 &e)))
        (when (= tok "sizeof")
          (let (q:i64 (c-skip-body-ws buf e len))
            (when (and (< q len) (= (cstr-byte-at buf q) 40))
              (return (c-cexpr-sizeof buf (+ q 1) len out-end ok)))))
        ; Only while folding macros: `-E` output has every macro already
        ; expanded, so an identifier in an array extent is an enum member or a
        ; const object, and resolving it against a same-named macro would be a
        ; wrong answer rather than a better one.
        (when (!= g-cmacro-folding 0)
          (let (mv:i64 0)
            (when (!= (cmacro-value tok (as &i64 &mv)) 0)
              (set! @out-end e)
              (return mv))))
        ; Enumerators too, but not in an array extent: that would lay out structs
        ; that were opaque, as c-cexpr-top's bitwise levels would.
        (when (or (!= g-cmacro-folding 0) (!= g-cenum-folding 0))
          (let (ev:i64 0)
            (when (!= (cenum-value tok (as &i64 &ev)) 0)
              (set! g-cexpr-rank (c-value-rank ev))
              (set! @out-end e)
              (return ev)))))
      (set! @ok 0)
      (set! @out-end p)
      (return 0))))

(defn c-cexpr-unary (buf:ptr pos:i64 len:i64 out-end:ptr:i64 ok:ptr:i32):i64
  (let (p:i64 (c-skip-body-ws buf pos len))
    (when (>= p len) (set! @ok 0) (set! @out-end p) (return 0))
    (let (c:i32 (cstr-byte-at buf p))
      (when (= c 43) (return (c-cexpr-unary buf (+ p 1) len out-end ok)))
      (when (= c 45)
        (let (v:i64 (c-cexpr-unary buf (+ p 1) len out-end ok))
          (return (c-norm (- 0 v) g-cexpr-rank))))
      ; `~` flips the operand's own width: `~0u` is 4294967295, not -1.
      (when (and (= c 126) (or (!= g-cmacro-folding 0) (!= g-cenum-folding 0)))
        (let (v:i64 (c-cexpr-unary buf (+ p 1) len out-end ok))
          (return (c-norm (bit-xor v -1) g-cexpr-rank))))
      (return (c-cexpr-primary buf p len out-end ok)))))

(defn c-cexpr-mul (buf:ptr pos:i64 len:i64 out-end:ptr:i64 ok:ptr:i32):i64
  (let (e:i64 0
        v:i64 (c-cexpr-unary buf pos len (as &i64 &e) ok)
        more:i32 1)
    (while (!= more 0)
      (set! more 0)
      (let (p:i64 (c-skip-body-ws buf e len))
        (when (< p len)
          (let (c:i32 (cstr-byte-at buf p))
            (when (or (= c 42) (or (= c 47) (= c 37)))
              (let (lr:i32 g-cexpr-rank
                    e2:i64 0
                    r:i64 (c-cexpr-unary buf (+ p 1) len (as &i64 &e2) ok))
                (set! v (c-arith c v lr r g-cexpr-rank ok))
                (set! e e2)
                (set! more 1)))))))
    (set! @out-end e)
    (return v)))

(defn c-cexpr-add (buf:ptr pos:i64 len:i64 out-end:ptr:i64 ok:ptr:i32):i64
  (let (e:i64 0
        v:i64 (c-cexpr-mul buf pos len (as &i64 &e) ok)
        more:i32 1)
    (while (!= more 0)
      (set! more 0)
      (let (p:i64 (c-skip-body-ws buf e len))
        (when (< p len)
          (let (c:i32 (cstr-byte-at buf p))
            (when (or (= c 43) (= c 45))
              (let (lr:i32 g-cexpr-rank
                    e2:i64 0
                    r:i64 (c-cexpr-mul buf (+ p 1) len (as &i64 &e2) ok))
                (set! v (c-arith c v lr r g-cexpr-rank ok))
                (set! e e2)
                (set! more 1)))))))
    (set! @out-end e)
    (return v)))

(defn c-cexpr-shift (buf:ptr pos:i64 len:i64 out-end:ptr:i64 ok:ptr:i32):i64
  (let (e:i64 0
        v:i64 (c-cexpr-add buf pos len (as &i64 &e) ok)
        more:i32 1)
    (while (!= more 0)
      (set! more 0)
      (let (p:i64 (c-skip-body-ws buf e len))
        (when (< (+ p 1) len)
          (let (c:i32 (cstr-byte-at buf p))
            (when (and (or (= c 60) (= c 62)) (= (cstr-byte-at buf (+ p 1)) c))
              (let (lr:i32 g-cexpr-rank
                    e2:i64 0
                    r:i64 (c-cexpr-add buf (+ p 2) len (as &i64 &e2) ok))
                (set! v (c-shift (= c 60) v lr r ok))
                (set! e e2)
                (set! more 1)))))))
    (set! @out-end e)
    (return v)))

; C's three bitwise levels, `&` tightest. Added for the macro fold
; (platform-constants.md §4) — `S_IRWXU` is `(__S_IREAD|__S_IWRITE|__S_IEXEC)`.
; Each refuses the doubled form, or `a && b` would fold as `a & (&b)`.
(defn c-cexpr-bitand (buf:ptr pos:i64 len:i64 out-end:ptr:i64 ok:ptr:i32):i64
  (let (e:i64 0
        v:i64 (c-cexpr-shift buf pos len (as &i64 &e) ok)
        more:i32 1)
    (while (!= more 0)
      (set! more 0)
      (let (p:i64 (c-skip-body-ws buf e len))
        (when (and (< p len) (= (cstr-byte-at buf p) 38))
          (when (or (>= (+ p 1) len) (!= (cstr-byte-at buf (+ p 1)) 38))
            (let (lr:i32 g-cexpr-rank
                  e2:i64 0
                  r:i64 (c-cexpr-shift buf (+ p 1) len (as &i64 &e2) ok))
              (set! v (c-arith 38 v lr r g-cexpr-rank ok))
              (set! e e2)
              (set! more 1))))))
    (set! @out-end e)
    (return v)))

(defn c-cexpr-bitxor (buf:ptr pos:i64 len:i64 out-end:ptr:i64 ok:ptr:i32):i64
  (let (e:i64 0
        v:i64 (c-cexpr-bitand buf pos len (as &i64 &e) ok)
        more:i32 1)
    (while (!= more 0)
      (set! more 0)
      (let (p:i64 (c-skip-body-ws buf e len))
        (when (and (< p len) (= (cstr-byte-at buf p) 94))
          (let (lr:i32 g-cexpr-rank
                e2:i64 0
                r:i64 (c-cexpr-bitand buf (+ p 1) len (as &i64 &e2) ok))
            (set! v (c-arith 94 v lr r g-cexpr-rank ok))
            (set! e e2)
            (set! more 1)))))
    (set! @out-end e)
    (return v)))

(defn c-cexpr-bitor (buf:ptr pos:i64 len:i64 out-end:ptr:i64 ok:ptr:i32):i64
  (let (e:i64 0
        v:i64 (c-cexpr-bitxor buf pos len (as &i64 &e) ok)
        more:i32 1)
    (while (!= more 0)
      (set! more 0)
      (let (p:i64 (c-skip-body-ws buf e len))
        (when (and (< p len) (= (cstr-byte-at buf p) 124))
          (when (or (>= (+ p 1) len) (!= (cstr-byte-at buf (+ p 1)) 124))
            (let (lr:i32 g-cexpr-rank
                  e2:i64 0
                  r:i64 (c-cexpr-bitxor buf (+ p 1) len (as &i64 &e2) ok))
              (set! v (c-arith 124 v lr r g-cexpr-rank ok))
              (set! e e2)
              (set! more 1))))))
    (set! @out-end e)
    (return v)))

; The evaluator's entry point. Only the macro fold takes the bitwise levels:
; `c-array-extent` still enters at `c-cexpr-shift`, so no struct that was opaque
; before suddenly lays out and no emitted byte moves.
(defn c-cexpr-top (buf:ptr pos:i64 len:i64 out-end:ptr:i64 ok:ptr:i32):i64
  (when (and (= g-cmacro-folding 0) (= g-cenum-folding 0))
    (return (c-cexpr-shift buf pos len out-end ok)))
  (return (c-cexpr-bitor buf pos len out-end ok)))

; One `[ … ]` extent, `pos` at the `[`. Sets out-end past the `]`; clears `ok`
; for anything that does not fold to a positive i32 count.
(defn c-array-extent (buf:ptr pos:i64 len:i64 out-end:ptr:i64 ok:ptr:i32):i32
  (let (e:i64 0
        v:i64 (c-cexpr-shift buf (+ pos 1) len (as &i64 &e) ok))
    (set! e (c-skip-body-ws buf e len))
    (if (and (< e len) (= (cstr-byte-at buf e) 93))
      (set! e (+ e 1))
      (set! @ok 0))
    (set! @out-end e)
    ; The clamp above is what makes the narrowing exact.
    (when (or (< v 1) (> v 2147483647)) (set! @ok 0) (set! v 1))
    (return (unsafe/cast i32 v))))

; C1a: `[]` with no extent. In member position that is C99's flexible array
; member, which contributes no bytes — `(array T 0)` says exactly that. Only the
; outermost dimension may be empty, and only where the caller allows one.
(defn c-flex-extent-here (buf:ptr pos:i64 len:i64 out-end:ptr:i64):i32
  (let (p:i64 (c-skip-body-ws buf (+ pos 1) len))
    (when (>= p len) (return 0))
    (when (!= (cstr-byte-at buf p) 93) (return 0))
    (set! @out-end (+ p 1))
    (return 1)))

; Wrap `elem` in the `[…]` extents at `pos`, or return `elem` unchanged when
; there are none. Null when an extent does not fold. C reads `[a][b]` left to
; right, so the extents wrap right to left.
(defn c-array-declarator (buf:ptr elem:ptr pos:i64 len:i64 out-end:ptr:i64
                          allow-flex:i32):ptr
  (let (dims:ptr (arena-alloc 32)
        nd:i32 0
        ok:i32 1
        p:i64 pos)
    (while (and (!= ok 0) (and (< p len) (= (cstr-byte-at buf p) 91)))
      (let (ee:i64 0
            n:i32 0
            flex:i32 (if (and (= nd 0) (!= allow-flex 0))
                       (c-flex-extent-here buf p len (as &i64 &ee))
                       0))
        ; -1, not 0: 0 is the prescan's provisional-length marker (type-to-ir).
        (if (!= flex 0)
          (set! n -1)
          (set! n (c-array-extent buf p len (as &i64 &ee)
                                  (as &i32 &ok))))
        (when (>= nd 8) (set! ok 0))
        (when (!= ok 0)
          (set! (aref (as &i32 dims) nd) n)
          (inc! nd))
        (set! p (c-skip-body-ws buf ee len))))
    (set! @out-end p)
    (when (= ok 0) (return null))
    (let (t:ptr elem
          k:i32 (- nd 1))
      (while (>= k 0)
        (set! t (as ptr (array-type t (aref (as &i32 dims) k))))
        (set! k (- k 1)))
      (return t))))

; AN-1: a member declaration that ended at the `;` with no declarator, whose
; type is an aggregate — C11's anonymous struct/union member.
(defn c-anon-member-here (buf:ptr pos:i64 len:i64 fty:ptr):i32
  (when (>= pos len) (return 0))
  (when (!= (cstr-byte-at buf pos) 59) (return 0))
  (when (= fty null) (return 0))
  (let (k:i32 (-> fty (unsafe/cast &Type _) (_ 'kind)))
    (return (if (or (= k TY-STRUCT) (= k TY-UNION)) 1 0))))

; Parse a C struct/union body `{ field; field; ... }` into a StructDef.
; a zero `tag-name` means anonymous (memoized by shape); is-union selects the
; union registration path (members at offset 0, deferred IR type definition).
; Returns the StructDef* or null on skip.
(defn c-parse-struct-body (buf:ptr pos:i64 len:i64 out-end:ptr:i64 tag-name:Symbol
                           is-union:i32 packed:i32 align:i32):ptr
  ; W3a: the declaration's own header:line, captured before `pos` advances, so a
  ; later diagnostic about this type points at the C declaration.
  (let (decl-line:i32 (cheader-line-at buf pos))
  ; Expect '{' at pos.
  (when (or (>= pos len) (!= (cstr-byte-at buf pos) 123))
    (set! @out-end pos) (return null))
  ; Pre-scan: locate the matching '}' so out-end is set ONCE here.
  ; All failure paths can simply `return null` and the caller's pos is
  ; correctly positioned past the body.
  (let (body-end:i64 (+ pos 1)
        depth:i32 1)
    (while (and (< body-end len) (> depth 0))
      (when (= (cstr-byte-at buf body-end) 123) (inc! depth))
      (when (= (cstr-byte-at buf body-end) 125) (set! depth (- depth 1)))
      (when (> depth 0)
        (set! body-end (+ body-end 1))))
    (when (< body-end len) (set! body-end (+ body-end 1)))
    (set! @out-end body-end))
  (set! pos (+ pos 1))
  (let (max-fields:i32 64
        fnames:ptr (arena-alloc (* 64 8))
        ftypes:ptr (arena-alloc (* 64 8))
        ; PK-3: member `aligned(N)`, parallel to the two arrays above. Zero for
        ; every member without one, which is every member in most bodies.
        faligns:ptr (arena-alloc (* 64 4))
        falign:i32 0
        ; BF-4: `: width`, in the same shape. -1 is C's unnamed zero-width
        ; member, which allocates nothing and forces the next boundary.
        fbits:ptr (arena-alloc (* 64 4))
        fbit:i32 0
        bfseq:i32 0
        ; AN-1: C11 anonymous members, minted in the same shape as `__bf.N`.
        anonseq:i32 0
        nfields:i32 0
        bad:i32 0
        done:i32 0
        ; Field-loop state, kept at this scope so the loop body can be
        ; flat and use `when` guards rather than deep nesting.
        fty:ptr null
        fname:Symbol (symbol-none)
        ; FP-4: a function-pointer member carries its name INSIDE the first
        ; paren group, so that branch supplies `fname` itself and the ordinary
        ; identifier read below must not run.
        fname-done:i32 0
        te:i64 0
        ne:i64 0
        ; CD-1: `int a, b;` — one specifier run, several declarators. `base-ty` is
        ; null when the first declarator's stars consumed it (c-header-layout.md §8).
        more:i32 0
        base-ty:ptr null
        spec-start:i64 0
        ; c-parse-type's unrep channel is scoped to the enclosing declaration,
        ; and this body may be a nested anonymous member of one — so save the
        ; caller's verdict rather than let a per-field clear erase it.
        save-unrep:i32 g-cheader-unrep
        save-why:StrView g-cheader-unrep-why
        save-quiet:i32 g-cheader-unrep-quiet)
    ; Per-field loop. On any anomaly we set bad=1 done=1 and abandon
    ; the struct (out-end is already past `}`, so the caller is fine).
    (while (= done 0)
      (set! pos (c-skip-body-ws buf pos len))
      (when (>= pos len) (set! bad 1) (set! done 1))
      (when (and (= done 0) (= (cstr-byte-at buf pos) 125))
        (set! pos (+ pos 1)) (set! done 1))
      (when (= done 0)
        (set! g-cheader-unrep 0)
        (set! fname-done 0)
        (set! falign 0)
        (set! fbit 0)
        (if (= more 0)
          (do
            (set! spec-start pos)
            (set! fty (c-parse-type buf pos len (as &i64 &te)))
            (set! base-ty fty)
            (when (!= (c-span-has-star buf spec-start te) 0) (set! base-ty null)))
          ; Continuing `T a, *b;`: the specifiers are the previous declarator's,
          ; and only this declarator's own stars apply.
          (let (p2:i64 (c-skip-type-quals buf pos len)
                ns:i32 0)
            (while (and (< p2 len) (= (cstr-byte-at buf p2) 42))
              (inc! ns)
              (set! p2 (c-skip-type-quals buf (+ p2 1) len)))
            (set! te p2)
            (set! fty (if (= ns 0) base-ty ty-ptr))))
        (when (= fty null) (set! bad 1) (set! done 1))
        ; D1: keeping the `ptr` c-parse-type returns here would give the struct a
        ; silently wrong layout; abandoning it leaves the name opaque instead.
        (when (and (= done 0) (!= g-cheader-unrep 0)) (set! bad 1) (set! done 1)))
      (when (= done 0)
        (set! pos te)
        (set! pos (c-skip-body-ws buf pos len))
        ; Function-pointer field: type (*name)(args...).
        (when (and (< pos len) (= (cstr-byte-at buf pos) 40))
          (let (fe:i64 0
                fpn:Symbol (symbol-none)
                ft:ptr (c-parse-fnptr-decl buf pos len fty
                                           (as &i64 &fe)
                                           (as &Symbol &fpn)))
            (set! pos fe)
            ; A function pointer is pointer-sized whichever way this went, so
            ; the layout is safe even when the inner types were not parseable.
            (set! g-cheader-unrep 0)
            (set! fty (if (!= ft null) ft ty-ptr))
            (when (not (symbol-none? fpn))
              (set! fname fpn)
              (set! fname-done 1)))
          (set! pos (c-skip-ws buf pos len))))
      (when (and (= done 0) (= fname-done 0))
        (set! fname (c-read-ident buf pos len (as &i64 &ne)))
        (when (= (symbol-len fname) 0)
          ; BF-4: `unsigned :3;` and `unsigned :0;` have no declarator at all.
          ; They still occupy (or close) a storage unit, so they must become
          ; fields; the minted name cannot collide with a C identifier.
          (if (and (< pos len) (= (cstr-byte-at buf pos) 58))
            (do (set! fname (symbol-intern (fstr "__bf." bfseq)))
                (inc! bfseq)
                (set! ne pos)
                (set! fname-done 1))
            ; AN-1: `struct { … };` with no declarator is a C11 anonymous
            ; member — an ordinary nested member whose own names are visible
            ; from outside (struct-field-ref descends through the minted one).
            (if (!= (c-anon-member-here buf pos len fty) 0)
              (do (set! fname (symbol-intern (fstr "__anon." anonseq)))
                  (inc! anonseq)
                  (set! ne pos)
                  (set! fname-done 1))
              (do (set! bad 1) (set! done 1))))))
      (when (= done 0)
        (when (= fname-done 0) (set! pos ne))
        (set! pos (c-skip-body-ws buf pos len))
        ; L2b/L2c: `[N]` declarators. A member's array type does not decay.
        (when (and (< pos len) (= (cstr-byte-at buf pos) 91))
          (let (ae:i64 0
                at:ptr (c-array-declarator buf fty pos len (as &i64 &ae) 1))
            (set! pos ae)
            (if (= at null)
              (do (set! bad 1) (set! done 1))
              (set! fty at))))
        ; BF-4: `: width`. C admits any integer constant expression; every
        ; occurrence surveyed is a decimal literal, and anything else abandons
        ; the struct rather than guessing a layout.
        (when (and (= done 0) (< pos len) (= (cstr-byte-at buf pos) 58))
          (set! pos (c-skip-body-ws buf (+ pos 1) len))
          (let (v:i32 0
                got:i32 0)
            (while (and (< pos len) (and (>= (cstr-byte-at buf pos) 48)
                                         (<= (cstr-byte-at buf pos) 57)))
              (set! v (+ (* v 10) (- (cstr-byte-at buf pos) 48)))
              (set! got 1)
              (set! pos (+ pos 1)))
            (if (or (= got 0) (or (> v 64) (> v (* 8 (abi-sizeof (as raw:Type fty))))))
              (do (set! bad 1) (set! done 1))
              (set! fbit (if (= v 0) -1 v))))
          (set! pos (c-skip-body-ws buf pos len)))
        ; PK-3: a member's own attribute run sits between the declarator and the
        ; `;`, and used to abandon the struct here — which is what kept
        ; `max_align_t` opaque. An `aligned` we cannot evaluate still does.
        (when (and (= done 0) (< pos len) (!= (cstr-byte-at buf pos) 59))
          (let (ae2:i64 0
                a:i32 0)
            (c-read-attributes buf pos len (as &i64 &ae2)
                               (as &i32 &a))
            (when (!= ae2 pos)
              (set! pos (c-skip-body-ws buf ae2 len))
              (if (< a 0)
                (do (set! bad 1) (set! done 1))
                (when (> a falign) (set! falign a))))))
        (when (and (= done 0) (>= pos len)) (set! bad 1) (set! done 1))
        ; A `,` continues the declaration; the append below consumes it as a `;`.
        (when (= done 0)
          (set! more (if (= (cstr-byte-at buf pos) 44) 1 0))
          (when (and (= more 0) (!= (cstr-byte-at buf pos) 59))
            (set! bad 1) (set! done 1))))
      (when (= done 0)
        (when (>= nfields max-fields) (set! bad 1) (set! done 1)))
      (when (= done 0)
        (set! (aref (as &Symbol fnames) nfields) fname)
        (set! (aref (as &ptr ftypes) nfields) fty)
        (set! (aref (as &i32 faligns) nfields) falign)
        (set! (aref (as &i32 fbits) nfields) fbit)
        (inc! nfields)
        (set! pos (+ pos 1))))
    ; Every exit below this point is covered: nothing after the loop parses a
    ; type, so nothing after it can touch the channel again.
    (set! g-cheader-unrep save-unrep)
    (set! g-cheader-unrep-why save-why)
    (set! g-cheader-unrep-quiet save-quiet)
    (when (!= bad 0) (return null))
    ; PK-3: an `aligned(…)` whose argument we could not evaluate would give the
    ; whole type a silently wrong size — refuse it the way an unreadable member
    ; type is refused, with a reason the skip report can print.
    (when (< align 0)
      (cheader-mark-unrep
        "an __attribute__((aligned(N))) whose N is neither an integer nor __alignof__(T)" 0)
      (return null))
    ; A union with no members would have no IR representation.
    (when (and (!= is-union 0) (= nfields 0)) (return null))
    ; Build StructDef. Anonymous → memoize via content hash; tagged
    ; → register by tag (if not already present).
    (when (symbol-none? tag-name)
      (if (!= is-union 0)
        (return (lookup-or-make-anon-union fnames ftypes faligns fbits nfields packed align))
        (return (lookup-or-make-anon-struct fnames ftypes faligns fbits nfields packed align))))
    ; W3a: an entry may already exist under this tag. A *defined* one is returned
    ; unchanged (a header included twice, or the tag also declared in Nucleus
    ; source). An *opaque* one — a `struct Tag;` forward declaration seen earlier,
    ; which is the order real C headers use — is upgraded IN PLACE: the same
    ; StructDef*, so every `ptr:Tag` Type already handed out gains the layout too.
    (let (existing:ptr (lookup-struct tag-name))
      (when (!= existing null)
        (let (esd:ptr:StructDef (as &StructDef existing))
          (when (= (esd 'opaque) 0) (return existing))
          (cheader-struct-define esd fnames ftypes faligns fbits nfields is-union packed align)
          (struct-upgrade-aliases esd)
          (return existing))))
    (let (sd:ptr:StructDef (register-struct tag-name))
      (set! (sd 'src-file) g-cheader-file)
      (set! (sd 'src-line) decl-line)
      (set! (sd 'from-c) 1)
      (cheader-struct-define sd fnames ftypes faligns fbits nfields is-union packed align)
      (return sd)))))

; Stage 16 CD-4 (c-header-layout.md §8.2): ONE declarator of a body-bearing
; `struct`/`union` declaration — the `A` of `typedef struct { … } A, B;`, or the
; `x` of `struct S { … } x, y;`. `stars` is the pointer depth the caller has
; already consumed. Returns the position after the declarator, or `pos` when
; the shape is one this parser does not model, which leaves it to the caller's
; skip. Factored out so the first declarator and every later one take the same
; path — a second implementation is how `B` came to be dropped in the first
; place.
(defn c-struct-decl-declarator (buf:ptr pos:i64 len:i64 stars:i32
                                is-typedef:i32 tag:Symbol tag-line:i32
                                sd:ptr):i64
  (let (ne:i64 0
        dn:Symbol (c-read-ident buf pos len (as &i64 &ne))
        ab:i64 0)
    (when (= (symbol-len dn) 0) (return pos))
    (set! ab (c-skip-ws buf ne len))
    ; `struct S { … } f(void);` declares a FUNCTION, not a variable or a type
    ; name. Decline rather than record `f`.
    (when (and (< ab len) (= (cstr-byte-at buf ab) 40)) (return pos))
    ; A pointer declarator is `ptr` whatever the body was — CD-2's rule.
    (when (!= stars 0)
      (when (!= is-typedef 0)
        (c-typedef-record dn ty-ptr g-cheader-file tag-line))
      (return ne))
    (when (and (< ab len) (= (cstr-byte-at buf ab) 91))
      ; CD-3: `… } Name[N];` is an ARRAY of the body's shape; a StructDef alias
      ; would discard the extent and pass it byval where C decays it.
      (let (tsd:ptr null
            esd:ptr sd
            ae:i64 0
            at:ptr null)
        ; The element must be the entry the PRESCAN anchored this typedef on:
        ; the tag, or the minted `__carr.` name when there is none.
        (when (!= is-typedef 0)
          (when (not (symbol-none? tag)) (set! tsd (lookup-struct tag)))
          (when (= tsd null) (set! tsd (lookup-struct (symbol-intern (fstr "__carr." dn)))))
          (when (and (!= tsd null) (!= sd null))
            (let (t2:ptr:StructDef (as &StructDef tsd))
              (when (!= (t2 'opaque) 0)
                (cheader-adopt-shape t2 (as &StructDef sd))
                (struct-upgrade-aliases t2))))
          (when (!= tsd null) (set! esd tsd)))
        (set! at (c-array-declarator buf
                   (if (!= esd null)
                     (as ptr (type-for-sdef (as &StructDef esd)))
                     ty-ptr)
                   ab len (as &i64 &ae) 0))
        (when (and (!= is-typedef 0) (!= sd null))
          (c-typedef-record dn at g-cheader-file tag-line))
        (return ae)))
    (when (and (!= is-typedef 0) (!= sd null))
      ; Register as a second alias if not already known. W3a: an entry that
      ; already exists because the alias name was forward-declared opaque is
      ; upgraded in place instead of being skipped.
      (let (prior:ptr (lookup-struct dn))
        (if (= prior null)
          (let (alias:ptr:StructDef (register-struct dn))
            (set! (alias 'alias-of) (as raw:StructDef sd))
            (set! (alias 'src-file) g-cheader-file)
            (set! (alias 'src-line) tag-line)
            (set! (alias 'from-c) 1)
            (cheader-adopt-shape alias (as &StructDef sd)))
          (let (psd:ptr:StructDef (as &StructDef prior))
            (when (!= (psd 'opaque) 0)
              (cheader-adopt-shape psd (as &StructDef sd)))))))
    (return ne)))

; Parse a top-level `struct Tag {...};`, `union Tag {...};`, or
; `typedef struct|union [Tag] {...} Name;`.
; Returns 1 if a definition was consumed, 0 if the caller should fall back.
(defn c-parse-struct-decl (buf:ptr pos:i64 len:i64 out-end:ptr:i64 line:i32):i32
  (let (is-typedef:i32 0
        is-union:i32 0
        te:i64 0
        tok:Symbol (c-read-ident buf pos len (as &i64 &te)))
    (cond
      (= tok "typedef")
        (do (set! is-typedef 1) (set! pos te))
      (= tok"struct" )
        (set! pos te)
      (= tok "union")
        (do (set! is-union 1) (set! pos te))
      true
        (do (set! @out-end pos) (return 0)))
    (when (!= is-typedef 0)
      (set! pos (c-skip-ws buf pos len))
      (let (te2:i64 0
            t2:Symbol (c-read-ident buf pos len (as &i64 &te2)))
        (cond
          (= t2 "struct") 0
          (= t2 "union" ) (set! is-union 1)
          true (do (set! @out-end pos) (return 0)))
        (set! pos te2)))
    ; After 'struct': an optional attribute run, then optional tag, then body.
    ; PK-2: the run is read here rather than skipped — it is one of the three
    ; places C admits `packed` on a definition (c-trailing-packed has the other
    ; two, and looks ahead over the body because the layout must be settled
    ; before c-parse-struct-body writes the type line).
    (let (lead-end:i64 0
          lead-align:i32 0
          lead-packed:i32 (c-read-attributes buf pos len (as &i64 &lead-end)
                                             (as &i32 &lead-align)))
    (set! pos lead-end)
    (let (tag:Symbol (symbol-none)
          tag-end:i64 0
          tag-line:i32 (cheader-line-at buf pos)
          maybe-tag:Symbol (c-read-ident buf pos len (as &i64 &tag-end)))
      (when (!= (symbol-len maybe-tag) 0)
        (set! tag maybe-tag)
        (set! pos tag-end)
        (set! pos (c-skip-ws buf pos len)))
      ; W3a (cheader.md §1.6): no '{' means no body here. `struct Foo;` /
      ; `typedef struct Foo Bar;` is C's opaque-handle idiom — the type NAME is
      ; real even though its layout is not, and skipping the declaration outright
      ; (the pre-W3a behavior) is what made every SDL handle type and `FILE`
      ; unusable. Register the tag (and, for a typedef, the alias) as opaque so
      ; `ptr:Foo` resolves; a by-value use is refused later with this header:line.
      (when (or (>= pos len) (!= (cstr-byte-at buf pos) 123))
        (when (symbol-none? tag)
          (set! @out-end pos) (return 0))
        (let (tag-sd:ptr (cheader-register-opaque tag tag-line is-union null))
          (when (>= pos len)
            (set! @out-end pos) (return 0))
          (if (!= is-typedef 0)
            ; `typedef struct Foo Bar;` — Bar is a second opaque entry sharing
            ; Foo's (future) layout through alias-of. When Bar spells the same
            ; name as Foo (`typedef struct Mix_Music Mix_Music;`, the common
            ; idiom) cheader-register-opaque finds the tag entry and returns it
            ; untouched.
            (let (ne:i64 0
                  tname:Symbol (c-read-ident buf pos len (as &i64 &ne)))
              (when (= (symbol-len tname) 0)
                ; Not a plain identifier — `*Bar`, `(*fp)(…)`, an array
                ; declarator. The tag is registered; the declaration itself is
                ; a shape we do not model, so fall back to the caller's skip.
                (set! @out-end pos) (return 0))
              (set! pos ne)
              (let (ab:i64 (c-skip-ws buf ne len)
                    tsd:ptr:StructDef (as &StructDef tag-sd))
                ; `typedef struct Foo Bar[N];` — Bar names an ARRAY of Foo, not a
                ; second name for Foo, so it belongs in the typedef table (D4);
                ; the StructDef alias is what discarded the extent. With no
                ; layout on the tag there is no element type to build over, so
                ; fall back to the opaque alias, which still refuses every
                ; by-value use with a located reason.
                (if (and (< ab len)
                         (and (= (cstr-byte-at buf ab) 91) (= (tsd 'opaque) 0)))
                  (let (ae:i64 0
                        at:ptr (c-array-declarator buf (as ptr (type-for-sdef tsd))
                                                   ab len (as &i64 &ae) 0))
                    (c-typedef-record tname at g-cheader-file tag-line)
                    (set! pos ae))
                  (cheader-register-opaque tname tag-line is-union
                                           (as raw:StructDef tag-sd)))))
            ; Plain `struct Foo;`. Anything else after the tag (a `*` declarator,
            ; a variable name, a function declarator) is not a forward declaration.
            (when (!= (cstr-byte-at buf pos) 59)
              (set! @out-end pos) (return 0)))
          (set! pos (c-skip-ws buf pos len))
          (when (and (< pos len) (= (cstr-byte-at buf pos) 59))
            (set! pos (+ pos 1)))
          (set! @out-end pos)
          (return 1)))
      (let (body-end:i64 0
            tail-align:i32 0
            tail-packed:i32 (c-trailing-packed buf pos len
                                               (as &i32 &tail-align))
            sd:ptr (c-parse-struct-body buf pos len
                                        (as &i64 &body-end)
                                        (if (!= is-typedef 0) (symbol-none) tag) is-union
                                        (if (!= lead-packed 0) 1 tail-packed)
                                        (if (!= lead-align 0) lead-align tail-align)))
        (set! pos body-end)
        ; W3a: a `typedef struct Tag { … } Name;` parses its body ANONYMOUSLY
        ; (memoized by shape) and never registers `Tag` itself — so when `Tag`
        ; was forward-declared earlier in the header it would stay opaque
        ; forever. Adopt the shape into it (and into its own aliases) here.
        (when (and (!= sd null) (!= is-typedef 0) (not (symbol-none? tag)))
          (let (tsd:ptr (lookup-struct tag))
            (when (!= tsd null)
              (let (tsd2:ptr:StructDef (as &StructDef tsd))
                (when (!= (tsd2 'opaque) 0)
                  (cheader-adopt-shape tsd2 (as &StructDef sd))
                  (struct-upgrade-aliases tsd2))))))
        ; For typedef, the typedef name comes after the body and may
        ; differ from the inner tag. Register a separate StructDef
        ; under the typedef name pointing at the same shape — but if
        ; sd is null (skipped body) we just consume to ';'.
        ;
        ; CD-4: a declarator LIST may follow — `typedef struct { … } A, B;`,
        ; `struct S { … } x, y;`. Everything after the first used to be dropped
        ; without a word (c-header-layout.md §8.2). A non-typedef's declarators
        ; are VARIABLES, which the importer does not model at all, so they are
        ; consumed (so the caller resumes at the `;`) rather than recorded.
        (let (more:i32 1)
          (while (!= more 0)
            (set! more 0)
            (set! pos (c-skip-ws buf pos len))
            ; PK-2: `typedef struct { … } __attribute__((packed)) Name;` puts a
            ; run between the body and the name. Skipping it here is what stops
            ; `__attribute__` itself being read as the typedef name.
            (set! pos (c-skip-attributes buf pos len))
            (let (stars:i32 0)
              (while (and (< pos len) (= (cstr-byte-at buf pos) 42))
                (inc! stars)
                (set! pos (c-skip-type-quals buf (+ pos 1) len)))
              (set! pos (c-struct-decl-declarator buf pos len stars
                                                  is-typedef tag tag-line sd)))
            (set! pos (c-skip-ws buf pos len))
            (when (and (< pos len) (= (cstr-byte-at buf pos) 44))
              (set! pos (+ pos 1))
              (set! more 1))))
        ; Skip trailing __attribute__ if any.
        (set! pos (c-skip-attributes buf pos len))
        ; Consume trailing semicolon.
        (when (and (< pos len) (= (cstr-byte-at buf pos) 59))
          (set! pos (+ pos 1)))
        (set! @out-end pos)
        (return 1))))))

; Stage 15 W3c (cheader.md §1.4): record a NON-aggregate top-level typedef —
; `typedef long int __off_t;`, `typedef __off_t off_t;`,
; `typedef unsigned char Uint8;`, `typedef char *string_t;`,
; `typedef int (*handler)(int);`, `typedef enum { … } E;`,
; `typedef struct Foo *FooPtr;`.
;
; Called only after `c-parse-struct-decl` has DECLINED the declaration, so every
; `typedef struct|union …` shape that introduces a named aggregate is handled
; there and cannot reach here — which is what keeps W3a's opaque-registration and
; in-place-upgrade paths untouched by this function.
;
; Returns 1 when the declaration was consumed. A name is recorded even when its
; type is not representable (recording null): that is how a later by-value use
; gets a located skip naming the type, instead of the pre-W3c silent `ptr`.
(defn c-parse-typedef-decl (buf:ptr pos:i64 len:i64 out-end:ptr:i64):i32
  (let (te:i64 0
        tok:Symbol (c-read-ident buf pos len (as &i64 &te)))
    (when (!= tok "typedef") (set! @out-end pos) (return 0))
    (let (dline:i32 (cheader-line-at buf pos)
          save-unrep:i32 g-cheader-unrep
          save-why:StrView g-cheader-unrep-why
          save-quiet:i32 g-cheader-unrep-quiet
          tend:i64 0
          bad:i32 0
          name:Symbol (symbol-none)
          base:ptr null)
      ; c-parse-type's unrep channel is scoped to a FUNCTION declaration
      ; (c-parse-func-decl clears it at entry). A typedef is parsed outside one,
      ; so save/restore rather than let this parse leak a verdict sideways.
      (set! g-cheader-unrep 0)
      (set! base (c-parse-type buf (c-skip-ws buf te len) len
                               (as &i64 &tend)))
      (when (!= g-cheader-unrep 0) (set! bad 1))
      (set! g-cheader-unrep save-unrep)
      (set! g-cheader-unrep-why save-why)
      (set! g-cheader-unrep-quiet save-quiet)
      ; CD-2: the shared specifiers, captured before the paths below rewrite
      ; `base`/`bad` for the FIRST declarator only.
      (let (p:i64 (c-skip-ws buf tend len)
            base0:ptr base
            bad0:i32 bad)
        (when (!= (c-span-has-star buf te tend) 0) (set! base0 null))
        ; `(*name)(args)` — a function-pointer typedef, which is a pointer
        ; whatever its return and argument types are. It has to be recognized
        ; HERE: the naive fallback would take `int` for the declarator of
        ; `typedef int (*handler)(int);` and the declaration would look like a
        ; function literally named `int` (the trap W3b recorded when it declined
        ; to extend the struct fallback to `typedef`).
        (when (and (< p len) (= (cstr-byte-at buf p) 40))
          (let (fe:i64 0
                fpn:Symbol (symbol-none)
                ft:ptr (c-parse-fnptr-decl buf p len base
                                           (as &i64 &fe)
                                           (as &Symbol &fpn)))
            (set! p fe)
            (when (not (symbol-none? fpn))
              (set! name fpn)
              ; FP-4: `bad` was the RETURN type's verdict; a function pointer is
              ; a pointer whatever that was, so it no longer condemns the typedef.
              (set! base (if (!= ft null) ft ty-ptr))
              (set! bad 0))))
        (when (symbol-none? name)
          (let (ne:i64 0
                dn:Symbol (c-read-ident buf p len (as &i64 &ne)))
            ; No declarator identifier — a shape not modelled at all. Decline, so
            ; nothing is recorded under a name that is not the declarator's.
            (when (= (symbol-len dn) 0)
              (set! @out-end pos) (return 0))
            (set! name dn)
            (set! p ne)))
        (set! p (c-skip-ws buf p len))
        ; An array declarator (`typedef int v4[4];`). L2 gives the parser a real
        ; array type to record, which is what makes `__jmp_buf` — and therefore
        ; every struct whose member is one — come out at the C size.
        (when (and (< p len) (= (cstr-byte-at buf p) 91))
          (let (ae:i64 0
                at:ptr (c-array-declarator buf base p len (as &i64 &ae) 0))
            (set! p ae)
            (if (or (= at null) (!= bad 0))
              (set! bad 1)
              (set! base at))))
        (c-typedef-record name (if (!= bad 0) null base) g-cheader-file dline)
        ; `typedef int a, *b;` — each declarator gets its own stars and extents
        ; over the shared specifiers; one whose base is gone is recorded null.
        (set! p (c-skip-ws buf p len))
        (while (and (< p len) (= (cstr-byte-at buf p) 44))
          (let (ns:i32 0
                dbad:i32 bad0
                dty:ptr base0
                ne2:i64 0
                dn2:Symbol (symbol-none))
            (set! p (c-skip-type-quals buf (+ p 1) len))
            (while (and (< p len) (= (cstr-byte-at buf p) 42))
              (inc! ns)
              (set! p (c-skip-type-quals buf (+ p 1) len)))
            (when (> ns 0) (set! dty ty-ptr) (set! dbad 0))
            (set! dn2 (c-read-ident buf p len (as &i64 &ne2)))
            (if (= (symbol-len dn2) 0)
              (set! p len)
              (do
                (set! p (c-skip-ws buf ne2 len))
                (when (and (< p len) (= (cstr-byte-at buf p) 91))
                  (let (ae2:i64 0
                        ; A placeholder element when the base was lost — the
                        ; extents still have to be consumed to find the `,`.
                        at2:ptr (c-array-declarator buf (if (!= dty null) dty ty-ptr)
                                                    p len (as &i64 &ae2) 0))
                    (set! p ae2)
                    (if (or (= at2 null) (= dty null))
                      (set! dbad 1)
                      (set! dty at2))))
                (c-typedef-record dn2 (if (!= dbad 0) null dty) g-cheader-file dline)
                (set! p (c-skip-ws buf p len))))))
        (set! @out-end (cheader-skip-to-semi buf p len))
        (return 1)))))

; ============================================================
; Stage 15 W3a: opaque-name pre-scan for the signature prescan
;
; prescan-defn-signatures resolves every defn signature in a unit BEFORE any
; import is processed, and prescan-imported-types deliberately skips C-string
; imports (running clang for every header would double the preprocessing cost of
; a build). That is exactly why `(defn play (m:ptr:Mix_Music):i32 …)` reported
; `unknown type: Mix_Music` — and it is unaffected by registering opaque types at
; import time, because the signature is resolved first. An opaque handle type in
; a signature is *the* thing a C library API wants, so this recovers the
; forward-declaration shapes ahead of the signature prescan.
;
; It is deliberately a NAME scan, not a second parse: only `struct X;` /
; `union X;` / `typedef struct X Y;` (no `{`) register anything. A declaration
; with a body is left entirely to the real import — which then upgrades these
; entries in place (cheader-adopt-shape / the opaque branch of
; c-parse-struct-body), so this pass emits no IR of its own and cannot change
; what a body-bearing declaration produces.
; ============================================================

; Advance past the end of the current declaration: the next `;` at brace depth 0,
; consuming balanced `{}` bodies whole. Linemarkers encountered on the way are
; recorded so provenance stays accurate across a multi-line declaration.
(defn cheader-skip-to-semi (buf:ptr pos:i64 len:i64):i64
  (let (p:i64 pos
        depth:i32 0
        done:i32 0)
    (while (and (= done 0) (< p len))
      (let (c:i32 (cstr-byte-at buf p))
        (case c
          123 (do (inc! depth) (set! p (+ p 1)))
          125 (do (when (> depth 0) (set! depth (- depth 1)))
                        (set! p (+ p 1)))
          59  (do (set! p (+ p 1)) (when (= depth 0) (set! done 1)))
          35  (let (dstart:i64 p)
                      (while (and (< p len) (!= (cstr-byte-at buf p) 10))
                        (set! p (+ p 1)))
                      (when (< p len) (set! p (+ p 1)))
                      (cheader-note-linemarker buf dstart p len))
          (set! p (+ p 1)))))
    (return p)))

; Skip a balanced `{ … }` starting at `pos` (which must be at `{`). Returns the
; position just past the matching `}`.
(defn cheader-skip-braces (buf:ptr pos:i64 len:i64):i64
  (let (p:i64 (+ pos 1)
        depth:i32 1)
    (while (and (< p len) (> depth 0))
      (let (c:i32 (cstr-byte-at buf p))
        (when (= c 123) (inc! depth))
        (when (= c 125) (set! depth (- depth 1))))
      (set! p (+ p 1)))
    (return p)))

; Scan one top-level construct at `pos`, registering the type NAME it introduces.
; Returns the position to resume from.
;
; Which name is registered mirrors the real import exactly: the TAG of
; `struct Tag …` and the DECLARATOR of `typedef struct [Tag] {…} Name;`. That
; equality is what keeps this pass free of IR consequences — the real import then
; upgrades the same entry in place and writes the same single `%X = type {…}` it
; always did, rather than defining a second name.
; Stage 16 L5 (c-header-layout.md §3.5): record a NON-aggregate `typedef` during
; the signature prescan, so a `defn` signature may spell `off_t` — signatures are
; resolved before any import runs. The real parser is reused rather than
; mirrored; every record it makes is provisional (c-typedef-record), since this
; pass resolves with every C struct still opaque.
;
; Declines any specifier run that reaches `struct`/`union`: `c-parse-type` would
; parse the body and write a `%X = type` line, and a prescan has no module stream
; open. Measured zero times across 21 standard headers, guarded anyway.
(defn cheader-scan-typedef (buf:ptr start:i64 p:i64 len:i64):i64
  (let (q:i64 (c-skip-type-quals buf p len)
        te:i64 0
        t:Symbol (c-read-ident buf q len (as &i64 &te)))
    (when (or (= t "struct") (= t "union"))
      (return (cheader-skip-to-semi buf p len))))
  (let (e:i64 0)
    (when (= (c-parse-typedef-decl buf start len (as &i64 &e)) 0)
      (return (cheader-skip-to-semi buf p len)))
    (return e)))

(defn cheader-scan-opaque-decl (buf:ptr pos:i64 len:i64):i64
  (let (te:i64 0
        tok:Symbol (c-read-ident buf pos len (as &i64 &te))
        is-typedef:i32 0
        is-union:i32 0
        p:i64 pos)
    ; Punctuation (not an identifier): step one character so the caller's loop
    ; always makes progress.
    (when (= (symbol-len tok) 0) (return (+ pos 1)))
    (set! p te)
    (when (= tok "typedef")
      (set! is-typedef 1)
      (set! p (c-skip-ws buf p len))
      (let (te2:i64 0
            t2:Symbol (c-read-ident buf p len (as &i64 &te2)))
        (when (and (!= t2 "struct") (!= t2 "union"))
          (return (cheader-scan-typedef buf pos p len)))
        (when (= t2 "union") (set! is-union 1))
        (set! p te2)))
    (when (= is-typedef 0)
      (cond
        (= tok "struct") 0
        (= tok "union")  (set! is-union 1)
        true             (return (cheader-skip-to-semi buf p len))))
    ; An optional attribute run, then optional tag, then optional body.
    (set! p (c-skip-attributes buf p len))
    (let (decl-line:i32 (cheader-line-at buf p)
          tend:i64 0
          tag:Symbol (c-read-ident buf p len (as &i64 &tend))
          has-tag:i32 0)
      (when (!= (symbol-len tag) 0)
        (set! has-tag 1)
        (set! p (c-skip-ws buf tend len)))
      (when (>= p len) (return (cheader-skip-to-semi buf p len)))
      (if (= (cstr-byte-at buf p) 123)
        ; Body present. Register the name the real import will define, so a defn
        ; signature may name a fully-defined C struct too (`ptr:Mix_Chunk`), not
        ; only an opaque handle.
        (do
          (set! p (cheader-skip-braces buf p len))
          (if (!= is-typedef 0)
            ; CD-4: every declarator of the list, name-for-name with
            ; c-struct-decl-declarator — `typedef struct { … } A, *Bp, C[3];`.
            (let (more:i32 1)
              (while (!= more 0)
                (set! more 0)
                (set! p (c-skip-ws buf p len))
                (set! p (c-skip-attributes buf p len))
                (let (stars:i32 0)
                  (while (and (< p len) (= (cstr-byte-at buf p) 42))
                    (inc! stars)
                    (set! p (c-skip-type-quals buf (+ p 1) len)))
                  (let (ne:i64 0
                        dname:Symbol (c-read-ident buf p len (as &i64 &ne))
                        ab:i64 0)
                    (when (!= (symbol-len dname) 0)
                      (set! ab (c-skip-ws buf ne len))
                      (set! p ne)
                      (cond
                        ; A function declarator names no type — decline, exactly
                        ; as the import does.
                        (and (< ab len) (= (cstr-byte-at buf ab) 40))
                          (set! p len)
                        ; A pointer declarator is `ptr`, and belongs in the
                        ; typedef table — NOT the struct registry, or the opaque
                        ; entry shadows the record the import makes.
                        (!= stars 0)
                          (c-typedef-record dname ty-ptr g-cheader-file decl-line)
                        ; CD-3: an array typedef registers no StructDef for Name
                        ; either — the name-for-name rule (c-header-layout.md §8.1).
                        (and (< ab len) (= (cstr-byte-at buf ab) 91))
                          (let (ae:i64 0
                                anchor:Symbol (if (!= has-tag 0) tag (symbol-intern (fstr "__carr." dname)))
                                elem:ptr (as ptr (type-for-sdef
                                                   (as &StructDef
                                                     (cheader-register-opaque anchor decl-line
                                                                              is-union null)))))
                            (c-typedef-record dname
                              (c-array-declarator buf elem ab len (as &i64 &ae) 0)
                              g-cheader-file decl-line)
                            (set! p ae))
                        true
                          (cheader-register-opaque dname decl-line is-union null)))))
                (set! p (c-skip-ws buf p len))
                (when (and (< p len) (= (cstr-byte-at buf p) 44))
                  (set! p (+ p 1))
                  (set! more 1))))
            (when (!= has-tag 0)
              (cheader-register-opaque tag decl-line is-union null))))
        ; No body.
        (when (!= has-tag 0)
          (if (!= is-typedef 0)
            ; `typedef struct X Y;` — register the tag, then Y as its alias. A
            ; non-identifier here (`*Y`, `(*fp)(…)`) is a pointer/function typedef
            ; we do not model, so only the tag is worth recording.
            (let (ne:i64 0
                  tname:Symbol (c-read-ident buf p len (as &i64 &ne))
                  tag-sd:ptr (cheader-register-opaque tag decl-line is-union null))
              ; `typedef struct Foo Bar[N];` registers no StructDef for Bar (D4,
              ; it is an array typedef) — and this scan must stay name-for-name
              ; with c-parse-struct-decl, or struct-upgrade-aliases emits a %Bar
              ; the real import never defines.
              (let (ab:i64 (c-skip-ws buf ne len))
                (if (and (!= (symbol-len tname) 0)
                         (and (< ab len) (= (cstr-byte-at buf ab) 91)))
                  ; L5: `typedef struct Foo Bar[N];` — Bar belongs in the typedef
                  ; table (D4), and a `defvar`/signature naming it is resolved
                  ; before any import runs, so record it here. The element wraps
                  ; the TAG's own StructDef, which the real import upgrades in
                  ; place; the record itself is provisional either way.
                  (let (ae:i64 0)
                    (c-typedef-record tname
                      (c-array-declarator buf
                        (as ptr (type-for-sdef (as &StructDef tag-sd)))
                        ab len (as &i64 &ae) 0)
                      g-cheader-file decl-line))
                  (when (!= (symbol-len tname) 0)
                    (cheader-register-opaque tname decl-line is-union
                                             (as raw:StructDef tag-sd))))))
            ; `struct X;` (a forward declaration) or a `struct X *…` use — the tag
            ; names a real type either way.
            (cheader-register-opaque tag decl-line is-union null))))
      (return (cheader-skip-to-semi buf p len)))))

; Pre-register a C header's opaque type names. Never emits IR and never registers
; a function. It refuses a header that does not preprocess, in `emit-c-include`'s
; words: the header modes run this pass and never the import.
(defn cheader-prescan-opaque (header-path:Symbol line:i32):void
  (let (buf-len:i64 0
        buf:ptr (cheader-preprocess header-path (as &i64 &buf-len)))
    (when (= buf null)
      ; A `.nuch`'s C import only binds a prefix; the import never reads it.
      (let (src:StrView (symbol-as-view g-source-path)
            ext:StrView ".nuch")
        (when (strview-ends-with &src &ext) (return)))
      (die-at line (fstr "c-include: failed to preprocess '" header-path "'")))
    (set! g-cheader-file header-path)
    (set! g-cheader-import-header header-path)
    (set! g-cheader-dline 1)
    (set! g-cheader-dpos 0)
    ; L5: every typedef this pass records is provisional — the real import
    ; re-records it with the struct layouts this pass does not have yet.
    (set! g-cheader-typedef-provisional 1)
    (let (pos:i64 0
          prev:i64 -1)
      (while (< pos buf-len)
        (set! prev pos)
        (set! pos (c-skip-ws buf pos buf-len))
        (when (< pos buf-len)
          (if (= (cstr-byte-at buf pos) 35)
            (let (dstart:i64 pos)
              (while (and (< pos buf-len) (!= (cstr-byte-at buf pos) 10))
                (set! pos (+ pos 1)))
              (when (< pos buf-len) (set! pos (+ pos 1)))
              (cheader-note-linemarker buf dstart pos buf-len))
            (set! pos (cheader-scan-opaque-decl buf pos buf-len))))
        ; Progress guard (mirrors emit-c-include's): never spin.
        (when (<= pos prev) (set! pos (+ prev 1)))))
    (set! g-cheader-typedef-provisional 0)))

; ============================================================
; Stage 17: platform constants (platform-constants.md).
; `#define O_CREAT 0100` is a named integer constant that C had no other way to
; spell. A `-dM` run gives the emission target's own table; the c-cexpr
; evaluator above is the admission test, since it fails closed on everything
; that is not an integer constant expression.
; ============================================================

; One `#define NAME body` line of a `-dM` dump; `val`/`folded` are filled by the
; fixed-point pass.
(defstruct CMacro
  name:Symbol
  body-start:i64
  body-end:i64
  val:i64
  folded:i32
  ; The C type of the folded body (a `c-rank`), which an expression using it takes.
  rank:i32)

(defvar g-cmacros:&(Vector &CMacro) (vector-new-in &g-arena-alloc))
(defvar g-cmacro-index:&(HashMap Symbol &CMacro)
  (hashmap-new-in &g-arena-alloc))
; clang's own predefines, subtracted before registration: `-include fcntl.h`
; dumps 739 names of which 398 are `linux`, `unix`, `__GNUC__` and friends.
; They stay in the fold table, since a header's macros are written in terms of
; them.
(defvar g-cmacro-baseline:&(HashSet Symbol) (hashset-new-in &g-arena-alloc))
(defvar g-cmacro-baseline-ready:i32 0)
(defvar g-cmacro-folding:i32 0)
(defvar g-cmacro-buf:ptr null)

(defn cheader-macro-reset ():void
  (let (v:&(Vector &CMacro) (vector-new-in &g-arena-alloc)
        m:&(HashMap Symbol &CMacro) (hashmap-new-in &g-arena-alloc))
    (set! g-cmacros v)
    (set! g-cmacro-index m)))

; The value of an already-folded macro, for c-cexpr-primary's identifier case.
(defn cmacro-value (name:Symbol out:ptr:i64):i32
  (when-some (m (get g-cmacro-index name))
    (when (!= (m 'folded) 0)
      (set! g-cexpr-rank (m 'rank))
      (set! @out (m 'val))
      (return 1)))
  (return 0))

(defn cmacro-private-name? (name:Symbol):i32
  (let (sv:StrView (symbol-as-view name)
        pfx:StrView "_")
    (when (strview-starts-with &sv &pfx) (return 1))
    (return 0)))

; §3.1: `_`-prefixed names out unless the import is `unsafe/import-private`, and
; never over a name that already resolves — a header's constant must not displace
; what this unit defined. The Sym is a `defconst`'s: an untyped integer literal.
(defn cheader-define-int-const (name:Symbol val:i64):void
  (let (priv:i32 (cmacro-private-name? name))
    (when (and (or (= priv 0) (!= g-import-include-private 0))
               (= (scope-lookup-key g-globals name) null)
               (not (cconst-name-taken? name)))
      (let (sym:ref:Sym (scope-define g-globals name
                          (as ptr (int-literal-type val)) "" 0))
        (set! (sym 'is-const) 1)
        (set! (sym 'const-val) (fstr val))
        (set! (sym 'const-lit) 1)
        (set! (sym 'const-lit-i64) val)
        (set! (sym 'c-const) 1)
        (when (!= priv 0) (set! (sym 'sym-private) 1))))))

; Does a Nucleus definition other than a value hold `name`? A C header's own tag
; does not count: C keeps tags apart from constants.
(defn cconst-name-taken? (name:Symbol):bool
  (let (i:i32 0)
    (while (< i BINDING-KIND-COUNT)
      (when (and (!= i BK-SPECIAL) (!= i BK-PRIMITIVE) (!= i BK-GLOBAL)
                 (!= ((binding-row i) 'collides) 0))
        (let (p:ptr (binding-probe i name null))
          (when (and (!= p null)
                     (or (!= i BK-STRUCT) (= ((as &StructDef p) 'from-c) 0)))
            (return true))))
      (inc! i)))
  (return false))

; A Nucleus definition of `name` displaces the C constant it would collide with,
; defined later (a macro, or at the REPL). Re-keyed under `#c/`, which nothing spells.
(defn cconst-yield (name:Symbol):void
  (let (more:bool true)
    (while more
      (set! more false)
      (if-some (s (scope-lookup g-globals name))
        (when (!= (s 'c-const) 0)
          (set! (s 'name) (symbol-intern (fstr "#c/" (s 'name))))
          (set! more true))
        0))))

; ============================================================
; C enumerators (stage21-cleanup/overview.md, rough edges): imported like a
; folded `#define`. The table keeps every enumerator seen, private names too, so
; a later initializer or `#define` can be written in terms of one.
; ============================================================

(defvar g-cenum-index:&(HashMap Symbol &CMacro) (hashmap-new-in &g-arena-alloc))
(defvar g-cenum-folding:i32 0)
; The C type of the (sub)expression just evaluated, as a `c-rank`. Every value the
; evaluator returns is already converted to it (`c-norm`).
(defvar g-cexpr-rank:i32 0)

; A promoted C integer type: width times two, plus one when unsigned. The larger
; of two ranks is then exactly C's usual arithmetic conversion.
(defn c-rank (bits:i64 uns:i32):i32
  (return (unsafe/cast i32 (+ (* bits 2) (as i64 uns)))))

(defn c-rank-bits (r:i32):i64
  (return (as i64 (/ r 2))))

(defn c-rank-unsigned? (r:i32):bool
  (return (!= (bit-and r 1) 0)))

; The emission target's C `int`, which is 16 bits on AVR.
(defn c-int-bits ():i64
  (return (as i64 (int-width (c-int-type 0)))))

(defn c-rank-int ():i32
  (return (c-rank (c-int-bits) 0)))

(defn c-rank-uint ():i32
  (return (c-rank (c-int-bits) 1)))

; `v` converted to the type `r` names: wrapped to its width, then zero- or
; sign-extended. A 64-bit unsigned value is kept as its bit pattern.
(defn c-norm (v:i64 r:i32):i64
  (let (bits:i64 (c-rank-bits r)
        one:i64 1)
    (when (>= bits 64) (return v))
    (let (u:i64 (bit-and v (- (bit-shl one bits) 1)))
      (when (c-rank-unsigned? r) (return u))
      (when (>= u (bit-shl one (- bits 1))) (return (- u (bit-shl one bits))))
      (return u))))

(defn cenum-value (name:Symbol out:ptr:i64):i32
  (when-some (m (get g-cenum-index name))
    (when (!= (m 'folded) 0)
      (set! @out (m 'val))
      (return 1)))
  (return 0))

; An enumerator's type, by its value (clang's, for one that does not fit `int`).
(defn c-value-rank (v:i64):i32
  (when (= (c-norm v (c-rank-int)) v) (return (c-rank-int)))
  (when (= (c-norm v (c-rank-uint)) v) (return (c-rank-uint)))
  (return (c-rank 64 0)))

; Does a literal's value fit type `r`? `wrapped` is a value past INT64_MAX, held
; as its bit pattern.
(defn c-literal-fits? (v:i64 wrapped:bool r:i32):bool
  (when wrapped (return (and (c-rank-unsigned? r) (>= (c-rank-bits r) 64))))
  (when (>= (c-rank-bits r) 64) (return true))
  (return (= (c-norm v r) v)))

; C's literal typing: the first of int, long, long long (from the `l` count) that
; holds the value, each followed by its unsigned twin unless the literal is an
; unsuffixed decimal, and only the twins under a `u`. A decimal no signed type
; holds falls through to `unsigned long long`, as clang reads it.
(defn c-literal-rank (v:i64 wrapped:bool decimal:bool nu:i32 nl:i32):i32
  (let (lvl:i32 (if (> nl 2) 2 nl))
    (while (<= lvl 2)
      (let (bits:i64 (cond (= lvl 0) (c-int-bits)
                           (= lvl 1) (as i64 (* (target-long-size) 8))
                           true 64))
        (when (and (= nu 0) (c-literal-fits? v wrapped (c-rank bits 0)))
          (return (c-rank bits 0)))
        (when (and (or (!= nu 0) (not decimal)) (c-literal-fits? v wrapped (c-rank bits 1)))
          (return (c-rank bits 1))))
      (inc! lvl)))
  (return (c-rank 64 1)))

; One binary operator (its character) over two operands of their own ranks, at
; their common type. Clears `ok` where C has no value or the host would trap.
(defn c-arith (op:i32 a:i64 ra:i32 b:i64 rb:i32 ok:ptr:i32):i64
  (let (r:i32 (if (> ra rb) ra rb)
        x:i64 (c-norm a r)
        y:i64 (c-norm b r)
        one:i64 1
        v:i64 0)
    (set! g-cexpr-rank r)
    (when (and (or (= op 47) (= op 37)) (= y 0)) (set! @ok 0) (return 0))
    (let (u64:bool (and (c-rank-unsigned? r) (>= (c-rank-bits r) 64)))
      (cond
        (= op 42)  (set! v (* x y))
        (= op 43)  (set! v (+ x y))
        (= op 45)  (set! v (- x y))
        (= op 38)  (set! v (bit-and x y))
        (= op 94)  (set! v (bit-xor x y))
        (= op 124) (set! v (bit-or x y))
        u64 (if (= op 47)
              (set! v (unsafe/cast i64 (/ (unsafe/cast ui64 x) (unsafe/cast ui64 y))))
              (set! v (unsafe/cast i64 (% (unsafe/cast ui64 x) (unsafe/cast ui64 y)))))
        (and (= x (bit-shl one 63)) (= y -1)) (set! @ok 0)
        (= op 47)  (set! v (/ x y))
        true       (set! v (% x y))))
    (return (c-norm v r))))

; `<<`/`>>` take the left operand's type. A count past its width has no value.
(defn c-shift (left:bool a:i64 ra:i32 n:i64 ok:ptr:i32):i64
  (set! g-cexpr-rank ra)
  (when (or (< n 0) (>= n 64) (>= n (c-rank-bits ra))) (set! @ok 0) (return 0))
  (when left (return (c-norm (bit-shl a n) ra)))
  (when (c-rank-unsigned? ra) (return (u64-shr (c-norm a ra) n)))
  (return (bit-shr (c-norm a ra) n)))

; End of one enumerator's initializer: the `,` or `}` at paren depth 0.
(defn c-enum-value-end (buf:ptr pos:i64 len:i64):i64
  (let (p:i64 pos
        depth:i32 0)
    (while (< p len)
      (let (c:i32 (cstr-byte-at buf p))
        (cond
          (and (= depth 0) (or (= c 44) (= c 125))) (return p)
          (or (= c 40) (= c 91) (= c 123)) (do (inc! depth) (set! p (+ p 1)))
          (or (= c 41) (= c 93) (= c 125)) (do (set! depth (- depth 1)) (set! p (+ p 1)))
          ; A linemarker, or a character literal that may hold a `,`.
          (= c 35) (while (and (< p len) (!= (cstr-byte-at buf p) 10)) (set! p (+ p 1)))
          (= c 39) (do (set! p (+ p 1))
                       (while (and (< p len) (!= (cstr-byte-at buf p) 39))
                         (when (= (cstr-byte-at buf p) 92) (set! p (+ p 1)))
                         (set! p (+ p 1)))
                       (set! p (+ p 1)))
          true (set! p (+ p 1)))))
    (return len)))

; One initializer on [pos,stop), or ok=0.
(defn c-enum-fold (buf:ptr pos:i64 stop:i64 ok:ptr:i32):i64
  (let (e:i64 0
        v:i64 0)
    (set! g-cenum-folding 1)
    (set! v (c-cexpr-top buf pos stop (as &i64 &e) ok))
    (set! g-cenum-folding 0)
    (when (!= (c-skip-body-ws buf e stop) stop) (set! @ok 0))
    (return v)))

(defn c-enum-record (name:Symbol val:i64 known:i32):void
  (let (m:ref:CMacro (new CMacro))
    (set! (m 'name) name)
    (set! (m 'val) val)
    (set! (m 'folded) known)
    (assoc g-cenum-index name m))
  (when (!= known 0) (cheader-define-int-const name val)))

; The `{ … }` list at `pos`: `NAME [attributes] [= const-expr]`, an omitted value
; being the previous one plus one. Returns what `cheader-skip-braces` would.
(defn c-parse-enum-body (buf:ptr pos:i64 len:i64):i64
  (let (end:i64 (cheader-skip-braces buf pos len))
    ; Registering at the prescan would outrun this unit's own definitions.
    (when (!= g-cheader-typedef-provisional 0) (return end))
    (let (p:i64 (+ pos 1)
          stop:i64 (- end 1)
          next:i64 0
          known:i32 1)
      (while (< p stop)
        (set! p (c-skip-body-ws buf p stop))
        (when (< p stop)
          (let (ne:i64 0
                name:Symbol (c-read-ident buf p stop (as &i64 &ne)))
            (when (= (symbol-len name) 0) (return end))
            (set! p (c-skip-body-ws buf (c-skip-attributes buf ne stop) stop))
            (when (and (< p stop) (= (cstr-byte-at buf p) 61))
              (let (ve:i64 (c-enum-value-end buf (+ p 1) stop)
                    ok:i32 1
                    v:i64 (c-enum-fold buf (+ p 1) ve (as &i32 &ok)))
                (set! known ok)
                (when (!= ok 0) (set! next v))
                (set! p ve)))
            (c-enum-record name next known)
            (set! next (+ next 1))
            (set! p (c-skip-body-ws buf p stop))
            (when (< p stop)
              (when (!= (cstr-byte-at buf p) 44) (return end))
              (set! p (+ p 1))))))
      (return end))))

; `#define NAME body` on [start,line-end). A `(` immediately after NAME makes it
; function-like, which stays out (§3.2).
(defn cheader-macro-line (buf:ptr start:i64 line-end:i64):void
  (let (p:i64 (c-skip-ws buf start line-end))
    (when (or (>= p line-end) (!= (cstr-byte-at buf p) 35)) (return))
    (let (de:i64 0
          d:Symbol (c-read-ident buf (+ p 1) line-end (as &i64 &de)))
      (when (!= d "define") (return))
      (let (ne:i64 0
            name:Symbol (c-read-ident buf (c-skip-ws buf de line-end) line-end
                                      (as &i64 &ne)))
        (when (= (symbol-len name) 0) (return))
        (when (and (< ne line-end) (= (cstr-byte-at buf ne) 40)) (return))
        (let (m:ref:CMacro (new CMacro))
          (set! (m 'name) name)
          (set! (m 'body-start) (c-skip-ws buf ne line-end))
          (set! (m 'body-end) line-end)
          (conj g-cmacros m)
          (assoc g-cmacro-index name m))))))

(defn cheader-macro-scan (buf:ptr len:i64):void
  (let (p:i64 0)
    (while (< p len)
      (let (le:i64 p)
        (while (and (< le len) (!= (cstr-byte-at buf le) 10)) (set! le (+ le 1)))
        (cheader-macro-line buf p le)
        (set! p (+ le 1))))))

; `-dM` replacement lists are UNEXPANDED — `F_GETLK` is the token `F_GETLK64` —
; so folding is a fixed point, not one pass.
(defn cheader-macro-fold ():void
  (let (save-quiet:i32 g-cheader-unrep-quiet
        more:i32 1)
    ; A `sizeof` in a macro body may name a type this header never resolved; that
    ; abandons the macro, and is not a diagnosis the user asked for.
    (set! g-cheader-unrep-quiet 1)
    (set! g-cmacro-folding 1)
    (while (!= more 0)
      (set! more 0)
      (dotimes (i (unsafe/cast i32 (count g-cmacros)))
        (let (m:ref:CMacro (invoke g-cmacros i:usize))
          (when (= (m 'folded) 0)
            (let (ok:i32 1
                  e:i64 0
                  v:i64 0)
              (set! v (c-cexpr-top g-cmacro-buf (m 'body-start) (m 'body-end)
                                   (as &i64 &e) (as &i32 &ok)))
              ; The body must consume itself: `3.14159` folds its leading `3` and
              ; stops at the `.`, which would register M_PI as 3.
              (set! e (c-skip-ws g-cmacro-buf e (m 'body-end)))
              (when (and (!= ok 0) (= e (m 'body-end)))
                (set! (m 'val) v)
                (set! (m 'rank) g-cexpr-rank)
                (set! (m 'folded) 1)
                (set! more 1)))))))
    (set! g-cmacro-folding 0)
    (set! g-cheader-unrep-quiet save-quiet)))

; §3.1: names verbatim, predefines out, then the rules every imported constant
; follows (cheader-define-int-const).
(defn cheader-macro-register ():void
  (dotimes (i (unsafe/cast i32 (count g-cmacros)))
    (let (m:ref:CMacro (invoke g-cmacros i:usize))
      (when (and (!= (m 'folded) 0)
                 (not (contains? g-cmacro-baseline (m 'name))))
        (cheader-define-int-const (m 'name) (m 'val))))))

(defn cheader-macro-baseline-load ():void
  (when (!= g-cmacro-baseline-ready 0) (return))
  (set! g-cmacro-baseline-ready 1)
  (let (buf-len:i64 0
        status:i32 0
        buf:ptr (cheader-run-cpp (symbol-none) (cheader-cc-target?) 1
                                 (as &i64 &buf-len)
                                 (as &i32 &status)))
    (when (or (= buf null) (!= status 0)) (return))
    (cheader-macro-reset)
    (cheader-macro-scan buf buf-len)
    (dotimes (i (unsafe/cast i32 (count g-cmacros)))
      (let (m:ref:CMacro (invoke g-cmacros i:usize))
        (insert g-cmacro-baseline (m 'name))))
    (cheader-macro-reset)))

; REPL only: `(cflag …)` moved what both caches took as fixed. The buffers
; outlive the records and the baseline SET keeps its names (repl-build-line.md §4).
(defn cheader-flags-changed ():void
  (set! g-cheader-cache null)
  (set! g-cmacro-baseline-ready 0))

; Called at the END of an import: a body may cast through a typedef
; (`CLOCKS_PER_SEC` is `((__clock_t) 1000000)`) that only the declaration pass
; records.
(defn cheader-import-macros (header-path:Symbol):void
  (cheader-macro-baseline-load)
  (let (buf-len:i64 0
        buf:ptr (cheader-preprocess-mode header-path 1 (as &i64 &buf-len)))
    (when (= buf null) (return))
    (cheader-macro-reset)
    (set! g-cmacro-buf buf)
    (cheader-macro-scan buf buf-len)
    (cheader-macro-fold)
    (cheader-macro-register)
    (cheader-macro-reset)))

; The header modes never reach the emitter's imports, so they run this file's C
; imports here, once its own names exist, for the constants an extent may name.
; The IR the import writes goes to buffers no module assembles.
(defn cheader-import-constants (forms:ptr):void
  (ensure-emit-buffers)
  (let (save-out:raw:String g-out
        fc:ptr forms)
    (set! g-out &g-decl-stream)
    (while (> (node-len fc) 0)
      (let (f:raw:Node (node-first fc))
        (when (and (= (node-kind f) NODE-LIST) (>= (node-len f) 2)
                   (= (node-kind (node-at f 0)) NODE-SYM)
                   (= (node-kind (node-at f 1)) NODE-STR))
          (let (h:Symbol ((as raw:Node (node-at f 0)) 's)
                path:Symbol ((as raw:Node (node-at f 1)) 's)
                priv:i32 (if (or (= h "unsafe-import-private") (= h "unsafe/import-private")) 1 0))
            (when (and (import-head? h)
                       (= (str-ends-with path ".nuc") 0)
                       (= (str-ends-with path ".nuch") 0))
              (let (save-priv:i32 g-import-include-private)
                (set! g-import-include-private priv)
                (emit-c-include path (f 'line))
                (set! g-import-include-private save-priv))))))
      (set! fc (node-rest fc)))
    (set! g-out save-out)
    (clear-module-buffers)))

(defn emit-c-include (header-path:Symbol line:i32):void
  ; W3a: reset the linemarker provenance for this header. Until the first
  ; `# N "file"` marker is seen, attribute declarations to the header we were
  ; asked to import (never to line 0 — a `:0:` in a diagnostic is exactly what
  ; W4a's guard forbids).
  (set! g-cheader-file header-path)
  (set! g-cheader-import-header header-path)
  (set! g-cheader-dline 1)
  (set! g-cheader-dpos 0)
  ; The preprocessed text is cached by path (cheader-preprocess) — the same header
  ; is imported by many library files, and the W3a name pre-scan reads it too.
  (let (buf-len:i64 0)
    (let (buf:ptr (cheader-preprocess header-path (as &i64 &buf-len)))
      (when (= buf null)
        (die-at line (fstr "c-include: failed to preprocess '" header-path "'")))
      ; Parse declarations
      (let (pos:i64 0
            prev-pos:i64 -1)
        (while (< pos buf-len)
          (set! prev-pos pos)
          ; Skip whitespace
          (set! pos (c-skip-ws buf pos buf-len))
          (when (< pos buf-len)
            (if (= (cstr-byte-at buf pos) 35)
              ; Skip # line directives. W3a: record the linemarker first, so a
              ; declaration parsed below can be attributed to the real header and
              ; line rather than to the .nuc file that imported it.
              (let (dstart:i64 pos)
                  (while (and (< pos buf-len) (!= (cstr-byte-at buf pos) 10))
                    (set! pos (+ pos 1)))
                  (when (< pos buf-len)
                    (set! pos (+ pos 1)))
                  (cheader-note-linemarker buf dstart pos buf-len))
              ; Try to read an identifier to check what kind of declaration
              (let (tok-end:i64 0
                    tok:Symbol (c-read-ident buf pos buf-len (as &i64 &tok-end)))
                ; Skip typedefs, static inline functions, etc.
                ; Process extern/implicit function declarations and top-level type declarations.
                ; musl (Alpine ARM64) omits `extern` on function declarations, so we try
                ; c-parse-func-decl for any non-struct/union/typedef token.
                ;
                ; Stage 15 W3b: the `true` clause used to sit OUTSIDE this cond — a
                ; stray `)` (introduced with union support) closed the cond after the
                ; struct branch, leaving `true` as a no-op statement and running the
                ; function-declaration parse *unconditionally*. So every top-level
                ; struct/union/typedef was followed, in the same iteration, by a
                ; function parse starting at whatever whitespace the struct parse
                ; stopped on. Two consequences: the declaration after a type
                ; declaration was attributed to the type declaration's line (the W3b
                ; skip warning's `header:line` was short by the intervening blank
                ; lines), and a second forward declaration immediately after a first
                ; (`struct Foo;` / `struct Bar;`) was consumed by the function parse's
                ; not-a-function fallback without ever being registered.
                (cond
                  ; W3c: glibc writes `__extension__ typedef long long int
                  ; __quad_t;` for every type it defines with a `long long`, so
                  ; without this the whole `__quad_t`/`__u_quad_t` family (and
                  ; anything typedef'd from them) stayed unresolved. Consume the
                  ; keyword and re-dispatch on the token that follows; the loop's
                  ; progress guard covers the no-advance case.
                  (= tok "__extension__")
                    (set! pos tok-end)
                  (or (= tok "union") (or (= tok "struct") (= tok "typedef")))
                    ; struct/union/typedef -> layout.
                    (let (decl-end:i64 0
                          ok:i32 (c-parse-struct-decl buf pos buf-len
                                                      (as &i64 &decl-end) line))
                      (if (!= ok 0)
                        (set! pos decl-end)
                        ; W3c: not an aggregate declaration. A scalar / pointer /
                        ; function-pointer / enum typedef is recorded here
                        ; (cheader.md §1.4); anything else falls through to the
                        ; function parser and then to the original
                        ; skip-to-semicolon.
                        (let (td-end:i64 0
                              tdok:i32 (c-parse-typedef-decl buf pos buf-len
                                                             (as &i64 &td-end)))
                          (if (!= tdok 0)
                            (set! pos td-end)
                            ; W3c: a declaration whose first token is
                            ; `struct`/`union` but which is a FUNCTION —
                            ; `struct Tag *f(int);` written without `extern`.
                            ; The type parser registers the tag and declines, and
                            ; before this the declaration was then silently
                            ; dropped: nothing is synthesized, so W3b's gate
                            ; cannot see it either. Invisible on glibc, which
                            ; always writes `extern`; musl deliberately omits it
                            ; (context/build.md), so on Alpine this dropped every
                            ; function returning a `struct X *`.
                            ;
                            ; Restricted to the `struct`/`union` tokens, per
                            ; W3b's note: running the function parser for
                            ; `typedef` too would read `typedef int (*h)(int);`
                            ; as a function literally named `int`. `typedef` has
                            ; already had its own parser above.
                            (let (fn-end:i64 0
                                  fnok:i32 (if (= tok "typedef") 0
                                             (c-parse-func-decl buf pos buf-len
                                               (as &i64 &fn-end) line)))
                              (if (!= fnok 0)
                                (set! pos fn-end)
                                (let (dstart:i64 pos)
                                 ; Neither a type nor a function — skip to `;`
                                 (while (and (< pos buf-len) (!= (cstr-byte-at buf pos) 59))
                                   (set! pos (+ pos 1)))
                                 (cheader-note-unparsed-decl buf dstart pos)
                                 (when (< pos buf-len)
                                      (set! pos (+ pos 1))))))))))
                  true
                    ; Try function declaration (handles both `extern int foo(...)` and
                    ; bare `int foo(...)` — c-parse-type skips `extern` internally).
                    (let (decl-end:i64 0
                          ok:i32 (c-parse-func-decl buf pos buf-len
                                                    (as &i64 &decl-end) line))
                      (if (!= ok 0)
                        (set! pos decl-end)
                        ; Not a function — skip to semicolon or next line
                        (let (dstart:i64 pos)
                            (while (and (< pos buf-len)
                                        (and (!= (cstr-byte-at buf pos) 59)
                                             (!= (cstr-byte-at buf pos) 10)))
                              ; Skip balanced braces (struct/enum bodies)
                              (when (= (cstr-byte-at buf pos) 123)
                                (let (brace-depth:i32 1)
                                  (set! pos (+ pos 1))
                                  (while (and (< pos buf-len) (> brace-depth 0))
                                    (when (= (cstr-byte-at buf pos) 123) (inc! brace-depth))
                                    (when (= (cstr-byte-at buf pos) 125)
                                      (set! brace-depth (- brace-depth 1)))
                                    (set! pos (+ pos 1)))))
                              (when (and (< pos buf-len)
                                         (and (!= (cstr-byte-at buf pos) 123)
                                              (and (!= (cstr-byte-at buf pos) 59)
                                                   (!= (cstr-byte-at buf pos) 10))))
                                (set! pos (+ pos 1))))
                            (cheader-note-unparsed-decl buf dstart pos)
                            (when (< pos buf-len)
                              (set! pos (+ pos 1))))))))))          ; Safety: if pos didn't advance, force it forward to avoid infinite loop
          (when (= pos prev-pos)
            (set! pos (+ pos 1)))))  ; closes when, while
      ; W3a: `buf` belongs to the cheader-preprocess cache now — it is shared with
      ; every other import of this header and with the opaque name pre-scan, so it
      ; must NOT be freed here (the former `(free buf)` left every later reader
      ; walking freed memory).
      )                                         ; let(pos) close, in let(buf)
    (emit g-out "\n"))
  (cheader-import-macros header-path))                      ; let(buf-len), defn

; ============================================================
; C header emission (--emit-cheader)
; ============================================================

; Non-zero when `s` is a word C or C++ reserves, so it cannot be spelled as an
; identifier. Stage 15 W9 item 28: `sanitize-for-c` maps illegal *characters* and
; has no notion of a reserved word, so `union`, `int` and `default` — all ordinary
; Nucleus names — passed through intact and the header did not parse.
;
; C++ is included, not only C. A generated header is routinely consumed through
; `extern "C"` from C++, and `new`, `delete`, `try`, `class`, `template`,
; `operator` and `namespace` are all names a Nucleus library plausibly defines;
; `try` is a Nucleus form. The iso646 spellings (`and`, `or`, `not`, `xor`, …) are
; here for the same reason — they are C++ keywords, and macros in C once
; <iso646.h> is included.
;
; One space-delimited string per family searched with `strstr`, rather than an
; array of literals: the padded needle makes the membership test exact, and each
; family stays one greppable line.
(defn cheader-reserved-word (s:StrView):i32
  (when (= (s 'len) 0) (return 0))
  (let (needle:StrView (fstr " " s " "))
    (when (strview-contains " alignas alignof auto bool break case char const constexpr continue default do double else enum extern false float for goto if inline int long nullptr register restrict return short signed sizeof static static_assert struct switch thread_local true typedef typeof typeof_unqual union unsigned void volatile while _Alignas _Alignof _Atomic _BitInt _Bool _Complex _Generic _Imaginary _Noreturn _Static_assert _Thread_local " needle)
      (return 1))
    (when (strview-contains " and and_eq asm bitand bitor catch char8_t char16_t char32_t class compl concept consteval constinit const_cast co_await co_return co_yield decltype delete dynamic_cast explicit export friend mutable namespace new noexcept not not_eq operator or or_eq private protected public reinterpret_cast requires static_cast template this throw try typeid typename using virtual wchar_t xor xor_eq " needle)
      (return 1))
    (return 0)))

; `s` with a trailing `_` when it is reserved, `s` unchanged otherwise. No
; reserved word ends in `_`, so one suffix always suffices — no loop. A
; collision with a real `union_` in the same header is possible in principle and
; would be a duplicate declaration, which the C compiler reports; silently
; emitting the keyword is the failure this avoids.
(defn cheader-escape-reserved (s:StrView):StrView
  (when (= (cheader-reserved-word s) 0) (return s))
  (return (fstr s "_")))

; `s` with one leading `_` when it begins with a digit. Stage 15 W9 item 39: a C
; identifier is `[A-Za-z_][A-Za-z0-9_]*` — the same first-POSITION rule LLVM has,
; and `sanitize-for-c`'s per-character map can no more express it than the LLVM
; character class could, so `2fast` passed through and the header did not parse.
;
; `_` is deliberately the escape `ir-name-token` uses for LLVM's identical rule:
; the C spelling and the link symbol then agree, so `cheader-asm-label` emits no
; label — correctly, since nothing was renamed beyond the prefix both sides share.
;
; Applied to a COMPLETE identifier only, never to a fragment — same reasoning as
; cheader-escape-reserved's placement on the join: `2circle` joined after
; `_2Shape_` is not at position 0, and escaping it there would spell
; `_2Shape__2circle` where `_2Shape_2circle` is already legal (and `__` is
; reserved to the implementation in C++, which these headers target through
; `extern "C"`).
(defn cheader-escape-leading-digit (s:StrView):StrView
  (when (= (ir-name-leading-digit s) 0) (return s))
  (return (fstr "_" s)))

; Stage 15 W9 item 4: the C spelling of a Nucleus name. `sanitize-for-c` maps
; every character C does not allow in an identifier to `_`, so `a-field` becomes
; `a_field`. Null-safe because several callers read a name out of a malformed
; form and print whatever they got.
;
; W9 item 28: and then escapes a reserved word, because a legal identifier is
; more than a legal character sequence. Every complete C identifier this emitter
; prints goes through here — including a struct/union tag, via the `ns-ir-base`
; callers — so the rule holds in one place instead of per call site.
;
; This is the spelling for names the LINKER NEVER SEES — struct fields, function
; parameters, `defunion` arm names, enum tags, `#define` constants. For a name the
; linker does resolve, sanitizing alone silently breaks the binding; use
; `cheader-asm-label` with it, which then picks up the `_` escape for free (the
; escaped spelling differs from the symbol, so the label appears exactly when it
; must). See the W9 item 4 and 28 notes in
; design/stage15-stress-test/progress.md.
; The absent name renders as nothing at all — a marker parameter (`&optional`,
; `&rest`) has no name — which is the empty view, not a null the callers guard.
(defn cheader-c-ident-view (name:Symbol):StrView
  (when (symbol-none? name) (return ""))
  (return (cheader-escape-reserved
            (cheader-escape-leading-digit
              (sanitize-for-c (symbol-as-view name))))))

; The C spelling of a name that is emitted as one identifier JOINED from two
; parts — `enum Color { Color_red }`, and a defunion's `Foo_arm` tag constants.
; The escape belongs on the join, not on either part: `Color_default` is a
; perfectly good identifier, and escaping the fragment would rename it for no
; reason. The join can still land on a keyword (`and` + `eq`), so it is tested.
(defn cheader-c-ident-join (prefix:StrView member:Symbol):StrView
  (when (symbol-none? member) (return prefix))
  (return (cheader-escape-reserved
            (fstr prefix "_" (sanitize-for-c (symbol-as-view member))))))

; The `asm("…")` suffix that re-binds a sanitized C declaration to the symbol the
; object actually defines, or "" when the sanitized spelling IS the symbol.
;
; A Nucleus link name keeps its hyphens (`(defn ch-get …)` emits `@ch-get`, and
; `nm` shows `T ch-get`), so a C declaration must both spell an identifier and
; name that symbol — two requirements one token cannot meet. Sanitizing alone
; yields a header that parses and then fails to LINK, which is strictly worse than
; one that fails to parse: the error moves away from its cause. The GCC/Clang
; asm-label extension is the only way C can name a hyphenated symbol.
;
; Deliberately empty when no mangling was needed, so a library whose names are
; already C-legal gets a fully portable header and the extension appears exactly
; where it is load-bearing.
(defn cheader-asm-label (link:Symbol cname:StrView):StrView
  (when (= (symbol-as-view link) cname) (return ""))
  (return (fstr " asm(\"" link "\")")))

; The linker symbol behind an ir-name: the same string without its leading `@`
; sigil. Stage 15 W9 item 26 — the generic registry stores ir-names (`@eq.String
; .String`), the C `asm` label wants the bare symbol, and no caller may hand a
; sigil through to a declaration.
(defn cheader-strip-sigil (irname:Symbol):Symbol
  (when (symbol-none? irname) (return irname))
  (let (sv:StrView (symbol-as-view irname))
    (when (or (= (sv 'len) 0) (!= (aref (sv 'data) 0) 64)) (return irname))
    (return (symbol-intern (strview-drop-bytes sv 1)))))

; Stage 15 W9 item 37. A type this unit does not define needs the defining unit's
; generated header included, or the reference is to a tag C never completes:
; a by-value FIELD fails outright ("field has incomplete type" — `lib/string-split.h`
; was unusable for exactly this), and a by-value PARAMETER parses but cannot be
; called, which is worse, being silent. Recorded here because `type-name-to-c`'s
; fallthrough is the one place a reference to a user type is spelled, so the set
; is exactly the set of references that were actually emitted.
;
; `src-file` is readable in this mode only because `prescan-struct-names` records
; it at NAME pre-registration; the definition-time writers never run here, since
; --emit-cheader emits no struct. `prescan-imported-types` swaps g-source-path
; while it walks an imported file, so an imported type carries that file's path.
(defn cheader-note-type-file (name:Symbol):void
  (when (symbol-none? g-source-path) (return))
  (let (sd:?ptr:StructDef (struct-lookup-ref name))
    (when (= sd null) (return))
    (let (f:Symbol ((as &StructDef sd) 'src-file))
      (when (symbol-none? f) (return))
      ; Only a Nucleus unit, whose header the build generates beside it by the
      ; same rule (`lib/%.h: lib/%.nuc`). A C header's opaque type is already
      ; reachable through the `#include` the SOURCE wrote, and a compiler-minted
      ; type (a closure env, a stamped instance) has no header to name at all.
      (when (and (= (str-ends-with f ".nuc") 0) (= (str-ends-with f ".nuch") 0))
        (return))
      (when (= f g-source-path) (return))
      (let (k:Symbol f)
        (when (= (import-list-has g-cheader-includes k) 0)
          (set! g-cheader-includes (import-list-push g-cheader-includes k)))))))

; The `#include` spelling for a defining source file, relative to the header
; being generated. The build writes `lib/foo.h` beside `lib/foo.nuc`, and a
; QUOTED include resolves against the including file's own directory — so a
; sibling is named by basename alone, which is also the only spelling that keeps
; working wherever the tree is checked out. A defining file in another directory
; keeps its path as written: there is no include search path to consult, and
; inventing one would be a guess (the C compiler needs a matching `-I`).
(defn cheader-include-spelling (src:Symbol):StrView
  (let (sv:StrView (symbol-as-view src)
        selfv:StrView (symbol-as-view g-source-path)
        base:i64 0
        end:i64 (as i64 (symbol-len src))
        selfbase:i64 0)
    (dotimes (i (as i64 (symbol-len src)))
      (when (= (symbol-byte-at src (as usize i)) 47) (set! base (+ i 1))))
    (if (!= (str-ends-with src ".nuch") 0)
      (set! end (- end 5))
      (when (!= (str-ends-with src ".nuc") 0) (set! end (- end 4))))
    (dotimes (i (as i64 (symbol-len g-source-path)))
      (when (= (symbol-byte-at g-source-path (as usize i)) 47) (set! selfbase (+ i 1))))
    (when (or (!= selfbase base)
              (and (> base 0)
                   (!= (strview-take-bytes sv (as usize base))
                       (strview-take-bytes selfv (as usize base)))))
      (set! base 0))
    (return (fstr (strview-take-bytes (strview-drop-bytes sv (as usize base))
                                      (as usize (- end base))) ".h"))))

; Stage 16 (c-header-layout.md §6, the `--emit-cheader` item): a C typedef is
; rendered BARE — `struct off_t` names nothing — so without the header that
; defines it the generated header does not compile at all, and the failure is a
; hard `unknown type name`, not the incomplete-tag asymmetry a `struct` gets.
; This is the rule the preamble already applies to `size_t` with `<stddef.h>`,
; applied to a name the emitter learned instead of one it hardcodes.
;
; The spelling is the one the SOURCE imported, not the `/usr/include/…` file a
; linemarker names: only the imported spelling is portable, and re-including it
; is exactly what reproduces the typedef the compiler read. Angle brackets
; unless the import spelled a path.
(defn cheader-c-include-spelling (h:Symbol):StrView
  (let (c0:i32 (symbol-byte-at h 0))
    (when (or (= c0 47) (= c0 46))
      (return (fstr "#include \"" h "\"")))
    (return (fstr "#include <" h ">"))))

(defn cheader-note-c-include (h:Symbol):void
  (when (symbol-none? h) (return))
  (when (= (import-list-has g-cheader-c-includes h) 0)
    (set! g-cheader-c-includes (import-list-push g-cheader-c-includes h))))

; A header mode's output, written to stdout only once the header is complete, so a
; refusal part-way through leaves no partial header behind.
(defvar g-hdr-buf:String)
(defvar g-hdr:raw:String)

(defn header-out-open ():void
  (set! g-hdr-buf (string-new))
  (set! g-hdr &g-hdr-buf))

(defn header-out-close ():void
  (emit-all (as ptr stdout) &g-hdr-buf)
  (set! g-hdr null))

(defn header-print-node (n:(raw Node)):void
  (let (s:String (node-str n))
    (emit-all g-hdr &s)
    (drop &s)))

; The recorded includes, in DISCOVERY order (import-list-push prepends, so the
; list is walked into an array and replayed). Discovery order is emission order,
; which is a deterministic function of the source — `make check-headers` compares
; the committed headers byte for byte, so a stable order is required, not merely
; tidy.
(defn cheader-emit-c-includes ():void
  (let (n:i32 0
        cur:ptr g-cheader-c-includes)
    (while (> (node-len cur) 0)
      (set! n (+ n 1))
      (set! cur (node-rest (unsafe/cast &Node cur))))
    (when (= n 0) (return))
    (let (arr:ptr (arena-alloc (* n (ptr-bytes)))
          i:i32 n)
      (set! cur g-cheader-c-includes)
      (while (> (node-len cur) 0)
        (set! i (- i 1))
        (set! (aref (as &Symbol arr) i)
              ((unsafe/cast &Node (node-first (unsafe/cast &Node cur))) 's))
        (set! cur (node-rest (unsafe/cast &Node cur))))
      (dotimes (j n)
        (emit g-hdr (cheader-c-include-spelling (aref (as &Symbol arr) j))
              "\n")))))

(defn cheader-emit-includes ():void
  (let (n:i32 0
        cur:ptr g-cheader-includes)
    (while (> (node-len cur) 0)
      (set! n (+ n 1))
      (set! cur (node-rest (unsafe/cast &Node cur))))
    (when (= n 0) (return))
    (let (arr:ptr (arena-alloc (* n (ptr-bytes)))
          i:i32 n)
      (set! cur g-cheader-includes)
      (while (> (node-len cur) 0)
        (set! i (- i 1))
        (set! (aref (as &Symbol arr) i)
              ((unsafe/cast &Node (node-first (unsafe/cast &Node cur))) 's))
        (set! cur (node-rest (unsafe/cast &Node cur))))
      (dotimes (j n)
        (emit g-hdr "#include \""
              (cheader-include-spelling (aref (as &Symbol arr) j)) "\"\n")))))

; Every builtin scalar MUST have a row here. A missing row does not fail loudly:
; it falls through to the "assume struct" branch below.
(defn type-name-to-c (name:Symbol):StrView
  ; A marker is spelled as the file that wrote it would spell it.
  (if-some (a (env-arg-of name))
    (do
      (when (!= (a 'type) null) (return (type-to-c (a 'type))))
      (let (here:NameEnv (name-env-here))
        (name-env-set (a 'env))
        (let (c:StrView (type-node-to-c (as ptr (a 'node))))
          (name-env-set here)
          (return c))))
    0)
  (let (mapping:&(HashMap StrView StrView)
        {"void" "void"
         "i8" "int8_t"
         "i16" "int16_t"
         "i32" "int32_t"
         "int" "int32_t"
         "i64" "int64_t"
         "ui8" "uint8_t"
         "ui16" "uint16_t"
         "ui32" "uint32_t"
         "ui64" "uint64_t"
         "f32" "float"
         "f64" "double"
         "f16" "_Float16"
         "f80" "long double"
         "f128" "_Float128"
         "bool" "bool"
         "usize" "size_t"
         "ssize" "ptrdiff_t"
         "Char" "uint32_t"
         "Err" "int32_t"
         "CStr" "const char*"
         "ptr" "void*"})
    (match (mapping (symbol-as-view name))
      ((some n) (return n))
      (none
       (do
         ; Stage 16 L5: a name that resolves only through the C typedef table is
         ; already a C type name — `struct off_t` names nothing. Probed after the
         ; struct registry, the order parse-type-name uses.
         (when (= (as ptr (struct-lookup-ref name)) null)
           (if-some (td (c-typedef-find name))
             (do (cheader-note-c-include (td 'hdr))
                 (return (symbol-as-view name)))
             0))
         (cheader-note-type-file name)
         (return (fstr "struct " (cheader-c-ident-view (ns-ir-base name)))))))))

; Convert a type AST node to a C type string. Handles SYM types and
; (ptr T) / (ptr ptr T) ... lists.
; A niche `!ptr:T` / `?ptr:T` (design/stage10/unions.md §6 rules 2/3) is a bare
; pointer to T — to C it IS a `T*`, with the reserved top page used for error /
; none sentinels (errors.md §2/§8). Render it as `T*` with a documented comment
; rather than the generic `void*`, so the C header is legible. `s` is the type
; spelling; returns the C rendering, or null if it is not a niche sugar symbol.
(defn niche-sym-to-c (s:Symbol):?StrView
  (let (sv:StrView (symbol-as-view s))
    (when (and (not (strview-has-prefix sv "!"))
               (not (strview-has-prefix sv "?")))
      (return (none)))
    ; The payload must be a pointer spelling: !ptr:T / ?ptr:T / !ref:T / ?ref:T.
    (let (rest:StrView (strview-drop-bytes sv 1))
      (when (or (strview-has-prefix rest "ptr:") (strview-has-prefix rest "ref:"))
        (let (elem:StrView (type-name-to-c (symbol-intern (strview-drop-bytes rest 4))))
          (return (some (fstr elem "* /* niche: reserved top page = error/none */")))))
      (return (none)))))

(defn type-node-to-c (tn:ptr):StrView
  (when (= tn null) (return "void"))
  (let (n:ptr:Node (unsafe/cast &Node tn))
    (case (n 'kind)
      NODE-SYM
        (do
          (match (niche-sym-to-c (n 's))
            ((some nc) (return nc))
            (none 0))
          ; Stage 16: an alias has no C spelling of its own — it is a second
          ; spelling for its body (container-type-sugar.md §3.2), so the header
          ; must show the body's C type. Without this the alias name leaked out
          ; as `struct Count`, naming nothing the header defines.
          (if-some (ta (type-alias-lookup-ref (n 's)))
            (do
              (when (>= g-type-alias-depth MAX-TYPE-ALIAS-DEPTH) (return "void"))
              (let (bn:ptr (as ptr (ta 'body)))
                ; A colon-chain body (`ref:Pt`) needs the same split the return
                ; and parameter positions do before it is a type NODE.
                (when (and (= (node-kind bn) NODE-SYM)
                           (symbol-contains-byte (-> bn (unsafe/cast &Node _) (_ 's)) 58))
                  (set! bn (split-colon-segments
                             (-> bn (unsafe/cast &Node _) (_ 's)) (n 'line))))
                (set! g-type-alias-depth (+ g-type-alias-depth 1))
                (let (c:StrView (type-node-to-c bn))
                  (set! g-type-alias-depth (- g-type-alias-depth 1))
                  (return c))))
            0)
          (return (type-name-to-c (n 's))))
      NODE-LIST
        (let (head:ptr (node-first n)
              rest:ptr (node-rest n))
          ; §3.7: same reason as the NODE-SYM arm above — a parametric alias has
          ; no C spelling, so the header must show its expanded body.
          (let (ex:raw:Node (type-alias-apply (as raw:Node tn) (n 'line)))
            (when (!= ex null)
              (when (>= g-type-alias-depth MAX-TYPE-ALIAS-DEPTH) (return "void"))
              (set! g-type-alias-depth (+ g-type-alias-depth 1))
              (let (c:StrView (type-node-to-c (as ptr ex)))
                (set! g-type-alias-depth (- g-type-alias-depth 1))
                (return c))))
          ; PK-4b: `(? (ref T))` / `(?ref T)` / `(Maybe &T)` are the niche
          ; pointer niche-sym-to-c spells for `?ref:T`; any other operand was
          ; refused by cheader-niche-no-c before rendering.
          (let (op:raw:Node (cheader-sigil-operand (as raw:Node tn)))
            (when (and (!= op null) (!= (cheader-ref-ptr-cell op) 0))
              (return (fstr (type-node-to-c (as ptr op))
                            " /* niche: reserved top page = error/none */"))))
          ; `ref` is `ptr`'s synonym (types.md §Pointer kinds), so both spell
          ; the same `T*`; without this the element type was lost to `void*`.
          (when (and (!= head null)
                     (and (= ((unsafe/cast &Node head) 'kind) NODE-SYM)
                          (or (= ((unsafe/cast &Node head) 's) "ptr")
                              (= ((unsafe/cast &Node head) 's) "ref"))))
            (when (= rest null) (return "void*"))
            (let (inner:StrView "")
              (if (= (node-rest (unsafe/cast &Node rest)) null)
                (set! inner (type-node-to-c (node-first (unsafe/cast &Node rest))))
                (set! inner (type-node-to-c rest)))
              (return (fstr inner "*"))))
          ; An inline aggregate, `(union m:T …)` or `(struct m:T …)`, is C's own
          ; unnamed `union { … }` / `struct { … }`, which lays out the same.
          (when (and (!= head null)
                     (and (= ((unsafe/cast &Node head) 'kind) NODE-SYM)
                          (or (= ((unsafe/cast &Node head) 's) "union")
                              (= ((unsafe/cast &Node head) 's) "struct"))))
            (let ((acc String) (str-alloc (strfmt-alloc) ((unsafe/cast &Node head) 's) " { ")
                  cur:ptr rest)
              (while (> (node-len cur) 0)
                (let (member:ptr (node-first (unsafe/cast &Node cur))
                      mname:Symbol (symbol-none)
                      mtname:Symbol (symbol-none))
                  (extract-name-type member (as &Symbol &mname) (as &Symbol &mtname))
                  (let (mtnode:ptr (extract-type-node member ((unsafe/cast &Node member) 'line)))
                    ; W9 item 4: an inline union's member names are emitted here
                    ; rather than by emit-cheader-defstruct, so they need the same
                    ; sanitize its named fields get.
                    (str-into acc (type-node-to-c-decl mtnode (cheader-c-ident-view mname)
                                                       ((unsafe/cast &Node member) 'line))
                              "; ")))
                (set! cur (node-rest (unsafe/cast &Node cur))))
              (str-into acc "}")
              (return (string-as-view acc)))))
      0)
    (return "void*")))

(defn cheader-inline-aggregate? (tn:ptr):i32
  (when (!= (node-kind tn) NODE-LIST) (return 0))
  (let (h:ptr (node-at tn 0))
    (when (!= (node-kind h) NODE-SYM) (return 0))
    (if (or (= ((as raw:Node h) 's) "struct") (= ((as raw:Node h) 's) "union"))
      (return 1)
      (return 0))))

; The type a type alias stands for, through any chain of aliases, or `tn` itself.
; A declarator needs the body: C spells an array or a function pointer around the
; declared name, which no prefix type string can do.
(defn cheader-unalias (tn:ptr):ptr
  (let (cur:ptr tn
        depth:i32 0)
    (while (< depth MAX-TYPE-ALIAS-DEPTH)
      (let (nx:ptr null)
        (case (node-kind cur)
          NODE-SYM
            (if-some (ta (type-alias-lookup-ref ((as raw:Node cur) 's)))
              (let (bn:ptr (as ptr (ta 'body)))
                (when (and (= (node-kind bn) NODE-SYM)
                           (symbol-contains-byte ((as raw:Node bn) 's) 58))
                  (set! bn (split-colon-segments ((as raw:Node bn) 's) (node-line cur 0))))
                (set! nx bn))
              0)
          NODE-LIST
            (set! nx (as ptr (type-alias-apply (as raw:Node cur) (node-line cur 0))))
          0)
        (when (= nx null) (return cur))
        (set! cur nx)
        (inc! depth)))
    (return cur)))

; Extract the type AST node from a binding form.  Returns:
;   - for (name (ptr T)): the (ptr T) cell
;   - for (name T): the T sym
;   - for sym "name:T": a freshly-allocated sym node holding "T"
;   - null if no type
(defn extract-type-node (binding:(raw Node) line:i32):ptr
  (when (= binding null) (return null))
  (let (n:ptr:Node (unsafe/cast &Node binding))
    (case (n 'kind)
      NODE-SYM
        (let (tname:Symbol (symbol-none)  bname:Symbol (symbol-none))
          (split-typed (n 's) (as &Symbol &bname) (as &Symbol &tname))
          (when (symbol-none? tname) (return null))
          (let (tn:ptr:Node (as &Node (alloc-node)))
            (set! (tn 'kind) NODE-SYM)
            (set! (tn 'line) line)
            (set! (tn 's) tname)
            (return (as ptr tn))))
      NODE-LIST
        (let (rest:ptr (node-rest n))
          (when (= rest null) (return null))
          ; A function-pointer type is spread across the whole rest —
          ; `(cb (fn i32) (i32 i32))` — so returning only the first element
          ; dropped the parameter list. Same rule extract-name-type applies
          ; (src/nucleusc.nuc, "legacy fn-pointer form").
          (let (t0:ptr (node-first (unsafe/cast &Node rest)))
            (when (and (!= t0 null) (= (node-kind t0) NODE-LIST))
              (let (ih:ptr (node-first (unsafe/cast &Node t0)))
                (when (and (!= ih null) (= (node-kind ih) NODE-SYM)
                           (= ((unsafe/cast &Node ih) 's) "fn"))
                  (return rest))))
            (return t0)))
      (return null))))

; Stage 15 W8 G-2: is this type node an `(array T N)`? Returns the node itself
; (so the caller can read the element type and the extent) or null.
(defn cheader-array-field-node (tn:(raw Node)):ptr
  (when (= tn null) (return null))
  (let (n:ptr:Node (unsafe/cast &Node tn))
    (when (!= (n 'kind) NODE-LIST) (return null))
    (when (!= (node-len (as ptr n)) 3) (return null))
    (let (hd:(raw Node) (node-at (as ptr n) 0))
      (when (or (= hd null) (!= (hd 'kind) NODE-SYM)) (return null))
      (when (!= (as ptr hd) (as ptr 'array)) (return null))
      (return (as ptr n)))))

; Only this file's own `defconst` keeps its name, since only it is `#define`d
; here; an imported or enum constant is written as its value.
(defn cheader-array-extent (an:ptr encl:i32):StrView
  (let (len:i64 0
        lnn:ptr (node-at an 2)
        lline:i32 (node-line lnn encl))
    (when (= (const-fold-int (as raw:Node lnn) (as &i64 &len) lline) 0)
      (let (e:ptr (header-stock-op-expand lnn))
        (when (and (= (node-kind e) NODE-LIST) (= (node-kind (node-at e 0)) NODE-SYM))
          (let (h:Symbol ((as raw:Node (node-at e 0)) 's))
            (when (and (= (cfold-op-code h) 0) (!= h "sizeof") (!= h "char") (!= h "as"))
              (die-at lline (fstr "--emit-cheader: (array T N): '" h
                                  "' is not folded in a header mode, which registers no macros -- spell the length with constants and arithmetic")))))))
    (set! g-array-ok 1)
    (parse-type-from-node an (node-line an encl))
    ; W9 item 4: sanitized, to match the `#define` emit-cheader-defconst writes.
    ; Only a `defconst` has one: a `defenum` member is spelled `Enum_member`.
    (when (and (= (node-kind lnn) NODE-SYM)
               (contains? g-cheader-own-consts ((as raw:Node lnn) 's)))
      (if-some (s (scope-lookup g-globals ((as raw:Node lnn) 's)))
        (when (and (= (s 'c-const) 0) (= (s 'src-file) g-source-path))
          (return (cheader-c-ident-view ((as raw:Node lnn) 's))))
        0))
    (return (fstr len))))

; The names this file `#define`s (emit-cheader-defconst's integer arm).
(defvar g-cheader-own-consts:&(HashSet Symbol) (hashset-new-in &g-arena-alloc))

(defn cheader-note-own-consts (forms:ptr):void
  (let (fc:ptr forms)
    (while (> (node-len fc) 0)
      (let (f:raw:Node (node-first fc))
        (when (and (= (node-kind f) NODE-LIST) (= (node-len f) 3)
                   (= (node-kind (node-at f 0)) NODE-SYM)
                   (= ((as raw:Node (node-at f 0)) 's) "defconst")
                   (= (node-kind (node-at f 1)) NODE-SYM)
                   (= (node-kind (node-at f 2)) NODE-INT))
          (insert g-cheader-own-consts ((as raw:Node (node-at f 1)) 's))))
      (set! fc (node-rest fc)))))

; Stage 16 FP-5 (design/stage16-ergonomics/c-boundary-defects.md §3): the
; `(fn RET)` head cell of a function-pointer type node — `((fn RET) (P…))` or
; the parameterless `(fn RET)` — or null. The two spellings are told apart by
; whether the answer IS `tn`.
(defn cheader-fn-head-node (tn:ptr):ptr
  (when (= tn null) (return null))
  (let (n:ptr:Node (unsafe/cast &Node tn))
    (when (!= (n 'kind) NODE-LIST) (return null))
    (let (head:ptr (node-first n))
      (when (= head null) (return null))
      (let (h:ptr:Node (unsafe/cast &Node head))
        (when (and (= (h 'kind) NODE-SYM) (= (h 's) "fn")) (return tn))
        (when (= (h 'kind) NODE-LIST)
          (let (h2:ptr (node-first h))
            (when (!= h2 null)
              (let (hh:ptr:Node (unsafe/cast &Node h2))
                (when (and (= (hh 'kind) NODE-SYM) (= (hh 's) "fn"))
                  (return head))))))
        (return null)))))

; FP-5: render a complete C declaration of type `tn` for the declarator `name`
; (which may be "" for the abstract declarator a prototype parameter can use).
;
; C's function-pointer and array types are POSTFIX declarators, so no prefix type
; string can spell them: `type-node-to-c` answered `void*` for the first — which
; is not even standard C, since ISO C defines no conversion between a function
; pointer and `void *` — and the element type for the second, leaving each
; declarator site to paste the rest on by hand. This is the one renderer for
; both, and recurses the way C's declarator grammar nests.
(defn type-node-to-c-decl (tn:ptr name:StrView line:i32):StrView
  (set! tn (cheader-unalias tn))
  (let (an:ptr (cheader-array-field-node (as raw:Node tn)))
    (when (!= an null)
      (return (type-node-to-c-decl (node-at an 1)
                                   (fstr name "[" (cheader-array-extent an line) "]")
                                   line))))
  (let (fh:ptr (cheader-fn-head-node tn))
    (when (!= fh null)
      (let (rnode:ptr null
            plist:ptr null
            (acc String) (str-alloc (strfmt-alloc) ""))
        (let (rn:ptr (node-rest (unsafe/cast &Node fh)))
          (when (!= rn null) (set! rnode (node-first (unsafe/cast &Node rn)))))
        ; `(fn RET)` alone carries no parameter list; `((fn RET) (P…))` holds it
        ; in the outer cell's second element.
        (when (!= fh tn)
          (let (pn:ptr (node-rest (unsafe/cast &Node tn)))
            (when (!= pn null) (set! plist (node-first (unsafe/cast &Node pn))))))
        ; `()` is C's `(void)`, not an empty declarator list: `f()` in C declares
        ; unspecified arguments, which is not what `(fn RET)()` means.
        (if (= (node-len plist) 0)
          (str-into acc "void")
          (let (cur:ptr plist
                first:i32 1)
            (while (> (node-len cur) 0)
              (when (= first 0) (str-into acc ", "))
              (str-into acc (type-node-to-c-decl (node-first (unsafe/cast &Node cur)) "" line))
              (set! first 0)
              (set! cur (node-rest (unsafe/cast &Node cur))))))
        (return (type-node-to-c-decl rnode
                  (fstr "(*" name ")(" (string-as-view acc) ")") line)))))
  (when (= (strview-byte-len name) 0) (return (type-node-to-c tn)))
  (return (fstr (type-node-to-c tn) " " name)))

(defn emit-cheader-defstruct (form:ptr):void
  ; Skip parametric templates: (defstruct (Name T...) ...) has a list at
  ; position 1, not a sym. Templates define no concrete C type.
  ; W9 item 45: `node-kind`, so a name spelled `()` — a NULL node (W5f) — is
  ; skipped here too rather than dereferenced. `validate-header-forms` is what
  ; refuses the form, before any output.
  (let (aflags:i32 0
        aalign:i32 0
        nattrs:i32 (struct-attr-scan (as raw:Node form)
                                     (as &i32 &aflags)
                                     (as &i32 &aalign) 0
                                     ((unsafe/cast &Node form) 'line)))
  (when (!= (node-kind (node-at form (+ 1 nattrs))) NODE-SYM) (return))
  ; ir-name-token first (`?`→_QMARK / `!`→_BANG), then the blanket C sanitize; see
  ; type-name-to-c. A no-op for names without `?`/`!`, so headers stay byte-identical.
  ;
  ; Stage 15 B3′: `ns-ir-base` composes the library's namespace ir-prefix, exactly
  ; as `emit-cheader-declare` already does for a function name. R1 makes it
  ; necessary: two namespaces may now both define `Pt`, and without the prefix
  ; their generated headers would both declare `typedef struct {…} Pt;` — a C
  ; collision the moment a program includes both. Identity under `user`, so every
  ; existing header is byte-identical.
  ; W9 item 28: `cheader-c-ident` — the tag and typedef of a struct named `union`
  ; must be escaped, in lockstep with every reference to it (type-name-to-c).
  (let (nn:ptr:Node (unsafe/cast &Node (node-at form (+ 1 nattrs)))
        name:StrView (cheader-c-ident-view (ns-ir-base (nn 's)))
        nfields:i32 (- (- (node-len form) 2) nattrs)
        ; PK-2: the attribute goes after the closing brace, which is the one
        ; position of the three C honours that needs no tag to attach to.
        packed:StrView (if (!= (bit-and aflags STRUCT-ATTR-PACKED) 0)
                         " __attribute__((packed))" "")
        ; PK-3: `aligned` sits in the same after-brace run; both attributes go
        ; into one `__attribute__((…))` only if both are present, which C spells
        ; as two runs just as happily.
        aligned:StrView "")
    (when (!= aalign 0)
      (set! aligned (fstr " __attribute__((aligned(" aalign ")))")))
    (check-ir-name-legal (nn 'line) (nn 's) name)
    ; Stage 18 TF-4, the same ruling W9 item 44 made for a declaration: a field
    ; whose type is a non-pointer `!T`/`?T` niche has no C spelling, and emitting
    ; one names an undefined tag. Refuse the WHOLE struct — dropping just the
    ; field would hand C a layout that silently disagrees with Nucleus.
    (dotimes (i nfields)
      (let (field:ptr (node-at form (+ (+ i 2) nattrs)))
        (when (!= (cheader-niche-no-c
                    (cheader-unalias
                      (extract-type-node field ((unsafe/cast &Node field) 'line)))) 0)
          (emit g-hdr "/* " name
                ": a field uses an error-union or option type; not exported */\n")
          (return))))
    ; Stage 15 W9 item 25: TAG the struct. `type-name-to-c` spells every reference
    ; to a user type `struct NAME`, so an anonymous typedef leaves `struct NAME` a
    ; never-completed tag and every BY-VALUE use of the type fails — a field
    ; (`struct Rec r;` — "field has incomplete type") and a parameter alike, in a
    ; header the compiler emitted for exactly that purpose. Tag and typedef may
    ; share a spelling (separate C namespaces), so both work afterwards and the
    ; reference spelling needs no special case.
    (emit g-hdr "typedef struct " name " {\n")
    (dotimes (i nfields)
      (let (falign:i32 0
            fbits:i32 0
            field:ptr (field-peel-attrs (node-at form (+ (+ i 2) nattrs))
                                        (as &i32 &falign)
                                        (as &i32 &fbits) 0
                                        ((unsafe/cast &Node form) 'line))
            fname:Symbol (symbol-none)
            tname:Symbol (symbol-none)
            anon:ptr (cheader-unalias (field-anon-type-node (node-at form (+ (+ i 2) nattrs)))))
        ; AN-2: C spells an anonymous member by inlining its BODY, so only an
        ; inline `(struct …)` / `(union …)` has a standard C rendering.
        (when (and (!= anon null) (= (cheader-inline-aggregate? anon) 0))
          (die-at ((unsafe/cast &Node form) 'line)
            "--emit-cheader: a ':anon' member has no standard C spelling -- C writes an anonymous member's body inline, which a named Nucleus type cannot be"))
        (if (!= anon null)
          (emit g-hdr "    " (type-node-to-c anon) ";\n")
          (extract-name-type field (as &Symbol &fname) (as &Symbol &tname)))
        (let (tnode:ptr (if (!= anon null) null
                          (extract-type-node field ((unsafe/cast &Node field) 'line))))
          (when (!= tnode null)
            (let (bits:StrView ""
                  fal:StrView "")
              (when (!= fbits 0) (set! bits (fstr " : " (if (< fbits 0) 0 fbits))))
              (when (!= falign 0)
                (set! fal (fstr " __attribute__((aligned(" falign ")))")))
              ; FP-5: array and function-pointer members are both postfix
              ; declarators; type-node-to-c-decl is the single renderer for them.
              (emit g-hdr "    "
                    (type-node-to-c-decl tnode (cheader-c-ident-view fname)
                                     ((unsafe/cast &Node field) 'line))
                    bits fal ";\n"))))))
    (emit g-hdr "}" packed aligned " " name ";\n\n"))))

; A defunion-template instance type ((Result i64 i32)) has no C spelling yet —
; the instance struct is not exported, and mapping it to void* would emit an
; ABI-wrong signature (the value is really a by-value tagged struct). Detect it
; so the declare can be skipped honestly.
(defn cheader-template-instance (tn:(raw Node)):i32
  (when (= tn null) (return 0))
  ; PK-4b: `(Maybe X)` / `(Result X Err)` are `?X` / `!X`, and the niche
  ; classifier below rules on those — a pointer operand IS exported.
  (when (!= (cheader-sigil-operand tn) null) (return 0))
  (let (n:ptr:Node (unsafe/cast &Node tn))
    (when (!= (n 'kind) NODE-LIST) (return 0))
    (let (head:ptr:Node (unsafe/cast &Node (node-first n)))
      (when (= (as ptr head) null) (return 0))
      (when (!= (head 'kind) NODE-SYM) (return 0))
      (when (!= (union-template-lookup-ref (head 's)) null) (return 1))
      (return 0))))

; L8: detect a capturing-closure environment type OR a type-erased box type in a
; signature's type AST. Closure env structs are compiler-generated __vfn_env_N
; (fn-make-env-struct). Type-erased box types are (BoxedFn …) and (dyn P) — fat
; pointers carrying Nucleus-side Drop/vtable semantics with no faithful C spelling.
; None of these is C-callable, so a public defn exposing one — by value, or via a
; (ref ...)/(ptr ...) indirection — is excluded from --emit-cheader and warned at
; its definition. A plain `fn`/function-pointer type is NOT a closure type (it
; is C-ABI). Returns 1 if `tn` mentions such a type, else 0. Unwraps arbitrary
; (ref T)/(ptr T) nesting down to the base type symbol.
(defn cheader-mentions-closure (tn:(raw Node)):i32
  (let (cur:ptr tn)
    (while (!= cur null)
      (let (n:ptr:Node (unsafe/cast &Node cur))
        (case (n 'kind)
          NODE-SYM
            (do
              (when (strview-has-prefix (symbol-as-view (n 's)) "__vfn_env_") (return 1))
              (return 0))
          NODE-LIST
            (let (head:ptr:Node (unsafe/cast &Node (node-first n)))
              (when (or (= (as ptr head) null) (!= (head 'kind) NODE-SYM)) (return 0))
              (let (hs:Symbol (head 's))
                ; Type-erased box types: (BoxedFn …) and (dyn P) carry fat-pointer
                ; Nucleus semantics with no faithful C spelling.
                (when (or (= hs "BoxedFn") (= hs "dyn")) (return 1))
                (when (and (!= hs "ptr") (!= hs "ref")) (return 0))
                (let (rest:ptr (node-rest n))
                  (when (= rest null) (return 0))
                  (if (= (node-rest (unsafe/cast &Node rest)) null)
                    (set! cur (node-first (unsafe/cast &Node rest)))
                    (set! cur rest)))))
          (return 0))))
    (return 0)))

; W9 item 44: an error-union / option type over a NON-pointer payload — `!ui8`,
; `!i32`, `!String`, `?Char` — is a `(Result T Err)` TEMPLATE INSTANCE wearing a
; sugar spelling, and `cheader-template-instance` above already rules that a
; template instance is not exported. It slipped past only because the sugar is a
; NODE-SYM, not a `(Result …)` cell, so `niche-sym-to-c` answered null and
; `type-name-to-c`'s "assume struct" fallthrough spelled `struct _BANGui8` — a tag
; nothing defines, and nothing here can define, since the header emits no typedef
; for a template instance. This makes the two spellings of one type agree, which
; is the same trap items 3 and 25 fixed (the Type-keyed and name-keyed renderers
; must give one answer).
;
; Not a cosmetic tag: the instance really is `{i32 tag; union payload}` (measured
; `%Result.u8.Err`), so a C author who writes a struct of the RIGHT shape reads
; the value correctly — and one who guesses the shape from the tag's name gets a
; program that compiles, links, runs and reads the wrong number (measured: 0
; where Nucleus reads 65). A declaration C trusts and gets wrong is worse than an
; omission — W9 item 3's ruling for `defvar`. Restoring these wants the general
; feature `cheader-template-instance` is waiting on, not a special case here.
;
; The POINTER niches stay: `!ptr:T` / `!ref:T` are niche-encoded in the pointer
; itself (design/stage10/unions.md §6 rule 3), so the whole value is a bare
; pointer, ABI-identical to a C `T*`, and niche-sym-to-c spells it as one.
; Unwraps `(ptr T)` / `(ref T)` exactly as cheader-mentions-closure does, so
; `ptr:!ui8` — which rendered `struct _BANGui8*` — is refused with the rest.
;
; PK-4b: the sigil is read through `sigil-split` (src/generics.nuc), so `?X`,
; `(? X)`, `(?ref X)` and `(Maybe X)` are one question with one answer.
(defn cheader-sigil-operand (tn:(raw Node)):(raw Node)
  (let (run:StrView "" op:raw:Node (sigil-split tn (node-line (as ptr tn) 0) &run))
    (when (= op null) (return null))
    ; `(Maybe ptr:Pt)`: the operand is the cell the type parser makes of it.
    (when (and (= (op 'kind) NODE-SYM) (symbol-contains-byte (op 's) 58))
      (return (split-colon-segments (op 's) (node-line (as ptr tn) 0))))
    (return op)))

; A `(ref X)` / `(ptr X)` cell — the operand shape a sigil may wrap and still
; be a C pointer. `raw` is excluded as niche-sym-to-c excludes `?raw:T`.
(defn cheader-ref-ptr-cell (op:(raw Node)):i32
  (when (or (= op null) (!= (op 'kind) NODE-LIST)) (return 0))
  (let (h:raw:Node (node-first op))
    (when (or (= h null) (!= (h 'kind) NODE-SYM)) (return 0))
    (if (or (= (h 's) "ptr") (= (h 's) "ref")) (return 1) (return 0))))

(defn cheader-niche-no-c (tn:(raw Node)):i32
  (when (= tn null) (return 0))
  (let (op:raw:Node (cheader-sigil-operand tn))
    (when (!= op null)
      ; Through the pointer, so `?&!i32` is refused for its pointee.
      (if (!= (cheader-ref-ptr-cell op) 0)
        (return (cheader-niche-no-c op))
        (return 1))))
  ; Stage 18 TF-4: a `(fn RET)` / `((fn RET) (P…))` carries RET and its parameters
  ; one level down, where the ptr/ref unwrapping below never looked — which is how
  ; a `!void` callback reached lib/test.h as an undefined `struct _BANGvoid` tag.
  (let (fh:ptr (cheader-fn-head-node (as ptr tn)))
    (when (!= fh null)
      (let (rn:ptr (node-rest (unsafe/cast &Node fh)))
        (when (and (!= rn null)
                   (!= (cheader-niche-no-c (node-first (unsafe/cast &Node rn))) 0))
          (return 1)))
      (when (!= fh (as ptr tn))
        (let (pn:ptr (node-rest (unsafe/cast &Node tn)))
          (when (!= pn null)
            (let (cur:ptr (node-first (unsafe/cast &Node pn)))
              (while (> (node-len cur) 0)
                (when (!= (cheader-niche-no-c (node-first (unsafe/cast &Node cur))) 0)
                  (return 1))
                (set! cur (node-rest (unsafe/cast &Node cur))))))))
      (return 0)))
  (let (n:ptr:Node (unsafe/cast &Node tn))
    (case (n 'kind)
      NODE-SYM
        (do
          (when (and (!= (symbol-byte-at (n 's) 0) 33) (!= (symbol-byte-at (n 's) 0) 63)) (return 0))
          (match (niche-sym-to-c (n 's))
            ((some _) (return 0))
            (none 0))
          (return 1))
      NODE-LIST
        (let (head:ptr:Node (unsafe/cast &Node (node-first n)))
          (when (or (= (as ptr head) null) (!= (head 'kind) NODE-SYM)) (return 0))
          (let (hs:Symbol (head 's))
            ; A `!ptr`/`!ref` HEAD is the pointer niche in list form; it lands
            ; on `void*`, which is size- and ABI-correct. Only ptr/ref wrappers
            ; are unwrapped to look further in.
            (when (and (!= hs "ptr") (!= hs "ref")) (return 0))
            (let (rest:ptr (node-rest n))
              (when (= rest null) (return 0))
              (if (= (node-rest (unsafe/cast &Node rest)) null)
                (return (cheader-niche-no-c (node-first (unsafe/cast &Node rest))))
                (return (cheader-niche-no-c rest))))))
      0)
    (return 0)))

; The C-header return-type node of a defn form, honoring both signature styles:
; legacy (`name:ret` / `(name ret)`) recovers it from the name node; new style
; (S1) takes the index-3 operand, normalized so a keyword ret reads as a symbol
; type node for type-node-to-c.
(defn cheader-defn-ret-node (form:(raw Node)):ptr
  (let (name-node:ptr (node-at form 1))
    ; W9 item 45: `node-line`/`node-kind` — a name or a return operand spelled
    ; `()` is a NULL node (W5f), and this accessor answers with the null node
    ; itself rather than dereferencing it; the form is refused by
    ; `validate-header-forms`, which runs before any of this.
    (when (= (sig-name-is-bare name-node) 0)
      (return (extract-type-node name-node
                (node-line name-node ((unsafe/cast &Node form) 'line)))))
    ; New style: the return operand is at index 3. type-node-to-c needs the nested
    ; type-node form, so a colon-chain spelling (`ptr:Pt`) is split into `(ptr Pt)`
    ; exactly as the legacy desugar path yields it; a plain spelling stays a symbol
    ; node; a parenthesized list-form return is used verbatim.
    (let (rn:ptr:Node (unsafe/cast &Node (node-at form 3)))
      (when (or (= (node-kind (as ptr rn)) NODE-KEYWORD)
                (= (node-kind (as ptr rn)) NODE-SYM))
        (when (symbol-contains-byte (rn 's) 58)
          (return (split-colon-segments (rn 's) (rn 'line))))
        (return (normalize-ret-node (as ptr rn))))
      (return (as ptr rn)))))

; Why `emit-cheader-declare` would refuse this defn, or 0 to export it:
;   1 generic template   2 defunion-template instance
;   3 closure / erased box   4 error-union or option type with no C spelling
; The reason CODE rather than a message, because the two callers need different
; things from the same question: the emitter names the class in the comment it
; prints in the declaration's place, while item 37's include pre-pass only needs
; to know that the declaration is refused — a type reachable solely through a
; refused declaration is not a dependency of this header, so scanning its other
; signature positions would record an `#include` nothing in the file needs.
; Asking it in one place is what stops those two from drifting apart, which is
; the failure mode item 37 hit when the pre-pass replicated the tests by hand.
(defn cheader-defn-skip-reason (form:ptr):i32
  ; A generic template (the same predicate the prescan/emit-defn skip already use
  ; — src/generics.nuc): a bare tyvar has no C spelling, so emitting one here
  ; produced garbage C in both defn-signature styles (defn-signature.md follow-up).
  (when (!= (defn-is-generic-template form) 0) (return 1))
  (let (params:ptr (node-at form 2)
        np:i32 (node-len (node-at form 2))
        ret:ptr null)
    ; Guarded exactly as cheader-defn-ret-node dereferences — the legacy spelling
    ; recovers the type from the name node, the S1 spelling from index 3 — because
    ; the include pre-pass asks this question before any prescan has vetted the
    ; form's shape. A null ret reads as "no return type", which every check below
    ; already answers 0 for.
    (when (or (= (sig-name-is-bare (node-at form 1)) 0) (>= (node-len form) 4))
      (set! ret (cheader-defn-ret-node form)))
    ; Signatures mentioning template-instance types (no C spelling yet).
    (let (skip:i32 (cheader-template-instance ret))
      (dotimes (pi np)
        (when (!= (cheader-template-instance
                    (extract-type-node (node-at params pi)
                                       ((unsafe/cast &Node (node-at params pi)) 'line))) 0)
          (set! skip 1)))
      (when (!= skip 0) (return 2)))
    ; L8: a signature exposing a capturing-closure env type (__vfn_env_N) or a
    ; type-erased box type (BoxedFn/dyn) is not C-callable. A plain fn pointer is.
    (let (skip-cl:i32 (cheader-mentions-closure ret))
      (dotimes (clpi np)
        (when (!= (cheader-mentions-closure
                    (extract-type-node (node-at params clpi)
                                       ((unsafe/cast &Node (node-at params clpi)) 'line))) 0)
          (set! skip-cl 1)))
      (when (!= skip-cl 0) (return 3)))
    ; W9 item 44: a niche-encoded `!T` / `?T` over a non-pointer payload.
    (let (skip-ni:i32 (cheader-niche-no-c ret))
      (dotimes (nipi np)
        (when (!= (cheader-niche-no-c
                    (extract-type-node (node-at params nipi)
                                       ((unsafe/cast &Node (node-at params nipi)) 'line))) 0)
          (set! skip-ni 1)))
      (when (!= skip-ni 0) (return 4)))
    (return 0)))

(defn emit-cheader-declare (form:ptr):void
  ; (defn name:rettype (params...) ...)  /  (defn name (params...) rettype ...)
  (let (name-node:ptr (node-at form 1)
        fname:Symbol (symbol-none)
        ret-name:Symbol (symbol-none))
    (extract-name-type name-node (as &Symbol &fname) (as &Symbol &ret-name))
    (let (why:i32 (cheader-defn-skip-reason form))
      (macmap ((x why-text)
               `(when (= why ~x)
                  (emit g-hdr "/* " fname ~why-text " */\n")
                  (return)))
        ((1 ": generic template; not exported")
         (2 ": uses a defunion-template instance type; not exported")
         (3 ": exposes a closure or type-erased box type; not C-callable, omitted")
         (4 ": uses an error-union or option type; not exported"))))
    ; Stage 12 N6: emit the C-legal mangled link name (`geom__area`) for a
    ; namespaced library. ns-ir-base composes g-current-ns's ir-prefix onto the
    ; bare name; identity under `user`, so existing headers are byte-identical.
    ;
    ; W9 item 4: the declaration's two halves — the opening `ret name(` and the
    ; closing `) asm("link");` — are emitted many lines apart with the parameters
    ; streamed between them, so both spellings are computed HERE, once. Deriving
    ; the label's copy separately is exactly how the two would drift.
    ;
    ; W9 item 26: ASK the registry, do not re-derive. `ns-ir-base` is the symbol
    ; only for a solitary non-operator `defn`; an overload takes a per-signature
    ; mangled name and an operator goes through `op-name-token` even when it is
    ; the sole user method (its generic always carries an intrinsic seed), so
    ; `lib/string.nuc`'s `=` links as `eq.String.String`. The registry decided
    ; that in `finalize-generics` and is the only thing that knows it; deriving a
    ; second answer here is how the header came to declare symbols no object
    ; defines. `defn-form-mangled-name` answers null for a solitary name, which is
    ; exactly when `ns-ir-base` is right.
    (let (link:Symbol (cheader-strip-sigil (defn-form-mangled-name (as raw:Node form)))
          cname:StrView "")
      (when (symbol-none? link) (set! link (ns-ir-base fname)))
      (set! cname (cheader-c-ident-view link))
      ; FP-5: the parameter list is built BEFORE the return type is rendered.
      ; A function returning a function pointer wraps its own declarator —
      ; `int32_t (*getf(void))(int32_t, int32_t);` — so the name and its
      ; parameters have to be in hand before the return type can be spelled.
      (let ((acc String) (str-alloc (strfmt-alloc) "")
            params:ptr (node-at form 2)
            n:i32 (node-len params))
        (when (= n 0) (str-into acc "void"))
        (dotimes (i n)
          (when (!= i 0) (str-into acc ", "))
          (let (p:ptr (node-at params i)
                pname:Symbol (symbol-none)
                ptname:Symbol (symbol-none))
            (extract-name-type p (as &Symbol &pname) (as &Symbol &ptname))
            (let (ptnode:ptr (extract-type-node p ((unsafe/cast &Node p) 'line))
                  pc:StrView (cheader-c-ident-view pname))
              (if (!= ptnode null)
                (str-into acc (type-node-to-c-decl ptnode pc
                                                   ((unsafe/cast &Node p) 'line)))
                ; No type node at all — a shape this pass cannot read.
                (when (not (symbol-none? pname))
                  (str-into acc "void* " pc))))))
        (let (rtnode:ptr (cheader-defn-ret-node form))
          (emit g-hdr
                (type-node-to-c-decl rtnode
                  (fstr cname "(" (string-as-view acc) ")")
                  (node-line (as raw:Node form) 0))
                (cheader-asm-label link cname) ";\n"))))))

; Zero for a cell `type-node-to-c` would silently widen to `void*` (a template
; instance, a bare `(fn …)`); `raw T` widens too, but at pointer size and ABI.
(defn cheader-defvar-type-ok (tn:ptr):i32
  (set! tn (cheader-unalias tn))
  (when (!= (cheader-inline-aggregate? tn) 0) (return 0))
  (let (an:ptr (cheader-array-field-node (as raw:Node tn)))
    (when (!= an null) (return (cheader-defvar-type-ok (node-at an 1)))))
  (let (n:ptr:Node (unsafe/cast &Node tn))
    (when (= (n 'kind) NODE-SYM) (return 0))
    (when (!= (n 'kind) NODE-LIST) (return 1))
    ; PK-4b: a niche pointer in list form is a pointer under a fourth spelling.
    (when (!= (cheader-ref-ptr-cell (cheader-sigil-operand (as raw:Node tn))) 0) (return 0))
    (let (head:ptr (node-first n))
      (when (= head null) (return 1))
      (when (!= ((unsafe/cast &Node head) 'kind) NODE-SYM) (return 1))
      (let (h:Symbol ((unsafe/cast &Node head) 's))
        (when (= h "ptr") (return 0))
        (when (= h "raw") (return 0))
        (when (= h "ref") (return 0))
        (when (= h "union") (return 0))
        (return 1)))))

; Item 3 needed a BY-VALUE spelling here (`cheader-by-value-c`, which stripped the
; `struct ` prefix) because the typedef was anonymous, so `struct NAME` was an
; incomplete tag and `extern struct SR s;` failed the moment a field was touched.
; Item 25 tagged the typedef, so `type-node-to-c`'s one answer is now correct in
; both positions and the second spelling is gone.

; Stage 15 W9 item 3: export a public `defvar` as `extern T name;`, which is what
; docs/toplevel.md has always CLAIMED a global does ("visible to C consumers
; (`extern T name;`)") and what `--emit-nuch` has always done for the Nucleus side
; (`(extern (g i32))`). The dispatch had no `defvar` arm at all, so a C consumer
; could reach a library's functions and none of its state.
;
; **The C name is not simply the sanitized name, and this is the whole design.**
; A global's link symbol keeps its hyphens — `(defvar ch-count:i32 7)` emits
; `@ch-count`, and `nm` shows `D ch-count` — while `ch-count` is not a C
; identifier. Sanitizing it to `ch_count` produces a header that PARSES and then
; fails to link (`undefined reference to 'ch_count'`, measured), which is strictly
; worse than one that fails to parse: the error moves away from its cause. So a
; name that needs sanitizing carries an `asm("…")` label, which is what makes the
; C spelling reach the real symbol (measured: the C consumer reads 7).
;
; The label is emitted ONLY when the sanitized name differs from the link name, so
; a library whose names are already C-legal gets a fully portable header and the
; GCC/Clang extension appears exactly where it is load-bearing. Note this is the
; opposite conclusion from W9 item 4's recorded one ("the fix is a missed call
; site") — which holds for type/field/arm/enum names, since those have no linkage,
; and does not hold for anything the linker resolves.
(defn emit-cheader-defvar (form:ptr):void
  (let (fc:ptr:Node (unsafe/cast &Node form)
        attr-flags:i32 0)
    ; The name may be preceded by declaration attributes (`(defvar :const g:i32 1)`),
    ; so the name node comes off the advanced cursor rather than a fixed index —
    ; the same chokepoint `emit-defvar` uses, not a second reading of the grammar.
    (let (decl:ptr (parse-decl-attrs (as ptr (node-rest fc))
                     (as &i32 &attr-flags) (fc 'line)))
      (when (= decl null) (return))
      (let (name-node:ptr (node-first (unsafe/cast &Node decl))
            vname:Symbol (symbol-none)
            vtname:Symbol (symbol-none))
        (extract-name-type name-node (as &Symbol &vname)
                                     (as &Symbol &vtname))
        (when (symbol-none? vname) (return))
        (let (tnode:ptr (cheader-unalias (extract-type-node name-node
                                           ((unsafe/cast &Node name-node) 'line))))
          (when (= tnode null)
            (emit g-hdr "/* " vname ": no type annotation; not exported */\n")
            (return))
          ; The same two un-C-representable classes `emit-cheader-declare` skips,
          ; for the same reasons: a defunion-template instance has no C spelling,
          ; and a closure env / erased box is not C-constructible.
          (when (!= (cheader-template-instance tnode) 0)
            (emit g-hdr "/* " vname
                  ": uses a defunion-template instance type; not exported */\n")
            (return))
          (when (!= (cheader-mentions-closure tnode) 0)
            (emit g-hdr "/* " vname
                  ": exposes a closure or type-erased box type; not C-callable, omitted */\n")
            (return))
          ; W9 item 44: and a niche-encoded `!T` / `?T` over a non-pointer payload,
          ; which `cheader-defvar-type-ok` below cannot see — it is a plain SYM, so
          ; that arm passes it and `type-name-to-c` spells an undefined struct tag.
          ; A `!T` global is real (`@g = global %Result.u8.Err`), which is exactly
          ; why the wrong spelling here would be linked against.
          (when (!= (cheader-niche-no-c tnode) 0)
            (emit g-hdr "/* " vname
                  ": uses an error-union or option type; not exported */\n")
            (return))
          ; `type-node-to-c` answers `void*` for every cell head it does not
          ; recognize, which is SIZE-CORRECT for a pointer and silently wrong for
          ; anything else — `(defvar m:(Maybe i32) …)` would declare a
          ; pointer-sized object over a struct. (The two skips above catch a
          ; template instance only where the registry knows the template; this
          ; arm does not depend on that.) A *declaration* the C
          ; compiler trusts and gets wrong is worse than an omission, so this arm
          ; emits only what that function genuinely spells: a plain type name, a
          ; pointer under any of its three spellings, an array or inline aggregate.
          (when (!= (cheader-defvar-type-ok tnode) 0)
            (emit g-hdr "/* " vname ": type has no C spelling here; not exported */\n")
            (return))
          ; AVR-6: `:const` selects LLVM `constant` storage, which is C's `const`.
          (let (cst:StrView (if (!= (bit-and attr-flags DECL-ATTR-CONST) 0) "const " "")
                link:Symbol (ns-ir-base vname))
            (let (cname (cheader-c-ident-view link))
              (emit g-hdr "extern " cst
                    (type-node-to-c-decl tnode cname ((unsafe/cast &Node name-node) 'line))
                    (cheader-asm-label link cname) ";\n"))))))))

; W9 item 4: a `#define` is a preprocessor token with no link name, so the plain
; sanitized spelling is the whole answer. `cheader-array-extent` emits the same
; spelling for a symbolic `(array T N)` length, which is what keeps the two agreeing.
(defn emit-cheader-defconst (form:ptr):void
  ; W9 item 45: a name spelled `()` is a NULL node (W5f) and defines no macro;
  ; `validate-header-forms` refuses the form before this emitter is reached.
  (when (!= (node-kind (node-at form 1)) NODE-SYM) (return))
  (let (name:StrView (cheader-c-ident-view ((unsafe/cast &Node (node-at form 1)) 's))
        val-node:ptr:Node (unsafe/cast &Node (node-at form 2)))
    (case (node-kind (as ptr val-node))
      NODE-INT (emit g-hdr "#define " name " " (val-node 'i) "\n")
      NODE-STR (emit g-hdr "#define " name " \"" (val-node 's) "\"\n")
      0)))

; W9 item 4: both the enum tag name and each member constant are sanitized —
; neither is a link name (a `defenum` member is a compile-time integer, not a
; symbol), so no asm label applies to either.
(defn emit-cheader-defenum (form:ptr):void
  ; W9 item 45: a name spelled `()` is a NULL node (W5f) and names no C enum.
  ; `validate-header-forms` refuses the form before any output; this guard is what
  ; keeps the emitter from reading the name to find that out — the same guard
  ; `emit-cheader-defunion` below already has.
  (when (!= (node-kind (node-at form 1)) NODE-SYM) (return))
  (dotimes (mi (- (node-len form) 2))
    (when (!= (node-kind (node-at form (+ mi 2))) NODE-SYM) (return)))
  (let (name:StrView (cheader-c-ident-view ((unsafe/cast &Node (node-at form 1)) 's))
        n:i32 (- (node-len form) 2))
    (emit g-hdr "enum " name " {\n")
    (dotimes (i n)
      (let (variant:StrView (cheader-c-ident-join name ((unsafe/cast &Node (node-at form (+ i 2))) 's)))
        (emit g-hdr "    " variant " = " i)
        (when (< i (- n 1)) (emit g-hdr ","))
        (emit g-hdr "\n")))
    (emit g-hdr "};\n\n")))

; Export a defunion as its C view (unions.md §3): the tagged struct plus an
; enum of tag constants, fully legible and constructible from C. Templates
; define no type and are skipped.
(defn emit-cheader-defunion (form:ptr):void
  (let (name-node:ptr:Node (unsafe/cast &Node (node-at form 1)))
    ; W9 item 45: `node-kind` — a name spelled `()` is a NULL node (W5f), skipped
    ; here as a template name is; `validate-header-forms` refuses the form.
    (when (!= (node-kind (as ptr name-node)) NODE-SYM) (return))
    ; ir-name-token first (`?`→_QMARK / `!`→_BANG), then the blanket C sanitize; see
    ; type-name-to-c. A no-op for names without `?`/`!`, so headers stay byte-identical.
    ; Stage 15 W9 item 25: `ns-ir-base`, not bare `ir-name-token` — B3′ applied
    ; that to `emit-cheader-defstruct` and `type-name-to-c` but not here, so a
    ; namespaced union's definition and every reference to it spelled different C
    ; identifiers. Identity under `user`.
    ; W9 item 28: `cheader-c-ident`, as emit-cheader-defstruct — see there.
    (let (name:StrView (cheader-c-ident-view (ns-ir-base (name-node 's)))
          narms:i32 (- (node-len form) 2)
          npay:i32 0)
      (check-ir-name-legal (name-node 'line) (name-node 's) name)
      ; Any payload-bearing arm?
      (dotimes (i narms)
        (when (= ((unsafe/cast &Node (node-at form (+ i 2))) 'kind) NODE-LIST)
          (inc! npay)))
      ; Tagged for the same reason a defstruct is (item 25): `type-name-to-c`
      ; spells a reference to a union type `struct NAME` too.
      (emit g-hdr "typedef struct " name " {\n    int32_t tag;\n")
      (when (> npay 0)
        (emit g-hdr "    union {\n")
        (dotimes (i narms)
          (let (arm:ptr:Node (unsafe/cast &Node (node-at form (+ i 2))))
            (when (= (arm 'kind) NODE-LIST)
              (let (aname:StrView (cheader-c-ident-view ((unsafe/cast &Node (node-at (as ptr arm) 0)) 's))
                    nf:i32 (- (node-len (as ptr arm)) 1))
                (if (= nf 1)
                  ; One field → the payload is just that field, named by the arm.
                  (let (field:ptr (node-at (as ptr arm) 1)
                        tnode:ptr (extract-type-node field ((unsafe/cast &Node field) 'line)))
                    (emit g-hdr "        " (type-node-to-c tnode) " " aname ";\n"))
                  (do
                    (emit g-hdr "        struct { ")
                    (dotimes (fi nf)
                      (let (field:ptr (node-at (as ptr arm) (+ fi 1))
                            fname:Symbol (symbol-none)
                            ftname:Symbol (symbol-none))
                        (extract-name-type field (as &Symbol &fname)
                                                  (as &Symbol &ftname))
                        (let (tnode:ptr (extract-type-node field ((unsafe/cast &Node field) 'line)))
                          (emit g-hdr (type-node-to-c tnode) " "
                                (cheader-c-ident-view fname) "; "))))
                    (emit g-hdr "} " aname ";\n")))))))
        (emit g-hdr "    } payload;\n"))
      (emit g-hdr "} " name ";\n\n")
      ; Tag constants: declaration order from 0 — part of the C contract.
      (emit g-hdr "enum " name "_tag {\n")
      (dotimes (i narms)
        (let (arm:ptr:Node (unsafe/cast &Node (node-at form (+ i 2)))
              aname:StrView (cheader-c-ident-join name
                          (if (= (arm 'kind) NODE-SYM) (arm 's)
                            ((unsafe/cast &Node (node-at (as ptr arm) 0)) 's))))
          (emit g-hdr "    " aname " = " i)
          (when (< i (- narms 1)) (emit g-hdr ","))
          (emit g-hdr "\n")))
      (emit g-hdr "};\n\n"))))

; W9 item 37: render one type node for its RECORDING side effect only. The
; `(array T N)` split mirrors emit-cheader-defstruct — `type-node-to-c` answers
; `void*` for an array cell and would never reach the element type — but the
; extent is deliberately not evaluated here: `cheader-array-extent` can `die-at`,
; and a diagnostic must keep coming from the emitter, at its own point.
;
; The two "has no C spelling" predicates are the emitters' own, and they are
; applied here for the same reason those apply them: a declaration they reject is
; never emitted, so a type reachable only through one is not a dependency of this
; header. Without them `lib/combinators.h` — which spells no `struct` at all —
; picked up an include for the `String` return type of a generic template.
(defn cheader-scan-type-node (tn:ptr):void
  (set! tn (cheader-unalias tn))
  (when (= tn null) (return))
  (when (!= (cheader-template-instance (as raw:Node tn)) 0) (return))
  (when (!= (cheader-mentions-closure (as raw:Node tn)) 0) (return))
  (when (!= (cheader-niche-no-c (as raw:Node tn)) 0) (return))
  (let (an:ptr (cheader-array-field-node (as raw:Node tn))
        rendered:StrView "")
    (if (!= an null)
      (set! rendered (type-node-to-c (node-at an 1)))
      (set! rendered (type-node-to-c tn)))))

; W9 item 37: the type nodes a generated header would RENDER, visited before the
; preamble is printed so the `#include` lines can precede the first use of what
; they complete. Signature positions only — a defn's BODY is never emitted, so a
; type used solely inside one is not a dependency of the header.
;
; This re-reads the positions the emitters read; it does not re-implement what
; they do with them, since the rendering goes through `type-node-to-c` itself.
; So the worst a drift here can cost is a missing or a surplus `#include`, never
; a wrong type. The heads are the same six `emit-cheader-header` dispatches on —
; the `-` (private) spellings are absent from both, which is what keeps a private
; definition from contributing a dependency nothing exported can need.
(defn cheader-scan-form-types (form:ptr):void
  (let (f:ptr:Node (unsafe/cast &Node form))
    (when (or (!= (f 'kind) NODE-LIST) (< (node-len form) 2)) (return))
    (let (h0:ptr:Node (unsafe/cast &Node (node-at form 0)))
      (when (!= (h0 'kind) NODE-SYM) (return))
      (let (h:Symbol (h0 's))
        (when (= h "defn")
          ; A declaration the emitter refuses names no dependency of this header,
          ; and it refuses the WHOLE declaration on any one of its signature
          ; positions — so ask once, of the whole form, rather than per type node.
          ; W9 item 44: this is what keeps `lib/char.h` from including `prelude.h`
          ; for the `Char` payload of a `!Char` return that is no longer declared.
          (when (!= (cheader-defn-skip-reason form) 0) (return))
          (when (>= (node-len form) 3)
            (let (params:ptr:Node (unsafe/cast &Node (node-at form 2)))
              (when (and (!= (as ptr params) null) (= (params 'kind) NODE-LIST))
                (dotimes (i (node-len (as ptr params)))
                  (let (p:ptr:Node (unsafe/cast &Node (node-at (as ptr params) i)))
                    (cheader-scan-type-node
                      (extract-type-node (as raw:Node p) (node-line (as ptr p) (f 'line))))))))
            ; Guarded exactly as cheader-defn-ret-node dereferences: the legacy
            ; spelling reads the name node, the S1 spelling index 3.
            (when (or (= (sig-name-is-bare (node-at form 1)) 0) (>= (node-len form) 4))
              (cheader-scan-type-node (cheader-defn-ret-node (as raw:Node form)))))
          (return))
        (when (= h "defstruct")
          ; A parametric head — `(defstruct (Vector T) …)` — defines no concrete
          ; C type and is skipped by the emitter at its first line, so its fields
          ; name no dependency either. Without this, `lib/vector.h` (which spells
          ; no `struct` at all) took an include for the template's allocator field.
          ; W9 item 45: `node-kind`/`node-line` throughout this scan — every
          ; position it walks may be spelled `()`, which is a NULL node (W5f), and
          ; a scan that only collects include dependencies has nothing to say
          ; about one. `validate-header-forms` is what refuses the form.
          (when (!= (node-kind (node-at form 1)) NODE-SYM) (return))
          (dotimes (i (- (node-len form) 2))
            (let (fl:ptr:Node (unsafe/cast &Node (node-at form (+ i 2))))
              (cheader-scan-type-node
                (extract-type-node (as raw:Node fl) (node-line (as ptr fl) (f 'line))))))
          (return))
        (when (= h "defunion")
          (when (!= (node-kind (node-at form 1)) NODE-SYM) (return))
          (dotimes (i (- (node-len form) 2))
            (let (arm:ptr:Node (unsafe/cast &Node (node-at form (+ i 2))))
              (when (= (node-kind (as ptr arm)) NODE-LIST)
                (dotimes (fi (- (node-len (as ptr arm)) 1))
                  (let (fl:ptr:Node (unsafe/cast &Node (node-at (as ptr arm) (+ fi 1))))
                    (cheader-scan-type-node
                      (extract-type-node (as raw:Node fl) (node-line (as ptr fl) (f 'line)))))))))
          (return))
        ; `defvar` puts the name after any declaration attributes, so every
        ; operand is offered to extract-type-node rather than a fixed index being
        ; read — a keyword or a literal answers null. Avoids calling
        ; `parse-decl-attrs`, which can die, before the preamble is printed.
        (when (= h "defvar")
          (dotimes (i (- (node-len form) 1))
            (let (op:ptr:Node (unsafe/cast &Node (node-at form (+ i 1))))
              (cheader-scan-type-node
                (extract-type-node (as raw:Node op) (node-line (as ptr op) (f 'line)))))))))))

(defn emit-cheader-header (forms:ptr source-file:Symbol):void
  ; Stage 12 N6: a namespaced library's public symbols carry a mangled link name
  ; (`@geom__area`), so the C declarations must use that C-legal spelling — never
  ; the Nucleus source name `geom/area` (not a C identifier). Apply a leading
  ; `(ns NAME)` / `set-ir-prefix` so g-current-ns is set; emit-cheader-declare
  ; then composes the namespace ir-prefix onto each function name via ns-ir-base.
  ; Identity under `user`, so an un-namespaced library's header is byte-identical.
  (set! forms (apply-leading-ns forms))
  (apply-early-set-ir-prefix forms)
  ; Stage 15 W9 item 26: the same prescan sequence `emit-nuch-header` runs, and
  ; for the same reason — the symbol a `defn` links as is decided by
  ; `finalize-generics` (at the end of prescan-defn-signatures), not by its
  ; spelling. Without this the header could only guess, and it guessed the
  ; solitary non-operator form for every function: an operator or an overload was
  ; declared under a symbol no object defines. Emission still walks THIS file's
  ; forms only, so nothing an import contributes is exported.
  ; Protocols before struct names, per B5 — the reverse order reports a
  ; `defprotocol`/`defstruct` name clash at the wrong line.
  ;
  ; `prescan-imported-signatures` is not optional here: whether a name is
  ; overloaded is a property of the whole compilation unit, and a library's own
  ; file usually contributes ONE method to a name the prelude also defines
  ; (`hash`, `drop`, `next`). Prescanning this file alone makes every such name
  ; look solitary, and the header would declare `@hash` where the object defines
  ; `hash.pString`. This file's own path goes on `g-prescan-sigs` first — the list
  ; that walk guards on — so an import cycle back to it is skipped rather than
  ; re-read.
  (prescan-file-imports forms)
  (prescan-imported-types forms)
  (prescan-protocols forms)
  (prescan-struct-names forms)
  (prescan-defn-signatures forms)
  ; So a C constant yields to this file's own value names, as it does when compiled.
  ; `cheader-array-extent` still writes a local constant by name.
  (prescan-value-names forms)
  (when (not (symbol-none? g-source-path))
    (set! g-prescan-sigs (import-list-push g-prescan-sigs g-source-path)))
  (prescan-imported-signatures forms)
  (cheader-import-constants forms)
  ; W9 item 38: ask the questions the prescans deferred to an emitter this mode
  ; never runs. Before any output, so a refused program produces no partial
  ; header — three fixtures used to segfault here with no output at all, and an
  ; unresolvable import printed a header that silently omitted its every name.
  (validate-header-forms forms)
  (cheader-note-own-consts forms)
  ; This file's layouts, as the compile prescans them, so an extent's `sizeof`
  ; folds to the size the compile uses; imported files' ran in the walk above.
  (prescan-struct-layouts forms)
  (prescan-union-layouts forms)
  ; W9 item 37: discover the cross-unit type references BEFORE the preamble, so
  ; the `#include` that completes each one can precede it. A header that names a
  ; type it does not define is not merely untidy — a by-value field of one does
  ; not compile at all, which is what made `lib/string-split.h` unusable.
  (set! g-cheader-includes null)
  (set! g-cheader-c-includes null)
  (let (sc:ptr forms)
    (while (> (node-len sc) 0)
      (cheader-scan-form-types (node-first (unsafe/cast &Node sc)))
      (set! sc (node-rest (unsafe/cast &Node sc)))))
  (emit g-hdr "#pragma once\n")
  (emit g-hdr "#include <stdint.h>\n")
  (emit g-hdr "#include <stdbool.h>\n")
  ; size_t / ptrdiff_t, for usize / ssize (type-name-to-c).
  (emit g-hdr "#include <stddef.h>\n")
  ; The C headers a rendered C typedef came from, before the Nucleus units'
  ; generated headers: a borrowed unit's header may itself name one.
  (cheader-emit-c-includes)
  (cheader-emit-includes)
  (emit g-hdr "\n")
  (emit g-hdr "/* Generated from " source-file " by nucleusc --emit-cheader */\n\n")
  ; Register defunion templates first so declares can recognize (and skip)
  ; signatures that mention template-instance types.
  (let (fc0:ptr forms)
    (while (> (node-len fc0) 0)
      (let (f:ptr:Node (unsafe/cast &Node (node-first (unsafe/cast &Node fc0))))
        (when (and (and (!= (as ptr f) null) (= (f 'kind) NODE-LIST))
                   (and (> (node-len (as ptr f)) 1)
                        (and (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 'kind) (= _ NODE-SYM))
                             (and (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 's) (= _ "defunion"))
                                  ; W9 item 45: `node-kind` — a name spelled `()`
                                  ; registers no template here.
                                  (= (node-kind (node-at (as ptr f) 1)) NODE-LIST)))))
          (register-union-template (as ptr f))))
      (set! fc0 (node-rest (unsafe/cast &Node fc0)))))
  (let (fc:ptr forms)
    (while (> (node-len fc) 0)
      (let (f:ptr:Node (unsafe/cast &Node (node-first (unsafe/cast &Node fc))))
        (when (and (and (!= (as ptr f) null) (= (f 'kind) NODE-LIST))
                   (and (> (node-len (as ptr f)) 0)
                        (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 'kind) (= _ NODE-SYM))))
          (let (h:Symbol (-> f (node-at _ 0) (unsafe/cast &Node _) (_ 's)))
            (case h
                  "defstruct" (emit-cheader-defstruct (as ptr f))
                  "defunion"  (emit-cheader-defunion (as ptr f))
                  "defn"      (emit-cheader-declare (as ptr f))
                  "defvar"    (emit-cheader-defvar (as ptr f))
                  "defconst"  (emit-cheader-defconst (as ptr f))
                  "defenum"   (emit-cheader-defenum (as ptr f))
                  0))))
      (set! fc (node-rest (unsafe/cast &Node fc))))))
